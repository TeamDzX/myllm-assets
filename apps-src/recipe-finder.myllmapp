{"name": "Recipe Finder", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>:root{color-scheme:light dark;--accent:#ff453a}\n*{box-sizing:border-box}\nbody{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:18px;background:#f2f2f7;color:#111}\n@media(prefers-color-scheme:dark){body{background:#000;color:#eee}input,.recipe,.saved{background:#1c1c1e;color:#eee;border-color:#3a3a3c}}\nh1{font-size:22px;margin:0 0 4px}\n.sub{font-size:13px;opacity:.6;margin-bottom:14px}\n.row{display:flex;gap:8px;margin-bottom:8px}\ninput{flex:1;min-width:0;padding:12px;border:1px solid #d1d1d6;border-radius:10px;font-size:16px;background:#fff;color:#111}\nbutton.go{border:0;background:var(--accent);color:#fff;border-radius:10px;padding:0 16px;font-size:15px;font-weight:600}\n.alt{display:flex;gap:8px;margin-bottom:6px}\n.alt button{flex:1;border:0;background:#e5e5ea;color:#333;border-radius:9px;padding:9px;font-size:13px;font-weight:600}\n@media(prefers-color-scheme:dark){.alt button{background:#1c1c1e;color:#eee}}\n#status{font-size:13px;opacity:.7;min-height:16px;margin:8px 0}\n.recipe{background:#fff;border-radius:16px;padding:18px;margin-top:6px;box-shadow:0 1px 4px rgba(0,0,0,.1);display:none}\n.recipe h2{margin:0 0 2px;font-size:20px}\n.recipe .serv{font-size:12px;opacity:.6;margin-bottom:12px}\n.recipe h3{font-size:13px;text-transform:uppercase;letter-spacing:.05em;opacity:.55;margin:14px 0 6px}\n.recipe ul,.recipe ol{margin:0;padding-left:20px}.recipe li{margin:4px 0;line-height:1.45;font-size:15px}\n.save{margin-top:14px;border:0;background:#ffe5e3;color:var(--accent);border-radius:10px;padding:11px 16px;font-size:14px;font-weight:600;width:100%}\n@media(prefers-color-scheme:dark){.save{background:#3a1f1e}}\nh4{font-size:13px;text-transform:uppercase;letter-spacing:.05em;opacity:.55;margin:22px 0 8px}\n.saved{background:#fff;border-radius:11px;padding:11px 14px;margin-bottom:8px;display:flex;align-items:center;gap:10px;box-shadow:0 1px 2px rgba(0,0,0,.07)}\n.saved span{flex:1;font-size:15px;font-weight:600}\n.saved .del{background:none;color:#ff453a;font-size:17px;padding:2px}\n@media(min-width:768px){body{max-width:760px;margin-left:auto;margin-right:auto}}\n</style></head><body>\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-family:-apple-system,system-ui,sans-serif;font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;line-height:1;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n<script>\n(function(){\n  if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;\n  window.__myllmAiWrap=true;\n  var orig=window.myllmAsk,depth=0,node=null;\n  function ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\n    node.innerHTML='<span class=\"myllm-ai-cog\">\\u2699\\uFE0F</span><span>AI is thinking\\u2026 <small>privately, on your device</small></span>';\n    (document.body||document.documentElement).appendChild(node);}\n  function show(){ensure();depth++;node.classList.add('on');}\n  function hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\n  window.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\n    return Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};\n})();\n</script>\n\n<h1>🍳 Recipe Finder</h1>\n<div class=\"sub\">Tell it what's in your fridge, or a dish you fancy — get a recipe.</div>\n<div class=\"row\"><input id=\"q\" placeholder=\"e.g. chicken, rice, peppers — or “lasagne”\" enterkeyhint=\"search\"><button class=\"go\" id=\"go\" onclick=\"find()\">Cook</button></div>\n<div class=\"alt\"><button onclick=\"surprise()\">🎲 Surprise me</button><button onclick=\"find(' make it quick (under 20 minutes)')\">⚡ Something quick</button></div>\n<div id=\"status\"></div>\n<div class=\"recipe\" id=\"recipe\"></div>\n<h4 id=\"savedHead\" style=\"display:none\">Saved recipes</h4>\n<div id=\"saved\"></div>\n<script>\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar saved=[],current=null;\nfunction el(i){return document.getElementById(i)}\nfunction setStatus(t){el('status').textContent=t||''}\nfunction esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}\n\nfunction find(extra){\n  var q=el('q').value.trim();\n  if(!q){setStatus('Type some ingredients or a dish first.');return}\n  ask('Create a recipe based on: \"'+q+'\".'+(typeof extra==='string'?extra:''));\n}\nfunction surprise(){ask('Invent one appealing dinner recipe (your choice, something a home cook would enjoy).')}\n\nfunction ask(prompt){\n  if(!window.myllmAsk){setStatus('Recipes need AI — update MyLLM and enable “Allow apps to use the AI” in Settings.');return}\n  el('go').disabled=true;setStatus('Cooking something up…');\n  myllmAsk(prompt+' Reply with ONLY JSON like {\"title\":\"...\",\"servings\":\"e.g. Serves 4\",\"time\":\"e.g. 30 min\",\"ingredients\":[\"...\"],\"steps\":[\"...\"]} and nothing else.',\n           {system:'You are a helpful home-cooking chef. Give clear, realistic recipes.'})\n  .then(function(reply){\n    var s=reply.indexOf('{'),e=reply.lastIndexOf('}');\n    if(s<0||e<=s)throw new Error('the chef didn’t return a recipe');\n    var r=JSON.parse(reply.slice(s,e+1));\n    if(!r.title||!r.ingredients||!r.steps)throw new Error('the recipe came back incomplete');\n    current=r;renderRecipe(r);setStatus('');if(window.myllmHaptic)myllmHaptic('success');\n  }).catch(function(err){setStatus('Could not find a recipe: '+err.message)})\n  .then(function(){el('go').disabled=false});\n}\n\nfunction renderRecipe(r){\n  var box=el('recipe');box.style.display='block';\n  var meta=[r.servings,r.time].filter(Boolean).join(' · ');\n  box.innerHTML='<h2>'+esc(r.title)+'</h2>'+(meta?'<div class=\"serv\">'+esc(meta)+'</div>':'')+\n    '<h3>Ingredients</h3><ul>'+(r.ingredients||[]).map(function(x){return '<li>'+esc(x)+'</li>'}).join('')+'</ul>'+\n    '<h3>Method</h3><ol>'+(r.steps||[]).map(function(x){return '<li>'+esc(x)+'</li>'}).join('')+'</ol>'+\n    '<button class=\"save\" id=\"saveBtn\">♥ Save recipe</button>';\n  el('saveBtn').onclick=function(){saveCurrent()};\n  box.scrollIntoView({behavior:'smooth',block:'start'});\n}\nfunction saveCurrent(){\n  if(!current)return;\n  if(!saved.some(function(r){return r.title===current.title})){saved.unshift(current);persist();renderSaved()}\n  el('saveBtn').textContent='♥ Saved';el('saveBtn').disabled=true;\n  if(window.myllmHaptic)myllmHaptic('success');\n}\nfunction persist(){store.setItem('recipes',JSON.stringify(saved))}\nfunction renderSaved(){\n  var S=el('saved');S.innerHTML='';el('savedHead').style.display=saved.length?'block':'none';\n  saved.forEach(function(r,i){\n    var d=document.createElement('div');d.className='saved';\n    var sp=document.createElement('span');sp.textContent=r.title;sp.onclick=function(){current=r;renderRecipe(r)};\n    var x=document.createElement('button');x.className='del';x.textContent='✕';x.onclick=function(){saved.splice(i,1);persist();renderSaved()};\n    d.appendChild(sp);d.appendChild(x);S.appendChild(d);\n  });\n}\nel('q').addEventListener('keydown',function(e){if(e.key==='Enter')find()});\nstore.getItem('recipes').then(function(v){\n  if(v)try{saved=JSON.parse(v)}catch(e){}\n  renderSaved();\n  if(!window.myllmAsk)setStatus('Heads-up: this app needs the latest MyLLM with apps-AI enabled.');\n});\n</script></body></html>\n", "kind": "html", "iconSymbol": "frying.pan", "iconColor": "red"}