{"name": "Recipe Finder", "html": "<!doctype html>\n<!--\n  Recipe Finder — MyLLMos App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>\n/* all theme colours live in variables so light/dark can never be undone by\n   rule order (a later `background:#fff` once beat the dark override — the\n   \"grey text on white card\" bug) */\n:root{--build-id:\"37d9ffc5dc\";color-scheme:light dark;--accent:#ff453a;\n  --bg:#f2f2f7;--card:#fff;--ink:#111;--line:#d1d1d6;--alt:#e5e5ea;--alt-ink:#333;--save-bg:#ffe5e3;\n  --diet-bg:#e3f4e7;--diet-ink:#1e7d3c}\n@media(prefers-color-scheme:dark){:root{\n  --bg:#000;--card:#1c1c1e;--ink:#eee;--line:#3a3a3c;--alt:#1c1c1e;--alt-ink:#eee;--save-bg:#3a1f1e;\n  --diet-bg:#173322;--diet-ink:#7ed99a}}\n*{box-sizing:border-box}\nbody{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:18px;background:var(--bg);color:var(--ink)}\nh1{font-size:22px;margin:0 0 4px}\n.sub{font-size:13px;opacity:.6;margin-bottom:14px}\n.row{display:flex;gap:8px;margin-bottom:8px}\ninput{flex:1;min-width:0;padding:12px;border:1px solid var(--line);border-radius:10px;font-size:16px;background:var(--card);color:var(--ink)}\nbutton.go{border:0;background:var(--accent);color:#fff;border-radius:10px;padding:0 16px;font-size:15px;font-weight:600}\n.alt{display:flex;gap:8px;margin-bottom:6px}\n.alt button{flex:1;border:0;background:var(--alt);color:var(--alt-ink);border-radius:9px;padding:9px;font-size:13px;font-weight:600}\n.diet{border:1.5px solid var(--line);background:none;color:var(--alt-ink);border-radius:999px;padding:7px 14px;font-size:13px;font-weight:600;margin-bottom:6px}\n.diet.on{border-color:#34a853;background:var(--diet-bg);color:var(--diet-ink)}\n#status{font-size:13px;opacity:.7;min-height:16px;margin:8px 0}\n.recipe{background:var(--card);color:var(--ink);border-radius:16px;padding:18px;margin-top:6px;box-shadow:0 1px 4px rgba(0,0,0,.1);display:none}\n.recipe h2{margin:0 0 2px;font-size:20px}\n.recipe .serv{font-size:12px;opacity:.6;margin-bottom:12px}\n.recipe h3{font-size:13px;text-transform:uppercase;letter-spacing:.05em;opacity:.55;margin:14px 0 6px}\n.recipe ul,.recipe ol{margin:0;padding-left:20px}.recipe li{margin:4px 0;line-height:1.45;font-size:15px}\n.save{margin-top:14px;border:0;background:var(--save-bg);color:var(--accent);border-radius:10px;padding:11px 16px;font-size:14px;font-weight:600;width:100%}\nh4{font-size:13px;text-transform:uppercase;letter-spacing:.05em;opacity:.55;margin:22px 0 8px}\n.saved{background:var(--card);color:var(--ink);border-radius:11px;padding:11px 14px;margin-bottom:8px;display:flex;align-items:center;gap:10px;box-shadow:0 1px 2px rgba(0,0,0,.07)}\n.saved span{flex:1;font-size:15px;font-weight:600}\n.saved .del{background:none;color:#ff453a;font-size:17px;padding:2px}\n@media(min-width:768px){body{max-width:760px;margin-left:auto;margin-right:auto}}\n</style></head><body>\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-family:-apple-system,system-ui,sans-serif;font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;line-height:1;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n<script>\n(function(){\n  if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;\n  window.__myllmAiWrap=true;\n  var orig=window.myllmAsk,depth=0,node=null;\n  function ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\n    node.innerHTML='<span class=\"myllm-ai-cog\">\\u2699\\uFE0F</span><span>AI is thinking\\u2026 <small>privately, on your device</small></span>';\n    (document.body||document.documentElement).appendChild(node);}\n  function show(){ensure();depth++;node.classList.add('on');}\n  function hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\n  window.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\n    return Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};\n})();\n</script>\n\n<h1>🍳 Recipe Finder</h1>\n<div class=\"sub\">Tell it what's in your fridge, or a dish you fancy — get a recipe.</div>\n<div class=\"row\"><input id=\"q\" placeholder=\"e.g. chicken, rice, peppers — or “lasagne”\" enterkeyhint=\"search\"><button class=\"go\" id=\"go\" onclick=\"find()\">Cook</button></div>\n<div class=\"alt\"><button onclick=\"surprise()\">🎲 Surprise me</button><button onclick=\"find(' make it quick (under 20 minutes)')\">⚡ Something quick</button></div>\n<button class=\"diet\" id=\"dietBtn\" onclick=\"toggleDiet()\">🌱 Plant-based</button>\n<div id=\"status\"></div>\n<div class=\"recipe\" id=\"recipe\"></div>\n<h4 id=\"savedHead\" style=\"display:none\">Saved recipes</h4>\n<div id=\"saved\"></div>\n<script>\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar saved=[],current=null,plant=false;\nfunction toggleDiet(){\n  plant=!plant;renderDiet();store.setItem('recipes.plant',plant?'1':'');\n  if(window.myllmHaptic)myllmHaptic('selection');\n}\nfunction renderDiet(){\n  var b=el('dietBtn');b.classList.toggle('on',plant);\n  b.textContent=plant?'🌱 Plant-based — on (eggs ok)':'🌱 Plant-based';\n}\nfunction el(i){return document.getElementById(i)}\nfunction setStatus(t){el('status').textContent=t||''}\nfunction esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}\n\nfunction find(extra){\n  var q=el('q').value.trim();\n  if(!q){setStatus('Type some ingredients or a dish first.');return}\n  ask('Create a recipe based on: \"'+q+'\".'+(typeof extra==='string'?extra:''));\n}\nfunction surprise(){ask('Invent one appealing dinner recipe (your choice, something a home cook would enjoy).')}\n\n/* Labelled lines, not JSON — small models (Apple Intelligence) echo JSON\n   templates back verbatim. Echoed instructions are rejected and retried. */\nvar ECHO=/recipe name|one ingredient|one short cooking step|repeat this line|labelled line|how many people/i;\nfunction parseRecipe(reply){\n  var r={title:'',servings:'',time:'',ingredients:[],steps:[]},got=false;\n  String(reply||'').split(/\\r?\\n/).forEach(function(raw){\n    var ln=raw.replace(/\\*\\*/g,'').trim();\n    var m=ln.match(/^[-*#>\\s]*(TITLE|SERVES|TIME|INGREDIENTS?|STEPS?)\\s*\\d*\\s*[::]\\s*(.*)$/i);\n    if(!m)return;\n    got=true;var k=m[1].toUpperCase().replace(/S$/,''),v=m[2].trim();\n    if(k==='TITLE')r.title=v;\n    else if(k==='SERVE')r.servings=v;\n    else if(k==='TIME')r.time=v;\n    else if(k==='INGREDIENT'&&v)r.ingredients.push(v);\n    else if(k==='STEP'&&v)r.steps.push(v);\n  });\n  if(!got){ // model answered in the old JSON shape — accept it\n    var s=reply.indexOf('{'),e=reply.lastIndexOf('}');\n    if(s>=0&&e>s)try{\n      var j=JSON.parse(reply.slice(s,e+1));\n      r.title=j.title||'';r.servings=j.servings||'';r.time=j.time||'';\n      r.ingredients=Array.isArray(j.ingredients)?j.ingredients:[];r.steps=Array.isArray(j.steps)?j.steps:[];\n    }catch(e2){}\n  }\n  r.ingredients=r.ingredients.filter(function(x){return x&&!ECHO.test(x)});\n  r.steps=r.steps.filter(function(x){return x&&!ECHO.test(x)});\n  if(!r.title||ECHO.test(r.title)||r.ingredients.length<2||r.steps.length<2)\n    throw new Error('the chef didn’t return a proper recipe');\n  return r;\n}\nfunction ask(prompt){\n  if(!window.myllmAsk){setStatus('Recipes need AI — update MyLLM and enable “Allow apps to use the AI” in Settings.');return}\n  el('go').disabled=true;setStatus('Cooking something up…');\n  var diet=plant?' The recipe MUST be fully plant-based: no meat, poultry, fish, seafood, dairy, gelatine or honey. Eggs ARE allowed.':'';\n  var p=prompt+diet+' Reply with EXACTLY these labelled lines and nothing else:\\n'+\n    'TITLE: the recipe name\\nSERVES: how many people it serves\\nTIME: total cooking time\\n'+\n    'INGREDIENT: one ingredient with its quantity (repeat this line for every ingredient)\\n'+\n    'STEP: one short cooking step (repeat this line for every step)';\n  var sys={system:'You are a helpful home-cooking chef. Give clear, realistic recipes.'};\n  myllmAsk(p,sys).then(function(r){return parseRecipe(r||'')})\n  .catch(function(){return myllmAsk(p+'\\nIMPORTANT: fill each line with the real recipe — never repeat the instruction text.',sys)\n    .then(function(r){return parseRecipe(r||'')})})\n  .then(function(r){\n    current=r;renderRecipe(r);setStatus('');if(window.myllmHaptic)myllmHaptic('success');\n  }).catch(function(err){setStatus('Could not find a recipe: '+err.message)})\n  .then(function(){el('go').disabled=false});\n}\n\nfunction renderRecipe(r){\n  var box=el('recipe');box.style.display='block';\n  var meta=[r.servings,r.time].filter(Boolean).join(' · ');\n  box.innerHTML='<h2>'+esc(r.title)+'</h2>'+(meta?'<div class=\"serv\">'+esc(meta)+'</div>':'')+\n    '<h3>Ingredients</h3><ul>'+(r.ingredients||[]).map(function(x){return '<li>'+esc(x)+'</li>'}).join('')+'</ul>'+\n    '<h3>Method</h3><ol>'+(r.steps||[]).map(function(x){return '<li>'+esc(x)+'</li>'}).join('')+'</ol>'+\n    '<button class=\"save\" id=\"saveBtn\">♥ Save recipe</button>';\n  el('saveBtn').onclick=function(){saveCurrent()};\n  box.scrollIntoView({behavior:'smooth',block:'start'});\n}\nfunction saveCurrent(){\n  if(!current)return;\n  if(!saved.some(function(r){return r.title===current.title})){saved.unshift(current);persist();renderSaved()}\n  el('saveBtn').textContent='♥ Saved';el('saveBtn').disabled=true;\n  if(window.myllmHaptic)myllmHaptic('success');\n}\nfunction persist(){store.setItem('recipes',JSON.stringify(saved))}\nfunction renderSaved(){\n  var S=el('saved');S.innerHTML='';el('savedHead').style.display=saved.length?'block':'none';\n  saved.forEach(function(r,i){\n    var d=document.createElement('div');d.className='saved';\n    var sp=document.createElement('span');sp.textContent=r.title;sp.onclick=function(){current=r;renderRecipe(r)};\n    var x=document.createElement('button');x.className='del';x.textContent='✕';x.onclick=function(){saved.splice(i,1);persist();renderSaved()};\n    d.appendChild(sp);d.appendChild(x);S.appendChild(d);\n  });\n}\nel('q').addEventListener('keydown',function(e){if(e.key==='Enter')find()});\nstore.getItem('recipes').then(function(v){\n  if(v)try{saved=JSON.parse(v)}catch(e){}\n  renderSaved();\n  if(!window.myllmAsk)setStatus('Heads-up: this app needs the latest MyLLM with apps-AI enabled.');\n  return store.getItem('recipes.plant');\n}).then(function(v){ plant=!!v; renderDiet(); });\n</script></body></html>\n", "kind": "html", "iconSymbol": "frying.pan", "iconColor": "red"}