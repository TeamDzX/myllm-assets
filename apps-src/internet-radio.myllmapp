{"name": "Internet Radio", "kind": "html", "iconSymbol": "radio.fill", "iconColor": "orange", "html": "<!doctype html>\n<!--\n  Internet Radio — MyLLMos App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Internet Radio</title>\n<style>\n  :root { color-scheme: light dark; }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111);\n    max-width:600px; margin:0 auto; min-height:100dvh;\n    padding:16px 16px calc(30px + env(safe-area-inset-bottom));\n  }\n  h1{ font-size:22px; font-weight:800; margin:4px 2px 12px; }\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--myllm-muted,#8a8a8e); margin:18px 2px 10px; }\n\n  .card{\n    background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8);\n    border-radius:18px; padding:14px; margin-bottom:12px;\n  }\n\n  /* Now playing */\n  .np{ display:none; position:sticky; top:8px; z-index:5; box-shadow:0 6px 24px rgba(0,0,0,.10); }\n  .np.on{ display:block; }\n  .np .row{ display:flex; align-items:center; gap:12px; }\n  .np .art{ width:52px; height:52px; border-radius:12px; background:var(--myllm-bg,#f2f2f7); display:flex; align-items:center; justify-content:center; font-size:26px; overflow:hidden; flex-shrink:0; }\n  .np .art img{ width:100%; height:100%; object-fit:cover; }\n  .np .info{ flex:1; min-width:0; }\n  .np .name{ font-size:15.5px; font-weight:750; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .np .meta{ font-size:12px; color:var(--myllm-muted,#8a8a8e); margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .np .state{ font-size:12px; font-weight:700; margin-top:2px; }\n  .np .state.live{ color:#30d158; }\n  .np .state.err{ color:#ff453a; }\n  .npbtn{ width:46px; height:46px; border-radius:50%; border:none; flex-shrink:0;\n    background:var(--myllm-accent,#0a84ff); color:#fff; font-size:19px; }\n  .np .sub{ display:flex; align-items:center; gap:7px; margin-top:11px; flex-wrap:wrap; }\n  .np .sub button{\n    border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111); border-radius:99px; padding:5px 12px; font-size:12px; font-weight:650;\n  }\n  .np .sub button.hot{ background:var(--myllm-accent,#0a84ff); border-color:var(--myllm-accent,#0a84ff); color:#fff; }\n\n  /* EQ animation */\n  .eq{ display:inline-flex; align-items:flex-end; gap:2px; height:12px; margin-right:5px; vertical-align:-1px; }\n  .eq i{ width:3px; border-radius:2px; background:#30d158; animation:eq 1s ease-in-out infinite; }\n  .eq i:nth-child(2){ animation-delay:.25s; } .eq i:nth-child(3){ animation-delay:.5s; }\n  @keyframes eq{ 0%,100%{height:4px;} 50%{height:12px;} }\n  .paused .eq i{ animation-play-state:paused; height:4px; }\n\n  /* Search + chips */\n  .search{ display:flex; gap:8px; }\n  .search input{\n    flex:1; font-size:16px; padding:11px 12px; border-radius:12px;\n    border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-surface,#fff); color:var(--myllm-text,#111);\n  }\n  .search button{ border:none; border-radius:12px; padding:0 16px; font-size:15px; font-weight:700; background:var(--myllm-accent,#0a84ff); color:#fff; }\n  .chips{ display:flex; gap:7px; overflow-x:auto; -webkit-overflow-scrolling:touch; padding:10px 2px 2px; scrollbar-width:none; }\n  .chips::-webkit-scrollbar{ display:none; }\n  .chips button{\n    border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-surface,#fff); color:var(--myllm-text,#111);\n    border-radius:99px; padding:7px 14px; font-size:13px; font-weight:650; white-space:nowrap; flex-shrink:0;\n  }\n  .chips button.hot{ background:var(--myllm-accent,#0a84ff); border-color:var(--myllm-accent,#0a84ff); color:#fff; }\n\n  /* Station rows */\n  .st{ display:flex; align-items:center; gap:11px; padding:10px 2px; border-bottom:1px solid var(--myllm-border,#e3e3e8); }\n  .st:last-child{ border-bottom:none; }\n  .st .art{ width:42px; height:42px; border-radius:10px; background:var(--myllm-bg,#f2f2f7); display:flex; align-items:center; justify-content:center; font-size:20px; overflow:hidden; flex-shrink:0; }\n  .st .art img{ width:100%; height:100%; object-fit:cover; }\n  .st .info{ flex:1; min-width:0; }\n  .st .name{ font-size:14.5px; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .st .name .eq{ height:10px; } .st .name .eq i{ width:2.5px; }\n  .st .meta{ font-size:11.5px; color:var(--myllm-muted,#8a8a8e); margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .st .fav{ border:none; background:none; font-size:19px; padding:8px 4px 8px 10px; flex-shrink:0; color:var(--myllm-muted,#8a8a8e); }\n  .st .fav.on{ color:#ff453a; }\n\n  .status{ text-align:center; font-size:13.5px; color:var(--myllm-muted,#8a8a8e); padding:20px 12px; line-height:1.6; }\n  .note{ font-size:12.5px; color:var(--myllm-muted,#8a8a8e); margin:8px 2px; line-height:1.5; }\n</style>\n<style>:root{--build-id:\"10a3f90e08\";}</style>\n</head>\n<body>\n\n<h1>📻 Internet Radio</h1>\n\n<div class=\"card np paused\" id=\"np\">\n  <div class=\"row\">\n    <div class=\"art\" id=\"npArt\">📻</div>\n    <div class=\"info\">\n      <div class=\"name\" id=\"npName\"></div>\n      <div class=\"meta\" id=\"npMeta\"></div>\n      <div class=\"state\" id=\"npState\"></div>\n    </div>\n    <button class=\"npbtn\" id=\"npBtn\" onclick=\"toggle()\">▶</button>\n  </div>\n  <div class=\"sub\">\n    <button id=\"npFav\" onclick=\"favCurrent()\">♥ Favourite</button>\n    <button id=\"npSleep\" onclick=\"cycleSleep()\">Sleep: off</button>\n  </div>\n</div>\n\n<div class=\"search\">\n  <input id=\"q\" type=\"search\" placeholder=\"Search stations… (name or genre)\" autocomplete=\"off\">\n  <button onclick=\"doSearch()\">Go</button>\n</div>\n<div class=\"chips\" id=\"chips\"></div>\n\n<div id=\"favsWrap\" style=\"display:none\">\n  <h2>Favourites</h2>\n  <div class=\"card\" id=\"favs\"></div>\n</div>\n\n<h2 id=\"listTitle\">Popular stations</h2>\n<div class=\"card\" id=\"list\"><p class=\"status\">Tuning the dial…</p></div>\n\n<script>\nvar NET = window.myllmFetch || null;\nvar store = window.myllmStorage || {getItem:function(){return Promise.resolve(null)}, setItem:function(){return Promise.resolve()}};\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s==null?'':s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\"); }\n\nvar HOSTS = [\"de1.api.radio-browser.info\", \"de2.api.radio-browser.info\", \"all.api.radio-browser.info\"];\nvar hostIdx = 0;\n\n/* Verified HTTPS fallback presets — shown if the directory is unreachable */\nvar PRESETS = [\n  {stationuuid:\"p1\", name:\"Radio Paradise\", url_resolved:\"https://stream.radioparadise.com/mp3-192\", tags:\"eclectic,rock\", countrycode:\"US\", codec:\"MP3\", bitrate:192, favicon:\"\"},\n  {stationuuid:\"p2\", name:\"Radio Paradise Mellow\", url_resolved:\"https://stream.radioparadise.com/mellow-192\", tags:\"chill,mellow\", countrycode:\"US\", codec:\"MP3\", bitrate:192, favicon:\"\"},\n  {stationuuid:\"p3\", name:\"FIP\", url_resolved:\"https://icecast.radiofrance.fr/fip-midfi.mp3\", tags:\"eclectic,jazz\", countrycode:\"FR\", codec:\"MP3\", bitrate:128, favicon:\"\"},\n  {stationuuid:\"p4\", name:\"France Musique\", url_resolved:\"https://icecast.radiofrance.fr/francemusique-midfi.mp3\", tags:\"classical\", countrycode:\"FR\", codec:\"MP3\", bitrate:128, favicon:\"\"},\n  {stationuuid:\"p5\", name:\"Classic FM\", url_resolved:\"https://media-ssl.musicradio.com/ClassicFM\", tags:\"classical\", countrycode:\"GB\", codec:\"AAC\", bitrate:128, favicon:\"\"},\n  {stationuuid:\"p6\", name:\"KEXP\", url_resolved:\"https://kexp-mp3-128.streamguys1.com/kexp128.mp3\", tags:\"indie,alternative\", countrycode:\"US\", codec:\"MP3\", bitrate:128, favicon:\"\"}\n];\n\nvar GENRES = [\"Popular\",\"Jazz\",\"Lo-Fi\",\"Classical\",\"News\",\"Rock\",\"Electronic\",\"Chill\",\"80s\"];\nvar TAG = {\"Jazz\":\"jazz\",\"Lo-Fi\":\"lofi\",\"Classical\":\"classical\",\"News\":\"news\",\"Rock\":\"rock\",\"Electronic\":\"electronic\",\"Chill\":\"chillout\",\"80s\":\"80s\"};\n\nvar audio = new Audio();\naudio.preload = \"none\";\nvar current = null;        /* station object now loaded */\nvar favs = [];             /* array of station objects */\nvar results = [];          /* current list */\nvar sleepMins = 0, sleepTimer = null;\nvar activeChip = \"Popular\";\n\n/* ---------- directory ---------- */\n\nfunction api(path){\n  if (!NET) return Promise.reject(new Error(\"no net bridge\"));\n  var url = \"https://\" + HOSTS[hostIdx] + path;\n  return NET(url).then(function(r){\n    var j = JSON.parse(r.body);\n    if (!(j instanceof Array)) throw new Error(\"bad response\");\n    return j;\n  }).catch(function(e){\n    if (hostIdx < HOSTS.length - 1){ hostIdx++; return api(path); }\n    throw e;\n  });\n}\n\nfunction cleanStations(arr){\n  var seen = {}, out = [];\n  for (var i = 0; i < arr.length; i++){\n    var s = arr[i];\n    if (!s.url_resolved || s.url_resolved.indexOf(\"https://\") !== 0) continue;\n    if (seen[s.stationuuid]) continue;\n    seen[s.stationuuid] = 1;\n    out.push(s);\n  }\n  return out;\n}\n\nfunction fetchList(params, title){\n  el(\"listTitle\").textContent = title;\n  el(\"list\").innerHTML = '<p class=\"status\">Tuning the dial…</p>';\n  api(\"/json/stations/search?hidebroken=true&is_https=true&order=clickcount&reverse=true&limit=40&\" + params)\n    .then(function(arr){\n      results = cleanStations(arr);\n      renderList();\n    })\n    .catch(function(){\n      results = PRESETS.slice();\n      el(\"listTitle\").textContent = \"Staff picks (directory offline)\";\n      renderList();\n      el(\"list\").insertAdjacentHTML(\"beforebegin\",\n        '<p class=\"note\" id=\"offnote\">Couldn\\'t reach the station directory' +\n        (NET ? ' — showing a built-in selection instead.' : ' — this app needs internet access for apps (MyLLMos settings). The built-in stations below may still play.') + '</p>');\n    });\n}\n\nfunction doSearch(){\n  var q = el(\"q\").value.trim();\n  if (!q) return;\n  setChip(null);\n  fetchList(\"name=\" + encodeURIComponent(q), 'Results for \"' + q + '\"');\n}\n\nfunction pickGenre(g){\n  el(\"q\").value = \"\";\n  setChip(g);\n  if (g === \"Popular\") fetchList(\"\", \"Popular stations\");\n  else fetchList(\"tag=\" + encodeURIComponent(TAG[g]), g + \" stations\");\n}\n\n/* ---------- rendering ---------- */\n\nfunction metaLine(s){\n  var bits = [];\n  if (s.tags){ var t = String(s.tags).split(\",\").slice(0,2).join(\", \"); if (t) bits.push(t); }\n  if (s.countrycode) bits.push(s.countrycode);\n  if (s.bitrate) bits.push(s.bitrate + \" kbps\");\n  return bits.join(\" · \");\n}\n\nfunction artHtml(s, cls){\n  var fallback = '📻';\n  if (s.favicon && String(s.favicon).indexOf(\"https://\") === 0)\n    return '<div class=\"art\"><img src=\"' + esc(s.favicon) + '\" loading=\"lazy\" onerror=\"this.parentNode.textContent=\\'' + fallback + '\\'\"></div>';\n  return '<div class=\"art\">' + fallback + '</div>';\n}\n\nfunction isFav(s){ for (var i=0;i<favs.length;i++) if (favs[i].stationuuid === s.stationuuid) return true; return false; }\n\nfunction rowHtml(s, idx, listName){\n  var playing = current && current.stationuuid === s.stationuuid;\n  return '<div class=\"st\" data-i=\"' + idx + '\" data-l=\"' + listName + '\">' +\n    artHtml(s) +\n    '<div class=\"info\" onclick=\"playFrom(\\'' + listName + '\\',' + idx + ')\">' +\n      '<div class=\"name\">' + (playing ? '<span class=\"eq\"><i></i><i></i><i></i></span>' : '') + esc(s.name) + '</div>' +\n      '<div class=\"meta\">' + esc(metaLine(s)) + '</div>' +\n    '</div>' +\n    '<button class=\"fav' + (isFav(s) ? ' on' : '') + '\" onclick=\"toggleFav(\\'' + listName + '\\',' + idx + ')\">' + (isFav(s) ? '♥' : '♡') + '</button>' +\n  '</div>';\n}\n\nfunction renderList(){\n  if (!results.length){ el(\"list\").innerHTML = '<p class=\"status\">No stations found — try another search.</p>'; return; }\n  var h = \"\";\n  for (var i = 0; i < results.length; i++) h += rowHtml(results[i], i, \"r\");\n  el(\"list\").innerHTML = h;\n}\n\nfunction renderFavs(){\n  if (!favs.length){ el(\"favsWrap\").style.display = \"none\"; return; }\n  el(\"favsWrap\").style.display = \"block\";\n  var h = \"\";\n  for (var i = 0; i < favs.length; i++) h += rowHtml(favs[i], i, \"f\");\n  el(\"favs\").innerHTML = h;\n}\n\nfunction renderChips(){\n  var h = \"\";\n  for (var i = 0; i < GENRES.length; i++)\n    h += '<button' + (GENRES[i] === activeChip ? ' class=\"hot\"' : '') + ' onclick=\"pickGenre(\\'' + GENRES[i] + '\\')\">' + GENRES[i] + '</button>';\n  el(\"chips\").innerHTML = h;\n}\n\nfunction setChip(g){ activeChip = g; renderChips(); }\n\n/* ---------- playback ---------- */\n\nfunction playFrom(listName, idx){\n  var s = (listName === \"f\" ? favs : results)[idx];\n  if (!s) return;\n  play(s);\n}\n\nfunction play(s){\n  haptic(\"light\");\n  current = s;\n  audio.src = s.url_resolved;\n  audio.play();\n  el(\"np\").className = \"card np on\";\n  el(\"npName\").textContent = s.name;\n  el(\"npMeta\").textContent = metaLine(s);\n  el(\"npArt\").innerHTML = artHtml(s).replace(/^<div class=\"art\">|<\\/div>$/g, \"\");\n  el(\"npBtn\").textContent = \"◼\";\n  setState(\"Connecting…\", \"\");\n  updateNpFav();\n  renderList(); renderFavs();\n  store.setItem(\"radio_last\", JSON.stringify(s));\n  /* polite listen ping so the directory's popularity counts stay honest */\n  if (NET && String(s.stationuuid).length > 8)\n    NET(\"https://\" + HOSTS[hostIdx] + \"/json/url/\" + s.stationuuid).catch(function(){});\n}\n\nfunction stop(){\n  audio.pause();\n  audio.removeAttribute(\"src\");\n  try { audio.load(); } catch(_){}\n  el(\"npBtn\").textContent = \"▶\";\n  el(\"np\").classList.add(\"paused\");\n  setState(\"Stopped\", \"\");\n}\n\nfunction toggle(){\n  haptic(\"light\");\n  if (!current) return;\n  if (audio.paused) play(current); else stop();\n}\n\nfunction setState(txt, cls){\n  el(\"npState\").textContent = txt;\n  el(\"npState\").className = \"state\" + (cls ? \" \" + cls : \"\");\n}\n\naudio.addEventListener(\"waiting\", function(){ setState(\"Buffering…\", \"\"); el(\"np\").classList.add(\"paused\"); });\naudio.addEventListener(\"playing\", function(){ setState(\"● Live\", \"live\"); el(\"np\").classList.remove(\"paused\"); });\naudio.addEventListener(\"error\", function(){\n  if (!current) return;\n  setState(\"Station didn't respond — try another\", \"err\");\n  el(\"npBtn\").textContent = \"▶\";\n  el(\"np\").classList.add(\"paused\");\n});\n\n/* ---------- favourites ---------- */\n\nfunction slim(s){\n  return {stationuuid:s.stationuuid, name:s.name, url_resolved:s.url_resolved,\n          tags:s.tags, countrycode:s.countrycode, codec:s.codec, bitrate:s.bitrate, favicon:s.favicon};\n}\n\nfunction toggleFav(listName, idx){\n  var s = (listName === \"f\" ? favs : results)[idx];\n  if (!s) return;\n  haptic(\"medium\");\n  setFav(s, !isFav(s));\n}\n\nfunction favCurrent(){ if (current){ haptic(\"medium\"); setFav(current, !isFav(current)); } }\n\nfunction setFav(s, on){\n  if (on) favs.unshift(slim(s));\n  else favs = favs.filter(function(f){ return f.stationuuid !== s.stationuuid; });\n  store.setItem(\"radio_favs\", JSON.stringify(favs));\n  renderFavs(); renderList(); updateNpFav();\n}\n\nfunction updateNpFav(){\n  if (!current) return;\n  var on = isFav(current);\n  el(\"npFav\").textContent = on ? \"♥ Favourited\" : \"♡ Favourite\";\n  el(\"npFav\").className = on ? \"hot\" : \"\";\n}\n\n/* ---------- sleep timer ---------- */\n\nvar SLEEPS = [0, 15, 30, 60];\nfunction cycleSleep(){\n  haptic(\"light\");\n  sleepMins = SLEEPS[(SLEEPS.indexOf(sleepMins) + 1) % SLEEPS.length];\n  if (sleepTimer){ clearTimeout(sleepTimer); sleepTimer = null; }\n  if (sleepMins){\n    sleepTimer = setTimeout(function(){ stop(); sleepMins = 0; el(\"npSleep\").textContent = \"Sleep: off\"; el(\"npSleep\").className = \"\"; }, sleepMins * 60000);\n  }\n  el(\"npSleep\").textContent = sleepMins ? \"Sleep: \" + sleepMins + \"m\" : \"Sleep: off\";\n  el(\"npSleep\").className = sleepMins ? \"hot\" : \"\";\n}\n\n/* ---------- boot ---------- */\n\nel(\"q\").addEventListener(\"keydown\", function(e){ if (e.key === \"Enter\"){ doSearch(); this.blur(); } });\n\nrenderChips();\nstore.getItem(\"radio_favs\").then(function(v){\n  if (v){ try { favs = JSON.parse(v) || []; } catch(_){} }\n  renderFavs();\n});\nstore.getItem(\"radio_last\").then(function(v){\n  if (v){ try {\n    var s = JSON.parse(v);\n    current = s;\n    el(\"np\").className = \"card np on paused\";\n    el(\"npName\").textContent = s.name;\n    el(\"npMeta\").textContent = metaLine(s);\n    el(\"npArt\").innerHTML = artHtml(s).replace(/^<div class=\"art\">|<\\/div>$/g, \"\");\n    el(\"npBtn\").textContent = \"▶\";\n    setState(\"Tap to resume\", \"\");\n    updateNpFav();\n  } catch(_){} }\n});\nfetchList(\"\", \"Popular stations\");\n</script>\n</body>\n</html>\n"}