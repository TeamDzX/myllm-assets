{"name": "Internet Radio", "kind": "html", "iconSymbol": "radio.fill", "iconColor": "orange", "html": "<!doctype html>\n<!--\n  Internet Radio — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Internet Radio</title>\n<style>\n  :root { color-scheme: light dark; }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111);\n    max-width:600px; margin:0 auto; min-height:100dvh;\n    padding:16px 16px calc(30px + env(safe-area-inset-bottom));\n  }\n  h1{ font-size:22px; font-weight:800; margin:4px 2px 12px; }\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--myllm-muted,#8a8a8e); margin:18px 2px 10px; }\n\n  .card{\n    background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8);\n    border-radius:18px; padding:14px; margin-bottom:12px;\n  }\n\n  /* Now playing */\n  .np{ display:none; position:sticky; top:8px; z-index:5; box-shadow:0 6px 24px rgba(0,0,0,.10); }\n  .np.on{ display:block; }\n  .np .row{ display:flex; align-items:center; gap:12px; }\n  .np .art{ width:52px; height:52px; border-radius:12px; background:var(--myllm-bg,#f2f2f7); display:flex; align-items:center; justify-content:center; font-size:26px; overflow:hidden; flex-shrink:0; }\n  .np .art img{ width:100%; height:100%; object-fit:cover; }\n  .np .info{ flex:1; min-width:0; }\n  .np .name{ font-size:15.5px; font-weight:750; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .np .meta{ font-size:12px; color:var(--myllm-muted,#8a8a8e); margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .np .state{ font-size:12px; font-weight:700; margin-top:2px; }\n  .np .state.live{ color:#30d158; }\n  .np .state.err{ color:#ff453a; }\n  .npbtn{ width:46px; height:46px; border-radius:50%; border:none; flex-shrink:0;\n    background:var(--myllm-accent,#0a84ff); color:#fff; font-size:19px; }\n  .np .sub{ display:flex; align-items:center; gap:7px; margin-top:11px; flex-wrap:wrap; }\n  .np .sub button{\n    border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111); border-radius:99px; padding:5px 12px; font-size:12px; font-weight:650;\n  }\n  .np .sub button.hot{ background:var(--myllm-accent,#0a84ff); border-color:var(--myllm-accent,#0a84ff); color:#fff; }\n\n  /* EQ animation */\n  .eq{ display:inline-flex; align-items:flex-end; gap:2px; height:12px; margin-right:5px; vertical-align:-1px; }\n  .eq i{ width:3px; border-radius:2px; background:#30d158; animation:eq 1s ease-in-out infinite; }\n  .eq i:nth-child(2){ animation-delay:.25s; } .eq i:nth-child(3){ animation-delay:.5s; }\n  @keyframes eq{ 0%,100%{height:4px;} 50%{height:12px;} }\n  .paused .eq i{ animation-play-state:paused; height:4px; }\n\n  /* Search + chips */\n  .search{ display:flex; gap:8px; }\n  .search input{\n    flex:1; font-size:16px; padding:11px 12px; border-radius:12px;\n    border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-surface,#fff); color:var(--myllm-text,#111);\n  }\n  .search button{ border:none; border-radius:12px; padding:0 16px; font-size:15px; font-weight:700; background:var(--myllm-accent,#0a84ff); color:#fff; }\n  .chips{ display:flex; gap:7px; overflow-x:auto; -webkit-overflow-scrolling:touch; padding:10px 2px 2px; scrollbar-width:none; }\n  .chips::-webkit-scrollbar{ display:none; }\n  .chips button{\n    border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-surface,#fff); color:var(--myllm-text,#111);\n    border-radius:99px; padding:7px 14px; font-size:13px; font-weight:650; white-space:nowrap; flex-shrink:0;\n  }\n  .chips button.hot{ background:var(--myllm-accent,#0a84ff); border-color:var(--myllm-accent,#0a84ff); color:#fff; }\n\n  /* Station rows */\n  .st{ display:flex; align-items:center; gap:11px; padding:10px 2px; border-bottom:1px solid var(--myllm-border,#e3e3e8); }\n  .st:last-child{ border-bottom:none; }\n  .st .art{ width:42px; height:42px; border-radius:10px; background:var(--myllm-bg,#f2f2f7); display:flex; align-items:center; justify-content:center; font-size:20px; overflow:hidden; flex-shrink:0; }\n  .st .art img{ width:100%; height:100%; object-fit:cover; }\n  .st .info{ flex:1; min-width:0; }\n  .st .name{ font-size:14.5px; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .st .name .eq{ height:10px; } .st .name .eq i{ width:2.5px; }\n  .st .meta{ font-size:11.5px; color:var(--myllm-muted,#8a8a8e); margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .st .fav{ border:none; background:none; font-size:19px; padding:8px 4px 8px 10px; flex-shrink:0; color:var(--myllm-muted,#8a8a8e); }\n  .st .fav.on{ color:#ff453a; }\n\n  /* Playing mode: full-screen now-playing, and the dock */\n  .np .info{ cursor:pointer; }\n  .np .track{ font-size:12.5px; color:var(--myllm-text,#111); margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:none; }\n  .np .track.on{ display:block; }\n  body.lock{ overflow:hidden; }\n\n  /* Station art: a hue-tinted tile carrying the station's initials; the logo\n     sits on top when there is one. Directory logos are often 32px favicons,\n     so a small one is shown small on the tile rather than stretched to mush. */\n  .tile{ position:relative; display:flex; align-items:center; justify-content:center; overflow:hidden;\n    background:linear-gradient(145deg, hsl(var(--h,215) 62% 46%), hsl(calc(var(--h,215) + 40) 58% 24%)); }\n  .tile .ini{ font-weight:800; color:rgba(255,255,255,.92); letter-spacing:.02em; }\n  .tile img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0; transition:opacity .35s; }\n  .tile img.ok{ opacity:1; }\n  .tile img.sm{ inset:auto; width:46%; height:46%; object-fit:contain; border-radius:16%; box-shadow:0 6px 22px rgba(0,0,0,.35); }\n\n  .full{ display:none; position:fixed; inset:0; z-index:50; color:#fff; overflow:hidden;\n    background:radial-gradient(120% 90% at 20% 10%, hsl(var(--h,215) 70% 42%), transparent 60%),\n      radial-gradient(120% 90% at 85% 95%, hsl(calc(var(--h,215) + 60) 65% 34%), transparent 62%), #0b0b10; }\n  .full.on{ display:block; }\n  .full .fbg{ position:absolute; inset:-12%; background-size:cover; background-position:center; filter:blur(46px) saturate(1.6); transform:scale(1.15); opacity:0; transition:opacity .6s; }\n  .full .fbg.art{ opacity:.5; }\n  .full .scrim{ position:absolute; inset:0; background:linear-gradient(180deg, rgba(8,8,12,.42) 0%, rgba(8,8,12,.58) 45%, rgba(8,8,12,.86) 100%); }\n  .full .stage{ position:absolute; inset:0; overflow-y:auto; -webkit-overflow-scrolling:touch; display:flex; flex-direction:column; align-items:center; text-align:center;\n    padding:calc(12px + env(safe-area-inset-top)) 24px calc(24px + env(safe-area-inset-bottom)); }\n  .full .top{ width:100%; max-width:520px; display:flex; justify-content:space-between; align-items:center; flex-shrink:0; }\n  .full .top .lbl{ font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; color:rgba(255,255,255,.62); }\n  .glass{ border:1px solid rgba(255,255,255,.16); background:rgba(255,255,255,.12); color:#fff;\n    -webkit-backdrop-filter:blur(18px); backdrop-filter:blur(18px); }\n  .full .top button{ height:40px; min-width:40px; border-radius:99px; padding:0 14px; font-size:13.5px; font-weight:700; display:inline-flex; align-items:center; justify-content:center; gap:7px; }\n  .full .top button.rnd{ padding:0; }\n  .full svg, .dock svg{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n\n  .full .bigart{ width:min(66vw,290px,38vh); height:min(66vw,290px,38vh); border-radius:30px; margin:auto 0 22px; flex-shrink:0;\n    box-shadow:0 24px 60px rgba(0,0,0,.5), 0 0 0 1px rgba(255,255,255,.08); transition:transform .6s cubic-bezier(.2,.8,.2,1); transform:scale(.9); }\n  .full.live .bigart{ transform:scale(1); }\n  .full .bigart .ini{ font-size:min(22vw,96px); }\n\n  .full .fstate{ display:inline-flex; align-items:center; gap:7px; font-size:11.5px; font-weight:800; letter-spacing:.12em; text-transform:uppercase;\n    color:rgba(255,255,255,.7); min-height:16px; flex-shrink:0; }\n  .full .fstate.live{ color:#4be07d; } .full .fstate.err{ color:#ff6b62; letter-spacing:.02em; text-transform:none; font-size:13.5px; }\n  .full .fstate .eq{ display:none; margin:0; } .full .fstate.live .eq{ display:inline-flex; }\n  .full .fstate .eq i{ background:#4be07d; }\n\n  .full .ftitle{ font-size:25px; font-weight:800; line-height:1.18; margin-top:10px; max-width:520px; letter-spacing:-.01em;\n    display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; flex-shrink:0; }\n  .full .fartist{ font-size:17px; font-weight:600; color:rgba(255,255,255,.78); margin-top:5px; max-width:520px; flex-shrink:0; }\n  .full .fartist:empty{ display:none; }\n  .full .fmeta{ font-size:13px; color:rgba(255,255,255,.55); margin-top:8px; max-width:520px; flex-shrink:0; }\n  .full .swap{ animation:swap .5s ease both; }\n  @keyframes swap{ from{ opacity:0; transform:translateY(8px); } to{ opacity:1; transform:none; } }\n\n  .full .ctl{ display:flex; align-items:center; justify-content:center; gap:26px; margin:26px 0 8px; flex-shrink:0; }\n  .full .ctl button{ border-radius:50%; display:flex; align-items:center; justify-content:center; position:relative; }\n  .full .ctl .side{ width:56px; height:56px; font-size:19px; }\n  .full .ctl .side.hot{ background:#fff; color:#111; border-color:#fff; }\n  .full .ctl #fFav.hot{ background:#ff453a; border-color:#ff453a; color:#fff; }\n  .full .ctl .fbtn{ width:84px; height:84px; border:none; background:#fff; color:#0b0b10; font-size:28px; box-shadow:0 10px 30px rgba(0,0,0,.35); }\n  .full .ctl .fbtn:active, .full .ctl .side:active{ transform:scale(.94); }\n  .full .ctl .badge{ position:absolute; right:-4px; top:-4px; min-width:24px; height:20px; padding:0 5px; border-radius:99px; background:#0a84ff; color:#fff;\n    font-size:10.5px; font-weight:800; line-height:20px; display:none; }\n  .full .ctl .hot .badge{ display:block; }\n\n  .full .earlier{ width:100%; max-width:520px; margin:18px 0 auto; text-align:left; border-radius:18px; padding:4px 14px; display:none; flex-shrink:0; }\n  .full .earlier.on{ display:block; }\n  .full .earlier h3{ font-size:10.5px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; color:rgba(255,255,255,.55); margin:10px 0 2px; }\n  .full .earlier .row{ display:flex; gap:12px; align-items:baseline; padding:8px 0; border-top:1px solid rgba(255,255,255,.1); font-size:13.5px; }\n  .full .earlier .row:first-of-type{ border-top:none; }\n  .full .earlier .when{ color:rgba(255,255,255,.5); font-variant-numeric:tabular-nums; font-size:12px; flex-shrink:0; }\n  .full .earlier .what{ min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .full .spacer{ margin-bottom:auto; }\n\n  /* Light variant: on a MyLLM build that can't hide its title bar, a dark\n     stage under a white bar looks cut in half — so in light mode, without\n     myllmImmersive, playing mode stays light and runs on from the bar. */\n  .full.lite{ color:#15151a;\n    background:radial-gradient(120% 90% at 20% 0%, hsl(var(--h,215) 85% 86%), transparent 60%),\n      radial-gradient(120% 90% at 85% 95%, hsl(calc(var(--h,215) + 60) 80% 84%), transparent 62%), #f4f4f8; }\n  .full.lite .scrim{ background:linear-gradient(180deg, rgba(255,255,255,.55) 0%, rgba(255,255,255,.3) 40%, rgba(255,255,255,.72) 100%); }\n  .full.lite .fbg.art{ opacity:.32; }\n  .full.lite .glass{ border-color:rgba(0,0,0,.09); background:rgba(255,255,255,.62); color:#15151a; }\n  .full.lite .top .lbl, .full.lite .fmeta, .full.lite .earlier h3, .full.lite .earlier .when{ color:rgba(0,0,0,.5); }\n  .full.lite .fartist{ color:rgba(0,0,0,.68); }\n  .full.lite .fstate{ color:rgba(0,0,0,.5); } .full.lite .fstate.live{ color:#1c9a4a; } .full.lite .fstate.err{ color:#d92d20; }\n  .full.lite .fstate .eq i{ background:#1c9a4a; }\n  .full.lite .bigart{ box-shadow:0 22px 50px rgba(20,20,40,.22), 0 0 0 1px rgba(0,0,0,.05); }\n  .full.lite .ctl .fbtn{ background:#15151a; color:#fff; box-shadow:0 10px 26px rgba(20,20,40,.25); }\n  .full.lite .ctl .side.hot{ background:#15151a; border-color:#15151a; color:#fff; }\n  .full.lite .ctl #fFav.hot{ background:#ff453a; border-color:#ff453a; }\n  .full.lite .earlier .row{ border-top-color:rgba(0,0,0,.08); }\n\n  /* Dock: true black edge to edge, everything dim, drifting against burn-in */\n  .dock{ display:none; position:fixed; inset:0; z-index:60; background:#000; color:#fff; overflow:hidden; }\n  .dock.on{ display:block; }\n  .dock .drift{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px; padding:0 24px; text-align:center;\n    transition:transform 20s ease-in-out; }\n  .dock .dclock{ font-size:min(27vw,150px); font-weight:200; letter-spacing:.01em; line-height:1; color:#c9c9cf; font-variant-numeric:tabular-nums; }\n  .dock .ddate{ font-size:14px; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:#5d5d66; margin-bottom:18px; }\n  .dock .drow{ display:flex; align-items:center; gap:12px; max-width:min(86vw,520px); text-align:left; }\n  .dock .dart{ width:50px; height:50px; border-radius:13px; flex-shrink:0; opacity:.7; }\n  .dock .dart .ini{ font-size:19px; }\n  .dock .dtxt{ min-width:0; }\n  .dock .dtrack{ font-size:16px; font-weight:650; color:#a9a9b2; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .dock .dname{ font-size:13.5px; color:#6a6a74; font-weight:600; margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .dock .dname .eq{ height:9px; opacity:.8; } .dock .dname .eq i{ width:2.5px; background:#3fae63; }\n  .dock .dstate.err{ color:#ff453a; }\n  .dock .ctl{ position:absolute; left:0; right:0; bottom:calc(30px + env(safe-area-inset-bottom)); display:flex; justify-content:center; gap:12px;\n    opacity:0; transition:opacity .3s; pointer-events:none; }\n  .dock .ctl.on{ opacity:1; pointer-events:auto; }\n  .dock .ctl button{ border:1px solid #2c2c33; background:#121216; color:#eee; border-radius:99px; padding:12px 22px; font-size:15px; font-weight:700; display:inline-flex; align-items:center; gap:8px; }\n  .dock .hint{ position:absolute; bottom:calc(34px + env(safe-area-inset-bottom)); left:0; right:0; text-align:center; font-size:12px; color:#4a4a52; transition:opacity .6s; }\n  @media (orientation:landscape){\n    .dock .dclock{ font-size:min(30vh,170px); }\n    .full .stage{ padding-left:calc(24px + env(safe-area-inset-left)); padding-right:calc(24px + env(safe-area-inset-right)); }\n  }\n  @media (prefers-reduced-motion:reduce){\n    .full .bigart, .tile img{ transition:none; } .full .swap{ animation:none; } .eq i{ animation:none; }\n  }\n\n  .status{ text-align:center; font-size:13.5px; color:var(--myllm-muted,#8a8a8e); padding:20px 12px; line-height:1.6; }\n  .note{ font-size:12.5px; color:var(--myllm-muted,#8a8a8e); margin:8px 2px; line-height:1.5; }\n</style>\n<style>:root{--build-id:\"10a3f90e08\";}</style>\n</head>\n<body>\n\n<h1>📻 Internet Radio</h1>\n\n<div class=\"card np paused\" id=\"np\">\n  <div class=\"row\">\n    <div class=\"art\" id=\"npArt\">📻</div>\n    <div class=\"info\" onclick=\"openFull()\" title=\"Open playing mode\">\n      <div class=\"name\" id=\"npName\"></div>\n      <div class=\"meta\" id=\"npMeta\"></div>\n      <div class=\"track\" id=\"npTrack\"></div>\n      <div class=\"state\" id=\"npState\"></div>\n    </div>\n    <button class=\"npbtn\" id=\"npBtn\" onclick=\"toggle()\">▶</button>\n  </div>\n  <div class=\"sub\">\n    <button id=\"npFav\" onclick=\"favCurrent()\">♥ Favourite</button>\n    <button id=\"npSleep\" onclick=\"cycleSleep()\">Sleep: off</button>\n    <button onclick=\"openFull()\">Playing mode</button>\n  </div>\n</div>\n\n<!-- Icons (inline: ▶ ◼ ♥ turn into emoji on iOS) -->\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\">\n  <symbol id=\"i-play\" viewBox=\"0 0 24 24\"><path d=\"M8 5.2v13.6a1 1 0 0 0 1.5.9l11-6.8a1 1 0 0 0 0-1.8l-11-6.8A1 1 0 0 0 8 5.2z\"/></symbol>\n  <symbol id=\"i-stop\" viewBox=\"0 0 24 24\"><rect x=\"6\" y=\"6\" width=\"12\" height=\"12\" rx=\"2.5\"/></symbol>\n  <symbol id=\"i-heart\" viewBox=\"0 0 24 24\"><path d=\"M12 20.6s-7.6-4.5-9.4-9.3C1.3 7.700 3.500 4.500 6.900 4.500c2 0 3.700 1 5.100 2.800 1.400-1.800 3.100-2.800 5.100-2.800 3.400 0 5.600 3.200 4.300 6.800-1.800 4.800-9.400 9.300-9.400 9.300z\"/></symbol>\n  <symbol id=\"i-moon\" viewBox=\"0 0 24 24\"><path d=\"M20.300 14.900A8.500 8.500 0 0 1 9.100 3.700a.7.7 0 0 0-.9-.9 9.900 9.900 0 1 0 13 13 .7.7 0 0 0-.9-.9z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M5.300 8.800a1.200 1.200 0 0 1 1.700 0l5 5 5-5a1.200 1.200 0 1 1 1.700 1.700l-5.850 5.850a1.200 1.200 0 0 1-1.700 0L5.300 10.500a1.200 1.200 0 0 1 0-1.700z\"/></symbol>\n  <symbol id=\"i-dock\" viewBox=\"0 0 24 24\"><path d=\"M12 3.500a8.500 8.500 0 1 0 0 17 8.500 8.500 0 0 0 0-17zm0 1.900a6.600 6.600 0 1 1 0 13.200 6.600 6.600 0 0 1 0-13.200zm0 1.800a.95.95 0 0 0-.95.95V12c0 .250.100.490.280.670l2.500 2.500a.95.95 0 0 0 1.340-1.340l-2.220-2.220V8.150A.95.95 0 0 0 12 7.200z\"/></symbol>\n</svg>\n\n<!-- Playing mode: full-screen now-playing -->\n<div class=\"full\" id=\"full\">\n  <div class=\"fbg\" id=\"fBg\"></div>\n  <div class=\"scrim\"></div>\n  <div class=\"stage\">\n    <div class=\"top\">\n      <button class=\"glass rnd\" onclick=\"closeFull()\" aria-label=\"Back to stations\"><svg><use href=\"#i-down\"/></svg></button>\n      <span class=\"lbl\">Now playing</span>\n      <button class=\"glass\" onclick=\"openDock()\"><svg><use href=\"#i-dock\"/></svg>Dock</button>\n    </div>\n    <div class=\"bigart tile\" id=\"fArt\"></div>\n    <div class=\"fstate\" id=\"fState\"><span class=\"eq\"><i></i><i></i><i></i></span><span id=\"fStateTxt\"></span></div>\n    <div class=\"ftitle\" id=\"fTitle\" onclick=\"shareTrack()\"></div>\n    <div class=\"fartist\" id=\"fArtist\"></div>\n    <div class=\"fmeta\" id=\"fMeta\"></div>\n    <div class=\"ctl\">\n      <button class=\"glass side\" id=\"fFav\" onclick=\"favCurrent()\" aria-label=\"Favourite\"><svg><use href=\"#i-heart\"/></svg></button>\n      <button class=\"fbtn\" id=\"fBtn\" onclick=\"toggle()\" aria-label=\"Play or stop\"><svg><use href=\"#i-play\"/></svg></button>\n      <button class=\"glass side\" id=\"fSleep\" onclick=\"cycleSleep()\" aria-label=\"Sleep timer\"><svg><use href=\"#i-moon\"/></svg><span class=\"badge\" id=\"fSleepN\"></span></button>\n    </div>\n    <div class=\"earlier glass\" id=\"fEarlier\"></div>\n    <div class=\"spacer\"></div>\n  </div>\n</div>\n\n<!-- Dock mode: true black, dimmed, drifts to avoid burn-in, keeps the screen awake -->\n<div class=\"dock\" id=\"dock\" onclick=\"dockTap()\">\n  <div class=\"drift\" id=\"dDrift\">\n    <div class=\"dclock\" id=\"dClock\">--:--</div>\n    <div class=\"ddate\" id=\"dDate\"></div>\n    <div class=\"drow\">\n      <div class=\"dart tile\" id=\"dArt\"></div>\n      <div class=\"dtxt\">\n        <div class=\"dtrack\" id=\"dTrack\"></div>\n        <div class=\"dname\"><span class=\"eq\" id=\"dEq\"><i></i><i></i><i></i></span><span id=\"dName\"></span> <span class=\"dstate\" id=\"dState\"></span></div>\n      </div>\n    </div>\n  </div>\n  <div class=\"hint\" id=\"dHint\">Tap for controls</div>\n  <div class=\"ctl\" id=\"dCtl\">\n    <button onclick=\"toggle();event.stopPropagation()\" id=\"dBtn\"></button>\n    <button onclick=\"closeDock();event.stopPropagation()\">Exit dock</button>\n  </div>\n</div>\n\n<div class=\"search\">\n  <input id=\"q\" type=\"search\" placeholder=\"Search stations… (name or genre)\" autocomplete=\"off\">\n  <button onclick=\"doSearch()\">Go</button>\n</div>\n<div class=\"chips\" id=\"chips\"></div>\n\n<div id=\"favsWrap\" style=\"display:none\">\n  <h2>Favourites</h2>\n  <div class=\"card\" id=\"favs\"></div>\n</div>\n\n<h2 id=\"listTitle\">Popular stations</h2>\n<div class=\"card\" id=\"list\"><p class=\"status\">Tuning the dial…</p></div>\n\n<script>\nvar NET = window.myllmFetch || null;\nvar store = window.myllmStorage || {getItem:function(){return Promise.resolve(null)}, setItem:function(){return Promise.resolve()}};\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s==null?'':s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\"); }\n\nvar HOSTS = [\"de1.api.radio-browser.info\", \"de2.api.radio-browser.info\", \"all.api.radio-browser.info\"];\nvar hostIdx = 0;\n\n/* Verified HTTPS fallback presets — shown if the directory is unreachable */\nvar PRESETS = [\n  {stationuuid:\"p1\", name:\"Radio Paradise\", url_resolved:\"https://stream.radioparadise.com/mp3-192\", tags:\"eclectic,rock\", countrycode:\"US\", codec:\"MP3\", bitrate:192, favicon:\"\"},\n  {stationuuid:\"p2\", name:\"Radio Paradise Mellow\", url_resolved:\"https://stream.radioparadise.com/mellow-192\", tags:\"chill,mellow\", countrycode:\"US\", codec:\"MP3\", bitrate:192, favicon:\"\"},\n  {stationuuid:\"p3\", name:\"FIP\", url_resolved:\"https://icecast.radiofrance.fr/fip-midfi.mp3\", tags:\"eclectic,jazz\", countrycode:\"FR\", codec:\"MP3\", bitrate:128, favicon:\"\"},\n  {stationuuid:\"p4\", name:\"France Musique\", url_resolved:\"https://icecast.radiofrance.fr/francemusique-midfi.mp3\", tags:\"classical\", countrycode:\"FR\", codec:\"MP3\", bitrate:128, favicon:\"\"},\n  {stationuuid:\"p5\", name:\"Classic FM\", url_resolved:\"https://media-ssl.musicradio.com/ClassicFM\", tags:\"classical\", countrycode:\"GB\", codec:\"AAC\", bitrate:128, favicon:\"\"},\n  {stationuuid:\"p6\", name:\"KEXP\", url_resolved:\"https://kexp-mp3-128.streamguys1.com/kexp128.mp3\", tags:\"indie,alternative\", countrycode:\"US\", codec:\"MP3\", bitrate:128, favicon:\"\"}\n];\n\nvar GENRES = [\"Popular\",\"Jazz\",\"Lo-Fi\",\"Classical\",\"News\",\"Rock\",\"Electronic\",\"Chill\",\"80s\"];\nvar TAG = {\"Jazz\":\"jazz\",\"Lo-Fi\":\"lofi\",\"Classical\":\"classical\",\"News\":\"news\",\"Rock\":\"rock\",\"Electronic\":\"electronic\",\"Chill\":\"chillout\",\"80s\":\"80s\"};\n\nvar audio = new Audio();\naudio.preload = \"none\";\nvar current = null;        /* station object now loaded */\nvar favs = [];             /* array of station objects */\nvar results = [];          /* current list */\nvar sleepMins = 0, sleepTimer = null;\nvar activeChip = \"Popular\";\n\n/* ---------- directory ---------- */\n\nfunction api(path){\n  if (!NET) return Promise.reject(new Error(\"no net bridge\"));\n  var url = \"https://\" + HOSTS[hostIdx] + path;\n  return NET(url).then(function(r){\n    var j = JSON.parse(r.body);\n    if (!(j instanceof Array)) throw new Error(\"bad response\");\n    return j;\n  }).catch(function(e){\n    if (hostIdx < HOSTS.length - 1){ hostIdx++; return api(path); }\n    throw e;\n  });\n}\n\nfunction cleanStations(arr){\n  var seen = {}, out = [];\n  for (var i = 0; i < arr.length; i++){\n    var s = arr[i];\n    if (!s.url_resolved || s.url_resolved.indexOf(\"https://\") !== 0) continue;\n    if (seen[s.stationuuid]) continue;\n    seen[s.stationuuid] = 1;\n    out.push(s);\n  }\n  return out;\n}\n\nfunction fetchList(params, title){\n  el(\"listTitle\").textContent = title;\n  el(\"list\").innerHTML = '<p class=\"status\">Tuning the dial…</p>';\n  api(\"/json/stations/search?hidebroken=true&is_https=true&order=clickcount&reverse=true&limit=40&\" + params)\n    .then(function(arr){\n      results = cleanStations(arr);\n      renderList();\n    })\n    .catch(function(){\n      results = PRESETS.slice();\n      el(\"listTitle\").textContent = \"Staff picks (directory offline)\";\n      renderList();\n      el(\"list\").insertAdjacentHTML(\"beforebegin\",\n        '<p class=\"note\" id=\"offnote\">Couldn\\'t reach the station directory' +\n        (NET ? ' — showing a built-in selection instead.' : ' — this app needs internet access for apps (MyLLMos settings). The built-in stations below may still play.') + '</p>');\n    });\n}\n\nfunction doSearch(){\n  var q = el(\"q\").value.trim();\n  if (!q) return;\n  setChip(null);\n  fetchList(\"name=\" + encodeURIComponent(q), 'Results for \"' + q + '\"');\n}\n\nfunction pickGenre(g){\n  el(\"q\").value = \"\";\n  setChip(g);\n  if (g === \"Popular\") fetchList(\"\", \"Popular stations\");\n  else fetchList(\"tag=\" + encodeURIComponent(TAG[g]), g + \" stations\");\n}\n\n/* ---------- rendering ---------- */\n\nfunction metaLine(s){\n  var bits = [];\n  if (s.tags){ var t = String(s.tags).split(\",\").slice(0,2).join(\", \"); if (t) bits.push(t); }\n  if (s.countrycode) bits.push(s.countrycode);\n  if (s.bitrate) bits.push(s.bitrate + \" kbps\");\n  return bits.join(\" · \");\n}\n\nfunction artHtml(s, cls){\n  var fallback = '📻';\n  if (s.favicon && String(s.favicon).indexOf(\"https://\") === 0)\n    return '<div class=\"art\"><img src=\"' + esc(s.favicon) + '\" loading=\"lazy\" onerror=\"if(this.parentNode)this.parentNode.textContent=\\'' + fallback + '\\'\"></div>';\n  return '<div class=\"art\">' + fallback + '</div>';\n}\n\nfunction isFav(s){ for (var i=0;i<favs.length;i++) if (favs[i].stationuuid === s.stationuuid) return true; return false; }\n\nfunction rowHtml(s, idx, listName){\n  var playing = current && current.stationuuid === s.stationuuid;\n  return '<div class=\"st\" data-i=\"' + idx + '\" data-l=\"' + listName + '\">' +\n    artHtml(s) +\n    '<div class=\"info\" onclick=\"playFrom(\\'' + listName + '\\',' + idx + ')\">' +\n      '<div class=\"name\">' + (playing ? '<span class=\"eq\"><i></i><i></i><i></i></span>' : '') + esc(s.name) + '</div>' +\n      '<div class=\"meta\">' + esc(metaLine(s)) + '</div>' +\n    '</div>' +\n    '<button class=\"fav' + (isFav(s) ? ' on' : '') + '\" onclick=\"toggleFav(\\'' + listName + '\\',' + idx + ')\">' + (isFav(s) ? '♥' : '♡') + '</button>' +\n  '</div>';\n}\n\nfunction renderList(){\n  if (!results.length){ el(\"list\").innerHTML = '<p class=\"status\">No stations found — try another search.</p>'; return; }\n  var h = \"\";\n  for (var i = 0; i < results.length; i++) h += rowHtml(results[i], i, \"r\");\n  el(\"list\").innerHTML = h;\n}\n\nfunction renderFavs(){\n  if (!favs.length){ el(\"favsWrap\").style.display = \"none\"; return; }\n  el(\"favsWrap\").style.display = \"block\";\n  var h = \"\";\n  for (var i = 0; i < favs.length; i++) h += rowHtml(favs[i], i, \"f\");\n  el(\"favs\").innerHTML = h;\n}\n\nfunction renderChips(){\n  var h = \"\";\n  for (var i = 0; i < GENRES.length; i++)\n    h += '<button' + (GENRES[i] === activeChip ? ' class=\"hot\"' : '') + ' onclick=\"pickGenre(\\'' + GENRES[i] + '\\')\">' + GENRES[i] + '</button>';\n  el(\"chips\").innerHTML = h;\n}\n\nfunction setChip(g){ activeChip = g; renderChips(); }\n\n/* ---------- playback ---------- */\n\nfunction playFrom(listName, idx){\n  var s = (listName === \"f\" ? favs : results)[idx];\n  if (!s) return;\n  play(s);\n}\n\nfunction play(s){\n  haptic(\"light\");\n  var same = current && current.stationuuid === s.stationuuid;\n  current = s;\n  audio.src = s.url_resolved;\n  audio.play();\n  el(\"np\").className = \"card np on\";\n  el(\"npName\").textContent = s.name;\n  el(\"npMeta\").textContent = metaLine(s);\n  el(\"npArt\").innerHTML = artHtml(s).replace(/^<div class=\"art\">|<\\/div>$/g, \"\");\n  el(\"npBtn\").textContent = \"◼\";\n  setState(\"Connecting…\", \"\");\n  resetTrack(same);\n  if (fullOn) paintFull();\n  if (dockOn) paintDock();\n  syncPlaying();\n  updateNpFav();\n  renderList(); renderFavs();\n  store.setItem(\"radio_last\", JSON.stringify(s));\n  /* polite listen ping so the directory's popularity counts stay honest */\n  if (NET && String(s.stationuuid).length > 8)\n    NET(\"https://\" + HOSTS[hostIdx] + \"/json/url/\" + s.stationuuid).catch(function(){});\n}\n\nfunction stop(){\n  audio.pause();\n  audio.removeAttribute(\"src\");\n  try { audio.load(); } catch(_){}\n  el(\"npBtn\").textContent = \"▶\";\n  el(\"np\").classList.add(\"paused\");\n  setState(\"Stopped\", \"\");\n  stopTitles();\n  syncPlaying();\n  if (dockOn) closeDock();     /* a silent dock is just a dark screen burning battery */\n}\n\nfunction toggle(){\n  haptic(\"light\");\n  if (!current) return;\n  if (audio.paused) play(current); else stop();\n}\n\nfunction setState(txt, cls){\n  el(\"npState\").textContent = txt;\n  el(\"npState\").className = \"state\" + (cls ? \" \" + cls : \"\");\n  el(\"fStateTxt\").textContent = cls === \"live\" ? \"Live\" : txt;\n  el(\"fState\").className = \"fstate\" + (cls ? \" \" + cls : \"\");\n  el(\"full\").classList.toggle(\"live\", cls === \"live\");\n  el(\"dState\").textContent = cls === \"live\" ? \"\" : \"· \" + txt;\n  el(\"dState\").className = \"dstate\" + (cls === \"err\" ? \" err\" : \"\");\n  el(\"dEq\").style.display = cls === \"live\" ? \"\" : \"none\";\n}\n\naudio.addEventListener(\"waiting\", function(){ setState(\"Buffering…\", \"\"); el(\"np\").classList.add(\"paused\"); });\naudio.addEventListener(\"playing\", function(){ setState(\"● Live\", \"live\"); el(\"np\").classList.remove(\"paused\"); startTitles(); });\naudio.addEventListener(\"error\", function(){\n  if (!current) return;\n  setState(\"Station didn't respond — try another\", \"err\");\n  el(\"npBtn\").textContent = \"▶\";\n  el(\"np\").classList.add(\"paused\");\n  syncPlaying();\n});\n\n/* ---------- favourites ---------- */\n\nfunction slim(s){\n  return {stationuuid:s.stationuuid, name:s.name, url_resolved:s.url_resolved,\n          tags:s.tags, countrycode:s.countrycode, codec:s.codec, bitrate:s.bitrate, favicon:s.favicon};\n}\n\nfunction toggleFav(listName, idx){\n  var s = (listName === \"f\" ? favs : results)[idx];\n  if (!s) return;\n  haptic(\"medium\");\n  setFav(s, !isFav(s));\n}\n\nfunction favCurrent(){ if (current){ haptic(\"medium\"); setFav(current, !isFav(current)); } }\n\nfunction setFav(s, on){\n  if (on) favs.unshift(slim(s));\n  else favs = favs.filter(function(f){ return f.stationuuid !== s.stationuuid; });\n  store.setItem(\"radio_favs\", JSON.stringify(favs));\n  renderFavs(); renderList(); updateNpFav();\n}\n\nfunction updateNpFav(){\n  if (!current) return;\n  var on = isFav(current);\n  el(\"npFav\").textContent = on ? \"♥ Favourited\" : \"♡ Favourite\";\n  el(\"npFav\").className = on ? \"hot\" : \"\";\n  el(\"fFav\").classList.toggle(\"hot\", on);\n}\n\n/* ---------- sleep timer ---------- */\n\nvar SLEEPS = [0, 15, 30, 60];\nfunction cycleSleep(){\n  haptic(\"light\");\n  sleepMins = SLEEPS[(SLEEPS.indexOf(sleepMins) + 1) % SLEEPS.length];\n  if (sleepTimer){ clearTimeout(sleepTimer); sleepTimer = null; }\n  if (sleepMins){\n    sleepTimer = setTimeout(function(){ stop(); sleepMins = 0; el(\"npSleep\").textContent = \"Sleep: off\"; el(\"npSleep\").className = \"\"; syncSleep(); }, sleepMins * 60000);\n  }\n  el(\"npSleep\").textContent = sleepMins ? \"Sleep: \" + sleepMins + \"m\" : \"Sleep: off\";\n  el(\"npSleep\").className = sleepMins ? \"hot\" : \"\";\n  syncSleep();\n}\nfunction syncSleep(){\n  el(\"fSleep\").classList.toggle(\"hot\", !!sleepMins);\n  el(\"fSleepN\").textContent = sleepMins ? sleepMins + \"m\" : \"\";\n}\n\n/* ---------- who's playing ---------- */\n\n/* The track comes from the stream itself. Three ways to hear it, best first:\n   1. myllmStreamTitle(url): MyLLM reads the stream's in-band ICY metadata\n      natively. Covers most music stations; needs a build that has the bridge.\n   2. The same read from the page, for the stations whose servers let a web\n      page ask for metadata (CORS) — stopped the moment a title arrives.\n   3. The Icecast server's own status page, through myllmFetch.\n   Each answers with a title, with \"\" (the station does send titles, this one\n   is blank — an ad break, a jingle) or with null (can't tell this way). The\n   first that can tell is remembered for that station. A station none of them\n   can read (HLS, most talk radio) is left alone after two rounds, so nothing\n   is fetched for nothing. MyLLM can also push a title in at any time\n   through window.myllmNowPlaying(title). */\nvar TITLE_EVERY = 20000;\nvar titles = { timer:null, seq:0, how:{}, misses:{}, abort:null };\nvar track = \"\";            /* cleaned title now showing */\nvar heard = [];            /* this session's earlier tracks, newest first */\n\nfunction startTitles(){\n  if (titles.timer) return;\n  pollTitle();\n  titles.timer = setInterval(pollTitle, TITLE_EVERY);\n}\nfunction stopTitles(){\n  clearInterval(titles.timer); titles.timer = null; titles.seq++;\n  if (titles.abort){ try { titles.abort.abort(); } catch(_){} titles.abort = null; }\n}\nfunction resetTrack(keepHeard){ stopTitles(); track = \"\"; if (!keepHeard) heard = []; paintTrack(false); }\n\nfunction pollTitle(){\n  if (!current || audio.paused || document.hidden) return;\n  var s = current, id = s.stationuuid, my = ++titles.seq;\n  if (/\\.m3u8(\\?|$)/i.test(s.url_resolved) || titles.how[id] === \"none\") return;\n  var order = titles.how[id] ? [titles.how[id]] : (window.myllmStreamTitle ? [\"native\",\"status\"] : [\"sniff\",\"status\"]);\n  var i = 0;\n  (function next(){\n    if (i >= order.length){\n      titles.misses[id] = (titles.misses[id] || 0) + 1;\n      if (!titles.how[id] && titles.misses[id] >= 2) titles.how[id] = \"none\";\n      return;\n    }\n    var how = order[i++];\n    ASK[how](s).then(function(raw){\n      if (my !== titles.seq || current !== s) return;\n      if (raw == null){ if (titles.how[id]) return; return next(); }\n      titles.how[id] = how;\n      setTrack(cleanTitle(raw, s.name));\n    });\n  })();\n}\n\nvar ASK = {\n  native: function(s){\n    return myllmStreamTitle(s.url_resolved).then(function(r){\n      if (!r || (!r.title && r.metadata === false)) return null;\n      return r.title || \"\";\n    }).catch(function(){ return null; });\n  },\n  sniff: function(s){\n    if (!window.fetch || !window.AbortController || !window.ReadableStream) return Promise.resolve(null);\n    var ac = new AbortController(); titles.abort = ac;\n    var giveUp = setTimeout(function(){ ac.abort(); }, 9000);\n    return fetch(s.url_resolved, {headers:{\"Icy-MetaData\":\"1\"}, signal:ac.signal, cache:\"no-store\"}).then(function(r){\n      if (!r.ok || !r.body) return null;\n      var reader = r.body.getReader(), tail = \"\", got = 0;\n      return (function pump(){\n        return reader.read().then(function(x){\n          if (x.done) return null;\n          got += x.value.length;\n          var chunk = tail + bytesToLatin1(x.value);\n          var a = chunk.indexOf(\"StreamTitle='\");\n          if (a >= 0){\n            var z = chunk.indexOf(\"';\", a + 13);\n            if (z >= 0) return utf8(chunk.slice(a + 13, z));\n            tail = chunk.slice(a);\n          } else tail = chunk.slice(-16);\n          return got > 160000 ? null : pump();   /* metadata comes every 8-16 KB when it comes at all */\n        });\n      })();\n    }).catch(function(){ return null; }).then(function(v){\n      clearTimeout(giveUp); try { ac.abort(); } catch(_){}\n      return v;\n    });\n  },\n  status: function(s){\n    if (!NET) return Promise.resolve(null);\n    var u; try { u = new URL(s.url_resolved); } catch(_){ return Promise.resolve(null); }\n    /* The browser-like User-Agent matters: old Shoutcast servers answer any\n       path with the audio itself unless the caller looks like a browser. */\n    return NET(u.origin + \"/status-json.xsl\", {headers:{\"User-Agent\":\"Mozilla/5.0\", \"Accept\":\"application/json\"}}).then(function(r){\n      if (!r.ok || !r.body || r.body.charAt(0) !== \"{\") return null;\n      var src = (JSON.parse(r.body).icestats || {}).source;\n      if (!src) return null;\n      if (!(src instanceof Array)) src = [src];\n      /* One server often carries many channels: only trust a source whose\n         mount is this stream's path, never a bare \"/\" — the wrong channel's\n         track is worse than none. */\n      var hit = src.length === 1 ? src[0] : null;\n      for (var i = 0; u.pathname.length > 1 && i < src.length; i++){\n        var l = String(src[i].listenurl || \"\");\n        if (l.slice(-u.pathname.length) === u.pathname) hit = src[i];\n      }\n      if (!hit || hit.title == null) return null;\n      var t = String(hit.title || \"\"), a = String(hit.artist || \"\");\n      return a && t && t.indexOf(a) < 0 ? a + \" - \" + t : t;\n    }).catch(function(){ return null; });\n  }\n};\n\nfunction bytesToLatin1(b){\n  var out = \"\";\n  for (var i = 0; i < b.length; i += 8192) out += String.fromCharCode.apply(null, b.subarray(i, i + 8192));\n  return out;\n}\nfunction utf8(latin1){ try { return decodeURIComponent(escape(latin1)); } catch(_){ return latin1; } }\n\n/* Stations put all sorts in the title field: nothing, their own name, a URL,\n   an ad marker. Only something that reads like a track gets shown. */\nfunction cleanTitle(raw, stationName){\n  var t = String(raw || \"\").replace(/\\s+/g, \" \").trim();\n  var m = /^(.*?) - text=\"([^\"]*)\"/.exec(t);              /* iHeart / StreamTheWorld wrap the song in attributes */\n  if (m) t = (m[1] ? m[1] + \" - \" : \"\") + m[2];\n  t = t.replace(/^[\\s\\-–|_]+|[\\s\\-–|_]+$/g, \"\");\n  if (t.length < 2 || /^https?:/i.test(t) || /^(unknown|untitled|n\\/a|advert|adbreak|ad break|commercial)/i.test(t)) return \"\";\n  var norm = function(x){ return String(x).toLowerCase().replace(/[^a-z0-9]+/g, \"\"); };\n  if (norm(t) === norm(stationName)) return \"\";\n  return t.length > 140 ? t.slice(0, 140) + \"…\" : t;\n}\nfunction splitTrack(t){\n  var i = t.indexOf(\" - \");\n  return i > 0 ? {artist:t.slice(0, i), title:t.slice(i + 3)} : {artist:\"\", title:t};\n}\n\nfunction setTrack(t){\n  if (t === track) return;\n  if (track) { heard.unshift({t:track, at:new Date()}); heard = heard.slice(0, 5); }\n  track = t;\n  paintTrack(true);\n}\n\nfunction paintTrack(animate){\n  var p = splitTrack(track);\n  var line = track ? \"♪ \" + (p.artist ? p.artist + \" — \" + p.title : p.title) : \"\";\n  el(\"npTrack\").textContent = line;\n  el(\"npTrack\").classList.toggle(\"on\", !!track);\n  if (current){\n    el(\"fTitle\").textContent = track ? p.title : current.name;\n    el(\"fArtist\").textContent = track ? p.artist : \"\";\n    el(\"fMeta\").textContent = track ? current.name + (stationDetail(current) ? \" · \" + stationDetail(current) : \"\") : stationDetail(current);\n    el(\"dTrack\").textContent = track ? (p.artist ? p.artist + \" — \" + p.title : p.title) : current.name;\n    el(\"dName\").textContent = track ? current.name : (stationDetail(current) || \"Live radio\");\n    if (animate){\n      [\"fTitle\",\"fArtist\"].forEach(function(id){ var n = el(id); n.classList.remove(\"swap\"); void n.offsetWidth; n.classList.add(\"swap\"); });\n    }\n  }\n  var h = \"\";\n  for (var i = 0; i < heard.length; i++){\n    var d = heard[i].at, hh = d.getHours(), mm = d.getMinutes();\n    h += '<div class=\"row\"><span class=\"when\">' + (hh < 10 ? \"0\" : \"\") + hh + \":\" + (mm < 10 ? \"0\" : \"\") + mm + '</span><span class=\"what\">' + esc(heard[i].t) + '</span></div>';\n  }\n  el(\"fEarlier\").innerHTML = h ? \"<h3>Earlier</h3>\" + h : \"\";\n  el(\"fEarlier\").classList.toggle(\"on\", !!h);\n  if (\"mediaSession\" in navigator && window.MediaMetadata && current){\n    try { navigator.mediaSession.metadata = new MediaMetadata({title: track ? p.title : current.name, artist: track ? (p.artist || current.name) : \"Internet Radio\", album: current.name}); } catch(_){}\n  }\n}\n\nfunction shareTrack(){\n  if (!track || !current || !window.myllmShare) return;\n  haptic(\"light\");\n  try { myllmShare(track + \" (heard on \" + current.name + \")\").catch(function(){}); } catch(_){}\n}\n\n/* MyLLM may push a title in directly. */\nwindow.myllmNowPlaying = function(title){ if (current) setTrack(cleanTitle(title, current.name)); };\n\n/* ---------- playing mode ---------- */\n\nfunction stationDetail(s){\n  var bits = [];\n  if (s.tags){ var t = String(s.tags).split(\",\").slice(0,3).join(\", \"); if (t) bits.push(t); }\n  if (s.countrycode) bits.push(s.countrycode);\n  var q = [];\n  if (s.codec) q.push(String(s.codec).toUpperCase());\n  if (s.bitrate) q.push(s.bitrate + \" kbps\");\n  if (q.length) bits.push(q.join(\" \"));\n  return bits.join(\" · \");\n}\n\nfunction hueOf(s){\n  var n = String(s.name || \"\"), h = 7;\n  for (var i = 0; i < n.length; i++) h = (h * 31 + n.charCodeAt(i)) % 360;\n  return h;\n}\nfunction initials(s){\n  var w = String(s.name || \"\").replace(/[^\\p{L}\\p{N} ]+/gu, \" \").trim().split(/\\s+/).filter(Boolean);\n  if (!w.length) return \"♪\";\n  return (w.length === 1 ? w[0].slice(0, 2) : w[0].charAt(0) + w[1].charAt(0)).toUpperCase();\n}\nfunction logoOf(s){ return s.favicon && String(s.favicon).indexOf(\"https://\") === 0 ? String(s.favicon) : \"\"; }\n\n/* Fill a .tile: initials on the station's hue, logo faded in over it once it\n   has loaded — full-bleed when it is big enough, small and centred when not. */\nfunction paintTile(node, s, onLogo){\n  node.style.setProperty(\"--h\", hueOf(s));\n  node.innerHTML = '<span class=\"ini\">' + esc(initials(s)) + '</span>';\n  var src = logoOf(s);\n  if (!src) return;\n  var img = new Image();\n  img.onload = function(){\n    if (current !== s) return;\n    var big = Math.min(img.naturalWidth, img.naturalHeight) >= 120;\n    img.className = big ? \"ok\" : \"ok sm\";\n    if (big) node.querySelector(\".ini\").style.display = \"none\";\n    if (onLogo) onLogo(src, big);\n  };\n  img.alt = \"\";\n  img.src = src;\n  node.appendChild(img);\n}\n\nvar fullOn = false;\n\nfunction paintFull(){\n  var bg = el(\"fBg\");\n  bg.className = \"fbg\"; bg.style.backgroundImage = \"\";\n  el(\"full\").style.setProperty(\"--h\", hueOf(current));\n  paintTile(el(\"fArt\"), current, function(src, big){\n    if (!big) return;                                  /* a blurred favicon is just grey */\n    bg.style.backgroundImage = 'url(\"' + src.replace(/\"/g, \"%22\") + '\")'; bg.className = \"fbg art\";\n  });\n  paintTrack(false);\n  updateNpFav(); syncSleep(); syncPlaying();\n}\n\nfunction openFull(){\n  if (!current) return;\n  haptic(\"light\");\n  fullOn = true;\n  el(\"full\").classList.toggle(\"lite\", !window.myllmImmersive &&\n    !(window.matchMedia && matchMedia(\"(prefers-color-scheme: dark)\").matches));\n  paintFull();\n  el(\"full\").classList.add(\"on\");\n  document.body.classList.add(\"lock\");\n  syncChrome();\n}\nfunction closeFull(){\n  haptic(\"light\");\n  fullOn = false;\n  el(\"full\").classList.remove(\"on\");\n  document.body.classList.remove(\"lock\");\n  syncChrome();\n}\n\nvar ICON = { play:'<svg><use href=\"#i-play\"/></svg>', stop:'<svg><use href=\"#i-stop\"/></svg>' };\nfunction syncPlaying(){\n  var playing = current && !audio.paused;\n  el(\"fBtn\").innerHTML = playing ? ICON.stop : ICON.play;\n  el(\"dBtn\").innerHTML = playing ? ICON.stop + \"Stop\" : ICON.play + \"Play\";\n}\n\n/* Playing mode and the dock want the whole display. myllmImmersive (MyLLM 5.7+)\n   hides MyLLM's own title bar and the status bar; the dock also asks for the\n   screen to stay awake. On a build without it both views still work — they\n   just sit under the title bar. */\nfunction syncChrome(){\n  if (!window.myllmImmersive) return;\n  try { myllmImmersive(fullOn || dockOn, {keepAwake: dockOn}).catch(function(){}); } catch(_){}\n}\n\n/* Dock: true black, a large clock, the track and station dimmed beneath it,\n   everything drifting a little every minute so nothing burns in. The screen is\n   kept awake by MyLLM where it can (see syncChrome), else by the Wake Lock API\n   where the web view offers it; failing both, the phone's own auto-lock\n   applies and the audio carries on regardless. */\nvar dockOn = false, dockClock = null, dockDrift = null, dockCtlTimer = null, wakeLock = null;\nvar DAYS = [\"Sunday\",\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\"];\nvar MONTHS = [\"January\",\"February\",\"March\",\"April\",\"May\",\"June\",\"July\",\"August\",\"September\",\"October\",\"November\",\"December\"];\n\nfunction dockTime(){\n  var d = new Date(), h = d.getHours(), m = d.getMinutes();\n  el(\"dClock\").textContent = (h < 10 ? \"0\" : \"\") + h + \":\" + (m < 10 ? \"0\" : \"\") + m;\n  el(\"dDate\").textContent = DAYS[d.getDay()] + \" \" + d.getDate() + \" \" + MONTHS[d.getMonth()];\n}\nfunction driftOnce(){\n  var x = Math.round((Math.random() - 0.5) * 44), y = Math.round((Math.random() - 0.5) * 44);\n  el(\"dDrift\").style.transform = \"translate(\" + x + \"px,\" + y + \"px)\";\n}\nfunction requestWake(){\n  if (!(\"wakeLock\" in navigator)) return;\n  navigator.wakeLock.request(\"screen\").then(function(l){ wakeLock = l; }).catch(function(){ wakeLock = null; });\n}\nfunction releaseWake(){\n  if (wakeLock){ try { wakeLock.release(); } catch(_){} wakeLock = null; }\n}\nfunction paintDock(){ paintTile(el(\"dArt\"), current); paintTrack(false); }\nfunction openDock(){\n  if (!current) return;\n  haptic(\"medium\");\n  dockOn = true;\n  paintDock(); dockTime(); driftOnce(); syncPlaying();\n  el(\"dock\").classList.add(\"on\");\n  document.body.classList.add(\"lock\");\n  el(\"dCtl\").classList.remove(\"on\");\n  el(\"dHint\").style.opacity = \"1\";\n  setTimeout(function(){ el(\"dHint\").style.opacity = \"0\"; }, 4000);\n  dockClock = setInterval(dockTime, 15000);\n  dockDrift = setInterval(driftOnce, 60000);\n  requestWake();\n  syncChrome();\n}\nfunction closeDock(){\n  dockOn = false;\n  el(\"dock\").classList.remove(\"on\");\n  if (!fullOn) document.body.classList.remove(\"lock\");\n  clearInterval(dockClock); clearInterval(dockDrift); clearTimeout(dockCtlTimer);\n  dockClock = dockDrift = dockCtlTimer = null;\n  releaseWake();\n  syncChrome();\n}\nfunction dockTap(){\n  if (!dockOn) return;\n  el(\"dHint\").style.opacity = \"0\";\n  el(\"dCtl\").classList.add(\"on\");\n  clearTimeout(dockCtlTimer);\n  dockCtlTimer = setTimeout(function(){ el(\"dCtl\").classList.remove(\"on\"); }, 5000);\n}\ndocument.addEventListener(\"visibilitychange\", function(){\n  if (document.hidden){ releaseWake(); return; }\n  if (dockOn){ dockTime(); requestWake(); }\n  if (fullOn || dockOn) syncChrome();          /* MyLLM puts its bars back when the app is left */\n  if (titles.timer) pollTitle();\n});\n\n/* ---------- boot ---------- */\n\nel(\"q\").addEventListener(\"keydown\", function(e){ if (e.key === \"Enter\"){ doSearch(); this.blur(); } });\n\nrenderChips();\nstore.getItem(\"radio_favs\").then(function(v){\n  if (v){ try { favs = JSON.parse(v) || []; } catch(_){} }\n  renderFavs();\n});\nstore.getItem(\"radio_last\").then(function(v){\n  if (v){ try {\n    var s = JSON.parse(v);\n    current = s;\n    el(\"np\").className = \"card np on paused\";\n    el(\"npName\").textContent = s.name;\n    el(\"npMeta\").textContent = metaLine(s);\n    el(\"npArt\").innerHTML = artHtml(s).replace(/^<div class=\"art\">|<\\/div>$/g, \"\");\n    el(\"npBtn\").textContent = \"▶\";\n    setState(\"Tap to resume\", \"\");\n    updateNpFav();\n  } catch(_){} }\n});\nfetchList(\"\", \"Popular stations\");\n</script>\n</body>\n</html>\n"}