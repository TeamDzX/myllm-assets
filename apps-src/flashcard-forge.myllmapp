{"name":"Flashcard Forge","html":"<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>:root{color-scheme:light dark}\nbody{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:20px;background:#f2f2f7;color:#111}\n@media(prefers-color-scheme:dark){body{background:#000;color:#eee}.panel,.deck{background:#1c1c1e}input{background:#2c2c2e;color:#eee;border-color:#3a3a3c}.nav button{background:#2c2c2e;color:#eee}}\nh1{font-size:22px;margin:0 0 14px}\n.row{display:flex;gap:8px;margin-bottom:10px}\ninput{flex:1;padding:12px;border:1px solid #d1d1d6;border-radius:10px;font-size:16px;background:#fff}\nbutton{border:0;background:#5e5ce6;color:#fff;border-radius:10px;padding:0 16px;font-size:15px;font-weight:600}\nbutton:disabled{opacity:.5}\n#status{font-size:13px;opacity:.65;min-height:18px;margin-bottom:10px}\n.panel{background:#fff;border-radius:16px;padding:22px 18px;min-height:150px;display:none;flex-direction:column;justify-content:center;text-align:center;box-shadow:0 1px 3px rgba(0,0,0,.1)}\n.panel .side{font-size:11px;letter-spacing:.08em;text-transform:uppercase;opacity:.5;margin-bottom:8px}\n.panel .text{font-size:18px;line-height:1.45}\n.panel .hint{font-size:12px;opacity:.4;margin-top:12px}\n.nav{display:none;align-items:center;justify-content:space-between;margin-top:10px}\n.nav button{background:#e5e5ea;color:#111;padding:9px 18px}\n.nav b{font-size:14px;opacity:.7}\nh2{font-size:15px;margin:20px 0 8px;opacity:.7}\n.deck{background:#fff;border-radius:12px;padding:11px 14px;margin-bottom:8px;display:flex;align-items:center;gap:10px}\n.deck span{flex:1;font-size:15px}\n.deck .n{opacity:.5;font-size:13px}\n.deck .del{background:none;color:#ff453a;font-size:16px;padding:4px}\n</style></head><body>\n<h1>🧠 Flashcard Forge</h1>\n<div class=\"row\"><input id=\"topic\" placeholder=\"Topic (e.g. The Tudors, photosynthesis)…\"><button id=\"gen\" onclick=\"gen()\">Forge</button></div>\n<div id=\"status\"></div>\n<div class=\"panel\" id=\"card\" onclick=\"flip()\">\n<div class=\"side\" id=\"side\"></div><div class=\"text\" id=\"text\"></div><div class=\"hint\">tap to flip</div>\n</div>\n<div class=\"nav\" id=\"nav\"><button onclick=\"nav(-1)\">‹ Prev</button><b id=\"count\"></b><button onclick=\"nav(1)\">Next ›</button></div>\n<h2 id=\"decksHead\" style=\"display:none\">Saved decks</h2>\n<div id=\"decks\"></div>\n<script>\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar decks=[],cur=-1,idx=0,showA=false;\nfunction el(i){return document.getElementById(i)}\nfunction setStatus(t){el('status').textContent=t}\nfunction save(){store.setItem('decks',JSON.stringify(decks))}\nfunction gen(){\nvar topic=el('topic').value.trim();if(!topic)return;\nif(!window.myllmAsk){setStatus('This app needs AI access — update MyLLM and enable “Allow apps to use the AI” in Settings.');return}\nel('gen').disabled=true;setStatus('Forging a deck about “'+topic+'”…');\nmyllmAsk('Create exactly 8 study flashcards about: '+topic+'. Reply with ONLY a JSON array like [{\"q\":\"short question\",\"a\":\"concise answer\"}] and nothing else.')\n.then(function(reply){\nvar s=reply.indexOf('['),e=reply.lastIndexOf(']');\nif(s<0||e<=s)throw new Error('the model did not return a deck');\nvar cards=JSON.parse(reply.slice(s,e+1)).filter(function(c){return c&&c.q&&c.a});\nif(!cards.length)throw new Error('the deck came back empty');\ndecks.unshift({topic:topic,cards:cards});save();\nel('topic').value='';setStatus('');openDeck(0);renderDecks();\n}).catch(function(err){setStatus('Could not generate: '+err.message)})\n.then(function(){el('gen').disabled=false});\n}\nfunction openDeck(i){cur=i;idx=0;showA=false;renderCard()}\nfunction flip(){showA=!showA;if(window.myllmHaptic)myllmHaptic('light');renderCard()}\nfunction nav(d){var n=decks[cur].cards.length;idx=(idx+d+n)%n;showA=false;renderCard();if(window.myllmHaptic)myllmHaptic('selection')}\nfunction renderCard(){\nif(cur<0||!decks[cur]){el('card').style.display='none';el('nav').style.display='none';return}\nvar c=decks[cur].cards[idx];\nel('card').style.display='flex';el('nav').style.display='flex';\nel('side').textContent=showA?'Answer':'Question';\nel('text').textContent=showA?c.a:c.q;\nel('count').textContent=(idx+1)+' / '+decks[cur].cards.length;\n}\nfunction renderDecks(){\nvar D=el('decks');D.innerHTML='';\nel('decksHead').style.display=decks.length?'block':'none';\ndecks.forEach(function(d,i){\nvar r=document.createElement('div');r.className='deck';\nvar s=document.createElement('span');s.textContent=d.topic;s.onclick=function(){openDeck(i)};\nvar n=document.createElement('span');n.className='n';n.textContent=d.cards.length+' cards';\nvar x=document.createElement('button');x.className='del';x.textContent='✕';\nx.onclick=function(){decks.splice(i,1);if(cur===i)cur=-1;else if(cur>i)cur--;save();renderDecks();renderCard()};\nr.appendChild(s);r.appendChild(n);r.appendChild(x);D.appendChild(r)})}\nel('topic').addEventListener('keydown',function(e){if(e.key==='Enter')gen()});\nstore.getItem('decks').then(function(v){\nif(v)try{decks=JSON.parse(v)}catch(e){}\nrenderDecks();if(decks.length)openDeck(0);\nif(!window.myllmAsk)setStatus('Heads-up: this app needs the latest MyLLM with apps-AI enabled.');\n});\n</script></body></html>","kind":"html","iconSymbol":"brain.head.profile","iconColor":"indigo"}