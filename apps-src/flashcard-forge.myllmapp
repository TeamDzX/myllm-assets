{"name": "Flashcard Forge", "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Flashcard Forge</title>\n<style>\n:root{\n  color-scheme:light dark;\n  --font:var(--myllm-font,-apple-system,system-ui,\"Segoe UI\",Roboto,sans-serif);\n  --page1:#eef1f8; --page2:#eef6ff;\n  --surface:#ffffff; --surface2:#f3f4fa;\n  --ink:#191c28; --muted:#697083; --faint:#a2a8b8;\n  --border:#e7e9f1;\n  --acc:#635bff; --acc2:#22a7f0; --accSoft:rgba(99,91,255,.12);\n  --radius:16px; --radiusLg:22px;\n  --shadow:0 1px 2px rgba(20,20,50,.05),0 8px 22px -14px rgba(30,40,110,.28);\n  --shadowLg:0 16px 44px -16px rgba(40,50,150,.5);\n}\n@media(prefers-color-scheme:dark){:root{\n  --page1:#0b0d13; --page2:#0d1220;\n  --surface:#181b24; --surface2:#20232f;\n  --ink:#f1f2f7; --muted:#9aa0af; --faint:#666d7d;\n  --border:#282c39; --accSoft:rgba(99,91,255,.22);\n  --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 28px -14px rgba(0,0,0,.7);\n  --shadowLg:0 18px 48px -16px rgba(0,0,0,.85);\n}}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nbody{font-family:var(--font);margin:0;padding:18px 16px calc(34px + env(safe-area-inset-bottom));\n  background:linear-gradient(180deg,var(--page1),var(--page2));background-attachment:fixed;\n  min-height:100dvh;color:var(--ink);line-height:1.4}\n@media(min-width:768px){body{max-width:720px;margin:0 auto}}\n\n.hero{position:relative;overflow:hidden;border-radius:var(--radiusLg);padding:20px;margin-bottom:16px;\n  background:linear-gradient(135deg,var(--acc),var(--acc2));color:#fff;box-shadow:var(--shadowLg);\n  display:flex;align-items:center;gap:14px}\n.hero::after{content:\"\";position:absolute;right:-46px;top:-46px;width:170px;height:170px;border-radius:50%;\n  background:radial-gradient(circle,rgba(255,255,255,.28),transparent 70%);pointer-events:none}\n.hero-badge{width:52px;height:52px;border-radius:16px;background:rgba(255,255,255,.22);\n  display:grid;place-items:center;font-size:28px;flex:0 0 auto}\n.hero h1{font-size:22px;font-weight:800;letter-spacing:-.02em;margin:0}\n.hero p{margin:3px 0 0;font-size:13px;opacity:.92;font-weight:500}\n\n.surface{background:var(--surface);border:1px solid var(--border);border-radius:var(--radiusLg);\n  padding:16px;box-shadow:var(--shadow);margin-bottom:16px}\n.field{display:flex;align-items:center;gap:10px;background:var(--surface2);border:1px solid var(--border);\n  border-radius:13px;padding:0 13px;margin-bottom:10px}\n.field-ic{font-size:16px;opacity:.7;flex:0 0 auto}\n.field input{flex:1;border:0;background:none;padding:13px 0;font-size:16px;color:var(--ink);\n  outline:none;min-width:0;font-family:var(--font)}\n.field input::placeholder{color:var(--faint)}\n.btn-primary{width:100%;border:0;border-radius:14px;padding:14px;font-size:15px;font-weight:700;color:#fff;\n  font-family:var(--font);background:linear-gradient(135deg,var(--acc),var(--acc2));\n  box-shadow:0 8px 20px -8px var(--acc);cursor:pointer;transition:transform .1s,opacity .2s}\n.btn-primary:active{transform:scale(.98)}\n.btn-primary:disabled{opacity:.5;box-shadow:none}\n.chips{display:flex;flex-wrap:wrap;gap:7px;margin:2px 0 12px}\n.chip{border:1px solid var(--border);background:var(--surface);color:var(--muted);border-radius:999px;\n  padding:7px 12px;font-size:13px;font-weight:600;cursor:pointer;font-family:var(--font);transition:.15s}\n.chip.on{color:var(--acc);border-color:var(--acc);background:var(--accSoft)}\n.status{font-size:13px;color:var(--muted);min-height:18px;margin-top:9px;text-align:center}\n\n/* active-deck header — makes it obvious what you're studying */\n.deck-head{display:flex;align-items:center;gap:12px;margin:2px 2px 14px}\n.deck-head .badge{width:44px;height:44px;border-radius:13px;flex:0 0 auto;display:grid;place-items:center;font-size:22px;\n  color:#fff;background:linear-gradient(135deg,var(--acc),var(--acc2));box-shadow:0 6px 16px -8px var(--acc)}\n.deck-head .dt{font-size:18px;font-weight:750;letter-spacing:-.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.deck-head .dm{font-size:13px;color:var(--muted);margin-top:1px}\n\n/* flip card */\n#study{display:none}\n.card{perspective:1400px;cursor:pointer;margin-bottom:13px}\n.card-inner{position:relative;height:216px;transition:transform .55s cubic-bezier(.2,.75,.2,1);transform-style:preserve-3d}\n.card-inner.flipped{transform:rotateY(180deg)}\n.face{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;\n  display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;\n  border-radius:var(--radiusLg);padding:26px 22px;overflow-y:auto}\n.face.front{background:var(--surface);border:1px solid var(--border);box-shadow:var(--shadowLg)}\n.face.back{background:linear-gradient(150deg,var(--acc),var(--acc2));color:#fff;transform:rotateY(180deg);box-shadow:var(--shadowLg)}\n.face-label{font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;opacity:.5;margin-bottom:12px}\n.face.back .face-label{opacity:.85}\n.face-text{font-size:19px;line-height:1.45;font-weight:600}\n.face-tip{position:absolute;bottom:11px;left:0;right:0;font-size:11px;opacity:.4;font-weight:500}\n\n.dots{display:flex;gap:6px;justify-content:center;flex-wrap:wrap;margin:0 0 14px}\n.dot{width:7px;height:7px;border-radius:50%;background:var(--border);transition:.2s}\n.dot.on{background:var(--acc);transform:scale(1.35)}\n.nav{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:6px}\n.nav button{background:var(--surface);border:1px solid var(--border);color:var(--ink);border-radius:12px;\n  padding:11px 18px;font-weight:650;font-size:14px;cursor:pointer;font-family:var(--font);transition:transform .1s}\n.nav button:active{transform:scale(.97)}\n.nav .count{font-size:13px;color:var(--muted);font-weight:600}\n\n/* saved decks */\n.section{font-size:12px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);margin:16px 2px 10px}\n.deck{display:flex;align-items:center;gap:12px;background:var(--surface);border:1px solid var(--border);\n  border-radius:14px;padding:11px 13px;margin-bottom:8px;box-shadow:var(--shadow);cursor:pointer;transition:border-color .2s,background .2s}\n.deck.on{border-color:var(--acc);background:var(--accSoft)}\n.deck-ic{width:34px;height:34px;border-radius:10px;flex:0 0 auto;display:grid;place-items:center;font-size:17px;\n  background:var(--surface2);border:1px solid var(--border)}\n.deck.on .deck-ic{background:linear-gradient(135deg,var(--acc),var(--acc2));border-color:transparent}\n.deck-mid{flex:1;min-width:0}\n.deck-t{font-size:15px;font-weight:650;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.deck-s{font-size:12.5px;color:var(--muted);margin-top:1px;display:flex;align-items:center;gap:7px}\n.now{font-size:10px;font-weight:800;color:#fff;background:var(--acc);border-radius:999px;padding:2px 7px;letter-spacing:.03em;text-transform:uppercase}\n.del{border:0;background:none;color:var(--faint);font-size:15px;padding:6px;cursor:pointer;flex:0 0 auto}\n.del:active{color:#ff453a}\n\n.empty{display:none;text-align:center;padding:30px 20px 10px;color:var(--muted)}\n.empty-emoji{font-size:44px;line-height:1}\n.empty h3{margin:12px 0 5px;font-size:17px;color:var(--ink);font-weight:700}\n.empty p{margin:0 auto;font-size:13.5px;line-height:1.5;max-width:280px}\n\n@media(prefers-reduced-motion:no-preference){\n  .hero,.surface{animation:rise .45s ease backwards}\n  @keyframes rise{from{opacity:0;transform:translateY(9px)}to{opacity:1;transform:none}}\n}\n@media(prefers-reduced-motion:reduce){.card-inner{transition:none}}\n</style></head><body>\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-family:-apple-system,system-ui,sans-serif;font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;line-height:1;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n<script>\n(function(){\n  if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;\n  window.__myllmAiWrap=true;\n  var orig=window.myllmAsk,depth=0,node=null;\n  function ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\n    node.innerHTML='<span class=\"myllm-ai-cog\">⚙️</span><span>AI is thinking… <small>privately, on your device</small></span>';\n    (document.body||document.documentElement).appendChild(node);}\n  function show(){ensure();depth++;node.classList.add('on');}\n  function hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\n  window.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\n    return Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};\n})();\n</script>\n\n<div class=\"hero\">\n  <div class=\"hero-badge\">🧠</div>\n  <div><h1>Flashcard Forge</h1><p>Turn any topic into a study deck in seconds.</p></div>\n</div>\n\n<div class=\"surface\">\n  <label class=\"field\"><span class=\"field-ic\">✨</span><input id=\"topic\" placeholder=\"Topic — e.g. The Tudors, photosynthesis\"></label>\n  <div class=\"chips\" id=\"topicChips\"></div>\n  <button class=\"btn-primary\" id=\"gen\" onclick=\"gen()\">Forge deck 🔨</button>\n  <div id=\"status\" class=\"status\"></div>\n</div>\n\n<div class=\"empty\" id=\"empty\">\n  <div class=\"empty-emoji\">🗂️</div>\n  <h3>No decks yet</h3>\n  <p>Type a topic above and your AI tutor forges an 8-card study deck to flip through.</p>\n</div>\n\n<div id=\"study\">\n  <div class=\"deck-head\">\n    <div class=\"badge\">🧠</div>\n    <div style=\"min-width:0\"><div class=\"dt\" id=\"deckTopic\"></div><div class=\"dm\" id=\"deckMeta\"></div></div>\n  </div>\n  <div class=\"card\" onclick=\"flip()\">\n    <div class=\"card-inner\" id=\"cardInner\">\n      <div class=\"face front\"><span class=\"face-label\">Question</span><div class=\"face-text\" id=\"qText\"></div><div class=\"face-tip\">tap to flip</div></div>\n      <div class=\"face back\"><span class=\"face-label\">Answer</span><div class=\"face-text\" id=\"aText\"></div><div class=\"face-tip\">tap to flip back</div></div>\n    </div>\n  </div>\n  <div class=\"dots\" id=\"dots\"></div>\n  <div class=\"nav\">\n    <button onclick=\"nav(-1)\">‹ Prev</button>\n    <span class=\"count\" id=\"count\"></span>\n    <button onclick=\"nav(1)\">Next ›</button>\n  </div>\n</div>\n\n<div id=\"savedWrap\" style=\"display:none\">\n  <div class=\"section\">Saved decks</div>\n  <div id=\"decks\"></div>\n</div>\n\n<script>\n\"use strict\";\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar decks=[],cur=-1,idx=0,showA=false;\nfunction el(i){return document.getElementById(i)}\nfunction setStatus(t){el('status').textContent=t}\nfunction save(){store.setItem('decks',JSON.stringify(decks))}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\n\nvar EXAMPLES=['The Tudors','Photosynthesis','French verbs','World capitals','Music theory'];\nfunction buildChips(){\n  var c=el('topicChips');c.innerHTML='';\n  EXAMPLES.forEach(function(t){\n    var b=document.createElement('button');b.type='button';b.className='chip';b.textContent=t;\n    b.onclick=function(){el('topic').value=t;\n      document.querySelectorAll('.chip').forEach(function(x){x.classList.remove('on')});\n      b.classList.add('on');haptic('selection');};\n    c.appendChild(b);\n  });\n}\n\n/* Labelled lines, not JSON — small models (Apple Intelligence) echo JSON\n   templates back verbatim. Echoed instructions are rejected and retried. */\nvar ECHO=/question on the front|answer on the back|repeat this line|labelled line/i;\nfunction parseDeck(reply){\n  var cards=[],got=false;\n  String(reply||'').split(/\\r?\\n/).forEach(function(raw){\n    var ln=raw.replace(/\\*\\*/g,'').trim();\n    var m=ln.match(/^[-*#>\\s]*(CARDS?)\\s*\\d*\\s*[:：]\\s*(.*)$/i);\n    if(!m)return;\n    got=true;\n    var parts=m[2].split('|');\n    var q=(parts[0]||'').trim(),a=parts.slice(1).join('|').trim();\n    if(q&&a)cards.push({q:q,a:a});\n  });\n  if(!got){ // model answered in the old JSON shape — accept it\n    var s=String(reply||'').indexOf('['),e=String(reply||'').lastIndexOf(']');\n    if(s>=0&&e>s)try{\n      var j=JSON.parse(String(reply).slice(s,e+1));\n      if(Array.isArray(j))j.forEach(function(c){if(c&&c.q&&c.a)cards.push({q:String(c.q),a:String(c.a)})});\n    }catch(e2){}\n  }\n  cards=cards.filter(function(c){return !ECHO.test(c.q)&&!ECHO.test(c.a)});\n  if(!cards.length)throw new Error('the model did not return a deck');\n  return cards;\n}\nfunction gen(){\n  var topic=el('topic').value.trim();if(!topic){setStatus('Enter a topic first.');return}\n  if(!window.myllmAsk){setStatus('This app needs AI access — update MyLLM and enable “Allow apps to use the AI” in Settings.');return}\n  el('gen').disabled=true;setStatus('Forging a deck about “'+topic+'”…');\n  var p='Create exactly 8 study flashcards about: '+topic+'. Reply with EXACTLY these labelled lines and nothing else:\\n'+\n    'CARD: the question on the front | the answer on the back (repeat this line for all 8 cards)';\n  myllmAsk(p).then(function(r){return parseDeck(r||'')})\n  .catch(function(){return myllmAsk(p+'\\nIMPORTANT: fill each labelled line with real content — never repeat the instruction text.')\n    .then(function(r){return parseDeck(r||'')})})\n  .then(function(cards){\n    decks.unshift({topic:topic,cards:cards});save();\n    el('topic').value='';setStatus('');cur=-1;openDeck(0);haptic('success');\n  }).catch(function(err){setStatus('Could not generate: '+err.message)})\n  .then(function(){el('gen').disabled=false});\n}\n\nfunction openDeck(i){\n  if(!decks[i]){el('study').style.display='none';return}\n  cur=i;idx=0;showA=false;\n  renderCard();renderDecks();updateViews();\n  window.scrollTo({top:0,behavior:'smooth'});\n}\nfunction flip(){showA=!showA;haptic('light');el('cardInner').classList.toggle('flipped',showA)}\nfunction nav(d){\n  if(cur<0||!decks[cur])return;\n  var n=decks[cur].cards.length;idx=(idx+d+n)%n;showA=false;\n  renderCard();haptic('selection');\n}\nfunction renderCard(){\n  if(cur<0||!decks[cur]){el('study').style.display='none';return}\n  var deck=decks[cur],c=deck.cards[idx];\n  el('study').style.display='block';\n  el('deckTopic').textContent=deck.topic;\n  el('deckMeta').textContent=deck.cards.length+' cards · tap the card to flip';\n  el('qText').textContent=c.q;\n  el('aText').textContent=c.a;\n  el('cardInner').classList.toggle('flipped',showA);\n  el('count').textContent='Card '+(idx+1)+' of '+deck.cards.length;\n  var dd=el('dots');dd.innerHTML='';\n  if(deck.cards.length<=16){\n    deck.cards.forEach(function(_,j){var s=document.createElement('span');s.className='dot'+(j===idx?' on':'');dd.appendChild(s)});\n  }\n}\n\nfunction renderDecks(){\n  var D=el('decks');D.innerHTML='';\n  decks.forEach(function(d,i){\n    var active=(i===cur);\n    var r=document.createElement('div');r.className='deck'+(active?' on':'');\n    var ic=document.createElement('div');ic.className='deck-ic';ic.textContent=active?'📖':'🗂️';\n    var mid=document.createElement('div');mid.className='deck-mid';\n    var t=document.createElement('div');t.className='deck-t';t.textContent=d.topic;\n    var s=document.createElement('div');s.className='deck-s';\n    s.innerHTML=(active?'<span class=\"now\">Studying</span>':'')+'<span>'+d.cards.length+' cards</span>';\n    mid.appendChild(t);mid.appendChild(s);\n    var x=document.createElement('button');x.className='del';x.type='button';x.textContent='✕';x.setAttribute('aria-label','Delete deck');\n    x.onclick=function(ev){\n      ev.stopPropagation();\n      decks.splice(i,1);\n      if(cur===i)cur=-1;else if(cur>i)cur--;\n      save();\n      if(decks.length){openDeck(cur<0?0:cur)}else{cur=-1;el('study').style.display='none';renderDecks();updateViews()}\n      haptic('warning');\n    };\n    r.appendChild(ic);r.appendChild(mid);r.appendChild(x);\n    r.onclick=function(){openDeck(i)};\n    D.appendChild(r);\n  });\n  updateViews();\n}\n\nfunction updateViews(){\n  el('empty').style.display=decks.length?'none':'block';\n  el('savedWrap').style.display=decks.length?'block':'none';\n  if(!decks.length)el('study').style.display='none';\n}\n\nel('topic').addEventListener('keydown',function(e){if(e.key==='Enter')gen()});\n\nbuildChips();\nstore.getItem('decks').then(function(v){\n  if(v)try{decks=JSON.parse(v)||[]}catch(e){}\n  renderDecks();\n  if(decks.length)openDeck(0);else updateViews();\n  if(!window.myllmAsk)setStatus('Heads-up: this app needs the latest MyLLM with apps-AI enabled.');\n});\n</script></body></html>\n", "kind": "html", "iconSymbol": "brain.head.profile", "iconColor": "indigo"}