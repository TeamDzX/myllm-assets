{"name": "Sprint Planner", "kind": "html", "iconSymbol": "figure.run", "iconColor": "indigo", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Sprint Planner</title>\n<style>:root{color-scheme:light dark;--ac:#5e5ce6}\n*{box-sizing:border-box}\nbody{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:18px 16px calc(28px + env(safe-area-inset-bottom));background:#f2f2f7;color:#111;-webkit-tap-highlight-color:transparent;max-width:820px;margin-left:auto;margin-right:auto}\n@media(prefers-color-scheme:dark){body{background:#000;color:#eee}.item,input,.stat,.pill{background:#1c1c1e}input{color:#eee;border-color:#3a3a3c}.pill{border-color:#3a3a3c}}\nh1{font-size:22px;margin:0 0 12px}\n.stats{display:flex;gap:8px;margin-bottom:14px}\n.stat{flex:1;background:#fff;border-radius:14px;padding:11px 12px;text-align:center;box-shadow:0 1px 2px rgba(0,0,0,.05)}\n.stat .n{font-size:22px;font-weight:700;color:var(--ac)}\n.stat .l{font-size:11px;opacity:.6;text-transform:uppercase;letter-spacing:.03em;margin-top:2px}\n.add input{width:100%;padding:12px;border:1px solid #d1d1d6;border-radius:12px;font-size:15px;background:#fff}\n.pills{display:flex;gap:6px;margin:8px 0}\n.pill{flex:1;border:1px solid #d1d1d6;background:#fff;border-radius:10px;padding:9px 0;font-size:15px;font-weight:700;color:inherit;text-align:center}\n.pill.on{background:var(--ac);color:#fff;border-color:transparent}\nbutton{border:0;border-radius:12px;font-weight:600;font-size:15px}\n.act{background:var(--ac);color:#fff;padding:12px 16px;width:100%}\nh2{font-size:14px;text-transform:uppercase;letter-spacing:.02em;opacity:.55;margin:20px 2px 8px;display:flex;justify-content:space-between;align-items:center}\nh2 .pts{color:var(--ac);font-weight:700}\n.item{background:#fff;border-radius:13px;padding:11px 13px;margin-bottom:7px;display:flex;align-items:center;gap:10px;box-shadow:0 1px 2px rgba(0,0,0,.05)}\n.item.done .t{opacity:.45;text-decoration:line-through}\n.item .sp{flex:0 0 auto;min-width:30px;height:30px;padding:0 7px;border-radius:8px;background:rgba(94,92,230,.14);color:var(--ac);font-weight:700;font-size:14px;display:flex;align-items:center;justify-content:center}\n.item .t{flex:1;font-size:15px;line-height:1.3}\n.item .mv{background:#e5e5ea;color:inherit;padding:7px 11px;font-size:13px;border-radius:9px;flex:0 0 auto}\n@media(prefers-color-scheme:dark){.item .mv{background:#2c2c2e}}\n.item .ck{flex:0 0 auto;width:22px;height:22px;border-radius:50%;border:2px solid #c7c7cc;display:flex;align-items:center;justify-content:center;color:#fff;font-size:13px}\n.item.done .ck{background:#34c759;border-color:#34c759}\n.del{background:none;color:#ff453a;font-size:16px;padding:2px 4px;flex:0 0 auto}\n.empty{opacity:.5;text-align:center;margin:16px 0;font-size:14px}\n.vel{font-size:13px;opacity:.7;margin-top:6px;line-height:1.6}\n.footer{margin-top:16px;display:flex;gap:8px}\n.footer button{flex:1;padding:12px}\n.ghost{background:#e5e5ea;color:inherit}\n@media(prefers-color-scheme:dark){.ghost{background:#2c2c2e}}\n</style></head><body>\n<h1>🏃 Sprint Planner</h1>\n<div class=\"stats\">\n  <div class=\"stat\"><div class=\"n\" id=\"sCommit\">0</div><div class=\"l\">Sprint pts</div></div>\n  <div class=\"stat\"><div class=\"n\" id=\"sDone\">0</div><div class=\"l\">Done</div></div>\n  <div class=\"stat\"><div class=\"n\" id=\"sVel\">–</div><div class=\"l\">Avg velocity</div></div>\n</div>\n\n<div class=\"add\">\n  <input id=\"title\" placeholder=\"New story / task…\">\n  <div class=\"pills\" id=\"pills\"></div>\n  <button class=\"act\" onclick=\"addItem()\">Add to backlog</button>\n</div>\n\n<h2>Sprint <span class=\"pts\" id=\"sprintPts\">0 pts</span></h2>\n<div id=\"sprintList\"></div>\n\n<h2>Backlog <span class=\"pts\" id=\"backlogPts\">0 pts</span></h2>\n<div id=\"backlogList\"></div>\n\n<div class=\"footer\">\n  <button class=\"act\" onclick=\"completeSprint()\">Complete sprint</button>\n</div>\n<div class=\"vel\" id=\"velHist\"></div>\n\n<script>\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar items=[], velocities=[], pts=3, POINTS=[1,2,3,5,8,13];\nvar seed=8123;\nfunction el(i){return document.getElementById(i)}\nfunction haptic(k){if(window.myllmHaptic)myllmHaptic(k||'light')}\nfunction uid(){seed=(seed*9301+49297)%233280;return 's'+seed}\nfunction save(){store.setItem('sprint',JSON.stringify({items:items,velocities:velocities}))}\nfunction esc(s){return (s+'').replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]})}\n\nfunction buildPills(){\n  var p=el('pills');p.innerHTML='';\n  POINTS.forEach(function(v){\n    var b=document.createElement('button');b.className='pill'+(v===pts?' on':'');b.textContent=v;\n    b.onclick=function(){pts=v;buildPills();haptic('selection')};p.appendChild(b);\n  });\n}\nfunction addItem(){\n  var t=el('title').value.trim();if(!t)return;\n  items.push({id:uid(),title:t,pts:pts,where:'backlog',done:false});\n  el('title').value='';save();render();haptic('light');\n}\nfunction move(id){var it=find(id);if(!it)return;it.where=it.where==='backlog'?'sprint':'backlog';if(it.where==='backlog')it.done=false;save();render();haptic('selection')}\nfunction toggle(id){var it=find(id);if(it&&it.where==='sprint'){it.done=!it.done;save();render();haptic('selection')}}\nfunction del(id){items=items.filter(function(x){return x.id!==id});save();render();haptic('light')}\nfunction find(id){return items.filter(function(x){return x.id===id})[0]}\nfunction sum(list){return list.reduce(function(a,b){return a+(b.pts||0)},0)}\n\nfunction completeSprint(){\n  var sprint=items.filter(function(x){return x.where==='sprint'});\n  if(!sprint.length){return}\n  var done=sprint.filter(function(x){return x.done});\n  velocities.push(sum(done));\n  // remove completed, send unfinished back to backlog\n  items=items.filter(function(x){return !(x.where==='sprint'&&x.done)});\n  items.forEach(function(x){if(x.where==='sprint'){x.where='backlog';x.done=false}});\n  save();render();haptic('success');\n}\nfunction render(){\n  var sprint=items.filter(function(x){return x.where==='sprint'});\n  var backlog=items.filter(function(x){return x.where==='backlog'});\n  var doneP=sum(sprint.filter(function(x){return x.done}));\n  el('sCommit').textContent=sum(sprint);el('sDone').textContent=doneP;\n  el('sprintPts').textContent=sum(sprint)+' pts';el('backlogPts').textContent=sum(backlog)+' pts';\n  el('sVel').textContent=velocities.length?Math.round(velocities.reduce(function(a,b){return a+b},0)/velocities.length):'–';\n  drawList('sprintList',sprint,true);drawList('backlogList',backlog,false);\n  el('velHist').textContent=velocities.length?('Past sprint velocity: '+velocities.join(', ')+' pts'):'';\n}\nfunction drawList(id,list,inSprint){\n  var L=el(id);L.innerHTML='';\n  if(!list.length){L.innerHTML='<div class=\"empty\">'+(inSprint?'Move backlog items in to plan a sprint.':'Nothing in the backlog.')+'</div>';return}\n  list.forEach(function(it){\n    var d=document.createElement('div');d.className='item'+(it.done?' done':'');\n    var ck=inSprint?'<div class=\"ck\">'+(it.done?'✓':'')+'</div>':'';\n    d.innerHTML=ck+'<div class=\"sp\">'+it.pts+'</div><div class=\"t\">'+esc(it.title)+'</div>'+\n      '<button class=\"mv\">'+(inSprint?'↩︎':'→ Sprint')+'</button><button class=\"del\">✕</button>';\n    if(inSprint)d.querySelector('.ck').onclick=function(){toggle(it.id)};\n    d.querySelector('.mv').onclick=function(){move(it.id)};\n    d.querySelector('.del').onclick=function(){del(it.id)};\n    L.appendChild(d);\n  });\n}\nel('title').addEventListener('keydown',function(e){if(e.key==='Enter')addItem()});\nbuildPills();\nstore.getItem('sprint').then(function(v){if(v){try{var o=JSON.parse(v);items=o.items||[];velocities=o.velocities||[]}catch(e){}}render()});\n</script></body></html>\n"}