{"name": "Bluesky Feed", "kind": "html", "iconSymbol": "cloud.fill", "iconColor": "cyan", "html": "<!doctype html>\n<!--\n  Bluesky Feed — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Bluesky Feed</title>\n<style>\n  :root { color-scheme: light dark; }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111);\n    max-width:640px; margin:0 auto; min-height:100dvh;\n    padding-bottom:calc(30px + env(safe-area-inset-bottom));\n  }\n  .hero{\n    height:100px; background:#27425f center/cover; position:relative;\n    display:flex; align-items:flex-end; padding:12px 16px;\n  }\n  .hero::after{ content:\"\"; position:absolute; inset:0; background:linear-gradient(180deg, transparent 30%, rgba(0,0,0,.4)); }\n  .hero h1{ position:relative; z-index:1; color:#fff; font-size:22px; font-weight:800; text-shadow:0 2px 8px rgba(0,0,0,.5); }\n  .wrap{ padding:12px 14px; }\n\n  .tabs{ display:flex; background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8); border-radius:13px; padding:3px; margin-bottom:12px; }\n  .tabs button{\n    flex:1; border:none; background:none; color:var(--myllm-muted,#8a8a8e);\n    border-radius:10px; padding:9px; font-size:14px; font-weight:700;\n  }\n  .tabs button.on{ background:var(--myllm-accent,#0a84ff); color:#fff; }\n\n  .card{\n    background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8);\n    border-radius:16px; padding:13px 14px; margin-bottom:10px;\n  }\n  .post{ display:flex; gap:10px; }\n  .post img.av{ width:42px; height:42px; border-radius:50%; flex-shrink:0; background:#ccc; }\n  .post .b{ flex:1; min-width:0; }\n  .post .who{ font-size:14px; }\n  .post .who b{ font-weight:750; }\n  .post .who span{ color:var(--myllm-muted,#8a8a8e); font-size:12.5px; }\n  .post .txt{ font-size:15px; line-height:1.42; margin-top:3px; white-space:pre-wrap; word-wrap:break-word; }\n  .post .media{ display:flex; gap:6px; margin-top:8px; overflow:hidden; border-radius:10px; }\n  .post .media img{ flex:1; min-width:0; max-height:220px; object-fit:cover; border-radius:10px; }\n  .post .foot{ display:flex; gap:16px; margin-top:8px; font-size:12.5px; color:var(--myllm-muted,#8a8a8e); }\n  .post .foot a{ margin-left:auto; color:var(--myllm-accent,#0a84ff); text-decoration:none; font-weight:650; }\n\n  .row{ display:flex; gap:8px; }\n  input, textarea{\n    width:100%; font-size:16px; padding:11px 12px; border-radius:12px;\n    border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111);\n    font-family:inherit;\n  }\n  textarea{ min-height:110px; resize:vertical; line-height:1.45; }\n  .go{\n    border:none; border-radius:12px; padding:0 18px; font-size:15px; font-weight:700;\n    background:var(--myllm-accent,#0a84ff); color:#fff;\n  }\n  .wide{ width:100%; padding:13px; margin-top:10px; }\n  .go:disabled{ opacity:.5; }\n  label{ display:block; font-size:11.5px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:var(--myllm-muted,#8a8a8e); margin:10px 0 6px; }\n  label:first-child{ margin-top:0; }\n  .note{ font-size:12.5px; color:var(--myllm-muted,#8a8a8e); line-height:1.5; margin-top:8px; }\n  .note a{ color:var(--myllm-accent,#0a84ff); }\n  .status{ text-align:center; font-size:13.5px; color:var(--myllm-muted,#8a8a8e); padding:18px 10px; line-height:1.5; }\n  .meta{ display:flex; justify-content:space-between; margin-top:6px; font-size:12.5px; color:var(--myllm-muted,#8a8a8e); }\n  .meta .over{ color:#ff3b30; font-weight:700; }\n  .okline{ color:#30a14e; font-size:13px; font-weight:650; margin-top:8px; }\n  .errline{ color:#ff3b30; font-size:13px; margin-top:8px; }\n  .refresh{ width:100%; border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-surface,#fff); color:var(--myllm-text,#111); border-radius:12px; padding:11px; font-size:14px; font-weight:650; margin-bottom:10px; }\n</style>\n<style>:root{--build-id:\"1027d9e687\";}</style>\n</head>\n<body>\n\n<div class=\"hero\" id=\"hero\"><h1>🦋 Bluesky Feed</h1></div>\n<div class=\"wrap\">\n  <div class=\"tabs\">\n    <button id=\"tabD\" class=\"on\" onclick=\"showTab('d')\">Discover</button>\n    <button id=\"tabP\" onclick=\"showTab('p')\">People</button>\n    <button id=\"tabW\" onclick=\"showTab('w')\">Write</button>\n  </div>\n\n  <div id=\"paneD\">\n    <button class=\"refresh\" onclick=\"loadDiscover()\">↻ Refresh</button>\n    <div id=\"feedD\"><p class=\"status\">Loading the Discover feed…</p></div>\n  </div>\n\n  <div id=\"paneP\" style=\"display:none\">\n    <div class=\"card\">\n      <div class=\"row\">\n        <input id=\"handle\" placeholder=\"someone.bsky.social\" autocapitalize=\"none\" autocorrect=\"off\" onkeydown=\"if(event.key==='Enter')loadProfile()\">\n        <button class=\"go\" onclick=\"loadProfile()\">View</button>\n      </div>\n    </div>\n    <div id=\"feedP\"></div>\n  </div>\n\n  <div id=\"paneW\" style=\"display:none\">\n    <div class=\"card\">\n      <label>New post</label>\n      <textarea id=\"compose\" placeholder=\"What's happening?\" oninput=\"onCompose()\"></textarea>\n      <div class=\"meta\"><b id=\"ccount\">0</b><span>300 max</span></div>\n      <button class=\"go wide\" id=\"postBtn\" onclick=\"doPost()\">Post to Bluesky</button>\n      <div id=\"postmsg\"></div>\n    </div>\n    <div class=\"card\">\n      <label>Your account</label>\n      <input id=\"ident\" placeholder=\"you.bsky.social\" autocapitalize=\"none\" autocorrect=\"off\">\n      <div style=\"height:8px\"></div>\n      <input id=\"apppass\" type=\"password\" placeholder=\"app password (xxxx-xxxx-xxxx-xxxx)\">\n      <button class=\"go wide\" onclick=\"saveCreds()\">Save on this device</button>\n      <p class=\"note\">Use an <b>app password</b>, never your real one: in the Bluesky app → Settings → Privacy &amp; Security → App Passwords → Add. Your details are stored only on this device and sent only to Bluesky itself.</p>\n      <div id=\"credmsg\"></div>\n    </div>\n  </div>\n</div>\n\n<script>\nvar store = window.myllmStorage || {getItem:function(){return Promise.resolve(null)}, setItem:function(){return Promise.resolve()}};\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nvar NET = window.myllmFetch || null;\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\"); }\n\nvar HERO = \"data:image/jpeg;base64,\";\nif (HERO.indexOf(\"data:\") === 0) el(\"hero\").style.backgroundImage = \"url(\" + HERO + \")\";\n\nvar PUB = \"https://public.api.bsky.app/xrpc/\";\nvar PDS = \"https://bsky.social/xrpc/\";\nvar DISCOVER = \"at://did:plc:z72i7hdynmk6r22z27h6tvur/app.bsky.feed.generator/whats-hot\";\nvar creds = null;\n\nfunction showTab(t){\n  haptic(\"selection\");\n  el(\"paneD\").style.display = t === \"d\" ? \"block\" : \"none\";\n  el(\"paneP\").style.display = t === \"p\" ? \"block\" : \"none\";\n  el(\"paneW\").style.display = t === \"w\" ? \"block\" : \"none\";\n  el(\"tabD\").className = t === \"d\" ? \"on\" : \"\";\n  el(\"tabP\").className = t === \"p\" ? \"on\" : \"\";\n  el(\"tabW\").className = t === \"w\" ? \"on\" : \"\";\n}\n\nfunction timeAgo(iso){\n  var s = (Date.now() - new Date(iso).getTime()) / 1000;\n  if (s < 60) return \"now\";\n  if (s < 3600) return Math.floor(s/60) + \"m\";\n  if (s < 86400) return Math.floor(s/3600) + \"h\";\n  return Math.floor(s/86400) + \"d\";\n}\n\nfunction postCard(item){\n  var p = item.post || item;\n  var a = p.author || {};\n  var rec = p.record || {};\n  var imgs = \"\";\n  var emb = p.embed;\n  if (emb && emb.images && emb.images.length){\n    imgs = '<div class=\"media\">' + emb.images.slice(0,2).map(function(im){\n      return '<img src=\"' + esc(im.thumb || \"\") + '\" alt=\"\" loading=\"lazy\">';\n    }).join(\"\") + '</div>';\n  }\n  var rkey = (p.uri || \"\").split(\"/\").pop();\n  var link = \"https://bsky.app/profile/\" + esc(a.handle || \"\") + \"/post/\" + esc(rkey);\n  return '<div class=\"card\"><div class=\"post\">' +\n    (a.avatar ? '<img class=\"av\" src=\"' + esc(a.avatar) + '\" alt=\"\" loading=\"lazy\">' : '<div class=\"av\"></div>') +\n    '<div class=\"b\"><div class=\"who\"><b>' + esc(a.displayName || a.handle || \"?\") + '</b> ' +\n    '<span>@' + esc(a.handle || \"\") + ' · ' + timeAgo(rec.createdAt || p.indexedAt) + '</span></div>' +\n    '<div class=\"txt\">' + esc(rec.text || \"\") + '</div>' + imgs +\n    '<div class=\"foot\"><span>💬 ' + (p.replyCount || 0) + '</span><span>🔁 ' + (p.repostCount || 0) + '</span><span>❤️ ' + (p.likeCount || 0) + '</span>' +\n    '<a href=\"' + link + '\">open ↗</a></div>' +\n    '</div></div></div>';\n}\n\nfunction renderFeed(target, items, emptyMsg){\n  if (!items || !items.length){\n    el(target).innerHTML = '<p class=\"status\">' + emptyMsg + '</p>';\n    return;\n  }\n  el(target).innerHTML = items.map(postCard).join(\"\");\n}\n\nfunction netGuard(target){\n  if (!NET){\n    el(target).innerHTML = '<p class=\"status\">This app needs internet access for apps — turn it on in MyLLMos settings, then reopen.</p>';\n    return false;\n  }\n  return true;\n}\n\nfunction loadDiscover(){\n  if (!netGuard(\"feedD\")) return;\n  el(\"feedD\").innerHTML = '<p class=\"status\">Loading the Discover feed…</p>';\n  NET(PUB + \"app.bsky.feed.getFeed?feed=\" + encodeURIComponent(DISCOVER) + \"&limit=40\")\n  .then(function(r){\n    var j = JSON.parse(r.body);\n    renderFeed(\"feedD\", j.feed, \"Nothing came back — try refresh.\");\n    haptic(\"selection\");\n  })\n  .catch(function(){\n    el(\"feedD\").innerHTML = '<p class=\"status\">Couldn\\'t reach Bluesky just now — pull yourself together and tap refresh.</p>';\n  });\n}\n\nfunction loadProfile(){\n  var h = el(\"handle\").value.trim().replace(/^@/, \"\");\n  if (!h) return;\n  if (!netGuard(\"feedP\")) return;\n  haptic(\"light\");\n  el(\"feedP\").innerHTML = '<p class=\"status\">Loading @' + esc(h) + '…</p>';\n  NET(PUB + \"app.bsky.feed.getAuthorFeed?actor=\" + encodeURIComponent(h) + \"&limit=30\")\n  .then(function(r){\n    var j = JSON.parse(r.body);\n    if (j.error) throw new Error(j.message || j.error);\n    renderFeed(\"feedP\", j.feed, \"No posts from @\" + esc(h) + \" yet.\");\n  })\n  .catch(function(){\n    el(\"feedP\").innerHTML = '<p class=\"status\">Couldn\\'t find that account — check the handle (e.g. name.bsky.social).</p>';\n  });\n}\n\n/* ---------- posting ---------- */\nfunction onCompose(){\n  var n = el(\"compose\").value.length;\n  el(\"ccount\").textContent = n;\n  el(\"ccount\").className = n > 300 ? \"over\" : \"\";\n}\nfunction saveCreds(){\n  var i = el(\"ident\").value.trim().replace(/^@/, \"\");\n  var p = el(\"apppass\").value.trim();\n  if (!i || !p){ el(\"credmsg\").innerHTML = '<div class=\"errline\">Fill in both fields.</div>'; return; }\n  creds = {i:i, p:p};\n  store.setItem(\"bsky_creds\", JSON.stringify(creds));\n  el(\"credmsg\").innerHTML = '<div class=\"okline\">Saved — you can post now.</div>';\n  haptic(\"success\");\n}\nfunction doPost(){\n  var text = el(\"compose\").value.trim();\n  if (!text){ el(\"postmsg\").innerHTML = '<div class=\"errline\">Write something first.</div>'; return; }\n  if (text.length > 300){ el(\"postmsg\").innerHTML = '<div class=\"errline\">Too long for Bluesky — 300 characters max.</div>'; return; }\n  if (!creds){ el(\"postmsg\").innerHTML = '<div class=\"errline\">Add your account below first.</div>'; return; }\n  if (!NET){ el(\"postmsg\").innerHTML = '<div class=\"errline\">Needs internet access for apps (MyLLMos settings).</div>'; return; }\n  haptic(\"light\");\n  el(\"postBtn\").disabled = true;\n  el(\"postmsg\").innerHTML = \"\";\n  NET(PDS + \"com.atproto.server.createSession\", {\n    method:\"POST\",\n    headers:{\"Content-Type\":\"application/json\"},\n    body:JSON.stringify({identifier:creds.i, password:creds.p})\n  })\n  .then(function(r){\n    var s = JSON.parse(r.body);\n    if (!s.accessJwt) throw new Error(s.message || \"Sign-in failed — check handle and app password.\");\n    return NET(PDS + \"com.atproto.repo.createRecord\", {\n      method:\"POST\",\n      headers:{\"Content-Type\":\"application/json\", \"Authorization\":\"Bearer \" + s.accessJwt},\n      body:JSON.stringify({\n        repo:s.did,\n        collection:\"app.bsky.feed.post\",\n        record:{\"$type\":\"app.bsky.feed.post\", text:text, createdAt:new Date().toISOString()}\n      })\n    });\n  })\n  .then(function(r){\n    var j = JSON.parse(r.body);\n    if (!j.uri) throw new Error(j.message || \"Posting failed.\");\n    el(\"compose\").value = \"\"; onCompose();\n    el(\"postmsg\").innerHTML = '<div class=\"okline\">Posted ✓ — it\\'s live on Bluesky.</div>';\n    el(\"postBtn\").disabled = false;\n    haptic(\"success\");\n  })\n  .catch(function(e){\n    el(\"postmsg\").innerHTML = '<div class=\"errline\">' + esc(e && e.message ? e.message : \"Something went wrong — try again.\") + '</div>';\n    el(\"postBtn\").disabled = false;\n  });\n}\n\n/* ---------- boot ---------- */\nstore.getItem(\"bsky_creds\").then(function(v){\n  if (v){ try{ creds = JSON.parse(v); if (creds) el(\"ident\").value = creds.i || \"\"; }catch(e){} }\n  loadDiscover();\n});\n</script>\n</body>\n</html>\n"}