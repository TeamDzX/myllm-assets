{"name": "Bluesky Feed", "kind": "html", "iconSymbol": "cloud.fill", "iconColor": "cyan", "html": "<!doctype html>\n<!--\n  Bluesky Feed — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Bluesky Feed</title>\n<style>\n  :root{ color-scheme:light dark;\n    --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n    --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n    --fill:rgba(120,120,128,.12); --h:205; }\n  @media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n    --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:640px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.96); }\n  [hidden]{ display:none !important; }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 12px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 28%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  .head .acts{ display:flex; gap:8px; flex-shrink:0; }\n  .ib{ width:40px; height:40px; border-radius:12px; border:1px solid var(--line); background:var(--surface); display:flex; align-items:center; justify-content:center; font-size:17px; }\n  .ib.busy svg{ animation:spin .8s linear infinite; }\n  .ib.gone{ visibility:hidden; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n\n  /* the art from the old banner, now a quiet strip under the header */\n  .art{ height:84px; border-radius:18px; margin-bottom:4px; background:hsl(var(--h) 40% 30%) center/cover; box-shadow:inset 0 0 0 1px rgba(255,255,255,.06); }\n\n  .stick{ position:sticky; top:0; z-index:5; margin:0 calc(-16px - env(safe-area-inset-right)) 8px calc(-16px - env(safe-area-inset-left));\n    padding:8px calc(16px + env(safe-area-inset-right)) 10px calc(16px + env(safe-area-inset-left));\n    background:color-mix(in srgb, var(--bg) 90%, transparent); -webkit-backdrop-filter:saturate(180%) blur(12px); backdrop-filter:saturate(180%) blur(12px); }\n  .seg{ display:flex; background:var(--fill); border-radius:12px; padding:3px; }\n  .seg button{ flex:1; min-height:36px; border:0; background:none; border-radius:9px; font-size:14px; font-weight:700; color:var(--muted); }\n  .seg button.on{ background:var(--surface); color:var(--ink); box-shadow:0 1px 3px rgba(0,0,0,.14); }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:10px; }\n  .post{ display:flex; gap:11px; }\n  .av{ width:42px; height:42px; border-radius:50%; flex-shrink:0; object-fit:cover; background:var(--fill); }\n  .av.ini{ display:flex; align-items:center; justify-content:center; color:#fff; font-size:15px; font-weight:800; letter-spacing:.02em;\n    background:linear-gradient(145deg, hsl(var(--ah,210) 55% 52%), hsl(calc(var(--ah,210) + 35) 50% 32%)); }\n  .post .b{ flex:1; min-width:0; }\n  .post .who{ font-size:14.5px; line-height:1.3; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  .post .who b{ font-weight:750; }\n  .post .who span{ color:var(--muted); font-size:13px; }\n  .post .txt{ font-size:15.5px; line-height:1.45; margin-top:4px; white-space:pre-wrap; overflow-wrap:anywhere; }\n  .post .media{ display:grid; grid-template-columns:repeat(auto-fit,minmax(0,1fr)); gap:6px; margin-top:9px; }\n  .post .media img{ width:100%; height:100%; max-height:240px; aspect-ratio:4/3; object-fit:cover; border-radius:12px; background:var(--fill); }\n  .post .foot{ display:flex; align-items:center; gap:16px; margin-top:9px; font-size:13px; color:var(--muted); font-variant-numeric:tabular-nums; }\n  .post .foot span{ display:inline-flex; align-items:center; gap:5px; }\n  .post .foot svg.i{ width:1.1em; height:1.1em; }\n  .post .foot a{ margin-left:auto; min-height:32px; padding:0 11px; border-radius:99px; background:var(--fill); color:var(--ink); font-weight:650; text-decoration:none; display:inline-flex; align-items:center; gap:5px; }\n\n  label.k{ display:block; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:14px 2px 7px; }\n  label.k:first-child{ margin-top:0; }\n  .search{ display:flex; gap:8px; }\n  .field{ flex:1; min-width:0; display:flex; align-items:center; gap:8px; border:1px solid var(--line); background:var(--bg); border-radius:12px; padding:0 12px; }\n  .field svg{ color:var(--muted); }\n  .field input{ flex:1; min-width:0; border:0; background:none; outline:none; font:inherit; font-size:16px; padding:12px 0; color:var(--ink); }\n  .field:focus-within{ border-color:var(--acc); }\n  input.plain, textarea{ width:100%; font:inherit; font-size:16px; padding:12px; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; }\n  input.plain:focus, textarea:focus{ border-color:var(--acc); }\n  textarea{ min-height:120px; resize:vertical; line-height:1.45; }\n  .go{ flex-shrink:0; min-height:46px; border:0; border-radius:12px; padding:0 16px; background:var(--acc); color:#fff; font-size:15px; font-weight:700; display:flex; align-items:center; justify-content:center; gap:7px; }\n  .go.wide{ width:100%; min-height:50px; margin-top:12px; border-radius:14px; }\n  .go:disabled{ opacity:.55; }\n  .spin{ width:16px; height:16px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; }\n  .meta{ display:flex; justify-content:space-between; margin-top:7px; font-size:12.5px; color:var(--muted); font-variant-numeric:tabular-nums; }\n  .meta .over{ color:#ff453a; font-weight:800; }\n  .note{ font-size:12.5px; color:var(--muted); line-height:1.5; margin-top:10px; }\n  .note a{ color:var(--acc); }\n  .okline, .errline{ display:flex; align-items:flex-start; gap:7px; font-size:13.5px; line-height:1.45; margin-top:10px; border-radius:12px; padding:10px 12px; }\n  .okline{ color:#1c9a4a; background:rgba(52,199,89,.12); font-weight:650; }\n  .errline{ color:#e0352b; background:rgba(255,69,58,.1); }\n  @media (prefers-color-scheme:dark){ .okline{ color:#4be07d; } .errline{ color:#ff6b62; } }\n  .okline svg.i, .errline svg.i{ margin-top:1px; }\n\n  .sk{ display:flex; gap:11px; background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:10px; }\n  .sk b{ width:42px; height:42px; border-radius:50%; background:var(--fill); flex-shrink:0; animation:pulse 1.3s ease-in-out infinite; }\n  .sk div{ flex:1; }\n  .sk i{ display:block; height:12px; border-radius:6px; background:var(--fill); margin-bottom:9px; animation:pulse 1.3s ease-in-out infinite; }\n  .sk i:first-child{ width:45%; } .sk i:last-child{ width:65%; margin-bottom:0; }\n  @keyframes pulse{ 50%{ opacity:.45; } }\n\n  .notice{ display:flex; gap:12px; align-items:flex-start; background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:14px; margin:0 0 10px; }\n  .notice .tile{ width:36px; height:36px; border-radius:10px; font-size:15px; }\n  .notice.err .tile{ background:linear-gradient(145deg,#ff6b5f,#c0392b); }\n  .notice.off .tile{ background:linear-gradient(145deg,#8e8e93,#48484a); }\n  .notice b{ display:block; font-size:15px; font-weight:750; }\n  .notice p{ font-size:13.5px; color:var(--muted); margin-top:2px; line-height:1.45; }\n  .notice button{ margin-top:10px; min-height:36px; padding:0 14px; border-radius:10px; border:0; background:var(--acc); color:#fff; font-weight:700; font-size:13.5px; display:inline-flex; align-items:center; gap:6px; }\n\n  @media (max-width:350px){ .seg button{ font-size:13px; } .art{ height:64px; } }\n  @media (max-height:520px) and (min-width:600px){ .art{ display:none; } }\n  @media (prefers-reduced-motion:reduce){ .sk b, .sk i, .ib.busy svg{ animation:none; } .spin{ animation-duration:2.4s; } button:active{ transform:none; } }\n\n</style>\n<style>:root{--build-id:\"1027d9e687\";}</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-refresh\" viewBox=\"0 0 24 24\"><path d=\"M20 12a8 8 0 1 1-2.6-5.9M20 4v5h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-chat\" viewBox=\"0 0 24 24\"><path d=\"M5 4h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-6.6L8 20.6a.6.6 0 0 1-1-.45V17H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z\"/></symbol>\n  <symbol id=\"i-repost\" viewBox=\"0 0 24 24\"><path d=\"M7 7h9.6l-1.8-1.8a1 1 0 1 1 1.4-1.4l3.5 3.5a1 1 0 0 1 0 1.4l-3.5 3.5a1 1 0 0 1-1.4-1.4L16.6 9H7a1 1 0 0 0-1 1v1.5a1 1 0 0 1-2 0V10a3 3 0 0 1 3-3zm13 5.5a1 1 0 0 1 1 1V14a3 3 0 0 1-3 3H8.4l1.8 1.8a1 1 0 0 1-1.4 1.4l-3.5-3.5a1 1 0 0 1 0-1.4l3.5-3.5a1 1 0 0 1 1.4 1.4L8.4 15H18a1 1 0 0 0 1-1v-.5a1 1 0 0 1 1-1z\"/></symbol>\n  <symbol id=\"i-heart\" viewBox=\"0 0 24 24\"><path d=\"M12 20.4c-.3 0-.6-.1-.8-.3C6 15.9 3 13 3 9.3A4.8 4.8 0 0 1 7.8 4.5c1.7 0 3.2.8 4.2 2.1a5.2 5.2 0 0 1 4.2-2.1A4.8 4.8 0 0 1 21 9.3c0 3.7-3 6.6-8.2 10.8-.2.2-.5.3-.8.3z\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.8l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 16.8l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z\"/></symbol>\n  <symbol id=\"i-ext\" viewBox=\"0 0 24 24\"><path d=\"M14 4h6v6M20 4l-9 9M18 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-at\" viewBox=\"0 0 24 24\"><path d=\"M12 3a9 9 0 0 1 9 9v1.2a3.3 3.3 0 0 1-6 1.9A4.5 4.5 0 1 1 16.5 12v1.2a1.3 1.3 0 0 0 2.5 0V12a7 7 0 1 0-3.4 6 1 1 0 1 1 1 1.7A9 9 0 1 1 12 3zm0 6.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M5 12.6l4.6 4.6L19.2 7.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-send\" viewBox=\"0 0 24 24\"><path d=\"M3.4 11.1L19.6 3.6a1 1 0 0 1 1.3 1.3l-7.5 16.2a1 1 0 0 1-1.8-.1L9.9 14.1 3.5 12.9a1 1 0 0 1-.1-1.8z\"/></symbol>\n  <symbol id=\"i-hash\" viewBox=\"0 0 24 24\"><path d=\"M9.5 4L7.5 20M16.5 4l-2 16M4.5 9h16M3.5 15h16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-cloud\" viewBox=\"0 0 24 24\"><path d=\"M7 19a4.5 4.5 0 0 1-.6-9 6 6 0 0 1 11.5 1.5A3.8 3.8 0 0 1 17.5 19z\"/></symbol>\n  <symbol id=\"i-mega\" viewBox=\"0 0 24 24\"><path d=\"M18.5 3.3a1 1 0 0 1 1.5.9v13.6a1 1 0 0 1-1.5.9L13 15.5H9.8l.9 4a1 1 0 0 1-1 1.2H8.2a1 1 0 0 1-1-.8L6.1 15.5H5.5A2.5 2.5 0 0 1 3 13V9a2.5 2.5 0 0 1 2.5-2.5H13z\"/></symbol>\n  <symbol id=\"i-off\" viewBox=\"0 0 24 24\"><path d=\"M3.3 3.3a1 1 0 0 1 1.4 0l16 16a1 1 0 0 1-1.4 1.4l-3.5-3.5a2 2 0 1 1-2.5-2.5L10.8 12a5 5 0 0 0-3.4 1.6 1 1 0 0 1-1.5-1.3 7 7 0 0 1 3.1-2L7 8.4a10 10 0 0 0-3.2 2.2 1 1 0 0 1-1.4-1.4A12 12 0 0 1 5.6 7L3.3 4.7a1 1 0 0 1 0-1.4zM12 6c3.5 0 6.8 1.4 9.2 3.8a1 1 0 0 1-1.4 1.4A11 11 0 0 0 12 8h-.6L9.6 6.2C10.4 6.1 11.2 6 12 6z\"/></symbol>\n  <symbol id=\"i-warn\" viewBox=\"0 0 24 24\"><path d=\"M10.3 3.9a2 2 0 0 1 3.4 0l8 13.6a2 2 0 0 1-1.7 3H4a2 2 0 0 1-1.7-3zM12 9a1 1 0 0 0-1 1v4a1 1 0 0 0 2 0v-4a1 1 0 0 0-1-1zm0 7.2a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z\"/></symbol>\n</defs></svg>\n\n<div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-cloud\"/></svg></div>\n  <div class=\"ht\"><h1>Bluesky Feed</h1><p>The open sky, in your pocket</p></div>\n  <div class=\"acts\"><button class=\"ib\" id=\"refresh\" type=\"button\" aria-label=\"Refresh\"><svg class=\"i\"><use href=\"#i-refresh\"/></svg></button></div>\n</div>\n<div class=\"art\" id=\"hero\" aria-hidden=\"true\"></div>\n<div class=\"stick\">\n  <div class=\"seg\" role=\"tablist\">\n    <button id=\"tabD\" class=\"on\" type=\"button\" onclick=\"showTab('d')\">Discover</button>\n    <button id=\"tabP\" type=\"button\" onclick=\"showTab('p')\">People</button>\n    <button id=\"tabW\" type=\"button\" onclick=\"showTab('w')\">Write</button>\n  </div>\n</div>\n\n<div id=\"paneD\">\n  <div id=\"feedD\"></div>\n</div>\n\n<div id=\"paneP\" hidden>\n  <div class=\"card\">\n    <div class=\"search\">\n      <label class=\"field\"><svg class=\"i\"><use href=\"#i-at\"/></svg><input id=\"handle\" placeholder=\"someone.bsky.social\" autocapitalize=\"none\" autocorrect=\"off\" spellcheck=\"false\" enterkeyhint=\"search\" aria-label=\"Handle\" onkeydown=\"if(event.key==='Enter')loadProfile()\"></label>\n      <button class=\"go\" type=\"button\" onclick=\"loadProfile()\">View</button>\n    </div>\n  </div>\n  <div id=\"feedP\"></div>\n</div>\n\n<div id=\"paneW\" hidden>\n  <div class=\"card\">\n    <label class=\"k\" for=\"compose\">New post</label>\n    <textarea id=\"compose\" placeholder=\"What's happening?\" oninput=\"onCompose()\"></textarea>\n    <div class=\"meta\"><b id=\"ccount\">0</b><span>300 max</span></div>\n    <button class=\"go wide\" id=\"postBtn\" type=\"button\" onclick=\"doPost()\"><svg class=\"i\"><use href=\"#i-send\"/></svg><span>Post to Bluesky</span></button>\n    <div id=\"postmsg\"></div>\n  </div>\n  <div class=\"card\">\n    <label class=\"k\" for=\"ident\">Your account</label>\n    <input class=\"plain\" id=\"ident\" placeholder=\"you.bsky.social\" autocapitalize=\"none\" autocorrect=\"off\" spellcheck=\"false\">\n    <div style=\"height:8px\"></div>\n    <input class=\"plain\" id=\"apppass\" type=\"password\" placeholder=\"app password (xxxx-xxxx-xxxx-xxxx)\" aria-label=\"App password\">\n    <button class=\"go wide\" type=\"button\" onclick=\"saveCreds()\">Save on this device</button>\n    <p class=\"note\">Use an <b>app password</b>, never your real one: in the Bluesky app → Settings → Privacy &amp; Security → App Passwords → Add. Your details are stored only on this device and sent only to Bluesky itself.</p>\n    <div id=\"credmsg\"></div>\n  </div>\n</div>\n\n<script>\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction store(){ return window.myllmStorage || {getItem:function(){return Promise.resolve(null)}, setItem:function(){return Promise.resolve()}}; }\nfunction NET(url, opts){ var f = window.myllmFetch; if (!f) return Promise.reject(new Error(\"no network bridge\")); return f(url, opts); }\nfunction hasNet(){ return !!window.myllmFetch; }\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\"); }\nfunction icon(n){ return '<svg class=\"i\"><use href=\"#i-' + n + '\"/></svg>'; }\nfunction okLine(t){ return '<div class=\"okline\">' + icon(\"check\") + '<span>' + t + '</span></div>'; }\nfunction errLine(t){ return '<div class=\"errline\">' + icon(\"warn\") + '<span>' + t + '</span></div>'; }\nfunction skeleton(target, n){ var h = \"\"; for (var i = 0; i < (n || 4); i++) h += '<div class=\"sk\"><b></b><div><i></i><i></i><i></i></div></div>'; el(target).innerHTML = h; }\nfunction notice(target, kind, title, text, retry){\n  var box = el(target);\n  box.innerHTML = '<div class=\"notice ' + kind + '\"><div class=\"tile\">' + icon(kind === \"off\" ? \"off\" : \"warn\") + '</div><div><b>' + esc(title) + '</b><p>' + esc(text) + '</p>' +\n    (retry ? '<button type=\"button\">' + icon(\"refresh\") + 'Try again</button>' : '') + '</div></div>';\n  if (retry) box.querySelector(\".notice button\").onclick = retry;\n}\n/* Round avatar; if there's no picture, or it fails to load, the person's initials on a hue of their own. */\nfunction hueOf(s){ var h = 0; s = String(s || \"\"); for (var i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) % 360; return h; }\nfunction initials(name){ var w = String(name || \"?\").replace(/[^\\p{L}\\p{N} ]/gu, \" \").trim().split(/\\s+/); return ((w[0] || \"?\")[0] + (w.length > 1 ? w[w.length - 1][0] : \"\")).toUpperCase(); }\nfunction avatarHtml(src, name, key){\n  var ini = '<div class=\"av ini\" style=\"--ah:' + hueOf(key || name) + '\" data-ini=\"1\">' + esc(initials(name)) + '</div>';\n  return src ? '<img class=\"av\" src=\"' + esc(src) + '\" alt=\"\" loading=\"lazy\" data-name=\"' + esc(name) + '\" data-key=\"' + esc(key || name) + '\">' : ini;\n}\nfunction wireAvatars(root){\n  Array.prototype.forEach.call(root.querySelectorAll(\"img.av\"), function(img){\n    img.onerror = function(){\n      if (!img.parentNode) return;\n      var d = document.createElement(\"div\");\n      d.className = \"av ini\"; d.style.setProperty(\"--ah\", hueOf(img.getAttribute(\"data-key\")));\n      d.textContent = initials(img.getAttribute(\"data-name\"));\n      img.parentNode.replaceChild(d, img);\n    };\n  });\n}\nfunction timeAgo(iso){\n  var s = (Date.now() - new Date(iso).getTime()) / 1000;\n  if (s < 60) return \"now\";\n  if (s < 3600) return Math.floor(s/60) + \"m\";\n  if (s < 86400) return Math.floor(s/3600) + \"h\";\n  return Math.floor(s/86400) + \"d\";\n}\n\nvar HERO = \"data:image/jpeg;base64,\";\nif (HERO.indexOf(\"data:\") === 0) el(\"hero\").style.backgroundImage = \"url(\" + HERO + \")\";\n\nvar PUB = \"https://public.api.bsky.app/xrpc/\";\nvar PDS = \"https://bsky.social/xrpc/\";\nvar DISCOVER = \"at://did:plc:z72i7hdynmk6r22z27h6tvur/app.bsky.feed.generator/whats-hot\";\nvar creds = null, tab = \"d\";\n\nfunction showTab(t){\n  haptic(\"selection\");\n  tab = t;\n  el(\"paneD\").hidden = t !== \"d\";\n  el(\"paneP\").hidden = t !== \"p\";\n  el(\"paneW\").hidden = t !== \"w\";\n  el(\"tabD\").className = t === \"d\" ? \"on\" : \"\";\n  el(\"tabP\").className = t === \"p\" ? \"on\" : \"\";\n  el(\"tabW\").className = t === \"w\" ? \"on\" : \"\";\n  el(\"refresh\").classList.toggle(\"gone\", t === \"w\");\n}\n\nfunction postCard(item){\n  var p = item.post || item;\n  var a = p.author || {};\n  var rec = p.record || {};\n  var imgs = \"\";\n  var emb = p.embed;\n  if (emb && emb.images && emb.images.length){\n    imgs = '<div class=\"media\">' + emb.images.slice(0,2).map(function(im){\n      return '<img src=\"' + esc(im.thumb || \"\") + '\" alt=\"' + esc(im.alt || \"\") + '\" loading=\"lazy\">';\n    }).join(\"\") + '</div>';\n  }\n  var rkey = (p.uri || \"\").split(\"/\").pop();\n  var link = \"https://bsky.app/profile/\" + esc(a.handle || \"\") + \"/post/\" + esc(rkey);\n  var name = a.displayName || a.handle || \"?\";\n  return '<div class=\"card\"><div class=\"post\">' + avatarHtml(a.avatar, name, a.handle) +\n    '<div class=\"b\"><div class=\"who\"><b>' + esc(name) + '</b> ' +\n    '<span>@' + esc(a.handle || \"\") + ' · ' + timeAgo(rec.createdAt || p.indexedAt) + '</span></div>' +\n    '<div class=\"txt\">' + esc(rec.text || \"\") + '</div>' + imgs +\n    '<div class=\"foot\"><span aria-label=\"Replies\">' + icon(\"chat\") + (p.replyCount || 0) + '</span><span aria-label=\"Reposts\">' + icon(\"repost\") + (p.repostCount || 0) + '</span><span aria-label=\"Likes\">' + icon(\"heart\") + (p.likeCount || 0) + '</span>' +\n    '<a href=\"' + link + '\">Open' + icon(\"ext\") + '</a></div>' +\n    '</div></div></div>';\n}\n\nfunction renderFeed(target, items, emptyMsg){\n  if (!items || !items.length){\n    notice(target, \"err\", \"Nothing to show\", emptyMsg, target === \"feedD\" ? loadDiscover : null);\n    return;\n  }\n  el(target).innerHTML = items.map(postCard).join(\"\");\n  wireAvatars(el(target));\n}\n\nfunction netGuard(target, retry){\n  if (!hasNet()){\n    notice(target, \"off\", \"Network access is off\", \"Bluesky Feed needs “Allow apps to use the internet” in MyLLM’s Settings.\", retry);\n    return false;\n  }\n  return true;\n}\nfunction busy(on){ el(\"refresh\").classList.toggle(\"busy\", on); }\n\nfunction loadDiscover(){\n  if (!netGuard(\"feedD\", loadDiscover)) return;\n  skeleton(\"feedD\", 4); busy(true);\n  NET(PUB + \"app.bsky.feed.getFeed?feed=\" + encodeURIComponent(DISCOVER) + \"&limit=40\")\n  .then(function(r){\n    var j = JSON.parse(r.body);\n    renderFeed(\"feedD\", j.feed, \"Nothing came back — try refresh.\");\n    haptic(\"selection\");\n  })\n  .catch(function(){\n    notice(\"feedD\", \"err\", \"Couldn’t reach Bluesky\", \"It may be busy or your connection dropped.\", loadDiscover);\n  })\n  .then(function(){ busy(false); });\n}\n\nfunction loadProfile(){\n  var h = el(\"handle\").value.trim().replace(/^@/, \"\");\n  if (!h) return;\n  if (!netGuard(\"feedP\", loadProfile)) return;\n  haptic(\"light\"); el(\"handle\").blur();\n  skeleton(\"feedP\", 3); busy(true);\n  NET(PUB + \"app.bsky.feed.getAuthorFeed?actor=\" + encodeURIComponent(h) + \"&limit=30\")\n  .then(function(r){\n    var j = JSON.parse(r.body);\n    if (j.error) throw new Error(j.message || j.error);\n    renderFeed(\"feedP\", j.feed, \"No posts from @\" + h + \" yet.\");\n  })\n  .catch(function(){\n    notice(\"feedP\", \"err\", \"Couldn’t find that account\", \"Check the handle — it looks like name.bsky.social.\", null);\n  })\n  .then(function(){ busy(false); });\n}\n\n/* ---------- posting ---------- */\nfunction onCompose(){\n  var n = el(\"compose\").value.length;\n  el(\"ccount\").textContent = n;\n  el(\"ccount\").className = n > 300 ? \"over\" : \"\";\n}\nfunction saveCreds(){\n  var i = el(\"ident\").value.trim().replace(/^@/, \"\");\n  var p = el(\"apppass\").value.trim();\n  if (!i || !p){ el(\"credmsg\").innerHTML = errLine(\"Fill in both fields.\"); return; }\n  creds = {i:i, p:p};\n  store().setItem(\"bsky_creds\", JSON.stringify(creds));\n  el(\"credmsg\").innerHTML = okLine(\"Saved — you can post now.\");\n  haptic(\"success\");\n}\nfunction postBtn(on){\n  var b = el(\"postBtn\"); b.disabled = on;\n  b.innerHTML = on ? '<i class=\"spin\"></i><span>Posting…</span>' : icon(\"send\") + '<span>Post to Bluesky</span>';\n}\nfunction doPost(){\n  var text = el(\"compose\").value.trim();\n  if (!text){ el(\"postmsg\").innerHTML = errLine(\"Write something first.\"); return; }\n  if (text.length > 300){ el(\"postmsg\").innerHTML = errLine(\"Too long for Bluesky — 300 characters max.\"); return; }\n  if (!creds){ el(\"postmsg\").innerHTML = errLine(\"Add your account below first.\"); return; }\n  if (!hasNet()){ el(\"postmsg\").innerHTML = errLine(\"Needs internet access for apps (MyLLMos settings).\"); return; }\n  haptic(\"light\");\n  postBtn(true);\n  el(\"postmsg\").innerHTML = \"\";\n  NET(PDS + \"com.atproto.server.createSession\", {\n    method:\"POST\",\n    headers:{\"Content-Type\":\"application/json\"},\n    body:JSON.stringify({identifier:creds.i, password:creds.p})\n  })\n  .then(function(r){\n    var s = JSON.parse(r.body);\n    if (!s.accessJwt) throw new Error(s.message || \"Sign-in failed — check handle and app password.\");\n    return NET(PDS + \"com.atproto.repo.createRecord\", {\n      method:\"POST\",\n      headers:{\"Content-Type\":\"application/json\", \"Authorization\":\"Bearer \" + s.accessJwt},\n      body:JSON.stringify({\n        repo:s.did,\n        collection:\"app.bsky.feed.post\",\n        record:{\"$type\":\"app.bsky.feed.post\", text:text, createdAt:new Date().toISOString()}\n      })\n    });\n  })\n  .then(function(r){\n    var j = JSON.parse(r.body);\n    if (!j.uri) throw new Error(j.message || \"Posting failed.\");\n    el(\"compose\").value = \"\"; onCompose();\n    el(\"postmsg\").innerHTML = okLine(\"Posted — it's live on Bluesky.\");\n    postBtn(false);\n    haptic(\"success\");\n  })\n  .catch(function(e){\n    el(\"postmsg\").innerHTML = errLine(esc(e && e.message ? e.message : \"Something went wrong — try again.\"));\n    postBtn(false);\n  });\n}\n\nel(\"refresh\").onclick = function(){\n  if (el(\"refresh\").classList.contains(\"busy\")) return;\n  haptic(\"light\");\n  if (tab === \"p\"){ if (el(\"handle\").value.trim()) loadProfile(); else el(\"handle\").focus(); }\n  else loadDiscover();\n};\n\n/* ---------- boot ---------- */\nstore().getItem(\"bsky_creds\").then(function(v){\n  if (v){ try{ creds = JSON.parse(v); if (creds) el(\"ident\").value = creds.i || \"\"; }catch(e){} }\n  loadDiscover();\n});\n</script>\n</body>\n</html>\n"}