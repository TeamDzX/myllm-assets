{"name": "Picture Crossword", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Picture Crossword</title>\n<style>\n:root{\n  color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7);--surface:var(--myllm-surface,#fff);\n  --text:var(--myllm-text,#111);--muted:var(--myllm-muted,#6b6b72);\n  --accent:var(--myllm-accent,#ff8c42);--border:var(--myllm-border,rgba(120,120,128,.3));\n  --font:var(--myllm-font,-apple-system,system-ui,sans-serif);\n  --cell:#fff;--sel:#ffe08a;--word:#dcefff;--ok:#bdf0c4;\n}\n@media(prefers-color-scheme:dark){:root{--bg:var(--myllm-bg,#000);--surface:var(--myllm-surface,#1c1c1e);--text:var(--myllm-text,#eee);--muted:var(--myllm-muted,#98989f);--cell:#26262b;--word:#1d3a57;--ok:#1f5a2b}}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none}\nbody{margin:0;font-family:var(--font);background:var(--bg);color:var(--text)}\n.wrap{max-width:440px;margin:0 auto;padding:10px 14px 18px;text-align:center}\n.bar{display:flex;gap:8px;justify-content:center;margin-bottom:10px}\n.bar button{border:0;background:var(--surface);border:1px solid var(--border);color:var(--accent);border-radius:12px;padding:9px 14px;font:inherit;font-weight:700;font-size:14px;cursor:pointer}\n.grid{display:grid;gap:4px;width:100%;max-width:300px;margin:0 auto;aspect-ratio:1}\n.cell{position:relative;border:2px solid var(--border);background:var(--cell);color:var(--text);font:inherit;font-weight:800;font-size:min(13vw,46px);border-radius:10px;display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0}\n.cell.word{background:var(--word)}\n.cell.sel{background:var(--sel);border-color:var(--accent)}\n.cell.ok{background:var(--ok)}\n.cell .n{position:absolute;top:2px;left:4px;font-size:12px;font-weight:700;color:var(--muted)}\n.clueWrap{margin:14px 0}\n.clueTitle{font-size:13px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;margin:10px 0 6px}\n.tiles{display:flex;gap:8px;justify-content:center;flex-wrap:wrap}\n.tile{border:2px solid var(--border);background:var(--surface);border-radius:14px;padding:4px;cursor:pointer;width:62px}\n.tile.on{border-color:var(--accent)}\n.tile img{width:100%;height:50px;object-fit:contain;display:block;border-radius:8px}\n.tile .lab{font-size:11px;font-weight:700;color:var(--muted);margin-top:2px}\n.tile.solved{background:var(--ok)}\n.kb{display:flex;flex-direction:column;gap:6px;margin-top:14px}\n.kbrow{display:flex;gap:5px;justify-content:center}\n.key{flex:1;max-width:32px;height:48px;border:0;border-radius:9px;background:var(--surface);border:1px solid var(--border);color:var(--text);font:inherit;font-weight:700;font-size:18px;cursor:pointer}\n.key.wide{max-width:60px;font-size:13px}\n.key:active{background:var(--accent);color:#fff}\n.win{position:fixed;inset:0;background:rgba(0,0,0,.55);display:none;align-items:center;justify-content:center;z-index:40}\n.win.show{display:flex}\n.winB{background:var(--bg);border-radius:22px;padding:28px 26px;max-width:300px}\n.winB .big{font-size:64px}\n.winB h2{margin:6px 0 4px;font-size:24px}\n.winB p{color:var(--muted);margin:0 0 16px}\n.winB button{width:100%;border:0;background:var(--accent);color:#fff;border-radius:14px;padding:13px;font:inherit;font-weight:800;font-size:16px;cursor:pointer}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <div class=\"bar\"><button id=\"prevP\">‹</button><button id=\"clearBtn\">Start over</button><button id=\"nextP\">Next ›</button></div>\n  <div class=\"grid\" id=\"grid\"></div>\n  <div class=\"clueWrap\">\n    <div class=\"clueTitle\">Across →</div><div class=\"tiles\" id=\"acrossTiles\"></div>\n    <div class=\"clueTitle\">Down ↓</div><div class=\"tiles\" id=\"downTiles\"></div>\n  </div>\n  <div class=\"kb\" id=\"kb\"></div>\n</div>\n<div class=\"win\" id=\"win\"><div class=\"winB\"><div class=\"big\">🎉</div><h2>You did it!</h2><p id=\"winSub\">Great job!</p><button id=\"winBtn\">Next puzzle →</button></div></div>\n\n<script>\nvar IMG=\"https://raw.githubusercontent.com/TeamDzX/myllm-assets/main/apps/kids/\";\nvar PUZZLES=[\n {id:\"kid1\",name:\"Cap, Ape, Tea\",rows:[\"CAP\",\"APE\",\"TEA\"]},\n {id:\"kid2\",name:\"Pig, Ice, Gem\",rows:[\"PIG\",\"ICE\",\"GEM\"]}\n];\nvar P=null,curPuz=0,N=0,user=[],nums=[],entries=[],cur=null,dir='A',solved=false;\nfunction $(i){return document.getElementById(i)}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nfunction wordOf(e){return e.cells.map(function(x){return P.rows[x[0]][x[1]]}).join('')}\nfunction imgOf(e){return IMG+wordOf(e).toLowerCase()+'.jpg'}\n\nfunction build(){\n  N=P.rows.length;\n  user=P.rows.map(function(row){return row.split('').map(function(){return ''})});\n  nums=P.rows.map(function(row){return row.split('').map(function(){return 0})});\n  entries=[];var n=0;\n  for(var r=0;r<N;r++)for(var c=0;c<N;c++){\n    var sa=(c===0)&&true, sd=(r===0)&&true; // 3x3 no blocks: starts at edges\n    sa=(c===0)&&c+1<N; sd=(r===0)&&r+1<N;\n    if(sa||sd){n++;nums[r][c]=n;\n      if(sa){var a=[];for(var cc=0;cc<N;cc++)a.push([r,cc]);entries.push({num:n,dir:'A',cells:a})}\n      if(sd){var d=[];for(var rr=0;rr<N;rr++)d.push([rr,c]);entries.push({num:n,dir:'D',cells:d})}\n    }\n  }\n}\nfunction entryAt(r,c,d){return entries.find(function(e){return e.dir===d&&e.cells.some(function(x){return x[0]===r&&x[1]===c})})}\nfunction curEntry(){return cur?entryAt(cur[0],cur[1],dir):null}\nfunction entryDone(e){return e.cells.every(function(x){return user[x[0]][x[1]]===P.rows[x[0]][x[1]]})}\n\nfunction render(){\n  var g=$('grid');g.style.gridTemplateColumns='repeat('+N+',1fr)';g.innerHTML='';\n  var ce=curEntry();\n  for(var r=0;r<N;r++)for(var c=0;c<N;c++){\n    var b=document.createElement('button');b.className='cell';\n    if(ce&&ce.cells.some(function(x){return x[0]===r&&x[1]===c}))b.className+=' word';\n    if(user[r][c]&&user[r][c]===P.rows[r][c])b.className+=' ok';\n    if(cur&&cur[0]===r&&cur[1]===c)b.className+=' sel';\n    if(nums[r][c]){var s=document.createElement('span');s.className='n';s.textContent=nums[r][c];b.appendChild(s)}\n    b.appendChild(document.createTextNode(user[r][c]||''));\n    (function(rr,cc){b.onclick=function(){onCell(rr,cc)}})(r,c);\n    g.appendChild(b);\n  }\n  tiles();\n}\nfunction tiles(){\n  ['A','D'].forEach(function(d){\n    var box=$(d==='A'?'acrossTiles':'downTiles');box.innerHTML='';\n    entries.filter(function(e){return e.dir===d}).forEach(function(e){\n      var t=document.createElement('button');t.className='tile'+(curEntry()===e?' on':'')+(entryDone(e)?' solved':'');\n      t.innerHTML='<img src=\"'+imgOf(e)+'\" alt=\"\"><div class=\"lab\">'+e.num+(d==='A'?' →':' ↓')+'</div>';\n      t.onclick=function(){cur=e.cells[0];dir=d;haptic('selection');render()};\n      box.appendChild(t);\n    });\n  });\n}\nfunction onCell(r,c){\n  if(cur&&cur[0]===r&&cur[1]===c){dir=dir==='A'?'D':'A'}\n  else cur=[r,c];\n  haptic('selection');render();\n}\nfunction type(ch){\n  if(!cur||solved)return;user[cur[0]][cur[1]]=ch;haptic('light');\n  var e=curEntry();if(e){var i=e.cells.findIndex(function(x){return x[0]===cur[0]&&x[1]===cur[1]});if(i+1<e.cells.length)cur=e.cells[i+1]}\n  render();save();checkWin();\n}\nfunction backspace(){\n  if(!cur||solved)return;haptic('light');\n  if(user[cur[0]][cur[1]])user[cur[0]][cur[1]]='';\n  else{var e=curEntry();if(e){var i=e.cells.findIndex(function(x){return x[0]===cur[0]&&x[1]===cur[1]});if(i>0){cur=e.cells[i-1];user[cur[0]][cur[1]]=''}}}\n  render();save();\n}\nfunction checkWin(){\n  for(var r=0;r<N;r++)for(var c=0;c<N;c++)if(user[r][c]!==P.rows[r][c])return;\n  solved=true;save();haptic('success');$('winSub').textContent='You solved '+P.name+'!';$('win').classList.add('show');\n}\nfunction clearAll(){user=P.rows.map(function(row){return row.split('').map(function(){return ''})});solved=false;render();save();haptic('warning')}\n\nfunction buildKB(){\n  var rows=['QWERTYUIOP','ASDFGHJKL','ZXCVBNM'],KB=$('kb');KB.innerHTML='';\n  rows.forEach(function(row,ri){\n    var d=document.createElement('div');d.className='kbrow';\n    row.split('').forEach(function(ch){var k=document.createElement('button');k.className='key';k.textContent=ch;k.onclick=function(){type(ch)};d.appendChild(k)});\n    if(ri===2){var del=document.createElement('button');del.className='key wide';del.textContent='⌫';del.onclick=backspace;d.appendChild(del)}\n    KB.appendChild(d);\n  });\n}\n\nfunction loadPuzzle(i){\n  curPuz=(i+PUZZLES.length)%PUZZLES.length;P=PUZZLES[curPuz];solved=false;build();\n  if(window.myllmStorage){\n    myllmStorage.getItem('kid_'+P.id).then(function(v){\n      if(v)try{var s=JSON.parse(v);if(s.user)user=s.user;if(s.solved)solved=s.solved}catch(e){}\n      cur=entries[0].cells[0];dir='A';render();saveCur();\n    });\n  }else{cur=entries[0].cells[0];dir='A';render();saveCur()}\n}\nfunction save(){if(window.myllmStorage&&P)myllmStorage.setItem('kid_'+P.id,JSON.stringify({user:user,solved:solved}))}\nfunction saveCur(){if(window.myllmStorage)myllmStorage.setItem('kid_last',String(curPuz))}\n\n$('clearBtn').onclick=clearAll;\n$('prevP').onclick=function(){$('win').classList.remove('show');loadPuzzle(curPuz-1)};\n$('nextP').onclick=function(){$('win').classList.remove('show');loadPuzzle(curPuz+1)};\n$('winBtn').onclick=function(){$('win').classList.remove('show');loadPuzzle(curPuz+1)};\nbuildKB();\nif(window.myllmStorage){myllmStorage.getItem('kid_last').then(function(v){loadPuzzle(v?(+v||0):0)})}\nelse loadPuzzle(0);\n</script>\n</body>\n</html>\n", "kind": "html", "iconSymbol": "puzzlepiece.fill", "iconColor": "orange"}