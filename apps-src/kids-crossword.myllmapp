{"name": "Spell the Picture", "html": "<!doctype html>\n<!--\n  Spell the Picture — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Spell the Picture</title>\n<style>\n:root{--build-id:\"d9edd23fd0\";\n  color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7);--surface:var(--myllm-surface,#fff);\n  --text:var(--myllm-text,#111);--muted:var(--myllm-muted,#6b6b72);\n  --accent:var(--myllm-accent,#ff8c42);--border:var(--myllm-border,rgba(120,120,128,.3));\n  --font:var(--myllm-font,-apple-system,system-ui,sans-serif);\n  --box:#fff;--ok:#34c759;--tile:#fff;\n}\n@media(prefers-color-scheme:dark){:root{--bg:var(--myllm-bg,#000);--surface:var(--myllm-surface,#1c1c1e);--text:var(--myllm-text,#eee);--muted:var(--myllm-muted,#98989f);--box:#26262b;--tile:#26262b}}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none}\nbody{margin:0;font-family:var(--font);background:var(--bg);color:var(--text)}\n.wrap{max-width:440px;margin:0 auto;padding:12px 16px 22px;text-align:center;display:flex;flex-direction:column;min-height:100dvh}\n.top{display:flex;align-items:center;gap:10px;margin-bottom:6px}\n.stars{font-size:18px;font-weight:800;color:var(--accent)}\n.top .sp{flex:1}\n.top button{border:0;background:var(--surface);border:1px solid var(--border);color:var(--accent);border-radius:12px;padding:9px 14px;font:inherit;font-weight:700;font-size:14px;cursor:pointer}\n.modeseg{display:flex;background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:3px;width:200px;margin:2px auto 0}\n.modeseg button{flex:1;border:0;background:none;color:var(--muted);font:inherit;font-weight:700;font-size:14px;padding:8px;border-radius:9px;cursor:pointer}\n.modeseg button.on{background:var(--accent);color:#fff}\n.pic{flex:none;margin:6px auto 2px;width:62%;max-width:240px;aspect-ratio:1;background:var(--surface);border:2px solid var(--border);border-radius:24px;display:flex;align-items:center;justify-content:center;overflow:hidden}\n.pic img{width:100%;height:100%;object-fit:contain}\n.boxes{display:flex;gap:8px;justify-content:center;margin:18px auto;max-width:100%}\n.box{flex:1 1 0;max-width:64px;aspect-ratio:1;border:3px solid var(--border);border-radius:16px;background:var(--box);display:flex;align-items:center;justify-content:center;font-size:min(8.5vw,32px);font-weight:800;cursor:pointer}\n.box.filled{border-color:var(--accent)}\n.box.ok{border-color:var(--ok);background:var(--ok);color:#fff}\n.box.bad{border-color:#ff3b30;animation:shake .4s}\n@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-7px)}75%{transform:translateX(7px)}}\n.bank{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:8px}\n.tile{width:58px;height:58px;border:2px solid var(--border);border-radius:14px;background:var(--tile);color:var(--text);font:inherit;font-size:30px;font-weight:800;cursor:pointer;box-shadow:0 3px 0 rgba(0,0,0,.12)}\n.tile:active{transform:translateY(2px);box-shadow:none}\n.tile.used{visibility:hidden}\n.spacer{flex:1}\n.cheer{font-size:22px;font-weight:800;color:var(--ok);min-height:30px;margin-top:14px}\n.win{position:fixed;inset:0;background:rgba(0,0,0,.55);display:none;align-items:center;justify-content:center;z-index:40}\n.win.show{display:flex}\n.winB{background:var(--bg);border-radius:24px;padding:30px 26px;max-width:300px}\n.winB .big{font-size:66px}.winB h2{margin:6px 0 4px;font-size:24px}.winB p{color:var(--muted);margin:0 0 16px}\n.winB button{width:100%;border:0;background:var(--accent);color:#fff;border-radius:14px;padding:14px;font:inherit;font-weight:800;font-size:16px;cursor:pointer}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <div class=\"top\"><span class=\"stars\" id=\"stars\">⭐ 0</span><span class=\"sp\"></span>\n    <button id=\"hintBtn\">💡 Hint</button><button id=\"skipBtn\">Skip ›</button></div>\n  <div class=\"modeseg\" id=\"modeseg\"><button data-m=\"little\" class=\"on\">Little words</button><button data-m=\"big\">Big words</button></div>\n  <div class=\"pic\"><img id=\"pic\" alt=\"\"></div>\n  <div class=\"boxes\" id=\"boxes\"></div>\n  <div class=\"cheer\" id=\"cheer\"></div>\n  <div class=\"spacer\"></div>\n  <div class=\"bank\" id=\"bank\"></div>\n</div>\n<div class=\"win\" id=\"win\"><div class=\"winB\"><div class=\"big\">🌟</div><h2>Well done!</h2><p id=\"winSub\">You spelled them all!</p><button id=\"winBtn\">Play again</button></div></div>\n\n<script>\nvar IMG=\"https://raw.githubusercontent.com/TeamDzX/myllm-assets/main/apps/kids/\";\nvar WORDS_LITTLE=[\"CAT\",\"DOG\",\"PIG\",\"COW\",\"SUN\",\"BEE\",\"BUS\",\"CAR\",\"HAT\",\"FOX\",\"OWL\",\"CAP\",\"CUP\",\"BAT\"];\nvar WORDS_BIG=[\"FISH\",\"STAR\",\"FROG\",\"DUCK\",\"CAKE\",\"MOON\",\"TREE\",\"BEAR\",\"APPLE\",\"TRAIN\",\"ROBOT\",\"SNAKE\",\"TIGER\",\"HOUSE\"];\nvar mode=\"little\";\nfunction WORDS(){return mode===\"big\"?WORDS_BIG:WORDS_LITTLE}\nvar order=[],qi=0,word=\"\",bank=[],used=[],placed=[],stars=0,locked=false;\nfunction $(i){return document.getElementById(i)}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nfunction shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=a[i];a[i]=a[j];a[j]=t}return a}\n\nfunction loadWord(){\n  locked=false;$('cheer').textContent='';\n  word=order[qi];\n  $('pic').src=IMG+word.toLowerCase()+'.jpg';$('pic').alt=word;\n  bank=shuffle(word.split(''));\n  // avoid an accidentally-correct shuffle\n  if(bank.join('')===word&&word.length>1)bank=shuffle(bank);\n  used=bank.map(function(){return false});\n  placed=word.split('').map(function(){return null});\n  render();\n}\nfunction render(){\n  var B=$('boxes');B.innerHTML='';\n  for(var b=0;b<word.length;b++){\n    var d=document.createElement('div');d.className='box'+(placed[b]!=null?' filled':'');\n    d.textContent=placed[b]!=null?bank[placed[b]]:'';\n    (function(bb){d.onclick=function(){removeAt(bb)}})(b);\n    B.appendChild(d);\n  }\n  var K=$('bank');K.innerHTML='';\n  bank.forEach(function(ch,i){\n    var t=document.createElement('button');t.className='tile'+(used[i]?' used':'');t.textContent=ch;\n    (function(ii){t.onclick=function(){place(ii)}})(i);\n    K.appendChild(t);\n  });\n}\nfunction place(i){\n  if(locked||used[i])return;\n  var b=placed.indexOf(null);if(b<0)return;\n  placed[b]=i;used[i]=true;haptic('light');render();\n  if(placed.indexOf(null)<0)check();\n}\nfunction removeAt(b){\n  if(locked||placed[b]==null)return;\n  used[placed[b]]=false;placed[b]=null;haptic('selection');render();\n}\nfunction check(){\n  var spelled=placed.map(function(i){return bank[i]}).join('');\n  if(spelled===word){\n    locked=true;haptic('success');\n    var bx=$('boxes').children;for(var k=0;k<bx.length;k++)bx[k].className='box ok';\n    stars++;$('stars').textContent='⭐ '+stars;$('cheer').textContent='Yes! '+word+' 🎉';\n    setTimeout(next,1100);\n  }else{\n    haptic('warning');\n    var b2=$('boxes').children;for(var k2=0;k2<b2.length;k2++)b2[k2].classList.add('bad');\n    setTimeout(function(){ // clear and let them retry\n      placed=word.split('').map(function(){return null});used=bank.map(function(){return false});render();\n    },520);\n  }\n}\nfunction next(){\n  qi++;\n  if(qi>=order.length){$('winSub').textContent='You spelled all '+order.length+' words! ⭐ '+stars;$('win').classList.add('show');return}\n  loadWord();\n}\n$('hintBtn').onclick=function(){\n  if(locked)return;\n  var b=placed.indexOf(null);if(b<0)return;\n  // place the correct letter for the first empty box\n  var need=word[b];\n  for(var i=0;i<bank.length;i++){if(!used[i]&&bank[i]===need){placed[b]=i;used[i]=true;break}}\n  haptic('light');render();if(placed.indexOf(null)<0)check();\n};\n$('skipBtn').onclick=function(){if(locked)return;haptic('selection');next()};\n$('winBtn').onclick=function(){$('win').classList.remove('show');start(true)};\n\nfunction save(){if(window.myllmStorage)myllmStorage.setItem('spellpic',JSON.stringify({stars:stars,mode:mode}))}\nfunction setModeUI(){Array.prototype.forEach.call(document.querySelectorAll('#modeseg button'),function(x){x.classList.toggle('on',x.dataset.m===mode)})}\nArray.prototype.forEach.call(document.querySelectorAll('#modeseg button'),function(b){b.onclick=function(){if(mode===b.dataset.m)return;mode=b.dataset.m;setModeUI();haptic('selection');start(false)}});\nfunction start(fresh){\n  order=shuffle(WORDS());qi=0;if(fresh)stars=0;$('stars').textContent='⭐ '+stars;loadWord();save();\n}\nif(window.myllmStorage){myllmStorage.getItem('spellpic').then(function(v){if(v)try{var s=JSON.parse(v);stars=s.stars||0;if(s.mode)mode=s.mode}catch(e){}; $('stars').textContent='⭐ '+stars; setModeUI(); start(false)})}\nelse{setModeUI();start(false)}\nsetInterval(save,4000);\n</script>\n</body>\n</html>\n", "kind": "html", "iconSymbol": "textformat.abc", "iconColor": "orange"}