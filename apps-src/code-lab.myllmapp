{"name": "Code Lab", "html": "<!doctype html>\n<!--\n  Code Lab — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Code Lab</title>\n<style>\n:root{--build-id:\"c71a1a0bef\";\n  color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7);--surface:var(--myllm-surface,#fff);\n  --text:var(--myllm-text,#111);--muted:var(--myllm-muted,#6b6b72);\n  --accent:var(--myllm-accent,#0a84ff);--border:var(--myllm-border,#e3e3e8);\n  --radius:var(--myllm-radius,18px);--font:var(--myllm-font,-apple-system,system-ui,sans-serif);\n  --h:215;                                 /* Code Lab's own hue: the lesson card and the tiles */\n  --code:#1e1e2e;--ok:#1f8c42;--okbg:rgba(52,199,89,.15);--no:#9a6400;--nobg:rgba(255,159,10,.15);\n}\n@media(prefers-color-scheme:dark){:root{--bg:var(--myllm-bg,#000);--surface:var(--myllm-surface,#1c1c1e);--text:var(--myllm-text,#f2f2f7);--muted:var(--myllm-muted,#98989f);--border:var(--myllm-border,#2c2c2e);\n  --ok:#5fdc86;--okbg:rgba(52,199,89,.18);--no:#ffc35c;--nobg:rgba(255,159,10,.16)}}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nbody{margin:0;font-family:var(--font);background:var(--bg);color:var(--text);min-height:100dvh;-webkit-text-size-adjust:100%}\nsvg.i{width:1.25em;height:1.25em;fill:currentColor;flex-shrink:0;display:block}\nbutton{font-family:inherit}\nbutton:active{transform:scale(.96)}\n.wrap{max-width:600px;margin:0 auto;\n  padding:calc(14px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left))}\n\n.head{display:flex;align-items:center;gap:12px;margin:2px 2px 14px}\n.tile{display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0;\n  background:linear-gradient(145deg,hsl(var(--h) 62% 50%),hsl(calc(var(--h) + 40) 58% 28%))}\n.head .tile{width:44px;height:44px;border-radius:13px;font-size:19px}\n.head .ht{flex:1;min-width:0}\n.head h1{font-size:22px;font-weight:800;letter-spacing:-.01em;margin:0}\n.head p{font-size:13px;color:var(--muted);margin:1px 0 0}\n\n/* The lesson you are on, and how far through you are. */\n.hero{position:relative;overflow:hidden;border-radius:20px;padding:16px 16px 14px;margin-bottom:14px;color:#fff;\n  background:linear-gradient(145deg,hsl(var(--h) 62% 46%),hsl(calc(var(--h) + 40) 58% 24%));\n  box-shadow:0 16px 40px -18px hsl(var(--h) 60% 30% / .7)}\n.hero::after{content:\"\";position:absolute;right:-50px;top:-60px;width:180px;height:180px;border-radius:50%;\n  background:radial-gradient(circle,rgba(255,255,255,.22),transparent 70%);pointer-events:none}\n.hero-row{display:flex;align-items:flex-start;gap:12px;position:relative;z-index:1}\n.hero-txt{flex:1;min-width:0}\n.lesson-no{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;opacity:.78}\n.hero h1{font-size:22px;font-weight:800;letter-spacing:-.01em;line-height:1.2;margin:4px 0 0}\n.menuBtn{flex:none;min-height:40px;border-radius:99px;padding:0 14px;font-size:13.5px;font-weight:700;cursor:pointer;color:#fff;\n  display:inline-flex;align-items:center;gap:7px;border:1px solid rgba(255,255,255,.2);background:rgba(255,255,255,.15);\n  -webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px)}\n.prog{height:6px;background:rgba(255,255,255,.2);border-radius:99px;overflow:hidden;margin-top:14px;position:relative;z-index:1}\n.prog i{display:block;height:100%;background:#fff;border-radius:99px;width:0;transition:width .4s cubic-bezier(.2,.8,.2,1)}\n\n.teach{color:var(--muted);font-size:15.5px;line-height:1.5;margin:0 2px 12px}\n.goal{display:flex;gap:11px;align-items:flex-start;background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:12px;font-size:14.5px;line-height:1.45;margin-bottom:14px}\n.goal .gt{width:34px;height:34px;border-radius:10px;flex:none;display:flex;align-items:center;justify-content:center;color:#fff;font-size:15px;\n  background:linear-gradient(145deg,hsl(var(--h) 62% 52%),hsl(calc(var(--h) + 40) 58% 30%))}\n.goal b{color:var(--accent)}\n.goal div{min-width:0;padding-top:1px;overflow-wrap:anywhere}\n\n.lab label{font-size:12px;font-weight:800;color:var(--muted);text-transform:uppercase;letter-spacing:.07em;display:block;margin:0 2px 7px}\n/* 16px: anything smaller and iOS zooms the whole page when the editor takes focus */\ntextarea{display:block;width:100%;min-height:170px;background:var(--code);color:#e6e6f0;caret-color:#5ea0ff;border:1px solid var(--border);border-radius:16px;padding:13px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:16px;line-height:1.5;resize:vertical;tab-size:2;outline:none}\ntextarea:focus{border-color:var(--accent)}\ntextarea::selection{background:rgba(94,160,255,.35)}\n.previewWrap{margin-top:14px}\niframe{display:block;width:100%;height:220px;border:1px solid var(--border);border-radius:16px;background:#fff}\n\n.btns{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}\n.btns button{border:0;border-radius:13px;min-height:46px;padding:0 15px;font-weight:700;font-size:14.5px;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:7px}\n.check{background:var(--accent);color:#fff;flex:1 1 auto}\n.ghost{background:var(--surface);border:1px solid var(--border)!important;color:var(--text)}\n.ai{background:var(--surface);border:1px solid var(--border)!important;color:var(--accent);flex:1 1 auto}\n.btns button:disabled{opacity:.45}\n.nav{display:flex;justify-content:space-between;align-items:center;margin-top:16px}\n.nav button{border:0;background:none;color:var(--accent);font-weight:700;font-size:15.5px;cursor:pointer;min-height:46px;padding:0 10px;display:inline-flex;align-items:center;gap:4px;border-radius:13px}\n.nav button:disabled{opacity:.35}\n.nav button.go{background:var(--accent);color:#fff;padding:0 14px 0 18px;animation:pulse 1.3s ease-in-out 2}\n@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.06)}}\n@media(prefers-reduced-motion:reduce){.nav button.go{animation:none}.prog i{transition:none}}\n#fb{margin-top:12px;padding:12px 14px;border-radius:14px;font-size:14.5px;line-height:1.45;font-weight:550;display:none}\n#fb.ok{display:block;background:var(--okbg);color:var(--ok)}\n#fb.no{display:block;background:var(--nobg);color:var(--no)}\n#aiBox{margin-top:12px;background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:13px 14px;font-size:14.5px;line-height:1.5;display:none;white-space:pre-wrap}\n.dots:after{content:'';animation:d 1.1s steps(4) infinite}@keyframes d{0%{content:''}25%{content:'.'}50%{content:'..'}75%{content:'...'}}\n\n.sheet{position:fixed;inset:0;background:rgba(0,0,0,.5);display:none;align-items:flex-end;justify-content:center;z-index:30}\n.sheet.show{display:flex}\n.sheetBody{background:var(--bg);width:100%;max-width:600px;max-height:80dvh;overflow:auto;-webkit-overflow-scrolling:touch;border-radius:22px 22px 0 0;\n  padding:8px calc(16px + env(safe-area-inset-right)) calc(24px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left))}\n.sheetBody::before{content:\"\";display:block;width:38px;height:5px;border-radius:99px;background:var(--border);margin:0 auto 10px}\n.sheetBody h3{margin:4px 2px 12px;font-size:20px;font-weight:800}\n.lgroup{background:var(--surface);border:1px solid var(--border);border-radius:18px;overflow:hidden}\n.litem{display:flex;align-items:center;gap:12px;min-height:52px;padding:8px 14px;border-bottom:1px solid var(--border);cursor:pointer;font-size:15px;font-weight:600}\n.litem:last-child{border-bottom:none}\n.litem:active{background:var(--bg)}\n.litem .n{width:28px;height:28px;border-radius:50%;background:var(--bg);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:12.5px;font-weight:800;flex:none;color:var(--muted);font-variant-numeric:tabular-nums}\n.litem.done .n{background:var(--accent);color:#fff;border-color:transparent;font-size:12px}\n.litem.cur{color:var(--accent)}\n.litem.cur .n{border-color:var(--accent);color:var(--accent)}\n.litem.cur.done .n{color:#fff}\n.done-screen{text-align:center;padding:34px 10px}\n.done-screen .big{width:76px;height:76px;border-radius:24px;margin:0 auto 16px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:32px;\n  background:linear-gradient(145deg,hsl(var(--h) 62% 52%),hsl(calc(var(--h) + 40) 58% 30%))}\nh2.title{font-size:22px;font-weight:800;margin:2px 0 8px}\n\n/* A tablet, or a phone on its side: code on the left, the page it makes on the right. */\n@media(min-width:700px){\n  .wrap{max-width:1100px}\n  .lab{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px;align-items:stretch}\n  .lab>div{display:flex;flex-direction:column;min-width:0}\n  .previewWrap{margin-top:0}\n  textarea{flex:1;min-height:300px;resize:none}\n  iframe{flex:1;height:auto;min-height:300px}\n  .check,.ai{flex:0 0 auto}\n}\n@media(min-width:700px) and (max-height:520px){\n  .hero{padding:12px 16px}.hero h1{font-size:19px}.prog{margin-top:10px}\n  .head{margin-bottom:8px}.head p{display:none}.head .tile{width:34px;height:34px;border-radius:10px;font-size:15px}\n  textarea,iframe{min-height:210px}\n}\n</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-code\" viewBox=\"0 0 24 24\"><path d=\"M8.300 6.300a1.100 1.100 0 0 1 0 1.560L4.160 12l4.140 4.140a1.100 1.100 0 0 1-1.560 1.560l-4.920-4.920a1.100 1.100 0 0 1 0-1.560l4.920-4.920a1.100 1.100 0 0 1 1.560 0zm7.400 0a1.100 1.100 0 0 1 1.560 0l4.920 4.920a1.100 1.100 0 0 1 0 1.560l-4.920 4.920a1.100 1.100 0 0 1-1.560-1.560L19.840 12 15.700 7.860a1.100 1.100 0 0 1 0-1.560zm-1.400-3.200a1 1 0 0 1 .700 1.230l-4 15a1 1 0 0 1-1.930-.520l4-15a1 1 0 0 1 1.230-.700z\"/></symbol>\n  <symbol id=\"i-list\" viewBox=\"0 0 24 24\"><path d=\"M4.500 5a1.500 1.500 0 1 0 0 3 1.500 1.500 0 0 0 0-3zM9 5.500a1 1 0 0 0 0 2h11a1 1 0 0 0 0-2zm-4.500 5a1.500 1.500 0 1 0 0 3 1.500 1.500 0 0 0 0-3zM9 11a1 1 0 0 0 0 2h11a1 1 0 0 0 0-2zm-4.500 5a1.500 1.500 0 1 0 0 3 1.500 1.500 0 0 0 0-3zm4.500.5a1 1 0 0 0 0 2h11a1 1 0 0 0 0-2z\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M20.300 5.700a1.200 1.200 0 0 0-1.700 0L9.500 14.800l-4.100-4.100a1.200 1.200 0 0 0-1.700 1.700l5 5a1.200 1.200 0 0 0 1.700 0l9.900-10a1.200 1.200 0 0 0 0-1.700z\"/></symbol>\n  <symbol id=\"i-reset\" viewBox=\"0 0 24 24\"><path d=\"M12 5V2.600a.6.6 0 0 0-1-.450L7.200 5.550a.6.6 0 0 0 0 .9L11 9.850a.6.6 0 0 0 1-.450V7a5.500 5.500 0 1 1-5.500 5.500 1 1 0 0 0-2 0A7.500 7.500 0 1 0 12 5z\"/></symbol>\n  <symbol id=\"i-bulb\" viewBox=\"0 0 24 24\"><path d=\"M12 2a7 7 0 0 0-4 12.740V16.500A1.500 1.500 0 0 0 9.500 18h5a1.500 1.500 0 0 0 1.500-1.500v-1.760A7 7 0 0 0 12 2zM9.500 19.500a1 1 0 0 0 0 2h5a1 1 0 0 0 0-2z\"/></symbol>\n  <symbol id=\"i-help\" viewBox=\"0 0 24 24\"><path d=\"M21.300 6.100a.7.7 0 0 0-1.160-.27l-2.700 2.700-2-.500-.5-2 2.700-2.700a.7.7 0 0 0-.27-1.160 5.500 5.500 0 0 0-6.900 6.940l-7.300 7.300a2.120 2.120 0 0 0 3 3l7.300-7.300a5.500 5.500 0 0 0 6.830-7.010z\"/></symbol>\n  <symbol id=\"i-target\" viewBox=\"0 0 24 24\"><path d=\"M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 2.200a7.800 7.800 0 1 1 0 15.600 7.800 7.800 0 0 1 0-15.600zm0 2.800a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 2.200a2.800 2.800 0 1 1 0 5.600 2.800 2.800 0 0 1 0-5.600z\"/></symbol>\n  <symbol id=\"i-left\" viewBox=\"0 0 24 24\"><path d=\"M14.700 5.300a1.100 1.100 0 0 1 0 1.560L9.560 12l5.140 5.140a1.100 1.100 0 0 1-1.560 1.560l-5.920-5.920a1.100 1.100 0 0 1 0-1.560l5.920-5.920a1.100 1.100 0 0 1 1.560 0z\"/></symbol>\n  <symbol id=\"i-right\" viewBox=\"0 0 24 24\"><path d=\"M9.300 5.300a1.100 1.100 0 0 0 0 1.560L14.440 12 9.300 17.140a1.100 1.100 0 0 0 1.560 1.560l5.920-5.920a1.100 1.100 0 0 0 0-1.560L10.860 5.300a1.100 1.100 0 0 0-1.560 0z\"/></symbol>\n  <symbol id=\"i-flag\" viewBox=\"0 0 24 24\"><path d=\"M5 2.500a1 1 0 0 0-1 1v17a1 1 0 0 0 2 0V15h5.600l.6 1.500c.15.300.45.500.8.500H19a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1h-5.400L13 3.500a.9.9 0 0 0-.8-.5H6a1 1 0 0 0-1-.5z\"/></symbol>\n</defs></svg>\n<div class=\"wrap\">\n  <div class=\"head\">\n    <div class=\"tile\"><svg class=\"i\"><use href=\"#i-code\"/></svg></div>\n    <div class=\"ht\"><h1>Code Lab</h1><p>Learn to code, live</p></div>\n  </div>\n  <div class=\"hero\">\n    <div class=\"hero-row\">\n      <div class=\"hero-txt\"><div class=\"lesson-no\" id=\"hNo\">Code Lab</div><h1 id=\"hTitle\">Code Lab</h1></div>\n      <button class=\"menuBtn\" id=\"menuBtn\"><svg class=\"i\"><use href=\"#i-list\"/></svg>Lessons</button>\n    </div>\n    <div class=\"prog\"><i id=\"bar\"></i></div>\n  </div>\n  <div id=\"view\"></div>\n</div>\n\n<div class=\"sheet\" id=\"sheet\"><div class=\"sheetBody\"><h3>Lessons</h3><div class=\"lgroup\" id=\"list\"></div></div></div>\n\n<script>\nvar LESSONS=[\n {t:\"Headings\",teach:\"Web pages are built from tags. A heading uses <h1>…</h1> — h1 is biggest, down to h6.\",\n  goal:\"Make an <h1> heading with your name.\",\n  starter:\"<h1>Hello!</h1>\",\n  hint:\"Put your text between <h1> and </h1>.\",\n  check:function(c,d){var h=d.querySelector(\"h1\");return h&&h.textContent.trim().length>0}},\n {t:\"Paragraphs\",teach:\"Normal text goes in a paragraph: <p>…</p>. You can have many.\",\n  goal:\"Add a <p> with a sentence about yourself.\",\n  starter:\"<h1>About me</h1>\\n<p>I am learning to code.</p>\",\n  hint:\"Add <p>your sentence</p> under the heading.\",\n  check:function(c,d){var p=d.querySelector(\"p\");return p&&p.textContent.trim().length>3}},\n {t:\"Links\",teach:\"A link uses an anchor tag: <a href=\\\"https://…\\\">text</a>. href is where it goes.\",\n  goal:\"Add a link to any website.\",\n  starter:'<a href=\"https://example.com\">Visit a site</a>',\n  hint:'Use <a href=\"https://…\">text</a>.',\n  check:function(c,d){return !!d.querySelector(\"a[href]\")}},\n {t:\"Images\",teach:\"Show a picture with <img src=\\\"URL\\\">. It has no closing tag; alt describes it.\",\n  goal:\"Add an <img> with a src.\",\n  starter:'<img src=\"https://picsum.photos/240\" alt=\"a random photo\">',\n  hint:'Add <img src=\"https://…\" alt=\"...\">.',\n  check:function(c,d){return !!d.querySelector(\"img[src]\")}},\n {t:\"Lists\",teach:\"A bulleted list is a <ul> with <li> items inside. (Use <ol> for numbers.)\",\n  goal:\"Make a list with at least 2 items.\",\n  starter:\"<ul>\\n  <li>Tea</li>\\n  <li>Coffee</li>\\n</ul>\",\n  hint:\"Put two <li>…</li> inside <ul>…</ul>.\",\n  check:function(c,d){return d.querySelectorAll(\"ul li, ol li\").length>=2}},\n {t:\"Bold & italic\",teach:\"Emphasise text with <strong>bold</strong> and <em>italic</em>.\",\n  goal:\"Use both <strong> and <em>.\",\n  starter:\"<p>This is <strong>important</strong> and <em>lovely</em>.</p>\",\n  hint:\"Wrap words in <strong>…</strong> and <em>…</em>.\",\n  check:function(c,d){return d.querySelector(\"strong\")&&d.querySelector(\"em\")}},\n {t:\"Colour with CSS\",teach:\"Style a tag with the style attribute. Colours can be names (tomato, royalblue) or hex (#0a84ff).\",\n  goal:\"Give an element a colour.\",\n  starter:'<h1 style=\"color: tomato\">Colourful heading</h1>',\n  hint:'Add style=\"color: red\" to a tag.',\n  check:function(c,d){return /style\\s*=\\s*[\"'][^\"']*color\\s*:/i.test(c)||/<style[\\s\\S]*color\\s*:/i.test(c)}},\n {t:\"Size & alignment\",teach:\"font-size sets text size (e.g. 24px); text-align: center centres it.\",\n  goal:\"Make text bigger AND centred.\",\n  starter:'<p style=\"font-size: 24px; text-align: center\">Big and centred</p>',\n  hint:\"Use font-size: 24px and text-align: center together in a style.\",\n  check:function(c){return /font-size\\s*:/i.test(c)&&/text-align\\s*:/i.test(c)}},\n {t:\"Boxes\",teach:\"padding adds space inside; background colours it; border-radius rounds the corners. Great for cards.\",\n  goal:\"Make a rounded, coloured box with padding.\",\n  starter:'<div style=\"background:#0a84ff; color:#fff; padding:16px; border-radius:12px\">A tidy card</div>',\n  hint:\"Add background, padding and border-radius to a <div>.\",\n  check:function(c){return /background\\s*:/i.test(c)&&/padding\\s*:/i.test(c)}},\n {t:\"Classes & <style>\",teach:\"Rather than repeat styles, define a class once in a <style> block and reuse it with class=\\\"…\\\".\",\n  goal:\"Define a .box class in <style> and use it.\",\n  starter:'<style>\\n  .box { background:#34c759; color:#fff; padding:12px; border-radius:10px }\\n</style>\\n<div class=\"box\">Reusable box</div>',\n  hint:'Write .box { … } inside <style>, then add class=\"box\" to an element.',\n  check:function(c,d){return /<style[\\s\\S]*\\.[\\w-]+\\s*\\{/i.test(c)&&!!d.querySelector(\"[class]\")}},\n {t:\"A button + JavaScript\",teach:\"JavaScript makes pages interactive. onclick runs code when a button is tapped.\",\n  goal:\"Make a button that changes the text when clicked.\",\n  starter:'<p id=\"out\">Tap the button</p>\\n<button onclick=\"document.getElementById(\\'out\\').textContent=\\'Clicked!\\'\">Click me</button>',\n  hint:'Add a <button onclick=\"...\">. Try it in the preview!',\n  check:function(c,d){return !!d.querySelector(\"button\")&&/onclick|addeventlistener/i.test(c)}},\n {t:\"Variables & the page\",teach:\"In a <script>, store data in a variable, then change the page with document.querySelector(...).textContent.\",\n  goal:\"Use a <script> with a variable that sets some text.\",\n  starter:'<h2 id=\"t\"></h2>\\n<script>\\n  var name = \"Coder\";\\n  document.querySelector(\"#t\").textContent = \"Hi, \" + name;\\n<\\/script>',\n  hint:\"Inside <script>, make a variable and use document.querySelector(...).textContent = ...\",\n  check:function(c,d){return /<script[\\s\\S]*(var|let|const)\\s/i.test(c)&&!!d.querySelector(\"#t\")}},\n {t:\"Flexbox layout\",teach:\"display: flex lays a box's children in a row. gap spaces them; justify-content positions them along the row; align-items across it.\",\n  goal:\"Make a flex row with at least 2 boxes inside.\",\n  starter:'<div style=\"display:flex; gap:10px; justify-content:center\">\\n  <div style=\"background:#0a84ff;color:#fff;padding:16px;border-radius:10px\">A</div>\\n  <div style=\"background:#34c759;color:#fff;padding:16px;border-radius:10px\">B</div>\\n  <div style=\"background:#ff9500;color:#fff;padding:16px;border-radius:10px\">C</div>\\n</div>',\n  hint:\"Put display:flex on a container, then give it 2+ child <div>s. gap adds space between them.\",\n  check:function(c,d){var w=frame.contentWindow,els=d.body.querySelectorAll(\"*\");for(var i=0;i<els.length;i++){try{if(w.getComputedStyle(els[i]).display===\"flex\"&&els[i].children.length>=2)return true}catch(e){}}return false}},\n {t:\"Forms & inputs\",teach:\"Forms collect what people type. <input> is a single line — set its type and a placeholder. Add a <button> to submit.\",\n  goal:\"Make a text input and a button.\",\n  starter:'<input type=\"text\" placeholder=\"Your name\">\\n<button>Submit</button>',\n  hint:\"Add an <input ...> and a <button>…</button>.\",\n  check:function(c,d){return !!d.querySelector(\"input,textarea,select\")&&!!d.querySelector(\"button,input[type=submit]\")}},\n {t:\"Capstone: profile card\",teach:\"Time to combine everything — a <style> block with classes, an image, a heading, text, and a button with JavaScript. Make it your own!\",\n  goal:\"Build a profile card: a styled box with a heading, an image, a short bio, and a button that does something when tapped.\",\n  starter:'<style>\\n  .card{max-width:280px;margin:auto;background:#fff;border:1px solid #eee;border-radius:16px;padding:20px;text-align:center;font-family:-apple-system,system-ui,sans-serif;box-shadow:0 6px 20px rgba(0,0,0,.08)}\\n  .card img{width:84px;height:84px;border-radius:50%;object-fit:cover}\\n  .card h2{margin:12px 0 2px}\\n  .card p{color:#666;font-size:14px;margin:0 0 14px}\\n  .card button{background:#0a84ff;color:#fff;border:0;padding:10px 18px;border-radius:10px;font-size:15px}\\n</style>\\n<div class=\"card\">\\n  <img src=\"https://picsum.photos/170\" alt=\"avatar\">\\n  <h2>Alex</h2>\\n  <p id=\"bio\">Learning to build for the web.</p>\\n  <button onclick=\"document.getElementById(\\'bio\\').textContent=\\'👋 Thanks for visiting!\\'\">Say hi</button>\\n</div>',\n  hint:\"Aim for at least four of: a heading, an image, a paragraph, a button, and box styling (padding / border-radius).\",\n  check:function(c,d){var n=0;if(d.querySelector(\"h1,h2,h3\"))n++;if(d.querySelector(\"img[src]\"))n++;if(d.querySelector(\"p\"))n++;if(d.querySelector(\"button\"))n++;if(/border-radius\\s*:/i.test(c)||/padding\\s*:/i.test(c))n++;return n>=4}},\n {t:\"Grid layout\",teach:\"display: grid arranges items into rows AND columns. grid-template-columns sets the columns — try repeat(3, 1fr) for three equal ones — and gap spaces them out.\",\n  goal:\"Make a grid with 3 columns and several boxes.\",\n  starter:'<style>\\n  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}\\n  .grid div{background:#5e5ce6;color:#fff;padding:18px;border-radius:10px;text-align:center}\\n</style>\\n<div class=\"grid\">\\n  <div>1</div><div>2</div><div>3</div>\\n  <div>4</div><div>5</div><div>6</div>\\n</div>',\n  hint:\"Put display:grid and grid-template-columns:repeat(3,1fr) on a container with several children.\",\n  check:function(c,d){var w=frame.contentWindow,els=d.body.querySelectorAll(\"*\");for(var i=0;i<els.length;i++){try{if(w.getComputedStyle(els[i]).display===\"grid\"&&els[i].children.length>=2)return true}catch(e){}}return false}},\n {t:\"Transitions & hover\",teach:\"transition makes a style change animate smoothly instead of snapping. Pair it with :hover (in a <style> block) so an element reacts when pointed at or tapped.\",\n  goal:\"Make an element that smoothly changes on hover, using transition.\",\n  starter:'<style>\\n  .btn{display:inline-block;background:#0a84ff;color:#fff;padding:12px 20px;border-radius:10px;\\n       transition:transform .25s ease, background .25s}\\n  .btn:hover{transform:scale(1.08);background:#5e5ce6}\\n</style>\\n<div class=\"btn\">Hover or tap me</div>',\n  hint:\"Add transition: transform .25s to an element, then a .name:hover { transform: scale(1.1) } rule.\",\n  check:function(c){return /transition\\s*:/i.test(c)&&/:hover/i.test(c)}},\n {t:\"Capstone: photo gallery\",teach:\"A second project! Combine grid for the layout with transition + :hover so the pictures zoom smoothly. Swap in your own image URLs and sizes.\",\n  goal:\"Build a photo gallery: a grid of at least 3 images that zoom smoothly on hover.\",\n  starter:'<style>\\n  .gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;max-width:360px;margin:auto}\\n  .gallery img{width:100%;height:120px;object-fit:cover;border-radius:12px;\\n               transition:transform .25s ease, box-shadow .25s}\\n  .gallery img:hover{transform:scale(1.06);box-shadow:0 8px 20px rgba(0,0,0,.2)}\\n</style>\\n<div class=\"gallery\">\\n  <img src=\"https://picsum.photos/seed/a/300/200\" alt=\"\">\\n  <img src=\"https://picsum.photos/seed/b/300/200\" alt=\"\">\\n  <img src=\"https://picsum.photos/seed/c/300/200\" alt=\"\">\\n  <img src=\"https://picsum.photos/seed/d/300/200\" alt=\"\">\\n</div>',\n  hint:\"Aim for a grid container, 3+ images, and a transition (plus a :hover for the zoom).\",\n  check:function(c,d){var n=0;if(/grid-template|display\\s*:\\s*grid/i.test(c))n++;if(d.querySelectorAll(\"img[src]\").length>=3)n++;if(/transition\\s*:/i.test(c))n++;if(/:hover/i.test(c))n++;return n>=3}}\n];\n\nvar state={idx:0,done:{},code:{}},frame,editor,renderT,saveT,busy=false;\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nfunction $(i){return document.getElementById(i)}\nfunction wrap(code){return '<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>body{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:14px;color:#111;background:#fff;line-height:1.5}</style></head><body>'+code+'</body></html>'}\n// Render the current code into the preview iframe and return the exact\n// document we wrote to — check() reads THIS so validation can never race a\n// stale document reference.\nfunction renderTo(){\n  if(!frame)return null;\n  try{var d=frame.contentDocument||frame.contentWindow.document;d.open();d.write(wrap(editor.value));d.close();return d}catch(e){return null}\n}\nfunction render(){renderTo();}\n\nfunction bar(){var n=Object.keys(state.done).length;$('bar').style.width=(n/LESSONS.length*100)+'%'}\n\nfunction lessonView(i){\n  var L=LESSONS[i],aiOn=!!window.myllmAsk;\n  return '<p class=\"teach\">'+L.teach.replace(/</g,'&lt;')+'</p>'+\n    '<div class=\"goal\"><span class=\"gt\"><svg class=\"i\"><use href=\"#i-target\"/></svg></span><div><b>Goal:</b> '+L.goal.replace(/</g,'&lt;')+'</div></div>'+\n    '<div class=\"lab\"><div><label for=\"editor\">Your code — edit it</label>'+\n    '<textarea id=\"editor\" spellcheck=\"false\" autocapitalize=\"off\" autocorrect=\"off\" autocomplete=\"off\"></textarea></div>'+\n    '<div class=\"previewWrap\"><label>Live preview</label><iframe id=\"frame\" title=\"preview\"></iframe></div></div>'+\n    '<div id=\"fb\"></div><div id=\"aiBox\"></div>'+\n    '<div class=\"btns\">'+\n      '<button class=\"check\" id=\"checkBtn\"><svg class=\"i\"><use href=\"#i-check\"/></svg>Check</button>'+\n      '<button class=\"ghost\" id=\"resetBtn\"><svg class=\"i\"><use href=\"#i-reset\"/></svg>Reset</button>'+\n      (aiOn?'<button class=\"ai\" id=\"explainBtn\"><svg class=\"i\"><use href=\"#i-bulb\"/></svg>Explain</button><button class=\"ai\" id=\"helpBtn\"><svg class=\"i\"><use href=\"#i-help\"/></svg>Help me fix it</button>':'')+\n    '</div>'+\n    '<div class=\"nav\"><button id=\"prevBtn\"><svg class=\"i\"><use href=\"#i-left\"/></svg>Back</button><button id=\"nextBtn\"></button></div>';\n}\n\nfunction nextLabel(last){return last?'Finish<svg class=\"i\"><use href=\"#i-flag\"/></svg>':'Next<svg class=\"i\"><use href=\"#i-right\"/></svg>'}\nfunction load(i){\n  state.idx=i;$('view').innerHTML=lessonView(i);\n  $('hNo').textContent='Lesson '+(i+1)+' / '+LESSONS.length;$('hTitle').textContent=LESSONS[i].t;\n  editor=$('editor');frame=$('frame');\n  editor.value=(i in state.code)?state.code[i]:LESSONS[i].starter;\n  render();bar();save();\n  editor.addEventListener('input',function(){state.code[state.idx]=editor.value;clearTimeout(renderT);renderT=setTimeout(render,180);clearTimeout(saveT);saveT=setTimeout(save,500)});\n  $('checkBtn').onclick=check;\n  $('resetBtn').onclick=function(){editor.value=LESSONS[state.idx].starter;state.code[state.idx]=editor.value;render();fb('','');$('nextBtn').classList.remove('go');haptic('light')};\n  $('prevBtn').onclick=function(){if(state.idx>0){haptic('selection');load(state.idx-1)}};\n  $('prevBtn').disabled=(i===0);\n  var last=(i>=LESSONS.length-1);\n  $('nextBtn').innerHTML=nextLabel(last);\n  $('nextBtn').onclick=function(){haptic('selection');if(state.idx<LESSONS.length-1)load(state.idx+1);else finish()};\n  if(state.done[i])$('nextBtn').classList.add('go');\n  if(window.myllmAsk){$('explainBtn').onclick=explain;$('helpBtn').onclick=help}\n  fb(state.done[i]?'ok':'', state.done[i]?('Completed — tap '+(last?'Finish':'Next')+' to carry on.'):'');\n}\nfunction fb(kind,msg){var e=$('fb');if(!e)return;e.className=kind||'';e.textContent=msg||'';if(!kind)e.style.display='none'}\nfunction check(){\n  var d=renderTo();var ok=false;try{ok=!!(d&&LESSONS[state.idx].check(editor.value,d))}catch(e){ok=false}\n  var last=state.idx>=LESSONS.length-1;\n  if(ok){\n    state.done[state.idx]=true;bar();save();haptic('success');\n    fb('ok','Great — that works! Edit it to experiment, or tap '+(last?'Finish':'Next')+' to continue.');\n    $('nextBtn').classList.add('go');\n  } else {\n    $('nextBtn').classList.remove('go');\n    fb('no','Not quite yet — '+LESSONS[state.idx].hint);haptic('warning');\n  }\n}\n\nvar SYS=\"You are a friendly, encouraging coding tutor for absolute beginners learning HTML, CSS and JavaScript. Keep every answer to 2-3 short, plain sentences. Be concrete and kind. Never lecture.\";\nfunction aiBusy(b){busy=b;var ex=$('explainBtn'),h=$('helpBtn');if(ex)ex.disabled=b;if(h)h.disabled=b}\nfunction showAI(t){var b=$('aiBox');b.style.display='block';b.textContent=t}\nfunction explain(){\n  if(busy)return;var L=LESSONS[state.idx];aiBusy(true);showAI('Thinking');$('aiBox').innerHTML='<span class=\"dots\">Thinking</span>';haptic('light');\n  myllmAsk('Explain this beginner web-coding topic in 2-3 simple sentences: \"'+L.t+'\". Context: '+L.teach,{system:SYS})\n   .then(function(r){showAI((r||'').trim()||'Try again.')}).catch(function(){showAI('The AI is unavailable right now.')}).then(function(){aiBusy(false)});\n}\nfunction help(){\n  if(busy)return;var L=LESSONS[state.idx];aiBusy(true);$('aiBox').style.display='block';$('aiBox').innerHTML='<span class=\"dots\">Looking at your code</span>';haptic('light');\n  myllmAsk('A beginner is on the lesson \"'+L.t+'\". Goal: '+L.goal+'\\nTheir code:\\n'+editor.value+'\\n\\nIn 2-3 sentences, gently nudge them toward what to change. Give a hint, not the full solution.',{system:SYS})\n   .then(function(r){showAI((r||'').trim()||'Try again.')}).catch(function(){showAI('The AI is unavailable right now.')}).then(function(){aiBusy(false)});\n}\n\nfunction finish(){\n  var n=Object.keys(state.done).length;\n  $('hNo').textContent='Code Lab';$('hTitle').textContent='Course complete';\n  $('view').innerHTML='<div class=\"done-screen\"><div class=\"big\"><svg class=\"i\"><use href=\"#i-flag\"/></svg></div><h2 class=\"title\">You reached the end!</h2>'+\n    '<p class=\"teach\">You completed '+n+' of '+LESSONS.length+' challenges. You can now write real HTML, style it with CSS, and add JavaScript.</p>'+\n    '<div class=\"btns\" style=\"justify-content:center\"><button class=\"check\" id=\"again\">Review lessons</button></div></div>';\n  $('again').onclick=function(){load(0)};haptic('success');bar();\n}\n\nfunction buildList(){\n  var l=$('list');l.innerHTML='';\n  LESSONS.forEach(function(L,i){\n    var d=document.createElement('div');d.className='litem'+(state.done[i]?' done':'')+(i===state.idx?' cur':'');\n    d.innerHTML='<span class=\"n\">'+(state.done[i]?'<svg class=\"i\"><use href=\"#i-check\"/></svg>':(i+1))+'</span><span>'+L.t+'</span>';\n    d.onclick=function(){$('sheet').classList.remove('show');haptic('selection');load(i)};l.appendChild(d);\n  });\n}\n$('menuBtn').onclick=function(){buildList();$('sheet').classList.add('show');haptic('selection')};\n$('sheet').onclick=function(e){if(e.target===$('sheet'))$('sheet').classList.remove('show')};\n\nfunction save(){if(window.myllmStorage)myllmStorage.setItem('codelab',JSON.stringify({idx:state.idx,done:state.done,code:state.code}))}\nfunction start(){\n  if(!window.myllmStorage){load(0);return}\n  myllmStorage.getItem('codelab').then(function(v){\n    if(v)try{var s=JSON.parse(v);state.done=s.done||{};state.code=s.code||{};state.idx=s.idx||0}catch(e){}\n    load(state.idx<LESSONS.length?state.idx:0);\n  });\n}\nstart();\n</script>\n</body>\n</html>\n", "kind": "html", "iconSymbol": "chevron.left.forwardslash.chevron.right", "iconColor": "blue"}