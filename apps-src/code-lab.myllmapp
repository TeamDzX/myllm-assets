{"name": "Code Lab", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Code Lab</title>\n<style>\n:root{\n  color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7);--surface:var(--myllm-surface,#fff);\n  --text:var(--myllm-text,#111);--muted:var(--myllm-muted,#6b6b72);\n  --accent:var(--myllm-accent,#0b5ed7);--border:var(--myllm-border,rgba(120,120,128,.25));\n  --radius:var(--myllm-radius,14px);--font:var(--myllm-font,-apple-system,system-ui,sans-serif);\n  --code:#1e1e2e;\n}\n@media(prefers-color-scheme:dark){:root{--bg:var(--myllm-bg,#000);--surface:var(--myllm-surface,#1c1c1e);--text:var(--myllm-text,#eee);--muted:var(--myllm-muted,#98989f)}}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nbody{margin:0;font-family:var(--font);background:var(--bg);color:var(--text)}\n.wrap{max-width:560px;margin:0 auto;padding:12px 14px 30px}\n.top{display:flex;align-items:center;gap:10px;margin-bottom:6px}\n.top h1{font-size:19px;font-weight:700;margin:0;flex:1}\n.menuBtn{border:0;background:var(--surface);border:1px solid var(--border);color:var(--text);border-radius:9px;padding:7px 10px;font:inherit;font-size:13px;font-weight:600;cursor:pointer}\n.prog{height:6px;background:var(--surface);border:1px solid var(--border);border-radius:99px;overflow:hidden;margin:6px 0 12px}\n.prog i{display:block;height:100%;background:var(--accent);width:0;transition:width .3s}\n.lesson-no{font-size:12px;font-weight:700;color:var(--accent);text-transform:uppercase;letter-spacing:.04em}\nh2.title{font-size:21px;margin:2px 0 8px}\n.teach{color:var(--muted);font-size:15px;line-height:1.5;margin:0 0 10px}\n.goal{background:var(--surface);border:1px solid var(--border);border-left:3px solid var(--accent);border-radius:10px;padding:10px 13px;font-size:14px;margin-bottom:12px}\n.goal b{color:var(--accent)}\n.lab label{font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.03em;display:block;margin:0 0 5px}\ntextarea{width:100%;min-height:140px;background:var(--code);color:#e6e6f0;border:1px solid var(--border);border-radius:11px;padding:12px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:14px;line-height:1.5;resize:vertical;tab-size:2}\n.previewWrap{margin-top:12px}\niframe{width:100%;height:200px;border:1px solid var(--border);border-radius:11px;background:#fff}\n.btns{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}\n.btns button{border:0;border-radius:10px;padding:11px 14px;font:inherit;font-weight:600;font-size:14px;cursor:pointer}\n.check{background:var(--accent);color:#fff}\n.ghost{background:var(--surface);border:1px solid var(--border);color:var(--text)}\n.ai{background:var(--surface);border:1px solid var(--border);color:var(--accent)}\n.btns button:disabled{opacity:.45}\n.nav{display:flex;justify-content:space-between;margin-top:14px}\n.nav button{border:0;background:none;color:var(--accent);font:inherit;font-weight:600;font-size:15px;cursor:pointer;padding:8px}\n.nav button:disabled{opacity:.35}\n#fb{margin-top:10px;padding:11px 13px;border-radius:10px;font-size:14px;display:none}\n#fb.ok{display:block;background:rgba(52,199,89,.15);color:#1f8c42}\n#fb.no{display:block;background:rgba(255,159,10,.15);color:#9a6400}\n#aiBox{margin-top:10px;background:var(--surface);border:1px solid var(--border);border-radius:11px;padding:12px;font-size:14px;line-height:1.5;display:none;white-space:pre-wrap}\n.dots:after{content:'';animation:d 1.1s steps(4) infinite}@keyframes d{0%{content:''}25%{content:'.'}50%{content:'..'}75%{content:'...'}}\n.sheet{position:fixed;inset:0;background:rgba(0,0,0,.5);display:none;align-items:flex-end;z-index:30}\n.sheet.show{display:flex}\n.sheetBody{background:var(--bg);width:100%;max-height:75%;overflow:auto;border-radius:18px 18px 0 0;padding:14px 16px 28px}\n.sheetBody h3{margin:4px 0 12px}\n.litem{display:flex;align-items:center;gap:10px;padding:12px;border:1px solid var(--border);border-radius:11px;margin-bottom:8px;background:var(--surface);cursor:pointer}\n.litem .n{width:24px;height:24px;border-radius:50%;background:var(--bg);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;flex:none}\n.litem.done .n{background:var(--accent);color:#fff;border-color:transparent}\n.litem.cur{border-color:var(--accent)}\n.done-screen{text-align:center;padding:30px 10px}\n.done-screen .big{font-size:54px}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <div class=\"top\">\n    <h1>👩‍💻 Code Lab</h1>\n    <button class=\"menuBtn\" id=\"menuBtn\">☰ Lessons</button>\n  </div>\n  <div class=\"prog\"><i id=\"bar\"></i></div>\n  <div id=\"view\"></div>\n</div>\n\n<div class=\"sheet\" id=\"sheet\"><div class=\"sheetBody\"><h3>Lessons</h3><div id=\"list\"></div></div></div>\n\n<script>\nvar LESSONS=[\n {t:\"Headings\",teach:\"Web pages are built from tags. A heading uses <h1>…</h1> — h1 is biggest, down to h6.\",\n  goal:\"Make an <h1> heading with your name.\",\n  starter:\"<h1>Hello!</h1>\",\n  hint:\"Put your text between <h1> and </h1>.\",\n  check:function(c,d){var h=d.querySelector(\"h1\");return h&&h.textContent.trim().length>0}},\n {t:\"Paragraphs\",teach:\"Normal text goes in a paragraph: <p>…</p>. You can have many.\",\n  goal:\"Add a <p> with a sentence about yourself.\",\n  starter:\"<h1>About me</h1>\\n<p>I am learning to code.</p>\",\n  hint:\"Add <p>your sentence</p> under the heading.\",\n  check:function(c,d){var p=d.querySelector(\"p\");return p&&p.textContent.trim().length>3}},\n {t:\"Links\",teach:\"A link uses an anchor tag: <a href=\\\"https://…\\\">text</a>. href is where it goes.\",\n  goal:\"Add a link to any website.\",\n  starter:'<a href=\"https://example.com\">Visit a site</a>',\n  hint:'Use <a href=\"https://…\">text</a>.',\n  check:function(c,d){return !!d.querySelector(\"a[href]\")}},\n {t:\"Images\",teach:\"Show a picture with <img src=\\\"URL\\\">. It has no closing tag; alt describes it.\",\n  goal:\"Add an <img> with a src.\",\n  starter:'<img src=\"https://picsum.photos/240\" alt=\"a random photo\">',\n  hint:'Add <img src=\"https://…\" alt=\"...\">.',\n  check:function(c,d){return !!d.querySelector(\"img[src]\")}},\n {t:\"Lists\",teach:\"A bulleted list is a <ul> with <li> items inside. (Use <ol> for numbers.)\",\n  goal:\"Make a list with at least 2 items.\",\n  starter:\"<ul>\\n  <li>Tea</li>\\n  <li>Coffee</li>\\n</ul>\",\n  hint:\"Put two <li>…</li> inside <ul>…</ul>.\",\n  check:function(c,d){return d.querySelectorAll(\"ul li, ol li\").length>=2}},\n {t:\"Bold & italic\",teach:\"Emphasise text with <strong>bold</strong> and <em>italic</em>.\",\n  goal:\"Use both <strong> and <em>.\",\n  starter:\"<p>This is <strong>important</strong> and <em>lovely</em>.</p>\",\n  hint:\"Wrap words in <strong>…</strong> and <em>…</em>.\",\n  check:function(c,d){return d.querySelector(\"strong\")&&d.querySelector(\"em\")}},\n {t:\"Colour with CSS\",teach:\"Style a tag with the style attribute. Colours can be names (tomato, royalblue) or hex (#0a84ff).\",\n  goal:\"Give an element a colour.\",\n  starter:'<h1 style=\"color: tomato\">Colourful heading</h1>',\n  hint:'Add style=\"color: red\" to a tag.',\n  check:function(c,d){return /style\\s*=\\s*[\"'][^\"']*color\\s*:/i.test(c)||/<style[\\s\\S]*color\\s*:/i.test(c)}},\n {t:\"Size & alignment\",teach:\"font-size sets text size (e.g. 24px); text-align: center centres it.\",\n  goal:\"Make text bigger AND centred.\",\n  starter:'<p style=\"font-size: 24px; text-align: center\">Big and centred</p>',\n  hint:\"Use font-size: 24px and text-align: center together in a style.\",\n  check:function(c){return /font-size\\s*:/i.test(c)&&/text-align\\s*:/i.test(c)}},\n {t:\"Boxes\",teach:\"padding adds space inside; background colours it; border-radius rounds the corners. Great for cards.\",\n  goal:\"Make a rounded, coloured box with padding.\",\n  starter:'<div style=\"background:#0a84ff; color:#fff; padding:16px; border-radius:12px\">A tidy card</div>',\n  hint:\"Add background, padding and border-radius to a <div>.\",\n  check:function(c){return /background\\s*:/i.test(c)&&/padding\\s*:/i.test(c)}},\n {t:\"Classes & <style>\",teach:\"Rather than repeat styles, define a class once in a <style> block and reuse it with class=\\\"…\\\".\",\n  goal:\"Define a .box class in <style> and use it.\",\n  starter:'<style>\\n  .box { background:#34c759; color:#fff; padding:12px; border-radius:10px }\\n</style>\\n<div class=\"box\">Reusable box</div>',\n  hint:'Write .box { … } inside <style>, then add class=\"box\" to an element.',\n  check:function(c,d){return /<style[\\s\\S]*\\.[\\w-]+\\s*\\{/i.test(c)&&!!d.querySelector(\"[class]\")}},\n {t:\"A button + JavaScript\",teach:\"JavaScript makes pages interactive. onclick runs code when a button is tapped.\",\n  goal:\"Make a button that changes the text when clicked.\",\n  starter:'<p id=\"out\">Tap the button</p>\\n<button onclick=\"document.getElementById(\\'out\\').textContent=\\'Clicked!\\'\">Click me</button>',\n  hint:'Add a <button onclick=\"...\">. Try it in the preview!',\n  check:function(c,d){return !!d.querySelector(\"button\")&&/onclick|addeventlistener/i.test(c)}},\n {t:\"Variables & the page\",teach:\"In a <script>, store data in a variable, then change the page with document.querySelector(...).textContent.\",\n  goal:\"Use a <script> with a variable that sets some text.\",\n  starter:'<h2 id=\"t\"></h2>\\n<script>\\n  var name = \"Coder\";\\n  document.querySelector(\"#t\").textContent = \"Hi, \" + name;\\n<\\/script>',\n  hint:\"Inside <script>, make a variable and use document.querySelector(...).textContent = ...\",\n  check:function(c,d){return /<script[\\s\\S]*(var|let|const)\\s/i.test(c)&&!!d.querySelector(\"#t\")}},\n {t:\"Flexbox layout\",teach:\"display: flex lays a box's children in a row. gap spaces them; justify-content positions them along the row; align-items across it.\",\n  goal:\"Make a flex row with at least 2 boxes inside.\",\n  starter:'<div style=\"display:flex; gap:10px; justify-content:center\">\\n  <div style=\"background:#0a84ff;color:#fff;padding:16px;border-radius:10px\">A</div>\\n  <div style=\"background:#34c759;color:#fff;padding:16px;border-radius:10px\">B</div>\\n  <div style=\"background:#ff9500;color:#fff;padding:16px;border-radius:10px\">C</div>\\n</div>',\n  hint:\"Put display:flex on a container, then give it 2+ child <div>s. gap adds space between them.\",\n  check:function(c,d){var w=frame.contentWindow,els=d.body.querySelectorAll(\"*\");for(var i=0;i<els.length;i++){try{if(w.getComputedStyle(els[i]).display===\"flex\"&&els[i].children.length>=2)return true}catch(e){}}return false}},\n {t:\"Forms & inputs\",teach:\"Forms collect what people type. <input> is a single line — set its type and a placeholder. Add a <button> to submit.\",\n  goal:\"Make a text input and a button.\",\n  starter:'<input type=\"text\" placeholder=\"Your name\">\\n<button>Submit</button>',\n  hint:\"Add an <input ...> and a <button>…</button>.\",\n  check:function(c,d){return !!d.querySelector(\"input,textarea,select\")&&!!d.querySelector(\"button,input[type=submit]\")}},\n {t:\"Capstone: profile card\",teach:\"Time to combine everything — a <style> block with classes, an image, a heading, text, and a button with JavaScript. Make it your own!\",\n  goal:\"Build a profile card: a styled box with a heading, an image, a short bio, and a button that does something when tapped.\",\n  starter:'<style>\\n  .card{max-width:280px;margin:auto;background:#fff;border:1px solid #eee;border-radius:16px;padding:20px;text-align:center;font-family:-apple-system,system-ui,sans-serif;box-shadow:0 6px 20px rgba(0,0,0,.08)}\\n  .card img{width:84px;height:84px;border-radius:50%;object-fit:cover}\\n  .card h2{margin:12px 0 2px}\\n  .card p{color:#666;font-size:14px;margin:0 0 14px}\\n  .card button{background:#0a84ff;color:#fff;border:0;padding:10px 18px;border-radius:10px;font-size:15px}\\n</style>\\n<div class=\"card\">\\n  <img src=\"https://picsum.photos/170\" alt=\"avatar\">\\n  <h2>Alex</h2>\\n  <p id=\"bio\">Learning to build for the web.</p>\\n  <button onclick=\"document.getElementById(\\'bio\\').textContent=\\'👋 Thanks for visiting!\\'\">Say hi</button>\\n</div>',\n  hint:\"Aim for at least four of: a heading, an image, a paragraph, a button, and box styling (padding / border-radius).\",\n  check:function(c,d){var n=0;if(d.querySelector(\"h1,h2,h3\"))n++;if(d.querySelector(\"img[src]\"))n++;if(d.querySelector(\"p\"))n++;if(d.querySelector(\"button\"))n++;if(/border-radius\\s*:/i.test(c)||/padding\\s*:/i.test(c))n++;return n>=4}},\n {t:\"Grid layout\",teach:\"display: grid arranges items into rows AND columns. grid-template-columns sets the columns — try repeat(3, 1fr) for three equal ones — and gap spaces them out.\",\n  goal:\"Make a grid with 3 columns and several boxes.\",\n  starter:'<style>\\n  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}\\n  .grid div{background:#5e5ce6;color:#fff;padding:18px;border-radius:10px;text-align:center}\\n</style>\\n<div class=\"grid\">\\n  <div>1</div><div>2</div><div>3</div>\\n  <div>4</div><div>5</div><div>6</div>\\n</div>',\n  hint:\"Put display:grid and grid-template-columns:repeat(3,1fr) on a container with several children.\",\n  check:function(c,d){var w=frame.contentWindow,els=d.body.querySelectorAll(\"*\");for(var i=0;i<els.length;i++){try{if(w.getComputedStyle(els[i]).display===\"grid\"&&els[i].children.length>=2)return true}catch(e){}}return false}},\n {t:\"Transitions & hover\",teach:\"transition makes a style change animate smoothly instead of snapping. Pair it with :hover (in a <style> block) so an element reacts when pointed at or tapped.\",\n  goal:\"Make an element that smoothly changes on hover, using transition.\",\n  starter:'<style>\\n  .btn{display:inline-block;background:#0a84ff;color:#fff;padding:12px 20px;border-radius:10px;\\n       transition:transform .25s ease, background .25s}\\n  .btn:hover{transform:scale(1.08);background:#5e5ce6}\\n</style>\\n<div class=\"btn\">Hover or tap me</div>',\n  hint:\"Add transition: transform .25s to an element, then a .name:hover { transform: scale(1.1) } rule.\",\n  check:function(c){return /transition\\s*:/i.test(c)&&/:hover/i.test(c)}},\n {t:\"Capstone: photo gallery\",teach:\"A second project! Combine grid for the layout with transition + :hover so the pictures zoom smoothly. Swap in your own image URLs and sizes.\",\n  goal:\"Build a photo gallery: a grid of at least 3 images that zoom smoothly on hover.\",\n  starter:'<style>\\n  .gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;max-width:360px;margin:auto}\\n  .gallery img{width:100%;height:120px;object-fit:cover;border-radius:12px;\\n               transition:transform .25s ease, box-shadow .25s}\\n  .gallery img:hover{transform:scale(1.06);box-shadow:0 8px 20px rgba(0,0,0,.2)}\\n</style>\\n<div class=\"gallery\">\\n  <img src=\"https://picsum.photos/seed/a/300/200\" alt=\"\">\\n  <img src=\"https://picsum.photos/seed/b/300/200\" alt=\"\">\\n  <img src=\"https://picsum.photos/seed/c/300/200\" alt=\"\">\\n  <img src=\"https://picsum.photos/seed/d/300/200\" alt=\"\">\\n</div>',\n  hint:\"Aim for a grid container, 3+ images, and a transition (plus a :hover for the zoom).\",\n  check:function(c,d){var n=0;if(/grid-template|display\\s*:\\s*grid/i.test(c))n++;if(d.querySelectorAll(\"img[src]\").length>=3)n++;if(/transition\\s*:/i.test(c))n++;if(/:hover/i.test(c))n++;return n>=3}}\n];\n\nvar state={idx:0,done:{},code:{}},frame,editor,renderT,saveT,busy=false;\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nfunction $(i){return document.getElementById(i)}\nfunction wrap(code){return '<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>body{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:14px;color:#111;background:#fff;line-height:1.5}</style></head><body>'+code+'</body></html>'}\nfunction render(){\n  if(!frame)return;\n  try{var d=frame.contentDocument||frame.contentWindow.document;d.open();d.write(wrap(editor.value));d.close()}catch(e){}\n}\nfunction previewDoc(){try{return frame.contentDocument||frame.contentWindow.document}catch(e){return document.implementation.createHTMLDocument('')}}\n\nfunction bar(){var n=Object.keys(state.done).length;$('bar').style.width=(n/LESSONS.length*100)+'%'}\n\nfunction lessonView(i){\n  var L=LESSONS[i],aiOn=!!window.myllmAsk;\n  return '<div class=\"lesson-no\">Lesson '+(i+1)+' / '+LESSONS.length+'</div>'+\n    '<h2 class=\"title\">'+L.t+'</h2>'+\n    '<p class=\"teach\">'+L.teach.replace(/</g,'&lt;')+'</p>'+\n    '<div class=\"goal\">🎯 <b>Goal:</b> '+L.goal.replace(/</g,'&lt;')+'</div>'+\n    '<div class=\"lab\"><label>Your code — edit it</label>'+\n    '<textarea id=\"editor\" spellcheck=\"false\" autocapitalize=\"off\" autocorrect=\"off\" autocomplete=\"off\"></textarea>'+\n    '<div class=\"previewWrap\"><label>Live preview</label><iframe id=\"frame\" title=\"preview\"></iframe></div></div>'+\n    '<div id=\"fb\"></div><div id=\"aiBox\"></div>'+\n    '<div class=\"btns\">'+\n      '<button class=\"check\" id=\"checkBtn\">Check ✓</button>'+\n      '<button class=\"ghost\" id=\"resetBtn\">Reset</button>'+\n      (aiOn?'<button class=\"ai\" id=\"explainBtn\">💡 Explain</button><button class=\"ai\" id=\"helpBtn\">🤔 Help me fix it</button>':'')+\n    '</div>'+\n    '<div class=\"nav\"><button id=\"prevBtn\">← Back</button><button id=\"nextBtn\">Next →</button></div>';\n}\n\nfunction load(i){\n  state.idx=i;$('view').innerHTML=lessonView(i);\n  editor=$('editor');frame=$('frame');\n  editor.value=(i in state.code)?state.code[i]:LESSONS[i].starter;\n  render();bar();save();\n  editor.addEventListener('input',function(){state.code[state.idx]=editor.value;clearTimeout(renderT);renderT=setTimeout(render,180);clearTimeout(saveT);saveT=setTimeout(save,500)});\n  $('checkBtn').onclick=check;\n  $('resetBtn').onclick=function(){editor.value=LESSONS[state.idx].starter;state.code[state.idx]=editor.value;render();fb('','');haptic('light')};\n  $('prevBtn').onclick=function(){if(state.idx>0){haptic('selection');load(state.idx-1)}};\n  $('prevBtn').disabled=(i===0);\n  $('nextBtn').onclick=function(){haptic('selection');if(state.idx<LESSONS.length-1)load(state.idx+1);else finish()};\n  if(window.myllmAsk){$('explainBtn').onclick=explain;$('helpBtn').onclick=help}\n  fb(state.done[i]?'ok':'', state.done[i]?'Completed ✓':'');\n}\nfunction fb(kind,msg){var e=$('fb');if(!e)return;e.className=kind||'';e.textContent=msg||'';if(!kind)e.style.display='none'}\nfunction check(){\n  render();var ok=false;try{ok=LESSONS[state.idx].check(editor.value,previewDoc())}catch(e){ok=false}\n  if(ok){state.done[state.idx]=true;fb('ok','Nice — that works! Tap Next →');haptic('success');bar();save()}\n  else{fb('no','Not quite. '+LESSONS[state.idx].hint);haptic('warning')}\n}\n\nvar SYS=\"You are a friendly, encouraging coding tutor for absolute beginners learning HTML, CSS and JavaScript. Keep every answer to 2-3 short, plain sentences. Be concrete and kind. Never lecture.\";\nfunction aiBusy(b){busy=b;var ex=$('explainBtn'),h=$('helpBtn');if(ex)ex.disabled=b;if(h)h.disabled=b}\nfunction showAI(t){var b=$('aiBox');b.style.display='block';b.textContent=t}\nfunction explain(){\n  if(busy)return;var L=LESSONS[state.idx];aiBusy(true);showAI('Thinking');$('aiBox').innerHTML='<span class=\"dots\">Thinking</span>';haptic('light');\n  myllmAsk('Explain this beginner web-coding topic in 2-3 simple sentences: \"'+L.t+'\". Context: '+L.teach,{system:SYS})\n   .then(function(r){showAI((r||'').trim()||'Try again.')}).catch(function(){showAI('The AI is unavailable right now.')}).then(function(){aiBusy(false)});\n}\nfunction help(){\n  if(busy)return;var L=LESSONS[state.idx];aiBusy(true);$('aiBox').style.display='block';$('aiBox').innerHTML='<span class=\"dots\">Looking at your code</span>';haptic('light');\n  myllmAsk('A beginner is on the lesson \"'+L.t+'\". Goal: '+L.goal+'\\nTheir code:\\n'+editor.value+'\\n\\nIn 2-3 sentences, gently nudge them toward what to change. Give a hint, not the full solution.',{system:SYS})\n   .then(function(r){showAI((r||'').trim()||'Try again.')}).catch(function(){showAI('The AI is unavailable right now.')}).then(function(){aiBusy(false)});\n}\n\nfunction finish(){\n  var n=Object.keys(state.done).length;\n  $('view').innerHTML='<div class=\"done-screen\"><div class=\"big\">🎉</div><h2 class=\"title\">You reached the end!</h2>'+\n    '<p class=\"teach\">You completed '+n+' of '+LESSONS.length+' challenges. You can now write real HTML, style it with CSS, and add JavaScript.</p>'+\n    '<div class=\"btns\" style=\"justify-content:center\"><button class=\"check\" id=\"again\">Review lessons</button></div></div>';\n  $('again').onclick=function(){load(0)};haptic('success');bar();\n}\n\nfunction buildList(){\n  var l=$('list');l.innerHTML='';\n  LESSONS.forEach(function(L,i){\n    var d=document.createElement('div');d.className='litem'+(state.done[i]?' done':'')+(i===state.idx?' cur':'');\n    d.innerHTML='<span class=\"n\">'+(state.done[i]?'✓':(i+1))+'</span><span>'+L.t+'</span>';\n    d.onclick=function(){$('sheet').classList.remove('show');haptic('selection');load(i)};l.appendChild(d);\n  });\n}\n$('menuBtn').onclick=function(){buildList();$('sheet').classList.add('show');haptic('selection')};\n$('sheet').onclick=function(e){if(e.target===$('sheet'))$('sheet').classList.remove('show')};\n\nfunction save(){if(window.myllmStorage)myllmStorage.setItem('codelab',JSON.stringify({idx:state.idx,done:state.done,code:state.code}))}\nfunction start(){\n  if(!window.myllmStorage){load(0);return}\n  myllmStorage.getItem('codelab').then(function(v){\n    if(v)try{var s=JSON.parse(v);state.done=s.done||{};state.code=s.code||{};state.idx=s.idx||0}catch(e){}\n    load(state.idx<LESSONS.length?state.idx:0);\n  });\n}\nstart();\n</script>\n</body>\n</html>\n", "kind": "html", "iconSymbol": "chevron.left.forwardslash.chevron.right", "iconColor": "blue"}