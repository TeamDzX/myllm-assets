{"name": "Stocks", "kind": "html", "iconSymbol": "chart.line.uptrend.xyaxis", "iconColor": "green", "html": "<!doctype html>\n<!--\n  Stocks — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Stocks</title>\n<style>\n:root{--build-id:\"53d328e242\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7);--surface:var(--myllm-surface,#fff);--text:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#6e6e73);--accent:var(--myllm-accent,#0a84ff);--border:var(--myllm-border,#e3e3e8);\n  --radius:var(--myllm-radius,18px);--up:#2fb56a;--down:#e5484d;--warn:#e8a317}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nhtml,body{margin:0}\nbody{font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);background:var(--bg);color:var(--text);\n  padding:16px 16px calc(28px + env(safe-area-inset-bottom));max-width:820px;margin:0 auto;-webkit-font-smoothing:antialiased}\nh1{font-size:24px;margin:0;letter-spacing:-.3px}\n.sub{font-size:13px;color:var(--muted);margin:3px 0 12px}\n.top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}\n.btn{border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:12px;padding:9px 13px;font-size:14px;font-weight:600;white-space:nowrap}\n.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}\n.btn.danger{color:var(--down)}\n.btn[disabled]{opacity:.5}\n.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:4px 14px}\n.status{font-size:12px;color:var(--muted);min-height:16px;margin:0 2px 8px;display:flex;justify-content:space-between;gap:8px}\n.status.warn{color:var(--warn)}\n.row{display:flex;align-items:center;gap:12px;padding:12px 0;border-top:1px solid var(--border);cursor:pointer}\n.row:first-child{border-top:0}\n.row .id{flex:1;min-width:0}\n.row .sym{font-size:16px;font-weight:700}\n.row .name{font-size:12px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.row .spark{width:72px;height:30px;flex:none}\n.row .px{text-align:right;flex:none;min-width:88px}\n.row .price{font-size:16px;font-weight:700;font-variant-numeric:tabular-nums}\n.row .chg{font-size:12px;font-weight:700;border-radius:7px;padding:2px 6px;display:inline-block;margin-top:2px;color:#fff;font-variant-numeric:tabular-nums}\n.chg.up{background:var(--up)}.chg.down{background:var(--down)}.chg.flat{background:var(--muted)}\n.row .hold{font-size:11px;color:var(--muted);margin-top:2px}\n.empty{color:var(--muted);font-size:14px;text-align:center;padding:26px 8px;line-height:1.5}\n.totals{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0 0}\n.tot{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:10px 12px;flex:1;min-width:140px}\n.tot .k{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;font-weight:600}\n.tot .v{font-size:20px;font-weight:700;font-variant-numeric:tabular-nums;margin-top:2px}\n.tot .d{font-size:12px;font-weight:700;margin-top:2px}\n.d.up{color:var(--up)}.d.down{color:var(--down)}\n.note{font-size:12px;color:var(--muted);line-height:1.5;margin-top:14px}\n[hidden]{display:none!important}\n/* detail + search sheets */\n.sheet{position:fixed;inset:0;background:var(--bg);z-index:9;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:0 0 calc(28px + env(safe-area-inset-bottom))}\n.sheet .bar{position:sticky;top:0;z-index:2;background:var(--bg);display:flex;align-items:center;gap:8px;padding:calc(10px + env(safe-area-inset-top)) 14px 10px;border-bottom:1px solid var(--border)}\n.sheet .bar .t{flex:1;min-width:0;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.sheet .bar input{flex:1;min-width:0;padding:11px 12px;border:1px solid var(--border);border-radius:12px;font-size:16px;background:var(--surface);color:var(--text)}\n.wrap{padding:16px}\n.big{font-size:40px;font-weight:700;letter-spacing:-1px;font-variant-numeric:tabular-nums;line-height:1.1}\n.big small{font-size:16px;color:var(--muted);font-weight:600;margin-left:6px}\n.dchg{font-size:15px;font-weight:700;margin-top:4px}\n.chart{width:100%;height:200px;display:block;margin:12px 0 4px}\n.ranges{display:flex;gap:6px;margin:6px 0 14px}\n.ranges button{flex:1;border:1px solid var(--border);background:var(--surface);color:var(--muted);border-radius:10px;padding:8px 0;font-size:13px;font-weight:700}\n.ranges button.on{background:var(--text);color:var(--bg);border-color:var(--text)}\n.stats{display:grid;grid-template-columns:1fr 1fr;gap:8px 14px;font-size:14px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:14px}\n.stats .k{color:var(--muted)}.stats .v{text-align:right;font-weight:600;font-variant-numeric:tabular-nums}\n.holdings{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:14px;margin-top:12px}\n.holdings label{font-size:13px;color:var(--muted)}\n.holdings .hrow{display:flex;gap:8px;align-items:center;margin-top:6px}\n.holdings input{flex:1;min-width:0;padding:10px 12px;border:1px solid var(--border);border-radius:12px;font-size:16px;background:var(--bg);color:var(--text)}\n.holdings .val{font-size:14px;margin-top:8px}\n.srow{display:flex;align-items:center;gap:12px;padding:12px 14px;border-bottom:1px solid var(--border)}\n.srow .id{flex:1;min-width:0}.srow .sym{font-weight:700}.srow .name{font-size:12px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.srow .exch{font-size:11px;color:var(--muted);border:1px solid var(--border);border-radius:6px;padding:1px 6px}\n.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(20px);\n  background:var(--text);color:var(--bg);padding:10px 16px;border-radius:14px;font-size:14px;font-weight:600;opacity:0;pointer-events:none;transition:.25s;z-index:10}\n.toast.on{opacity:1;transform:translateX(-50%) translateY(0)}\n</style></head><body>\n\n<div class=\"top\">\n  <div><h1>Stocks</h1><div class=\"sub\">Your watchlist, at a glance</div></div>\n  <div style=\"display:flex;gap:8px\"><button class=\"btn\" id=\"refreshBtn\">Refresh</button><button class=\"btn primary\" id=\"addBtn\">＋ Add</button></div>\n</div>\n\n<div class=\"status\"><span id=\"status\"></span><span id=\"asOf\"></span></div>\n<div class=\"card\" id=\"list\"></div>\n<div class=\"totals\" id=\"totals\" hidden></div>\n\n<p class=\"note\">Prices come from Yahoo Finance's public quote feed through MyLLM's network bridge and can be delayed by up to 15 minutes; London prices are shown in pence. Tap a stock for its chart, and enter how many shares you hold to see what your position is worth. Everything stays on this device. Not financial advice.</p>\n\n<div class=\"sheet\" id=\"detail\" hidden>\n  <div class=\"bar\"><button class=\"btn\" id=\"backBtn\">‹ Back</button><div class=\"t\" id=\"dTitle\"></div><button class=\"btn danger\" id=\"removeBtn\">Remove</button></div>\n  <div class=\"wrap\" id=\"dBody\"></div>\n</div>\n\n<div class=\"sheet\" id=\"search\" hidden>\n  <div class=\"bar\"><input id=\"q\" placeholder=\"Company or ticker, e.g. Vodafone or VOD.L\" autocapitalize=\"characters\" autocorrect=\"off\" enterkeyhint=\"search\"><button class=\"btn\" id=\"closeSearch\">Done</button></div>\n  <div id=\"results\"></div>\n</div>\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\n(function(){\n'use strict';\nvar $=function(id){return document.getElementById(id);};\nfunction haptic(k){try{if(window.myllmHaptic)window.myllmHaptic(k||'light');}catch(e){}}\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null);},setItem:function(){return Promise.resolve();}};\nvar hasFetch=typeof window.myllmFetch==='function';\nvar KEY='stocks.v1';\nvar state={symbols:['^FTSE','^GSPC','AAPL','MSFT','VOD.L'],names:{},holdings:{},cache:{},updated:0};\nvar current=null,range='1D',dchartSeries=null;\nvar RANGES={'1D':{range:'1d',interval:'5m'},'5D':{range:'5d',interval:'30m'},'1M':{range:'1mo',interval:'1d'},'6M':{range:'6mo',interval:'1d'},'1Y':{range:'1y',interval:'1wk'}};\n\nfunction esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\nfunction toast(t){var e=$('toast');e.textContent=t;e.classList.add('on');clearTimeout(toast._t);toast._t=setTimeout(function(){e.classList.remove('on');},1800);}\nfunction save(){return store.setItem(KEY,JSON.stringify({symbols:state.symbols,names:state.names,holdings:state.holdings,cache:state.cache,updated:state.updated})).catch(function(){});}\nfunction load(){return store.getItem(KEY).then(function(s){try{var d=JSON.parse(s||'{}');if(d&&Array.isArray(d.symbols)){state.symbols=d.symbols;state.names=d.names||{};state.holdings=d.holdings||{};state.cache=d.cache||{};state.updated=d.updated||0;}}catch(e){}}).catch(function(){});}\nfunction friendlyError(e){var m=(e&&e.message)||String(e||'');if(/turned off/i.test(m))return 'Network access for apps is turned off in MyLLM Settings.';if(/offline|not connected/i.test(m))return 'You appear to be offline.';return 'Could not reach the quote service.';}\n\n/* ---------- money formatting ---------- */\nfunction isPence(q){return q&&q.currency==='GBp';}\nfunction fmtPrice(v,q){\n  if(v==null||!isFinite(v))return '—';\n  if(isPence(q))return v.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2})+'p';\n  var sym={USD:'$',EUR:'€',GBP:'£',JPY:'¥',CHF:'CHF ',CAD:'C$',AUD:'A$',HKD:'HK$',INR:'₹'}[q&&q.currency]||'';\n  var dp=Math.abs(v)>=1000?0:2;\n  return sym+v.toLocaleString(undefined,{minimumFractionDigits:dp,maximumFractionDigits:dp});\n}\n/* Holdings are worth pounds even when the quote is in pence. */\nfunction positionValue(q,shares){if(!q||!shares)return null;var v=q.price*shares;return isPence(q)?v/100:v;}\nfunction positionCurrency(q){return isPence(q)?'GBP':(q.currency||'');}\nfunction fmtMoney(v,ccy){var sym={USD:'$',EUR:'€',GBP:'£',JPY:'¥'}[ccy]||(ccy+' ');return sym+v.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2});}\nfunction chgClass(d){return d>0.0001?'up':d<-0.0001?'down':'flat';}\nfunction pct(q){if(!q||q.prevClose==null||q.price==null||!q.prevClose)return 0;return (q.price-q.prevClose)/q.prevClose*100;}\nfunction fmtChg(q){if(!q||q.prevClose==null||q.price==null)return '';var p=pct(q);if(Math.abs(p)<0.005)return '0.00%';return (p>=0?'+':'')+p.toFixed(2)+'%';}\n\n/* ---------- data ---------- */\nfunction chartURL(sym,r){var o=RANGES[r]||RANGES['1D'];return 'https://query1.finance.yahoo.com/v8/finance/chart/'+encodeURIComponent(sym)+'?range='+o.range+'&interval='+o.interval+'&includePrePost=false';}\nfunction parseChart(body){\n  var d=JSON.parse(body||'{}');var r=d.chart&&d.chart.result&&d.chart.result[0];\n  if(!r){var err=d.chart&&d.chart.error;throw new Error(err&&err.description||'No data for that symbol');}\n  var m=r.meta||{},ts=r.timestamp||[],closes=(r.indicators&&r.indicators.quote&&r.indicators.quote[0]&&r.indicators.quote[0].close)||[];\n  var series=[];for(var i=0;i<ts.length;i++){if(closes[i]!=null)series.push([ts[i],closes[i]]);}\n  return {symbol:m.symbol,name:m.shortName||m.longName||m.symbol,currency:m.currency,exchange:m.fullExchangeName||m.exchangeName||'',\n    price:m.regularMarketPrice,prevClose:m.chartPreviousClose!=null?m.chartPreviousClose:m.previousClose,\n    dayHigh:m.regularMarketDayHigh,dayLow:m.regularMarketDayLow,volume:m.regularMarketVolume,\n    wkHigh:m.fiftyTwoWeekHigh,wkLow:m.fiftyTwoWeekLow,marketTime:m.regularMarketTime,series:series};\n}\nfunction fetchQuote(sym,r){\n  if(!hasFetch)return Promise.reject(new Error('This app needs MyLLM\\'s network bridge — open it inside the MyLLM app.'));\n  return window.myllmFetch(chartURL(sym,r||'1D'),{headers:{'accept':'application/json'}}).then(function(res){if(!res||!res.ok)throw new Error('HTTP '+(res&&res.status));return parseChart(res.body);});\n}\nvar refreshing=false;\nfunction refreshAll(){\n  if(refreshing||!state.symbols.length)return Promise.resolve();\n  if(!hasFetch){setStatus('Open this app inside MyLLM to load prices.',true);render();return Promise.resolve();}\n  refreshing=true;$('refreshBtn').disabled=true;setStatus('Updating…');\n  var failed=[];\n  return Promise.all(state.symbols.map(function(s){\n    return fetchQuote(s,'1D').then(function(q){var old=state.cache[s]||{};q.series1d=q.series;delete q.series;state.cache[s]=Object.assign(old,q);state.names[s]=q.name;})\n      .catch(function(e){failed.push(s);if(!state.cache[s])state.cache[s]={symbol:s,name:state.names[s]||s,error:friendlyError(e)};});\n  })).then(function(){\n    if(failed.length<state.symbols.length)state.updated=Date.now();\n    setStatus(failed.length?('Couldn\\'t update '+failed.join(', ')):'',failed.length>0);\n    save();render();if(!failed.length)haptic('selection');\n  }).then(function(){refreshing=false;$('refreshBtn').disabled=false;});\n}\nfunction setStatus(t,warn){$('status').textContent=t||'';$('status').className=warn?'status warn':'status';}\nfunction asOf(){if(!state.updated)return '';var m=(Date.now()-state.updated)/6e4;return m<1?'just now':m<60?Math.round(m)+' min ago':new Date(state.updated).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});}\n\n/* ---------- sparkline / chart ---------- */\nfunction polyline(series,w,h,pad){\n  if(!series||series.length<2)return '';\n  var min=Infinity,max=-Infinity;series.forEach(function(p){if(p[1]<min)min=p[1];if(p[1]>max)max=p[1];});\n  if(max===min){max+=1;min-=1;}\n  var pts=series.map(function(p,i){var x=pad+(w-2*pad)*i/(series.length-1);var y=pad+(h-2*pad)*(1-(p[1]-min)/(max-min));return x.toFixed(1)+','+y.toFixed(1);});\n  return pts.join(' ');\n}\nfunction sparkSVG(q){\n  var s=q&&q.series1d;if(!s||s.length<2)return '<svg class=\"spark\" viewBox=\"0 0 72 30\"></svg>';\n  var col=chgClass(q.price-(q.prevClose||q.price))==='down'?'var(--down)':'var(--up)';\n  return '<svg class=\"spark\" viewBox=\"0 0 72 30\" preserveAspectRatio=\"none\"><polyline fill=\"none\" stroke=\"'+col+'\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\" points=\"'+polyline(s,72,30,2)+'\"/></svg>';\n}\nfunction chartSVG(series,q,baseline){\n  var W=360,H=200;\n  if(!series||series.length<2)return '<div class=\"empty\">No chart data for this range.</div>';\n  var min=Infinity,max=-Infinity;series.forEach(function(p){if(p[1]<min)min=p[1];if(p[1]>max)max=p[1];});\n  if(baseline!=null){if(baseline<min)min=baseline;if(baseline>max)max=baseline;}\n  if(max===min){max+=1;min-=1;}\n  var pad=6;\n  function y(v){return (pad+(H-2*pad)*(1-(v-min)/(max-min))).toFixed(1);}\n  var pts=series.map(function(p,i){return (pad+(W-2*pad)*i/(series.length-1)).toFixed(1)+','+y(p[1]);}).join(' ');\n  var last=series[series.length-1][1],first=baseline!=null?baseline:series[0][1];\n  var col=last>=first?'var(--up)':'var(--down)';\n  var area=pts+' '+(W-pad)+','+(H-pad)+' '+pad+','+(H-pad);\n  var base=baseline!=null?'<line x1=\"'+pad+'\" x2=\"'+(W-pad)+'\" y1=\"'+y(baseline)+'\" y2=\"'+y(baseline)+'\" stroke=\"var(--border)\" stroke-dasharray=\"4 4\"/>':'';\n  return '<svg class=\"chart\" viewBox=\"0 0 '+W+' '+H+'\" preserveAspectRatio=\"none\"><defs><linearGradient id=\"g\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"'+col+'\" stop-opacity=\".25\"/><stop offset=\"1\" stop-color=\"'+col+'\" stop-opacity=\"0\"/></linearGradient></defs>'+base+\n    '<polygon fill=\"url(#g)\" points=\"'+area+'\"/><polyline fill=\"none\" stroke=\"'+col+'\" stroke-width=\"2.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" points=\"'+pts+'\"/></svg>'+\n    '<div style=\"display:flex;justify-content:space-between;font-size:11px;color:var(--muted)\"><span>'+esc(fmtPrice(min,q))+'</span><span>'+esc(fmtPrice(max,q))+'</span></div>';\n}\n\n/* ---------- render ---------- */\nfunction render(){\n  $('asOf').textContent=state.updated?'as of '+asOf():'';\n  var list=$('list');\n  if(!state.symbols.length){list.innerHTML='<div class=\"empty\">Your watchlist is empty.<br>Tap <b>Add</b> to search for a company or ticker.</div>';$('totals').hidden=true;return;}\n  list.innerHTML=state.symbols.map(function(s){\n    var q=state.cache[s]||{symbol:s,name:state.names[s]||s};\n    var chg=fmtChg(q),cls=q.prevClose!=null&&q.price!=null?(Math.abs(pct(q))<0.005?'flat':chgClass(q.price-q.prevClose)):'flat';\n    var shares=state.holdings[s],pv=positionValue(q,shares);\n    return '<div class=\"row\" data-sym=\"'+esc(s)+'\"><div class=\"id\"><div class=\"sym\">'+esc(s)+'</div><div class=\"name\">'+esc(q.name||s)+(q.error?' · <span style=\"color:var(--warn)\">'+esc(q.error)+'</span>':'')+'</div>'+(pv!=null?'<div class=\"hold\">'+esc(shares.toLocaleString())+' shares · '+esc(fmtMoney(pv,positionCurrency(q)))+'</div>':'')+'</div>'+\n      sparkSVG(q)+'<div class=\"px\"><div class=\"price\">'+esc(fmtPrice(q.price,q))+'</div>'+(chg?'<span class=\"chg '+cls+'\">'+esc(chg)+'</span>':'')+'</div></div>';\n  }).join('');\n  // portfolio totals per currency\n  var tot={};\n  state.symbols.forEach(function(s){var q=state.cache[s],sh=state.holdings[s];var pv=positionValue(q,sh);if(pv==null)return;var c=positionCurrency(q);var prev=q.prevClose!=null?(isPence(q)?q.prevClose*sh/100:q.prevClose*sh):pv;tot[c]=tot[c]||{v:0,d:0};tot[c].v+=pv;tot[c].d+=pv-prev;});\n  var keys=Object.keys(tot);\n  $('totals').hidden=!keys.length;\n  $('totals').innerHTML=keys.map(function(c){var t=tot[c];return '<div class=\"tot\"><div class=\"k\">Holdings · '+esc(c)+'</div><div class=\"v\">'+esc(fmtMoney(t.v,c))+'</div><div class=\"d '+chgClass(t.d)+'\">'+(t.d>=0?'+':'')+esc(fmtMoney(t.d,c).replace(/^[^0-9-]*/,''))+' today</div></div>';}).join('');\n}\n\n/* ---------- detail ---------- */\nfunction openDetail(sym){\n  current=sym;range='1D';$('detail').hidden=false;$('detail').scrollTop=0;document.body.style.overflow='hidden';haptic('selection');\n  renderDetail();loadRange();\n}\nfunction closeDetail(){$('detail').hidden=true;document.body.style.overflow='';current=null;dchartSeries=null;render();}\nfunction renderDetail(){\n  var q=state.cache[current]||{symbol:current,name:state.names[current]||current};\n  $('dTitle').textContent=(q.name||current)+' · '+current;\n  var cls=q.prevClose!=null&&q.price!=null?chgClass(q.price-q.prevClose):'flat';\n  var d=q.prevClose!=null&&q.price!=null?q.price-q.prevClose:null;\n  var series=dchartSeries||q.series1d;\n  var shares=state.holdings[current]||'';\n  var pv=positionValue(q,+shares||0);\n  $('dBody').innerHTML='<div class=\"big\">'+esc(fmtPrice(q.price,q))+'<small>'+esc(q.currency==='GBp'?'GBX':(q.currency||''))+'</small></div>'+\n    '<div class=\"dchg '+cls+'\" style=\"color:var(--'+(cls==='flat'?'muted':cls)+')\">'+(d!=null?esc((d>=0?'+':'')+fmtPrice(Math.abs(d),q).replace(/^-/,''))+' ('+esc(fmtChg(q))+') today':'')+'</div>'+\n    '<div id=\"dchart\">'+chartSVG(series,q,range==='1D'?q.prevClose:null)+'</div>'+\n    '<div class=\"ranges\">'+Object.keys(RANGES).map(function(r){return '<button data-r=\"'+r+'\"'+(r===range?' class=\"on\"':'')+'>'+r+'</button>';}).join('')+'</div>'+\n    '<div class=\"stats\">'+[['Previous close',fmtPrice(q.prevClose,q)],['Day range',q.dayLow!=null?fmtPrice(q.dayLow,q)+' – '+fmtPrice(q.dayHigh,q):'—'],['52-week range',q.wkLow!=null?fmtPrice(q.wkLow,q)+' – '+fmtPrice(q.wkHigh,q):'—'],['Volume',q.volume!=null?q.volume.toLocaleString():'—'],['Exchange',q.exchange||'—'],['Currency',q.currency==='GBp'?'Pence sterling':(q.currency||'—')]].map(function(x){return '<div class=\"k\">'+esc(x[0])+'</div><div class=\"v\">'+esc(x[1])+'</div>';}).join('')+'</div>'+\n    '<div class=\"holdings\"><label for=\"shares\">Shares you hold (optional)</label><div class=\"hrow\"><input id=\"shares\" inputmode=\"decimal\" placeholder=\"0\" value=\"'+esc(shares)+'\"><button class=\"btn\" id=\"saveShares\">Save</button></div>'+(pv!=null?'<div class=\"val\">Worth <b>'+esc(fmtMoney(pv,positionCurrency(q)))+'</b>'+(q.prevClose!=null?' · '+((q.price-q.prevClose)>=0?'+':'')+esc(fmtMoney(positionValue(q,+shares)-(isPence(q)?q.prevClose*(+shares)/100:q.prevClose*(+shares)),positionCurrency(q)).replace(/^([^0-9-]*)-/,'-$1'))+' today':'')+'</div>':'')+'</div>';\n}\nfunction loadRange(){\n  var sym=current,r=range;\n  if(r==='1D'){dchartSeries=null;renderDetail();return;}\n  var cached=(state.cache[sym]&&state.cache[sym].ranges&&state.cache[sym].ranges[r]);\n  if(cached&&Date.now()-cached.at<15*6e4){dchartSeries=cached.series;renderDetail();return;}\n  fetchQuote(sym,r).then(function(q){if(current!==sym||range!==r)return;state.cache[sym].ranges=state.cache[sym].ranges||{};state.cache[sym].ranges[r]={at:Date.now(),series:q.series};dchartSeries=q.series;renderDetail();save();})\n    .catch(function(e){if(current===sym)toast(friendlyError(e));});\n}\n$('dBody').addEventListener('click',function(e){\n  var rb=e.target.closest('button[data-r]');if(rb){range=rb.dataset.r;haptic('selection');renderDetail();loadRange();return;}\n  if(e.target.id==='saveShares'){var v=parseFloat($('shares').value);if(v>0)state.holdings[current]=v;else delete state.holdings[current];save();renderDetail();haptic('success');toast(v>0?'Holding saved':'Holding cleared');}\n});\n$('backBtn').addEventListener('click',closeDetail);\n$('removeBtn').addEventListener('click',function(){\n  var s=current;state.symbols=state.symbols.filter(function(x){return x!==s;});delete state.cache[s];delete state.holdings[s];save();closeDetail();haptic('warning');toast('Removed '+s);\n});\n\n/* ---------- search / add ---------- */\nvar searchTimer=null;\nfunction openSearch(){$('search').hidden=false;$('results').innerHTML='<div class=\"empty\">Type a company name or ticker.<br>London shares end in .L, e.g. VOD.L; indexes start with ^, e.g. ^FTSE.</div>';document.body.style.overflow='hidden';setTimeout(function(){$('q').focus();},50);haptic('light');}\nfunction closeSearch(){$('search').hidden=true;document.body.style.overflow='';$('q').value='';}\nfunction doSearch(){\n  var q=$('q').value.trim();if(!q){return;}\n  if(!hasFetch){$('results').innerHTML='<div class=\"empty\">Search needs MyLLM\\'s network bridge.</div>';return;}\n  $('results').innerHTML='<div class=\"empty\">Searching…</div>';\n  window.myllmFetch('https://query1.finance.yahoo.com/v1/finance/search?q='+encodeURIComponent(q)+'&quotesCount=10&newsCount=0').then(function(res){\n    var d=JSON.parse(res.body||'{}');var qs=(d.quotes||[]).filter(function(x){return x.symbol&&['EQUITY','ETF','INDEX','MUTUALFUND','CRYPTOCURRENCY'].indexOf(x.quoteType)>=0;});\n    if(!qs.length){$('results').innerHTML='<div class=\"empty\">No match for \"'+esc(q)+'\". Try the ticker itself.</div>';return;}\n    $('results').innerHTML=qs.map(function(x){var have=state.symbols.indexOf(x.symbol)>=0;return '<div class=\"srow\" data-sym=\"'+esc(x.symbol)+'\" data-name=\"'+esc(x.shortname||x.longname||x.symbol)+'\"><div class=\"id\"><div class=\"sym\">'+esc(x.symbol)+'</div><div class=\"name\">'+esc(x.shortname||x.longname||'')+'</div></div><span class=\"exch\">'+esc(x.exchDisp||x.quoteType||'')+'</span><button class=\"btn'+(have?'':' primary')+'\"'+(have?' disabled':'')+'>'+(have?'Added':'Add')+'</button></div>';}).join('');\n  }).catch(function(e){$('results').innerHTML='<div class=\"empty\">'+esc(friendlyError(e))+'</div>';});\n}\n$('q').addEventListener('input',function(){clearTimeout(searchTimer);searchTimer=setTimeout(doSearch,350);});\n$('q').addEventListener('keydown',function(e){if(e.key==='Enter'){clearTimeout(searchTimer);doSearch();}});\n$('results').addEventListener('click',function(e){\n  var row=e.target.closest('.srow');if(!row)return;var s=row.dataset.sym;\n  if(state.symbols.indexOf(s)>=0)return;\n  state.symbols.push(s);state.names[s]=row.dataset.name;save();haptic('success');toast('Added '+s);closeSearch();render();\n  fetchQuote(s,'1D').then(function(q){q.series1d=q.series;delete q.series;state.cache[s]=q;state.names[s]=q.name;state.updated=Date.now();save();render();}).catch(function(e){state.cache[s]={symbol:s,name:state.names[s]||s,error:friendlyError(e)};render();});\n});\n$('closeSearch').addEventListener('click',closeSearch);\n$('addBtn').addEventListener('click',openSearch);\n$('refreshBtn').addEventListener('click',function(){refreshAll();});\n$('list').addEventListener('click',function(e){var r=e.target.closest('.row[data-sym]');if(r)openDetail(r.dataset.sym);});\n\nload().then(function(){\n  render();\n  refreshAll();\n});\ndocument.addEventListener('visibilitychange',function(){if(!document.hidden&&hasFetch&&Date.now()-state.updated>6e4)refreshAll();});\n})();\n</script>\n</body></html>\n"}