{"name": "Command Center", "kind": "html", "iconSymbol": "antenna.radiowaves.left.and.right", "iconColor": "blue", "html": "<!doctype html>\n<!--\n  Command Center — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Command Center</title>\n<style>\n  :root{--build-id:\"761922ee1c\"; color-scheme:light dark; }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111);\n    max-width:680px; margin:0 auto; min-height:100dvh;\n    padding:12px 12px calc(20px + env(safe-area-inset-bottom)); }\n  .top{ display:flex; align-items:center; gap:10px; margin:2px 2px 12px; }\n  .top h1{ font-size:20px; font-weight:800; flex:1; display:flex; align-items:center; gap:8px; }\n  .ib{ border:0; background:var(--myllm-surface,#fff); color:var(--myllm-text,#111);\n    width:38px; height:38px; border-radius:12px; font-size:17px; display:flex; align-items:center; justify-content:center; }\n  .ib:active{ transform:scale(.94); }\n\n  .summary{ display:flex; gap:8px; margin-bottom:12px; }\n  .stat{ flex:1; background:var(--myllm-surface,#fff); border-radius:14px; padding:10px 12px; text-align:center; }\n  .stat b{ display:block; font-size:22px; font-weight:800; }\n  .stat small{ font-size:11px; color:var(--myllm-muted,#8a8a8e); font-weight:650; }\n  .stat.ok b{ color:#34c759; } .stat.warn b{ color:#ff9500; } .stat.err b{ color:#ff3b30; }\n  .synced{ font-size:11.5px; color:var(--myllm-muted,#8a8a8e); text-align:center; margin-bottom:12px; min-height:14px; }\n\n  .card{ background:var(--myllm-surface,#fff); border-radius:16px; padding:13px 14px; margin-bottom:10px;\n    border-left:4px solid var(--myllm-border,#d1d1d6); }\n  .card.ok{ border-left-color:#34c759; } .card.warn{ border-left-color:#ff9500; }\n  .card.err{ border-left-color:#ff3b30; } .card.stale{ border-left-color:#c7c7cc; }\n  .card .row1{ display:flex; align-items:center; gap:8px; }\n  .dot{ width:9px; height:9px; border-radius:50%; background:#c7c7cc; flex:0 0 auto; }\n  .dot.ok{ background:#34c759; } .dot.warn{ background:#ff9500; } .dot.err{ background:#ff3b30; }\n  .card .name{ font-size:16px; font-weight:700; flex:1; }\n  .card .seen{ font-size:11.5px; color:var(--myllm-muted,#8a8a8e); white-space:nowrap; }\n  .src{ font-size:10px; font-weight:750; color:var(--myllm-muted,#8a8a8e); border:1px solid var(--myllm-border,#d1d1d6);\n    border-radius:6px; padding:1px 5px; }\n  .metrics{ display:flex; flex-wrap:wrap; gap:6px; margin-top:9px; }\n  .metric{ background:var(--myllm-bg,#f2f2f7); border-radius:8px; padding:4px 9px; font-size:12.5px; }\n  .metric b{ font-weight:750; } .metric .k{ color:var(--myllm-muted,#8a8a8e); }\n  .errs{ margin-top:8px; }\n  .errs div{ font-size:12px; color:#ff3b30; padding:2px 0 2px 16px; position:relative; }\n  .errs div::before{ content:\"⚠\"; position:absolute; left:0; }\n\n  .empty{ text-align:center; color:var(--myllm-muted,#8a8a8e); padding:40px 16px; }\n  .empty .big{ font-size:40px; margin-bottom:10px; }\n  .empty p{ font-size:14px; line-height:1.5; margin-bottom:16px; }\n\n  .btn{ border:0; border-radius:12px; padding:12px 16px; font-size:15px; font-weight:650;\n    background:var(--myllm-accent,#0a84ff); color:#fff; }\n  .btn.sec{ background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111); }\n  .btn:active{ transform:scale(.97); }\n  .btnrow{ display:flex; gap:8px; flex-wrap:wrap; justify-content:center; }\n\n  /* sheet */\n  .sheet{ position:fixed; inset:0; background:rgba(0,0,0,.35); display:none; align-items:flex-end; justify-content:center; z-index:9; }\n  .sheet.show{ display:flex; }\n  .sheetcard{ background:var(--myllm-surface,#fff); border-radius:20px 20px 0 0; width:100%; max-width:680px;\n    max-height:88dvh; overflow-y:auto; padding:16px 16px calc(20px + env(safe-area-inset-bottom)); }\n  .sheethead{ display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; }\n  .sheethead h2{ font-size:18px; }\n  .sheethead .x{ border:0; background:var(--myllm-bg,#f2f2f7); width:32px; height:32px; border-radius:50%; font-size:15px; }\n  label{ display:block; font-size:12.5px; font-weight:700; color:var(--myllm-muted,#8a8a8e); margin:12px 0 5px; }\n  input,select{ width:100%; font-size:16px; padding:11px 12px; border-radius:11px;\n    border:1px solid var(--myllm-border,#d1d1d6); background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111); }\n  .toggle{ display:flex; align-items:center; justify-content:space-between; margin:14px 0; }\n  .note{ font-size:12.5px; line-height:1.5; color:var(--myllm-muted,#8a8a8e); background:var(--myllm-bg,#f2f2f7);\n    border-radius:12px; padding:11px 13px; margin-top:14px; }\n  .note b{ color:var(--myllm-text,#111); }\n  pre{ background:var(--myllm-bg,#f2f2f7); border-radius:10px; padding:11px; font-size:11.5px; overflow-x:auto;\n    font-family:ui-monospace,Menlo,monospace; white-space:pre-wrap; word-break:break-word; margin-top:6px; }\n  .status-line{ font-size:12.5px; color:var(--myllm-muted,#8a8a8e); margin-top:8px; min-height:16px; }\n  .mon{ display:flex; align-items:center; gap:10px; padding:10px 0; border-bottom:1px solid var(--myllm-border,#e5e5ea); }\n  .mon-i{ flex:1; min-width:0; }\n  .mon-i b{ display:block; font-size:14.5px; }\n  .mon-i span{ display:block; font-size:11.5px; color:var(--myllm-muted,#8a8a8e); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  .mrm{ border:0; background:rgba(255,59,48,.12); color:#ff3b30; border-radius:9px; padding:6px 11px; font-size:12.5px; font-weight:650; }\n</style></head>\n<body>\n\n<!-- Actions the MyLLM assistant can invoke from chat (\"add my greenhouse at http://…\"). -->\n<script type=\"application/myllm-actions\">\n[{\"name\":\"add-monitor\",\n  \"description\":\"Add a URL for Command Center to monitor on the systems dashboard. Use when the user wants MyLLM to keep an eye on a system/service/database that exposes an http(s) endpoint returning JSON.\",\n  \"parameters\":{\"name\":\"a short display name for the system\",\"url\":\"the http(s) URL that returns the system's status as JSON\"}}]\n</script>\n\n<div class=\"top\">\n  <h1>🛰️ Command Center</h1>\n  <button class=\"ib\" onclick=\"openMonitors()\" aria-label=\"Monitors\">🌐</button>\n  <button class=\"ib\" onclick=\"openHistory()\" aria-label=\"History\">🕘</button>\n  <button class=\"ib\" onclick=\"openHelp()\" aria-label=\"How to report\">?</button>\n  <button class=\"ib\" onclick=\"syncNow(true)\" aria-label=\"Sync\">⟳</button>\n  <button class=\"ib\" onclick=\"openSettings()\" aria-label=\"Settings\">⚙</button>\n</div>\n\n<div class=\"summary\" id=\"summary\" style=\"display:none\">\n  <div class=\"stat\"><b id=\"cTotal\">0</b><small>systems</small></div>\n  <div class=\"stat ok\"><b id=\"cOk\">0</b><small>ok</small></div>\n  <div class=\"stat warn\"><b id=\"cWarn\">0</b><small>warn</small></div>\n  <div class=\"stat err\"><b id=\"cErr\">0</b><small>error</small></div>\n</div>\n<div class=\"synced\" id=\"synced\"></div>\n\n<div id=\"cards\"></div>\n\n<div class=\"empty\" id=\"empty\" style=\"display:none\">\n  <div class=\"big\">🛰️</div>\n  <p>No systems are reporting yet.<br>Start with a few real ones — the public status pages for GitHub, Cloudflare, Claude and OpenAI — then ask MyLLM <i>“are any of my systems down?”</i></p>\n  <div class=\"btnrow\">\n    <button class=\"btn\" onclick=\"addPresets()\">Add example monitors</button>\n    <button class=\"btn sec\" onclick=\"openHelp()\">How reporting works</button>\n  </div>\n  <p class=\"note\" style=\"margin-top:12px\">Or point it at your own: anything that returns JSON over http(s). <a href=\"#\" onclick=\"writeDemo();return false;\">Write a demo heartbeat</a> to see the shape.</p>\n</div>\n\n<p class=\"note\" id=\"cardHint\" style=\"display:none; text-align:center; margin:10px 0 0\">\n  Touch and hold a system to remove it.</p>\n\n<!-- History — the record of state changes -->\n<div class=\"sheet\" id=\"history\">\n  <div class=\"sheetcard\">\n    <div class=\"sheethead\"><h2>History</h2><button class=\"x\" onclick=\"closeSheet('history')\">✕</button></div>\n    <p style=\"font-size:13px; line-height:1.5; color:var(--myllm-muted,#8a8a8e)\">\n      Every time a system moves between ok, warn and error it is recorded here — the last 200 changes.\n      Steady systems stay quiet. Ask MyLLM <i>“what changed overnight?”</i> and it reads this too.</p>\n    <div id=\"histList\" style=\"margin:10px 0\"></div>\n  </div>\n</div>\n\n<!-- Remove confirmation — an in-page sheet, since JS dialogs are not allowed here -->\n<div class=\"sheet\" id=\"remove\">\n  <div class=\"sheetcard\">\n    <div class=\"sheethead\"><h2>Remove system</h2><button class=\"x\" onclick=\"closeSheet('remove')\">✕</button></div>\n    <p style=\"font-size:15px; margin:6px 0\"><b id=\"rmName\"></b></p>\n    <p class=\"note\" id=\"rmNote\" style=\"line-height:1.5\"></p>\n    <div class=\"btnrow\" style=\"margin-top:14px\">\n      <button class=\"btn\" onclick=\"confirmRemove()\">Remove</button>\n      <button class=\"btn sec\" onclick=\"closeSheet('remove')\">Cancel</button>\n    </div>\n  </div>\n</div>\n\n<!-- Monitors sheet — the URL collectors -->\n<div class=\"sheet\" id=\"monitors\">\n  <div class=\"sheetcard\">\n    <div class=\"sheethead\"><h2>Monitors</h2><button class=\"x\" onclick=\"closeSheet('monitors')\">✕</button></div>\n    <p style=\"font-size:13px; line-height:1.5; color:var(--myllm-muted,#8a8a8e)\">\n      Each monitor is a URL Command Center polls. It should return JSON — e.g. a small status\n      endpoint in front of a database or service. Top-level numbers/text become metrics.</p>\n    <div id=\"monList\" style=\"margin:10px 0\"></div>\n    <button class=\"btn sec\" style=\"width:100%; margin-bottom:8px\" onclick=\"addPresets()\">Add example monitors (GitHub, Cloudflare, Claude, OpenAI)</button>\n    <button class=\"btn sec\" style=\"width:100%; margin-bottom:12px\" onclick=\"setUpBackgroundPolling()\">Keep polling when the app is closed…</button>\n    <p class=\"note\" style=\"margin:-6px 0 12px\">Monitors are only polled while this app is open. That button drafts a routine for the assistant, which can poll them in the background — you send it.</p>\n\n    <label>Display name</label>\n    <input id=\"mName\" type=\"text\" autocomplete=\"off\" placeholder=\"Greenhouse\">\n    <label>URL (returns JSON)</label>\n    <input id=\"mUrl\" type=\"text\" autocomplete=\"off\" placeholder=\"http://greenhouse.local/status\">\n    <label>Metrics to show (optional, comma-separated keys)</label>\n    <input id=\"mMetrics\" type=\"text\" autocomplete=\"off\" placeholder=\"humidity, temp\">\n    <label>Auth header (optional, kept private to this app)</label>\n    <input id=\"mToken\" type=\"text\" autocomplete=\"off\" placeholder=\"Bearer abc123\">\n    <div class=\"btnrow\" style=\"margin-top:14px; justify-content:flex-start\">\n      <button class=\"btn\" onclick=\"submitMonitor()\">Add monitor</button>\n      <button class=\"btn sec\" onclick=\"pollNow()\">Poll now</button>\n    </div>\n    <div class=\"status-line\" id=\"mStatus\"></div>\n  </div>\n</div>\n\n<!-- Settings sheet -->\n<div class=\"sheet\" id=\"settings\">\n  <div class=\"sheetcard\">\n    <div class=\"sheethead\"><h2>Settings</h2><button class=\"x\" onclick=\"closeSheet('settings')\">✕</button></div>\n\n    <label>Refresh (registry) every</label>\n    <select id=\"refreshSel\" onchange=\"saveCfg()\">\n      <option value=\"3\">3 seconds</option><option value=\"5\" selected>5 seconds</option>\n      <option value=\"15\">15 seconds</option><option value=\"0\">Manual only</option>\n    </select>\n\n    <label>Poll monitors (URLs) every</label>\n    <select id=\"collectSel\" onchange=\"saveCfg()\">\n      <option value=\"0\" selected>Manual only</option><option value=\"60\">1 minute</option>\n      <option value=\"300\">5 minutes</option><option value=\"900\">15 minutes</option>\n    </select>\n\n    <div class=\"note\"><b>Everything runs on your device.</b> Monitors are polled from this phone;\n      nothing is sent anywhere else. A system just needs a URL (on your network or the internet)\n      that returns JSON — add it in 🌐 Monitors.</div>\n  </div>\n</div>\n\n<!-- Help sheet -->\n<div class=\"sheet\" id=\"help\">\n  <div class=\"sheetcard\">\n    <div class=\"sheethead\"><h2>How systems report</h2><button class=\"x\" onclick=\"closeSheet('help')\">✕</button></div>\n    <p style=\"font-size:13.5px; line-height:1.5; color:var(--myllm-muted,#8a8a8e)\">\n      Command Center shows one card per system. A system's state gets in three ways:</p>\n\n    <div class=\"note\" style=\"margin-top:14px\"><b>What it's for</b> — once anything is on the dashboard,\n      the assistant can read it. Try asking MyLLM:\n      <br>· <i>“are any of my systems down?”</i>\n      <br>· <i>“what changed since this morning?”</i>\n      <br>· <i>“monitor the greenhouse at http://greenhouse.local/status”</i>\n      <br>· <i>“if GitHub goes red, tell me”</i> (as a routine)\n      <br>Nothing here leaves the device unless a monitor's URL is remote.</div>\n\n    <div class=\"note\"><b>New here?</b> Tap <b>Add example monitors</b> in 🌐 Monitors to put the public\n      status pages for GitHub, Cloudflare, Claude and OpenAI on the board. They're real, need no\n      account, and give the assistant something true to answer with straight away.</div>\n\n    <div class=\"note\"><b>Removing a system</b> — touch and hold its card. If it came from a URL monitor,\n      the monitor goes with it, otherwise the card would return on the next poll.</div>\n\n    <div class=\"note\"><b>Polling when the app is closed</b> — monitors are only fetched while Command\n      Center is on screen. In 🌐 Monitors, <b>Keep polling when the app is closed</b> drafts a routine for\n      the assistant: it reads the same monitor list from the shared workspace and writes the heartbeats\n      back on a schedule, with nothing open. You review and send it.</div>\n\n    <div class=\"note\"><b>History</b> — 🕘 records every move between ok, warn and error (last 200), so\n      \"was it down overnight?\" and \"how often does this flap?\" have real answers.</div>\n\n    <div class=\"note\" style=\"margin-top:14px\"><b>1. Monitor a URL (the main way)</b> — in 🌐 Monitors, add a\n      URL that returns JSON. Command Center pulls it and turns the top-level fields into metrics. A database\n      or service just needs a small status endpoint in front of it, e.g. <code>GET /status → {\"rows\":1240,\"errors\":0}</code>.\n      You can also just ask MyLLM: <b>\"monitor the greenhouse at http://…\"</b>.</div>\n\n    <div class=\"note\"><b>2. On this device</b> — another MyLLMos app writes straight\n      to the shared file store (private, no network):</div>\n    <pre id=\"exLocal\"></pre>\n\n    <div class=\"note\"><b>Can't reach a system?</b> Give it a URL with a tunnel (Tailscale, Cloudflare\n      Tunnel, ngrok…) and add it as a monitor — that's simpler and stays on-device, unlike routing\n      through a chat service.</div>\n\n    <div class=\"note\"><b>The heartbeat schema</b> (transport-agnostic — same shape however it arrives):\n      <br>• <b>id</b> — unique system name\n      <br>• <b>status</b> — \"ok\" · \"warn\" · \"error\"\n      <br>• <b>metrics</b> — any key→number/text (shown as chips)\n      <br>• <b>errors</b> — optional list of strings\n      <br>The hub stamps the time it arrives.</div>\n  </div>\n</div>\n\n<script>\n/* ---------- bridges (feature-detected, degrade gracefully) ---------- */\nvar files = window.myllmFiles || null;\nvar store = window.myllmStorage || {getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar haptic = function(k){ if(window.myllmHaptic) try{ myllmHaptic(k||'light'); }catch(e){} };\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }\n\nvar REG = \"system/\";                 /* registry folder in the shared store */\nvar STALE_MS = 10*60*1000;           /* no heartbeat in 10 min → \"stale\" */\nvar cfg = { refresh:5, collectInt:0 };\nvar refreshTimer=null, collectTimer=null;\n\n/* ---------- registry (the single source of truth, on-device) ---------- */\nasync function readRegistry(){\n  if(!files) return [];\n  var list;\n  try{ list = await files.list(); }catch(e){ return []; }\n  var out=[];\n  for(var i=0;i<list.length;i++){\n    var p=list[i].path;\n    if(p.indexOf(REG)!==0 || p.slice(-5)!=='.json') continue;\n    if(p.charAt(REG.length)==='_') continue;   /* config files like _collectors.json aren't heartbeats */\n    try{\n      var t=await files.read(p); if(!t) continue;\n      var o=JSON.parse(t);\n      if(o && o.id) out.push(o);\n    }catch(e){}\n  }\n  out.sort(function(a,b){ return (b.ts||0)-(a.ts||0); });\n  return out;\n}\nasync function writeHeartbeat(hb){\n  if(!files) throw new Error(\"Shared files are off (Settings → Allow apps to use shared files).\");\n  hb.ts = hb.ts || Date.now();\n  hb.status = hb.status || \"ok\";\n  var safe = String(hb.id).replace(/[^a-z0-9_-]+/gi,'-').slice(0,48) || 'system';\n  var prev = null;\n  try{ var old = await files.read(REG+safe+\".json\"); if(old) prev = JSON.parse(old).status; }catch(e){}\n  await files.write(REG+safe+\".json\", JSON.stringify(hb));\n  if(prev !== hb.status) await recordChange(hb, prev);\n}\n\n/* ---------- history ----------\n   Each heartbeat overwrites the last, so nothing could answer \"was it down\n   overnight?\" or \"how often does this flap?\" — the state was always only ever\n   NOW. This keeps a small append-only log of TRANSITIONS (not every poll, which\n   would be almost entirely noise) that the assistant can read straight out of\n   the shared workspace.\n\n   Named with a leading underscore and a .jsonl extension so readRegistry skips\n   it twice over — it is a log, not a system. */\nvar HISTORY = \"system/_history.jsonl\";\nvar HISTORY_MAX = 200;\n\nasync function recordChange(hb, prevStatus){\n  if(!files) return;\n  var line = JSON.stringify({\n    ts: hb.ts,\n    id: hb.id,\n    name: hb.name || hb.id,\n    from: prevStatus || 'new',\n    to: hb.status,\n    errors: (hb.errors && hb.errors.length) ? hb.errors.slice(0,2) : undefined\n  });\n  var existing = '';\n  try{ existing = (await files.read(HISTORY)) || ''; }catch(e){}\n  var lines = existing ? existing.split('\\n').filter(Boolean) : [];\n  lines.push(line);\n  if(lines.length > HISTORY_MAX) lines = lines.slice(lines.length - HISTORY_MAX);\n  try{ await files.write(HISTORY, lines.join('\\n')); }catch(e){}\n}\n\nasync function readHistory(){\n  if(!files) return [];\n  var t=''; try{ t = (await files.read(HISTORY)) || ''; }catch(e){ return []; }\n  return t.split('\\n').filter(Boolean).map(function(l){\n    try{ return JSON.parse(l); }catch(e){ return null; }\n  }).filter(Boolean).reverse();\n}\n\nasync function renderHistory(){\n  var h = await readHistory();\n  el('histList').innerHTML = h.length ? h.slice(0,60).map(function(e){\n    var cls = e.to==='error'?'err':(e.to==='warn'?'warn':'ok');\n    return '<div class=\"mon\"><div class=\"mon-i\"><b>'+esc(e.name)+'</b>'\n      + '<span>'+esc(e.from)+' → '+esc(e.to)+(e.errors&&e.errors.length?' · '+esc(e.errors[0]):'')+'</span></div>'\n      + '<span class=\"seen\" style=\"white-space:nowrap\"><span class=\"dot '+cls+'\"></span> '+rel(e.ts)+'</span></div>';\n  }).join('') : '<p class=\"note\">Nothing yet. Changes are recorded when a system moves between ok, warn and error — steady systems stay quiet.</p>';\n}\nasync function openHistory(){ await renderHistory(); el('history').classList.add('show'); }\n\n/* ---------- render ---------- */\nfunction rel(ts){\n  if(!ts) return '';\n  var s=Math.max(0,Math.round((Date.now()-ts)/1000));\n  if(s<60) return s+'s ago'; if(s<3600) return Math.round(s/60)+'m ago';\n  if(s<86400) return Math.round(s/3600)+'h ago'; return Math.round(s/86400)+'d ago';\n}\nfunction effectiveStatus(hb){\n  if(Date.now()-(hb.ts||0) > STALE_MS) return 'stale';\n  return (hb.status==='error'||hb.status==='err')?'err':(hb.status==='warn')?'warn':'ok';\n}\nasync function render(){\n  var items = await readRegistry();\n  var counts={ok:0,warn:0,err:0};\n  items.forEach(function(h){ var s=effectiveStatus(h); if(s==='ok')counts.ok++; else if(s==='warn')counts.warn++; else if(s==='err')counts.err++; });\n  el('summary').style.display = items.length? 'flex':'none';\n  el('empty').style.display = items.length? 'none':'block';\n  el('cTotal').textContent=items.length; el('cOk').textContent=counts.ok; el('cWarn').textContent=counts.warn; el('cErr').textContent=counts.err;\n\n  el('cards').innerHTML = items.map(function(h){\n    var s=effectiveStatus(h);\n    var metrics = h.metrics && typeof h.metrics==='object'\n      ? Object.keys(h.metrics).map(function(k){ return '<span class=\"metric\"><span class=\"k\">'+esc(k)+'</span> <b>'+esc(h.metrics[k])+'</b></span>'; }).join('') : '';\n    var errs = (h.errors&&h.errors.length)\n      ? '<div class=\"errs\">'+h.errors.slice(0,4).map(function(e){return '<div>'+esc(e)+'</div>';}).join('')+'</div>' : '';\n    return '<div class=\"card '+s+'\" data-sys=\"'+esc(h.id)+'\" data-name=\"'+esc(h.name||h.id)+'\"><div class=\"row1\"><span class=\"dot '+s+'\"></span>'\n      + '<span class=\"name\">'+esc(h.name||h.id)+'</span>'\n      + (h.source? '<span class=\"src\">'+esc(h.source)+'</span>':'')\n      + '<span class=\"seen\">'+(s==='stale'?'stale · ':'')+rel(h.ts)+'</span></div>'\n      + (metrics? '<div class=\"metrics\">'+metrics+'</div>':'') + errs + '</div>';\n  }).join('');\n  el('cardHint').style.display = items.length ? 'block' : 'none';\n  bindLongPress();\n  publishTile(items.length, counts);\n}\n\n/* Put the summary on this app's own springboard tile, so \"is anything wrong?\"\n   is answered without opening anything. Errors outrank warnings outrank ok —\n   the tile has room for one fact and it should be the worst one. */\nfunction publishTile(total, counts){\n  if(!window.myllmWidget) return;\n  if(!total){ myllmWidget.clear(); return; }\n  var value, label;\n  if(counts.err){ value = String(counts.err); label = counts.err===1 ? 'system down' : 'systems down'; }\n  else if(counts.warn){ value = String(counts.warn); label = 'needs a look'; }\n  else { value = String(counts.ok); label = counts.ok===1 ? 'system ok' : 'all ok'; }\n  myllmWidget.publish({ value: value, label: label });\n}\n\n/* ---------- removing a system from the dashboard ----------\n   Cards come from heartbeat FILES, which is why this was missing: only URL\n   monitors had a Remove button, so anything that wrote its own heartbeat — the\n   demo reporter, another MyLLMos app, the assistant via write_shared_file — had\n   no way off the dashboard at all.\n\n   Long-press is the gesture, but never the only affordance: a hint line sits\n   under the cards, because a removal that exists only as an undiscoverable\n   long-press may as well not exist. The web view forbids native JS dialogs, so\n   the confirmation is an in-page sheet. */\nvar pendingRemove = null;\nfunction bindLongPress(){\n  var cards = document.querySelectorAll('#cards .card');\n  Array.prototype.forEach.call(cards, function(card){\n    var timer = null, moved = false;\n    function start(){\n      moved = false;\n      timer = setTimeout(function(){\n        if(moved) return;\n        haptic('impact');\n        askRemove(card.getAttribute('data-sys'), card.getAttribute('data-name'));\n      }, 500);\n    }\n    function cancel(){ if(timer){ clearTimeout(timer); timer=null; } }\n    card.addEventListener('touchstart', start, {passive:true});\n    card.addEventListener('touchmove', function(){ moved = true; cancel(); }, {passive:true});\n    card.addEventListener('touchend', cancel);\n    card.addEventListener('touchcancel', cancel);\n    /* Mouse equivalent so the same code is testable in a desktop preview. */\n    card.addEventListener('mousedown', start);\n    card.addEventListener('mouseup', cancel);\n    card.addEventListener('mouseleave', cancel);\n  });\n}\n\nasync function askRemove(id, name){\n  pendingRemove = id;\n  el('rmName').textContent = name || id;\n  /* A polled monitor would simply reappear on the next poll, so say plainly\n     that removing the card also stops the monitor. */\n  var isMonitor = (await readCollectors()).some(function(c){ return c.id===id; });\n  el('rmNote').textContent = isMonitor\n    ? 'This system is polled from a URL, so its monitor will be removed too — otherwise the card would come straight back.'\n    : 'Its heartbeat file is deleted from the shared registry. If whatever wrote it reports again, it will reappear.';\n  el('remove').classList.add('show');\n}\n\nasync function confirmRemove(){\n  var id = pendingRemove; pendingRemove = null;\n  closeSheet('remove');\n  if(!id) return;\n  await removeMonitor(id);          /* drops the collector AND the heartbeat file */\n  haptic('success');\n  await render();\n}\n\n/* ---------- collectors: URLs the hub polls (the main intake) ----------\n   Config lives in the SHARED store (system/_collectors.json) so the MyLLM\n   assistant can add a monitor too; auth tokens stay PRIVATE (per-app storage). */\nvar COLLECTORS = \"system/_collectors.json\";\nasync function readCollectors(){ try{ return JSON.parse((files && await files.read(COLLECTORS))||'[]'); }catch(e){ return []; } }\nasync function writeCollectors(list){ if(files) await files.write(COLLECTORS, JSON.stringify(list)); }\nasync function authMap(){ try{ return JSON.parse(await store.getItem('cc_auth')||'{}'); }catch(e){ return {}; } }\n\n/* Read \"status.indicator\" style dot-paths. The original collector only looked\n   at TOP-LEVEL keys, which is fine for a status endpoint you wrote yourself and\n   useless for almost every real one — an Atlassian status page (GitHub,\n   Cloudflare, Claude, OpenAI, and most SaaS) nests everything under `status`,\n   so every such monitor reported a cheerful green no matter what was on fire. */\nfunction getPath(obj, path){\n  return String(path||'').split('.').reduce(function(o,k){\n    return (o && typeof o==='object' && k in o) ? o[k] : undefined;\n  }, obj);\n}\n\n/* Poll one URL → write a heartbeat. Failure becomes an \"error\" heartbeat so the\n   card turns red rather than silently vanishing. */\nasync function collectOne(c){\n  var headers = {};\n  var auth = await authMap(); if(auth[c.id]) headers.Authorization = auth[c.id];\n  try{\n    if(!window.myllmFetch) throw new Error(\"internet is off for apps\");\n    var r = await myllmFetch(c.url, { headers: headers });\n    if(!r.ok) throw new Error(\"HTTP \"+r.status);\n    var data = JSON.parse(r.body);\n    var metrics = {};\n    var keys = (c.metrics && c.metrics.length) ? c.metrics\n      : Object.keys(data).filter(function(k){ var t=typeof data[k]; return t==='number'||t==='string'||t==='boolean'; }).slice(0,8);\n    keys.forEach(function(k){ if(k in data) metrics[k]=data[k]; });\n    /* Explicit metric paths win over the top-level scrape. */\n    if(c.metricPaths){\n      metrics = {};\n      Object.keys(c.metricPaths).forEach(function(label){\n        var v = getPath(data, c.metricPaths[label]);\n        if(v !== undefined && typeof v !== 'object') metrics[label] = v;\n      });\n    }\n    var st = c.statusPath ? getPath(data, c.statusPath) : data.status;\n    if(c.statusMap && st != null && (String(st) in c.statusMap)) st = c.statusMap[String(st)];\n    st = (st==='warn'||st==='error'||st==='ok') ? st : 'ok';\n    await writeHeartbeat({ id:c.id, name:c.name||c.id, status:st, metrics:metrics, errors:(data.errors||[]), source:'url' });\n    return true;\n  }catch(e){\n    await writeHeartbeat({ id:c.id, name:c.name||c.id, status:'error', metrics:{}, errors:[String(e.message||e)], source:'url' });\n    return false;\n  }\n}\nasync function collectAll(){ var list=await readCollectors(); for(var i=0;i<list.length;i++){ await collectOne(list[i]); } return list.length; }\n\n/* Add a monitor — used by the UI AND by the assistant's add-monitor action. */\nasync function addMonitor(name, url, metrics, token, extra){\n  url = String(url||'').trim();\n  if(!/^https?:\\/\\//i.test(url)) throw new Error(\"URL must start with http:// or https://\");\n  name = String(name||'').trim() || url;\n  var id = (name.toLowerCase().replace(/[^a-z0-9_-]+/g,'-').replace(/^-+|-+$/g,'').slice(0,40)) || ('mon-'+Date.now());\n  var list = (await readCollectors()).filter(function(c){ return c.id!==id; });\n  var c = { id:id, name:name, url:url };\n  if(metrics && metrics.length) c.metrics = metrics;\n  /* Optional shape mapping (used by the starter monitors); absent for a\n     hand-added or assistant-added URL, which behaves exactly as before. */\n  if(extra && extra.statusPath)  c.statusPath  = extra.statusPath;\n  if(extra && extra.statusMap)   c.statusMap   = extra.statusMap;\n  if(extra && extra.metricPaths) c.metricPaths = extra.metricPaths;\n  list.push(c);\n  await writeCollectors(list);\n  if(token){ var a=await authMap(); a[id]=token; await store.setItem('cc_auth', JSON.stringify(a)); }\n  await collectOne(c);   /* immediate first reading */\n  return id;\n}\n/* ---------- starter monitors ----------\n   The honest answer to \"what is this app for?\". A dashboard with nothing on it\n   teaches nothing, and the only thing it previously offered a new user was a\n   fake \"Demo Reporter\" — which then could not be removed.\n\n   These are real, public, no-auth status pages for services this app's users\n   actually depend on, and they make `system_status` immediately worth asking\n   about: \"are any of my systems down?\" returns something true on day one. */\nvar STATUSPAGE = {\n  statusPath: 'status.indicator',\n  statusMap: { none:'ok', minor:'warn', major:'error', critical:'error', maintenance:'warn' },\n  metricPaths: { state: 'status.description' }\n};\nvar PRESETS = [\n  { name:'GitHub',     url:'https://www.githubstatus.com/api/v2/status.json' },\n  { name:'Cloudflare', url:'https://www.cloudflarestatus.com/api/v2/status.json' },\n  { name:'Claude',     url:'https://status.claude.com/api/v2/status.json' },\n  { name:'OpenAI',     url:'https://status.openai.com/api/v2/status.json' }\n];\n\nasync function addPresets(){\n  if(!window.myllmFetch){\n    el('mStatus').textContent = '✗ Internet is off for apps — turn it on in MyLLMos settings to poll status pages.';\n    haptic('error');\n    return;\n  }\n  el('mStatus').textContent = 'Adding example monitors…';\n  var added = 0;\n  for(var i=0;i<PRESETS.length;i++){\n    try{ await addMonitor(PRESETS[i].name, PRESETS[i].url, null, null, STATUSPAGE); added++; }\n    catch(e){ /* keep going: one unreachable service shouldn't block the rest */ }\n  }\n  el('mStatus').textContent = 'Added '+added+' example monitor(s) and polled once.';\n  haptic('success');\n  await renderMonitors(); await render();\n}\n\nasync function removeMonitor(id){\n  await writeCollectors((await readCollectors()).filter(function(c){ return c.id!==id; }));\n  try{ if(files) await files.remove(REG+id+\".json\"); }catch(e){}   /* drop its card */\n}\n\nasync function renderMonitors(){\n  var list = await readCollectors();\n  el('monList').innerHTML = list.length ? list.map(function(c){\n    return '<div class=\"mon\"><div class=\"mon-i\"><b>'+esc(c.name)+'</b><span>'+esc(c.url)+'</span></div>'\n      + '<button class=\"mrm\" onclick=\"removeMon(\\''+c.id+'\\')\">Remove</button></div>';\n  }).join('') : '<p class=\"note\">No monitors yet. Add a URL below that returns JSON — e.g. a small status endpoint in front of your database or service. The assistant can add one too: just ask MyLLM to \"monitor &lt;name&gt; at &lt;url&gt;\".</p>';\n}\nasync function openMonitors(){ await renderMonitors(); el('monitors').classList.add('show'); }\nasync function submitMonitor(){\n  var metrics = el('mMetrics').value.split(',').map(function(s){return s.trim();}).filter(Boolean);\n  el('mStatus').textContent='Adding…';\n  try{\n    await addMonitor(el('mName').value, el('mUrl').value, metrics, el('mToken').value.trim());\n    el('mName').value=el('mUrl').value=el('mMetrics').value=el('mToken').value='';\n    el('mStatus').textContent='Added and polled once.'; haptic('success');\n    await renderMonitors(); await render();\n  }catch(e){ el('mStatus').textContent='✗ '+e.message; haptic('error'); }\n}\nfunction removeMon(id){ removeMonitor(id).then(function(){ renderMonitors(); render(); haptic('selection'); }); }\n/* ---------- background polling ----------\n   The app can only poll while it is on screen: setInterval stops the moment the\n   web view goes away, so this was a dashboard that refreshed when you looked at\n   it and never otherwise. An app action cannot fix that either — those need the\n   app open, by design.\n\n   The assistant can. The collector list lives in the SHARED workspace, so a\n   routine can read it, fetch each URL and write the heartbeats back with no app\n   running at all. This drafts exactly that request; the user presses send. */\nfunction backgroundPollPrompt(){\n  return 'Every hour, read the JSON list of monitors at system/_collectors.json in my '\n    + 'shared workspace. For each entry, fetch its \"url\", then write the result to '\n    + 'system/<id>.json as {\"id\",\"name\",\"status\",\"metrics\",\"ts\",\"source\":\"routine\"} where '\n    + 'status is \"ok\", \"warn\" or \"error\" — use \"error\" if the request fails, and put the '\n    + 'reason in an \"errors\" array. Set ts to the current time in milliseconds. '\n    + 'Do not report back unless something is in error.';\n}\n\nfunction setUpBackgroundPolling(){\n  if(!window.myllmChat){\n    el('mStatus').textContent = 'Ask MyLLM in chat: “poll the monitors in system/_collectors.json every hour and write the results back to system/”.';\n    return;\n  }\n  window.myllmChat.compose(backgroundPollPrompt());\n  haptic('success');\n}\n\nasync function pollNow(){ el('mStatus').textContent='Polling…'; var n=await collectAll(); el('mStatus').textContent='Polled '+n+' monitor(s).'; await render(); }\n\n/* ---------- actions ---------- */\nasync function syncNow(user){\n  haptic('light');\n  var msg='';\n  try{ var n=await collectAll(); if(n) msg += n+' monitor'+(n>1?'s':'')+' polled · '; }catch(e){ msg+='monitors: '+e.message+' · '; }\n  await render();\n  el('synced').textContent = msg + 'updated '+new Date().toLocaleTimeString();\n}\n\nasync function writeDemo(){\n  haptic('success');\n  await writeHeartbeat({ id:'command-center-demo', name:'Demo Reporter', status:'ok',\n    source:'local', metrics:{ uptime:'just now', reports:1 }, errors:[] });\n  await render();\n  el('synced').textContent='Wrote a demo heartbeat to the registry.';\n}\n\n/* ---------- settings persistence ---------- */\nasync function loadCfg(){\n  try{ var c=JSON.parse(await store.getItem('cc_cfg')||'{}'); Object.assign(cfg,c); }catch(e){}\n  el('refreshSel').value=String(cfg.refresh); el('collectSel').value=String(cfg.collectInt||0);\n}\nfunction saveCfg(){\n  cfg.refresh=parseInt(el('refreshSel').value,10); cfg.collectInt=parseInt(el('collectSel').value,10);\n  store.setItem('cc_cfg', JSON.stringify(cfg));\n  scheduleTimers();\n}\nfunction scheduleTimers(){\n  if(refreshTimer) clearInterval(refreshTimer); refreshTimer=null;\n  if(cfg.refresh>0) refreshTimer=setInterval(render, cfg.refresh*1000);\n  if(collectTimer) clearInterval(collectTimer); collectTimer=null;\n  if(cfg.collectInt>0) collectTimer=setInterval(function(){ collectAll().then(render); }, cfg.collectInt*1000);\n}\nfunction openSettings(){ el('settings').classList.add('show'); }\nfunction openHelp(){ el('help').classList.add('show'); }\nfunction closeSheet(id){ el(id).classList.remove('show'); }\n\n/* ---------- help examples ---------- */\nel('exLocal').textContent =\n'await myllmFiles.write(\"system/greenhouse.json\",\\n'+\n'  JSON.stringify({ id:\"greenhouse\", name:\"Greenhouse\",\\n'+\n'    status:\"ok\", metrics:{ humidity:62, temp:24 }, errors:[] }));';\n\n/* ---------- boot ---------- */\n/* The assistant can add a monitor from chat via the add-monitor action. */\nif(window.myllmIntent && myllmIntent.receive){\n  myllmIntent.receive(function(intent){\n    if(intent && intent.action==='add-monitor' && intent.data && intent.data.url){\n      addMonitor(intent.data.name, intent.data.url).then(function(){\n        renderMonitors(); render(); openMonitors();\n      }).catch(function(){});\n    }\n  });\n}\n\n(async function(){\n  await loadCfg();\n  scheduleTimers();\n  await render();\n  var hasMon = (await readCollectors()).length > 0;\n  if(hasMon) syncNow(false);   /* pull monitors once on open */\n})();\n</script>\n</body></html>\n"}