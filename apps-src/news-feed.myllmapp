{"name": "News", "html": "<!doctype html>\n<!--\n  News — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>News</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--h:4;--build-id:\"c14294ef8c\";color-scheme:light dark;\n  --accent:var(--myllm-accent,#ff453a);\n  --bg:var(--myllm-bg,#f2f2f7); --card:var(--myllm-surface,#fff);\n  --fg:var(--myllm-text,#111); --dim:var(--myllm-muted,#6b6b70);\n  --line:var(--myllm-border,rgba(128,128,128,.22)); --r:var(--myllm-radius,13px);\n  --read:17px}\n@media(prefers-color-scheme:dark){:root{--bg:var(--myllm-bg,#000);--card:var(--myllm-surface,#1c1c1e);--fg:var(--myllm-text,#eee);--dim:var(--myllm-muted,#98989f)}}\n*{box-sizing:border-box}\nbody{font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);margin:0;background:var(--bg);color:var(--fg);\n     -webkit-text-size-adjust:100%}\n/* phone on its side: keep clear of the notch and the rounded corners */\nbody{padding-left:env(safe-area-inset-left);padding-right:env(safe-area-inset-right)}\n#reader{padding-left:env(safe-area-inset-left);padding-right:env(safe-area-inset-right)}\nbutton{font:inherit;color:inherit}\n\n/* ---------- the list ---------- */\n.stick{position:sticky;top:0;background:color-mix(in srgb,var(--bg) 92%,transparent);\n      backdrop-filter:saturate(180%) blur(12px);padding:8px 16px 0;z-index:5}\n.hrow{display:flex;align-items:center;gap:10px}\nh1{font-size:20px;margin:0 0 8px;flex:1}\n.icon{border:0;background:none;padding:6px;border-radius:9px;opacity:.75;font-size:17px;line-height:1;min-width:40px;min-height:40px;display:inline-flex;align-items:center;justify-content:center;color:inherit}\n.icon svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}\n.tabs{display:flex;gap:4px;overflow-x:auto;padding:0 16px 10px;margin:0 -16px}\n.tab{flex:none;padding:7px 14px;border-radius:18px;background:none;color:var(--dim);font-size:14px;font-weight:600;border:0;white-space:nowrap}\n.tab.on{background:var(--accent);color:#fff}\n.wrap{padding:6px 16px calc(24px + env(safe-area-inset-bottom))}\n.item{background:var(--card);border-radius:var(--r);padding:13px 15px;margin-bottom:9px;\n      box-shadow:0 1px 3px rgba(0,0,0,.07);display:flex;gap:12px;align-items:flex-start;width:100%;text-align:left;border:0}\n.item .body{flex:1;min-width:0}\n.title{font-size:16px;font-weight:600;line-height:1.32}\n.meta{font-size:12px;color:var(--dim);margin-top:5px;display:flex;gap:6px;flex-wrap:wrap}\n.src{font-weight:600;color:var(--accent)}\n.blurb{font-size:14px;color:var(--dim);margin-top:6px;line-height:1.4;\n       display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}\n.thumb{width:76px;height:76px;border-radius:10px;object-fit:cover;flex:none;background:var(--line)}\n#status{padding:18px 16px;font-size:14px;color:var(--dim);text-align:center}\n\n/* ---------- the reader ---------- */\n#reader{display:none;position:fixed;inset:0;background:var(--bg);z-index:20;overflow:auto;-webkit-overflow-scrolling:touch}\n#reader.on{display:block}\n.rbar{position:sticky;top:0;display:flex;align-items:center;gap:4px;padding:calc(8px + env(safe-area-inset-top)) 10px 8px;\n      background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:saturate(180%) blur(12px);border-bottom:1px solid var(--line);z-index:2}\n.rbar .site{flex:1;min-width:0;font-size:13px;font-weight:600;color:var(--dim);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.art{padding:14px 20px calc(40px + env(safe-area-inset-bottom));max-width:700px;margin:0 auto}\n.art h2{font-size:26px;line-height:1.22;margin:6px 0 10px;letter-spacing:-.01em}\n.byline{font-size:13px;color:var(--dim);margin-bottom:16px;line-height:1.5}\n.art figure{margin:18px 0}\n.art img{width:100%;border-radius:10px;display:block;background:var(--line)}\n.art figcaption{font-size:12.5px;color:var(--dim);margin-top:7px;line-height:1.4}\n.art p{font-size:var(--read);line-height:1.62;margin:0 0 1.05em}\n.art h3{font-size:calc(var(--read) + 3px);line-height:1.3;margin:1.5em 0 .5em}\n.art ul,.art ol{font-size:var(--read);line-height:1.6;padding-left:1.3em;margin:0 0 1.05em}\n.art li{margin-bottom:.4em}\n.art blockquote{margin:1.2em 0;padding-left:14px;border-left:3px solid var(--accent);color:var(--dim);font-size:var(--read)}\n.art pre{background:var(--card);padding:12px;border-radius:9px;overflow-x:auto;font-size:14px}\n.art a{color:var(--accent)}\n.note{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:13px 15px;margin:4px 0 18px;\n      font-size:14px;line-height:1.5;color:var(--dim)}\n/* .art a is (0,1,1) and would out-specify a bare .open — which paints this\n   label in the accent colour ON the accent colour. Match the specificity. */\n.art a.open{display:block;text-align:center;background:var(--accent);color:#fff;text-decoration:none;font-weight:600;\n      padding:14px;border-radius:var(--r);margin-top:26px}\n.skel{height:13px;border-radius:7px;background:var(--line);margin-bottom:11px;animation:pulse 1.3s ease-in-out infinite}\n@keyframes pulse{0%,100%{opacity:.45}50%{opacity:.8}}\n\n/* ---------- manage feeds ---------- */\n.manage{padding:0 16px 24px}\n.manage h2{font-size:13px;text-transform:uppercase;letter-spacing:.05em;color:var(--dim)}\n.row{display:flex;gap:8px}\ninput{flex:1;padding:10px;border:1px solid var(--line);border-radius:9px;font-size:15px;background:var(--card);color:var(--fg)}\n.row button{border:0;background:var(--accent);color:#fff;border-radius:9px;padding:0 16px;font-weight:600}\n.feedrow{display:flex;align-items:center;gap:8px;padding:9px 0;font-size:14px;border-top:1px solid var(--line)}\n.feedrow .u{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--dim)}\n.feedrow .x{color:var(--accent);font-size:16px;border:0;background:none}\n@media(min-width:768px){.wrap,.head,.stick{max-width:760px;margin-left:auto;margin-right:auto}}\n/* The header every gallery home screen shares: hue tile, name, one line, actions. */\n.head{display:flex;align-items:center;gap:12px;margin:2px 2px 14px}\n.head .tile{display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0;width:44px;height:44px;border-radius:13px;background:linear-gradient(145deg,hsl(var(--h) 62% 50%),hsl(calc(var(--h) + 40) 58% 28%))}\n.head .tile svg{width:24px;height:24px}\n.head .ht{flex:1;min-width:0}\n.head h1{font-size:22px;font-weight:800;letter-spacing:-.01em;line-height:1.2;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.head p{font-size:13px;color:var(--dim);margin:1px 0 0;line-height:1.35}\n.head .acts{display:flex;gap:8px;flex-shrink:0;align-items:center;padding:0}\n.head .acts>button{min-width:40px;height:40px;display:inline-flex;align-items:center;justify-content:center;gap:6px;flex:none}\n.head .acts svg{width:19px;height:19px}\n.head{margin:0 auto;padding:calc(14px + env(safe-area-inset-top)) 18px 2px}\n.head .acts .icon svg{fill:none}\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style></head><body>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M4 4.5A1.5 1.5 0 0 1 5.5 3h10A1.5 1.5 0 0 1 17 4.5V8h2.5A1.5 1.5 0 0 1 21 9.5V18a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3zM17 10v8a1 1 0 0 0 2 0v-8zM7 6.5a.75.75 0 0 0 0 1.5h7a.75.75 0 0 0 0-1.5zm0 4a.75.75 0 0 0-.75.75v3.5c0 .4.35.75.75.75h3.5c.4 0 .75-.35.75-.75v-3.5a.75.75 0 0 0-.75-.75zm6.25 0a.75.75 0 0 0 0 1.5H14a.75.75 0 0 0 0-1.5zm0 3.5a.75.75 0 0 0 0 1.5H14a.75.75 0 0 0 0-1.5zM7 17a.75.75 0 0 0 0 1.5h7a.75.75 0 0 0 0-1.5z\"/></svg></div>\n  <div class=\"ht\"><h1>News</h1><p>Headlines, and the whole story</p></div>\n  <div class=\"acts\"><button class=\"icon\" id=\"refresh\" aria-label=\"Refresh\"><svg viewBox=\"0 0 24 24\"><path d=\"M20 12a8 8 0 1 1-2.6-5.9\"/><path d=\"M20 4v5h-5\"/></svg></button></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close News\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n<div class=\"stick\">\n  <div class=\"tabs\" id=\"tabs\"></div>\n</div>\n<div id=\"status\"></div>\n<div class=\"wrap\" id=\"wrap\"></div>\n\n<div id=\"reader\" aria-hidden=\"true\">\n  <div class=\"rbar\">\n    <button class=\"icon\" id=\"back\" aria-label=\"Back\">‹</button>\n    <span class=\"site\" id=\"rsite\"></span>\n    <button class=\"icon\" id=\"smaller\" aria-label=\"Smaller text\">A−</button>\n    <button class=\"icon\" id=\"bigger\" aria-label=\"Larger text\">A+</button>\n    <button class=\"icon\" id=\"share\" aria-label=\"Share\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3v12\"/><path d=\"M8 7l4-4 4 4\"/><path d=\"M7 11H6a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-8a1 1 0 0 0-1-1h-1\"/></svg></button>\n  </div>\n  <div class=\"art\" id=\"art\"></div>\n</div>\n\n<script>\n/* News — a feed reader that can also READ the article.\n\n   The list is RSS. The reader is the article's own page, fetched through\n   myllmFetch and reduced to prose here on the device: no reader service in the\n   middle, nothing about what you read leaves the phone. Where a site refuses\n   (plenty do — Reuters, Sky and AP all 403 a non-browser regardless of what\n   user agent it claims) the app says so plainly and offers the original. */\n\nvar TOPICS=[\n  {name:\"Top\",url:\"https://feeds.bbci.co.uk/news/rss.xml\"},\n  {name:\"World\",url:\"https://feeds.bbci.co.uk/news/world/rss.xml\"},\n  {name:\"UK\",url:\"https://feeds.bbci.co.uk/news/uk/rss.xml\"},\n  {name:\"Tech\",url:\"https://feeds.bbci.co.uk/news/technology/rss.xml\"},\n  {name:\"Business\",url:\"https://feeds.bbci.co.uk/news/business/rss.xml\"},\n  {name:\"Science\",url:\"https://feeds.bbci.co.uk/news/science_and_environment/rss.xml\"},\n  {name:\"Sport\",url:\"https://feeds.bbci.co.uk/sport/rss.xml\"}\n];\n/* Looked up on each use, never kept: MyLLM can add its bridges after this script has run. */\nvar store={getItem:function(k){var s=window.myllmStorage;return s?s.getItem(k):Promise.resolve(null)},setItem:function(k,v){var s=window.myllmStorage;return s?s.setItem(k,v):Promise.resolve()}};\nvar custom=[],active=0,feedCache={},artCache={},readSize=17;\nvar CACHE_MS=5*60*1000;\n\nfunction el(id){return document.getElementById(id)}\nfunction setStatus(t){var s=el('status');s.style.display=t?'block':'none';s.textContent=t||''}\nfunction tabs(){return TOPICS.concat(custom).concat([{name:\"＋ Feeds\",manage:true}])}\nfunction haptic(k){try{window.myllmHaptic&&myllmHaptic(k)}catch(e){}}\nfunction esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;')}\nfunction host(u){try{return new URL(u).hostname.replace(/^www\\./,'')}catch(e){return''}}\n\n/* ============================ the list ============================ */\n\nfunction renderTabs(){\n  var T=el('tabs');T.innerHTML='';\n  tabs().forEach(function(t,i){\n    var b=document.createElement('button');b.className='tab'+(i===active?' on':'');b.textContent=t.name;\n    b.onclick=function(){active=i;route()};T.appendChild(b);\n  });\n}\nfunction route(){\n  renderTabs();\n  var t=tabs()[active];\n  if(t.manage)return renderManage();\n  load(t.url,t.name);\n}\n\nfunction load(url,label,force){\n  el('wrap').innerHTML='';\n  var hit=feedCache[url];\n  if(hit&&!force&&(Date.now()-hit.at)<CACHE_MS){setStatus('');renderItems(hit.items,label);return}\n  if(!window.myllmFetch){setStatus('This app needs network access — update MyLLM and enable app network access in Settings.');return}\n  setStatus('Loading…');\n  myllmFetch(url,{headers:{Accept:'application/rss+xml,application/xml,text/xml'}})\n  .then(function(r){\n    if(!r||!r.ok)throw new Error('feed returned '+((r&&r.status)||'no response'));\n    var items=parseFeed(r.body,url);\n    if(!items.length)throw new Error('no stories found in this feed');\n    feedCache[url]={items:items,at:Date.now()};setStatus('');renderItems(items,label);\n  }).catch(function(err){setStatus('Couldn’t load this feed: '+err.message)});\n}\n\nfunction parseFeed(xml,feedUrl){\n  var doc=new DOMParser().parseFromString(xml,'text/xml');\n  var nodes=doc.querySelectorAll('item'),atom=false;\n  if(!nodes.length){nodes=doc.querySelectorAll('entry');atom=true}\n  var out=[];\n  Array.prototype.forEach.call(nodes,function(n){\n    var get=function(tag){var e=n.querySelector(tag);return e?e.textContent.trim():''};\n    var link=get('link');\n    if(atom){var l=n.querySelector('link');if(l&&l.getAttribute('href'))link=l.getAttribute('href')}\n    var desc=get('description')||get('summary')||get('content');\n    /* content:encoded carries the WHOLE article on many feeds (WordPress,\n       Substack), which saves the reader a fetch — and works on sites that\n       would refuse one. querySelector can't take the namespaced name, so go\n       through the tag list. */\n    var full='';\n    Array.prototype.forEach.call(n.children,function(c){\n      var nm=(c.tagName||'').toLowerCase();\n      if(nm==='content:encoded'||nm==='encoded')full=c.textContent||'';\n    });\n    out.push({\n      title:get('title'),link:link,\n      date:get('pubDate')||get('updated')||get('published'),\n      desc:strip(desc),full:full,\n      image:feedImage(n,desc),\n      source:sourceName(n,feedUrl,link)\n    });\n  });\n  return out.filter(function(i){return i.title});\n}\n\n/* Feeds hide their picture in one of four places depending on who built them. */\nfunction feedImage(n,desc){\n  var pick=['media\\\\:thumbnail','media\\\\:content','enclosure','thumbnail'];\n  for(var i=0;i<pick.length;i++){\n    var e=null;\n    Array.prototype.forEach.call(n.children,function(c){\n      if(e)return;\n      var nm=(c.tagName||'').toLowerCase();\n      if(nm===pick[i].replace('\\\\','')||nm===pick[i].split('\\\\:').pop())e=c;\n    });\n    if(e){\n      var u=e.getAttribute('url')||e.getAttribute('href')||'';\n      var ty=e.getAttribute('type')||'';\n      if(u&&(!ty||/image/i.test(ty)))return u;\n    }\n  }\n  var m=/<img[^>]+src=[\"']([^\"']+)[\"']/i.exec(desc||'');\n  return m?m[1]:'';\n}\nfunction sourceName(n,feedUrl,link){\n  var s=n.querySelector('source');\n  if(s&&s.textContent.trim())return s.textContent.trim();\n  return host(link)||host(feedUrl);\n}\n\nfunction strip(html){var d=document.createElement('div');d.innerHTML=html;var t=(d.textContent||'').replace(/\\s+/g,' ').trim();return t.length>300?t.slice(0,300)+'…':t}\nfunction ago(d){\n  if(!d)return'';var t=new Date(d);if(isNaN(t))return'';\n  var s=Math.round((new Date()-t)/1000);\n  if(s<60)return'just now';\n  if(s<3600)return Math.max(1,Math.round(s/60))+'m ago';\n  if(s<86400)return Math.round(s/3600)+'h ago';\n  return Math.round(s/86400)+'d ago';\n}\n\nfunction renderItems(items,label){\n  var W=el('wrap');W.innerHTML='';\n  items.forEach(function(it){\n    var c=document.createElement('button');c.className='item';c.type='button';\n    var body=document.createElement('div');body.className='body';\n    var h=document.createElement('div');h.className='title';h.textContent=it.title;\n    var m=document.createElement('div');m.className='meta';\n    var src=document.createElement('span');src.className='src';src.textContent=it.source||label||'';\n    var when=document.createElement('span');when.textContent=ago(it.date);\n    m.appendChild(src);if(when.textContent)m.appendChild(when);\n    body.appendChild(h);body.appendChild(m);\n    if(it.desc){var b=document.createElement('div');b.className='blurb';b.textContent=it.desc;body.appendChild(b)}\n    c.appendChild(body);\n    if(it.image){\n      var im=document.createElement('img');im.className='thumb';im.loading='lazy';\n      im.referrerPolicy='no-referrer';im.alt='';im.src=it.image;\n      im.onerror=function(){im.remove()};\n      c.appendChild(im);\n    }\n    c.onclick=function(){openArticle(it)};\n    W.appendChild(c);\n  });\n}\n\n/* ============================ the reader ============================ */\n\nfunction showReader(on){\n  var R=el('reader');\n  R.classList.toggle('on',on);\n  R.setAttribute('aria-hidden',on?'false':'true');\n  document.body.style.overflow=on?'hidden':'';\n  if(on)R.scrollTop=0;\n}\nel('back').onclick=function(){showReader(false);haptic('selection')};\nel('bigger').onclick=function(){setRead(readSize+1)};\nel('smaller').onclick=function(){setRead(readSize-1)};\nfunction setRead(px){\n  readSize=Math.max(14,Math.min(24,px));\n  document.documentElement.style.setProperty('--read',readSize+'px');\n  store.setItem('readSize',String(readSize));\n  haptic('selection');\n}\n\nvar current=null;\nel('share').onclick=function(){\n  if(!current)return;\n  var text=current.title+'\\n'+current.link;\n  if(window.myllmShare)myllmShare(text)['catch'](function(){});\n  haptic('light');\n};\n\nfunction openArticle(item){\n  current=item;\n  el('rsite').textContent=item.source||host(item.link);\n  showReader(true);haptic('selection');\n  paintArticle(item,null,'loading');\n  var cached=artCache[item.link];\n  if(cached){paintArticle(item,cached.article,cached.how);return}\n\n  readArticle(item).then(function(res){\n    if(current!==item)return;                     /* they moved on while we fetched */\n    artCache[item.link]={article:res.article,how:res.how};\n    paintArticle(item,res.article,res.how);\n  })['catch'](function(err){\n    if(current!==item)return;\n    paintArticle(item,null,'failed',err&&err.message);\n  });\n}\n\n/* Full text, from the cheapest source that has it. */\nfunction readArticle(item){\n  if(item.full&&item.full.length>600){\n    var a=extractArticle(item.full,item.link);\n    if(a.blocks.length>=2)return Promise.resolve({article:a,how:'feed'});\n  }\n  if(!item.link)return Promise.reject(new Error('this story has no link'));\n  if(!window.myllmFetch)return Promise.reject(new Error('network access for apps is off'));\n  return myllmFetch(item.link,{headers:{Accept:'text/html,application/xhtml+xml'}}).then(function(r){\n    if(!r)throw new Error('no response');\n    if(!r.ok){\n      /* 401/403 is a publisher refusing a non-browser, not a bug — say which. */\n      if(r.status===401||r.status===403)throw new Error('blocked');\n      throw new Error('the site returned '+r.status);\n    }\n    var a=extractArticle(r.body||'',item.link);\n    if(!a.blocks.length)throw new Error('nothing readable');\n    return {article:a,how:'web'};\n  });\n}\n\nfunction paintArticle(item,article,how,why){\n  var A=el('art');A.innerHTML='';\n  var h=document.createElement('h2');h.textContent=(article&&article.title)||item.title;A.appendChild(h);\n\n  var bits=[];\n  if(article&&article.author)bits.push(article.author);\n  var when=(article&&article.published)||item.date;\n  if(ago(when))bits.push(ago(when));\n  bits.push(item.source||host(item.link));\n  var by=document.createElement('div');by.className='byline';by.textContent=bits.join(' · ');A.appendChild(by);\n\n  if(how==='loading'){\n    if(item.image)A.appendChild(figure(item.image,''));\n    if(item.desc){var p0=document.createElement('p');p0.textContent=item.desc;A.appendChild(p0)}\n    for(var i=0;i<5;i++){var s=document.createElement('div');s.className='skel';\n      s.style.width=(i===4?'55%':'100%');A.appendChild(s)}\n    return;\n  }\n\n  if(how==='failed'){\n    A.appendChild(note(why==='blocked'\n      ? 'This publisher doesn’t let apps read its articles — only a browser. The summary from the feed is below.'\n      : 'Couldn’t read the full article here (' + (why||'unknown error') + '). The summary from the feed is below.'));\n    if(item.image)A.appendChild(figure(item.image,''));\n    if(item.desc){var p1=document.createElement('p');p1.textContent=item.desc;A.appendChild(p1)}\n    A.appendChild(openLink(item));\n    return;\n  }\n\n  var lead=(article.lead&&article.lead!==item.image)?article.lead:item.image;\n  var first=article.blocks[0];\n  if(lead&&!(first&&first.t==='img'))A.appendChild(figure(lead,''));\n\n  article.blocks.forEach(function(b){\n    if(b.t==='img'){A.appendChild(figure(b.src,b.cap));return}\n    if(b.t==='list'){\n      var l=document.createElement(b.ordered?'ol':'ul');\n      b.items.forEach(function(x){var li=document.createElement('li');li.textContent=x;l.appendChild(li)});\n      A.appendChild(l);return;\n    }\n    var tag=b.t==='h'?'h3':b.t==='quote'?'blockquote':b.t==='pre'?'pre':'p';\n    var n=document.createElement(tag);n.textContent=b.text;A.appendChild(n);\n  });\n\n  /* Say when this came from the feed's own copy rather than the page. */\n  var words=article.blocks.reduce(function(n,b){return n+(b.text?b.text.length:0)},0);\n  if(words<600)A.appendChild(note('That’s all this page gave us — the original may have more.'));\n  A.appendChild(openLink(item));\n}\n\nfunction figure(src,cap){\n  var f=document.createElement('figure');\n  var im=document.createElement('img');im.loading='lazy';im.referrerPolicy='no-referrer';im.alt=cap||'';im.src=src;\n  im.onerror=function(){f.remove()};\n  f.appendChild(im);\n  if(cap){var c=document.createElement('figcaption');c.textContent=cap;f.appendChild(c)}\n  return f;\n}\nfunction note(text){var d=document.createElement('div');d.className='note';d.textContent=text;return d}\nfunction openLink(item){\n  var a=document.createElement('a');a.className='open';a.href=item.link;a.target='_top';a.rel='noopener';\n  a.textContent='Open the original ↗\\uFE0E';\n  return a;\n}\n\n/* ===================== reading an article page =====================\n   The readability core, small enough to inline — a gallery app is one\n   self-contained file, so there is no library to reach for. */\n\nvar JUNK=/(^|[\\s_-])(nav|menu|banner|promo|advert|ads?|sponsor|share|social|comment|related|recirc|newsletter|subscribe|signup|sign-up|cookie|consent|sidebar|breadcrumb|most-read|trending|footer|header|masthead|tags?|meta-nav|skip)([\\s_-]|$)/i;\nvar BOILER=/^(sign up|subscribe|follow (us|bbc)|share this|read more|advertisement|related (stories|articles)|most read|this article|copyright|all rights reserved|getty images|image source|image caption|posts from this (topic|author)|are you personally affected|a free daily digest|by submitting your email|we use cookies)\\b/i;\nvar BLOCK='p,h2,h3,h4,ul,ol,blockquote,pre,figure,img';\n\nfunction txt(node){return node?(node.textContent||'').replace(/\\s+/g,' ').trim():''}\nfunction absolute(url,base){if(!url)return'';try{return new URL(url,base).href}catch(e){return''}}\nfunction fromSrcset(set,base){\n  var best='',bestW=0;\n  String(set).split(',').forEach(function(part){\n    var bits=part.trim().split(/\\s+/);\n    if(!bits[0])return;\n    var w=parseInt((bits[1]||'').replace(/[^\\d]/g,''),10)||0;\n    if(w>=bestW){bestW=w;best=bits[0]}\n  });\n  return absolute(best,base);\n}\nfunction imgSrc(node,base){\n  return fromSrcset(node.getAttribute('srcset')||node.getAttribute('data-srcset')||'',base)\n      || absolute(node.getAttribute('src')||node.getAttribute('data-src')||node.getAttribute('data-lazy-src')||'',base);\n}\nfunction metaOf(doc,names){\n  for(var i=0;i<names.length;i++){\n    var e=doc.querySelector('meta[property=\"'+names[i]+'\"], meta[name=\"'+names[i]+'\"]');\n    var v=e&&(e.getAttribute('content')||'').trim();\n    if(v)return v;\n  }\n  return'';\n}\n/* schema.org JSON-LD is where a modern news site actually keeps its metadata —\n   the BBC's byline exists ONLY there, not in any meta tag or class name. Sites\n   wrap it in an array, or in an @graph, or both. */\nfunction jsonLd(doc){\n  var found=null;\n  doc.querySelectorAll('script[type=\"application/ld+json\"]').forEach(function(node){\n    if(found)return;\n    var data;\n    try{data=JSON.parse(node.textContent||'')}catch(e){return}\n    var queue=[data];\n    while(queue.length&&!found){\n      var d=queue.shift();\n      if(Array.isArray(d)){queue=queue.concat(d);continue}\n      if(!d||typeof d!=='object')continue;\n      if(d['@graph'])queue=queue.concat(d['@graph']);\n      var t=[].concat(d['@type']||[]).join(' ');\n      if(/Article|BlogPosting|Report|NewsStory/i.test(t))found=d;\n    }\n  });\n  return found||{};\n}\n/* An author is a string, an object with a name, or an array of either. */\nfunction ldAuthor(ld){\n  var a=ld.author||ld.creator;\n  if(!a)return'';\n  a=[].concat(a)[0];\n  if(typeof a==='string')return a.trim();\n  return (a&&a.name?String(a.name):'').trim();\n}\n\n/* Bylines arrive as a name, a URL, an @handle or a whole social profile —\n   only the first of those is worth putting under a headline. */\nfunction byline(doc,ld){\n  var cands=[ldAuthor(ld||{}),\n             metaOf(doc,['author','article:author','parsely-author']),\n             txt(doc.querySelector('[rel=\"author\"]')),\n             txt(doc.querySelector('[itemprop=\"author\"] [itemprop=\"name\"], [itemprop=\"author\"]')),\n             txt(doc.querySelector('.byline, .author-name, [class*=\"byline\" i]'))];\n  for(var i=0;i<cands.length;i++){\n    var c=(cands[i]||'').trim().replace(/^(by|words by)\\s+/i,'');\n    if(!c||c.length>60)continue;\n    if(/^https?:\\/\\//i.test(c)||c.indexOf('@')===0)continue;\n    return c;\n  }\n  return'';\n}\n\nfunction qualifies(p){\n  var t=txt(p);\n  if(t.length<25)return 0;\n  var links=0;\n  p.querySelectorAll('a').forEach(function(a){links+=txt(a).length});\n  if(t.length&&links/t.length>0.5)return 0;      /* a link list, not a paragraph */\n  return t.length;\n}\nfunction proseIn(node){\n  var n=0;\n  node.querySelectorAll('p,blockquote,pre').forEach(function(p){n+=qualifies(p)});\n  return n;\n}\n\n/* Picking the article body.\n   Readability credits a paragraph's parent and grandparent. That fails badly on\n   a modern news site: the BBC wraps every THREE paragraphs in their own\n   container six levels below <article>, so the real root is credited by nothing\n   and each little wrapper wins on its own three.\n   So score by PROSE PURITY instead — how much of what an element contains is\n   actual paragraph text — which is scale-free and picks the same node whether\n   the prose sits one level down or eight. <body> loses because it also carries\n   the nav, the footer and the related-stories rail. */\nfunction pickRoot(doc){\n  var prose=new Map();\n  doc.querySelectorAll('p,blockquote,pre').forEach(function(p){\n    var n=qualifies(p);\n    if(!n)return;\n    var node=p.parentElement,depth=0;\n    while(node&&node.tagName!=='HTML'&&depth<12){\n      prose.set(node,(prose.get(node)||0)+n);\n      node=node.parentElement;depth++;\n    }\n  });\n  var best=null,bestScore=0;\n  prose.forEach(function(len,node){\n    if(len<200)return;\n    var all=txt(node).length;\n    var s=len-(all-len)*0.5;                     /* non-prose is furniture it dragged in */\n    var tag=node.tagName.toLowerCase();\n    if(tag==='article'||node.getAttribute('itemprop')==='articleBody')s*=1.15;\n    else if(tag==='main')s*=1.05;\n    else if(tag==='body')s*=0.9;\n    if(s>bestScore){bestScore=s;best=node}\n  });\n  return best;\n}\n\nfunction scrub(root){\n  root.querySelectorAll('script,style,noscript,iframe,svg,form,button,input,select,textarea,nav,aside,footer,header,video,audio,object,embed').forEach(function(n){n.remove()});\n  root.querySelectorAll('[aria-hidden=\"true\"],[hidden],[role=\"navigation\"],[role=\"banner\"],[role=\"complementary\"],[role=\"contentinfo\"]').forEach(function(n){n.remove()});\n  /* A junk-named block goes — unless it holds a serious share of the prose, in\n     which case the name is a coincidence and it IS the article. Guarding on\n     \"contains no <p>\" instead (the obvious version) keeps every native ad and\n     newsletter box on the page, because those are made of paragraphs too.\n     NB: no isConnected check — scrub runs on a DETACHED clone, where\n     isConnected is false for every node, so it would remove nothing at all. */\n  var budget=proseIn(root)*0.25;\n  root.querySelectorAll('*').forEach(function(n){\n    var id=((n.getAttribute('id')||'')+' '+(n.getAttribute('class')||'')).trim();\n    if(!id||!JUNK.test(id))return;\n    if(proseIn(n)>=budget)return;\n    n.remove();\n  });\n}\n\nfunction extractArticle(html,base){\n  var doc=new DOMParser().parseFromString(html,'text/html');\n  var canonical=doc.querySelector('link[rel=\"canonical\"]');\n  var ld=jsonLd(doc);\n  var info={\n    title:metaOf(doc,['og:title','twitter:title'])||(ld.headline||'').trim()||txt(doc.querySelector('h1'))||(doc.title||'').trim(),\n    site:metaOf(doc,['og:site_name'])||host(base),\n    author:byline(doc,ld),\n    published:metaOf(doc,['article:published_time','datePublished','og:published_time'])\n      ||(typeof ld.datePublished==='string'?ld.datePublished:'')\n      ||(doc.querySelector('time[datetime]')&&doc.querySelector('time[datetime]').getAttribute('datetime'))||'',\n    lead:metaOf(doc,['og:image','twitter:image']),\n    url:(canonical&&canonical.getAttribute('href'))||base,\n    blocks:[]\n  };\n  if(info.lead)info.lead=absolute(info.lead,base);\n\n  var root=pickRoot(doc);\n  if(!root)return info;\n  root=root.cloneNode(true);\n  scrub(root);\n\n  var seen={},out=[];\n  root.querySelectorAll(BLOCK).forEach(function(node){\n    /* Only the outermost of a nest — a <p> inside a <figure> is the caption. */\n    if(node.tagName!=='FIGURE'&&node.closest&&node.closest('figure'))return;\n    var tag=node.tagName.toLowerCase();\n    if(tag==='img'){\n      var s=imgSrc(node,base);\n      if(s&&!seen['i'+s]){seen['i'+s]=1;out.push({t:'img',src:s,cap:(node.getAttribute('alt')||'').trim()})}\n      return;\n    }\n    if(tag==='figure'){\n      var im=node.querySelector('img'),s2=im&&imgSrc(im,base),cap=txt(node.querySelector('figcaption'));\n      if(s2&&!seen['i'+s2]){seen['i'+s2]=1;out.push({t:'img',src:s2,cap:cap})}\n      return;\n    }\n    if(tag==='ul'||tag==='ol'){\n      var items=[];\n      node.querySelectorAll(':scope > li').forEach(function(li){var t=txt(li);if(t)items.push(t)});\n      if(items.length)out.push({t:'list',items:items,ordered:tag==='ol'});\n      return;\n    }\n    var t=txt(node);\n    if(!t||t.length<2)return;\n    if(BOILER.test(t))return;\n    if(seen['t'+t])return;\n    seen['t'+t]=1;\n    if(tag==='p'||tag==='pre'){\n      if(t.length<25&&node.querySelectorAll('a').length)return;   /* a short link is furniture */\n      out.push({t:tag==='pre'?'pre':'p',text:t});\n    }else if(tag==='blockquote'){\n      out.push({t:'quote',text:t});\n    }else{\n      out.push({t:'h',text:t});\n    }\n  });\n  while(out.length&&out[out.length-1].t==='h')out.pop();   /* a trailing heading heads nothing */\n  info.blocks=out;\n  return info;\n}\n\n/* ============================ feeds ============================ */\n\nfunction renderManage(){\n  setStatus('');\n  var W=el('wrap');\n  W.innerHTML='<div class=\"manage\"><h2>Add a feed</h2>'+\n    '<div class=\"row\"><input id=\"fname\" placeholder=\"Name\"><input id=\"furl\" placeholder=\"https://…/rss\"></div>'+\n    '<div class=\"row\" style=\"margin-top:8px\"><button id=\"addbtn\" style=\"flex:1;padding:11px;border-radius:9px\">Add RSS feed</button></div>'+\n    '<h2 style=\"margin-top:20px\">Your feeds</h2><div id=\"feeds\"></div>'+\n    '<p style=\"font-size:12px;color:var(--dim)\">Paste any site’s RSS or Atom feed URL — most have one at /rss or /feed.</p></div>';\n  el('addbtn').onclick=addFeed;\n  var F=el('feeds');\n  if(!custom.length)F.innerHTML='<p style=\"color:var(--dim);font-size:14px\">None yet.</p>';\n  custom.forEach(function(c,i){\n    var r=document.createElement('div');r.className='feedrow';\n    r.innerHTML='<b>'+esc(c.name)+'</b><span class=\"u\">'+esc(c.url)+'</span><button class=\"x\" aria-label=\"Remove\">✕</button>';\n    r.querySelector('.x').onclick=function(){custom.splice(i,1);saveCustom();renderManage();renderTabs()};\n    F.appendChild(r);\n  });\n}\nfunction addFeed(){\n  var n=el('fname').value.trim(),u=el('furl').value.trim();\n  if(!n||!/^https?:\\/\\//.test(u)){setStatus('Enter a name and a full feed URL (https://…).');return}\n  setStatus('');custom.push({name:n,url:u});saveCustom();renderManage();renderTabs();\n}\nfunction saveCustom(){store.setItem('feeds',JSON.stringify(custom))}\n\nel('refresh').onclick=function(){\n  var t=tabs()[active];\n  if(t.manage)return;\n  feedCache={};artCache={};\n  haptic('light');\n  load(t.url,t.name,true);\n};\n\nPromise.all([store.getItem('feeds'),store.getItem('readSize')]).then(function(v){\n  if(v[0])try{custom=JSON.parse(v[0])||[]}catch(e){}\n  if(v[1])setRead(parseInt(v[1],10)||17);\n  route();\n});\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes.\n   The spacer keeps the header clear of the status bar / Dynamic Island. It is\n   live CSS — env(safe-area-inset-top) — not a measured number: the inset is\n   still 0 when the page loads and only grows once MyLLM's bar has gone (v1\n   measured once, so the title sat under the island). If the page's own styles\n   already pad the header down by the inset, the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  /* Does any rule that applies to the header or an ancestor already use the top inset? */\n  function pageHandlesInset(head){\n    var chain = [], n, found = false;\n    for (n = head; n && n.nodeType === 1; n = n.parentElement) chain.push(n);\n    function walk(rules){\n      for (var i = 0; i < rules.length && !found; i++){\n        var r = rules[i];\n        if (r.cssRules && !r.selectorText) { walk(r.cssRules); continue; }\n        if (!r.selectorText || !/safe-area-inset-top/.test(r.cssText) || !/(padding|margin|top)\\s*:/.test(r.cssText)) continue;\n        if (/\\.imm-safe/.test(r.selectorText)) continue;\n        for (var k = 0; k < chain.length; k++){\n          try { if (chain[k].matches(r.selectorText)) { found = true; break; } } catch(e){}\n        }\n      }\n    }\n    for (var s = 0; s < document.styleSheets.length && !found; s++){\n      try { walk(document.styleSheets[s].cssRules); } catch(e){}\n    }\n    for (n = head; n && n.nodeType === 1 && !found; n = n.parentElement){\n      if (/safe-area-inset-top/.test(n.getAttribute(\"style\") || \"\")) found = true;\n    }\n    return found;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = (document.body.classList.contains(\"imm\") && !pageHandlesInset(head)) ? \"env(safe-area-inset-top)\" : \"0px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script></body></html>\n", "kind": "html", "iconSymbol": "newspaper.fill", "iconColor": "red"}