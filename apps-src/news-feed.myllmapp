{"name": "News", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>:root{color-scheme:light dark;--accent:#ff453a}\n*{box-sizing:border-box}\nbody{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:0;background:#f2f2f7;color:#111}\n@media(prefers-color-scheme:dark){body{background:#000;color:#eee}.head{background:rgba(20,20,22,.92)}.item{background:#1c1c1e}.tab{color:#888}input{background:#1c1c1e;color:#eee;border-color:#3a3a3c}}\n.head{position:sticky;top:0;background:rgba(242,242,247,.92);backdrop-filter:saturate(180%) blur(12px);padding:14px 16px 0;z-index:5}\nh1{font-size:20px;margin:0 0 8px}\n.tabs{display:flex;gap:4px;overflow-x:auto;padding-bottom:10px;margin:0 -16px;padding-left:16px;padding-right:16px}\n.tab{flex:none;padding:7px 14px;border-radius:18px;background:none;color:#777;font-size:14px;font-weight:600;border:0;cursor:pointer;white-space:nowrap}\n.tab.on{background:var(--accent);color:#fff}\n.wrap{padding:6px 16px 24px}\n.item{background:#fff;border-radius:13px;padding:13px 15px;margin-bottom:9px;box-shadow:0 1px 3px rgba(0,0,0,.07)}\n.title{font-size:16px;font-weight:600;line-height:1.3}\n.meta{font-size:12px;opacity:.55;margin-top:4px}\n.desc{font-size:14px;opacity:.85;margin-top:8px;line-height:1.45;display:none}\n.item.open .desc{display:block}\n.go{display:inline-block;margin-top:9px;font-size:13px;font-weight:600;color:var(--accent);text-decoration:none}\n#status{padding:14px 16px;font-size:14px;opacity:.7;text-align:center}\n.manage{padding:0 16px 24px}\n.manage h2{font-size:13px;text-transform:uppercase;letter-spacing:.05em;opacity:.55}\n.row{display:flex;gap:8px}\ninput{flex:1;padding:10px;border:1px solid #d1d1d6;border-radius:9px;font-size:15px;background:#fff}\n.row button{border:0;background:var(--accent);color:#fff;border-radius:9px;padding:0 16px;font-weight:600}\n.feedrow{display:flex;align-items:center;gap:8px;padding:8px 0;font-size:14px;border-top:1px solid rgba(128,128,128,.2)}\n.feedrow .u{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;opacity:.75}\n.feedrow .x{color:#ff453a;cursor:pointer;font-size:16px}\n@media(min-width:768px){body{max-width:760px;margin-left:auto;margin-right:auto}}\n</style></head><body>\n<div class=\"head\">\n  <h1>📰 News</h1>\n  <div class=\"tabs\" id=\"tabs\"></div>\n</div>\n<div id=\"status\"></div>\n<div class=\"wrap\" id=\"wrap\"></div>\n<script>\nvar TOPICS=[\n  {name:\"Top\",url:\"https://feeds.bbci.co.uk/news/rss.xml\"},\n  {name:\"World\",url:\"https://feeds.bbci.co.uk/news/world/rss.xml\"},\n  {name:\"UK\",url:\"https://feeds.bbci.co.uk/news/uk/rss.xml\"},\n  {name:\"Tech\",url:\"https://feeds.bbci.co.uk/news/technology/rss.xml\"},\n  {name:\"Business\",url:\"https://feeds.bbci.co.uk/news/business/rss.xml\"},\n  {name:\"Science\",url:\"https://feeds.bbci.co.uk/news/science_and_environment/rss.xml\"},\n  {name:\"Sport\",url:\"https://feeds.bbci.co.uk/sport/rss.xml\"}\n];\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar custom=[],active=0,cache={};\nfunction el(i){return document.getElementById(i)}\nfunction setStatus(t){var s=el('status');s.style.display=t?'block':'none';s.textContent=t||''}\nfunction tabs(){return TOPICS.concat(custom).concat([{name:\"＋ Feeds\",manage:true}])}\n\nfunction renderTabs(){\n  var T=el('tabs');T.innerHTML='';\n  tabs().forEach(function(t,i){\n    var b=document.createElement('button');b.className='tab'+(i===active?' on':'');b.textContent=t.name;\n    b.onclick=function(){active=i;route()};T.appendChild(b);\n  });\n}\nfunction route(){\n  renderTabs();\n  var t=tabs()[active];\n  if(t.manage)return renderManage();\n  load(t.url);\n}\n\nfunction load(url){\n  el('wrap').innerHTML='';\n  if(cache[url]){renderItems(cache[url]);return}\n  if(!window.myllmFetch){setStatus('This app needs network access — update MyLLM and enable app network access in Settings.');return}\n  setStatus('Loading…');\n  myllmFetch(url,{headers:{Accept:'application/rss+xml,application/xml,text/xml'}})\n  .then(function(r){\n    if(!r||!r.ok)throw new Error('feed returned '+((r&&r.status)||'no response'));\n    var items=parseFeed(r.body);\n    if(!items.length)throw new Error('no stories found in this feed');\n    cache[url]=items;setStatus('');renderItems(items);\n  }).catch(function(err){setStatus('Couldn’t load this feed: '+err.message)});\n}\n\nfunction parseFeed(xml){\n  var doc=new DOMParser().parseFromString(xml,'text/xml');\n  var nodes=doc.querySelectorAll('item');\n  var atom=false;\n  if(!nodes.length){nodes=doc.querySelectorAll('entry');atom=true}\n  var out=[];\n  Array.prototype.forEach.call(nodes,function(n){\n    var get=function(tag){var e=n.querySelector(tag);return e?e.textContent.trim():''};\n    var link=get('link');\n    if(atom){var l=n.querySelector('link');if(l&&l.getAttribute('href'))link=l.getAttribute('href')}\n    var desc=get('description')||get('summary')||get('content');\n    out.push({title:get('title'),link:link,date:get('pubDate')||get('updated')||get('published'),desc:strip(desc)});\n  });\n  return out.filter(function(i){return i.title});\n}\nfunction strip(html){var d=document.createElement('div');d.innerHTML=html;var t=(d.textContent||'').trim();return t.length>320?t.slice(0,320)+'…':t}\nfunction ago(d){\n  if(!d)return'';var t=new Date(d);if(isNaN(t))return'';\n  var s=Math.round((new Date()-t)/1000);\n  if(s<3600)return Math.max(1,Math.round(s/60))+'m ago';\n  if(s<86400)return Math.round(s/3600)+'h ago';\n  return Math.round(s/86400)+'d ago';\n}\n\nfunction renderItems(items){\n  var W=el('wrap');W.innerHTML='';\n  items.forEach(function(it){\n    var c=document.createElement('div');c.className='item';\n    var h=document.createElement('div');h.className='title';h.textContent=it.title;\n    var m=document.createElement('div');m.className='meta';m.textContent=ago(it.date);\n    var d=document.createElement('div');d.className='desc';d.textContent=it.desc||'';\n    c.appendChild(h);c.appendChild(m);if(it.desc)c.appendChild(d);\n    if(it.link){var a=document.createElement('a');a.className='go';a.textContent='Read full story ↗';a.href=it.link;a.target='_top';a.rel='noopener';c.appendChild(a)}\n    h.onclick=function(){c.classList.toggle('open');if(window.myllmHaptic)myllmHaptic('selection')};\n    W.appendChild(c);\n  });\n}\n\nfunction renderManage(){\n  setStatus('');\n  var W=el('wrap');\n  W.innerHTML='<div class=\"manage\"><h2>Add a feed</h2>'+\n    '<div class=\"row\"><input id=\"fname\" placeholder=\"Name\"><input id=\"furl\" placeholder=\"https://…/rss\"></div>'+\n    '<div class=\"row\" style=\"margin-top:8px\"><button onclick=\"addFeed()\" style=\"flex:1;padding:11px;border-radius:9px\">Add RSS feed</button></div>'+\n    '<h2 style=\"margin-top:20px\">Your feeds</h2><div id=\"feeds\"></div>'+\n    '<p style=\"font-size:12px;opacity:.5\">Paste any site’s RSS/Atom feed URL. Many sites have one at /rss or /feed.</p></div>';\n  var F=el('feeds');\n  if(!custom.length)F.innerHTML='<p style=\"opacity:.5;font-size:14px\">None yet.</p>';\n  custom.forEach(function(c,i){\n    var r=document.createElement('div');r.className='feedrow';\n    r.innerHTML='<b>'+escapeHtml(c.name)+'</b><span class=\"u\">'+escapeHtml(c.url)+'</span><span class=\"x\">✕</span>';\n    r.querySelector('.x').onclick=function(){custom.splice(i,1);saveCustom();renderManage();renderTabs()};\n    F.appendChild(r);\n  });\n}\nfunction addFeed(){\n  var n=el('fname').value.trim(),u=el('furl').value.trim();\n  if(!n||!/^https?:\\/\\//.test(u)){setStatus('Enter a name and a full feed URL (https://…).');return}\n  setStatus('');custom.push({name:n,url:u});saveCustom();renderManage();renderTabs();\n}\nfunction saveCustom(){store.setItem('feeds',JSON.stringify(custom))}\nfunction escapeHtml(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;')}\n\nstore.getItem('feeds').then(function(v){\n  if(v)try{custom=JSON.parse(v)||[]}catch(e){}\n  route();\n});\n</script></body></html>\n", "kind": "html", "iconSymbol": "newspaper.fill", "iconColor": "red"}