{"name": "Subscription Tracker", "kind": "html", "iconSymbol": "repeat.circle.fill", "iconColor": "indigo", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Subscription Tracker</title>\n<style>\n  :root { color-scheme: light dark; }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111);\n    max-width:820px; margin:0 auto;\n    padding:16px 16px calc(96px + env(safe-area-inset-bottom));\n  }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-0.02em; margin:6px 2px 14px; display:flex; align-items:center; gap:8px; }\n  h1 select{\n    margin-left:auto; font-size:14px; font-weight:700; border:1px solid var(--myllm-border,#e3e3e8);\n    background:var(--myllm-surface,#fff); color:var(--myllm-text,#111); border-radius:10px; padding:6px 8px;\n  }\n\n  .totals{\n    display:flex; gap:10px; margin-bottom:14px;\n  }\n  .tot{\n    flex:1; background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8);\n    border-radius:16px; padding:12px 14px;\n  }\n  .tot small{ display:block; font-size:11px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:var(--myllm-muted,#8a8a8e); margin-bottom:3px; }\n  .tot b{ font-size:22px; font-weight:800; letter-spacing:-0.02em; }\n  .tot span{ font-size:12px; color:var(--myllm-muted,#8a8a8e); }\n\n  .bars{ background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8); border-radius:16px; padding:12px 14px; margin-bottom:14px; }\n  .bars small{ font-size:11px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:var(--myllm-muted,#8a8a8e); }\n  .bar{ margin-top:8px; }\n  .bar .lbl{ display:flex; justify-content:space-between; font-size:12.5px; font-weight:600; margin-bottom:3px; }\n  .bar .lbl i{ font-style:normal; color:var(--myllm-muted,#8a8a8e); font-weight:500; }\n  .bar .track{ height:7px; border-radius:99px; background:var(--myllm-bg,#f2f2f7); overflow:hidden; }\n  .bar .fill{ height:100%; border-radius:99px; background:var(--myllm-accent,#0a84ff); }\n\n  .sub{\n    display:flex; align-items:center; gap:12px;\n    background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8);\n    border-radius:16px; padding:12px 14px; margin-bottom:10px;\n  }\n  .sub.paused{ opacity:.55; }\n  .sub .dot{ width:38px; height:38px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:18px; flex-shrink:0; background:var(--myllm-bg,#f2f2f7); }\n  .sub .mid{ flex:1; min-width:0; }\n  .sub .mid b{ display:block; font-size:15.5px; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .sub .mid small{ font-size:12.5px; color:var(--myllm-muted,#8a8a8e); }\n  .sub .right{ text-align:right; flex-shrink:0; }\n  .sub .right b{ display:block; font-size:15px; font-weight:750; }\n  .sub .right small{ font-size:11.5px; color:var(--myllm-muted,#8a8a8e); }\n  .due{ color:#ff9500 !important; font-weight:700 !important; }\n  .today{ color:#ff3b30 !important; font-weight:700 !important; }\n\n  .empty{ text-align:center; padding:44px 20px; color:var(--myllm-muted,#8a8a8e); font-size:14.5px; line-height:1.5; }\n  .empty .big{ font-size:40px; margin-bottom:10px; }\n\n  .fab{\n    position:fixed; right:18px; bottom:calc(20px + env(safe-area-inset-bottom));\n    width:56px; height:56px; border-radius:50%; border:none;\n    background:var(--myllm-accent,#0a84ff); color:#fff; font-size:28px; font-weight:600; line-height:1;\n    box-shadow:0 8px 24px -6px rgba(10,132,255,.55); z-index:50;\n  }\n  .aibtn{\n    position:fixed; left:18px; bottom:calc(20px + env(safe-area-inset-bottom));\n    height:44px; border-radius:99px; border:1px solid var(--myllm-border,#e3e3e8);\n    background:var(--myllm-surface,#fff); color:var(--myllm-text,#111);\n    font-size:14px; font-weight:650; padding:0 16px; z-index:50; display:flex; align-items:center; gap:7px;\n  }\n\n  /* modal sheet */\n  .veil{ position:fixed; inset:0; background:rgba(0,0,0,.4); z-index:90; display:none; }\n  .veil.on{ display:block; }\n  .sheet{\n    position:fixed; left:0; right:0; bottom:0; z-index:95;\n    background:var(--myllm-surface,#fff); border-radius:22px 22px 0 0;\n    padding:18px 18px calc(24px + env(safe-area-inset-bottom));\n    transform:translateY(105%); transition:transform .28s ease;\n    max-width:820px; margin:0 auto; max-height:86dvh; overflow-y:auto;\n  }\n  .sheet.on{ transform:none; }\n  .sheet h2{ font-size:17px; font-weight:800; margin-bottom:14px; }\n  .sheet label{ display:block; font-size:11.5px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:var(--myllm-muted,#8a8a8e); margin:12px 0 5px; }\n  .sheet input, .sheet select{\n    width:100%; font-size:16px; padding:11px 12px; border-radius:12px;\n    border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111);\n  }\n  .row2{ display:flex; gap:10px; }\n  .row2 > div{ flex:1; }\n  .chips{ display:flex; flex-wrap:wrap; gap:7px; }\n  .chip{\n    border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111);\n    border-radius:99px; padding:7px 13px; font-size:13.5px; font-weight:600;\n  }\n  .chip.on{ background:var(--myllm-accent,#0a84ff); border-color:var(--myllm-accent,#0a84ff); color:#fff; }\n  .actions{ display:flex; gap:10px; margin-top:18px; }\n  .btn{\n    flex:1; border:none; border-radius:14px; padding:14px; font-size:16px; font-weight:700;\n  }\n  .btn.primary{ background:var(--myllm-accent,#0a84ff); color:#fff; }\n  .btn.ghost{ background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111); }\n  .btn.danger{ background:transparent; color:#ff3b30; }\n  .btn:disabled{ opacity:.5; }\n\n  .aiout{\n    background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8);\n    border-radius:16px; padding:14px; margin-bottom:14px; font-size:14.5px; line-height:1.5; white-space:pre-wrap; display:none;\n  }\n  .aiout.on{ display:block; }\n  .aiout .x{ float:right; border:none; background:none; color:var(--myllm-muted,#8a8a8e); font-size:16px; padding:0 2px; }\n</style>\n</head>\n<body>\n\n<h1>💳 Subscriptions\n  <select id=\"cur\" onchange=\"setCur()\" aria-label=\"Currency\">\n    <option>£</option><option>$</option><option>€</option><option>¥</option><option>₹</option><option>kr</option><option>zł</option>\n  </select>\n</h1>\n\n<div class=\"totals\">\n  <div class=\"tot\"><small>Per month</small><b id=\"permo\">–</b></div>\n  <div class=\"tot\"><small>Per year</small><b id=\"peryr\">–</b><span id=\"count\"></span></div>\n</div>\n\n<div class=\"aiout\" id=\"aiout\"><button class=\"x\" onclick=\"hideAi()\" aria-label=\"Dismiss\">✕</button><span id=\"aitext\"></span></div>\n\n<div class=\"bars\" id=\"bars\" style=\"display:none\"><small>Where it goes / month</small><div id=\"barlist\"></div></div>\n\n<div id=\"list\"></div>\n\n<button class=\"aibtn\" id=\"aibtn\" onclick=\"audit()\" style=\"display:none\">✨ AI audit</button>\n<button class=\"fab\" onclick=\"openSheet()\" aria-label=\"Add subscription\">+</button>\n\n<div class=\"veil\" id=\"veil\" onclick=\"closeSheet()\"></div>\n<div class=\"sheet\" id=\"sheet\">\n  <h2 id=\"sheetTitle\">New subscription</h2>\n  <label>Name</label>\n  <input id=\"f_name\" placeholder=\"Netflix, iCloud, gym…\" autocomplete=\"off\">\n  <div class=\"row2\">\n    <div><label>Price</label><input id=\"f_price\" inputmode=\"decimal\" placeholder=\"9.99\"></div>\n    <div><label>Billing</label>\n      <select id=\"f_cycle\">\n        <option value=\"w\">Weekly</option>\n        <option value=\"m\" selected>Monthly</option>\n        <option value=\"q\">Every 3 months</option>\n        <option value=\"y\">Yearly</option>\n      </select>\n    </div>\n  </div>\n  <label>Next renewal</label>\n  <input id=\"f_date\" type=\"date\">\n  <label>Category</label>\n  <div class=\"chips\" id=\"f_cats\"></div>\n  <div class=\"actions\">\n    <button class=\"btn ghost\" onclick=\"closeSheet()\">Cancel</button>\n    <button class=\"btn primary\" id=\"saveBtn\" onclick=\"saveSub()\">Save</button>\n  </div>\n  <div class=\"actions\" id=\"dangerRow\" style=\"display:none\">\n    <button class=\"btn ghost\" id=\"pauseBtn\" onclick=\"togglePause()\">Pause</button>\n    <button class=\"btn danger\" id=\"delBtn\" onclick=\"delSub()\">Delete</button>\n  </div>\n</div>\n\n<!-- AI thinking pill (house convention) -->\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\">⚙️</span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n\n<script>\nvar store = window.myllmStorage || {getItem:function(){return Promise.resolve(null)}, setItem:function(){return Promise.resolve()}};\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\n\nvar CATS = [\n  {id:\"streaming\", name:\"Streaming\", ico:\"📺\"},\n  {id:\"music\",     name:\"Music\",     ico:\"🎵\"},\n  {id:\"cloud\",     name:\"Cloud & apps\", ico:\"☁️\"},\n  {id:\"fitness\",   name:\"Fitness\",   ico:\"💪\"},\n  {id:\"news\",      name:\"News & reading\", ico:\"📰\"},\n  {id:\"gaming\",    name:\"Gaming\",    ico:\"🎮\"},\n  {id:\"home\",      name:\"Home & bills\", ico:\"🏠\"},\n  {id:\"other\",     name:\"Other\",     ico:\"📦\"}\n];\nvar CYCLES = {w:{name:\"weekly\", perMonth:52/12, days:7}, m:{name:\"monthly\", perMonth:1, days:0}, q:{name:\"quarterly\", perMonth:1/3, days:0}, y:{name:\"yearly\", perMonth:1/12, days:0}};\n\nvar subs = [];\nvar currency = \"£\";\nvar editing = null;       // id being edited, or null\nvar pickedCat = \"other\";\nvar armDelete = false;\n\nfunction uid(){ return \"s\" + Date.now().toString(36) + Math.floor(Math.random()*1e6).toString(36); }\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\"); }\nfunction money(n){ return currency + (Math.round(n*100)/100).toFixed(2); }\n\nfunction save(){ store.setItem(\"subs\", JSON.stringify(subs)); store.setItem(\"cur\", currency); }\n\n/* advance a renewal date until it's today or later */\nfunction rollForward(s){\n  var d = new Date(s.next + \"T12:00:00\");\n  var today = new Date(); today.setHours(0,0,0,0);\n  var guard = 0;\n  while (d < today && guard++ < 600){\n    if (s.cycle === \"w\") d.setDate(d.getDate()+7);\n    else if (s.cycle === \"m\") d.setMonth(d.getMonth()+1);\n    else if (s.cycle === \"q\") d.setMonth(d.getMonth()+3);\n    else d.setFullYear(d.getFullYear()+1);\n  }\n  var iso = d.toISOString().slice(0,10);\n  if (iso !== s.next){ s.next = iso; return true; }\n  return false;\n}\n\nfunction daysUntil(iso){\n  var today = new Date(); today.setHours(0,0,0,0);\n  var d = new Date(iso + \"T00:00:00\");\n  return Math.round((d - today) / 86400000);\n}\n\nfunction monthly(s){ return s.price * CYCLES[s.cycle].perMonth; }\n\nfunction render(){\n  var active = subs.filter(function(s){ return !s.paused; });\n  var mo = active.reduce(function(a,s){ return a + monthly(s); }, 0);\n  el(\"permo\").textContent = subs.length ? money(mo) : \"–\";\n  el(\"peryr\").textContent = subs.length ? money(mo*12) : \"–\";\n  el(\"count\").textContent = subs.length ? (\" \" + active.length + \" active\") : \"\";\n  el(\"aibtn\").style.display = (window.myllmAsk && subs.length >= 2) ? \"flex\" : \"none\";\n\n  /* category bars */\n  var byCat = {};\n  active.forEach(function(s){ byCat[s.cat] = (byCat[s.cat]||0) + monthly(s); });\n  var keys = Object.keys(byCat).sort(function(a,b){ return byCat[b]-byCat[a]; });\n  if (keys.length >= 2){\n    el(\"bars\").style.display = \"block\";\n    var max = byCat[keys[0]];\n    el(\"barlist\").innerHTML = keys.map(function(k){\n      var c = CATS.filter(function(x){return x.id===k;})[0] || CATS[CATS.length-1];\n      return '<div class=\"bar\"><div class=\"lbl\"><span>'+c.ico+' '+esc(c.name)+'</span><i>'+money(byCat[k])+'</i></div>'+\n             '<div class=\"track\"><div class=\"fill\" style=\"width:'+Math.max(6, byCat[k]/max*100)+'%\"></div></div></div>';\n    }).join(\"\");\n  } else el(\"bars\").style.display = \"none\";\n\n  /* list */\n  if (!subs.length){\n    el(\"list\").innerHTML = '<div class=\"empty\"><div class=\"big\">💳</div>Track every subscription in one place.<br>Tap <b>+</b> to add your first — you might be surprised what it all adds up to.</div>';\n    return;\n  }\n  var sorted = subs.slice().sort(function(a,b){\n    if (!!a.paused !== !!b.paused) return a.paused ? 1 : -1;\n    return a.next < b.next ? -1 : 1;\n  });\n  el(\"list\").innerHTML = sorted.map(function(s){\n    var c = CATS.filter(function(x){return x.id===s.cat;})[0] || CATS[CATS.length-1];\n    var d = daysUntil(s.next);\n    var when = s.paused ? \"paused\" : (d === 0 ? \"renews today\" : d === 1 ? \"renews tomorrow\" : \"renews in \" + d + \" days\");\n    var cls = s.paused ? \"\" : (d === 0 ? \"today\" : d <= 7 ? \"due\" : \"\");\n    return '<div class=\"sub'+(s.paused?' paused':'')+'\" onclick=\"openSheet(\\''+s.id+'\\')\">'+\n      '<div class=\"dot\">'+c.ico+'</div>'+\n      '<div class=\"mid\"><b>'+esc(s.name)+'</b><small class=\"'+cls+'\">'+when+'</small></div>'+\n      '<div class=\"right\"><b>'+money(s.price)+'</b><small>'+CYCLES[s.cycle].name+'</small></div>'+\n    '</div>';\n  }).join(\"\");\n}\n\n/* ---- sheet ---- */\nfunction renderCats(){\n  el(\"f_cats\").innerHTML = CATS.map(function(c){\n    return '<button class=\"chip'+(pickedCat===c.id?' on':'')+'\" onclick=\"pickCat(\\''+c.id+'\\')\">'+c.ico+' '+esc(c.name)+'</button>';\n  }).join(\"\");\n}\nfunction pickCat(id){ pickedCat = id; haptic(\"selection\"); renderCats(); }\n\nfunction openSheet(id){\n  editing = id || null;\n  armDelete = false;\n  var s = editing ? subs.filter(function(x){return x.id===editing;})[0] : null;\n  el(\"sheetTitle\").textContent = s ? \"Edit subscription\" : \"New subscription\";\n  el(\"f_name\").value = s ? s.name : \"\";\n  el(\"f_price\").value = s ? s.price : \"\";\n  el(\"f_cycle\").value = s ? s.cycle : \"m\";\n  el(\"f_date\").value = s ? s.next : new Date(Date.now()+86400000*30).toISOString().slice(0,10);\n  pickedCat = s ? s.cat : \"other\";\n  el(\"dangerRow\").style.display = s ? \"flex\" : \"none\";\n  el(\"delBtn\").textContent = \"Delete\";\n  el(\"pauseBtn\").textContent = (s && s.paused) ? \"Resume\" : \"Pause\";\n  renderCats();\n  el(\"veil\").classList.add(\"on\");\n  el(\"sheet\").classList.add(\"on\");\n  haptic(\"light\");\n}\nfunction closeSheet(){\n  el(\"veil\").classList.remove(\"on\");\n  el(\"sheet\").classList.remove(\"on\");\n}\nfunction saveSub(){\n  var name = el(\"f_name\").value.trim();\n  var price = parseFloat(String(el(\"f_price\").value).replace(\",\", \".\"));\n  var date = el(\"f_date\").value;\n  if (!name || !(price > 0) || !date){ haptic(\"light\"); el(\"f_name\").focus(); return; }\n  if (editing){\n    var s = subs.filter(function(x){return x.id===editing;})[0];\n    s.name = name; s.price = price; s.cycle = el(\"f_cycle\").value; s.next = date; s.cat = pickedCat;\n    rollForward(s);\n  } else {\n    var ns = {id:uid(), name:name, price:price, cycle:el(\"f_cycle\").value, next:date, cat:pickedCat, paused:false};\n    rollForward(ns);\n    subs.push(ns);\n  }\n  save(); render(); closeSheet(); haptic(\"success\");\n}\nfunction delSub(){\n  if (!armDelete){ armDelete = true; el(\"delBtn\").textContent = \"Really delete?\"; haptic(\"light\"); return; }\n  subs = subs.filter(function(x){return x.id!==editing;});\n  save(); render(); closeSheet(); haptic(\"success\");\n}\nfunction togglePause(){\n  var s = subs.filter(function(x){return x.id===editing;})[0];\n  if (s){ s.paused = !s.paused; save(); render(); }\n  closeSheet(); haptic(\"selection\");\n}\nfunction setCur(){ currency = el(\"cur\").value; save(); render(); }\n\n/* ---- optional AI audit ---- */\nfunction audit(){\n  if (!window.myllmAsk) return;\n  haptic(\"light\");\n  var lines = subs.map(function(s){\n    return s.name + \": \" + currency + s.price + \" \" + CYCLES[s.cycle].name + (s.paused ? \" (paused)\" : \"\");\n  }).join(\"; \");\n  var mo = subs.filter(function(s){return !s.paused;}).reduce(function(a,s){return a+monthly(s);},0);\n  var prompt = \"My subscriptions: \" + lines + \". Total ≈ \" + money(mo) + \"/month. \" +\n    \"In under 120 words, give a friendly audit: the yearly total, my biggest costs, any likely overlap (e.g. two music or two TV services), and 1–2 candidates to consider cancelling or switching to yearly billing. Plain text, no markdown.\";\n  myllmAsk(prompt, {system:\"You are a concise, friendly personal-finance helper. Plain text only.\"})\n    .then(function(r){\n      el(\"aitext\").textContent = String(r).trim();\n      el(\"aiout\").classList.add(\"on\");\n      haptic(\"success\");\n    })\n    .catch(function(){\n      el(\"aitext\").textContent = \"The AI couldn't run just now — try again in a moment.\";\n      el(\"aiout\").classList.add(\"on\");\n    });\n}\nfunction hideAi(){ el(\"aiout\").classList.remove(\"on\"); }\n\n/* ---- boot ---- */\nPromise.all([store.getItem(\"subs\"), store.getItem(\"cur\")]).then(function(vals){\n  if (vals[0]){ try{ subs = JSON.parse(vals[0]) || []; }catch(e){} }\n  if (vals[1]){ currency = vals[1]; el(\"cur\").value = currency; }\n  var changed = false;\n  subs.forEach(function(s){ if (!s.paused && rollForward(s)) changed = true; });\n  if (changed) save();\n  render();\n});\n</script>\n</body>\n</html>\n"}