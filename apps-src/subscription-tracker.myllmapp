{"name": "Subscription Tracker", "kind": "html", "iconSymbol": "repeat.circle.fill", "iconColor": "indigo", "html": "<!doctype html>\n<!--\n  Subscription Tracker — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Subscription Tracker</title>\n<style>\n  :root{ color-scheme:light dark;\n    --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n    --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n    --fill:rgba(120,120,128,.12); --h:244; }\n  @media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n    --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(96px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:760px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.96); }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 28%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  .head .acts{ display:flex; gap:8px; flex-shrink:0; }\n  .head select{ height:40px; min-width:52px; font:inherit; font-size:15px; font-weight:700; border:1px solid var(--line);\n    background:var(--surface); color:var(--ink); border-radius:12px; padding:0 10px; }\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:20px 2px 10px; }\n\n  .hero{ border-radius:20px; padding:16px 18px; color:#fff; margin-bottom:12px; display:flex; align-items:flex-end; gap:14px;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 26%)); box-shadow:0 10px 28px hsl(var(--h) 60% 30% / .25); }\n  .hero .main{ flex:1; min-width:0; }\n  .hero .k{ font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.8; }\n  .hero .n{ font-size:40px; font-weight:800; line-height:1.05; letter-spacing:-.03em; font-variant-numeric:tabular-nums; overflow-wrap:anywhere; }\n  .hero .yr{ flex-shrink:0; text-align:right; }\n  .hero .yr b{ display:block; font-size:19px; font-weight:800; font-variant-numeric:tabular-nums; }\n  .hero .yr small{ display:block; font-size:12px; opacity:.8; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  .bars small.lbl{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); }\n  .bar{ margin-top:10px; }\n  .bar .lbl{ display:flex; align-items:center; gap:7px; font-size:13px; font-weight:650; margin-bottom:4px; }\n  .bar .lbl .dotc{ width:10px; height:10px; border-radius:3px; flex-shrink:0; background:hsl(var(--h) 62% 50%); }\n  .bar .lbl i{ margin-left:auto; font-style:normal; color:var(--muted); font-weight:600; font-variant-numeric:tabular-nums; }\n  .bar .track{ height:8px; border-radius:99px; background:var(--fill); overflow:hidden; }\n  .bar .fill{ height:100%; border-radius:99px; background:linear-gradient(90deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 30) 62% 56%)); }\n\n  .list{ display:grid; gap:8px; }\n  .list{ grid-template-columns:minmax(0,1fr); }\n  @media (min-width:768px){ .list{ grid-template-columns:repeat(2,minmax(0,1fr)); } }\n  .sub{ display:flex; align-items:center; gap:12px; background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:10px 12px; min-height:64px; cursor:pointer; }\n  .sub.paused{ opacity:.55; }\n  .sub .tile{ width:40px; height:40px; border-radius:12px; font-size:17px; }\n  .sub .mid{ flex:1; min-width:0; }\n  .sub .mid b{ display:block; font-size:15.5px; font-weight:650; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .sub .mid small{ font-size:12.5px; color:var(--muted); }\n  .sub .right{ text-align:right; flex-shrink:0; }\n  .sub .right b{ display:block; font-size:15px; font-weight:750; font-variant-numeric:tabular-nums; }\n  .sub .right small{ font-size:11.5px; color:var(--muted); }\n  .due{ color:#ff9500 !important; font-weight:700 !important; }\n  .today{ color:#ff3b30 !important; font-weight:700 !important; }\n\n  .empty{ grid-column:1/-1; text-align:center; padding:26px 20px 14px; background:var(--surface); border:1px solid var(--line); border-radius:18px; }\n  .empty .tile{ width:48px; height:48px; border-radius:14px; font-size:21px; margin:0 auto 10px; opacity:.9; }\n  .empty b{ display:block; font-size:16px; font-weight:750; }\n  .empty p{ font-size:13.5px; color:var(--muted); line-height:1.5; max-width:290px; margin:5px auto 0; }\n\n  .fab{ position:fixed; right:calc(18px + env(safe-area-inset-right)); bottom:calc(20px + env(safe-area-inset-bottom));\n    width:56px; height:56px; border-radius:50%; border:none; display:flex; align-items:center; justify-content:center; font-size:24px;\n    background:var(--acc); color:#fff; box-shadow:0 10px 26px -6px rgba(10,132,255,.55); z-index:50; }\n  .aibtn{ position:fixed; left:calc(18px + env(safe-area-inset-left)); bottom:calc(26px + env(safe-area-inset-bottom));\n    height:44px; border-radius:99px; border:1px solid var(--line); background:var(--surface); color:var(--ink);\n    font-size:14px; font-weight:700; padding:0 16px; z-index:50; display:flex; align-items:center; gap:7px; box-shadow:0 6px 18px rgba(0,0,0,.12); }\n  .aibtn svg{ color:hsl(var(--h) 62% 55%); }\n  .aibtn:disabled{ opacity:.7; }\n  .spin{ width:16px; height:16px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n\n  /* modal sheet */\n  .veil{ position:fixed; inset:0; background:rgba(0,0,0,.4); z-index:90; display:none; }\n  .veil.on{ display:block; }\n  .sheet{ position:fixed; left:0; right:0; bottom:0; z-index:95; background:var(--surface); border-radius:22px 22px 0 0;\n    padding:10px calc(18px + env(safe-area-inset-right)) calc(24px + env(safe-area-inset-bottom)) calc(18px + env(safe-area-inset-left));\n    transform:translateY(105%); transition:transform .28s cubic-bezier(.2,.8,.2,1);\n    max-width:600px; margin:0 auto; max-height:88dvh; overflow-y:auto; box-shadow:0 -10px 40px rgba(0,0,0,.2); }\n  .sheet::before{ content:\"\"; display:block; width:38px; height:5px; border-radius:99px; background:var(--line); margin:0 auto 12px; }\n  .sheet.on{ transform:none; }\n  .sheet h2{ font-size:18px; font-weight:800; margin:0 0 4px; letter-spacing:0; text-transform:none; color:var(--ink); }\n  .sheet label{ display:block; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:14px 2px 7px; }\n  .sheet input, .sheet select{ width:100%; font:inherit; font-size:16px; padding:12px; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; }\n  .sheet input:focus, .sheet select:focus{ border-color:var(--acc); }\n  .row2{ display:flex; gap:10px; }\n  .row2 > div{ flex:1; min-width:0; }\n  .chips{ display:flex; flex-wrap:wrap; gap:7px; }\n  .chip{ min-height:36px; border:1px solid var(--line); background:var(--bg); color:var(--ink); border-radius:99px; padding:0 13px 0 10px; font-size:13.5px; font-weight:650;\n    display:inline-flex; align-items:center; gap:6px; }\n  .chip svg{ width:15px; height:15px; opacity:.75; }\n  .chip.on{ background:var(--acc); border-color:var(--acc); color:#fff; }\n  .chip.on svg{ opacity:1; }\n  .actions{ display:flex; gap:10px; margin-top:18px; }\n  .btn{ flex:1; min-height:50px; border:none; border-radius:14px; font-size:16px; font-weight:700; }\n  .btn.primary{ background:var(--acc); color:#fff; }\n  .btn.ghost{ background:var(--fill); color:var(--ink); }\n  .btn.danger{ background:transparent; color:#ff3b30; }\n  .btn:disabled{ opacity:.5; }\n\n  .aiout{ position:relative; background:var(--surface); border:1px solid hsl(var(--h) 62% 55% / .45); border-radius:18px; padding:14px 48px 14px 14px;\n    margin-bottom:12px; font-size:14.5px; line-height:1.55; white-space:pre-wrap; display:none; }\n  .aiout.on{ display:block; }\n  .aiout .kk{ display:flex; align-items:center; gap:6px; font-size:11.5px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:hsl(var(--h) 62% 55%); margin-bottom:6px; white-space:normal; }\n  .aiout .x{ position:absolute; right:4px; top:4px; width:44px; height:44px; border:none; background:none; color:var(--muted); font-size:14px; display:flex; align-items:center; justify-content:center; }\n  [hidden]{ display:none !important; }\n  .hero select{ display:none; height:34px; font:inherit; font-size:14px; font-weight:700; border:1px solid rgba(255,255,255,.3); background:rgba(255,255,255,.16); color:#fff; border-radius:10px; padding:0 8px; margin-bottom:6px; }\n  .hero select option{ color:#111; }\n  /* narrow phones: the title keeps the header row; the currency moves beside the money */\n  @media (max-width:360px){ .head .acts{ display:none; } .hero select{ display:inline-block; } }\n  @media (prefers-reduced-motion:reduce){ .sheet{ transition:none; } .spin{ animation-duration:2.4s; } button:active{ transform:none; } }\n</style>\n<style>:root{--build-id:\"6b22e09c1a\";}</style>\n</head>\n<body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-repeat\" viewBox=\"0 0 24 24\"><path d=\"M17 3.3l3.2 3.2L17 9.7M20.2 6.5H8a4 4 0 0 0-4 4V12M7 20.7l-3.2-3.2L7 14.3M3.8 17.5H16a4 4 0 0 0 4-4V12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-plus\" viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-spark\" viewBox=\"0 0 24 24\"><path d=\"M10 2.5l1.9 5.6 5.6 1.9-5.6 1.9L10 17.5l-1.9-5.6L2.5 10l5.6-1.9zM18.5 14l.95 2.55L22 17.5l-2.55.95L18.5 21l-.95-2.55L15 17.5l2.55-.95z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"c-streaming\" viewBox=\"0 0 24 24\"><path d=\"M4.5 4.5h15A2.5 2.5 0 0 1 22 7v9a2.5 2.5 0 0 1-2.5 2.5h-15A2.5 2.5 0 0 1 2 16V7a2.5 2.5 0 0 1 2.5-2.5zm5.3 3.8v6.4a.6.6 0 0 0 .9.5l5.2-3.2a.6.6 0 0 0 0-1l-5.2-3.2a.6.6 0 0 0-.9.5zM7 20.5h10a1 1 0 0 1 0 2H7a1 1 0 0 1 0-2z\" fill=\"currentColor\" fill-rule=\"evenodd\"/></symbol>\n  <symbol id=\"c-music\" viewBox=\"0 0 24 24\"><path d=\"M19.2 2.7a1 1 0 0 1 .8 1V16a3.5 3.5 0 1 1-2-3.2V7.5l-8 1.6V18a3.5 3.5 0 1 1-2-3.2V5.5a1 1 0 0 1 .8-1z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"c-cloud\" viewBox=\"0 0 24 24\"><path d=\"M12.5 5a6 6 0 0 1 5.8 4.6A4.8 4.8 0 0 1 17.6 19H7a5 5 0 0 1-.7-9.95A6 6 0 0 1 12.5 5z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"c-fitness\" viewBox=\"0 0 24 24\"><path d=\"M5 7.5a1.5 1.5 0 0 1 3 0V11h8V7.5a1.5 1.5 0 0 1 3 0v9a1.5 1.5 0 0 1-3 0V13H8v3.5a1.5 1.5 0 0 1-3 0zM2.5 9.5a1 1 0 0 1 2 0v5a1 1 0 0 1-2 0zm17 0a1 1 0 0 1 2 0v5a1 1 0 0 1-2 0z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"c-news\" viewBox=\"0 0 24 24\"><path d=\"M5.5 3.5h11A1.5 1.5 0 0 1 18 5v2h1.5A1.5 1.5 0 0 1 21 8.5V18a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 18V6a2.5 2.5 0 0 1 2.5-2.5zM18 9v9a.5.5 0 0 0 1 0V9zM6.5 7a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5zm5.5.5a.75.75 0 0 0 0 1.5h2.5a.75.75 0 0 0 0-1.5zm0 2.5a.75.75 0 0 0 0 1.5h2.5a.75.75 0 0 0 0-1.5zM6.75 13.5a.75.75 0 0 0 0 1.5h7.75a.75.75 0 0 0 0-1.5zm0 3a.75.75 0 0 0 0 1.5h7.75a.75.75 0 0 0 0-1.5z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"c-gaming\" viewBox=\"0 0 24 24\"><path d=\"M7.5 6.5h9a5 5 0 0 1 4.9 4l.9 4.6a2.6 2.6 0 0 1-4.5 2.2L15.9 15H8.1l-1.9 2.3a2.6 2.6 0 0 1-4.5-2.2l.9-4.6a5 5 0 0 1 4.9-4zM8 9a.75.75 0 0 0-.75.75v.75H6.5a.75.75 0 0 0 0 1.5h.75v.75a.75.75 0 0 0 1.5 0V12h.75a.75.75 0 0 0 0-1.5h-.75v-.75A.75.75 0 0 0 8 9zm8.5.3a1 1 0 1 0 0 2 1 1 0 0 0 0-2zm-2 2a1 1 0 1 0 0 2 1 1 0 0 0 0-2z\" fill=\"currentColor\" fill-rule=\"evenodd\"/></symbol>\n  <symbol id=\"c-home\" viewBox=\"0 0 24 24\"><path d=\"M11.3 3.3a1 1 0 0 1 1.4 0l8 7.4a1 1 0 0 1-1.4 1.5l-.3-.3V19a2 2 0 0 1-2 2h-2.5a1 1 0 0 1-1-1v-4.5h-3V20a1 1 0 0 1-1 1H7a2 2 0 0 1-2-2v-7.1l-.3.3a1 1 0 0 1-1.4-1.5z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"c-other\" viewBox=\"0 0 24 24\"><path d=\"M11.4 2.6a1.5 1.5 0 0 1 1.2 0l7.5 3.4a1 1 0 0 1 .4.3L12 10.4 3.5 6.3a1 1 0 0 1 .4-.3zM3 8l8 3.9v9.4l-7.4-3.4A1 1 0 0 1 3 17zm18 0v9a1 1 0 0 1-.6.9L13 21.3v-9.4z\" fill=\"currentColor\"/></symbol>\n</defs></svg>\n\n<div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-repeat\"/></svg></div>\n  <div class=\"ht\"><h1>Subscription Tracker</h1><p>Know what you really pay</p></div>\n  <div class=\"acts\">\n    <select id=\"cur\" onchange=\"setCur()\" aria-label=\"Currency\">\n      <option>£</option><option>$</option><option>€</option><option>¥</option><option>₹</option><option>kr</option><option>zł</option>\n    </select>\n  </div>\n</div>\n\n<div class=\"hero\">\n  <div class=\"main\"><div class=\"k\">Per month</div><div class=\"n\" id=\"permo\">–</div></div>\n  <div class=\"yr\"><select id=\"cur2\" aria-label=\"Currency\"><option>£</option><option>$</option><option>€</option><option>¥</option><option>₹</option><option>kr</option><option>zł</option></select><b id=\"peryr\">–</b><small>a year<span id=\"count\"></span></small></div>\n</div>\n\n<div class=\"aiout\" id=\"aiout\"><div class=\"kk\"><svg class=\"i\"><use href=\"#i-spark\"/></svg>AI audit</div><button class=\"x\" onclick=\"hideAi()\" aria-label=\"Dismiss\"><svg class=\"i\"><use href=\"#i-x\"/></svg></button><span id=\"aitext\"></span></div>\n\n<div class=\"card bars\" id=\"bars\" style=\"display:none\"><small class=\"lbl\">Where it goes / month</small><div id=\"barlist\"></div></div>\n\n<h2 id=\"listLbl\" hidden>Subscriptions</h2>\n<div class=\"list\" id=\"list\"></div>\n\n<button class=\"aibtn\" id=\"aibtn\" onclick=\"audit()\" style=\"display:none\"><svg class=\"i\"><use href=\"#i-spark\"/></svg><span>AI audit</span></button>\n<button class=\"fab\" onclick=\"openSheet()\" aria-label=\"Add subscription\"><svg class=\"i\"><use href=\"#i-plus\"/></svg></button>\n\n<div class=\"veil\" id=\"veil\" onclick=\"closeSheet()\"></div>\n<div class=\"sheet\" id=\"sheet\">\n  <h2 id=\"sheetTitle\">New subscription</h2>\n  <label>Name</label>\n  <input id=\"f_name\" placeholder=\"Netflix, iCloud, gym…\" autocomplete=\"off\">\n  <div class=\"row2\">\n    <div><label>Price</label><input id=\"f_price\" inputmode=\"decimal\" placeholder=\"9.99\"></div>\n    <div><label>Billing</label>\n      <select id=\"f_cycle\">\n        <option value=\"w\">Weekly</option>\n        <option value=\"m\" selected>Monthly</option>\n        <option value=\"q\">Every 3 months</option>\n        <option value=\"y\">Yearly</option>\n      </select>\n    </div>\n  </div>\n  <label>Next renewal</label>\n  <input id=\"f_date\" type=\"date\">\n  <label>Category</label>\n  <div class=\"chips\" id=\"f_cats\"></div>\n  <div class=\"actions\">\n    <button class=\"btn ghost\" onclick=\"closeSheet()\">Cancel</button>\n    <button class=\"btn primary\" id=\"saveBtn\" onclick=\"saveSub()\">Save</button>\n  </div>\n  <div class=\"actions\" id=\"dangerRow\" style=\"display:none\">\n    <button class=\"btn ghost\" id=\"pauseBtn\" onclick=\"togglePause()\">Pause</button>\n    <button class=\"btn danger\" id=\"delBtn\" onclick=\"delSub()\">Delete</button>\n  </div>\n</div>\n\n<!-- AI thinking pill (house convention) -->\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{width:16px;height:16px;border-radius:50%;border:2.4px solid #a78bfa;border-right-color:transparent;animation:myllmAiSpin .9s linear infinite;flex-shrink:0}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\"></span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n\n<script>\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction store(){ return window.myllmStorage || {getItem:function(){return Promise.resolve(null)}, setItem:function(){return Promise.resolve()}}; }\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\n\nvar CATS = [\n  {id:\"streaming\", name:\"Streaming\", h:350},\n  {id:\"music\",     name:\"Music\",     h:320},\n  {id:\"cloud\",     name:\"Cloud & apps\", h:205},\n  {id:\"fitness\",   name:\"Fitness\",   h:145},\n  {id:\"news\",      name:\"News & reading\", h:28},\n  {id:\"gaming\",    name:\"Gaming\",    h:268},\n  {id:\"home\",      name:\"Home & bills\", h:176},\n  {id:\"other\",     name:\"Other\",     h:230}\n];\nvar CYCLES = {w:{name:\"weekly\", perMonth:52/12, days:7}, m:{name:\"monthly\", perMonth:1, days:0}, q:{name:\"quarterly\", perMonth:1/3, days:0}, y:{name:\"yearly\", perMonth:1/12, days:0}};\n\nvar subs = [];\nvar currency = \"£\";\nvar editing = null;       // id being edited, or null\nvar pickedCat = \"other\";\nvar armDelete = false;\n\nfunction uid(){ return \"s\" + Date.now().toString(36) + Math.floor(Math.random()*1e6).toString(36); }\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\"); }\nfunction cico(c){ return '<svg class=\"i\"><use href=\"#c-' + c.id + '\"/></svg>'; }\nfunction money(n){ return currency + (Math.round(n*100)/100).toFixed(2); }\n\nfunction save(){ store().setItem(\"subs\", JSON.stringify(subs)); store().setItem(\"cur\", currency); }\n\n/* advance a renewal date until it's today or later */\nfunction rollForward(s){\n  var d = new Date(s.next + \"T12:00:00\");\n  var today = new Date(); today.setHours(0,0,0,0);\n  var guard = 0;\n  while (d < today && guard++ < 600){\n    if (s.cycle === \"w\") d.setDate(d.getDate()+7);\n    else if (s.cycle === \"m\") d.setMonth(d.getMonth()+1);\n    else if (s.cycle === \"q\") d.setMonth(d.getMonth()+3);\n    else d.setFullYear(d.getFullYear()+1);\n  }\n  var iso = d.toISOString().slice(0,10);\n  if (iso !== s.next){ s.next = iso; return true; }\n  return false;\n}\n\nfunction daysUntil(iso){\n  var today = new Date(); today.setHours(0,0,0,0);\n  var d = new Date(iso + \"T00:00:00\");\n  return Math.round((d - today) / 86400000);\n}\n\nfunction monthly(s){ return s.price * CYCLES[s.cycle].perMonth; }\n\nfunction render(){\n  var active = subs.filter(function(s){ return !s.paused; });\n  var mo = active.reduce(function(a,s){ return a + monthly(s); }, 0);\n  el(\"permo\").textContent = subs.length ? money(mo) : \"–\";\n  el(\"peryr\").textContent = subs.length ? money(mo*12) : \"–\";\n  el(\"count\").textContent = subs.length ? (\" · \" + active.length + \" active\") : \"\";\n  el(\"listLbl\").hidden = !subs.length;\n  el(\"aibtn\").style.display = (window.myllmAsk && subs.length >= 2) ? \"flex\" : \"none\";\n\n  /* category bars */\n  var byCat = {};\n  active.forEach(function(s){ byCat[s.cat] = (byCat[s.cat]||0) + monthly(s); });\n  var keys = Object.keys(byCat).sort(function(a,b){ return byCat[b]-byCat[a]; });\n  if (keys.length >= 2){\n    el(\"bars\").style.display = \"block\";\n    var max = byCat[keys[0]];\n    el(\"barlist\").innerHTML = keys.map(function(k){\n      var c = CATS.filter(function(x){return x.id===k;})[0] || CATS[CATS.length-1];\n      return '<div class=\"bar\" style=\"--h:'+c.h+'\"><div class=\"lbl\"><span class=\"dotc\"></span><span>'+esc(c.name)+'</span><i>'+money(byCat[k])+'</i></div>'+\n             '<div class=\"track\"><div class=\"fill\" style=\"width:'+Math.max(6, byCat[k]/max*100)+'%\"></div></div></div>';\n    }).join(\"\");\n  } else el(\"bars\").style.display = \"none\";\n\n  /* list */\n  if (!subs.length){\n    el(\"list\").innerHTML = '<div class=\"empty\"><div class=\"tile\"><svg class=\"i\"><use href=\"#i-repeat\"/></svg></div><b>Track every subscription in one place</b><p>Tap + to add your first — you might be surprised what it all adds up to.</p></div>';\n    return;\n  }\n  var sorted = subs.slice().sort(function(a,b){\n    if (!!a.paused !== !!b.paused) return a.paused ? 1 : -1;\n    return a.next < b.next ? -1 : 1;\n  });\n  el(\"list\").innerHTML = sorted.map(function(s){\n    var c = CATS.filter(function(x){return x.id===s.cat;})[0] || CATS[CATS.length-1];\n    var d = daysUntil(s.next);\n    var when = s.paused ? \"paused\" : (d === 0 ? \"renews today\" : d === 1 ? \"renews tomorrow\" : \"renews in \" + d + \" days\");\n    var cls = s.paused ? \"\" : (d === 0 ? \"today\" : d <= 7 ? \"due\" : \"\");\n    return '<div class=\"sub'+(s.paused?' paused':'')+'\" onclick=\"openSheet(\\''+s.id+'\\')\">'+\n      '<div class=\"tile\" style=\"--h:'+c.h+'\">'+cico(c)+'</div>'+\n      '<div class=\"mid\"><b>'+esc(s.name)+'</b><small class=\"'+cls+'\">'+when+'</small></div>'+\n      '<div class=\"right\"><b>'+money(s.price)+'</b><small>'+CYCLES[s.cycle].name+'</small></div>'+\n    '</div>';\n  }).join(\"\");\n}\n\n/* ---- sheet ---- */\nfunction renderCats(){\n  el(\"f_cats\").innerHTML = CATS.map(function(c){\n    return '<button class=\"chip'+(pickedCat===c.id?' on':'')+'\" type=\"button\" onclick=\"pickCat(\\''+c.id+'\\')\">'+cico(c)+esc(c.name)+'</button>';\n  }).join(\"\");\n}\nfunction pickCat(id){ pickedCat = id; haptic(\"selection\"); renderCats(); }\n\nfunction openSheet(id){\n  editing = id || null;\n  armDelete = false;\n  var s = editing ? subs.filter(function(x){return x.id===editing;})[0] : null;\n  el(\"sheetTitle\").textContent = s ? \"Edit subscription\" : \"New subscription\";\n  el(\"f_name\").value = s ? s.name : \"\";\n  el(\"f_price\").value = s ? s.price : \"\";\n  el(\"f_cycle\").value = s ? s.cycle : \"m\";\n  el(\"f_date\").value = s ? s.next : new Date(Date.now()+86400000*30).toISOString().slice(0,10);\n  pickedCat = s ? s.cat : \"other\";\n  el(\"dangerRow\").style.display = s ? \"flex\" : \"none\";\n  el(\"delBtn\").textContent = \"Delete\";\n  el(\"pauseBtn\").textContent = (s && s.paused) ? \"Resume\" : \"Pause\";\n  renderCats();\n  el(\"veil\").classList.add(\"on\");\n  el(\"sheet\").classList.add(\"on\");\n  haptic(\"light\");\n}\nfunction closeSheet(){\n  el(\"veil\").classList.remove(\"on\");\n  el(\"sheet\").classList.remove(\"on\");\n}\nfunction saveSub(){\n  var name = el(\"f_name\").value.trim();\n  var price = parseFloat(String(el(\"f_price\").value).replace(\",\", \".\"));\n  var date = el(\"f_date\").value;\n  if (!name || !(price > 0) || !date){ haptic(\"light\"); el(\"f_name\").focus(); return; }\n  if (editing){\n    var s = subs.filter(function(x){return x.id===editing;})[0];\n    s.name = name; s.price = price; s.cycle = el(\"f_cycle\").value; s.next = date; s.cat = pickedCat;\n    rollForward(s);\n  } else {\n    var ns = {id:uid(), name:name, price:price, cycle:el(\"f_cycle\").value, next:date, cat:pickedCat, paused:false};\n    rollForward(ns);\n    subs.push(ns);\n  }\n  save(); render(); closeSheet(); haptic(\"success\");\n}\nfunction delSub(){\n  if (!armDelete){ armDelete = true; el(\"delBtn\").textContent = \"Really delete?\"; haptic(\"light\"); return; }\n  subs = subs.filter(function(x){return x.id!==editing;});\n  save(); render(); closeSheet(); haptic(\"success\");\n}\nfunction togglePause(){\n  var s = subs.filter(function(x){return x.id===editing;})[0];\n  if (s){ s.paused = !s.paused; save(); render(); }\n  closeSheet(); haptic(\"selection\");\n}\nfunction setCur(){ currency = el(\"cur\").value; el(\"cur2\").value = currency; save(); render(); }\nel(\"cur2\").onchange = function(){ el(\"cur\").value = el(\"cur2\").value; setCur(); };\n\n/* ---- optional AI audit ---- */\nfunction audit(){\n  if (!window.myllmAsk) return;\n  haptic(\"light\");\n  var ab = el(\"aibtn\"); ab.disabled = true; ab.innerHTML = '<i class=\"spin\"></i><span>Auditing…</span>';\n  var lines = subs.map(function(s){\n    return s.name + \": \" + currency + s.price + \" \" + CYCLES[s.cycle].name + (s.paused ? \" (paused)\" : \"\");\n  }).join(\"; \");\n  var mo = subs.filter(function(s){return !s.paused;}).reduce(function(a,s){return a+monthly(s);},0);\n  var prompt = \"My subscriptions: \" + lines + \". Total ≈ \" + money(mo) + \"/month. \" +\n    \"In under 120 words, give a friendly audit: the yearly total, my biggest costs, any likely overlap (e.g. two music or two TV services), and 1–2 candidates to consider cancelling or switching to yearly billing. Plain text, no markdown.\";\n  myllmAsk(prompt, {system:\"You are a concise, friendly personal-finance helper. Plain text only.\"})\n    .then(function(r){\n      el(\"aitext\").textContent = String(r).trim();\n      el(\"aiout\").classList.add(\"on\");\n      haptic(\"success\");\n    })\n    .catch(function(){\n      el(\"aitext\").textContent = \"The AI couldn't run just now — try again in a moment.\";\n      el(\"aiout\").classList.add(\"on\");\n    })\n    .then(function(){ ab.disabled = false; ab.innerHTML = '<svg class=\"i\"><use href=\"#i-spark\"/></svg><span>AI audit</span>'; });\n}\nfunction hideAi(){ el(\"aiout\").classList.remove(\"on\"); }\n\n/* ---- boot ---- */\nPromise.all([store().getItem(\"subs\"), store().getItem(\"cur\")]).then(function(vals){\n  if (vals[0]){ try{ subs = JSON.parse(vals[0]) || []; }catch(e){} }\n  if (vals[1]){ currency = vals[1]; el(\"cur\").value = currency; el(\"cur2\").value = currency; }\n  var changed = false;\n  subs.forEach(function(s){ if (!s.paused && rollForward(s)) changed = true; });\n  if (changed) save();\n  render();\n});\n</script>\n</body>\n</html>\n"}