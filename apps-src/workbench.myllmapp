{"name": "Workbench", "kind": "html", "iconSymbol": "wrench.and.screwdriver", "iconColor": "indigo", "html": "<!doctype html>\n<!--\n  Workbench — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Workbench</title>\n<!-- Receives files handed over from the MyLLMos Files app (\"Open with an app...\"). -->\n<meta name=\"myllm:intents\" content=\"open-text\">\n<style>\n  *{box-sizing:border-box}\n  body{margin:0;font:16px/1.5 var(--myllm-font,-apple-system,system-ui,sans-serif);\n       background:var(--myllm-bg,#fff);color:var(--myllm-text,#0b0c0f);\n       padding:0 0 env(safe-area-inset-bottom)}\n  header{position:sticky;top:0;z-index:5;background:var(--myllm-bg,#fff);\n         border-bottom:1px solid var(--myllm-border,rgba(0,0,0,.12));padding:12px 16px}\n  h1{margin:0;font-size:17px;font-weight:650;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n  h2{margin:0 0 4px;font-size:20px;font-weight:700}\n  h3{margin:2px 0 4px}\n  .sub{font-size:12px;color:var(--myllm-muted,#5b6270);margin-top:2px;\n       overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n  .tabs{display:flex;gap:6px;padding:10px 16px;overflow-x:auto}\n  /* display:flex outranks the UA rule for [hidden], so the tab strip stayed on\n     screen with no document open until this said otherwise. */\n  .tabs[hidden]{display:none}\n  .tab{border:0;background:var(--myllm-surface,#f4f5f7);color:var(--myllm-text,#111);\n       border-radius:999px;padding:7px 13px;font-size:13.5px;font-weight:600;white-space:nowrap}\n  .tab[aria-selected=\"true\"]{background:var(--myllm-accent,#4f7cff);color:#fff}\n  main{padding:0 16px 104px}\n  .hero{padding:26px 12px 6px;text-align:center;color:var(--myllm-muted,#5b6270)}\n  .hero .big{font-size:44px;margin-bottom:8px}\n  .hero h2{color:var(--myllm-text,#0b0c0f)}\n  pre,textarea{white-space:pre-wrap;word-wrap:break-word;font:13.5px/1.55 ui-monospace,SFMono-Regular,Menlo,monospace}\n  textarea{width:100%;min-height:58vh;border:1px solid var(--myllm-border,#ddd);\n           border-radius:var(--myllm-radius,14px);padding:12px;background:var(--myllm-surface,#fafafa);\n           color:inherit;resize:vertical}\n  table{border-collapse:collapse;width:100%;font-size:13.5px}\n  th,td{border:1px solid var(--myllm-border,rgba(0,0,0,.12));padding:6px 8px;text-align:left;vertical-align:top}\n  th{background:var(--myllm-surface,#f4f5f7);position:sticky;top:0}\n  .scroll{overflow:auto;max-width:100%;border-radius:10px}\n  .md h1,.md h2,.md h3{line-height:1.25}\n  .md code{background:var(--myllm-surface,#f0f1f3);padding:1px 5px;border-radius:5px;font-size:13px}\n  .md pre{background:var(--myllm-surface,#f0f1f3);padding:12px;border-radius:10px;overflow:auto}\n  .md blockquote{margin:0;padding-left:12px;border-left:3px solid var(--myllm-border,#ddd);color:var(--myllm-muted,#5b6270)}\n  .md table{margin:10px 0}\n  .k{color:var(--myllm-accent,#4f7cff)}\n  .bar{position:fixed;left:0;right:0;bottom:0;display:flex;gap:4px;padding:6px 8px calc(6px + env(safe-area-inset-bottom));\n       background:var(--myllm-bg,#fff);border-top:1px solid var(--myllm-border,rgba(0,0,0,.12));z-index:10}\n  .tb{flex:1;border:0;background:transparent;color:var(--myllm-text,#111);border-radius:10px;\n      display:flex;flex-direction:column;align-items:center;gap:3px;padding:6px 2px;\n      font-size:10.5px;font-weight:600;line-height:1.1}\n  .tb .g{font-size:19px;line-height:1}\n  .tb:disabled{opacity:.34}\n  .btn{flex:1;border:0;border-radius:12px;padding:12px 10px;font-size:14.5px;font-weight:650;\n       background:var(--myllm-surface,#eef0f4);color:var(--myllm-text,#111)}\n  .btn.primary{background:var(--myllm-accent,#4f7cff);color:#fff}\n  .btn:disabled{opacity:.45}\n  .note{font-size:12.5px;color:var(--myllm-muted,#5b6270);padding:8px 0}\n  .sheet{position:fixed;inset:0;background:rgba(0,0,0,.35);display:none;align-items:flex-end;z-index:20}\n  .sheet.show{display:flex}\n  .sheetcard{background:var(--myllm-bg,#fff);width:100%;border-radius:18px 18px 0 0;padding:16px;max-height:86vh;overflow:auto}\n  input[type=text],select{width:100%;padding:11px;border-radius:10px;border:1px solid var(--myllm-border,#ddd);\n                   background:var(--myllm-surface,#fafafa);color:inherit;font-size:15px;font-family:inherit}\n\n  /* ---------- starting a document ---------- */\n  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(102px,1fr));gap:8px;margin:6px 0 4px}\n  .card{border:1px solid var(--myllm-border,rgba(0,0,0,.14));background:var(--myllm-surface,#f4f5f7);\n        color:var(--myllm-text,#111);border-radius:12px;padding:12px 6px;\n        display:flex;flex-direction:column;align-items:center;gap:6px;\n        font-family:inherit;font-size:12.5px;font-weight:600;text-align:center}\n  .card .g{font-size:22px;line-height:1}\n  .card[aria-pressed=\"true\"]{background:var(--myllm-accent,#4f7cff);color:#fff;border-color:transparent}\n  .rows{margin:2px 0 10px}\n  .row{display:flex;align-items:center;gap:10px;width:100%;text-align:left;border:0;background:transparent;\n       color:inherit;font-family:inherit;padding:11px 6px;\n       border-bottom:1px solid var(--myllm-border,rgba(0,0,0,.08))}\n  .row .g{font-size:17px;line-height:1}\n  .row .nm{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:14.5px;font-weight:600}\n  .row .mt{font-size:11.5px;color:var(--myllm-muted,#5b6270);white-space:nowrap}\n  .banner{border:1px solid var(--myllm-border,rgba(0,0,0,.14));border-radius:12px;padding:12px;\n          background:var(--myllm-surface,#f4f5f7);margin:10px 0;font-size:13.5px}\n  .banner .acts{display:flex;gap:8px;margin-top:10px}\n  .stack{display:flex;flex-direction:column;gap:8px}\n  .stack .btn{flex:none;text-align:left;padding:13px 14px}\n\n  /* ---------- typography ----------\n     Reading settings live on one wrapper as custom properties, so the rendered\n     view, the raw view and the editor all inherit exactly the same type without\n     three sets of rules drifting apart. */\n  #doc{--doc-font:var(--myllm-font,-apple-system,system-ui,sans-serif);\n       --doc-size:16px;--doc-line:1.6;--doc-width:100%;--doc-align:left}\n  #doc, #doc .md, #doc pre, #doc textarea{\n       font-family:var(--doc-font);font-size:var(--doc-size);line-height:var(--doc-line);\n       text-align:var(--doc-align)}\n  /* Descendant, not child: the views render inside #main, so a child selector\n     silently left the column-width setting doing nothing outside Markdown. */\n  #doc .md, #doc #main > pre, #doc .scroll, #doc #main > textarea{\n       max-width:var(--doc-width);margin-left:auto;margin-right:auto}\n  #doc.paper{background:#fbf7ef;color:#33302b;border-radius:12px;padding:14px 16px}\n  #doc.paper pre,#doc.paper code{background:#f2ece0}\n  /* Justified text needs hyphenation or it opens rivers of whitespace on a phone. */\n  #doc[data-align=\"justify\"] .md p{hyphens:auto;-webkit-hyphens:auto}\n  /* The start screen is furniture, not the document: it keeps its own type. */\n  #doc .hero,#doc .card,#doc .row,#doc .note,#doc .banner,#doc .lbl{\n       font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);text-align:initial}\n  #doc .hero{text-align:center}\n  .fmtbar{display:flex;gap:6px;overflow-x:auto;padding:8px 0 10px;position:sticky;top:0;\n          background:var(--myllm-bg,#fff);z-index:3}\n  .fmt{border:1px solid var(--myllm-border,rgba(0,0,0,.14));background:var(--myllm-surface,#f4f5f7);\n       color:var(--myllm-text,#111);border-radius:9px;min-width:38px;height:34px;font-size:14px;font-weight:700}\n  .fmt.wide{padding:0 10px;font-weight:600}\n  .seg{display:flex;gap:6px;flex-wrap:wrap;margin:6px 0 2px}\n  .seg button{flex:1;min-width:74px;border:1px solid var(--myllm-border,rgba(0,0,0,.14));\n              background:var(--myllm-surface,#f4f5f7);color:var(--myllm-text,#111);\n              border-radius:10px;padding:9px 8px;font-size:13.5px;font-weight:600}\n  .seg button[aria-pressed=\"true\"]{background:var(--myllm-accent,#4f7cff);color:#fff;border-color:transparent}\n  .lbl{font-size:12.5px;font-weight:700;color:var(--myllm-muted,#5b6270);\n       text-transform:uppercase;letter-spacing:.04em;margin:14px 0 2px}\n  input[type=range]{width:100%;accent-color:var(--myllm-accent,#4f7cff)}\n  .sample{border:1px dashed var(--myllm-border,#ddd);border-radius:10px;padding:10px;margin-top:12px}\n</style><style>:root{--build-id:\"4a4a3b52da\";}</style>\n</head>\n<body>\n\n<header>\n  <div style=\"display:flex;align-items:center;gap:10px\">\n    <div style=\"min-width:0;flex:1\">\n      <h1 id=\"title\">Workbench</h1>\n      <div class=\"sub\" id=\"sub\">Start a document, or open one from your workspace</div>\n    </div>\n    <button class=\"fmt wide\" id=\"typeBtn\" onclick=\"openType()\" aria-label=\"Text settings\"\n            style=\"height:38px;font-size:15px\">Aa</button>\n  </div>\n</header>\n\n<div class=\"tabs\" id=\"tabs\" hidden>\n  <button class=\"tab\" id=\"tabView\" onclick=\"setMode('view')\" aria-selected=\"true\">View</button>\n  <button class=\"tab\" id=\"tabEdit\" onclick=\"setMode('edit')\" aria-selected=\"false\">Edit</button>\n  <button class=\"tab\" id=\"tabRaw\" onclick=\"setMode('raw')\" aria-selected=\"false\">Source</button>\n</div>\n\n<main id=\"doc\">\n <div id=\"main\"></div>\n</main>\n\n<div class=\"bar\" id=\"bar\">\n  <button class=\"tb\" onclick=\"openNew()\"><span class=\"g\">&#43;</span>New</button>\n  <button class=\"tb\" onclick=\"openBrowse()\"><span class=\"g\">&#128194;</span>Open</button>\n  <button class=\"tb\" id=\"saveBtn\" onclick=\"save()\" disabled><span class=\"g\">&#128190;</span>Save</button>\n  <button class=\"tb\" id=\"moreBtn\" onclick=\"openMore()\" disabled><span class=\"g\">&#8943;</span>More</button>\n  <button class=\"tb\" id=\"askBtn\" onclick=\"askAI()\" disabled><span class=\"g\">&#10024;</span>Ask</button>\n</div>\n\n<div class=\"sheet\" id=\"new\">\n  <div class=\"sheetcard\">\n    <h3>New document</h3>\n    <p class=\"note\" style=\"padding-top:0\">It is created in your shared workspace straight away, so it is never lost before the first save.</p>\n    <div class=\"lbl\">Kind</div>\n    <div class=\"grid\" id=\"newTpl\"></div>\n    <div class=\"lbl\">Name</div>\n    <input type=\"text\" id=\"newName\" placeholder=\"Untitled\">\n    <div class=\"lbl\">Folder</div>\n    <select id=\"newFolder\"></select>\n    <div style=\"display:flex;gap:8px;margin-top:14px\">\n      <button class=\"btn primary\" onclick=\"commitNew()\">Create</button>\n      <button class=\"btn\" onclick=\"closeSheet('new')\">Cancel</button>\n    </div>\n    <div class=\"note\" id=\"newStatus\"></div>\n  </div>\n</div>\n\n<div class=\"sheet\" id=\"browse\">\n  <div class=\"sheetcard\">\n    <h3>Open a document</h3>\n    <input type=\"text\" id=\"browseQ\" placeholder=\"Search your workspace\" oninput=\"paintBrowse()\">\n    <div class=\"rows\" id=\"browseList\"></div>\n    <button class=\"btn\" onclick=\"closeSheet('browse')\">Cancel</button>\n  </div>\n</div>\n\n<div class=\"sheet\" id=\"more\">\n  <div class=\"sheetcard\">\n    <h3 id=\"moreTitle\">Document</h3>\n    <div class=\"stack\" style=\"margin-top:10px\">\n      <button class=\"btn\" onclick=\"closeSheet('more');openSaveAs()\">Save a copy, or in another format...</button>\n      <button class=\"btn\" onclick=\"closeSheet('more');openExport()\">Export and share...</button>\n      <button class=\"btn\" onclick=\"closeSheet('more');openRename()\">Rename or move...</button>\n      <button class=\"btn\" onclick=\"closeSheet('more');closeDoc()\">Close document</button>\n      <button class=\"btn primary\" onclick=\"closeSheet('more')\">Done</button>\n    </div>\n  </div>\n</div>\n\n<div class=\"sheet\" id=\"type\">\n  <div class=\"sheetcard\">\n    <h3>Text</h3>\n    <p class=\"note\" style=\"padding-top:0\">Applies to reading, the source view and the editor. Remembered for next time.</p>\n\n    <div class=\"lbl\">Typeface</div>\n    <div class=\"seg\" id=\"segFont\"></div>\n\n    <div class=\"lbl\">Size <span id=\"sizeVal\" style=\"font-weight:600\"></span></div>\n    <input type=\"range\" id=\"rngSize\" min=\"13\" max=\"26\" step=\"1\" oninput=\"setType('size', +this.value)\">\n\n    <div class=\"lbl\">Line spacing <span id=\"lineVal\" style=\"font-weight:600\"></span></div>\n    <input type=\"range\" id=\"rngLine\" min=\"12\" max=\"22\" step=\"1\" oninput=\"setType('line', +this.value/10)\">\n\n    <div class=\"lbl\">Column width</div>\n    <div class=\"seg\" id=\"segWidth\"></div>\n\n    <div class=\"lbl\">Alignment</div>\n    <div class=\"seg\" id=\"segAlign\"></div>\n\n    <div class=\"lbl\">Page</div>\n    <div class=\"seg\" id=\"segTheme\"></div>\n\n    <div class=\"sample\" id=\"sample\">The quick brown fox jumps over the lazy dog. 0123456789</div>\n\n    <div style=\"display:flex;gap:8px;margin-top:14px\">\n      <button class=\"btn\" onclick=\"resetType()\">Reset</button>\n      <button class=\"btn primary\" onclick=\"closeSheet('type')\">Done</button>\n    </div>\n  </div>\n</div>\n\n<div class=\"sheet\" id=\"saveAs\">\n  <div class=\"sheetcard\">\n    <h3>Save a copy</h3>\n    <p class=\"note\" style=\"padding-top:0\">Choose a path inside your shared workspace. Folders are created as needed.</p>\n    <div class=\"lbl\">Format</div>\n    <select id=\"saveAsFmt\" onchange=\"saveAsFmtChanged()\"></select>\n    <div class=\"lbl\">Path</div>\n    <input type=\"text\" id=\"saveAsPath\" placeholder=\"notes/2026/copy.md\">\n    <div class=\"note\" id=\"saveAsNote\"></div>\n    <div style=\"display:flex;gap:8px;margin-top:6px\">\n      <button class=\"btn primary\" onclick=\"commitSaveAs()\">Save</button>\n      <button class=\"btn\" onclick=\"closeSheet('saveAs')\">Cancel</button>\n    </div>\n    <div class=\"note\" id=\"saveAsStatus\"></div>\n  </div>\n</div>\n\n<div class=\"sheet\" id=\"export\">\n  <div class=\"sheetcard\">\n    <h3>Export and share</h3>\n    <p class=\"note\" style=\"padding-top:0\">Sends a copy out of MyLLM through the iOS share sheet &mdash; Mail, Messages, Files, AirDrop. The workspace copy is untouched.</p>\n    <div class=\"lbl\">Format</div>\n    <div class=\"seg\" id=\"expFmt\"></div>\n    <div class=\"note\" id=\"expNote\"></div>\n    <div style=\"display:flex;gap:8px;margin-top:6px\">\n      <button class=\"btn primary\" onclick=\"commitExport()\">Share</button>\n      <button class=\"btn\" onclick=\"closeSheet('export')\">Cancel</button>\n    </div>\n    <div class=\"note\" id=\"expStatus\"></div>\n  </div>\n</div>\n\n<div class=\"sheet\" id=\"rename\">\n  <div class=\"sheetcard\">\n    <h3>Rename or move</h3>\n    <p class=\"note\" style=\"padding-top:0\">Changes where the file lives in your workspace. Include a folder to move it.</p>\n    <input type=\"text\" id=\"renamePath\" placeholder=\"notes/2026/report.md\">\n    <div style=\"display:flex;gap:8px;margin-top:12px\">\n      <button class=\"btn primary\" onclick=\"commitRename()\">Rename</button>\n      <button class=\"btn\" onclick=\"closeSheet('rename')\">Cancel</button>\n    </div>\n    <div class=\"note\" id=\"renameStatus\"></div>\n  </div>\n</div>\n\n<div class=\"sheet\" id=\"unsaved\">\n  <div class=\"sheetcard\">\n    <h3>Unsaved changes</h3>\n    <p class=\"note\" style=\"padding-top:0\" id=\"unsavedNote\">This document has edits that are not saved yet.</p>\n    <div class=\"stack\" style=\"margin-top:6px\">\n      <button class=\"btn primary\" onclick=\"guardSave()\">Save, then continue</button>\n      <button class=\"btn\" onclick=\"guardDiscard()\">Discard the changes</button>\n      <button class=\"btn\" onclick=\"guardCancel()\">Stay here</button>\n    </div>\n  </div>\n</div>\n\n<script>\nvar files = window.myllmFiles || null;\nvar current = null;          /* {name, path, ext, text} */\nvar edited = '';             /* working copy while editing */\nvar mode = 'view';\nvar recents = [];\nvar draft = null;            /* crash-recovery copy of unsaved edits */\nvar pendingGuard = null;     /* what to do once unsaved changes are dealt with */\nvar allFiles = [];           /* last workspace listing, for the Open sheet */\n\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s==null?'':s)\n  .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }\nfunction haptic(k){ try{ window.myllmHaptic && myllmHaptic(k); }catch(e){} }\nfunction closeSheet(id){ el(id).classList.remove('show'); }\nfunction extOf(p){ var b = String(p||'').split('/').pop(); return b.indexOf('.')>0 ? b.split('.').pop().toLowerCase() : ''; }\nfunction dirty(){ return !!current && edited !== current.text; }\nfunction words(s){ var m = String(s||'').match(/\\S+/g); return m ? m.length : 0; }\nfunction today(){ return new Date().toISOString().slice(0,10); }\n\n/* ---------- receiving a file (how this app started life) ----------\n   The Files app routes an \"open-text\" intent through the MyLLMos intent bus and\n   the payload lands here. The declaration is the myllm:intents meta tag in the\n   head; without it the router would never offer this app as a destination.\n   (Written as prose on purpose: the router parses the document as TEXT, so a\n   literal meta tag in a comment shows up as a second declaration.) */\nif (window.myllmIntent && myllmIntent.receive) {\n  myllmIntent.receive(function (intent) {\n    if (!intent || intent.action !== 'open-text' || !intent.data) return;\n    guard(function(){ openDoc(intent.data); });\n  });\n}\n\n/* ================= documents =================\n   A document app that can only open what someone else hands it is a viewer.\n   Workbench owns the whole life of a file now: start it, open it, edit it,\n   save it, save it again in another format, send it out of the app. */\n\nvar FORMATS = [\n  { ext:'md',   label:'Markdown',   mime:'text/markdown' },\n  { ext:'txt',  label:'Plain text', mime:'text/plain' },\n  { ext:'html', label:'Web page',   mime:'text/html' },\n  { ext:'csv',  label:'CSV',        mime:'text/csv' },\n  { ext:'json', label:'JSON',       mime:'application/json' }\n];\n\nvar TEMPLATES = [\n  { id:'blank',   g:'\\u{1F4C4}', label:'Blank',    ext:'md',   name:'Untitled', body:'' },\n  { id:'doc',     g:'\\u{1F4DD}', label:'Document', ext:'md',   name:'Document',\n    body:'# Title\\n\\nStart writing here.\\n\\n## A section\\n\\n- a point\\n- another point\\n' },\n  { id:'meeting', g:'\\u{1F5D3}', label:'Meeting',  ext:'md',   name:'Meeting notes',\n    body:'# Meeting — {{date}}\\n\\n**Present:** \\n\\n## Notes\\n\\n- \\n\\n## Actions\\n\\n- [ ] \\n' },\n  { id:'list',    g:'☑',     label:'Checklist',ext:'md',   name:'Checklist',\n    body:'# Checklist\\n\\n- [ ] First thing\\n- [ ] Second thing\\n- [x] Already done\\n' },\n  { id:'plain',   g:'Aa',        label:'Plain text',ext:'txt', name:'Notes', body:'' },\n  { id:'table',   g:'\\u{1F4CA}', label:'Table',    ext:'csv',  name:'Table',\n    body:'Name,Value,Notes\\n' },\n  { id:'data',    g:'{ }',       label:'JSON',     ext:'json', name:'Data',\n    body:'{\\n  \"items\": []\\n}\\n' },\n  { id:'page',    g:'\\u{1F310}', label:'Web page', ext:'html', name:'Page',\n    body:'<!doctype html>\\n<html lang=\"en\">\\n<head><meta charset=\"utf-8\"><title>Page</title></head>\\n<body>\\n<h1>Page</h1>\\n</body>\\n</html>\\n' }\n];\nvar newTplId = 'blank';\n\n/* Text-ish files the Open sheet offers. Anything else in the workspace is a\n   photo, a recording or a bundle, and opening it here would show mojibake. */\nvar TEXTY = ['md','markdown','txt','text','csv','tsv','json','log','html','htm',\n             'xml','yml','yaml','ini','conf','cfg','js','css','py','sh','srt','rtf'];\n\nfunction openDoc(d, m){\n  current = { name: d.name || 'Untitled', path: d.path || '',\n              ext: String(d.ext||'').toLowerCase(), text: String(d.text||'') };\n  if (!current.ext && current.path) current.ext = extOf(current.path);\n  edited = current.text;\n  el('title').textContent = current.name;\n  el('tabs').hidden = false;\n  setMode(m || 'view');\n  pushRecent(current.path);\n  updateSub(); updateBar();\n  haptic('selection');\n}\n\nfunction closeDoc(){\n  current = null; edited = ''; clearDraft();\n  el('title').textContent = 'Workbench';\n  el('tabs').hidden = true;\n  renderStart();\n  updateSub(); updateBar();\n}\n\nfunction updateSub(msg){\n  if (!current){\n    el('sub').textContent = 'Start a document, or open one from your workspace';\n    return;\n  }\n  var bits = [ current.path || 'not saved anywhere yet' ];\n  if (msg) bits.push(msg);\n  else if (dirty()) bits.push('edited');\n  if (current.ext === 'csv' || current.ext === 'tsv') bits.push(Math.max(0, parseCSV(edited).length - 1) + ' rows');\n  else bits.push(words(edited) + ' words');\n  bits.push(kindLabel(current.ext));\n  el('sub').textContent = bits.join(' · ');\n}\n\nfunction updateBar(){\n  el('saveBtn').disabled = !current || (!dirty() && !!current.path);\n  el('moreBtn').disabled = !current;\n  el('askBtn').disabled  = !current;\n}\n\n/* Anything that would throw away edits goes through here first. A MyLLMos app\n   gets no browser dialogs - the OS suppresses them - so it is an in-page sheet. */\nfunction guard(fn){\n  if (!dirty()) { fn(); return; }\n  pendingGuard = fn;\n  el('unsavedNote').textContent = current.path\n    ? ('\"' + current.name + '\" has edits that are not saved yet.')\n    : 'This document has never been saved.';\n  el('unsaved').classList.add('show');\n}\nasync function guardSave(){\n  await save();\n  if (dirty()) return;              /* save failed - leave the sheet up */\n  closeSheet('unsaved');\n  var f = pendingGuard; pendingGuard = null; if (f) f();\n}\nfunction guardDiscard(){\n  closeSheet('unsaved');\n  if (current) edited = current.text;\n  clearDraft(); updateBar(); render();\n  var f = pendingGuard; pendingGuard = null; if (f) f();\n}\nfunction guardCancel(){ closeSheet('unsaved'); pendingGuard = null; }\n\n/* ---------- start screen ---------- */\n\nfunction renderStart(){\n  var m = el('main');\n  var html = '<div class=\"hero\"><div class=\"big\">&#129520;</div>'\n    + '<h2>Workbench</h2>'\n    + '<p class=\"note\">Write something new, open a document from your shared workspace, '\n    + 'or send a file here from the <b>Files</b> app with <b>Open with an app</b>.</p></div>';\n  if (draft) html += draftBanner();\n  html += '<div class=\"lbl\">Start something</div><div class=\"grid\" id=\"startGrid\">'\n    + TEMPLATES.map(function(t){\n        return '<button class=\"card\" data-t=\"' + t.id + '\"><span class=\"g\">' + esc(t.g) + '</span>'\n             + esc(t.label) + '</button>';\n      }).join('') + '</div>';\n  html += '<div class=\"lbl\">Recent</div>' + recentRows();\n  m.innerHTML = html;\n  Array.prototype.forEach.call(m.querySelectorAll('.card[data-t]'), function(b){\n    b.onclick = function(){ openNew(b.getAttribute('data-t')); };\n  });\n  Array.prototype.forEach.call(m.querySelectorAll('.row[data-p]'), function(b){\n    b.onclick = function(){ openPath(b.getAttribute('data-p')); };\n  });\n  var r = el('draftRestore'); if (r) r.onclick = restoreDraft;\n  var d = el('draftDrop');    if (d) d.onclick = function(){ clearDraft(); renderStart(); };\n}\n\nfunction recentRows(){\n  if (!recents.length) return '<p class=\"note\">Nothing yet. What you open or create shows up here.</p>';\n  return '<div class=\"rows\">' + recents.map(function(p){\n    var name = p.split('/').pop(), dir = p.indexOf('/') > -1 ? p.slice(0, p.lastIndexOf('/')) : '';\n    return '<button class=\"row\" data-p=\"' + esc(p) + '\"><span class=\"g\">' + esc(glyphFor(extOf(p))) + '</span>'\n      + '<span class=\"nm\">' + esc(name) + '</span>'\n      + '<span class=\"mt\">' + esc(dir || 'root') + '</span></button>';\n  }).join('') + '</div>';\n}\n\nfunction glyphFor(ext){\n  if (ext==='csv'||ext==='tsv') return '\\u{1F4CA}';\n  if (ext==='json') return '{ }';\n  if (ext==='html'||ext==='htm') return '\\u{1F310}';\n  if (ext==='md'||ext==='markdown') return '\\u{1F4DD}';\n  if (ext==='log') return '\\u{1F50E}';\n  return '\\u{1F4C4}';\n}\n\n/* ---------- recents ---------- */\n\nasync function loadRecents(){\n  try{\n    if (!window.myllmStorage) return;\n    var raw = await myllmStorage.getItem('wb.recent');\n    if (raw) recents = (JSON.parse(raw) || []).filter(function(x){ return typeof x === 'string'; });\n  }catch(e){}\n}\nfunction pushRecent(p){\n  if (!p) return;\n  recents = [p].concat(recents.filter(function(x){ return x !== p; })).slice(0, 10);\n  try{ window.myllmStorage && myllmStorage.setItem('wb.recent', JSON.stringify(recents)); }catch(e){}\n}\nfunction dropRecent(p){\n  recents = recents.filter(function(x){ return x !== p; });\n  try{ window.myllmStorage && myllmStorage.setItem('wb.recent', JSON.stringify(recents)); }catch(e){}\n}\n\n/* ---------- draft recovery ----------\n   A web view can be torn down while you are mid-paragraph. Every edit is\n   mirrored into app storage on a short delay, so the words survive even though\n   the file on disk has not been written. It is offered, never applied silently -\n   a draft that overwrites a file the user has since changed elsewhere would be\n   the worse bug. */\nvar draftTimer = null;\nfunction queueDraft(){\n  if (draftTimer) clearTimeout(draftTimer);\n  draftTimer = setTimeout(function(){\n    if (!current) return;\n    try{\n      window.myllmStorage && myllmStorage.setItem('wb.draft', JSON.stringify({\n        name: current.name, path: current.path, ext: current.ext, text: edited, at: Date.now()\n      }));\n    }catch(e){}\n  }, 900);\n}\nfunction clearDraft(){\n  draft = null;\n  if (draftTimer) { clearTimeout(draftTimer); draftTimer = null; }\n  try{\n    if (window.myllmStorage){\n      if (myllmStorage.removeItem) myllmStorage.removeItem('wb.draft');\n      else myllmStorage.setItem('wb.draft', '');\n    }\n  }catch(e){}\n}\nasync function loadDraft(){\n  try{\n    if (!window.myllmStorage) return;\n    var raw = await myllmStorage.getItem('wb.draft');\n    if (!raw) return;\n    var d = JSON.parse(raw);\n    if (d && typeof d.text === 'string' && d.text.length) draft = d;\n  }catch(e){}\n}\nfunction draftBanner(){\n  return '<div class=\"banner\"><b>Unsaved work recovered.</b><br>'\n    + esc(draft.name || 'A document') + ' · ' + words(draft.text) + ' words, from when the app last closed.'\n    + '<div class=\"acts\"><button class=\"btn primary\" id=\"draftRestore\">Open it</button>'\n    + '<button class=\"btn\" id=\"draftDrop\">Discard</button></div></div>';\n}\nfunction restoreDraft(){\n  var d = draft;\n  clearDraft();\n  openDoc({ name: d.name, path: d.path, ext: d.ext, text: d.text }, 'edit');\n  /* The file on disk still holds the old text, so this counts as unsaved. */\n  if (d.path && files){\n    files.read(d.path).then(function(onDisk){\n      if (onDisk != null && current && current.path === d.path){\n        current.text = onDisk; updateBar(); updateSub();\n      }\n    }).catch(function(){});\n  }\n}\n\n/* ---------- new ---------- */\n\nfunction openNew(tplId){\n  guard(function(){\n    if (tplId) newTplId = tplId;\n    paintNewTpl();\n    var t = tpl();\n    el('newName').value = t.name;\n    el('newStatus').textContent = '';\n    paintFolders('newFolder', folderOf(current && current.path));\n    el('new').classList.add('show');\n  });\n}\nfunction tpl(){ return TEMPLATES.filter(function(x){ return x.id === newTplId; })[0] || TEMPLATES[0]; }\nfunction paintNewTpl(){\n  var c = el('newTpl');\n  c.innerHTML = TEMPLATES.map(function(t){\n    return '<button class=\"card\" aria-pressed=\"' + (t.id===newTplId) + '\" data-t=\"' + t.id + '\">'\n      + '<span class=\"g\">' + esc(t.g) + '</span>' + esc(t.label) + '</button>';\n  }).join('');\n  Array.prototype.forEach.call(c.querySelectorAll('.card[data-t]'), function(b){\n    b.onclick = function(){\n      var prev = tpl();\n      newTplId = b.getAttribute('data-t');\n      var name = el('newName').value.trim();\n      if (!name || name === prev.name) el('newName').value = tpl().name;\n      paintNewTpl(); haptic('selection');\n    };\n  });\n}\nfunction folderOf(p){\n  if (!p || p.indexOf('/') < 0) return '/';\n  return p.slice(0, p.lastIndexOf('/'));\n}\nasync function paintFolders(selectId, chosen){\n  var opts = ['/'];\n  try{\n    if (files && files.folders){\n      var f = await files.folders();\n      opts = ['/'].concat((f || []).map(String).sort());\n    }\n  }catch(e){}\n  el(selectId).innerHTML = opts.map(function(p){\n    return '<option value=\"' + esc(p) + '\"' + (p === chosen ? ' selected' : '') + '>'\n      + esc(p === '/' ? 'Workspace root' : p) + '</option>';\n  }).join('');\n}\nfunction safeName(s){\n  return String(s||'').replace(/[\\/\\\\:*?\"<>|]/g,'-').replace(/\\s+/g,' ').trim();\n}\nasync function uniquePath(folder, stem, ext){\n  var dir = (folder && folder !== '/') ? folder.replace(/^\\/+|\\/+$/g,'') + '/' : '';\n  stem = stem.replace(new RegExp('\\\\.' + ext + '$', 'i'), '');\n  var p = dir + stem + '.' + ext, n = 2;\n  if (!files) return p;\n  try{\n    while (await files.exists(p)) { p = dir + stem + ' ' + n + '.' + ext; if (++n > 99) break; }\n  }catch(e){}\n  return p;\n}\nasync function commitNew(){\n  var t = tpl();\n  var stem = safeName(el('newName').value) || t.name;\n  var body = t.body.replace('{{date}}', today());\n  try{\n    var path = await uniquePath(el('newFolder').value, stem, t.ext);\n    if (files) await files.write(path, body);\n    closeSheet('new');\n    openDoc({ name: path.split('/').pop(), path: files ? path : '', ext: t.ext, text: body }, 'edit');\n    if (!files) updateSub('shared files are off - use Export to get this out');\n  }catch(e){\n    el('newStatus').textContent = 'Could not create it: ' + e.message; haptic('error');\n  }\n}\n\n/* ---------- open ---------- */\n\nfunction openBrowse(){\n  guard(async function(){\n    el('browseQ').value = '';\n    el('browseList').innerHTML = '<p class=\"note\">Reading your workspace...</p>';\n    el('browse').classList.add('show');\n    if (!files){\n      el('browseList').innerHTML = '<p class=\"note\">Shared files are off for apps, so there is nothing to browse. '\n        + 'Turn them on in MyLLM settings, or send a file here from the Files app.</p>';\n      return;\n    }\n    try{\n      var list = await files.list();\n      /* The store lists [{path,size,modified}], but the Android bridge and older\n         builds have handed back bare path strings - normalise before reading. */\n      allFiles = (list || []).map(function(f){\n          return (typeof f === 'string') ? { path: f, size: 0, modified: 0 } : f;\n        })\n        .filter(function(f){ return f && f.path && TEXTY.indexOf(extOf(f.path)) > -1; })\n        .sort(function(a,b){ return (b.modified||0) - (a.modified||0); });\n      paintBrowse();\n    }catch(e){\n      el('browseList').innerHTML = '<p class=\"note\">Could not read the workspace: ' + esc(e.message) + '</p>';\n    }\n  });\n}\n\nfunction paintBrowse(){\n  var q = el('browseQ').value.trim().toLowerCase();\n  var rows = allFiles.filter(function(f){ return !q || f.path.toLowerCase().indexOf(q) > -1; }).slice(0, 200);\n  if (!rows.length){\n    el('browseList').innerHTML = '<p class=\"note\">' + (allFiles.length\n      ? 'Nothing matches that.'\n      : 'No text documents in your workspace yet. Create one with New.') + '</p>';\n    return;\n  }\n  el('browseList').innerHTML = rows.map(function(f){\n    return '<button class=\"row\" data-p=\"' + esc(f.path) + '\"><span class=\"g\">' + esc(glyphFor(extOf(f.path))) + '</span>'\n      + '<span class=\"nm\">' + esc(f.path) + '</span>'\n      + '<span class=\"mt\">' + esc(sizeLabel(f.size) + (f.modified ? ' · ' + dateLabel(f.modified) : '')) + '</span></button>';\n  }).join('');\n  Array.prototype.forEach.call(el('browseList').querySelectorAll('.row[data-p]'), function(b){\n    b.onclick = function(){ openPath(b.getAttribute('data-p')); };\n  });\n}\n\n/* The store has reported `modified` in seconds on one platform and milliseconds\n   on another; anything below this threshold is plainly seconds. */\nfunction dateLabel(t){\n  var ms = t < 1e11 ? t * 1000 : t;\n  var d = new Date(ms);\n  return isNaN(d.getTime()) ? '' : d.toISOString().slice(0,10);\n}\nfunction sizeLabel(n){\n  n = n || 0;\n  return n < 1024 ? n + ' B' : (n / 1024).toFixed(1) + ' KB';\n}\n\nasync function openPath(p){\n  if (!files) return;\n  try{\n    var txt = await files.read(p);\n    if (txt == null){\n      dropRecent(p);\n      updateSub('that file is gone');\n      if (!current) renderStart();\n      closeSheet('browse');\n      return;\n    }\n    closeSheet('browse');\n    guard(function(){\n      openDoc({ name: p.split('/').pop(), path: p, ext: extOf(p), text: String(txt) });\n    });\n  }catch(e){ updateSub('could not open it: ' + e.message); haptic('error'); }\n}\n\nfunction human(n){ return n < 1024 ? n + ' chars' : (n/1024).toFixed(1) + ' KB'; }\n\n/* ================= typography =================\n   A document app that can't change its type is a viewer, not a workbench -\n   reading a long note at the system default in a sans stack is the thing people\n   actually complain about. Settings persist per app via myllmStorage.\n\n   Defaults are seeded from myllmTheme where MyLLM already knows the answer:\n   if the user asked the OS for larger text or a readable font, start there\n   rather than making them say it twice. */\nvar FONTS = [\n  { id:'system', label:'System', css:\"var(--myllm-font,-apple-system,system-ui,sans-serif)\" },\n  { id:'serif',  label:'Serif',  css:\"'Iowan Old Style','Palatino','Georgia',serif\" },\n  { id:'mono',   label:'Mono',   css:\"ui-monospace,SFMono-Regular,Menlo,monospace\" },\n  { id:'read',   label:'Readable', css:\"'Comic Sans MS','Chalkboard SE','Trebuchet MS',system-ui,sans-serif\" }\n];\nvar WIDTHS = [ {id:'narrow',label:'Narrow',css:'34em'}, {id:'normal',label:'Normal',css:'46em'}, {id:'full',label:'Full',css:'100%'} ];\nvar ALIGNS = [ {id:'left',label:'Left'}, {id:'justify',label:'Justified'} ];\nvar THEMES = [ {id:'default',label:'Default'}, {id:'paper',label:'Paper'} ];\n\nvar type = { font:'system', size:16, line:1.6, width:'full', align:'left', theme:'default' };\n\nfunction themeDefaults(){\n  var t = window.myllmTheme || {};\n  if (t.largeText) type.size = 19;\n  if (t.dyslexiaFont) { type.font = 'read'; type.line = 1.8; }\n}\n\nasync function loadType(){\n  themeDefaults();\n  try{\n    if (window.myllmStorage){\n      var raw = await myllmStorage.getItem('wb.type');\n      if (raw) {\n        var saved = JSON.parse(raw);\n        Object.keys(type).forEach(function(k){ if (saved[k] != null) type[k] = saved[k]; });\n      }\n    }\n  }catch(e){}\n  applyType();\n}\n\nfunction saveType(){\n  try{ window.myllmStorage && myllmStorage.setItem('wb.type', JSON.stringify(type)); }catch(e){}\n}\n\nfunction applyType(){\n  var d = el('doc');\n  var f = FONTS.filter(function(x){ return x.id === type.font; })[0] || FONTS[0];\n  var w = WIDTHS.filter(function(x){ return x.id === type.width; })[0] || WIDTHS[2];\n  d.style.setProperty('--doc-font', f.css);\n  d.style.setProperty('--doc-size', type.size + 'px');\n  d.style.setProperty('--doc-line', String(type.line));\n  d.style.setProperty('--doc-width', w.css);\n  d.style.setProperty('--doc-align', type.align);\n  d.setAttribute('data-align', type.align);\n  d.classList.toggle('paper', type.theme === 'paper');\n  var sample = el('sample');\n  if (sample){\n    sample.style.fontFamily = f.css;\n    sample.style.fontSize = type.size + 'px';\n    sample.style.lineHeight = String(type.line);\n    sample.style.textAlign = type.align;\n  }\n  if (el('sizeVal')) el('sizeVal').textContent = type.size + 'px';\n  if (el('lineVal')) el('lineVal').textContent = type.line.toFixed(1);\n  if (el('rngSize')) el('rngSize').value = type.size;\n  if (el('rngLine')) el('rngLine').value = Math.round(type.line * 10);\n  paintSegs();\n}\n\nfunction setType(k, v){ type[k] = v; applyType(); saveType(); }\n\nfunction resetType(){\n  type = { font:'system', size:16, line:1.6, width:'full', align:'left', theme:'default' };\n  themeDefaults(); applyType(); saveType(); haptic('selection');\n}\n\nfunction seg(containerId, options, key){\n  var c = el(containerId);\n  if (!c) return;\n  c.innerHTML = options.map(function(o){\n    return '<button aria-pressed=\"' + (type[key]===o.id) + '\" data-v=\"' + o.id + '\">' + esc(o.label) + '</button>';\n  }).join('');\n  Array.prototype.forEach.call(c.querySelectorAll('button'), function(b){\n    b.onclick = function(){ setType(key, b.getAttribute('data-v')); haptic('selection'); };\n  });\n}\nfunction paintSegs(){\n  seg('segFont', FONTS, 'font');\n  seg('segWidth', WIDTHS, 'width');\n  seg('segAlign', ALIGNS, 'align');\n  seg('segTheme', THEMES, 'theme');\n}\n\nfunction openType(){ paintSegs(); applyType(); el('type').classList.add('show'); }\n\nfunction kindLabel(ext){\n  if (ext==='md'||ext==='markdown') return 'Markdown';\n  if (ext==='csv') return 'CSV';\n  if (ext==='tsv') return 'TSV';\n  if (ext==='json') return 'JSON';\n  if (ext==='html'||ext==='htm') return 'HTML';\n  if (ext==='log') return 'Log';\n  return 'Text';\n}\n\nfunction setMode(m){\n  mode = m;\n  var map = { view:'tabView', edit:'tabEdit', raw:'tabRaw' };\n  Object.keys(map).forEach(function(x){\n    el(map[x]).setAttribute('aria-selected', String(x===m));\n  });\n  render();\n}\n\nfunction render(){\n  var m = el('main');\n  if (!current) { renderStart(); return; }\n  if (mode === 'edit'){\n    /* A Markdown editor with no formatting controls makes people memorise\n       syntax; these wrap the selection the way a word processor would. */\n    var isMd = (current.ext === 'md' || current.ext === 'markdown' || current.ext === '' || current.ext === 'txt');\n    m.innerHTML = (isMd ? fmtBar() : '') + '<textarea id=\"ta\" spellcheck=\"false\"></textarea>';\n    if (isMd) wireFmtBar();\n    var ta = el('ta');\n    ta.value = edited;\n    ta.addEventListener('input', function(){\n      edited = ta.value;\n      updateBar(); updateSub(); queueDraft();\n    });\n    updateBar();\n    return;\n  }\n  if (mode === 'raw'){\n    m.innerHTML = '<pre>' + esc(edited) + '</pre>';\n    return;\n  }\n  var e = current.ext;\n  if (e==='md'||e==='markdown') m.innerHTML = '<div class=\"md\">' + markdown(edited) + '</div>';\n  else if (e==='csv')  m.innerHTML = csvTable(edited);\n  else if (e==='json') m.innerHTML = jsonView(edited);\n  else if (e==='html'||e==='htm') m.innerHTML = htmlSource(edited);\n  else m.innerHTML = '<pre>' + esc(edited) + '</pre>';\n}\n\n/* ---------- editor formatting ---------- */\n\nvar FMT = [\n  { k:'b',   label:'B',   title:'Bold',      wrap:['**','**'] },\n  { k:'i',   label:'I',   title:'Italic',    wrap:['*','*'] },\n  { k:'h1',  label:'H1',  title:'Heading 1', line:'# ' },\n  { k:'h2',  label:'H2',  title:'Heading 2', line:'## ' },\n  { k:'ul',  label:'•', title:'List',   line:'- ' },\n  { k:'ol',  label:'1.',  title:'Numbered',  line:'1. ' },\n  { k:'todo',label:'☐', title:'Task',   line:'- [ ] ' },\n  { k:'q',   label:'❝', title:'Quote',  line:'> ' },\n  { k:'code',label:'</>', title:'Code',      wrap:['`','`'] },\n  { k:'link',label:'Link',title:'Link',      wrap:['[',\"](https://)\"], wide:true }\n];\n\nfunction fmtBar(){\n  return '<div class=\"fmtbar\">' + FMT.map(function(f){\n    return '<button class=\"fmt' + (f.wide?' wide':'') + '\" data-k=\"' + f.k + '\" title=\"' + f.title + '\">' + f.label + '</button>';\n  }).join('') + '</div>';\n}\n\nfunction wireFmtBar(){\n  Array.prototype.forEach.call(document.querySelectorAll('.fmt[data-k]'), function(b){\n    /* mousedown, not click: the textarea must not lose its selection first. */\n    b.addEventListener('mousedown', function(ev){ ev.preventDefault(); });\n    b.addEventListener('click', function(){\n      var f = FMT.filter(function(x){ return x.k === b.getAttribute('data-k'); })[0];\n      if (f) applyFmt(f);\n    });\n  });\n}\n\nfunction applyFmt(f){\n  var ta = el('ta');\n  if (!ta) return;\n  var start = ta.selectionStart, end = ta.selectionEnd;\n  var before = ta.value.slice(0, start), sel = ta.value.slice(start, end), after = ta.value.slice(end);\n  if (f.line){\n    /* Prefix every line the selection touches, including the one the caret sits\n       on when nothing is selected. */\n    var ls = before.lastIndexOf('\\n') + 1;\n    var le = end + (ta.value.slice(end).indexOf('\\n') === -1 ? ta.value.length - end : ta.value.slice(end).indexOf('\\n'));\n    var block = ta.value.slice(ls, le);\n    var prefixed = block.split('\\n').map(function(l){\n      return l.indexOf(f.line) === 0 ? l.slice(f.line.length) : f.line + l;   /* toggles */\n    }).join('\\n');\n    ta.value = ta.value.slice(0, ls) + prefixed + ta.value.slice(le);\n    ta.selectionStart = ls; ta.selectionEnd = ls + prefixed.length;\n  } else {\n    ta.value = before + f.wrap[0] + sel + f.wrap[1] + after;\n    ta.selectionStart = start + f.wrap[0].length;\n    ta.selectionEnd = ta.selectionStart + sel.length;\n  }\n  edited = ta.value;\n  updateBar(); updateSub(); queueDraft();\n  ta.focus();\n  haptic('light');\n}\n\n/* ---------- renderers ---------- */\n\n/* A small, dependency-free Markdown subset: headings, emphasis, code, lists,\n   tables, task boxes, quotes, links, rules. Deliberately not a full parser - a\n   gallery app must stay self-contained, and this covers what notes actually\n   use. Escapes FIRST, so nothing in the document can inject markup. */\nfunction markdown(src){\n  var s = esc(src);\n  var blocks = [];\n  s = s.replace(/```([\\s\\S]*?)```/g, function(_, code){\n    blocks.push('<pre>' + code.replace(/^\\n/,'') + '</pre>');\n    return ' BLOCK' + (blocks.length-1) + ' ';\n  });\n  s = s.replace(/^######\\s+(.*)$/gm,'<h6>$1</h6>')\n       .replace(/^#####\\s+(.*)$/gm,'<h5>$1</h5>')\n       .replace(/^####\\s+(.*)$/gm,'<h4>$1</h4>')\n       .replace(/^###\\s+(.*)$/gm,'<h3>$1</h3>')\n       .replace(/^##\\s+(.*)$/gm,'<h2>$1</h2>')\n       .replace(/^#\\s+(.*)$/gm,'<h1>$1</h1>')\n       .replace(/^\\s*([-*_])\\1{2,}\\s*$/gm,'<hr>')\n       .replace(/^&gt;\\s?(.*)$/gm,'<blockquote>$1</blockquote>')\n       .replace(/`([^`\\n]+)`/g,'<code>$1</code>')\n       .replace(/\\*\\*([^*\\n]+)\\*\\*/g,'<strong>$1</strong>')\n       .replace(/(^|[^*])\\*([^*\\n]+)\\*/g,'$1<em>$2</em>')\n       .replace(/\\[([^\\]]+)\\]\\((https?:[^)\\s]+)\\)/g,'<a href=\"$2\">$1</a>');\n  /* Pipe tables. Needs the ---|--- separator row, like every other renderer, so\n     a paragraph that merely contains a pipe is left alone. */\n  s = s.replace(/(?:^\\|.*\\|[ \\t]*(?:\\n|$))+/gm, function(run){\n    var lines = run.trim().split('\\n');\n    if (lines.length < 2 || !/^\\|[\\s:|-]+\\|$/.test(lines[1].trim())) return run;\n    var cells = function(l){\n      return l.trim().replace(/^\\|/,'').replace(/\\|$/,'').split('|').map(function(c){ return c.trim(); });\n    };\n    var head = cells(lines[0]), body = lines.slice(2).map(cells);\n    return '<div class=\"scroll\"><table><thead><tr>'\n      + head.map(function(h){ return '<th>' + h + '</th>'; }).join('')\n      + '</tr></thead><tbody>'\n      + body.map(function(r){\n          return '<tr>' + head.map(function(_, i){ return '<td>' + (r[i]||'') + '</td>'; }).join('') + '</tr>';\n        }).join('')\n      + '</tbody></table></div>';\n  });\n  s = s.replace(/(?:^[-*+]\\s+.*(?:\\n|$))+/gm, function(run){\n    return '<ul>' + run.trim().split('\\n').map(function(l){\n      return '<li>' + l.replace(/^[-*+]\\s+/,'') + '</li>'; }).join('') + '</ul>';\n  });\n  s = s.replace(/(?:^\\d+\\.\\s+.*(?:\\n|$))+/gm, function(run){\n    return '<ol>' + run.trim().split('\\n').map(function(l){\n      return '<li>' + l.replace(/^\\d+\\.\\s+/,'') + '</li>'; }).join('') + '</ol>';\n  });\n  /* Task boxes, drawn rather than made interactive: a tick you can tap but that\n     never reaches the file would be a lie about what was saved. */\n  s = s.replace(/<li>\\[ \\]\\s*/g, '<li>☐ ').replace(/<li>\\[[xX]\\]\\s*/g, '<li>☑ ');\n  s = s.split(/\\n{2,}/).map(function(p){\n    return /^\\s*<(h[1-6]|ul|ol|pre|blockquote|hr|div|table)/.test(p) ? p : '<p>' + p.replace(/\\n/g,'<br>') + '</p>';\n  }).join('\\n');\n  return s.replace(/ BLOCK(\\d+) /g, function(_, i){ return blocks[+i]; });\n}\n\n/* RFC-ish CSV: honours quoted fields containing commas, newlines and doubled\n   quotes, which a naive split(',') mangles on exactly the files people have. */\nfunction parseCSV(text){\n  var rows=[], row=[], cur='', q=false;\n  for (var i=0;i<text.length;i++){\n    var c=text[i];\n    if (q){\n      if (c === '\"'){ if (text[i+1] === '\"'){ cur+='\"'; i++; } else q=false; }\n      else cur+=c;\n    } else if (c === '\"'){ q=true; }\n    else if (c === ','){ row.push(cur); cur=''; }\n    else if (c === '\\n'){ row.push(cur); rows.push(row); row=[]; cur=''; }\n    else if (c !== '\\r'){ cur+=c; }\n  }\n  if (cur.length || row.length){ row.push(cur); rows.push(row); }\n  return rows.filter(function(r){ return r.length>1 || String(r[0]||'').trim()!==''; });\n}\n\nfunction csvTable(text){\n  var rows = parseCSV(text);\n  if (!rows.length) return '<p class=\"note\">Empty file.</p>';\n  var head = rows[0], body = rows.slice(1);\n  return '<div class=\"scroll\"><table><thead><tr>' +\n    head.map(function(h){ return '<th>' + esc(h) + '</th>'; }).join('') +\n    '</tr></thead><tbody>' +\n    body.map(function(r){\n      return '<tr>' + head.map(function(_, i){ return '<td>' + esc(r[i]||'') + '</td>'; }).join('') + '</tr>';\n    }).join('') + '</tbody></table></div>' +\n    '<p class=\"note\">' + body.length + ' row' + (body.length===1?'':'s') + ' - ' + head.length + ' columns</p>';\n}\n\nfunction jsonView(text){\n  var data;\n  try { data = JSON.parse(text); }\n  catch(e){\n    return '<p class=\"note\">Not valid JSON - ' + esc(e.message) + '. Showing the source.</p><pre>' + esc(text) + '</pre>';\n  }\n  return '<pre>' + colourJSON(JSON.stringify(data, null, 2)) + '</pre>';\n}\nfunction colourJSON(s){\n  return esc(s).replace(/&quot;([^&]*?)&quot;(\\s*:)/g, '<span class=\"k\">&quot;$1&quot;</span>$2');\n}\n\n/* An HTML document is shown as SOURCE, never executed. Running a file from the\n   shared workspace inside this app would hand it this app's bridges and storage;\n   install it as its own app if that is what you want. */\nfunction htmlSource(text){\n  return '<p class=\"note\">HTML is shown as source here. To run it, install it as its own app from the Files preview.</p>'\n       + '<pre>' + esc(text) + '</pre>';\n}\n\n/* ================= converting between formats =================\n   \"Save as\" in a word processor means two different things: a copy somewhere\n   else, and the same document in another file type. This does both. Every\n   conversion says what it did, and anything without a sensible conversion is\n   written unchanged with a note rather than silently mangled. */\n\nfunction normExt(e){\n  e = String(e||'').toLowerCase();\n  if (e === 'markdown') return 'md';\n  if (e === 'htm') return 'html';\n  if (e === '' || e === 'text' || e === 'log') return 'txt';\n  return e;\n}\n\nfunction convert(text, from, to){\n  from = normExt(from); to = normExt(to);\n  if (from === to) return { text: text, note: '' };\n  var name = (current && current.name) || 'Document';\n  try{\n    if (from === 'md'   && to === 'html') return { text: htmlDoc(name, '<div class=\"md\">' + markdown(text) + '</div>'), note: 'Markdown rendered into a standalone web page.' };\n    if (from === 'md'   && to === 'txt')  return { text: stripMd(text), note: 'Markdown marks removed.' };\n    if (from === 'txt'  && to === 'md')   return { text: text, note: 'Kept as it is - plain text is already valid Markdown.' };\n    if (from === 'csv'  && to === 'json') return { text: csvToJson(text), note: 'Rows converted to JSON objects, using the first row as keys.' };\n    if (from === 'csv'  && to === 'md')   return { text: csvToMd(text), note: 'Table converted to a Markdown table.' };\n    if (from === 'csv'  && to === 'html') return { text: htmlDoc(name, csvTable(text)), note: 'Table rendered into a standalone web page.' };\n    if (from === 'json' && to === 'csv')  return jsonToCsv(text);\n    if (from === 'json' && to === 'md')   return { text: '```json\\n' + String(text).trim() + '\\n```\\n', note: 'Wrapped in a Markdown code block.' };\n    if (from === 'html' && (to === 'txt' || to === 'md'))\n      return { text: stripTags(text), note: 'Tags stripped - this is the readable text, not a full HTML to Markdown conversion.' };\n    if (to === 'html')  return { text: htmlDoc(name, '<pre>' + esc(text) + '</pre>'), note: 'Wrapped in a standalone web page.' };\n    if (to === 'txt' || to === 'md') return { text: text, note: 'Written as it is.' };\n  }catch(e){\n    return { text: text, note: 'Could not convert it (' + e.message + '), so it was written unchanged.' };\n  }\n  return { text: text, note: 'No conversion from ' + kindLabel(from) + ' to ' + kindLabel(to) + ', so it was written unchanged.' };\n}\n\nfunction htmlDoc(title, inner){\n  return '<!doctype html>\\n<html lang=\"en\">\\n<head>\\n<meta charset=\"utf-8\">\\n'\n    + '<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\\n'\n    + '<title>' + esc(title || 'Document') + '</title>\\n<style>\\n'\n    + '  body{max-width:42em;margin:0 auto;padding:26px 18px;font:17px/1.65 -apple-system,system-ui,sans-serif;color:#191b1f;background:#fff}\\n'\n    + '  h1,h2,h3{line-height:1.25}\\n'\n    + '  code{background:#f0f1f3;padding:1px 5px;border-radius:5px}\\n'\n    + '  pre{background:#f0f1f3;padding:12px;border-radius:10px;overflow:auto;white-space:pre-wrap}\\n'\n    + '  table{border-collapse:collapse;width:100%}\\n'\n    + '  th,td{border:1px solid #dcdee3;padding:6px 8px;text-align:left}\\n'\n    + '  blockquote{margin:0;padding-left:12px;border-left:3px solid #dcdee3;color:#5b6270}\\n'\n    + '  @media (prefers-color-scheme:dark){body{background:#111318;color:#e8eaee}'\n    + 'code,pre{background:#1b1e25}th,td{border-color:#2a2e37}}\\n'\n    + '</style>\\n</head>\\n<body>\\n' + inner + '\\n</body>\\n</html>\\n';\n}\n\nfunction stripMd(s){\n  return String(s)\n    .replace(/```[a-z]*\\n?/gi, '')\n    .replace(/^#{1,6}\\s+/gm, '')\n    .replace(/^\\s*&gt;\\s?/gm, '')\n    .replace(/^\\s*>\\s?/gm, '')\n    .replace(/^(\\s*)[-*+]\\s+\\[[ xX]\\]\\s+/gm, '$1- ')\n    .replace(/\\*\\*([^*]+)\\*\\*/g, '$1')\n    .replace(/(^|[^*])\\*([^*]+)\\*/g, '$1$2')\n    .replace(/`([^`]+)`/g, '$1')\n    .replace(/\\[([^\\]]+)\\]\\(([^)\\s]+)\\)/g, '$1 ($2)')\n    .replace(/^\\s*([-*_])\\1{2,}\\s*$/gm, '----');\n}\n\nfunction stripTags(s){\n  return String(s)\n    .replace(/<script[\\s\\S]*?<\\/script>/gi, '')\n    .replace(/<style[\\s\\S]*?<\\/style>/gi, '')\n    .replace(/<br\\s*\\/?>/gi, '\\n')\n    .replace(/<\\/(p|div|h[1-6]|li|tr|blockquote)>/gi, '\\n')\n    .replace(/<[^>]+>/g, '')\n    .replace(/&nbsp;/g, ' ').replace(/&lt;/g, '<').replace(/&gt;/g, '>')\n    .replace(/&quot;/g, '\"').replace(/&#39;/g, \"'\").replace(/&amp;/g, '&')\n    .replace(/\\n{3,}/g, '\\n\\n').trim() + '\\n';\n}\n\nfunction coerce(v){\n  if (v == null || v === '') return '';\n  if (/^-?\\d+(\\.\\d+)?$/.test(v)) return Number(v);\n  if (/^(true|false)$/i.test(v)) return String(v).toLowerCase() === 'true';\n  return v;\n}\nfunction csvToJson(text){\n  var rows = parseCSV(text);\n  if (!rows.length) return '[]\\n';\n  var head = rows[0].map(function(h, i){ return String(h||'').trim() || ('column' + (i+1)); });\n  var out = rows.slice(1).map(function(r){\n    var o = {};\n    head.forEach(function(h, i){ o[h] = coerce(r[i]); });\n    return o;\n  });\n  return JSON.stringify(out, null, 2) + '\\n';\n}\nfunction csvToMd(text){\n  var rows = parseCSV(text);\n  if (!rows.length) return '';\n  var cell = function(v){ return String(v==null?'':v).replace(/\\|/g, '\\\\|'); };\n  var head = rows[0];\n  var out = ['| ' + head.map(cell).join(' | ') + ' |',\n             '| ' + head.map(function(){ return '---'; }).join(' | ') + ' |'];\n  rows.slice(1).forEach(function(r){\n    out.push('| ' + head.map(function(_, i){ return cell(r[i]); }).join(' | ') + ' |');\n  });\n  return out.join('\\n') + '\\n';\n}\nfunction jsonToCsv(text){\n  var data = JSON.parse(text);\n  var rows = Array.isArray(data) ? data\n           : (data && Array.isArray(data.items) ? data.items : null);\n  if (!rows) return { text: text, note: 'That JSON is not a list of records, so there are no rows to make. Written unchanged.' };\n  var keys = [];\n  rows.forEach(function(r){\n    if (r && typeof r === 'object' && !Array.isArray(r)) Object.keys(r).forEach(function(k){ if (keys.indexOf(k) < 0) keys.push(k); });\n  });\n  if (!keys.length) return { text: text, note: 'No object keys to use as columns. Written unchanged.' };\n  var q = function(v){\n    v = (v == null) ? '' : (typeof v === 'object' ? JSON.stringify(v) : String(v));\n    return /[\",\\n]/.test(v) ? '\"' + v.replace(/\"/g, '\"\"') + '\"' : v;\n  };\n  var out = [keys.join(',')].concat(rows.map(function(r){\n    return keys.map(function(k){ return q(r ? r[k] : ''); }).join(',');\n  })).join('\\n') + '\\n';\n  return { text: out, note: rows.length + ' record' + (rows.length===1?'':'s') + ' converted to CSV.' };\n}\n\n/* ---------- saving ---------- */\n\nasync function save(){\n  if (!current) return;\n  if (!current.path){ openSaveAs(); return; }\n  if (!files){ updateSub('shared files are off'); return; }\n  try{\n    await files.write(current.path, edited);\n    current.text = edited;\n    clearDraft();\n    updateBar(); updateSub('saved');\n    haptic('success');\n  }catch(e){ updateSub('save failed: ' + e.message); haptic('error'); }\n}\n\nfunction fmtByExt(e){\n  e = normExt(e);\n  return FORMATS.filter(function(f){ return f.ext === e; })[0] || FORMATS[1];\n}\n\nfunction openSaveAs(){\n  if (!current) return;\n  var cur = fmtByExt(current.ext);\n  el('saveAsFmt').innerHTML = FORMATS.map(function(f){\n    return '<option value=\"' + f.ext + '\"' + (f.ext === cur.ext ? ' selected' : '') + '>'\n      + esc(f.label) + ' (.' + f.ext + ')</option>';\n  }).join('');\n  el('saveAsPath').value = current.path || ((current.name || 'untitled').replace(/\\.[^.]+$/, '') + '.' + cur.ext);\n  el('saveAsNote').textContent = '';\n  el('saveAsStatus').textContent = '';\n  el('saveAs').classList.add('show');\n}\n\nfunction saveAsFmtChanged(){\n  var to = el('saveAsFmt').value;\n  var p = el('saveAsPath').value.trim() || 'untitled';\n  el('saveAsPath').value = p.replace(/\\.[^./]+$/, '') + '.' + to;\n  var r = convert(edited, current ? current.ext : 'txt', to);\n  el('saveAsNote').textContent = r.note;\n}\n\nasync function commitSaveAs(){\n  var p = el('saveAsPath').value.trim();\n  if (!p){ el('saveAsStatus').textContent = 'Give it a path.'; return; }\n  if (!files){ el('saveAsStatus').textContent = 'Shared files are off.'; return; }\n  var to = el('saveAsFmt').value;\n  var r = convert(edited, current ? current.ext : 'txt', to);\n  try{\n    await files.write(p, r.text);\n    current.path = p;\n    current.name = p.split('/').pop();\n    current.ext = extOf(p);\n    current.text = r.text;\n    edited = r.text;\n    clearDraft();\n    pushRecent(p);\n    el('title').textContent = current.name;\n    closeSheet('saveAs');\n    updateBar(); updateSub('saved' + (r.note ? ' · ' + r.note.toLowerCase().replace(/\\.$/,'') : ''));\n    haptic('success');\n    render();\n  }catch(e){ el('saveAsStatus').textContent = 'x ' + e.message; haptic('error'); }\n}\n\n/* ---------- export out of the app ---------- */\n\nvar expExt = 'md';\nfunction openExport(){\n  if (!current) return;\n  expExt = normExt(current.ext);\n  paintExport();\n  el('expStatus').textContent = '';\n  el('export').classList.add('show');\n}\nfunction paintExport(){\n  var c = el('expFmt');\n  c.innerHTML = FORMATS.map(function(f){\n    return '<button aria-pressed=\"' + (f.ext === expExt) + '\" data-v=\"' + f.ext + '\">' + esc(f.label) + '</button>';\n  }).join('');\n  Array.prototype.forEach.call(c.querySelectorAll('button'), function(b){\n    b.onclick = function(){ expExt = b.getAttribute('data-v'); paintExport(); haptic('selection'); };\n  });\n  var r = convert(edited, current ? current.ext : 'txt', expExt);\n  el('expNote').textContent = r.note || 'Shared exactly as it is on screen.';\n}\n\n/* btoa() only speaks Latin-1, so anything with an accent or an emoji has to go\n   through the encoder first or the share silently ships broken bytes. */\nfunction utf8b64(s){\n  var bytes = new TextEncoder().encode(s), bin = '';\n  for (var i = 0; i < bytes.length; i += 0x8000){\n    bin += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000));\n  }\n  return btoa(bin);\n}\n\nasync function commitExport(){\n  if (!current) return;\n  if (!window.myllmShareFile){ el('expStatus').textContent = 'Sharing needs a newer MyLLM build.'; return; }\n  var f = fmtByExt(expExt);\n  var r = convert(edited, current.ext, f.ext);\n  var base = (current.name || 'document').replace(/\\.[^.]+$/, '');\n  try{\n    el('expStatus').textContent = 'Preparing...';\n    await myllmShareFile('data:' + f.mime + ';base64,' + utf8b64(r.text),\n                         { filename: base + '.' + f.ext, mime: f.mime });\n    el('expStatus').textContent = '';\n    closeSheet('export');\n    haptic('success');\n  }catch(e){ el('expStatus').textContent = 'Share failed: ' + e.message; haptic('error'); }\n}\n\n/* ---------- rename / move ---------- */\n\nfunction openRename(){\n  if (!current || !current.path) return;\n  el('renamePath').value = current.path;\n  el('renameStatus').textContent = '';\n  el('rename').classList.add('show');\n}\nasync function commitRename(){\n  var to = el('renamePath').value.trim();\n  if (!to || !current || !files) return;\n  if (to === current.path){ closeSheet('rename'); return; }\n  try{\n    if (dirty()) await files.write(current.path, edited);\n    await files.move(current.path, to);\n    dropRecent(current.path);\n    current.path = to;\n    current.name = to.split('/').pop();\n    current.ext = extOf(to);\n    current.text = edited;\n    pushRecent(to);\n    el('title').textContent = current.name;\n    closeSheet('rename');\n    clearDraft();\n    updateBar(); updateSub('moved');\n    haptic('success');\n    render();\n  }catch(e){ el('renameStatus').textContent = 'x ' + e.message; haptic('error'); }\n}\n\nfunction openMore(){\n  if (!current) return;\n  el('moreTitle').textContent = current.name;\n  el('more').classList.add('show');\n}\n\n/* Hands the document to the assistant. compose (not send) so the user reads the\n   request before it goes - and a long file is referred to by PATH rather than\n   pasted, so the chat box stays usable and the assistant reads it itself. */\nfunction askAI(){\n  if (!current) return;\n  var where = current.path ? ('the file ' + current.path + ' in my shared workspace') : 'this document';\n  var ask = 'Read ' + where + ' and tell me what it says - the key points, anything that needs a decision, and anything that looks wrong.';\n  if (window.myllmChat && myllmChat.compose){ myllmChat.compose(ask); haptic('success'); return; }\n  if (window.myllmAsk){\n    updateSub('asking MyLLM...');\n    myllmAsk('Summarise this ' + kindLabel(current.ext) + ' document in 5 bullets:\\n\\n' + String(edited).slice(0, 6000))\n      .then(function(r){\n        el('main').innerHTML = '<div class=\"md\">' + markdown(r) + '</div>';\n        updateSub('MyLLM summary');\n      })\n      .catch(function(e){ updateSub('ask failed: ' + e.message); });\n    return;\n  }\n  updateSub('AI is off for apps');\n}\n\n/* ---------- boot ---------- */\n\n(async function boot(){\n  await loadType();\n  await loadRecents();\n  await loadDraft();\n  if (!current) renderStart();\n  updateBar();\n})();\n</script>\n</body></html>\n"}