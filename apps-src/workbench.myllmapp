{"name": "Workbench", "kind": "html", "iconSymbol": "wrench.and.screwdriver", "iconColor": "indigo", "html": "<!doctype html>\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Workbench</title>\n<!-- Receives files handed over from the MyLLMos Files app (\"Open with an app...\"). -->\n<meta name=\"myllm:intents\" content=\"open-text\">\n<style>\n  *{box-sizing:border-box}\n  body{margin:0;font:16px/1.5 var(--myllm-font,-apple-system,system-ui,sans-serif);\n       background:var(--myllm-bg,#fff);color:var(--myllm-text,#0b0c0f);\n       padding:0 0 env(safe-area-inset-bottom)}\n  header{position:sticky;top:0;z-index:5;background:var(--myllm-bg,#fff);\n         border-bottom:1px solid var(--myllm-border,rgba(0,0,0,.12));padding:12px 16px}\n  h1{margin:0;font-size:17px;font-weight:650;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n  .sub{font-size:12px;color:var(--myllm-muted,#5b6270);margin-top:2px}\n  .tabs{display:flex;gap:6px;padding:10px 16px;overflow-x:auto}\n  .tab{border:0;background:var(--myllm-surface,#f4f5f7);color:var(--myllm-text,#111);\n       border-radius:999px;padding:7px 13px;font-size:13.5px;font-weight:600;white-space:nowrap}\n  .tab[aria-selected=\"true\"]{background:var(--myllm-accent,#4f7cff);color:#fff}\n  main{padding:0 16px 96px}\n  .empty{padding:48px 24px;text-align:center;color:var(--myllm-muted,#5b6270)}\n  .empty .big{font-size:44px;margin-bottom:10px}\n  pre,textarea{white-space:pre-wrap;word-wrap:break-word;font:13.5px/1.55 ui-monospace,SFMono-Regular,Menlo,monospace}\n  textarea{width:100%;min-height:58vh;border:1px solid var(--myllm-border,#ddd);\n           border-radius:var(--myllm-radius,14px);padding:12px;background:var(--myllm-surface,#fafafa);\n           color:inherit;resize:vertical}\n  table{border-collapse:collapse;width:100%;font-size:13.5px}\n  th,td{border:1px solid var(--myllm-border,rgba(0,0,0,.12));padding:6px 8px;text-align:left;vertical-align:top}\n  th{background:var(--myllm-surface,#f4f5f7);position:sticky;top:0}\n  .scroll{overflow:auto;max-width:100%;border-radius:10px}\n  .md h1,.md h2,.md h3{line-height:1.25}\n  .md code{background:var(--myllm-surface,#f0f1f3);padding:1px 5px;border-radius:5px;font-size:13px}\n  .md pre{background:var(--myllm-surface,#f0f1f3);padding:12px;border-radius:10px;overflow:auto}\n  .md blockquote{margin:0;padding-left:12px;border-left:3px solid var(--myllm-border,#ddd);color:var(--myllm-muted,#5b6270)}\n  .md table{margin:10px 0}\n  .k{color:var(--myllm-accent,#4f7cff)}\n  .bar{position:fixed;left:0;right:0;bottom:0;display:flex;gap:8px;padding:10px 14px calc(10px + env(safe-area-inset-bottom));\n       background:var(--myllm-bg,#fff);border-top:1px solid var(--myllm-border,rgba(0,0,0,.12))}\n  .btn{flex:1;border:0;border-radius:12px;padding:12px 10px;font-size:14.5px;font-weight:650;\n       background:var(--myllm-surface,#eef0f4);color:var(--myllm-text,#111)}\n  .btn.primary{background:var(--myllm-accent,#4f7cff);color:#fff}\n  .btn:disabled{opacity:.45}\n  .note{font-size:12.5px;color:var(--myllm-muted,#5b6270);padding:8px 0}\n  .sheet{position:fixed;inset:0;background:rgba(0,0,0,.35);display:none;align-items:flex-end;z-index:20}\n  .sheet.show{display:flex}\n  .sheetcard{background:var(--myllm-bg,#fff);width:100%;border-radius:18px 18px 0 0;padding:16px;max-height:80vh;overflow:auto}\n  input[type=text]{width:100%;padding:11px;border-radius:10px;border:1px solid var(--myllm-border,#ddd);\n                   background:var(--myllm-surface,#fafafa);color:inherit;font-size:15px}\n\n  /* ---------- typography ----------\n     Reading settings live on one wrapper as custom properties, so the rendered\n     view, the raw view and the editor all inherit exactly the same type without\n     three sets of rules drifting apart. */\n  #doc{--doc-font:var(--myllm-font,-apple-system,system-ui,sans-serif);\n       --doc-size:16px;--doc-line:1.6;--doc-width:100%;--doc-align:left}\n  #doc, #doc .md, #doc pre, #doc textarea{\n       font-family:var(--doc-font);font-size:var(--doc-size);line-height:var(--doc-line);\n       text-align:var(--doc-align)}\n  #doc .md, #doc > pre, #doc .scroll, #doc > textarea{max-width:var(--doc-width);margin-left:auto;margin-right:auto}\n  #doc.paper{background:#fbf7ef;color:#33302b;border-radius:12px;padding:14px 16px}\n  #doc.paper pre,#doc.paper code{background:#f2ece0}\n  /* Justified text needs hyphenation or it opens rivers of whitespace on a phone. */\n  #doc[data-align=\"justify\"] .md p{hyphens:auto;-webkit-hyphens:auto}\n  .fmtbar{display:flex;gap:6px;overflow-x:auto;padding:8px 0 10px;position:sticky;top:0;\n          background:var(--myllm-bg,#fff);z-index:3}\n  .fmt{border:1px solid var(--myllm-border,rgba(0,0,0,.14));background:var(--myllm-surface,#f4f5f7);\n       color:var(--myllm-text,#111);border-radius:9px;min-width:38px;height:34px;font-size:14px;font-weight:700}\n  .fmt.wide{padding:0 10px;font-weight:600}\n  .seg{display:flex;gap:6px;flex-wrap:wrap;margin:6px 0 2px}\n  .seg button{flex:1;min-width:74px;border:1px solid var(--myllm-border,rgba(0,0,0,.14));\n              background:var(--myllm-surface,#f4f5f7);color:var(--myllm-text,#111);\n              border-radius:10px;padding:9px 8px;font-size:13.5px;font-weight:600}\n  .seg button[aria-pressed=\"true\"]{background:var(--myllm-accent,#4f7cff);color:#fff;border-color:transparent}\n  .lbl{font-size:12.5px;font-weight:700;color:var(--myllm-muted,#5b6270);\n       text-transform:uppercase;letter-spacing:.04em;margin:14px 0 2px}\n  input[type=range]{width:100%;accent-color:var(--myllm-accent,#4f7cff)}\n  .sample{border:1px dashed var(--myllm-border,#ddd);border-radius:10px;padding:10px;margin-top:12px}\n</style></head>\n<body>\n\n<header>\n  <div style=\"display:flex;align-items:center;gap:10px\">\n    <div style=\"min-width:0;flex:1\">\n      <h1 id=\"title\">Workbench</h1>\n      <div class=\"sub\" id=\"sub\">Open a file from Files, then \"Open with an app...\"</div>\n    </div>\n    <button class=\"fmt wide\" id=\"typeBtn\" onclick=\"openType()\" aria-label=\"Text settings\"\n            style=\"height:38px;font-size:15px\">Aa</button>\n  </div>\n</header>\n\n<div class=\"tabs\" id=\"tabs\" hidden>\n  <button class=\"tab\" id=\"tabView\" onclick=\"setMode('view')\" aria-selected=\"true\">View</button>\n  <button class=\"tab\" id=\"tabEdit\" onclick=\"setMode('edit')\" aria-selected=\"false\">Edit</button>\n  <button class=\"tab\" id=\"tabRaw\" onclick=\"setMode('raw')\" aria-selected=\"false\">Source</button>\n</div>\n\n<main id=\"doc\">\n <div id=\"main\">\n  <div class=\"empty\" id=\"empty\">\n    <div class=\"big\">&#129520;</div>\n    <p><b>Nothing open yet.</b><br>\n    Open the <b>Files</b> app in MyLLMos, swipe a file and choose <b>Open</b> &mdash;\n    Workbench reads Markdown, CSV, JSON, HTML, logs and plain text.</p>\n    <p class=\"note\">Or ask MyLLM to save something into your workspace, then open it here.</p>\n  </div>\n </div>\n</main>\n\n<div class=\"bar\" id=\"bar\" hidden>\n  <button class=\"btn\" id=\"saveBtn\" onclick=\"save()\" disabled>Save</button>\n  <button class=\"btn\" onclick=\"openSaveAs()\">Save as...</button>\n  <button class=\"btn primary\" onclick=\"askAI()\">Ask MyLLM</button>\n</div>\n\n<div class=\"sheet\" id=\"type\">\n  <div class=\"sheetcard\">\n    <h3 style=\"margin:2px 0 4px\">Text</h3>\n    <p class=\"note\" style=\"padding-top:0\">Applies to reading, the source view and the editor. Remembered for next time.</p>\n\n    <div class=\"lbl\">Typeface</div>\n    <div class=\"seg\" id=\"segFont\"></div>\n\n    <div class=\"lbl\">Size <span id=\"sizeVal\" style=\"font-weight:600\"></span></div>\n    <input type=\"range\" id=\"rngSize\" min=\"13\" max=\"26\" step=\"1\" oninput=\"setType('size', +this.value)\">\n\n    <div class=\"lbl\">Line spacing <span id=\"lineVal\" style=\"font-weight:600\"></span></div>\n    <input type=\"range\" id=\"rngLine\" min=\"12\" max=\"22\" step=\"1\" oninput=\"setType('line', +this.value/10)\">\n\n    <div class=\"lbl\">Column width</div>\n    <div class=\"seg\" id=\"segWidth\"></div>\n\n    <div class=\"lbl\">Alignment</div>\n    <div class=\"seg\" id=\"segAlign\"></div>\n\n    <div class=\"lbl\">Page</div>\n    <div class=\"seg\" id=\"segTheme\"></div>\n\n    <div class=\"sample\" id=\"sample\">The quick brown fox jumps over the lazy dog. 0123456789</div>\n\n    <div style=\"display:flex;gap:8px;margin-top:14px\">\n      <button class=\"btn\" onclick=\"resetType()\">Reset</button>\n      <button class=\"btn primary\" onclick=\"closeSheet('type')\">Done</button>\n    </div>\n  </div>\n</div>\n\n<div class=\"sheet\" id=\"saveAs\">\n  <div class=\"sheetcard\">\n    <h3 style=\"margin:2px 0 10px\">Save a copy</h3>\n    <p class=\"note\" style=\"padding-top:0\">Choose a path inside your shared workspace. Folders are created as needed.</p>\n    <input type=\"text\" id=\"saveAsPath\" placeholder=\"notes/2026/copy.md\">\n    <div style=\"display:flex;gap:8px;margin-top:12px\">\n      <button class=\"btn primary\" onclick=\"commitSaveAs()\">Save</button>\n      <button class=\"btn\" onclick=\"closeSheet('saveAs')\">Cancel</button>\n    </div>\n    <div class=\"note\" id=\"saveAsStatus\"></div>\n  </div>\n</div>\n\n<script>\nvar files = window.myllmFiles || null;\nvar current = null;          /* {name, path, ext, text} */\nvar edited = null;           /* working copy while editing */\nvar mode = 'view';\n\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s==null?'':s)\n  .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }\nfunction haptic(k){ try{ window.myllmHaptic && myllmHaptic(k); }catch(e){} }\nfunction closeSheet(id){ el(id).classList.remove('show'); }\n\n/* ---------- receiving a file (the whole point) ----------\n   The Files app routes an \"open-text\" intent through the MyLLMos intent bus and\n   the payload lands here. The declaration is the myllm:intents meta tag in the\n   head; without it the router would never offer this app as a destination.\n   (Written as prose on purpose: the router parses the document as TEXT, so a\n   literal meta tag in a comment shows up as a second declaration.) */\nif (window.myllmIntent && myllmIntent.receive) {\n  myllmIntent.receive(function (intent) {\n    if (!intent || intent.action !== 'open-text' || !intent.data) return;\n    openDoc(intent.data);\n  });\n}\n\nfunction openDoc(d){\n  current = { name: d.name || 'Untitled', path: d.path || '',\n              ext: String(d.ext||'').toLowerCase(), text: String(d.text||'') };\n  edited = current.text;\n  el('title').textContent = current.name;\n  el('sub').textContent = (current.path || 'unsaved') + ' - ' + human(current.text.length) + ' - ' + kindLabel(current.ext);\n  el('empty').style.display = 'none';\n  el('tabs').hidden = false;\n  el('bar').hidden = false;\n  setMode('view');\n  haptic('selection');\n}\n\nfunction human(n){ return n < 1024 ? n + ' chars' : (n/1024).toFixed(1) + ' KB'; }\n\n/* ================= typography =================\n   A document app that can't change its type is a viewer, not a workbench —\n   reading a long note at the system default in a sans stack is the thing people\n   actually complain about. Settings persist per app via myllmStorage.\n\n   Defaults are seeded from myllmTheme where MyLLM already knows the answer:\n   if the user asked the OS for larger text or a readable font, start there\n   rather than making them say it twice. */\nvar FONTS = [\n  { id:'system', label:'System', css:\"var(--myllm-font,-apple-system,system-ui,sans-serif)\" },\n  { id:'serif',  label:'Serif',  css:\"'Iowan Old Style','Palatino','Georgia',serif\" },\n  { id:'mono',   label:'Mono',   css:\"ui-monospace,SFMono-Regular,Menlo,monospace\" },\n  { id:'read',   label:'Readable', css:\"'Comic Sans MS','Chalkboard SE','Trebuchet MS',system-ui,sans-serif\" }\n];\nvar WIDTHS = [ {id:'narrow',label:'Narrow',css:'34em'}, {id:'normal',label:'Normal',css:'46em'}, {id:'full',label:'Full',css:'100%'} ];\nvar ALIGNS = [ {id:'left',label:'Left'}, {id:'justify',label:'Justified'} ];\nvar THEMES = [ {id:'default',label:'Default'}, {id:'paper',label:'Paper'} ];\n\nvar type = { font:'system', size:16, line:1.6, width:'full', align:'left', theme:'default' };\n\nfunction themeDefaults(){\n  var t = window.myllmTheme || {};\n  if (t.largeText) type.size = 19;\n  if (t.dyslexiaFont) { type.font = 'read'; type.line = 1.8; }\n}\n\nasync function loadType(){\n  themeDefaults();\n  try{\n    if (window.myllmStorage){\n      var raw = await myllmStorage.getItem('wb.type');\n      if (raw) {\n        var saved = JSON.parse(raw);\n        Object.keys(type).forEach(function(k){ if (saved[k] != null) type[k] = saved[k]; });\n      }\n    }\n  }catch(e){}\n  applyType();\n}\n\nfunction saveType(){\n  try{ window.myllmStorage && myllmStorage.setItem('wb.type', JSON.stringify(type)); }catch(e){}\n}\n\nfunction applyType(){\n  var d = el('doc');\n  var f = FONTS.filter(function(x){ return x.id === type.font; })[0] || FONTS[0];\n  var w = WIDTHS.filter(function(x){ return x.id === type.width; })[0] || WIDTHS[2];\n  d.style.setProperty('--doc-font', f.css);\n  d.style.setProperty('--doc-size', type.size + 'px');\n  d.style.setProperty('--doc-line', String(type.line));\n  d.style.setProperty('--doc-width', w.css);\n  d.style.setProperty('--doc-align', type.align);\n  d.setAttribute('data-align', type.align);\n  d.classList.toggle('paper', type.theme === 'paper');\n  var sample = el('sample');\n  if (sample){\n    sample.style.fontFamily = f.css;\n    sample.style.fontSize = type.size + 'px';\n    sample.style.lineHeight = String(type.line);\n    sample.style.textAlign = type.align;\n  }\n  if (el('sizeVal')) el('sizeVal').textContent = type.size + 'px';\n  if (el('lineVal')) el('lineVal').textContent = type.line.toFixed(1);\n  if (el('rngSize')) el('rngSize').value = type.size;\n  if (el('rngLine')) el('rngLine').value = Math.round(type.line * 10);\n  paintSegs();\n}\n\nfunction setType(k, v){ type[k] = v; applyType(); saveType(); }\n\nfunction resetType(){\n  type = { font:'system', size:16, line:1.6, width:'full', align:'left', theme:'default' };\n  themeDefaults(); applyType(); saveType(); haptic('selection');\n}\n\nfunction seg(containerId, options, key){\n  var c = el(containerId);\n  if (!c) return;\n  c.innerHTML = options.map(function(o){\n    return '<button aria-pressed=\"' + (type[key]===o.id) + '\" data-v=\"' + o.id + '\">' + esc(o.label) + '</button>';\n  }).join('');\n  Array.prototype.forEach.call(c.querySelectorAll('button'), function(b){\n    b.onclick = function(){ setType(key, b.getAttribute('data-v')); haptic('selection'); };\n  });\n}\nfunction paintSegs(){\n  seg('segFont', FONTS, 'font');\n  seg('segWidth', WIDTHS, 'width');\n  seg('segAlign', ALIGNS, 'align');\n  seg('segTheme', THEMES, 'theme');\n}\n\nfunction openType(){ paintSegs(); applyType(); el('type').classList.add('show'); }\n\nloadType();\n\nfunction kindLabel(ext){\n  if (ext==='md'||ext==='markdown') return 'Markdown';\n  if (ext==='csv') return 'CSV';\n  if (ext==='json') return 'JSON';\n  if (ext==='html'||ext==='htm') return 'HTML';\n  if (ext==='log') return 'Log';\n  return 'Text';\n}\n\nfunction setMode(m){\n  mode = m;\n  var map = { view:'tabView', edit:'tabEdit', raw:'tabRaw' };\n  Object.keys(map).forEach(function(x){\n    el(map[x]).setAttribute('aria-selected', String(x===m));\n  });\n  render();\n}\n\nfunction render(){\n  var m = el('main');\n  if (!current) return;\n  if (mode === 'edit'){\n    /* A Markdown editor with no formatting controls makes people memorise\n       syntax; these wrap the selection the way a word processor would. */\n    var isMd = (current.ext === 'md' || current.ext === 'markdown' || current.ext === '' || current.ext === 'txt');\n    m.innerHTML = (isMd ? fmtBar() : '') + '<textarea id=\"ta\" spellcheck=\"false\"></textarea>';\n    if (isMd) wireFmtBar();\n    var ta = el('ta');\n    ta.value = edited;\n    ta.addEventListener('input', function(){\n      edited = ta.value;\n      el('saveBtn').disabled = (edited === current.text) || !current.path;\n    });\n    el('saveBtn').disabled = (edited === current.text) || !current.path;\n    return;\n  }\n  if (mode === 'raw'){\n    m.innerHTML = '<pre>' + esc(edited) + '</pre>';\n    return;\n  }\n  var e = current.ext;\n  if (e==='md'||e==='markdown') m.innerHTML = '<div class=\"md\">' + markdown(edited) + '</div>';\n  else if (e==='csv')  m.innerHTML = csvTable(edited);\n  else if (e==='json') m.innerHTML = jsonView(edited);\n  else if (e==='html'||e==='htm') m.innerHTML = htmlSource(edited);\n  else m.innerHTML = '<pre>' + esc(edited) + '</pre>';\n}\n\n/* ---------- editor formatting ---------- */\n\nvar FMT = [\n  { k:'b',   label:'B',   title:'Bold',      wrap:['**','**'] },\n  { k:'i',   label:'I',   title:'Italic',    wrap:['*','*'] },\n  { k:'h1',  label:'H1',  title:'Heading 1', line:'# ' },\n  { k:'h2',  label:'H2',  title:'Heading 2', line:'## ' },\n  { k:'ul',  label:'•',   title:'List',      line:'- ' },\n  { k:'ol',  label:'1.',  title:'Numbered',  line:'1. ' },\n  { k:'q',   label:'❝',   title:'Quote',     line:'> ' },\n  { k:'code',label:'</>', title:'Code',      wrap:['`','`'] },\n  { k:'link',label:'Link',title:'Link',      wrap:['[',\"](https://)\"], wide:true }\n];\n\nfunction fmtBar(){\n  return '<div class=\"fmtbar\">' + FMT.map(function(f){\n    return '<button class=\"fmt' + (f.wide?' wide':'') + '\" data-k=\"' + f.k + '\" title=\"' + f.title + '\">' + f.label + '</button>';\n  }).join('') + '</div>';\n}\n\nfunction wireFmtBar(){\n  Array.prototype.forEach.call(document.querySelectorAll('.fmt[data-k]'), function(b){\n    /* mousedown, not click: the textarea must not lose its selection first. */\n    b.addEventListener('mousedown', function(ev){ ev.preventDefault(); });\n    b.addEventListener('click', function(){\n      var f = FMT.filter(function(x){ return x.k === b.getAttribute('data-k'); })[0];\n      if (f) applyFmt(f);\n    });\n  });\n}\n\nfunction applyFmt(f){\n  var ta = el('ta');\n  if (!ta) return;\n  var start = ta.selectionStart, end = ta.selectionEnd;\n  var before = ta.value.slice(0, start), sel = ta.value.slice(start, end), after = ta.value.slice(end);\n  if (f.line){\n    /* Prefix every line the selection touches, including the one the caret sits\n       on when nothing is selected. */\n    var ls = before.lastIndexOf('\\n') + 1;\n    var le = end + (ta.value.slice(end).indexOf('\\n') === -1 ? ta.value.length - end : ta.value.slice(end).indexOf('\\n'));\n    var block = ta.value.slice(ls, le);\n    var prefixed = block.split('\\n').map(function(l){\n      return l.indexOf(f.line) === 0 ? l.slice(f.line.length) : f.line + l;   /* toggles */\n    }).join('\\n');\n    ta.value = ta.value.slice(0, ls) + prefixed + ta.value.slice(le);\n    ta.selectionStart = ls; ta.selectionEnd = ls + prefixed.length;\n  } else {\n    ta.value = before + f.wrap[0] + sel + f.wrap[1] + after;\n    ta.selectionStart = start + f.wrap[0].length;\n    ta.selectionEnd = ta.selectionStart + sel.length;\n  }\n  edited = ta.value;\n  el('saveBtn').disabled = (edited === current.text) || !current.path;\n  ta.focus();\n  haptic('light');\n}\n\n/* ---------- renderers ---------- */\n\n/* A small, dependency-free Markdown subset: headings, emphasis, code, lists,\n   quotes, links, rules. Deliberately not a full parser - a gallery app must stay\n   self-contained, and this covers what notes actually use. Escapes FIRST, so\n   nothing in the document can inject markup. */\nfunction markdown(src){\n  var s = esc(src);\n  var blocks = [];\n  s = s.replace(/```([\\s\\S]*?)```/g, function(_, code){\n    blocks.push('<pre>' + code.replace(/^\\n/,'') + '</pre>');\n    return ' BLOCK' + (blocks.length-1) + ' ';\n  });\n  s = s.replace(/^######\\s+(.*)$/gm,'<h6>$1</h6>')\n       .replace(/^#####\\s+(.*)$/gm,'<h5>$1</h5>')\n       .replace(/^####\\s+(.*)$/gm,'<h4>$1</h4>')\n       .replace(/^###\\s+(.*)$/gm,'<h3>$1</h3>')\n       .replace(/^##\\s+(.*)$/gm,'<h2>$1</h2>')\n       .replace(/^#\\s+(.*)$/gm,'<h1>$1</h1>')\n       .replace(/^\\s*([-*_])\\1{2,}\\s*$/gm,'<hr>')\n       .replace(/^&gt;\\s?(.*)$/gm,'<blockquote>$1</blockquote>')\n       .replace(/`([^`\\n]+)`/g,'<code>$1</code>')\n       .replace(/\\*\\*([^*\\n]+)\\*\\*/g,'<strong>$1</strong>')\n       .replace(/(^|[^*])\\*([^*\\n]+)\\*/g,'$1<em>$2</em>')\n       .replace(/\\[([^\\]]+)\\]\\((https?:[^)\\s]+)\\)/g,'<a href=\"$2\">$1</a>');\n  s = s.replace(/(?:^[-*+]\\s+.*(?:\\n|$))+/gm, function(run){\n    return '<ul>' + run.trim().split('\\n').map(function(l){\n      return '<li>' + l.replace(/^[-*+]\\s+/,'') + '</li>'; }).join('') + '</ul>';\n  });\n  s = s.replace(/(?:^\\d+\\.\\s+.*(?:\\n|$))+/gm, function(run){\n    return '<ol>' + run.trim().split('\\n').map(function(l){\n      return '<li>' + l.replace(/^\\d+\\.\\s+/,'') + '</li>'; }).join('') + '</ol>';\n  });\n  s = s.split(/\\n{2,}/).map(function(p){\n    return /^\\s*<(h[1-6]|ul|ol|pre|blockquote|hr)/.test(p) ? p : '<p>' + p.replace(/\\n/g,'<br>') + '</p>';\n  }).join('\\n');\n  return s.replace(/ BLOCK(\\d+) /g, function(_, i){ return blocks[+i]; });\n}\n\n/* RFC-ish CSV: honours quoted fields containing commas, newlines and doubled\n   quotes, which a naive split(',') mangles on exactly the files people have. */\nfunction parseCSV(text){\n  var rows=[], row=[], cur='', q=false;\n  for (var i=0;i<text.length;i++){\n    var c=text[i];\n    if (q){\n      if (c === '\"'){ if (text[i+1] === '\"'){ cur+='\"'; i++; } else q=false; }\n      else cur+=c;\n    } else if (c === '\"'){ q=true; }\n    else if (c === ','){ row.push(cur); cur=''; }\n    else if (c === '\\n'){ row.push(cur); rows.push(row); row=[]; cur=''; }\n    else if (c !== '\\r'){ cur+=c; }\n  }\n  if (cur.length || row.length){ row.push(cur); rows.push(row); }\n  return rows.filter(function(r){ return r.length>1 || String(r[0]||'').trim()!==''; });\n}\n\nfunction csvTable(text){\n  var rows = parseCSV(text);\n  if (!rows.length) return '<p class=\"note\">Empty file.</p>';\n  var head = rows[0], body = rows.slice(1);\n  return '<div class=\"scroll\"><table><thead><tr>' +\n    head.map(function(h){ return '<th>' + esc(h) + '</th>'; }).join('') +\n    '</tr></thead><tbody>' +\n    body.map(function(r){\n      return '<tr>' + head.map(function(_, i){ return '<td>' + esc(r[i]||'') + '</td>'; }).join('') + '</tr>';\n    }).join('') + '</tbody></table></div>' +\n    '<p class=\"note\">' + body.length + ' row' + (body.length===1?'':'s') + ' - ' + head.length + ' columns</p>';\n}\n\nfunction jsonView(text){\n  var data;\n  try { data = JSON.parse(text); }\n  catch(e){\n    return '<p class=\"note\">Not valid JSON - ' + esc(e.message) + '. Showing the source.</p><pre>' + esc(text) + '</pre>';\n  }\n  return '<pre>' + colourJSON(JSON.stringify(data, null, 2)) + '</pre>';\n}\nfunction colourJSON(s){\n  return esc(s).replace(/&quot;([^&]*?)&quot;(\\s*:)/g, '<span class=\"k\">&quot;$1&quot;</span>$2');\n}\n\n/* An HTML document is shown as SOURCE, never executed. Running a file from the\n   shared workspace inside this app would hand it this app's bridges and storage;\n   install it as its own app if that is what you want. */\nfunction htmlSource(text){\n  return '<p class=\"note\">HTML is shown as source here. To run it, install it as its own app from the Files preview.</p>'\n       + '<pre>' + esc(text) + '</pre>';\n}\n\n/* ---------- actions ---------- */\n\nasync function save(){\n  if (!files || !current || !current.path) return;\n  try{\n    await files.write(current.path, edited);\n    current.text = edited;\n    el('saveBtn').disabled = true;\n    el('sub').textContent = current.path + ' - saved - ' + kindLabel(current.ext);\n    haptic('success');\n  }catch(e){ el('sub').textContent = 'Save failed: ' + e.message; haptic('error'); }\n}\n\nfunction openSaveAs(){\n  if (!current) return;\n  el('saveAsPath').value = current.path || (current.name || 'untitled.txt');\n  el('saveAsStatus').textContent = '';\n  el('saveAs').classList.add('show');\n}\n\nasync function commitSaveAs(){\n  var p = el('saveAsPath').value.trim();\n  if (!p){ el('saveAsStatus').textContent = 'Give it a path.'; return; }\n  if (!files){ el('saveAsStatus').textContent = 'Shared files are off.'; return; }\n  try{\n    await files.write(p, edited);\n    current.path = p;\n    current.name = p.split('/').pop();\n    current.ext = String(p.split('.').pop()||'').toLowerCase();\n    current.text = edited;\n    el('title').textContent = current.name;\n    el('sub').textContent = p + ' - saved - ' + kindLabel(current.ext);\n    el('saveBtn').disabled = true;\n    closeSheet('saveAs');\n    haptic('success');\n    render();\n  }catch(e){ el('saveAsStatus').textContent = 'x ' + e.message; haptic('error'); }\n}\n\n/* Hands the document to the assistant. compose (not send) so the user reads the\n   request before it goes - and a long file is referred to by PATH rather than\n   pasted, so the chat box stays usable and the assistant reads it itself. */\nfunction askAI(){\n  if (!current) return;\n  var where = current.path ? ('the file ' + current.path + ' in my shared workspace') : 'this document';\n  var ask = 'Read ' + where + ' and tell me what it says - the key points, anything that needs a decision, and anything that looks wrong.';\n  if (window.myllmChat && myllmChat.compose){ myllmChat.compose(ask); haptic('success'); return; }\n  if (window.myllmAsk){\n    el('sub').textContent = 'Asking MyLLM...';\n    myllmAsk('Summarise this ' + kindLabel(current.ext) + ' document in 5 bullets:\\n\\n' + String(edited).slice(0, 6000))\n      .then(function(r){\n        el('main').innerHTML = '<div class=\"md\">' + markdown(r) + '</div>';\n        el('sub').textContent = 'MyLLM summary';\n      })\n      .catch(function(e){ el('sub').textContent = 'Ask failed: ' + e.message; });\n    return;\n  }\n  el('sub').textContent = 'AI is off for apps.';\n}\n</script>\n</body></html>\n"}