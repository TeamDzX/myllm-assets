{"name": "Book Nook", "kind": "html", "iconSymbol": "books.vertical.fill", "iconColor": "orange", "html": "<!doctype html>\n<!--\n  Book Nook — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Book Nook</title>\n<style>\n:root{ color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); --h:24; --brand:hsl(var(--h) 46% 43%); }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24);\n  --brand:hsl(var(--h) 55% 55%); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink); font-size:15.5px;\n    max-width:600px; margin:0 auto; min-height:100dvh;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:760px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.96); }\n  [hidden]{ display:none !important; }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 28%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:20px 2px 10px; }\n\n  .hero{ border-radius:20px; padding:16px 18px; color:#fff; margin-bottom:12px; display:flex; align-items:center; gap:16px;\n    background:linear-gradient(145deg, hsl(var(--h) 55% 44%), hsl(calc(var(--h) + 30) 50% 22%)); box-shadow:0 10px 28px hsl(var(--h) 50% 25% / .25); }\n  .hero .n{ font-size:44px; font-weight:800; line-height:1; letter-spacing:-.03em; font-variant-numeric:tabular-nums; }\n  .hero .k{ font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.8; }\n  .hero .pills{ display:flex; flex-wrap:wrap; gap:6px; margin-top:7px; }\n  .hero .pill{ display:inline-flex; align-items:center; gap:5px; font-size:12.5px; font-weight:700; border-radius:99px; padding:4px 10px;\n    background:rgba(255,255,255,.18); border:1px solid rgba(255,255,255,.2); }\n  .hero .pill svg{ width:13px; height:13px; }\n\n  .seg{ display:flex; background:var(--fill); border-radius:13px; padding:3px; margin-bottom:12px; }\n  .seg button{ flex:1; min-height:38px; border:none; background:none; color:var(--muted); border-radius:10px; padding:0 4px; font-size:13.5px; font-weight:700; }\n  .seg button.on{ background:var(--surface); color:var(--ink); box-shadow:0 1px 3px rgba(0,0,0,.12); }\n  .seg button .c{ font-weight:600; opacity:.6; margin-left:3px; font-variant-numeric:tabular-nums; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  .search{ display:flex; gap:8px; }\n  .field{ flex:1; min-width:0; display:flex; align-items:center; gap:8px; border:1px solid var(--line); background:var(--bg); border-radius:12px; padding:0 12px; }\n  .field svg{ color:var(--muted); }\n  .field input{ flex:1; min-width:0; border:0; background:none; outline:none; font:inherit; font-size:16px; padding:12px 0; color:var(--ink); }\n  .go{ flex:none; min-width:72px; min-height:46px; border:none; border-radius:12px; padding:0 16px; font-size:15px; font-weight:700; background:var(--brand); color:#fff;\n    display:flex; align-items:center; justify-content:center; gap:7px; }\n  .go:disabled{ opacity:.6; }\n  .hint{ font-size:12.5px; color:var(--muted); margin-top:9px; line-height:1.45; }\n  .hint:empty{ display:none; }\n  .spin{ width:16px; height:16px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n\n  .cov{ width:44px; height:64px; object-fit:cover; border-radius:7px; flex-shrink:0; display:flex; align-items:center; justify-content:center;\n    color:#fff; font-weight:800; font-size:15px; text-align:center; box-shadow:0 2px 6px rgba(0,0,0,.18); overflow:hidden;\n    background:linear-gradient(145deg, hsl(var(--ch,24) 45% 48%), hsl(calc(var(--ch,24) + 30) 45% 28%)); }\n  .cov.blank{ background:var(--fill); box-shadow:none; color:var(--muted); }\n  .result{ display:flex; gap:11px; align-items:center; padding:10px 0; border-bottom:1px solid var(--line); }\n  .result:first-child{ margin-top:12px; } .result:last-child{ border-bottom:none; padding-bottom:0; }\n  .result .t{ flex:1; min-width:0; }\n  .result b{ display:block; font-size:14.5px; line-height:1.3; }\n  .result small{ color:var(--muted); font-size:12.5px; }\n  .result .btns{ display:flex; gap:6px; flex:none; }\n  .result button{ min-height:36px; border:1px solid var(--line); border-radius:10px; padding:0 11px; font-weight:700; font-size:12.5px; background:var(--bg); }\n  .result button.pri{ background:var(--brand); border-color:transparent; color:#fff; }\n\n  .shelf{ display:grid; gap:9px; }\n  @media (min-width:700px){ .shelf{ grid-template-columns:minmax(0,1fr) minmax(0,1fr); } }\n  .book{ display:flex; gap:12px; align-items:center; background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:12px; }\n  .book .t{ flex:1; min-width:0; }\n  .book b{ display:block; font-size:15px; line-height:1.3; }\n  .book small{ color:var(--muted); font-size:12.5px; display:block; margin-top:1px; }\n  .stars{ display:flex; gap:2px; margin-top:4px; color:#ff9f0a; }\n  .stars svg{ width:14px; height:14px; }\n  .stars .off{ color:var(--line); }\n  .book .note{ font-size:12.5px; color:var(--muted); font-style:italic; margin-top:3px; }\n  .book .acts{ display:flex; flex-direction:column; gap:6px; flex:none; }\n  .book .acts button{ min-height:36px; border:1px solid var(--line); border-radius:10px; padding:0 11px; font-size:12.5px; font-weight:700; background:var(--bg);\n    display:flex; align-items:center; justify-content:center; gap:5px; }\n  .book .acts button.pri{ background:var(--brand); border-color:transparent; color:#fff; }\n  .book .acts button.x{ width:44px; height:44px; padding:0; border:none; background:none; color:var(--muted); font-size:14px; }\n\n  .empty{ text-align:center; padding:24px 18px 20px; }\n  .empty .tile{ width:48px; height:48px; border-radius:14px; font-size:21px; margin:0 auto 10px; opacity:.9; }\n  .empty p{ font-size:13.5px; color:var(--muted); line-height:1.5; max-width:290px; margin:0 auto; }\n\n  .recbtn{ width:100%; min-height:50px; border:1px solid hsl(var(--h) 50% 50% / .45); background:hsl(var(--h) 60% 50% / .12); color:var(--brand);\n    border-radius:14px; padding:0 14px; font-size:15px; font-weight:700; margin-bottom:10px; display:flex; align-items:center; justify-content:center; gap:8px; }\n  .recbtn:disabled{ opacity:.7; }\n  .rec{ padding:10px 0; border-bottom:1px solid var(--line); }\n  .rec:first-child{ padding-top:0; } .rec:last-child{ border-bottom:none; padding-bottom:0; }\n  .rec b{ font-size:14.5px; }\n  .rec .by{ color:var(--muted); font-size:12.5px; }\n  .rec small{ display:block; color:var(--muted); font-size:12.5px; line-height:1.45; margin-top:2px; }\n  .rec .add{ min-height:34px; border:1px solid var(--line); border-radius:10px; padding:0 11px; font-size:12.5px; font-weight:700; background:var(--bg); margin-top:7px;\n    display:inline-flex; align-items:center; gap:5px; }\n  .skel{ height:52px; border-radius:12px; background:var(--fill); margin-bottom:8px; animation:shimmer 1.4s ease-in-out infinite; }\n  .skel:last-child{ margin-bottom:0; }\n  @keyframes shimmer{ 50%{ opacity:.45; } }\n  .warn{ display:flex; gap:10px; align-items:flex-start; font-size:13.5px; line-height:1.45; }\n  .warn svg{ color:#ff9f0a; margin-top:1px; }\n\n  /* finish sheet */\n  .veil{ position:fixed; inset:0; background:rgba(0,0,0,.4); z-index:90; display:none; }\n  .veil.on{ display:block; }\n  .sheet{ position:fixed; left:0; right:0; bottom:0; z-index:95; background:var(--surface); border-radius:22px 22px 0 0;\n    padding:10px calc(18px + env(safe-area-inset-right)) calc(24px + env(safe-area-inset-bottom)) calc(18px + env(safe-area-inset-left));\n    transform:translateY(105%); transition:transform .25s cubic-bezier(.2,.8,.2,1); max-width:640px; margin:0 auto; }\n  .sheet.on{ transform:none; }\n  .sheet .grab{ width:38px; height:5px; border-radius:99px; background:var(--line); margin:0 auto 14px; }\n  .sheet h3{ font-size:17px; font-weight:800; line-height:1.3; }\n  .sheet .bstars{ display:flex; gap:4px; justify-content:center; margin:14px 0; }\n  .sheet .bstars button{ width:48px; height:48px; border:none; background:none; color:var(--line); display:flex; align-items:center; justify-content:center; }\n  .sheet .bstars button.on{ color:#ff9f0a; }\n  .sheet .bstars svg{ width:34px; height:34px; }\n  .sheet input{ width:100%; font:inherit; font-size:16px; padding:12px; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; }\n  .sheet .done{ width:100%; min-height:50px; border:none; border-radius:14px; font-size:15.5px; font-weight:750; background:var(--brand); color:#fff; margin-top:12px; }\n\n  @media (max-width:360px){ .result .btns{ flex-direction:column; } }\n  @media (prefers-reduced-motion:reduce){ .spin{ animation-duration:2.4s; } .skel{ animation:none; } .sheet{ transition:none; } button:active{ transform:none; } }\n\n  @keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n  .myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n  .myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n  .myllm-ai-cog{width:16px;height:16px;border-radius:50%;border:2.4px solid #a78bfa;border-right-color:transparent;animation:myllmAiSpin .9s linear infinite;flex-shrink:0}\n  .myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n<style>:root{--build-id:\"3d02a4282c\";}</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-books\" viewBox=\"0 0 24 24\"><path d=\"M4 3.5h3a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-15a1 1 0 0 1 1-1zm6 0h3a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1h-3a1 1 0 0 1-1-1v-15a1 1 0 0 1 1-1zm6.3 1.6l2.9-.8a1 1 0 0 1 1.2.7l3.8 14.1a1 1 0 0 1-.7 1.2l-2.9.8a1 1 0 0 1-1.2-.7L15.6 6.3a1 1 0 0 1 .7-1.2z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.8l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 16.8l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-search\" viewBox=\"0 0 24 24\"><path d=\"M10.5 3a7.5 7.5 0 0 1 5.9 12.1l4.3 4.3a1 1 0 0 1-1.4 1.4l-4.3-4.3A7.5 7.5 0 1 1 10.5 3zm0 2a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M5 12.6l4.6 4.6L19.2 7.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-plus\" viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-play\" viewBox=\"0 0 24 24\"><path d=\"M8 5.5v13a1 1 0 0 0 1.52.85l10.4-6.5a1 1 0 0 0 0-1.7L9.52 4.65A1 1 0 0 0 8 5.5z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-pause\" viewBox=\"0 0 24 24\"><rect x=\"6\" y=\"5\" width=\"4.2\" height=\"14\" rx=\"1.4\" fill=\"currentColor\"/><rect x=\"13.8\" y=\"5\" width=\"4.2\" height=\"14\" rx=\"1.4\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-spark\" viewBox=\"0 0 24 24\"><path d=\"M10 2.5l1.9 5.6 5.6 1.9-5.6 1.9L10 17.5l-1.9-5.6L2.5 10l5.6-1.9zM18.5 14l.95 2.55L22 17.5l-2.55.95L18.5 21l-.95-2.55L15 17.5l2.55-.95z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-warn\" viewBox=\"0 0 24 24\"><path d=\"M10.3 3.9a2 2 0 0 1 3.4 0l8 13.6a2 2 0 0 1-1.7 3H4a2 2 0 0 1-1.7-3zM12 9a1 1 0 0 0-1 1v4a1 1 0 0 0 2 0v-4a1 1 0 0 0-1-1zm0 7.2a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-clock\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5a9.5 9.5 0 1 1 0 19 9.5 9.5 0 0 1 0-19zm0 2a7.5 7.5 0 1 0 0 15 7.5 7.5 0 0 0 0-15zM12 7a1 1 0 0 1 1 1v3.6l2.4 1.4a1 1 0 1 1-1 1.7l-2.9-1.7A1 1 0 0 1 11 12V8a1 1 0 0 1 1-1z\" fill=\"currentColor\"/></symbol>\n</defs></svg>\n\n<div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-books\"/></svg></div>\n  <div class=\"ht\"><h1>Book Nook</h1><p>Your reading life, on one shelf</p></div>\n</div>\n\n<div class=\"hero\">\n  <div class=\"n\" id=\"hFin\">0</div>\n  <div style=\"min-width:0\">\n    <div class=\"k\" id=\"hLbl\">Finished this year</div>\n    <div class=\"pills\"><span class=\"pill\" id=\"hAvg\" hidden></span><span class=\"pill\" id=\"hWait\"></span></div>\n  </div>\n</div>\n<p id=\"stats\" hidden></p>\n\n<div class=\"seg\" role=\"tablist\">\n  <button id=\"tabR\" class=\"on\" type=\"button\" onclick=\"showTab('reading')\">Reading<span class=\"c\" id=\"cR\"></span></button>\n  <button id=\"tabW\" type=\"button\" onclick=\"showTab('want')\">Want to read<span class=\"c\" id=\"cW\"></span></button>\n  <button id=\"tabF\" type=\"button\" onclick=\"showTab('finished')\">Finished<span class=\"c\" id=\"cF\"></span></button>\n</div>\n\n<div class=\"card\" id=\"addcard\">\n  <div class=\"search\">\n    <label class=\"field\"><svg class=\"i\"><use href=\"#i-search\"/></svg><input id=\"addq\" placeholder=\"Add a book — title or author…\" autocomplete=\"off\" enterkeyhint=\"search\" onkeydown=\"if(event.key==='Enter')searchBooks()\"></label>\n    <button class=\"go\" id=\"addgo\" type=\"button\" onclick=\"searchBooks()\">Find</button>\n  </div>\n  <div id=\"results\"></div>\n  <p class=\"hint\" id=\"addhint\"></p>\n</div>\n\n<div id=\"recwrap\" style=\"display:none\">\n  <button class=\"recbtn\" id=\"recbtn\" type=\"button\" onclick=\"recommend()\"></button>\n  <div class=\"card\" id=\"reccard\" style=\"display:none\"><div id=\"recs\"></div></div>\n</div>\n\n<div id=\"shelf\"></div>\n\n<div class=\"veil\" id=\"veil\" onclick=\"closeSheet()\"></div>\n<div class=\"sheet\" id=\"sheet\" role=\"dialog\" aria-modal=\"true\">\n  <div class=\"grab\"></div>\n  <h3 id=\"fintitle\">Finished!</h3>\n  <div class=\"bstars\" id=\"bstars\"></div>\n  <input id=\"finnote\" placeholder=\"One line to remember it by (optional)\">\n  <button class=\"done\" type=\"button\" onclick=\"confirmFinish()\">Add to Finished</button>\n</div>\n\n<!-- AI thinking pill (house convention) -->\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\"></span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n\n<script>\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nvar store = {\n  getItem:function(k){ return window.myllmStorage ? window.myllmStorage.getItem(k) : Promise.resolve(null); },\n  setItem:function(k,v){ return window.myllmStorage ? window.myllmStorage.setItem(k,v) : Promise.resolve(); }\n};\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction NET(){ return window.myllmFetch ? window.myllmFetch.apply(window, arguments) : Promise.reject(new Error(\"no bridge\")); }\nfunction hasNet(){ return !!window.myllmFetch; }\nfunction ASK(){ return window.myllmAsk.apply(window, arguments); }\nfunction hasAsk(){ return typeof window.myllmAsk === \"function\"; }\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\"); }\nfunction icon(n){ return '<svg class=\"i\"><use href=\"#i-' + n + '\"/></svg>'; }\n\n/* book = {id, title, author, cover(url|null), shelf, rating, note, finishedAt} */\nvar books = [];\nvar tab = \"reading\";\nvar finishing = null, finRating = 0, recBusy = false;\nvar SPINE_HUES = [24, 110, 208, 326, 40, 200];\n\nfunction uid(){ return \"b\" + Date.now().toString(36) + Math.floor(Math.random()*1e5).toString(36); }\nfunction save(){ store.setItem(\"books\", JSON.stringify(books)); }\n\nfunction initials(t){\n  return t.split(/\\s+/).slice(0,2).map(function(w){ return (w[0]||\"\").toUpperCase(); }).join(\"\");\n}\nfunction spineHue(t){\n  var h = 0; for (var i = 0; i < t.length; i++) h = (h * 31 + t.charCodeAt(i)) >>> 0;\n  return SPINE_HUES[h % SPINE_HUES.length];\n}\nfunction tileHTML(title){ return '<div class=\"cov\" style=\"--ch:' + spineHue(title) + '\">' + esc(initials(title)) + '</div>'; }\n/* A cover that fails to load becomes its hue tile. Guarded: the row may have\n   been re-rendered (and the image detached) before the error fires. */\nfunction coverFail(img){\n  var p = img.parentNode; if (!p) return;\n  var d = document.createElement(\"div\"); d.className = \"cov\"; d.style.setProperty(\"--ch\", img.getAttribute(\"data-h\"));\n  d.textContent = img.getAttribute(\"data-i\") || \"\"; p.replaceChild(d, img);\n}\nfunction coverHTML(b){\n  if (b.cover) return '<img class=\"cov\" src=\"' + esc(b.cover) + '\" alt=\"\" loading=\"lazy\" data-h=\"' + spineHue(b.title) + '\" data-i=\"' + esc(initials(b.title)) + '\" onerror=\"coverFail(this)\">';\n  return tileHTML(b.title);\n}\n\nfunction showTab(t){\n  tab = t;\n  haptic(\"selection\");\n  el(\"tabR\").className = t === \"reading\" ? \"on\" : \"\";\n  el(\"tabW\").className = t === \"want\" ? \"on\" : \"\";\n  el(\"tabF\").className = t === \"finished\" ? \"on\" : \"\";\n  render();\n}\n\n/* ---------- stats ---------- */\nfunction renderStats(){\n  var yr = new Date().getFullYear();\n  var fin = books.filter(function(b){ return b.shelf === \"finished\"; });\n  var finYr = fin.filter(function(b){ return b.finishedAt && new Date(b.finishedAt).getFullYear() === yr; });\n  var rated = fin.filter(function(b){ return b.rating; });\n  var avg = rated.length ? (rated.reduce(function(a,b){ return a + b.rating; }, 0) / rated.length).toFixed(1) : null;\n  var waiting = books.filter(function(b){ return b.shelf === \"want\"; }).length;\n  el(\"stats\").textContent = finYr.length + \" finished in \" + yr +\n    (avg ? \" · \" + avg + \"★ average\" : \"\") +\n    \" · \" + waiting + \" waiting\";\n  el(\"hFin\").textContent = finYr.length;\n  el(\"hLbl\").textContent = \"Finished in \" + yr;\n  el(\"hAvg\").hidden = !avg;\n  if (avg) el(\"hAvg\").innerHTML = icon(\"star\") + avg + \" average\";\n  el(\"hWait\").innerHTML = icon(\"clock\") + waiting + \" waiting\";\n  el(\"cR\").textContent = books.filter(function(b){ return b.shelf === \"reading\"; }).length || \"\";\n  el(\"cW\").textContent = waiting || \"\";\n  el(\"cF\").textContent = fin.length || \"\";\n}\n\n/* ---------- add via Open Library (manual fallback built in) ---------- */\nfunction findBtn(busy){ el(\"addgo\").disabled = busy; el(\"addgo\").innerHTML = busy ? '<i class=\"spin\"></i>' : \"Find\"; }\nfunction searchBooks(){\n  var q = el(\"addq\").value.trim();\n  if (!q) return;\n  haptic(\"light\");\n  if (!hasNet()){ offerManual(q, \"No internet access for apps — add it by hand:\"); return; }\n  findBtn(true);\n  el(\"addhint\").textContent = \"Searching Open Library…\";\n  el(\"results\").innerHTML = \"\";\n  NET(\"https://openlibrary.org/search.json?limit=5&fields=title,author_name,cover_i&q=\" + encodeURIComponent(q))\n  .then(function(r){\n    var j = JSON.parse(r.body);\n    findBtn(false);\n    el(\"addhint\").textContent = \"\";\n    if (!j.docs || !j.docs.length){ offerManual(q, \"Nothing found — add it by hand:\"); return; }\n    window.__found = j.docs.slice(0,5);\n    el(\"results\").innerHTML = window.__found.map(function(d, i){\n      var cov = d.cover_i ? \"https://covers.openlibrary.org/b/id/\" + d.cover_i + \"-M.jpg\" : \"\";\n      return '<div class=\"result\">' +\n        (cov ? '<img class=\"cov\" src=\"' + cov + '\" alt=\"\" loading=\"lazy\" data-h=\"' + spineHue(d.title) + '\" data-i=\"' + esc(initials(d.title)) + '\" onerror=\"coverFail(this)\">' : tileHTML(d.title)) +\n        '<div class=\"t\"><b>' + esc(d.title) + '</b><small>' + esc((d.author_name || []).slice(0,2).join(\", \")) + '</small></div>' +\n        '<div class=\"btns\"><button type=\"button\" onclick=\"addFound(' + i + ',\\'want\\')\">Want</button>' +\n        '<button type=\"button\" class=\"pri\" onclick=\"addFound(' + i + ',\\'reading\\')\">Reading</button></div>' +\n      '</div>';\n    }).join(\"\");\n  })\n  .catch(function(){\n    findBtn(false);\n    offerManual(q, \"Search didn't work — add it by hand:\");\n  });\n}\nfunction offerManual(q, msg){\n  el(\"addhint\").textContent = \"\";\n  window.__manual = q;\n  el(\"results\").innerHTML = '<div class=\"result\"><div class=\"cov blank\">' + icon(\"books\") + '</div>' +\n    '<div class=\"t\"><b>' + esc(q) + '</b><small>' + esc(msg) + '</small></div>' +\n    '<div class=\"btns\"><button type=\"button\" onclick=\"addManual(\\'want\\')\">Want</button>' +\n    '<button type=\"button\" class=\"pri\" onclick=\"addManual(\\'reading\\')\">Reading</button></div></div>';\n}\nfunction addFound(i, shelf){\n  var d = window.__found[i];\n  addBook({title:d.title, author:(d.author_name || [])[0] || \"\",\n           cover:d.cover_i ? \"https://covers.openlibrary.org/b/id/\" + d.cover_i + \"-M.jpg\" : null}, shelf);\n}\nfunction addManual(shelf){\n  var parts = String(window.__manual).split(/\\s+by\\s+/i);\n  addBook({title:parts[0], author:parts[1] || \"\", cover:null}, shelf);\n}\nfunction addBook(meta, shelf){\n  books.unshift({id:uid(), title:meta.title, author:meta.author, cover:meta.cover,\n                 shelf:shelf, rating:0, note:\"\", finishedAt:null});\n  el(\"results\").innerHTML = \"\"; el(\"addq\").value = \"\";\n  haptic(\"success\");\n  save(); showTab(shelf);\n}\n\n/* ---------- shelf ---------- */\nfunction starsHTML(n){\n  var s = \"\"; for (var i = 1; i <= 5; i++) s += '<svg class=\"' + (i <= n ? \"\" : \"off\") + '\"><use href=\"#i-star\"/></svg>';\n  return '<div class=\"stars\" aria-label=\"' + n + ' of 5 stars\">' + s + '</div>';\n}\nfunction recLabel(){ el(\"recbtn\").disabled = recBusy; el(\"recbtn\").innerHTML = recBusy ? '<i class=\"spin\"></i>Finding your next read…' : icon(\"spark\") + \"What should I read next?\"; }\nfunction render(){\n  renderStats();\n  el(\"recwrap\").style.display =\n    (hasAsk() && books.filter(function(b){ return b.shelf === \"finished\" && b.rating >= 4; }).length >= 2) ? \"block\" : \"none\";\n  recLabel();\n  var rows = books.filter(function(b){ return b.shelf === tab; });\n  if (!rows.length){\n    var msg = tab === \"reading\" ? \"Nothing on the go. Find a book above — or move one over from Want to read.\"\n            : tab === \"want\" ? \"Your someday-pile is empty. Lucky you — go browsing.\"\n            : \"Nothing finished yet. The first one's the sweetest.\";\n    el(\"shelf\").innerHTML = '<div class=\"card empty\"><div class=\"tile\">' + icon(\"books\") + '</div><p>' + msg + '</p></div>';\n    return;\n  }\n  el(\"shelf\").innerHTML = '<div class=\"shelf\">' + rows.map(function(b){\n    var acts = \"\";\n    if (tab === \"reading\") acts = '<button type=\"button\" class=\"pri\" onclick=\"openFinish(\\'' + b.id + '\\')\">' + icon(\"check\") + 'Finished</button>' +\n                                  '<button type=\"button\" onclick=\"moveBook(\\'' + b.id + '\\',\\'want\\')\">' + icon(\"pause\") + 'Pause</button>';\n    else if (tab === \"want\") acts = '<button type=\"button\" class=\"pri\" onclick=\"moveBook(\\'' + b.id + '\\',\\'reading\\')\">' + icon(\"play\") + 'Start</button>' +\n                                    '<button type=\"button\" class=\"x\" aria-label=\"Remove\" onclick=\"removeBook(\\'' + b.id + '\\')\">' + icon(\"x\") + '</button>';\n    else acts = '<button type=\"button\" class=\"x\" aria-label=\"Remove\" onclick=\"removeBook(\\'' + b.id + '\\')\">' + icon(\"x\") + '</button>';\n    return '<div class=\"book\">' + coverHTML(b) +\n      '<div class=\"t\"><b>' + esc(b.title) + '</b>' +\n      (b.author ? '<small>' + esc(b.author) + '</small>' : '') +\n      (b.rating ? starsHTML(b.rating) : '') +\n      (b.note ? '<div class=\"note\">“' + esc(b.note) + '”</div>' : '') +\n      '</div><div class=\"acts\">' + acts + '</div></div>';\n  }).join(\"\") + '</div>';\n}\nfunction moveBook(id, shelf){\n  var b = books.filter(function(x){ return x.id === id; })[0];\n  if (b){ b.shelf = shelf; haptic(\"selection\"); save(); render(); }\n}\nfunction removeBook(id){\n  books = books.filter(function(x){ return x.id !== id; });\n  haptic(\"light\"); save(); render();\n}\n\n/* ---------- finishing ---------- */\nfunction openFinish(id){\n  finishing = books.filter(function(x){ return x.id === id; })[0];\n  if (!finishing) return;\n  finRating = 0;\n  el(\"fintitle\").textContent = \"Finished “\" + finishing.title + \"”!\";\n  el(\"finnote\").value = \"\";\n  renderStars();\n  el(\"veil\").classList.add(\"on\"); el(\"sheet\").classList.add(\"on\");\n  haptic(\"light\");\n}\nfunction renderStars(){\n  el(\"bstars\").innerHTML = [1,2,3,4,5].map(function(n){\n    return '<button type=\"button\" class=\"' + (n <= finRating ? \"on\" : \"\") + '\" aria-label=\"' + n + ' star' + (n > 1 ? \"s\" : \"\") + '\" onclick=\"setStar(' + n + ')\">' + icon(\"star\") + '</button>';\n  }).join(\"\");\n}\nfunction setStar(n){ finRating = n; haptic(\"selection\"); renderStars(); }\nfunction confirmFinish(){\n  if (!finishing) return;\n  finishing.shelf = \"finished\";\n  finishing.rating = finRating;\n  finishing.note = el(\"finnote\").value.trim();\n  finishing.finishedAt = Date.now();\n  closeSheet();\n  haptic(\"success\");\n  save(); showTab(\"finished\");\n}\nfunction closeSheet(){\n  el(\"veil\").classList.remove(\"on\"); el(\"sheet\").classList.remove(\"on\");\n  finishing = null;\n}\n\n/* ---------- AI recommendations ---------- */\n/* Labelled lines, not JSON — small models (Apple Intelligence) echo JSON\n   templates back verbatim. Echoed instructions are rejected and retried. */\nvar ECHO = /the book title|author['’]?s name|one short sentence|why i['’]d love it|repeat this line|labelled line/i;\nfunction parseRecs(reply){\n  var s = String(reply || \"\"), recs = [], got = false;\n  s.split(/\\r?\\n/).forEach(function(raw){\n    var ln = raw.replace(/\\*\\*/g, \"\").trim();\n    var m = ln.match(/^[-*#>\\s]*(BOOKS?)\\s*\\d*\\s*[:：]\\s*(.*)$/i);\n    if (!m) return;\n    got = true;\n    var parts = m[2].split(\"|\").map(function(x){ return x.trim(); });\n    if (!parts[0]) return;\n    recs.push({title:parts[0], author:parts[1] || \"\", why:parts.slice(2).join(\" | \")});\n  });\n  if (!got){ // model answered in the old JSON shape — accept it\n    var a = s.indexOf(\"[\"), b = s.lastIndexOf(\"]\");\n    if (a >= 0 && b > a) try{\n      var j = JSON.parse(s.slice(a, b + 1));\n      if (Array.isArray(j)) recs = j.filter(function(x){ return x && x.title; })\n        .map(function(x){ return {title:String(x.title), author:x.author ? String(x.author) : \"\", why:x.why ? String(x.why) : \"\"}; });\n    }catch(e){}\n  }\n  recs = recs.filter(function(x){\n    return x.title && !ECHO.test(x.title) && !ECHO.test(x.author) && !ECHO.test(x.why);\n  });\n  if (!recs.length) throw new Error(\"bad\");\n  return recs;\n}\nfunction recommend(){\n  if (!hasAsk() || recBusy) return;\n  haptic(\"light\");\n  var loved = books.filter(function(b){ return b.shelf === \"finished\" && b.rating >= 4; })\n                   .slice(0, 8)\n                   .map(function(b){ return '\"' + b.title + '\"' + (b.author ? \" by \" + b.author : \"\") + \" (\" + b.rating + \"/5\" + (b.note ? \", said: \" + b.note : \"\") + \")\"; });\n  var have = books.map(function(b){ return b.title.toLowerCase(); });\n  var p = \"Books I loved: \" + loved.join(\"; \") +\n      \".\\nSuggest 4 books I haven't mentioned that I'd probably love next. Reply with EXACTLY these labelled lines and nothing else:\\n\" +\n      \"BOOK: the book title | the author's name | one short sentence on why I'd love it — repeat this line for each of the 4 suggestions\";\n  var sys = {system:\"You are a well-read, honest book recommender.\"};\n  recBusy = true; recLabel();\n  el(\"reccard\").style.display = \"block\";\n  el(\"recs\").innerHTML = '<div class=\"skel\"></div><div class=\"skel\"></div><div class=\"skel\"></div>';\n  ASK(p, sys)\n  .then(function(r){ return parseRecs(r); })\n  .catch(function(){\n    return ASK(p + \"\\nIMPORTANT: fill each labelled line with real content — never repeat the instruction text.\", sys)\n      .then(function(r){ return parseRecs(r); });\n  })\n  .then(function(recs){\n    recs = recs.filter(function(x){ return have.indexOf(String(x.title).toLowerCase()) < 0; }).slice(0, 4);\n    if (!recs.length) throw new Error(\"bad\");\n    window.__recs = recs;\n    el(\"reccard\").style.display = \"block\";\n    el(\"recs\").innerHTML = recs.map(function(x, i){\n      return '<div class=\"rec\"><b>' + esc(x.title) + '</b>' + (x.author ? ' <span class=\"by\">— ' + esc(x.author) + '</span>' : '') +\n        '<small>' + esc(x.why || \"\") + '</small>' +\n        '<button type=\"button\" class=\"add\" onclick=\"addRec(' + i + ')\">' + icon(\"plus\") + 'Want to read</button></div>';\n    }).join(\"\");\n    haptic(\"success\");\n  })\n  .catch(function(){\n    el(\"reccard\").style.display = \"block\";\n    el(\"recs\").innerHTML = '<div class=\"warn\">' + icon(\"warn\") + '<span>The recommendations didn\\'t come through cleanly — tap the button to try again.</span></div>';\n  })\n  .then(function(){ recBusy = false; recLabel(); });\n}\nfunction addRec(i){\n  var x = window.__recs[i];\n  addBook({title:x.title, author:x.author || \"\", cover:null}, \"want\");\n}\n\n/* ---------- boot ---------- */\nrecLabel();\nstore.getItem(\"books\").then(function(v){\n  if (v){ try{ books = JSON.parse(v) || []; }catch(e){} }\n  if (!hasNet()) el(\"addhint\").textContent = \"No internet access for apps — you can still add books by hand (type the title, then Find).\";\n  render();\n});\n</script>\n</body>\n</html>\n"}