{"name": "Receipt Logger", "html": "<!doctype html>\n<!--\n  Receipt Logger — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>:root{--build-id:\"0fdde3cc0a\";color-scheme:light dark}\n*{box-sizing:border-box}\nbody{font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);margin:0;padding:16px;background:var(--myllm-bg,#f2f2f7);color:var(--myllm-text,#111)}\nh1{font-size:22px;margin:0 0 2px}\n.sub{font-size:13px;color:var(--myllm-muted,#8a8a8e);margin:0 0 14px}\n.total{background:var(--myllm-surface,#fff);border-radius:16px;padding:16px;text-align:center;margin-bottom:12px}\n.total .n{font-size:34px;font-weight:800}\n.total .l{font-size:13px;color:var(--myllm-muted,#8a8a8e)}\nbutton.go{width:100%;border:0;background:var(--myllm-accent,#0a84ff);color:#fff;border-radius:12px;padding:14px;font-size:16px;font-weight:700}\nbutton.go:disabled{opacity:.5}\n.row{background:var(--myllm-surface,#fff);border-radius:12px;padding:12px 14px;margin-top:8px;display:flex;align-items:center;gap:10px}\n.row .m{flex:1}\n.row .m b{font-size:15px}\n.row .m span{display:block;font-size:12px;color:var(--myllm-muted,#8a8a8e)}\n.row .amt{font-weight:700;font-size:15px}\n.row .del{background:none;border:0;color:#ff453a;font-size:18px;padding:4px 6px}\n.note{color:var(--myllm-muted,#8a8a8e);font-size:14px;text-align:center;margin-top:18px;line-height:1.5;padding:0 6px}\n.bar{display:flex;gap:8px;margin-top:12px}\n.bar button{flex:1;border:0;border-radius:10px;padding:10px;font-size:13px;font-weight:600;background:rgba(10,132,255,.14);color:var(--myllm-accent,#0a84ff)}\n@media(min-width:768px){body{max-width:680px;margin-left:auto;margin-right:auto}}\n</style></head><body>\n<h1>🧾 Receipt Logger</h1>\n<p class=\"sub\">Scan a receipt — it reads the total and keeps a running tally.</p>\n<div class=\"total\"><div class=\"n\" id=\"sum\">—</div><div class=\"l\" id=\"count\">No receipts yet</div></div>\n<button class=\"go\" id=\"goBtn\" onclick=\"scan()\">📸 Scan a receipt</button>\n<div id=\"list\"></div>\n<div class=\"bar\" id=\"bar\" style=\"display:none\"><button id=\"shareB\">Share summary</button><button id=\"clearB\">Clear all</button></div>\n<p class=\"note\" id=\"hint\">Scanning and reading happen on your device. Needs the latest MyLLM with “Allow apps to use the AI” enabled.</p>\n\n<script>\nvar SCAN = window.myllmScan || null;\nvar ASK = window.myllmAsk || null;\nvar store = window.myllmStorage || {getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar haptic = window.myllmHaptic || function(){};\nvar items = [];\n\nfunction el(id){return document.getElementById(id)}\n\nfunction scan(){\n  if(!SCAN){ el('hint').textContent='This needs the latest MyLLM with document scanning (v3.6+) and “Allow apps to use the AI” on.'; return; }\n  haptic('light');\n  el('goBtn').disabled=true; el('goBtn').textContent='Scanning…';\n  SCAN().then(function(text){\n    if(!text){ return; } // cancelled / nothing found\n    el('goBtn').textContent='Reading…';\n    return extract(text).then(function(rec){\n      items.unshift(rec); save(); render(); haptic('success');\n    });\n  }).catch(function(e){ el('hint').textContent=(e&&e.message)?e.message:'Scan failed'; })\n    .then(function(){ el('goBtn').disabled=false; el('goBtn').textContent='📸 Scan a receipt'; });\n}\n\nfunction extract(text){\n  if(!ASK){ return Promise.resolve({merchant:'Receipt', total:null, currency:'', date:'', raw:text}); }\n  var prompt='From this receipt text, extract JSON ONLY: {\"merchant\":string,\"date\":string,\"total\":number,\"currency\":string(symbol like £ or $)}. '+\n    'If a field is unknown use \"\" (or 0 for total). Receipt text:\\n'+text.slice(0,1500);\n  return ASK(prompt,{system:'You output only one compact JSON object, no prose.'}).then(function(reply){\n    try{ var s=reply.indexOf('{'),e=reply.lastIndexOf('}'); var o=JSON.parse(reply.slice(s,e+1));\n      return {merchant:o.merchant||'Receipt', total:(typeof o.total==='number'?o.total:parseFloat(o.total)||null), currency:o.currency||'', date:o.date||'', raw:text}; }\n    catch(err){ return {merchant:'Receipt', total:null, currency:'', date:'', raw:text}; }\n  }).catch(function(){ return {merchant:'Receipt', total:null, currency:'', date:'', raw:text}; });\n}\n\nfunction render(){\n  var L=el('list'); L.innerHTML='';\n  var cur='', sum=0, n=0;\n  items.forEach(function(it,i){\n    if(typeof it.total==='number'){ sum+=it.total; n++; if(it.currency) cur=it.currency; }\n    var d=document.createElement('div'); d.className='row';\n    d.innerHTML='<div class=\"m\"><b></b><span></span></div><div class=\"amt\"></div><button class=\"del\">✕</button>';\n    d.querySelector('b').textContent=it.merchant||'Receipt';\n    d.querySelector('.m span').textContent=it.date||'';\n    d.querySelector('.amt').textContent=(typeof it.total==='number')?((it.currency||'')+it.total.toFixed(2)):'—';\n    d.querySelector('.del').onclick=function(){ items.splice(i,1); save(); render(); };\n    L.appendChild(d);\n  });\n  el('sum').textContent = n? (cur+sum.toFixed(2)) : '—';\n  el('count').textContent = items.length? (items.length+' receipt'+(items.length>1?'s':'')+(n<items.length?' ('+(items.length-n)+' unread)':'')) : 'No receipts yet';\n  el('bar').style.display = items.length? 'flex':'none';\n  el('shareB').onclick=function(){ if(window.myllmShare) window.myllmShare('Receipts total: '+(cur+sum.toFixed(2))+' across '+n+' receipts.'); };\n  el('clearB').onclick=function(){ items=[]; save(); render(); };\n}\n\nfunction save(){ store.setItem('receipts', JSON.stringify(items.slice(0,200))); }\nfunction load(){ return store.getItem('receipts').then(function(v){ try{return v?JSON.parse(v):[]}catch(e){return []} }); }\n\nload().then(function(v){ items=v; render(); });\n</script></body></html>\n"}