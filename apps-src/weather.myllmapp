{"name": "Weather", "html": "<!doctype html>\n<!--\n  Weather — MyLLMos App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>:root{--build-id:\"73349fd0a0\";color-scheme:light dark;--accent:#0a84ff}\n*{box-sizing:border-box}\nbody{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:18px;background:#f2f2f7;color:#111}\n@media(prefers-color-scheme:dark){body{background:#000;color:#eee}input,.cur,.day,.tip{background:#1c1c1e;color:#eee;border-color:#3a3a3c}.unit{background:#1c1c1e}}\nh1{font-size:22px;margin:0 0 4px}\n.sub{font-size:13px;opacity:.6;margin-bottom:14px}\n.row{display:flex;gap:8px;margin-bottom:10px}\ninput{flex:1;min-width:0;padding:11px;border:1px solid #d1d1d6;border-radius:10px;font-size:16px;background:#fff;color:#111}\nbutton.go{border:0;background:var(--accent);color:#fff;border-radius:10px;padding:0 16px;font-size:15px;font-weight:600}\n.unit{display:inline-flex;background:#e5e5ea;border-radius:9px;overflow:hidden;margin-bottom:12px}\n.unit button{border:0;background:transparent;color:inherit;padding:7px 14px;font-size:14px;font-weight:600}\n.unit button.on{background:var(--accent);color:#fff}\n#status{font-size:13px;opacity:.7;min-height:16px;margin:6px 0}\n.cur{background:#fff;border-radius:18px;padding:20px;box-shadow:0 1px 4px rgba(0,0,0,.1);display:none;text-align:center}\n.cur .loc{font-size:15px;opacity:.7}\n.cur .big{font-size:58px;line-height:1.05;font-weight:300;margin:2px 0}\n.cur .ico{font-size:46px}\n.cur .desc{font-size:16px;font-weight:600}\n.cur .extra{font-size:13px;opacity:.65;margin-top:8px}\n.days{display:flex;gap:8px;overflow-x:auto;margin-top:12px;display:none}\n.day{flex:1;min-width:62px;background:#fff;border-radius:13px;padding:11px 6px;text-align:center;box-shadow:0 1px 3px rgba(0,0,0,.08)}\n.day .d{font-size:12px;opacity:.65}.day .e{font-size:24px;margin:4px 0}.day .hi{font-weight:700;font-size:14px}.day .lo{font-size:13px;opacity:.55}\n.tip{background:#eef;border-radius:13px;padding:13px 15px;margin-top:12px;font-size:14px;line-height:1.5;display:none}\nbutton.wear{margin-top:12px;border:0;background:#e8eefc;color:var(--accent);border-radius:11px;padding:11px 16px;font-size:14px;font-weight:600;display:none}\n@media(prefers-color-scheme:dark){.unit{background:#1c1c1e}.tip{background:#15152a}button.wear{background:#15223a}}\n</style></head><body>\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-family:-apple-system,system-ui,sans-serif;font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;line-height:1;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n@media(min-width:768px){body{max-width:760px;margin-left:auto;margin-right:auto}}\n</style>\n<script>\n(function(){\n  if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;\n  window.__myllmAiWrap=true;\n  var orig=window.myllmAsk,depth=0,node=null;\n  function ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\n    node.innerHTML='<span class=\"myllm-ai-cog\">\\u2699\\uFE0F</span><span>AI is thinking\\u2026 <small>privately, on your device</small></span>';\n    (document.body||document.documentElement).appendChild(node);}\n  function show(){ensure();depth++;node.classList.add('on');}\n  function hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\n  window.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\n    return Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};\n})();\n</script>\n\n<h1>⛅ Weather</h1>\n<div class=\"sub\">Live forecast for anywhere. No account, no tracking.</div>\n<div class=\"row\"><input id=\"city\" placeholder=\"City (e.g. London, Tokyo)\" enterkeyhint=\"search\"><button class=\"go\" onclick=\"search()\">Get weather</button></div>\n<div class=\"unit\"><button id=\"uC\" class=\"on\" onclick=\"setUnit('c')\">°C</button><button id=\"uF\" onclick=\"setUnit('f')\">°F</button></div>\n<div id=\"status\"></div>\n<div class=\"cur\" id=\"cur\"></div>\n<div class=\"days\" id=\"days\"></div>\n<button class=\"wear\" id=\"wearBtn\" onclick=\"wear()\">👕 What should I wear?</button>\n<div class=\"tip\" id=\"tip\"></div>\n<script>\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar unit='c',place=null,last=null;\nfunction el(i){return document.getElementById(i)}\nfunction setStatus(t){el('status').textContent=t||''}\nfunction uTemp(){return unit==='f'?'fahrenheit':'celsius'}\nfunction uWind(){return unit==='f'?'mph':'kmh'}\nfunction deg(){return unit==='f'?'°F':'°C'}\nfunction wspd(){return unit==='f'?'mph':'km/h'}\n\nvar WMO={0:['☀️','Clear sky'],1:['🌤️','Mainly clear'],2:['⛅','Partly cloudy'],3:['☁️','Overcast'],\n45:['🌫️','Fog'],48:['🌫️','Rime fog'],51:['🌦️','Light drizzle'],53:['🌦️','Drizzle'],55:['🌦️','Heavy drizzle'],\n56:['🌧️','Freezing drizzle'],57:['🌧️','Freezing drizzle'],61:['🌧️','Light rain'],63:['🌧️','Rain'],65:['🌧️','Heavy rain'],\n66:['🌧️','Freezing rain'],67:['🌧️','Freezing rain'],71:['🌨️','Light snow'],73:['🌨️','Snow'],75:['🌨️','Heavy snow'],\n77:['🌨️','Snow grains'],80:['🌦️','Light showers'],81:['🌦️','Showers'],82:['⛈️','Violent showers'],\n85:['🌨️','Snow showers'],86:['🌨️','Snow showers'],95:['⛈️','Thunderstorm'],96:['⛈️','Thunderstorm + hail'],99:['⛈️','Thunderstorm + hail']};\nfunction wmo(c,day){var w=WMO[c]||['🌡️','—'];var e=w[0];if(c<=1&&day===0)e='🌙';return{e:e,t:w[1]}}\nfunction dayName(iso){var d=new Date(iso+'T00:00');return d.toLocaleDateString(undefined,{weekday:'short'})}\n\nfunction search(){\n  var q=el('city').value.trim();if(!q)return;\n  if(!window.myllmFetch){setStatus('This app needs network access — update MyLLM and enable app network access in Settings.');return}\n  setStatus('Finding “'+q+'”…');\n  myllmFetch('https://geocoding-api.open-meteo.com/v1/search?count=1&language=en&name='+encodeURIComponent(q))\n  .then(function(r){\n    if(!r||!r.ok)throw new Error('lookup failed');\n    var g=JSON.parse(r.body);\n    if(!g.results||!g.results.length)throw new Error('couldn’t find that place');\n    var p=g.results[0];place={lat:p.latitude,lon:p.longitude,name:p.name,region:p.admin1||'',country:p.country||''};\n    store.setItem('place',JSON.stringify(place));load();\n  }).catch(function(e){setStatus('Could not search: '+e.message)});\n}\nfunction load(){\n  if(!place)return;setStatus('Loading forecast…');\n  var u='https://api.open-meteo.com/v1/forecast?latitude='+place.lat+'&longitude='+place.lon+\n    '&current=temperature_2m,weather_code,wind_speed_10m,relative_humidity_2m,is_day'+\n    '&daily=weather_code,temperature_2m_max,temperature_2m_min&forecast_days=5&timezone=auto'+\n    '&temperature_unit='+uTemp()+'&wind_speed_unit='+uWind();\n  myllmFetch(u).then(function(r){\n    if(!r||!r.ok)throw new Error('forecast failed');\n    last=JSON.parse(r.body);render();setStatus('');\n  }).catch(function(e){setStatus('Could not load forecast: '+e.message)});\n}\nfunction render(){\n  if(!last)return;var c=last.current,w=wmo(c.weather_code,c.is_day);\n  var loc=place.name+(place.region&&place.region!==place.name?', '+place.region:'')+(place.country?', '+place.country:'');\n  el('cur').style.display='block';\n  el('cur').innerHTML='<div class=\"loc\">'+loc+'</div><div class=\"ico\">'+w.e+'</div>'+\n    '<div class=\"big\">'+Math.round(c.temperature_2m)+deg()+'</div>'+\n    '<div class=\"desc\">'+w.t+'</div>'+\n    '<div class=\"extra\">💧 '+c.relative_humidity_2m+'%  ·  💨 '+Math.round(c.wind_speed_10m)+' '+wspd()+'</div>';\n  var D=el('days');D.style.display='flex';D.innerHTML='';\n  for(var i=0;i<last.daily.time.length;i++){\n    var dw=wmo(last.daily.weather_code[i],1);\n    var div=document.createElement('div');div.className='day';\n    div.innerHTML='<div class=\"d\">'+(i===0?'Today':dayName(last.daily.time[i]))+'</div>'+\n      '<div class=\"e\">'+dw.e+'</div>'+\n      '<div class=\"hi\">'+Math.round(last.daily.temperature_2m_max[i])+'°</div>'+\n      '<div class=\"lo\">'+Math.round(last.daily.temperature_2m_min[i])+'°</div>';\n    D.appendChild(div);\n  }\n  el('tip').style.display='none';\n  el('wearBtn').style.display=window.myllmAsk?'inline-block':'none';\n}\nfunction setUnit(u){if(unit===u)return;unit=u;el('uC').classList.toggle('on',u==='c');el('uF').classList.toggle('on',u==='f');store.setItem('unit',u);if(place)load()}\nfunction wear(){\n  if(!last||!window.myllmAsk)return;var c=last.current,w=wmo(c.weather_code,c.is_day);\n  el('wearBtn').disabled=true;setStatus('Thinking…');\n  myllmAsk('Weather right now: '+Math.round(c.temperature_2m)+deg()+', '+w.t+', wind '+Math.round(c.wind_speed_10m)+' '+wspd()+', humidity '+c.relative_humidity_2m+'%. In ONE friendly sentence, say what to wear and whether to take an umbrella.')\n  .then(function(reply){var t=el('tip');t.textContent='👕 '+reply.trim();t.style.display='block';setStatus('')})\n  .catch(function(e){setStatus('')}).then(function(){el('wearBtn').disabled=false});\n}\nel('city').addEventListener('keydown',function(e){if(e.key==='Enter')search()});\nPromise.all([store.getItem('place'),store.getItem('unit')]).then(function(r){\n  if(r[1])unit=r[1];el('uC').classList.toggle('on',unit==='c');el('uF').classList.toggle('on',unit==='f');\n  if(r[0]){try{place=JSON.parse(r[0]);el('city').value=place.name;load()}catch(e){}}\n  if(!window.myllmFetch)setStatus('Heads-up: this app needs app network access (Settings).');\n});\n</script></body></html>\n", "kind": "html", "iconSymbol": "cloud.sun.fill", "iconColor": "blue"}