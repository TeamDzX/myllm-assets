{"name": "Weather", "html": "<!doctype html>\n<!--\n  Weather — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Weather</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"73349fd0a0\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); --h:205; }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  @property --wh{ syntax:'<number>'; inherits:true; initial-value:205; }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:760px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.96); }\n  [hidden]{ display:none !important; }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 28%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  .head .acts{ display:flex; gap:8px; flex-shrink:0; }\n  .seg{ display:flex; background:var(--fill); border-radius:12px; padding:3px; }\n  .seg button{ min-width:42px; height:34px; border:0; background:none; border-radius:9px; font-size:14px; font-weight:750; color:var(--muted); }\n  .seg button.on{ background:var(--surface); color:var(--ink); box-shadow:0 1px 3px rgba(0,0,0,.14); }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  .search{ display:flex; gap:8px; }\n  .field{ flex:1; min-width:0; display:flex; align-items:center; gap:8px; border:1px solid var(--line); background:var(--bg); border-radius:12px; padding:0 12px; }\n  .field svg{ color:var(--muted); }\n  .field input{ flex:1; min-width:0; border:0; background:none; outline:none; font:inherit; font-size:16px; padding:12px 0; color:var(--ink); }\n  .field:focus-within{ border-color:var(--acc); }\n  .go{ flex-shrink:0; min-height:46px; border:0; border-radius:12px; padding:0 16px; background:var(--acc); color:#fff; font-size:15px; font-weight:700; display:flex; align-items:center; gap:7px; }\n  .go:disabled{ opacity:.55; }\n  .spin{ width:16px; height:16px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n\n  /* the hero takes the weather's colour: cold blue, mild teal, warm amber, hot red; night and storms darker */\n  .hero{ --wh:205; transition:--wh 1s ease; border-radius:22px; padding:16px 18px 14px; color:#fff; margin-bottom:12px; overflow:hidden;\n    background:linear-gradient(160deg, hsl(var(--wh) 66% 50%), hsl(calc(var(--wh) + 28) 60% 28%)); box-shadow:0 12px 30px hsl(var(--wh) 60% 30% / .28); }\n  .hero.night{ background:linear-gradient(160deg, hsl(var(--wh) 42% 32%), hsl(calc(var(--wh) + 20) 45% 13%)); }\n  .hero .loc{ display:flex; align-items:center; gap:6px; font-size:13px; font-weight:700; letter-spacing:.02em; opacity:.88; }\n  .hero .loc span{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  .hero .now{ display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:4px; }\n  .hero .big{ font-size:68px; font-weight:250; line-height:1; letter-spacing:-.04em; font-variant-numeric:tabular-nums; }\n  .hero .big small{ font-size:26px; font-weight:400; letter-spacing:0; vertical-align:top; margin-left:2px; opacity:.85; }\n  .hero .wx{ width:74px; height:74px; fill:#fff; flex-shrink:0; filter:drop-shadow(0 4px 12px rgba(0,0,0,.18)); }\n  .hero .desc{ font-size:18px; font-weight:700; margin-top:2px; }\n  .hero .extra{ display:flex; gap:16px; margin-top:6px; font-size:13.5px; opacity:.9; font-variant-numeric:tabular-nums; }\n  .hero .extra span{ display:inline-flex; align-items:center; gap:5px; }\n  .hours{ display:flex; gap:6px; overflow-x:auto; scrollbar-width:none; margin:14px -18px -2px; padding:0 18px 2px; }\n  .hours::-webkit-scrollbar{ display:none; }\n  .hr{ flex:0 0 auto; width:54px; border-radius:14px; padding:8px 0; text-align:center; background:rgba(255,255,255,.14); border:1px solid rgba(255,255,255,.14); }\n  .hr.cur{ background:rgba(255,255,255,.28); }\n  .hr b{ display:block; font-size:11.5px; font-weight:700; opacity:.85; }\n  .hr svg{ width:24px; height:24px; fill:#fff; margin:5px 0 3px; }\n  .hr span{ display:block; font-size:14.5px; font-weight:750; font-variant-numeric:tabular-nums; }\n\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:18px 2px 10px; }\n  .days{ padding:4px 14px; }\n  .day{ display:grid; grid-template-columns:56px 30px 38px 1fr 38px; align-items:center; gap:8px; padding:10px 0; border-bottom:1px solid var(--line); font-variant-numeric:tabular-nums; }\n  .day:last-child{ border-bottom:none; }\n  .day .d{ font-size:15px; font-weight:650; }\n  .day svg{ width:24px; height:24px; color:hsl(var(--h) 70% 50%); }\n  .day .lo{ font-size:15px; color:var(--muted); text-align:right; }\n  .day .hi{ font-size:15px; font-weight:750; }\n  .bar{ position:relative; height:6px; border-radius:99px; background:var(--fill); }\n  .bar i{ position:absolute; top:0; bottom:0; border-radius:99px; background:linear-gradient(90deg, #5ac8fa, #34c759 45%, #ffcc00 70%, #ff9500); }\n\n  .wear{ width:100%; min-height:48px; border:0; border-radius:14px; background:var(--fill); color:var(--acc); font-size:15px; font-weight:700; display:flex; align-items:center; justify-content:center; gap:8px; margin-top:12px; }\n  .wear:disabled{ opacity:.6; }\n  .tip{ display:flex; gap:12px; align-items:flex-start; margin-top:10px; }\n  .tip .tile{ width:36px; height:36px; border-radius:10px; font-size:15px; }\n  .tip p{ font-size:15px; line-height:1.5; }\n  .tip small{ display:block; font-size:12.5px; color:var(--muted); margin-top:3px; }\n\n  .notice{ display:flex; gap:12px; align-items:flex-start; background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:14px; margin:0 0 12px; }\n  .notice .tile{ width:36px; height:36px; border-radius:10px; font-size:15px; }\n  .notice.err .tile{ background:linear-gradient(145deg,#ff6b5f,#c0392b); }\n  .notice.off .tile{ background:linear-gradient(145deg,#8e8e93,#48484a); }\n  .notice b{ display:block; font-size:15px; font-weight:750; }\n  .notice p{ font-size:13.5px; color:var(--muted); margin-top:2px; line-height:1.45; }\n  .notice button{ margin-top:10px; min-height:36px; padding:0 14px; border-radius:10px; border:0; background:var(--acc); color:#fff; font-weight:700; font-size:13.5px; display:inline-flex; align-items:center; gap:6px; }\n  .status{ display:flex; align-items:center; justify-content:center; gap:8px; font-size:13.5px; color:var(--muted); margin:-2px 0 12px; min-height:18px; }\n  .sk{ height:240px; border-radius:22px; background:var(--fill); margin-bottom:12px; animation:pulse 1.3s ease-in-out infinite; }\n  @keyframes pulse{ 50%{ opacity:.5; } }\n\n  @media (max-height:520px) and (min-width:600px){ .hero .big{ font-size:56px; } .hero .wx{ width:60px; height:60px; } }\n  @media (max-width:350px){ .hero .big{ font-size:56px; } .go span{ display:none; } }\n  @media (prefers-reduced-motion:reduce){ .hero{ transition:none; } .sk{ animation:none; } .spin{ animation-duration:2.4s; } button:active{ transform:none; } }\n  @keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n  .myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n  .myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n  .myllm-ai-cog{width:16px;height:16px;border-radius:50%;border:2.4px solid #a78bfa;border-right-color:transparent;animation:myllmAiSpin .9s linear infinite;flex-shrink:0}\n  .myllm-ai-busy small{font-weight:400;opacity:.6}\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"w-sun\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"4.6\"/><path d=\"M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" fill=\"none\"/></symbol>\n  <symbol id=\"w-moon\" viewBox=\"0 0 24 24\"><path d=\"M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a.6.6 0 0 0-.8-.7A9.6 9.6 0 1 0 21.2 15.4a.6.6 0 0 0-.7-.8z\"/></symbol>\n  <symbol id=\"w-suncloud\" viewBox=\"0 0 24 24\"><circle cx=\"8.3\" cy=\"8.3\" r=\"3.3\"/><path d=\"M8.3 2.4v1.3M2.4 8.3h1.3M4.2 4.2l.9.9M12.4 4.2l-.9.9M4.2 12.4l.9-.9\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" fill=\"none\"/><path d=\"M9.3 20.8a4 4 0 0 1-.5-8 5.4 5.4 0 0 1 10.3 1.3 3.4 3.4 0 0 1-.3 6.7z\"/></symbol>\n  <symbol id=\"w-mooncloud\" viewBox=\"0 0 24 24\"><path d=\"M12 9.2a5 5 0 0 1-6.3-6.3.4.4 0 0 0-.5-.5 5.8 5.8 0 1 0 7.3 7.3.4.4 0 0 0-.5-.5z\"/><path d=\"M9.3 20.8a4 4 0 0 1-.5-8 5.4 5.4 0 0 1 10.3 1.3 3.4 3.4 0 0 1-.3 6.7z\"/></symbol>\n  <symbol id=\"w-cloud\" viewBox=\"0 0 24 24\"><path d=\"M7 19a4.5 4.5 0 0 1-.6-9 6 6 0 0 1 11.5 1.5A3.8 3.8 0 0 1 17.5 19z\"/></symbol>\n  <symbol id=\"w-fog\" viewBox=\"0 0 24 24\"><path d=\"M7 11.5a4 4 0 0 1-.4-7.9 5.3 5.3 0 0 1 10.2 1.3A3.3 3.3 0 0 1 16.5 11.5z\"/><path d=\"M4 15h16M5.5 19h13\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" fill=\"none\"/></symbol>\n  <symbol id=\"w-drizzle\" viewBox=\"0 0 24 24\"><path d=\"M7 14.5a4.2 4.2 0 0 1-.5-8.4 5.6 5.6 0 0 1 10.8 1.4A3.5 3.5 0 0 1 17 14.5z\"/><path d=\"M8.5 17.6v1.2M12.5 17.6v1.2M16.5 17.6v1.2\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" fill=\"none\"/></symbol>\n  <symbol id=\"w-rain\" viewBox=\"0 0 24 24\"><path d=\"M7 14.5a4.2 4.2 0 0 1-.5-8.4 5.6 5.6 0 0 1 10.8 1.4A3.5 3.5 0 0 1 17 14.5z\"/><path d=\"M9 17l-1.1 3.2M13 17l-1.1 3.2M17 17l-1.1 3.2\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" fill=\"none\"/></symbol>\n  <symbol id=\"w-snow\" viewBox=\"0 0 24 24\"><path d=\"M7 14.5a4.2 4.2 0 0 1-.5-8.4 5.6 5.6 0 0 1 10.8 1.4A3.5 3.5 0 0 1 17 14.5z\"/><circle cx=\"8.3\" cy=\"18.3\" r=\"1.25\"/><circle cx=\"12.3\" cy=\"20\" r=\"1.25\"/><circle cx=\"16.3\" cy=\"18.3\" r=\"1.25\"/></symbol>\n  <symbol id=\"w-storm\" viewBox=\"0 0 24 24\"><path d=\"M7 14a4.2 4.2 0 0 1-.5-8.4 5.6 5.6 0 0 1 10.8 1.4A3.5 3.5 0 0 1 17 14z\"/><path d=\"M12.8 14.6l-3.2 4.6h2.6l-1 3.3 3.9-5h-2.6l1.4-2.9z\"/></symbol>\n  <symbol id=\"w-temp\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5a3 3 0 0 1 3 3v8.1a5 5 0 1 1-6 0V5.5a3 3 0 0 1 3-3zm0 2a1 1 0 0 0-1 1v9.2l-.4.3a3 3 0 1 0 2.8 0l-.4-.3V5.5a1 1 0 0 0-1-1z\"/></symbol>\n  <symbol id=\"i-drop\" viewBox=\"0 0 24 24\"><path d=\"M12 3c-.3 0-.5.1-.7.3C9 6 5.5 10.4 5.5 14a6.5 6.5 0 0 0 13 0c0-3.6-3.5-8-5.8-10.7A1 1 0 0 0 12 3z\"/></symbol>\n  <symbol id=\"i-wind\" viewBox=\"0 0 24 24\"><path d=\"M3 9h11a2.5 2.5 0 1 0-2.5-2.5M3 13h15a2.5 2.5 0 1 1-2.5 2.5M3 17h8\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" fill=\"none\"/></symbol>\n  <symbol id=\"i-shirt\" viewBox=\"0 0 24 24\"><path d=\"M8.5 3.5L4 5.5 2.5 10l3.3 1.3.9-1.4V20a1 1 0 0 0 1 1h8.6a1 1 0 0 0 1-1V9.9l.9 1.4 3.3-1.3L20 5.5l-4.5-2a3.6 3.6 0 0 1-7 0z\"/></symbol>\n  <symbol id=\"i-search\" viewBox=\"0 0 24 24\"><path d=\"M10.5 3a7.5 7.5 0 0 1 6 12l4.3 4.3a1 1 0 0 1-1.4 1.4L15 16.5A7.5 7.5 0 1 1 10.5 3zm0 2a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11z\"/></symbol>\n  <symbol id=\"i-pin\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5a7 7 0 0 1 7 7c0 5-5.6 10.6-6.3 11.3a1 1 0 0 1-1.4 0C10.6 20.1 5 14.5 5 9.5a7 7 0 0 1 7-7zm0 4.3a2.7 2.7 0 1 0 0 5.4 2.7 2.7 0 0 0 0-5.4z\"/></symbol>\n  <symbol id=\"i-refresh\" viewBox=\"0 0 24 24\"><path d=\"M20 12a8 8 0 1 1-2.6-5.9M20 4v5h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-off\" viewBox=\"0 0 24 24\"><path d=\"M3.3 3.3a1 1 0 0 1 1.4 0l16 16a1 1 0 0 1-1.4 1.4l-3.5-3.5a2 2 0 1 1-2.5-2.5L10.8 12a5 5 0 0 0-3.4 1.6 1 1 0 0 1-1.5-1.3 7 7 0 0 1 3.1-2L7 8.4a10 10 0 0 0-3.2 2.2 1 1 0 0 1-1.4-1.4A12 12 0 0 1 5.6 7L3.3 4.7a1 1 0 0 1 0-1.4zM12 6c3.5 0 6.8 1.4 9.2 3.8a1 1 0 0 1-1.4 1.4A11 11 0 0 0 12 8h-.6L9.6 6.2C10.4 6.1 11.2 6 12 6z\"/></symbol>\n  <symbol id=\"i-warn\" viewBox=\"0 0 24 24\"><path d=\"M10.3 3.9a2 2 0 0 1 3.4 0l8 13.6a2 2 0 0 1-1.7 3H4a2 2 0 0 1-1.7-3zM12 9a1 1 0 0 0-1 1v4a1 1 0 0 0 2 0v-4a1 1 0 0 0-1-1zm0 7.2a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z\"/></symbol>\n</defs></svg>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\"></span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#w-suncloud\"/></svg></div>\n  <div class=\"ht\"><h1>Weather</h1><p>Live forecast for anywhere — no account, no tracking</p></div>\n  <div class=\"acts\"><div class=\"seg\" role=\"group\" aria-label=\"Units\"><button id=\"uC\" class=\"on\" type=\"button\">°C</button><button id=\"uF\" type=\"button\">°F</button></div></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Weather\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n\n<div class=\"card\">\n  <div class=\"search\">\n    <label class=\"field\"><svg class=\"i\"><use href=\"#i-search\"/></svg><input id=\"city\" placeholder=\"City (e.g. London, Tokyo)\" enterkeyhint=\"search\" autocomplete=\"off\" aria-label=\"City\"></label>\n    <button class=\"go\" id=\"goBtn\" type=\"button\"><svg class=\"i\"><use href=\"#i-search\"/></svg><span>Search</span></button>\n  </div>\n</div>\n<div class=\"status\" id=\"status\"></div>\n<div id=\"notice\"></div>\n<div class=\"notice\" id=\"empty\" hidden><div class=\"tile\"><svg class=\"i\"><use href=\"#i-pin\"/></svg></div><div><b>Where are you looking?</b><p>Search for a city to see its weather now, the next 24 hours and the days ahead.</p></div></div>\n<div class=\"sk\" id=\"sk\" hidden></div>\n\n<div class=\"hero\" id=\"cur\" hidden></div>\n<div id=\"dayWrap\" hidden><h2>Next few days</h2><div class=\"card days\" id=\"days\"></div></div>\n<div id=\"wearWrap\" hidden>\n  <button class=\"wear\" id=\"wearBtn\" type=\"button\"><svg class=\"i\"><use href=\"#i-shirt\"/></svg><span>What should I wear?</span></button>\n  <div class=\"card tip\" id=\"tip\" hidden><div class=\"tile\"><svg class=\"i\"><use href=\"#i-shirt\"/></svg></div><div><p id=\"tipText\"></p></div></div>\n</div>\n\n<script>\nvar unit='c',place=null,last=null;\nfunction el(i){return document.getElementById(i)}\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction store(){return window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}}}\nfunction net(){return window.myllmFetch||null}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nfunction esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;')}\nfunction icon(n){return '<svg class=\"i\"><use href=\"#'+n+'\"/></svg>'}\nfunction setStatus(t,busy){el('status').innerHTML=t?(busy?'<i class=\"spin\"></i>':'')+'<span>'+esc(t)+'</span>':''}\nfunction notice(kind,title,text,retry){\n  var N=el('notice');\n  if(!kind){N.innerHTML='';return}\n  N.innerHTML='<div class=\"notice '+kind+'\"><div class=\"tile\">'+icon(kind==='off'?'i-off':'i-warn')+'</div><div><b>'+esc(title)+'</b><p>'+esc(text)+'</p>'+\n    (retry?'<button type=\"button\">'+icon('i-refresh')+'Try again</button>':'')+'</div></div>';\n  if(retry)N.querySelector('button').onclick=retry;\n}\nfunction uTemp(){return unit==='f'?'fahrenheit':'celsius'}\nfunction uWind(){return unit==='f'?'mph':'kmh'}\nfunction deg(){return unit==='f'?'°F':'°C'}\nfunction wspd(){return unit==='f'?'mph':'km/h'}\n\nvar WMO={0:['sun','Clear sky'],1:['suncloud','Mainly clear'],2:['suncloud','Partly cloudy'],3:['cloud','Overcast'],\n45:['fog','Fog'],48:['fog','Rime fog'],51:['drizzle','Light drizzle'],53:['drizzle','Drizzle'],55:['drizzle','Heavy drizzle'],\n56:['drizzle','Freezing drizzle'],57:['drizzle','Freezing drizzle'],61:['rain','Light rain'],63:['rain','Rain'],65:['rain','Heavy rain'],\n66:['rain','Freezing rain'],67:['rain','Freezing rain'],71:['snow','Light snow'],73:['snow','Snow'],75:['snow','Heavy snow'],\n77:['snow','Snow grains'],80:['rain','Light showers'],81:['rain','Showers'],82:['storm','Violent showers'],\n85:['snow','Snow showers'],86:['snow','Snow showers'],95:['storm','Thunderstorm'],96:['storm','Thunderstorm + hail'],99:['storm','Thunderstorm + hail']};\nfunction wmo(c,day){var w=WMO[c]||['temp','—'];var g=w[0];if(day===0){if(g==='sun')g='moon';else if(g==='suncloud')g=c<=1?'moon':'mooncloud'}return{g:'w-'+g,t:w[1],kind:w[0]}}\nfunction wx(g,cls){return '<svg class=\"'+(cls||'i')+'\"><use href=\"#'+g+'\"/></svg>'}\nfunction dayName(iso){var d=new Date(iso+'T00:00');return d.toLocaleDateString(undefined,{weekday:'short'})}\n\n/* Hue from how warm it feels (in °C whatever the display unit), nudged by the sky.\n   Two families, never the green in between: cool blues up to 19°, warm ambers\n   from 20°. The hue animates, so crossing over is a fade, not a jump. */\nvar HUES=[[-10,228],[0,215],[10,202],[19,188],[19.5,52],[25,36],[32,14],[38,4]];\nfunction hueFor(temp,kind,isDay){\n  var t=unit==='f'?(temp-32)*5/9:temp,h=HUES[0][1];\n  for(var i=0;i<HUES.length;i++){if(t<=HUES[i][0]){if(i===0)h=HUES[0][1];else{var a=HUES[i-1],b=HUES[i],k=(t-a[0])/(b[0]-a[0]);h=a[1]+(b[1]-a[1])*k}break}h=HUES[i][1]}\n  if(kind==='rain'||kind==='drizzle')h=h*0.4+208*0.6;\n  if(kind==='storm')h=262;if(kind==='snow')h=200;if(kind==='fog'||kind==='cloud')h=h*0.5+210*0.5;\n  if(!isDay)h=h*0.3+235*0.7;\n  return Math.round(h);\n}\n\nfunction search(){\n  var q=el('city').value.trim();if(!q)return;\n  if(!net()){notice('off','Network access is off','Weather needs “Allow apps to use the internet” in MyLLM’s Settings.',search);return}\n  notice(null);el('city').blur();\n  el('goBtn').disabled=true;setStatus('Finding “'+q+'”…',true);\n  net()('https://geocoding-api.open-meteo.com/v1/search?count=1&language=en&name='+encodeURIComponent(q))\n  .then(function(r){\n    if(!r||!r.ok)throw new Error('lookup failed');\n    var g=JSON.parse(r.body);\n    if(!g.results||!g.results.length)throw new Error('couldn’t find that place');\n    var p=g.results[0];place={lat:p.latitude,lon:p.longitude,name:p.name,region:p.admin1||'',country:p.country||''};\n    store().setItem('place',JSON.stringify(place));haptic('light');load();\n  }).catch(function(e){setStatus('');notice('err','Could not search',e.message,search)})\n  .then(function(){el('goBtn').disabled=false});\n}\nfunction load(){\n  if(!place)return;\n  if(!net()){notice('off','Network access is off','Weather needs “Allow apps to use the internet” in MyLLM’s Settings.',load);return}\n  notice(null);el('empty').hidden=true;\n  if(!last)el('sk').hidden=false;\n  setStatus('Loading forecast…',true);\n  var u='https://api.open-meteo.com/v1/forecast?latitude='+place.lat+'&longitude='+place.lon+\n    '&current=temperature_2m,weather_code,wind_speed_10m,relative_humidity_2m,is_day'+\n    '&hourly=temperature_2m,weather_code,is_day'+\n    '&daily=weather_code,temperature_2m_max,temperature_2m_min&forecast_days=5&timezone=auto'+\n    '&temperature_unit='+uTemp()+'&wind_speed_unit='+uWind();\n  net()(u).then(function(r){\n    if(!r||!r.ok)throw new Error('forecast failed');\n    last=JSON.parse(r.body);render();setStatus('');\n  }).catch(function(e){setStatus('');notice('err','Could not load the forecast',e.message,load)})\n  .then(function(){el('sk').hidden=true});\n}\nfunction hoursHtml(){\n  var H=last.hourly;if(!H||!H.time||!H.time.length)return '';\n  var nowKey=String(last.current.time||'').slice(0,13),start=0;\n  for(var i=0;i<H.time.length;i++){if(H.time[i].slice(0,13)>=nowKey){start=i;break}}\n  var out='';\n  for(var j=start;j<Math.min(start+24,H.time.length);j++){\n    var w=wmo(H.weather_code[j],H.is_day?H.is_day[j]:1);\n    var label=j===start?'Now':H.time[j].slice(11,13);\n    out+='<div class=\"hr'+(j===start?' cur':'')+'\"><b>'+label+'</b>'+wx(w.g,'')+'<span>'+Math.round(H.temperature_2m[j])+'°</span></div>';\n  }\n  return '<div class=\"hours\">'+out+'</div>';\n}\nfunction render(){\n  if(!last)return;var c=last.current,w=wmo(c.weather_code,c.is_day);\n  var loc=place.name+(place.region&&place.region!==place.name?', '+place.region:'')+(place.country?', '+place.country:'');\n  var hero=el('cur');hero.hidden=false;\n  hero.classList.toggle('night',c.is_day===0);\n  hero.style.setProperty('--wh',hueFor(c.temperature_2m,w.kind,c.is_day!==0));\n  hero.innerHTML='<div class=\"loc\">'+icon('i-pin')+'<span>'+esc(loc)+'</span></div>'+\n    '<div class=\"now\"><div class=\"big\">'+Math.round(c.temperature_2m)+'<small>'+deg()+'</small></div>'+wx(w.g,'wx')+'</div>'+\n    '<div class=\"desc\">'+esc(w.t)+'</div>'+\n    '<div class=\"extra\"><span>'+icon('i-drop')+c.relative_humidity_2m+'%</span><span>'+icon('i-wind')+Math.round(c.wind_speed_10m)+' '+wspd()+'</span></div>'+\n    hoursHtml();\n  var D=el('days');D.innerHTML='';\n  var lo=Math.min.apply(null,last.daily.temperature_2m_min),hi=Math.max.apply(null,last.daily.temperature_2m_max),span=Math.max(1,hi-lo);\n  for(var i=0;i<last.daily.time.length;i++){\n    var dw=wmo(last.daily.weather_code[i],1),mn=last.daily.temperature_2m_min[i],mx=last.daily.temperature_2m_max[i];\n    var row=document.createElement('div');row.className='day';\n    row.innerHTML='<div class=\"d\">'+(i===0?'Today':esc(dayName(last.daily.time[i])))+'</div>'+wx(dw.g,'i')+\n      '<div class=\"lo\">'+Math.round(mn)+'°</div>'+\n      '<div class=\"bar\"><i style=\"left:'+((mn-lo)/span*100).toFixed(1)+'%;width:'+Math.max(6,(mx-mn)/span*100).toFixed(1)+'%\"></i></div>'+\n      '<div class=\"hi\">'+Math.round(mx)+'°</div>';\n    row.setAttribute('aria-label',(i===0?'Today':dayName(last.daily.time[i]))+': '+dw.t+', '+Math.round(mn)+' to '+Math.round(mx)+' degrees');\n    D.appendChild(row);\n  }\n  el('dayWrap').hidden=false;\n  el('tip').hidden=true;\n  el('wearWrap').hidden=!window.myllmAsk;\n}\nfunction setUnit(u){\n  if(unit===u)return;unit=u;syncUnit();haptic('selection');\n  store().setItem('unit',u);if(place)load();\n}\nfunction syncUnit(){el('uC').classList.toggle('on',unit==='c');el('uF').classList.toggle('on',unit==='f')}\nfunction wear(){\n  if(!last||!window.myllmAsk)return;var c=last.current,w=wmo(c.weather_code,c.is_day);\n  var b=el('wearBtn');b.disabled=true;b.innerHTML='<i class=\"spin\"></i><span>Thinking…</span>';\n  myllmAsk('Weather right now: '+Math.round(c.temperature_2m)+deg()+', '+w.t+', wind '+Math.round(c.wind_speed_10m)+' '+wspd()+', humidity '+c.relative_humidity_2m+'%. In ONE friendly sentence, say what to wear and whether to take an umbrella.')\n  .then(function(reply){el('tipText').textContent=String(reply).trim();el('tip').hidden=false;haptic('success')})\n  .catch(function(){el('tipText').textContent='Couldn’t get a suggestion just now — try again in a moment.';el('tip').hidden=false})\n  .then(function(){b.disabled=false;b.innerHTML=icon('i-shirt')+'<span>What should I wear?</span>'});\n}\nel('uC').onclick=function(){setUnit('c')};\nel('uF').onclick=function(){setUnit('f')};\nel('goBtn').onclick=search;\nel('wearBtn').onclick=wear;\nel('city').addEventListener('keydown',function(e){if(e.key==='Enter')search()});\nPromise.all([store().getItem('place'),store().getItem('unit')]).then(function(r){\n  if(r[1]==='c'||r[1]==='f')unit=r[1];syncUnit();\n  if(r[0]){try{place=JSON.parse(r[0]);el('city').value=place.name;load()}catch(e){place=null}}\n  if(!place){el('empty').hidden=false;if(!net())notice('off','Network access is off','Weather needs “Allow apps to use the internet” in MyLLM’s Settings.',null)}\n});\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes.\n   The spacer keeps the header clear of the status bar / Dynamic Island. It is\n   live CSS — env(safe-area-inset-top) — not a measured number: the inset is\n   still 0 when the page loads and only grows once MyLLM's bar has gone (v1\n   measured once, so the title sat under the island). If the page's own styles\n   already pad the header down by the inset, the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  /* Does any rule that applies to the header or an ancestor already use the top inset? */\n  function pageHandlesInset(head){\n    var chain = [], n, found = false;\n    for (n = head; n && n.nodeType === 1; n = n.parentElement) chain.push(n);\n    function walk(rules){\n      for (var i = 0; i < rules.length && !found; i++){\n        var r = rules[i];\n        if (r.cssRules && !r.selectorText) { walk(r.cssRules); continue; }\n        if (!r.selectorText || !/safe-area-inset-top/.test(r.cssText) || !/(padding|margin|top)\\s*:/.test(r.cssText)) continue;\n        if (/\\.imm-safe/.test(r.selectorText)) continue;\n        for (var k = 0; k < chain.length; k++){\n          try { if (chain[k].matches(r.selectorText)) { found = true; break; } } catch(e){}\n        }\n      }\n    }\n    for (var s = 0; s < document.styleSheets.length && !found; s++){\n      try { walk(document.styleSheets[s].cssRules); } catch(e){}\n    }\n    for (n = head; n && n.nodeType === 1 && !found; n = n.parentElement){\n      if (/safe-area-inset-top/.test(n.getAttribute(\"style\") || \"\")) found = true;\n    }\n    return found;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = (document.body.classList.contains(\"imm\") && !pageHandlesInset(head)) ? \"env(safe-area-inset-top)\" : \"0px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script></body></html>\n", "kind": "html", "iconSymbol": "cloud.sun.fill", "iconColor": "blue"}