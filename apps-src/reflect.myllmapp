{"name": "Reflect", "kind": "html", "iconSymbol": "book.closed.fill", "iconColor": "teal", "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Reflect</title>\n<style>\n:root{\n  color-scheme:light dark;\n  --paper:#f6f4ee;--card:#ffffff;--ink:#26291f;--mut:#7d8074;--line:#e6e3d8;\n  --ac:#2e7d6a;--ac-soft:#e2efe9;--danger:#a84f3f;\n  --m0:#b5544a;--m1:#c08a45;--m2:#a8a04b;--m3:#7aa35c;--m4:#3d8f72;\n}\n@media(prefers-color-scheme:dark){:root{\n  --paper:#131511;--card:#1d201a;--ink:#e8e6dd;--mut:#8f927f;--line:#2c2f26;\n  --ac:#5cb397;--ac-soft:#1e332c;--danger:#d07a63;\n}}\n*{box-sizing:border-box;margin:0}\nhtml,body{height:100%}\nbody{font-family:-apple-system,system-ui,sans-serif;background:var(--paper);color:var(--ink);\n  padding-bottom:calc(84px + env(safe-area-inset-bottom));-webkit-tap-highlight-color:transparent}\n.serif{font-family:ui-serif,\"New York\",Georgia,serif}\n/* header */\n.hero{position:relative;height:148px;overflow:hidden}\n.hero img{width:100%;height:100%;object-fit:cover;display:block}\n.hero::after{content:\"\";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.05),var(--paper) 96%)}\n.hero .tt{position:absolute;left:20px;bottom:10px;z-index:2}\n.hero h1{font-size:30px;font-weight:700;letter-spacing:-.02em;color:var(--ink);text-shadow:0 1px 6px var(--paper)}\n.hero .sub{font-size:13px;color:var(--mut)}\n.wrap{padding:0 18px;max-width:660px;margin:0 auto}\nh2{font-size:13px;letter-spacing:.09em;text-transform:uppercase;color:var(--mut);margin:26px 2px 10px;font-weight:600}\n/* cards */\n.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:16px 18px;margin-bottom:12px}\n.qcard{border-left:3px solid var(--ac)}\n.qcard .q{font-size:17px;line-height:1.45;font-style:italic}\n.qrow{display:flex;gap:8px;margin-top:12px}\ntextarea{width:100%;min-height:130px;border:0;background:none;color:var(--ink);font:16px/1.55 ui-serif,\"New York\",Georgia,serif;resize:none;outline:none}\ntextarea::placeholder{color:var(--mut);opacity:.7}\n/* mood */\n.moods{display:flex;justify-content:space-between;gap:6px;margin:4px 0 2px}\n.mood{flex:1;display:flex;flex-direction:column;align-items:center;gap:5px;padding:9px 0 7px;border:1.5px solid var(--line);border-radius:14px;background:none;color:var(--mut);font-size:10.5px;font-weight:600;letter-spacing:.02em}\n.mood svg{width:26px;height:26px}\n.mood.on{border-color:currentColor}\n.mood.on.m0{color:var(--m0)}.mood.on.m1{color:var(--m1)}.mood.on.m2{color:var(--m2)}.mood.on.m3{color:var(--m3)}.mood.on.m4{color:var(--m4)}\n/* buttons */\n.btn{border:0;border-radius:13px;padding:13px 18px;font-size:15px;font-weight:650;background:var(--ac);color:#fff;width:100%}\n.btn:disabled{opacity:.4}\n.btn.ghost{background:var(--ac-soft);color:var(--ac);width:auto;padding:9px 14px;font-size:13.5px}\n.btn.tiny{width:auto;padding:8px 13px;font-size:13px;background:none;border:1.5px solid var(--line);color:var(--mut)}\n.rowflex{display:flex;gap:8px;align-items:center}\n/* meta chips */\n.chips{display:flex;gap:8px;margin:14px 0 6px;flex-wrap:wrap}\n.chip{background:var(--card);border:1px solid var(--line);border-radius:999px;padding:7px 13px;font-size:13px;color:var(--mut)}\n.chip b{color:var(--ink)}\n/* journal list */\ninput[type=search]{width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:13px;background:var(--card);color:var(--ink);font-size:15px;outline:none;margin-bottom:12px}\n.erow{display:flex;gap:12px;align-items:flex-start;padding:13px 2px;border-bottom:1px solid var(--line)}\n.erow:last-child{border-bottom:0}\n.edot{width:10px;height:10px;border-radius:50%;margin-top:6px;flex:0 0 auto;background:var(--line)}\n.edot.m0{background:var(--m0)}.edot.m1{background:var(--m1)}.edot.m2{background:var(--m2)}.edot.m3{background:var(--m3)}.edot.m4{background:var(--m4)}\n.erow .ed{font-size:12.5px;color:var(--mut);margin-bottom:2px}\n.erow .ex{font-size:15px;line-height:1.45;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}\n/* insights */\n.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}\n.stat{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px 6px;text-align:center}\n.stat b{display:block;font-size:24px;font-variant-numeric:tabular-nums}\n.stat span{font-size:11.5px;color:var(--mut);letter-spacing:.03em;text-transform:uppercase;font-weight:600}\ncanvas#moodcv{width:100%;height:130px;display:block}\n.refl{white-space:pre-wrap;font-size:15.5px;line-height:1.6}\n.refl-date{font-size:12px;color:var(--mut);margin-bottom:6px}\n.hintline{font-size:13px;color:var(--mut);margin-top:8px;line-height:1.45}\n/* modal */\n.scrim{position:fixed;inset:0;background:rgba(10,12,8,.45);display:none;align-items:flex-end;z-index:50}\n.scrim.on{display:flex}\n.sheet{background:var(--paper);border-radius:22px 22px 0 0;width:100%;max-height:82dvh;overflow-y:auto;padding:20px 20px calc(22px + env(safe-area-inset-bottom))}\n.sheet .sd{font-size:13px;color:var(--mut);margin-bottom:10px}\n.sheet .st{font-size:17px;line-height:1.6;white-space:pre-wrap;font-family:ui-serif,Georgia,serif}\n.sheet textarea{min-height:180px;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:12px}\n.sheetrow{display:flex;gap:9px;margin-top:16px}\n.sheetrow .btn{flex:1}\n.btn.warn{background:none;border:1.5px solid var(--danger);color:var(--danger)}\n/* tab bar */\n.tabbar{position:fixed;left:0;right:0;bottom:0;display:flex;background:color-mix(in srgb,var(--paper) 88%,transparent);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom);z-index:40}\n.tabbar button{flex:1;border:0;background:none;color:var(--mut);padding:10px 0 9px;font-size:11px;font-weight:600;display:flex;flex-direction:column;align-items:center;gap:3px}\n.tabbar button svg{width:22px;height:22px}\n.tabbar button.on{color:var(--ac)}\n.section{display:none}.section.on{display:block}\n.fadein{animation:fi .45s ease}\n@keyframes fi{from{opacity:0;transform:translateY(8px)}to{opacity:1}}\n@media(prefers-reduced-motion:reduce){.fadein{animation:none}}\n.empty{color:var(--mut);text-align:center;padding:34px 10px;font-size:14.5px;line-height:1.5}\n</style></head><body>\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(76px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-family:-apple-system,system-ui,sans-serif;font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;line-height:1;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\">⚙️</span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n\n<div class=\"hero\"><img src=\"data:image/jpeg;base64,\" alt=\"\"><div class=\"tt\"><h1 class=\"serif\">Reflect</h1><div class=\"sub\">Your private journal — nothing ever leaves this device</div></div></div>\n\n<div class=\"wrap\">\n\n  <!-- TODAY -->\n  <div class=\"section on\" id=\"s-today\">\n    <div class=\"chips\"><span class=\"chip\" id=\"chipDate\"></span><span class=\"chip\" id=\"chipStreak\"></span></div>\n\n    <div class=\"card qcard\">\n      <div class=\"q serif\" id=\"promptText\"></div>\n      <div class=\"qrow\">\n        <button class=\"btn tiny\" onclick=\"nextPrompt()\">Another</button>\n        <button class=\"btn tiny\" id=\"aiPromptBtn\" onclick=\"aiPrompt()\">One just for me</button>\n      </div>\n    </div>\n\n    <div class=\"card\">\n      <textarea id=\"entryText\" placeholder=\"Write freely — a line is enough…\" oninput=\"autosize(this);draftSave()\"></textarea>\n    </div>\n\n    <h2>How was today?</h2>\n    <div class=\"moods\" id=\"moods\"></div>\n    <div style=\"height:14px\"></div>\n    <button class=\"btn\" id=\"saveBtn\" onclick=\"saveEntry()\">Keep this entry</button>\n    <p class=\"hintline\" id=\"todayHint\"></p>\n  </div>\n\n  <!-- JOURNAL -->\n  <div class=\"section\" id=\"s-journal\">\n    <div style=\"height:16px\"></div>\n    <input type=\"search\" id=\"q\" placeholder=\"Search your journal…\" oninput=\"renderJournal()\">\n    <div id=\"journalList\"></div>\n  </div>\n\n  <!-- INSIGHTS -->\n  <div class=\"section\" id=\"s-insights\">\n    <h2>Your practice</h2>\n    <div class=\"stats\">\n      <div class=\"stat\"><b id=\"stStreak\">0</b><span>day streak</span></div>\n      <div class=\"stat\"><b id=\"stCount\">0</b><span>entries</span></div>\n      <div class=\"stat\"><b id=\"stWords\">0</b><span>words</span></div>\n    </div>\n\n    <h2>Mood — last 30 days</h2>\n    <div class=\"card\"><canvas id=\"moodcv\"></canvas></div>\n\n    <h2>Weekly reflection</h2>\n    <div class=\"card\">\n      <p style=\"font-size:14.5px;color:var(--mut);line-height:1.5\">Your AI reads the last seven days and reflects back what it notices — privately, on your device.</p>\n      <div style=\"height:12px\"></div>\n      <button class=\"btn\" id=\"reflBtn\" onclick=\"weeklyReflection()\">Reflect on my week</button>\n      <p class=\"hintline\" id=\"reflHint\"></p>\n    </div>\n    <div id=\"reflList\"></div>\n\n    <h2 id=\"otdHead\" style=\"display:none\">On this day</h2>\n    <div id=\"otdList\"></div>\n  </div>\n</div>\n\n<div class=\"scrim\" id=\"scrim\" onclick=\"if(event.target===this)closeSheet()\">\n  <div class=\"sheet\" id=\"sheet\"></div>\n</div>\n\n<div class=\"tabbar\">\n  <button class=\"on\" data-s=\"today\" onclick=\"tab('today')\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 20l1-4L15.5 5.5a2.1 2.1 0 0 1 3 3L8 19l-4 1z\"/><path d=\"M13.5 7.5l3 3\"/></svg>Today</button>\n  <button data-s=\"journal\" onclick=\"tab('journal')\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15.5H6.5A2.5 2.5 0 0 0 4 21z\"/><path d=\"M4 21a2.5 2.5 0 0 1 2.5-2.5H20\"/></svg>Journal</button>\n  <button data-s=\"insights\" onclick=\"tab('insights')\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 19V10M10 19V4M16 19v-8M21 19H3\"/></svg>Insights</button>\n</div>\n\n<script>\n\"use strict\";\n/* ---------- storage (myllmStorage w/ localStorage fallback) ---------- */\nvar store = window.myllmStorage || {\n  getItem: function(k){ try{ return Promise.resolve(localStorage.getItem(k)); }catch(e){ return Promise.resolve(null); } },\n  setItem: function(k,v){ try{ localStorage.setItem(k,v); }catch(e){} return Promise.resolve(); }\n};\nvar DATA = { v:1, entries:[], refl:[] };\nfunction persist(){ store.setItem('reflect.data', JSON.stringify(DATA)); }\nfunction el(i){ return document.getElementById(i); }\nfunction haptic(k){ if(window.myllmHaptic) try{ myllmHaptic(k||'light'); }catch(e){} }\nfunction today(){ var d=new Date(); return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }\nfunction fmtDate(iso){ var d=new Date(iso+'T12:00:00');\n  return d.toLocaleDateString(undefined,{weekday:'short',day:'numeric',month:'short',year: d.getFullYear()!==new Date().getFullYear()?'numeric':undefined}); }\n\n/* ---------- prompts ---------- */\nvar PROMPTS = [\n \"What made today feel different from yesterday?\",\n \"What's one small thing you're grateful for right now?\",\n \"What took more energy today than it should have?\",\n \"If today had a colour, what would it be — and why?\",\n \"What did you do today that your younger self would find impressive?\",\n \"What conversation stayed with you today?\",\n \"What are you quietly looking forward to?\",\n \"What would you do tomorrow if you knew it would go well?\",\n \"What's something you've been avoiding? What's the smallest first step?\",\n \"Who made your day better today — did they know?\",\n \"What's a moment from today you'd like to remember in a year?\",\n \"What worried you today that probably won't matter in a month?\",\n \"Where did you feel most like yourself today?\",\n \"What did you learn today — about anything, or anyone?\",\n \"What would you tell a friend who'd had your day?\",\n \"What's one thing you did today purely for yourself?\",\n \"What sound, smell or taste stood out today?\",\n \"If you could replay one hour of today, which one?\",\n \"What's something kind you could do tomorrow that takes two minutes?\",\n \"What's slowly getting better, even if it doesn't feel like it?\",\n \"What do you want less of in your days? More of?\",\n \"What made you smile when you weren't expecting to?\",\n \"What's a question you're carrying at the moment?\",\n \"How does your body feel right now — really?\"\n];\nvar pIdx = (new Date().getFullYear()*372 + new Date().getMonth()*31 + new Date().getDate()) % PROMPTS.length;\nfunction showPrompt(t){ el('promptText').textContent = t; }\nfunction nextPrompt(){ pIdx=(pIdx+1)%PROMPTS.length; showPrompt(PROMPTS[pIdx]); haptic('selection'); }\n\n/* ---------- mood picker ---------- */\nvar MOODS = [[\"Rough\",\"M8 15.5c1-.9 2.4-1.5 4-1.5s3 .6 4 1.5\"],[\"Low\",\"M8.5 15h7\"],[\"Okay\",\"M8.5 15c.9.4 2.1.6 3.5.6s2.6-.2 3.5-.6\"],[\"Good\",\"M8 14c1 .9 2.4 1.5 4 1.5s3-.6 4-1.5\"],[\"Great\",\"M7.5 13.5c1.1 1.4 2.7 2.2 4.5 2.2s3.4-.8 4.5-2.2\"]];\nvar mood = null;\nfunction moodSVG(path){ return '<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><circle cx=\"9\" cy=\"9.6\" r=\".6\" fill=\"currentColor\" stroke=\"none\"/><circle cx=\"15\" cy=\"9.6\" r=\".6\" fill=\"currentColor\" stroke=\"none\"/><path d=\"'+path+'\"/></svg>'; }\nfunction buildMoods(){\n  var box = el('moods'); box.innerHTML='';\n  MOODS.forEach(function(m,i){\n    var b=document.createElement('button'); b.className='mood m'+i; b.innerHTML=moodSVG(m[1])+'<span>'+m[0]+'</span>';\n    b.onclick=function(){ mood = (mood===i? null : i); buildMoods(); haptic('selection'); };\n    if(mood===i) b.classList.add('on');\n    box.appendChild(b);\n  });\n}\n\n/* ---------- today ---------- */\nvar draftTimer=null;\nfunction draftSave(){ clearTimeout(draftTimer); draftTimer=setTimeout(function(){ store.setItem('reflect.draft', el('entryText').value); },400); }\nfunction autosize(t){ t.style.height='auto'; t.style.height=Math.max(130,t.scrollHeight)+'px'; }\nfunction saveEntry(){\n  var t = el('entryText').value.trim();\n  if(!t && mood===null){ el('todayHint').textContent='Write a line or pick a mood first.'; return; }\n  DATA.entries.push({ id: Date.now(), ts: Date.now(), d: today(), m: mood, t: t });\n  persist(); store.setItem('reflect.draft','');\n  el('entryText').value=''; autosize(el('entryText')); mood=null; buildMoods();\n  el('todayHint').textContent='Kept. It stays on this device — always.';\n  haptic('success'); refreshMeta(); renderJournal(); renderInsights();\n}\nfunction refreshMeta(){\n  el('chipDate').innerHTML = '<b>'+new Date().toLocaleDateString(undefined,{weekday:'long',day:'numeric',month:'long'})+'</b>';\n  var s = streak();\n  el('chipStreak').innerHTML = s>0 ? '<b>'+s+'</b>&nbsp;day streak' : 'start your streak today';\n}\nfunction streak(){\n  var days = {}; DATA.entries.forEach(function(e){ days[e.d]=1; });\n  var n=0, d=new Date();\n  if(!days[today()]) d.setDate(d.getDate()-1); // yesterday keeps a live streak\n  for(;;){ var k=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');\n    if(days[k]){ n++; d.setDate(d.getDate()-1); } else break; }\n  return n;\n}\n\n/* ---------- journal ---------- */\nfunction renderJournal(){\n  var q=(el('q').value||'').toLowerCase().trim(), L=el('journalList'); L.innerHTML='';\n  var list = DATA.entries.slice().sort(function(a,b){ return b.ts-a.ts; })\n    .filter(function(e){ return !q || (e.t||'').toLowerCase().indexOf(q)>=0 || e.d.indexOf(q)>=0; });\n  if(!list.length){ L.innerHTML='<div class=\"empty\">'+(q?'Nothing matches that.':'Your journal is empty — today is a good day to start.')+'</div>'; return; }\n  var month='';\n  list.forEach(function(e){\n    var m = new Date(e.d+'T12:00:00').toLocaleDateString(undefined,{month:'long',year:'numeric'});\n    if(m!==month){ month=m; var h=document.createElement('h2'); h.textContent=m; L.appendChild(h); }\n    var r=document.createElement('div'); r.className='erow';\n    r.innerHTML='<span class=\"edot'+(e.m!=null?' m'+e.m:'')+'\"></span><div style=\"min-width:0\"><div class=\"ed\">'+fmtDate(e.d)+'</div><div class=\"ex serif\"></div></div>';\n    r.querySelector('.ex').textContent = e.t || '(mood only)';\n    r.onclick=function(){ openEntry(e.id); };\n    L.appendChild(r);\n  });\n}\nfunction openEntry(id){\n  var e = DATA.entries.find(function(x){ return x.id===id; }); if(!e) return;\n  var s=el('sheet');\n  s.innerHTML='<div class=\"sd\">'+fmtDate(e.d)+(e.m!=null?' · feeling '+MOODS[e.m][0].toLowerCase():'')+'</div>'+\n    '<div class=\"st\" id=\"sheetBody\"></div><div class=\"sheetrow\">'+\n    '<button class=\"btn ghost\" onclick=\"editEntry('+id+')\">Edit</button>'+\n    '<button class=\"btn warn\" onclick=\"askDelete('+id+')\">Delete</button></div>';\n  s.querySelector('#sheetBody').textContent = e.t || '(mood only)';\n  el('scrim').classList.add('on');\n}\nfunction editEntry(id){\n  var e = DATA.entries.find(function(x){ return x.id===id; }); if(!e) return;\n  var s=el('sheet');\n  s.innerHTML='<div class=\"sd\">Editing · '+fmtDate(e.d)+'</div>'+\n    '<textarea id=\"editText\"></textarea><div class=\"sheetrow\">'+\n    '<button class=\"btn\" onclick=\"saveEdit('+id+')\">Save</button>'+\n    '<button class=\"btn ghost\" onclick=\"closeSheet()\">Cancel</button></div>';\n  s.querySelector('#editText').value = e.t||'';\n}\nfunction saveEdit(id){\n  var e = DATA.entries.find(function(x){ return x.id===id; }); if(!e) return;\n  e.t = el('sheet').querySelector('#editText').value.trim();\n  persist(); haptic('success'); closeSheet(); renderJournal(); renderInsights();\n}\nfunction askDelete(id){\n  var s=el('sheet');\n  s.innerHTML='<div class=\"sd\">Delete this entry?</div><div class=\"st\">It can’t be brought back.</div>'+\n    '<div class=\"sheetrow\"><button class=\"btn warn\" onclick=\"doDelete('+id+')\">Delete</button>'+\n    '<button class=\"btn ghost\" onclick=\"closeSheet()\">Keep it</button></div>';\n}\nfunction doDelete(id){\n  DATA.entries = DATA.entries.filter(function(x){ return x.id!==id; });\n  persist(); haptic('success'); closeSheet(); renderJournal(); renderInsights(); refreshMeta();\n}\nfunction closeSheet(){ el('scrim').classList.remove('on'); }\n\n/* ---------- insights ---------- */\nfunction renderInsights(){\n  el('stStreak').textContent = streak();\n  el('stCount').textContent = DATA.entries.length;\n  el('stWords').textContent = DATA.entries.reduce(function(n,e){ return n + (e.t? e.t.split(/\\s+/).filter(Boolean).length : 0); },0);\n  drawMood(); renderRefl(); renderOTD();\n}\nfunction drawMood(){\n  var cv=el('moodcv'), dpr=window.devicePixelRatio||1;\n  var W=cv.clientWidth||300, H=130;\n  cv.width=W*dpr; cv.height=H*dpr;\n  var ctx=cv.getContext('2d'); ctx.scale(dpr,dpr);\n  var css=getComputedStyle(document.documentElement);\n  var line=css.getPropertyValue('--line').trim(), ac=css.getPropertyValue('--ac').trim(), mut=css.getPropertyValue('--mut').trim();\n  var days=[], byDay={};\n  DATA.entries.forEach(function(e){ if(e.m!=null){ (byDay[e.d]=byDay[e.d]||[]).push(e.m); } });\n  for(var i=29;i>=0;i--){ var d=new Date(); d.setDate(d.getDate()-i);\n    var k=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');\n    days.push(byDay[k] ? byDay[k].reduce(function(a,b){return a+b;},0)/byDay[k].length : null); }\n  ctx.strokeStyle=line; ctx.lineWidth=1;\n  for(var g=0; g<5; g++){ var gy=10+(H-30)*(1-g/4); ctx.beginPath(); ctx.moveTo(0,gy); ctx.lineTo(W,gy); ctx.stroke(); }\n  var pts=[], step=W/29;\n  days.forEach(function(v,i){ if(v!=null) pts.push([i*step, 10+(H-30)*(1-v/4)]); });\n  if(pts.length>1){ ctx.strokeStyle=ac; ctx.lineWidth=2; ctx.lineJoin='round'; ctx.beginPath();\n    pts.forEach(function(p,i){ i? ctx.lineTo(p[0],p[1]) : ctx.moveTo(p[0],p[1]); }); ctx.stroke(); }\n  ctx.fillStyle=ac; pts.forEach(function(p){ ctx.beginPath(); ctx.arc(p[0],p[1],3,0,7); ctx.fill(); });\n  if(!pts.length){ ctx.fillStyle=mut; ctx.font='13px -apple-system'; ctx.textAlign='center';\n    ctx.fillText('Log a mood with an entry and your month appears here.', W/2, H/2); }\n}\nfunction needAI(hintEl){\n  if(window.myllmAsk) return false;\n  hintEl.textContent='This needs the latest MyLLM with “Allow apps to use the AI” enabled in Settings.';\n  return true;\n}\nfunction weeklyReflection(){\n  var hint=el('reflHint'); hint.textContent='';\n  if(needAI(hint)) return;\n  var weekAgo=Date.now()-7*864e5;\n  var recent=DATA.entries.filter(function(e){ return e.ts>=weekAgo && (e.t||e.m!=null); });\n  if(!recent.length){ hint.textContent='Write at least one entry this week first.'; return; }\n  var body=recent.map(function(e){ return e.d+(e.m!=null?' (feeling '+MOODS[e.m][0].toLowerCase()+')':'')+': '+(e.t||'(mood only)'); }).join('\\n').slice(0,1600);\n  el('reflBtn').disabled=true;\n  myllmAsk('You are a warm, perceptive journaling companion. Below are my private journal entries from the past week. Write a short reflection back to me (under 130 words, second person, plain prose, no lists or headers): notice one pattern, name one thing worth celebrating, and offer one gentle suggestion.\\n\\n'+body)\n  .then(function(r){\n    r=(r||'').trim(); if(!r) throw new Error('empty reply');\n    DATA.refl.unshift({ id:Date.now(), ts:Date.now(), text:r });\n    DATA.refl=DATA.refl.slice(0,20); persist(); renderRefl(); haptic('success');\n  }).catch(function(e){ hint.textContent='Couldn’t reflect just now: '+e.message; })\n  .then(function(){ el('reflBtn').disabled=false; });\n}\nfunction renderRefl(){\n  var L=el('reflList'); L.innerHTML='';\n  DATA.refl.forEach(function(r){\n    var c=document.createElement('div'); c.className='card fadein';\n    c.innerHTML='<div class=\"refl-date\">'+new Date(r.ts).toLocaleDateString(undefined,{day:'numeric',month:'long'})+'</div><div class=\"refl serif\"></div>';\n    c.querySelector('.refl').textContent=r.text;\n    L.appendChild(c);\n  });\n}\nfunction renderOTD(){\n  var mmdd=today().slice(5), L=el('otdList'); L.innerHTML='';\n  var hits=DATA.entries.filter(function(e){ return e.d!==today() && e.d.slice(5)===mmdd; });\n  el('otdHead').style.display = hits.length? 'block':'none';\n  hits.slice(0,3).forEach(function(e){\n    var c=document.createElement('div'); c.className='card';\n    c.innerHTML='<div class=\"refl-date\">'+fmtDate(e.d)+'</div><div class=\"refl serif\"></div>';\n    c.querySelector('.refl').textContent=e.t||'(mood only)';\n    L.appendChild(c);\n  });\n}\n\n/* ---------- AI prompt ---------- */\nfunction aiPrompt(){\n  var hint=el('todayHint'); hint.textContent='';\n  if(needAI(hint)) return;\n  var recent=DATA.entries.slice(-6).map(function(e){ return (e.t||'').slice(0,140); }).filter(Boolean).join(' | ').slice(0,900);\n  el('aiPromptBtn').disabled=true;\n  myllmAsk('Suggest ONE thoughtful, specific journaling prompt for me tonight — a single question, one sentence, no preamble, no quotes.'+(recent? ' For context, snippets from my recent entries: '+recent : ''))\n  .then(function(r){ r=(r||'').trim().replace(/^[\"“]|[\"”]$/g,''); if(r) showPrompt(r); haptic('success'); })\n  .catch(function(e){ hint.textContent='No prompt right now: '+e.message; })\n  .then(function(){ el('aiPromptBtn').disabled=false; });\n}\n\n/* ---------- tabs & init ---------- */\nfunction tab(s){\n  document.querySelectorAll('.section').forEach(function(x){ x.classList.remove('on'); });\n  el('s-'+s).classList.add('on');\n  document.querySelectorAll('.tabbar button').forEach(function(b){ b.classList.toggle('on', b.dataset.s===s); });\n  haptic('selection'); window.scrollTo(0,0);\n  if(s==='insights') renderInsights();\n}\nbuildMoods(); showPrompt(PROMPTS[pIdx]); refreshMeta();\nstore.getItem('reflect.data').then(function(v){\n  if(v){ try{ var d=JSON.parse(v); if(d && d.entries) DATA=d; }catch(e){} }\n  renderJournal(); renderInsights();\n});\nstore.getItem('reflect.draft').then(function(v){ if(v && !el('entryText').value){ el('entryText').value=v; autosize(el('entryText')); } });\nwindow.addEventListener('resize', function(){ if(el('s-insights').classList.contains('on')) drawMood(); });\n</script>\n</body></html>\n"}