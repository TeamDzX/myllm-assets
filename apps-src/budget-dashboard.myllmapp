{"name": "Budget Dashboard", "kind": "html", "iconSymbol": "chart.pie.fill", "iconColor": "green", "html": "<!doctype html>\n<!--\n  Budget Dashboard — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Budget Dashboard</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"b8606b99a2\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); --h:152; --ok:#2fbf71; --warn:#f0a020; --over:#ef4b4b; }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:760px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; border:none; background:none; } button:active{ transform:scale(.96); }\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 44%), hsl(calc(var(--h) + 40) 58% 26%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:20px 2px 10px; display:flex; align-items:center; gap:8px; }\n  h2 .sp{ flex:1; }\n  h2 button{ font-size:12px; letter-spacing:0; text-transform:none; color:var(--acc); font-weight:700; }\n\n  .month{ display:flex; align-items:center; justify-content:space-between; margin:0 2px 10px; }\n  .month b{ font-size:17px; font-weight:750; }\n  .month button{ width:40px; height:40px; border-radius:12px; background:var(--surface); border:1px solid var(--line); display:grid; place-items:center; }\n  .month button[disabled]{ opacity:.35; }\n\n  .hero{ border-radius:20px; padding:16px 18px; color:#fff; margin-bottom:12px;\n    background:linear-gradient(145deg, hsl(var(--h) 60% 40%), hsl(calc(var(--h) + 30) 58% 24%)); box-shadow:0 10px 28px hsl(var(--h) 60% 20% / .25); }\n  .hero.warn{ --h:36; } .hero.over{ --h:2; }\n  .hero .k{ font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.8; }\n  .hero .n{ font-size:40px; font-weight:800; line-height:1.05; letter-spacing:-.03em; font-variant-numeric:tabular-nums; margin-top:2px; }\n  .hero .n small{ font-size:18px; opacity:.75; font-weight:700; }\n  .hero .bar{ height:8px; border-radius:99px; background:rgba(255,255,255,.22); margin-top:10px; overflow:hidden; position:relative; }\n  .hero .bar i{ display:block; height:100%; border-radius:99px; background:#fff; transition:width .35s cubic-bezier(.2,.8,.2,1); }\n  .hero .bar u{ position:absolute; top:-3px; bottom:-3px; width:2px; background:rgba(255,255,255,.75); border-radius:2px; }\n  .hero .meta{ display:flex; gap:14px; flex-wrap:wrap; margin-top:10px; font-size:12.5px; opacity:.92; font-variant-numeric:tabular-nums; }\n  .hero .meta b{ font-weight:750; }\n  .hero .setb{ margin-top:12px; font-size:13px; font-weight:700; background:rgba(255,255,255,.18); border:1px solid rgba(255,255,255,.25); border-radius:10px; padding:7px 11px; color:#fff; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  .chart{ display:flex; align-items:flex-end; gap:8px; height:120px; padding-top:6px; }\n  .chart .col{ flex:1; display:flex; flex-direction:column; align-items:center; gap:5px; min-width:0; }\n  .chart .col i{ display:block; width:100%; max-width:38px; border-radius:7px 7px 3px 3px; background:var(--fill); min-height:3px; }\n  .chart .col.cur i{ background:hsl(var(--h) 60% 45%); }\n  .chart .col span{ font-size:11px; color:var(--muted); font-weight:650; }\n  .chart .col em{ font-style:normal; font-size:10.5px; color:var(--muted); font-variant-numeric:tabular-nums; white-space:nowrap; }\n\n  .rows{ display:grid; gap:2px; }\n  .row{ display:flex; align-items:center; gap:10px; padding:9px 2px; border-bottom:1px solid var(--line); }\n  .row:last-child{ border-bottom:none; }\n  .row .sw{ width:12px; height:12px; border-radius:4px; flex-shrink:0; }\n  .row .nm{ flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-weight:600; }\n  .row .nm small{ display:block; font-weight:500; font-size:12px; color:var(--muted); }\n  .row .amt{ font-variant-numeric:tabular-nums; font-weight:700; }\n  .row .pc{ width:44px; text-align:right; color:var(--muted); font-size:12.5px; font-variant-numeric:tabular-nums; }\n  .row button.tag{ font-size:12px; font-weight:700; color:var(--acc); padding:6px 8px; border-radius:8px; background:var(--fill); }\n  .stack{ display:flex; height:12px; border-radius:99px; overflow:hidden; background:var(--fill); margin:4px 0 10px; }\n  .stack i{ display:block; height:100%; }\n\n  .notice{ background:var(--surface); border:1px solid var(--line); border-radius:14px; padding:12px 14px; font-size:13.5px; color:var(--muted); margin-bottom:12px; line-height:1.5; }\n  .notice b{ color:var(--ink); }\n  .empty{ text-align:center; padding:28px 18px 18px; }\n  .empty .tile{ width:52px; height:52px; border-radius:15px; font-size:22px; margin:0 auto 12px; }\n  .empty b{ display:block; font-size:16px; font-weight:750; }\n  .empty p{ font-size:13.5px; color:var(--muted); line-height:1.5; max-width:300px; margin:6px auto 0; }\n  .say{ font-size:14.5px; line-height:1.55; white-space:pre-wrap; }\n  .ghost{ display:inline-flex; align-items:center; gap:6px; font-weight:700; color:var(--acc); padding:8px 2px; }\n\n  .sheet{ position:fixed; inset:0; background:rgba(0,0,0,.38); display:flex; align-items:flex-end; justify-content:center; z-index:20; }\n  .sheet .panel{ width:100%; max-width:600px; background:var(--surface); border-radius:20px 20px 0 0; padding:18px 16px calc(18px + env(safe-area-inset-bottom)); }\n  .sheet h3{ font-size:17px; font-weight:750; margin-bottom:4px; }\n  .sheet p{ font-size:13px; color:var(--muted); margin-bottom:12px; }\n  .chips{ display:flex; flex-wrap:wrap; gap:8px; margin-bottom:12px; }\n  .chips button{ padding:9px 12px; border-radius:99px; background:var(--fill); font-weight:650; font-size:14px; }\n  .chips button.on{ background:var(--acc); color:#fff; }\n  input{ width:100%; font:inherit; font-size:16px; padding:12px; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; }\n  input:focus{ border-color:var(--acc); }\n  .sheet .acts{ display:flex; gap:8px; margin-top:12px; }\n  .sheet .acts button{ flex:1; min-height:46px; border-radius:12px; font-weight:700; background:var(--fill); }\n  .sheet .acts button.pri{ background:var(--acc); color:#fff; }\n  [hidden]{ display:none !important; }\n  @media (prefers-reduced-motion:reduce){ .hero .bar i{ transition:none; } button:active{ transform:none; } }\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-pie\" viewBox=\"0 0 24 24\"><path d=\"M11 3.1A9 9 0 1 0 20.9 13H11z\" fill=\"currentColor\"/><path d=\"M13 2v9h9A9 9 0 0 0 13 2z\" fill=\"currentColor\" opacity=\".55\"/></symbol>\n  <symbol id=\"i-l\" viewBox=\"0 0 24 24\"><path d=\"M15 5l-7 7 7 7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-r\" viewBox=\"0 0 24 24\"><path d=\"M9 5l7 7-7 7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-spark\" viewBox=\"0 0 24 24\"><path d=\"M12 2l2.2 6.4L21 10l-6.8 1.7L12 18l-2.2-6.3L3 10l6.8-1.6z\" fill=\"currentColor\"/></symbol>\n</defs></svg>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-pie\"/></svg></div>\n  <div class=\"ht\"><h1>Budget Dashboard</h1><p>Where the month's money went</p></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Budget Dashboard\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n\n<div id=\"notice\" class=\"notice\" hidden></div>\n\n<div id=\"main\" hidden>\n  <div class=\"month\"><button id=\"prevM\" type=\"button\" aria-label=\"Previous month\"><svg class=\"i\"><use href=\"#i-l\"/></svg></button><b id=\"mLabel\">—</b><button id=\"nextM\" type=\"button\" aria-label=\"Next month\"><svg class=\"i\"><use href=\"#i-r\"/></svg></button></div>\n\n  <div class=\"hero\" id=\"hero\">\n    <div class=\"k\" id=\"hK\">Spent this month</div>\n    <div class=\"n\" id=\"hN\">£0</div>\n    <div class=\"bar\" id=\"hBar\" hidden><i id=\"hFill\" style=\"width:0\"></i><u id=\"hPace\"></u></div>\n    <div class=\"meta\" id=\"hMeta\"></div>\n    <button class=\"setb\" id=\"setBudget\" type=\"button\">Set a monthly budget</button>\n  </div>\n\n  <h2>Last six months</h2>\n  <div class=\"card\"><div class=\"chart\" id=\"chart\"></div></div>\n\n  <h2><span>By category</span><span class=\"sp\"></span><button id=\"catHelp\" type=\"button\">How?</button></h2>\n  <div class=\"card\"><div class=\"stack\" id=\"stack\"></div><div class=\"rows\" id=\"cats\"></div></div>\n\n  <h2>Top places</h2>\n  <div class=\"card\"><div class=\"rows\" id=\"places\"></div></div>\n\n  <div id=\"aiBox\" hidden>\n    <h2>This month, in a few words</h2>\n    <div class=\"card\"><div class=\"say\" id=\"aiText\"></div><button class=\"ghost\" id=\"aiBtn\" type=\"button\"><svg class=\"i\"><use href=\"#i-spark\"/></svg><span>Summarise with MyLLM</span></button></div>\n  </div>\n</div>\n\n<div class=\"card empty\" id=\"empty\" hidden>\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-pie\"/></svg></div>\n  <b id=\"emptyT\">No receipts yet</b>\n  <p id=\"emptyP\">Scan receipts with <b>Receipt Logger</b> and your spending shows up here, month by month and by category.</p>\n</div>\n\n<div class=\"sheet\" id=\"sheet\" hidden><div class=\"panel\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"shT\">\n  <h3 id=\"shT\">—</h3><p id=\"shP\"></p>\n  <div class=\"chips\" id=\"shChips\"></div>\n  <input id=\"shIn\" autocomplete=\"off\" enterkeyhint=\"done\">\n  <div class=\"acts\"><button id=\"shNo\" type=\"button\">Cancel</button><button id=\"shOk\" class=\"pri\" type=\"button\">Save</button></div>\n</div></div>\n\n<script>\n/* Budget Dashboard reads data/receipts.json — written by Receipt Logger in the\n   shared format of docs/SHARED_DATA.md (schema myllm.receipts, version 1).\n   Its own settings (budget, which category each place belongs to) live in its\n   private storage; it never writes the receipts file. */\nfunction el(i){ return document.getElementById(i); }\nfunction store(){ return window.myllmStorage || { getItem:function(){ return Promise.resolve(null); }, setItem:function(){ return Promise.resolve(); } }; }\nfunction haptic(k){ try{ window.myllmHaptic && myllmHaptic(k); }catch(e){} }\nfunction esc(s){ return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;'); }\n\nvar PATH = 'data/receipts.json';\nvar CATS = ['Groceries','Eating out','Transport','Home','Shopping','Health','Fun','Bills','Other'];\nvar CAT_H = { 'Groceries':145, 'Eating out':28, 'Transport':205, 'Home':265, 'Shopping':320, 'Health':0, 'Fun':48, 'Bills':230, 'Other':210, 'Uncategorised':0 };\nvar receipts = [], settings = { budget: null, cats: {} }, view = null, aiCache = {};\n\nfunction pad2(n){ return (n < 10 ? '0' : '') + n; }\nfunction monthKey(day){ return day ? day.slice(0, 7) : null; }\nfunction thisMonth(){ var d = new Date(); return d.getFullYear() + '-' + pad2(d.getMonth() + 1); }\nfunction shiftMonth(k, by){ var y = +k.slice(0, 4), m = +k.slice(5, 7) - 1 + by; y += Math.floor(m / 12); m = ((m % 12) + 12) % 12; return y + '-' + pad2(m + 1); }\nfunction monthName(k, short){ var d = new Date(+k.slice(0, 4), +k.slice(5, 7) - 1, 1); return d.toLocaleDateString(undefined, short ? { month: 'short' } : { month: 'long', year: 'numeric' }); }\nfunction merchantKey(m){ return String(m || '').trim().toLowerCase(); }\nfunction catOf(r){ return r.category || settings.cats[merchantKey(r.merchant)] || null; }\nfunction money(n, cur){ var v = Math.abs(n) >= 1000 ? n.toFixed(0) : n.toFixed(2); return (cur || '') + v; }\n\n/* The currency most receipts use is the \"main\" one; the budget is in it.\n   Others are shown separately rather than added up with the wrong unit. */\nfunction mainCurrency(){\n  var c = {}; receipts.forEach(function(r){ if (typeof r.total === 'number') c[r.currency || ''] = (c[r.currency || ''] || 0) + 1; });\n  var best = null; Object.keys(c).forEach(function(k){ if (best === null || c[k] > c[best]) best = k; });\n  return best || '';\n}\n\nfunction readReceipts(){\n  var F = window.myllmFiles;\n  if (!F || !F.read) return Promise.resolve({ off: true });\n  return Promise.resolve().then(function(){ return F.read(PATH); }).then(function(text){\n    if (text == null) return { missing: true };\n    var j; try { j = JSON.parse(text); } catch(e){ return { bad: 'Receipt Logger’s file couldn’t be read.' }; }\n    if (!j || j.schema !== 'myllm.receipts') return { bad: 'data/receipts.json isn’t a receipts file.' };\n    if (j.version !== 1) return { bad: 'Receipt Logger saved a newer format (v' + j.version + '). Update Budget Dashboard from the gallery.' };\n    return { items: Array.isArray(j.items) ? j.items : [] };\n  }).catch(function(e){\n    var m = String(e && e.message || e);\n    return /turned off|disabled|not allowed/i.test(m) ? { off: true } : { missing: true };\n  });\n}\n\nfunction load(){\n  return Promise.all([\n    readReceipts(),\n    store().getItem('budget.settings').then(function(v){ try { return v ? JSON.parse(v) : null; } catch(e){ return null; } })\n  ]).then(function(res){\n    if (res[1]) settings = { budget: res[1].budget || null, cats: res[1].cats || {} };\n    var r = res[0];\n    el('notice').hidden = true;\n    if (r.off){ return showEmpty('Shared files are off', 'Budget Dashboard reads what Receipt Logger saves to the shared workspace. Turn on “Shared files” for apps in MyLLMos settings.'); }\n    if (r.bad){ return showEmpty('Can’t read the receipts', r.bad); }\n    if (r.missing){ return showEmpty('No receipts yet', 'Scan receipts with <b>Receipt Logger</b> (update it from the gallery if you have it already) and your spending shows up here, month by month and by category.'); }\n    receipts = r.items.filter(function(x){ return x && typeof x === 'object'; });\n    if (!receipts.length) return showEmpty('No receipts yet', 'Scan receipts with <b>Receipt Logger</b> and your spending shows up here.');\n    var undated = receipts.filter(function(x){ return !x.date; }).length;\n    var unread = receipts.filter(function(x){ return typeof x.total !== 'number'; }).length;\n    if (undated || unread){\n      el('notice').innerHTML = (unread ? '<b>' + unread + '</b> receipt' + (unread > 1 ? 's' : '') + ' had no readable total' : '') +\n        (unread && undated ? ' and ' : '') + (undated ? '<b>' + undated + '</b> had no date' : '') + ' — not counted below.';\n      el('notice').hidden = false;\n    }\n    if (!view) view = thisMonth();\n    el('empty').hidden = true; el('main').hidden = false;\n    render();\n  });\n}\nfunction showEmpty(t, p){ el('main').hidden = true; el('empty').hidden = false; el('emptyT').textContent = t; el('emptyP').innerHTML = p; }\nfunction saveSettings(){ store().setItem('budget.settings', JSON.stringify(settings)); }\n\nfunction inMonth(k, cur){ return receipts.filter(function(r){ return monthKey(r.date) === k && typeof r.total === 'number' && (cur == null || (r.currency || '') === cur); }); }\nfunction sum(list){ return list.reduce(function(a, r){ return a + r.total; }, 0); }\n\nfunction render(){\n  var cur = mainCurrency(), now = thisMonth();\n  el('mLabel').textContent = monthName(view);\n  el('nextM').disabled = view >= now;\n  var mine = inMonth(view, cur), spent = sum(mine);\n  var others = receipts.filter(function(r){ return monthKey(r.date) === view && typeof r.total === 'number' && (r.currency || '') !== cur; });\n\n  /* Hero: spent, against the budget and against where you'd expect to be by today. */\n  var hero = el('hero'), b = settings.budget;\n  hero.classList.remove('warn', 'over');\n  el('hK').textContent = view === now ? 'Spent this month' : 'Spent in ' + monthName(view, true);\n  el('hN').innerHTML = esc(money(spent, cur)) + (b ? '<small> / ' + esc(money(b, cur)) + '</small>' : '');\n  var meta = [];\n  meta.push('<span><b>' + mine.length + '</b> receipt' + (mine.length === 1 ? '' : 's') + '</span>');\n  if (b){\n    var frac = spent / b; el('hBar').hidden = false;\n    el('hFill').style.width = Math.min(100, frac * 100) + '%';\n    var dim = new Date(+view.slice(0, 4), +view.slice(5, 7), 0).getDate(), today = new Date().getDate();\n    var paceFrac = view === now ? today / dim : 1;\n    el('hPace').style.left = 'calc(' + Math.min(100, paceFrac * 100) + '% - 1px)';\n    /* Amber when the month is heading over: well ahead of pace, or (from day 5)\n       on course to overshoot. Red once it has. */\n    var heading = view === now && new Date().getDate() >= 5 && spent / new Date().getDate() * dim > b;\n    if (frac > 1) hero.classList.add('over'); else if (heading || frac > Math.max(.8, paceFrac + .1)) hero.classList.add('warn');\n    if (view === now){\n      var left = b - spent, daysLeft = dim - today + 1;\n      meta.push(left >= 0 ? '<span><b>' + esc(money(left, cur)) + '</b> left · ' + esc(money(left / daysLeft, cur)) + '/day for ' + daysLeft + ' day' + (daysLeft === 1 ? '' : 's') + '</span>'\n                          : '<span><b>' + esc(money(-left, cur)) + '</b> over budget</span>');\n      if (today >= 5 && spent > 0){ var proj = spent / today * dim; meta.push('<span>on course for <b>' + esc(money(proj, cur)) + '</b></span>'); }\n    } else meta.push('<span>' + Math.round(frac * 100) + '% of budget</span>');\n  } else el('hBar').hidden = true;\n  if (others.length){\n    var byC = {}; others.forEach(function(r){ byC[r.currency || '?'] = (byC[r.currency || '?'] || 0) + r.total; });\n    meta.push('<span>+ ' + Object.keys(byC).map(function(c){ return esc(money(byC[c], c)); }).join(', ') + ' in other currencies</span>');\n  }\n  el('hMeta').innerHTML = meta.join('');\n  el('setBudget').textContent = b ? 'Change budget' : 'Set a monthly budget';\n\n  /* Six months, the viewed one highlighted. */\n  var months = []; for (var i = 5; i >= 0; i--) months.push(shiftMonth(view, -i));\n  var totals = months.map(function(k){ return sum(inMonth(k, cur)); }), max = Math.max.apply(null, totals.concat([b || 0, 1]));\n  el('chart').innerHTML = months.map(function(k, i){\n    return '<div class=\"col' + (k === view ? ' cur' : '') + '\"><em>' + (totals[i] ? esc(money(totals[i], cur).replace(/\\.\\d\\d$/, '')) : '') + '</em><i style=\"height:' + Math.max(3, totals[i] / max * 92) + 'px\"></i><span>' + esc(monthName(k, true)) + '</span></div>';\n  }).join('');\n\n  /* Categories: each place belongs to one; you set it once and it sticks. */\n  var byCat = {};\n  mine.forEach(function(r){ var c = catOf(r) || 'Uncategorised'; byCat[c] = (byCat[c] || 0) + r.total; });\n  var cats = Object.keys(byCat).sort(function(a, z){ return byCat[z] - byCat[a]; });\n  el('stack').innerHTML = cats.map(function(c){ return '<i style=\"width:' + (byCat[c] / (spent || 1) * 100) + '%;background:' + catColor(c) + '\"></i>'; }).join('');\n  el('cats').innerHTML = cats.length ? cats.map(function(c){\n    return '<div class=\"row\"><span class=\"sw\" style=\"background:' + catColor(c) + '\"></span><span class=\"nm\">' + esc(c) + '</span><span class=\"amt\">' + esc(money(byCat[c], cur)) + '</span><span class=\"pc\">' + Math.round(byCat[c] / (spent || 1) * 100) + '%</span></div>';\n  }).join('') : '<div class=\"row\"><span class=\"nm\" style=\"color:var(--muted);font-weight:500\">Nothing this month</span></div>';\n  el('stack').hidden = !cats.length;\n\n  /* Places: tap the tag to put a place in a category. */\n  var byPlace = {}, label = {};\n  mine.forEach(function(r){ var k = merchantKey(r.merchant); byPlace[k] = (byPlace[k] || 0) + r.total; label[k] = label[k] || r.merchant || 'Receipt'; });\n  var places = Object.keys(byPlace).sort(function(a, z){ return byPlace[z] - byPlace[a]; }).slice(0, 8);\n  el('places').innerHTML = places.length ? places.map(function(k){\n    var c = settings.cats[k];\n    var n = mine.filter(function(r){ return merchantKey(r.merchant) === k; }).length;\n    return '<div class=\"row\"><span class=\"nm\">' + esc(label[k]) + '<small>' + n + ' receipt' + (n === 1 ? '' : 's') + '</small></span><span class=\"amt\">' + esc(money(byPlace[k], cur)) + '</span><button class=\"tag\" type=\"button\" data-place=\"' + esc(k) + '\" data-label=\"' + esc(label[k]) + '\">' + esc(c || 'Category?') + '</button></div>';\n  }).join('') : '<div class=\"row\"><span class=\"nm\" style=\"color:var(--muted);font-weight:500\">Nothing this month</span></div>';\n\n  el('aiBox').hidden = !window.myllmAsk || !mine.length;\n  el('aiText').textContent = aiCache[view] || '';\n  el('aiText').hidden = !aiCache[view];\n}\n\nfunction catColor(c){ return c === 'Uncategorised' ? 'var(--fill)' : 'hsl(' + (CAT_H[c] != null ? CAT_H[c] : (c.length * 37) % 360) + ' 62% 52%)'; }\n\n/* ---- the small sheet: budget amount, or a place's category ---- */\nvar sheetDone = null;\nfunction openSheet(o){\n  el('shT').textContent = o.title; el('shP').textContent = o.text || '';\n  el('shChips').innerHTML = (o.chips || []).map(function(c){ return '<button type=\"button\" class=\"' + (c === o.selected ? 'on' : '') + '\">' + esc(c) + '</button>'; }).join('');\n  el('shChips').hidden = !o.chips;\n  el('shIn').value = o.value || ''; el('shIn').placeholder = o.placeholder || ''; el('shIn').setAttribute('inputmode', o.numeric ? 'decimal' : 'text');\n  el('sheet').hidden = false; sheetDone = o.done;\n  if (o.numeric) setTimeout(function(){ el('shIn').focus(); }, 60);\n}\nfunction closeSheet(){ el('sheet').hidden = true; sheetDone = null; }\nel('shChips').addEventListener('click', function(e){\n  var b = e.target.closest('button'); if (!b) return;\n  [].forEach.call(el('shChips').children, function(x){ x.classList.toggle('on', x === b); });\n  el('shIn').value = b.textContent;\n});\nel('shNo').onclick = closeSheet;\nel('sheet').addEventListener('click', function(e){ if (e.target === el('sheet')) closeSheet(); });\nel('shOk').onclick = function(){ var v = el('shIn').value.trim(); var f = sheetDone; closeSheet(); if (f) f(v); };\nel('shIn').addEventListener('keydown', function(e){ if (e.key === 'Enter') el('shOk').click(); });\n\nel('setBudget').onclick = function(){\n  var cur = mainCurrency();\n  openSheet({ title: 'Monthly budget', text: 'How much you mean to spend a month' + (cur ? ' (in ' + cur + ')' : '') + '. Leave it empty for none.',\n    value: settings.budget || '', placeholder: 'e.g. 600', numeric: true,\n    done: function(v){ var n = parseFloat(String(v).replace(/[^0-9.]/g, '')); settings.budget = n > 0 ? n : null; saveSettings(); haptic('success'); render(); } });\n};\nel('places').addEventListener('click', function(e){\n  var b = e.target.closest('button.tag'); if (!b) return;\n  var k = b.getAttribute('data-place');\n  openSheet({ title: b.getAttribute('data-label'), text: 'Which category? Every receipt from here goes in it, past and future.',\n    chips: CATS, selected: settings.cats[k], value: settings.cats[k] || '', placeholder: 'Or type your own',\n    done: function(v){ if (v) settings.cats[k] = v.slice(0, 24); else delete settings.cats[k]; saveSettings(); haptic('light'); render(); } });\n});\nel('catHelp').onclick = function(){\n  openSheet({ title: 'Categories', text: 'Tap the tag next to a place under “Top places” to choose its category. It applies to every receipt from that place, so you only do it once.', done: null });\n  el('shIn').hidden = true; el('shNo').textContent = 'OK'; el('shOk').hidden = true;\n  var restore = function(){ el('shIn').hidden = false; el('shNo').textContent = 'Cancel'; el('shOk').hidden = false; el('shNo').removeEventListener('click', restore); };\n  el('shNo').addEventListener('click', restore);\n};\nel('prevM').onclick = function(){ view = shiftMonth(view, -1); haptic('selection'); render(); };\nel('nextM').onclick = function(){ if (view < thisMonth()){ view = shiftMonth(view, 1); haptic('selection'); render(); } };\n\n/* A short read of the month from the user's own model — totals only, never the raw receipt text. */\nel('aiBtn').onclick = function(){\n  if (!window.myllmAsk) return;\n  var cur = mainCurrency(), mine = inMonth(view, cur), byCat = {};\n  mine.forEach(function(r){ var c = catOf(r) || 'Uncategorised'; byCat[c] = (byCat[c] || 0) + r.total; });\n  var prev = sum(inMonth(shiftMonth(view, -1), cur));\n  var facts = 'Month: ' + monthName(view) + '. Spent ' + money(sum(mine), cur) + ' across ' + mine.length + ' receipts' +\n    (settings.budget ? ' against a budget of ' + money(settings.budget, cur) : '') + '. Previous month: ' + money(prev, cur) + '. By category: ' +\n    Object.keys(byCat).map(function(c){ return c + ' ' + money(byCat[c], cur); }).join(', ') + '.';\n  el('aiBtn').disabled = true; el('aiBtn').querySelector('span').textContent = 'Thinking…';\n  Promise.resolve(window.myllmAsk('In 2-3 short, friendly sentences, say what stands out about this month\\'s spending and one practical tip. Use only these numbers:\\n' + facts,\n    { system: 'You are a calm, practical money helper. Plain prose, no lists, no markdown, no invented numbers.' }))\n    .then(function(a){ aiCache[view] = String(a || '').trim(); render(); })\n    .catch(function(){ aiCache[view] = 'MyLLM couldn’t answer just now.'; render(); })\n    .then(function(){ el('aiBtn').disabled = false; el('aiBtn').querySelector('span').textContent = 'Summarise with MyLLM'; });\n};\n\n/* Receipts change in another app: read again whenever this one comes back. */\ndocument.addEventListener('visibilitychange', function(){ if (!document.hidden) load(); });\nload();\n</script>\n<script>\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes.\n   The spacer keeps the header clear of the status bar / Dynamic Island. It is\n   live CSS — env(safe-area-inset-top) — not a measured number: the inset is\n   still 0 when the page loads and only grows once MyLLM's bar has gone (v1\n   measured once, so the title sat under the island). If the page's own styles\n   already pad the header down by the inset, the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  /* Does any rule that applies to the header or an ancestor already use the top inset? */\n  function pageHandlesInset(head){\n    var chain = [], n, found = false;\n    for (n = head; n && n.nodeType === 1; n = n.parentElement) chain.push(n);\n    function walk(rules){\n      for (var i = 0; i < rules.length && !found; i++){\n        var r = rules[i];\n        if (r.cssRules && !r.selectorText) { walk(r.cssRules); continue; }\n        if (!r.selectorText || !/safe-area-inset-top/.test(r.cssText) || !/(padding|margin|top)\\s*:/.test(r.cssText)) continue;\n        if (/\\.imm-safe/.test(r.selectorText)) continue;\n        for (var k = 0; k < chain.length; k++){\n          try { if (chain[k].matches(r.selectorText)) { found = true; break; } } catch(e){}\n        }\n      }\n    }\n    for (var s = 0; s < document.styleSheets.length && !found; s++){\n      try { walk(document.styleSheets[s].cssRules); } catch(e){}\n    }\n    for (n = head; n && n.nodeType === 1 && !found; n = n.parentElement){\n      if (/safe-area-inset-top/.test(n.getAttribute(\"style\") || \"\")) found = true;\n    }\n    return found;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = (document.body.classList.contains(\"imm\") && !pageHandlesInset(head)) ? \"env(safe-area-inset-top)\" : \"0px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n\n</script></body></html>\n"}