{"name": "Feelings Check-In", "html": "<!doctype html>\n<!--\n  Feelings Check-In — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\">\n<style>:root{--build-id:\"719a6558f9\";color-scheme:light dark;--bg:#f2f2f7;--fg:#111;--card:#fff}\n@media(prefers-color-scheme:dark){:root{--bg:#000;--fg:#eee;--card:#1c1c1e}}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none}\nhtml,body{margin:0;min-height:100%}\nbody{font-family:-apple-system,system-ui,sans-serif;background:var(--bg);color:var(--fg);margin:0 auto;max-width:560px;padding:calc(16px + env(safe-area-inset-top)) 16px calc(20px + env(safe-area-inset-bottom))}\nh1{font-size:21px;margin:0 0 2px;font-weight:700}\n.sub{font-size:13px;opacity:.6;margin-bottom:14px}\n.zones{display:grid;grid-template-columns:1fr 1fr;gap:12px}\n.zone{border-radius:18px;padding:18px 12px;color:#fff;text-align:center;border:0;box-shadow:0 3px 8px rgba(0,0,0,.12)}\n.zone:active{transform:scale(.97)}\n.zone .em{font-size:44px}\n.zone .nm{font-size:16px;font-weight:700;margin-top:4px}\n.zone .ds{font-size:11px;opacity:.9;margin-top:1px}\n.panel{display:none;margin-top:16px;background:var(--card);border-radius:18px;padding:18px;box-shadow:0 2px 8px rgba(0,0,0,.1)}\n.panel.show{display:block}\n.panel h2{margin:0 0 2px;font-size:20px}\n.panel .msg{font-size:14px;opacity:.75;margin-bottom:12px}\n.tool{display:flex;align-items:center;gap:12px;padding:12px;border-radius:14px;background:var(--bg);margin-bottom:8px;font-size:16px;font-weight:600}\n.tool .em{font-size:26px}\n.pbtns{display:flex;gap:10px;margin-top:12px}\n.pbtns button{flex:1;border:0;border-radius:14px;padding:13px;font-size:15px;font-weight:700}\n.logbtn{background:#4a7bf0;color:#fff}.closebtn{background:rgba(127,127,127,.18);color:var(--fg)}\n.hist{margin-top:22px}\n.hist h3{font-size:13px;opacity:.55;text-transform:uppercase;letter-spacing:.5px;margin:0 0 8px}\n.hrow{display:flex;align-items:center;gap:10px;font-size:14px;padding:7px 0;border-top:1px solid rgba(127,127,127,.14)}\n.hrow .em{font-size:20px}.hrow .t{margin-left:auto;opacity:.5;font-size:12px}\n.clear{border:0;background:none;color:#f0584f;font-size:12px;font-weight:600;margin-top:6px}\n@media(min-width:768px){body{max-width:720px}}\n</style></head><body>\n<h1>💗 How Are You Feeling?</h1>\n<div class=\"sub\">Tap the colour that matches how you feel right now.</div>\n<div class=\"zones\" id=\"zones\"></div>\n<div class=\"panel\" id=\"panel\"></div>\n<div class=\"hist\" id=\"hist\"></div>\n<script>\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nfunction haptic(s){if(window.myllmHaptic)try{myllmHaptic(s)}catch(e){}}\nvar ZONES=[\n {id:'blue',c:'#4a7bf0',em:'😢',nm:'Blue',ds:'sad · tired · poorly',\n  msg:\"It's okay to feel low. These can help you feel a bit better.\",\n  tools:[['🤗','Ask for a hug or a chat'],['💧','Have a drink of water'],['🛋️','Rest in a cosy quiet spot'],['🌬️','Take three slow breaths']]},\n {id:'green',c:'#34a853',em:'😊',nm:'Green',ds:'happy · calm · ready',\n  msg:\"You're in a great place to learn and play. Keep it up!\",\n  tools:[['🎯','Carry on with what you’re doing'],['🤝','Help a friend or say hello'],['🌟','Notice one good thing right now']]},\n {id:'yellow',c:'#f4b400',em:'😟',nm:'Yellow',ds:'worried · wiggly · silly',\n  msg:\"Feeling a bit wobbly is normal. Let's get steady again.\",\n  tools:[['🌬️','Breathe in for 4, out for 4'],['🔢','Slowly count to ten'],['✋','Squeeze and let go your hands'],['⏸️','Ask for a short break']]},\n {id:'red',c:'#ea4335',em:'😠',nm:'Red',ds:'angry · upset · too much',\n  msg:\"Big feelings are okay. You are safe. Let's calm your body.\",\n  tools:[['🛑','Stop and stand still'],['🌬️','Take long, slow breaths'],['🧱','Push your hands on a wall'],['🧑','Find a grown-up you trust']]}\n];\nvar hist=[];\nfunction el(i){return document.getElementById(i)}\nfunction renderZones(){\n  var Z=el('zones');Z.innerHTML='';\n  ZONES.forEach(function(z){\n    var b=document.createElement('button');b.className='zone';b.style.background=z.c;\n    b.innerHTML='<div class=\"em\">'+z.em+'</div><div class=\"nm\">'+z.nm+'</div><div class=\"ds\">'+z.ds+'</div>';\n    b.onclick=function(){openZone(z)};\n    Z.appendChild(b);\n  });\n}\nfunction openZone(z){\n  haptic('selection');\n  // pick up to 3 tools, rotating so it feels fresh\n  var t=z.tools.slice();for(var i=t.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var x=t[i];t[i]=t[j];t[j]=x}\n  t=t.slice(0,3);\n  var P=el('panel');P.className='panel show';P.style.borderTop='6px solid '+z.c;\n  P.innerHTML='<h2>'+z.em+' '+z.nm+'</h2><div class=\"msg\">'+z.msg+'</div>'+\n    t.map(function(x){return '<div class=\"tool\"><span class=\"em\">'+x[0]+'</span>'+x[1]+'</div>'}).join('')+\n    '<div class=\"pbtns\"><button class=\"logbtn\" id=\"logb\">Save how I feel</button><button class=\"closebtn\" id=\"closeb\">Close</button></div>';\n  el('logb').onclick=function(){logFeeling(z)};\n  el('closeb').onclick=function(){P.className='panel'};\n  P.scrollIntoView({behavior:'smooth',block:'nearest'});\n}\nfunction logFeeling(z){\n  hist.unshift({z:z.id,em:z.em,nm:z.nm,t:Date.now()});\n  hist=hist.slice(0,30);\n  store.setItem('fc_hist',JSON.stringify(hist));\n  haptic('success');\n  el('panel').className='panel';\n  renderHist();\n}\nfunction fmtTime(ts){var d=new Date(ts);var h=d.getHours(),m=d.getMinutes();var ap=h<12?'am':'pm';h=h%12||12;return h+':'+(m<10?'0':'')+m+ap}\nfunction sameDay(a,b){var x=new Date(a),y=new Date(b);return x.toDateString()===y.toDateString()}\nfunction renderHist(){\n  var H=el('hist');\n  var today=hist.filter(function(r){return sameDay(r.t,Date.now())});\n  if(!today.length){H.innerHTML='';return}\n  H.innerHTML='<h3>Today’s check-ins</h3>'+today.map(function(r){\n    return '<div class=\"hrow\"><span class=\"em\">'+r.em+'</span>'+r.nm+'<span class=\"t\">'+fmtTime(r.t)+'</span></div>';\n  }).join('')+'<button class=\"clear\" id=\"clr\">Clear today</button>';\n  el('clr').onclick=function(){hist=hist.filter(function(r){return !sameDay(r.t,Date.now())});store.setItem('fc_hist',JSON.stringify(hist));renderHist()};\n}\nrenderZones();\nstore.getItem('fc_hist').then(function(v){if(v){try{hist=JSON.parse(v)||[]}catch(e){}}renderHist()});\n</script></body></html>\n", "kind": "html", "iconSymbol": "heart.fill", "iconColor": "purple"}