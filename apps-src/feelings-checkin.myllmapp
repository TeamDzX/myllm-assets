{"name": "Feelings Check-In", "html": "<!doctype html>\n<!--\n  Feelings Check-In — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover\">\n<title>Feelings Check-In</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"719a6558f9\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); --h:285; }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; -webkit-user-select:none; user-select:none; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:720px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.97); }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 45% 52%), hsl(calc(var(--h) + 30) 45% 34%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  .q{ font-size:20px; font-weight:800; letter-spacing:-.01em; margin:4px 2px 12px; }\n  h3{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:22px 2px 10px; }\n\n  /* Four calm colour tiles; the faces are content. */\n  .zones{ display:grid; grid-template-columns:1fr 1fr; gap:12px; }\n  @media (min-width:700px){ .zones{ grid-template-columns:repeat(4,1fr); } }\n  .zone{ min-height:140px; border-radius:22px; padding:16px 12px; color:#fff; text-align:center; border:3px solid transparent;\n    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:3px; box-shadow:0 6px 16px rgba(0,0,0,.12); }\n  .zone.on{ border-color:var(--ink); }\n  .zone .em{ font-size:48px; line-height:1.1; }\n  .zone .nm{ font-size:18px; font-weight:800; margin-top:4px; }\n  .zone .ds{ font-size:12.5px; opacity:.92; }\n\n  .panel{ margin-top:14px; background:var(--surface); border:1px solid var(--line); border-radius:20px; padding:16px; border-top-width:8px; }\n  .panel h2{ display:flex; align-items:center; gap:10px; font-size:21px; font-weight:800; }\n  .panel h2 .em{ font-size:30px; }\n  .panel .msg{ font-size:15.5px; color:var(--muted); line-height:1.5; margin:6px 0 12px; }\n  .tool{ display:flex; align-items:center; gap:14px; min-height:60px; padding:10px 14px; border-radius:16px; background:var(--fill); margin-bottom:8px; font-size:17px; font-weight:650; line-height:1.3; }\n  .tool .em{ font-size:28px; flex-shrink:0; }\n  .pbtns{ display:flex; gap:10px; margin-top:12px; }\n  .pbtns button{ flex:1; min-height:56px; border:none; border-radius:16px; font-size:16px; font-weight:750; display:flex; align-items:center; justify-content:center; gap:8px; }\n  .logbtn{ color:#fff; }\n  .closebtn{ background:var(--fill); }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:4px 14px; }\n  .hrow{ display:flex; align-items:center; gap:12px; font-size:16px; font-weight:600; min-height:56px; border-bottom:1px solid var(--line); }\n  .hrow:last-child{ border-bottom:none; }\n  .hrow .dot{ width:12px; height:12px; border-radius:50%; flex-shrink:0; }\n  .hrow .em{ font-size:24px; }\n  .hrow .t{ margin-left:auto; color:var(--muted); font-size:13.5px; font-weight:500; font-variant-numeric:tabular-nums; }\n  .clear{ display:flex; align-items:center; gap:6px; min-height:44px; border:none; background:none; color:#e5484d; font-size:14px; font-weight:700; margin:6px 2px 0; }\n  [hidden]{ display:none !important; }\n  @media (prefers-reduced-motion:reduce){ button:active{ transform:none; } }\n\n/* myllm-fullscreen-v1 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-heart\" viewBox=\"0 0 24 24\"><path d=\"M12 20.3l-1.3-1.2C5.8 14.7 3 12.1 3 8.9A4.8 4.8 0 0 1 7.9 4c1.6 0 3.1.7 4.1 1.9A5.5 5.5 0 0 1 16.1 4 4.8 4.8 0 0 1 21 8.9c0 3.2-2.8 5.8-7.7 10.2z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M5 12.6l4.6 4.6L19.2 7.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n</defs></svg>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></div>\n  <div class=\"ht\"><h1>Feelings Check-In</h1><p>Tap the colour that matches how you feel right now.</p></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Feelings Check-In\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n<div class=\"q\">How Are You Feeling?</div>\n<div class=\"zones\" id=\"zones\"></div>\n<div class=\"panel\" id=\"panel\" hidden></div>\n<div id=\"hist\"></div>\n\n<script>\nfunction el(i){return document.getElementById(i)}\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction store(){return window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}}}\nfunction haptic(s){if(window.myllmHaptic)try{myllmHaptic(s)}catch(e){}}\nfunction icon(n){return '<svg class=\"i\"><use href=\"#i-'+n+'\"/></svg>'}\nvar ZONES=[\n {id:'blue',c:'#4a7bf0',em:'😢',nm:'Blue',ds:'sad · tired · poorly',\n  msg:\"It's okay to feel low. These can help you feel a bit better.\",\n  tools:[['🤗','Ask for a hug or a chat'],['💧','Have a drink of water'],['🛋️','Rest in a cosy quiet spot'],['🌬️','Take three slow breaths']]},\n {id:'green',c:'#34a853',em:'😊',nm:'Green',ds:'happy · calm · ready',\n  msg:\"You're in a great place to learn and play. Keep it up!\",\n  tools:[['🎯','Carry on with what you’re doing'],['🤝','Help a friend or say hello'],['🌟','Notice one good thing right now']]},\n {id:'yellow',c:'#e0a400',em:'😟',nm:'Yellow',ds:'worried · wiggly · silly',\n  msg:\"Feeling a bit wobbly is normal. Let's get steady again.\",\n  tools:[['🌬️','Breathe in for 4, out for 4'],['🔢','Slowly count to ten'],['✋','Squeeze and let go your hands'],['⏸️','Ask for a short break']]},\n {id:'red',c:'#e04a3c',em:'😠',nm:'Red',ds:'angry · upset · too much',\n  msg:\"Big feelings are okay. You are safe. Let's calm your body.\",\n  tools:[['🛑','Stop and stand still'],['🌬️','Take long, slow breaths'],['🧱','Push your hands on a wall'],['🧑','Find a grown-up you trust']]}\n];\nvar COL={}; ZONES.forEach(function(z){COL[z.id]=z.c});\nvar hist=[],openId=null;\nfunction save(){store().setItem('fc_hist',JSON.stringify(hist))}\nfunction renderZones(){\n  var Z=el('zones');Z.innerHTML='';\n  ZONES.forEach(function(z){\n    var b=document.createElement('button');b.type='button';b.className='zone'+(openId===z.id?' on':'');\n    b.style.background='linear-gradient(160deg,'+z.c+','+z.c+'dd)';\n    b.innerHTML='<div class=\"em\">'+z.em+'</div><div class=\"nm\">'+z.nm+'</div><div class=\"ds\">'+z.ds+'</div>';\n    b.onclick=function(){openZone(z)};\n    Z.appendChild(b);\n  });\n}\nfunction closePanel(){el('panel').hidden=true;openId=null;renderZones()}\nfunction openZone(z){\n  haptic('selection');openId=z.id;renderZones();\n  // pick up to 3 tools, rotating so it feels fresh\n  var t=z.tools.slice();for(var i=t.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var x=t[i];t[i]=t[j];t[j]=x}\n  t=t.slice(0,3);\n  var P=el('panel');P.hidden=false;P.style.borderTopColor=z.c;\n  P.innerHTML='<h2><span class=\"em\">'+z.em+'</span>'+z.nm+'</h2><div class=\"msg\">'+z.msg+'</div>'+\n    t.map(function(x){return '<div class=\"tool\"><span class=\"em\">'+x[0]+'</span><span>'+x[1]+'</span></div>'}).join('')+\n    '<div class=\"pbtns\"><button class=\"logbtn\" id=\"logb\" type=\"button\">'+icon('check')+'Save how I feel</button><button class=\"closebtn\" id=\"closeb\" type=\"button\">Close</button></div>';\n  el('logb').style.background=z.c;\n  el('logb').onclick=function(){logFeeling(z)};\n  el('closeb').onclick=closePanel;\n  P.scrollIntoView({behavior:'smooth',block:'nearest'});\n}\nfunction logFeeling(z){\n  hist.unshift({z:z.id,em:z.em,nm:z.nm,t:Date.now()});\n  hist=hist.slice(0,30);\n  save();\n  haptic('success');\n  closePanel();\n  renderHist();\n}\nfunction fmtTime(ts){var d=new Date(ts);var h=d.getHours(),m=d.getMinutes();var ap=h<12?'am':'pm';h=h%12||12;return h+':'+(m<10?'0':'')+m+ap}\nfunction sameDay(a,b){var x=new Date(a),y=new Date(b);return x.toDateString()===y.toDateString()}\nfunction renderHist(){\n  var H=el('hist');\n  var today=hist.filter(function(r){return sameDay(r.t,Date.now())});\n  if(!today.length){H.innerHTML='';return}\n  H.innerHTML='<h3>Today’s check-ins</h3><div class=\"card\">'+today.map(function(r){\n    return '<div class=\"hrow\"><span class=\"dot\" style=\"background:'+(COL[r.z]||'#999')+'\"></span><span class=\"em\">'+r.em+'</span>'+r.nm+'<span class=\"t\">'+fmtTime(r.t)+'</span></div>';\n  }).join('')+'</div><button class=\"clear\" id=\"clr\" type=\"button\">'+icon('x')+'Clear today</button>';\n  el('clr').onclick=function(){hist=hist.filter(function(r){return !sameDay(r.t,Date.now())});save();renderHist()};\n}\nrenderZones();\nstore().getItem('fc_hist').then(function(v){if(v){try{hist=JSON.parse(v)||[]}catch(e){}}renderHist()});\n\n/* myllm-fullscreen-v1 — full screen where MyLLM can also close the app for us (myllmClose,\n   5.6.2+): full screen hides MyLLM's Done, and a page with no way out is\n   worse than a repeated title, so elsewhere nothing changes. The spacer keeps\n   the header clear of the status bar only if the page doesn't already. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  function inset(){\n    var p = document.createElement(\"div\");\n    p.style.cssText = \"position:fixed;top:0;left:0;width:1px;visibility:hidden;height:env(safe-area-inset-top)\";\n    document.body.appendChild(p); var h = p.offsetHeight; p.parentNode.removeChild(p); return h;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = \"0px\";\n    if (!document.body.classList.contains(\"imm\")) return;\n    var need = inset() + 6 - (head.getBoundingClientRect().top + window.scrollY);\n    sp.style.height = Math.max(0, Math.round(need)) + \"px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  window.addEventListener(\"resize\", fit);\n  sync();\n})();\n</script></body></html>\n", "kind": "html", "iconSymbol": "heart.fill", "iconColor": "purple"}