{"name": "Art Studio", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Art Studio</title>\n<style>\n:root{\n  color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7);--surface:var(--myllm-surface,#fff);\n  --text:var(--myllm-text,#111);--muted:var(--myllm-muted,#6b6b72);\n  --accent:var(--myllm-accent,#0b5ed7);--border:var(--myllm-border,rgba(120,120,128,.25));\n  --radius:var(--myllm-radius,14px);--font:var(--myllm-font,-apple-system,system-ui,sans-serif);\n}\n@media(prefers-color-scheme:dark){:root{--bg:var(--myllm-bg,#000);--surface:var(--myllm-surface,#1c1c1e);--text:var(--myllm-text,#eee);--muted:var(--myllm-muted,#98989f)}}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nbody{margin:0;font-family:var(--font);background:var(--bg);color:var(--text);overflow-x:hidden}\n.stage{display:flex;align-items:center;justify-content:center;padding:14px 14px 0}\ncanvas{width:100%;max-width:460px;border-radius:var(--radius);box-shadow:0 6px 24px rgba(0,0,0,.18);display:block}\n.panel{max-width:460px;margin:0 auto;padding:12px 14px 28px}\n.row{display:flex;gap:8px;margin-bottom:10px}\n.modes{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none}.modes::-webkit-scrollbar{display:none}\nbutton{font:inherit;cursor:pointer;border:0;border-radius:10px}\n.chip{flex:none;padding:9px 14px;border-radius:999px;background:var(--surface);border:1px solid var(--border);color:var(--muted);font-weight:600;font-size:14px}\n.chip.on{background:var(--accent);color:#fff;border-color:transparent}\nlabel{display:block;font-size:12px;font-weight:600;color:var(--muted);margin:10px 0 4px;text-transform:uppercase;letter-spacing:.03em}\ninput[type=range]{width:100%;accent-color:var(--accent)}\n.pals{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px;scrollbar-width:none}.pals::-webkit-scrollbar{display:none}\n.pal{flex:none;width:44px;height:28px;border-radius:8px;border:2px solid transparent;overflow:hidden;display:flex}\n.pal.on{border-color:var(--text)}\n.pal span{flex:1}\n.actions{display:flex;gap:8px;margin-top:16px}\n.actions button{flex:1;padding:13px;font-weight:700;font-size:15px}\n.primary{background:var(--accent);color:#fff}\n.ghost{background:var(--surface);border:1px solid var(--border);color:var(--text)}\n#toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%) translateY(20px);background:rgba(0,0,0,.85);color:#fff;padding:10px 18px;border-radius:999px;font-size:14px;opacity:0;transition:.25s;pointer-events:none;z-index:50}\n#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}\n</style>\n</head>\n<body>\n<div class=\"stage\"><canvas id=\"c\"></canvas></div>\n<div class=\"panel\">\n  <div class=\"modes\" id=\"modes\"></div>\n  <label>Density</label><input type=\"range\" id=\"density\" min=\"1\" max=\"100\" value=\"55\">\n  <label>Turbulence</label><input type=\"range\" id=\"turb\" min=\"1\" max=\"100\" value=\"40\">\n  <label>Stroke</label><input type=\"range\" id=\"stroke\" min=\"1\" max=\"100\" value=\"30\">\n  <label>Palette</label><div class=\"pals\" id=\"pals\"></div>\n  <div class=\"actions\">\n    <button class=\"ghost\" id=\"newBtn\">↻ New</button>\n    <button class=\"ghost\" id=\"shareBtn\">Share</button>\n    <button class=\"primary\" id=\"saveBtn\">Save to Photos</button>\n  </div>\n</div>\n<div id=\"toast\"></div>\n<script>\nvar cv=document.getElementById('c'),ctx=cv.getContext('2d');\nvar W=900,H=1125; // 4:5 portrait, hi-res for crisp export\ncv.width=W;cv.height=H;\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nfunction toast(t){var e=document.getElementById('toast');e.textContent=t;e.classList.add('show');clearTimeout(e._t);e._t=setTimeout(function(){e.classList.remove('show')},1600)}\n\nvar PALETTES=[\n  [\"#0b5ed7\",\"#5ec8ff\",\"#b388ff\",\"#ffd166\",\"#ffffff\"],\n  [\"#ff6b6b\",\"#ffd93d\",\"#6bcB77\",\"#4d96ff\",\"#fff7e6\"],\n  [\"#231942\",\"#5e548e\",\"#9f86c0\",\"#be95c4\",\"#e0b1cb\"],\n  [\"#0d1b2a\",\"#1b9aaa\",\"#06d6a0\",\"#ef476f\",\"#ffd166\"],\n  [\"#2b2d42\",\"#8d99ae\",\"#edf2f4\",\"#ef233c\",\"#d90429\"],\n  [\"#03071e\",\"#370617\",\"#9d0208\",\"#dc2f02\",\"#ffba08\"],\n  [\"#004b23\",\"#38b000\",\"#9ef01a\",\"#ccff33\",\"#ffffff\"],\n  [\"#10002b\",\"#3c096c\",\"#7b2cbf\",\"#c77dff\",\"#e0aaff\"]\n];\nvar MODES=[\"Flow\",\"Swarm\",\"Bloom\"];\nvar state={mode:0,pal:0,seed:1,density:55,turb:40,stroke:30};\n\n// seeded PRNG\nfunction mulberry32(a){return function(){a|=0;a=a+0x6D2B79F5|0;var t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}\nvar rnd;\nfunction field(x,y,t){ // smooth pseudo-noise angle field\n  return Math.sin(x*0.9+t)+Math.cos(y*1.1-t*0.7)+Math.sin((x+y)*0.6+t*1.3);\n}\n\nfunction draw(){\n  rnd=mulberry32(state.seed);\n  var pal=PALETTES[state.pal];\n  var dark=pal[0];\n  ctx.globalCompositeOperation='source-over';\n  ctx.fillStyle=dark;ctx.fillRect(0,0,W,H);\n  ctx.lineCap='round';\n  var d=state.density/100,turb=state.turb/100,sw=state.stroke/100;\n  if(MODES[state.mode]===\"Flow\")drawFlow(pal,d,turb,sw);\n  else if(MODES[state.mode]===\"Swarm\")drawSwarm(pal,d,turb,sw);\n  else drawBloom(pal,d,turb,sw);\n}\n\nfunction pick(pal){return pal[1+Math.floor(rnd()*(pal.length-1))]}\n\nfunction drawFlow(pal,d,turb,sw){\n  ctx.globalCompositeOperation='lighter';\n  var lines=Math.floor(120+d*900),steps=70,scale=turb*0.012+0.002;\n  ctx.lineWidth=0.5+sw*3.5;ctx.globalAlpha=0.5;\n  for(var i=0;i<lines;i++){\n    var x=rnd()*W,y=rnd()*H;\n    ctx.strokeStyle=pick(pal);ctx.beginPath();ctx.moveTo(x,y);\n    for(var s=0;s<steps;s++){\n      var a=field(x*scale,y*scale,state.seed*0.001)*Math.PI;\n      x+=Math.cos(a)*6;y+=Math.sin(a)*6;\n      if(x<0||x>W||y<0||y>H)break;\n      ctx.lineTo(x,y);\n    }\n    ctx.stroke();\n  }\n  ctx.globalAlpha=1;\n}\n\nfunction drawSwarm(pal,d,turb,sw){\n  ctx.globalCompositeOperation='lighter';\n  var n=Math.floor(60+d*500),cx=W/2,cy=H/2;\n  var attractors=[];for(var k=0;k<3;k++)attractors.push({x:rnd()*W,y:rnd()*H});\n  ctx.lineWidth=0.4+sw*2.2;ctx.globalAlpha=0.45;\n  for(var i=0;i<n;i++){\n    var x=rnd()*W,y=rnd()*H,vx=0,vy=0;\n    ctx.strokeStyle=pick(pal);ctx.beginPath();ctx.moveTo(x,y);\n    for(var s=0;s<90;s++){\n      var a=attractors[s%attractors.length];\n      var dx=a.x-x,dy=a.y-y,dist=Math.sqrt(dx*dx+dy*dy)+0.01;\n      vx+=(dx/dist)*(0.6+turb*2)+(rnd()-0.5)*turb*4;\n      vy+=(dy/dist)*(0.6+turb*2)+(rnd()-0.5)*turb*4;\n      vx*=0.92;vy*=0.92;x+=vx;y+=vy;\n      ctx.lineTo(x,y);\n    }\n    ctx.stroke();\n  }\n  ctx.globalAlpha=1;\n}\n\nfunction drawBloom(pal,d,turb,sw){\n  ctx.globalCompositeOperation='lighter';\n  var cx=W/2,cy=H/2,sym=6+Math.floor(rnd()*10),petals=Math.floor(40+d*260);\n  ctx.lineWidth=0.6+sw*3;ctx.globalAlpha=0.55;\n  for(var i=0;i<petals;i++){\n    var r=rnd()*Math.min(W,H)*0.46,ang=rnd()*Math.PI*2;\n    var len=20+rnd()*(80+turb*260),wob=(rnd()-0.5)*turb*1.4;\n    var col=pick(pal);\n    for(var k=0;k<sym;k++){\n      var a=ang+k*(Math.PI*2/sym);\n      ctx.strokeStyle=col;ctx.beginPath();\n      var x=cx+Math.cos(a)*r,y=cy+Math.sin(a)*r;ctx.moveTo(x,y);\n      ctx.quadraticCurveTo(\n        cx+Math.cos(a+wob)*(r+len*0.5),cy+Math.sin(a+wob)*(r+len*0.5),\n        cx+Math.cos(a)*(r+len),cy+Math.sin(a)*(r+len));\n      ctx.stroke();\n    }\n  }\n  ctx.globalAlpha=1;\n}\n\nfunction buildModes(){\n  var m=document.getElementById('modes');m.innerHTML='';\n  MODES.forEach(function(name,i){\n    var b=document.createElement('button');b.className='chip'+(i===state.mode?' on':'');b.textContent=name;\n    b.onclick=function(){state.mode=i;haptic('selection');buildModes();regen()};m.appendChild(b);\n  });\n}\nfunction buildPals(){\n  var p=document.getElementById('pals');p.innerHTML='';\n  PALETTES.forEach(function(pal,i){\n    var d=document.createElement('button');d.className='pal'+(i===state.pal?' on':'');\n    pal.forEach(function(c){var s=document.createElement('span');s.style.background=c;d.appendChild(s)});\n    d.onclick=function(){state.pal=i;haptic('selection');buildPals();draw();save()};p.appendChild(d);\n  });\n}\nfunction regen(){state.seed=Math.floor(Math.random()*1e9);draw();save()}\n\n['density','turb','stroke'].forEach(function(id){\n  document.getElementById(id).oninput=function(){state[id==='turb'?'turb':id]=+this.value;draw()};\n  document.getElementById(id).onchange=save;\n});\ndocument.getElementById('newBtn').onclick=function(){haptic('light');regen()};\ndocument.getElementById('saveBtn').onclick=function(){\n  haptic('success');\n  if(!window.myllmSaveImage){toast('Update MyLLM to save to Photos');return}\n  myllmSaveImage(cv.toDataURL('image/png')).then(function(){toast('Saved to Photos ✓')}).catch(function(){toast('Couldn’t save (check Photos permission)')});\n};\ndocument.getElementById('shareBtn').onclick=function(){\n  haptic('light');\n  if(window.myllmShare)myllmShare('Made with Art Studio in MyLLM');\n};\n\nfunction save(){if(window.myllmStorage)myllmStorage.setItem('art',JSON.stringify(state))}\nfunction load(){\n  if(!window.myllmStorage){draw();return}\n  myllmStorage.getItem('art').then(function(v){\n    if(v)try{var s=JSON.parse(v);for(var k in s)state[k]=s[k];\n      document.getElementById('density').value=state.density;\n      document.getElementById('turb').value=state.turb;\n      document.getElementById('stroke').value=state.stroke;\n    }catch(e){}\n    buildModes();buildPals();draw();\n  });\n}\nbuildModes();buildPals();load();\n</script>\n</body>\n</html>\n", "kind": "html", "iconSymbol": "paintpalette.fill", "iconColor": "pink"}