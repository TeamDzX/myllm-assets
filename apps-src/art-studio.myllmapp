tt)*Math.PI;\n      p.vx=p.vx*0.8+Math.cos(a)*sp;p.vy=p.vy*0.8+Math.sin(a)*sp;\n    }else if(state.mode===1){ // Swarm\n      var dx=cx0-p.x,dy=cy0-p.y,d=Math.sqrt(dx*dx+dy*dy)+0.01;\n      p.vx=p.vx*0.92+(dx/d)*sp*0.5+(rnd()-0.5)*sp*1.4;\n      p.vy=p.vy*0.92+(dy/d)*sp*0.5+(rnd()-0.5)*sp*1.4;\n    }else if(state.mode===2){ // Bloom: outward radial (drawn symmetric below)\n      p.ang=(p.ang||0)+(rnd()-0.5)*0.04*turb;\n      p.vx=Math.cos(p.ang)*(p.spd||1)*sp*0.5;p.vy=Math.sin(p.ang)*(p.spd||1)*sp*0.5;\n    }else if(state.mode===3){ // Vortex: swirl around the centre\n      var vdx=p.x-cx0,vdy=p.y-cy0,vd=Math.sqrt(vdx*vdx+vdy*vdy)+0.01;\n      p.vx=p.vx*0.9+(-vdy/vd)*sp-(vdx/vd)*sp*0.12;\n      p.vy=p.vy*0.9+(vdx/vd)*sp-(vdy/vd)*sp*0.12;\n    }else if(state.mode===4){ // Ripple: travelling radial waves\n      var wdx=p.x-cx0,wdy=p.y-cy0,wd=Math.sqrt(wdx*wdx+wdy*wdy)+0.01,wv=Math.sin(wd*0.05-tt*4);\n      p.vx=p.vx*0.86+(wdx/wd)*wv*sp*0.9;\n      p.vy=p.vy*0.86+(wdy/wd)*wv*sp*0.9;\n    }else{ // Orbit: particles circle at their own radius\n      var odx=p.x-cx0,ody=p.y-cy0,od=Math.sqrt(odx*odx+ody*ody)+0.01,kk=sp*20/(od+40);\n      p.vx=p.vx*0.9+(-ody/od)*kk+(odx/od)*(1-od/380)*sp*0.15;\n      p.vy=p.vy*0.9+(odx/od)*kk+(ody/od)*(1-od/380)*sp*0.15;\n    }\n    if(touch&&(state.mode===0||state.mode===2)){var tdx=touch.x-p.x,tdy=touch.y-p.y,td=Math.sqrt(tdx*tdx+tdy*tdy)+1;if(td<160){p.vx+=tdx/td*sp;p.vy+=tdy/td*sp}}\n    p.x+=p.vx;p.y+=p.vy;p.life--;\n    var off=p.x<0||p.x>W||p.y<0||p.y>H||p.life<0;\n    if(state.mode===2){\n      // draw symmetric\n      var cx=W/2,cy=H/2,rdx=p.px-cx,rdy=p.py-cy,ndx=p.x-cx,ndy=p.y-cy;\n      ctx.strokeStyle=p.col;\n      for(var k=0;k<sym;k++){var ang=k*2*Math.PI/sym,c=Math.cos(ang),s=Math.sin(ang);\n        ctx.beginPath();ctx.moveTo(cx+rdx*c-rdy*s,cy+rdx*s+rdy*c);ctx.lineTo(cx+ndx*c-ndy*s,cy+ndx*s+ndy*c);ctx.stroke();\n        ctx.beginPath();ctx.moveTo(cx+rdx*c+rdy*s,cy-rdx*s+rdy*c);ctx.lineTo(cx+ndx*c+ndy*s,cy-ndx*s+ndy*c);ctx.stroke();\n      }\n      if(off){var a2=rnd()*Math.PI*2,r2=rnd()*8;p.x=cx+Math.cos(a2)*r2;p.y=cy+Math.sin(a2)*r2;p.px=p.x;p.py=p.y;p.vx=0;p.vy=0;p.ang=a2;p.spd=0.6+rnd()*1.6;p.col=pick();p.life=40+rnd()*120}\n    }else{\n      ctx.strokeStyle=p.col;ctx.beginPath();ctx.moveTo(p.px,p.py);ctx.lineTo(p.x,p.y);ctx.stroke();\n      if(off)newParticle(p);\n    }\n  }\n  ctx.globalAlpha=1;\n  if(recording)capture();\n  raf=requestAnimationFrame(step);\n}\n\n// ---- free-form touch ----\nfunction pos(e){var r=cv.getBoundingClientRect();return{x:(e.clientX-r.left)/r.width*W,y:(e.clientY-r.top)/r.height*H}}\ncv.addEventListener('pointerdown',function(e){e.preventDefault();touch=pos(e);cv.setPointerCapture(e.pointerId);haptic('selection');inject()});\ncv.addEventListener('pointermove',function(e){if(!touch)return;e.preventDefault();touch=pos(e);inject()});\nfunction endT(){touch=null}\ncv.addEventListener('pointerup',endT);cv.addEventListener('pointercancel',endT);cv.addEventListener('pointerleave',endT);\nfunction inject(){ // spawn a few particles at the touch (paint)\n  if(!touch)return;\n  for(var i=0;i<4;i++){var p=newParticle();p.x=touch.x+(rnd()-0.5)*20;p.y=touch.y+(rnd()-0.5)*20;p.px=p.x;p.py=p.y;if(state.mode===2){p.x=W/2;p.y=H/2;p.ang=Math.atan2(touch.y-H/2,touch.x-W/2)+(rnd()-0.5)*0.4;p.spd=0.6+rnd()*1.6}parts.push(p)}\n  if(parts.length>1400)parts.splice(0,parts.length-1400);\n}\n\n// ---- GIF recording ----\nvar gw=360,gh=480,gc=document.createElement('canvas');gc.width=gw;gc.height=gh;var gctx=gc.getContext('2d');\nvar recording=false,frames=[],tick=0,MAXF=28;\nfunction capture(){tick++;if(tick%3!==0)return;gctx.drawImage(cv,0,0,gw,gh);frames.push(gctx.getImageData(0,0,gw,gh).data);if(frames.length>=MAXF){recording=false;encodeGIF()}}\nfunction bytesB64(u8){var s='',CH=0x8000;for(var i=0;i<u8.length;i+=CH)s+=String.fromCharCode.apply(null,u8.subarray(i,i+CH));return btoa(s)}\nfunction encodeGIF(){\n  document.getElementById('ovT').textContent='Rendering GIF…';document.getElementById('ov').classList.add('show');\n  setTimeout(function(){\n    try{\n      var enc=GIFLIB.GIFEncoder();\n      for(var f=0;f<frames.length;f++){var rgba=frames[f];var pal=GIFLIB.quantize(rgba,256);var idx=GIFLIB.applyPalette(rgba,pal);enc.writeFrame(idx,gw,gh,{palette:pal,delay:70});}\n      enc.finish();var url='data:image/gif;base64,'+bytesB64(enc.bytes());frames=[];\n      if(window.myllmSaveImage)myllmSaveImage(url).then(function(){toast('GIF saved to Photos ✓')}).catch(function(){toast('Couldn’t save (Photos permission?)')});\n      else toast('Update MyLLM to save');\n    }catch(e){toast('GIF failed: '+e.message)}\n    document.getElementById('ov').classList.remove('show');\n    document.getElementById('gifBtn').textContent='🎞️ Save GIF';\n  },60);\n}\ndocument.getElementById('gifBtn').onclick=function(){\n  if(recording)return;\n  if(paused){togglePlay()}\n  frames=[];tick=0;recording=true;haptic('medium');\n  this.innerHTML='<span class=\"recdot\"></span>Recording…';toast('Recording ~2 seconds…');\n};\n\n// ---- video clip recording (5/10/15s) → share as an mp4 via myllmShareFile ----\nvar vidRec=false;\nfunction pickVideoMime(){var c=['video/mp4;codecs=avc1','video/mp4','video/webm;codecs=vp9','video/webm;codecs=vp8','video/webm'];for(var i=0;i<c.length;i++){try{if(MediaRecorder.isTypeSupported(c[i]))return c[i]}catch(e){}}return ''}\nfunction videoSupported(){try{return !!(cv.captureStream&&typeof MediaRecorder!=='undefined'&&pickVideoMime())}catch(e){return false}}\nfunction setVid(on){vidRec=on;document.getElementById('vrec').classList.toggle('show',on);\n  var bs=document.querySelectorAll('#videoRow button');for(var i=0;i<bs.length;i++)bs[i].disabled=on;}\nfunction fmtT(s){return '0:'+(s<10?'0':'')+s}\nfunction recordVideo(secs){\n  if(vidRec||recording)return;\n  if(!window.myllmShareFile){toast('Sharing clips needs the latest MyLLM');return}\n  if(paused)togglePlay();\n  var mime=pickVideoMime(),strm;\n  try{strm=cv.captureStream(30)}catch(e){toast('Video capture isn’t available here');return}\n  var chunksV=[],mr;\n  try{mr=mime?new MediaRecorder(strm,{mimeType:mime,videoBitsPerSecond:2600000}):new MediaRecorder(strm)}catch(e){toast('Recorder unavailable');return}\n  mr.ondataavailable=function(e){if(e.data&&e.data.size)chunksV.push(e.data)};\n  mr.onstop=function(){\n    strm.getTracks().forEach(function(t){t.stop()});\n    var m=(mr.mimeType||mime||'video/mp4').split(';')[0];\n    document.getElementById('ovT').textContent='Preparing clip…';document.getElementById('ov').classList.add('show');\n    var fr=new FileReader();\n    fr.onload=function(){\n      document.getElementById('ov').classList.remove('show');\n      myllmShareFile(fr.result,{filename:'Art Studio clip',mime:m})\n        .then(function(){toast('Clip ready — choose where to send it')})\n        .catch(function(){toast('Couldn’t share the clip')});\n    };\n    fr.onerror=function(){document.getElementById('ov').classList.remove('show');toast('Couldn’t prepare the clip')};\n    fr.readAsDataURL(new Blob(chunksV,{type:m}));\n  };\n  setVid(true);haptic('medium');mr.start();\n  var left=secs;document.getElementById('vrecT').textContent=fmtT(left);\n  var iv=setInterval(function(){left=Math.max(0,left-1);document.getElementById('vrecT').textContent=fmtT(left);},1000);\n  setTimeout(function(){clearInterval(iv);try{mr.stop()}catch(e){}setVid(false);},secs*1000);\n}\n(function(){var bs=document.querySelectorAll('#videoRow button');for(var i=0;i<bs.length;i++){(function(b){b.onclick=function(){recordVideo(+b.getAttribute('data-s'))}})(bs[i]);}\n  if(videoSupported()&&window.myllmShareFile){document.getElementById('videoRow').style.display='';document.getElementById('clipLbl').style.display='';}\n})();\n\n// ---- UI ----\nfunction buildModes(){var m=document.getElementById('modes');m.innerHTML='';MODES.forEach(function(name,i){var b=document.createElement('button');b.className='chip'+(i===state.mode?' on':'');b.textContent=name;b.onclick=function(){state.mode=i;haptic('selection');buildModes();reseed();clearCanvas();save()};m.appendChild(b)})}\nfunction buildPals(){var p=document.getElementById('pals');p.innerHTML='';PALETTES.forEach(function(pal,i){var d=document.createElement('button');d.className='pal'+(i===state.pal?' on':'');pal.forEach(function(c){var s=document.createElement('span');s.style.background=c;d.appendChild(s)});d.onclick=function(){state.pal=i;haptic('selection');buildPals();clearCanvas();save()};p.appendChild(d)})}\n['density','speed','trail','stroke'].forEach(function(id){var el=document.getElementById(id);el.oninput=function(){state[id]=+this.value};el.onchange=save});\nfunction togglePlay(){paused=!paused;document.getElementById('playBtn').textContent=paused?'▶ Play':'⏸ Pause';if(!paused&&!raf)raf=requestAnimationFrame(step);if(paused&&raf){cancelAnimationFrame(raf);raf=null}haptic('selection')}\ndocument.getElementById('playBtn').onclick=togglePlay;\ndocument.getElementById('newBtn').onclick=function(){reseed();clearCanvas();save();haptic('light')};\ndocument.getElementById('clearBtn').onclick=function(){clearCanvas();haptic('warning')};\ndocument.getElementById('saveBtn').onclick=function(){haptic('success');if(!window.myllmSaveImage){toast('Update MyLLM to save');return}myllmSaveImage(cv.toDataURL('image/png')).then(function(){toast('Saved to Photos ✓')}).catch(function(){toast('Couldn’t save (Photos permission?)')})};\n\nfunction save(){if(window.myllmStorage)myllmStorage.setItem('art',JSON.stringify(state))}\nfunction load(){\n  if(!window.myllmStorage){init();return}\n  myllmStorage.getItem('art').then(function(v){\n    if(v)try{var s=JSON.parse(v);for(var k in s)if(k in state)state[k]=s[k];\n      ['density','speed','trail','stroke'].forEach(function(id){document.getElementById(id).value=state[id]});\n    }catch(e){}\n    init();\n  });\n}\nfunction init(){buildModes();buildPals();clearCanvas();reseed();raf=requestAnimationFrame(step)}\nload();\n</script>\n</body>\n</html>\n", "kind": "html", "iconSymbol": "paintpalette.fill", "iconColor": "pink"}