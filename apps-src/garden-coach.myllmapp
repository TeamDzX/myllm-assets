{"name": "Garden Coach", "html": "<!doctype html>\n<!--\n  Garden Coach — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Garden Coach</title>\n<style>:root{--build-id:\"ff0ade068b\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); --h:158; }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:760px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.96); }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 55% 42%), hsl(calc(var(--h) - 25) 55% 26%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n\n  .season{ display:inline-flex; align-items:center; gap:7px; font-size:12.5px; font-weight:700; color:hsl(var(--h) 55% 30%);\n    background:hsl(var(--h) 55% 45% / .14); border-radius:99px; padding:6px 12px; margin:0 2px 12px; }\n  @media (prefers-color-scheme:dark){ .season{ color:hsl(var(--h) 55% 64%); } }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  label{ display:block; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:14px 2px 7px; }\n  label:first-child{ margin-top:0; }\n  input{ width:100%; font:inherit; font-size:16px; padding:12px; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; }\n  input:focus{ border-color:var(--acc); }\n  .chips{ display:grid; grid-template-columns:1fr 1fr; gap:8px; }\n  @media (min-width:560px){ .chips{ grid-template-columns:repeat(4,1fr); } }\n  .chip{ min-height:48px; border:1px solid var(--line); background:var(--bg); border-radius:14px; padding:8px 12px; font-size:14px; font-weight:650;\n    display:flex; align-items:center; gap:8px; text-align:left; line-height:1.25; }\n  .chip .e{ font-size:18px; flex-shrink:0; }\n  .chip:disabled{ opacity:.5; }\n  .ask{ display:flex; gap:8px; }\n  .ask input{ flex:1; min-width:0; }\n  .ask button{ flex-shrink:0; min-width:64px; border:none; border-radius:12px; background:var(--acc); color:#fff; font-size:15.5px; font-weight:700; padding:0 16px;\n    display:flex; align-items:center; justify-content:center; gap:6px; }\n  .ask button:disabled{ opacity:.55; }\n  .status{ font-size:13px; color:var(--muted); min-height:18px; margin:4px 2px 0; }\n  .status.err{ color:#ff453a; }\n\n  .answer .top{ display:flex; align-items:center; gap:11px; margin-bottom:10px; }\n  .answer .top .tile{ width:36px; height:36px; border-radius:10px; font-size:15px; }\n  .answer .top b{ font-size:16px; font-weight:750; line-height:1.3; overflow-wrap:anywhere; }\n  .answer .body{ font-size:15.5px; line-height:1.6; white-space:pre-wrap; overflow-wrap:anywhere; }\n  .spin{ width:16px; height:16px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n  .skel{ height:14px; border-radius:7px; background:var(--fill); margin-top:10px; animation:shimmer 1.4s ease-in-out infinite; }\n  .skel.w8{ width:80%; } .skel.w6{ width:60%; } .skel.w9{ width:92%; }\n  @keyframes shimmer{ 50%{ opacity:.45; } }\n  [hidden]{ display:none !important; }\n  @media (prefers-reduced-motion:reduce){ .spin{ animation-duration:2.4s; } .skel{ animation:none; } button:active{ transform:none; } }\n\n  @keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n  .myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n  .myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n  .myllm-ai-cog{width:16px;height:16px;border-radius:50%;border:2.4px solid #a78bfa;border-right-color:transparent;animation:myllmAiSpin .9s linear infinite;flex-shrink:0}\n  .myllm-ai-busy small{font-weight:400;opacity:.6}\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-flower\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5a3.5 3.5 0 0 1 3.4 4.4 3.5 3.5 0 0 1 2.7 6.1A3.5 3.5 0 0 1 12 15.9 3.5 3.5 0 0 1 5.9 13a3.5 3.5 0 0 1 2.7-6.1A3.5 3.5 0 0 1 12 2.5zm0 5.8a1.7 1.7 0 1 0 0 3.4 1.7 1.7 0 0 0 0-3.4zM11 16.8h2V21a1 1 0 0 1-2 0z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-cal\" viewBox=\"0 0 24 24\"><path d=\"M7 2.8a1 1 0 0 1 1 1V5h8V3.8a1 1 0 0 1 2 0V5h.5A2.5 2.5 0 0 1 21 7.5v11a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 18.5v-11A2.5 2.5 0 0 1 5.5 5H6V3.8a1 1 0 0 1 1-1zM5 10.2v8.3c0 .3.2.5.5.5h13c.3 0 .5-.2.5-.5v-8.3z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-send\" viewBox=\"0 0 24 24\"><path d=\"M3.4 11.1L19.6 4a.9.9 0 0 1 1.2 1.2L13.9 21.4a.9.9 0 0 1-1.7-.1L10.5 14l-7.2-1.6a.9.9 0 0 1-.1-1.7z\" fill=\"currentColor\"/></symbol>\n</defs></svg>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\"></span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n\n<div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-flower\"/></svg></div>\n  <div class=\"ht\"><h1>Garden Coach</h1><p>Your AI gardening helper — what to plant right now, and answers to anything.</p></div>\n</div>\n<div class=\"season\"><svg class=\"i\"><use href=\"#i-cal\"/></svg><span id=\"season\"></span></div>\n\n<div class=\"card\">\n  <label for=\"region\">Your area</label>\n  <input id=\"region\" placeholder=\"Your area / climate (optional, e.g. UK, mild)\" autocomplete=\"off\">\n  <label>Right now</label>\n  <div class=\"chips\">\n    <button class=\"chip\" type=\"button\" data-q=\"vegetables to sow or plant now\"><span class=\"e\">🥕</span>Veg to sow now</button>\n    <button class=\"chip\" type=\"button\" data-q=\"flowers to plant now\"><span class=\"e\">🌸</span>Flowers</button>\n    <button class=\"chip\" type=\"button\" data-q=\"herbs to grow now\"><span class=\"e\">🌿</span>Herbs</button>\n    <button class=\"chip\" type=\"button\" data-q=\"key gardening jobs to do this month\"><span class=\"e\">🧤</span>Jobs this month</button>\n  </div>\n  <label for=\"q\">Ask anything</label>\n  <div class=\"ask\"><input id=\"q\" placeholder=\"Ask the coach anything…\" enterkeyhint=\"send\" autocomplete=\"off\"><button id=\"askBtn\" type=\"button\" aria-label=\"Ask\"><svg class=\"i\"><use href=\"#i-send\"/></svg></button></div>\n</div>\n<div id=\"status\" class=\"status\"></div>\n<div class=\"card answer\" id=\"answer\" hidden></div>\n\n<script>\nfunction el(i){return document.getElementById(i)}\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction store(){return window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}}}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nvar month=new Date().toLocaleDateString(undefined,{month:'long'});\nfunction setStatus(t,err){var s=el('status');s.textContent=t||'';s.classList.toggle('err',!!err)}\nel('season').textContent='Tips tuned for '+month;\n\nfunction regionClause(){var r=el('region').value.trim();return r?(' I garden in: '+r+'.'):''}\nfunction busy(b){\n  el('askBtn').disabled=b;el('askBtn').innerHTML=b?'<i class=\"spin\"></i>':'<svg class=\"i\"><use href=\"#i-send\"/></svg>';\n  var c=document.querySelectorAll('.chip');for(var i=0;i<c.length;i++)c[i].disabled=b;\n}\nfunction answerCard(heading){\n  var a=el('answer');a.hidden=false;\n  a.innerHTML='<div class=\"top\"><div class=\"tile\"><svg class=\"i\"><use href=\"#i-flower\"/></svg></div><b></b></div>';\n  a.querySelector('b').textContent=heading;return a;\n}\n\nfunction run(prompt,heading){\n  if(!window.myllmAsk){setStatus('This app needs AI — update MyLLM and enable “Allow apps to use the AI” in Settings.',true);return}\n  busy(true);setStatus('');\n  var a=answerCard(heading);\n  a.insertAdjacentHTML('beforeend','<div class=\"skel w9\"></div><div class=\"skel w8\"></div><div class=\"skel w6\"></div><div class=\"skel w8\"></div>');\n  store().setItem('region',el('region').value.trim());\n  myllmAsk(prompt,{system:'You are a friendly, practical gardening expert. Be concise and specific. Prefer short bulleted lists. Assume a home gardener.'})\n  .then(function(reply){\n    var a=answerCard(heading);\n    var b=document.createElement('div');b.className='body';b.textContent=String(reply).trim();a.appendChild(b);\n    haptic('success');\n    a.scrollIntoView({behavior:'smooth',block:'nearest'});\n  }).catch(function(err){el('answer').hidden=true;setStatus('Coach unavailable: '+err.message,true)})\n  .then(function(){busy(false)});\n}\nfunction quick(what){\n  run('It is '+month+'.'+regionClause()+' List '+what+', as short bullet lines, each with a one-line tip. No preamble.',\n      month+' · '+what.charAt(0).toUpperCase()+what.slice(1));\n}\nfunction ask(){\n  var q=el('q').value.trim();if(!q)return;\n  run('It is '+month+'.'+regionClause()+' Gardening question: '+q+' Answer concisely for a home gardener.', q);\n  el('q').value='';\n}\n\n[].forEach.call(document.querySelectorAll('.chip'),function(c){c.onclick=function(){quick(c.getAttribute('data-q'))}});\nel('askBtn').onclick=ask;\nel('q').addEventListener('keydown',function(e){if(e.key==='Enter')ask()});\nstore().getItem('region').then(function(v){if(v)el('region').value=v});\nif(!window.myllmAsk)setStatus('Heads-up: this app needs the latest MyLLM with apps-AI enabled.');\n</script></body></html>\n", "kind": "html", "iconSymbol": "camera.macro", "iconColor": "mint"}