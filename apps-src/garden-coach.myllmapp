{"name": "Garden Coach", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>:root{color-scheme:light dark;--accent:#34c759}\n*{box-sizing:border-box}\nbody{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:18px;background:#f2f2f7;color:#111}\n@media(prefers-color-scheme:dark){body{background:#000;color:#eee}input,.answer{background:#1c1c1e;color:#eee;border-color:#3a3a3c}.chip{background:#1c1c1e;color:#eee}}\nh1{font-size:22px;margin:0 0 4px}\n.sub{font-size:13px;opacity:.6;margin-bottom:14px}\ninput{width:100%;padding:11px;border:1px solid #d1d1d6;border-radius:10px;font-size:15px;background:#fff;font-family:inherit;margin-bottom:8px}\n.chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px}\n.chip{border:0;background:#e8f7ee;color:#1a8a44;border-radius:18px;padding:9px 13px;font-size:14px;font-weight:600}\n@media(prefers-color-scheme:dark){.chip{background:#13351f;color:#5fd98a}}\n.ask{display:flex;gap:8px}\n.ask input{flex:1;margin-bottom:0}\n.ask button{border:0;background:var(--accent);color:#fff;border-radius:10px;padding:0 16px;font-size:15px;font-weight:600}\nbutton:disabled{opacity:.5}\n#status{font-size:13px;opacity:.7;min-height:16px;margin:10px 0}\n.answer{background:#fff;border-radius:13px;padding:14px 16px;margin-top:6px;font-size:15px;line-height:1.55;white-space:pre-wrap;box-shadow:0 1px 3px rgba(0,0,0,.08);display:none}\n.answer .q{font-weight:700;color:var(--accent);margin-bottom:6px}\n.season{font-size:12px;opacity:.55;margin-bottom:12px}\n</style></head><body>\n<h1>🌱 Garden Coach</h1>\n<div class=\"sub\">Your AI gardening helper — what to plant right now, and answers to anything.</div>\n<div class=\"season\" id=\"season\"></div>\n<input id=\"region\" placeholder=\"Your area / climate (optional, e.g. UK, mild)\">\n<div class=\"chips\">\n  <button class=\"chip\" onclick=\"quick('vegetables to sow or plant now')\">🥕 Veg to sow now</button>\n  <button class=\"chip\" onclick=\"quick('flowers to plant now')\">🌸 Flowers</button>\n  <button class=\"chip\" onclick=\"quick('herbs to grow now')\">🌿 Herbs</button>\n  <button class=\"chip\" onclick=\"quick('key gardening jobs to do this month')\">🧤 Jobs this month</button>\n</div>\n<div class=\"ask\"><input id=\"q\" placeholder=\"Ask the coach anything…\" enterkeyhint=\"send\"><button id=\"askBtn\" onclick=\"ask()\">Ask</button></div>\n<div id=\"status\"></div>\n<div class=\"answer\" id=\"answer\"></div>\n<script>\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar month=new Date().toLocaleDateString(undefined,{month:'long'});\nfunction el(i){return document.getElementById(i)}\nfunction setStatus(t){el('status').textContent=t||''}\nel('season').textContent='🗓️ Tips tuned for '+month;\n\nfunction regionClause(){var r=el('region').value.trim();return r?(' I garden in: '+r+'.'):''}\nfunction busy(b){el('askBtn').disabled=b;var c=document.querySelectorAll('.chip');for(var i=0;i<c.length;i++)c[i].disabled=b}\n\nfunction run(prompt,heading){\n  if(!window.myllmAsk){setStatus('This app needs AI — update MyLLM and enable “Allow apps to use the AI” in Settings.');return}\n  busy(true);setStatus('Asking the garden coach…');\n  store.setItem('region',el('region').value.trim());\n  myllmAsk(prompt,{system:'You are a friendly, practical gardening expert. Be concise and specific. Prefer short bulleted lists. Assume a home gardener.'})\n  .then(function(reply){\n    var a=el('answer');a.style.display='block';\n    a.innerHTML='<div class=\"q\"></div>';a.querySelector('.q').textContent=heading;\n    a.appendChild(document.createTextNode(reply.trim()));\n    setStatus('');if(window.myllmHaptic)myllmHaptic('success');\n    a.scrollIntoView({behavior:'smooth',block:'nearest'});\n  }).catch(function(err){setStatus('Coach unavailable: '+err.message)})\n  .then(function(){busy(false)});\n}\nfunction quick(what){\n  run('It is '+month+'.'+regionClause()+' List '+what+', as short bullet lines, each with a one-line tip. No preamble.',\n      month+' · '+what.charAt(0).toUpperCase()+what.slice(1));\n}\nfunction ask(){\n  var q=el('q').value.trim();if(!q)return;\n  run('It is '+month+'.'+regionClause()+' Gardening question: '+q+' Answer concisely for a home gardener.', q);\n  el('q').value='';\n}\n\nel('q').addEventListener('keydown',function(e){if(e.key==='Enter')ask()});\nstore.getItem('region').then(function(v){if(v)el('region').value=v});\nif(!window.myllmAsk)setStatus('Heads-up: this app needs the latest MyLLM with apps-AI enabled.');\n</script></body></html>\n", "kind": "html", "iconSymbol": "camera.macro", "iconColor": "mint"}