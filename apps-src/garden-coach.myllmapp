{"name": "Garden Coach", "html": "<!doctype html>\n<!--\n  Garden Coach — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>:root{--build-id:\"ff0ade068b\";color-scheme:light dark;--accent:#34c759}\n*{box-sizing:border-box}\nbody{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:18px;background:#f2f2f7;color:#111}\n@media(prefers-color-scheme:dark){body{background:#000;color:#eee}input,.answer{background:#1c1c1e;color:#eee;border-color:#3a3a3c}.chip{background:#1c1c1e;color:#eee}}\nh1{font-size:22px;margin:0 0 4px}\n.sub{font-size:13px;opacity:.6;margin-bottom:14px}\ninput{width:100%;padding:11px;border:1px solid #d1d1d6;border-radius:10px;font-size:15px;background:#fff;font-family:inherit;margin-bottom:8px}\n.chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px}\n.chip{border:0;background:#e8f7ee;color:#1a8a44;border-radius:18px;padding:9px 13px;font-size:14px;font-weight:600}\n@media(prefers-color-scheme:dark){.chip{background:#13351f;color:#5fd98a}}\n.ask{display:flex;gap:8px}\n.ask input{flex:1;margin-bottom:0}\n.ask button{border:0;background:var(--accent);color:#fff;border-radius:10px;padding:0 16px;font-size:15px;font-weight:600}\nbutton:disabled{opacity:.5}\n#status{font-size:13px;opacity:.7;min-height:16px;margin:10px 0}\n.answer{background:#fff;border-radius:13px;padding:14px 16px;margin-top:6px;font-size:15px;line-height:1.55;white-space:pre-wrap;box-shadow:0 1px 3px rgba(0,0,0,.08);display:none}\n.answer .q{font-weight:700;color:var(--accent);margin-bottom:6px}\n.season{font-size:12px;opacity:.55;margin-bottom:12px}\n</style></head><body>\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-family:-apple-system,system-ui,sans-serif;font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;line-height:1;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n@media(min-width:768px){body{max-width:760px;margin-left:auto;margin-right:auto}}\n</style>\n<script>\n(function(){\n  if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;\n  window.__myllmAiWrap=true;\n  var orig=window.myllmAsk,depth=0,node=null;\n  function ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\n    node.innerHTML='<span class=\"myllm-ai-cog\">\\u2699\\uFE0F</span><span>AI is thinking\\u2026 <small>privately, on your device</small></span>';\n    (document.body||document.documentElement).appendChild(node);}\n  function show(){ensure();depth++;node.classList.add('on');}\n  function hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\n  window.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\n    return Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};\n})();\n</script>\n\n<h1>🌱 Garden Coach</h1>\n<div class=\"sub\">Your AI gardening helper — what to plant right now, and answers to anything.</div>\n<div class=\"season\" id=\"season\"></div>\n<input id=\"region\" placeholder=\"Your area / climate (optional, e.g. UK, mild)\">\n<div class=\"chips\">\n  <button class=\"chip\" onclick=\"quick('vegetables to sow or plant now')\">🥕 Veg to sow now</button>\n  <button class=\"chip\" onclick=\"quick('flowers to plant now')\">🌸 Flowers</button>\n  <button class=\"chip\" onclick=\"quick('herbs to grow now')\">🌿 Herbs</button>\n  <button class=\"chip\" onclick=\"quick('key gardening jobs to do this month')\">🧤 Jobs this month</button>\n</div>\n<div class=\"ask\"><input id=\"q\" placeholder=\"Ask the coach anything…\" enterkeyhint=\"send\"><button id=\"askBtn\" onclick=\"ask()\">Ask</button></div>\n<div id=\"status\"></div>\n<div class=\"answer\" id=\"answer\"></div>\n<script>\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar month=new Date().toLocaleDateString(undefined,{month:'long'});\nfunction el(i){return document.getElementById(i)}\nfunction setStatus(t){el('status').textContent=t||''}\nel('season').textContent='🗓️ Tips tuned for '+month;\n\nfunction regionClause(){var r=el('region').value.trim();return r?(' I garden in: '+r+'.'):''}\nfunction busy(b){el('askBtn').disabled=b;var c=document.querySelectorAll('.chip');for(var i=0;i<c.length;i++)c[i].disabled=b}\n\nfunction run(prompt,heading){\n  if(!window.myllmAsk){setStatus('This app needs AI — update MyLLM and enable “Allow apps to use the AI” in Settings.');return}\n  busy(true);setStatus('Asking the garden coach…');\n  store.setItem('region',el('region').value.trim());\n  myllmAsk(prompt,{system:'You are a friendly, practical gardening expert. Be concise and specific. Prefer short bulleted lists. Assume a home gardener.'})\n  .then(function(reply){\n    var a=el('answer');a.style.display='block';\n    a.innerHTML='<div class=\"q\"></div>';a.querySelector('.q').textContent=heading;\n    a.appendChild(document.createTextNode(reply.trim()));\n    setStatus('');if(window.myllmHaptic)myllmHaptic('success');\n    a.scrollIntoView({behavior:'smooth',block:'nearest'});\n  }).catch(function(err){setStatus('Coach unavailable: '+err.message)})\n  .then(function(){busy(false)});\n}\nfunction quick(what){\n  run('It is '+month+'.'+regionClause()+' List '+what+', as short bullet lines, each with a one-line tip. No preamble.',\n      month+' · '+what.charAt(0).toUpperCase()+what.slice(1));\n}\nfunction ask(){\n  var q=el('q').value.trim();if(!q)return;\n  run('It is '+month+'.'+regionClause()+' Gardening question: '+q+' Answer concisely for a home gardener.', q);\n  el('q').value='';\n}\n\nel('q').addEventListener('keydown',function(e){if(e.key==='Enter')ask()});\nstore.getItem('region').then(function(v){if(v)el('region').value=v});\nif(!window.myllmAsk)setStatus('Heads-up: this app needs the latest MyLLM with apps-AI enabled.');\n</script></body></html>\n", "kind": "html", "iconSymbol": "camera.macro", "iconColor": "mint"}