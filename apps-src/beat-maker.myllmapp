{"name": "Beat Maker", "html": "<!doctype html>\n<!--\n  Beat Maker — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Beat Maker</title>\n<style>\n:root{--build-id:\"4ce7ae74cd\";\n  color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7);--surface:var(--myllm-surface,#fff);\n  --text:var(--myllm-text,#111);--muted:var(--myllm-muted,#6b6b72);\n  --accent:var(--myllm-accent,#0b5ed7);--border:var(--myllm-border,rgba(120,120,128,.25));\n  --radius:var(--myllm-radius,14px);--font:var(--myllm-font,-apple-system,system-ui,sans-serif);\n  --cell:#dcdce2;--cell2:#cfcfd6;--h:270;\n}\n@media(prefers-color-scheme:dark){:root{--bg:var(--myllm-bg,#000);--surface:var(--myllm-surface,#1c1c1e);--text:var(--myllm-text,#eee);--muted:var(--myllm-muted,#98989f);--cell:#2c2c2e;--cell2:#3a3a3d}}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nbody{margin:0;font-family:var(--font);background:var(--bg);color:var(--text);overscroll-behavior:none;min-height:100dvh;-webkit-user-select:none;user-select:none}\nsvg.i{width:1.25em;height:1.25em;fill:currentColor;flex-shrink:0}\nbutton{font:inherit;color:inherit} button:active{transform:scale(.96)}\n.head{position:sticky;top:0;z-index:5;border-bottom:1px solid var(--border);\n  background:color-mix(in srgb,var(--bg) 82%,transparent);-webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px);\n  padding:calc(12px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) 12px calc(16px + env(safe-area-inset-left))}\n@supports not (background:color-mix(in srgb,red,blue)){.head{background:var(--bg)}}\n.bar{max-width:1000px;margin:0 auto}\n.title{display:flex;align-items:center;gap:10px;margin-bottom:12px}\n.title h1{margin:0;font-size:22px;font-weight:800;flex:1}\n.tile{width:34px;height:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:15px;flex-shrink:0;\n  background:linear-gradient(145deg,hsl(var(--h) 62% 52%),hsl(calc(var(--h) + 40) 58% 28%))}\n.full{width:42px;height:42px;border-radius:50%;border:1px solid var(--border);background:var(--surface);display:none;align-items:center;justify-content:center;font-size:15px}\n.full.can{display:flex} .full.on{background:var(--accent);border-color:var(--accent);color:#fff}\n.transport{display:flex;align-items:center;gap:14px}\n#play{width:56px;height:56px;border-radius:50%;border:0;color:#fff;font-size:21px;cursor:pointer;flex:none;display:flex;align-items:center;justify-content:center;\n  background:linear-gradient(145deg,hsl(var(--h) 70% 58%),hsl(calc(var(--h) + 30) 64% 40%));box-shadow:0 8px 22px hsl(var(--h) 70% 45% / .35)}\n#play.on{background:#ff3b30;box-shadow:0 8px 22px rgba(255,59,48,.35)}\n.bpm{flex:1;min-width:0}\n.bpm label{font-size:12px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);display:flex;justify-content:space-between}\n.bpm label span:last-child{letter-spacing:0;text-transform:none;font-size:13px;color:var(--text);font-variant-numeric:tabular-nums}\n.bpm input{width:100%;margin-top:8px;-webkit-appearance:none;appearance:none;height:6px;border-radius:3px;background:var(--cell2);outline:none}\n.bpm input::-webkit-slider-thumb{-webkit-appearance:none;width:24px;height:24px;border-radius:50%;background:#fff;border:0;box-shadow:0 2px 8px rgba(0,0,0,.3)}\n.tools{display:flex;gap:8px;margin-top:12px}\n.tools button{background:var(--surface);border:1px solid var(--border);border-radius:99px;padding:0 14px;min-height:40px;font-weight:700;font-size:13px;cursor:pointer;display:inline-flex;align-items:center;gap:6px}\n\n/* Pads take their size from the screen: two rows of eight on a phone held\n   upright, all sixteen across once there is room. */\n.grid{max-width:1000px;margin:0 auto;padding:14px calc(12px + env(safe-area-inset-right)) 8px calc(12px + env(safe-area-inset-left))}\n.track{display:flex;align-items:center;gap:8px;margin-bottom:10px}\n.tt{flex:none;width:44px;display:flex;flex-direction:column;align-items:center;gap:3px}\n.tt .tk{width:38px;height:38px;border-radius:11px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:17px;\n  background:linear-gradient(145deg,hsl(var(--th) 66% 52%),hsl(calc(var(--th) + 40) 60% 28%))}\n.name{font-size:10px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}\n.steps{flex:1;min-width:0;display:grid;grid-template-columns:repeat(8,1fr);gap:5px}\n.cell{aspect-ratio:1;max-height:56px;width:100%;border-radius:22%;background:var(--cell);border:0;padding:0;cursor:pointer;transition:transform .05s,box-shadow .12s,filter .12s}\n.cell.alt{background:var(--cell2)}\n.cell.on{background:linear-gradient(145deg,hsl(var(--th) 82% 62%),hsl(var(--th) 74% 46%));box-shadow:0 3px 10px hsl(var(--th) 80% 45% / .4)}\n.cell.play{box-shadow:inset 0 0 0 2px var(--text)}\n.cell.on.play{filter:brightness(1.35);box-shadow:0 0 0 2px var(--text),0 0 16px hsl(var(--th) 90% 60% / .8)}\n.cell:active{transform:scale(.88)}\n.hint{color:var(--muted);font-size:13px;text-align:center;padding:4px 16px calc(24px + env(safe-area-inset-bottom))}\n@media (min-width:640px){\n  .steps{grid-template-columns:repeat(16,1fr)} .cell{max-height:none}\n  .head .bar{display:flex;align-items:center;gap:16px;flex-wrap:wrap} .title{margin:0;flex:0 0 auto} .title h1{flex:none}\n  .transport{flex:1 1 260px} .tools{margin-top:0} .full{order:9}\n}\n@media (min-width:640px) and (max-height:520px){                 /* phone on its side: every pad on one screen */\n  .head{padding-top:calc(6px + env(safe-area-inset-top));padding-bottom:6px} .head .bar{flex-wrap:nowrap;gap:12px} #play{width:42px;height:42px;font-size:17px}\n  .title h1{font-size:18px} .tile{width:28px;height:28px;font-size:13px} .transport{flex:1 1 160px} .tools button{min-height:34px;padding:0 10px;font-size:12px}\n  .grid{padding-top:8px} .track{margin-bottom:5px} .tt{flex-direction:row;width:74px;gap:6px} .tt .tk{width:30px;height:30px;font-size:14px;border-radius:9px}\n  .cell{aspect-ratio:auto;height:calc((100dvh - 78px - env(safe-area-inset-top) - env(safe-area-inset-bottom)) / 6 - 5px);max-height:48px;border-radius:9px} .hint{display:none}\n}\n@media (prefers-reduced-motion:reduce){.cell{transition:none}}\n</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-play\" viewBox=\"0 0 24 24\"><path d=\"M8 5.5v13a1 1 0 0 0 1.52.85l10.4-6.5a1 1 0 0 0 0-1.7L9.52 4.65A1 1 0 0 0 8 5.5z\"/></symbol>\n  <symbol id=\"i-stop\" viewBox=\"0 0 24 24\"><rect x=\"6\" y=\"6\" width=\"12\" height=\"12\" rx=\"2.6\"/></symbol>\n  <symbol id=\"i-note\" viewBox=\"0 0 24 24\"><path d=\"M19.4 3.2 9.6 5.4A1.5 1.5 0 0 0 8.4 6.9v8.3a3.4 3.4 0 1 0 2 3.1V9.6l7.6-1.7v5.3a3.4 3.4 0 1 0 2 3.1V4.2a1 1 0 0 0-.6-1z\"/></symbol>\n  <symbol id=\"i-expand\" viewBox=\"0 0 24 24\"><path d=\"M5 4a1 1 0 0 0-1 1v4.5a1 1 0 0 0 2 0V7.4l3.3 3.3a1 1 0 0 0 1.4-1.4L7.4 6h2.1a1 1 0 0 0 0-2zm9.5 0a1 1 0 0 0 0 2h2.1l-3.3 3.3a1 1 0 0 0 1.4 1.4L18 7.4v2.1a1 1 0 0 0 2 0V5a1 1 0 0 0-1-1zM9.3 13.3 6 16.6v-2.1a1 1 0 0 0-2 0V19a1 1 0 0 0 1 1h4.5a1 1 0 0 0 0-2H7.4l3.3-3.3a1 1 0 0 0-1.4-1.4zm5.4 0a1 1 0 0 0-1.4 1.4l3.3 3.3h-2.1a1 1 0 0 0 0 2H19a1 1 0 0 0 1-1v-4.5a1 1 0 0 0-2 0v2.1z\"/></symbol>\n  <symbol id=\"i-collapse\" viewBox=\"0 0 24 24\"><path d=\"M9.5 4a1 1 0 0 0-1 1v2.1L5.2 3.8a1 1 0 0 0-1.4 1.4l3.3 3.3H5a1 1 0 0 0 0 2h4.5a1 1 0 0 0 1-1V5a1 1 0 0 0-1-1zm5 0a1 1 0 0 0-1 1v4.5a1 1 0 0 0 1 1H19a1 1 0 0 0 0-2h-2.1l3.3-3.3a1 1 0 0 0-1.4-1.4l-3.3 3.3V5a1 1 0 0 0-1-1zM5 13.5a1 1 0 0 0 0 2h2.100l-3.3 3.3a1 1 0 0 0 1.4 1.4l3.3-3.3V19a1 1 0 0 0 2 0v-4.5a1 1 0 0 0-1-1zm9.5 0a1 1 0 0 0-1 1V19a1 1 0 0 0 2 0v-2.100l3.3 3.3a1 1 0 0 0 1.4-1.4l-3.3-3.3H19a1 1 0 0 0 0-2z\"/></symbol>\n  <symbol id=\"i-trash\" viewBox=\"0 0 24 24\"><path d=\"M10 3a1 1 0 0 0-1 1v1H5a1 1 0 0 0 0 2h.6l.9 11.700A2.500 2.500 0 0 0 9 21h6a2.500 2.500 0 0 0 2.500-2.300L18.400 7H19a1 1 0 0 0 0-2h-4V4a1 1 0 0 0-1-1zM7.600 7h8.800l-.9 11.500a.5.5 0 0 1-.5.5H9a.5.5 0 0 1-.5-.5z\"/></symbol>\n  <symbol id=\"i-dice\" viewBox=\"0 0 24 24\"><path d=\"M7 3a4 4 0 0 0-4 4v10a4 4 0 0 0 4 4h10a4 4 0 0 0 4-4V7a4 4 0 0 0-4-4zm0 2h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2zm1.500 2a1.500 1.500 0 1 0 0 3 1.500 1.500 0 0 0 0-3zm7 0a1.500 1.500 0 1 0 0 3 1.500 1.500 0 0 0 0-3zM12 10.500a1.500 1.500 0 1 0 0 3 1.500 1.500 0 0 0 0-3zM8.500 14a1.500 1.500 0 1 0 0 3 1.500 1.500 0 0 0 0-3zm7 0a1.500 1.500 0 1 0 0 3 1.500 1.500 0 0 0 0-3z\"/></symbol>\n  <symbol id=\"i-spark\" viewBox=\"0 0 24 24\"><path d=\"M12 2.500a1 1 0 0 0-.95.700L9.300 8.300a1.500 1.500 0 0 1-1 1L3.200 11.050a1 1 0 0 0 0 1.900L8.300 14.700a1.500 1.500 0 0 1 1 1l1.750 5.100a1 1 0 0 0 1.900 0l1.750-5.100a1.500 1.500 0 0 1 1-1l5.100-1.750a1 1 0 0 0 0-1.900L15.700 9.300a1.500 1.500 0 0 1-1-1L12.950 3.200a1 1 0 0 0-.95-.700z\"/></symbol>\n  <symbol id=\"k-kick\" viewBox=\"0 0 24 24\"><path d=\"M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zm0 2a7 7 0 1 1 0 14 7 7 0 0 1 0-14zm0 3.500a3.500 3.500 0 1 0 0 7 3.500 3.500 0 0 0 0-7z\"/></symbol>\n  <symbol id=\"k-snare\" viewBox=\"0 0 24 24\"><path d=\"M12 5C7 5 3 6.600 3 8.800v6.400C3 17.400 7 19 12 19s9-1.600 9-3.800V8.800C21 6.600 17 5 12 5zm0 2c4.300 0 7 1.200 7 1.800s-2.700 1.800-7 1.800-7-1.200-7-1.800S7.700 7 12 7zm-7 4.500c.6.300 1.300.5 2 .700v3.900c-1.300-.4-2-.900-2-1.300zm4 1.100c.950.150 1.950.2 3 .2s2.050-.050 3-.2v3.900c-.9.150-1.900.2-3 .2s-2.100-.050-3-.2zm10-1.100v3.700c0 .4-.7.900-2 1.300v-3.900c.7-.2 1.400-.4 2-.700z\"/></symbol>\n  <symbol id=\"k-hat\" viewBox=\"0 0 24 24\"><path d=\"M12 8c-4.600 0-9 1-9 2.500 0 .9 1.600 1.600 4 2.050V13c-2.400.45-4 1.150-4 2.050C3 16.500 7.400 17.500 12 17.500s9-1 9-2.450c0-.9-1.600-1.600-4-2.050v-.45c2.400-.45 4-1.150 4-2.050C21 9 16.600 8 12 8zm-1 5h2v6a1 1 0 0 1-2 0z\"/><rect x=\"11\" y=\"3\" width=\"2\" height=\"6\" rx=\"1\"/></symbol>\n  <symbol id=\"k-open\" viewBox=\"0 0 24 24\"><path d=\"M12 4.500c-4.600 0-9 1-9 2.500s4.400 2.500 9 2.500 9-1 9-2.500-4.400-2.500-9-2.500zm0 9c-4.600 0-9 1-9 2.500s4.400 2.500 9 2.500 9-1 9-2.500-4.400-2.500-9-2.500z\"/><rect x=\"11\" y=\"9\" width=\"2\" height=\"12\" rx=\"1\"/></symbol>\n  <symbol id=\"k-clap\" viewBox=\"0 0 24 24\"><path d=\"M9.200 3.300a1 1 0 0 0-1.900.6l.7 2.200a1 1 0 0 0 1.900-.6zm5.600 0-.7 2.200a1 1 0 0 0 1.900.6l.7-2.200a1 1 0 0 0-1.900-.6zM12 2a1 1 0 0 0-1 1v2.300a1 1 0 0 0 2 0V3a1 1 0 0 0-1-1zm-1.800 6.200a1.600 1.600 0 0 0-2.300 0l-2.400 2.500a5.600 5.600 0 0 0 0 7.800 5.300 5.300 0 0 0 7.600 0l4.700-4.800a1.500 1.500 0 0 0-2.100-2.100l-1.900 1.900 2.900-3a1.500 1.500 0 0 0-2.100-2.100l-3 3 1.900-2a1.500 1.500 0 0 0-2.100-2.100l-3.800 3.900z\"/></symbol>\n  <symbol id=\"k-tom\" viewBox=\"0 0 24 24\"><path d=\"M12 4C7.600 4 4 5.500 4 7.500v8C4 17.500 7.600 19 12 19s8-1.500 8-3.500v-8C20 5.500 16.400 4 12 4zm0 2c3.700 0 6 1.100 6 1.500S15.700 9 12 9 6 7.900 6 7.500 8.300 6 12 6zm-6 4.100C7.500 10.700 9.600 11 12 11s4.500-.3 6-.900v5.400c0 .4-2.300 1.500-6 1.500s-6-1.100-6-1.500z\"/></symbol>\n</defs></svg>\n<div class=\"head\"><div class=\"bar\">\n  <div class=\"title\">\n    <span class=\"tile\"><svg class=\"i\"><use href=\"#i-note\"/></svg></span>\n    <h1>Beat Maker</h1>\n    <button class=\"full\" id=\"full\" aria-label=\"Full screen\"><svg class=\"i\"><use href=\"#i-expand\"/></svg></button>\n  </div>\n  <div class=\"transport\">\n    <button id=\"play\" aria-label=\"Play\"><svg class=\"i\"><use href=\"#i-play\"/></svg></button>\n    <div class=\"bpm\"><label><span>Tempo</span><span id=\"bpmv\">110 BPM</span></label><input type=\"range\" id=\"bpm\" min=\"60\" max=\"180\" value=\"110\"></div>\n  </div>\n  <div class=\"tools\">\n    <button id=\"clear\"><svg class=\"i\"><use href=\"#i-trash\"/></svg>Clear</button>\n    <button id=\"rand\"><svg class=\"i\"><use href=\"#i-dice\"/></svg>Random</button>\n    <button id=\"demo\"><svg class=\"i\"><use href=\"#i-spark\"/></svg>Demo beat</button>\n  </div>\n</div></div>\n<div class=\"grid\" id=\"grid\"></div>\n<div class=\"hint\">Tap the pads to make a beat. It saves automatically.</div>\n<script>\nvar STEPS=16;\nvar KITS=[\n  {name:\"Kick\", make:kick,   hue:270,icon:\"k-kick\"},\n  {name:\"Snare\",make:snare,  hue:332,icon:\"k-snare\"},\n  {name:\"Hat\",  make:hat,    hue:44, icon:\"k-hat\"},\n  {name:\"Open\", make:openhat,hue:22, icon:\"k-open\"},\n  {name:\"Clap\", make:clap,   hue:190,icon:\"k-clap\"},\n  {name:\"Tom\",  make:tom,    hue:150,icon:\"k-tom\"}\n];\nvar pattern=KITS.map(function(){return new Array(STEPS).fill(false)});\nvar bpm=110,playing=false,curStep=0,nextTime=0,timer=null,actx=null,noiseBuf=null;\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\n\nfunction ac(){\n  if(!actx){actx=new (window.AudioContext||window.webkitAudioContext)();\n    var len=actx.sampleRate*0.5,b=actx.createBuffer(1,len,actx.sampleRate),d=b.getChannelData(0);\n    for(var i=0;i<len;i++)d[i]=Math.random()*2-1;noiseBuf=b;}\n  return actx;\n}\nfunction noise(){var s=ac().createBufferSource();s.buffer=noiseBuf;return s}\nfunction env(g,t,a,dcy,peak){g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(peak,t+a);g.gain.exponentialRampToValueAtTime(0.0001,t+a+dcy)}\n\nfunction kick(t){var c=ac(),o=c.createOscillator(),g=c.createGain();o.frequency.setValueAtTime(150,t);o.frequency.exponentialRampToValueAtTime(45,t+0.13);env(g,t,0.001,0.32,1);o.connect(g).connect(c.destination);o.start(t);o.stop(t+0.36)}\nfunction snare(t){var c=ac(),n=noise(),nf=c.createBiquadFilter(),ng=c.createGain();nf.type='highpass';nf.frequency.value=1500;env(ng,t,0.001,0.18,0.7);n.connect(nf).connect(ng).connect(c.destination);n.start(t);n.stop(t+0.2);var o=c.createOscillator(),g=c.createGain();o.type='triangle';o.frequency.setValueAtTime(180,t);env(g,t,0.001,0.12,0.4);o.connect(g).connect(c.destination);o.start(t);o.stop(t+0.14)}\nfunction hat(t){var c=ac(),n=noise(),f=c.createBiquadFilter(),g=c.createGain();f.type='highpass';f.frequency.value=8000;env(g,t,0.001,0.04,0.4);n.connect(f).connect(g).connect(c.destination);n.start(t);n.stop(t+0.06)}\nfunction openhat(t){var c=ac(),n=noise(),f=c.createBiquadFilter(),g=c.createGain();f.type='highpass';f.frequency.value=7000;env(g,t,0.001,0.3,0.35);n.connect(f).connect(g).connect(c.destination);n.start(t);n.stop(t+0.34)}\nfunction clap(t){var c=ac();for(var k=0;k<3;k++){var n=noise(),f=c.createBiquadFilter(),g=c.createGain();f.type='bandpass';f.frequency.value=1200;env(g,t+k*0.012,0.001,0.12,0.5);n.connect(f).connect(g).connect(c.destination);n.start(t+k*0.012);n.stop(t+k*0.012+0.13)}}\nfunction tom(t){var c=ac(),o=c.createOscillator(),g=c.createGain();o.type='sine';o.frequency.setValueAtTime(220,t);o.frequency.exponentialRampToValueAtTime(90,t+0.2);env(g,t,0.001,0.28,0.8);o.connect(g).connect(c.destination);o.start(t);o.stop(t+0.32)}\n\nfunction stepTime(){return 60/bpm/4}\nfunction schedule(){\n  var c=ac();\n  while(nextTime<c.currentTime+0.12){\n    var s=curStep;\n    KITS.forEach(function(k,r){if(pattern[r][s])k.make(nextTime)});\n    var when=nextTime,drawStep=s;\n    requestAnimationFrame(function fr(){if(c.currentTime>=when){highlight(drawStep)}else if(playing)requestAnimationFrame(fr)});\n    nextTime+=stepTime();curStep=(curStep+1)%STEPS;\n  }\n}\nfunction highlight(s){\n  document.querySelectorAll('.cell.play').forEach(function(e){e.classList.remove('play')});\n  for(var r=0;r<KITS.length;r++){var el=document.getElementById('c'+r+'_'+s);if(el)el.classList.add('play')}\n}\nfunction start(){\n  ac().resume();playing=true;playLook();\n  curStep=0;nextTime=ac().currentTime+0.05;timer=setInterval(schedule,25);haptic('medium');\n}\nfunction stop(){\n  playing=false;playLook();clearInterval(timer);timer=null;\n  document.querySelectorAll('.cell.play').forEach(function(e){e.classList.remove('play')});\n}\ndocument.getElementById('play').onclick=function(){playing?stop():start()};\ndocument.getElementById('bpm').oninput=function(){bpm=+this.value;document.getElementById('bpmv').value=bpm+' BPM';document.getElementById('bpmv').textContent=bpm+' BPM'};\ndocument.getElementById('bpm').onchange=save;\ndocument.getElementById('clear').onclick=function(){pattern=KITS.map(function(){return new Array(STEPS).fill(false)});render();save();haptic('warning')};\ndocument.getElementById('rand').onclick=function(){pattern=KITS.map(function(r,i){return Array.from({length:STEPS},function(){return Math.random()<(i===0?0.28:i===2?0.4:0.18)})});render();save();haptic('light')};\ndocument.getElementById('demo').onclick=function(){loadDemo();render();save();haptic('success')};\n\nfunction loadDemo(){\n  pattern=KITS.map(function(){return new Array(STEPS).fill(false)});\n  [0,8].forEach(function(i){pattern[0][i]=true}); // kick\n  pattern[0][10]=true;\n  [4,12].forEach(function(i){pattern[1][i]=true}); // snare\n  for(var i=0;i<16;i+=2)pattern[2][i]=true; // hats\n  pattern[3][14]=true; // open\n}\n\nfunction render(){\n  var g=document.getElementById('grid');g.innerHTML='';\n  KITS.forEach(function(k,r){\n    var t=document.createElement('div');t.className='track';t.style.setProperty('--th',k.hue);\n    var n=document.createElement('div');n.className='tt';\n    n.innerHTML='<span class=\"tk\"><svg class=\"i\"><use href=\"#'+k.icon+'\"/></svg></span><span class=\"name\">'+k.name+'</span>';t.appendChild(n);\n    var s=document.createElement('div');s.className='steps';\n    for(var i=0;i<STEPS;i++){\n      var b=document.createElement('button');\n      b.className='cell'+(pattern[r][i]?' on':'')+(Math.floor(i/4)%2?' alt':'');\n      b.setAttribute('aria-label',k.name+' step '+(i+1));\n      b.id='c'+r+'_'+i;\n      (function(rr,ii,btn){btn.onclick=function(){\n        pattern[rr][ii]=!pattern[rr][ii];btn.classList.toggle('on');haptic('selection');save();\n        if(pattern[rr][ii]&&!playing)KITS[rr].make(ac().currentTime+0.01);\n      }})(r,i,b);\n      s.appendChild(b);\n    }\n    t.appendChild(s);g.appendChild(t);\n  });\n}\nfunction save(){if(window.myllmStorage)myllmStorage.setItem('beat',JSON.stringify({pattern:pattern,bpm:bpm}))}\nfunction load(){\n  if(!window.myllmStorage){loadDemo();render();return}\n  myllmStorage.getItem('beat').then(function(v){\n    if(v){try{var d=JSON.parse(v);if(d.pattern)pattern=d.pattern;if(d.bpm){bpm=d.bpm;document.getElementById('bpm').value=bpm;document.getElementById('bpmv').textContent=bpm+' BPM'}}catch(e){}}\n    else loadDemo();\n    render();\n  });\n}\nload();\n\n/* ---------- surface only: the play button's look, full screen, staying awake ----------\n   The play button and the scheduler above are untouched; this only reflects `playing`. */\nvar fullOn=false,wakeLock=null;\nfunction playLook(){\n  var b=document.getElementById('play');\n  b.innerHTML='<svg class=\"i\"><use href=\"#'+(playing?'i-stop':'i-play')+'\"/></svg>';\n  b.className=playing?'on':'';b.setAttribute('aria-label',playing?'Stop':'Play');\n  syncChrome();\n  /* the pattern stops with the screen, so hold it awake while it plays */\n  if(playing){if('wakeLock' in navigator&&!wakeLock)navigator.wakeLock.request('screen').then(function(l){wakeLock=l}).catch(function(){wakeLock=null})}\n  else if(wakeLock){try{wakeLock.release()}catch(e){}wakeLock=null}\n}\n/* Full screen hides MyLLM's own bars for more pad room. The bridge is looked up\n   on each use, never kept: MyLLM can add it after this script has run. */\nvar chromeAsked=false;\nfunction syncChrome(){\n  if(!window.myllmImmersive)return;\n  if(!fullOn&&!chromeAsked)return;       /* never speak to the bars until full screen has been asked for */\n  chromeAsked=true;\n  try{myllmImmersive(fullOn,{keepAwake:fullOn&&playing}).catch(function(){})}catch(e){}\n}\nfunction fullLook(){\n  var b=document.getElementById('full');\n  b.classList.toggle('can',!!window.myllmImmersive);b.classList.toggle('on',fullOn);\n  b.innerHTML='<svg class=\"i\"><use href=\"#'+(fullOn?'i-collapse':'i-expand')+'\"/></svg>';\n  b.setAttribute('aria-label',fullOn?'Leave full screen':'Full screen');\n}\ndocument.getElementById('full').onclick=function(){if(!window.myllmImmersive)return;fullOn=!fullOn;haptic('light');fullLook();syncChrome()};\ndocument.addEventListener('visibilitychange',function(){\n  if(document.hidden){if(wakeLock){try{wakeLock.release()}catch(e){}wakeLock=null}return}\n  if(fullOn)syncChrome();          /* MyLLM puts its bars back when the app is left */\n  if(playing)playLook();\n});\nfullLook();setTimeout(fullLook,600);setTimeout(fullLook,2500);\n</script>\n</body>\n</html>\n", "kind": "html", "iconSymbol": "music.note", "iconColor": "purple"}