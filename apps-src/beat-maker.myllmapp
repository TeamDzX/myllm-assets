{"name": "Beat Maker", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Beat Maker</title>\n<style>\n:root{\n  color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7);--surface:var(--myllm-surface,#fff);\n  --text:var(--myllm-text,#111);--muted:var(--myllm-muted,#6b6b72);\n  --accent:var(--myllm-accent,#0b5ed7);--border:var(--myllm-border,rgba(120,120,128,.25));\n  --radius:var(--myllm-radius,14px);--font:var(--myllm-font,-apple-system,system-ui,sans-serif);\n  --cell:#d8d8de;\n}\n@media(prefers-color-scheme:dark){:root{--bg:var(--myllm-bg,#000);--surface:var(--myllm-surface,#1c1c1e);--text:var(--myllm-text,#eee);--muted:var(--myllm-muted,#98989f);--cell:#3a3a3c}}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nbody{margin:0;font-family:var(--font);background:var(--bg);color:var(--text);overscroll-behavior:none}\n.head{position:sticky;top:0;background:var(--bg);padding:12px 16px;border-bottom:1px solid var(--border);z-index:5}\n.head h1{margin:0 0 10px;font-size:20px;font-weight:700}\n.transport{display:flex;align-items:center;gap:12px}\n#play{width:54px;height:54px;border-radius:50%;border:0;background:var(--accent);color:#fff;font-size:22px;cursor:pointer;flex:none}\n.bpm{flex:1}\n.bpm label{font-size:12px;font-weight:600;color:var(--muted);display:flex;justify-content:space-between}\n.bpm input{width:100%;accent-color:var(--accent)}\n.tools{display:flex;gap:8px}\n.tools button{border:0;background:var(--surface);border:1px solid var(--border);color:var(--text);border-radius:9px;padding:9px 12px;font:inherit;font-weight:600;font-size:13px;cursor:pointer}\n.grid{padding:12px 10px 30px;overflow-x:auto}\n.track{display:flex;align-items:center;gap:6px;margin-bottom:7px}\n.name{flex:none;width:62px;font-size:12px;font-weight:700;color:var(--muted);text-align:right;padding-right:4px}\n.steps{display:flex;gap:4px}\n.cell{width:30px;height:30px;border-radius:7px;background:var(--cell);border:0;cursor:pointer;flex:none;transition:transform .05s}\n.cell.g{margin-left:8px}\n.cell.on{background:var(--accent)}\n.cell.play{outline:2px solid var(--text);outline-offset:1px}\n.cell:active{transform:scale(.88)}\n.hint{color:var(--muted);font-size:13px;text-align:center;padding:6px 16px 0}\n</style>\n</head>\n<body>\n<div class=\"head\">\n  <h1>🥁 Beat Maker</h1>\n  <div class=\"transport\">\n    <button id=\"play\">▶</button>\n    <div class=\"bpm\"><label><span>Tempo</span><span id=\"bpmv\">110 BPM</span></label><input type=\"range\" id=\"bpm\" min=\"60\" max=\"180\" value=\"110\"></div>\n  </div>\n  <div class=\"tools\" style=\"margin-top:10px\">\n    <button id=\"clear\">Clear</button>\n    <button id=\"rand\">Random</button>\n    <button id=\"demo\">Demo beat</button>\n  </div>\n</div>\n<div class=\"grid\" id=\"grid\"></div>\n<div class=\"hint\">Tap the squares to make a beat. It saves automatically.</div>\n<script>\nvar STEPS=16;\nvar KITS=[\n  {name:\"Kick\", make:kick},\n  {name:\"Snare\",make:snare},\n  {name:\"Hat\",  make:hat},\n  {name:\"Open\", make:openhat},\n  {name:\"Clap\", make:clap},\n  {name:\"Tom\",  make:tom}\n];\nvar pattern=KITS.map(function(){return new Array(STEPS).fill(false)});\nvar bpm=110,playing=false,curStep=0,nextTime=0,timer=null,actx=null,noiseBuf=null;\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\n\nfunction ac(){\n  if(!actx){actx=new (window.AudioContext||window.webkitAudioContext)();\n    var len=actx.sampleRate*0.5,b=actx.createBuffer(1,len,actx.sampleRate),d=b.getChannelData(0);\n    for(var i=0;i<len;i++)d[i]=Math.random()*2-1;noiseBuf=b;}\n  return actx;\n}\nfunction noise(){var s=ac().createBufferSource();s.buffer=noiseBuf;return s}\nfunction env(g,t,a,dcy,peak){g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(peak,t+a);g.gain.exponentialRampToValueAtTime(0.0001,t+a+dcy)}\n\nfunction kick(t){var c=ac(),o=c.createOscillator(),g=c.createGain();o.frequency.setValueAtTime(150,t);o.frequency.exponentialRampToValueAtTime(45,t+0.13);env(g,t,0.001,0.32,1);o.connect(g).connect(c.destination);o.start(t);o.stop(t+0.36)}\nfunction snare(t){var c=ac(),n=noise(),nf=c.createBiquadFilter(),ng=c.createGain();nf.type='highpass';nf.frequency.value=1500;env(ng,t,0.001,0.18,0.7);n.connect(nf).connect(ng).connect(c.destination);n.start(t);n.stop(t+0.2);var o=c.createOscillator(),g=c.createGain();o.type='triangle';o.frequency.setValueAtTime(180,t);env(g,t,0.001,0.12,0.4);o.connect(g).connect(c.destination);o.start(t);o.stop(t+0.14)}\nfunction hat(t){var c=ac(),n=noise(),f=c.createBiquadFilter(),g=c.createGain();f.type='highpass';f.frequency.value=8000;env(g,t,0.001,0.04,0.4);n.connect(f).connect(g).connect(c.destination);n.start(t);n.stop(t+0.06)}\nfunction openhat(t){var c=ac(),n=noise(),f=c.createBiquadFilter(),g=c.createGain();f.type='highpass';f.frequency.value=7000;env(g,t,0.001,0.3,0.35);n.connect(f).connect(g).connect(c.destination);n.start(t);n.stop(t+0.34)}\nfunction clap(t){var c=ac();for(var k=0;k<3;k++){var n=noise(),f=c.createBiquadFilter(),g=c.createGain();f.type='bandpass';f.frequency.value=1200;env(g,t+k*0.012,0.001,0.12,0.5);n.connect(f).connect(g).connect(c.destination);n.start(t+k*0.012);n.stop(t+k*0.012+0.13)}}\nfunction tom(t){var c=ac(),o=c.createOscillator(),g=c.createGain();o.type='sine';o.frequency.setValueAtTime(220,t);o.frequency.exponentialRampToValueAtTime(90,t+0.2);env(g,t,0.001,0.28,0.8);o.connect(g).connect(c.destination);o.start(t);o.stop(t+0.32)}\n\nfunction stepTime(){return 60/bpm/4}\nfunction schedule(){\n  var c=ac();\n  while(nextTime<c.currentTime+0.12){\n    var s=curStep;\n    KITS.forEach(function(k,r){if(pattern[r][s])k.make(nextTime)});\n    var when=nextTime,drawStep=s;\n    requestAnimationFrame(function fr(){if(c.currentTime>=when){highlight(drawStep)}else if(playing)requestAnimationFrame(fr)});\n    nextTime+=stepTime();curStep=(curStep+1)%STEPS;\n  }\n}\nfunction highlight(s){\n  document.querySelectorAll('.cell.play').forEach(function(e){e.classList.remove('play')});\n  for(var r=0;r<KITS.length;r++){var el=document.getElementById('c'+r+'_'+s);if(el)el.classList.add('play')}\n}\nfunction start(){\n  ac().resume();playing=true;document.getElementById('play').textContent='■';\n  curStep=0;nextTime=ac().currentTime+0.05;timer=setInterval(schedule,25);haptic('medium');\n}\nfunction stop(){\n  playing=false;document.getElementById('play').textContent='▶';clearInterval(timer);timer=null;\n  document.querySelectorAll('.cell.play').forEach(function(e){e.classList.remove('play')});\n}\ndocument.getElementById('play').onclick=function(){playing?stop():start()};\ndocument.getElementById('bpm').oninput=function(){bpm=+this.value;document.getElementById('bpmv').value=bpm+' BPM';document.getElementById('bpmv').textContent=bpm+' BPM'};\ndocument.getElementById('bpm').onchange=save;\ndocument.getElementById('clear').onclick=function(){pattern=KITS.map(function(){return new Array(STEPS).fill(false)});render();save();haptic('warning')};\ndocument.getElementById('rand').onclick=function(){pattern=KITS.map(function(r,i){return Array.from({length:STEPS},function(){return Math.random()<(i===0?0.28:i===2?0.4:0.18)})});render();save();haptic('light')};\ndocument.getElementById('demo').onclick=function(){loadDemo();render();save();haptic('success')};\n\nfunction loadDemo(){\n  pattern=KITS.map(function(){return new Array(STEPS).fill(false)});\n  [0,8].forEach(function(i){pattern[0][i]=true}); // kick\n  pattern[0][10]=true;\n  [4,12].forEach(function(i){pattern[1][i]=true}); // snare\n  for(var i=0;i<16;i+=2)pattern[2][i]=true; // hats\n  pattern[3][14]=true; // open\n}\n\nfunction render(){\n  var g=document.getElementById('grid');g.innerHTML='';\n  KITS.forEach(function(k,r){\n    var t=document.createElement('div');t.className='track';\n    var n=document.createElement('div');n.className='name';n.textContent=k.name;t.appendChild(n);\n    var s=document.createElement('div');s.className='steps';\n    for(var i=0;i<STEPS;i++){\n      var b=document.createElement('button');\n      b.className='cell'+(pattern[r][i]?' on':'')+((i%4===0&&i>0)?' g':'');\n      b.id='c'+r+'_'+i;\n      (function(rr,ii,btn){btn.onclick=function(){\n        pattern[rr][ii]=!pattern[rr][ii];btn.classList.toggle('on');haptic('selection');save();\n        if(pattern[rr][ii]&&!playing)KITS[rr].make(ac().currentTime+0.01);\n      }})(r,i,b);\n      s.appendChild(b);\n    }\n    t.appendChild(s);g.appendChild(t);\n  });\n}\nfunction save(){if(window.myllmStorage)myllmStorage.setItem('beat',JSON.stringify({pattern:pattern,bpm:bpm}))}\nfunction load(){\n  if(!window.myllmStorage){loadDemo();render();return}\n  myllmStorage.getItem('beat').then(function(v){\n    if(v){try{var d=JSON.parse(v);if(d.pattern)pattern=d.pattern;if(d.bpm){bpm=d.bpm;document.getElementById('bpm').value=bpm;document.getElementById('bpmv').textContent=bpm+' BPM'}}catch(e){}}\n    else loadDemo();\n    render();\n  });\n}\nload();\n</script>\n</body>\n</html>\n", "kind": "html", "iconSymbol": "music.note", "iconColor": "purple"}