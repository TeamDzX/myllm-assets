{"name": "Kitchen Converter", "html": "<!doctype html>\n<!--\n  Kitchen Converter — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Kitchen Converter</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"2cd3661e91\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); --h:180; }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:760px; } .cols{ display:grid; grid-template-columns:1fr 1fr; gap:12px; align-items:start; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.96); }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 42%), hsl(calc(var(--h) + 40) 58% 26%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:4px 2px 10px; }\n\n  .hero{ border-radius:20px; padding:16px 18px; color:#fff; margin-bottom:12px;\n    background:linear-gradient(145deg, hsl(var(--h) 58% 36%), hsl(calc(var(--h) + 40) 58% 22%)); box-shadow:0 10px 28px hsl(var(--h) 60% 22% / .25); }\n  .hero .big{ font-size:44px; font-weight:800; line-height:1.05; letter-spacing:-.03em; font-variant-numeric:tabular-nums; overflow-wrap:anywhere; }\n  .hero .big small{ font-size:22px; font-weight:750; opacity:.85; margin-left:4px; letter-spacing:0; }\n  .hero .sub{ font-size:13.5px; opacity:.85; margin-top:4px; font-variant-numeric:tabular-nums; }\n  .hero .hint{ font-size:12px; opacity:.72; margin-top:8px; line-height:1.4; }\n  .hero .hint:empty{ display:none; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  label{ display:block; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:0 2px 7px; }\n  .two{ display:flex; gap:10px; } .two>div{ flex:1; min-width:0; }\n  .gap{ margin-top:12px; }\n  input,select{ width:100%; font:inherit; font-size:16px; padding:11px 12px; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; min-height:46px; }\n  select{ -webkit-appearance:none; appearance:none; padding-right:30px;\n    background-image:linear-gradient(45deg,transparent 50%,var(--muted) 50%),linear-gradient(135deg,var(--muted) 50%,transparent 50%);\n    background-position:calc(100% - 17px) 50%,calc(100% - 12px) 50%; background-size:5px 5px,5px 5px; background-repeat:no-repeat; }\n  input:focus,select:focus{ border-color:var(--acc); }\n  .num{ display:flex; align-items:stretch; border:1px solid var(--line); border-radius:12px; background:var(--bg); overflow:hidden; }\n  .num:focus-within{ border-color:var(--acc); }\n  .num input{ border:0; border-radius:0; background:none; text-align:center; font-weight:700; font-variant-numeric:tabular-nums; padding:11px 2px; min-width:0; }\n  .num button{ width:44px; flex-shrink:0; border:0; background:none; color:hsl(var(--h) 60% 34%); display:flex; align-items:center; justify-content:center; font-size:15px; }\n  @media (prefers-color-scheme:dark){ .num button{ color:hsl(var(--h) 70% 62%); } }\n  .swaprow{ display:flex; align-items:flex-end; gap:8px; margin-top:12px; }\n  .swaprow>div{ flex:1; min-width:0; }\n  .swap{ width:46px; height:46px; flex-shrink:0; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:hsl(var(--h) 60% 34%);\n    display:flex; align-items:center; justify-content:center; font-size:17px; }\n  @media (prefers-color-scheme:dark){ .swap{ color:hsl(var(--h) 70% 62%); } }\n\n  .temps{ display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-top:12px; }\n  .temps>div{ border-radius:14px; padding:11px 4px; text-align:center; background:hsl(var(--h) 60% 45% / .12); }\n  .temps .v{ font-size:24px; font-weight:800; font-variant-numeric:tabular-nums; color:hsl(var(--h) 65% 30%); }\n  @media (prefers-color-scheme:dark){ .temps .v{ color:hsl(var(--h) 70% 64%); } }\n  .temps .l{ font-size:11px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); margin-top:1px; }\n  @media (max-width:360px){ .two{ flex-direction:column; gap:12px; } }\n  @media (max-width:340px){ .hero .big{ font-size:36px; } }\n  @media (prefers-reduced-motion:reduce){ button:active{ transform:none; } }\n  input[type=number]{ -moz-appearance:textfield; appearance:textfield; }\n  input[type=number]::-webkit-inner-spin-button, input[type=number]::-webkit-outer-spin-button{ -webkit-appearance:none; margin:0; }\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-scale\" viewBox=\"0 0 24 24\"><g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 20h16M6.2 20l1.8-10h8l1.8 10\"/><path d=\"M12 10V5M8.5 5h7\"/></g></symbol>\n  <symbol id=\"i-swap\" viewBox=\"0 0 24 24\"><g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M8 4v15M4.5 7.5L8 4l3.5 3.5M16 20V5M12.5 16.5L16 20l3.5-3.5\"/></g></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M5 12h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-plus\" viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n</defs></svg>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-scale\"/></svg></div>\n  <div class=\"ht\"><h1>Kitchen Converter</h1><p>Cups, grams, millilitres and oven temperatures — fully offline</p></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Kitchen Converter\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n\n<div class=\"cols\">\n<section>\n  <h2>Measure</h2>\n  <div class=\"hero\" aria-live=\"polite\">\n    <div class=\"big\" id=\"res\">—</div>\n    <div class=\"sub\" id=\"resSub\"></div>\n    <div class=\"hint\" id=\"densHint\"></div>\n  </div>\n  <div class=\"card\">\n    <div class=\"two\">\n      <div><label for=\"amt\">Amount</label>\n        <div class=\"num\"><button type=\"button\" data-step=\"amt:-1\" aria-label=\"Less\"><svg class=\"i\"><use href=\"#i-minus\"/></svg></button>\n          <input id=\"amt\" type=\"number\" inputmode=\"decimal\" value=\"1\">\n          <button type=\"button\" data-step=\"amt:1\" aria-label=\"More\"><svg class=\"i\"><use href=\"#i-plus\"/></svg></button></div></div>\n      <div><label for=\"ing\">Ingredient</label><select id=\"ing\"></select></div>\n    </div>\n    <div class=\"swaprow\">\n      <div><label for=\"from\">From</label><select id=\"from\"></select></div>\n      <button type=\"button\" class=\"swap\" id=\"swapBtn\" aria-label=\"Swap units\"><svg class=\"i\"><use href=\"#i-swap\"/></svg></button>\n      <div><label for=\"to\">To</label><select id=\"to\"></select></div>\n    </div>\n  </div>\n</section>\n\n<section>\n  <h2>Oven temperature</h2>\n  <div class=\"card\">\n    <div class=\"two\">\n      <div><label for=\"tval\">Value</label>\n        <div class=\"num\"><button type=\"button\" data-step=\"tval:-1\" aria-label=\"Lower\"><svg class=\"i\"><use href=\"#i-minus\"/></svg></button>\n          <input id=\"tval\" type=\"number\" inputmode=\"numeric\" value=\"180\">\n          <button type=\"button\" data-step=\"tval:1\" aria-label=\"Higher\"><svg class=\"i\"><use href=\"#i-plus\"/></svg></button></div></div>\n      <div><label for=\"tunit\">Unit</label><select id=\"tunit\"><option value=\"C\">°C</option><option value=\"F\">°F</option><option value=\"G\">Gas mark</option></select></div>\n    </div>\n    <div class=\"temps\"><div><div class=\"v\" id=\"oc\">—</div><div class=\"l\">°C</div></div><div><div class=\"v\" id=\"of\">—</div><div class=\"l\">°F</div></div><div><div class=\"v\" id=\"og\">—</div><div class=\"l\">Gas</div></div></div>\n  </div>\n</section>\n</div>\n\n<script>\nvar VOL={'cup':240,'tbsp':15,'tsp':5,'ml':1,'litre':1000,'fl oz':29.5735};\nvar WT={'g':1,'oz':28.3495,'lb':453.592,'kg':1000};\nvar UNITS=[['cup','Cups'],['tbsp','Tablespoons'],['tsp','Teaspoons'],['ml','Millilitres'],['litre','Litres'],['fl oz','Fluid ounces'],['g','Grams'],['oz','Ounces'],['lb','Pounds'],['kg','Kilograms']];\nvar DENS={'Water':1.00,'Plain flour':0.52,'Sugar (granulated)':0.83,'Brown sugar (packed)':0.92,'Butter':0.95,'Rice (uncooked)':0.77,'Milk':1.02,'Honey':1.42,'Rolled oats':0.375};\nvar GAS={1:140,2:150,3:170,4:180,5:190,6:200,7:220,8:230,9:240};\nfunction el(i){return document.getElementById(i)}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nfunction isVol(u){return VOL.hasOwnProperty(u)}\n\nfunction fillUnit(sel,def){UNITS.forEach(function(u){var o=document.createElement('option');o.value=u[0];o.textContent=u[1];sel.appendChild(o)});sel.value=def}\nfunction fillIng(){Object.keys(DENS).forEach(function(k){var o=document.createElement('option');o.value=k;o.textContent=k;el('ing').appendChild(o)})}\n\nfunction fmt(n){if(!isFinite(n))return'—';if(n>=100)return Math.round(n).toString();if(n>=10)return n.toFixed(1);if(n>=1)return n.toFixed(2);return n.toFixed(3).replace(/0+$/,'').replace(/\\.$/,'')}\n\nfunction convert(){\n  var amt=parseFloat(el('amt').value);var from=el('from').value,to=el('to').value,d=DENS[el('ing').value];\n  var cross=isVol(from)!==isVol(to);\n  el('densHint').textContent=cross?('Using '+el('ing').value.toLowerCase()+' (≈'+Math.round(d*240)+' g per cup) to convert between volume and weight.'):'';\n  if(isNaN(amt)){el('res').textContent='—';el('resSub').textContent='';return}\n  var ml,g;\n  if(isVol(from)){ml=amt*VOL[from];g=ml*d;}else{g=amt*WT[from];ml=g/d;}\n  var out=isVol(to)?ml/VOL[to]:g/WT[to];\n  var label=UNITS.filter(function(u){return u[0]===to})[0][1].toLowerCase();\n  el('res').innerHTML='';el('res').appendChild(document.createTextNode(fmt(out)));\n  var u=document.createElement('small');u.textContent=to;el('res').appendChild(u);\n  el('resSub').textContent=fmt(amt)+' '+from+' = '+fmt(out)+' '+label;\n}\nfunction swap(){var f=el('from').value;el('from').value=el('to').value;el('to').value=f;haptic('selection');convert()}\n\nfunction nearestGas(c){var best=1,bd=1e9;for(var k in GAS){var diff=Math.abs(GAS[k]-c);if(diff<bd){bd=diff;best=k}}return best}\nfunction temp(){\n  var v=parseFloat(el('tval').value),u=el('tunit').value,c;\n  if(isNaN(v)){el('oc').textContent=el('of').textContent=el('og').textContent='—';return}\n  if(u==='C')c=v;else if(u==='F')c=(v-32)*5/9;else c=GAS[Math.round(v)]||GAS[nearestGas(GAS[Math.round(v)]||180)];\n  if(u==='G'&&!GAS[Math.round(v)]){el('oc').textContent='—';el('of').textContent='—';el('og').textContent='1–9';return}\n  el('oc').textContent=Math.round(c);\n  el('of').textContent=Math.round(c*9/5+32);\n  el('og').textContent=nearestGas(c);\n}\n/* Steppers: quarter steps for small amounts (¼ cup, ½ tsp), whole ones above;\n   oven in 10s, gas marks in 1s. */\nfunction step(id,dir){\n  var inp=el(id),v=parseFloat(inp.value);if(isNaN(v))v=0;\n  var s;\n  if(id==='amt')s=(dir<0?v<=2:v<2)?0.25:1;\n  else s=el('tunit').value==='G'?1:10;\n  v=Math.round((v+dir*s)*100)/100;\n  if(id==='amt')v=Math.max(0,v);\n  if(id==='tval'&&el('tunit').value==='G')v=Math.min(9,Math.max(1,v));\n  inp.value=v;haptic('selection');\n  if(id==='amt')convert();else temp();\n}\ndocument.querySelectorAll('[data-step]').forEach(function(b){\n  var p=b.getAttribute('data-step').split(':');b.onclick=function(){step(p[0],+p[1])};\n});\nel('swapBtn').onclick=swap;\nfillUnit(el('from'),'cup');fillUnit(el('to'),'g');fillIng();\n['amt','from','to','ing'].forEach(function(id){el(id).addEventListener('input',convert);el(id).addEventListener('change',convert)});\n['tval','tunit'].forEach(function(id){el(id).addEventListener('input',temp);el(id).addEventListener('change',temp)});\nconvert();temp();\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes.\n   The spacer keeps the header clear of the status bar / Dynamic Island. It is\n   live CSS — env(safe-area-inset-top) — not a measured number: the inset is\n   still 0 when the page loads and only grows once MyLLM's bar has gone (v1\n   measured once, so the title sat under the island). If the page's own styles\n   already pad the header down by the inset, the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  /* Does any rule that applies to the header or an ancestor already use the top inset? */\n  function pageHandlesInset(head){\n    var chain = [], n, found = false;\n    for (n = head; n && n.nodeType === 1; n = n.parentElement) chain.push(n);\n    function walk(rules){\n      for (var i = 0; i < rules.length && !found; i++){\n        var r = rules[i];\n        if (r.cssRules && !r.selectorText) { walk(r.cssRules); continue; }\n        if (!r.selectorText || !/safe-area-inset-top/.test(r.cssText) || !/(padding|margin|top)\\s*:/.test(r.cssText)) continue;\n        if (/\\.imm-safe/.test(r.selectorText)) continue;\n        for (var k = 0; k < chain.length; k++){\n          try { if (chain[k].matches(r.selectorText)) { found = true; break; } } catch(e){}\n        }\n      }\n    }\n    for (var s = 0; s < document.styleSheets.length && !found; s++){\n      try { walk(document.styleSheets[s].cssRules); } catch(e){}\n    }\n    for (n = head; n && n.nodeType === 1 && !found; n = n.parentElement){\n      if (/safe-area-inset-top/.test(n.getAttribute(\"style\") || \"\")) found = true;\n    }\n    return found;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = (document.body.classList.contains(\"imm\") && !pageHandlesInset(head)) ? \"env(safe-area-inset-top)\" : \"0px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script></body></html>\n", "kind": "html", "iconSymbol": "scalemass.fill", "iconColor": "teal"}