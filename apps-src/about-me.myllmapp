{"name": "About Me", "html": "<!doctype html>\n<!--\n  About Me — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>About Me</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"8b3cde2247\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --h:335; }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; } button:active{ transform:scale(.96); }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 28%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:20px 2px 10px; }\n\n  .hero{ border-radius:20px; padding:16px 18px; color:#fff; margin-bottom:12px; display:flex; align-items:center; gap:16px;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 46%), hsl(calc(var(--h) + 40) 58% 24%)); box-shadow:0 10px 28px hsl(var(--h) 60% 30% / .25); }\n  .hero .n{ font-size:44px; font-weight:800; line-height:1; letter-spacing:-.03em; font-variant-numeric:tabular-nums; }\n  .hero b{ display:block; font-size:15.5px; font-weight:750; }\n  .hero span{ display:block; font-size:12.5px; line-height:1.4; opacity:.8; margin-top:3px; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  label{ display:block; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:14px 2px 7px; }\n  label:first-child{ margin-top:0; }\n  input{ width:100%; font:inherit; font-size:16px; padding:12px; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; }\n  input:focus{ border-color:var(--acc); }\n  .chips{ display:flex; gap:7px; overflow-x:auto; -webkit-overflow-scrolling:touch; scrollbar-width:none; margin:0 -14px; padding:0 14px 2px; }\n  .chips::-webkit-scrollbar{ display:none; }\n  .chips.wrap{ flex-wrap:wrap; overflow:visible; margin:0; padding:0; }\n  .chip{ flex:0 0 auto; min-height:36px; border:1px solid var(--line); background:var(--bg); border-radius:99px; padding:0 14px; font-size:13.5px; font-weight:650; white-space:nowrap; }\n  .chip.hot{ background:var(--acc); border-color:var(--acc); color:#fff; }\n  .go{ width:100%; min-height:50px; margin-top:16px; border:none; border-radius:14px; background:var(--acc); color:#fff; font-size:16px; font-weight:700;\n    display:flex; align-items:center; justify-content:center; gap:8px; }\n  .go:disabled{ opacity:.5; }\n\n  .row{ display:flex; align-items:center; gap:11px; padding:10px 0; border-bottom:1px solid var(--line); }\n  .row:first-child{ padding-top:2px; } .row:last-child{ border-bottom:none; padding-bottom:2px; }\n  .row .tile{ width:36px; height:36px; border-radius:10px; font-size:15px; }\n  .row .f{ flex:1; min-width:0; font-size:15px; font-weight:600; line-height:1.3; overflow-wrap:anywhere; }\n  .row .c{ font-size:12px; font-weight:500; color:var(--muted); text-transform:capitalize; margin-top:2px; }\n  .row .del{ width:44px; height:44px; margin-right:-8px; border:none; background:none; color:var(--muted); font-size:15px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }\n  .empty{ text-align:center; padding:12px 8px 8px; color:var(--muted); font-size:13.5px; line-height:1.45; }\n  .empty .tile{ width:48px; height:48px; border-radius:14px; font-size:21px; margin:0 auto 10px; opacity:.85; }\n  .note{ color:var(--muted); font-size:12.5px; text-align:center; line-height:1.5; padding:6px 10px 0; }\n  .note.err{ color:#ff453a; }\n\n  @media (min-width:768px){ body{ max-width:760px; } }\n  @media (prefers-reduced-motion:reduce){ button:active{ transform:none; } }\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-person\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"8\" r=\"4.2\"/><path d=\"M4 20.2c0-4 3.6-6.7 8-6.7s8 2.7 8 6.7a.8.8 0 0 1-.8.8H4.8a.8.8 0 0 1-.8-.8z\"/></symbol>\n  <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M6.4 5a1 1 0 0 0-1.4 1.4L10.6 12 5 17.6A1 1 0 0 0 6.4 19l5.6-5.6 5.6 5.6a1 1 0 0 0 1.4-1.4L13.4 12 19 6.4A1 1 0 0 0 17.6 5L12 10.6z\"/></symbol>\n  <symbol id=\"i-plus\" viewBox=\"0 0 24 24\"><path d=\"M12 4a1 1 0 0 0-1 1v6H5a1 1 0 0 0 0 2h6v6a1 1 0 0 0 2 0v-6h6a1 1 0 0 0 0-2h-6V5a1 1 0 0 0-1-1z\"/></symbol>\n  <symbol id=\"i-work\" viewBox=\"0 0 24 24\"><path d=\"M9 3a2 2 0 0 0-2 2v2H5a3 3 0 0 0-3 3v8a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3v-8a3 3 0 0 0-3-3h-2V5a2 2 0 0 0-2-2zm0 2h6v2H9z\"/></symbol>\n  <symbol id=\"i-health\" viewBox=\"0 0 24 24\"><path d=\"M10 3a1 1 0 0 0-1 1v5H4a1 1 0 0 0-1 1v4a1 1 0 0 0 1 1h5v5a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1v-5h5a1 1 0 0 0 1-1v-4a1 1 0 0 0-1-1h-5V4a1 1 0 0 0-1-1z\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.6l2.7 5.9 6.4.7a.6.6 0 0 1 .34 1.04l-4.8 4.3 1.35 6.3a.6.6 0 0 1-.89.64L12 18.3l-5.6 3.2a.6.6 0 0 1-.89-.64l1.35-6.3-4.8-4.3A.6.6 0 0 1 2.4 9.2l6.4-.7z\"/></symbol>\n  <symbol id=\"i-dot\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"5\"/></symbol>\n</defs></svg>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-person\"/></svg></div>\n  <div><h1>About Me</h1><p>Teach MyLLM lasting facts about you</p></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close About Me\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n\n<div class=\"hero\">\n  <div class=\"n\" id=\"count\">0</div>\n  <div><b id=\"heroTitle\">Nothing saved from here yet</b>\n  <span>Saved privately on your device. This app can add and remove facts, but can't read anything else.</span></div>\n</div>\n\n<div class=\"card\">\n  <label for=\"fact\">Tell MyLLM to remember…</label>\n  <input id=\"fact\" placeholder=\"e.g. I'm vegetarian\" autocomplete=\"off\" enterkeyhint=\"done\">\n  <label>Ideas</label>\n  <div class=\"chips\" id=\"chips\"></div>\n  <label>Category</label>\n  <div class=\"chips wrap\" id=\"cats\"></div>\n  <button class=\"go\" id=\"goBtn\"><svg class=\"i\"><use href=\"#i-plus\"/></svg>Remember this</button>\n</div>\n\n<h2>Saved here</h2>\n<div class=\"card\" id=\"savedCard\"><div id=\"saved\"></div></div>\n<p class=\"note\" id=\"hint\">Needs the latest MyLLM with “Allow apps to use your memory” enabled in Settings.</p>\n\n<script>\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction haptic(s){ if (window.myllmHaptic) try { myllmHaptic(s); } catch(_){} }\nfunction loadKey(k){ var s = window.myllmStorage; return s ? s.getItem(k).catch(function(){ return null; }) : Promise.resolve(null); }\nfunction keepKey(k, v){ var s = window.myllmStorage; if (s) try { s.setItem(k, v).catch(function(){}); } catch(_){} }\n\nvar saved = [];   /* {fact, cat} the app added (the memory API is write-only: it can't read existing memories) */\nvar cat = \"preference\";\nvar IDEAS = [\"I'm vegetarian\",\"Prefer concise answers\",\"I use UK English\",\"I'm learning Spanish\",\"I have a peanut allergy\",\"I work in design\"];\nvar CATS = [[\"preference\",\"Preference\",\"i-star\",335],[\"personal\",\"Personal\",\"i-person\",275],[\"work\",\"Work\",\"i-work\",215],[\"health\",\"Health\",\"i-health\",150],[\"general\",\"General\",\"i-dot\",30]];\n\nfunction el(id){ return document.getElementById(id); }\nfunction catOf(id){ for (var i = 0; i < CATS.length; i++) if (CATS[i][0] === id) return CATS[i]; return CATS[4]; }\nfunction note(text, bad){ var h = el(\"hint\"); h.textContent = text; h.classList.toggle(\"err\", !!bad); }\n\nfunction chips(){\n  var c = el(\"chips\");\n  IDEAS.forEach(function(t){\n    var b = document.createElement(\"button\"); b.className = \"chip\"; b.textContent = t;\n    b.onclick = function(){ haptic(\"selection\"); el(\"fact\").value = t; };\n    c.appendChild(b);\n  });\n}\nfunction cats(){\n  var c = el(\"cats\"); c.innerHTML = \"\";\n  CATS.forEach(function(k){\n    var b = document.createElement(\"button\"); b.className = \"chip\" + (cat === k[0] ? \" hot\" : \"\"); b.textContent = k[1];\n    b.setAttribute(\"aria-pressed\", cat === k[0]);\n    b.onclick = function(){ cat = k[0]; haptic(\"selection\"); cats(); };\n    c.appendChild(b);\n  });\n}\n\nfunction remember(){\n  var fact = el(\"fact\").value.trim();\n  if (!fact){ el(\"fact\").focus(); return; }\n  var mem = window.myllmMemory;\n  if (!mem){ note(\"This needs the latest MyLLM (v3.7+) with “Allow apps to use your memory” enabled in Settings.\", true); return; }\n  var c = cat;\n  haptic(\"light\");\n  el(\"goBtn\").disabled = true;\n  mem.remember(fact, c).then(function(){\n    saved.unshift({ fact: fact, cat: c });\n    persist(); render(); el(\"fact\").value = \"\"; haptic(\"success\");\n  }).catch(function(e){ note((e && e.message) ? e.message : \"Could not save that.\", true); })\n    .then(function(){ el(\"goBtn\").disabled = false; });\n}\n\nfunction forget(i){\n  var item = saved[i], mem = window.myllmMemory; if (!item || !mem) return;\n  mem.forget(item.fact).then(function(){ saved.splice(i, 1); persist(); render(); haptic(\"warning\"); });\n}\n\nfunction render(){\n  var list = el(\"saved\"), n = saved.length;\n  el(\"count\").textContent = n;\n  el(\"heroTitle\").textContent = n ? (n === 1 ? \"fact MyLLM remembers from here\" : \"facts MyLLM remembers from here\") : \"Nothing saved from here yet\";\n  list.innerHTML = \"\";\n  if (!n){\n    list.innerHTML = '<div class=\"empty\"><div class=\"tile\"><svg class=\"i\"><use href=\"#i-person\"/></svg></div>Facts you add will be listed here, so you can take them back later.</div>';\n    return;\n  }\n  saved.forEach(function(it, i){\n    var k = catOf(it.cat), d = document.createElement(\"div\"); d.className = \"row\";\n    d.innerHTML = '<div class=\"tile\" style=\"--h:' + k[3] + '\"><svg class=\"i\"><use href=\"#' + k[2] + '\"/></svg></div>' +\n      '<div class=\"f\"><div></div><div class=\"c\"></div></div><button class=\"del\" aria-label=\"Forget this\"><svg class=\"i\"><use href=\"#i-x\"/></svg></button>';\n    d.querySelector(\".f div\").textContent = it.fact;\n    d.querySelector(\".c\").textContent = it.cat;\n    d.querySelector(\".del\").onclick = function(){ forget(i); };\n    list.appendChild(d);\n  });\n}\n\nfunction persist(){ keepKey(\"aboutme\", JSON.stringify(saved.slice(0, 100))); }\nfunction load(){ return loadKey(\"aboutme\").then(function(v){ try { var a = v ? JSON.parse(v) : []; return Array.isArray(a) ? a : []; } catch(e){ return []; } }); }\n\nel(\"goBtn\").onclick = remember;\nel(\"fact\").addEventListener(\"keydown\", function(e){ if (e.key === \"Enter\") remember(); });\nchips(); cats(); render();\nload().then(function(v){ saved = v; render(); });\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes.\n   The spacer keeps the header clear of the status bar / Dynamic Island. It is\n   live CSS — env(safe-area-inset-top) — not a measured number: the inset is\n   still 0 when the page loads and only grows once MyLLM's bar has gone (v1\n   measured once, so the title sat under the island). If the page's own styles\n   already pad the header down by the inset, the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  /* Does any rule that applies to the header or an ancestor already use the top inset? */\n  function pageHandlesInset(head){\n    var chain = [], n, found = false;\n    for (n = head; n && n.nodeType === 1; n = n.parentElement) chain.push(n);\n    function walk(rules){\n      for (var i = 0; i < rules.length && !found; i++){\n        var r = rules[i];\n        if (r.cssRules && !r.selectorText) { walk(r.cssRules); continue; }\n        if (!r.selectorText || !/safe-area-inset-top/.test(r.cssText) || !/(padding|margin|top)\\s*:/.test(r.cssText)) continue;\n        if (/\\.imm-safe/.test(r.selectorText)) continue;\n        for (var k = 0; k < chain.length; k++){\n          try { if (chain[k].matches(r.selectorText)) { found = true; break; } } catch(e){}\n        }\n      }\n    }\n    for (var s = 0; s < document.styleSheets.length && !found; s++){\n      try { walk(document.styleSheets[s].cssRules); } catch(e){}\n    }\n    for (n = head; n && n.nodeType === 1 && !found; n = n.parentElement){\n      if (/safe-area-inset-top/.test(n.getAttribute(\"style\") || \"\")) found = true;\n    }\n    return found;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = (document.body.classList.contains(\"imm\") && !pageHandlesInset(head)) ? \"env(safe-area-inset-top)\" : \"0px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script></body></html>\n"}