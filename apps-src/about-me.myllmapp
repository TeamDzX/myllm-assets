{"name": "About Me", "html": "<!doctype html>\n<!--\n  About Me — MyLLMos App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>:root{--build-id:\"8b3cde2247\";color-scheme:light dark}\n*{box-sizing:border-box}\nbody{font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);margin:0;padding:16px;background:var(--myllm-bg,#f2f2f7);color:var(--myllm-text,#111)}\nh1{font-size:22px;margin:0 0 2px}\n.sub{font-size:13px;color:var(--myllm-muted,#8a8a8e);margin:0 0 14px;line-height:1.45}\nlabel{font-size:13px;font-weight:600;display:block;margin:10px 0 4px}\ninput,select{width:100%;padding:11px;border:1px solid var(--myllm-border,#d1d1d6);border-radius:12px;font-size:16px;background:var(--myllm-surface,#fff);color:var(--myllm-text,#111)}\n.chips{display:flex;gap:8px;overflow-x:auto;padding:8px 0 4px;-webkit-overflow-scrolling:touch}\n.chip{flex:0 0 auto;background:var(--myllm-surface,#fff);border:1px solid var(--myllm-border,#d1d1d6);color:var(--myllm-text,#111);border-radius:999px;padding:8px 13px;font-size:14px}\nbutton.go{width:100%;border:0;background:var(--myllm-accent,#0a84ff);color:#fff;border-radius:12px;padding:13px;font-size:16px;font-weight:700;margin-top:12px}\nbutton.go:disabled{opacity:.5}\n.saved{margin-top:22px}\n.saved h3{font-size:14px;color:var(--myllm-muted,#8a8a8e);margin:0 0 8px}\n.row{background:var(--myllm-surface,#fff);border-radius:12px;padding:11px 14px;margin-bottom:8px;display:flex;align-items:center;gap:10px}\n.row .f{flex:1;font-size:15px}\n.row .c{font-size:11px;color:var(--myllm-muted,#8a8a8e);text-transform:capitalize}\n.row .del{border:0;background:none;color:#ff453a;font-size:18px}\n.note{color:var(--myllm-muted,#8a8a8e);font-size:13px;text-align:center;margin-top:16px;line-height:1.5;padding:0 6px}\n@media(min-width:768px){body{max-width:680px;margin-left:auto;margin-right:auto}}\n</style></head><body>\n<h1>🙋 About Me</h1>\n<p class=\"sub\">Tell MyLLM lasting facts about you, so it personalises every chat. These are saved privately on your device — this app can add and remove them, but can't read anything else.</p>\n\n<div class=\"chips\" id=\"chips\"></div>\n<label>Tell MyLLM to remember…</label>\n<input id=\"fact\" placeholder=\"e.g. I'm vegetarian\">\n<label>Category</label>\n<select id=\"cat\">\n  <option value=\"preference\" selected>Preference</option>\n  <option value=\"personal\">Personal</option>\n  <option value=\"work\">Work</option>\n  <option value=\"health\">Health</option>\n  <option value=\"general\">General</option>\n</select>\n<button class=\"go\" id=\"goBtn\" onclick=\"remember()\">Remember this</button>\n\n<div class=\"saved\" id=\"savedWrap\" style=\"display:none\">\n  <h3>Saved here</h3>\n  <div id=\"saved\"></div>\n</div>\n<p class=\"note\" id=\"hint\">Needs the latest MyLLM with “Allow apps to use your memory” enabled in Settings.</p>\n\n<script>\nvar MEM = window.myllmMemory || null;\nvar store = window.myllmStorage || {getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar haptic = window.myllmHaptic || function(){};\nvar saved = []; // {fact, cat} the app added (write-only API can't read existing memories)\nvar IDEAS = [\"I'm vegetarian\",\"Prefer concise answers\",\"I use UK English\",\"I'm learning Spanish\",\"I have a peanut allergy\",\"I work in design\"];\n\nfunction el(id){return document.getElementById(id)}\n\nfunction chips(){\n  var c = el('chips');\n  IDEAS.forEach(function(t){\n    var b=document.createElement('button'); b.className='chip'; b.textContent=t;\n    b.onclick=function(){ haptic('selection'); el('fact').value=t; };\n    c.appendChild(b);\n  });\n}\n\nfunction remember(){\n  var fact = el('fact').value.trim();\n  if(!fact) { el('fact').focus(); return; }\n  if(!MEM){ el('hint').textContent='This needs the latest MyLLM (v3.7+) with “Allow apps to use your memory” enabled in Settings.'; return; }\n  var cat = el('cat').value;\n  haptic('light');\n  el('goBtn').disabled = true;\n  MEM.remember(fact, cat).then(function(){\n    saved.unshift({ fact: fact, cat: cat });\n    persist(); render(); el('fact').value=''; haptic('success');\n  }).catch(function(e){ el('hint').textContent=(e&&e.message)?e.message:'Could not save that.'; })\n    .then(function(){ el('goBtn').disabled=false; });\n}\n\nfunction forget(i){\n  var item = saved[i]; if(!item || !MEM) return;\n  MEM.forget(item.fact).then(function(){ saved.splice(i,1); persist(); render(); haptic('warning'); });\n}\n\nfunction render(){\n  var wrap = el('savedWrap'), list = el('saved');\n  if(!saved.length){ wrap.style.display='none'; return; }\n  wrap.style.display='block'; list.innerHTML='';\n  saved.forEach(function(it, i){\n    var d=document.createElement('div'); d.className='row';\n    d.innerHTML='<div class=\"f\"><div></div><div class=\"c\"></div></div><button class=\"del\">✕</button>';\n    d.querySelector('.f div').textContent = it.fact;\n    d.querySelector('.c').textContent = it.cat;\n    d.querySelector('.del').onclick = function(){ forget(i); };\n    list.appendChild(d);\n  });\n}\n\nfunction persist(){ store.setItem('aboutme', JSON.stringify(saved.slice(0,100))); }\nfunction load(){ return store.getItem('aboutme').then(function(v){ try{return v?JSON.parse(v):[]}catch(e){return []} }); }\n\nchips();\nload().then(function(v){ saved=v; render(); });\n</script></body></html>\n"}