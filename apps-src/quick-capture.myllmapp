{"name": "Quick Capture", "html": "<!doctype html>\n<!--\n  Quick Capture — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover\">\n<title>Quick Capture</title>\n<style>\n  :root{--build-id:\"b8f0555128\"; color-scheme:light dark;\n    --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n    --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n    --h:275;\n  }\n  @media (prefers-color-scheme: dark){\n    :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e); --ink:var(--myllm-text,#f2f2f7);\n      --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); }\n  }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  html,body{ height:100%; }\n  body{\n    background:var(--bg); color:var(--ink);\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    display:flex; flex-direction:column; max-width:600px; margin:0 auto; height:100dvh;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(16px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left));\n    user-select:none; -webkit-user-select:none;\n  }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.96); }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; flex-shrink:0; }\n  .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 56%), hsl(calc(var(--h) + 40) 58% 30%)); }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head .ht{ flex:1; min-width:0; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  .count{ margin-left:auto; flex-shrink:0; font-size:11px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; color:var(--muted);\n    border:1px solid var(--line); background:var(--surface); border-radius:99px; padding:6px 11px; font-variant-numeric:tabular-nums; visibility:hidden; }\n  .count.on{ visibility:visible; }\n  @media (max-width:340px){ .count:not(.on){ display:none; } }   /* no room to hold its place on a small phone */\n\n  /* The page: the whole screen is the note. */\n  .page{ flex:1; min-height:0; display:flex; border-radius:18px; border:1px solid var(--line); background:var(--surface); overflow:hidden; transition:border-color .2s; }\n  .page:focus-within{ border-color:var(--acc); }\n  textarea{\n    flex:1; width:100%; font:inherit; font-size:17px; line-height:1.55; color:var(--ink);\n    background:transparent; border:none; padding:16px; outline:none; resize:none; user-select:text; -webkit-user-select:text;\n  }\n  textarea::placeholder{ color:var(--muted); opacity:.8; }\n  .row{ display:flex; gap:10px; margin-top:12px; flex-shrink:0; }\n  .row button{ min-height:52px; border-radius:14px; padding:0 18px; font-weight:700; font-size:16px; display:flex; align-items:center; justify-content:center; gap:8px; }\n  .primary{ flex:1; border:none; background:var(--acc); color:#fff; }\n  .ghost{ border:1px solid var(--line); background:var(--surface); }\n  .toast{\n    position:fixed; left:50%; bottom:calc(88px + env(safe-area-inset-bottom)); transform:translateX(-50%) translateY(20px);\n    background:var(--ink); color:var(--bg); padding:10px 16px; border-radius:999px; font-size:14px; font-weight:600;\n    opacity:0; transition:opacity .2s, transform .2s cubic-bezier(.2,.8,.2,1); pointer-events:none; max-width:84%; text-align:center;\n    box-shadow:0 8px 24px rgba(0,0,0,.25);\n  }\n  .toast.show{ opacity:1; transform:translateX(-50%); }\n\n  /* iPad / large screens: a centred, comfortable column (the textarea grows to\n     fill the height) rather than an over-wide stretch. */\n  @media (min-width: 768px){\n    body{ max-width:760px; padding-left:24px; padding-right:24px; }\n    textarea{ font-size:19px; }\n  }\n  /* Phone on its side: the note keeps the room, the header gives way. */\n  @media (max-height: 520px){ .head{ margin-bottom:8px; } .head p{ display:none; } .tile{ width:34px; height:34px; border-radius:10px; font-size:15px; } .row{ margin-top:8px; } .row button{ min-height:44px; } }\n  @media (prefers-reduced-motion:reduce){ button:active{ transform:none; } .toast{ transition:opacity .2s; } }\n</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-bolt\" viewBox=\"0 0 24 24\"><path d=\"M13.2 2.3 5 13.2a.7.7 0 0 0 .56 1.12H11l-1.1 7.1a.5.5 0 0 0 .9.38L19 10.9a.7.7 0 0 0-.56-1.12H13l1.1-7.1a.5.5 0 0 0-.9-.38z\"/></symbol>\n  <symbol id=\"i-send\" viewBox=\"0 0 24 24\"><path d=\"M21.4 2.6a1 1 0 0 0-1.05-.23L2.65 9.2a1 1 0 0 0-.06 1.84l6.9 3.47 3.47 6.9a1 1 0 0 0 1.84-.06l6.83-17.7a1 1 0 0 0-.23-1.05zM17.9 6.1l-4.1 10.6-2.1-4.2a1 1 0 0 0-.45-.45L7.3 9.95z\"/></symbol>\n</defs></svg>\n\n<div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-bolt\"/></svg></div>\n  <div class=\"ht\"><h1>Quick Capture</h1><p>Jot anything. Send it straight to your Shopping List.</p></div>\n  <div class=\"count\" id=\"count\"></div>\n</div>\n\n<div class=\"page\"><textarea id=\"note\" placeholder=\"milk&#10;eggs&#10;coffee&#10;&#10;Type items (one per line), then send to your list…\"></textarea></div>\n\n<div class=\"row\">\n  <button class=\"primary\" id=\"send\" type=\"button\"><svg class=\"i\"><use href=\"#i-send\"/></svg>Send to Shopping List</button>\n  <button class=\"ghost\" id=\"clear\" type=\"button\">Clear</button>\n</div>\n\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\n(function(){\n  function toast(msg){\n    var t = document.getElementById('toast');\n    t.textContent = msg; t.classList.add('show');\n    clearTimeout(t._t); t._t = setTimeout(function(){ t.classList.remove('show'); }, 2200);\n  }\n  function haptic(s){ try{ if(window.myllmHaptic) myllmHaptic(s); }catch(e){} }\n  function count(){\n    var n = document.getElementById('note').value.split(/\\r?\\n/).filter(function(l){ return l.trim(); }).length;\n    var c = document.getElementById('count');\n    c.textContent = n + (n === 1 ? ' line' : ' lines'); c.classList.toggle('on', n > 0);\n  }\n  document.getElementById('note').addEventListener('input', count);\n\n  document.getElementById('clear').addEventListener('click', function(){\n    document.getElementById('note').value = '';\n    document.getElementById('note').focus();\n    count();\n  });\n\n  // #1 intent bus — hand the text off to whichever app handles \"add-item\"\n  // (the Shopping List). The OS opens it and delivers the payload.\n  document.getElementById('send').addEventListener('click', async function(){\n    var text = document.getElementById('note').value.trim();\n    if(!text){ toast('Type something first.'); return; }\n    if(!window.myllmIntent){ toast('Open this inside MyLLM to send to other apps.'); return; }\n    try{\n      await myllmIntent.send('add-item', { text: text });\n      haptic('success');\n      // (We usually won't see this — the list app takes over the screen.)\n      toast('Sent to Shopping List ✓');\n    }catch(e){\n      haptic('error');\n      toast(e && e.message ? e.message : 'No app can receive that yet — install Shopping List.');\n    }\n  });\n  count();\n})();\n</script>\n</body>\n</html>\n", "kind": "html", "iconSymbol": "bolt.fill", "iconColor": "purple"}