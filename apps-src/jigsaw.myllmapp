{"name": "Jigsaw", "kind": "html", "iconSymbol": "puzzlepiece.fill", "iconColor": "orange", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Jigsaw</title>\n<style>\n  :root { color-scheme: dark; }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; user-select:none; -webkit-user-select:none; }\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:linear-gradient(180deg, #2b2118 0%, #201810 60%, #1a130c 100%);\n    color:#f2e9dc;\n    height:100dvh; overflow:hidden;\n    max-width:600px; margin:0 auto;\n    touch-action:none;\n  }\n\n  /* ---- picker ---- */\n  #picker{ height:100%; overflow-y:auto; padding:16px 16px calc(30px + env(safe-area-inset-bottom)); touch-action:pan-y; }\n  #picker h1{ font-size:22px; font-weight:800; margin:6px 2px 4px; }\n  #picker p.sub{ font-size:13.5px; color:#c9b8a4; margin:0 2px 14px; }\n  .diffs{ display:flex; background:rgba(255,255,255,.08); border-radius:12px; padding:3px; margin-bottom:14px; }\n  .diffs button{\n    flex:1; border:none; background:none; color:#c9b8a4;\n    border-radius:9px; padding:9px; font-size:14px; font-weight:700;\n  }\n  .diffs button.on{ background:#d99a3d; color:#241a0e; }\n  .pics{ display:grid; grid-template-columns:1fr 1fr; gap:10px; }\n  .pic{\n    position:relative; border-radius:14px; overflow:hidden; border:none; padding:0;\n    aspect-ratio:4/3; background:#333 center/cover;\n    box-shadow:0 6px 16px -8px rgba(0,0,0,.7);\n  }\n  .pic img{ width:100%; height:100%; object-fit:cover; display:block; }\n  .pic .done{\n    position:absolute; top:7px; right:7px; background:rgba(20,120,60,.92); color:#fff;\n    font-size:11px; font-weight:800; border-radius:99px; padding:3px 8px;\n  }\n\n  /* ---- play ---- */\n  #play{ position:relative; height:100%; display:none; }\n  #playbar{\n    position:absolute; top:0; left:0; right:0; z-index:50;\n    display:flex; align-items:center; justify-content:space-between;\n    padding:12px 14px 8px;\n  }\n  #playbar b{ font-size:14px; font-weight:800; }\n  #playbar .pb-btns{ display:flex; gap:6px; }\n  #playbar button{\n    border:1px solid rgba(255,255,255,.25); background:rgba(0,0,0,.35); color:#f2e9dc;\n    border-radius:9px; padding:6px 10px; font-size:12.5px; font-weight:700;\n  }\n  #frame{\n    position:absolute; border-radius:4px;\n    box-shadow:0 0 0 3px rgba(217,154,61,.75), 0 12px 34px -10px rgba(0,0,0,.8);\n    background:rgba(0,0,0,.3);\n  }\n  #ghost{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:.16; }\n  .piece{ position:absolute; touch-action:none; }\n  .piece.locked{ pointer-events:none; }\n\n  #winbox{\n    position:fixed; inset:0; z-index:300; display:none;\n    align-items:center; justify-content:center; flex-direction:column; gap:12px;\n    background:rgba(20,12,4,.85); -webkit-backdrop-filter:blur(6px); backdrop-filter:blur(6px);\n    text-align:center; padding:30px;\n  }\n  #winbox.on{ display:flex; }\n  #winbox .big{ font-size:52px; }\n  #winbox h2{ font-size:24px; font-weight:800; }\n  #winbox button{\n    margin-top:8px; border:none; border-radius:13px; padding:13px 26px;\n    font-size:16px; font-weight:750; background:#d99a3d; color:#241a0e;\n  }\n  .confetti{ position:fixed; top:-12px; font-size:20px; z-index:310; animation:fall linear forwards; pointer-events:none; }\n  @keyframes fall{ to{ transform:translateY(105dvh) rotate(720deg); } }\n</style>\n</head>\n<body>\n\n<div id=\"picker\">\n  <h1>🧩 Jigsaw</h1>\n  <p class=\"sub\">Six little paintings, made just for this app. Pick one.</p>\n  <div class=\"diffs\" id=\"diffs\"></div>\n  <div class=\"pics\" id=\"pics\"></div>\n</div>\n\n<div id=\"play\">\n  <div id=\"playbar\">\n    <b id=\"progress\"></b>\n    <div class=\"pb-btns\">\n      <button onclick=\"toggleGhost()\" id=\"ghostBtn\">Guide</button>\n      <button onclick=\"backToPicker()\">Puzzles</button>\n    </div>\n  </div>\n  <div id=\"frame\"><img id=\"ghost\" alt=\"\"></div>\n</div>\n\n<div id=\"winbox\">\n  <div class=\"big\">🧩</div>\n  <h2 id=\"wintitle\">Beautiful!</h2>\n  <button onclick=\"backToPicker()\">Another puzzle</button>\n</div>\n\n<script>\nvar store = window.myllmStorage || {getItem:function(){return Promise.resolve(null)}, setItem:function(){return Promise.resolve()}};\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction el(id){ return document.getElementById(id); }\n\nvar IMAGES = [\n  {id:\"lighthouse\", name:\"The Lighthouse\",  src:\"data:image/jpeg;base64,\"},\n  {id:\"balloons\",   name:\"Balloon Morning\", src:\"data:image/jpeg;base64,\"},\n  {id:\"cottage\",    name:\"Cottage Garden\",  src:\"data:image/jpeg;base64,\"},\n  {id:\"koi\",        name:\"The Koi Pond\",    src:\"data:image/jpeg;base64,\"},\n  {id:\"autumn\",     name:\"Autumn Path\",     src:\"data:image/jpeg;base64,\"},\n  {id:\"cabin\",      name:\"Winter Cabin\",    src:\"data:image/jpeg;base64,\"}\n];\nvar DIFFS = [\n  {id:\"easy\",   name:\"Easy · 12\",   cols:4, rows:3},\n  {id:\"medium\", name:\"Medium · 24\", cols:6, rows:4},\n  {id:\"hard\",   name:\"Hard · 48\",   cols:8, rows:6}\n];\nvar diff = DIFFS[0];\nvar doneSet = {};        /* \"imgId|diffId\" -> true, persisted */\n\n/* ---- current puzzle ---- */\nvar cur = null;   /* {img, cols, rows, cell, frameX, frameY, hEdges, vEdges, pieces:[{c,r,x,y,locked,cv}], placedCount} */\nvar drag = null;\n\nfunction key(imgId, diffId){ return imgId + \"|\" + diffId; }\n\n/* ---------- picker ---------- */\nfunction renderPicker(){\n  el(\"diffs\").innerHTML = DIFFS.map(function(d){\n    return '<button class=\"' + (d.id === diff.id ? \"on\" : \"\") + '\" onclick=\"setDiff(\\'' + d.id + '\\')\">' + d.name + '</button>';\n  }).join(\"\");\n  el(\"pics\").innerHTML = IMAGES.map(function(im, i){\n    return '<button class=\"pic\" onclick=\"startPuzzle(' + i + ')\"><img src=\"' + im.src + '\" alt=\"' + im.name + '\">' +\n      (doneSet[key(im.id, diff.id)] ? '<span class=\"done\">✓ done</span>' : '') + '</button>';\n  }).join(\"\");\n}\nfunction setDiff(id){\n  diff = DIFFS.filter(function(d){ return d.id === id; })[0];\n  haptic(\"selection\");\n  store.setItem(\"jigsaw_diff\", id);\n  renderPicker();\n}\n\n/* ---------- edges: complementary tabs shared between neighbours ----------\n   hEdges[r][c] = tab on the edge BETWEEN (r-1,c) and (r,c); vEdges[r][c]\n   between (r,c-1) and (r,c). 0 on the border, else ±1. */\nfunction makeEdges(cols, rows){\n  var h = [], v = [];\n  for (var r = 0; r <= rows; r++){\n    h[r] = [];\n    for (var c = 0; c < cols; c++) h[r][c] = (r === 0 || r === rows) ? 0 : (Math.random() < 0.5 ? 1 : -1);\n  }\n  for (var r2 = 0; r2 < rows; r2++){\n    v[r2] = [];\n    for (var c2 = 0; c2 <= cols; c2++) v[r2][c2] = (c2 === 0 || c2 === cols) ? 0 : (Math.random() < 0.5 ? 1 : -1);\n  }\n  return {h:h, v:v};\n}\n\n/* one jigsaw edge from (x0,y0) to (x1,y1); tab ±1 bulges left/right of travel */\nfunction edgeTo(ctx, x0, y0, x1, y1, tab){\n  if (!tab){ ctx.lineTo(x1, y1); return; }\n  var dx = x1 - x0, dy = y1 - y0;\n  var nx = -dy * tab * 0.28, ny = dx * tab * 0.28;   /* normal (bump height) */\n  function P(t, n){ return [x0 + dx*t + nx*n, y0 + dy*t + ny*n]; }\n  var p35 = P(0.38, 0), pA = P(0.30, 0.55), pB = P(0.5, 1.0), pC = P(0.70, 0.55), p65 = P(0.62, 0);\n  ctx.lineTo(p35[0], p35[1]);\n  ctx.bezierCurveTo(P(0.46,-0.15)[0], P(0.46,-0.15)[1], pA[0], pA[1], pB[0], pB[1]);\n  ctx.bezierCurveTo(pC[0], pC[1], P(0.54,-0.15)[0], P(0.54,-0.15)[1], p65[0], p65[1]);\n  ctx.lineTo(x1, y1);\n}\n\n/* trace the closed path of piece (c,r) in LOCAL coords with `pad` margin */\nfunction piecePath(ctx, c, r, cell, pad, E){\n  var x0 = pad, y0 = pad, x1 = pad + cell, y1 = pad + cell;\n  ctx.beginPath();\n  ctx.moveTo(x0, y0);\n  edgeTo(ctx, x0, y0, x1, y0,  E.h[r][c]);        /* top: bump up = -normal… sign folded into stored value */\n  edgeTo(ctx, x1, y0, x1, y1,  E.v[r][c+1]);      /* right */\n  edgeTo(ctx, x1, y1, x0, y1, -E.h[r+1][c]);      /* bottom (reverse direction → flip) */\n  edgeTo(ctx, x0, y1, x0, y0, -E.v[r][c]);        /* left */\n  ctx.closePath();\n}\n\n/* ---------- puzzle setup ---------- */\nfunction startPuzzle(imgIdx){\n  haptic(\"light\");\n  var im = new Image();\n  im.onload = function(){ buildPuzzle(IMAGES[imgIdx], im); };\n  im.src = IMAGES[imgIdx].src;\n}\n\nfunction buildPuzzle(imgDef, im){\n  el(\"picker\").style.display = \"none\";\n  el(\"play\").style.display = \"block\";\n  el(\"winbox\").classList.remove(\"on\");\n  document.querySelectorAll(\".piece\").forEach(function(p){ p.remove(); });\n\n  var W = Math.min(window.innerWidth, 600);\n  var frameW = Math.min(W - 28, 470);\n  var cell = Math.floor(frameW / diff.cols);\n  frameW = cell * diff.cols;\n  var frameH = cell * diff.rows;\n  var frameX = Math.floor((W - frameW) / 2);\n  var frameY = 54;\n\n  var fr = el(\"frame\");\n  fr.style.left = frameX + \"px\"; fr.style.top = frameY + \"px\";\n  fr.style.width = frameW + \"px\"; fr.style.height = frameH + \"px\";\n  el(\"ghost\").src = imgDef.src;\n\n  var E = makeEdges(diff.cols, diff.rows);\n  cur = {imgId:imgDef.id, cols:diff.cols, rows:diff.rows, cell:cell,\n         frameX:frameX, frameY:frameY, E:E, pieces:[], placedCount:0};\n\n  var pad = Math.ceil(cell * 0.32);\n  var dpr = Math.min(window.devicePixelRatio || 1, 2);\n  /* source image maps frame → image */\n  var sx = im.width / frameW, sy = im.height / frameH;\n\n  var scatterTop = frameY + frameH + 10;\n  var scatterH = Math.max(80, window.innerHeight - scatterTop - 40);\n\n  for (var r = 0; r < diff.rows; r++){\n    for (var c = 0; c < diff.cols; c++){\n      var size = cell + pad * 2;\n      var cv = document.createElement(\"canvas\");\n      cv.className = \"piece\";\n      cv.width = size * dpr; cv.height = size * dpr;\n      cv.style.width = size + \"px\"; cv.style.height = size + \"px\";\n      var ctx = cv.getContext(\"2d\");\n      ctx.scale(dpr, dpr);\n      piecePath(ctx, c, r, cell, pad, E);\n      ctx.save();\n      ctx.clip();\n      /* draw the matching part of the image: piece cell starts at (c*cell, r*cell) in frame coords */\n      ctx.drawImage(im,\n        (c * cell - pad) * sx, (r * cell - pad) * sy, size * sx, size * sy,\n        0, 0, size, size);\n      ctx.restore();\n      /* edge definition */\n      piecePath(ctx, c, r, cell, pad, E);\n      ctx.lineWidth = 1.2;\n      ctx.strokeStyle = \"rgba(0,0,0,.45)\";\n      ctx.stroke();\n\n      var p = {c:c, r:r, locked:false, cv:cv, pad:pad,\n               homeX:frameX + c * cell - pad, homeY:frameY + r * cell - pad};\n      p.x = 8 + Math.random() * (W - size - 16);\n      p.y = scatterTop + Math.random() * Math.max(10, scatterH - size);\n      place(p);\n      cv.style.zIndex = 10;\n      attachDrag(p);\n      el(\"play\").appendChild(cv);\n      cur.pieces.push(p);\n    }\n  }\n  updateProgress();\n}\n\nfunction place(p){\n  p.cv.style.left = p.x + \"px\";\n  p.cv.style.top = p.y + \"px\";\n}\n\nfunction attachDrag(p){\n  p.cv.addEventListener(\"pointerdown\", function(e){\n    if (p.locked || drag) return;\n    drag = {p:p, offX:e.clientX - p.x, offY:e.clientY - p.y};\n    p.cv.style.zIndex = 999;\n    p.cv.setPointerCapture(e.pointerId);\n    e.preventDefault();\n  });\n  p.cv.addEventListener(\"pointermove\", function(e){\n    if (!drag || drag.p !== p) return;\n    p.x = e.clientX - drag.offX;\n    p.y = e.clientY - drag.offY;\n    place(p);\n  });\n  function up(e){\n    if (!drag || drag.p !== p) return;\n    drag = null;\n    /* snap? */\n    var tol = cur.cell * 0.38;\n    if (Math.abs(p.x - p.homeX) < tol && Math.abs(p.y - p.homeY) < tol){\n      p.x = p.homeX; p.y = p.homeY;\n      p.locked = true;\n      p.cv.classList.add(\"locked\");\n      p.cv.style.zIndex = 1;\n      cur.placedCount++;\n      haptic(\"success\");\n      updateProgress();\n      if (cur.placedCount === cur.pieces.length) win();\n    } else {\n      p.cv.style.zIndex = 10;\n      haptic(\"light\");\n    }\n    place(p);\n  }\n  p.cv.addEventListener(\"pointerup\", up);\n  p.cv.addEventListener(\"pointercancel\", up);\n}\n\nfunction updateProgress(){\n  el(\"progress\").textContent = \"🧩 \" + cur.placedCount + \" / \" + cur.pieces.length;\n}\n\nvar ghostOn = true;\nfunction toggleGhost(){\n  ghostOn = !ghostOn;\n  el(\"ghost\").style.opacity = ghostOn ? .16 : 0;\n  haptic(\"selection\");\n}\n\nfunction win(){\n  doneSet[key(cur.imgId, diff.id)] = true;\n  store.setItem(\"jigsaw_done\", JSON.stringify(doneSet));\n  el(\"wintitle\").textContent = \"Beautiful! \" + cur.pieces.length + \" pieces.\";\n  el(\"winbox\").classList.add(\"on\");\n  haptic(\"success\");\n  for (var i = 0; i < 24; i++){\n    var conf = document.createElement(\"div\");\n    conf.className = \"confetti\";\n    conf.textContent = [\"🧩\",\"✨\",\"🎉\",\"⭐\"][i % 4];\n    conf.style.left = (Math.random() * 100) + \"vw\";\n    conf.style.animationDuration = (1.6 + Math.random() * 1.6) + \"s\";\n    conf.style.animationDelay = (Math.random() * 0.7) + \"s\";\n    document.body.appendChild(conf);\n    setTimeout(function(n){ return function(){ n.remove(); }; }(conf), 4200);\n  }\n}\n\nfunction backToPicker(){\n  haptic(\"light\");\n  el(\"winbox\").classList.remove(\"on\");\n  el(\"play\").style.display = \"none\";\n  document.querySelectorAll(\".piece\").forEach(function(p){ p.remove(); });\n  cur = null;\n  el(\"picker\").style.display = \"block\";\n  renderPicker();\n}\n\n/* ---------- boot ---------- */\nPromise.all([store.getItem(\"jigsaw_done\"), store.getItem(\"jigsaw_diff\")]).then(function(vals){\n  if (vals[0]){ try{ doneSet = JSON.parse(vals[0]) || {}; }catch(e){} }\n  if (vals[1]){ var d = DIFFS.filter(function(x){ return x.id === vals[1]; })[0]; if (d) diff = d; }\n  renderPicker();\n});\n</script>\n</body>\n</html>\n"}