{"name": "Draughts", "html": "<!doctype html>\n<!--\n  Draughts — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,user-scalable=no,viewport-fit=cover\">\n<title>Draughts</title>\n<style>:root{--build-id:\"06c0e532be\";color-scheme:light dark}\n  @property --h{ syntax:'<number>'; inherits:true; initial-value:8; }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  html,body{ height:100%; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:#0b0b10; color:#fff; overflow:hidden;\n    touch-action:none; overscroll-behavior:none; -webkit-user-select:none; user-select:none; }\n  button{ font:inherit; color:inherit; }\n\n  /* The stage: a hue-tinted backdrop in two layers, dark and light, so the\n     change between them can fade. */\n  .stage{ position:fixed; inset:0; --h:8; transition:--h 1.4s ease; color:#fff; }\n  .bg{ position:absolute; inset:0; transition:opacity .6s ease; }\n  .bg.d{ background:radial-gradient(120% 90% at 20% 10%, hsl(var(--h) 70% 34%), transparent 60%),\n      radial-gradient(120% 90% at 85% 95%, hsl(calc(var(--h) + 60) 65% 26%), transparent 62%), #0b0b10; }\n  .bg.l{ opacity:0; background:radial-gradient(120% 90% at 20% 0%, hsl(var(--h) 80% 84%), transparent 60%),\n      radial-gradient(120% 90% at 85% 100%, hsl(calc(var(--h) + 60) 78% 86%), transparent 62%), #f4f4f8; }\n  .lite{ color:#15151a; } .lite .bg.l{ opacity:1; } .lite .bg.d{ opacity:0; }\n\n  .col{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center;\n    padding:calc(12px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(14px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  .top{ width:100%; max-width:560px; height:44px; display:flex; align-items:center; justify-content:space-between; flex-shrink:0; }\n  .lbl{ font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; opacity:.62; white-space:nowrap; }\n  .glass{ border:1px solid rgba(255,255,255,.16); background:rgba(255,255,255,.12); color:inherit;\n    -webkit-backdrop-filter:blur(18px); backdrop-filter:blur(18px); }\n  .lite .glass{ border-color:rgba(0,0,0,.09); background:rgba(255,255,255,.62); }\n  svg{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  .rnd{ width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:15px; flex-shrink:0; }\n  .pill{ min-width:44px; height:44px; border-radius:99px; padding:0 16px; display:flex; align-items:center; justify-content:center; gap:6px;\n    font-size:19px; font-weight:800; font-variant-numeric:tabular-nums; flex-shrink:0; }\n  .pill small{ font-size:10px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; opacity:.6; }\n  .pill.bump{ animation:bump .28s ease; }\n  @keyframes bump{ 40%{ transform:scale(1.18); } }\n  .top .hide{ visibility:hidden; }\n\n  .wrap{ flex:1; width:100%; min-height:0; position:relative; display:flex; align-items:center; justify-content:center; margin:10px 0 34px; }\n  .foot{ position:absolute; left:0; right:0; top:calc(50% + var(--bh,320px) / 2 + 12px); text-align:center; font-size:12px; font-weight:600;\n    letter-spacing:.02em; opacity:.55; font-variant-numeric:tabular-nums; white-space:nowrap; }\n\n  /* One glass card over the board: title, paused, finished. */\n  .sheet{ position:absolute; left:50%; top:50%; width:max(232px, min(300px, calc(var(--b,320px) - 44px))); transform:translate(-50%,-50%) scale(.96);\n    opacity:0; pointer-events:none; border-radius:26px; padding:22px 20px 18px; text-align:center; box-shadow:0 24px 60px rgba(0,0,0,.35); z-index:5;\n    transition:opacity .28s ease, transform .28s cubic-bezier(.2,.8,.2,1); }\n  .sheet.on{ opacity:1; transform:translate(-50%,-50%); pointer-events:auto; }\n  /* whatever sits under an open card steps back, so the card reads */\n  .under{ transition:opacity .3s, filter .3s; } .veil .under{ opacity:.28; filter:blur(2px); }\n  .lite .sheet{ box-shadow:0 22px 50px rgba(20,20,40,.18); }\n  .sheet h1{ font-size:30px; font-weight:800; letter-spacing:-.02em; }\n  .sheet p{ font-size:13.5px; line-height:1.4; opacity:.72; margin-top:6px; }\n  .kick{ font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; opacity:.62; }\n  .big{ font-size:64px; font-weight:800; line-height:1.05; letter-spacing:-.03em; font-variant-numeric:tabular-nums; margin-top:4px; }\n  .big small{ display:block; font-size:12px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.6; margin-top:2px; }\n  .best{ display:inline-block; margin-top:10px; font-size:11.5px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; opacity:.7; }\n  .best.new{ opacity:1; color:#0b0b10; background:#ffd60a; border-radius:99px; padding:5px 11px; }\n  .sheet .act{ width:100%; height:50px; border-radius:99px; margin-top:10px; font-size:16px; font-weight:750;\n    display:flex; align-items:center; justify-content:center; gap:8px; }\n  .sheet .act:first-of-type{ margin-top:18px; }\n  .sheet .act:active, .rnd:active{ transform:scale(.96); }\n  .pri{ border:none; background:#fff; color:#0b0b10; box-shadow:0 10px 30px rgba(0,0,0,.3); }\n  .lite .pri{ background:#15151a; color:#fff; box-shadow:0 10px 26px rgba(20,20,40,.22); }\n\n  @media (max-height:430px){\n    .sheet{ padding:14px 18px 14px; } .sheet h1{ font-size:24px; } .big{ font-size:42px; }\n    .sheet .act{ height:44px; margin-top:8px; } .sheet .act:first-of-type{ margin-top:12px; } .sheet p{ display:none; }\n    .wrap{ margin:6px 0 26px; }\n  }\n  @media (prefers-reduced-motion:reduce){ .pill.bump{ animation:none; } .stage{ transition:none; } }\n\n  .main{ flex:1; width:100%; max-width:760px; min-height:0; display:flex; flex-direction:column; align-items:center; }\n  .wrap{ margin:8px 0 6px; }\n  .veil .under{ pointer-events:none; opacity:.3; filter:blur(7px) saturate(.8); }\n  .dock{ width:100%; max-width:560px; flex-shrink:0; display:flex; flex-direction:column; align-items:center; gap:10px; transition:opacity .3s; }\n  .veil .dock, .home .dock{ opacity:.0; pointer-events:none; }\n  .status{ min-height:24px; font-size:16px; font-weight:750; display:flex; align-items:center; gap:8px; text-align:center; }\n  .status.bad{ color:#ff6b62; } .lite .status.bad{ color:#d92d20; }\n  .sub{ min-height:16px; font-size:12.5px; font-weight:600; opacity:.6; margin-top:-6px; text-align:center; }\n  .ctl{ display:flex; gap:10px; justify-content:center; }\n  .ctl button{ min-width:104px; height:46px; border-radius:99px; padding:0 18px; font-size:15px; font-weight:700; display:flex; align-items:center; justify-content:center; gap:8px; }\n  .ctl button:active{ transform:scale(.96); }\n  .ctl button:disabled{ opacity:.45; }\n  .spin{ width:15px; height:15px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n  .seglbl{ font-size:10.5px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.6; margin:14px 0 6px; text-align:left; }\n  .seg{ display:flex; border-radius:14px; padding:3px; gap:3px; }\n  .seg button{ flex:1; height:36px; border:0; background:none; border-radius:11px; font-size:13.5px; font-weight:700; opacity:.72; }\n  .seg button.on{ background:#fff; color:#0b0b10; opacity:1; }\n  .lite .seg button.on{ background:#15151a; color:#fff; }\n  .sheet .act.glass{ font-weight:700; }\n  @media (max-height:520px){\n    .main{ flex-direction:row; align-items:stretch; gap:22px; }\n    .wrap{ margin:4px 0; }\n    .dock{ width:230px; justify-content:center; }\n    .ctl{ flex-direction:column; width:100%; } .ctl button{ width:100%; }\n    .seglbl{ margin:8px 0 4px; } .seg button{ height:32px; }\n  }\n  @media (max-height:640px) and (min-height:521px){ .sheet{ padding:16px 16px 14px; } .sheet h1{ font-size:24px; } .sheet p{ display:none; } .sheet .act{ height:44px; margin-top:8px; } .sheet .act:first-of-type{ margin-top:12px; } .seglbl{ margin:10px 0 5px; } .seg button{ height:32px; } }\n  @media (max-height:640px){ .home .lbl{ visibility:hidden; } }\n  @media (prefers-reduced-motion:reduce){ .spin{ animation-duration:2.4s; } }\n\n  .game{ width:var(--b,320px); }\n  .board{ width:var(--b,320px); height:var(--b,320px); display:grid; grid-template-columns:repeat(8,1fr); grid-template-rows:repeat(8,1fr);\n    border-radius:16px; overflow:hidden; box-shadow:0 20px 50px rgba(0,0,0,.4), 0 0 0 1px rgba(255,255,255,.1); touch-action:manipulation; }\n  .lite .board{ box-shadow:0 18px 40px rgba(20,20,40,.18), 0 0 0 1px rgba(0,0,0,.06); }\n  .sq{ position:relative; display:flex; align-items:center; justify-content:center; cursor:pointer; -webkit-user-select:none; user-select:none; }\n  .sq.l{ background:hsl(32 42% 84%); } .sq.d{ background:hsl(18 30% 33%); }\n  .sq::before, .sq::after{ pointer-events:none; }\n  .sq.sel::after{ content:\"\"; position:absolute; inset:0; background:hsla(48,98%,55%,.45); }\n  .sq.tgt::before{ content:\"\"; position:absolute; width:30%; height:30%; border-radius:50%; background:hsla(140,70%,55%,.8); box-shadow:0 0 0 3px rgba(0,0,0,.18); z-index:2; }\n  .pc{ width:76%; height:76%; border-radius:50%; display:flex; align-items:center; justify-content:center; pointer-events:none; position:relative; z-index:1;\n    font-size:calc(var(--b,320px) / 8 * .4); box-shadow:inset 0 -3px 6px rgba(0,0,0,.35), inset 0 2px 3px rgba(255,255,255,.25), 0 3px 5px rgba(0,0,0,.35); }\n  .pc::after{ content:\"\"; position:absolute; inset:14%; border-radius:50%; border:1.5px solid rgba(255,255,255,.22); }\n  .pc.red{ background:radial-gradient(circle at 35% 30%, #ff8373, #d93a2b 68%, #a8261a); color:#fff3e6; }\n  .pc.black{ background:radial-gradient(circle at 35% 30%, #69717f, #2a2f38 68%, #16191e); color:#ffd66b; }\n  .sq.must .pc{ box-shadow:0 0 0 3px #ffd23f, 0 0 16px rgba(255,210,63,.7), inset 0 -3px 6px rgba(0,0,0,.35); }\n  .score{ display:flex; gap:8px; }\n  .score .pill{ font-size:15px; padding:0 12px; gap:7px; height:40px; }\n  .disc{ width:13px; height:13px; border-radius:50%; flex-shrink:0; }\n  .disc.red{ background:#e0493a; } .disc.black{ background:#2f343d; border:1px solid rgba(255,255,255,.25); }\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-play\" viewBox=\"0 0 24 24\"><path d=\"M8 5.5v13a1 1 0 0 0 1.52.85l10.4-6.5a1 1 0 0 0 0-1.7L9.52 4.65A1 1 0 0 0 8 5.5z\"/></symbol>\n  <symbol id=\"i-pause\" viewBox=\"0 0 24 24\"><rect x=\"6\" y=\"5\" width=\"4.2\" height=\"14\" rx=\"1.4\"/><rect x=\"13.8\" y=\"5\" width=\"4.2\" height=\"14\" rx=\"1.4\"/></symbol>\n  <symbol id=\"i-again\" viewBox=\"0 0 24 24\"><path d=\"M12 5V2.6a.6.6 0 0 0-1-.45L7.2 5.55a.6.6 0 0 0 0 .9L11 9.85a.6.6 0 0 0 1-.45V7a5.5 5.5 0 1 1-5.5 5.5 1 1 0 0 0-2 0A7.5 7.5 0 1 0 12 5z\"/></symbol>\n  <symbol id=\"i-close\" viewBox=\"0 0 24 24\"><path d=\"M6.4 5a1 1 0 0 0-1.4 1.4L10.6 12 5 17.6A1 1 0 0 0 6.4 19l5.6-5.6 5.6 5.6a1 1 0 0 0 1.4-1.4L13.4 12 19 6.4A1 1 0 0 0 17.6 5L12 10.6z\"/></symbol>\n  <symbol id=\"i-menu\" viewBox=\"0 0 24 24\"><path d=\"M4 7h16M4 12h16M4 17h16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-undo\" viewBox=\"0 0 24 24\"><path d=\"M9 7.5 4.5 12 9 16.5M5 12h9.5a5 5 0 0 1 0 10H12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-flip\" viewBox=\"0 0 24 24\"><path d=\"M7 4v14m0 0-3.5-3.5M7 18l3.5-3.5M17 20V6m0 0-3.5 3.5M17 6l3.5 3.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-crown\" viewBox=\"0 0 24 24\"><path d=\"M3.5 8.2l4.3 3.4L12 5.5l4.2 6.1 4.3-3.4-1.8 9.3H5.3zM5.6 18.8h12.8a.9.9 0 0 1 0 1.8H5.6a.9.9 0 0 1 0-1.8z\"/></symbol>\n</defs></svg>\n<div class=\"stage home\" id=\"stage\">\n  <div class=\"bg d\"></div><div class=\"bg l\"></div>\n  <div class=\"col\">\n    <div class=\"top\">\n      <button class=\"glass rnd hide\" id=\"bMenu\" aria-label=\"Menu\"><svg><use href=\"#i-menu\"/></svg></button>\n      <div class=\"lbl\" id=\"lbl\">Draughts</div>\n      <div class=\"score hide\" id=\"score\">\n        <div class=\"glass pill\" aria-label=\"Your pieces\"><i class=\"disc red\"></i><span id=\"cRed\">12</span></div>\n        <div class=\"glass pill\" aria-label=\"Computer's pieces\"><i class=\"disc black\"></i><span id=\"cBlack\">12</span></div>\n      </div>\n    </div>\n    <div class=\"main\">\n      <div class=\"wrap\" id=\"wrap\">\n        <div class=\"game under\" id=\"game\"><div class=\"board\" id=\"board\"></div></div>\n        <div class=\"sheet glass\" id=\"sheet\"></div>\n      </div>\n      <div class=\"dock under\" id=\"dock\">\n        <div class=\"status\" id=\"statusText\">Your move</div>\n        <div class=\"sub\" id=\"sub\"></div>\n        <div class=\"ctl\"><button class=\"glass\" id=\"undoBtn\"><svg><use href=\"#i-undo\"/></svg>Undo</button></div>\n      </div>\n    </div>\n  </div>\n</div>\n<script>\nfunction el(i){ return document.getElementById(i); }\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction haptic(s){ if (window.myllmHaptic) try { myllmHaptic(s); } catch(_){} }\nfunction load(k){ var s = window.myllmStorage; return s ? s.getItem(k).catch(function(){ return null; }) : Promise.resolve(null); }\nfunction keep(k, v){ var s = window.myllmStorage; if (s) try { s.setItem(k, v).catch(function(){}); } catch(_){} }\nvar calm = window.matchMedia && matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n\n/* ---------- look ---------- */\nfunction isLight(){ return !(window.matchMedia && matchMedia(\"(prefers-color-scheme: dark)\").matches); }\n/* A game in progress takes the whole display and goes dark. Where MyLLM can't\n   hide its own title bar, a dark stage under a white bar looks cut in half —\n   so in light mode, without myllmImmersive, the stage stays light. */\nfunction syncLook(){\n  el(\"stage\").classList.toggle(\"lite\", isLight() && !(state !== \"home\" && window.myllmImmersive));\n  if (typeof onLook === \"function\") onLook();\n}\nfunction syncChrome(){\n  if (!window.myllmImmersive) return;\n  try { myllmImmersive(state !== \"home\", {keepAwake:false}).catch(function(){}); } catch(_){}\n}\nfunction setHue(h){ el(\"stage\").style.setProperty(\"--h\", String(h)); }\nfunction showSheet(html, acts){\n  var s = el(\"sheet\"); s.innerHTML = html;\n  Object.keys(acts).forEach(function(id){ var b = el(id); if (b) b.onclick = acts[id]; });\n  s.classList.add(\"on\"); el(\"stage\").classList.add(\"veil\");\n}\nfunction hideSheet(){ el(\"sheet\").classList.remove(\"on\"); el(\"stage\").classList.remove(\"veil\"); }\nfunction bump(id){ var p = el(id); p.classList.remove(\"bump\"); void p.offsetWidth; p.classList.add(\"bump\"); }\ndocument.addEventListener(\"visibilitychange\", function(){\n  if (document.hidden){ if (typeof onHide === \"function\") onHide(); return; }\n  if (state !== \"home\") syncChrome();          /* MyLLM puts its bars back when the app is left */\n});\nif (window.matchMedia){\n  var mq = matchMedia(\"(prefers-color-scheme: dark)\");\n  if (mq.addEventListener) mq.addEventListener(\"change\", syncLook); else if (mq.addListener) mq.addListener(syncLook);\n}\n\nvar N = 8, INF = 1e9;\nvar board = [], sel = null, midJump = false, depth = 5, thinking = false, undoStack = [];\nvar state = \"home\", over = null;\nvar DIFF = {3:'Easy',5:'Medium',7:'Hard'};\nfunction $(i){ return document.getElementById(i); }\nfunction inB(r,c){ return r >= 0 && r < 8 && c >= 0 && c < 8; }\nfunction clone(b){ return b.map(function(row){ return row.slice(); }); }\nfunction isRed(p){ return p === 'r' || p === 'R'; }\nfunction isBlack(p){ return p === 'b' || p === 'B'; }\nfunction isKing(p){ return p === 'R' || p === 'B'; }\nfunction opp(q,p){ return q && ((isRed(p) && isBlack(q)) || (isBlack(p) && isRed(q))); }\nfunction dirs(p){\n  if (p === 'r') return [[-1,-1],[-1,1]];\n  if (p === 'b') return [[1,-1],[1,1]];\n  return [[-1,-1],[-1,1],[1,-1],[1,1]];\n}\n\nfunction init(){\n  board = []; for (var r = 0; r < 8; r++){ var row = []; for (var c = 0; c < 8; c++){\n    var dark = (r + c) % 2 === 1, v = '';\n    if (dark && r < 3) v = 'b'; else if (dark && r > 4) v = 'r';\n    row.push(v);\n  } board.push(row); }\n}\n\nfunction jumpsFrom(b,r,c){ // single immediate jumps for the piece at r,c\n  var p = b[r][c], out = []; if (!p) return out;\n  dirs(p).forEach(function(d){\n    var mr = r + d[0], mc = c + d[1], jr = r + 2 * d[0], jc = c + 2 * d[1];\n    if (inB(jr,jc) && b[jr][jc] === '' && inB(mr,mc) && opp(b[mr][mc], p)) out.push({to:[jr,jc], cap:[mr,mc]});\n  });\n  return out;\n}\nfunction simpleFrom(b,r,c){\n  var p = b[r][c], out = []; if (!p) return out;\n  dirs(p).forEach(function(d){ var nr = r + d[0], nc = c + d[1]; if (inB(nr,nc) && b[nr][nc] === '') out.push({to:[nr,nc]}); });\n  return out;\n}\nfunction applyMoveTo(b,fr,fc,tr,tc,cap){ // returns {board,promoted}\n  var nb = clone(b), p = nb[fr][fc]; nb[fr][fc] = '';\n  if (cap) nb[cap[0]][cap[1]] = '';\n  var promoted = false;\n  if (p === 'r' && tr === 0){ p = 'R'; promoted = true; }\n  else if (p === 'b' && tr === 7){ p = 'B'; promoted = true; }\n  nb[tr][tc] = p; return {board:nb, promoted:promoted};\n}\nfunction sideHasCapture(b,red){\n  for (var r = 0; r < 8; r++) for (var c = 0; c < 8; c++){ var p = b[r][c]; if (p && (red ? isRed(p) : isBlack(p)) && jumpsFrom(b,r,c).length) return true; }\n  return false;\n}\n// full legal turns for AI (each returns resulting board)\nfunction legalTurns(b,red){\n  var caps = [];\n  for (var r = 0; r < 8; r++) for (var c = 0; c < 8; c++){ var p = b[r][c]; if (p && (red ? isRed(p) : isBlack(p))) expandJumps(b,r,c,caps); }\n  if (caps.length) return caps;\n  var simp = [];\n  for (var r2 = 0; r2 < 8; r2++) for (var c2 = 0; c2 < 8; c2++){ var p2 = b[r2][c2]; if (p2 && (red ? isRed(p2) : isBlack(p2))){\n    simpleFrom(b,r2,c2).forEach(function(m){ simp.push({board:applyMoveTo(b,r2,c2,m.to[0],m.to[1],null).board}); });\n  } }\n  return simp;\n}\nfunction expandJumps(b,r,c,acc){\n  var js = jumpsFrom(b,r,c); if (!js.length) return;\n  js.forEach(function(j){\n    var res = applyMoveTo(b,r,c,j.to[0],j.to[1],j.cap);\n    if (res.promoted){ acc.push({board:res.board}); }\n    else {\n      var before = acc.length;\n      expandJumps(res.board, j.to[0], j.to[1], acc);\n      if (acc.length === before) acc.push({board:res.board}); // no further jump -> sequence ends\n    }\n  });\n}\n\nvar CROWN = '<svg><use href=\"#i-crown\"/></svg>';\nfunction render(){\n  var B = $('board'); B.innerHTML = '';\n  var tgts = highlightTargets();\n  for (var r = 0; r < 8; r++) for (var c = 0; c < 8; c++){\n    var dark = (r + c) % 2 === 1, d = document.createElement('div');\n    d.className = 'sq ' + (dark ? 'd' : 'l');\n    if (sel && sel[0] === r && sel[1] === c) d.className += ' sel';\n    if (tgts.some(function(t){ return t[0] === r && t[1] === c; })) d.className += ' tgt';\n    var p = board[r][c];\n    if (p){\n      var pc = document.createElement('div'); pc.className = 'pc ' + (isRed(p) ? 'red' : 'black');\n      if (isKing(p)) pc.innerHTML = CROWN;\n      // mark forced-capture pieces (player's turn only)\n      if (state === 'play' && playerTurn() && !thinking && isRed(p) && forced() && jumpsFrom(board,r,c).length && !midJump) d.classList.add('must');\n      d.appendChild(pc);\n    }\n    (function(rr,cc){ var h = function(e){ if (e && e.preventDefault) e.preventDefault(); handleTap(rr,cc); }; d.addEventListener('pointerup', h); d.addEventListener('click', h); })(r,c);\n    B.appendChild(d);\n  }\n  updateCounts();\n}\nfunction highlightTargets(){\n  if (!sel) return [];\n  if (forced() || midJump) return jumpsFrom(board, sel[0], sel[1]).map(function(j){ return j.to; });\n  return simpleFrom(board, sel[0], sel[1]).map(function(m){ return m.to; });\n}\nfunction forced(){ return sideHasCapture(board, true); }\nfunction playerTurn(){ return turn === 'r'; }\nvar turn = 'r';\n\nvar _ltKey = '', _ltT = 0;\nfunction handleTap(r,c){ // dedupe the pointerup+click pair on the same square\n  var k = r + '_' + c, now = Date.now();\n  if (k === _ltKey && now - _ltT < 500) return;\n  _ltKey = k; _ltT = now; onTap(r,c);\n}\nfunction onTap(r,c){\n  if (state !== 'play' || over || thinking || turn !== 'r') return;\n  var p = board[r][c];\n  if (sel){\n    var t = highlightTargets().find(function(x){ return x[0] === r && x[1] === c; });\n    if (t){ doPlayer(sel[0], sel[1], r, c); return; }\n  }\n  if (midJump) return; // must continue the current jump\n  if (p && isRed(p)){\n    if (forced() && jumpsFrom(board,r,c).length === 0){ haptic('warning'); return; } // must pick a capturing piece\n    sel = [r,c]; haptic('selection'); render();\n  } else { sel = null; render(); }\n}\n\nfunction doPlayer(fr,fc,tr,tc){\n  var capturing = Math.abs(tr - fr) === 2;\n  var cap = capturing ? [(fr + tr) / 2, (fc + tc) / 2] : null;\n  undoStack.push({board:clone(board), turn:turn}); // snapshot before this turn\n  if (midJump) undoStack.pop();                   // one snapshot per full turn\n  var res = applyMoveTo(board, fr, fc, tr, tc, cap);\n  board = res.board; haptic(capturing ? 'medium' : 'light');\n  if (capturing && !res.promoted && jumpsFrom(board,tr,tc).length){\n    sel = [tr,tc]; midJump = true; render(); updateStatus(); return; // continue multi-jump\n  }\n  sel = null; midJump = false; turn = 'b'; render(); save(); updateStatus();\n  if (checkOver()) return;\n  aiTurn();\n}\n\nfunction aiTurn(){\n  thinking = true; updateStatus();\n  setTimeout(function(){\n    var best = aiBest(board, depth);\n    if (best) board = best;\n    thinking = false; turn = 'r';\n    haptic('light'); render(); save(); updateStatus(); checkOver();\n  }, 40);\n}\n\n// ---- AI: minimax (black maximises) ----\nfunction evalBlack(b){\n  var s = 0;\n  for (var r = 0; r < 8; r++) for (var c = 0; c < 8; c++){ var p = b[r][c]; if (!p) continue;\n    if (p === 'b') s += 100 + r * 4;           // advance toward row7\n    else if (p === 'B') s += 165;\n    else if (p === 'r') s -= 100 + (7 - r) * 4;\n    else if (p === 'R') s -= 165;\n  }\n  return s;\n}\nfunction minimax(b,red,d,alpha,beta){\n  var moves = legalTurns(b, red);\n  if (moves.length === 0) return red ? INF : -INF; // side to move (red) stuck -> bad for red(good for black); black stuck -> bad for black\n  if (d === 0) return evalBlack(b);\n  if (!red){ // black maximises\n    var best = -INF;\n    for (var i = 0; i < moves.length; i++){ var v = minimax(moves[i].board, true, d - 1, alpha, beta); if (v > best) best = v; if (best > alpha) alpha = best; if (alpha >= beta) break; }\n    return best;\n  } else { // red minimises\n    var best2 = INF;\n    for (var j = 0; j < moves.length; j++){ var v2 = minimax(moves[j].board, false, d - 1, alpha, beta); if (v2 < best2) best2 = v2; if (best2 < beta) beta = best2; if (alpha >= beta) break; }\n    return best2;\n  }\n}\nfunction aiBest(b,d){\n  var moves = legalTurns(b, false); if (!moves.length) return null;\n  var best = -INF, pick = null;\n  for (var i = 0; i < moves.length; i++){\n    var v = minimax(moves[i].board, true, d - 1, -INF, INF);\n    if (v > best || (v === best && Math.random() < 0.3)){ best = v; pick = moves[i].board; }\n  }\n  return pick;\n}\n\nfunction counts(){ var red = 0, black = 0; for (var r = 0; r < 8; r++) for (var c = 0; c < 8; c++){ var p = board[r][c]; if (isRed(p)) red++; else if (isBlack(p)) black++; } return {red:red, black:black}; }\nfunction updateCounts(){ var c = counts(); $('cRed').textContent = c.red; $('cBlack').textContent = c.black; }\nfunction updateStatus(){\n  var st = $('statusText');\n  st.classList.remove('bad');\n  if (over) st.textContent = over.t;\n  else if (thinking) st.innerHTML = '<i class=\"spin\"></i><span>Thinking…</span>';\n  else if (turn === 'r'){\n    if (midJump) st.textContent = 'Keep jumping';\n    else if (forced()){ st.textContent = 'Your move — you must take'; st.classList.add('bad'); }\n    else st.textContent = 'Your move';\n  }\n  else st.textContent = 'Computer to move';\n  $('sub').textContent = over ? over.p : (state === 'play' && turn === 'r' && !thinking ? 'You play red, moving up the board' : '');\n  $('undoBtn').disabled = thinking || !undoStack.length;\n  $('lbl').textContent = state === 'play' && window.innerWidth > 360 ? 'Draughts · ' + DIFF[depth] : 'Draughts';\n}\nfunction checkOver(){ // checks the side whose turn it now is\n  var c = counts();\n  if (turn === 'b'){ if (c.black === 0 || legalTurns(board,false).length === 0){ finish('You win', 'The computer has no moves left.', true); return true; } }\n  else { if (c.red === 0 || legalTurns(board,true).length === 0){ finish('Computer wins', 'You have no moves left.', false); return true; } }\n  return false;\n}\nfunction finish(t,p,won){\n  over = {t:t, p:p}; haptic(won ? 'success' : 'warning'); updateStatus();\n  setTimeout(function(){ if (over && state === 'play') showOver(); }, 650);\n}\n\n/* ---------- cards ---------- */\nfunction segHTML(id, items, on){\n  return '<div class=\"seg glass\" id=\"' + id + '\">' + items.map(function(it){ return '<button data-v=\"' + it[0] + '\"' + (String(it[0]) === String(on) ? ' class=\"on\"' : '') + '>' + it[1] + '</button>'; }).join('') + '</div>';\n}\nfunction wireSeg(id, fn){\n  var s = $(id); if (!s) return;\n  Array.prototype.forEach.call(s.children, function(b){ b.onclick = function(){\n    Array.prototype.forEach.call(s.children, function(x){ x.classList.remove('on'); }); b.classList.add('on'); haptic('selection'); fn(b.dataset.v);\n  }; });\n}\nfunction fresh(){ var s = JSON.stringify(board), keepB = board; init(); var start = JSON.stringify(board); board = keepB; return s === start && turn === 'r'; }\nfunction showHome(){\n  var going = !fresh() && !over;\n  showSheet('<h1>Draughts</h1><p>You play red. Captures are compulsory, and jumps chain.</p>' +\n    '<div class=\"seglbl\">Difficulty</div>' + segHTML('diffSeg', [[3,'Easy'],[5,'Medium'],[7,'Hard']], depth) +\n    (going ? '<button class=\"act pri\" id=\"sA\"><svg><use href=\"#i-play\"/></svg>Continue</button><button class=\"act glass\" id=\"sB\">New game</button>'\n           : '<button class=\"act pri\" id=\"sB\"><svg><use href=\"#i-play\"/></svg>Play</button>'),\n    {sA: resume, sB: newGame});\n  wireSeg('diffSeg', function(v){ depth = +v; save(); });\n}\nfunction showMenu(){\n  showSheet('<div class=\"kick\">Paused</div><h1>Draughts</h1>' +\n    '<div class=\"seglbl\">Difficulty</div>' + segHTML('diffSeg', [[3,'Easy'],[5,'Medium'],[7,'Hard']], depth) +\n    '<button class=\"act pri\" id=\"sA\"><svg><use href=\"#i-play\"/></svg>Resume</button><button class=\"act glass\" id=\"sB\">New game</button><button class=\"act glass\" id=\"sC\">Leave game</button>',\n    {sA: function(){ haptic('light'); hideSheet(); }, sB: newGame, sC: goHome});\n  wireSeg('diffSeg', function(v){ depth = +v; save(); updateStatus(); });\n}\nfunction showOver(){\n  showSheet('<div class=\"kick\">Game over</div><h1>' + over.t + '</h1><p>' + over.p + '</p>' +\n    '<button class=\"act pri\" id=\"sA\"><svg><use href=\"#i-again\"/></svg>New game</button><button class=\"act glass\" id=\"sB\">See the board</button>',\n    {sA: newGame, sB: function(){ haptic('light'); hideSheet(); }});\n}\n\n/* ---------- flow ---------- */\nfunction setState(s){\n  state = s; $('stage').classList.toggle('home', s === 'home');\n  $('bMenu').classList.toggle('hide', s !== 'play'); $('score').classList.toggle('hide', s !== 'play');\n  syncLook(); syncChrome(); render(); updateStatus();\n}\nfunction enterPlay(){\n  hideSheet(); setState('play');\n  if (!over && turn === 'b' && !thinking) aiTurn();\n  else if (!over) checkOver();\n}\nfunction resume(){ haptic('medium'); enterPlay(); }\nfunction newGame(){\n  haptic('medium'); init(); turn = 'r'; sel = null; midJump = false; thinking = false; undoStack = []; over = null;\n  render(); save(); enterPlay();\n}\nfunction goHome(){ haptic('light'); sel = null; midJump = false; setState('home'); showHome(); }\n\n$('undoBtn').onclick = function(){ if (thinking || !undoStack.length) return; var h = undoStack.pop(); board = h.board; turn = 'r'; sel = null; midJump = false; over = null; hideSheet(); render(); save(); updateStatus(); haptic('light'); };\n$('bMenu').onclick = function(){ haptic('light'); showMenu(); };\n\nfunction save(){ keep('draughts', JSON.stringify({board:board, turn:turn, depth:depth})); }\n\nfunction fit(){\n  var w = $('wrap');\n  var b = Math.floor(Math.min(w.clientWidth, w.clientHeight, 560));\n  $('stage').style.setProperty('--b', Math.max(200, b) + 'px');\n}\nwindow.addEventListener('resize', fit);\n\n/* ---------- boot ---------- */\ninit(); fit(); render(); updateStatus(); syncLook(); showHome();\nload('draughts').then(function(v){\n  if (v) try { var s = JSON.parse(v);\n    if (s.depth) depth = s.depth;\n    if (s.board){ board = s.board; turn = s.turn || 'r'; } else init();\n  } catch(e){ init(); } else init();\n  render(); updateStatus(); if (state === 'home') showHome();\n});\n</script></body></html>\n", "kind": "html", "iconSymbol": "circle.grid.3x3.fill", "iconColor": "red"}