{"name": "Draughts", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Draughts</title>\n<style>\n:root{\n  color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7);--surface:var(--myllm-surface,#fff);\n  --text:var(--myllm-text,#111);--muted:var(--myllm-muted,#6b6b72);\n  --accent:var(--myllm-accent,#0b5ed7);--border:var(--myllm-border,rgba(120,120,128,.25));\n  --radius:var(--myllm-radius,14px);--font:var(--myllm-font,-apple-system,system-ui,sans-serif);\n  --light:#e8d3a8;--dark:#7a5236;--dot:rgba(20,120,40,.55);\n}\n@media(prefers-color-scheme:dark){:root{--bg:var(--myllm-bg,#000);--surface:var(--myllm-surface,#1c1c1e);--text:var(--myllm-text,#eee);--muted:var(--myllm-muted,#98989f)}}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nbody{margin:0;font-family:var(--font);background:var(--bg);color:var(--text)}\n.wrap{max-width:460px;margin:0 auto;padding:12px 12px 28px}\n.status{display:flex;align-items:center;gap:8px;font-size:16px;font-weight:600;padding:8px 4px 12px;min-height:38px}\n.status .think{color:var(--muted);font-weight:500;font-size:14px}\n.board{width:100%;aspect-ratio:1;display:grid;grid-template-columns:repeat(8,1fr);grid-template-rows:repeat(8,1fr);border-radius:10px;overflow:hidden;box-shadow:0 4px 18px rgba(0,0,0,.2);touch-action:manipulation}\n.sq{position:relative;display:flex;align-items:center;justify-content:center;cursor:pointer;user-select:none;-webkit-user-select:none}\n.sq.l{background:var(--light)}.sq.d{background:var(--dark)}\n.sq:before,.sq:after{pointer-events:none}\n.pc{width:74%;height:74%;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:min(5vw,24px);pointer-events:none;box-shadow:inset 0 -3px 5px rgba(0,0,0,.35),0 2px 3px rgba(0,0,0,.3)}\n.pc.red{background:radial-gradient(circle at 35% 30%,#ff7a6b,#d93a2b);color:#ffe}\n.pc.black{background:radial-gradient(circle at 35% 30%,#5a6472,#262b33);color:#fff}\n.pc .crown{opacity:.9}\n.sq.sel:after{content:\"\";position:absolute;inset:0;background:rgba(11,94,215,.4)}\n.sq.tgt:before{content:\"\";position:absolute;width:32%;height:32%;border-radius:50%;background:var(--dot);z-index:2}\n.sq.must .pc{outline:3px solid #ffd23f;outline-offset:-3px;border-radius:50%}\n.controls{display:flex;gap:8px;margin-top:14px}\n.controls button{flex:1;border:0;background:var(--surface);border:1px solid var(--border);color:var(--text);border-radius:11px;padding:11px;font:inherit;font-weight:600;font-size:14px;cursor:pointer}\n.controls button.primary{background:var(--accent);color:#fff;border-color:transparent}\n.lbl{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.03em;margin:14px 0 5px}\n.seg{display:flex;background:var(--surface);border:1px solid var(--border);border-radius:11px;padding:3px}\n.seg button{flex:1;border:0;background:none;color:var(--muted);font:inherit;font-weight:600;font-size:13px;padding:9px;border-radius:8px;cursor:pointer}\n.seg button.on{background:var(--accent);color:#fff}\n.count{display:flex;justify-content:space-between;font-size:13px;color:var(--muted);margin-top:10px}\n.sheet{position:fixed;inset:0;background:rgba(0,0,0,.5);display:none;align-items:center;justify-content:center;z-index:30;padding:24px}\n.sheet.show{display:flex}\n.sheetB{background:var(--bg);border-radius:18px;max-width:320px;padding:22px;text-align:center}\n.sheetB h3{margin:0 0 6px;font-size:20px}.sheetB p{color:var(--muted);font-size:14px;margin:0 0 16px}\n.sheetB button{width:100%;border:0;background:var(--accent);color:#fff;border-radius:11px;padding:12px;font:inherit;font-weight:600;cursor:pointer}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <div class=\"status\"><span id=\"statusText\">Your move</span><span class=\"think\" id=\"think\"></span></div>\n  <div class=\"board\" id=\"board\"></div>\n  <div class=\"count\"><span id=\"cRed\">You: 12</span><span id=\"cBlack\">Computer: 12</span></div>\n  <div id=\"dbg\" style=\"font-size:11px;color:var(--muted);text-align:center;padding:7px 0;min-height:14px\"></div>\n  <div class=\"controls\">\n    <button class=\"primary\" id=\"newBtn\">New game</button>\n    <button id=\"undoBtn\">Undo</button>\n  </div>\n  <div class=\"lbl\">Difficulty</div>\n  <div class=\"seg\" id=\"diffSeg\"><button data-d=\"3\">Easy</button><button data-d=\"5\" class=\"on\">Medium</button><button data-d=\"7\">Hard</button></div>\n</div>\n<div class=\"sheet\" id=\"sheet\"><div class=\"sheetB\"><h3 id=\"overT\">Game over</h3><p id=\"overP\"></p><button id=\"overBtn\">New game</button></div></div>\n\n<script>\nvar N=8, INF=1e9;\nvar board=[], sel=null, midJump=false, depth=5, thinking=false, history=[];\nfunction $(i){return document.getElementById(i)}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nfunction inB(r,c){return r>=0&&r<8&&c>=0&&c<8}\nfunction clone(b){return b.map(function(row){return row.slice()})}\nfunction isRed(p){return p==='r'||p==='R'}\nfunction isBlack(p){return p==='b'||p==='B'}\nfunction isKing(p){return p==='R'||p==='B'}\nfunction opp(q,p){return q&&((isRed(p)&&isBlack(q))||(isBlack(p)&&isRed(q)))}\nfunction dirs(p){\n  if(p==='r')return [[-1,-1],[-1,1]];\n  if(p==='b')return [[1,-1],[1,1]];\n  return [[-1,-1],[-1,1],[1,-1],[1,1]];\n}\n\nfunction init(){\n  board=[];for(var r=0;r<8;r++){var row=[];for(var c=0;c<8;c++){\n    var dark=(r+c)%2===1, v='';\n    if(dark&&r<3)v='b'; else if(dark&&r>4)v='r';\n    row.push(v);\n  }board.push(row)}\n}\n\nfunction jumpsFrom(b,r,c){ // single immediate jumps for the piece at r,c\n  var p=b[r][c],out=[];if(!p)return out;\n  dirs(p).forEach(function(d){\n    var mr=r+d[0],mc=c+d[1],jr=r+2*d[0],jc=c+2*d[1];\n    if(inB(jr,jc)&&b[jr][jc]===''&&inB(mr,mc)&&opp(b[mr][mc],p))out.push({to:[jr,jc],cap:[mr,mc]});\n  });\n  return out;\n}\nfunction simpleFrom(b,r,c){\n  var p=b[r][c],out=[];if(!p)return out;\n  dirs(p).forEach(function(d){var nr=r+d[0],nc=c+d[1];if(inB(nr,nc)&&b[nr][nc]==='')out.push({to:[nr,nc]})});\n  return out;\n}\nfunction applyMoveTo(b,fr,fc,tr,tc,cap){ // returns {board,promoted}\n  var nb=clone(b),p=nb[fr][fc];nb[fr][fc]='';\n  if(cap)nb[cap[0]][cap[1]]='';\n  var promoted=false;\n  if(p==='r'&&tr===0){p='R';promoted=true}\n  else if(p==='b'&&tr===7){p='B';promoted=true}\n  nb[tr][tc]=p;return {board:nb,promoted:promoted};\n}\nfunction sideHasCapture(b,red){\n  for(var r=0;r<8;r++)for(var c=0;c<8;c++){var p=b[r][c];if(p&&(red?isRed(p):isBlack(p))&&jumpsFrom(b,r,c).length)return true}\n  return false;\n}\n// full legal turns for AI (each returns resulting board)\nfunction legalTurns(b,red){\n  var caps=[];\n  for(var r=0;r<8;r++)for(var c=0;c<8;c++){var p=b[r][c];if(p&&(red?isRed(p):isBlack(p)))expandJumps(b,r,c,caps)}\n  if(caps.length)return caps;\n  var simp=[];\n  for(var r2=0;r2<8;r2++)for(var c2=0;c2<8;c2++){var p2=b[r2][c2];if(p2&&(red?isRed(p2):isBlack(p2))){\n    simpleFrom(b,r2,c2).forEach(function(m){simp.push({board:applyMoveTo(b,r2,c2,m.to[0],m.to[1],null).board})});\n  }}\n  return simp;\n}\nfunction expandJumps(b,r,c,acc){\n  var js=jumpsFrom(b,r,c);if(!js.length)return;\n  js.forEach(function(j){\n    var res=applyMoveTo(b,r,c,j.to[0],j.to[1],j.cap);\n    if(res.promoted){acc.push({board:res.board})}\n    else{\n      var before=acc.length;\n      expandJumps(res.board,j.to[0],j.to[1],acc);\n      if(acc.length===before)acc.push({board:res.board}); // no further jump -> sequence ends\n    }\n  });\n}\n\nfunction render(){\n  var B=$('board');B.innerHTML='';\n  var tgts=highlightTargets();\n  for(var r=0;r<8;r++)for(var c=0;c<8;c++){\n    var dark=(r+c)%2===1,d=document.createElement('div');\n    d.className='sq '+(dark?'d':'l');\n    if(sel&&sel[0]===r&&sel[1]===c)d.className+=' sel';\n    if(tgts.some(function(t){return t[0]===r&&t[1]===c}))d.className+=' tgt';\n    var p=board[r][c];\n    if(p){\n      var pc=document.createElement('div');pc.className='pc '+(isRed(p)?'red':'black');\n      if(isKing(p))pc.innerHTML='<span class=\"crown\">♔</span>';\n      // mark forced-capture pieces (player's turn only)\n      if(playerTurn()&&!thinking&&isRed(p)&&forced()&&jumpsFrom(board,r,c).length&&!midJump)d.classList.add('must');\n      d.appendChild(pc);\n    }\n    (function(rr,cc){var h=function(e){if(e&&e.preventDefault)e.preventDefault();handleTap(rr,cc)};d.addEventListener('pointerup',h);d.addEventListener('click',h)})(r,c);\n    B.appendChild(d);\n  }\n  updateCounts();\n}\nfunction highlightTargets(){\n  if(!sel)return [];\n  if(forced()||midJump)return jumpsFrom(board,sel[0],sel[1]).map(function(j){return j.to});\n  return simpleFrom(board,sel[0],sel[1]).map(function(m){return m.to});\n}\nfunction forced(){return sideHasCapture(board,true)}\nfunction playerTurn(){return turn==='r'}\nvar turn='r';\n\nvar _ltKey='',_ltT=0;\nfunction handleTap(r,c){ // dedupe the pointerup+click pair on the same square\n  var k=r+'_'+c,now=Date.now();\n  if(k===_ltKey&&now-_ltT<500)return;\n  _ltKey=k;_ltT=now;onTap(r,c);\n}\nfunction dbg(m){var e=$('dbg');if(e)e.textContent=m}\nfunction onTap(r,c){\n  if(thinking||turn!=='r'){dbg('tap '+r+','+c+' ignored (turn='+turn+(thinking?', thinking':'')+')');return}\n  var p=board[r][c];\n  // tapping a target?\n  if(sel){\n    var t=highlightTargets().find(function(x){return x[0]===r&&x[1]===c});\n    if(t){dbg('move '+sel[0]+','+sel[1]+' → '+r+','+c);doPlayer(sel[0],sel[1],r,c);return}\n  }\n  if(midJump){dbg('continue the jump');return} // must continue the jump with the selected piece\n  // (re)select own piece\n  if(p&&isRed(p)){\n    if(forced()&&jumpsFrom(board,r,c).length===0){dbg('must capture with a ringed piece');haptic('warning');return}\n    sel=[r,c];haptic('selection');render();dbg('selected '+r+','+c+' — '+highlightTargets().length+' move(s)');\n  }else{sel=null;render();dbg('tapped '+r+','+c+' ('+(p||'empty')+') — nothing to do')}\n}\n\nfunction doPlayer(fr,fc,tr,tc){\n  var capturing=Math.abs(tr-fr)===2;\n  var cap=capturing?[(fr+tr)/2,(fc+tc)/2]:null;\n  history.push({board:clone(board),turn:turn}); // snapshot before move (only push once per full turn)\n  if(midJump)history.pop(); // keep only the pre-turn snapshot\n  var res=applyMoveTo(board,fr,fc,tr,tc,cap);\n  board=res.board;haptic(capturing?'medium':'light');\n  if(capturing&&!res.promoted&&jumpsFrom(board,tr,tc).length){\n    sel=[tr,tc];midJump=true;render();return; // continue multi-jump\n  }\n  sel=null;midJump=false;turn='b';render();save();updateStatus();\n  if(checkOver())return;\n  aiTurn();\n}\n\nfunction aiTurn(){\n  thinking=true;$('think').textContent='Computer is thinking…';updateStatus();\n  setTimeout(function(){\n    var best=aiBest(board,depth);\n    if(best)board=best;\n    thinking=false;$('think').textContent='';turn='r';\n    haptic('light');render();save();updateStatus();checkOver();\n  },40);\n}\n\n// ---- AI: minimax (black maximises) ----\nfunction evalBlack(b){\n  var s=0;\n  for(var r=0;r<8;r++)for(var c=0;c<8;c++){var p=b[r][c];if(!p)continue;\n    if(p==='b')s+=100+r*4;           // advance toward row7\n    else if(p==='B')s+=165;\n    else if(p==='r')s-=100+(7-r)*4;\n    else if(p==='R')s-=165;\n  }\n  return s;\n}\nfunction minimax(b,red,d,alpha,beta){\n  var moves=legalTurns(b,red);\n  if(moves.length===0)return red? INF : -INF; // side to move (red) stuck -> bad for red(good for black); black stuck -> bad for black\n  if(d===0)return evalBlack(b);\n  if(!red){ // black maximises\n    var best=-INF;\n    for(var i=0;i<moves.length;i++){var v=minimax(moves[i].board,true,d-1,alpha,beta);if(v>best)best=v;if(best>alpha)alpha=best;if(alpha>=beta)break;}\n    return best;\n  } else { // red minimises\n    var best2=INF;\n    for(var j=0;j<moves.length;j++){var v2=minimax(moves[j].board,false,d-1,alpha,beta);if(v2<best2)best2=v2;if(best2<beta)beta=best2;if(alpha>=beta)break;}\n    return best2;\n  }\n}\nfunction aiBest(b,d){\n  var moves=legalTurns(b,false);if(!moves.length)return null;\n  var best=-INF,pick=null;\n  for(var i=0;i<moves.length;i++){\n    var v=minimax(moves[i].board,true,d-1,-INF,INF);\n    if(v>best||(v===best&&Math.random()<0.3)){best=v;pick=moves[i].board}\n  }\n  return pick;\n}\n\nfunction counts(){var red=0,black=0;for(var r=0;r<8;r++)for(var c=0;c<8;c++){var p=board[r][c];if(isRed(p))red++;else if(isBlack(p))black++}return {red:red,black:black}}\nfunction updateCounts(){var c=counts();$('cRed').textContent='You: '+c.red;$('cBlack').textContent='Computer: '+c.black}\nfunction updateStatus(){\n  if(thinking){$('statusText').textContent='Computer is thinking';return}\n  if(turn==='r'){$('statusText').textContent=forced()?'Your move — you must take':'Your move'}\n  else $('statusText').textContent='Computer to move';\n}\nfunction checkOver(){ // checks the side whose turn it now is\n  var c=counts();\n  if(turn==='b'){ if(c.black===0||legalTurns(board,false).length===0){over('You win! 🎉','The computer has no moves left.');return true} }\n  else { if(c.red===0||legalTurns(board,true).length===0){over('Computer wins','You have no moves left.');return true} }\n  return false;\n}\nfunction over(t,p){$('overT').textContent=t;$('overP').textContent=p;$('sheet').classList.add('show');haptic(t.indexOf('win!')>=0?'success':'warning')}\n\n$('newBtn').onclick=function(){init();turn='r';sel=null;midJump=false;thinking=false;history=[];$('sheet').classList.remove('show');render();save();updateStatus();haptic('light')};\n$('overBtn').onclick=function(){$('newBtn').onclick()};\n$('undoBtn').onclick=function(){if(thinking||!history.length)return;var h=history.pop();board=h.board;turn='r';sel=null;midJump=false;render();save();updateStatus();haptic('light')};\nArray.prototype.forEach.call($('diffSeg').children,function(b){b.onclick=function(){depth=+b.dataset.d;Array.prototype.forEach.call($('diffSeg').children,function(x){x.classList.remove('on')});b.classList.add('on');save();haptic('selection')}});\n\nfunction save(){if(window.myllmStorage)myllmStorage.setItem('draughts',JSON.stringify({board:board,turn:turn,depth:depth}))}\nfunction load(){\n  if(!window.myllmStorage){init();render();updateStatus();return}\n  myllmStorage.getItem('draughts').then(function(v){\n    if(v)try{var s=JSON.parse(v);\n      if(s.depth){depth=s.depth;Array.prototype.forEach.call($('diffSeg').children,function(x){x.classList.toggle('on',+x.dataset.d===depth)})}\n      if(s.board){board=s.board;turn=s.turn||'r'}else init();\n    }catch(e){init()} else init();\n    render();updateStatus();\n    if(turn==='b'&&!thinking)aiTurn();\n  });\n}\nload();\n</script>\n</body>\n</html>\n", "kind": "html", "iconSymbol": "circle.grid.3x3.fill", "iconColor": "red"}