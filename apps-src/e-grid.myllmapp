{"name": "E-Grid", "kind": "html", "iconSymbol": "flag.checkered", "iconColor": "red", "html": "<!DOCTYPE html>\n<!--\n  E-Grid — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>E-Grid</title>\n<style>\n:root{--build-id:\"3b30c8afe2\";\n  --bg:var(--myllm-bg,#f2f2f7);--surface:var(--myllm-surface,#fff);\n  --text:var(--myllm-text,#0d0d0f);--muted:var(--myllm-muted,#6c6c72);\n  --border:var(--myllm-border,rgba(0,0,0,.12));\n  --radius:var(--myllm-radius,16px);\n  --font:var(--myllm-font,-apple-system,system-ui,sans-serif);\n  --accent:var(--myllm-accent,#e10600);\n  --sunk:rgba(120,120,128,.10);\n}\n@media(prefers-color-scheme:dark){:root{\n  --bg:var(--myllm-bg,#000);--surface:var(--myllm-surface,#151518);\n  --text:var(--myllm-text,#f4f4f6);--muted:var(--myllm-muted,#98989f);\n  --border:var(--myllm-border,rgba(255,255,255,.14));\n  --sunk:rgba(120,120,128,.20);\n}}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nhtml,body{height:100%}\nbody{margin:0;background:var(--bg);color:var(--text);font-family:var(--font);\n  font-size:17px;line-height:1.42;-webkit-text-size-adjust:100%;\n  display:flex;flex-direction:column;height:100dvh;overflow:hidden}\n\n/* ---------- chrome ---------- */\n#bar{flex:0 0 auto;padding:max(10px,env(safe-area-inset-top)) 16px 10px;\n  display:flex;align-items:center;gap:10px;border-bottom:1px solid var(--border);\n  background:var(--surface)}\n#bar h1{margin:0;font-size:1.22rem;font-weight:800;letter-spacing:-.03em;flex:1}\n#bar h1 em{font-style:normal;color:var(--accent)}\n.iconbtn{border:0;background:var(--sunk);color:var(--text);width:34px;height:34px;\n  border-radius:50%;font-size:1rem;display:grid;place-items:center;cursor:pointer}\n.iconbtn:active{opacity:.55}\n.iconbtn.spin{animation:spin 1s linear infinite}\n#back{font-size:1.5rem;line-height:0;padding-bottom:3px}\n#back[hidden]{display:none}\n@keyframes spin{to{transform:rotate(360deg)}}\n\n#view{flex:1 1 auto;overflow-y:auto;-webkit-overflow-scrolling:touch;\n  padding:14px 16px calc(20px + env(safe-area-inset-bottom))}\n.wrap{max-width:760px;margin:0 auto}\n\n#tabs{flex:0 0 auto;display:flex;border-top:1px solid var(--border);\n  background:var(--surface);padding-bottom:env(safe-area-inset-bottom)}\n#tabs button{flex:1;border:0;background:none;color:var(--muted);cursor:pointer;\n  padding:8px 2px 7px;font-family:inherit;font-size:.66rem;font-weight:700;\n  letter-spacing:.02em;display:flex;flex-direction:column;align-items:center;gap:2px}\n#tabs button span{font-size:1.22rem;line-height:1.05}\n#tabs button[aria-selected=true]{color:var(--accent)}\n\n/* ---------- notices ---------- */\n.notice{background:var(--sunk);border-radius:12px;padding:10px 13px;font-size:.85rem;\n  color:var(--muted);margin-bottom:14px;font-weight:550}\n.notice b{color:var(--text);font-weight:700}\n\n/* ---------- cards ---------- */\n.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);\n  overflow:hidden;margin-bottom:14px}\n.pad{padding:14px 15px}\nh2.sec{font-size:.76rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase;\n  color:var(--muted);margin:22px 2px 9px}\nh2.sec:first-child{margin-top:4px}\n\n/* hero (next race / channel header) */\n/* min-height, not img height: when a photo fails the element still has to\n   hold its caption rather than collapsing to a broken-image box. */\n.hero{position:relative;border-radius:var(--radius);overflow:hidden;margin-bottom:14px;\n  background:#111;cursor:pointer;display:block;width:100%;border:0;padding:0;text-align:left;\n  font-family:inherit;color:#fff;min-height:200px}\n.hero img{display:block;width:100%;height:200px;object-fit:cover;opacity:.82}\n.hero .veil{position:absolute;inset:0;\n  background:linear-gradient(180deg,rgba(0,0,0,.12) 0%,rgba(0,0,0,.35) 46%,rgba(0,0,0,.86) 100%)}\n.hero .body{position:absolute;left:0;right:0;bottom:0;padding:14px 15px}\n.hero .eyebrow{font-size:.68rem;font-weight:850;letter-spacing:.13em;text-transform:uppercase;\n  display:flex;align-items:center;gap:5px}\n.hero .title{font-size:1.4rem;font-weight:800;letter-spacing:-.025em;margin:3px 0 1px;\n  color:#fff;text-shadow:0 1px 12px rgba(0,0,0,.5)}\n.hero .sub{font-size:.9rem;font-weight:600;color:rgba(255,255,255,.9)}\n.cd{font-size:1.06rem;font-weight:800;font-variant-numeric:tabular-nums;color:var(--text);\n  margin-top:5px;letter-spacing:.01em}\n.hero .cd{color:#fff}\n.cd.live{color:#16a34a}\n@media(prefers-color-scheme:dark){.cd.live{color:#4ade80}}\n.hero .cd.live{color:#4ade80}\n\n/* rows */\n.row{display:flex;align-items:center;gap:12px;padding:11px 15px;cursor:pointer;\n  border-top:1px solid var(--border)}\n.row:first-child{border-top:0}\n.row:active{background:var(--sunk)}\n.row .grow{flex:1;min-width:0}\n.row .name{font-weight:680;font-size:.99rem;letter-spacing:-.01em}\n.row .meta{font-size:.82rem;color:var(--muted);font-weight:550;\n  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.row .right{text-align:right;font-size:.82rem;color:var(--muted);font-weight:650;flex:0 0 auto}\n.row .right b{display:block;color:var(--text);font-size:.92rem;font-weight:750;\n  font-variant-numeric:tabular-nums}\n.chev{color:var(--muted);opacity:.5;flex:0 0 auto;font-size:.9rem}\n.pill{flex:0 0 auto;width:38px;text-align:center;font-size:.7rem;font-weight:800;\n  color:#fff;border-radius:7px;padding:3px 0;letter-spacing:.02em}\n.tno{flex:0 0 auto;width:26px;text-align:center;font-weight:800;font-size:.95rem;\n  font-variant-numeric:tabular-nums;color:var(--muted)}\n.tno.p1{color:#d4a017}.tno.p2{color:#9aa0a6}.tno.p3{color:#b87333}\n\n/* series grid */\n.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(158px,1fr));gap:12px}\n.tile{position:relative;border-radius:14px;overflow:hidden;background:#111;cursor:pointer;\n  border:0;padding:0;font-family:inherit;text-align:left;color:#fff;display:block;min-height:100px}\n.tile img{display:block;width:100%;height:100px;object-fit:cover;opacity:.8}\n.tile .veil{position:absolute;inset:0;\n  background:linear-gradient(180deg,rgba(0,0,0,.05),rgba(0,0,0,.82))}\n.tile .body{position:absolute;left:0;right:0;bottom:0;padding:9px 10px}\n.tile .nm{font-size:.86rem;font-weight:800;letter-spacing:-.02em;line-height:1.15;\n  text-shadow:0 1px 8px rgba(0,0,0,.55)}\n.tile .nx{font-size:.7rem;font-weight:650;color:rgba(255,255,255,.82);margin-top:2px}\n.tile .star{position:absolute;top:7px;right:8px;font-size:.85rem;\n  text-shadow:0 1px 6px rgba(0,0,0,.7)}\n.tile .bar{position:absolute;left:0;top:0;bottom:0;width:4px}\n\n/* segmented control */\n.segs{display:flex;gap:6px;overflow-x:auto;padding:2px 0 12px;scrollbar-width:none}\n.segs::-webkit-scrollbar{display:none}\n.seg{flex:0 0 auto;border:1px solid var(--border);background:var(--surface);color:var(--muted);\n  border-radius:999px;padding:6px 14px;font-size:.83rem;font-weight:700;cursor:pointer;\n  font-family:inherit}\n.seg[aria-selected=true]{background:var(--text);color:var(--bg);border-color:var(--text)}\n\n/* buttons */\n.btn{display:block;width:100%;border:0;border-radius:13px;padding:13px;cursor:pointer;\n  font-family:inherit;font-size:.97rem;font-weight:750;background:var(--sunk);color:var(--text)}\n.btn.fill{background:var(--accent);color:#fff}\n.btn:active{opacity:.7}\n\n/* news */\n.news{display:flex;gap:12px;padding:12px 15px;border-top:1px solid var(--border);cursor:pointer}\n.news:first-child{border-top:0}\n.news img{width:76px;height:76px;border-radius:10px;object-fit:cover;flex:0 0 auto;\n  background:var(--sunk)}\n.news .t{font-weight:680;font-size:.94rem;line-height:1.3;letter-spacing:-.01em}\n.news .s{font-size:.78rem;color:var(--muted);margin-top:3px;font-weight:600}\n\n/* tracks */\n.track img{width:64px;height:48px;border-radius:8px;object-fit:cover;flex:0 0 auto;\n  background:var(--sunk)}\n#tsearch{width:100%;border:1px solid var(--border);background:var(--surface);color:var(--text);\n  border-radius:11px;padding:10px 13px;font-family:inherit;font-size:.95rem;margin-bottom:12px}\n#tsearch:focus{outline:2px solid var(--accent);outline-offset:-1px}\n\n/* stat strip */\n.stats{display:flex;flex-wrap:wrap;gap:1px;background:var(--border)}\n.stats div{flex:1 1 33%;background:var(--surface);padding:11px 12px}\n.stats span{display:block;font-size:.68rem;font-weight:750;letter-spacing:.06em;\n  text-transform:uppercase;color:var(--muted)}\n.stats b{font-size:1.02rem;font-weight:780;letter-spacing:-.02em}\n\n/* prose */\n.prose{font-size:.94rem;line-height:1.5}\n.prose p{margin:0 0 10px}\n.facts{margin:0;padding:0;list-style:none}\n.facts li{position:relative;padding:0 0 9px 17px;font-size:.9rem;line-height:1.45}\n.facts li:before{content:\"\";position:absolute;left:2px;top:8px;width:5px;height:5px;\n  border-radius:50%;background:var(--accent)}\n.credit{font-size:.7rem;color:var(--muted);padding:7px 15px 0;font-weight:600}\n.credit a{color:var(--muted)}\na{color:var(--accent)}\n.empty{text-align:center;color:var(--muted);font-size:.9rem;padding:26px 18px;font-weight:600}\n\n/* App Store funnel */\n.cta{display:flex;align-items:center;gap:12px;padding:14px 15px;text-decoration:none;\n  color:var(--text)}\n.cta .mark{width:44px;height:44px;border-radius:11px;flex:0 0 auto;display:grid;\n  place-items:center;font-size:1.35rem;\n  background:linear-gradient(150deg,#e10600,#7a0400);color:#fff}\n.cta .t{font-weight:750;font-size:.97rem;letter-spacing:-.01em}\n.cta .s{font-size:.8rem;color:var(--muted);font-weight:600;margin-top:1px}\n.cta .go{font-size:.82rem;font-weight:800;color:var(--accent);flex:0 0 auto}\n\n/* sheet */\n#sheet{position:fixed;inset:0;z-index:60;background:var(--bg);display:flex;\n  flex-direction:column;transform:translateY(100%);transition:transform .26s ease;\n  visibility:hidden}\n#sheet.open{transform:none;visibility:visible}\n#sheet .head{flex:0 0 auto;display:flex;align-items:center;gap:10px;\n  padding:max(10px,env(safe-area-inset-top)) 16px 10px;border-bottom:1px solid var(--border);\n  background:var(--surface)}\n#sheet .head h2{margin:0;font-size:1.02rem;font-weight:780;flex:1;letter-spacing:-.02em;\n  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n#sheetbody{flex:1 1 auto;overflow-y:auto;padding:14px 16px calc(24px + env(safe-area-inset-bottom))}\n.shot{width:100%;height:210px;object-fit:cover;display:block}\n</style>\n</head>\n<body>\n\n<div id=\"bar\">\n  <button class=\"iconbtn\" id=\"back\" data-act=\"back\" aria-label=\"Back\" hidden>‹</button>\n  <h1>E<em>-</em>Grid</h1>\n  <button class=\"iconbtn\" id=\"refresh\" data-act=\"refresh\" aria-label=\"Refresh\">⟳</button>\n</div>\n\n<main id=\"view\"><div class=\"wrap\"><div class=\"empty\">Loading…</div></div></main>\n\n<nav id=\"tabs\">\n  <button data-act=\"tab\" data-tab=\"home\" aria-selected=\"true\"><span>🏁</span>Home</button>\n  <button data-act=\"tab\" data-tab=\"series\" aria-selected=\"false\"><span>🏎️</span>Series</button>\n  <button data-act=\"tab\" data-tab=\"tracks\" aria-selected=\"false\"><span>🛣️</span>Tracks</button>\n  <button data-act=\"tab\" data-tab=\"news\" aria-selected=\"false\"><span>📰</span>News</button>\n</nav>\n\n<div id=\"sheet\" aria-hidden=\"true\">\n  <div class=\"head\">\n    <button class=\"iconbtn\" data-act=\"close\" aria-label=\"Close\">✕</button>\n    <h2 id=\"sheettitle\"></h2>\n  </div>\n  <div id=\"sheetbody\"></div>\n</div>\n\n<script>\n/* ============================================================\n   E-Grid for MyLLMos — a race hub built on the same content the\n   iOS and Android apps read. Series catalogue, track guides,\n   bios and machinery come from the E-Grid content repo; live\n   schedules and standings come from the same public APIs.\n   ============================================================ */\n\n/* The App Store listing. The \"Get E-Grid\" cards render only when this is set. */\nvar APPSTORE_URL = 'https://apps.apple.com/us/app/e-grid/id6761284626';\n\nvar CONTENT = 'https://raw.githubusercontent.com/TeamDzX/egrid-content/live/';\nvar HERO    = 'https://raw.githubusercontent.com/TeamDzX/myllm-assets/main/apps/e-grid/';\nvar K       = 'egrid1:';            /* storage key prefix */\n\n/* ---------- bridges (feature-detected; the app must run on any build) ---------- */\nvar store = window.myllmStorage || {\n  getItem: function(){ return Promise.resolve(null); },\n  setItem: function(){ return Promise.resolve(); }\n};\nfunction haptic(k){ try{ if(window.myllmHaptic) window.myllmHaptic(k||'selection'); }catch(e){} }\nfunction online(){ return typeof window.myllmFetch === 'function'; }\n\nfunction save(key, val){\n  try{ store.setItem(K+key, JSON.stringify(val)); }catch(e){}\n}\nfunction read(key){\n  try{\n    return Promise.resolve(store.getItem(K+key)).then(function(s){\n      if(!s) return null;\n      try{ return JSON.parse(s); }catch(e){ return null; }\n    }, function(){ return null; });\n  }catch(e){ return Promise.resolve(null); }\n}\n/* Each cache is one blob rather than a key per series: the bridge is async,\n   and thirteen round-trips per bucket at launch is a visible delay. */\nvar flushing = null;\nfunction flush(){\n  if(flushing) return;\n  flushing = setTimeout(function(){\n    flushing = null;\n    save('sched', S.sched);\n    save('stand', S.stand);\n    save('news', S.news);\n  }, 400);\n}\n\n/* The web view runs at a null origin, so browser-side networking is CORS-dead.\n   Everything goes through the native bridge instead. */\nfunction getText(url){\n  if(!online()) return Promise.reject(new Error('offline'));\n  return window.myllmFetch(url, {method:'GET'}).then(function(r){\n    if(!r || !r.ok) throw new Error('HTTP ' + (r ? r.status : '?'));\n    return r.body || '';\n  });\n}\nfunction getJSON(url){ return getText(url).then(function(t){ return JSON.parse(t); }); }\n\n/* ---------- state ---------- */\nvar S = {\n  channels: [], circuits: [], drivers: [], teams: [], specs: [], broadcasts: [],\n  sched: {},      /* channelID -> [race]        */\n  stand: {},      /* channelID -> {groups:[]}   */\n  news:  {},      /* channelID -> [item]        */\n  follow: ['f1'],\n  tab: 'home', channel: null, seg: 'calendar',\n  query: '', stale: false, booted: false\n};\n\n/* Baked-in catalogue: enough to open the app with no network and nothing\n   cached. Refreshed from the content repo on every launch.\n   Regenerated by build_egrid.py — edit channels.json, not this line. */\nvar FALLBACK = /*<FB>*/[{\"id\":\"f1\",\"name\":\"Formula 1\",\"tagline\":\"Grand Prix racing \\u2014 schedules, standings and stats\",\"accentHex\":\"E10600\",\"hasStandings\":true,\"comingSoon\":false},{\"id\":\"wrc\",\"name\":\"World Rally Championship\",\"tagline\":\"Rally calendar, results and news from the stages\",\"accentHex\":\"1E88E5\",\"hasStandings\":false,\"comingSoon\":false,\"calendar\":[{\"round\":1,\"name\":\"Rallye Automobile Monte Carlo\",\"location\":\"Gap, France\",\"date\":\"2026-01-25\"},{\"round\":2,\"name\":\"Rally Sweden\",\"location\":\"Umea, Sweden\",\"date\":\"2026-02-15\"},{\"round\":3,\"name\":\"Safari Rally Kenya\",\"location\":\"Nairobi, Kenya\",\"date\":\"2026-03-15\"},{\"round\":4,\"name\":\"Croatia Rally\",\"location\":\"Rijeka, Croatia\",\"date\":\"2026-04-12\"},{\"round\":5,\"name\":\"Rally Islas Canarias\",\"location\":\"Las Palmas, Spain\",\"date\":\"2026-04-26\"},{\"round\":6,\"name\":\"Rally de Portugal\",\"location\":\"Matosinhos, Portugal\",\"date\":\"2026-05-10\"},{\"round\":7,\"name\":\"Rally Japan\",\"location\":\"Toyota, Aichi, Japan\",\"date\":\"2026-05-31\"},{\"round\":8,\"name\":\"Acropolis Rally Greece\",\"location\":\"Loutraki, Greece\",\"date\":\"2026-06-28\"},{\"round\":9,\"name\":\"Rally Estonia\",\"location\":\"Tartu, Estonia\",\"date\":\"2026-07-19\"},{\"round\":10,\"name\":\"Rally Finland\",\"location\":\"Jyvaskyla, Finland\",\"date\":\"2026-08-02\"},{\"round\":11,\"name\":\"Rally del Paraguay\",\"location\":\"Encarnacion, Paraguay\",\"date\":\"2026-08-30\"},{\"round\":12,\"name\":\"Rally Chile\",\"location\":\"Concepcion, Chile\",\"date\":\"2026-09-13\"},{\"round\":13,\"name\":\"Rally Italia Sardegna\",\"location\":\"Alghero, Italy\",\"date\":\"2026-10-04\"},{\"round\":14,\"name\":\"Rally Saudi Arabia\",\"location\":\"Jeddah, Saudi Arabia\",\"date\":\"2026-11-14\"}]},{\"id\":\"f2\",\"name\":\"Formula 2\",\"tagline\":\"The final step to F1 \\u2014 every round on a Grand Prix weekend\",\"accentHex\":\"00A0DE\",\"hasStandings\":false,\"comingSoon\":false,\"calendar\":[{\"round\":1,\"name\":\"Melbourne\",\"location\":\"Albert Park Circuit, Australia\",\"date\":\"2026-03-08\"},{\"round\":2,\"name\":\"Miami\",\"location\":\"Miami International Autodrome, USA\",\"date\":\"2026-05-03\"},{\"round\":3,\"name\":\"Montreal\",\"location\":\"Circuit Gilles-Villeneuve, Canada\",\"date\":\"2026-05-24\"},{\"round\":4,\"name\":\"Monaco\",\"location\":\"Circuit de Monaco\",\"date\":\"2026-06-07\"},{\"round\":5,\"name\":\"Barcelona\",\"location\":\"Circuit de Barcelona-Catalunya, Spain\",\"date\":\"2026-06-14\"},{\"round\":6,\"name\":\"Spielberg\",\"location\":\"Red Bull Ring, Austria\",\"date\":\"2026-06-28\"},{\"round\":7,\"name\":\"Silverstone\",\"location\":\"Silverstone Circuit, Great Britain\",\"date\":\"2026-07-05\"},{\"round\":8,\"name\":\"Spa-Francorchamps\",\"location\":\"Circuit de Spa-Francorchamps, Belgium\",\"date\":\"2026-07-19\"},{\"round\":9,\"name\":\"Budapest\",\"location\":\"Hungaroring, Hungary\",\"date\":\"2026-07-26\"},{\"round\":10,\"name\":\"Monza\",\"location\":\"Autodromo Nazionale Monza, Italy\",\"date\":\"2026-09-06\"},{\"round\":11,\"name\":\"Madrid\",\"location\":\"Madrid, Spain\",\"date\":\"2026-09-13\"},{\"round\":12,\"name\":\"Baku\",\"location\":\"Baku City Circuit, Azerbaijan\",\"date\":\"2026-09-27\"},{\"round\":13,\"name\":\"Lusail\",\"location\":\"Lusail International Circuit, Qatar\",\"date\":\"2026-11-29\"},{\"round\":14,\"name\":\"Abu Dhabi\",\"location\":\"Yas Marina Circuit, UAE\",\"date\":\"2026-12-06\"}]},{\"id\":\"f3\",\"name\":\"Formula 3\",\"tagline\":\"Tomorrow's stars \\u2014 junior single-seaters on the F1 stage\",\"accentHex\":\"FF6B00\",\"hasStandings\":false,\"comingSoon\":false,\"calendar\":[{\"round\":1,\"name\":\"Melbourne\",\"location\":\"Albert Park Circuit, Australia\",\"date\":\"2026-03-08\"},{\"round\":2,\"name\":\"Sakhir\",\"location\":\"Bahrain International Circuit\",\"date\":\"2026-04-12\"},{\"round\":3,\"name\":\"Monaco\",\"location\":\"Circuit de Monaco\",\"date\":\"2026-06-07\"},{\"round\":4,\"name\":\"Barcelona\",\"location\":\"Circuit de Barcelona-Catalunya, Spain\",\"date\":\"2026-06-14\"},{\"round\":5,\"name\":\"Spielberg\",\"location\":\"Red Bull Ring, Austria\",\"date\":\"2026-06-28\"},{\"round\":6,\"name\":\"Silverstone\",\"location\":\"Silverstone Circuit, Great Britain\",\"date\":\"2026-07-05\"},{\"round\":7,\"name\":\"Spa-Francorchamps\",\"location\":\"Circuit de Spa-Francorchamps, Belgium\",\"date\":\"2026-07-19\"},{\"round\":8,\"name\":\"Budapest\",\"location\":\"Hungaroring, Hungary\",\"date\":\"2026-07-26\"},{\"round\":9,\"name\":\"Monza\",\"location\":\"Autodromo Nazionale Monza, Italy\",\"date\":\"2026-09-06\"},{\"round\":10,\"name\":\"Madrid\",\"location\":\"Madrid, Spain\",\"date\":\"2026-09-13\"}]},{\"id\":\"wec\",\"name\":\"World Endurance Championship\",\"tagline\":\"Hypercars, Le Mans and round-the-clock racing\",\"accentHex\":\"0E7C86\",\"hasStandings\":false,\"comingSoon\":false,\"calendar\":[{\"round\":1,\"name\":\"Qatar 1812 Km\",\"location\":\"Lusail International Circuit, Qatar\",\"date\":\"2026-03-28\"},{\"round\":2,\"name\":\"6 Hours of Imola\",\"location\":\"Autodromo Enzo e Dino Ferrari, Italy\",\"date\":\"2026-04-19\"},{\"round\":3,\"name\":\"6 Hours of Spa-Francorchamps\",\"location\":\"Circuit de Spa-Francorchamps, Belgium\",\"date\":\"2026-05-09\"},{\"round\":4,\"name\":\"24 Hours of Le Mans\",\"location\":\"Circuit de la Sarthe, France\",\"date\":\"2026-06-13\"},{\"round\":5,\"name\":\"6 Hours of S\\u00e3o Paulo\",\"location\":\"Interlagos, Brazil\",\"date\":\"2026-07-12\"},{\"round\":6,\"name\":\"Lone Star Le Mans\",\"location\":\"Circuit of the Americas, USA\",\"date\":\"2026-09-06\"},{\"round\":7,\"name\":\"6 Hours of Fuji\",\"location\":\"Fuji Speedway, Japan\",\"date\":\"2026-09-27\"},{\"round\":8,\"name\":\"8 Hours of Bahrain\",\"location\":\"Bahrain International Circuit\",\"date\":\"2026-11-07\"}]},{\"id\":\"formulae\",\"name\":\"Formula E\",\"tagline\":\"All-electric racing on city streets worldwide\",\"accentHex\":\"00BEC3\",\"hasStandings\":true,\"comingSoon\":false},{\"id\":\"motogp\",\"name\":\"MotoGP\",\"tagline\":\"The pinnacle of motorcycle racing \\u2014 riders, rounds and standings\",\"accentHex\":\"D81B60\",\"hasStandings\":true,\"comingSoon\":false},{\"id\":\"porschecup\",\"name\":\"Porsche Supercup\",\"tagline\":\"One-make 911 racing on the F1 stage\",\"accentHex\":\"C89B3C\",\"hasStandings\":false,\"comingSoon\":false,\"calendar\":[{\"round\":1,\"name\":\"Monaco\",\"location\":\"Circuit de Monaco\",\"date\":\"2026-06-07\"},{\"round\":2,\"name\":\"Barcelona\",\"location\":\"Circuit de Barcelona-Catalunya, Spain\",\"date\":\"2026-06-14\"},{\"round\":3,\"name\":\"Spielberg\",\"location\":\"Red Bull Ring, Austria\",\"date\":\"2026-06-28\"},{\"round\":4,\"name\":\"Spa-Francorchamps\",\"location\":\"Circuit de Spa-Francorchamps, Belgium\",\"date\":\"2026-07-19\"},{\"round\":5,\"name\":\"Budapest\",\"location\":\"Hungaroring, Hungary\",\"date\":\"2026-07-26\"},{\"round\":6,\"name\":\"Zandvoort\",\"location\":\"Circuit Zandvoort, Netherlands\",\"date\":\"2026-08-23\"},{\"round\":7,\"name\":\"Monza (double-header)\",\"location\":\"Autodromo Nazionale Monza, Italy\",\"date\":\"2026-09-06\"}]},{\"id\":\"cliocup\",\"name\":\"Clio Cup Series\",\"tagline\":\"Europe's classic one-make hot hatch battle\",\"accentHex\":\"EFDF00\",\"hasStandings\":false,\"comingSoon\":false,\"calendar\":[{\"round\":1,\"name\":\"Nogaro\",\"location\":\"Circuit Paul Armagnac, France\",\"date\":\"2026-04-06\"},{\"round\":2,\"name\":\"Paul Ricard\",\"location\":\"Circuit Paul Ricard, France\",\"date\":\"2026-04-26\"},{\"round\":3,\"name\":\"Magny-Cours\",\"location\":\"Circuit de Nevers Magny-Cours, France\",\"date\":\"2026-05-31\"},{\"round\":4,\"name\":\"Mugello\",\"location\":\"Mugello Circuit, Italy\",\"date\":\"2026-07-12\"},{\"round\":5,\"name\":\"Spa-Francorchamps\",\"location\":\"Circuit de Spa-Francorchamps, Belgium\",\"date\":\"2026-09-19\"},{\"round\":6,\"name\":\"Navarra\",\"location\":\"Circuito de Navarra, Spain\",\"date\":\"2026-10-18\"},{\"round\":7,\"name\":\"Portim\\u00e3o\",\"location\":\"Aut\\u00f3dromo Internacional do Algarve, Portugal\",\"date\":\"2026-11-08\"}]},{\"id\":\"nascar\",\"name\":\"NASCAR Cup Series\",\"tagline\":\"Stock car racing \\u2014 The Chase for the championship\",\"accentHex\":\"FFB300\",\"hasStandings\":false,\"comingSoon\":false,\"calendar\":[{\"round\":23,\"name\":\"Iowa Corn 350\",\"location\":\"Iowa Speedway\",\"date\":\"2026-08-09\"},{\"round\":24,\"name\":\"Cook Out 400\",\"location\":\"Richmond Raceway\",\"date\":\"2026-08-15\"},{\"round\":25,\"name\":\"Dollar Tree 301\",\"location\":\"New Hampshire Motor Speedway\",\"date\":\"2026-08-23\"},{\"round\":26,\"name\":\"Coke Zero Sugar 400\",\"location\":\"Daytona International Speedway\",\"date\":\"2026-08-29\"},{\"round\":27,\"name\":\"Cook Out Southern 500\",\"location\":\"Darlington Raceway\",\"date\":\"2026-09-06\"},{\"round\":28,\"name\":\"Enjoy Illinois 300\",\"location\":\"World Wide Technology Raceway\",\"date\":\"2026-09-13\"},{\"round\":29,\"name\":\"Bass Pro Shops Night Race\",\"location\":\"Bristol Motor Speedway\",\"date\":\"2026-09-19\"},{\"round\":30,\"name\":\"Hollywood Casino 400\",\"location\":\"Kansas Speedway\",\"date\":\"2026-09-27\"},{\"round\":31,\"name\":\"South Point 400\",\"location\":\"Las Vegas Motor Speedway\",\"date\":\"2026-10-04\"},{\"round\":32,\"name\":\"Bank of America 400\",\"location\":\"Charlotte Motor Speedway\",\"date\":\"2026-10-11\"},{\"round\":33,\"name\":\"Freeway Insurance 500\",\"location\":\"Phoenix Raceway\",\"date\":\"2026-10-18\"},{\"round\":34,\"name\":\"YellaWood 500\",\"location\":\"Talladega Superspeedway\",\"date\":\"2026-10-25\"},{\"round\":35,\"name\":\"Xfinity 500\",\"location\":\"Martinsville Speedway\",\"date\":\"2026-11-01\"},{\"round\":36,\"name\":\"Championship Race\",\"location\":\"Homestead-Miami Speedway\",\"date\":\"2026-11-08\"}]},{\"id\":\"indycar\",\"name\":\"IndyCar\",\"tagline\":\"American open-wheel racing, from streets to superspeedways\",\"accentHex\":\"1565C0\",\"hasStandings\":false,\"comingSoon\":false,\"calendar\":[{\"name\":\"Grand Prix of Portland\",\"location\":\"Portland International Raceway\",\"date\":\"2026-08-09\"},{\"name\":\"Streets of Markham\",\"location\":\"Markham, Ontario\",\"date\":\"2026-08-16\"},{\"name\":\"Streets of Washington\",\"location\":\"Washington, D.C.\",\"date\":\"2026-08-23\"},{\"name\":\"Milwaukee Mile \\u2014 Race 1\",\"location\":\"Milwaukee Mile, Wisconsin\",\"date\":\"2026-08-29\"},{\"name\":\"Milwaukee Mile \\u2014 Race 2\",\"location\":\"Milwaukee Mile, Wisconsin\",\"date\":\"2026-08-30\"},{\"name\":\"Season Finale\",\"location\":\"WeatherTech Raceway Laguna Seca\",\"date\":\"2026-09-06\"}]},{\"id\":\"nhra\",\"name\":\"NHRA Drag Racing\",\"tagline\":\"11,000 horsepower, four seconds at a time\",\"accentHex\":\"E53935\",\"hasStandings\":false,\"comingSoon\":false,\"calendar\":[{\"name\":\"Brainerd Nationals\",\"location\":\"Brainerd International Raceway, Minnesota\",\"date\":\"2026-08-23\"},{\"name\":\"U.S. Nationals\",\"location\":\"Lucas Oil Indianapolis Raceway Park\",\"date\":\"2026-09-07\"},{\"name\":\"Great Lakes Nationals\",\"location\":\"U.S. 131 Motorsports Park, Michigan\",\"date\":\"2026-09-20\"},{\"name\":\"Nationals at The Rock\",\"location\":\"Rockingham Dragway, North Carolina\",\"date\":\"2026-09-27\"},{\"name\":\"Midwest Nationals\",\"location\":\"World Wide Technology Raceway, Illinois\",\"date\":\"2026-10-04\"},{\"name\":\"Texas FallNationals\",\"location\":\"Texas Motorplex, Ennis\",\"date\":\"2026-10-18\"},{\"name\":\"Las Vegas Nationals\",\"location\":\"Las Vegas Motor Speedway\",\"date\":\"2026-11-01\"},{\"name\":\"NHRA Finals\",\"location\":\"Pomona Dragstrip, California\",\"date\":\"2026-11-15\"}]},{\"id\":\"imsa\",\"name\":\"IMSA SportsCar Championship\",\"tagline\":\"American endurance racing \\u2014 prototypes to Petit Le Mans\",\"accentHex\":\"2E7D32\",\"hasStandings\":false,\"comingSoon\":false,\"calendar\":[{\"round\":8,\"name\":\"SportsCar Endurance Grand Prix\",\"location\":\"Road America, Wisconsin\",\"date\":\"2026-08-02\"},{\"round\":9,\"name\":\"Michelin GT Challenge\",\"location\":\"Virginia International Raceway\",\"date\":\"2026-08-23\"},{\"round\":10,\"name\":\"Battle on the Bricks\",\"location\":\"Indianapolis Motor Speedway\",\"date\":\"2026-09-20\"},{\"round\":11,\"name\":\"Motul Petit Le Mans\",\"location\":\"Michelin Raceway Road Atlanta\",\"date\":\"2026-10-03\"}]}]/*</FB>*/;\n\n/* ============================================================\n   Content\n   ============================================================ */\nfunction applyContent(c){\n  if(c.channels && c.channels.length)  S.channels   = c.channels;\n  if(c.circuits && c.circuits.length)  S.circuits   = c.circuits;\n  if(c.drivers  && c.drivers.length)   S.drivers    = c.drivers;\n  if(c.teams    && c.teams.length)     S.teams      = c.teams;\n  if(c.specs    && c.specs.length)     S.specs      = c.specs;\n  if(c.guides   && c.guides.length)    S.broadcasts = c.guides;\n}\n\nfunction loadContent(){\n  var files = ['channels','circuits','drivers','machines','broadcasters'];\n  return Promise.all(files.map(function(f){\n    return getJSON(CONTENT + f + '.json').catch(function(){ return null; });\n  })).then(function(r){\n    var c = {};\n    if(r[0] && r[0].channels) c.channels = r[0].channels;\n    if(r[1] && r[1].circuits) c.circuits = r[1].circuits;\n    if(r[2] && r[2].drivers)  c.drivers  = r[2].drivers;\n    if(r[3]){ c.teams = r[3].teams || []; c.specs = r[3].series || []; }\n    if(r[4] && r[4].guides)   c.guides   = r[4].guides;\n    if(!c.channels) throw new Error('no content');\n    applyContent(c);\n    save('content', c);\n    return true;\n  });\n}\n\n/* ============================================================\n   Schedules — live where a series publishes one, otherwise the\n   hand-maintained calendar that ships in channels.json.\n   ============================================================ */\nfunction race(o){\n  return {\n    id: o.id, channelID: o.channelID, round: o.round || 0, name: o.name,\n    circuit: o.circuit || '', locality: o.locality || '', country: o.country || '',\n    start: o.start || null, hasTime: !!o.hasTime, sessions: o.sessions || []\n  };\n}\nfunction iso(date, time){\n  if(!date) return null;\n  var m = /^(\\d{4})-(\\d{2})-(\\d{2})/.exec(String(date));\n  if(!m) return null;\n  /* A date with no published start time is anchored to LOCAL midnight. Parsed\n     as UTC it would render as the previous day for anyone west of Greenwich —\n     which is exactly the kind of off-by-one a calendar can't afford. */\n  if(!time) return new Date(+m[1], +m[2] - 1, +m[3]).getTime();\n  var t = Date.parse(date + 'T' + (time.length > 5 ? time : time + ':00Z'));\n  return isNaN(t) ? null : t;\n}\n/* How long a race stays \"current\" once it starts: a timed event for three\n   hours, a date-only event until the end of its day. */\nfunction endOf(r){ return r.start + (r.hasTime ? 10800000 : 86400000); }\nfunction ahead(r){ return r.start && endOf(r) >= Date.now(); }\n\nfunction f1Schedule(){\n  return getJSON('https://api.jolpi.ca/ergast/f1/current.json?limit=30').then(function(j){\n    var races = ((j.MRData || {}).RaceTable || {}).Races || [];\n    return races.map(function(r){\n      var ss = [];\n      function add(label, o){\n        if(o && o.date){ var t = iso(o.date, o.time); if(t) ss.push({name:label, date:t}); }\n      }\n      add('Practice 1', r.FirstPractice);\n      add('Practice 2', r.SecondPractice);\n      add('Practice 3', r.ThirdPractice);\n      add('Sprint Qualifying', r.SprintQualifying);\n      add('Sprint', r.Sprint);\n      add('Qualifying', r.Qualifying);\n      var start = iso(r.date, r.time);\n      if(start) ss.push({name:'Race', date:start});\n      ss.sort(function(a,b){ return a.date - b.date; });\n      var loc = (r.Circuit || {}).Location || {};\n      return race({\n        id:'f1-'+r.round, channelID:'f1', round:parseInt(r.round,10)||0, name:r.raceName,\n        circuit:(r.Circuit||{}).circuitName||'', locality:loc.locality||'', country:loc.country||'',\n        start:start, hasTime:!!r.time, sessions:ss\n      });\n    });\n  });\n}\n\nvar mgpSeason = null;\nfunction motogpSeason(){\n  if(mgpSeason) return Promise.resolve(mgpSeason);\n  return getJSON('https://api.motogp.pulselive.com/motogp/v1/results/seasons').then(function(list){\n    var cur = null, i;\n    for(i = 0; i < list.length; i++){ if(list[i].current){ cur = list[i]; break; } }\n    if(!cur) cur = list[0];\n    if(!cur) throw new Error('no season');\n    mgpSeason = cur.id;\n    return mgpSeason;\n  });\n}\nfunction motogpSchedule(){\n  return motogpSeason().then(function(sid){\n    var b = 'https://api.motogp.pulselive.com/motogp/v1/results/events?seasonUuid=' + sid;\n    return Promise.all([ getJSON(b+'&isFinished=true'), getJSON(b+'&isFinished=false') ]);\n  }).then(function(r){\n    var all = (r[0] || []).concat(r[1] || []);\n    return all.map(function(e, i){\n      var end = e.date_end ? String(e.date_end).slice(0,10) : null;\n      return race({\n        id:'motogp-'+(i+1), channelID:'motogp', round:i+1,\n        name:(e.name||'').replace(/\\w\\S*/g, function(w){\n          return w.charAt(0).toUpperCase() + w.slice(1).toLowerCase();\n        }),\n        circuit:(e.circuit||{}).name||'', locality:(e.circuit||{}).name||'',\n        country:(e.country||{}).name||'', start:iso(end), hasTime:false\n      });\n    }).filter(function(r){ return r.name; });\n  });\n}\n\nvar feChamp = null;\nfunction feChampionship(){\n  if(feChamp) return Promise.resolve(feChamp);\n  return getJSON('https://api.formula-e.pulselive.com/formula-e/v1/championships').then(function(j){\n    var list = j.championships || [], cur = null, i;\n    for(i = 0; i < list.length; i++){ if(list[i].status === 'Present'){ cur = list[i]; break; } }\n    if(!cur) cur = list[list.length - 1];\n    if(!cur) throw new Error('no championship');\n    feChamp = cur.id;\n    return feChamp;\n  });\n}\nfunction feSchedule(){\n  return feChampionship().then(function(id){\n    return getJSON('https://api.formula-e.pulselive.com/formula-e/v1/races?championshipId=' + id);\n  }).then(function(j){\n    return (j.races || []).map(function(r, i){\n      return race({\n        id:'formulae-'+(r.sequence || i+1), channelID:'formulae', round:r.sequence || i+1,\n        name:r.name || ((r.city||'') + ' E-Prix'), circuit:r.city || '',\n        locality:r.city || '', country:r.country || '',\n        start:iso(r.date ? String(r.date).slice(0,10) : null), hasTime:false\n      });\n    }).filter(function(r){ return r.name; });\n  });\n}\n\nfunction staticSchedule(ch){\n  return (ch.calendar || []).map(function(r, i){\n    return race({\n      id:ch.id+'-'+(r.round || i+1), channelID:ch.id, round:r.round || i+1, name:r.name,\n      circuit:r.location || '', locality:r.location || '', country:'',\n      start:iso(r.date), hasTime:false\n    });\n  });\n}\n\nvar LIVE = {f1:f1Schedule, motogp:motogpSchedule, formulae:feSchedule};\n\n/* Resolves a channel's season, preferring live data and falling back to the\n   static calendar (and then to whatever was last cached). */\nfunction schedule(ch, force){\n  var have = S.sched[ch.id];\n  if(have && !force) return Promise.resolve(have);\n  var fn = LIVE[ch.id];\n  if(!fn || !online()){\n    var s = staticSchedule(ch);\n    if(s.length){ S.sched[ch.id] = s; return Promise.resolve(s); }\n    return Promise.resolve(have || []);\n  }\n  return fn().then(function(rows){\n    if(!rows.length) throw new Error('empty');\n    S.sched[ch.id] = rows;\n    flush();\n    return rows;\n  }).catch(function(){\n    var s = staticSchedule(ch);\n    if(s.length){ S.sched[ch.id] = s; return s; }\n    return have || [];\n  });\n}\n\n/* ============================================================\n   Standings\n   ============================================================ */\nfunction row(pos, name, detail, points, wins){\n  return {position:pos, name:name, detail:detail||'', points:points, wins:wins};\n}\nfunction f1Standings(){\n  var b = 'https://api.jolpi.ca/ergast/f1/current/';\n  return Promise.all([\n    getJSON(b + 'driverstandings.json'),\n    getJSON(b + 'constructorstandings.json')\n  ]).then(function(r){\n    function list(j, key){\n      var t = ((j.MRData || {}).StandingsTable || {}).StandingsLists || [];\n      return (t[0] && t[0][key]) || [];\n    }\n    var d = list(r[0], 'DriverStandings').map(function(s, i){\n      return row(parseInt(s.position,10) || i+1,\n        s.Driver.givenName + ' ' + s.Driver.familyName,\n        (s.Constructors && s.Constructors.length ? s.Constructors[s.Constructors.length-1].name : ''),\n        parseFloat(s.points) || 0, parseInt(s.wins,10) || 0);\n    });\n    var c = list(r[1], 'ConstructorStandings').map(function(s, i){\n      return row(parseInt(s.position,10) || i+1, s.Constructor.name,\n        s.Constructor.nationality || '', parseFloat(s.points) || 0, parseInt(s.wins,10) || 0);\n    });\n    return [{title:'Drivers', rows:d}, {title:'Constructors', rows:c}];\n  });\n}\nfunction motogpStandings(){\n  var sid;\n  return motogpSeason().then(function(id){\n    sid = id;\n    return getJSON('https://api.motogp.pulselive.com/motogp/v1/results/categories?seasonUuid=' + sid);\n  }).then(function(cats){\n    var premier = null, i;\n    for(i = 0; i < cats.length; i++){\n      if((cats[i].name || '').toLowerCase().indexOf('motogp') >= 0){ premier = cats[i]; break; }\n    }\n    if(!premier) throw new Error('no class');\n    return getJSON('https://api.motogp.pulselive.com/motogp/v1/results/standings?seasonUuid=' +\n      sid + '&categoryUuid=' + premier.id);\n  }).then(function(j){\n    var rows = (j.classification || []).map(function(r, i){\n      return row(r.position || i+1, (r.rider || {}).full_name || 'Unknown',\n        (r.team || {}).name || '', r.points || 0, r.race_wins || 0);\n    });\n    return [{title:'Riders', rows:rows}];\n  });\n}\nfunction feStandings(){\n  var id;\n  return feChampionship().then(function(c){\n    id = c;\n    var b = 'https://api.formula-e.pulselive.com/formula-e/v1/standings/';\n    return Promise.all([\n      getJSON(b + 'drivers?championshipId=' + id),\n      getJSON(b + 'teams?championshipId=' + id).catch(function(){ return []; })\n    ]);\n  }).then(function(r){\n    var d = (r[0] || []).map(function(s, i){\n      var nm = [s.driverFirstName, s.driverLastName].filter(Boolean).join(' ');\n      return row(s.driverPosition || i+1, nm || 'Unknown', title(s.driverTeamName || ''),\n        s.driverPoints || 0, null);\n    });\n    var t = (r[1] || []).map(function(s, i){\n      return row(s.teamPosition || i+1, title(s.teamName || 'Unknown'), '', s.teamPoints || 0, null);\n    });\n    var out = [{title:'Drivers', rows:d}];\n    if(t.length) out.push({title:'Teams', rows:t});\n    return out;\n  });\n}\nvar STAND = {f1:f1Standings, motogp:motogpStandings, formulae:feStandings};\n\nfunction standings(ch, force){\n  if(S.stand[ch.id] && !force) return Promise.resolve(S.stand[ch.id]);\n  var fn = STAND[ch.id];\n  if(!fn || !online()) return Promise.resolve(S.stand[ch.id] || null);\n  return fn().then(function(groups){\n    S.stand[ch.id] = groups;\n    flush();\n    return groups;\n  }).catch(function(){ return S.stand[ch.id] || null; });\n}\n\n/* ============================================================\n   News — RSS/Atom through the bridge, parsed with DOMParser\n   ============================================================ */\nfunction tagText(n, name){\n  var e = n.getElementsByTagName(name)[0];\n  return e ? (e.textContent || '').trim() : '';\n}\n/* Article art: RSS carries it as media:content / media:thumbnail / enclosure,\n   and otherwise it's the first <img> inside the description. */\nfunction itemImage(n, body){\n  var names = ['media:content', 'media:thumbnail', 'enclosure'], i, e, u, ty;\n  for(i = 0; i < names.length; i++){\n    e = n.getElementsByTagName(names[i])[0];\n    if(!e) continue;\n    u = e.getAttribute('url') || '';\n    ty = e.getAttribute('type') || '';\n    if(u && (names[i] !== 'enclosure' || ty.indexOf('image') === 0 ||\n             /\\.(jpe?g|png|webp)/i.test(u))) return u;\n  }\n  var m = (body || '').match(/<img[^>]+src=[\"']([^\"']+)[\"']/i);\n  return m ? m[1] : '';\n}\nfunction parseFeed(xml, source){\n  var doc = new DOMParser().parseFromString(xml, 'text/xml');\n  if(doc.getElementsByTagName('parsererror').length) return [];\n  var nodes = doc.getElementsByTagName('item');\n  if(!nodes.length) nodes = doc.getElementsByTagName('entry');\n  var out = [], i, n, title, link, l, body, img;\n  for(i = 0; i < nodes.length && out.length < 25; i++){\n    n = nodes[i];\n    title = tagText(n, 'title');\n    if(!title) continue;\n    link = tagText(n, 'link');\n    if(!link){\n      l = n.getElementsByTagName('link')[0];\n      if(l) link = l.getAttribute('href') || '';\n    }\n    body = tagText(n, 'description') || tagText(n, 'summary') || tagText(n, 'content');\n    img = itemImage(n, body);\n    out.push({\n      title: title,\n      link: /^https?:/.test(link) ? link : '',\n      date: Date.parse(tagText(n, 'pubDate') || tagText(n, 'published') ||\n                       tagText(n, 'updated')) || null,\n      source: source,\n      image: /^https?:/.test(img) ? img : ''\n    });\n  }\n  return out;\n}\n\nfunction news(ch, force){\n  if(S.news[ch.id] && !force) return Promise.resolve(S.news[ch.id]);\n  var feeds = ch.feeds || [];\n  if(!feeds.length || !online()) return Promise.resolve(S.news[ch.id] || []);\n  return Promise.all(feeds.map(function(f){\n    return getText(f.url).then(function(x){ return parseFeed(x, f.name); })\n                         .catch(function(){ return []; });\n  })).then(function(lists){\n    var all = [];\n    lists.forEach(function(l){ all = all.concat(l); });\n    all.sort(function(a,b){ return (b.date || 0) - (a.date || 0); });\n    all = all.slice(0, 30);\n    if(!all.length) return S.news[ch.id] || [];\n    S.news[ch.id] = all;\n    flush();\n    return all;\n  });\n}\n\n/* ============================================================\n   Matching — the content repo keys entries by matchKeys, the\n   same way the native apps resolve a guide for a race.\n   ============================================================ */\nfunction norm(s){ return (s||'').toLowerCase().replace(/[^a-z0-9 ]+/g,' ').replace(/\\s+/g,' ').trim(); }\n\nfunction bestMatch(list, haystack, channelID){\n  var hay = ' ' + norm(haystack) + ' ', best = null, bestScore = -1;\n  list.forEach(function(e){\n    var longest = -1;\n    (e.matchKeys || []).forEach(function(k){\n      var n = norm(k);\n      if(n && hay.indexOf(' ' + n) >= 0 && n.length > longest) longest = n.length;\n    });\n    if(longest < 0) return;\n    var scoped = channelID && e.channelIDs && e.channelIDs.indexOf(channelID) >= 0;\n    var score = (scoped ? 1000 : 0) + longest;\n    if(score > bestScore){ bestScore = score; best = e; }\n  });\n  return best;\n}\nfunction circuitFor(r){\n  return bestMatch(S.circuits, r.circuit + ' ' + r.name + ' ' + r.locality, r.channelID);\n}\nfunction driverFor(name, channelID){ return bestMatch(S.drivers, name, channelID); }\nfunction teamFor(name, channelID){ return bestMatch(S.teams, name, channelID); }\n\n/* Rally rounds sit in the same guide file as circuits but describe a route,\n   not a lap — no length, no corners, no lap record. Calling one \"the circuit\"\n   is simply wrong. */\nfunction isRally(c){ return !!c && (c.channelIDs || []).indexOf('wrc') >= 0; }\n\nfunction photoURL(c){\n  if(!c || !c.image || !c.image.url) return '';\n  var u = c.image.url;\n  return /^https?:/.test(u) ? u : CONTENT + u;\n}\nfunction heroFor(id){ return HERO + id + '.jpg'; }\n/* Series art is hosted, so it can fail: offline, or a series added to the\n   catalogue before its artwork lands. The accent wash stands in for it. */\nfunction wash(ch){\n  return 'background:linear-gradient(155deg,' + accent(ch) + ' -30%,#141416 72%)';\n}\nvar FALLBACK_IMG = ' onerror=\"this.remove()\"';\n\n/* ============================================================\n   Formatting\n   ============================================================ */\nfunction esc(s){\n  return String(s == null ? '' : s).replace(/[&<>\"']/g, function(c){\n    return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c];\n  });\n}\nfunction title(s){\n  return String(s||'').toLowerCase().replace(/\\b[a-z]/g, function(c){ return c.toUpperCase(); });\n}\nfunction fmtDate(t, hasTime){\n  if(!t) return 'Date to be confirmed';\n  var d = new Date(t);\n  var o = {weekday:'short', day:'numeric', month:'short'};\n  if(new Date().getFullYear() !== d.getFullYear()) o.year = 'numeric';\n  var s = d.toLocaleDateString(undefined, o);\n  if(hasTime) s += ' · ' + d.toLocaleTimeString(undefined, {hour:'2-digit', minute:'2-digit'});\n  return s;\n}\nfunction fmtTime(t){\n  return new Date(t).toLocaleString(undefined,\n    {weekday:'short', day:'numeric', month:'short', hour:'2-digit', minute:'2-digit'});\n}\nfunction ago(t){\n  if(!t) return '';\n  var s = Math.max(0, (Date.now() - t) / 1000);\n  if(s < 3600) return Math.round(s/60) + 'm ago';\n  if(s < 86400) return Math.round(s/3600) + 'h ago';\n  if(s < 604800) return Math.round(s/86400) + 'd ago';\n  return new Date(t).toLocaleDateString(undefined, {day:'numeric', month:'short'});\n}\nfunction countdown(t, hasTime){\n  var ms = t - Date.now();\n  /* A date-only event stays \"today\" for the whole day rather than\n     flipping to \"under way\" at midnight. */\n  if(ms <= 0) return (!hasTime && ms > -86400000) ? 'Race day' : 'Under way';\n  var d = Math.floor(ms/86400000), h = Math.floor(ms/3600000)%24,\n      m = Math.floor(ms/60000)%60, s = Math.floor(ms/1000)%60;\n  function p(n){ return n < 10 ? '0'+n : ''+n; }\n  if(!hasTime) return d > 0 ? (d + (d === 1 ? ' day' : ' days')) : 'Today';\n  return (d > 0 ? d + 'd ' : '') + p(h) + ':' + p(m) + ':' + p(s);\n}\nfunction accent(ch){ return ch && ch.accentHex ? '#' + ch.accentHex : 'var(--accent)'; }\nfunction channel(id){\n  for(var i = 0; i < S.channels.length; i++) if(S.channels[i].id === id) return S.channels[i];\n  return null;\n}\n\n/* ============================================================\n   Derived\n   ============================================================ */\nfunction nextIn(chid){\n  var rows = S.sched[chid] || [], best = null;\n  rows.forEach(function(r){\n    if(ahead(r) && (!best || r.start < best.start)) best = r;\n  });\n  return best;\n}\nfunction nextSession(r){\n  if(!r || !r.sessions) return null;\n  var now = Date.now(), best = null;\n  r.sessions.forEach(function(s){ if(s.date >= now && !best) best = s; });\n  return best;\n}\nfunction followed(){\n  return S.channels.filter(function(c){ return S.follow.indexOf(c.id) >= 0; });\n}\nfunction isFollowed(id){ return S.follow.indexOf(id) >= 0; }\n\n/* ============================================================\n   Views\n   ============================================================ */\nfunction ctaCard(line){\n  if(!APPSTORE_URL) return '';\n  return '<div class=\"card\"><a class=\"cta\" href=\"' + esc(APPSTORE_URL) +\n    '\" target=\"_blank\" rel=\"noopener\">' +\n    '<div class=\"mark\">🏁</div><div class=\"grow\" style=\"flex:1;min-width:0\">' +\n    '<div class=\"t\">Get E-Grid on the App Store</div><div class=\"s\">' +\n    esc(line || 'Race reminders, a home-screen widget and every series in one app.') +\n    '</div></div><div class=\"go\">Get ›</div></a></div>';\n}\n\nfunction offlineNotice(){\n  if(online()) return '';\n  return '<div class=\"notice\"><b>Offline.</b> Network access for MyLLMos apps is off, ' +\n    'so this is the last saved season. Turn it on in Settings → MyLLMos Apps to pull ' +\n    'live schedules, standings and news.</div>';\n}\n\nfunction cdSpan(t, hasTime, cls){\n  return '<div class=\"' + (cls || 'cd') + '\" data-cd=\"' + t + '\" data-ht=\"' + (hasTime ? 1 : 0) +\n    '\">' + esc(countdown(t, hasTime)) + '</div>';\n}\n\nfunction heroHTML(r, ch, eyebrow){\n  var c = circuitFor(r), img = photoURL(c) || heroFor(ch ? ch.id : 'home');\n  var sess = nextSession(r);\n  var line = sess && sess.name !== 'Race'\n    ? sess.name + ' · ' + fmtTime(sess.date)\n    : fmtDate(r.start, r.hasTime);\n  return '<button class=\"hero\" style=\"' + wash(ch) + '\" data-act=\"race\" data-ch=\"' +\n    esc(r.channelID) + '\" data-id=\"' + esc(r.id) + '\">' +\n    '<img src=\"' + esc(img) + '\" alt=\"\" loading=\"lazy\" decoding=\"async\"' + FALLBACK_IMG + '>' +\n    '<div class=\"veil\"></div><div class=\"body\">' +\n    '<div class=\"eyebrow\" style=\"color:' + accent(ch) + '\">' + esc(eyebrow || 'Next race') +\n    ' <span>›</span></div>' +\n    '<div class=\"title\">' + esc(r.name) + '</div>' +\n    '<div class=\"sub\">' + esc(line) + '</div>' +\n    (r.start ? cdSpan(sess ? sess.date : r.start, sess ? true : r.hasTime) : '') +\n    '</div></button>';\n}\n\nfunction raceRow(r, ch, showSeries){\n  var when = fmtDate(r.start, r.hasTime);\n  var past = r.start && !ahead(r);\n  return '<div class=\"row\" data-act=\"race\" data-ch=\"' + esc(r.channelID) + '\" data-id=\"' +\n    esc(r.id) + '\"' + (past ? ' style=\"opacity:.55\"' : '') + '>' +\n    '<div class=\"pill\" style=\"background:' + accent(ch) + '\">' +\n    esc(showSeries ? shortName(ch) : 'R' + (r.round || '–')) + '</div>' +\n    '<div class=\"grow\"><div class=\"name\">' + esc(r.name) + '</div>' +\n    '<div class=\"meta\">' + esc(r.circuit || r.locality || (ch ? ch.name : '')) + '</div></div>' +\n    '<div class=\"right\">' + esc(when) + '</div><div class=\"chev\">›</div></div>';\n}\n\nfunction shortName(ch){\n  if(!ch) return '—';\n  var map = {f1:'F1', f2:'F2', f3:'F3', wrc:'WRC', wec:'WEC', imsa:'IMSA', nhra:'NHRA',\n             motogp:'MGP', formulae:'FE', nascar:'CUP', indycar:'INDY',\n             porschecup:'PSC', cliocup:'CLIO'};\n  return map[ch.id] || ch.id.slice(0,4).toUpperCase();\n}\n\n/* ---------- Home ---------- */\nfunction viewHome(){\n  var h = '<div class=\"wrap\">' + offlineNotice();\n  var mine = followed();\n  var upcoming = [];\n  S.channels.forEach(function(c){\n    var n = nextIn(c.id);\n    if(n) upcoming.push({r:n, ch:c});\n  });\n  upcoming.sort(function(a,b){ return a.r.start - b.r.start; });\n\n  var lead = null;\n  for(var i = 0; i < upcoming.length; i++){\n    if(isFollowed(upcoming[i].ch.id)){ lead = upcoming[i]; break; }\n  }\n  if(!lead) lead = upcoming[0];\n\n  if(lead){\n    h += heroHTML(lead.r, lead.ch, 'Next race · ' + lead.ch.name);\n  }else{\n    h += '<div class=\"card\"><div class=\"empty\">No dates loaded yet.' +\n      (online() ? ' Pull the refresh button above.' : '') + '</div></div>';\n  }\n\n  if(mine.length){\n    h += '<h2 class=\"sec\">Your series</h2><div class=\"grid\">';\n    mine.forEach(function(c){ h += tileHTML(c); });\n    h += '</div>';\n  }\n\n  var rest = upcoming.filter(function(u){ return !lead || u.ch.id !== lead.ch.id; }).slice(0, 8);\n  if(rest.length){\n    h += '<h2 class=\"sec\">Coming up</h2><div class=\"card\">';\n    rest.forEach(function(u){ h += raceRow(u.r, u.ch, true); });\n    h += '</div>';\n  }\n\n  h += ctaCard();\n  h += '<div class=\"empty\" style=\"font-size:.76rem;padding-top:4px\">E-Grid is not affiliated ' +\n       'with, endorsed by or connected to any championship, team or governing body named here.</div>';\n  return h + '</div>';\n}\n\nfunction tileHTML(c){\n  var n = nextIn(c.id);\n  return '<button class=\"tile\" style=\"' + wash(c) + '\" data-act=\"channel\" data-ch=\"' +\n    esc(c.id) + '\">' +\n    '<img src=\"' + esc(heroFor(c.id)) + '\" alt=\"\" loading=\"lazy\" decoding=\"async\"' +\n    FALLBACK_IMG + '>' +\n    '<div class=\"veil\"></div><div class=\"bar\" style=\"background:' + accent(c) + '\"></div>' +\n    (isFollowed(c.id) ? '<div class=\"star\">★</div>' : '') +\n    '<div class=\"body\"><div class=\"nm\">' + esc(c.name) + '</div>' +\n    '<div class=\"nx\">' + esc(n ? fmtDate(n.start, false) + ' · ' + n.name : (c.tagline || '')) +\n    '</div></div></button>';\n}\n\n/* ---------- Series ---------- */\nfunction viewSeries(){\n  var h = '<div class=\"wrap\">' + offlineNotice() +\n    '<div class=\"notice\">Tap ★ on a series to follow it — followed series lead your ' +\n    'Home screen and News.</div><div class=\"grid\">';\n  S.channels.forEach(function(c){ h += tileHTML(c); });\n  return h + '</div>' + ctaCard() + '</div>';\n}\n\n/* ---------- one series ---------- */\nfunction viewChannel(){\n  var c = channel(S.channel);\n  if(!c) return '<div class=\"wrap\"><div class=\"empty\">Series not found.</div></div>';\n  var segs = ['calendar'];\n  if(STAND[c.id]) segs.push('standings');\n  if((c.feeds || []).length) segs.push('news');\n  if(machinesFor(c.id).length || specsFor(c.id).length) segs.push('machines');\n  if(broadcastFor(c.id)) segs.push('watch');\n  if((c.regulationLinks || []).length) segs.push('rules');\n  if(segs.indexOf(S.seg) < 0) S.seg = segs[0];\n\n  var labels = {calendar:'Calendar', standings:'Standings', news:'News',\n                machines:'Machines', watch:'Watch', rules:'Rules'};\n\n  var h = '<div class=\"wrap\">' +\n    '<div class=\"hero\" style=\"cursor:default;' + wash(c) + '\">' +\n    '<img src=\"' + esc(heroFor(c.id)) + '\" alt=\"\" decoding=\"async\"' + FALLBACK_IMG + '>' +\n    '<div class=\"veil\"></div><div class=\"body\">' +\n    '<div class=\"eyebrow\" style=\"color:' + accent(c) + '\">Series</div>' +\n    '<div class=\"title\">' + esc(c.name) + '</div>' +\n    '<div class=\"sub\">' + esc(c.tagline || '') + '</div></div></div>' +\n    '<button class=\"btn\" data-act=\"follow\" data-ch=\"' + esc(c.id) + '\" style=\"margin-bottom:14px' +\n    (isFollowed(c.id) ? '' : ';background:' + accent(c) + ';color:#fff') + '\">' +\n    (isFollowed(c.id) ? '★ Following' : '☆ Follow this series') + '</button>' +\n    '<div class=\"segs\">';\n  segs.forEach(function(s){\n    h += '<button class=\"seg\" data-act=\"seg\" data-seg=\"' + s + '\" aria-selected=\"' +\n      (S.seg === s) + '\">' + labels[s] + '</button>';\n  });\n  h += '</div><div id=\"segbody\">' + segBody(c) + '</div>' + ctaCard() + '</div>';\n  return h;\n}\n\nfunction segBody(c){\n  if(S.seg === 'calendar') return calendarHTML(c);\n  if(S.seg === 'standings') return standingsHTML(c);\n  if(S.seg === 'news') return newsHTML(S.news[c.id] || [], c);\n  if(S.seg === 'machines') return machinesHTML(c);\n  if(S.seg === 'watch') return watchHTML(c);\n  if(S.seg === 'rules') return rulesHTML(c);\n  return '';\n}\n\nfunction calendarHTML(c){\n  var rows = S.sched[c.id] || [];\n  if(!rows.length){\n    return '<div class=\"card\"><div class=\"empty\">' +\n      (LIVE[c.id] || (c.calendar || []).length\n        ? 'No dates loaded yet.'\n        : 'This series doesn\\'t publish a calendar we can read. Its news feed is live.') +\n      '</div></div>';\n  }\n  var next = nextIn(c.id);\n  var h = '';\n  if(next) h += heroHTML(next, c, 'Next round');\n  h += '<div class=\"card\">';\n  rows.slice().sort(function(a,b){\n    return (a.start || 8e15) - (b.start || 8e15);\n  }).forEach(function(r){ h += raceRow(r, c, false); });\n  return h + '</div>';\n}\n\nfunction standingsHTML(c){\n  var g = S.stand[c.id];\n  if(!g) return '<div class=\"card\"><div class=\"empty\">' +\n    (online() ? 'Loading standings…' : 'Standings need network access.') + '</div></div>';\n  var h = '';\n  g.forEach(function(group){\n    h += '<h2 class=\"sec\">' + esc(group.title) + '</h2><div class=\"card\">';\n    if(!group.rows.length) h += '<div class=\"empty\">Nothing published yet.</div>';\n    group.rows.forEach(function(r){\n      var bio = driverFor(r.name, c.id) || teamFor(r.name, c.id);\n      h += '<div class=\"row\"' + (bio ? ' data-act=\"bio\" data-name=\"' + esc(r.name) +\n        '\" data-ch=\"' + esc(c.id) + '\"' : ' style=\"cursor:default\"') + '>' +\n        '<div class=\"tno p' + r.position + '\">' + esc(r.position) + '</div>' +\n        '<div class=\"grow\"><div class=\"name\">' + esc(r.name) + '</div>' +\n        '<div class=\"meta\">' + esc(r.detail) +\n        (r.wins ? ' · ' + r.wins + (r.wins === 1 ? ' win' : ' wins') : '') + '</div></div>' +\n        '<div class=\"right\"><b>' + esc(fmtPoints(r.points)) + '</b>pts</div>' +\n        (bio ? '<div class=\"chev\">›</div>' : '') + '</div>';\n    });\n    h += '</div>';\n  });\n  return h;\n}\nfunction fmtPoints(p){\n  if(p == null) return '–';\n  return (Math.round(p * 100) / 100).toString();\n}\n\nfunction newsHTML(items, c){\n  if(!items.length){\n    return '<div class=\"card\"><div class=\"empty\">' +\n      (online() ? 'Fetching headlines…' : 'Headlines need network access.') + '</div></div>';\n  }\n  var h = '<div class=\"card\">';\n  items.forEach(function(n){\n    h += '<a class=\"news\" href=\"' + esc(n.link) + '\" target=\"_blank\" rel=\"noopener\" ' +\n      'style=\"text-decoration:none;color:inherit\">' +\n      (n.image ? '<img src=\"' + esc(n.image) + '\" alt=\"\" loading=\"lazy\" decoding=\"async\" ' +\n        'onerror=\"this.style.display=\\'none\\'\">' : '') +\n      '<div class=\"grow\" style=\"flex:1;min-width:0\"><div class=\"t\">' + esc(n.title) + '</div>' +\n      '<div class=\"s\">' + esc(n.source || '') + (n.date ? ' · ' + esc(ago(n.date)) : '') +\n      (c ? '' : '') + '</div></div></a>';\n  });\n  return h + '</div>';\n}\n\nfunction machinesFor(id){\n  return S.teams.filter(function(t){ return (t.channelIDs || []).indexOf(id) >= 0; });\n}\nfunction specsFor(id){\n  return S.specs.filter(function(s){ return s.channelID === id; });\n}\nfunction machinesHTML(c){\n  var h = '', specs = specsFor(c.id), teams = machinesFor(c.id);\n  specs.forEach(function(sp){\n    h += '<h2 class=\"sec\">' + esc(sp.title) + (sp.season ? ' · ' + esc(sp.season) : '') +\n      '</h2><div class=\"card\">';\n    (sp.entries || []).forEach(function(e){\n      h += '<div class=\"row\" style=\"cursor:default\"><div class=\"grow\">' +\n        '<div class=\"name\" style=\"font-weight:600\">' + esc(e.label) + '</div></div>' +\n        '<div class=\"right\"><b>' + esc(e.value) + '</b></div></div>';\n    });\n    h += '</div>';\n  });\n  if(teams.length){\n    h += '<h2 class=\"sec\">Teams</h2><div class=\"card\">';\n    teams.forEach(function(t){\n      h += '<div class=\"row\" data-act=\"team\" data-id=\"' + esc(t.id) + '\">' +\n        '<div class=\"grow\"><div class=\"name\">' + esc(t.name) + '</div>' +\n        '<div class=\"meta\">' + esc([t.base, t.chassis].filter(Boolean).join(' · ')) + '</div></div>' +\n        '<div class=\"chev\">›</div></div>';\n    });\n    h += '</div>';\n  }\n  return h || '<div class=\"card\"><div class=\"empty\">Nothing published for this series yet.</div></div>';\n}\n\nfunction broadcastFor(id){\n  for(var i = 0; i < S.broadcasts.length; i++) if(S.broadcasts[i].channelID === id) return S.broadcasts[i];\n  return null;\n}\nfunction watchHTML(c){\n  var g = broadcastFor(c.id);\n  if(!g) return '<div class=\"card\"><div class=\"empty\">No broadcast guide yet.</div></div>';\n  var home = '';\n  try{ home = (navigator.language || '').split('-')[1] || ''; }catch(e){}\n  var regions = (g.regions || []).slice().sort(function(a, b){\n    return (b.code === home ? 1 : 0) - (a.code === home ? 1 : 0);\n  });\n  var h = '';\n  regions.forEach(function(r){\n    h += '<h2 class=\"sec\">' + esc(r.country) + '</h2><div class=\"card\">';\n    (r.entries || []).forEach(function(e){\n      h += '<div class=\"row\" style=\"cursor:default\"><div class=\"grow\">' +\n        '<div class=\"name\">' + esc(e.name) + '</div>' +\n        '<div class=\"meta\">' + esc(e.note || '') + '</div></div>' +\n        '<div class=\"right\">' + esc(e.kind || '') + '</div></div>';\n    });\n    h += '</div>';\n  });\n  return h + '<div class=\"empty\" style=\"font-size:.76rem;padding-top:0\">Rights change ' +\n    'between seasons — check your provider before a session.</div>';\n}\n\nfunction rulesHTML(c){\n  var h = '<div class=\"card\">';\n  (c.regulationLinks || []).forEach(function(l){\n    h += '<a class=\"row\" href=\"' + esc(l.url) + '\" target=\"_blank\" rel=\"noopener\" ' +\n      'style=\"text-decoration:none;color:inherit\"><div class=\"grow\">' +\n      '<div class=\"name\">' + esc(l.title) + '</div>' +\n      '<div class=\"meta\">Opens in Safari</div></div><div class=\"chev\">›</div></a>';\n  });\n  return h + '</div>';\n}\n\n/* ---------- Tracks ---------- */\nfunction trackListHTML(){\n  var q = norm(S.query);\n  var list = S.circuits.filter(function(c){\n    if(!q) return true;\n    return norm(c.name + ' ' + c.location + ' ' + c.country).indexOf(q) >= 0;\n  });\n  if(!S.circuits.length){\n    return '<div class=\"card\"><div class=\"empty\">' +\n      (online() ? 'Loading track guides…' : 'Track guides need one online launch first.') +\n      '</div></div>';\n  }\n  if(!list.length){\n    return '<div class=\"card\"><div class=\"empty\">No track matches “' + esc(S.query) +\n      '”.</div></div>';\n  }\n  var h = '<div class=\"card\">';\n  list.forEach(function(c){\n    var img = photoURL(c);\n    h += '<div class=\"row track\" data-act=\"circuit\" data-id=\"' + esc(c.id) + '\">' +\n      (img ? '<img src=\"' + esc(img) + '\" alt=\"\" loading=\"lazy\" decoding=\"async\">' : '') +\n      '<div class=\"grow\"><div class=\"name\">' + esc(c.name) + '</div>' +\n      '<div class=\"meta\">' + esc(c.location || c.country || '') + '</div></div>' +\n      '<div class=\"right\">' + (c.lengthKm ? esc(c.lengthKm.toFixed(3)) + ' km' : '') +\n      '</div><div class=\"chev\">›</div></div>';\n  });\n  return h + '</div>';\n}\nfunction viewTracks(){\n  return '<div class=\"wrap\">' +\n    '<input id=\"tsearch\" type=\"search\" placeholder=\"Search ' +\n    (S.circuits.length || '') + ' tracks and rallies\" value=\"' + esc(S.query) +\n    '\" autocomplete=\"off\" autocorrect=\"off\" enterkeyhint=\"search\">' +\n    '<div id=\"tracklist\">' + trackListHTML() + '</div></div>';\n}\n\n/* ---------- News tab ---------- */\nfunction viewNews(){\n  var mine = followed();\n  var all = [];\n  mine.forEach(function(c){\n    (S.news[c.id] || []).forEach(function(n){\n      all.push({n:n, ch:c});\n    });\n  });\n  all.sort(function(a, b){ return (b.n.date || 0) - (a.n.date || 0); });\n  var h = '<div class=\"wrap\">' + offlineNotice();\n  if(!mine.length){\n    return h + '<div class=\"card\"><div class=\"empty\">Follow a series to build your news ' +\n      'feed.</div></div><button class=\"btn fill\" data-act=\"tab\" data-tab=\"series\">' +\n      'Browse series</button></div>';\n  }\n  if(!all.length){\n    return h + '<div class=\"card\"><div class=\"empty\">' +\n      (online() ? 'Fetching headlines…' : 'Headlines need network access.') +\n      '</div></div></div>';\n  }\n  h += '<div class=\"card\">';\n  all.slice(0, 60).forEach(function(x){\n    h += '<a class=\"news\" href=\"' + esc(x.n.link) + '\" target=\"_blank\" rel=\"noopener\" ' +\n      'style=\"text-decoration:none;color:inherit\">' +\n      (x.n.image ? '<img src=\"' + esc(x.n.image) + '\" alt=\"\" loading=\"lazy\" decoding=\"async\" ' +\n        'onerror=\"this.style.display=\\'none\\'\">' : '') +\n      '<div class=\"grow\" style=\"flex:1;min-width:0\"><div class=\"t\">' + esc(x.n.title) + '</div>' +\n      '<div class=\"s\" style=\"color:' + accent(x.ch) + '\">' + esc(shortName(x.ch)) +\n      '<span style=\"color:var(--muted)\"> · ' + esc(x.n.source || '') +\n      (x.n.date ? ' · ' + esc(ago(x.n.date)) : '') + '</span></div></div></a>';\n  });\n  return h + '</div>' + ctaCard() + '</div>';\n}\n\n/* ============================================================\n   Sheets\n   ============================================================ */\nfunction openSheet(title, html){\n  document.getElementById('sheettitle').textContent = title;\n  document.getElementById('sheetbody').innerHTML = html;\n  document.getElementById('sheetbody').scrollTop = 0;\n  var s = document.getElementById('sheet');\n  s.classList.add('open');\n  s.setAttribute('aria-hidden', 'false');\n  haptic('light');\n}\nfunction closeSheet(){\n  var s = document.getElementById('sheet');\n  s.classList.remove('open');\n  s.setAttribute('aria-hidden', 'true');\n}\n\nfunction raceSheet(chid, id){\n  var rows = S.sched[chid] || [], r = null;\n  rows.forEach(function(x){ if(x.id === id) r = x; });\n  if(!r) return;\n  var ch = channel(chid), c = circuitFor(r), img = photoURL(c) || heroFor(chid);\n  var h = '<div class=\"card\" style=\"margin:-14px -16px 14px;border-radius:0;border-left:0;' +\n    'border-right:0;border-top:0;' + wash(ch) + '\">' +\n    '<img class=\"shot\" src=\"' + esc(img) + '\" alt=\"\" decoding=\"async\"' + FALLBACK_IMG + '></div>';\n\n  h += '<div class=\"card\"><div class=\"pad\">' +\n    '<div style=\"font-size:.7rem;font-weight:850;letter-spacing:.1em;text-transform:uppercase;' +\n    'color:' + accent(ch) + '\">' + esc(ch ? ch.name : '') +\n    (r.round ? ' · Round ' + r.round : '') + '</div>' +\n    '<div style=\"font-size:1.25rem;font-weight:800;letter-spacing:-.025em;margin:2px 0 2px\">' +\n    esc(r.name) + '</div>' +\n    '<div style=\"color:var(--muted);font-weight:600;font-size:.9rem\">' +\n    esc([r.circuit, r.locality !== r.circuit ? r.locality : '', r.country]\n        .filter(Boolean).join(' · ')) + '</div>' +\n    (r.start ? '<div style=\"margin-top:9px;font-weight:700\">' + esc(fmtDate(r.start, r.hasTime)) +\n      '</div>' + cdSpan(r.start, r.hasTime) : '') +\n    '</div></div>';\n\n  if(r.sessions && r.sessions.length){\n    h += '<h2 class=\"sec\">Weekend schedule <span style=\"text-transform:none;letter-spacing:0;' +\n      'font-weight:600\">· your local time</span></h2><div class=\"card\">';\n    r.sessions.forEach(function(s){\n      var done = s.date < Date.now();\n      h += '<div class=\"row\" style=\"cursor:default' + (done ? ';opacity:.5' : '') + '\">' +\n        '<div class=\"grow\"><div class=\"name\">' + esc(s.name) + '</div></div>' +\n        '<div class=\"right\"><b>' + esc(fmtTime(s.date)) + '</b></div></div>';\n    });\n    h += '</div>';\n    if(APPSTORE_URL){\n      h += '<div class=\"notice\">Session reminders are a notification, which a MyLLMos app ' +\n        'can\\'t post — the E-Grid app on the App Store can.</div>';\n    }\n  }\n\n  if(c){\n    h += '<h2 class=\"sec\">' + (isRally(c) ? 'The rally' : 'The circuit') + '</h2>' +\n      circuitCardHTML(c, true);\n  }\n  h += ctaCard();\n  openSheet(r.name, h);\n}\n\nfunction circuitCardHTML(c, compact){\n  var h = '<div class=\"card\">';\n  if(!compact && photoURL(c)){\n    h += '<img class=\"shot\" src=\"' + esc(photoURL(c)) + '\" alt=\"\" decoding=\"async\"' +\n      FALLBACK_IMG + '>';\n  }\n  h += '<div class=\"stats\">';\n  if(c.lengthKm) h += '<div><span>Length</span><b>' + c.lengthKm.toFixed(3) + ' km</b></div>';\n  if(c.corners)  h += '<div><span>Corners</span><b>' + c.corners + '</b></div>';\n  if(c.firstHeld) h += '<div><span>Since</span><b>' + c.firstHeld + '</b></div>';\n  h += '</div>';\n  if(c.lapRecord && c.lapRecord.time){\n    h += '<div class=\"row\" style=\"cursor:default\"><div class=\"grow\">' +\n      '<div class=\"name\">Lap record</div><div class=\"meta\">' +\n      esc([c.lapRecord.holder, c.lapRecord.series, c.lapRecord.year].filter(Boolean).join(' · ')) +\n      '</div></div><div class=\"right\"><b>' + esc(c.lapRecord.time) + '</b></div></div>';\n  }\n  if(c.overview){\n    h += '<div class=\"pad prose\"><p>' + esc(c.overview) + '</p></div>';\n  }\n  if(c.facts && c.facts.length){\n    h += '<div class=\"pad\" style=\"padding-top:0\"><ul class=\"facts\">';\n    c.facts.forEach(function(f){ h += '<li>' + esc(f) + '</li>'; });\n    h += '</ul></div>';\n  }\n  if(c.image && c.image.credit){\n    h += '<div class=\"credit\" style=\"padding-bottom:12px\">Photo: ' + esc(c.image.credit) +\n      (c.image.licence ? ' · ' + (c.image.licenceURL\n        ? '<a href=\"' + esc(c.image.licenceURL) + '\" target=\"_blank\" rel=\"noopener\">' +\n          esc(c.image.licence) + '</a>'\n        : esc(c.image.licence)) : '') +\n      (c.image.sourceURL ? ' · <a href=\"' + esc(c.image.sourceURL) +\n        '\" target=\"_blank\" rel=\"noopener\">source</a>' : '') + '</div>';\n  }\n  return h + '</div>';\n}\n\nfunction circuitSheet(id){\n  var c = null;\n  S.circuits.forEach(function(x){ if(x.id === id) c = x; });\n  if(!c) return;\n  var h = '';\n  if(photoURL(c)){\n    h += '<div style=\"margin:-14px -16px 14px\"><img class=\"shot\" src=\"' + esc(photoURL(c)) +\n      '\" alt=\"\" decoding=\"async\"' + FALLBACK_IMG + '></div>';\n  }\n  h += '<div style=\"font-size:1.25rem;font-weight:800;letter-spacing:-.025em\">' + esc(c.name) +\n    '</div><div style=\"color:var(--muted);font-weight:600;margin-bottom:12px\">' +\n    esc(c.location || c.country || '') + '</div>';\n  h += circuitCardHTML(c, true);\n  openSheet(c.name, h);\n}\n\nfunction bioSheet(name, chid){\n  var d = driverFor(name, chid), t = !d ? teamFor(name, chid) : null;\n  var e = d || t;\n  if(!e) return;\n  var h = '<div style=\"font-size:1.3rem;font-weight:800;letter-spacing:-.03em\">' + esc(e.name) +\n    '</div>';\n  var line = d\n    ? [d.nationality, d.born ? 'born ' + d.born : ''].filter(Boolean).join(' · ')\n    : [t.country, t.firstSeason ? 'since ' + t.firstSeason : ''].filter(Boolean).join(' · ');\n  if(line) h += '<div style=\"color:var(--muted);font-weight:600;margin-bottom:12px\">' +\n    esc(line) + '</div>';\n\n  h += '<div class=\"card\"><div class=\"stats\">';\n  if(d){\n    if(d.birthplace) h += '<div><span>From</span><b style=\"font-size:.9rem\">' +\n      esc(d.birthplace) + '</b></div>';\n    if(d.debut) h += '<div><span>Debut</span><b style=\"font-size:.9rem\">' + esc(d.debut) +\n      '</b></div>';\n  }else{\n    if(t.base) h += '<div><span>Base</span><b style=\"font-size:.9rem\">' + esc(t.base) + '</b></div>';\n    if(t.chassis) h += '<div><span>Chassis</span><b style=\"font-size:.9rem\">' + esc(t.chassis) +\n      '</b></div>';\n    if(t.powerUnit) h += '<div><span>Power unit</span><b style=\"font-size:.9rem\">' +\n      esc(t.powerUnit) + '</b></div>';\n  }\n  h += '</div>';\n  var body = d ? d.bio : t.notes;\n  if(body) h += '<div class=\"pad prose\"><p>' + esc(body) + '</p></div>';\n  var facts = (d ? d.highlights : t.facts) || [];\n  if(facts.length){\n    h += '<div class=\"pad\" style=\"padding-top:0\"><ul class=\"facts\">';\n    facts.forEach(function(f){ h += '<li>' + esc(f) + '</li>'; });\n    h += '</ul></div>';\n  }\n  h += '</div>' + ctaCard();\n  openSheet(e.name, h);\n}\n\nfunction teamSheet(id){\n  var t = null;\n  S.teams.forEach(function(x){ if(x.id === id) t = x; });\n  if(t) bioSheet(t.name, (t.channelIDs || [])[0]);\n}\n\n/* ============================================================\n   Render + routing\n   ============================================================ */\nfunction render(){\n  var v = document.getElementById('view');\n  var html;\n  if(S.tab === 'home') html = viewHome();\n  else if(S.tab === 'series') html = S.channel ? viewChannel() : viewSeries();\n  else if(S.tab === 'tracks') html = viewTracks();\n  else html = viewNews();\n  v.innerHTML = html;\n  var tabs = document.querySelectorAll('#tabs button');\n  for(var i = 0; i < tabs.length; i++){\n    tabs[i].setAttribute('aria-selected', tabs[i].getAttribute('data-tab') === S.tab);\n  }\n  var inChannel = !!(S.channel && S.tab === 'series');\n  var c = inChannel ? channel(S.channel) : null;\n  document.querySelector('#bar h1').innerHTML = c ? esc(c.name) : 'E<em>-</em>Grid';\n  document.getElementById('back').hidden = !inChannel;\n  tick();\n}\n\n/* Re-renders only the active segment, so switching tabs inside a series\n   doesn't scroll the page back to the top. */\nfunction renderSeg(){\n  var c = channel(S.channel);\n  if(!c) return;\n  var b = document.getElementById('segbody');\n  if(b) b.innerHTML = segBody(c);\n  var segs = document.querySelectorAll('.seg');\n  for(var i = 0; i < segs.length; i++){\n    segs[i].setAttribute('aria-selected', segs[i].getAttribute('data-seg') === S.seg);\n  }\n  tick();\n}\n\nfunction tick(){\n  var nodes = document.querySelectorAll('[data-cd]');\n  for(var i = 0; i < nodes.length; i++){\n    var t = parseInt(nodes[i].getAttribute('data-cd'), 10);\n    var ht = nodes[i].getAttribute('data-ht') === '1';\n    var s = countdown(t, ht);\n    if(nodes[i].textContent !== s) nodes[i].textContent = s;\n    nodes[i].className = nodes[i].className.replace(/\\s*live/, '') + (s === 'Under way' ? ' live' : '');\n  }\n}\nsetInterval(tick, 1000);\n\n/* ---------- lazy loading per view ---------- */\nfunction ensureFor(tab){\n  if(tab === 'home' || tab === 'series' && !S.channel){\n    S.channels.forEach(function(c){\n      if(!S.sched[c.id]) schedule(c).then(function(){ if(S.tab === tab) render(); });\n    });\n  }\n  if(tab === 'series' && S.channel){\n    var c = channel(S.channel);\n    if(!c) return;\n    if(!S.sched[c.id]) schedule(c).then(function(){ if(S.channel === c.id) renderSeg(); });\n    if(S.seg === 'standings' && !S.stand[c.id]){\n      standings(c).then(function(){ if(S.channel === c.id && S.seg === 'standings') renderSeg(); });\n    }\n    if(S.seg === 'news' && !S.news[c.id]){\n      news(c).then(function(){ if(S.channel === c.id && S.seg === 'news') renderSeg(); });\n    }\n  }\n  if(tab === 'news'){\n    followed().forEach(function(c){\n      if(!S.news[c.id]) news(c).then(function(){ if(S.tab === 'news') render(); });\n    });\n  }\n}\n\nfunction go(tab){\n  if(S.tab === tab && tab === 'series' && S.channel){ S.channel = null; }\n  S.tab = tab;\n  if(tab !== 'series') S.channel = null;\n  render();\n  ensureFor(tab);\n  document.getElementById('view').scrollTop = 0;\n}\n\n/* ---------- events ---------- */\ndocument.addEventListener('click', function(ev){\n  var el = ev.target.closest ? ev.target.closest('[data-act]') : null;\n  if(!el) return;\n  var act = el.getAttribute('data-act');\n\n  if(act === 'tab'){ haptic('selection'); go(el.getAttribute('data-tab')); return; }\n\n  if(act === 'back'){\n    haptic('light');\n    S.channel = null;\n    render();\n    document.getElementById('view').scrollTop = 0;\n    return;\n  }\n\n  if(act === 'channel'){\n    haptic('light');\n    S.tab = 'series'; S.channel = el.getAttribute('data-ch'); S.seg = 'calendar';\n    render(); ensureFor('series');\n    document.getElementById('view').scrollTop = 0;\n    return;\n  }\n  if(act === 'seg'){\n    haptic('selection');\n    S.seg = el.getAttribute('data-seg');\n    renderSeg(); ensureFor('series');\n    return;\n  }\n  if(act === 'follow'){\n    var id = el.getAttribute('data-ch'), i = S.follow.indexOf(id);\n    if(i >= 0) S.follow.splice(i, 1); else S.follow.push(id);\n    save('follow', S.follow);\n    haptic(i >= 0 ? 'light' : 'success');\n    render(); ensureFor(S.tab);\n    return;\n  }\n  if(act === 'race'){ raceSheet(el.getAttribute('data-ch'), el.getAttribute('data-id')); return; }\n  if(act === 'circuit'){ circuitSheet(el.getAttribute('data-id')); return; }\n  if(act === 'bio'){ bioSheet(el.getAttribute('data-name'), el.getAttribute('data-ch')); return; }\n  if(act === 'team'){ teamSheet(el.getAttribute('data-id')); return; }\n  if(act === 'close'){ closeSheet(); return; }\n  if(act === 'refresh'){ refreshAll(); return; }\n});\n\n/* Only the list is rebuilt — re-rendering the view would drop the keyboard. */\ndocument.addEventListener('input', function(ev){\n  if(ev.target && ev.target.id === 'tsearch'){\n    S.query = ev.target.value;\n    var list = document.getElementById('tracklist');\n    if(list) list.innerHTML = trackListHTML();\n  }\n});\n\n/* ---------- refresh ---------- */\nvar refreshing = false;\nfunction refreshAll(){\n  if(refreshing) return;\n  if(!online()){ haptic('warning'); render(); return; }\n  refreshing = true;\n  haptic('light');\n  var btn = document.getElementById('refresh');\n  btn.classList.add('spin');\n  mgpSeason = null; feChamp = null;\n  loadContent().catch(function(){}).then(function(){\n    return Promise.all(S.channels.map(function(c){ return schedule(c, true); }));\n  }).then(function(){\n    var jobs = [];\n    Object.keys(S.stand).forEach(function(id){\n      var c = channel(id); if(c) jobs.push(standings(c, true));\n    });\n    followed().forEach(function(c){ jobs.push(news(c, true)); });\n    return Promise.all(jobs);\n  }).catch(function(){}).then(function(){\n    refreshing = false;\n    btn.classList.remove('spin');\n    render();\n    haptic('success');\n  });\n}\n\n/* ---------- boot ---------- */\nfunction hydrate(){\n  return Promise.all([read('content'), read('follow'), read('sched'),\n                      read('stand'), read('news')]).then(function(r){\n    if(r[0]) applyContent(r[0]);\n    if(r[1] && r[1].length) S.follow = r[1];\n    if(!S.channels.length && FALLBACK.length) S.channels = FALLBACK;\n    if(r[2]) S.sched = r[2];\n    if(r[3]) S.stand = r[3];\n    if(r[4]) S.news = r[4];\n    /* Series with a hand-maintained calendar need no network at all. */\n    S.channels.forEach(function(c){\n      if(!S.sched[c.id] || !S.sched[c.id].length){\n        var st = staticSchedule(c);\n        if(st.length) S.sched[c.id] = st;\n      }\n    });\n    /* A follow for a series that has since left the catalogue would render\n       an empty tile forever. */\n    S.follow = S.follow.filter(function(id){ return !!channel(id); });\n    if(!S.follow.length && S.channels.length) S.follow = [S.channels[0].id];\n  });\n}\n\nhydrate().then(function(){\n  S.booted = true;\n  render();\n  if(!online()) return;\n  loadContent().then(function(){\n    /* Content may add a series or fix a calendar — re-seed static schedules. */\n    S.channels.forEach(function(c){\n      if(!LIVE[c.id]){\n        var st = staticSchedule(c);\n        if(st.length) S.sched[c.id] = st;\n      }\n    });\n    render();\n  }).catch(function(){}).then(function(){\n    ensureFor(S.tab);\n    followed().forEach(function(c){\n      news(c).then(function(){ if(S.tab === 'news') render(); });\n    });\n  });\n});\n</script>\n</body>\n</html>\n"}