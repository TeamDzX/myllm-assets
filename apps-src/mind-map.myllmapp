{"name": "Mind Map", "html": "<!doctype html>\n<!--\n  Mind Map — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no\">\n<title>Mind Map</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"2b3258ca5d\";color-scheme:light dark;\n  --bg:#f4f4f7; --stage:#f7f7fa; --dot:rgba(30,35,60,.13); --surface:#ffffff; --ink:#1b1d24; --muted:#7a7f8c; --line:rgba(20,25,40,.09);\n  --chip:rgba(20,25,40,.05); --card-shadow:0 1px 2px rgba(20,25,45,.06),0 6px 16px rgba(20,25,45,.08);\n  --dock:rgba(255,255,255,.86); --dock-line:rgba(20,25,40,.08); --sheet:#ffffff; --scrim:rgba(15,18,30,.32);\n  --root1:#5b5ef4; --root2:#9b5cf6; --accent:#6a5cf5;\n  --font:-apple-system,\"SF Pro Text\",system-ui,sans-serif; --display:-apple-system,\"SF Pro Display\",system-ui,sans-serif; }\n@media (prefers-color-scheme:dark){ :root{\n  --bg:#0c0d12; --stage:#0f1016; --dot:rgba(255,255,255,.09); --surface:#1b1d26; --ink:#f2f3f7; --muted:#8d92a1; --line:rgba(255,255,255,.08);\n  --chip:rgba(255,255,255,.07); --card-shadow:0 1px 2px rgba(0,0,0,.4),0 8px 20px rgba(0,0,0,.35);\n  --dock:rgba(28,30,40,.86); --dock-line:rgba(255,255,255,.08); --sheet:#191b24; --scrim:rgba(0,0,0,.5);\n  --accent:#8b7dff; } }\n*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}\nhtml,body{height:100%;overflow:hidden;overscroll-behavior:none}\nbody{font-family:var(--font);color:var(--ink);background:var(--bg);height:100vh;height:100dvh;display:flex;flex-direction:column;\n  padding-top:env(safe-area-inset-top)}\nbutton{font:inherit;color:inherit;border:0;background:none;cursor:pointer}\n\n/* Header */\n.head{display:flex;align-items:center;gap:10px;padding:8px calc(12px + env(safe-area-inset-right)) 8px calc(12px + env(safe-area-inset-left));flex-shrink:0;\n  position:relative;z-index:5;background:var(--bg)}\n.tile{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;flex-shrink:0;\n  background:linear-gradient(145deg,var(--root1),var(--root2));box-shadow:0 4px 12px rgba(107,92,245,.3)}\n.tile svg{width:19px;height:19px;color:#fff}\n.ht{min-width:0;flex:1}\n.ht button{display:flex;align-items:center;gap:4px;max-width:100%;text-align:left;padding:2px 0}\n.ht h1{font-family:var(--display);font-size:17px;line-height:1.35;font-weight:650;letter-spacing:-.2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.ht .chev{width:14px;height:14px;flex-shrink:0;color:var(--muted);fill:none;stroke:currentColor;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}\n.ht p{font-size:12px;line-height:1.35;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.acts{display:flex;gap:8px;align-items:center}\n.hbtn{height:36px;min-width:36px;padding:0 10px;border-radius:11px;background:var(--chip);display:grid;place-items:center;color:var(--ink);transition:transform .12s}\n.hbtn:active{transform:scale(.93)}\n.hbtn svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}\n\n/* Stage */\n.stage{position:relative;flex:1;overflow:hidden;touch-action:none;background-color:var(--stage);\n  background-image:radial-gradient(circle,var(--dot) 1.1px,transparent 1.4px);cursor:grab}\n.stage.panning{cursor:grabbing}\n.world{position:absolute;left:0;top:0;transform-origin:0 0;will-change:transform}\n.links{position:absolute;left:0;top:0;overflow:visible;pointer-events:none}\n.links path{fill:none;stroke-linecap:round}\n.node{position:absolute;left:0;top:0;width:max-content;max-width:210px;padding:10px 14px 11px;border-radius:14px;background:var(--surface);\n  box-shadow:var(--card-shadow);font-size:15px;line-height:1.38;font-weight:500;color:var(--ink);white-space:pre-wrap;word-break:break-word;\n  overflow-wrap:anywhere;cursor:pointer;transition:box-shadow .2s;border:1px solid var(--line)}\n.node .dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:8px;vertical-align:.08em;background:var(--c)}\n.node.d1{background:color-mix(in srgb,var(--c) 14%,var(--surface));border-color:color-mix(in srgb,var(--c) 40%,transparent);\n  color:color-mix(in srgb,var(--c) 58%,var(--ink));font-weight:650;font-size:16px}\n.node.root{max-width:250px;padding:14px 20px 15px;border-radius:18px;background:linear-gradient(135deg,var(--root1),var(--root2));color:#fff;\n  font-family:var(--display);font-size:19px;line-height:1.3;font-weight:700;letter-spacing:-.2px;border:0;\n  box-shadow:0 10px 26px rgba(107,92,245,.35),0 2px 6px rgba(60,40,160,.2);text-align:center}\n.node.sel{box-shadow:0 0 0 3px var(--stage),0 0 0 5.5px var(--c,var(--accent)),var(--card-shadow)}\n.node.root.sel{box-shadow:0 0 0 3px var(--stage),0 0 0 5.5px var(--accent),0 10px 26px rgba(107,92,245,.35)}\n.node .more{display:inline-block;margin-left:8px;font-size:11.5px;font-weight:700;line-height:1.5;padding:0 7px;border-radius:999px;\n  background:var(--c,var(--accent));color:#fff;vertical-align:.1em}\n.node.root .more{background:rgba(255,255,255,.28)}\n.node.busy{animation:breathe 1.1s ease-in-out infinite}\n.node.busy::after{content:\"\";position:absolute;inset:-4px;border-radius:inherit;border:2px dashed var(--c,var(--accent));opacity:.7;animation:spin 6s linear infinite}\n@keyframes breathe{50%{filter:brightness(1.08)}}\n@keyframes spin{to{transform:rotate(360deg)}}\n.node.new{animation:pop .42s cubic-bezier(.2,.9,.3,1.25) both}\n@keyframes pop{from{opacity:0;scale:.6}to{opacity:1;scale:1}}\n.node.drop{opacity:.35}\n\n.hint{position:absolute;left:50%;bottom:calc(92px + env(safe-area-inset-bottom));transform:translateX(-50%);max-width:calc(100% - 40px);\n  text-align:center;font-size:14px;line-height:1.45;color:var(--muted);background:var(--dock);border:1px solid var(--dock-line);\n  padding:9px 14px;border-radius:14px;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);pointer-events:none;transition:opacity .3s}\n.hint.hide{opacity:0}\n\n/* Dock */\n.dock{position:absolute;left:50%;bottom:calc(12px + env(safe-area-inset-bottom));transform:translateX(-50%);display:flex;gap:2px;padding:6px;\n  background:var(--dock);border:1px solid var(--dock-line);border-radius:22px;backdrop-filter:blur(18px) saturate(1.4);-webkit-backdrop-filter:blur(18px) saturate(1.4);\n  box-shadow:0 10px 30px rgba(10,12,30,.16);max-width:calc(100% - 20px - env(safe-area-inset-left) - env(safe-area-inset-right));z-index:4}\n.dock button{min-width:58px;padding:6px 6px 5px;border-radius:15px;display:flex;flex-direction:column;align-items:center;gap:3px;color:var(--ink);transition:transform .1s,background .2s}\n.dock button:active{transform:scale(.92);background:var(--chip)}\n.dock button[disabled]{opacity:.35}\n.dock button.hide{display:none}\n.dock svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}\n.dock span{font-size:11px;line-height:1.3;font-weight:600;color:var(--muted);white-space:nowrap}\n.dock .ai svg{color:var(--accent)}\n.dock .danger svg{color:#ef5b5b}\n\n/* Toast */\n.toast{position:absolute;left:50%;top:14px;transform:translate(-50%,-10px);opacity:0;pointer-events:none;display:flex;align-items:center;gap:12px;\n  background:var(--ink);color:var(--bg);font-size:14px;line-height:1.4;font-weight:600;padding:9px 10px 9px 14px;border-radius:13px;transition:.25s;z-index:6;\n  max-width:calc(100% - 32px)}\n.toast.show{opacity:1;transform:translate(-50%,0);pointer-events:auto}\n.toast button{color:var(--bg);background:rgba(127,127,127,.35);padding:4px 10px;border-radius:9px;font-size:13px;font-weight:700}\n.toast button.hide{display:none}\n\n/* Sheets */\n.scrim{position:fixed;inset:0;background:var(--scrim);opacity:0;pointer-events:none;transition:opacity .25s;z-index:20}\n.scrim.open{opacity:1;pointer-events:auto}\n.sheet{position:fixed;left:50%;width:min(560px,calc(100% - 20px));z-index:21;background:var(--sheet);border-radius:22px;\n  box-shadow:0 18px 50px rgba(0,0,0,.28);padding:16px;opacity:0;pointer-events:none;transition:transform .3s cubic-bezier(.2,.8,.2,1),opacity .2s}\n.sheet.top{top:calc(env(safe-area-inset-top) + 8px);transform:translate(-50%,-30px)}\n.sheet.bottom{bottom:calc(10px + env(safe-area-inset-bottom));transform:translate(-50%,30px);max-height:calc(100% - env(safe-area-inset-top) - 40px);display:flex;flex-direction:column}\n.sheet.open{opacity:1;pointer-events:auto;transform:translate(-50%,0)}\n.sheet h2{font-family:var(--display);font-size:17px;line-height:1.35;font-weight:700;margin-bottom:10px;display:flex;align-items:center;justify-content:space-between}\n.sheet h2 button{font-size:15px;font-weight:600;color:var(--accent);padding:4px 2px}\n.sheet textarea,.sheet input{width:100%;border-radius:13px;border:1px solid var(--line);background:var(--chip);color:var(--ink);font:inherit;font-size:17px;line-height:1.4;\n  padding:11px 12px;resize:none;-webkit-user-select:text;user-select:text;outline:none}\n.sheet textarea:focus,.sheet input:focus{border-color:var(--accent)}\n.sheet .row{display:flex;gap:10px;margin-top:12px}\n.sheet .row button{flex:1;height:46px;border-radius:13px;font-size:16px;font-weight:600;background:var(--chip)}\n.sheet .row .go{background:linear-gradient(135deg,var(--root1),var(--root2));color:#fff}\n.sheet .row .del{flex:0 0 auto;padding:0 16px;color:#ef5b5b}\n.swatches{display:flex;gap:10px;margin-top:12px;flex-wrap:wrap}\n.swatches button{width:30px;height:30px;border-radius:50%;background:var(--c);box-shadow:0 0 0 2px var(--sheet)}\n.swatches button.on{box-shadow:0 0 0 2px var(--sheet),0 0 0 4px var(--c)}\n.swatches.hide{display:none}\n.lbl{font-size:12.5px;line-height:1.4;color:var(--muted);font-weight:600;margin-top:12px}\n.maps{list-style:none;overflow-y:auto;margin:0 -4px;-webkit-overflow-scrolling:touch}\n.maps li{display:flex;align-items:center;gap:10px;padding:10px 6px;border-radius:13px}\n.maps li.cur{background:var(--chip)}\n.maps li .m{flex:1;min-width:0;text-align:left;padding:2px 0}\n.maps li .m b{display:block;font-size:16px;line-height:1.35;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.maps li .m small{display:block;font-size:12.5px;line-height:1.4;color:var(--muted)}\n.maps li .ic{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;color:var(--muted)}\n.maps li .ic:active{background:var(--chip)}\n.maps li .ic svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}\n.maps li .yes{font-size:13px;font-weight:700;color:#fff;background:#ef5b5b;border-radius:9px;padding:6px 10px}\n.list-acts{display:flex;gap:10px;margin-top:10px}\n.list-acts button{flex:1;height:44px;border-radius:13px;font-size:15px;font-weight:600;background:var(--chip);display:flex;align-items:center;justify-content:center;gap:6px}\n.list-acts .go{background:linear-gradient(135deg,var(--root1),var(--root2));color:#fff}\n.opt{display:flex;align-items:center;gap:12px;width:100%;padding:12px 8px;border-radius:13px;text-align:left}\n.opt:active{background:var(--chip)}\n.opt .oi{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;background:var(--chip);color:var(--accent);flex-shrink:0}\n.opt .oi svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}\n.opt b{display:block;font-size:16px;line-height:1.35;font-weight:600}\n.opt small{display:block;font-size:12.5px;line-height:1.4;color:var(--muted)}\n.opt.hide{display:none}\n\n@media (prefers-reduced-motion:reduce){ .node.new,.node.busy,.node.busy::after{animation:none} .sheet,.toast{transition:opacity .15s} }\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:36px;height:36px;border-radius:11px;border:1px solid var(--line);\n  background:var(--chip);color:var(--ink);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active{transform:scale(.94)}\n.imm-acts svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style></head><body>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3.2\"/><circle cx=\"4.5\" cy=\"5.5\" r=\"1.9\"/><circle cx=\"19.5\" cy=\"5.5\" r=\"1.9\"/><circle cx=\"4.5\" cy=\"18.5\" r=\"1.9\"/><circle cx=\"19.5\" cy=\"18.5\" r=\"1.9\"/><path d=\"M9.6 10 6 7M14.4 10 18 7M9.6 14 6 17M14.4 14 18 17\"/></svg></div>\n  <div class=\"ht\"><button id=\"titleBtn\" aria-label=\"Your maps\"><h1 id=\"mapTitle\">Mind Map</h1><svg class=\"chev\" viewBox=\"0 0 24 24\"><path d=\"M6 9l6 6 6-6\"/></svg></button><p id=\"mapSub\"></p></div>\n  <div class=\"acts\">\n    <button class=\"hbtn\" id=\"mapsBtn\" aria-label=\"Your maps\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3 3 8l9 5 9-5z\"/><path d=\"M3 13l9 5 9-5\"/></svg></button>\n    <button class=\"hbtn\" id=\"exportBtn\" aria-label=\"Export\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 15V3M7.5 7.5 12 3l4.5 4.5\"/><path d=\"M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7\"/></svg></button>\n  </div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Mind Map\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n\n<div class=\"stage\" id=\"stage\">\n  <div class=\"world\" id=\"world\"><svg class=\"links\" id=\"links\" width=\"1\" height=\"1\"></svg></div>\n  <div class=\"toast\" id=\"toast\"><span id=\"toastMsg\"></span><button id=\"toastUndo\">Undo</button></div>\n  <div class=\"hint\" id=\"hint\">Tap the centre idea, then Add to branch out. Drag to move, pinch to zoom.</div>\n  <div class=\"dock\" id=\"dock\">\n    <button id=\"bAdd\" aria-label=\"Add idea\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\"/></svg><span>Add</span></button>\n    <button id=\"bEdit\" aria-label=\"Edit\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 20h4L19 9l-4-4L4 16z\"/><path d=\"M13.5 6.5l4 4\"/></svg><span>Edit</span></button>\n    <button id=\"bExpand\" class=\"ai\" aria-label=\"Expand with AI\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3l1.8 4.6L18.5 9l-4.7 1.6L12 15l-1.8-4.4L5.5 9l4.7-1.4z\"/><path d=\"M18.5 15.5l.8 1.9 1.9.7-1.9.8-.8 1.9-.8-1.9-1.9-.8 1.9-.7z\"/></svg><span>Expand</span></button>\n    <button id=\"bFold\" aria-label=\"Fold branch\"><svg viewBox=\"0 0 24 24\"><path d=\"M7 10l5-5 5 5M7 19l5-5 5 5\"/></svg><span>Fold</span></button>\n    <button id=\"bDelete\" class=\"danger\" aria-label=\"Delete\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 7h16M10 11v6M14 11v6\"/><path d=\"M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3\"/></svg><span>Delete</span></button>\n    <button id=\"bTidy\" aria-label=\"Tidy layout\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"2.6\"/><path d=\"M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M5.6 18.4l2.8-2.8M15.6 8.4l2.8-2.8\"/></svg><span>Tidy</span></button>\n    <button id=\"bFit\" aria-label=\"Fit to screen\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 9V5a1 1 0 0 1 1-1h4M15 4h4a1 1 0 0 1 1 1v4M20 15v4a1 1 0 0 1-1 1h-4M9 20H5a1 1 0 0 1-1-1v-4\"/></svg><span>Fit</span></button>\n    <button id=\"bUndo\" aria-label=\"Undo\"><svg viewBox=\"0 0 24 24\"><path d=\"M9 14 4 9l5-5\"/><path d=\"M4 9h10.5a5.5 5.5 0 0 1 0 11H11\"/></svg><span>Undo</span></button>\n  </div>\n</div>\n\n<div class=\"scrim\" id=\"scrim\"></div>\n\n<div class=\"sheet top\" id=\"editSheet\" role=\"dialog\" aria-label=\"Edit idea\">\n  <h2><span id=\"editTitle\">Edit idea</span></h2>\n  <textarea id=\"editText\" rows=\"2\" maxlength=\"120\" placeholder=\"An idea\"></textarea>\n  <div class=\"lbl\" id=\"swLbl\">Branch colour</div>\n  <div class=\"swatches\" id=\"swatches\"></div>\n  <div class=\"row\"><button class=\"del\" id=\"editDelete\">Delete</button><button id=\"editCancel\">Cancel</button><button class=\"go\" id=\"editDone\">Done</button></div>\n</div>\n\n<div class=\"sheet bottom\" id=\"mapsSheet\" role=\"dialog\" aria-label=\"Your maps\">\n  <h2><span>Your maps</span><button id=\"mapsDone\">Done</button></h2>\n  <ul class=\"maps\" id=\"mapsList\"></ul>\n  <div class=\"list-acts\"><button id=\"importBtn\">Paste an outline</button><button class=\"go\" id=\"newMap\">New map</button></div>\n</div>\n\n<div class=\"sheet bottom\" id=\"exportSheet\" role=\"dialog\" aria-label=\"Export\">\n  <h2><span>Export</span><button id=\"exportDone\">Done</button></h2>\n  <button class=\"opt\" id=\"exImage\"><span class=\"oi\"><svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"3\"/><circle cx=\"9\" cy=\"10\" r=\"2\"/><path d=\"M21 16l-5-5-9 9\"/></svg></span><span><b>Save as image</b><small>The whole map, to your photos</small></span></button>\n  <button class=\"opt\" id=\"exShare\"><span class=\"oi\"><svg viewBox=\"0 0 24 24\"><path d=\"M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01\"/></svg></span><span><b>Share as outline</b><small>Indented text for notes or a document</small></span></button>\n  <button class=\"opt\" id=\"exCopy\"><span class=\"oi\"><svg viewBox=\"0 0 24 24\"><rect x=\"9\" y=\"9\" width=\"11\" height=\"11\" rx=\"2\"/><path d=\"M5 15V5a2 2 0 0 1 2-2h8\"/></svg></span><span><b>Copy outline</b><small>Paste it anywhere</small></span></button>\n</div>\n\n<div class=\"sheet top\" id=\"importSheet\" role=\"dialog\" aria-label=\"Paste an outline\">\n  <h2><span>Paste an outline</span></h2>\n  <textarea id=\"importText\" rows=\"7\" placeholder=\"Project&#10;  Goals&#10;    Launch in May&#10;  Team&#10;    Design&#10;    Build\"></textarea>\n  <div class=\"row\"><button id=\"importCancel\">Cancel</button><button class=\"go\" id=\"importGo\">Make a map</button></div>\n</div>\n\n<script>\n'use strict';\nvar $ = function(id){ return document.getElementById(id); };\nvar PALETTE = ['#ef6a6a','#f0a13a','#2fb379','#2c9fd9','#8a6cf0','#e45fa8','#12aea0','#5f86f7'];\nvar STORE = 'mindmap.v1';\nvar SVGNS = 'http://www.w3.org/2000/svg';\n\n/* ---------- State ----------\n   A map: { id, title, rootId, nodes: { id: {id, text, parent, x, y, color, collapsed} }, updated }.\n   Positions are world coordinates; the view is a pan (tx, ty) and a zoom (sc). */\nvar db = { v:1, current:null, maps:[] };\nvar view = { tx:0, ty:0, sc:1 };\nvar selectedId = null;\nvar undoStack = [];\nvar dims = {};          // measured card sizes by node id\nvar busyIds = {};       // nodes waiting on the AI\nvar fresh = {};         // nodes to animate in on their first render\n\nfunction uid(){ return Math.random().toString(36).slice(2,9) + Date.now().toString(36).slice(-3); }\nfunction cur(){ for (var i = 0; i < db.maps.length; i++) if (db.maps[i].id === db.current) return db.maps[i]; return db.maps[0]; }\nfunction nodesOf(m){ return m.nodes; }\nfunction childrenOf(m, id){\n  var out = [];\n  for (var k in m.nodes) if (m.nodes[k].parent === id) out.push(m.nodes[k]);\n  return out.sort(function(a,b){ return (a.order||0) - (b.order||0); });\n}\nfunction depthOf(m, id){ var d = 0, n = m.nodes[id]; while (n && n.parent){ d++; n = m.nodes[n.parent]; } return d; }\nfunction branchColor(m, id){\n  var n = m.nodes[id]; if (!n || !n.parent) return null;\n  while (n.parent && m.nodes[n.parent] && m.nodes[n.parent].parent) n = m.nodes[n.parent];\n  return n.color || PALETTE[0];\n}\nfunction descendants(m, id){\n  var out = [], stack = [id];\n  while (stack.length){ var cid = stack.pop(); childrenOf(m, cid).forEach(function(c){ out.push(c.id); stack.push(c.id); }); }\n  return out;\n}\nfunction hiddenSet(m){\n  var hid = {};\n  for (var k in m.nodes) if (m.nodes[k].collapsed) descendants(m, k).forEach(function(d){ hid[d] = true; });\n  return hid;\n}\nfunction pathTo(m, id){ var p = [], n = m.nodes[id]; while (n){ p.unshift(n.text); n = n.parent ? m.nodes[n.parent] : null; } return p; }\nfunction countNodes(m){ return Object.keys(m.nodes).length; }\n\nfunction newMap(title, rootText){\n  var rid = uid(), m = { id: uid(), title: title || 'Untitled map', rootId: rid, nodes: {}, updated: Date.now() };\n  m.nodes[rid] = { id: rid, text: rootText || title || 'Central idea', parent: null, x: 0, y: 0 };\n  return m;\n}\nfunction addNode(m, parentId, text, x, y){\n  var p = m.nodes[parentId], id = uid(), sibs = childrenOf(m, parentId);\n  var n = { id: id, text: text, parent: parentId, x: x, y: y, order: sibs.length ? (sibs[sibs.length-1].order||0) + 1 : 0 };\n  if (!p.parent){ // a new main branch takes the next colour nobody is using\n    var used = sibs.map(function(s){ return s.color; });\n    n.color = PALETTE.filter(function(c){ return used.indexOf(c) < 0; })[0] || PALETTE[sibs.length % PALETTE.length];\n  }\n  m.nodes[id] = n; fresh[id] = true;\n  return n;\n}\nfunction seed(){\n  var m = newMap('Weekend trip', 'Weekend trip');\n  var r = m.rootId;\n  var where = addNode(m, r, 'Where', 0, 0), food = addNode(m, r, 'Food', 0, 0), pack = addNode(m, r, 'Pack', 0, 0), budget = addNode(m, r, 'Budget', 0, 0);\n  addNode(m, where.id, 'The coast', 0, 0); addNode(m, where.id, 'Lake District', 0, 0);\n  addNode(m, food.id, 'Picnic lunch', 0, 0); addNode(m, food.id, 'Local market', 0, 0);\n  addNode(m, pack.id, 'Walking boots', 0, 0); addNode(m, pack.id, 'Camera', 0, 0); addNode(m, pack.id, 'Snacks', 0, 0);\n  addNode(m, budget.id, 'About £250', 0, 0);\n  fresh = {};\n  return m;\n}\n\n/* ---------- Storage ---------- */\nvar saveTimer = null;\nfunction saveNow(){\n  var m = cur(); if (m) m.updated = Date.now();\n  var data = JSON.stringify(db);\n  try { if (window.myllmStorage){ myllmStorage.setItem(STORE, data); return; } } catch(e){}\n  try { localStorage.setItem(STORE, data); } catch(e){}\n}\nfunction save(){ clearTimeout(saveTimer); saveTimer = setTimeout(saveNow, 250); }\nfunction validMap(m){ return m && typeof m.id === 'string' && m.nodes && typeof m.nodes === 'object' && m.nodes[m.rootId]; }\nfunction applyStored(v){\n  var ok = false;\n  if (v){ try { var d = JSON.parse(v); if (d && Array.isArray(d.maps)){ var maps = d.maps.filter(validMap); if (maps.length){ db = { v:1, current: d.current, maps: maps }; ok = true; } } } catch(e){} }\n  if (!ok){ var s = seed(); db = { v:1, current: s.id, maps: [s] }; }\n  if (!db.maps.some(function(m){ return m.id === db.current; })) db.current = db.maps[0].id;\n  return !ok;\n}\nfunction load(done){\n  function finish(v){ var seeded = applyStored(v); done(seeded); }\n  try { if (window.myllmStorage){ myllmStorage.getItem(STORE).then(finish, function(){ finish(null); }); return; } } catch(e){}\n  var v = null; try { v = localStorage.getItem(STORE); } catch(e){} finish(v);\n}\n\n/* ---------- Undo ---------- */\nfunction snapshot(){ return JSON.stringify({ current: db.current, map: cur() }); }\nfunction pushUndo(){ undoStack.push(snapshot()); if (undoStack.length > 40) undoStack.shift(); updateDock(); }\nfunction undo(){\n  var s = undoStack.pop(); if (!s) return;\n  var d = JSON.parse(s);\n  var idx = db.maps.findIndex(function(m){ return m.id === d.map.id; });\n  if (idx >= 0) db.maps[idx] = d.map; else db.maps.push(d.map);\n  db.current = d.current;\n  if (selectedId && !cur().nodes[selectedId]) selectedId = null;\n  haptic('light'); render(); save();\n}\n\n/* ---------- Rendering ---------- */\nvar world = $('world'), stage = $('stage'), links = $('links');\nvar nodeEls = {};\nfunction applyView(){\n  world.style.transform = 'translate(' + view.tx + 'px,' + view.ty + 'px) scale(' + view.sc + ')';\n  var g = 26 * view.sc;\n  stage.style.backgroundSize = g + 'px ' + g + 'px';\n  stage.style.backgroundPosition = view.tx + 'px ' + view.ty + 'px';\n}\nfunction nodeLabel(m, n, el){\n  el.textContent = '';\n  var d = depthOf(m, n.id);\n  if (d >= 2){ var dot = document.createElement('span'); dot.className = 'dot'; el.appendChild(dot); }\n  el.appendChild(document.createTextNode(n.text));\n  if (n.collapsed){ var c = descendants(m, n.id).length; if (c){ var b = document.createElement('span'); b.className = 'more'; b.textContent = '+' + c; el.appendChild(b); } }\n}\nfunction render(){\n  var m = cur(), hid = hiddenSet(m);\n  // cards\n  var seen = {};\n  for (var id in m.nodes){\n    if (hid[id]) continue;\n    var n = m.nodes[id], el = nodeEls[id];\n    if (!el){ el = document.createElement('div'); el.className = 'node'; el.dataset.id = id; world.appendChild(el); nodeEls[id] = el; }\n    var d = depthOf(m, id), col = branchColor(m, id);\n    el.className = 'node' + (d === 0 ? ' root' : d === 1 ? ' d1' : '') + (id === selectedId ? ' sel' : '') + (busyIds[id] ? ' busy' : '') + (fresh[id] ? ' new' : '');\n    if (col) el.style.setProperty('--c', col); else el.style.removeProperty('--c');\n    var sig = n.text + '|' + (n.collapsed ? descendants(m, id).length : '') + '|' + d;\n    if (el.dataset.sig !== sig){ nodeLabel(m, n, el); el.dataset.sig = sig; }\n    el.setAttribute('role', 'button'); el.setAttribute('aria-label', n.text);\n    seen[id] = true;\n  }\n  for (var k in nodeEls) if (!seen[k]){ nodeEls[k].remove(); delete nodeEls[k]; delete dims[k]; }\n  fresh = {};\n  // measure, then place\n  for (var k2 in nodeEls){ var e = nodeEls[k2]; dims[k2] = { w: e.offsetWidth, h: e.offsetHeight }; }\n  place();\n  applyView();\n  updateHeader(); updateDock();\n}\nfunction place(){\n  var m = cur();\n  for (var id in nodeEls){\n    var n = m.nodes[id], dm = dims[id] || { w: 0, h: 0 };\n    nodeEls[id].style.transform = 'translate(' + (n.x - dm.w/2) + 'px,' + (n.y - dm.h/2) + 'px)';\n  }\n  drawLinks();\n}\nfunction linkPath(p, c, pw, cw){\n  // leave the parent from its side edge, arrive at the child's near edge\n  var dir = c.x >= p.x ? 1 : -1;\n  var x1 = p.x + dir * pw/2 * .72, y1 = p.y, x2 = c.x - dir * cw/2, y2 = c.y;\n  if (Math.abs(c.x - p.x) < (pw + cw) / 2){ x1 = p.x; x2 = c.x; }\n  var mx = (x2 - x1) * .55;\n  return 'M' + x1.toFixed(1) + ',' + y1.toFixed(1) + ' C' + (x1 + mx).toFixed(1) + ',' + y1.toFixed(1) + ' ' + (x2 - mx).toFixed(1) + ',' + y2.toFixed(1) + ' ' + x2.toFixed(1) + ',' + y2.toFixed(1);\n}\nfunction drawLinks(){\n  var m = cur(), html = '';\n  for (var id in nodeEls){\n    var n = m.nodes[id]; if (!n.parent || !nodeEls[n.parent]) continue;\n    var p = m.nodes[n.parent], d = depthOf(m, id), col = branchColor(m, id) || '#999';\n    var w = d === 1 ? 3.4 : d === 2 ? 2.4 : 1.8;\n    html += '<path d=\"' + linkPath(p, n, (dims[p.id]||{w:0}).w, (dims[id]||{w:0}).w) + '\" stroke=\"' + col + '\" stroke-width=\"' + w + '\" stroke-opacity=\"' + (d === 1 ? .85 : .6) + '\"/>';\n  }\n  links.innerHTML = html;\n}\nfunction updateHeader(){\n  var m = cur();\n  $('mapTitle').textContent = m.title;\n  var n = countNodes(m);\n  $('mapSub').textContent = n + (n === 1 ? ' idea' : ' ideas') + (db.maps.length > 1 ? ' · ' + db.maps.length + ' maps' : '');\n  $('hint').classList.toggle('hide', n > 1);\n}\nfunction aiAvailable(){ return typeof window.myllmAskJSON === 'function' || typeof window.myllmAsk === 'function'; }\nfunction updateDock(){\n  var m = cur(), sel = selectedId && m.nodes[selectedId];\n  var isRoot = sel && !sel.parent, hasKids = sel && childrenOf(m, selectedId).length > 0;\n  $('bEdit').classList.toggle('hide', !sel);\n  $('bExpand').classList.toggle('hide', !sel || !aiAvailable());\n  $('bFold').classList.toggle('hide', !sel || !hasKids || isRoot);\n  $('bDelete').classList.toggle('hide', !sel || isRoot);\n  $('bTidy').classList.toggle('hide', !!sel);\n  $('bFit').classList.toggle('hide', !!sel);\n  $('bUndo').classList.toggle('hide', !undoStack.length);\n  if (sel){ $('bFold').querySelector('span').textContent = sel.collapsed ? 'Unfold' : 'Fold'; }\n  $('bAdd').querySelector('span').textContent = sel ? 'Add' : 'Add idea';\n}\n\n/* ---------- Layout ----------\n   Tidy: a two-sided tree. Main branches alternate left and right, balanced by\n   how many ideas each carries; each side is a tidy horizontal tree. */\nvar GAPX = 56, GAPY = 16;\nfunction gapX(){ return oneSidedLayout() ? 30 : GAPX; }\nfunction subtreeH(m, id, hid){\n  var kids = childrenOf(m, id).filter(function(c){ return !hid[c.id]; });\n  var own = (dims[id] || { h: 40 }).h;\n  if (!kids.length || m.nodes[id].collapsed) return own;\n  var sum = 0; kids.forEach(function(k, i){ sum += subtreeH(m, k.id, hid) + (i ? GAPY : 0); });\n  return Math.max(own, sum);\n}\nfunction layoutSide(m, id, x, yTop, dir, hid, out){\n  var h = subtreeH(m, id, hid), dm = dims[id] || { w: 120, h: 40 };\n  out[id] = { x: x, y: yTop + h/2 };\n  if (m.nodes[id].collapsed) return;\n  var kids = childrenOf(m, id).filter(function(c){ return !hid[c.id]; });\n  var sum = 0; kids.forEach(function(k, i){ sum += subtreeH(m, k.id, hid) + (i ? GAPY : 0); });\n  var y = yTop + (h - sum) / 2;\n  kids.forEach(function(k){\n    var kh = subtreeH(m, k.id, hid), kw = (dims[k.id] || { w: 120 }).w;\n    layoutSide(m, k.id, x + dir * (dm.w/2 + gapX() + kw/2), y, dir, hid, out);\n    y += kh + GAPY;\n  });\n}\nfunction computeTidy(m){\n  var hid = hiddenSet(m), root = m.nodes[m.rootId], rd = dims[root.id] || { w: 160, h: 50 };\n  var out = {}; out[root.id] = { x: root.x, y: root.y };\n  var kids = childrenOf(m, root.id);\n  var sides = [[], []], hs = [0, 0];\n  // Portrait: one side only, stacked down the tall screen, so the whole map\n  // stays readable. Wide screens: both sides, balanced by size.\n  var oneSided = oneSidedLayout();\n  kids.forEach(function(k){ var h = subtreeH(m, k.id, hid); var s = oneSided || hs[0] <= hs[1] ? 0 : 1; sides[s].push(k); hs[s] += h + GAPY * 2; });\n  [0, 1].forEach(function(s){\n    var dir = s === 0 ? 1 : -1, list = sides[s], total = 0;\n    list.forEach(function(k, i){ total += subtreeH(m, k.id, hid) + (i ? GAPY * 2 : 0); });\n    var y = root.y - total / 2;\n    list.forEach(function(k){\n      var kh = subtreeH(m, k.id, hid), kw = (dims[k.id] || { w: 120 }).w;\n      layoutSide(m, k.id, root.x + dir * (rd.w/2 + gapX() * 1.5 + kw/2), y, dir, hid, out);\n      y += kh + GAPY * 2;\n    });\n  });\n  return out;\n}\nfunction oneSidedLayout(){ return stage.clientWidth < 600 && stage.clientHeight > stage.clientWidth; }\nvar anim = null;\nfunction animateTo(target, ms, then){\n  var m = cur(), from = {};\n  for (var id in target){ if (m.nodes[id]) from[id] = { x: m.nodes[id].x, y: m.nodes[id].y }; }\n  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;\n  if (anim) cancelAnimationFrame(anim);\n  var t0 = performance.now(); ms = reduce || ms === 0 ? 0 : (ms || 420);\n  function step(t){\n    var k = ms ? Math.min(1, (t - t0) / ms) : 1, e = 1 - Math.pow(1 - k, 3);\n    for (var id in from){ var n = m.nodes[id]; if (!n) continue; n.x = from[id].x + (target[id].x - from[id].x) * e; n.y = from[id].y + (target[id].y - from[id].y) * e; }\n    place();\n    if (k < 1) anim = requestAnimationFrame(step); else { anim = null; if (then) then(); }\n  }\n  anim = requestAnimationFrame(step);\n}\nfunction tidy(record){\n  if (record !== false) pushUndo();\n  var m = cur(); render();\n  animateTo(computeTidy(m), 460, function(){ save(); fit(true); });\n}\n/* Where a new child goes: beside its parent, away from the centre, below its last sibling. */\nfunction spotFor(m, parentId){\n  var p = m.nodes[parentId], root = m.nodes[m.rootId], pd = dims[parentId] || { w: 140, h: 40 };\n  var sibs = childrenOf(m, parentId);\n  if (!p.parent){\n    var right = sibs.filter(function(s){ return s.x >= root.x; }).length, left = sibs.length - right;\n    var dir = oneSidedLayout() || right <= left ? 1 : -1, side = sibs.filter(function(s){ return dir > 0 ? s.x >= root.x : s.x < root.x; });\n    var yy = side.length ? Math.max.apply(null, side.map(function(s){ return s.y; })) + 70 : root.y - 30;\n    return { x: root.x + dir * (pd.w/2 + GAPX * 1.5 + 70), y: yy };\n  }\n  var dir2 = p.x >= root.x ? 1 : -1;\n  var y = sibs.length ? Math.max.apply(null, sibs.map(function(s){ return s.y; })) + 54 : p.y;\n  return { x: p.x + dir2 * (pd.w/2 + GAPX + 70), y: y };\n}\n\n/* ---------- View ---------- */\nfunction fit(animate){\n  var m = cur(), hid = hiddenSet(m), minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;\n  for (var id in m.nodes){ if (hid[id]) continue; var n = m.nodes[id], d = dims[id] || { w: 120, h: 40 };\n    minX = Math.min(minX, n.x - d.w/2); maxX = Math.max(maxX, n.x + d.w/2); minY = Math.min(minY, n.y - d.h/2); maxY = Math.max(maxY, n.y + d.h/2); }\n  var W = stage.clientWidth, H = stage.clientHeight, padX = oneSidedLayout() ? 14 : 28, padTop = 24, padBot = 100;\n  var scW = (W - padX*2) / Math.max(1, maxX - minX), scH = (H - padTop - padBot) / Math.max(1, maxY - minY);\n  var sc = Math.min(scW, scH, 1.1), tall = false;\n  // Fitting a tall map to the screen height makes labels unreadable; below\n  // ~0.8 fit the width instead and let the map scroll vertically, from the top.\n  if (sc < .8){ sc = Math.min(1.1, Math.max(.8, scW)); tall = scH < sc; }\n  sc = Math.max(.25, sc);\n  var wide = (maxX - minX) * sc > W - padX*2;   // still wider: start from the left, pan for the rest\n  var target = { sc: sc, tx: wide ? padX - minX * sc : W/2 - (minX + maxX)/2 * sc,\n    ty: tall ? padTop - minY * sc : padTop + (H - padTop - padBot)/2 - (minY + maxY)/2 * sc };\n  if (!animate || matchMedia('(prefers-reduced-motion: reduce)').matches){ view = target; applyView(); return; }\n  var from = { tx: view.tx, ty: view.ty, sc: view.sc }, t0 = performance.now();\n  (function step(t){ var k = Math.min(1, (t - t0) / 380), e = 1 - Math.pow(1 - k, 3);\n    view.tx = from.tx + (target.tx - from.tx) * e; view.ty = from.ty + (target.ty - from.ty) * e; view.sc = from.sc + (target.sc - from.sc) * e;\n    applyView(); if (k < 1) requestAnimationFrame(step); })(t0);\n}\nfunction ensureVisible(id){\n  var m = cur(), n = m.nodes[id], d = dims[id] || { w: 120, h: 40 };\n  var sx = n.x * view.sc + view.tx, sy = n.y * view.sc + view.ty, W = stage.clientWidth, H = stage.clientHeight;\n  var dx = 0, dy = 0, mx = d.w * view.sc / 2 + 20, my = d.h * view.sc / 2 + 20;\n  if (sx - mx < 0) dx = mx - sx; else if (sx + mx > W) dx = W - mx - sx;\n  if (sy - my < 0) dy = my - sy; else if (sy + my > H - 96) dy = H - 96 - my - sy;\n  if (dx || dy){ view.tx += dx; view.ty += dy; applyView(); }\n}\n\n/* ---------- Gestures ---------- */\nvar pts = new Map(), gest = null, lastTap = { id: null, t: 0 };\nfunction nodeAt(e){ var el = e.target.closest && e.target.closest('.node'); return el ? el.dataset.id : null; }\nstage.addEventListener('pointerdown', function(e){\n  if (e.target.closest('.dock,.toast')) return;\n  pts.set(e.pointerId, { x: e.clientX, y: e.clientY });\n  try { stage.setPointerCapture(e.pointerId); } catch(_){}\n  if (pts.size === 1){\n    var id = nodeAt(e), m = cur();\n    gest = { kind: 'one', id: id, x0: e.clientX, y0: e.clientY, t0: Date.now(), moved: false, tx0: view.tx, ty0: view.ty, orig: null, snap: null };\n    if (id){\n      var ids = [id].concat(descendants(m, id)); // a branch moves with its ideas\n      gest.orig = {}; ids.forEach(function(k){ gest.orig[k] = { x: m.nodes[k].x, y: m.nodes[k].y }; });\n      gest.snap = snapshot();\n    }\n  } else if (pts.size === 2){\n    var a = Array.from(pts.values());\n    gest = { kind: 'pinch', d0: Math.hypot(a[0].x - a[1].x, a[0].y - a[1].y) || 1, m0: { x: (a[0].x + a[1].x)/2, y: (a[0].y + a[1].y)/2 },\n      sc0: view.sc, tx0: view.tx, ty0: view.ty, moved: true };\n  }\n});\nstage.addEventListener('pointermove', function(e){\n  if (!pts.has(e.pointerId) || !gest) return;\n  pts.set(e.pointerId, { x: e.clientX, y: e.clientY });\n  var r = stage.getBoundingClientRect();\n  if (gest.kind === 'pinch' && pts.size >= 2){\n    var a = Array.from(pts.values()), d = Math.hypot(a[0].x - a[1].x, a[0].y - a[1].y), mid = { x: (a[0].x + a[1].x)/2, y: (a[0].y + a[1].y)/2 };\n    var sc = Math.max(.25, Math.min(2.6, gest.sc0 * d / gest.d0));\n    var wx = (gest.m0.x - r.left - gest.tx0) / gest.sc0, wy = (gest.m0.y - r.top - gest.ty0) / gest.sc0;\n    view.sc = sc; view.tx = mid.x - r.left - wx * sc; view.ty = mid.y - r.top - wy * sc; applyView();\n    return;\n  }\n  if (gest.kind !== 'one') return;\n  var dx = e.clientX - gest.x0, dy = e.clientY - gest.y0;\n  if (!gest.moved && Math.hypot(dx, dy) > 7){ gest.moved = true; if (!gest.id) stage.classList.add('panning'); }\n  if (!gest.moved) return;\n  if (gest.id){\n    var m = cur();\n    for (var k in gest.orig){ var n = m.nodes[k]; if (n){ n.x = gest.orig[k].x + dx / view.sc; n.y = gest.orig[k].y + dy / view.sc; } }\n    place();\n  } else { view.tx = gest.tx0 + dx; view.ty = gest.ty0 + dy; applyView(); }\n});\nfunction endPointer(e){\n  if (!pts.has(e.pointerId)) return;\n  pts.delete(e.pointerId);\n  stage.classList.remove('panning');\n  if (!gest) return;\n  if (gest.kind === 'pinch'){\n    if (pts.size === 1){ var p = Array.from(pts.values())[0]; gest = { kind: 'one', id: null, x0: p.x, y0: p.y, t0: Date.now(), moved: true, tx0: view.tx, ty0: view.ty }; }\n    else gest = null;\n    return;\n  }\n  if (pts.size) return;\n  var g = gest; gest = null;\n  if (g.moved){\n    if (g.id && g.snap){ undoStack.push(g.snap); if (undoStack.length > 40) undoStack.shift(); updateDock(); save(); }\n    return;\n  }\n  if (e.type === 'pointercancel') return;\n  tap(g.id);\n}\nstage.addEventListener('pointerup', endPointer);\nstage.addEventListener('pointercancel', endPointer);\nstage.addEventListener('wheel', function(e){\n  e.preventDefault();\n  var r = stage.getBoundingClientRect(), f = Math.exp(-e.deltaY * (e.ctrlKey ? .01 : .002));\n  var sc = Math.max(.25, Math.min(2.6, view.sc * f)), px = e.clientX - r.left, py = e.clientY - r.top;\n  view.tx = px - (px - view.tx) * sc / view.sc; view.ty = py - (py - view.ty) * sc / view.sc; view.sc = sc; applyView();\n}, { passive: false });\nfunction tap(id){\n  var now = Date.now();\n  if (id && lastTap.id === id && now - lastTap.t < 330){ lastTap = { id: null, t: 0 }; select(id); openEditor(id); return; }\n  lastTap = { id: id, t: now };\n  if (!id){ if (selectedId){ selectedId = null; render(); } return; }\n  select(id);\n}\nfunction select(id){ if (selectedId !== id){ selectedId = id; haptic('light'); render(); } }\n\n/* ---------- Actions ---------- */\nfunction haptic(s){ try { if (window.myllmHaptic) window.myllmHaptic(s || 'light'); } catch(e){} }\nvar toastTimer;\nfunction toast(msg, withUndo){\n  $('toastMsg').textContent = msg; $('toastUndo').classList.toggle('hide', !withUndo);\n  $('toast').classList.add('show'); clearTimeout(toastTimer);\n  toastTimer = setTimeout(function(){ $('toast').classList.remove('show'); }, withUndo ? 4200 : 1800);\n}\n$('toastUndo').addEventListener('click', function(){ undo(); $('toast').classList.remove('show'); });\n\nfunction addChild(parentId, text, andEdit){\n  var m = cur(); pushUndo();\n  var p = m.nodes[parentId]; if (p.collapsed) p.collapsed = false;\n  render();\n  var s = spotFor(m, parentId), n = addNode(m, parentId, text || 'New idea', s.x, s.y);\n  selectedId = n.id; render(); ensureVisible(n.id); save(); haptic('light');\n  if (andEdit) openEditor(n.id, true);\n  return n;\n}\nfunction deleteNode(id){\n  var m = cur(), n = m.nodes[id]; if (!n || !n.parent) return;\n  pushUndo();\n  var gone = [id].concat(descendants(m, id));\n  gone.forEach(function(k){ delete m.nodes[k]; });\n  selectedId = null; render(); save(); haptic('medium');\n  toast(gone.length > 1 ? 'Deleted ' + gone.length + ' ideas' : 'Deleted “' + n.text.slice(0, 24) + '”', true);\n}\nfunction toggleFold(id){\n  var m = cur(), n = m.nodes[id]; if (!n) return;\n  pushUndo(); n.collapsed = !n.collapsed; render(); save(); haptic('light');\n}\n$('bAdd').addEventListener('click', function(){ addChild(selectedId || cur().rootId, 'New idea', true); });\n$('bEdit').addEventListener('click', function(){ if (selectedId) openEditor(selectedId); });\n$('bFold').addEventListener('click', function(){ if (selectedId) toggleFold(selectedId); });\n$('bDelete').addEventListener('click', function(){ if (selectedId) deleteNode(selectedId); });\n$('bTidy').addEventListener('click', function(){ haptic('light'); tidy(); });\n$('bFit').addEventListener('click', function(){ haptic('light'); fit(true); });\n$('bUndo').addEventListener('click', undo);\n$('bExpand').addEventListener('click', function(){ if (selectedId) expand(selectedId); });\n\n/* ---------- Sheets ---------- */\nvar openSheetEl = null;\nfunction openSheet(id){ closeSheet(); openSheetEl = $(id); $('scrim').classList.add('open'); openSheetEl.classList.add('open'); }\nfunction closeSheet(){ if (openSheetEl){ openSheetEl.classList.remove('open'); openSheetEl = null; } $('scrim').classList.remove('open');\n  var ae = document.activeElement; if (ae && ae.blur) ae.blur(); }\n$('scrim').addEventListener('click', function(){ if (editing && editing.isNew) cancelEdit(); else closeSheet(); });\n\nvar editing = null; // { kind:'node'|'title', id, isNew, color }\nPALETTE.forEach(function(c){\n  var b = document.createElement('button'); b.style.setProperty('--c', c); b.setAttribute('aria-label', 'Colour'); b.dataset.c = c;\n  b.addEventListener('click', function(){ if (!editing) return; editing.color = c; markSwatch(); haptic('light'); });\n  $('swatches').appendChild(b);\n});\nfunction markSwatch(){ Array.prototype.forEach.call($('swatches').children, function(b){ b.classList.toggle('on', editing && b.dataset.c === editing.color); }); }\nfunction openEditor(id, isNew){\n  var m = cur(), n = m.nodes[id]; if (!n) return;\n  var d = depthOf(m, id);\n  editing = { kind: 'node', id: id, isNew: !!isNew, color: d >= 1 ? branchColor(m, id) : null };\n  $('editTitle').textContent = isNew ? 'New idea' : d === 0 ? 'Centre idea' : 'Edit idea';\n  $('editText').value = isNew ? '' : n.text;\n  $('editText').placeholder = d === 0 ? 'What is this map about?' : 'An idea';\n  var showSw = d >= 1;\n  $('swatches').classList.toggle('hide', !showSw); $('swLbl').style.display = showSw ? '' : 'none';\n  $('editDelete').style.display = d === 0 ? 'none' : '';\n  markSwatch(); openSheet('editSheet');\n  setTimeout(function(){ $('editText').focus(); }, 60);\n}\nfunction openTitleEditor(mapId){\n  var m = db.maps.find(function(x){ return x.id === mapId; }); if (!m) return;\n  editing = { kind: 'title', id: mapId };\n  $('editTitle').textContent = 'Rename map'; $('editText').value = m.title; $('editText').placeholder = 'Map name';\n  $('swatches').classList.add('hide'); $('swLbl').style.display = 'none'; $('editDelete').style.display = 'none';\n  openSheet('editSheet'); setTimeout(function(){ $('editText').focus(); }, 60);\n}\nfunction commitEdit(){\n  if (!editing) return closeSheet();\n  var txt = $('editText').value.replace(/\\s+/g, ' ').trim();\n  if (editing.kind === 'title'){\n    var mm = db.maps.find(function(x){ return x.id === editing.id; });\n    if (mm && txt){ mm.title = txt; save(); }\n    editing = null; closeSheet(); render(); renderMaps(); return;\n  }\n  var m = cur(), n = m.nodes[editing.id];\n  if (!n){ editing = null; return closeSheet(); }\n  if (!txt){ if (editing.isNew){ delete m.nodes[n.id]; undoStack.pop(); selectedId = null; } editing = null; closeSheet(); render(); save(); return; }\n  if (!editing.isNew) pushUndo();\n  n.text = txt;\n  if (!n.parent && m.title === 'Untitled map') m.title = txt;\n  if (editing.color && n.parent){ var top = n; while (m.nodes[top.parent] && m.nodes[top.parent].parent) top = m.nodes[top.parent]; top.color = editing.color; }\n  editing = null; closeSheet(); render(); save(); haptic('light');\n}\nfunction cancelEdit(){\n  if (editing && editing.isNew && editing.kind === 'node'){ var m = cur(); delete m.nodes[editing.id]; undoStack.pop(); selectedId = null; render(); save(); }\n  editing = null; closeSheet();\n}\n$('editDone').addEventListener('click', commitEdit);\n$('editCancel').addEventListener('click', cancelEdit);\n$('editDelete').addEventListener('click', function(){ var id = editing && editing.id, isNew = editing && editing.isNew; if (isNew){ cancelEdit(); return; } editing = null; closeSheet(); deleteNode(id); });\n$('editText').addEventListener('keydown', function(e){ if (e.key === 'Enter' && !e.shiftKey){ e.preventDefault(); commitEdit(); } else if (e.key === 'Escape') cancelEdit(); });\n\n/* Maps */\nvar confirmDel = null;\nfunction fmtDate(t){ var d = new Date(t || Date.now()), now = new Date();\n  if (d.toDateString() === now.toDateString()) return 'Today ' + d.toTimeString().slice(0, 5);\n  return d.toLocaleDateString(undefined, { day: 'numeric', month: 'short' }); }\nfunction renderMaps(){\n  var ul = $('mapsList'); ul.innerHTML = '';\n  db.maps.slice().sort(function(a, b){ return (b.updated||0) - (a.updated||0); }).forEach(function(m){\n    var li = document.createElement('li'); if (m.id === db.current) li.className = 'cur';\n    var b = document.createElement('button'); b.className = 'm';\n    var t = document.createElement('b'); t.textContent = m.title; var s = document.createElement('small');\n    var n = countNodes(m); s.textContent = n + (n === 1 ? ' idea' : ' ideas') + ' · ' + fmtDate(m.updated);\n    b.appendChild(t); b.appendChild(s);\n    b.addEventListener('click', function(){ switchMap(m.id); closeSheet(); });\n    li.appendChild(b);\n    var ren = document.createElement('button'); ren.className = 'ic'; ren.setAttribute('aria-label', 'Rename ' + m.title);\n    ren.innerHTML = '<svg viewBox=\"0 0 24 24\"><path d=\"M4 20h4L19 9l-4-4L4 16z\"/></svg>';\n    ren.addEventListener('click', function(){ openTitleEditor(m.id); });\n    li.appendChild(ren);\n    if (confirmDel === m.id){\n      var y = document.createElement('button'); y.className = 'yes'; y.textContent = 'Delete';\n      y.addEventListener('click', function(){ deleteMap(m.id); });\n      li.appendChild(y);\n    } else if (db.maps.length > 1){\n      var del = document.createElement('button'); del.className = 'ic'; del.setAttribute('aria-label', 'Delete ' + m.title);\n      del.innerHTML = '<svg viewBox=\"0 0 24 24\"><path d=\"M4 7h16M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3\"/></svg>';\n      del.addEventListener('click', function(){ confirmDel = m.id; renderMaps(); haptic('warning'); });\n      li.appendChild(del);\n    }\n    ul.appendChild(li);\n  });\n}\nfunction openMaps(){ confirmDel = null; renderMaps(); openSheet('mapsSheet'); }\nfunction switchMap(id){\n  if (db.current === id) return;\n  db.current = id; selectedId = null; undoStack = []; clearWorld(); render(); fit(false); save(); haptic('light');\n}\nfunction clearWorld(){ $('toast').classList.remove('show'); for (var k in nodeEls){ nodeEls[k].remove(); } nodeEls = {}; dims = {}; }\nfunction deleteMap(id){\n  var i = db.maps.findIndex(function(m){ return m.id === id; }); if (i < 0 || db.maps.length < 2) return;\n  var title = db.maps[i].title;\n  db.maps.splice(i, 1); confirmDel = null;\n  if (db.current === id){ db.current = db.maps[0].id; selectedId = null; undoStack = []; clearWorld(); render(); fit(false); }\n  save(); renderMaps(); render(); toast('Deleted “' + title.slice(0, 24) + '”');\n}\n$('titleBtn').addEventListener('click', openMaps);\n$('mapsBtn').addEventListener('click', openMaps);\n$('mapsDone').addEventListener('click', closeSheet);\n$('newMap').addEventListener('click', function(){\n  var m = newMap('Untitled map', 'Central idea'); db.maps.push(m);\n  db.current = m.id; selectedId = m.rootId; undoStack = []; clearWorld(); closeSheet(); render(); fit(false); save();\n  openEditor(m.rootId);\n});\n\n/* ---------- Outline: export and import ---------- */\nfunction outline(m){\n  var lines = [];\n  (function walk(id, d){ var n = m.nodes[id]; lines.push(new Array(d + 1).join('  ') + n.text); childrenOf(m, id).forEach(function(c){ walk(c.id, d + 1); }); })(m.rootId, 0);\n  return lines.join('\\n');\n}\nfunction parseOutline(text){\n  var rows = [];\n  String(text || '').replace(/\\r/g, '').split('\\n').forEach(function(line){\n    if (!line.trim()) return;\n    var lead = line.match(/^[ \\t]*/)[0].replace(/\\t/g, '    ').length;\n    var t = line.trim().replace(/^([-*•·–]|\\d+[.)])\\s+/, '').replace(/^#+\\s*/, '').trim();\n    if (t) rows.push({ lead: lead, text: t.slice(0, 120) });\n  });\n  if (!rows.length) return null;\n  var tops = rows.filter(function(r){ return r.lead === rows[0].lead; }).length;\n  var m;\n  if (tops === 1){ m = newMap(rows[0].text, rows[0].text); rows.shift(); }\n  else m = newMap('Imported map', 'Imported map');\n  var stack = [{ lead: -1, id: m.rootId }];\n  rows.forEach(function(r){\n    while (stack.length > 1 && stack[stack.length - 1].lead >= r.lead) stack.pop();\n    var n = addNode(m, stack[stack.length - 1].id, r.text, 0, 0);\n    stack.push({ lead: r.lead, id: n.id });\n  });\n  fresh = {};\n  return m;\n}\n$('importBtn').addEventListener('click', function(){ $('importText').value = ''; openSheet('importSheet'); setTimeout(function(){ $('importText').focus(); }, 60); });\n$('importCancel').addEventListener('click', closeSheet);\n$('importGo').addEventListener('click', function(){\n  var m = parseOutline($('importText').value);\n  if (!m){ toast('Paste some lines first'); return; }\n  db.maps.push(m); db.current = m.id; selectedId = null; undoStack = []; clearWorld(); closeSheet(); render();\n  animateTo(computeTidy(m), 0, function(){ fit(false); save(); });\n  toast('Made a map with ' + countNodes(m) + ' ideas');\n});\n\nfunction copyText(s){\n  var ok = false;\n  try { var ta = document.createElement('textarea'); ta.value = s; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';\n    document.body.appendChild(ta); ta.select(); ta.setSelectionRange(0, s.length); ok = document.execCommand('copy'); document.body.removeChild(ta); } catch(e){}\n  if (!ok && navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(s).then(function(){ toast('Outline copied'); }, function(){ toast('Copy isn’t available here'); }); return; }\n  toast(ok ? 'Outline copied' : 'Copy isn’t available here');\n}\n$('exportBtn').addEventListener('click', function(){\n  $('exImage').classList.toggle('hide', typeof window.myllmSaveImage !== 'function');\n  $('exShare').classList.toggle('hide', typeof window.myllmShare !== 'function');\n  openSheet('exportSheet');\n});\n$('exportDone').addEventListener('click', closeSheet);\n$('exShare').addEventListener('click', function(){ var t = outline(cur()); closeSheet(); try { myllmShare(t).catch(function(){}); } catch(e){} });\n$('exCopy').addEventListener('click', function(){ closeSheet(); copyText(outline(cur())); });\n$('exImage').addEventListener('click', function(){\n  var url = renderPNG(cur()); closeSheet();\n  Promise.resolve(window.myllmSaveImage(url)).then(function(){ toast('Saved to your photos'); haptic('success'); }, function(){ toast('Couldn’t save the image'); });\n});\n\n/* The PNG is drawn straight onto a canvas — the same curves and cards as the\n   page — rather than via an SVG with HTML inside, which Safari refuses to\n   export (a foreignObject taints the canvas). */\nfunction renderPNG(m){\n  var hid = hiddenSet(m), dark = matchMedia('(prefers-color-scheme: dark)').matches, ids = Object.keys(m.nodes).filter(function(k){ return !hid[k]; });\n  var minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;\n  ids.forEach(function(k){ var n = m.nodes[k], d = dims[k] || { w: 120, h: 40 };\n    minX = Math.min(minX, n.x - d.w/2); maxX = Math.max(maxX, n.x + d.w/2); minY = Math.min(minY, n.y - d.h/2); maxY = Math.max(maxY, n.y + d.h/2); });\n  var pad = 48, w = maxX - minX + pad*2, h = maxY - minY + pad*2, k = Math.min(3, 4096 / Math.max(w, h));\n  var cv = document.createElement('canvas'); cv.width = Math.round(w * k); cv.height = Math.round(h * k);\n  var g = cv.getContext('2d'); g.scale(k, k); g.translate(pad - minX, pad - minY);\n  g.fillStyle = dark ? '#0f1016' : '#f7f7fa'; g.fillRect(minX - pad, minY - pad, w, h);\n  var surface = dark ? '#1b1d26' : '#ffffff', ink = dark ? '#f2f3f7' : '#1b1d24';\n  // links\n  ids.forEach(function(id){\n    var n = m.nodes[id]; if (!n.parent || hid[n.parent] || !m.nodes[n.parent]) return;\n    var p = m.nodes[n.parent], d = depthOf(m, id);\n    var path = new Path2D(linkPath(p, n, (dims[p.id]||{w:0}).w, (dims[id]||{w:0}).w));\n    g.strokeStyle = branchColor(m, id); g.globalAlpha = d === 1 ? .85 : .6; g.lineWidth = d === 1 ? 3.4 : d === 2 ? 2.4 : 1.8; g.lineCap = 'round'; g.stroke(path); g.globalAlpha = 1;\n  });\n  function rr(x, y, ww, hh, r){ g.beginPath(); g.moveTo(x + r, y); g.arcTo(x + ww, y, x + ww, y + hh, r); g.arcTo(x + ww, y + hh, x, y + hh, r); g.arcTo(x, y + hh, x, y, r); g.arcTo(x, y, x + ww, y, r); g.closePath(); }\n  function mix(hex, a, base){ // hex over base at alpha a\n    var p = function(s, i){ return parseInt(s.slice(i, i + 2), 16); };\n    var h1 = hex.replace('#', ''), h2 = base.replace('#', '');\n    var c = [0, 2, 4].map(function(i){ return Math.round(p(h1, i) * a + p(h2, i) * (1 - a)); });\n    return 'rgb(' + c.join(',') + ')';\n  }\n  ids.forEach(function(id){\n    var n = m.nodes[id], el = nodeEls[id], d = depthOf(m, id), dm = dims[id] || { w: 120, h: 40 }, col = branchColor(m, id);\n    var x = n.x - dm.w/2, y = n.y - dm.h/2, r = d === 0 ? 18 : 14;\n    g.save(); g.shadowColor = dark ? 'rgba(0,0,0,.45)' : 'rgba(20,25,45,.12)'; g.shadowBlur = 16; g.shadowOffsetY = 5;\n    rr(x, y, dm.w, dm.h, r);\n    if (d === 0){ var gr = g.createLinearGradient(x, y, x + dm.w, y + dm.h); gr.addColorStop(0, '#5b5ef4'); gr.addColorStop(1, '#9b5cf6'); g.fillStyle = gr; }\n    else if (d === 1) g.fillStyle = mix(col, .14, surface);\n    else g.fillStyle = surface;\n    g.fill(); g.restore();\n    if (d === 1){ rr(x, y, dm.w, dm.h, r); g.strokeStyle = mix(col, .45, surface); g.lineWidth = 1; g.stroke(); }\n    // text: reuse the browser's own line breaks by reading them from the card\n    var fs = d === 0 ? 19 : d === 1 ? 16 : 15, wt = d === 0 ? 700 : d === 1 ? 650 : 500, lh = d === 0 ? 1.3 : 1.38;\n    g.font = wt + ' ' + fs + 'px -apple-system,\"SF Pro Text\",system-ui,sans-serif';\n    g.fillStyle = d === 0 ? '#ffffff' : d === 1 ? mix(col, .58, ink.length === 7 ? ink : '#1b1d24') : ink;\n    g.textBaseline = 'middle';\n    var padX = d === 0 ? 20 : 14, dotW = d >= 2 ? 16 : 0, maxW = dm.w - padX*2 - dotW;\n    var words = n.text.split(/\\s+/), lines = [], line = '';\n    words.forEach(function(wd){ var t = line ? line + ' ' + wd : wd; if (g.measureText(t).width > maxW + 6 && line){ lines.push(line); line = wd; } else line = t; });\n    if (line) lines.push(line);\n    var totalH = lines.length * fs * lh, y0 = n.y - totalH/2 + fs * lh / 2;\n    if (d >= 2){ g.beginPath(); g.arc(x + padX + 4, y0, 4, 0, Math.PI*2); g.fillStyle = col; g.fill(); g.fillStyle = ink; }\n    g.textAlign = d === 0 ? 'center' : 'left';\n    lines.forEach(function(l, i){ g.fillText(l, d === 0 ? n.x : x + padX + dotW, y0 + i * fs * lh); });\n  });\n  return cv.toDataURL('image/png');\n}\n\n/* ---------- Expand with AI ----------\n   Asks for a handful of short sub-ideas for the selected node, with the path\n   from the centre as context. JSON (schema-fenced on the phone's own model)\n   first, plain lines as the fallback. */\nfunction parseIdeas(text, exclude){\n  var seen = {}, out = [];\n  exclude.forEach(function(x){ seen[x.toLowerCase()] = true; });\n  String(text || '').replace(/\\r/g, '').split(/\\n|;/).forEach(function(line){\n    var t = line.trim().replace(/^([-*•·–]|\\d+[.):]|[a-z][.)])\\s*/i, '').replace(/^[\"'“”]+|[\"'“”.,]+$/g, '').replace(/\\*\\*/g, '').trim();\n    if (!t || t.length > 70) return;\n    if (/^(here are|sure|ideas?:|sub-ideas|one idea per line|reply with|mind map|path:)/i.test(t)) return;\n    if (/[:]$/.test(t)) return;\n    var key = t.toLowerCase(); if (seen[key]) return; seen[key] = true;\n    out.push(t);\n  });\n  return out.slice(0, 6);\n}\nfunction expand(id){\n  var m = cur(), n = m.nodes[id]; if (!n || busyIds[id]) return;\n  var mapId = m.id, path = pathTo(m, id), existing = childrenOf(m, id).map(function(c){ return c.text; });\n  var q = 'Mind map path: ' + path.join(' > ') + '.\\nSuggest 3 to 6 short, distinct sub-ideas that belong under \"' + n.text + '\" (each 1 to 5 words).' +\n    (existing.length ? ' It already has: ' + existing.join(', ') + ' — suggest different ones.' : '');\n  var schema = { type: 'object', required: ['ideas'], properties: { ideas: { type: 'array', minItems: 3, maxItems: 6, items: { type: 'string', maxLength: 60 } } } };\n  busyIds[id] = true; render(); haptic('light');\n  var p = typeof window.myllmAskJSON === 'function'\n    ? myllmAskJSON(q + '\\nReply as JSON with the ideas in \"ideas\".', schema).then(function(j){\n        var arr = j && Array.isArray(j.ideas) ? j.ideas.filter(function(x){ return typeof x === 'string'; }) : [];\n        var got = parseIdeas(arr.join('\\n'), [n.text].concat(existing)); if (!got.length) throw new Error('none'); return got;\n      }).catch(function(){ return askPlain(q, n, existing); })\n    : askPlain(q, n, existing);\n  p.then(function(ideas){\n    delete busyIds[id];\n    var mm = db.maps.find(function(x){ return x.id === mapId; });\n    if (!mm || !mm.nodes[id]){ render(); return; }\n    if (!ideas.length){ render(); toast('No ideas came back — try again'); return; }\n    if (db.current !== mapId){ db.current = mapId; clearWorld(); }\n    pushUndo();\n    if (mm.nodes[id].collapsed) mm.nodes[id].collapsed = false;\n    render();\n    ideas.forEach(function(t, i){ var s = spotFor(mm, id); addNode(mm, id, t, s.x, s.y); });\n    selectedId = id; render(); haptic('success');\n    // Re-flow at once so the new ideas never sit on a neighbouring branch;\n    // one undo step takes back both the ideas and the re-flow.\n    animateTo(computeTidy(mm), 460, function(){ save(); fit(true); });\n    toast('Added ' + ideas.length + ' ideas', true);\n  }, function(){\n    delete busyIds[id]; render(); toast('Couldn’t reach your AI just now'); haptic('error');\n  });\n}\nfunction askPlain(q, n, existing){\n  if (typeof window.myllmAsk !== 'function') return Promise.reject(new Error('no ai'));\n  return myllmAsk(q + '\\nReply with ONLY the ideas, one per line, no numbering and nothing else.').then(function(r){\n    return parseIdeas(r, [n.text].concat(existing));\n  });\n}\n\n/* ---------- Keyboard (iPad) ---------- */\ndocument.addEventListener('keydown', function(e){\n  if (e.target && (e.target.tagName === 'TEXTAREA' || e.target.tagName === 'INPUT')) return;\n  if (openSheetEl){ if (e.key === 'Escape') closeSheet(); return; }\n  if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'z'){ e.preventDefault(); undo(); return; }\n  if (e.key === 'Tab'){ e.preventDefault(); addChild(selectedId || cur().rootId, 'New idea', true); }\n  else if (e.key === 'Enter' && selectedId){ e.preventDefault(); var m = cur(), n = m.nodes[selectedId]; if (n.parent) addChild(n.parent, 'New idea', true); else openEditor(selectedId); }\n  else if ((e.key === 'Backspace' || e.key === 'Delete') && selectedId){ e.preventDefault(); deleteNode(selectedId); }\n  else if (e.key === ' ' && selectedId){ e.preventDefault(); openEditor(selectedId); }\n  else if (e.key === 'Escape'){ selectedId = null; render(); }\n});\n\n/* ---------- Boot ---------- */\nvar booted = false;\nfunction boot(seeded){\n  if (booted) return; booted = true;\n  render();\n  if (seeded){ animateTo(computeTidy(cur()), 0, function(){ fit(false); saveNow(); }); }\n  else fit(false);\n}\naddEventListener('resize', function(){ if (booted) fit(false); });\nload(boot);\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes. This page\n   pads its own top by env(safe-area-inset-top), so the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    var sp = document.querySelector(\".imm-safe\"); if (sp) sp.style.height = \"0px\";\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script></body></html>\n", "kind": "html", "iconSymbol": "point.3.connected.trianglepath.dotted", "iconColor": "purple"}