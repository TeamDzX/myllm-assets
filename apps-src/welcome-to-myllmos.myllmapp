{"name": "Welcome to MyLLMos", "kind": "html", "iconSymbol": "hand.wave.fill", "iconColor": "mint", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Welcome to MyLLMos</title>\n<style>\n  :root {\n    --ink: #12291d;\n    --ink-soft: rgba(18, 41, 29, 0.62);\n    --accent: var(--myllm-accent, #109a68);\n    --card: rgba(255, 255, 255, 0.72);\n    --radius: 24px;\n  }\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  html, body { height: 100%; }\n  body {\n    font-family: -apple-system, BlinkMacSystemFont, \"SF Pro Text\", sans-serif;\n    color: var(--ink);\n    background: #eef6f1;\n    overflow: hidden;\n  }\n\n  main {\n    display: flex;\n    height: 100dvh;\n    overflow-x: auto;\n    overflow-y: hidden;\n    scroll-snap-type: x mandatory;\n    -webkit-overflow-scrolling: touch;\n    scrollbar-width: none;\n  }\n  main::-webkit-scrollbar { display: none; }\n\n  .scene {\n    position: relative;\n    min-width: 100vw;\n    height: 100%;\n    scroll-snap-align: center;\n    scroll-snap-stop: always;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    gap: 18px;\n    padding: max(48px, env(safe-area-inset-top)) 28px calc(64px + env(safe-area-inset-bottom));\n    text-align: center;\n    background-size: cover;\n    background-position: center;\n  }\n  .scene { background-image: url(\"data:image/jpeg;base64,\"); }\n  .scene.finale { background-image: url(\"data:image/jpeg;base64,\"); }\n  /* per-scene wash so one background reads as five */\n  .scene::before {\n    content: \"\";\n    position: absolute; inset: 0;\n    background: linear-gradient(180deg, rgba(255,255,255,0.15), rgba(238,246,241,0.55));\n    pointer-events: none;\n  }\n  .scene[data-tint=\"teal\"]::before   { background: linear-gradient(200deg, rgba(160,225,205,0.28), rgba(238,246,241,0.6)); }\n  .scene[data-tint=\"sky\"]::before    { background: linear-gradient(160deg, rgba(168,214,235,0.30), rgba(238,246,241,0.6)); }\n  .scene[data-tint=\"violet\"]::before { background: linear-gradient(200deg, rgba(199,186,240,0.26), rgba(238,246,241,0.6)); }\n  .scene > * { position: relative; }\n\n  .kicker {\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    color: var(--accent);\n  }\n  h1 { font-size: 34px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.12; }\n  h2 { font-size: 28px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.15; }\n  .copy {\n    font-size: 16px;\n    line-height: 1.45;\n    color: var(--ink-soft);\n    max-width: 30em;\n  }\n  .copy strong { color: var(--ink); font-weight: 650; }\n\n  /* device-framed screenshot */\n  .shot {\n    width: min(58vw, 240px);\n    aspect-ratio: 1320 / 2868;\n    border-radius: 34px;\n    border: 6px solid #10231a;\n    box-shadow: 0 24px 60px -18px rgba(16, 60, 40, 0.45);\n    background: #fff center / cover no-repeat;\n    overflow: hidden;\n    flex-shrink: 1;\n    min-height: 0;\n  }\n  .shot img { width: 100%; height: 100%; object-fit: cover; display: block; }\n\n  /* ---- in-frame UI mockups (used until/unless real screenshots replace them) ---- */\n  .mock { display: flex; flex-direction: column; height: 100%; text-align: left; font-size: 9.5px; }\n  .mock, .mock * { line-height: 1.3; }\n\n  .mk-chat { background: #edf6ee; }\n  .mk-chat .hd { padding: 14px 8px 8px; text-align: center; font-weight: 700; font-size: 11px; background: #e2f1e4; }\n  .mk-chat .bd { flex: 1; padding: 9px 8px; display: flex; flex-direction: column; gap: 7px; overflow: hidden; }\n  .mk-chat .u { align-self: flex-end; max-width: 82%; background: #0a84ff; color: #fff; padding: 6px 9px; border-radius: 12px 12px 3px 12px; }\n  .mk-chat .a { align-self: flex-start; max-width: 88%; background: #fff; color: #222; padding: 7px 9px; border-radius: 12px 12px 12px 3px; display: flex; flex-direction: column; gap: 6px; }\n  .mk-chat .tool { color: #1f7a4d; font-weight: 700; font-size: 8.5px; }\n  .mk-chat .card { border: 1px solid #e2e6e4; border-radius: 8px; padding: 6px 7px; display: flex; align-items: center; gap: 6px; background: #fafcfb; }\n  .mk-chat .card .ico { width: 16px; height: 16px; border-radius: 50%; background: #0a84ff; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 9px; flex-shrink: 0; }\n  .mk-chat .card b { font-size: 9px; display: block; }\n  .mk-chat .card small { color: #7b8580; font-size: 7.5px; }\n  .mk-chat .in { margin: 7px 8px 12px; background: #fff; border-radius: 999px; padding: 6px 10px; color: #9aa4a0; display: flex; justify-content: space-between; align-items: center; }\n  .mk-chat .in i { width: 15px; height: 15px; border-radius: 50%; background: #109a68; }\n\n  .mk-open { background: #0c0d0f; color: #e8e8ea; align-items: center; justify-content: center; gap: 8px; padding: 12px; }\n  .mk-open .t { color: #2de0c0; font-weight: 800; font-size: 13px; }\n  .mk-open canvas { width: 88%; height: 34%; background: #000; border-radius: 6px; }\n  .mk-open .cap { color: #9a9aa2; font-size: 8px; }\n\n  .mk-save { background: #f2f3f5; padding: 10px 9px; gap: 8px; }\n  .mk-save .row { display: flex; justify-content: space-between; align-items: center; font-size: 9px; color: #333; }\n  .mk-save .row b { font-size: 10px; }\n  .mk-save .pill { background: #fff; border-radius: 999px; padding: 4px 8px; font-weight: 600; }\n  .mk-save .seg { display: flex; background: #e3e5e8; border-radius: 999px; padding: 2px; }\n  .mk-save .seg i { flex: 1; text-align: center; padding: 4px 6px; border-radius: 999px; font-style: normal; color: #666; }\n  .mk-save .seg i.on { background: #fff; color: #111; font-weight: 650; }\n  .mk-save label { font-size: 8px; font-weight: 700; color: #8a9296; letter-spacing: .06em; }\n  .mk-save .field { background: #fff; border-radius: 10px; padding: 7px 9px; font-weight: 600; color: #222; }\n  .mk-save .iconprev { align-self: center; width: 34px; height: 34px; border-radius: 9px; background: linear-gradient(180deg, #35a2ff, #0a84ff); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 15px; }\n  .mk-save .dots-row { display: flex; gap: 5px; }\n  .mk-save .dots-row i { width: 13px; height: 13px; border-radius: 50%; }\n  .mk-save .syms { display: grid; grid-template-columns: repeat(6, 1fr); gap: 4px; }\n  .mk-save .syms i { aspect-ratio: 1; background: #fff; border-radius: 7px; display: flex; align-items: center; justify-content: center; font-style: normal; font-size: 9px; color: #333; }\n\n  .wave { font-size: 56px; line-height: 1; }\n  .hint {\n    position: absolute;\n    bottom: calc(26px + env(safe-area-inset-bottom));\n    left: 0; right: 0;\n    font-size: 13px;\n    font-weight: 600;\n    color: var(--ink-soft);\n    animation: nudge 1.8s ease-in-out infinite;\n  }\n  @keyframes nudge { 0%,100% { transform: translateX(0); opacity:.75 } 50% { transform: translateX(8px); opacity:1 } }\n\n  /* prompt idea cards on the finale */\n  .ideas { display: flex; flex-direction: column; gap: 10px; width: 100%; max-width: 340px; }\n  .idea {\n    background: var(--card);\n    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);\n    border: 1px solid rgba(16, 90, 60, 0.12);\n    border-radius: 16px;\n    padding: 12px 16px;\n    font-size: 14.5px;\n    font-weight: 550;\n    color: var(--ink);\n    text-align: left;\n    box-shadow: 0 6px 18px -10px rgba(16, 60, 40, 0.25);\n  }\n  .idea::before { content: \"“\"; color: var(--accent); font-weight: 800; }\n  .idea::after  { content: \"”\"; color: var(--accent); font-weight: 800; }\n  .gallery-note { font-size: 13.5px; color: var(--ink-soft); }\n  .gallery-note b { color: var(--ink); }\n\n  /* progress dots */\n  .dots {\n    position: fixed;\n    top: calc(18px + env(safe-area-inset-top));\n    left: 0; right: 0;\n    display: flex; justify-content: center; gap: 7px;\n    pointer-events: none;\n  }\n  .dots span {\n    width: 7px; height: 7px; border-radius: 50%;\n    background: rgba(18, 41, 29, 0.18);\n    transition: all .3s ease;\n  }\n  .dots span.on { background: var(--accent); transform: scale(1.25); }\n\n  .scene .reveal { opacity: 0; transform: translateY(14px); transition: opacity .6s ease, transform .6s ease; }\n  .scene.seen .reveal { opacity: 1; transform: none; }\n  .scene.seen .reveal:nth-child(2) { transition-delay: .08s }\n  .scene.seen .reveal:nth-child(3) { transition-delay: .16s }\n  .scene.seen .reveal:nth-child(4) { transition-delay: .24s }\n  @media (prefers-reduced-motion: reduce) {\n    .hint { animation: none; }\n    .scene .reveal { opacity: 1; transform: none; transition: none; }\n  }\n  @media (max-height: 700px) {\n    h1 { font-size: 28px } h2 { font-size: 23px }\n    .copy { font-size: 14.5px }\n    .shot { width: min(48vw, 190px) }\n  }\n</style>\n</head>\n<body>\n\n<main id=\"story\">\n\n  <section class=\"scene\" data-tint=\"mint\">\n    <div class=\"wave reveal\">👋</div>\n    <h1 class=\"reveal\">Welcome to<br>MyLLMos</h1>\n    <p class=\"copy reveal\">The little OS that lives inside MyLLM — where <strong>apps you imagine</strong> become apps you own. Here's how it works.</p>\n    <div class=\"hint\" aria-hidden=\"true\">swipe →</div>\n  </section>\n\n  <section class=\"scene\" data-tint=\"teal\">\n    <p class=\"kicker reveal\">Step 1</p>\n    <h2 class=\"reveal\">Just ask</h2>\n    <p class=\"copy reveal\">Describe any app in plain words. MyLLM writes <strong>real code</strong> and hands it to you as a tap-to-open card — right in the chat.</p>\n    <div class=\"shot reveal\"><div class=\"mock mk-chat\">\n      <div class=\"hd\">MyLLM</div>\n      <div class=\"bd\">\n        <div class=\"u\">Can I have an html5 of a sine curve</div>\n        <div class=\"a\">\n          <span>Here is an HTML5 animation of a sine curve — rendered as a tap-to-open card.</span>\n          <span class=\"tool\">&#128295; render_html</span>\n          <span class=\"card\"><span class=\"ico\">&#9678;</span><span><b>Sine Curve Animation</b><small>Interactive HTML &middot; tap to open</small></span></span>\n        </div>\n      </div>\n      <div class=\"in\"><span>Message&hellip;</span><i></i></div>\n    </div></div>\n  </section>\n\n  <section class=\"scene\" data-tint=\"sky\">\n    <p class=\"kicker reveal\">Step 2</p>\n    <h2 class=\"reveal\">Tap it — it's real</h2>\n    <p class=\"copy reveal\">Your app opens full-screen and runs <strong>on your device</strong>. No app store, no account, no waiting.</p>\n    <div class=\"shot reveal\"><div class=\"mock mk-open\">\n      <div class=\"t\">Sine Wave</div>\n      <canvas id=\"sine\"></canvas>\n      <div class=\"cap\">Animated Sine Curve (y = sin(x))</div>\n    </div></div>\n  </section>\n\n  <section class=\"scene\" data-tint=\"violet\">\n    <p class=\"kicker reveal\">Step 3</p>\n    <h2 class=\"reveal\">Save it forever</h2>\n    <p class=\"copy reveal\">Love it? <strong>Save to MyLLMos</strong> — give it a name, a colour and an icon. From that moment, it's yours.</p>\n    <div class=\"shot reveal\"><div class=\"mock mk-save\">\n      <div class=\"row\"><span class=\"pill\">Cancel</span><b>Save to MyLLMos</b><span class=\"pill\">Save</span></div>\n      <div class=\"seg\"><i class=\"on\">New app</i><i>New version of&hellip;</i></div>\n      <label>NAME</label>\n      <div class=\"field\">Sine Curve Animation</div>\n      <label>ICON</label>\n      <div class=\"iconprev\">&#9678;</div>\n      <label>COLOUR</label>\n      <div class=\"dots-row\">\n        <i style=\"background:#0a84ff\"></i><i style=\"background:#bf5af2\"></i><i style=\"background:#ff2d55\"></i>\n        <i style=\"background:#ff9500\"></i><i style=\"background:#ffd60a\"></i><i style=\"background:#30d158\"></i><i style=\"background:#40c8e0\"></i>\n      </div>\n      <label>SYMBOLS</label>\n      <div class=\"syms\"><i>&#9707;</i><i>&#9776;</i><i>&#9998;</i><i>&#9200;</i><i>&#128172;</i><i>&#128197;</i></div>\n    </div></div>\n  </section>\n\n  <section class=\"scene\" data-tint=\"mint\">\n    <p class=\"kicker reveal\">Step 4</p>\n    <h2 class=\"reveal\">Your own springboard</h2>\n    <p class=\"copy reveal\">Everything you save lives here — games, tools, trackers. Ask MyLLM to <strong>improve any of them</strong> and it edits the app for you.</p>\n    <div class=\"shot reveal\"><img src=\"data:image/jpeg;base64,\" alt=\"The MyLLMos springboard of saved apps\"></div>\n  </section>\n\n  <section class=\"scene finale\">\n    <h2 class=\"reveal\">What will you build?</h2>\n    <p class=\"copy reveal\">Close this app and try one of these in the chat:</p>\n    <div class=\"ideas reveal\">\n      <div class=\"idea\">Make me a water tracker with a big + button</div>\n      <div class=\"idea\">Build a memory game with emoji cards</div>\n      <div class=\"idea\">A countdown to my holiday, with confetti</div>\n      <div class=\"idea\">A tip calculator that splits the bill</div>\n    </div>\n    <p class=\"gallery-note reveal\">Not feeling creative? The <b>App Gallery</b> tile on your springboard has 80+ ready-made apps.</p>\n  </section>\n\n</main>\n\n<nav class=\"dots\" aria-hidden=\"true\"></nav>\n\n<script>\n  var story = document.getElementById(\"story\");\n  var scenes = Array.prototype.slice.call(document.querySelectorAll(\".scene\"));\n  var dotsBox = document.querySelector(\".dots\");\n  scenes.forEach(function () {\n    var d = document.createElement(\"span\");\n    dotsBox.appendChild(d);\n  });\n  var dots = Array.prototype.slice.call(dotsBox.children);\n\n  // Live sine animation for the \"Tap it — it's real\" mockup (skipped when a\n  // real screenshot replaced the mockup, or when the user prefers less motion).\n  var cv = document.getElementById(\"sine\");\n  if (cv) {\n    var ctx = cv.getContext(\"2d\");\n    cv.width = 300; cv.height = 150;\n    var still = window.matchMedia && matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n    var t = 0;\n    function drawSine() {\n      ctx.clearRect(0, 0, cv.width, cv.height);\n      ctx.strokeStyle = \"#2de0c0\";\n      ctx.lineWidth = 2;\n      ctx.beginPath();\n      for (var x = 0; x <= cv.width; x++) {\n        var y = cv.height / 2 + Math.sin(x / 24 + t) * cv.height * 0.36;\n        x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);\n      }\n      ctx.stroke();\n      if (!still) { t += 0.045; requestAnimationFrame(drawSine); }\n    }\n    drawSine();\n  }\n\n  var io = new IntersectionObserver(function (entries) {\n    entries.forEach(function (e) {\n      if (e.isIntersecting) {\n        var i = scenes.indexOf(e.target);\n        e.target.classList.add(\"seen\");\n        dots.forEach(function (d, j) { d.classList.toggle(\"on\", j === i); });\n        // gentle haptic on scene change when the bridge is present\n        if (i > 0 && window.myllmHaptic) { try { window.myllmHaptic(\"light\"); } catch (_) {} }\n      }\n    });\n  }, { root: story, threshold: 0.6 });\n  scenes.forEach(function (s) { io.observe(s); });\n</script>\n</body>\n</html>\n"}