{"name": "Draw", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\">\n    <meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n    <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n    <meta name=\"mobile-web-app-capable\" content=\"yes\">\n    <meta name=\"theme-color\" content=\"#ffffff\">\n    <meta name=\"apple-mobile-web-app-title\" content=\"Draw\">\n    <meta name=\"format-detection\" content=\"telephone=no\">\n    <title>Draw</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n            -webkit-tap-highlight-color: transparent;\n            -webkit-touch-callout: none;\n            -webkit-user-select: none;\n            user-select: none;\n            touch-action: none;\n        }\n\n        html {\n            height: 100%;\n            height: -webkit-fill-available;\n            overflow: hidden;\n            position: fixed;\n            width: 100%;\n            background: #ffffff;\n        }\n\n        body {\n            width: 100%;\n            height: 100%;\n            height: -webkit-fill-available;\n            min-height: 100vh;\n            min-height: -webkit-fill-available;\n            overflow: hidden;\n            background: #ffffff;\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n            position: fixed;\n            top: 0;\n            left: 0;\n            overscroll-behavior: none;\n        }\n\n        #app {\n            width: 100%;\n            height: 100%;\n            height: 100dvh;\n            height: -webkit-fill-available;\n            position: fixed;\n            top: 0;\n            left: 0;\n            overflow: hidden;\n            background: #ffffff;\n        }\n\n        #canvas {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            background: #ffffff;\n            cursor: crosshair;\n            touch-action: none;\n        }\n\n        #app.fullscreen, #app.fullscreen #canvas {\n            background: #ffffff !important;\n        }\n\n        .toolbar-toggle {\n            position: fixed;\n            bottom: 20px;\n            bottom: calc(20px + env(safe-area-inset-bottom, 0px));\n            left: 50%;\n            transform: translateX(-50%);\n            width: 60px;\n            height: 60px;\n            border-radius: 50%;\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            border: none;\n            box-shadow: 0 4px 20px rgba(102, 126, 234, 0.5);\n            cursor: pointer;\n            z-index: 1000;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            transition: all 0.3s ease;\n        }\n\n        .toolbar-toggle:active { transform: translateX(-50%) scale(0.95); }\n        .toolbar-toggle svg { width: 28px; height: 28px; fill: white; transition: transform 0.3s ease; }\n        .toolbar-toggle.active svg { transform: rotate(45deg); }\n\n        .toolbar {\n            position: fixed;\n            bottom: 100px;\n            bottom: calc(100px + env(safe-area-inset-bottom, 0px));\n            left: 50%;\n            transform: translateX(-50%) translateY(20px);\n            background: rgba(26, 26, 46, 0.95);\n            -webkit-backdrop-filter: blur(20px);\n            backdrop-filter: blur(20px);\n            border-radius: 24px;\n            padding: 16px 20px;\n            display: flex;\n            gap: 12px;\n            align-items: center;\n            opacity: 0;\n            visibility: hidden;\n            transition: all 0.3s ease;\n            z-index: 999;\n            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);\n            max-width: calc(100vw - 40px);\n            flex-wrap: wrap;\n            justify-content: center;\n        }\n\n        .toolbar.visible {\n            opacity: 1;\n            visibility: visible;\n            transform: translateX(-50%) translateY(0);\n        }\n\n        .tool-btn {\n            width: 52px;\n            height: 52px;\n            min-width: 52px;\n            min-height: 52px;\n            border-radius: 16px;\n            border: 2px solid transparent;\n            background: rgba(255, 255, 255, 0.1);\n            cursor: pointer;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            transition: all 0.2s ease;\n        }\n\n        .tool-btn:active { transform: scale(0.95); background: rgba(255, 255, 255, 0.3); }\n        .tool-btn.active { border-color: #667eea; background: rgba(102, 126, 234, 0.3); }\n        .tool-btn svg { width: 24px; height: 24px; fill: white; pointer-events: none; }\n\n        .color-btn {\n            width: 52px;\n            height: 52px;\n            min-width: 52px;\n            min-height: 52px;\n            border-radius: 50%;\n            border: 3px solid rgba(255, 255, 255, 0.3);\n            cursor: pointer;\n            transition: all 0.2s ease;\n        }\n\n        .color-btn:active { transform: scale(0.95); }\n\n        .size-indicator {\n            display: flex;\n            align-items: center;\n            gap: 8px;\n            padding: 0 12px;\n        }\n\n        .size-indicator input[type=\"range\"] {\n            width: 100px;\n            height: 8px;\n            -webkit-appearance: none;\n            appearance: none;\n            background: rgba(255, 255, 255, 0.2);\n            border-radius: 4px;\n            outline: none;\n            touch-action: pan-x;\n        }\n\n        .size-indicator input[type=\"range\"]::-webkit-slider-thumb {\n            -webkit-appearance: none;\n            width: 28px;\n            height: 28px;\n            border-radius: 50%;\n            background: #667eea;\n            cursor: pointer;\n            border: 3px solid white;\n        }\n\n        .size-value {\n            color: white;\n            font-size: 14px;\n            font-weight: 600;\n            min-width: 30px;\n            text-align: center;\n        }\n\n        .color-palette {\n            position: fixed;\n            bottom: 180px;\n            bottom: calc(180px + env(safe-area-inset-bottom, 0px));\n            left: 50%;\n            transform: translateX(-50%) scale(0.9);\n            background: rgba(26, 26, 46, 0.95);\n            -webkit-backdrop-filter: blur(20px);\n            backdrop-filter: blur(20px);\n            border-radius: 24px;\n            padding: 20px;\n            display: grid;\n            grid-template-columns: repeat(6, 1fr);\n            gap: 12px;\n            opacity: 0;\n            visibility: hidden;\n            transition: all 0.3s ease;\n            z-index: 998;\n            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);\n        }\n\n        .color-palette.visible {\n            opacity: 1;\n            visibility: visible;\n            transform: translateX(-50%) scale(1);\n        }\n\n        .palette-color {\n            width: 44px;\n            height: 44px;\n            min-width: 44px;\n            min-height: 44px;\n            border-radius: 50%;\n            border: 3px solid transparent;\n            cursor: pointer;\n            transition: all 0.2s ease;\n        }\n\n        .palette-color:active { transform: scale(0.9); }\n        .palette-color.active { border-color: white; box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.5); }\n\n        .custom-color-wrapper {\n            grid-column: span 2;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n        }\n\n        .custom-color-input {\n            width: 100%;\n            height: 44px;\n            border-radius: 22px;\n            border: 2px dashed rgba(255, 255, 255, 0.4);\n            cursor: pointer;\n            -webkit-appearance: none;\n            appearance: none;\n            padding: 0;\n            background: transparent;\n        }\n\n        .custom-color-input::-webkit-color-swatch-wrapper { padding: 4px; }\n        .custom-color-input::-webkit-color-swatch { border-radius: 18px; border: none; }\n\n        .quick-action {\n            position: fixed;\n            top: 20px;\n            top: calc(20px + env(safe-area-inset-top, 0px));\n            width: 48px;\n            height: 48px;\n            border-radius: 50%;\n            background: rgba(26, 26, 46, 0.8);\n            -webkit-backdrop-filter: blur(10px);\n            backdrop-filter: blur(10px);\n            border: none;\n            cursor: pointer;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            z-index: 1000;\n            transition: all 0.2s ease;\n        }\n\n        .quick-action:active { transform: scale(0.9); }\n        .quick-action svg { width: 22px; height: 22px; fill: white; pointer-events: none; }\n        .quick-action.left { left: 20px; left: calc(20px + env(safe-area-inset-left, 0px)); }\n        .quick-action.right { right: 20px; right: calc(20px + env(safe-area-inset-right, 0px)); }\n\n        .undo-redo-group {\n            position: fixed;\n            top: 20px;\n            top: calc(20px + env(safe-area-inset-top, 0px));\n            left: 80px;\n            left: calc(80px + env(safe-area-inset-left, 0px));\n            display: flex;\n            gap: 8px;\n            z-index: 1000;\n        }\n\n        .undo-redo-btn {\n            width: 44px;\n            height: 44px;\n            border-radius: 50%;\n            background: rgba(26, 26, 46, 0.8);\n            -webkit-backdrop-filter: blur(10px);\n            backdrop-filter: blur(10px);\n            border: none;\n            cursor: pointer;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            transition: all 0.2s ease;\n        }\n\n        .undo-redo-btn:active { transform: scale(0.9); }\n        .undo-redo-btn:disabled { opacity: 0.4; cursor: not-allowed; }\n        .undo-redo-btn svg { width: 20px; height: 20px; fill: white; pointer-events: none; }\n\n        .top-right-group {\n            position: fixed;\n            top: 20px;\n            top: calc(20px + env(safe-area-inset-top, 0px));\n            right: 20px;\n            right: calc(20px + env(safe-area-inset-right, 0px));\n            display: flex;\n            gap: 8px;\n            z-index: 1000;\n        }\n\n        .top-btn {\n            width: 44px;\n            height: 44px;\n            border-radius: 50%;\n            background: rgba(26, 26, 46, 0.8);\n            -webkit-backdrop-filter: blur(10px);\n            backdrop-filter: blur(10px);\n            border: none;\n            cursor: pointer;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            transition: all 0.2s ease;\n        }\n\n        .top-btn:active { transform: scale(0.9); }\n        .top-btn svg { width: 20px; height: 20px; fill: white; pointer-events: none; }\n        .top-btn .exit-icon { display: none; }\n        .top-btn.active .enter-icon { display: none; }\n        .top-btn.active .exit-icon { display: block; }\n\n        .toast {\n            position: fixed;\n            bottom: 180px;\n            bottom: calc(180px + env(safe-area-inset-bottom, 0px));\n            left: 50%;\n            transform: translateX(-50%) translateY(20px);\n            background: rgba(26, 26, 46, 0.95);\n            -webkit-backdrop-filter: blur(10px);\n            backdrop-filter: blur(10px);\n            padding: 12px 24px;\n            border-radius: 12px;\n            color: white;\n            font-size: 14px;\n            font-weight: 500;\n            z-index: 10000;\n            opacity: 0;\n            visibility: hidden;\n            transition: all 0.3s ease;\n        }\n\n        .toast.visible { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); }\n\n        .toolbar-divider { width: 1px; height: 36px; background: rgba(255, 255, 255, 0.2); margin: 0 4px; }\n\n        /* Pen type & stroke shape buttons */\n        .pen-btn {\n            width: 52px;\n            height: 52px;\n            min-width: 52px;\n            min-height: 52px;\n            border-radius: 16px;\n            border: 2px solid transparent;\n            background: rgba(255, 255, 255, 0.1);\n            cursor: pointer;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            transition: all 0.2s ease;\n            position: relative;\n        }\n\n        .pen-btn:active { transform: scale(0.95); }\n        .pen-btn svg { width: 24px; height: 24px; fill: white; pointer-events: none; }\n\n        /* Pen type menu */\n        .pen-menu {\n            position: fixed;\n            bottom: 180px;\n            bottom: calc(180px + env(safe-area-inset-bottom, 0px));\n            left: 50%;\n            transform: translateX(-50%) scale(0.9);\n            background: rgba(26, 26, 46, 0.95);\n            -webkit-backdrop-filter: blur(20px);\n            backdrop-filter: blur(20px);\n            border-radius: 20px;\n            padding: 16px;\n            display: flex;\n            gap: 10px;\n            flex-wrap: wrap;\n            justify-content: center;\n            max-width: 320px;\n            opacity: 0;\n            visibility: hidden;\n            transition: all 0.3s ease;\n            z-index: 998;\n            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);\n        }\n\n        .pen-menu.visible {\n            opacity: 1;\n            visibility: visible;\n            transform: translateX(-50%) scale(1);\n        }\n\n        .pen-option {\n            width: 56px;\n            height: 56px;\n            border-radius: 14px;\n            border: 2px solid transparent;\n            background: rgba(255, 255, 255, 0.1);\n            cursor: pointer;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            gap: 4px;\n            transition: all 0.2s ease;\n        }\n\n        .pen-option:active { transform: scale(0.95); }\n        .pen-option.active { border-color: #667eea; background: rgba(102, 126, 234, 0.3); }\n        .pen-option svg { width: 22px; height: 22px; fill: white; }\n        .pen-option span { font-size: 9px; color: white; opacity: 0.8; }\n\n        /* Stroke shape menu */\n        .stroke-menu {\n            position: fixed;\n            bottom: 180px;\n            bottom: calc(180px + env(safe-area-inset-bottom, 0px));\n            left: 50%;\n            transform: translateX(-50%) scale(0.9);\n            background: rgba(26, 26, 46, 0.95);\n            -webkit-backdrop-filter: blur(20px);\n            backdrop-filter: blur(20px);\n            border-radius: 20px;\n            padding: 16px;\n            display: flex;\n            gap: 10px;\n            flex-wrap: wrap;\n            justify-content: center;\n            max-width: 260px;\n            opacity: 0;\n            visibility: hidden;\n            transition: all 0.3s ease;\n            z-index: 998;\n            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);\n        }\n\n        .stroke-menu.visible {\n            opacity: 1;\n            visibility: visible;\n            transform: translateX(-50%) scale(1);\n        }\n\n        .stroke-option {\n            width: 56px;\n            height: 56px;\n            border-radius: 14px;\n            border: 2px solid transparent;\n            background: rgba(255, 255, 255, 0.1);\n            cursor: pointer;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            gap: 4px;\n            transition: all 0.2s ease;\n        }\n\n        .stroke-option:active { transform: scale(0.95); }\n        .stroke-option.active { border-color: #667eea; background: rgba(102, 126, 234, 0.3); }\n        .stroke-preview { width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; }\n        .stroke-option span { font-size: 9px; color: white; opacity: 0.8; }\n\n        \n        /* Library Panel */\n        .library-panel {\n            position: fixed;\n            top: 0;\n            right: -350px;\n            width: 300px;\n            max-width: 85vw;\n            height: 100%;\n            background: rgba(26, 26, 46, 0.98);\n            -webkit-backdrop-filter: blur(20px);\n            backdrop-filter: blur(20px);\n            z-index: 2000;\n            transition: right 0.3s ease;\n            display: flex;\n            flex-direction: column;\n            padding-top: env(safe-area-inset-top, 20px);\n        }\n\n        .library-panel.visible {\n            right: 0;\n        }\n\n        .library-header {\n            padding: 20px;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            border-bottom: 1px solid rgba(255,255,255,0.1);\n        }\n\n        .library-header h2 {\n            color: white;\n            font-size: 18px;\n            font-weight: 600;\n        }\n\n        .library-close {\n            width: 36px;\n            height: 36px;\n            border-radius: 50%;\n            background: rgba(255,255,255,0.1);\n            border: none;\n            cursor: pointer;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n        }\n\n        .library-close svg { width: 20px; height: 20px; fill: white; }\n\n        .library-tabs {\n            display: flex;\n            padding: 0 20px;\n            gap: 8px;\n            margin-top: 16px;\n        }\n\n        .library-tab {\n            flex: 1;\n            padding: 12px;\n            border: none;\n            border-radius: 12px;\n            background: rgba(255,255,255,0.1);\n            color: white;\n            font-size: 14px;\n            font-weight: 500;\n            cursor: pointer;\n            transition: all 0.2s ease;\n        }\n\n        .library-tab.active {\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n        }\n\n        .library-content {\n            flex: 1;\n            overflow-y: auto;\n            -webkit-overflow-scrolling: touch;\n            padding: 20px;\n        }\n\n        .library-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 12px;\n        }\n\n        .library-item {\n            aspect-ratio: 1;\n            border-radius: 12px;\n            background: rgba(255,255,255,0.1);\n            cursor: pointer;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 36px;\n            transition: all 0.2s ease;\n            border: 2px solid transparent;\n        }\n\n        .library-item:active {\n            transform: scale(0.95);\n        }\n\n        .library-item.selected {\n            border-color: #667eea;\n            background: rgba(102, 126, 234, 0.3);\n        }\n\n        .library-item svg {\n            width: 50%;\n            height: 50%;\n            fill: white;\n            opacity: 0.9;\n        }\n\n        .stencil-preview {\n            width: 100%;\n            height: 100%;\n            object-fit: contain;\n            padding: 8px;\n        }\n\n        /* Sticker being placed */\n        .floating-sticker {\n            position: fixed;\n            font-size: 60px;\n            cursor: move;\n            z-index: 1500;\n            transform: translate(-50%, -50%);\n            transition: transform 0.1s ease;\n            filter: drop-shadow(0 4px 8px rgba(0,0,0,0.3));\n        }\n\n        .floating-sticker.placing {\n            animation: pulse 0.5s ease infinite alternate;\n        }\n\n        @keyframes pulse {\n            from { transform: translate(-50%, -50%) scale(1); }\n            to { transform: translate(-50%, -50%) scale(1.1); }\n        }\n\n        /* Overlay when library is open */\n        .library-overlay {\n            position: fixed;\n            inset: 0;\n            background: rgba(0,0,0,0.5);\n            z-index: 1999;\n            opacity: 0;\n            visibility: hidden;\n            transition: all 0.3s ease;\n        }\n\n        .library-overlay.visible {\n            opacity: 1;\n            visibility: visible;\n        }\n\n        /* Help overlay */\n        .help-overlay {\n            position: fixed;\n            inset: 0;\n            background: rgba(0, 0, 0, 0.9);\n            -webkit-backdrop-filter: blur(10px);\n            backdrop-filter: blur(10px);\n            z-index: 10001;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            opacity: 0;\n            visibility: hidden;\n            transition: all 0.3s ease;\n            padding: env(safe-area-inset-top, 20px) env(safe-area-inset-right, 20px) env(safe-area-inset-bottom, 20px) env(safe-area-inset-left, 20px);\n        }\n\n        .help-overlay.visible { opacity: 1; visibility: visible; }\n\n        .help-content {\n            background: rgba(26, 26, 46, 0.95);\n            border-radius: 24px;\n            padding: 32px;\n            max-width: 400px;\n            width: calc(100% - 40px);\n            color: white;\n            max-height: 90vh;\n            overflow-y: auto;\n        }\n\n        .help-content h2 { font-size: 24px; margin-bottom: 20px; text-align: center; }\n\n        .help-item {\n            display: flex;\n            align-items: center;\n            gap: 16px;\n            padding: 12px 0;\n            border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n        }\n\n        .help-item:last-child { border-bottom: none; }\n\n        .help-icon {\n            width: 40px;\n            height: 40px;\n            min-width: 40px;\n            border-radius: 12px;\n            background: rgba(102, 126, 234, 0.3);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n        }\n\n        .help-icon svg { width: 20px; height: 20px; fill: white; }\n        .help-text { flex: 1; }\n        .help-text strong { display: block; margin-bottom: 2px; }\n        .help-text span { font-size: 13px; opacity: 0.7; }\n\n        .close-help {\n            margin-top: 24px;\n            width: 100%;\n            padding: 16px;\n            border-radius: 12px;\n            border: none;\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            color: white;\n            font-size: 16px;\n            font-weight: 600;\n            cursor: pointer;\n        }\n\n        @media (max-width: 600px) {\n            .toolbar { bottom: 90px; bottom: calc(90px + env(safe-area-inset-bottom, 0px)); padding: 12px 16px; gap: 8px; }\n            .tool-btn, .color-btn, .pen-btn { width: 48px; height: 48px; min-width: 48px; min-height: 48px; }\n            .size-indicator input[type=\"range\"] { width: 80px; }\n            .toolbar-toggle { width: 56px; height: 56px; bottom: 16px; bottom: calc(16px + env(safe-area-inset-bottom, 0px)); }\n            .color-palette { bottom: 165px; bottom: calc(165px + env(safe-area-inset-bottom, 0px)); gap: 10px; padding: 16px; }\n            .pen-menu, .stroke-menu { bottom: 165px; bottom: calc(165px + env(safe-area-inset-bottom, 0px)); }\n            .pen-option, .stroke-option { width: 50px; height: 50px; }\n            .palette-color { width: 40px; height: 40px; min-width: 40px; min-height: 40px; }\n            .undo-redo-group { left: 72px; left: calc(72px + env(safe-area-inset-left, 0px)); }\n            .library-panel { width: 280px; }\n            .library-grid { grid-template-columns: repeat(3, 1fr); gap: 10px; }\n            .library-item { font-size: 28px; }\n        }\n\n        @media (max-width: 380px) {\n            .color-palette { grid-template-columns: repeat(5, 1fr); }\n            .custom-color-wrapper { grid-column: span 1; }\n        }\n\n        @media (orientation: landscape) and (max-height: 500px) {\n            .toolbar { bottom: 10px; bottom: calc(10px + env(safe-area-inset-bottom, 0px)); padding: 10px 16px; }\n            .toolbar-toggle { bottom: 10px; right: 20px; left: auto; transform: none; }\n        }\n\n        @media (min-width: 768px) {\n            .tool-btn, .color-btn, .pen-btn { width: 56px; height: 56px; min-width: 56px; min-height: 56px; }\n            .palette-color { width: 48px; height: 48px; }\n            .pen-option, .stroke-option { width: 60px; height: 60px; }\n            .toolbar { padding: 18px 24px; gap: 14px; }\n            .library-panel { width: 350px; }\n            .library-grid { grid-template-columns: repeat(4, 1fr); }\n        }\n    </style>\n</head>\n<body>\n    <div id=\"app\">\n        <canvas id=\"canvas\"></canvas>\n\n        <button class=\"quick-action left\" id=\"menuBtn\" title=\"Help\">\n            <svg viewBox=\"0 0 24 24\"><path d=\"M11 18h2v-2h-2v2zm1-16C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14c-2.21 0-4 1.79-4 4h2c0-1.1.9-2 2-2s2 .9 2 2c0 2-3 1.75-3 5h2c0-2.25 3-2.5 3-5 0-2.21-1.79-4-4-4z\"/></svg>\n        </button>\n\n        <div class=\"undo-redo-group\">\n            <button class=\"undo-redo-btn\" id=\"undoBtn\" title=\"Undo\" disabled>\n                <svg viewBox=\"0 0 24 24\"><path d=\"M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z\"/></svg>\n            </button>\n            <button class=\"undo-redo-btn\" id=\"redoBtn\" title=\"Redo\" disabled>\n                <svg viewBox=\"0 0 24 24\"><path d=\"M18.4 10.6C16.55 8.99 14.15 8 11.5 8c-4.65 0-8.58 3.03-9.96 7.22L3.9 16c1.05-3.19 4.05-5.5 7.6-5.5 1.95 0 3.73.72 5.12 1.88L13 16h9V7l-3.6 3.6z\"/></svg>\n            </button>\n        </div>\n\n        <div class=\"top-right-group\">\n            <button class=\"top-btn\" id=\"libraryBtn\" title=\"Stickers & Stencils\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z\"/></svg>\n            </button>\n            <button class=\"top-btn\" id=\"fullscreenBtn\" title=\"Fullscreen\">\n                <svg class=\"enter-icon\" viewBox=\"0 0 24 24\"><path d=\"M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z\"/></svg>\n                <svg class=\"exit-icon\" viewBox=\"0 0 24 24\"><path d=\"M5 16h3v3h2v-5H5v2zm3-8H5v2h5V5H8v3zm6 11h2v-3h3v-2h-5v5zm2-11V5h-2v5h5V8h-3z\"/></svg>\n            </button>\n            <button class=\"top-btn\" id=\"downloadBtn\" title=\"Save\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z\"/></svg>\n            </button>\n        </div>\n\n        <button class=\"toolbar-toggle\" id=\"toolbarToggle\">\n            <svg viewBox=\"0 0 24 24\"><path d=\"M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z\"/></svg>\n        </button>\n\n        <div class=\"toolbar\" id=\"toolbar\">\n            <button class=\"tool-btn active\" id=\"brushTool\" title=\"Brush\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M7 14c-1.66 0-3 1.34-3 3 0 1.31-1.16 2-2 2 .92 1.22 2.49 2 4 2 2.21 0 4-1.79 4-4 0-1.66-1.34-3-3-3zm13.71-9.37l-1.34-1.34c-.39-.39-1.02-.39-1.41 0L9 12.25 11.75 15l8.96-8.96c.39-.39.39-1.02 0-1.41z\"/></svg>\n            </button>\n            <button class=\"pen-btn\" id=\"penTypeBtn\" title=\"Pen Type\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z\"/></svg>\n            </button>\n            <button class=\"pen-btn\" id=\"strokeShapeBtn\" title=\"Stroke Shape\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M2 4c0-.55.45-1 1-1h3c.55 0 1 .45 1 1v3c0 .55-.45 1-1 1H3c-.55 0-1-.45-1-1V4zm7 0h12c.55 0 1 .45 1 1s-.45 1-1 1H9c-.55 0-1-.45-1-1s.45-1 1-1zm-7 9c0-.55.45-1 1-1h3c.55 0 1 .45 1 1v3c0 .55-.45 1-1 1H3c-.55 0-1-.45-1-1v-3zm7 0h12c.55 0 1 .45 1 1s-.45 1-1 1H9c-.55 0-1-.45-1-1s.45-1 1-1z\"/></svg>\n            </button>\n            <button class=\"tool-btn\" id=\"eraserTool\" title=\"Eraser\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M16.24 3.56l4.95 4.94c.78.79.78 2.05 0 2.84L12 20.53a4.01 4.01 0 01-5.66 0L2.81 17c-.78-.79-.78-2.05 0-2.84l10.6-10.6c.79-.78 2.05-.78 2.83 0zM4.22 15.58l3.54 3.53c.78.79 2.04.79 2.83 0l3.53-3.53-4.95-4.95-4.95 4.95z\"/></svg>\n            </button>\n            <div class=\"toolbar-divider\"></div>\n            <button class=\"color-btn\" id=\"colorBtn\" style=\"background: #000000;\" title=\"Color\"></button>\n            <div class=\"toolbar-divider\"></div>\n            <div class=\"size-indicator\">\n                <svg width=\"16\" height=\"16\" fill=\"white\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"4\"/></svg>\n                <input type=\"range\" id=\"brushSize\" min=\"2\" max=\"80\" value=\"8\">\n                <span class=\"size-value\" id=\"sizeValue\">8</span>\n            </div>\n            <div class=\"toolbar-divider\"></div>\n            <button class=\"tool-btn\" id=\"clearBtn\" title=\"Clear\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z\"/></svg>\n            </button>\n        </div>\n\n        <div class=\"color-palette\" id=\"colorPalette\">\n            <button class=\"palette-color active\" style=\"background: #000000;\" data-color=\"#000000\"></button>\n            <button class=\"palette-color\" style=\"background: #ffffff; border: 2px solid rgba(0,0,0,0.2);\" data-color=\"#ffffff\"></button>\n            <button class=\"palette-color\" style=\"background: #808080;\" data-color=\"#808080\"></button>\n            <button class=\"palette-color\" style=\"background: #ff0000;\" data-color=\"#ff0000\"></button>\n            <button class=\"palette-color\" style=\"background: #ff6b6b;\" data-color=\"#ff6b6b\"></button>\n            <button class=\"palette-color\" style=\"background: #ff8c00;\" data-color=\"#ff8c00\"></button>\n            <button class=\"palette-color\" style=\"background: #ffa500;\" data-color=\"#ffa500\"></button>\n            <button class=\"palette-color\" style=\"background: #ffff00;\" data-color=\"#ffff00\"></button>\n            <button class=\"palette-color\" style=\"background: #98d8c8;\" data-color=\"#98d8c8\"></button>\n            <button class=\"palette-color\" style=\"background: #00ff00;\" data-color=\"#00ff00\"></button>\n            <button class=\"palette-color\" style=\"background: #228b22;\" data-color=\"#228b22\"></button>\n            <button class=\"palette-color\" style=\"background: #00ffff;\" data-color=\"#00ffff\"></button>\n            <button class=\"palette-color\" style=\"background: #4ecdc4;\" data-color=\"#4ecdc4\"></button>\n            <button class=\"palette-color\" style=\"background: #0000ff;\" data-color=\"#0000ff\"></button>\n            <button class=\"palette-color\" style=\"background: #667eea;\" data-color=\"#667eea\"></button>\n            <button class=\"palette-color\" style=\"background: #800080;\" data-color=\"#800080\"></button>\n            <button class=\"palette-color\" style=\"background: #764ba2;\" data-color=\"#764ba2\"></button>\n            <button class=\"palette-color\" style=\"background: #ff00ff;\" data-color=\"#ff00ff\"></button>\n            <button class=\"palette-color\" style=\"background: #ffc0cb;\" data-color=\"#ffc0cb\"></button>\n            <button class=\"palette-color\" style=\"background: #8b4513;\" data-color=\"#8b4513\"></button>\n            <button class=\"palette-color\" style=\"background: #d2691e;\" data-color=\"#d2691e\"></button>\n            <button class=\"palette-color\" style=\"background: #f5deb3;\" data-color=\"#f5deb3\"></button>\n            <div class=\"custom-color-wrapper\">\n                <input type=\"color\" class=\"custom-color-input\" id=\"customColor\" value=\"#667eea\" title=\"Custom Color\">\n            </div>\n        </div>\n\n        <!-- Pen Type Menu (Media) -->\n        <div class=\"pen-menu\" id=\"penMenu\">\n            <button class=\"pen-option active\" data-pen=\"marker\" title=\"Marker\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z\"/></svg>\n                <span>Marker</span>\n            </button>\n            <button class=\"pen-option\" data-pen=\"pencil\" title=\"Pencil\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83zM3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25z\"/></svg>\n                <span>Pencil</span>\n            </button>\n            <button class=\"pen-option\" data-pen=\"ink\" title=\"Ink Pen\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M4.5 21.5c1-1 1.5-2.5 1.5-4 0-2-1-3-1-3s-1 1-1 3c0 1.5.5 3 1.5 4zm5.5-6.5L14 11l-4 4zM18.27 3.27l-2.54 2.54 2.54 2.54 1.27-1.27c.39-.39.39-1.02 0-1.41l-1.27-1.27v-1.13zM14 6l-9.5 9.5L3 21l5.5-1.5L18 10l-4-4z\"/></svg>\n                <span>Ink</span>\n            </button>\n            <button class=\"pen-option\" data-pen=\"ballpoint\" title=\"Ballpoint\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M17.75 7L14 3.25l-10 10V17h3.75l10-10zm2.96-2.96a.996.996 0 000-1.41L18.37.29a.996.996 0 00-1.41 0L15 2.25 18.75 6l1.96-1.96z\"/></svg>\n                <span>Ballpoint</span>\n            </button>\n            <button class=\"pen-option\" data-pen=\"felt\" title=\"Felt Tip\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M18 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-6 16c-.55 0-1-.45-1-1V7c0-.55.45-1 1-1s1 .45 1 1v10c0 .55-.45 1-1 1z\"/></svg>\n                <span>Felt</span>\n            </button>\n            <button class=\"pen-option\" data-pen=\"crayon\" title=\"Crayon\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L4.5 20.29l.71.71L12 18l6.79 3 .71-.71L12 2zm0 4l4.5 11H7.5L12 6z\"/></svg>\n                <span>Crayon</span>\n            </button>\n            <button class=\"pen-option\" data-pen=\"chalk\" title=\"Chalk\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M19.5 3.5L18 2l-1.5 1.5L15 2l-1.5 1.5L12 2l-1.5 1.5L9 2 7.5 3.5 6 2v14H4v3c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2v-3h-2V2l-1.5 1.5z\"/></svg>\n                <span>Chalk</span>\n            </button>\n            <button class=\"pen-option\" data-pen=\"charcoal\" title=\"Charcoal\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M17.66 8L12 2.35 6.34 8A8.02 8.02 0 004 13.64c0 2 .78 4.11 2.34 5.67a7.99 7.99 0 0011.32 0c1.56-1.56 2.34-3.67 2.34-5.67S19.22 9.56 17.66 8zM6 14c.01-2 .62-3.27 1.76-4.4L12 5.27l4.24 4.38C17.38 10.77 17.99 12 18 14H6z\"/></svg>\n                <span>Charcoal</span>\n            </button>\n            <button class=\"pen-option\" data-pen=\"highlighter\" title=\"Highlighter\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M6 14l3 3v5h6v-5l3-3V9H6v5zm5-12h2v3h-2V2zM3.5 5.875L4.914 4.46l2.12 2.122L5.622 7.997 3.5 5.875zm13.46.71l2.123-2.12 1.414 1.414L18.375 8 16.96 6.586z\"/></svg>\n                <span>Highlight</span>\n            </button>\n            <button class=\"pen-option\" data-pen=\"watercolor\" title=\"Watercolor\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M12 2c-5.33 4.55-8 8.48-8 11.8 0 4.98 3.8 8.2 8 8.2s8-3.22 8-8.2c0-3.32-2.67-7.25-8-11.8zm0 18c-3.35 0-6-2.57-6-6.2 0-2.34 1.95-5.44 6-9.14 4.05 3.7 6 6.79 6 9.14 0 3.63-2.65 6.2-6 6.2z\"/></svg>\n                <span>Water</span>\n            </button>\n            <button class=\"pen-option\" data-pen=\"oil\" title=\"Oil Paint\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z\"/></svg>\n                <span>Oil</span>\n            </button>\n            <button class=\"pen-option\" data-pen=\"spray\" title=\"Spray Paint\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M19 12h-3v9h-4v-9H9l5-5 5 5zM7 6c0-1.1.9-2 2-2h1V2h4v2h1c1.1 0 2 .9 2 2v1H7V6z\"/></svg>\n                <span>Spray</span>\n            </button>\n        </div>\n\n        <!-- Stroke Shape Menu -->\n        <div class=\"stroke-menu\" id=\"strokeMenu\">\n            <button class=\"stroke-option active\" data-stroke=\"round\" title=\"Round\">\n                <div class=\"stroke-preview\"><svg viewBox=\"0 0 24 24\" fill=\"white\"><circle cx=\"12\" cy=\"12\" r=\"8\"/></svg></div>\n                <span>Round</span>\n            </button>\n            <button class=\"stroke-option\" data-stroke=\"flat\" title=\"Flat\">\n                <div class=\"stroke-preview\"><svg viewBox=\"0 0 24 24\" fill=\"white\"><rect x=\"2\" y=\"9\" width=\"20\" height=\"6\" rx=\"1\"/></svg></div>\n                <span>Flat</span>\n            </button>\n            <button class=\"stroke-option\" data-stroke=\"chisel\" title=\"Chisel\">\n                <div class=\"stroke-preview\"><svg viewBox=\"0 0 24 24\" fill=\"white\"><polygon points=\"4,16 20,8 20,16\"/></svg></div>\n                <span>Chisel</span>\n            </button>\n            <button class=\"stroke-option\" data-stroke=\"calligraphy\" title=\"Calligraphy\">\n                <div class=\"stroke-preview\"><svg viewBox=\"0 0 24 24\" fill=\"white\"><ellipse cx=\"12\" cy=\"12\" rx=\"3\" ry=\"10\" transform=\"rotate(-45 12 12)\"/></svg></div>\n                <span>Callig.</span>\n            </button>\n            <button class=\"stroke-option\" data-stroke=\"pointed\" title=\"Pointed\">\n                <div class=\"stroke-preview\"><svg viewBox=\"0 0 24 24\" fill=\"white\"><polygon points=\"12,2 20,22 12,18 4,22\"/></svg></div>\n                <span>Pointed</span>\n            </button>\n            <button class=\"stroke-option\" data-stroke=\"square\" title=\"Square\">\n                <div class=\"stroke-preview\"><svg viewBox=\"0 0 24 24\" fill=\"white\"><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\"/></svg></div>\n                <span>Square</span>\n            </button>\n        </div>\n\n        <!-- Library Overlay -->\n        <div class=\"library-overlay\" id=\"libraryOverlay\"></div>\n\n        <!-- Library Panel -->\n        <div class=\"library-panel\" id=\"libraryPanel\">\n            <div class=\"library-header\">\n                <h2>Library</h2>\n                <button class=\"library-close\" id=\"libraryClose\">\n                    <svg viewBox=\"0 0 24 24\"><path d=\"M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z\"/></svg>\n                </button>\n            </div>\n            <div class=\"library-tabs\">\n                <button class=\"library-tab active\" data-tab=\"stickers\">Stickers</button>\n                <button class=\"library-tab\" data-tab=\"stencils\">Stencils</button>\n            </div>\n            <div class=\"library-content\">\n                <div class=\"library-grid\" id=\"stickersGrid\">\n                    <!-- Stickers will be populated by JS -->\n                </div>\n                <div class=\"library-grid\" id=\"stencilsGrid\" style=\"display:none;\">\n                    <!-- Stencils will be populated by JS -->\n                </div>\n            </div>\n        </div>\n\n        <div class=\"toast\" id=\"toast\"></div>\n\n        <div class=\"help-overlay\" id=\"helpOverlay\">\n            <div class=\"help-content\">\n                <h2>How to Draw</h2>\n                <div class=\"help-item\">\n                    <div class=\"help-icon\"><svg viewBox=\"0 0 24 24\"><path d=\"M7 14c-1.66 0-3 1.34-3 3 0 1.31-1.16 2-2 2 .92 1.22 2.49 2 4 2 2.21 0 4-1.79 4-4 0-1.66-1.34-3-3-3zm13.71-9.37l-1.34-1.34c-.39-.39-1.02-.39-1.41 0L9 12.25 11.75 15l8.96-8.96c.39-.39.39-1.02 0-1.41z\"/></svg></div>\n                    <div class=\"help-text\"><strong>Draw</strong><span>Touch and drag on the canvas</span></div>\n                </div>\n                <div class=\"help-item\">\n                    <div class=\"help-icon\"><svg viewBox=\"0 0 24 24\"><path d=\"M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z\"/></svg></div>\n                    <div class=\"help-text\"><strong>Tools</strong><span>Tap + button to show toolbar</span></div>\n                </div>\n                <div class=\"help-item\">\n                    <div class=\"help-icon\"><svg viewBox=\"0 0 24 24\"><path d=\"M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z\"/></svg></div>\n                    <div class=\"help-text\"><strong>Stickers & Stencils</strong><span>Tap image icon for fun graphics</span></div>\n                </div>\n                <div class=\"help-item\">\n                    <div class=\"help-icon\"><svg viewBox=\"0 0 24 24\"><path d=\"M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z\"/></svg></div>\n                    <div class=\"help-text\"><strong>Undo</strong><span>Two-finger tap or undo button</span></div>\n                </div>\n                <button class=\"close-help\" id=\"closeHelp\">Start Drawing</button>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        const state = {\n            isDrawing: false,\n            currentColor: '#000000',\n            brushSize: 8,\n            tool: 'brush',\n            penType: 'marker',\n            strokeShape: 'round',\n            lastX: 0,\n            lastY: 0,\n            lastAngle: 0,\n            toolbarVisible: false,\n            colorPaletteVisible: false,\n            penMenuVisible: false,\n            strokeMenuVisible: false,\n            libraryVisible: false,\n            undoStack: [],\n            redoStack: [],\n            maxUndoSteps: 30,\n            isFullscreen: false,\n            isIOS: false,\n            activeTab: 'stickers',\n            placingSticker: null\n        };\n\n        // Stickers library\n        const stickers = [\n            '\ud83d\ude00', '\ud83d\ude0d', '\ud83e\udd73', '\ud83d\ude0e', '\ud83e\udd29', '\ud83d\ude07',\n            '\u2764\ufe0f', '\ud83d\udc96', '\ud83d\udc95', '\u2728', '\u2b50', '\ud83c\udf1f',\n            '\ud83c\udf08', '\u2600\ufe0f', '\ud83c\udf19', '\u26a1', '\ud83d\udd25', '\ud83d\udca7',\n            '\ud83c\udf38', '\ud83c\udf3a', '\ud83c\udf3b', '\ud83c\udf37', '\ud83c\udf39', '\ud83c\udf40',\n            '\ud83e\udd8b', '\ud83d\udc1d', '\ud83d\udc1e', '\ud83d\udc31', '\ud83d\udc36', '\ud83e\udd84',\n            '\ud83c\udf88', '\ud83c\udf89', '\ud83c\udf81', '\ud83c\udf80', '\ud83c\udfc6', '\ud83d\udc51',\n            '\ud83c\udf4e', '\ud83c\udf53', '\ud83c\udf55', '\ud83c\udf66', '\ud83e\uddc1', '\ud83c\udf69',\n            '\u26bd', '\ud83c\udfc0', '\ud83c\udfb8', '\ud83c\udfa8', '\ud83d\udcf7', '\ud83d\udc8e'\n        ];\n\n        // Stencils library (SVG paths for drawing templates)\n        const stencils = [\n            { name: 'Star', icon: '\u2b50', path: (ctx, x, y, size) => {\n                const spikes = 5, outerR = size, innerR = size/2;\n                ctx.beginPath();\n                for(let i = 0; i < spikes * 2; i++) {\n                    const r = i % 2 === 0 ? outerR : innerR;\n                    const angle = (i * Math.PI / spikes) - Math.PI/2;\n                    const px = x + Math.cos(angle) * r;\n                    const py = y + Math.sin(angle) * r;\n                    i === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);\n                }\n                ctx.closePath();\n            }},\n            { name: 'Heart', icon: '\u2764\ufe0f', path: (ctx, x, y, size) => {\n                ctx.beginPath();\n                ctx.moveTo(x, y + size/4);\n                ctx.bezierCurveTo(x, y - size/2, x - size, y - size/2, x - size, y + size/4);\n                ctx.bezierCurveTo(x - size, y + size/2, x, y + size, x, y + size);\n                ctx.bezierCurveTo(x, y + size, x + size, y + size/2, x + size, y + size/4);\n                ctx.bezierCurveTo(x + size, y - size/2, x, y - size/2, x, y + size/4);\n                ctx.closePath();\n            }},\n            { name: 'Circle', icon: '\u2b55', path: (ctx, x, y, size) => {\n                ctx.beginPath();\n                ctx.arc(x, y, size, 0, Math.PI * 2);\n                ctx.closePath();\n            }},\n            { name: 'Square', icon: '\u2b1c', path: (ctx, x, y, size) => {\n                ctx.beginPath();\n                ctx.rect(x - size, y - size, size * 2, size * 2);\n                ctx.closePath();\n            }},\n            { name: 'Triangle', icon: '\ud83d\udd3a', path: (ctx, x, y, size) => {\n                ctx.beginPath();\n                ctx.moveTo(x, y - size);\n                ctx.lineTo(x + size, y + size);\n                ctx.lineTo(x - size, y + size);\n                ctx.closePath();\n            }},\n            { name: 'Diamond', icon: '\ud83d\udc8e', path: (ctx, x, y, size) => {\n                ctx.beginPath();\n                ctx.moveTo(x, y - size);\n                ctx.lineTo(x + size, y);\n                ctx.lineTo(x, y + size);\n                ctx.lineTo(x - size, y);\n                ctx.closePath();\n            }},\n            { name: 'House', icon: '\ud83c\udfe0', path: (ctx, x, y, size) => {\n                ctx.beginPath();\n                // Roof\n                ctx.moveTo(x - size, y);\n                ctx.lineTo(x, y - size);\n                ctx.lineTo(x + size, y);\n                // Walls\n                ctx.lineTo(x + size * 0.7, y);\n                ctx.lineTo(x + size * 0.7, y + size);\n                ctx.lineTo(x - size * 0.7, y + size);\n                ctx.lineTo(x - size * 0.7, y);\n                ctx.closePath();\n            }},\n            { name: 'Tree', icon: '\ud83c\udf32', path: (ctx, x, y, size) => {\n                ctx.beginPath();\n                // Triangle top\n                ctx.moveTo(x, y - size);\n                ctx.lineTo(x + size * 0.8, y + size * 0.3);\n                ctx.lineTo(x - size * 0.8, y + size * 0.3);\n                ctx.closePath();\n                ctx.fill();\n                // Trunk\n                ctx.fillRect(x - size * 0.15, y + size * 0.3, size * 0.3, size * 0.7);\n            }},\n            { name: 'Flower', icon: '\ud83c\udf38', path: (ctx, x, y, size) => {\n                const petals = 6;\n                for (let i = 0; i < petals; i++) {\n                    const angle = (i / petals) * Math.PI * 2;\n                    const px = x + Math.cos(angle) * size * 0.5;\n                    const py = y + Math.sin(angle) * size * 0.5;\n                    ctx.beginPath();\n                    ctx.arc(px, py, size * 0.4, 0, Math.PI * 2);\n                    ctx.fill();\n                }\n                ctx.beginPath();\n                ctx.arc(x, y, size * 0.3, 0, Math.PI * 2);\n            }},\n            { name: 'Sun', icon: '\u2600\ufe0f', path: (ctx, x, y, size) => {\n                ctx.beginPath();\n                ctx.arc(x, y, size * 0.5, 0, Math.PI * 2);\n                ctx.fill();\n                for (let i = 0; i < 8; i++) {\n                    const angle = (i / 8) * Math.PI * 2;\n                    ctx.beginPath();\n                    ctx.moveTo(x + Math.cos(angle) * size * 0.6, y + Math.sin(angle) * size * 0.6);\n                    ctx.lineTo(x + Math.cos(angle) * size, y + Math.sin(angle) * size);\n                    ctx.lineWidth = size * 0.1;\n                    ctx.stroke();\n                }\n            }},\n            { name: 'Moon', icon: '\ud83c\udf19', path: (ctx, x, y, size) => {\n                ctx.beginPath();\n                ctx.arc(x, y, size, 0, Math.PI * 2);\n                ctx.fill();\n                ctx.globalCompositeOperation = 'destination-out';\n                ctx.beginPath();\n                ctx.arc(x + size * 0.4, y - size * 0.2, size * 0.7, 0, Math.PI * 2);\n                ctx.fill();\n                ctx.globalCompositeOperation = 'source-over';\n            }},\n            { name: 'Cloud', icon: '\u2601\ufe0f', path: (ctx, x, y, size) => {\n                ctx.beginPath();\n                ctx.arc(x - size * 0.5, y, size * 0.5, 0, Math.PI * 2);\n                ctx.arc(x, y - size * 0.3, size * 0.6, 0, Math.PI * 2);\n                ctx.arc(x + size * 0.5, y, size * 0.5, 0, Math.PI * 2);\n                ctx.arc(x, y + size * 0.2, size * 0.4, 0, Math.PI * 2);\n            }}\n        ];\n\n        state.isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) ||\n                      (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);\n\n        const app = document.getElementById('app');\n        const canvas = document.getElementById('canvas');\n        const ctx = canvas.getContext('2d', { willReadFrequently: true, alpha: false });\n        const toolbar = document.getElementById('toolbar');\n        const toolbarToggle = document.getElementById('toolbarToggle');\n        const colorPalette = document.getElementById('colorPalette');\n        const colorBtn = document.getElementById('colorBtn');\n        const brushSizeInput = document.getElementById('brushSize');\n        const sizeValue = document.getElementById('sizeValue');\n        const toast = document.getElementById('toast');\n        const helpOverlay = document.getElementById('helpOverlay');\n        const fullscreenBtn = document.getElementById('fullscreenBtn');\n        const libraryPanel = document.getElementById('libraryPanel');\n        const libraryOverlay = document.getElementById('libraryOverlay');\n        const stickersGrid = document.getElementById('stickersGrid');\n        const stencilsGrid = document.getElementById('stencilsGrid');\n        const penMenu = document.getElementById('penMenu');\n        const penTypeBtn = document.getElementById('penTypeBtn');\n        const strokeMenu = document.getElementById('strokeMenu');\n        const strokeShapeBtn = document.getElementById('strokeShapeBtn');\n\n        // Prevent overscroll\n        function preventOverscroll() {\n            document.body.addEventListener('touchmove', function(e) {\n                if (e.target === canvas || e.target === document.body || e.target === app) {\n                    e.preventDefault();\n                }\n            }, { passive: false });\n            document.addEventListener('gesturestart', e => e.preventDefault());\n            document.addEventListener('gesturechange', e => e.preventDefault());\n        }\n\n        function initCanvas() {\n            const dpr = window.devicePixelRatio || 1;\n            const width = window.innerWidth;\n            const height = window.innerHeight;\n            canvas.width = width * dpr;\n            canvas.height = height * dpr;\n            canvas.style.width = width + 'px';\n            canvas.style.height = height + 'px';\n            ctx.scale(dpr, dpr);\n            ctx.lineCap = 'round';\n            ctx.lineJoin = 'round';\n            ctx.fillStyle = '#ffffff';\n            ctx.fillRect(0, 0, width, height);\n            saveState();\n        }\n\n        function handleResize() {\n            const imageData = canvas.toDataURL('image/png');\n            const oldWidth = canvas.style.width ? parseInt(canvas.style.width) : window.innerWidth;\n            const oldHeight = canvas.style.height ? parseInt(canvas.style.height) : window.innerHeight;\n            const dpr = window.devicePixelRatio || 1;\n            const width = window.innerWidth;\n            const height = window.innerHeight;\n\n            canvas.width = width * dpr;\n            canvas.height = height * dpr;\n            canvas.style.width = width + 'px';\n            canvas.style.height = height + 'px';\n            ctx.scale(dpr, dpr);\n            ctx.lineCap = 'round';\n            ctx.lineJoin = 'round';\n\n            // Fill white background immediately\n            ctx.fillStyle = '#ffffff';\n            ctx.fillRect(0, 0, width, height);\n\n            const img = new Image();\n            img.onload = () => {\n                // Draw the old content preserving aspect\n                ctx.drawImage(img, 0, 0, oldWidth, oldHeight);\n            };\n            img.src = imageData;\n        }\n\n        function saveState() {\n            state.undoStack.push(canvas.toDataURL('image/png', 0.8));\n            if (state.undoStack.length > state.maxUndoSteps) state.undoStack.shift();\n            state.redoStack = [];\n            updateUndoRedoButtons();\n        }\n\n        function undo() {\n            if (state.undoStack.length > 1) {\n                state.redoStack.push(state.undoStack.pop());\n                restoreState(state.undoStack[state.undoStack.length - 1]);\n                updateUndoRedoButtons();\n                showToast('Undo');\n            }\n        }\n\n        function redo() {\n            if (state.redoStack.length > 0) {\n                const imageData = state.redoStack.pop();\n                state.undoStack.push(imageData);\n                restoreState(imageData);\n                updateUndoRedoButtons();\n                showToast('Redo');\n            }\n        }\n\n        function restoreState(imageData) {\n            const img = new Image();\n            img.onload = () => {\n                ctx.fillStyle = '#ffffff';\n                ctx.fillRect(0, 0, window.innerWidth, window.innerHeight);\n                ctx.drawImage(img, 0, 0, window.innerWidth, window.innerHeight);\n            };\n            img.src = imageData;\n        }\n\n        function updateUndoRedoButtons() {\n            document.getElementById('undoBtn').disabled = state.undoStack.length <= 1;\n            document.getElementById('redoBtn').disabled = state.redoStack.length === 0;\n        }\n\n        function getCoords(e) {\n            const rect = canvas.getBoundingClientRect();\n            let clientX, clientY;\n            if (e.touches && e.touches.length > 0) {\n                clientX = e.touches[0].clientX;\n                clientY = e.touches[0].clientY;\n            } else {\n                clientX = e.clientX;\n                clientY = e.clientY;\n            }\n            return { x: clientX - rect.left, y: clientY - rect.top };\n        }\n\n        // Drawing utility functions\n        function hexToRgb(hex) {\n            const result = /^#?([a-f\\d]{2})([a-f\\d]{2})([a-f\\d]{2})$/i.exec(hex);\n            return result ? {\n                r: parseInt(result[1], 16),\n                g: parseInt(result[2], 16),\n                b: parseInt(result[3], 16)\n            } : { r: 0, g: 0, b: 0 };\n        }\n\n        function getStrokeAngle(x1, y1, x2, y2) {\n            return Math.atan2(y2 - y1, x2 - x1);\n        }\n\n        // Get stroke shape function based on current shape setting\n        function getStrokeShape(size, angle) {\n            const shape = state.tool === 'eraser' ? 'round' : state.strokeShape;\n            return { shape, size, angle };\n        }\n\n        // Draw a single stamp of the current stroke shape\n        function drawStamp(px, py, size, angle, alpha = 1) {\n            const shape = state.tool === 'eraser' ? 'round' : state.strokeShape;\n            ctx.save();\n            ctx.translate(px, py);\n\n            if (alpha < 1) {\n                ctx.globalAlpha = alpha;\n            }\n\n            switch (shape) {\n                case 'flat':\n                    ctx.rotate(angle);\n                    ctx.fillRect(-size, -size * 0.2, size * 2, size * 0.4);\n                    break;\n                case 'chisel':\n                    ctx.rotate(angle + Math.PI/6);\n                    ctx.beginPath();\n                    ctx.moveTo(-size * 0.8, size * 0.15);\n                    ctx.lineTo(size * 0.8, -size * 0.15);\n                    ctx.lineTo(size * 0.8, size * 0.15);\n                    ctx.lineTo(-size * 0.8, size * 0.15);\n                    ctx.closePath();\n                    ctx.fill();\n                    break;\n                case 'calligraphy':\n                    ctx.rotate(Math.PI / 4);\n                    ctx.beginPath();\n                    ctx.ellipse(0, 0, size * 0.2, size * 0.8, 0, 0, Math.PI * 2);\n                    ctx.fill();\n                    break;\n                case 'pointed':\n                    ctx.rotate(angle);\n                    ctx.beginPath();\n                    ctx.moveTo(size, 0);\n                    ctx.lineTo(-size * 0.5, -size * 0.4);\n                    ctx.lineTo(-size * 0.5, size * 0.4);\n                    ctx.closePath();\n                    ctx.fill();\n                    break;\n                case 'square':\n                    ctx.rotate(angle);\n                    ctx.fillRect(-size * 0.5, -size * 0.5, size, size);\n                    break;\n                default: // round\n                    ctx.beginPath();\n                    ctx.arc(0, 0, size / 2, 0, Math.PI * 2);\n                    ctx.fill();\n            }\n            ctx.restore();\n            ctx.globalAlpha = 1;\n        }\n\n        // Marker - solid smooth strokes\n        function drawMarker(x, y, isStart) {\n            const color = state.tool === 'eraser' ? '#ffffff' : state.currentColor;\n            ctx.globalCompositeOperation = 'source-over';\n            ctx.fillStyle = color;\n            ctx.strokeStyle = color;\n\n            const angle = isStart ? state.lastAngle : getStrokeAngle(state.lastX, state.lastY, x, y);\n            if (!isStart) state.lastAngle = angle;\n            const size = state.brushSize;\n\n            if (state.strokeShape === 'round' && state.tool !== 'eraser') {\n                ctx.lineWidth = size;\n                ctx.lineCap = 'round';\n                ctx.lineJoin = 'round';\n                if (isStart) {\n                    ctx.beginPath();\n                    ctx.arc(x, y, size / 2, 0, Math.PI * 2);\n                    ctx.fill();\n                } else {\n                    ctx.beginPath();\n                    ctx.moveTo(state.lastX, state.lastY);\n                    ctx.lineTo(x, y);\n                    ctx.stroke();\n                }\n            } else {\n                if (isStart) {\n                    drawStamp(x, y, size / 2, angle);\n                } else {\n                    const dist = Math.hypot(x - state.lastX, y - state.lastY);\n                    const steps = Math.max(1, Math.floor(dist / (size / 4)));\n                    for (let i = 0; i <= steps; i++) {\n                        const t = i / steps;\n                        const px = state.lastX + (x - state.lastX) * t;\n                        const py = state.lastY + (y - state.lastY) * t;\n                        drawStamp(px, py, size / 2, angle);\n                    }\n                }\n            }\n        }\n\n        // Pencil - light textured strokes\n        function drawPencil(x, y, isStart) {\n            const color = state.tool === 'eraser' ? '#ffffff' : state.currentColor;\n            const rgb = hexToRgb(color);\n            ctx.globalCompositeOperation = 'source-over';\n\n            const angle = isStart ? state.lastAngle : getStrokeAngle(state.lastX, state.lastY, x, y);\n            if (!isStart) state.lastAngle = angle;\n            const size = state.brushSize * 0.6;\n\n            ctx.fillStyle = `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.7)`;\n\n            if (isStart) {\n                drawStamp(x, y, size / 2, angle, 0.7);\n            } else {\n                const dist = Math.hypot(x - state.lastX, y - state.lastY);\n                const steps = Math.max(1, Math.floor(dist / 2));\n                for (let i = 0; i <= steps; i++) {\n                    const t = i / steps;\n                    const px = state.lastX + (x - state.lastX) * t;\n                    const py = state.lastY + (y - state.lastY) * t;\n                    drawStamp(px, py, size / 2, angle, 0.6 + Math.random() * 0.2);\n\n                    // Add texture\n                    if (Math.random() > 0.6) {\n                        ctx.fillStyle = `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, ${Math.random() * 0.3})`;\n                        ctx.fillRect(px + (Math.random() - 0.5) * size, py + (Math.random() - 0.5) * size, 1, 1);\n                        ctx.fillStyle = `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.7)`;\n                    }\n                }\n            }\n        }\n\n        // Crayon - textured rough strokes\n        function drawCrayon(x, y, isStart) {\n            const color = state.tool === 'eraser' ? '#ffffff' : state.currentColor;\n            const rgb = hexToRgb(color);\n            ctx.globalCompositeOperation = 'source-over';\n\n            const size = state.brushSize;\n\n            const drawCrayonMark = (px, py) => {\n                for (let j = 0; j < size * 2; j++) {\n                    const offsetX = (Math.random() - 0.5) * size;\n                    const offsetY = (Math.random() - 0.5) * size;\n                    const alpha = Math.random() * 0.4 + 0.3;\n                    ctx.fillStyle = `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, ${alpha})`;\n                    ctx.fillRect(px + offsetX, py + offsetY, Math.random() * 2 + 1, Math.random() * 2 + 1);\n                }\n            };\n\n            if (isStart) {\n                drawCrayonMark(x, y);\n            } else {\n                const dist = Math.hypot(x - state.lastX, y - state.lastY);\n                const steps = Math.max(1, Math.floor(dist / 2));\n                for (let i = 0; i <= steps; i++) {\n                    const t = i / steps;\n                    const px = state.lastX + (x - state.lastX) * t;\n                    const py = state.lastY + (y - state.lastY) * t;\n                    drawCrayonMark(px, py);\n                }\n            }\n        }\n\n        // Ink - smooth flowing strokes with slight variation\n        function drawInk(x, y, isStart) {\n            const color = state.tool === 'eraser' ? '#ffffff' : state.currentColor;\n            const rgb = hexToRgb(color);\n            ctx.globalCompositeOperation = 'source-over';\n\n            const angle = isStart ? state.lastAngle : getStrokeAngle(state.lastX, state.lastY, x, y);\n            if (!isStart) state.lastAngle = angle;\n            const size = state.brushSize * 0.8;\n\n            ctx.fillStyle = color;\n\n            if (isStart) {\n                drawStamp(x, y, size / 2, angle);\n            } else {\n                const dist = Math.hypot(x - state.lastX, y - state.lastY);\n                const steps = Math.max(1, Math.floor(dist));\n                for (let i = 0; i <= steps; i++) {\n                    const t = i / steps;\n                    const px = state.lastX + (x - state.lastX) * t;\n                    const py = state.lastY + (y - state.lastY) * t;\n                    // Slight size variation for ink flow effect\n                    const sizeVar = size / 2 * (0.9 + Math.random() * 0.2);\n                    drawStamp(px, py, sizeVar, angle);\n                }\n            }\n        }\n\n        // Ballpoint - thin consistent strokes\n        function drawBallpoint(x, y, isStart) {\n            const color = state.tool === 'eraser' ? '#ffffff' : state.currentColor;\n            const rgb = hexToRgb(color);\n            ctx.globalCompositeOperation = 'source-over';\n\n            const size = Math.max(1, state.brushSize * 0.3);\n            ctx.fillStyle = `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.85)`;\n            ctx.strokeStyle = `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.85)`;\n            ctx.lineWidth = size;\n            ctx.lineCap = 'round';\n            ctx.lineJoin = 'round';\n\n            if (isStart) {\n                ctx.beginPath();\n                ctx.arc(x, y, size / 2, 0, Math.PI * 2);\n                ctx.fill();\n            } else {\n                ctx.beginPath();\n                ctx.moveTo(state.lastX, state.lastY);\n                ctx.lineTo(x, y);\n                ctx.stroke();\n            }\n        }\n\n        // Felt tip - bold smooth strokes\n        function drawFelt(x, y, isStart) {\n            const color = state.tool === 'eraser' ? '#ffffff' : state.currentColor;\n            ctx.globalCompositeOperation = 'source-over';\n            ctx.fillStyle = color;\n\n            const angle = isStart ? state.lastAngle : getStrokeAngle(state.lastX, state.lastY, x, y);\n            if (!isStart) state.lastAngle = angle;\n            const size = state.brushSize * 1.1;\n\n            if (isStart) {\n                drawStamp(x, y, size / 2, angle);\n            } else {\n                const dist = Math.hypot(x - state.lastX, y - state.lastY);\n                const steps = Math.max(1, Math.floor(dist / 2));\n                for (let i = 0; i <= steps; i++) {\n                    const t = i / steps;\n                    const px = state.lastX + (x - state.lastX) * t;\n                    const py = state.lastY + (y - state.lastY) * t;\n                    drawStamp(px, py, size / 2, angle);\n                }\n            }\n        }\n\n        // Chalk - dusty powdery texture\n        function drawChalk(x, y, isStart) {\n            const color = state.tool === 'eraser' ? '#ffffff' : state.currentColor;\n            const rgb = hexToRgb(color);\n            ctx.globalCompositeOperation = 'source-over';\n\n            const size = state.brushSize;\n\n            const drawChalkMark = (px, py) => {\n                for (let j = 0; j < size * 1.5; j++) {\n                    const offsetX = (Math.random() - 0.5) * size * 0.8;\n                    const offsetY = (Math.random() - 0.5) * size * 0.8;\n                    const alpha = Math.random() * 0.6 + 0.2;\n                    ctx.fillStyle = `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, ${alpha})`;\n                    const dotSize = Math.random() * 2 + 0.5;\n                    ctx.fillRect(px + offsetX, py + offsetY, dotSize, dotSize);\n                }\n            };\n\n            if (isStart) {\n                drawChalkMark(x, y);\n            } else {\n                const dist = Math.hypot(x - state.lastX, y - state.lastY);\n                const steps = Math.max(1, Math.floor(dist / 3));\n                for (let i = 0; i <= steps; i++) {\n                    const t = i / steps;\n                    const px = state.lastX + (x - state.lastX) * t;\n                    const py = state.lastY + (y - state.lastY) * t;\n                    drawChalkMark(px, py);\n                }\n            }\n        }\n\n        // Charcoal - dark grainy textured strokes\n        function drawCharcoal(x, y, isStart) {\n            const color = state.tool === 'eraser' ? '#ffffff' : state.currentColor;\n            const rgb = hexToRgb(color);\n            ctx.globalCompositeOperation = 'source-over';\n\n            const size = state.brushSize * 1.2;\n\n            const drawCharcoalMark = (px, py) => {\n                for (let j = 0; j < size * 2.5; j++) {\n                    const offsetX = (Math.random() - 0.5) * size;\n                    const offsetY = (Math.random() - 0.5) * size;\n                    const alpha = Math.random() * 0.5 + 0.3;\n                    ctx.fillStyle = `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, ${alpha})`;\n                    ctx.fillRect(px + offsetX, py + offsetY, Math.random() * 3 + 1, Math.random() * 3 + 1);\n                }\n            };\n\n            if (isStart) {\n                drawCharcoalMark(x, y);\n            } else {\n                const dist = Math.hypot(x - state.lastX, y - state.lastY);\n                const steps = Math.max(1, Math.floor(dist / 2));\n                for (let i = 0; i <= steps; i++) {\n                    const t = i / steps;\n                    const px = state.lastX + (x - state.lastX) * t;\n                    const py = state.lastY + (y - state.lastY) * t;\n                    drawCharcoalMark(px, py);\n                }\n            }\n        }\n\n        // Oil paint - thick blending strokes\n        function drawOil(x, y, isStart) {\n            const color = state.tool === 'eraser' ? '#ffffff' : state.currentColor;\n            const rgb = hexToRgb(color);\n            ctx.globalCompositeOperation = 'source-over';\n\n            const angle = isStart ? state.lastAngle : getStrokeAngle(state.lastX, state.lastY, x, y);\n            if (!isStart) state.lastAngle = angle;\n            const size = state.brushSize * 1.3;\n\n            if (isStart) {\n                ctx.fillStyle = `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.85)`;\n                drawStamp(x, y, size / 2, angle, 0.85);\n            } else {\n                const dist = Math.hypot(x - state.lastX, y - state.lastY);\n                const steps = Math.max(1, Math.floor(dist / 2));\n                for (let i = 0; i <= steps; i++) {\n                    const t = i / steps;\n                    const px = state.lastX + (x - state.lastX) * t;\n                    const py = state.lastY + (y - state.lastY) * t;\n                    // Layered strokes for thick paint effect\n                    for (let layer = 0; layer < 2; layer++) {\n                        const ox = (Math.random() - 0.5) * size * 0.2;\n                        const oy = (Math.random() - 0.5) * size * 0.2;\n                        const alpha = 0.5 + Math.random() * 0.3;\n                        ctx.fillStyle = `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, ${alpha})`;\n                        drawStamp(px + ox, py + oy, size / 2, angle, alpha);\n                    }\n                }\n            }\n        }\n\n        // Highlighter - semi-transparent wide strokes\n        function drawHighlighter(x, y, isStart) {\n            const color = state.tool === 'eraser' ? '#ffffff' : state.currentColor;\n            const rgb = hexToRgb(color);\n            ctx.globalCompositeOperation = state.tool === 'eraser' ? 'source-over' : 'multiply';\n\n            const size = state.brushSize * 1.5;\n            ctx.fillStyle = `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.3)`;\n            ctx.strokeStyle = `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.3)`;\n            ctx.lineWidth = size;\n            ctx.lineCap = 'square';\n            ctx.lineJoin = 'miter';\n\n            if (isStart) {\n                ctx.fillRect(x - size/2, y - size/4, size, size/2);\n            } else {\n                ctx.beginPath();\n                ctx.moveTo(state.lastX, state.lastY);\n                ctx.lineTo(x, y);\n                ctx.stroke();\n            }\n            ctx.globalCompositeOperation = 'source-over';\n        }\n\n        // Watercolor - soft transparent blending\n        function drawWatercolor(x, y, isStart) {\n            const color = state.tool === 'eraser' ? '#ffffff' : state.currentColor;\n            const rgb = hexToRgb(color);\n            ctx.globalCompositeOperation = 'source-over';\n\n            const size = state.brushSize * 1.2;\n\n            const drawBlob = (px, py) => {\n                const gradient = ctx.createRadialGradient(px, py, 0, px, py, size);\n                gradient.addColorStop(0, `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.15)`);\n                gradient.addColorStop(0.5, `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.08)`);\n                gradient.addColorStop(1, `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0)`);\n                ctx.fillStyle = gradient;\n                ctx.beginPath();\n                ctx.arc(px, py, size, 0, Math.PI * 2);\n                ctx.fill();\n            };\n\n            if (isStart) {\n                drawBlob(x, y);\n            } else {\n                const dist = Math.hypot(x - state.lastX, y - state.lastY);\n                const steps = Math.max(1, Math.floor(dist));\n                for (let i = 0; i <= steps; i++) {\n                    const t = i / steps;\n                    const px = state.lastX + (x - state.lastX) * t;\n                    const py = state.lastY + (y - state.lastY) * t;\n                    drawBlob(px, py);\n                }\n            }\n        }\n\n        // Spray - scattered particles\n        function drawSpray(x, y, isStart) {\n            const color = state.tool === 'eraser' ? '#ffffff' : state.currentColor;\n            const rgb = hexToRgb(color);\n            ctx.globalCompositeOperation = 'source-over';\n\n            const density = state.brushSize * 2;\n            const radius = state.brushSize * 1.5;\n\n            for (let i = 0; i < density; i++) {\n                const angle = Math.random() * Math.PI * 2;\n                const r = Math.random() * radius;\n                const px = x + Math.cos(angle) * r;\n                const py = y + Math.sin(angle) * r;\n                const alpha = Math.random() * 0.5 + 0.2;\n                ctx.fillStyle = `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, ${alpha})`;\n                ctx.fillRect(px, py, Math.random() + 0.5, Math.random() + 0.5);\n            }\n        }\n\n        function drawWithBrush(x, y, isStart) {\n            const penType = state.tool === 'eraser' ? 'marker' : state.penType;\n            switch (penType) {\n                case 'pencil': drawPencil(x, y, isStart); break;\n                case 'ink': drawInk(x, y, isStart); break;\n                case 'ballpoint': drawBallpoint(x, y, isStart); break;\n                case 'felt': drawFelt(x, y, isStart); break;\n                case 'crayon': drawCrayon(x, y, isStart); break;\n                case 'chalk': drawChalk(x, y, isStart); break;\n                case 'charcoal': drawCharcoal(x, y, isStart); break;\n                case 'highlighter': drawHighlighter(x, y, isStart); break;\n                case 'watercolor': drawWatercolor(x, y, isStart); break;\n                case 'oil': drawOil(x, y, isStart); break;\n                case 'spray': drawSpray(x, y, isStart); break;\n                default: drawMarker(x, y, isStart);\n            }\n        }\n\n        function startDrawing(e) {\n            if (e.touches && e.touches.length > 1) return;\n            if (state.placingSticker) return;\n\n            e.preventDefault();\n            state.isDrawing = true;\n            const coords = getCoords(e);\n            state.lastX = coords.x;\n            state.lastY = coords.y;\n\n            drawWithBrush(coords.x, coords.y, true);\n\n            if (state.toolbarVisible) hideToolbar();\n            if (state.colorPaletteVisible) hideColorPalette();\n            if (state.penMenuVisible) hidePenMenu();\n            if (state.strokeMenuVisible) hideStrokeMenu();\n        }\n\n        function draw(e) {\n            if (!state.isDrawing) return;\n            if (e.touches && e.touches.length > 1) return;\n\n            e.preventDefault();\n            const coords = getCoords(e);\n\n            drawWithBrush(coords.x, coords.y, false);\n\n            state.lastX = coords.x;\n            state.lastY = coords.y;\n        }\n\n        function stopDrawing() {\n            if (state.isDrawing) {\n                state.isDrawing = false;\n                saveState();\n            }\n        }\n\n        function toggleToolbar() {\n            state.toolbarVisible = !state.toolbarVisible;\n            toolbar.classList.toggle('visible', state.toolbarVisible);\n            toolbarToggle.classList.toggle('active', state.toolbarVisible);\n            if (!state.toolbarVisible) hideColorPalette();\n        }\n\n        function hideToolbar() {\n            state.toolbarVisible = false;\n            toolbar.classList.remove('visible');\n            toolbarToggle.classList.remove('active');\n            hideColorPalette();\n        }\n\n        function toggleColorPalette() {\n            state.colorPaletteVisible = !state.colorPaletteVisible;\n            colorPalette.classList.toggle('visible', state.colorPaletteVisible);\n        }\n\n        function hideColorPalette() {\n            state.colorPaletteVisible = false;\n            colorPalette.classList.remove('visible');\n        }\n\n        function togglePenMenu() {\n            state.penMenuVisible = !state.penMenuVisible;\n            penMenu.classList.toggle('visible', state.penMenuVisible);\n            if (state.penMenuVisible) {\n                hideColorPalette();\n                hideStrokeMenu();\n            }\n        }\n\n        function hidePenMenu() {\n            state.penMenuVisible = false;\n            penMenu.classList.remove('visible');\n        }\n\n        function setPenType(type) {\n            state.penType = type;\n            document.querySelectorAll('.pen-option').forEach(btn => {\n                btn.classList.toggle('active', btn.dataset.pen === type);\n            });\n            if (state.tool === 'eraser') setTool('brush');\n            hidePenMenu();\n            const names = { marker: 'Marker', pencil: 'Pencil', ink: 'Ink', ballpoint: 'Ballpoint', felt: 'Felt Tip', crayon: 'Crayon', chalk: 'Chalk', charcoal: 'Charcoal', highlighter: 'Highlighter', watercolor: 'Watercolor', oil: 'Oil Paint', spray: 'Spray' };\n            showToast(names[type]);\n        }\n\n        function toggleStrokeMenu() {\n            state.strokeMenuVisible = !state.strokeMenuVisible;\n            strokeMenu.classList.toggle('visible', state.strokeMenuVisible);\n            if (state.strokeMenuVisible) {\n                hideColorPalette();\n                hidePenMenu();\n            }\n        }\n\n        function hideStrokeMenu() {\n            state.strokeMenuVisible = false;\n            strokeMenu.classList.remove('visible');\n        }\n\n        function setStrokeShape(shape) {\n            state.strokeShape = shape;\n            document.querySelectorAll('.stroke-option').forEach(btn => {\n                btn.classList.toggle('active', btn.dataset.stroke === shape);\n            });\n            if (state.tool === 'eraser') setTool('brush');\n            hideStrokeMenu();\n            const names = { round: 'Round', flat: 'Flat', chisel: 'Chisel', calligraphy: 'Calligraphy', pointed: 'Pointed', square: 'Square' };\n            showToast(names[shape] + ' Tip');\n        }\n\n        function setColor(color) {\n            state.currentColor = color;\n            colorBtn.style.background = color;\n            document.querySelectorAll('.palette-color').forEach(btn => {\n                btn.classList.toggle('active', btn.dataset.color === color);\n            });\n            if (state.tool === 'eraser') setTool('brush');\n        }\n\n        function setTool(tool) {\n            state.tool = tool;\n            document.getElementById('brushTool').classList.toggle('active', tool === 'brush');\n            document.getElementById('eraserTool').classList.toggle('active', tool === 'eraser');\n        }\n\n        function showToast(message) {\n            toast.textContent = message;\n            toast.classList.add('visible');\n            clearTimeout(window.toastTimeout);\n            window.toastTimeout = setTimeout(() => toast.classList.remove('visible'), 1500);\n        }\n\n        function clearCanvas() {\n            if (confirm('Clear the canvas?')) {\n                ctx.fillStyle = '#ffffff';\n                ctx.fillRect(0, 0, window.innerWidth, window.innerHeight);\n                saveState();\n                showToast('Canvas cleared');\n            }\n        }\n\n        function downloadCanvas() {\n            const link = document.createElement('a');\n            link.download = 'drawing-' + Date.now() + '.png';\n            link.href = canvas.toDataURL('image/png');\n            if (state.isIOS) {\n                const newTab = window.open();\n                if (newTab) {\n                    newTab.document.write('<html><head><title>Save Image</title></head><body style=\"margin:0;display:flex;justify-content:center;align-items:center;min-height:100vh;background:#000;\"><img src=\"' + link.href + '\" style=\"max-width:100%;max-height:100vh;\"></body></html>');\n                    showToast('Long press image to save');\n                }\n            } else {\n                link.click();\n                showToast('Image saved!');\n            }\n        }\n\n        // Fullscreen\n        function toggleFullscreen() {\n            if (!state.isFullscreen) {\n                const elem = document.documentElement;\n                if (elem.requestFullscreen) elem.requestFullscreen().catch(()=>{});\n                else if (elem.webkitRequestFullscreen) elem.webkitRequestFullscreen();\n                state.isFullscreen = true;\n                fullscreenBtn.classList.add('active');\n                showToast('Fullscreen');\n            } else {\n                if (document.exitFullscreen) document.exitFullscreen().catch(()=>{});\n                else if (document.webkitExitFullscreen) document.webkitExitFullscreen();\n                state.isFullscreen = false;\n                fullscreenBtn.classList.remove('active');\n            }\n            setTimeout(handleResize, 100);\n        }\n\n        document.addEventListener('fullscreenchange', () => {\n            if (!document.fullscreenElement && !document.webkitFullscreenElement) {\n                state.isFullscreen = false;\n                fullscreenBtn.classList.remove('active');\n            }\n        });\n\n        // Library functions\n        function openLibrary() {\n            state.libraryVisible = true;\n            libraryPanel.classList.add('visible');\n            libraryOverlay.classList.add('visible');\n        }\n\n        function closeLibrary() {\n            state.libraryVisible = false;\n            libraryPanel.classList.remove('visible');\n            libraryOverlay.classList.remove('visible');\n        }\n\n        function switchTab(tab) {\n            state.activeTab = tab;\n            document.querySelectorAll('.library-tab').forEach(t => t.classList.toggle('active', t.dataset.tab === tab));\n            stickersGrid.style.display = tab === 'stickers' ? 'grid' : 'none';\n            stencilsGrid.style.display = tab === 'stencils' ? 'grid' : 'none';\n        }\n\n        function populateLibrary() {\n            // Stickers\n            stickersGrid.innerHTML = stickers.map(s => `<div class=\"library-item\" data-sticker=\"${s}\">${s}</div>`).join('');\n\n            // Stencils\n            stencilsGrid.innerHTML = stencils.map((s, i) => `<div class=\"library-item\" data-stencil=\"${i}\">${s.icon}</div>`).join('');\n\n            // Event listeners for stickers\n            stickersGrid.querySelectorAll('.library-item').forEach(item => {\n                item.addEventListener('click', () => {\n                    const sticker = item.dataset.sticker;\n                    placeSticker(sticker);\n                });\n            });\n\n            // Event listeners for stencils\n            stencilsGrid.querySelectorAll('.library-item').forEach(item => {\n                item.addEventListener('click', () => {\n                    const index = parseInt(item.dataset.stencil);\n                    placeStencil(index);\n                });\n            });\n        }\n\n        function placeSticker(sticker) {\n            closeLibrary();\n            showToast('Tap canvas to place sticker');\n\n            const handler = (e) => {\n                e.preventDefault();\n                const coords = getCoords(e);\n\n                ctx.font = '60px serif';\n                ctx.textAlign = 'center';\n                ctx.textBaseline = 'middle';\n                ctx.fillText(sticker, coords.x, coords.y);\n\n                saveState();\n                showToast('Sticker placed!');\n                canvas.removeEventListener('click', handler);\n                canvas.removeEventListener('touchend', handler);\n            };\n\n            canvas.addEventListener('click', handler, { once: true });\n            canvas.addEventListener('touchend', handler, { once: true });\n        }\n\n        function placeStencil(index) {\n            closeLibrary();\n            showToast('Tap canvas to place stencil');\n\n            const stencil = stencils[index];\n            const handler = (e) => {\n                e.preventDefault();\n                const coords = getCoords(e);\n                const size = state.brushSize * 3;\n\n                ctx.fillStyle = state.currentColor;\n                ctx.strokeStyle = state.currentColor;\n                ctx.lineWidth = 3;\n\n                stencil.path(ctx, coords.x, coords.y, size);\n                ctx.fill();\n                ctx.stroke();\n\n                saveState();\n                showToast(stencil.name + ' placed!');\n                canvas.removeEventListener('click', handler);\n                canvas.removeEventListener('touchend', handler);\n            };\n\n            canvas.addEventListener('click', handler, { once: true });\n            canvas.addEventListener('touchend', handler, { once: true });\n        }\n\n        function checkFirstVisit() {\n            // localStorage THROWS under MyLLM's sandboxed null origin \u2014 use its\n            // async myllmStorage bridge there, and fall back to showing help.\n            try {\n                if (!localStorage.getItem('drawAppV2Visited')) {\n                    helpOverlay.classList.add('visible');\n                    localStorage.setItem('drawAppV2Visited', 'true');\n                }\n            } catch (e) {\n                if (window.myllmStorage) {\n                    myllmStorage.getItem('drawAppV2Visited').then(function (v) {\n                        if (!v) {\n                            helpOverlay.classList.add('visible');\n                            myllmStorage.setItem('drawAppV2Visited', '1');\n                        }\n                    });\n                } else {\n                    helpOverlay.classList.add('visible');\n                }\n            }\n        }\n\n        // Two-finger undo\n        let lastTapTime = 0, touchCount = 0;\n        function handleTwoFingerTap(e) {\n            if (e.touches && e.touches.length === 2) {\n                touchCount = 2;\n                if (Date.now() - lastTapTime < 400) { undo(); e.preventDefault(); }\n                lastTapTime = Date.now();\n            }\n        }\n\n        // Event listeners\n        canvas.addEventListener('mousedown', startDrawing);\n        canvas.addEventListener('mousemove', draw);\n        canvas.addEventListener('mouseup', stopDrawing);\n        canvas.addEventListener('mouseleave', stopDrawing);\n\n        canvas.addEventListener('touchstart', (e) => {\n            handleTwoFingerTap(e);\n            if (e.touches.length === 1) { touchCount = 1; startDrawing(e); }\n        }, { passive: false });\n        canvas.addEventListener('touchmove', (e) => { if (touchCount === 1) draw(e); }, { passive: false });\n        canvas.addEventListener('touchend', () => { stopDrawing(); touchCount = 0; }, { passive: false });\n        canvas.addEventListener('touchcancel', () => { stopDrawing(); touchCount = 0; });\n\n        toolbarToggle.addEventListener('click', toggleToolbar);\n        document.getElementById('brushTool').addEventListener('click', () => setTool('brush'));\n        document.getElementById('eraserTool').addEventListener('click', () => setTool('eraser'));\n        document.getElementById('clearBtn').addEventListener('click', clearCanvas);\n        colorBtn.addEventListener('click', toggleColorPalette);\n        penTypeBtn.addEventListener('click', togglePenMenu);\n        strokeShapeBtn.addEventListener('click', toggleStrokeMenu);\n\n        document.querySelectorAll('.pen-option').forEach(btn => {\n            btn.addEventListener('click', () => setPenType(btn.dataset.pen));\n        });\n\n        document.querySelectorAll('.stroke-option').forEach(btn => {\n            btn.addEventListener('click', () => setStrokeShape(btn.dataset.stroke));\n        });\n\n        fullscreenBtn.addEventListener('click', toggleFullscreen);\n        document.getElementById('libraryBtn').addEventListener('click', openLibrary);\n        document.getElementById('libraryClose').addEventListener('click', closeLibrary);\n        libraryOverlay.addEventListener('click', closeLibrary);\n\n        document.querySelectorAll('.library-tab').forEach(tab => {\n            tab.addEventListener('click', () => switchTab(tab.dataset.tab));\n        });\n\n        document.querySelectorAll('.palette-color').forEach(btn => {\n            btn.addEventListener('click', () => { setColor(btn.dataset.color); hideColorPalette(); });\n        });\n\n        document.getElementById('customColor').addEventListener('input', (e) => setColor(e.target.value));\n\n        brushSizeInput.addEventListener('input', (e) => {\n            state.brushSize = parseInt(e.target.value);\n            sizeValue.textContent = state.brushSize;\n        });\n\n        document.getElementById('undoBtn').addEventListener('click', undo);\n        document.getElementById('redoBtn').addEventListener('click', redo);\n        document.getElementById('downloadBtn').addEventListener('click', downloadCanvas);\n        document.getElementById('menuBtn').addEventListener('click', () => helpOverlay.classList.add('visible'));\n        document.getElementById('closeHelp').addEventListener('click', () => helpOverlay.classList.remove('visible'));\n\n        document.addEventListener('click', (e) => {\n            if (state.colorPaletteVisible && !colorPalette.contains(e.target) && e.target !== colorBtn) hideColorPalette();\n            if (state.penMenuVisible && !penMenu.contains(e.target) && e.target !== penTypeBtn && !penTypeBtn.contains(e.target)) hidePenMenu();\n            if (state.strokeMenuVisible && !strokeMenu.contains(e.target) && e.target !== strokeShapeBtn && !strokeShapeBtn.contains(e.target)) hideStrokeMenu();\n        });\n\n        document.addEventListener('keydown', (e) => {\n            if (e.ctrlKey || e.metaKey) {\n                if (e.key === 'z') { e.preventDefault(); e.shiftKey ? redo() : undo(); }\n                else if (e.key === 'y') { e.preventDefault(); redo(); }\n                else if (e.key === 's') { e.preventDefault(); downloadCanvas(); }\n            } else {\n                if (e.key === 'b') setTool('brush');\n                else if (e.key === 'e') setTool('eraser');\n                else if (e.key === 'f') toggleFullscreen();\n                else if (e.key === 'Escape') { if (state.libraryVisible) closeLibrary(); }\n                else if (e.key === '[') { state.brushSize = Math.max(2, state.brushSize - 4); brushSizeInput.value = state.brushSize; sizeValue.textContent = state.brushSize; }\n                else if (e.key === ']') { state.brushSize = Math.min(80, state.brushSize + 4); brushSizeInput.value = state.brushSize; sizeValue.textContent = state.brushSize; }\n            }\n        });\n\n        window.addEventListener('resize', handleResize);\n        window.addEventListener('orientationchange', () => setTimeout(handleResize, 100));\n        canvas.addEventListener('contextmenu', e => e.preventDefault());\n\n        // Initialize\n        preventOverscroll();\n        initCanvas();\n        populateLibrary();\n        checkFirstVisit();\n        updateUndoRedoButtons();\n    </script>\n</body>\n</html>\n", "kind": "html", "iconSymbol": "paintbrush.fill", "iconColor": "pink"}