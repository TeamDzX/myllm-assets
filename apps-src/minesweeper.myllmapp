{"name": "Minesweeper", "kind": "html", "iconSymbol": "flag.fill", "iconColor": "red", "html": "<!doctype html>\n<!--\n  Minesweeper — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Minesweeper</title>\n<style>\n  :root { color-scheme: light dark; }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; user-select:none; -webkit-user-select:none; }\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111);\n    max-width:600px; margin:0 auto; min-height:100dvh;\n    padding:14px 12px calc(30px + env(safe-area-inset-bottom));\n  }\n  header{ display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; }\n  header b{ font-size:18px; font-weight:800; }\n  .hud{ display:flex; gap:12px; font-size:14px; font-weight:700; font-variant-numeric:tabular-nums; }\n  .sizes{ display:flex; background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8); border-radius:12px; padding:3px; margin-bottom:12px; }\n  .sizes button{\n    flex:1; border:none; background:none; color:var(--myllm-muted,#8a8a8e);\n    border-radius:9px; padding:9px; font-size:13.5px; font-weight:700;\n  }\n  .sizes button.on{ background:var(--myllm-accent,#0a84ff); color:#fff; }\n\n  #grid{\n    display:grid; gap:3px;\n    background:var(--myllm-surface,#fff);\n    border:1px solid var(--myllm-border,#e3e3e8);\n    border-radius:14px; padding:8px;\n    touch-action:manipulation;\n  }\n  .sq{\n    aspect-ratio:1; border:none; border-radius:6px;\n    display:flex; align-items:center; justify-content:center;\n    font-size:clamp(11px, 3.6vw, 17px); font-weight:800;\n    background:linear-gradient(180deg, #7fb2e8, #5a95d6);\n    box-shadow:inset 0 -2px 0 rgba(0,0,0,.18);\n    color:transparent;\n    padding:0;\n  }\n  @media (prefers-color-scheme: dark){\n    .sq{ background:linear-gradient(180deg, #3f6ea6, #2d5484); }\n  }\n  .sq.open{\n    background:var(--myllm-bg,#f2f2f7);\n    box-shadow:none; color:inherit;\n  }\n  .sq.open.n1{ color:#0a84ff; } .sq.open.n2{ color:#30a14e; } .sq.open.n3{ color:#ff3b30; }\n  .sq.open.n4{ color:#5e5ce6; } .sq.open.n5{ color:#a2845e; } .sq.open.n6{ color:#30b0c7; }\n  .sq.open.n7{ color:#ff9500; } .sq.open.n8{ color:#8e8e93; }\n  .sq.flag, .sq.boom, .sq.mine{ color:inherit; }\n  .sq.boom{ background:#ff3b30 !important; }\n\n  .toolrow{ display:flex; gap:8px; margin-top:12px; }\n  .toolrow button{\n    flex:1; border:1px solid var(--myllm-border,#e3e3e8); border-radius:12px; padding:12px;\n    font-size:14.5px; font-weight:700; background:var(--myllm-surface,#fff); color:var(--myllm-text,#111);\n  }\n  .toolrow button.flagmode{ background:#ff9500; border-color:#ff9500; color:#fff; }\n  .note{ text-align:center; font-size:12px; color:var(--myllm-muted,#8a8a8e); margin-top:10px; line-height:1.5; }\n  .best{ text-align:center; font-size:12.5px; color:var(--myllm-muted,#8a8a8e); margin-top:6px; }\n\n  #overlay{\n    position:fixed; inset:0; z-index:100; display:none;\n    align-items:center; justify-content:center; flex-direction:column; gap:10px;\n    background:rgba(0,0,0,.55); -webkit-backdrop-filter:blur(4px); backdrop-filter:blur(4px);\n    text-align:center; padding:30px; color:#fff;\n  }\n  #overlay.on{ display:flex; }\n  #overlay .big{ font-size:52px; }\n  #overlay h2{ font-size:24px; font-weight:800; }\n  #overlay p{ font-size:14.5px; opacity:.85; }\n  #overlay button{\n    margin-top:8px; border:none; border-radius:13px; padding:13px 26px;\n    font-size:16px; font-weight:750; background:#fff; color:#111;\n  }\n</style>\n<style>:root{--build-id:\"add7282610\";}</style>\n</head>\n<body>\n\n<header>\n  <b>💣 Minesweeper</b>\n  <div class=\"hud\"><span id=\"mines\">💣 10</span><span id=\"clock\">⏱ 0</span></div>\n</header>\n\n<div class=\"sizes\" id=\"sizes\"></div>\n<div id=\"grid\"></div>\n\n<div class=\"toolrow\">\n  <button id=\"flagBtn\" onclick=\"toggleFlagMode()\">🚩 Flag mode: off</button>\n  <button onclick=\"newGame()\">New game</button>\n</div>\n<p class=\"note\">Tap to dig · long-press (or flag mode) to plant a flag<br>Your first tap is always safe.</p>\n<p class=\"best\" id=\"best\"></p>\n\n<div id=\"overlay\">\n  <div class=\"big\" id=\"ovemoji\">💥</div>\n  <h2 id=\"ovtitle\">Boom!</h2>\n  <p id=\"ovtext\"></p>\n  <button onclick=\"newGame()\">Play again</button>\n</div>\n\n<script>\nvar store = window.myllmStorage || {getItem:function(){return Promise.resolve(null)}, setItem:function(){return Promise.resolve()}};\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction el(id){ return document.getElementById(id); }\n\nvar SIZES = [\n  {id:\"s\", name:\"Small\",  cols:9,  rows:9,  mines:10},\n  {id:\"m\", name:\"Medium\", cols:11, rows:13, mines:24},\n  {id:\"l\", name:\"Large\",  cols:13, rows:16, mines:40}\n];\nvar size = SIZES[0];\nvar best = {};            /* sizeId -> seconds */\n\n/* board[i] = {mine, open, flag, n} — index = r*cols + c */\nvar board = [], started = false, over = false, flagMode = false;\nvar flags = 0, opened = 0, startAt = 0, clockId = null;\nvar pressTimer = null, pressFired = false;\n\nfunction idx(r, c){ return r * size.cols + c; }\nfunction inb(r, c){ return r >= 0 && r < size.rows && c >= 0 && c < size.cols; }\nfunction neighbours(i){\n  var r = Math.floor(i / size.cols), c = i % size.cols, out = [];\n  for (var dr = -1; dr <= 1; dr++)\n    for (var dc = -1; dc <= 1; dc++)\n      if ((dr || dc) && inb(r + dr, c + dc)) out.push(idx(r + dr, c + dc));\n  return out;\n}\n\nfunction newGame(){\n  board = [];\n  for (var i = 0; i < size.rows * size.cols; i++) board.push({mine:false, open:false, flag:false, n:0});\n  started = false; over = false; flags = 0; opened = 0;\n  el(\"overlay\").classList.remove(\"on\");\n  el(\"clock\").textContent = \"⏱ 0\";\n  if (clockId){ clearInterval(clockId); clockId = null; }\n  haptic(\"light\");\n  render();\n}\n\n/* mines are laid AFTER the first tap, keeping it (and its ring) safe */\nfunction layMines(safe){\n  var forbidden = {}; forbidden[safe] = true;\n  neighbours(safe).forEach(function(n){ forbidden[n] = true; });\n  var laid = 0;\n  while (laid < size.mines){\n    var i = Math.floor(Math.random() * board.length);\n    if (board[i].mine || forbidden[i]) continue;\n    board[i].mine = true; laid++;\n  }\n  for (var j = 0; j < board.length; j++){\n    board[j].n = neighbours(j).filter(function(n){ return board[n].mine; }).length;\n  }\n  started = true;\n  startAt = Date.now();\n  clockId = setInterval(function(){\n    if (!over) el(\"clock\").textContent = \"⏱ \" + Math.floor((Date.now() - startAt) / 1000);\n  }, 1000);\n}\n\nfunction dig(i){\n  if (over || board[i].open || board[i].flag) return;\n  if (!started) layMines(i);\n  if (board[i].mine){ return lose(i); }\n  /* flood reveal */\n  var queue = [i];\n  while (queue.length){\n    var q = queue.pop();\n    var sq = board[q];\n    if (sq.open || sq.flag) continue;\n    sq.open = true; opened++;\n    if (sq.n === 0){\n      neighbours(q).forEach(function(n){ if (!board[n].open && !board[n].flag) queue.push(n); });\n    }\n  }\n  haptic(\"selection\");\n  render();\n  if (opened === board.length - size.mines) winGame();\n}\n\nfunction plantFlag(i){\n  if (over || board[i].open) return;\n  board[i].flag = !board[i].flag;\n  flags += board[i].flag ? 1 : -1;\n  haptic(board[i].flag ? \"success\" : \"light\");\n  render();\n}\n\nfunction tap(i){\n  if (pressFired){ pressFired = false; return; }\n  if (flagMode) plantFlag(i); else dig(i);\n}\nfunction pressStart(i){\n  pressFired = false;\n  pressTimer = setTimeout(function(){\n    pressFired = true;\n    if (!flagMode) plantFlag(i);\n  }, 420);\n}\nfunction pressEnd(){\n  if (pressTimer){ clearTimeout(pressTimer); pressTimer = null; }\n}\n\nfunction toggleFlagMode(){\n  flagMode = !flagMode;\n  var b = el(\"flagBtn\");\n  b.textContent = \"🚩 Flag mode: \" + (flagMode ? \"on\" : \"off\");\n  b.className = flagMode ? \"flagmode\" : \"\";\n  haptic(\"selection\");\n}\n\nfunction lose(hit){\n  over = true;\n  board.forEach(function(sq){ if (sq.mine) sq.open = true; });\n  board[hit]._boom = true;\n  render();\n  haptic(\"light\");\n  el(\"ovemoji\").textContent = \"💥\";\n  el(\"ovtitle\").textContent = \"Boom!\";\n  el(\"ovtext\").textContent = \"The field keeps its secrets. Another go?\";\n  setTimeout(function(){ el(\"overlay\").classList.add(\"on\"); }, 650);\n}\n\nfunction winGame(){\n  over = true;\n  var secs = Math.floor((Date.now() - startAt) / 1000);\n  var prev = best[size.id];\n  var isRecord = !prev || secs < prev;\n  if (isRecord){ best[size.id] = secs; store.setItem(\"mines_best\", JSON.stringify(best)); }\n  haptic(\"success\");\n  el(\"ovemoji\").textContent = \"🏆\";\n  el(\"ovtitle\").textContent = \"Field cleared!\";\n  el(\"ovtext\").textContent = secs + \" seconds\" + (isRecord ? \" — new best time!\" : (prev ? \" · best \" + prev + \"s\" : \"\"));\n  setTimeout(function(){ el(\"overlay\").classList.add(\"on\"); }, 350);\n  renderBest();\n}\n\n/* ---------- render ---------- */\nfunction render(){\n  el(\"mines\").textContent = \"💣 \" + Math.max(0, size.mines - flags);\n  var g = el(\"grid\");\n  g.style.gridTemplateColumns = \"repeat(\" + size.cols + \", 1fr)\";\n  var h = \"\";\n  for (var i = 0; i < board.length; i++){\n    var sq = board[i];\n    var cls = \"sq\", inner = \"\";\n    if (sq.open){\n      if (sq.mine){ cls += sq._boom ? \" boom\" : \" mine\"; inner = \"💣\"; }\n      else { cls += \" open n\" + sq.n; inner = sq.n ? sq.n : \"\"; }\n    } else if (sq.flag){ cls += \" flag\"; inner = \"🚩\"; }\n    h += '<button class=\"' + cls + '\"' +\n      ' onclick=\"tap(' + i + ')\"' +\n      ' onpointerdown=\"pressStart(' + i + ')\" onpointerup=\"pressEnd()\" onpointercancel=\"pressEnd()\" onpointerleave=\"pressEnd()\">' +\n      inner + '</button>';\n  }\n  g.innerHTML = h;\n}\nfunction renderSizes(){\n  el(\"sizes\").innerHTML = SIZES.map(function(s){\n    return '<button class=\"' + (s.id === size.id ? \"on\" : \"\") + '\" onclick=\"setSize(\\'' + s.id + '\\')\">' +\n      s.name + ' · ' + s.mines + '💣</button>';\n  }).join(\"\");\n  renderBest();\n}\nfunction renderBest(){\n  el(\"best\").textContent = best[size.id] ? (\"Best time (\" + size.name.toLowerCase() + \"): \" + best[size.id] + \"s\") : \"\";\n}\nfunction setSize(id){\n  size = SIZES.filter(function(s){ return s.id === id; })[0];\n  haptic(\"selection\");\n  store.setItem(\"mines_size\", id);\n  renderSizes();\n  newGame();\n}\n\n/* ---------- boot ---------- */\nPromise.all([store.getItem(\"mines_best\"), store.getItem(\"mines_size\")]).then(function(vals){\n  if (vals[0]){ try{ best = JSON.parse(vals[0]) || {}; }catch(e){} }\n  if (vals[1]){ var s = SIZES.filter(function(x){ return x.id === vals[1]; })[0]; if (s) size = s; }\n  renderSizes();\n  newGame();\n});\n</script>\n</body>\n</html>\n"}