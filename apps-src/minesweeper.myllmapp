{"name": "Minesweeper", "kind": "html", "iconSymbol": "flag.fill", "iconColor": "red", "html": "<!doctype html>\n<!--\n  Minesweeper — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover\">\n<title>Minesweeper</title>\n<style>\n  :root { color-scheme: light dark; }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; user-select:none; -webkit-user-select:none; }\n  html,body{ height:100%; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:#0b0b10; color:#fff; overflow:hidden; overscroll-behavior:none; }\n\n  /* The stage: a hue-tinted backdrop in two layers, dark and light, so the\n     change between them can fade. */\n  .stage{ position:fixed; inset:0; --h:355; color:#fff; }\n  .bg{ position:absolute; inset:0; transition:opacity .6s ease; }\n  .bg.d{ background:radial-gradient(120% 90% at 20% 10%, hsl(var(--h) 62% 30%), transparent 60%),\n      radial-gradient(120% 90% at 85% 95%, hsl(calc(var(--h) - 70) 55% 26%), transparent 62%), #0b0b10; }\n  .bg.l{ opacity:0; background:radial-gradient(120% 90% at 20% 0%, hsl(var(--h) 85% 88%), transparent 60%),\n      radial-gradient(120% 90% at 85% 100%, hsl(calc(var(--h) - 70) 78% 88%), transparent 62%), #f4f4f8; }\n  .lite{ color:#15151a; } .lite .bg.l{ opacity:1; } .lite .bg.d{ opacity:0; }\n\n  .col{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center;\n    padding:calc(10px + env(safe-area-inset-top)) calc(12px + env(safe-area-inset-right)) calc(12px + env(safe-area-inset-bottom)) calc(12px + env(safe-area-inset-left)); }\n  .top{ width:100%; max-width:600px; height:44px; display:flex; align-items:center; justify-content:space-between; gap:8px; flex-shrink:0; }\n  .lbl{ font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; opacity:.62; }\n  .glass{ border:1px solid rgba(255,255,255,.16); background:rgba(255,255,255,.12); color:inherit;\n    -webkit-backdrop-filter:blur(18px); backdrop-filter:blur(18px); }\n  .lite .glass{ border-color:rgba(0,0,0,.09); background:rgba(255,255,255,.62); }\n  svg{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; }\n  .rnd{ width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:15px; flex-shrink:0; }\n  .hud{ height:44px; border-radius:99px; padding:0 14px; display:flex; align-items:center; gap:12px; font-size:15px; font-weight:800; font-variant-numeric:tabular-nums; }\n  .hud span{ display:inline-flex; align-items:center; gap:5px; } .hud svg{ font-size:13px; opacity:.75; }\n  .top .hide{ visibility:hidden; }\n\n  .mid{ position:relative; flex:1; min-height:0; width:100%; max-width:600px; display:flex; flex-direction:column; align-items:center; gap:12px; margin-top:8px; }\n  /* The field never shrinks a square below a fingertip: when a size can't fit,\n     it scrolls both ways inside this box and the page stays still. */\n  .scroller{ flex:1; min-height:0; width:100%; position:relative; overflow:auto; -webkit-overflow-scrolling:touch; overscroll-behavior:contain; display:flex; }\n  #grid{ display:grid; gap:2px; margin:auto; padding:7px; border-radius:16px; background:rgba(10,10,16,.42); border:1px solid rgba(255,255,255,.12);\n    box-shadow:0 18px 44px rgba(0,0,0,.35); touch-action:pan-x pan-y; transition:filter .3s, background .6s; flex-shrink:0; }\n  .lite #grid{ background:rgba(255,255,255,.55); border-color:rgba(0,0,0,.06); box-shadow:0 18px 40px rgba(20,20,40,.14); }\n  .veil #grid{ filter:blur(9px) saturate(.7); pointer-events:none; }       /* a paused field can't be studied */\n  .sq{ width:var(--c,32px); height:var(--c,32px); border:none; border-radius:7px; padding:0; display:flex; align-items:center; justify-content:center;\n    font-size:calc(var(--c,32px) * .52); font-weight:800; color:transparent;\n    background:linear-gradient(180deg, rgba(255,255,255,.30), rgba(255,255,255,.17)); box-shadow:inset 0 1px 0 rgba(255,255,255,.28), inset 0 -2px 0 rgba(0,0,0,.22); }\n  .lite .sq{ background:linear-gradient(180deg, #fff, #e6e6ee); box-shadow:inset 0 -2px 0 rgba(20,20,40,.13), 0 1px 2px rgba(20,20,40,.12); }\n  .sq svg{ font-size:calc(var(--c,32px) * .5); }\n  .sq.open{ background:rgba(0,0,0,.26); box-shadow:none; }\n  .lite .sq.open{ background:rgba(20,20,40,.07); box-shadow:none; }\n  .sq.open.n1{ color:#64b5ff; } .sq.open.n2{ color:#5bdc7a; } .sq.open.n3{ color:#ff7a70; } .sq.open.n4{ color:#b3b1ff; }\n  .sq.open.n5{ color:#ddb388; } .sq.open.n6{ color:#62dcee; } .sq.open.n7{ color:#ffb84d; } .sq.open.n8{ color:#d1d1d6; }\n  .lite .sq.open.n1{ color:#0a6fe0; } .lite .sq.open.n2{ color:#1f8a3c; } .lite .sq.open.n3{ color:#e0281e; } .lite .sq.open.n4{ color:#4b49d1; }\n  .lite .sq.open.n5{ color:#8a6a42; } .lite .sq.open.n6{ color:#11879c; } .lite .sq.open.n7{ color:#c76f00; } .lite .sq.open.n8{ color:#6c6c72; }\n  .sq.flag{ color:#ff9f0a; } .sq.mine{ color:inherit; background:rgba(0,0,0,.26); box-shadow:none; }\n  .lite .sq.mine{ background:rgba(20,20,40,.07); }\n  .sq.boom{ background:#ff3b30 !important; color:#fff; box-shadow:none; }\n\n  .tools{ width:100%; flex-shrink:0; }\n  .toolrow{ display:flex; gap:8px; }\n  .toolrow button{ flex:1; height:50px; border-radius:99px; font-size:14.5px; font-weight:750; display:flex; align-items:center; justify-content:center; gap:7px; }\n  .toolrow button.flagmode{ background:#ff9f0a; border-color:#ff9f0a; color:#fff; }\n  .toolrow button:active, .rnd:active, .sheet button:active, .result button:active{ transform:scale(.96); }\n  .note{ text-align:center; font-size:12px; opacity:.55; margin-top:9px; line-height:1.45; }\n\n  /* Win or lose, the result sits under the field so the whole field stays in view. */\n  .result{ display:none; border-radius:22px; padding:14px 16px; text-align:center; }\n  .over .result{ display:block; } .over .toolrow, .over .note{ display:none; }\n  .result .kick{ margin-bottom:2px; } .result h2{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .result p{ font-size:13.5px; opacity:.72; margin-top:3px; }\n  .result .row{ display:flex; gap:8px; margin-top:12px; }\n  .result button{ flex:1; height:48px; border-radius:99px; font-size:15.5px; font-weight:750; display:flex; align-items:center; justify-content:center; gap:7px; }\n\n  /* One glass card over the field: title and paused. */\n  .sheet{ position:absolute; left:50%; top:50%; width:min(310px, calc(100% - 16px)); transform:translate(-50%,-50%) scale(.96); opacity:0; pointer-events:none; z-index:5;\n    border-radius:26px; padding:22px 18px 18px; text-align:center; box-shadow:0 24px 60px rgba(0,0,0,.35);\n    transition:opacity .28s ease, transform .28s cubic-bezier(.2,.8,.2,1); }\n  .sheet.on{ opacity:1; transform:translate(-50%,-50%); pointer-events:auto; }\n  .lite .sheet{ box-shadow:0 22px 50px rgba(20,20,40,.18); }\n  .sheet h1{ font-size:28px; font-weight:800; letter-spacing:-.02em; }\n  .sheet p{ font-size:13.5px; line-height:1.4; opacity:.72; margin-top:6px; }\n  .kick{ font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; opacity:.62; }\n  .big{ font-size:50px; font-weight:800; line-height:1.05; letter-spacing:-.03em; font-variant-numeric:tabular-nums; margin-top:4px; }\n  .best{ display:block; margin-top:10px; font-size:11.5px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; opacity:.7; min-height:15px; }\n  .new{ display:inline-block; color:#0b0b10; background:#ffd60a; border-radius:99px; padding:4px 10px; font-size:11px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }\n  .sizes{ display:flex; border-radius:99px; padding:3px; margin-top:14px; }\n  .sizes button{ flex:1; border:none; background:none; color:inherit; opacity:.7; border-radius:99px; height:38px; font-size:12.5px; font-weight:750;\n    display:flex; align-items:center; justify-content:center; gap:4px; }\n  .sizes button{ flex-direction:column; gap:0; line-height:1.1; } .sizes button small{ font-size:10px; font-weight:750; opacity:.65; }\n  .sizes button.on{ background:#fff; color:#0b0b10; opacity:1; } .lite .sizes button.on{ background:#15151a; color:#fff; }\n  .sheet .act{ width:100%; height:50px; border-radius:99px; margin-top:10px; font-size:16px; font-weight:750; display:flex; align-items:center; justify-content:center; gap:8px; }\n  .sheet .act.first{ margin-top:16px; }\n  .pri{ border:none; background:#fff; color:#0b0b10; box-shadow:0 10px 30px rgba(0,0,0,.3); }\n  .lite .pri{ background:#15151a; color:#fff; box-shadow:0 10px 26px rgba(20,20,40,.22); }\n\n  @media (max-height:520px){                       /* phone on its side: field left, tools right */\n    .mid{ flex-direction:row; align-items:stretch; max-width:none; } .tools{ width:min(280px,36vw); align-self:center; }\n    .toolrow{ flex-direction:column; } .toolrow button{ flex:none; height:46px; }\n    .sheet{ padding:14px 16px; } .sheet h1{ font-size:22px; } .sheet p{ display:none; } .big{ font-size:34px; }\n    .sizes{ margin-top:10px; } .sheet .act{ height:42px; margin-top:8px; } .sheet .act.first{ margin-top:10px; }\n    .result .row{ flex-direction:column; }\n  }\n</style>\n<style>:root{--build-id:\"add7282610\";}</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-play\" viewBox=\"0 0 24 24\"><path d=\"M8 5.5v13a1 1 0 0 0 1.52.85l10.4-6.5a1 1 0 0 0 0-1.7L9.52 4.65A1 1 0 0 0 8 5.5z\"/></symbol>\n  <symbol id=\"i-pause\" viewBox=\"0 0 24 24\"><rect x=\"6\" y=\"5\" width=\"4.2\" height=\"14\" rx=\"1.4\"/><rect x=\"13.8\" y=\"5\" width=\"4.2\" height=\"14\" rx=\"1.4\"/></symbol>\n  <symbol id=\"i-again\" viewBox=\"0 0 24 24\"><path d=\"M12 5V2.6a.6.6 0 0 0-1-.45L7.2 5.55a.6.6 0 0 0 0 .9L11 9.85a.6.6 0 0 0 1-.45V7a5.5 5.5 0 1 1-5.5 5.5 1 1 0 0 0-2 0A7.5 7.5 0 1 0 12 5z\"/></symbol>\n  <symbol id=\"i-flag\" viewBox=\"0 0 24 24\"><path d=\"M6 2.5a1.1 1.1 0 0 0-1.1 1.1v16.8a1.1 1.1 0 0 0 2.2 0v-5.6h10.6a.9.9 0 0 0 .72-1.44L15.4 9.3l3.02-4.06A.9.9 0 0 0 17.7 3.8H7.1v-.2A1.1 1.1 0 0 0 6 2.5z\"/></symbol>\n  <symbol id=\"i-mine\" viewBox=\"0 0 24 24\"><path d=\"M12 1.8a1 1 0 0 0-1 1v2.1a7.1 7.1 0 0 0-3.2 1.33L6.3 4.75A1 1 0 0 0 4.9 6.16L6.37 7.64A7.1 7.1 0 0 0 5 11H2.8a1 1 0 0 0 0 2H5a7.1 7.1 0 0 0 1.37 3.36L4.9 17.84a1 1 0 0 0 1.4 1.41l1.5-1.48A7.1 7.1 0 0 0 11 19.1v2.1a1 1 0 0 0 2 0v-2.1a7.1 7.1 0 0 0 3.2-1.33l1.5 1.48a1 1 0 0 0 1.4-1.41l-1.47-1.48A7.1 7.1 0 0 0 19 13h2.2a1 1 0 0 0 0-2H19a7.1 7.1 0 0 0-1.37-3.36l1.47-1.48a1 1 0 0 0-1.4-1.41l-1.5 1.48A7.1 7.1 0 0 0 13 4.9V2.8a1 1 0 0 0-1-1zM9.6 8.2a1.6 1.6 0 1 1 0 3.2 1.6 1.6 0 0 1 0-3.2z\"/></symbol>\n  <symbol id=\"i-clock\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5a9.5 9.5 0 1 0 0 19 9.5 9.5 0 0 0 0-19zm0 2.2a7.3 7.3 0 1 1 0 14.6 7.3 7.3 0 0 1 0-14.6zm0 2.1a1.1 1.1 0 0 0-1.1 1.1V12c0 .3.12.58.32.78l2.6 2.6a1.1 1.1 0 0 0 1.56-1.56L13.1 11.54V7.9A1.1 1.1 0 0 0 12 6.8z\"/></symbol>\n  <symbol id=\"i-trophy\" viewBox=\"0 0 24 24\"><path d=\"M7 2.8a1 1 0 0 0-1 1V5H3.8a1 1 0 0 0-1 1v1.6a4.2 4.2 0 0 0 3.6 4.15A6 6 0 0 0 11 15.4v2.8H8.4a1 1 0 0 0 0 2h7.2a1 1 0 0 0 0-2H13v-2.8a6 6 0 0 0 4.6-3.65A4.2 4.2 0 0 0 21.2 7.6V6a1 1 0 0 0-1-1H18V3.8a1 1 0 0 0-1-1zM4.8 7H6v2.6A2.2 2.2 0 0 1 4.8 7.6zM18 7h1.2v.6A2.2 2.2 0 0 1 18 9.6z\"/></symbol>\n</defs></svg>\n\n<div class=\"stage\" id=\"stage\">\n  <div class=\"bg d\"></div><div class=\"bg l\"></div>\n  <div class=\"col\">\n    <div class=\"top\">\n      <button class=\"glass rnd hide\" id=\"bPause\" aria-label=\"Pause\"><svg><use href=\"#i-pause\"/></svg></button>\n      <div class=\"lbl\">Minesweeper</div>\n      <div class=\"glass hud hide\" id=\"hud\"><span id=\"mines\"></span><span id=\"clock\"></span></div>\n    </div>\n    <div class=\"mid\">\n      <div class=\"scroller\" id=\"scroller\">\n        <div id=\"grid\"></div>\n      </div>\n      <div class=\"sheet glass\" id=\"sheet\"></div>\n      <div class=\"tools\" id=\"tools\">\n        <div class=\"toolrow\">\n          <button class=\"glass\" id=\"flagBtn\" onclick=\"toggleFlagMode()\"></button>\n          <button class=\"glass\" onclick=\"newGame()\"><svg><use href=\"#i-again\"/></svg>New game</button>\n        </div>\n        <p class=\"note\">Tap to dig · long-press (or flag mode) to plant a flag<br>Your first tap is always safe.</p>\n        <div class=\"glass result\" id=\"result\">\n          <div class=\"kick\" id=\"ovkick\"></div>\n          <h2 id=\"ovtitle\"></h2>\n          <p id=\"ovtext\"></p>\n          <div class=\"row\">\n            <button class=\"pri\" onclick=\"newGame()\"><svg><use href=\"#i-again\"/></svg>Play again</button>\n            <button class=\"glass\" onclick=\"home()\">Done</button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction load(k){ var s = window.myllmStorage; return s ? s.getItem(k).catch(function(){ return null; }) : Promise.resolve(null); }\nfunction keep(k, v){ var s = window.myllmStorage; if (s) try { s.setItem(k, v).catch(function(){}); } catch(_){} }\nfunction el(id){ return document.getElementById(id); }\nfunction icon(id){ return '<svg><use href=\"#i-' + id + '\"/></svg>'; }\n\nvar SIZES = [\n  {id:\"s\", name:\"Small\",  cols:9,  rows:9,  mines:10},\n  {id:\"m\", name:\"Medium\", cols:11, rows:13, mines:24},\n  {id:\"l\", name:\"Large\",  cols:13, rows:16, mines:40}\n];\nvar size = SIZES[0];\nvar best = {};            /* sizeId -> seconds */\n\n/* board[i] = {mine, open, flag, n} — index = r*cols + c */\nvar board = [], started = false, over = false, flagMode = false;\nvar flags = 0, opened = 0, startAt = 0, clockId = null;\nvar pressTimer = null, pressFired = false;\nvar state = \"home\";       /* home · play */\nvar paused = false, pausedAt = 0;\n\nfunction idx(r, c){ return r * size.cols + c; }\nfunction inb(r, c){ return r >= 0 && r < size.rows && c >= 0 && c < size.cols; }\nfunction neighbours(i){\n  var r = Math.floor(i / size.cols), c = i % size.cols, out = [];\n  for (var dr = -1; dr <= 1; dr++)\n    for (var dc = -1; dc <= 1; dc++)\n      if ((dr || dc) && inb(r + dr, c + dc)) out.push(idx(r + dr, c + dc));\n  return out;\n}\n\n/* ---------- look ---------- */\nfunction isLight(){ return !(window.matchMedia && matchMedia(\"(prefers-color-scheme: dark)\").matches); }\n/* A game in progress takes the whole display and goes dark. Where MyLLM can't\n   hide its own title bar, a dark stage under a white bar looks cut in half —\n   so in light mode, without myllmImmersive, the stage stays light. */\nfunction syncLook(){\n  var s = el(\"stage\");\n  s.classList.toggle(\"lite\", isLight() && !(state !== \"home\" && window.myllmImmersive));\n  s.classList.toggle(\"veil\", state === \"home\" || paused);\n  s.classList.toggle(\"over\", over && state === \"play\");\n  el(\"bPause\").classList.toggle(\"hide\", state !== \"play\" || paused || over);\n  el(\"hud\").classList.toggle(\"hide\", state !== \"play\");\n  el(\"tools\").style.visibility = state === \"play\" && !paused ? \"\" : \"hidden\";\n}\nfunction syncChrome(){\n  if (!window.myllmImmersive) return;\n  try { myllmImmersive(state !== \"home\", {keepAwake:false}).catch(function(){}); } catch(_){}\n}\n/* Squares fill the room they're given but never drop under 28px. */\nfunction fit(){\n  var sc = el(\"scroller\"), gap = 2, pad = 16;\n  var w = (sc.clientWidth - pad - gap * (size.cols - 1)) / size.cols, h = (sc.clientHeight - pad - gap * (size.rows - 1)) / size.rows;\n  var c = Math.max(28, Math.min(46, Math.floor(Math.min(w, h))));\n  el(\"grid\").style.setProperty(\"--c\", c + \"px\");\n}\n\nfunction showClock(){\n  var secs = started ? Math.floor(((paused ? pausedAt : (over ? endAt : Date.now())) - startAt) / 1000) : 0;\n  el(\"clock\").innerHTML = icon(\"clock\") + secs;\n}\nvar endAt = 0;\n\nfunction newGame(){\n  board = [];\n  for (var i = 0; i < size.rows * size.cols; i++) board.push({mine:false, open:false, flag:false, n:0});\n  started = false; over = false; flags = 0; opened = 0; paused = false;\n  if (clockId){ clearInterval(clockId); clockId = null; }\n  haptic(\"light\");\n  if (state === \"play\"){ el(\"sheet\").classList.remove(\"on\"); }\n  fit(); render(); showClock(); syncLook();\n  el(\"scroller\").scrollTop = 0; el(\"scroller\").scrollLeft = 0;\n}\n\n/* mines are laid AFTER the first tap, keeping it (and its ring) safe */\nfunction layMines(safe){\n  var forbidden = {}; forbidden[safe] = true;\n  neighbours(safe).forEach(function(n){ forbidden[n] = true; });\n  var laid = 0;\n  while (laid < size.mines){\n    var i = Math.floor(Math.random() * board.length);\n    if (board[i].mine || forbidden[i]) continue;\n    board[i].mine = true; laid++;\n  }\n  for (var j = 0; j < board.length; j++){\n    board[j].n = neighbours(j).filter(function(n){ return board[n].mine; }).length;\n  }\n  started = true;\n  startAt = Date.now();\n  clockId = setInterval(function(){ if (!over && !paused) showClock(); }, 1000);\n}\n\nfunction dig(i){\n  if (over || board[i].open || board[i].flag) return;\n  if (!started) layMines(i);\n  if (board[i].mine){ return lose(i); }\n  /* flood reveal */\n  var queue = [i];\n  while (queue.length){\n    var q = queue.pop();\n    var sq = board[q];\n    if (sq.open || sq.flag) continue;\n    sq.open = true; opened++;\n    if (sq.n === 0){\n      neighbours(q).forEach(function(n){ if (!board[n].open && !board[n].flag) queue.push(n); });\n    }\n  }\n  haptic(\"selection\");\n  render();\n  if (opened === board.length - size.mines) winGame();\n}\n\nfunction plantFlag(i){\n  if (over || board[i].open) return;\n  board[i].flag = !board[i].flag;\n  flags += board[i].flag ? 1 : -1;\n  haptic(board[i].flag ? \"success\" : \"light\");\n  render();\n}\n\nfunction tap(i){\n  if (pressFired){ pressFired = false; return; }\n  if (state !== \"play\" || paused) return;\n  if (flagMode) plantFlag(i); else dig(i);\n}\nfunction pressStart(i){\n  pressFired = false;\n  if (state !== \"play\" || paused) return;\n  pressTimer = setTimeout(function(){\n    pressFired = true;\n    if (!flagMode) plantFlag(i);\n  }, 420);\n}\nfunction pressEnd(){\n  if (pressTimer){ clearTimeout(pressTimer); pressTimer = null; }\n}\n\nfunction paintFlagBtn(){\n  var b = el(\"flagBtn\");\n  b.innerHTML = icon(\"flag\") + \"Flag mode: \" + (flagMode ? \"on\" : \"off\");\n  b.className = \"glass\" + (flagMode ? \" flagmode\" : \"\");\n  b.setAttribute(\"aria-pressed\", flagMode);\n}\nfunction toggleFlagMode(){\n  flagMode = !flagMode;\n  paintFlagBtn();\n  haptic(\"selection\");\n}\n\nfunction lose(hit){\n  over = true; endAt = Date.now();\n  board.forEach(function(sq){ if (sq.mine) sq.open = true; });\n  board[hit]._boom = true;\n  render();\n  haptic(\"light\");\n  el(\"ovkick\").textContent = \"Game over\";\n  el(\"ovtitle\").textContent = \"Boom!\";\n  el(\"ovtext\").textContent = \"The field keeps its secrets. Another go?\";\n  setTimeout(function(){ if (over) syncLook(); }, 650);\n}\n\nfunction winGame(){\n  over = true; endAt = Date.now();\n  var secs = Math.floor((endAt - startAt) / 1000);\n  var prev = best[size.id];\n  var isRecord = !prev || secs < prev;\n  if (isRecord){ best[size.id] = secs; keep(\"mines_best\", JSON.stringify(best)); }\n  haptic(\"success\");\n  el(\"ovkick\").innerHTML = isRecord ? '<span class=\"new\">New best time</span>' : \"Field cleared\";\n  el(\"ovtitle\").textContent = \"Field cleared!\";\n  el(\"ovtext\").textContent = secs + \" seconds\" + (isRecord ? \" — new best time!\" : (prev ? \" · best \" + prev + \"s\" : \"\"));\n  showClock();\n  setTimeout(function(){ if (over) syncLook(); }, 350);\n}\n\n/* ---------- render ---------- */\nfunction render(){\n  el(\"mines\").innerHTML = icon(\"mine\") + Math.max(0, size.mines - flags);\n  var g = el(\"grid\");\n  g.style.gridTemplateColumns = \"repeat(\" + size.cols + \", var(--c,32px))\";\n  var h = \"\";\n  for (var i = 0; i < board.length; i++){\n    var sq = board[i];\n    var cls = \"sq\", inner = \"\";\n    if (sq.open){\n      if (sq.mine){ cls += sq._boom ? \" boom\" : \" mine\"; inner = icon(\"mine\"); }\n      else { cls += \" open n\" + sq.n; inner = sq.n ? sq.n : \"\"; }\n    } else if (sq.flag){ cls += \" flag\"; inner = icon(\"flag\"); }\n    h += '<button class=\"' + cls + '\"' +\n      ' onclick=\"tap(' + i + ')\"' +\n      ' onpointerdown=\"pressStart(' + i + ')\" onpointerup=\"pressEnd()\" onpointercancel=\"pressEnd()\" onpointerleave=\"pressEnd()\">' +\n      inner + '</button>';\n  }\n  g.innerHTML = h;\n}\nfunction bestText(){\n  return best[size.id] ? (\"Best time (\" + size.name.toLowerCase() + \"): \" + best[size.id] + \"s\") : \"\";\n}\nfunction setSize(id){\n  size = SIZES.filter(function(s){ return s.id === id; })[0];\n  haptic(\"selection\");\n  keep(\"mines_size\", id);\n  newGame();\n  showSheet(\"home\");\n}\n\n/* ---------- the glass card ---------- */\nfunction showSheet(kind){\n  var s = el(\"sheet\"), h;\n  if (kind === \"home\"){\n    h = '<h1>Minesweeper</h1><p>Tap to dig. Long-press, or switch on flag mode, to plant a flag. Your first tap is always safe.</p>' +\n      '<div class=\"glass sizes\">' + SIZES.map(function(z){\n        return '<button class=\"' + (z.id === size.id ? \"on\" : \"\") + '\" onclick=\"setSize(\\'' + z.id + '\\')\">' + z.name + '<small>' + z.mines + '</small></button>';\n      }).join(\"\") + '</div><span class=\"best\">' + bestText() + '</span>' +\n      '<button class=\"act first pri\" onclick=\"play()\">' + icon(\"play\") + 'Play</button>';\n  } else {\n    h = '<div class=\"kick\">Paused</div><div class=\"big\">' + el(\"clock\").textContent + 's</div>' +\n      '<button class=\"act first pri\" onclick=\"resume()\">' + icon(\"play\") + 'Resume</button>' +\n      '<button class=\"act glass\" onclick=\"home()\">End game</button>';\n  }\n  s.innerHTML = h; s.classList.add(\"on\");\n}\nfunction play(){\n  haptic(\"medium\");\n  state = \"play\";\n  el(\"sheet\").classList.remove(\"on\");\n  newGame(); syncChrome();\n}\nfunction home(){\n  state = \"home\";\n  newGame(); showSheet(\"home\"); syncLook(); syncChrome();\n}\nfunction pause(){\n  if (state !== \"play\" || paused || over) return;\n  paused = true; pausedAt = Date.now(); pressEnd();\n  showClock(); showSheet(\"pause\"); syncLook();\n}\nfunction resume(){\n  if (!paused) return;\n  haptic(\"light\");\n  if (started) startAt += Date.now() - pausedAt;      /* the clock doesn't run while the field is hidden */\n  paused = false;\n  el(\"sheet\").classList.remove(\"on\");\n  showClock(); syncLook(); syncChrome();\n}\nel(\"bPause\").onclick = function(){ haptic(\"light\"); pause(); };\n\ndocument.addEventListener(\"visibilitychange\", function(){\n  if (document.hidden){ pause(); return; }\n  if (state !== \"home\") syncChrome();                 /* MyLLM puts its bars back when the app is left */\n});\nif (window.matchMedia){\n  var mq = matchMedia(\"(prefers-color-scheme: dark)\");\n  if (mq.addEventListener) mq.addEventListener(\"change\", syncLook); else if (mq.addListener) mq.addListener(syncLook);\n}\nwindow.addEventListener(\"resize\", fit);\n\n/* ---------- boot ---------- */\npaintFlagBtn();\nPromise.all([load(\"mines_best\"), load(\"mines_size\")]).then(function(vals){\n  if (vals[0]){ try{ best = JSON.parse(vals[0]) || {}; }catch(e){} }\n  if (vals[1]){ var s = SIZES.filter(function(x){ return x.id === vals[1]; })[0]; if (s) size = s; }\n  newGame();\n  showSheet(\"home\");\n});\n</script>\n</body>\n</html>\n"}