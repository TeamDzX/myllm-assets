{"name": "Study Buddy", "kind": "html", "iconSymbol": "graduationcap.fill", "iconColor": "indigo", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Study Buddy</title>\n<style>\n  :root { color-scheme: light dark; }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111);\n    max-width:640px; margin:0 auto; min-height:100dvh;\n    padding:14px 14px calc(30px + env(safe-area-inset-bottom));\n  }\n  h1{ font-size:22px; font-weight:800; margin:4px 2px 2px; }\n  .statline{ font-size:13px; color:var(--myllm-muted,#8a8a8e); margin:0 2px 12px; }\n  .card{\n    background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8);\n    border-radius:16px; padding:14px; margin-bottom:12px;\n  }\n  label{ display:block; font-size:11.5px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:var(--myllm-muted,#8a8a8e); margin-bottom:7px; }\n  textarea{\n    width:100%; min-height:160px; font-size:15px; line-height:1.5; padding:12px; resize:vertical;\n    border-radius:12px; border:1px solid var(--myllm-border,#e3e3e8);\n    background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111); font-family:inherit;\n  }\n  .go{\n    width:100%; border:none; border-radius:13px; padding:15px; margin-top:12px;\n    font-size:16px; font-weight:750; background:#5e5ce6; color:#fff;\n  }\n  .go:disabled{ opacity:.5; }\n  .hint{ font-size:12.5px; color:var(--myllm-muted,#8a8a8e); margin-top:9px; line-height:1.5; }\n\n  /* quiz */\n  #quiz{ display:none; }\n  .qtop{ display:flex; justify-content:space-between; align-items:baseline; margin-bottom:8px; }\n  .qtop b{ font-size:14px; }\n  .qtop span{ font-size:13px; color:var(--myllm-muted,#8a8a8e); font-variant-numeric:tabular-nums; }\n  .qbar{ height:6px; border-radius:99px; background:var(--myllm-bg,#f2f2f7); overflow:hidden; margin-bottom:14px; }\n  .qbar div{ height:100%; border-radius:99px; background:#5e5ce6; transition:width .25s; }\n  .qtext{ font-size:18px; font-weight:750; line-height:1.4; margin-bottom:14px; }\n  .opt{\n    width:100%; text-align:left; border:1.5px solid var(--myllm-border,#e3e3e8);\n    background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111);\n    border-radius:13px; padding:13px 14px; font-size:15px; font-weight:600; margin-bottom:9px;\n    font-family:inherit; line-height:1.35;\n  }\n  .opt.correct{ border-color:#30a14e; background:rgba(48,161,78,.14); }\n  .opt.wrong{ border-color:#ff3b30; background:rgba(255,59,48,.12); }\n  .opt:disabled{ opacity:.92; }\n  .why{\n    display:none; font-size:13.5px; line-height:1.5; color:var(--myllm-muted,#8a8a8e);\n    background:var(--myllm-bg,#f2f2f7); border-radius:12px; padding:11px 12px; margin-top:4px;\n  }\n  .why.on{ display:block; }\n  .nextbtn{ display:none; }\n  .nextbtn.on{ display:block; }\n\n  /* results */\n  #result{ display:none; text-align:center; }\n  #result .big{ font-size:52px; margin:12px 0 4px; }\n  #result h2{ font-size:24px; font-weight:800; }\n  #result p{ color:var(--myllm-muted,#8a8a8e); font-size:14.5px; margin-top:4px; }\n  .review{ text-align:left; margin-top:14px; }\n  .review .rv{ padding:10px 0; border-bottom:1px solid var(--myllm-border,#e3e3e8); font-size:14px; }\n  .review .rv:last-child{ border-bottom:none; }\n  .review .rv b{ display:block; }\n  .review .rv small{ display:block; color:var(--myllm-muted,#8a8a8e); margin-top:3px; line-height:1.45; }\n  .row2{ display:flex; gap:9px; margin-top:14px; }\n  .row2 .go{ margin-top:0; }\n  .go.ghost{ background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111); border:1px solid var(--myllm-border,#e3e3e8); }\n</style>\n</head>\n<body>\n\n<h1>🎓 Study Buddy</h1>\n<p class=\"statline\" id=\"stats\"></p>\n\n<div id=\"setup\">\n  <div class=\"card\">\n    <label>Your notes — or just a topic</label>\n    <textarea id=\"notes\" placeholder=\"Paste your revision notes, a textbook passage, vocabulary…&#10;&#10;Or simply type a topic: 'GCSE photosynthesis', 'French passé composé', 'the French Revolution'\"></textarea>\n    <button class=\"go\" id=\"quizBtn\" onclick=\"startQuiz()\">Quiz me</button>\n    <p class=\"hint\" id=\"setuphint\">Questions are generated privately, on this device — your notes never leave your phone.</p>\n  </div>\n</div>\n\n<div id=\"quiz\">\n  <div class=\"card\">\n    <div class=\"qtop\"><b id=\"qnum\"></b><span id=\"qscore\"></span></div>\n    <div class=\"qbar\"><div id=\"qfill\"></div></div>\n    <div class=\"qtext\" id=\"qtext\"></div>\n    <div id=\"opts\"></div>\n    <div class=\"why\" id=\"why\"></div>\n    <button class=\"go nextbtn\" id=\"nextBtn\" onclick=\"nextQ()\">Next</button>\n  </div>\n</div>\n\n<div id=\"result\">\n  <div class=\"card\">\n    <div class=\"big\" id=\"remoji\"></div>\n    <h2 id=\"rtitle\"></h2>\n    <p id=\"rsub\"></p>\n    <div class=\"review\" id=\"review\"></div>\n    <div class=\"row2\">\n      <button class=\"go ghost\" onclick=\"backToNotes()\">Edit notes</button>\n      <button class=\"go\" onclick=\"startQuiz()\">Quiz me again</button>\n    </div>\n  </div>\n</div>\n\n<!-- AI thinking pill (house convention) -->\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\">⚙️</span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n\n<script>\nvar store = window.myllmStorage || {getItem:function(){return Promise.resolve(null)}, setItem:function(){return Promise.resolve()}};\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nvar ASK = window.myllmAsk || null;\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\"); }\n\nvar quiz = [];        /* [{q, options[4], correct, why}] */\nvar qi = 0, score = 0, answered = false;\nvar wrong = [];       /* review list */\nvar lifetime = {asked:0, right:0};\nvar askedBefore = []; /* question texts from this session, to avoid repeats on \"again\" */\n\nfunction renderStats(){\n  el(\"stats\").textContent = lifetime.asked\n    ? lifetime.right + \" / \" + lifetime.asked + \" lifetime · \" + Math.round(lifetime.right / lifetime.asked * 100) + \"% right\"\n    : \"Paste notes, get quizzed, actually remember it.\";\n}\n\n/* ---------- generate ---------- */\nfunction parseQuiz(reply){\n  var s = String(reply);\n  var a = s.indexOf(\"[\"), b = s.lastIndexOf(\"]\");\n  if (a < 0 || b <= a) return null;\n  var arr;\n  try{ arr = JSON.parse(s.slice(a, b + 1)); }catch(e){ return null; }\n  if (!Array.isArray(arr)) return null;\n  var clean = arr.filter(function(x){\n    return x && typeof x.q === \"string\" && Array.isArray(x.options) && x.options.length === 4 &&\n           typeof x.correct === \"number\" && x.correct >= 0 && x.correct <= 3;\n  }).map(function(x){\n    return {q:x.q, options:x.options.map(String), correct:x.correct, why:String(x.why || \"\")};\n  });\n  return clean.length >= 3 ? clean.slice(0, 5) : null;\n}\n\nfunction startQuiz(){\n  var notes = el(\"notes\").value.trim();\n  if (!notes){ el(\"setuphint\").textContent = \"Paste some notes or a topic first.\"; haptic(\"light\"); return; }\n  if (!ASK){ el(\"setuphint\").textContent = \"Study Buddy needs AI — enable it in Settings, then come back.\"; haptic(\"light\"); return; }\n  haptic(\"light\");\n  store.setItem(\"sb_notes\", notes);\n  el(\"quizBtn\").disabled = true;\n  el(\"setuphint\").textContent = \"Writing your questions…\";\n  var avoid = askedBefore.length ? \"\\nDo NOT reuse these questions: \" + askedBefore.slice(-10).map(function(q){ return '\"' + q + '\"'; }).join(\", \") : \"\";\n  ASK(\"Create exactly 5 multiple-choice questions to test understanding of this material. Mix recall and understanding; make wrong options plausible.\\n\\nMATERIAL:\\n\" + notes.slice(0, 6000) + avoid +\n      '\\n\\nReply with ONLY a JSON array, no markdown, exactly this shape:\\n[{\"q\":\"…\",\"options\":[\"…\",\"…\",\"…\",\"…\"],\"correct\":0,\"why\":\"one-sentence explanation of the right answer\"}]\\nThe \"correct\" field is the index (0-3) of the right option. Vary which position is correct.',\n      {system:\"You are an excellent quiz writer. Output only the JSON array — no commentary, no code fences.\"})\n  .then(function(r){\n    var parsed = parseQuiz(r);\n    el(\"quizBtn\").disabled = false;\n    if (!parsed){\n      el(\"setuphint\").textContent = \"The questions didn't come through cleanly — that happens with smaller models. Tap Quiz me to try again.\";\n      haptic(\"light\");\n      return;\n    }\n    quiz = parsed;\n    quiz.forEach(function(x){ askedBefore.push(x.q); });\n    qi = 0; score = 0; wrong = [];\n    el(\"setup\").style.display = \"none\";\n    el(\"result\").style.display = \"none\";\n    el(\"quiz\").style.display = \"block\";\n    el(\"setuphint\").textContent = \"\";\n    haptic(\"success\");\n    showQ();\n    window.scrollTo(0, 0);\n  })\n  .catch(function(){\n    el(\"quizBtn\").disabled = false;\n    el(\"setuphint\").textContent = \"The AI couldn't run just now — try again in a moment.\";\n  });\n}\n\n/* ---------- play ---------- */\nfunction showQ(){\n  var x = quiz[qi];\n  answered = false;\n  el(\"qnum\").textContent = \"Question \" + (qi + 1) + \" of \" + quiz.length;\n  el(\"qscore\").textContent = score + \" right\";\n  el(\"qfill\").style.width = (qi / quiz.length * 100) + \"%\";\n  el(\"qtext\").textContent = x.q;\n  el(\"why\").className = \"why\";\n  el(\"nextBtn\").className = \"go nextbtn\";\n  el(\"nextBtn\").textContent = qi === quiz.length - 1 ? \"See my score\" : \"Next\";\n  el(\"opts\").innerHTML = x.options.map(function(o, i){\n    return '<button class=\"opt\" id=\"opt' + i + '\" onclick=\"answer(' + i + ')\">' + esc(o) + '</button>';\n  }).join(\"\");\n}\nfunction answer(i){\n  if (answered) return;\n  answered = true;\n  var x = quiz[qi];\n  lifetime.asked++;\n  for (var k = 0; k < 4; k++){\n    var btn = el(\"opt\" + k);\n    btn.disabled = true;\n    if (k === x.correct) btn.className = \"opt correct\";\n    else if (k === i) btn.className = \"opt wrong\";\n  }\n  if (i === x.correct){ score++; haptic(\"success\"); }\n  else { wrong.push(x); haptic(\"light\"); }\n  lifetime.right += (i === x.correct) ? 1 : 0;\n  store.setItem(\"sb_life\", JSON.stringify(lifetime));\n  if (x.why){\n    el(\"why\").textContent = x.why;\n    el(\"why\").className = \"why on\";\n  }\n  el(\"qscore\").textContent = score + \" right\";\n  el(\"nextBtn\").className = \"go nextbtn on\";\n}\nfunction nextQ(){\n  haptic(\"selection\");\n  if (qi < quiz.length - 1){ qi++; showQ(); window.scrollTo(0, 0); }\n  else finish();\n}\n\n/* ---------- results ---------- */\nfunction finish(){\n  el(\"quiz\").style.display = \"none\";\n  el(\"result\").style.display = \"block\";\n  var pct = Math.round(score / quiz.length * 100);\n  el(\"remoji\").textContent = pct === 100 ? \"🏆\" : pct >= 60 ? \"💪\" : \"📖\";\n  el(\"rtitle\").textContent = score + \" out of \" + quiz.length;\n  el(\"rsub\").textContent = pct === 100 ? \"Perfect — you own this material.\"\n    : pct >= 60 ? \"Solid. One more round and it sticks.\"\n    : \"That's what practice is for — review below, then go again.\";\n  el(\"review\").innerHTML = wrong.length\n    ? '<label>Worth another look</label>' + wrong.map(function(x){\n        return '<div class=\"rv\"><b>' + esc(x.q) + '</b><small>✓ ' + esc(x.options[x.correct]) +\n          (x.why ? ' — ' + esc(x.why) : '') + '</small></div>';\n      }).join(\"\")\n    : \"\";\n  renderStats();\n  haptic(pct >= 60 ? \"success\" : \"light\");\n  window.scrollTo(0, 0);\n}\nfunction backToNotes(){\n  haptic(\"selection\");\n  el(\"result\").style.display = \"none\";\n  el(\"quiz\").style.display = \"none\";\n  el(\"setup\").style.display = \"block\";\n}\n\n/* ---------- boot ---------- */\nPromise.all([store.getItem(\"sb_notes\"), store.getItem(\"sb_life\")]).then(function(v){\n  if (v[0]) el(\"notes\").value = v[0];\n  if (v[1]){ try{ lifetime = JSON.parse(v[1]) || lifetime; }catch(e){} }\n  if (!ASK) el(\"setuphint\").textContent = \"Study Buddy needs AI — enable it in Settings to get quizzed.\";\n  renderStats();\n});\n</script>\n</body>\n</html>\n"}