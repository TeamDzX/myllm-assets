{"name": "Study Buddy", "kind": "html", "iconSymbol": "graduationcap.fill", "iconColor": "indigo", "html": "<!doctype html>\n<!--\n  Study Buddy — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Study Buddy</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"c51f394801\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); --h:248; }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink); min-height:100dvh; font-size:15.5px; line-height:1.4; }\n  body.lock{ overflow:hidden; }\n  .home{ max-width:600px; margin:0 auto;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ .home{ max-width:760px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.96); }\n  [hidden]{ display:none !important; }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 28%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  .head .acts{ display:flex; gap:8px; flex-shrink:0; }\n  h2.sec{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:20px 2px 9px; }\n\n  .hero{ border-radius:20px; padding:16px 18px; color:#fff; margin-bottom:12px; display:flex; align-items:center; gap:16px;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 46%), hsl(calc(var(--h) + 40) 58% 24%)); box-shadow:0 10px 28px hsl(var(--h) 60% 30% / .25); }\n  .hero .n{ font-size:44px; font-weight:800; line-height:1; letter-spacing:-.03em; font-variant-numeric:tabular-nums; flex-shrink:0; }\n  .hero .k{ display:block; font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.78; }\n  .hero b{ display:block; font-size:17px; font-weight:750; line-height:1.25; overflow-wrap:anywhere; }\n  .hero span.s{ display:block; font-size:12.5px; line-height:1.4; opacity:.82; margin-top:3px; overflow-wrap:anywhere; }\n  .hero .grow{ flex:1; min-width:0; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  label{ display:block; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:14px 2px 7px; }\n  label:first-child{ margin-top:0; }\n  input, textarea, select{ width:100%; font:inherit; font-size:16px; padding:12px; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; }\n  input:focus, textarea:focus{ border-color:hsl(var(--h) 60% 55%); }\n  .go{ width:100%; min-height:50px; margin-top:14px; border:none; border-radius:14px; background:hsl(var(--h) 62% 52%); color:#fff; font-size:16px; font-weight:700;\n    display:flex; align-items:center; justify-content:center; gap:8px; box-shadow:0 8px 20px hsl(var(--h) 60% 40% / .25); }\n  .go.soft{ background:var(--fill); color:var(--ink); box-shadow:none; }\n  .go:disabled{ opacity:.55; }\n  .status{ font-size:13px; color:var(--muted); min-height:18px; margin-top:10px; text-align:center; line-height:1.45; }\n  .status.err{ color:#ff453a; }\n  .spin{ width:16px; height:16px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; display:inline-block; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n  .empty{ text-align:center; padding:24px 18px 14px; }\n  .empty .tile{ width:48px; height:48px; border-radius:14px; font-size:21px; margin:0 auto 10px; opacity:.9; }\n  .empty b{ display:block; font-size:16px; font-weight:750; }\n  .empty p{ font-size:13.5px; color:var(--muted); line-height:1.5; max-width:280px; margin:5px auto 0; }\n  @media (prefers-reduced-motion:reduce){ .spin{ animation-duration:2.4s; } button:active{ transform:none; } }\n  @keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n  .myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n  .myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n  .myllm-ai-cog{width:16px;height:16px;border-radius:50%;border:2.4px solid #a78bfa;border-right-color:transparent;animation:myllmAiSpin .9s linear infinite;flex-shrink:0}\n  .myllm-ai-busy small{font-weight:400;opacity:.6}\n  /* ---------- the full-screen stage ---------- */\n  .stage{ display:none; position:fixed; inset:0; z-index:50; color:#fff; }\n  .stage.on{ display:block; }\n  .bg{ position:absolute; inset:0; transition:opacity .6s ease; }\n  .bg.d{ background:radial-gradient(120% 90% at 20% 10%, hsl(var(--h) 64% 34%), transparent 60%),\n      radial-gradient(120% 90% at 85% 95%, hsl(calc(var(--h) + 60) 60% 26%), transparent 62%), #0b0b10; }\n  .bg.l{ opacity:0; background:radial-gradient(120% 90% at 20% 0%, hsl(var(--h) 85% 88%), transparent 60%),\n      radial-gradient(120% 90% at 85% 100%, hsl(calc(var(--h) + 60) 80% 88%), transparent 62%), #f4f4f8; }\n  .lite{ color:#15151a; } .lite .bg.l{ opacity:1; } .lite .bg.d{ opacity:0; }\n  .col{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; overflow-y:auto; -webkit-overflow-scrolling:touch;\n    padding:calc(10px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(16px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  .top{ width:100%; max-width:560px; height:44px; display:flex; align-items:center; justify-content:space-between; gap:8px; flex-shrink:0; }\n  .glass{ border:1px solid rgba(255,255,255,.16); background:rgba(255,255,255,.12); color:inherit;\n    -webkit-backdrop-filter:blur(18px); backdrop-filter:blur(18px); }\n  .lite .glass{ border-color:rgba(0,0,0,.09); background:rgba(255,255,255,.62); }\n  .rnd{ width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:15px; flex-shrink:0; }\n  .pill{ min-width:44px; height:44px; border-radius:99px; padding:0 15px; display:flex; align-items:center; justify-content:center; gap:5px;\n    font-size:17px; font-weight:800; font-variant-numeric:tabular-nums; }\n  .pill small{ font-size:10.5px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; opacity:.7; }\n  .pill.hide{ visibility:hidden; }\n  .dots{ display:flex; gap:6px; align-items:center; flex-wrap:wrap; justify-content:center; }\n  .dots i{ width:8px; height:8px; border-radius:50%; background:currentColor; opacity:.22; transition:all .3s; }\n  .dots i.now{ opacity:1; transform:scale(1.35); } .dots i.ok{ opacity:1; background:#34c759; } .dots i.no{ opacity:1; background:#ff6259; }\n  .body{ flex:1 0 auto; width:100%; max-width:560px; display:flex; flex-direction:column; gap:12px; padding:12px 0 4px;\n    transition:opacity .3s, filter .3s; }\n  /* centred when there's room, top-aligned when there isn't: two growing spacers\n     instead of justify-content:center, which pushes tall content up under the bar */\n  .body::before, .body::after{ content:\"\"; flex:1 1 0; }\n  .veil .body{ opacity:.3; filter:blur(7px); pointer-events:none; }\n  .kick{ font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; opacity:.62; }\n  .pri{ width:100%; height:54px; border:none; border-radius:99px; font-size:16.5px; font-weight:750; background:#fff; color:#0b0b10;\n    box-shadow:0 10px 30px rgba(0,0,0,.3); display:flex; align-items:center; justify-content:center; gap:8px; flex-shrink:0; }\n  .lite .pri{ background:#15151a; color:#fff; box-shadow:0 10px 26px rgba(20,20,40,.22); }\n  .pri:disabled{ opacity:.5; }\n  .sec2{ width:100%; height:50px; border-radius:99px; font-size:15.5px; font-weight:750; display:flex; align-items:center; justify-content:center; gap:8px; flex-shrink:0; }\n  .center{ position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); border-radius:26px; padding:24px 20px 18px; text-align:center;\n    width:min(340px, calc(100% - 32px)); max-height:calc(100% - 40px); overflow-y:auto; z-index:5;\n    box-shadow:0 24px 60px rgba(0,0,0,.35); animation:pop .28s cubic-bezier(.2,.8,.2,1) both; }\n  .lite .center{ box-shadow:0 22px 50px rgba(20,20,40,.18); }\n  @keyframes pop{ from{ opacity:0; transform:translate(-50%,-50%) scale(.96); } to{ opacity:1; transform:translate(-50%,-50%); } }\n  .center h2{ font-size:24px; font-weight:800; letter-spacing:-.015em; margin-top:6px; }\n  .center p{ font-size:14px; line-height:1.45; opacity:.76; margin-top:8px; }\n  .center .big{ font-size:64px; font-weight:800; line-height:1.05; letter-spacing:-.03em; font-variant-numeric:tabular-nums; margin-top:4px; }\n  .center .big small{ font-size:.42em; opacity:.55; font-weight:750; }\n  .center .best{ display:inline-block; margin-top:10px; font-size:11.5px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; color:#0b0b10; background:#ffd60a; border-radius:99px; padding:5px 11px; }\n  .center .pri{ margin-top:18px; } .center .sec2{ margin-top:10px; }\n  .stars3{ display:flex; justify-content:center; gap:6px; margin-top:10px; font-size:30px; }\n  .stars3 svg{ width:1em; height:1em; fill:currentColor; opacity:.22; } .stars3 svg.on{ opacity:1; color:#ffd60a; }\n  @media (prefers-reduced-motion:reduce){ .center{ animation:none; } .dots i{ transition:none; } }\n\n  textarea{ min-height:170px; line-height:1.5; resize:vertical; -webkit-user-select:text; user-select:text; }\n  .hero .n small{ font-size:.45em; opacity:.7; font-weight:750; margin-left:1px; }\n  .qcard{ border-radius:24px; padding:20px 18px; }\n  .qcard h2{ font-size:20px; font-weight:750; line-height:1.32; margin-top:8px; letter-spacing:-.005em; overflow-wrap:anywhere; }\n  .opts{ display:flex; flex-direction:column; gap:9px; }\n  .opt{ width:100%; min-height:58px; border-radius:18px; padding:10px 14px; display:flex; align-items:center; gap:12px; text-align:left; font-size:16px; font-weight:650; line-height:1.3;\n    transition:background .25s, border-color .25s, opacity .25s; }\n  .opt .k{ width:30px; height:30px; border-radius:50%; flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:13px; font-weight:800; background:rgba(255,255,255,.14); }\n  .lite .opt .k{ background:rgba(20,20,40,.08); }\n  .opt .t{ flex:1; min-width:0; overflow-wrap:anywhere; }\n  .opt .mk{ font-size:15px; display:none; }\n  .opt:disabled{ opacity:.5; } .opt:disabled:active{ transform:none; }\n  .opt.correct, .lite .opt.correct{ background:#2fb350; border-color:#2fb350; color:#fff; opacity:1; }\n  .opt.wrong, .lite .opt.wrong{ background:#e5453b; border-color:#e5453b; color:#fff; opacity:1; }\n  .opt.correct .mk, .opt.wrong .mk{ display:flex; }\n  .opt.correct .k, .opt.wrong .k{ background:rgba(255,255,255,.25); }\n  .why{ display:none; border-radius:18px; padding:12px 14px; font-size:14px; line-height:1.45; gap:10px; align-items:flex-start; }\n  .why.on{ display:flex; animation:rise .4s ease both; } .why svg{ font-size:15px; margin-top:2px; opacity:.8; }\n  @keyframes rise{ from{ opacity:0; transform:translateY(8px); } to{ opacity:1; transform:none; } }\n  #nextBtn{ visibility:hidden; } #nextBtn.on{ visibility:visible; }\n  .review{ text-align:left; margin-top:14px; border-radius:16px; padding:4px 12px; background:rgba(255,255,255,.08); }\n  .lite .review{ background:rgba(20,20,40,.05); }\n  .review .h{ font-size:10.5px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.6; margin:10px 0 2px; }\n  .review .rv{ padding:9px 0; border-top:1px solid rgba(255,255,255,.12); font-size:13.5px; line-height:1.4; }\n  .lite .review .rv{ border-top-color:rgba(0,0,0,.08); }\n  .review .rv:first-of-type{ border-top:none; }\n  .review .rv b{ display:block; font-weight:700; }\n  .review .rv small{ display:flex; gap:5px; align-items:flex-start; margin-top:3px; opacity:.78; font-size:13px; }\n  .review .rv small svg{ color:#34c759; margin-top:1px; font-size:12px; }\n  .center .ring{ width:44px; height:44px; margin:4px auto 0; border-radius:50%; border:3px solid currentColor; border-right-color:transparent; animation:spin .9s linear infinite; opacity:.8; }\n  .center .tile2{ width:52px; height:52px; border-radius:16px; margin:0 auto; display:flex; align-items:center; justify-content:center; font-size:24px; color:#fff;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 55%), hsl(calc(var(--h) + 40) 58% 32%)); }\n  @media (max-height:520px){ .qcard{ padding:14px 16px; } .qcard h2{ font-size:17px; } .opt{ min-height:46px; } .body{ gap:8px; } }\n  @media (prefers-reduced-motion:reduce){ .why.on{ animation:none; } .center .ring{ animation-duration:2.4s; } }\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-cap\" viewBox=\"0 0 24 24\"><path d=\"M11.5 3.6a1.2 1.2 0 0 1 1 0l10 4.6a.8.8 0 0 1 0 1.5l-10 4.6a1.2 1.2 0 0 1-1 0l-10-4.6a.8.8 0 0 1 0-1.5zM5.5 12.6l5.6 2.6a2.2 2.2 0 0 0 1.8 0l5.6-2.6v3.6c0 1.8-3 3.6-6.5 3.6s-6.5-1.8-6.5-3.6zM21 10.4v5.4a1 1 0 0 1-2 0v-4.5z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-close\" viewBox=\"0 0 24 24\"><path d=\"M6.4 5a1 1 0 0 0-1.4 1.4L10.6 12 5 17.6A1 1 0 0 0 6.4 19l5.6-5.6 5.6 5.6a1 1 0 0 0 1.4-1.4L13.4 12 19 6.4A1 1 0 0 0 17.6 5L12 10.6z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M5 12.6l4.6 4.6L19.2 7.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-bulb\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5a6.5 6.5 0 0 1 4 11.6c-.7.6-1 1.2-1 1.9v.5a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1V16c0-.7-.3-1.3-1-1.9A6.5 6.5 0 0 1 12 2.5zM9.5 19.5h5a1 1 0 0 1 0 2h-5a1 1 0 0 1 0-2z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-again\" viewBox=\"0 0 24 24\"><path d=\"M12 5V2.6a.6.6 0 0 0-1-.45L7.2 5.55a.6.6 0 0 0 0 .9L11 9.85a.6.6 0 0 0 1-.45V7a5.5 5.5 0 1 1-5.5 5.5 1 1 0 0 0-2 0A7.5 7.5 0 1 0 12 5z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-pen\" viewBox=\"0 0 24 24\"><path d=\"M15.2 4.3a2.2 2.2 0 0 1 3.1 0l1.4 1.4a2.2 2.2 0 0 1 0 3.1L9.4 19.1 4 20l.9-5.4z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-spark\" viewBox=\"0 0 24 24\"><path d=\"M10 2.5l1.9 5.6 5.6 1.9-5.6 1.9L10 17.5l-1.9-5.6L2.5 10l5.6-1.9zM18.5 14l.95 2.55L22 17.5l-2.55.95L18.5 21l-.95-2.55L15 17.5l2.55-.95z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-trophy\" viewBox=\"0 0 24 24\"><path d=\"M7 3h10a1 1 0 0 1 1 1v1h2.5a1 1 0 0 1 1 1v1.5A4.5 4.5 0 0 1 17.3 12a5.5 5.5 0 0 1-4.3 3.4V18h3a1 1 0 0 1 0 2H8a1 1 0 0 1 0-2h3v-2.6A5.5 5.5 0 0 1 6.7 12 4.5 4.5 0 0 1 2.5 7.5V6a1 1 0 0 1 1-1H6V4a1 1 0 0 1 1-1zM4.5 7v.5A2.5 2.5 0 0 0 6.1 9.8 7 7 0 0 1 6 8.5V7zm13.5 0v1.5a7 7 0 0 1-.1 1.3A2.5 2.5 0 0 0 19.5 7.5V7z\" fill=\"currentColor\"/></symbol>\n</defs></svg>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\"></span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n<div class=\"home\">\n  <div class=\"imm-safe\"></div><div class=\"head\">\n    <div class=\"tile\"><svg class=\"i\"><use href=\"#i-cap\"/></svg></div>\n    <div class=\"ht\"><h1>Study Buddy</h1><p>Paste your notes, get quizzed</p></div>\n  <div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Study Buddy\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n\n  <div class=\"hero\" id=\"hero\" hidden>\n    <div class=\"n\" id=\"hPct\">0<small>%</small></div>\n    <div class=\"grow\"><span class=\"k\">Lifetime</span><b id=\"hT\"></b><span class=\"s\">Every quiz you take adds up here.</span></div>\n  </div>\n\n  <div class=\"card\">\n    <label for=\"notes\">Your notes — or just a topic</label>\n    <textarea id=\"notes\" placeholder=\"Paste your revision notes, a textbook passage, vocabulary…&#10;&#10;Or simply type a topic: 'GCSE photosynthesis', 'French passé composé', 'the French Revolution'\"></textarea>\n    <button class=\"go\" id=\"quizBtn\" type=\"button\"></button>\n    <p class=\"status\" id=\"setuphint\">Questions are generated privately, on this device — your notes never leave your phone.</p>\n  </div>\n</div>\n\n<div class=\"stage\" id=\"stage\">\n  <div class=\"bg d\"></div><div class=\"bg l\"></div>\n  <div class=\"col\" id=\"col\">\n    <div class=\"top\">\n      <button class=\"glass rnd\" id=\"bClose\" type=\"button\" aria-label=\"Leave quiz\"><svg class=\"i\"><use href=\"#i-close\"/></svg></button>\n      <div class=\"dots\" id=\"dots\"></div>\n      <div class=\"glass pill\" id=\"pScore\">0<small>right</small></div>\n    </div>\n    <div class=\"body\" id=\"qbody\">\n      <div class=\"qcard glass\"><div class=\"kick\" id=\"qnum\"></div><h2 id=\"qtext\"></h2></div>\n      <div class=\"opts\" id=\"opts\"></div>\n      <div class=\"why glass\" id=\"why\"><svg class=\"i\"><use href=\"#i-bulb\"/></svg><span id=\"whyText\"></span></div>\n      <button class=\"pri\" id=\"nextBtn\" type=\"button\">Next</button>\n    </div>\n    <div class=\"center glass\" id=\"card\" hidden></div>\n  </div>\n</div>\n\n<script>\nfunction el(i){return document.getElementById(i)}\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction store(){return window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}}}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nfunction icon(n){return '<svg class=\"i\"><use href=\"#i-'+n+'\"/></svg>'}\nfunction esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]})}\n/* The quiz takes the whole display. Where MyLLM can't hide its own title\n   bar, a dark stage under a white bar looks cut in half — so in light mode,\n   without myllmImmersive, the stage stays light. */\nvar stageOn=false;\nfunction isLight(){return !(window.matchMedia&&matchMedia('(prefers-color-scheme: dark)').matches)}\nfunction syncLook(){el('stage').classList.toggle('lite',isLight()&&!window.myllmImmersive)}\nfunction syncChrome(){\n  if(!window.myllmImmersive)return;\n  try{myllmImmersive((window.myllmClose ? true : (stageOn)), {keepAwake:false}).catch(function(){})}catch(_){}\n}\nfunction openStage(){if(stageOn)return;stageOn=true;syncLook();el('stage').classList.add('on');document.body.classList.add('lock');syncChrome()}\nfunction closeStage(){if(!stageOn)return;stageOn=false;el('stage').classList.remove('on','veil');document.body.classList.remove('lock');syncChrome()}\nif(window.matchMedia){var mq=matchMedia('(prefers-color-scheme: dark)');if(mq.addEventListener)mq.addEventListener('change',syncLook);else if(mq.addListener)mq.addListener(syncLook)}\nfunction ASK(){return window.myllmAsk||null}\n\nvar quiz = [];        /* [{q, options[4], correct, why}] */\nvar qi = 0, score = 0, answered = false, busy = false;\nvar wrong = [];       /* review list */\nvar results = [];     /* true/false per question, for the dots */\nvar lifetime = {asked:0, right:0};\nvar askedBefore = []; /* question texts from this session, to avoid repeats on \"again\" */\n\nfunction renderStats(){\n  var has = lifetime.asked > 0;\n  el(\"hero\").hidden = !has;\n  if (has){\n    el(\"hPct\").innerHTML = Math.round(lifetime.right / lifetime.asked * 100) + \"<small>%</small>\";\n    el(\"hT\").textContent = lifetime.right + \" of \" + lifetime.asked + \" answered right\";\n  }\n}\nfunction quizBtn(on){\n  var b = el(\"quizBtn\"); b.disabled = !!on;\n  b.innerHTML = on ? '<i class=\"spin\"></i><span>Writing your questions…</span>' : icon(\"spark\") + \"<span>Quiz me</span>\";\n}\nfunction hint(t, err){ var h = el(\"setuphint\"); h.textContent = t; h.classList.toggle(\"err\", !!err); }\n\n/* ---------- generate ---------- */\n/* Labelled lines, not JSON — small models (Apple Intelligence) echo JSON\n   templates back verbatim. Echoed instructions are rejected and retried. */\nvar ECHO = /the question text|one answer choice|repeat this line|labelled line|number \\(1-4\\)|of the correct choice|one-sentence explanation|each of the four/i;\n\nfunction parseQuizJSON(s){ /* legacy fallback: big cloud models may still answer in the old JSON shape */\n  var a = s.indexOf(\"[\"), b = s.lastIndexOf(\"]\");\n  if (a < 0 || b <= a) return null;\n  var arr;\n  try{ arr = JSON.parse(s.slice(a, b + 1)); }catch(e){ return null; }\n  if (!Array.isArray(arr)) return null;\n  var clean = arr.filter(function(x){\n    return x && typeof x.q === \"string\" && Array.isArray(x.options) && x.options.length === 4 &&\n           typeof x.correct === \"number\" && x.correct >= 0 && x.correct <= 3;\n  }).map(function(x){\n    return {q:x.q, options:x.options.map(String), correct:x.correct, why:String(x.why || \"\")};\n  });\n  return clean.length >= 3 ? clean.slice(0, 5) : null;\n}\n\nfunction resolveAnswer(ans, options){\n  var s = String(ans || \"\").trim();\n  var m = s.match(/[1-4]/);\n  if (m) return parseInt(m[0], 10) - 1;\n  m = s.match(/^[A-D]\\b/i);\n  if (m) return \"ABCD\".indexOf(m[0].toUpperCase());\n  for (var i = 0; i < options.length; i++)\n    if (options[i].toLowerCase() === s.toLowerCase()) return i;\n  return -1;\n}\n\nfunction parseQuizReply(reply){\n  var s = String(reply || \"\");\n  var qs = [], cur = null, lastKey = \"\";\n  s.split(/\\r?\\n/).forEach(function(raw){\n    var ln = raw.replace(/\\*\\*/g, \"\").trim();\n    var m = ln.match(/^[-*#>\\s]*(QUESTION|Q|OPTIONS?|ANSWERS?|WHY)\\s*\\d*\\s*[::]\\s*(.*)$/i);\n    if (!m){\n      if (cur && lastKey === \"WHY\" && ln) cur.why += \" \" + ln; /* prose may wrap onto the next line */\n      return;\n    }\n    var k = m[1].toUpperCase().replace(/S$/, \"\"), v = m[2].trim();\n    if (k === \"QUESTION\") k = \"Q\";\n    lastKey = k;\n    if (k === \"Q\"){ cur = {q:v, options:[], correct:-1, why:\"\", _ans:\"\"}; qs.push(cur); return; }\n    if (!cur) return;\n    if (k === \"OPTION\"){ v.split(\"|\").forEach(function(o){ o = o.trim(); if (o) cur.options.push(o); }); }\n    else if (k === \"ANSWER\"){ cur._ans = v; }\n    else if (k === \"WHY\"){ cur.why = v; }\n  });\n  if (!qs.length){\n    var legacy = parseQuizJSON(s); /* no labelled lines at all — try the old JSON shape */\n    if (legacy) return legacy;\n    throw new Error(\"no questions found\");\n  }\n  var clean = qs.map(function(x){\n    x.options = x.options.filter(function(o){ return o && !ECHO.test(o); }).slice(0, 4);\n    x.correct = resolveAnswer(x._ans, x.options);\n    delete x._ans;\n    x.why = ECHO.test(x.why) ? \"\" : x.why.trim();\n    return x;\n  }).filter(function(x){\n    return x.q && !ECHO.test(x.q) && x.options.length === 4 && x.correct >= 0 && x.correct <= 3;\n  });\n  if (clean.length < 3) throw new Error(\"quiz didn't parse\");\n  return clean.slice(0, 5);\n}\n\nfunction showCard(html){ var c = el(\"card\"); c.innerHTML = html; c.hidden = false; el(\"stage\").classList.add(\"veil\"); }\nfunction hideCard(){ el(\"card\").hidden = true; el(\"stage\").classList.remove(\"veil\"); }\n\nfunction startQuiz(){\n  if (busy) return;\n  var notes = el(\"notes\").value.trim();\n  if (!notes){\n    if (stageOn){ leave(); }\n    hint(\"Paste some notes or a topic first.\", true); haptic(\"light\"); return;\n  }\n  var ask = ASK();\n  if (!ask){ hint(\"Study Buddy needs AI — enable it in Settings, then come back.\", true); haptic(\"light\"); return; }\n  haptic(\"light\");\n  store().setItem(\"sb_notes\", notes);\n  busy = true;\n  quizBtn(true);\n  hint(\"Writing your questions…\");\n  if (stageOn) showCard('<div class=\"ring\"></div><h2>Writing new questions</h2><p>From the same notes — usually a few seconds.</p>');\n  var avoid = askedBefore.length ? \"\\nDo NOT reuse these questions: \" + askedBefore.slice(-10).map(function(q){ return '\"' + q + '\"'; }).join(\", \") : \"\";\n  var prompt = \"Create exactly 5 multiple-choice questions to test understanding of this material. Mix recall and understanding; make wrong options plausible.\\n\\nMATERIAL:\\n\" + notes.slice(0, 6000) + avoid +\n      \"\\n\\nReply with EXACTLY these labelled lines and nothing else, repeating the block for each of the 5 questions:\\n\" +\n      \"Q: the question text\\n\" +\n      \"OPTION: one answer choice — repeat this line for each of the four choices\\n\" +\n      \"ANSWER: the number (1-4) of the correct choice\\n\" +\n      \"WHY: a one-sentence explanation of the right answer\\n\" +\n      \"Vary which position is correct.\";\n  var sys = {system:\"You are an excellent quiz writer. Output only the labelled lines — no commentary, no code fences.\"};\n  ask(prompt, sys)\n  .then(function(r){ return parseQuizReply(r); })\n  .catch(function(){\n    return ASK()(prompt + \"\\nIMPORTANT: fill each labelled line with real content — never repeat the instruction text.\", sys)\n      .then(function(r){ return parseQuizReply(r); });\n  })\n  .then(function(parsed){\n    busy = false; quizBtn(false);\n    quiz = parsed;\n    quiz.forEach(function(x){ askedBefore.push(x.q); });\n    qi = 0; score = 0; wrong = []; results = [];\n    hint(\"\");\n    haptic(\"success\");\n    hideCard(); openStage();\n    showQ();\n  })\n  .catch(function(){\n    busy = false; quizBtn(false);\n    var msg = \"The questions didn't come through cleanly — that happens with smaller models. Tap Quiz me to try again.\";\n    hint(msg, true);\n    if (stageOn){\n      showCard('<div class=\"tile2\">' + icon(\"again\") + '</div><h2>No quiz this time</h2><p>' + esc(msg.replace(\"Tap Quiz me\", \"Try again\")) + '</p>' +\n        '<button class=\"pri\" id=\"cA\" type=\"button\">' + icon(\"again\") + 'Try again</button><button class=\"sec2 glass\" id=\"cB\" type=\"button\">' + icon(\"pen\") + 'Edit notes</button>');\n      el(\"cA\").onclick = startQuiz; el(\"cB\").onclick = backToNotes;\n    }\n    haptic(\"light\");\n  });\n}\n\n/* ---------- play ---------- */\nfunction renderDots(){\n  el(\"dots\").innerHTML = quiz.map(function(_, i){\n    return '<i class=\"' + (i < results.length ? (results[i] ? \"ok\" : \"no\") : i === qi ? \"now\" : \"\") + '\"></i>';\n  }).join(\"\");\n}\nfunction showQ(){\n  var x = quiz[qi];\n  answered = false;\n  el(\"qnum\").textContent = \"Question \" + (qi + 1) + \" of \" + quiz.length;\n  el(\"pScore\").innerHTML = score + \"<small>right</small>\";\n  el(\"qtext\").textContent = x.q;\n  el(\"why\").className = \"why glass\";\n  el(\"nextBtn\").className = \"pri\";\n  el(\"nextBtn\").innerHTML = qi === quiz.length - 1 ? \"See my score\" : \"Next\";\n  el(\"opts\").innerHTML = x.options.map(function(o, i){\n    return '<button class=\"opt glass\" type=\"button\" id=\"opt' + i + '\"><span class=\"k\">' + \"ABCD\"[i] + '</span><span class=\"t\">' + esc(o) + '</span><span class=\"mk\"></span></button>';\n  }).join(\"\");\n  x.options.forEach(function(_, i){ el(\"opt\" + i).onclick = function(){ answer(i); }; });\n  renderDots();\n  el(\"col\").scrollTop = 0;\n}\nfunction answer(i){\n  if (answered) return;\n  answered = true;\n  var x = quiz[qi];\n  lifetime.asked++;\n  for (var k = 0; k < 4; k++){\n    var btn = el(\"opt\" + k);\n    btn.disabled = true;\n    if (k === x.correct){ btn.className = \"opt glass correct\"; btn.querySelector(\".mk\").innerHTML = icon(\"check\"); }\n    else if (k === i){ btn.className = \"opt glass wrong\"; btn.querySelector(\".mk\").innerHTML = icon(\"x\"); }\n  }\n  if (i === x.correct){ score++; haptic(\"success\"); }\n  else { wrong.push(x); haptic(\"light\"); }\n  results.push(i === x.correct);\n  lifetime.right += (i === x.correct) ? 1 : 0;\n  store().setItem(\"sb_life\", JSON.stringify(lifetime));\n  if (x.why){\n    el(\"whyText\").textContent = x.why;\n    el(\"why\").className = \"why glass on\";\n  }\n  el(\"pScore\").innerHTML = score + \"<small>right</small>\";\n  el(\"nextBtn\").className = \"pri on\";\n  renderDots();\n}\nfunction nextQ(){\n  haptic(\"selection\");\n  if (qi < quiz.length - 1){ qi++; showQ(); }\n  else finish();\n}\n\n/* ---------- results ---------- */\nfunction finish(){\n  var pct = Math.round(score / quiz.length * 100);\n  var head = pct === 100 ? \"Perfect score\" : pct >= 60 ? \"Nicely done\" : \"Keep going\";\n  var sub = pct === 100 ? \"Perfect — you own this material.\"\n    : pct >= 60 ? \"Solid. One more round and it sticks.\"\n    : \"That's what practice is for — review below, then go again.\";\n  var review = wrong.length\n    ? '<div class=\"review\"><div class=\"h\">Worth another look</div>' + wrong.map(function(x){\n        return '<div class=\"rv\"><b>' + esc(x.q) + '</b><small>' + icon(\"check\") + '<span>' + esc(x.options[x.correct]) +\n          (x.why ? ' — ' + esc(x.why) : '') + '</span></small></div>';\n      }).join(\"\") + '</div>'\n    : \"\";\n  showCard('<div class=\"kick\">' + head + '</div><div class=\"big\">' + score + '<small>/' + quiz.length + '</small></div><p>' + sub + '</p>' + review +\n    '<button class=\"pri\" id=\"cA\" type=\"button\">' + icon(\"again\") + 'Quiz me again</button><button class=\"sec2 glass\" id=\"cB\" type=\"button\">' + icon(\"pen\") + 'Edit notes</button>');\n  el(\"cA\").onclick = startQuiz; el(\"cB\").onclick = backToNotes;\n  renderStats();\n  haptic(pct >= 60 ? \"success\" : \"light\");\n}\nfunction leave(){ hideCard(); closeStage(); }\nfunction backToNotes(){\n  haptic(\"selection\");\n  leave();\n}\n\nel(\"quizBtn\").onclick = startQuiz;\nel(\"nextBtn\").onclick = nextQ;\nel(\"bClose\").onclick = function(){ if (busy) return; haptic(\"light\"); leave(); };\ndocument.addEventListener(\"visibilitychange\", function(){ if (!document.hidden && stageOn) syncChrome(); });\n\n/* ---------- boot ---------- */\nquizBtn(false);\nPromise.all([store().getItem(\"sb_notes\"), store().getItem(\"sb_life\")]).then(function(v){\n  if (v[0]) el(\"notes\").value = v[0];\n  if (v[1]){ try{ lifetime = JSON.parse(v[1]) || lifetime; }catch(e){} }\n  if (!ASK()) hint(\"Study Buddy needs AI — enable it in Settings to get quizzed.\", true);\n  renderStats();\n});\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes.\n   The spacer keeps the header clear of the status bar / Dynamic Island. It is\n   live CSS — env(safe-area-inset-top) — not a measured number: the inset is\n   still 0 when the page loads and only grows once MyLLM's bar has gone (v1\n   measured once, so the title sat under the island). If the page's own styles\n   already pad the header down by the inset, the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  /* Does any rule that applies to the header or an ancestor already use the top inset? */\n  function pageHandlesInset(head){\n    var chain = [], n, found = false;\n    for (n = head; n && n.nodeType === 1; n = n.parentElement) chain.push(n);\n    function walk(rules){\n      for (var i = 0; i < rules.length && !found; i++){\n        var r = rules[i];\n        if (r.cssRules && !r.selectorText) { walk(r.cssRules); continue; }\n        if (!r.selectorText || !/safe-area-inset-top/.test(r.cssText) || !/(padding|margin|top)\\s*:/.test(r.cssText)) continue;\n        if (/\\.imm-safe/.test(r.selectorText)) continue;\n        for (var k = 0; k < chain.length; k++){\n          try { if (chain[k].matches(r.selectorText)) { found = true; break; } } catch(e){}\n        }\n      }\n    }\n    for (var s = 0; s < document.styleSheets.length && !found; s++){\n      try { walk(document.styleSheets[s].cssRules); } catch(e){}\n    }\n    for (n = head; n && n.nodeType === 1 && !found; n = n.parentElement){\n      if (/safe-area-inset-top/.test(n.getAttribute(\"style\") || \"\")) found = true;\n    }\n    return found;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = (document.body.classList.contains(\"imm\") && !pageHandlesInset(head)) ? \"env(safe-area-inset-top)\" : \"0px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script>\n</body>\n</html>\n"}