{"name": "Language Lab", "html": "<!doctype html>\n<!--\n  Language Lab — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Language Lab</title>\n<style>\n:root{--build-id:\"c4dd53474e\";\n  color-scheme:light dark;\n  --font:var(--myllm-font,-apple-system,system-ui,\"Segoe UI\",Roboto,sans-serif);\n  --page1:#eef1f8; --page2:#f6f4ff;\n  --surface:#ffffff; --surface2:#f3f4fa;\n  --ink:#191c28; --muted:#697083; --faint:#a2a8b8;\n  --border:#e7e9f1;\n  --acc:#6d5efc; --acc2:#a855f7; --accSoft:rgba(109,94,252,.12);\n  --radius:16px; --radiusLg:22px;\n  --shadow:0 1px 2px rgba(20,20,50,.05),0 8px 22px -14px rgba(40,25,90,.28);\n  --shadowLg:0 14px 42px -14px rgba(80,50,160,.45);\n}\n@media(prefers-color-scheme:dark){:root{\n  --page1:#0b0d13; --page2:#12111c;\n  --surface:#181b24; --surface2:#20232f;\n  --ink:#f1f2f7; --muted:#9aa0af; --faint:#666d7d;\n  --border:#282c39; --accSoft:rgba(139,92,246,.20);\n  --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 28px -14px rgba(0,0,0,.7);\n  --shadowLg:0 16px 46px -14px rgba(0,0,0,.85);\n}}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nbody{font-family:var(--font);margin:0;padding:18px 16px calc(34px + env(safe-area-inset-bottom));\n  background:linear-gradient(180deg,var(--page1),var(--page2));background-attachment:fixed;\n  min-height:100dvh;color:var(--ink);line-height:1.4}\n@media(min-width:768px){body{max-width:720px;margin:0 auto}}\n\n/* hero */\n.hero{position:relative;overflow:hidden;border-radius:var(--radiusLg);padding:20px;margin-bottom:16px;\n  background:linear-gradient(135deg,var(--acc),var(--acc2));color:#fff;box-shadow:var(--shadowLg);\n  display:flex;align-items:center;gap:14px}\n.hero::after{content:\"\";position:absolute;right:-46px;top:-46px;width:170px;height:170px;border-radius:50%;\n  background:radial-gradient(circle,rgba(255,255,255,.28),transparent 70%);pointer-events:none}\n.hero-badge{width:52px;height:52px;border-radius:16px;background:rgba(255,255,255,.22);\n  display:grid;place-items:center;font-size:28px;flex:0 0 auto}\n.hero h1{font-size:22px;font-weight:800;letter-spacing:-.02em;margin:0}\n.hero p{margin:3px 0 0;font-size:13px;opacity:.92;font-weight:500}\n\n/* cards / surfaces */\n.surface{background:var(--surface);border:1px solid var(--border);border-radius:var(--radiusLg);\n  padding:16px;box-shadow:var(--shadow);margin-bottom:16px}\n\n/* fields + buttons */\n.field{display:flex;align-items:center;gap:10px;background:var(--surface2);border:1px solid var(--border);\n  border-radius:13px;padding:0 13px;margin-bottom:10px}\n.field-ic{font-size:16px;opacity:.7;flex:0 0 auto}\n.field input{flex:1;border:0;background:none;padding:13px 0;font-size:16px;color:var(--ink);\n  outline:none;min-width:0;font-family:var(--font)}\n.field input::placeholder{color:var(--faint)}\n.btn-primary{width:100%;border:0;border-radius:14px;padding:14px;font-size:15px;font-weight:700;color:#fff;\n  font-family:var(--font);background:linear-gradient(135deg,var(--acc),var(--acc2));\n  box-shadow:0 8px 20px -8px var(--acc);cursor:pointer;transition:transform .1s,opacity .2s}\n.btn-primary:active{transform:scale(.98)}\n.btn-primary:disabled{opacity:.5;box-shadow:none}\n.btn-soft{width:100%;border:0;border-radius:13px;padding:12px;font-size:14.5px;font-weight:700;\n  color:var(--acc);background:var(--accSoft);font-family:var(--font);cursor:pointer;transition:transform .1s,opacity .2s}\n.btn-soft:active{transform:scale(.98)}\n.btn-soft:disabled{opacity:.5}\n\n/* language chips */\n.chips{display:flex;flex-wrap:wrap;gap:7px;margin:2px 0 12px}\n.chip{border:1px solid var(--border);background:var(--surface);color:var(--muted);border-radius:999px;\n  padding:7px 12px;font-size:13px;font-weight:600;cursor:pointer;font-family:var(--font);transition:.15s}\n.chip.on{color:var(--acc);border-color:var(--acc);background:var(--accSoft)}\n\n.status{font-size:13px;color:var(--muted);min-height:18px;margin-top:9px;text-align:center}\n\n/* lesson header */\n.lesson-head{display:flex;align-items:center;gap:12px;margin:4px 2px 13px}\n.lesson-flag{width:44px;height:44px;border-radius:13px;background:var(--surface);border:1px solid var(--border);\n  display:grid;place-items:center;font-size:24px;box-shadow:var(--shadow);flex:0 0 auto}\n.lesson-title{font-size:18px;font-weight:750;letter-spacing:-.01em}\n.lesson-sub{font-size:13px;color:var(--muted);margin-top:1px}\n\n/* phrase cards */\n.pcard{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);\n  padding:14px 15px;margin-bottom:9px;box-shadow:var(--shadow);cursor:pointer;\n  transition:border-color .2s,transform .1s}\n.pcard:active{transform:scale(.995)}\n.pcard.open{border-color:var(--acc)}\n.pcard-top{display:flex;align-items:center;gap:11px}\n.pnum{flex:0 0 auto;width:24px;height:24px;border-radius:8px;background:var(--accSoft);color:var(--acc);\n  font-size:12px;font-weight:800;display:grid;place-items:center}\n.pphrase{flex:1;font-size:17px;font-weight:650;line-height:1.3;min-width:0}\n.pspeak{flex:0 0 auto;border:0;background:var(--surface2);border-radius:9px;padding:6px 9px;\n  font-size:15px;cursor:pointer;line-height:1}\n.pspeak:active{background:var(--accSoft)}\n.pchev{flex:0 0 auto;color:var(--faint);font-size:16px;transition:transform .25s,color .2s}\n.pcard.open .pchev{transform:rotate(180deg);color:var(--acc)}\n.preveal{max-height:0;overflow:hidden;opacity:0;transition:max-height .3s ease,opacity .25s ease,margin .3s}\n.pcard.open .preveal{max-height:240px;opacity:1;margin-top:11px}\n.ppron{font-size:14px;font-style:italic;color:var(--muted)}\n.pmean{font-size:15px;margin-top:3px;line-height:1.5}\n.tap-hint{font-size:11.5px;color:var(--faint);text-align:center;margin:2px 0 12px}\n\n/* coach */\n.coach-head{display:flex;align-items:center;gap:11px;margin-bottom:13px}\n.coach-head>span{font-size:22px;flex:0 0 auto}\n.coach-title{font-size:16px;font-weight:700}\n.coach-sub{font-size:12.5px;color:var(--muted);margin-top:1px}\n.feedback{display:none;margin-top:12px;background:var(--accSoft);border-radius:12px;padding:12px 13px}\n.fb-label{font-size:11.5px;font-weight:800;color:var(--acc);margin-bottom:5px;letter-spacing:.04em;text-transform:uppercase}\n.fb-body{font-size:14.5px;line-height:1.55;white-space:pre-wrap}\n\n/* saved lessons */\n.section{font-size:12px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);margin:8px 2px 10px}\n.deck{display:flex;align-items:center;gap:12px;background:var(--surface);border:1px solid var(--border);\n  border-radius:14px;padding:11px 13px;margin-bottom:8px;box-shadow:var(--shadow);cursor:pointer;transition:border-color .2s}\n.deck.on{border-color:var(--acc)}\n.deck-flag{font-size:22px;flex:0 0 auto}\n.deck-mid{flex:1;min-width:0}\n.deck-t{font-size:15px;font-weight:650;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.deck-s{font-size:12.5px;color:var(--muted);margin-top:1px}\n.del{border:0;background:none;color:var(--faint);font-size:15px;padding:6px;cursor:pointer;flex:0 0 auto}\n.del:active{color:#ff453a}\n\n/* empty state */\n.empty{display:none;text-align:center;padding:30px 20px 10px;color:var(--muted)}\n.empty-emoji{font-size:44px;line-height:1}\n.empty h3{margin:12px 0 5px;font-size:17px;color:var(--ink);font-weight:700}\n.empty p{margin:0 auto;font-size:13.5px;line-height:1.5;max-width:270px}\n\n@media(prefers-reduced-motion:no-preference){\n  .pcard{animation:rise .4s ease backwards;animation-delay:var(--d,0ms)}\n  @keyframes rise{from{opacity:0;transform:translateY(9px)}to{opacity:1;transform:none}}\n  .hero{animation:rise .45s ease backwards}\n}\n</style></head><body>\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-family:-apple-system,system-ui,sans-serif;font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;line-height:1;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n<script>\n(function(){\n  if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;\n  window.__myllmAiWrap=true;\n  var orig=window.myllmAsk,depth=0,node=null;\n  function ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\n    node.innerHTML='<span class=\"myllm-ai-cog\">⚙️</span><span>AI is thinking… <small>privately, on your device</small></span>';\n    (document.body||document.documentElement).appendChild(node);}\n  function show(){ensure();depth++;node.classList.add('on');}\n  function hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\n  window.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\n    return Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};\n})();\n</script>\n\n<div class=\"hero\">\n  <div class=\"hero-badge\">🌍</div>\n  <div><h1>Language Lab</h1><p>Learn any language — one bite-size lesson at a time.</p></div>\n</div>\n\n<div class=\"surface\">\n  <label class=\"field\"><span class=\"field-ic\">🗣️</span><input id=\"lang\" placeholder=\"Language — e.g. Spanish, Japanese\"></label>\n  <div class=\"chips\" id=\"langChips\"></div>\n  <label class=\"field\"><span class=\"field-ic\">💡</span><input id=\"topic\" placeholder=\"Topic — e.g. ordering food\"></label>\n  <button class=\"btn-primary\" id=\"gen\" onclick=\"gen()\">Teach me ✨</button>\n  <div id=\"status\" class=\"status\"></div>\n</div>\n\n<div class=\"empty\" id=\"empty\">\n  <div class=\"empty-emoji\">📚</div>\n  <h3>Your lessons live here</h3>\n  <p>Pick a language and a topic above, and your AI tutor writes a lesson in seconds.</p>\n</div>\n\n<div id=\"lessonView\" style=\"display:none\">\n  <div class=\"lesson-head\">\n    <div class=\"lesson-flag\" id=\"lessonFlag\">🌐</div>\n    <div><div class=\"lesson-title\" id=\"lessonTitle\"></div><div class=\"lesson-sub\" id=\"lessonSub\"></div></div>\n  </div>\n  <div id=\"phrases\"></div>\n  <div class=\"tap-hint\" id=\"tapHint\">Tap a card to reveal the meaning</div>\n  <div class=\"surface\" id=\"coachWrap\">\n    <div class=\"coach-head\"><span>✍️</span><div><div class=\"coach-title\">Practice</div><div class=\"coach-sub\">Write a sentence — get instant, friendly feedback</div></div></div>\n    <label class=\"field\"><span class=\"field-ic\">📝</span><input id=\"attempt\" placeholder=\"Your sentence…\"></label>\n    <button class=\"btn-soft\" id=\"chk\" onclick=\"coach()\">Check my sentence</button>\n    <div class=\"feedback\" id=\"feedback\"></div>\n  </div>\n</div>\n\n<div id=\"savedWrap\" style=\"display:none\">\n  <div class=\"section\">Saved lessons</div>\n  <div id=\"lessons\"></div>\n</div>\n\n<script>\n\"use strict\";\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar lessons=[],cur=-1;\nvar TTS=!!(window.speechSynthesis&&window.SpeechSynthesisUtterance);\nfunction el(i){return document.getElementById(i)}\nfunction setStatus(t){el('status').textContent=t}\nfunction save(){store.setItem('lessons',JSON.stringify(lessons))}\nfunction esc(s){return String(s).replace(/[&<>\"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]})}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\n\nvar FLAGS={spanish:'🇪🇸',french:'🇫🇷',japanese:'🇯🇵',german:'🇩🇪',italian:'🇮🇹',portuguese:'🇵🇹',mandarin:'🇨🇳',chinese:'🇨🇳',korean:'🇰🇷',russian:'🇷🇺',arabic:'🇸🇦',hindi:'🇮🇳',dutch:'🇳🇱',greek:'🇬🇷',turkish:'🇹🇷',polish:'🇵🇱',swedish:'🇸🇪',english:'🇬🇧',thai:'🇹🇭',vietnamese:'🇻🇳',hebrew:'🇮🇱',indonesian:'🇮🇩'};\nvar CODES={spanish:'es-ES',french:'fr-FR',japanese:'ja-JP',german:'de-DE',italian:'it-IT',portuguese:'pt-PT',mandarin:'zh-CN',chinese:'zh-CN',korean:'ko-KR',russian:'ru-RU',arabic:'ar-SA',hindi:'hi-IN',dutch:'nl-NL',greek:'el-GR',turkish:'tr-TR',polish:'pl-PL',swedish:'sv-SE',english:'en-GB',thai:'th-TH',vietnamese:'vi-VN',hebrew:'he-IL',indonesian:'id-ID'};\nfunction flagFor(l){return FLAGS[String(l||'').trim().toLowerCase()]||'🌐'}\nfunction codeFor(l){return CODES[String(l||'').trim().toLowerCase()]||''}\nfunction speak(text,lang){\n  if(!TTS)return;\n  try{window.speechSynthesis.cancel();\n    var u=new SpeechSynthesisUtterance(text);var c=codeFor(lang);if(c)u.lang=c;u.rate=.9;\n    window.speechSynthesis.speak(u);haptic('light');\n  }catch(e){}\n}\n\nvar POPULAR=['Spanish','French','Japanese','German','Italian','Korean'];\nfunction buildChips(){\n  var c=el('langChips');c.innerHTML='';\n  POPULAR.forEach(function(name){\n    var b=document.createElement('button');b.type='button';b.className='chip';b.textContent=flagFor(name)+' '+name;\n    b.onclick=function(){\n      el('lang').value=name;\n      document.querySelectorAll('.chip').forEach(function(x){x.classList.remove('on')});\n      b.classList.add('on');el('topic').focus();haptic('selection');\n    };\n    c.appendChild(b);\n  });\n}\n\nfunction needAI(){\n  if(window.myllmAsk)return false;\n  setStatus('This app needs AI access — update MyLLM and enable “Allow apps to use the AI” in Settings.');\n  return true;\n}\n\n/* Labelled lines, not JSON — small models (Apple Intelligence) echo JSON\n   templates back verbatim. Echoed instructions are rejected and retried. */\nvar ECHO=/the phrase in\\b|english pronunciation|english meaning|repeat this line|labelled line/i;\nfunction parseLesson(reply){\n  reply=String(reply||'');\n  var phrases=[],got=false;\n  reply.split(/\\r?\\n/).forEach(function(raw){\n    var ln=raw.replace(/\\*\\*/g,'').trim();\n    var m=ln.match(/^[-*#>\\s]*(PHRASES?)\\s*\\d*\\s*[::]\\s*(.*)$/i);\n    if(!m)return;\n    got=true;var v=m[2].trim();\n    if(!v||ECHO.test(v))return;\n    var parts=v.split('|').map(function(x){return x.trim()});\n    if(parts.length>=3)phrases.push({t:parts[0],p:parts[1],n:parts.slice(2).join(' | ')});\n    else if(parts.length===2)phrases.push({t:parts[0],p:'',n:parts[1]});\n  });\n  if(!got){ // some models still answer in the old JSON shape — accept it\n    var s=reply.indexOf('['),e=reply.lastIndexOf(']');\n    if(s>=0&&e>s)try{\n      var j=JSON.parse(reply.slice(s,e+1));\n      if(Array.isArray(j))phrases=j.filter(function(x){return x&&x.t&&x.n})\n        .map(function(x){return{t:String(x.t),p:x.p?String(x.p):'',n:String(x.n)}});\n    }catch(e2){}\n  }\n  phrases=phrases.filter(function(x){return x.t&&x.n&&!ECHO.test(x.t)&&!ECHO.test(x.n)});\n  if(phrases.length<2)throw new Error('the model did not return a lesson');\n  return phrases;\n}\nfunction gen(){\n  var lang=el('lang').value.trim(),topic=el('topic').value.trim();\n  if(!lang||!topic){setStatus('Enter a language and a topic.');return}\n  if(needAI())return;\n  el('gen').disabled=true;setStatus('Writing a '+lang+' lesson on “'+topic+'”…');\n  var p='Create 8 useful '+lang+' phrases about: '+topic+', for an English-speaking beginner. Reply with EXACTLY these labelled lines and nothing else:\\n'+\n    'PHRASE: the phrase in '+lang+' | its simple English pronunciation | its English meaning — repeat this line for each of the 8 phrases';\n  myllmAsk(p).then(function(r){return parseLesson(r)})\n  .catch(function(){return myllmAsk(p+'\\nIMPORTANT: fill each labelled line with real content — never repeat the instruction text.')\n    .then(function(r){return parseLesson(r)})})\n  .then(function(phrases){\n    lessons.unshift({lang:lang,topic:topic,phrases:phrases});save();\n    el('topic').value='';setStatus('');cur=-1;openLesson(0);renderLessons();haptic('success');\n  }).catch(function(err){setStatus('Could not generate: '+err.message)})\n  .then(function(){el('gen').disabled=false});\n}\n\nfunction openLesson(i){\n  var les=lessons[i];if(!les){el('lessonView').style.display='none';return}\n  cur=i;\n  el('lang').value=les.lang;\n  el('lessonFlag').textContent=flagFor(les.lang);\n  el('lessonTitle').textContent=les.topic;\n  el('lessonSub').textContent=les.lang+' · '+les.phrases.length+' phrases';\n  var L=el('phrases');L.innerHTML='';\n  les.phrases.forEach(function(ph,idx){\n    var d=document.createElement('div');d.className='pcard';d.style.setProperty('--d',(Math.min(idx,12)*45)+'ms');\n    var top=document.createElement('div');top.className='pcard-top';\n    var num=document.createElement('span');num.className='pnum';num.textContent=idx+1;\n    var p=document.createElement('div');p.className='pphrase';p.textContent=ph.t;\n    top.appendChild(num);top.appendChild(p);\n    if(TTS){\n      var sp=document.createElement('button');sp.className='pspeak';sp.type='button';sp.textContent='🔊';sp.setAttribute('aria-label','Hear it');\n      sp.onclick=function(ev){ev.stopPropagation();speak(ph.t,les.lang)};\n      top.appendChild(sp);\n    }\n    var chev=document.createElement('span');chev.className='pchev';chev.textContent='⌄';top.appendChild(chev);\n    var rev=document.createElement('div');rev.className='preveal';\n    rev.innerHTML=(ph.p?'<div class=\"ppron\">['+esc(ph.p)+']</div>':'')+'<div class=\"pmean\">'+esc(ph.n)+'</div>';\n    d.appendChild(top);d.appendChild(rev);\n    d.onclick=function(){d.classList.toggle('open');haptic('light')};\n    L.appendChild(d);\n  });\n  el('lessonView').style.display='block';\n  el('feedback').style.display='none';el('feedback').innerHTML='';el('attempt').value='';\n  updateViews();\n}\n\nfunction coach(){\n  var lang=el('lang').value.trim(),attempt=el('attempt').value.trim();\n  if(!lang||!attempt){setStatus('Write a sentence first.');return}\n  if(needAI())return;\n  el('chk').disabled=true;setStatus('Coach is reading…');\n  myllmAsk('I am an English speaker learning '+lang+'. Check my '+lang+' sentence. In under 60 words: if it has mistakes, give the corrected sentence and briefly say why; if it is right, say so and give one short tip. My sentence: '+attempt)\n  .then(function(reply){\n    var f=el('feedback');f.innerHTML='<div class=\"fb-label\">✓ Coach</div><div class=\"fb-body\">'+esc(reply)+'</div>';\n    f.style.display='block';setStatus('');haptic('success');\n  }).catch(function(err){setStatus('Coach unavailable: '+err.message)})\n  .then(function(){el('chk').disabled=false});\n}\n\nfunction renderLessons(){\n  var D=el('lessons');D.innerHTML='';\n  lessons.forEach(function(les,i){\n    var r=document.createElement('div');r.className='deck'+(i===cur?' on':'');\n    var fl=document.createElement('span');fl.className='deck-flag';fl.textContent=flagFor(les.lang);\n    var mid=document.createElement('div');mid.className='deck-mid';\n    var t=document.createElement('div');t.className='deck-t';t.textContent=les.topic;\n    var s=document.createElement('div');s.className='deck-s';s.textContent=les.lang+' · '+les.phrases.length+' phrases';\n    mid.appendChild(t);mid.appendChild(s);\n    var x=document.createElement('button');x.className='del';x.type='button';x.textContent='✕';x.setAttribute('aria-label','Delete lesson');\n    x.onclick=function(ev){\n      ev.stopPropagation();\n      lessons.splice(i,1);\n      if(cur===i)cur=-1;else if(cur>i)cur--;\n      save();\n      if(lessons.length){openLesson(cur<0?0:cur)}else{cur=-1;el('lessonView').style.display='none'}\n      renderLessons();updateViews();haptic('warning');\n    };\n    r.appendChild(fl);r.appendChild(mid);r.appendChild(x);\n    r.onclick=function(){openLesson(i);renderLessons();window.scrollTo({top:0,behavior:'smooth'})};\n    D.appendChild(r);\n  });\n  updateViews();\n}\n\nfunction updateViews(){\n  el('empty').style.display=lessons.length?'none':'block';\n  el('savedWrap').style.display=lessons.length?'block':'none';\n  if(!lessons.length)el('lessonView').style.display='none';\n}\n\nel('topic').addEventListener('keydown',function(e){if(e.key==='Enter')gen()});\nel('attempt').addEventListener('keydown',function(e){if(e.key==='Enter')coach()});\n\nbuildChips();\nstore.getItem('lessons').then(function(v){\n  if(v)try{lessons=JSON.parse(v)||[]}catch(e){}\n  renderLessons();\n  if(lessons.length)openLesson(0);else updateViews();\n  if(!window.myllmAsk)setStatus('Heads-up: this app needs the latest MyLLM with apps-AI enabled.');\n});\n</script></body></html>\n", "kind": "html", "iconSymbol": "globe", "iconColor": "cyan"}