{"name": "Language Lab", "html": "<!doctype html>\n<!--\n  Language Lab — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Language Lab</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"c4dd53474e\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); --h:192; }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:760px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.96); }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 28%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:20px 2px 10px; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  label{ display:block; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:14px 2px 7px; }\n  label:first-child{ margin-top:0; }\n  input{ width:100%; font:inherit; font-size:16px; padding:12px; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; }\n  input:focus{ border-color:var(--acc); }\n  .chips{ display:flex; gap:7px; overflow-x:auto; -webkit-overflow-scrolling:touch; scrollbar-width:none; margin:9px -14px 0; padding:0 14px 2px; }\n  .chips::-webkit-scrollbar{ display:none; }\n  .chip{ flex:0 0 auto; min-height:36px; border:1px solid var(--line); background:var(--bg); border-radius:99px; padding:0 14px; font-size:13.5px; font-weight:650; white-space:nowrap; }\n  .chip.hot{ background:var(--acc); border-color:var(--acc); color:#fff; }\n  .go{ width:100%; min-height:50px; margin-top:16px; border:none; border-radius:14px; background:var(--acc); color:#fff; font-size:16px; font-weight:700;\n    display:flex; align-items:center; justify-content:center; gap:8px; }\n  .go.soft{ background:var(--fill); color:var(--acc); margin-top:12px; }\n  .go:disabled{ opacity:.55; }\n  .status{ font-size:13px; color:var(--muted); min-height:18px; margin-top:10px; text-align:center; }\n  .status.err{ color:#ff453a; }\n  .spin{ width:16px; height:16px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n\n  /* the open lesson */\n  .hero{ border-radius:20px; padding:16px 18px; color:#fff; margin:4px 0 12px; display:flex; align-items:center; gap:14px;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 44%), hsl(calc(var(--h) + 40) 58% 24%)); box-shadow:0 10px 28px hsl(var(--h) 60% 28% / .25); }\n  .hero .flag{ width:52px; height:52px; border-radius:16px; background:rgba(255,255,255,.18); border:1px solid rgba(255,255,255,.22);\n    display:flex; align-items:center; justify-content:center; font-size:28px; flex-shrink:0; }\n  .hero .k{ font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.78; }\n  .hero b{ display:block; font-size:19px; font-weight:800; line-height:1.2; letter-spacing:-.01em; margin-top:2px; overflow-wrap:anywhere; }\n\n  .pcard{ background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:12px 12px 12px 14px; margin-bottom:8px; cursor:pointer; transition:border-color .2s; }\n  .pcard.open{ border-color:hsl(var(--h) 60% 50%); }\n  .ptop{ display:flex; align-items:center; gap:11px; }\n  .pnum{ flex-shrink:0; width:26px; height:26px; border-radius:8px; background:hsl(var(--h) 70% 50% / .14); color:hsl(var(--h) 70% 40%);\n    font-size:12.5px; font-weight:800; display:flex; align-items:center; justify-content:center; font-variant-numeric:tabular-nums; }\n  @media (prefers-color-scheme:dark){ .pnum{ color:hsl(var(--h) 80% 68%); } }\n  .pphrase{ flex:1; min-width:0; font-size:17px; font-weight:650; line-height:1.3; overflow-wrap:anywhere; }\n  .speak{ flex-shrink:0; width:44px; height:44px; border:none; border-radius:12px; background:var(--fill); color:hsl(var(--h) 70% 40%);\n    display:flex; align-items:center; justify-content:center; font-size:17px; }\n  @media (prefers-color-scheme:dark){ .speak{ color:hsl(var(--h) 80% 68%); } }\n  .speak.on{ background:hsl(var(--h) 65% 45%); color:#fff; }\n  .speak.on svg{ animation:pulse 1s ease-in-out infinite; }\n  @keyframes pulse{ 50%{ opacity:.45; } }\n  .chev{ flex-shrink:0; color:var(--muted); font-size:15px; display:flex; transition:transform .25s; }\n  .pcard.open .chev{ transform:rotate(180deg); }\n  .preveal{ max-height:0; overflow:hidden; opacity:0; transition:max-height .3s ease, opacity .25s ease, margin .3s; padding-left:37px; }\n  .pcard.open .preveal{ max-height:260px; opacity:1; margin-top:8px; }\n  .ppron{ font-size:14px; font-style:italic; color:var(--muted); }\n  .ptext{ flex:1; min-width:0; }\n  .ppy{ font-size:15px; font-weight:550; color:hsl(var(--h) 70% 36%); margin-top:2px; letter-spacing:.01em; overflow-wrap:anywhere; }\n  @media (prefers-color-scheme:dark){ .ppy{ color:hsl(var(--h) 80% 70%); } }\n  .pyfix{ display:flex; align-items:center; gap:10px; border-radius:14px; padding:10px 12px; margin:0 0 12px; background:var(--fill); font-size:13.5px; line-height:1.4; }\n  .pyfix span{ flex:1; }\n  .pyfix button{ flex-shrink:0; min-height:36px; border:none; border-radius:10px; padding:0 12px; background:var(--acc); color:#fff; font-size:13.5px; font-weight:700; display:flex; align-items:center; gap:6px; }\n  .pyfix button:disabled{ opacity:.6; }\n  .pmean{ font-size:15px; margin-top:3px; line-height:1.5; }\n  .hint{ font-size:12px; color:var(--muted); text-align:center; margin:4px 0 12px; }\n  .notice{ display:flex; gap:10px; align-items:flex-start; font-size:13.5px; line-height:1.45; border-radius:14px; padding:11px 12px; margin:0 0 12px;\n    background:rgba(255,159,10,.12); color:var(--ink); }\n  .notice svg{ color:#ff9f0a; margin-top:1px; }\n\n  .skel{ height:58px; border-radius:16px; margin-bottom:8px; background:var(--fill); animation:shimmer 1.4s ease-in-out infinite; }\n  @keyframes shimmer{ 50%{ opacity:.45; } }\n\n  .coach-head{ display:flex; align-items:center; gap:11px; margin-bottom:12px; }\n  .coach-head .tile{ width:36px; height:36px; border-radius:10px; font-size:15px; }\n  .coach-head b{ display:block; font-size:16px; font-weight:750; }\n  .coach-head span{ display:block; font-size:12.5px; color:var(--muted); margin-top:1px; }\n  .feedback{ margin-top:12px; border-radius:14px; padding:12px 13px; background:hsl(var(--h) 70% 50% / .1); }\n  .feedback .k{ display:flex; align-items:center; gap:6px; font-size:11.5px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; color:hsl(var(--h) 70% 38%); margin-bottom:5px; }\n  @media (prefers-color-scheme:dark){ .feedback .k{ color:hsl(var(--h) 80% 68%); } }\n  .feedback .b{ font-size:14.5px; line-height:1.55; white-space:pre-wrap; }\n\n  .row{ display:flex; align-items:center; gap:11px; padding:9px 0; border-bottom:1px solid var(--line); cursor:pointer; }\n  .row:first-child{ padding-top:0; } .row:last-child{ border-bottom:none; padding-bottom:0; }\n  .row .flag{ width:36px; height:36px; border-radius:10px; background:var(--fill); display:flex; align-items:center; justify-content:center; font-size:20px; flex-shrink:0; }\n  .row.on .flag{ box-shadow:0 0 0 2px hsl(var(--h) 60% 50%); }\n  .row .mid{ flex:1; min-width:0; }\n  .row .t{ font-size:15px; font-weight:650; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .row .s{ font-size:12.5px; color:var(--muted); margin-top:1px; }\n  .row .pill{ font-size:10.5px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; color:#fff; background:hsl(var(--h) 60% 45%); border-radius:99px; padding:3px 8px; flex-shrink:0; }\n  .row .del{ width:44px; height:44px; margin-right:-8px; border:none; background:none; color:var(--muted); font-size:14px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }\n\n  .empty{ text-align:center; padding:26px 20px 14px; }\n  .empty .tile{ width:48px; height:48px; border-radius:14px; font-size:21px; margin:0 auto 10px; opacity:.9; }\n  .empty b{ display:block; font-size:16px; font-weight:750; }\n  .empty p{ font-size:13.5px; color:var(--muted); line-height:1.5; max-width:280px; margin:5px auto 0; }\n\n  [hidden]{ display:none !important; }\n  @media (prefers-reduced-motion:no-preference){\n    .pcard{ animation:rise .35s cubic-bezier(.2,.8,.2,1) backwards; animation-delay:var(--d,0ms); }\n    @keyframes rise{ from{ opacity:0; transform:translateY(8px); } to{ opacity:1; transform:none; } }\n  }\n  @media (prefers-reduced-motion:reduce){ .spin{ animation-duration:2.4s; } .skel, .speak.on svg{ animation:none; } button:active{ transform:none; } }\n\n  @keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n  .myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n  .myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n  .myllm-ai-cog{width:16px;height:16px;border-radius:50%;border:2.4px solid #a78bfa;border-right-color:transparent;animation:myllmAiSpin .9s linear infinite;flex-shrink:0}\n  .myllm-ai-busy small{font-weight:400;opacity:.6}\n\n/* myllm-fullscreen-v1 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-globe\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5a9.5 9.5 0 1 0 0 19 9.5 9.5 0 0 0 0-19zm6.9 8.5h-3.1a15.4 15.4 0 0 0-1.4-5.9A7.5 7.5 0 0 1 18.9 11zM12 4.6c.8 1 1.9 3.2 2.1 6.4H9.9C10.1 7.8 11.2 5.6 12 4.6zM9.6 5.1A15.4 15.4 0 0 0 8.2 11H5.1a7.5 7.5 0 0 1 4.5-5.9zM5.1 13h3.1c.1 2.2.6 4.2 1.4 5.9A7.5 7.5 0 0 1 5.1 13zm6.9 6.4c-.8-1-1.9-3.2-2.1-6.4h4.2c-.2 3.2-1.3 5.4-2.1 6.4zm2.4-.5c.8-1.7 1.3-3.7 1.4-5.9h3.1a7.5 7.5 0 0 1-4.5 5.9z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-spark\" viewBox=\"0 0 24 24\"><path d=\"M10 2.5l1.9 5.6 5.6 1.9-5.6 1.9L10 17.5l-1.9-5.6L2.5 10l5.6-1.9zM18.5 14l.95 2.55L22 17.5l-2.55.95L18.5 21l-.95-2.55L15 17.5l2.55-.95z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-speaker\" viewBox=\"0 0 24 24\"><path d=\"M11 4.6a.9.9 0 0 1 1.5.7v13.4a.9.9 0 0 1-1.5.7L6.6 15.6H4a1 1 0 0 1-1-1V9.4a1 1 0 0 1 1-1h2.6z\" fill=\"currentColor\"/><path d=\"M15.6 8.6a4.6 4.6 0 0 1 0 6.8M18.4 5.9a8.6 8.6 0 0 1 0 12.2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-chev\" viewBox=\"0 0 24 24\"><path d=\"M6 9.5l6 6 6-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-pen\" viewBox=\"0 0 24 24\"><path d=\"M15.2 4.3a2.2 2.2 0 0 1 3.1 0l1.4 1.4a2.2 2.2 0 0 1 0 3.1L9.4 19.1 4 20l.9-5.4z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M5 12.6l4.6 4.6L19.2 7.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-book\" viewBox=\"0 0 24 24\"><path d=\"M4 5.5A2.5 2.5 0 0 1 6.5 3H19a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H6.5a.5.5 0 0 0 0 1H19a1 1 0 0 1 0 2H6.5A2.5 2.5 0 0 1 4 18.5z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-warn\" viewBox=\"0 0 24 24\"><path d=\"M10.3 3.9a2 2 0 0 1 3.4 0l8 13.6a2 2 0 0 1-1.7 3H4a2 2 0 0 1-1.7-3zM12 9a1 1 0 0 0-1 1v4a1 1 0 0 0 2 0v-4a1 1 0 0 0-1-1zm0 7.2a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z\" fill=\"currentColor\"/></symbol>\n</defs></svg>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\"></span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-globe\"/></svg></div>\n  <div><h1>Language Lab</h1><p>Learn any language, one bite-size lesson at a time</p></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Language Lab\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n\n<div class=\"card\">\n  <label for=\"lang\">Language</label>\n  <input id=\"lang\" placeholder=\"e.g. Spanish, Japanese\" autocomplete=\"off\" enterkeyhint=\"next\">\n  <div class=\"chips\" id=\"langChips\"></div>\n  <label for=\"topic\">Topic</label>\n  <input id=\"topic\" placeholder=\"e.g. ordering food\" autocomplete=\"off\" enterkeyhint=\"go\">\n  <button class=\"go\" id=\"gen\" type=\"button\"></button>\n  <div id=\"status\" class=\"status\"></div>\n</div>\n\n<div class=\"card empty\" id=\"empty\" hidden>\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-book\"/></svg></div>\n  <b>Your lessons live here</b>\n  <p>Pick a language and a topic above, and your AI tutor writes a lesson in seconds.</p>\n</div>\n\n<div id=\"skeleton\" hidden><div class=\"skel\"></div><div class=\"skel\"></div><div class=\"skel\"></div><div class=\"skel\"></div></div>\n\n<div id=\"lessonView\" hidden>\n  <div class=\"hero\">\n    <div class=\"flag\" id=\"lessonFlag\"></div>\n    <div style=\"min-width:0\"><div class=\"k\" id=\"lessonSub\"></div><b id=\"lessonTitle\"></b></div>\n  </div>\n  <div class=\"notice\" id=\"voiceNote\" hidden><svg class=\"i\"><use href=\"#i-warn\"/></svg><span id=\"voiceNoteText\"></span></div>\n  <div class=\"pyfix\" id=\"pyFix\" hidden><span>This lesson spells sounds out in English letters.</span><button type=\"button\" id=\"pyBtn\">Add Pinyin</button></div>\n  <div id=\"phrases\"></div>\n  <div class=\"hint\" id=\"tapHint\">Tap a card to reveal the meaning</div>\n  <div class=\"card\">\n    <div class=\"coach-head\"><div class=\"tile\"><svg class=\"i\"><use href=\"#i-pen\"/></svg></div>\n      <div><b>Practice</b><span>Write a sentence — get instant, friendly feedback</span></div></div>\n    <input id=\"attempt\" placeholder=\"Your sentence…\" autocomplete=\"off\" enterkeyhint=\"send\">\n    <button class=\"go soft\" id=\"chk\" type=\"button\">Check my sentence</button>\n    <div class=\"feedback\" id=\"feedback\" hidden></div>\n  </div>\n</div>\n\n<div id=\"savedWrap\" hidden>\n  <h2>Saved lessons</h2>\n  <div class=\"card\" id=\"lessons\"></div>\n</div>\n\n<script>\n\"use strict\";\nfunction el(i){return document.getElementById(i)}\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction store(){return window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}}}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nfunction icon(n){return '<svg class=\"i\"><use href=\"#i-'+n+'\"/></svg>'}\nvar lessons=[],cur=-1;\nfunction setStatus(t,err){var s=el('status');s.textContent=t;s.classList.toggle('err',!!err)}\nfunction save(){store().setItem('lessons',JSON.stringify(lessons))}\nfunction esc(s){return String(s).replace(/[&<>\"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]})}\n\nvar FLAGS={spanish:'🇪🇸',french:'🇫🇷',japanese:'🇯🇵',german:'🇩🇪',italian:'🇮🇹',portuguese:'🇵🇹',mandarin:'🇨🇳',chinese:'🇨🇳',korean:'🇰🇷',russian:'🇷🇺',arabic:'🇸🇦',hindi:'🇮🇳',dutch:'🇳🇱',greek:'🇬🇷',turkish:'🇹🇷',polish:'🇵🇱',swedish:'🇸🇪',english:'🇬🇧',thai:'🇹🇭',vietnamese:'🇻🇳',hebrew:'🇮🇱',indonesian:'🇮🇩'};\nvar CODES={spanish:'es-ES',french:'fr-FR',japanese:'ja-JP',german:'de-DE',italian:'it-IT',portuguese:'pt-PT',mandarin:'zh-CN',chinese:'zh-CN',cantonese:'zh-HK',korean:'ko-KR',russian:'ru-RU',arabic:'ar-SA',hindi:'hi-IN',dutch:'nl-NL',greek:'el-GR',turkish:'tr-TR',polish:'pl-PL',swedish:'sv-SE',norwegian:'nb-NO',danish:'da-DK',finnish:'fi-FI',czech:'cs-CZ',hungarian:'hu-HU',romanian:'ro-RO',ukrainian:'uk-UA',catalan:'ca-ES',english:'en-GB',thai:'th-TH',vietnamese:'vi-VN',hebrew:'he-IL',indonesian:'id-ID',malay:'ms-MY'};\n/* \"Spanish\", \"spanish (Mexico)\", \"Brazilian Portuguese\", \"Mandarin Chinese\":\n   the first word that names a language we know wins. */\nfunction langKey(l){\n  var words=String(l||'').toLowerCase().replace(/\\(.*?\\)/g,' ').split(/[^a-z]+/).filter(Boolean);\n  for(var i=0;i<words.length;i++)if(CODES[words[i]])return words[i];\n  return '';\n}\nfunction flagFor(l){return FLAGS[langKey(l)]||'🌐'}\nfunction codeFor(l){var k=langKey(l),c=CODES[k]||'';if(k==='portuguese'&&/brazil/i.test(l))c='pt-BR';return c}\n\n/* ---------- speech ----------\n   The web view's own speechSynthesis (MyLLM has no speak bridge). Three\n   things make it dependable on iPhone, all learned from Talk Tutor on device:\n   pick a voice for the language explicitly, only cancel when something is\n   actually speaking (cancel-then-speak in the same tick can swallow the new\n   line), and say plainly when no voice played instead of staying silent. */\nfunction canSpeak(){return !!(window.speechSynthesis&&window.SpeechSynthesisUtterance)}\nvar voiceCache={},speakToken=0,speakBtn=null;\nif(canSpeak())try{speechSynthesis.onvoiceschanged=function(){voiceCache={}}}catch(e){}\nfunction pickVoice(code){\n  if(voiceCache[code]!==undefined)return voiceCache[code];\n  var all=[];try{all=speechSynthesis.getVoices()||[]}catch(e){}\n  function norm(v){return String(v.lang||'').replace('_','-').toLowerCase()}\n  var want=code.toLowerCase(),base=want.slice(0,2);\n  var inLang=all.filter(function(v){return norm(v).slice(0,2)===base});\n  var better=function(list){return list.filter(function(v){return /enhanced|premium/i.test(v.name)})[0]||list[0]};\n  var exact=inLang.filter(function(v){return norm(v)===want});\n  voiceCache[code]=better(exact)||better(inLang)||null;\n  return voiceCache[code];\n}\nfunction markSpeaking(btn,on){\n  if(speakBtn&&speakBtn!==btn)speakBtn.classList.remove('on');\n  if(btn)btn.classList.toggle('on',on);\n  speakBtn=on?btn:null;\n}\nfunction noVoice(lang){\n  var n=el('voiceNote');\n  el('voiceNoteText').textContent='Couldn’t play '+(langKey(lang)?lang.trim():'this language')+' out loud. Check the volume, or add a voice in iPhone Settings → Accessibility → Spoken Content → Voices.';\n  n.hidden=false;\n}\nfunction speak(text,lang,btn){\n  if(!canSpeak()||!text)return;\n  var ss=window.speechSynthesis,token=++speakToken,started=false;\n  var u=new SpeechSynthesisUtterance(text),code=codeFor(lang);\n  if(code){u.lang=code;var v=pickVoice(code);if(v)u.voice=v}\n  u.rate=.9;u.volume=1;\n  u.onstart=function(){started=true;if(token===speakToken){markSpeaking(btn,true);el('voiceNote').hidden=true}};\n  u.onend=function(){if(token===speakToken)markSpeaking(btn,false)};\n  u.onerror=function(e){\n    if(token!==speakToken)return;\n    markSpeaking(btn,false);\n    var why=e&&e.error;\n    if(!started&&why!=='interrupted'&&why!=='canceled')noVoice(lang);\n  };\n  haptic('light');\n  function go(){try{if(ss.paused)ss.resume();ss.speak(u)}catch(e){noVoice(lang)}}\n  try{\n    if(ss.speaking||ss.pending){ss.cancel();setTimeout(go,80)}\n    else go();                                   /* first line stays inside the tap, which iOS requires */\n  }catch(e){noVoice(lang);return}\n  setTimeout(function(){\n    if(token===speakToken&&!started&&!ss.speaking){markSpeaking(btn,false);noVoice(lang)}\n  },2500);\n}\nfunction stopSpeaking(){speakToken++;markSpeaking(null,false);if(canSpeak())try{speechSynthesis.cancel()}catch(e){}}\n\n/* ---------- form ---------- */\nvar POPULAR=['Spanish','French','Japanese','German','Italian','Korean'];\nfunction buildChips(){\n  var c=el('langChips');c.innerHTML='';\n  var now=el('lang').value.trim().toLowerCase();\n  POPULAR.forEach(function(name){\n    var b=document.createElement('button');b.type='button';b.className='chip'+(now===name.toLowerCase()?' hot':'');\n    b.textContent=flagFor(name)+' '+name;\n    b.onclick=function(){el('lang').value=name;buildChips();el('topic').focus();haptic('selection')};\n    c.appendChild(b);\n  });\n}\nfunction genBtn(busy,text){\n  var b=el('gen');b.disabled=!!busy;\n  b.innerHTML=busy?'<i class=\"spin\"></i><span>'+esc(text)+'</span>':icon('spark')+'<span>Teach me</span>';\n}\n\nfunction needAI(){\n  if(window.myllmAsk)return false;\n  setStatus('This app needs AI access — update MyLLM and enable “Allow apps to use the AI” in Settings.',true);\n  return true;\n}\n\n/* Labelled lines, not JSON — small models (Apple Intelligence) echo JSON\n   templates back verbatim. Echoed instructions are rejected and retried. */\nvar ECHO=/the phrase in\\b|english pronunciation|english meaning|repeat this line|labelled line|pinyin with tone marks|jyutping with tone numbers|simplified chinese characters/i;\nfunction parseLesson(reply){\n  reply=String(reply||'');\n  var phrases=[],got=false;\n  reply.split(/\\r?\\n/).forEach(function(raw){\n    var ln=raw.replace(/\\*\\*/g,'').trim();\n    var m=ln.match(/^[-*#>\\s]*(PHRASES?)\\s*\\d*\\s*[::]\\s*(.*)$/i);\n    if(!m)return;\n    got=true;var v=m[2].trim();\n    if(!v||ECHO.test(v))return;\n    var parts=v.split('|').map(function(x){return x.trim()});\n    if(parts.length>=3)phrases.push({t:parts[0],p:parts[1],n:parts.slice(2).join(' | ')});\n    else if(parts.length===2)phrases.push({t:parts[0],p:'',n:parts[1]});\n  });\n  if(!got){ // some models still answer in the old JSON shape — accept it\n    var s=reply.indexOf('['),e=reply.lastIndexOf(']');\n    if(s>=0&&e>s)try{\n      var j=JSON.parse(reply.slice(s,e+1));\n      if(Array.isArray(j))phrases=j.filter(function(x){return x&&x.t&&x.n})\n        .map(function(x){return{t:String(x.t),p:x.p?String(x.p):'',n:String(x.n)}});\n    }catch(e2){}\n  }\n  phrases=phrases.filter(function(x){return x.t&&x.n&&!ECHO.test(x.t)&&!ECHO.test(x.n)});\n  if(phrases.length<2)throw new Error('the model did not return a lesson');\n  return phrases;\n}\n/* Chinese is learned with Hanyu Pinyin, not English sound-alike spellings\n   (Cantonese with Jyutping). Everything else keeps the simple English\n   pronunciation. */\nfunction romFor(lang){\n  var k=langKey(lang);\n  if(k==='cantonese')return 'jyutping';\n  if(k==='mandarin'||k==='chinese')return 'pinyin';\n  return '';\n}\n/* Models sometimes write \"ni3 hao3\"; learners read \"nǐ hǎo\". Rule: a or e\n   takes the mark; in \"ou\" the o does; otherwise the last vowel. ü may arrive\n   as v or u:. Tone 5 / 0 is neutral (no mark). */\nvar TONES={a:'āáǎàa',e:'ēéěèe',i:'īíǐìi',o:'ōóǒòo',u:'ūúǔùu','ü':'ǖǘǚǜü'};\nfunction toneMarks(py){\n  return String(py||'').replace(/([a-zü:v]+)([0-5])/gi,function(all,syl,t){\n    t=+t;syl=syl.replace(/u:|v/gi,function(m){return m[0]===m[0].toUpperCase()&&m!=='v'?'Ü':'ü'});\n    if(!t||t===5)return syl;\n    var low=syl.toLowerCase(),at=-1;\n    if(low.indexOf('a')>=0)at=low.indexOf('a');\n    else if(low.indexOf('e')>=0)at=low.indexOf('e');\n    else if(low.indexOf('ou')>=0)at=low.indexOf('o');\n    else for(var i=low.length-1;i>=0;i--)if(TONES[low[i]]){at=i;break}\n    if(at<0)return syl;\n    var ch=low[at],mark=TONES[ch].charAt(t-1);\n    if(syl[at]!==ch)mark=mark.toUpperCase();\n    return syl.slice(0,at)+mark+syl.slice(at+1);\n  });\n}\nfunction lessonPrompt(lang,topic){\n  var rom=romFor(lang),line;\n  if(rom==='pinyin')line='PHRASE: the phrase in Simplified Chinese characters | its Hanyu Pinyin with tone marks | its English meaning';\n  else if(rom==='jyutping')line='PHRASE: the phrase in Traditional Chinese characters | its Jyutping with tone numbers | its English meaning';\n  else line='PHRASE: the phrase in '+lang+' | its simple English pronunciation | its English meaning';\n  return 'Create 8 useful '+lang+' phrases about: '+topic+', for an English-speaking beginner. Reply with EXACTLY these labelled lines and nothing else:\\n'+\n    line+' — repeat this line for each of the 8 phrases';\n}\nfunction gen(){\n  var lang=el('lang').value.trim(),topic=el('topic').value.trim();\n  if(!lang||!topic){setStatus('Enter a language and a topic.',true);return}\n  if(needAI())return;\n  stopSpeaking();\n  genBtn(true,'Writing your '+lang+' lesson…');setStatus('');\n  el('skeleton').hidden=false;el('lessonView').hidden=true;el('empty').hidden=true;\n  var p=lessonPrompt(lang,topic),rom=romFor(lang);\n  myllmAsk(p).then(function(r){return parseLesson(r)})\n  .catch(function(){return myllmAsk(p+'\\nIMPORTANT: fill each labelled line with real content — never repeat the instruction text.')\n    .then(function(r){return parseLesson(r)})})\n  .then(function(phrases){\n    var les={lang:lang,topic:topic,phrases:phrases};\n    if(rom){les.rom=rom;if(rom==='pinyin')phrases.forEach(function(ph){ph.p=toneMarks(ph.p)})}\n    lessons.unshift(les);save();\n    el('topic').value='';setStatus('');cur=-1;openLesson(0);renderLessons();haptic('success');\n  }).catch(function(err){\n    setStatus('Could not generate: '+err.message,true);\n    if(cur>=0&&lessons[cur])el('lessonView').hidden=false;\n  })\n  .then(function(){el('skeleton').hidden=true;genBtn(false);updateViews()});\n}\n\nfunction openLesson(i){\n  var les=lessons[i];if(!les){el('lessonView').hidden=true;return}\n  stopSpeaking();\n  cur=i;\n  el('lang').value=les.lang;buildChips();\n  el('lessonFlag').textContent=flagFor(les.lang);\n  el('lessonTitle').textContent=les.topic;\n  el('lessonSub').textContent=les.lang+' · '+les.phrases.length+' phrases';\n  el('voiceNote').hidden=true;\n  var want=romFor(les.lang);\n  el('pyFix').hidden=!(want&&les.rom!==want);\n  if(want==='jyutping'){el('pyBtn').textContent='Add Jyutping'}else{el('pyBtn').textContent='Add Pinyin'}\n  el('pyBtn').disabled=false;\n  var L=el('phrases');L.innerHTML='';\n  var talk=canSpeak();\n  les.phrases.forEach(function(ph,idx){\n    var d=document.createElement('div');d.className='pcard';d.style.setProperty('--d',(Math.min(idx,12)*40)+'ms');\n    var top=document.createElement('div');top.className='ptop';\n    var num=document.createElement('span');num.className='pnum';num.textContent=idx+1;\n    var tx=document.createElement('div');tx.className='ptext';\n    var p=document.createElement('div');p.className='pphrase';p.textContent=ph.t;tx.appendChild(p);\n    var rom=les.rom&&ph.p;\n    if(rom){var py=document.createElement('div');py.className='ppy';py.textContent=ph.p;py.lang='zh-Latn';tx.appendChild(py)}\n    top.appendChild(num);top.appendChild(tx);\n    if(talk){\n      var sp=document.createElement('button');sp.className='speak';sp.type='button';sp.innerHTML=icon('speaker');sp.setAttribute('aria-label','Hear it');\n      sp.onclick=function(ev){ev.stopPropagation();speak(ph.t,les.lang,sp)};\n      top.appendChild(sp);\n    }\n    var chev=document.createElement('span');chev.className='chev';chev.innerHTML=icon('chev');top.appendChild(chev);\n    var rev=document.createElement('div');rev.className='preveal';\n    rev.innerHTML=(ph.p&&!rom?'<div class=\"ppron\">['+esc(ph.p)+']</div>':'')+'<div class=\"pmean\">'+esc(ph.n)+'</div>';\n    d.appendChild(top);d.appendChild(rev);\n    d.onclick=function(){d.classList.toggle('open');haptic('light')};\n    L.appendChild(d);\n  });\n  el('lessonView').hidden=false;\n  el('feedback').hidden=true;el('feedback').innerHTML='';el('attempt').value='';\n  updateViews();\n}\n\n/* Lessons saved before Pinyin: ask the model for just the romanisation of\n   each phrase, numbered so the answers line up, and keep the rest. */\nfunction addRomanisation(){\n  var les=lessons[cur];if(!les)return;\n  var rom=romFor(les.lang);if(!rom)return;\n  if(needAI())return;\n  var btn=el('pyBtn'),label=rom==='pinyin'?'Pinyin':'Jyutping';\n  btn.disabled=true;btn.innerHTML='<i class=\"spin\"></i>Adding…';\n  var ask='Write the '+(rom==='pinyin'?'Hanyu Pinyin with tone marks':'Jyutping with tone numbers')+' for each Chinese phrase below. Reply with EXACTLY one line per phrase in the form \"N: romanisation\" and nothing else.\\n'+\n    les.phrases.map(function(ph,i){return (i+1)+': '+ph.t}).join('\\n');\n  myllmAsk(ask).then(function(reply){\n    var got={},n=0;\n    String(reply||'').split(/\\r?\\n/).forEach(function(ln){\n      var m=ln.replace(/\\*\\*/g,'').match(/^\\s*(\\d+)\\s*[.:)：]\\s*(.+)$/);\n      if(!m)return;var v=m[2].trim().replace(/^\\[|\\]$/g,'');\n      if(!v||/[㐀-鿿]/.test(v)||ECHO.test(v))return;      /* characters back = not a romanisation */\n      got[+m[1]-1]=rom==='pinyin'?toneMarks(v):v;\n    });\n    les.phrases.forEach(function(ph,i){if(got[i]){ph.p=got[i];n++}});\n    if(n<Math.ceil(les.phrases.length/2))throw new Error('the model did not return '+label);\n    les.rom=rom;save();openLesson(cur);haptic('success');\n  }).catch(function(err){\n    btn.disabled=false;btn.textContent='Add '+label;\n    setStatus('Could not add '+label+': '+err.message,true);\n  });\n}\nel('pyBtn').onclick=addRomanisation;\n\nfunction coach(){\n  var lang=el('lang').value.trim(),attempt=el('attempt').value.trim();\n  if(!lang||!attempt){setStatus('Write a sentence first.',true);return}\n  if(needAI())return;\n  var b=el('chk');b.disabled=true;b.innerHTML='<i class=\"spin\"></i><span>Coach is reading…</span>';setStatus('');\n  myllmAsk('I am an English speaker learning '+lang+'. Check my '+lang+' sentence. In under 60 words: if it has mistakes, give the corrected sentence and briefly say why; if it is right, say so and give one short tip. My sentence: '+attempt)\n  .then(function(reply){\n    var f=el('feedback');f.innerHTML='<div class=\"k\">'+icon('check')+'Coach</div><div class=\"b\">'+esc(reply)+'</div>';\n    f.hidden=false;haptic('success');\n  }).catch(function(err){setStatus('Coach unavailable: '+err.message,true)})\n  .then(function(){b.disabled=false;b.textContent='Check my sentence'});\n}\n\nfunction renderLessons(){\n  var D=el('lessons');D.innerHTML='';\n  lessons.forEach(function(les,i){\n    var r=document.createElement('div');r.className='row'+(i===cur?' on':'');\n    var fl=document.createElement('span');fl.className='flag';fl.textContent=flagFor(les.lang);\n    var mid=document.createElement('div');mid.className='mid';\n    var t=document.createElement('div');t.className='t';t.textContent=les.topic;\n    var s=document.createElement('div');s.className='s';s.textContent=les.lang+' · '+les.phrases.length+' phrases';\n    mid.appendChild(t);mid.appendChild(s);\n    r.appendChild(fl);r.appendChild(mid);\n    if(i===cur){var pill=document.createElement('span');pill.className='pill';pill.textContent='Open';r.appendChild(pill)}\n    var x=document.createElement('button');x.className='del';x.type='button';x.innerHTML=icon('x');x.setAttribute('aria-label','Delete lesson');\n    x.onclick=function(ev){\n      ev.stopPropagation();\n      lessons.splice(i,1);\n      if(cur===i)cur=-1;else if(cur>i)cur--;\n      save();\n      if(lessons.length){openLesson(cur<0?0:cur)}else{cur=-1;el('lessonView').hidden=true;stopSpeaking()}\n      renderLessons();updateViews();haptic('warning');\n    };\n    r.appendChild(x);\n    r.onclick=function(){openLesson(i);renderLessons();window.scrollTo({top:0,behavior:'smooth'})};\n    D.appendChild(r);\n  });\n  updateViews();\n}\n\nfunction updateViews(){\n  var busy=!el('skeleton').hidden;\n  el('empty').hidden=!!lessons.length||busy;\n  el('savedWrap').hidden=!lessons.length;\n  if(!lessons.length)el('lessonView').hidden=true;\n}\n\nel('gen').onclick=gen;\nel('chk').onclick=coach;\nel('lang').addEventListener('input',buildChips);\nel('lang').addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();el('topic').focus()}});\nel('topic').addEventListener('keydown',function(e){if(e.key==='Enter')gen()});\nel('attempt').addEventListener('keydown',function(e){if(e.key==='Enter')coach()});\ndocument.addEventListener('visibilitychange',function(){if(document.hidden)stopSpeaking()});\n\ngenBtn(false);buildChips();\nstore().getItem('lessons').then(function(v){\n  if(v)try{lessons=JSON.parse(v)||[]}catch(e){}\n  renderLessons();\n  if(lessons.length)openLesson(0);else updateViews();\n  if(!window.myllmAsk)setStatus('Heads-up: this app needs the latest MyLLM with apps-AI enabled.');\n});\n\n/* myllm-fullscreen-v1 — full screen where MyLLM can also close the app for us (myllmClose,\n   5.6.2+): full screen hides MyLLM's Done, and a page with no way out is\n   worse than a repeated title, so elsewhere nothing changes. The spacer keeps\n   the header clear of the status bar only if the page doesn't already. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  function inset(){\n    var p = document.createElement(\"div\");\n    p.style.cssText = \"position:fixed;top:0;left:0;width:1px;visibility:hidden;height:env(safe-area-inset-top)\";\n    document.body.appendChild(p); var h = p.offsetHeight; p.parentNode.removeChild(p); return h;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = \"0px\";\n    if (!document.body.classList.contains(\"imm\")) return;\n    var need = inset() + 6 - (head.getBoundingClientRect().top + window.scrollY);\n    sp.style.height = Math.max(0, Math.round(need)) + \"px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  window.addEventListener(\"resize\", fit);\n  sync();\n})();\n</script></body></html>\n", "kind": "html", "iconSymbol": "globe", "iconColor": "cyan"}