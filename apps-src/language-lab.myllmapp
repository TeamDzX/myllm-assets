{"name": "Language Lab", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>:root{color-scheme:light dark}\nbody{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:20px;background:#f2f2f7;color:#111}\n@media(prefers-color-scheme:dark){body{background:#000;color:#eee}.card,.deck{background:#1c1c1e}input{background:#2c2c2e;color:#eee;border-color:#3a3a3c}}\nh1{font-size:22px;margin:0 0 14px}\nh2{font-size:15px;margin:22px 0 8px;opacity:.7}\n.row{display:flex;gap:8px;margin-bottom:8px}\ninput{flex:1;padding:12px;border:1px solid #d1d1d6;border-radius:10px;font-size:16px;background:#fff;min-width:0}\nbutton{border:0;background:#32ade6;color:#fff;border-radius:10px;padding:0 16px;font-size:15px;font-weight:600}\nbutton:disabled{opacity:.5}\n#status{font-size:13px;opacity:.65;min-height:18px;margin:2px 0 6px}\n.card{background:#fff;border-radius:12px;padding:13px 14px;margin-bottom:8px;box-shadow:0 1px 2px rgba(0,0,0,.06)}\n.card .t{font-size:17px;font-weight:600}\n.card .hidden-part{display:none;margin-top:6px;font-size:14px;line-height:1.5}\n.card.open .hidden-part{display:block}\n.card .p{opacity:.6;font-style:italic}\n.card .hint{font-size:11px;opacity:.35;margin-top:4px}\n.card.open .hint{display:none}\n#feedback{display:none;font-size:14px;line-height:1.55;white-space:pre-wrap}\n.deck{background:#fff;border-radius:12px;padding:11px 14px;margin-bottom:8px;display:flex;align-items:center;gap:10px}\n.deck span{flex:1;font-size:15px}\n.deck .n{opacity:.5;font-size:13px}\n.deck .del{background:none;color:#ff453a;font-size:16px;padding:4px}\n@media(min-width:768px){body{max-width:760px;margin-left:auto;margin-right:auto}}\n</style></head><body>\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-family:-apple-system,system-ui,sans-serif;font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;line-height:1;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n<script>\n(function(){\n  if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;\n  window.__myllmAiWrap=true;\n  var orig=window.myllmAsk,depth=0,node=null;\n  function ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\n    node.innerHTML='<span class=\"myllm-ai-cog\">\\u2699\\uFE0F</span><span>AI is thinking\\u2026 <small>privately, on your device</small></span>';\n    (document.body||document.documentElement).appendChild(node);}\n  function show(){ensure();depth++;node.classList.add('on');}\n  function hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\n  window.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\n    return Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};\n})();\n</script>\n\n<h1>🌍 Language Lab</h1>\n<div class=\"row\"><input id=\"lang\" placeholder=\"Language (e.g. Spanish, Japanese)…\"></div>\n<div class=\"row\"><input id=\"topic\" placeholder=\"Topic (e.g. ordering food)…\"><button id=\"gen\" onclick=\"gen()\">Teach me</button></div>\n<div id=\"status\"></div>\n<div id=\"phrases\"></div>\n<div id=\"coachWrap\" style=\"display:none\">\n<h2>Coach — try writing a sentence</h2>\n<div class=\"row\"><input id=\"attempt\" placeholder=\"Your sentence…\"><button id=\"chk\" onclick=\"coach()\">Check</button></div>\n<div class=\"card\" id=\"feedback\"></div>\n</div>\n<h2 id=\"lessonsHead\" style=\"display:none\">Saved lessons</h2>\n<div id=\"lessons\"></div>\n<script>\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar lessons=[],cur=-1;\nfunction el(i){return document.getElementById(i)}\nfunction setStatus(t){el('status').textContent=t}\nfunction save(){store.setItem('lessons',JSON.stringify(lessons))}\nfunction needAI(){\nif(window.myllmAsk)return false;\nsetStatus('This app needs AI access — update MyLLM and enable “Allow apps to use the AI” in Settings.');\nreturn true;\n}\nfunction gen(){\nvar lang=el('lang').value.trim(),topic=el('topic').value.trim();\nif(!lang||!topic){setStatus('Enter a language and a topic.');return}\nif(needAI())return;\nel('gen').disabled=true;setStatus('Writing a '+lang+' lesson on “'+topic+'”…');\nmyllmAsk('Create 8 useful '+lang+' phrases about: '+topic+', for an English-speaking beginner. Reply with ONLY a JSON array like [{\"t\":\"phrase in '+lang+'\",\"p\":\"simple English pronunciation\",\"n\":\"English meaning\"}] and nothing else.')\n.then(function(reply){\nvar s=reply.indexOf('['),e=reply.lastIndexOf(']');\nif(s<0||e<=s)throw new Error('the model did not return a lesson');\nvar phrases=JSON.parse(reply.slice(s,e+1)).filter(function(x){return x&&x.t&&x.n});\nif(!phrases.length)throw new Error('the lesson came back empty');\nlessons.unshift({lang:lang,topic:topic,phrases:phrases});save();\nel('topic').value='';setStatus('');openLesson(0);renderLessons();\n}).catch(function(err){setStatus('Could not generate: '+err.message)})\n.then(function(){el('gen').disabled=false});\n}\nfunction openLesson(i){\ncur=i;var L=el('phrases');L.innerHTML='';\nvar les=lessons[i];if(!les){el('coachWrap').style.display='none';return}\nel('lang').value=les.lang;\nles.phrases.forEach(function(ph){\nvar d=document.createElement('div');d.className='card';\nvar t=document.createElement('div');t.className='t';t.textContent=ph.t;\nvar h=document.createElement('div');h.className='hidden-part';\nh.textContent=(ph.p?'['+ph.p+']  ':'')+ph.n;\nvar hint=document.createElement('div');hint.className='hint';hint.textContent='tap to reveal';\nd.appendChild(t);d.appendChild(h);d.appendChild(hint);\nd.onclick=function(){d.classList.toggle('open');if(window.myllmHaptic)myllmHaptic('light')};\nL.appendChild(d)});\nel('coachWrap').style.display='block';\nel('feedback').style.display='none';\n}\nfunction coach(){\nvar lang=el('lang').value.trim(),attempt=el('attempt').value.trim();\nif(!lang||!attempt){setStatus('Write a sentence first.');return}\nif(needAI())return;\nel('chk').disabled=true;setStatus('Coach is reading…');\nmyllmAsk('I am an English speaker learning '+lang+'. Check my '+lang+' sentence. In under 60 words: if it has mistakes, give the corrected sentence and briefly say why; if it is right, say so and give one short tip. My sentence: '+attempt)\n.then(function(reply){\nvar f=el('feedback');f.textContent=reply;f.style.display='block';setStatus('');\nif(window.myllmHaptic)myllmHaptic('success');\n}).catch(function(err){setStatus('Coach unavailable: '+err.message)})\n.then(function(){el('chk').disabled=false});\n}\nfunction renderLessons(){\nvar D=el('lessons');D.innerHTML='';\nel('lessonsHead').style.display=lessons.length?'block':'none';\nlessons.forEach(function(les,i){\nvar r=document.createElement('div');r.className='deck';\nvar s=document.createElement('span');s.textContent=les.lang+' · '+les.topic;s.onclick=function(){openLesson(i)};\nvar n=document.createElement('span');n.className='n';n.textContent=les.phrases.length+' phrases';\nvar x=document.createElement('button');x.className='del';x.textContent='✕';\nx.onclick=function(){lessons.splice(i,1);if(cur===i)cur=-1;else if(cur>i)cur--;save();renderLessons();openLesson(cur)};\nr.appendChild(s);r.appendChild(n);r.appendChild(x);D.appendChild(r)})}\nel('topic').addEventListener('keydown',function(e){if(e.key==='Enter')gen()});\nel('attempt').addEventListener('keydown',function(e){if(e.key==='Enter')coach()});\nstore.getItem('lessons').then(function(v){\nif(v)try{lessons=JSON.parse(v)}catch(e){}\nrenderLessons();if(lessons.length)openLesson(0);\nif(!window.myllmAsk)setStatus('Heads-up: this app needs the latest MyLLM with apps-AI enabled.');\n});\n</script></body></html>", "kind": "html", "iconSymbol": "globe", "iconColor": "cyan"}