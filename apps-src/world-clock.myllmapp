{"name": "World Clock", "html": "<!doctype html>\n<!--\n  World Clock — MyLLMos App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>World Clock</title>\n<style>\n:root{--build-id:\"d506381356\";\n  color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7);--surface:var(--myllm-surface,#fff);\n  --text:var(--myllm-text,#111);--muted:var(--myllm-muted,#6b6b72);\n  --accent:var(--myllm-accent,#0b5ed7);--border:var(--myllm-border,rgba(120,120,128,.25));\n  --radius:var(--myllm-radius,14px);--font:var(--myllm-font,-apple-system,system-ui,sans-serif);\n}\n@media(prefers-color-scheme:dark){:root{--bg:var(--myllm-bg,#000);--surface:var(--myllm-surface,#1c1c1e);--text:var(--myllm-text,#eee);--muted:var(--myllm-muted,#98989f)}}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nbody{margin:0;font-family:var(--font);background:var(--bg);color:var(--text)}\n.wrap{max-width:620px;margin:0 auto;padding:14px}\n.bar{display:flex;align-items:center;gap:8px;margin-bottom:12px}\n.bar .sp{flex:1}\n.bar button{border:0;background:var(--surface);border:1px solid var(--border);color:var(--accent);border-radius:10px;padding:9px 13px;font:inherit;font-weight:600;font-size:14px;cursor:pointer}\n.local{background:var(--accent);color:#fff;border-radius:var(--radius);padding:16px 18px;margin-bottom:14px}\n.local .l{font-size:13px;font-weight:600;opacity:.85}\n.local .t{font-size:40px;font-weight:700;letter-spacing:.5px;line-height:1.1;font-variant-numeric:tabular-nums}\n.local .d{font-size:14px;opacity:.9;margin-top:2px}\n.clock{display:flex;align-items:center;gap:12px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:13px 15px;margin-bottom:9px}\n.clock .glyph{font-size:22px;flex:none}\n.clock .info{flex:1;min-width:0}\n.clock .city{font-size:16px;font-weight:600}\n.clock .sub{font-size:12px;color:var(--muted);margin-top:1px}\n.clock .time{font-size:26px;font-weight:700;font-variant-numeric:tabular-nums}\n.clock .x{color:#ff453a;font-size:20px;padding:4px 6px;cursor:pointer;display:none}\n.editing .clock .x{display:block}\n.empty{color:var(--muted);text-align:center;padding:30px 16px;font-size:15px}\n/* picker */\n.sheet{position:fixed;inset:0;background:rgba(0,0,0,.5);display:none;align-items:flex-end;z-index:30}\n.sheet.show{display:flex}\n.sheetB{background:var(--bg);width:100%;max-height:82%;display:flex;flex-direction:column;border-radius:18px 18px 0 0;overflow:hidden}\n.sheetH{padding:14px 16px 10px;border-bottom:1px solid var(--border)}\n.sheetH input{width:100%;padding:11px 13px;border:1px solid var(--border);border-radius:10px;font:inherit;font-size:16px;background:var(--surface);color:var(--text)}\n.sheetL{overflow:auto;padding:6px 10px 24px}\n.pi{display:flex;justify-content:space-between;align-items:center;padding:12px;border-bottom:1px solid var(--border);cursor:pointer}\n.pi .c{font-size:15px;font-weight:600}.pi .k{font-size:12px;color:var(--muted)}\n.pi .o{font-size:13px;color:var(--accent);font-weight:600}\n.pi.dim{opacity:.4}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <div class=\"bar\">\n    <div class=\"sp\"></div>\n    <button id=\"edit\">Edit</button>\n    <button id=\"add\">＋ Add city</button>\n  </div>\n  <div class=\"local\" id=\"local\"></div>\n  <div id=\"clocks\"></div>\n  <div class=\"empty\" id=\"empty\" style=\"display:none\">Tap “＋ Add city” to add clocks from around the world.</div>\n</div>\n\n<div class=\"sheet\" id=\"sheet\"><div class=\"sheetB\">\n  <div class=\"sheetH\"><input id=\"search\" placeholder=\"Search a city…\" autocapitalize=\"words\" autocorrect=\"off\"></div>\n  <div class=\"sheetL\" id=\"pick\"></div>\n</div></div>\n\n<script>\nvar CITIES=[\n [\"Honolulu\",\"USA\",\"Pacific/Honolulu\"],[\"Anchorage\",\"USA\",\"America/Anchorage\"],[\"Los Angeles\",\"USA\",\"America/Los_Angeles\"],\n [\"Denver\",\"USA\",\"America/Denver\"],[\"Chicago\",\"USA\",\"America/Chicago\"],[\"New York\",\"USA\",\"America/New_York\"],\n [\"Toronto\",\"Canada\",\"America/Toronto\"],[\"Mexico City\",\"Mexico\",\"America/Mexico_City\"],[\"Bogotá\",\"Colombia\",\"America/Bogota\"],\n [\"São Paulo\",\"Brazil\",\"America/Sao_Paulo\"],[\"Buenos Aires\",\"Argentina\",\"America/Argentina/Buenos_Aires\"],\n [\"Reykjavik\",\"Iceland\",\"Atlantic/Reykjavik\"],[\"London\",\"UK\",\"Europe/London\"],[\"Dublin\",\"Ireland\",\"Europe/Dublin\"],\n [\"Lisbon\",\"Portugal\",\"Europe/Lisbon\"],[\"Madrid\",\"Spain\",\"Europe/Madrid\"],[\"Paris\",\"France\",\"Europe/Paris\"],\n [\"Berlin\",\"Germany\",\"Europe/Berlin\"],[\"Rome\",\"Italy\",\"Europe/Rome\"],[\"Amsterdam\",\"Netherlands\",\"Europe/Amsterdam\"],\n [\"Zurich\",\"Switzerland\",\"Europe/Zurich\"],[\"Stockholm\",\"Sweden\",\"Europe/Stockholm\"],[\"Athens\",\"Greece\",\"Europe/Athens\"],\n [\"Istanbul\",\"Turkey\",\"Europe/Istanbul\"],[\"Moscow\",\"Russia\",\"Europe/Moscow\"],[\"Cairo\",\"Egypt\",\"Africa/Cairo\"],\n [\"Lagos\",\"Nigeria\",\"Africa/Lagos\"],[\"Johannesburg\",\"South Africa\",\"Africa/Johannesburg\"],[\"Nairobi\",\"Kenya\",\"Africa/Nairobi\"],\n [\"Dubai\",\"UAE\",\"Asia/Dubai\"],[\"Tehran\",\"Iran\",\"Asia/Tehran\"],[\"Karachi\",\"Pakistan\",\"Asia/Karachi\"],\n [\"Mumbai\",\"India\",\"Asia/Kolkata\"],[\"Delhi\",\"India\",\"Asia/Kolkata\"],[\"Dhaka\",\"Bangladesh\",\"Asia/Dhaka\"],\n [\"Bangkok\",\"Thailand\",\"Asia/Bangkok\"],[\"Jakarta\",\"Indonesia\",\"Asia/Jakarta\"],[\"Singapore\",\"Singapore\",\"Asia/Singapore\"],\n [\"Hong Kong\",\"China\",\"Asia/Hong_Kong\"],[\"Shanghai\",\"China\",\"Asia/Shanghai\"],[\"Taipei\",\"Taiwan\",\"Asia/Taipei\"],\n [\"Seoul\",\"South Korea\",\"Asia/Seoul\"],[\"Tokyo\",\"Japan\",\"Asia/Tokyo\"],[\"Sydney\",\"Australia\",\"Australia/Sydney\"],\n [\"Melbourne\",\"Australia\",\"Australia/Melbourne\"],[\"Perth\",\"Australia\",\"Australia/Perth\"],[\"Auckland\",\"New Zealand\",\"Pacific/Auckland\"]\n];\nvar saved=[\"Europe/London\",\"America/New_York\",\"Asia/Tokyo\",\"Australia/Sydney\"];\nfunction $(i){return document.getElementById(i)}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nfunction cityFor(z){for(var i=0;i<CITIES.length;i++)if(CITIES[i][2]===z)return CITIES[i];return [z.split('/').pop().replace(/_/g,' '),'',z]}\n\nfunction zoneOffMin(z){\n  try{\n    var p=new Intl.DateTimeFormat('en-US',{timeZone:z,timeZoneName:'shortOffset'}).formatToParts(new Date());\n    var s=(p.find(function(x){return x.type==='timeZoneName'})||{}).value||'GMT';\n    var m=s.match(/GMT([+-])(\\d{1,2})(?::?(\\d{2}))?/);\n    if(!m)return 0;return (m[1]==='-'?-1:1)*(parseInt(m[2])*60+(m[3]?parseInt(m[3]):0));\n  }catch(e){return 0}\n}\nfunction fmtTime(z){return new Intl.DateTimeFormat([],{timeZone:z,hour:'2-digit',minute:'2-digit',hour12:false}).format(new Date())}\nfunction fmtSec(z){return new Intl.DateTimeFormat([],{timeZone:z,second:'2-digit'}).format(new Date())}\nfunction fmtDate(z){return new Intl.DateTimeFormat([],{timeZone:z,weekday:'short',day:'numeric',month:'short'}).format(new Date())}\nfunction dayKey(z){return new Intl.DateTimeFormat('en-CA',{timeZone:z,year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date())}\nfunction relLabel(z){\n  var loc=dayKey(Intl.DateTimeFormat().resolvedOptions().timeZone),here=dayKey(z);\n  if(here===loc)return 'Today';\n  return here>loc?'Tomorrow':'Yesterday';\n}\nfunction relOff(z){\n  var local=-new Date().getTimezoneOffset();\n  var diff=(zoneOffMin(z)-local)/60;\n  if(diff===0)return 'same time';\n  var h=Math.floor(Math.abs(diff)),mm=Math.round((Math.abs(diff)-h)*60);\n  return (diff>0?'+':'−')+h+(mm?(':'+(mm<10?'0':'')+mm):'')+'h';\n}\nfunction isDay(z){var h=parseInt(new Intl.DateTimeFormat('en-US',{timeZone:z,hour:'2-digit',hour12:false}).format(new Date()));return h>=6&&h<19}\n\nfunction tick(){\n  var lz=Intl.DateTimeFormat().resolvedOptions().timeZone;\n  $('local').innerHTML='<div class=\"l\">'+cityFor(lz)[0]+' · your time</div><div class=\"t\">'+fmtTime(lz)+'<span style=\"font-size:20px;opacity:.7\">:'+fmtSec(lz)+'</span></div><div class=\"d\">'+fmtDate(lz)+'</div>';\n  saved.forEach(function(z){\n    var el=document.getElementById('t-'+cssId(z));if(!el)return;\n    el.querySelector('.time').textContent=fmtTime(z);\n    el.querySelector('.glyph').textContent=isDay(z)?'☀️':'🌙';\n    el.querySelector('.sub').textContent=relLabel(z)+', '+relOff(z)+' · '+fmtDate(z);\n  });\n}\nfunction cssId(z){return z.replace(/[^\\w]/g,'_')}\nfunction render(){\n  var box=$('clocks');box.innerHTML='';\n  $('empty').style.display=saved.length?'none':'block';\n  saved.forEach(function(z){\n    var c=cityFor(z),row=document.createElement('div');row.className='clock';row.id='t-'+cssId(z);\n    row.innerHTML='<span class=\"glyph\">☀️</span><div class=\"info\"><div class=\"city\">'+esc(c[0])+'</div><div class=\"sub\"></div></div><div class=\"time\">--:--</div><span class=\"x\">✕</span>';\n    row.querySelector('.x').onclick=function(){saved=saved.filter(function(x){return x!==z});save();render();tick();haptic('warning')};\n    box.appendChild(row);\n  });\n  tick();\n}\nfunction esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}\n\n$('edit').onclick=function(){document.body.classList.toggle('editing');this.textContent=document.body.classList.contains('editing')?'Done':'Edit';haptic('selection')};\n$('add').onclick=function(){$('search').value='';renderPick('');$('sheet').classList.add('show');setTimeout(function(){$('search').focus()},100);haptic('selection')};\n$('sheet').onclick=function(e){if(e.target===$('sheet'))$('sheet').classList.remove('show')};\n$('search').addEventListener('input',function(){renderPick(this.value)});\nfunction renderPick(q){\n  q=(q||'').toLowerCase().trim();\n  var L=$('pick');L.innerHTML='';\n  CITIES.filter(function(c){return !q||c[0].toLowerCase().indexOf(q)>=0||c[1].toLowerCase().indexOf(q)>=0}).forEach(function(c){\n    var has=saved.indexOf(c[2])>=0,d=document.createElement('div');d.className='pi'+(has?' dim':'');\n    d.innerHTML='<div><div class=\"c\">'+esc(c[0])+'</div><div class=\"k\">'+esc(c[1])+'</div></div><div class=\"o\">'+(has?'Added':relOff(c[2]))+'</div>';\n    d.onclick=function(){if(has)return;saved.push(c[2]);save();render();$('sheet').classList.remove('show');haptic('success')};\n    L.appendChild(d);\n  });\n}\n\nfunction save(){if(window.myllmStorage)myllmStorage.setItem('worldclock',JSON.stringify(saved))}\nfunction load(){\n  if(!window.myllmStorage){render();start();return}\n  myllmStorage.getItem('worldclock').then(function(v){if(v)try{var a=JSON.parse(v);if(Array.isArray(a))saved=a}catch(e){}render();start()});\n}\nfunction start(){tick();setInterval(tick,1000)}\nload();\n</script>\n</body>\n</html>\n", "kind": "html", "iconSymbol": "globe.europe.africa.fill", "iconColor": "teal"}