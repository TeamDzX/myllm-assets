{"name": "World Clock", "html": "<!doctype html>\n<!--\n  World Clock — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>World Clock</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>\n:root{--build-id:\"d506381356\";\n  color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7);--surface:var(--myllm-surface,#fff);\n  --text:var(--myllm-text,#111);--muted:var(--myllm-muted,#6b6b72);\n  --accent:var(--myllm-accent,#0b5ed7);--border:var(--myllm-border,rgba(120,120,128,.25));\n  --radius:var(--myllm-radius,14px);--font:var(--myllm-font,-apple-system,system-ui,sans-serif);\n  --h:180;\n}\n@media(prefers-color-scheme:dark){:root{--bg:var(--myllm-bg,#000);--surface:var(--myllm-surface,#1c1c1e);--text:var(--myllm-text,#eee);--muted:var(--myllm-muted,#98989f)}}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nbody{margin:0;font-family:var(--font);background:var(--bg);color:var(--text)}\n.wrap{max-width:620px;margin:0 auto;padding:14px}\n.head{display:flex;align-items:center;gap:12px;margin:2px 2px 14px}\n.head .tile{width:44px;height:44px;border-radius:13px;font-size:19px;display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0;\n  background:linear-gradient(145deg,hsl(var(--h) 62% 50%),hsl(calc(var(--h) + 40) 58% 28%))}\n.head .ht{flex:1;min-width:0}\n.head h1{margin:0;font-size:22px;font-weight:800;letter-spacing:-.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.head p{margin:1px 0 0;font-size:13px;color:var(--muted)}\n.head .acts{display:flex;gap:8px;flex-shrink:0}\n@media(max-width:439px){.head .acts #add .lb{display:none}.head .acts #add{padding:0;width:40px;justify-content:center}}\n@media(max-width:379px){.head h1{font-size:20px}.head .acts #edit{padding:0 12px}}\n.head .acts button{height:40px;border:0;background:var(--surface);border:1px solid var(--border);color:var(--accent);border-radius:99px;padding:0 14px;font:inherit;font-weight:650;font-size:14px;cursor:pointer;display:inline-flex;align-items:center;gap:6px}\nsvg{width:1.2em;height:1.2em;fill:currentColor;flex-shrink:0}\n.local{position:relative;background:var(--accent);background:linear-gradient(145deg,var(--accent),color-mix(in srgb,var(--accent) 58%,#05051a));color:#fff;border-radius:22px;padding:18px 18px 20px;margin-bottom:14px;box-shadow:0 10px 30px rgba(10,20,60,.16)}\n.local .l{font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;opacity:.8;padding-right:130px}\n.local .t{font-size:54px;font-weight:300;letter-spacing:-.01em;line-height:1.1;margin-top:8px;font-variant-numeric:tabular-nums}\n.local .t span{font-size:22px;opacity:.65;margin-left:2px}\n.local .d{font-size:14px;opacity:.9;margin-top:2px}\n.glass{border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.16);color:#fff;-webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px)}\n.local .desk{position:absolute;z-index:1;right:12px;top:12px;height:36px;border-radius:99px;padding:0 13px;font:inherit;font-size:13px;font-weight:700;display:inline-flex;align-items:center;gap:6px;cursor:pointer}\n.local .desk:active{transform:scale(.96)}\n.clock{display:flex;align-items:center;gap:12px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:13px 15px;margin-bottom:9px}\n.clock .glyph{width:36px;height:36px;border-radius:11px;flex:none;display:flex;align-items:center;justify-content:center;font-size:17px;color:#ff9f0a;background:rgba(255,159,10,.14)}\n.clock .glyph.night{color:#8e8ef5;background:rgba(124,124,240,.16)}\n.clock .info{flex:1;min-width:0}\n.clock .city{font-size:16px;font-weight:600}\n.clock .sub{font-size:12px;color:var(--muted);margin-top:1px}\n.clock .time{font-size:26px;font-weight:700;font-variant-numeric:tabular-nums}\n.clock .x{border:0;background:rgba(255,69,58,.14);color:#ff453a;width:32px;height:32px;border-radius:50%;font-size:14px;cursor:pointer;display:none;align-items:center;justify-content:center;flex:none}\n.editing .clock .x{display:flex}\n.empty{color:var(--muted);text-align:center;padding:30px 16px;font-size:15px}\n/* picker */\n.sheet{position:fixed;inset:0;background:rgba(0,0,0,.5);display:none;align-items:flex-end;z-index:30}\n.sheet.show{display:flex}\n.sheetB{background:var(--bg);width:100%;max-height:82%;display:flex;flex-direction:column;border-radius:18px 18px 0 0;overflow:hidden}\n.sheetH{padding:14px 16px 10px;border-bottom:1px solid var(--border)}\n.sheetH input{width:100%;padding:11px 13px;border:1px solid var(--border);border-radius:10px;font:inherit;font-size:16px;background:var(--surface);color:var(--text)}\n.sheetL{overflow:auto;padding:6px 10px 24px}\n.pi{display:flex;justify-content:space-between;align-items:center;padding:12px;border-bottom:1px solid var(--border);cursor:pointer}\n.pi .c{font-size:15px;font-weight:600}.pi .k{font-size:12px;color:var(--muted)}\n.pi .o{font-size:13px;color:var(--accent);font-weight:600}\n.pi.dim{opacity:.4}\n\n/* Desk clock: true black, the local time large and thin, a few saved cities\n   dimmed beneath it, everything drifting a little every minute so nothing\n   burns in. Made for a phone on a stand. */\nbody.lock{overflow:hidden}\n.dock{display:none;position:fixed;inset:0;z-index:60;background:#000;color:#fff;overflow:hidden;-webkit-user-select:none;user-select:none}\n.dock.on{display:block}\n.dock .drift{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;\n  padding:calc(34px + env(safe-area-inset-top)) calc(34px + env(safe-area-inset-right)) calc(34px + env(safe-area-inset-bottom)) calc(34px + env(safe-area-inset-left));\n  transition:transform 2.5s ease-in-out}\n.dock .dmain{text-align:center;flex:none}\n.dock .dclock{font-size:min(29vw,220px);font-weight:200;letter-spacing:.01em;line-height:1;color:#c9c9cf;font-variant-numeric:tabular-nums;white-space:nowrap}\n.dock .dclock span{font-size:.24em;color:#5d5d66;margin-left:.12em;font-weight:300}\n.dock.nosec .dclock span{display:none}\n.dock .ddate{font-size:14px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5d5d66;margin-top:12px}\n.dock .dcities{width:min(100%,400px);margin-top:34px;flex:none}\n.dock .dcity{display:flex;align-items:center;gap:11px;padding:9px 0;border-top:1px solid #16161a}\n.dock .dcity:first-child{border-top:none}\n.dock .dcity svg{color:#55555e;font-size:15px}\n.dock .dcity .n{flex:1;min-width:0}\n.dock .dcity .c{font-size:15.5px;font-weight:650;color:#a9a9b2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.dock .dcity .s{font-size:12px;color:#5d5d66;margin-top:1px;font-weight:600}\n.dock .dcity .tm{font-size:24px;font-weight:300;color:#b4b4bd;font-variant-numeric:tabular-nums}\n.dock .ctl{position:absolute;left:0;right:0;bottom:calc(30px + env(safe-area-inset-bottom));display:flex;justify-content:center;gap:12px;opacity:0;pointer-events:none;transition:opacity .3s}\n.dock .ctl.on{opacity:1;pointer-events:auto}\n.dock .ctl button{border:1px solid #2c2c33;background:#121216;color:#eee;border-radius:99px;padding:12px 22px;font:inherit;font-size:15px;font-weight:700;display:inline-flex;align-items:center;gap:8px}\n.dock .ctl button.hot{background:#eee;color:#121216;border-color:#eee}\n.dock .hint{position:absolute;bottom:calc(34px + env(safe-area-inset-bottom));left:0;right:0;text-align:center;font-size:12px;color:#4a4a52;transition:opacity .6s}\n@media (orientation:landscape) and (max-height:560px){\n  .dock .drift{flex-direction:row;gap:6vw}\n  .dock .dclock{font-size:min(19vw,56vh)}\n  .dock .dcities{width:min(30vw,300px);margin-top:0}\n  .dock .dcities:empty{display:none}\n  .dock:not(.has) .dclock{font-size:min(27vw,50vh)}\n}\n@media (prefers-reduced-motion:reduce){.dock .drift{transition:none}}\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-globe\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5a9.5 9.5 0 1 0 0 19 9.5 9.5 0 0 0 0-19zm6.9 8.5h-3.1a15.4 15.4 0 0 0-1.4-5.9A7.5 7.5 0 0 1 18.9 11zM12 4.6c.8 1 1.9 3.2 2.1 6.4H9.9C10.1 7.8 11.2 5.6 12 4.6zM9.6 5.1A15.4 15.4 0 0 0 8.2 11H5.1a7.5 7.5 0 0 1 4.5-5.9zM5.1 13h3.1c.1 2.2.6 4.2 1.4 5.9A7.5 7.5 0 0 1 5.1 13zm6.9 6.4c-.8-1-1.9-3.2-2.1-6.4h4.2c-.2 3.2-1.3 5.4-2.1 6.4zm2.4-.5c.8-1.7 1.3-3.7 1.4-5.9h3.1a7.5 7.5 0 0 1-4.5 5.9z\"/></symbol>\n  <symbol id=\"i-plus\" viewBox=\"0 0 24 24\"><path d=\"M12 4.5a1.2 1.2 0 0 1 1.2 1.2v5.1h5.1a1.2 1.2 0 0 1 0 2.4h-5.1v5.1a1.2 1.2 0 0 1-2.4 0v-5.1H5.7a1.2 1.2 0 0 1 0-2.4h5.1V5.7A1.2 1.2 0 0 1 12 4.5z\"/></symbol>\n  <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M6.3 6.3a1.2 1.2 0 0 1 1.7 0l4 4 4-4a1.2 1.2 0 1 1 1.7 1.7l-4 4 4 4a1.2 1.2 0 1 1-1.7 1.7l-4-4-4 4a1.2 1.2 0 1 1-1.7-1.7l4-4-4-4a1.2 1.2 0 0 1 0-1.7z\"/></symbol>\n  <symbol id=\"i-sun\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"4.6\"/><path d=\"M12 1.8a1 1 0 0 1 1 1v1.9a1 1 0 0 1-2 0V2.8a1 1 0 0 1 1-1zm0 16.5a1 1 0 0 1 1 1v1.9a1 1 0 0 1-2 0v-1.9a1 1 0 0 1 1-1zM1.8 12a1 1 0 0 1 1-1h1.9a1 1 0 0 1 0 2H2.8a1 1 0 0 1-1-1zm16.5 0a1 1 0 0 1 1-1h1.9a1 1 0 0 1 0 2h-1.9a1 1 0 0 1-1-1zM4.8 4.8a1 1 0 0 1 1.4 0l1.35 1.35a1 1 0 0 1-1.4 1.4L4.8 6.2a1 1 0 0 1 0-1.4zm11.65 11.65a1 1 0 0 1 1.4 0l1.35 1.35a1 1 0 0 1-1.4 1.4l-1.35-1.35a1 1 0 0 1 0-1.4zM19.2 4.8a1 1 0 0 1 0 1.4l-1.35 1.35a1 1 0 0 1-1.4-1.4L17.8 4.8a1 1 0 0 1 1.4 0zM7.55 16.45a1 1 0 0 1 0 1.4L6.2 19.2a1 1 0 0 1-1.4-1.4l1.35-1.35a1 1 0 0 1 1.4 0z\"/></symbol>\n  <symbol id=\"i-moon\" viewBox=\"0 0 24 24\"><path d=\"M20.3 14.6a1 1 0 0 0-1.2-.6 7.3 7.3 0 0 1-9.1-9.1 1 1 0 0 0-1.3-1.2 9.3 9.3 0 1 0 12.2 12.2 1 1 0 0 0-.6-1.3z\"/></symbol>\n  <symbol id=\"i-desk\" viewBox=\"0 0 24 24\"><path d=\"M5 4.5h14A2.5 2.5 0 0 1 21.5 7v7.5A2.5 2.5 0 0 1 19 17h-5.2l.45 1.5H16a1 1 0 0 1 0 2H8a1 1 0 0 1 0-2h1.75l.45-1.5H5a2.5 2.5 0 0 1-2.5-2.5V7A2.5 2.5 0 0 1 5 4.5zm0 2a.5.5 0 0 0-.5.5v7.5c0 .28.22.5.5.5h14a.5.5 0 0 0 .5-.5V7a.5.5 0 0 0-.5-.5H5z\" fill-rule=\"evenodd\"/><rect x=\"7\" y=\"9.6\" width=\"2.2\" height=\"2.4\" rx=\".6\"/><rect x=\"10\" y=\"9.6\" width=\"2.2\" height=\"2.4\" rx=\".6\"/><rect x=\"14.8\" y=\"9.6\" width=\"2.2\" height=\"2.4\" rx=\".6\"/></symbol>\n</defs></svg>\n<div class=\"wrap\">\n  <div class=\"imm-safe\"></div><div class=\"head\">\n    <div class=\"tile\"><svg><use href=\"#i-globe\"/></svg></div>\n    <div class=\"ht\"><h1>World Clock</h1><p>Times around the world</p></div>\n    <div class=\"acts\">\n      <button id=\"edit\">Edit</button>\n      <button id=\"add\" aria-label=\"Add city\"><svg><use href=\"#i-plus\"/></svg><span class=\"lb\">Add city</span></button>\n    </div>\n  <div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close World Clock\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n  <div class=\"local\">\n    <button class=\"glass desk\" id=\"desk\"><svg><use href=\"#i-desk\"/></svg>Desk clock</button>\n    <div class=\"l\" id=\"lName\"></div>\n    <div class=\"t\"><b id=\"lTime\" style=\"font-weight:inherit\">--:--</b><span id=\"lSec\"></span></div>\n    <div class=\"d\" id=\"lDate\"></div>\n  </div>\n  <div id=\"clocks\"></div>\n  <div class=\"empty\" id=\"empty\" style=\"display:none\">Tap “Add city” to add clocks from around the world.</div>\n</div>\n\n<div class=\"sheet\" id=\"sheet\"><div class=\"sheetB\">\n  <div class=\"sheetH\"><input id=\"search\" placeholder=\"Search a city…\" autocapitalize=\"words\" autocorrect=\"off\"></div>\n  <div class=\"sheetL\" id=\"pick\"></div>\n</div></div>\n\n<div class=\"dock\" id=\"dock\">\n  <div class=\"drift\" id=\"dDrift\">\n    <div class=\"dmain\"><div class=\"dclock\"><b id=\"dClock\" style=\"font-weight:inherit\">--:--</b><span id=\"dSec\"></span></div><div class=\"ddate\" id=\"dDate\"></div></div>\n    <div class=\"dcities\" id=\"dCities\"></div>\n  </div>\n  <div class=\"hint\" id=\"dHint\">Tap for controls</div>\n  <div class=\"ctl\" id=\"dCtl\"><button id=\"dSecs\">Seconds</button><button id=\"dExit\"><svg><use href=\"#i-x\"/></svg>Exit</button></div>\n</div>\n\n<script>\nvar CITIES=[\n [\"Honolulu\",\"USA\",\"Pacific/Honolulu\"],[\"Anchorage\",\"USA\",\"America/Anchorage\"],[\"Los Angeles\",\"USA\",\"America/Los_Angeles\"],\n [\"Denver\",\"USA\",\"America/Denver\"],[\"Chicago\",\"USA\",\"America/Chicago\"],[\"New York\",\"USA\",\"America/New_York\"],\n [\"Toronto\",\"Canada\",\"America/Toronto\"],[\"Mexico City\",\"Mexico\",\"America/Mexico_City\"],[\"Bogotá\",\"Colombia\",\"America/Bogota\"],\n [\"São Paulo\",\"Brazil\",\"America/Sao_Paulo\"],[\"Buenos Aires\",\"Argentina\",\"America/Argentina/Buenos_Aires\"],\n [\"Reykjavik\",\"Iceland\",\"Atlantic/Reykjavik\"],[\"London\",\"UK\",\"Europe/London\"],[\"Dublin\",\"Ireland\",\"Europe/Dublin\"],\n [\"Lisbon\",\"Portugal\",\"Europe/Lisbon\"],[\"Madrid\",\"Spain\",\"Europe/Madrid\"],[\"Paris\",\"France\",\"Europe/Paris\"],\n [\"Berlin\",\"Germany\",\"Europe/Berlin\"],[\"Rome\",\"Italy\",\"Europe/Rome\"],[\"Amsterdam\",\"Netherlands\",\"Europe/Amsterdam\"],\n [\"Zurich\",\"Switzerland\",\"Europe/Zurich\"],[\"Stockholm\",\"Sweden\",\"Europe/Stockholm\"],[\"Athens\",\"Greece\",\"Europe/Athens\"],\n [\"Istanbul\",\"Turkey\",\"Europe/Istanbul\"],[\"Moscow\",\"Russia\",\"Europe/Moscow\"],[\"Cairo\",\"Egypt\",\"Africa/Cairo\"],\n [\"Lagos\",\"Nigeria\",\"Africa/Lagos\"],[\"Johannesburg\",\"South Africa\",\"Africa/Johannesburg\"],[\"Nairobi\",\"Kenya\",\"Africa/Nairobi\"],\n [\"Dubai\",\"UAE\",\"Asia/Dubai\"],[\"Tehran\",\"Iran\",\"Asia/Tehran\"],[\"Karachi\",\"Pakistan\",\"Asia/Karachi\"],\n [\"Mumbai\",\"India\",\"Asia/Kolkata\"],[\"Delhi\",\"India\",\"Asia/Kolkata\"],[\"Dhaka\",\"Bangladesh\",\"Asia/Dhaka\"],\n [\"Bangkok\",\"Thailand\",\"Asia/Bangkok\"],[\"Jakarta\",\"Indonesia\",\"Asia/Jakarta\"],[\"Singapore\",\"Singapore\",\"Asia/Singapore\"],\n [\"Hong Kong\",\"China\",\"Asia/Hong_Kong\"],[\"Shanghai\",\"China\",\"Asia/Shanghai\"],[\"Taipei\",\"Taiwan\",\"Asia/Taipei\"],\n [\"Seoul\",\"South Korea\",\"Asia/Seoul\"],[\"Tokyo\",\"Japan\",\"Asia/Tokyo\"],[\"Sydney\",\"Australia\",\"Australia/Sydney\"],\n [\"Melbourne\",\"Australia\",\"Australia/Melbourne\"],[\"Perth\",\"Australia\",\"Australia/Perth\"],[\"Auckland\",\"New Zealand\",\"Pacific/Auckland\"]\n];\nvar saved=[\"Europe/London\",\"America/New_York\",\"Asia/Tokyo\",\"Australia/Sydney\"];\nfunction $(i){return document.getElementById(i)}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nfunction cityFor(z){for(var i=0;i<CITIES.length;i++)if(CITIES[i][2]===z)return CITIES[i];return [z.split('/').pop().replace(/_/g,' '),'',z]}\n\nfunction zoneOffMin(z){\n  try{\n    var p=new Intl.DateTimeFormat('en-US',{timeZone:z,timeZoneName:'shortOffset'}).formatToParts(new Date());\n    var s=(p.find(function(x){return x.type==='timeZoneName'})||{}).value||'GMT';\n    var m=s.match(/GMT([+-])(\\d{1,2})(?::?(\\d{2}))?/);\n    if(!m)return 0;return (m[1]==='-'?-1:1)*(parseInt(m[2])*60+(m[3]?parseInt(m[3]):0));\n  }catch(e){return 0}\n}\nfunction fmtTime(z){return new Intl.DateTimeFormat([],{timeZone:z,hour:'2-digit',minute:'2-digit',hour12:false}).format(new Date())}\nfunction fmtSec(z){var v=new Intl.DateTimeFormat('en-US',{timeZone:z,second:'numeric'}).format(new Date());return v.length<2?'0'+v:v}   /* '2-digit' alone comes back unpadded */\nfunction fmtDate(z){return new Intl.DateTimeFormat([],{timeZone:z,weekday:'short',day:'numeric',month:'short'}).format(new Date())}\nfunction dayKey(z){return new Intl.DateTimeFormat('en-CA',{timeZone:z,year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date())}\nfunction relLabel(z){\n  var loc=dayKey(Intl.DateTimeFormat().resolvedOptions().timeZone),here=dayKey(z);\n  if(here===loc)return 'Today';\n  return here>loc?'Tomorrow':'Yesterday';\n}\nfunction relOff(z){\n  var local=-new Date().getTimezoneOffset();\n  var diff=(zoneOffMin(z)-local)/60;\n  if(diff===0)return 'same time';\n  var h=Math.floor(Math.abs(diff)),mm=Math.round((Math.abs(diff)-h)*60);\n  return (diff>0?'+':'−')+h+(mm?(':'+(mm<10?'0':'')+mm):'')+'h';\n}\nfunction isDay(z){var h=parseInt(new Intl.DateTimeFormat('en-US',{timeZone:z,hour:'2-digit',hour12:false}).format(new Date()));return h>=6&&h<19}\n\nfunction tick(){\n  var lz=Intl.DateTimeFormat().resolvedOptions().timeZone;\n  $('lName').textContent=cityFor(lz)[0]+' · your time';$('lTime').textContent=fmtTime(lz);$('lSec').textContent=':'+fmtSec(lz);$('lDate').textContent=fmtDate(lz);\n  saved.forEach(function(z){\n    var el=document.getElementById('t-'+cssId(z));if(!el)return;\n    el.querySelector('.time').textContent=fmtTime(z);\n    var g=el.querySelector('.glyph'),day=isDay(z);\n    if(g.getAttribute('data-d')!==String(day)){g.setAttribute('data-d',String(day));g.className='glyph'+(day?'':' night');g.innerHTML=day?SUN:MOON}\n    el.querySelector('.sub').textContent=relLabel(z)+', '+relOff(z)+' · '+fmtDate(z);\n  });\n  if(dockOn)dockTick();\n}\nvar SUN='<svg><use href=\"#i-sun\"/></svg>',MOON='<svg><use href=\"#i-moon\"/></svg>';\nfunction cssId(z){return z.replace(/[^\\w]/g,'_')}\nfunction render(){\n  var box=$('clocks');box.innerHTML='';\n  $('empty').style.display=saved.length?'none':'block';\n  saved.forEach(function(z){\n    var c=cityFor(z),row=document.createElement('div');row.className='clock';row.id='t-'+cssId(z);\n    row.innerHTML='<span class=\"glyph\"></span><div class=\"info\"><div class=\"city\">'+esc(c[0])+'</div><div class=\"sub\"></div></div><div class=\"time\">--:--</div><button class=\"x\" aria-label=\"Remove\"><svg><use href=\"#i-x\"/></svg></button>';\n    row.querySelector('.x').onclick=function(){saved=saved.filter(function(x){return x!==z});save();render();tick();haptic('warning')};\n    box.appendChild(row);\n  });\n  tick();\n}\nfunction esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}\n\n$('edit').onclick=function(){document.body.classList.toggle('editing');this.textContent=document.body.classList.contains('editing')?'Done':'Edit';haptic('selection')};\n$('add').onclick=function(){$('search').value='';renderPick('');$('sheet').classList.add('show');setTimeout(function(){$('search').focus()},100);haptic('selection')};\n$('sheet').onclick=function(e){if(e.target===$('sheet'))$('sheet').classList.remove('show')};\n$('search').addEventListener('input',function(){renderPick(this.value)});\nfunction renderPick(q){\n  q=(q||'').toLowerCase().trim();\n  var L=$('pick');L.innerHTML='';\n  CITIES.filter(function(c){return !q||c[0].toLowerCase().indexOf(q)>=0||c[1].toLowerCase().indexOf(q)>=0}).forEach(function(c){\n    var has=saved.indexOf(c[2])>=0,d=document.createElement('div');d.className='pi'+(has?' dim':'');\n    d.innerHTML='<div><div class=\"c\">'+esc(c[0])+'</div><div class=\"k\">'+esc(c[1])+'</div></div><div class=\"o\">'+(has?'Added':relOff(c[2]))+'</div>';\n    d.onclick=function(){if(has)return;saved.push(c[2]);save();render();$('sheet').classList.remove('show');haptic('success')};\n    L.appendChild(d);\n  });\n}\n\n/* ---------- desk clock ----------\n   The screen is kept awake by MyLLM where it can (myllmImmersive, which also\n   hides MyLLM's own title bar), else by the Wake Lock API where the web view\n   offers it; failing both, the phone's own auto-lock applies. */\nvar dockOn=false,dockSecs=true,dockDrift=null,dockCtlTimer=null,wakeLock=null;\nfunction fmtLong(z){return new Intl.DateTimeFormat([],{timeZone:z,weekday:'long',day:'numeric',month:'long'}).format(new Date())}\nfunction syncChrome(){\n  if(!window.myllmImmersive)return;\n  try{myllmImmersive((window.myllmClose ? true : (dockOn)), {keepAwake:dockOn}).catch(function(){})}catch(e){}\n}\nfunction requestWake(){\n  if(!('wakeLock' in navigator))return;\n  try{navigator.wakeLock.request('screen').then(function(l){wakeLock=l}).catch(function(){wakeLock=null})}catch(e){}\n}\nfunction releaseWake(){if(wakeLock){try{wakeLock.release()}catch(e){}wakeLock=null}}\nfunction driftOnce(){\n  var x=Math.round((Math.random()-0.5)*40),y=Math.round((Math.random()-0.5)*40);\n  $('dDrift').style.transform='translate('+x+'px,'+y+'px)';\n}\nfunction dockCities(){\n  var lz=Intl.DateTimeFormat().resolvedOptions().timeZone;\n  return saved.filter(function(z){return z!==lz}).slice(0,4);\n}\nfunction dockBuild(){\n  var box=$('dCities');box.innerHTML='';\n  dockCities().forEach(function(z){\n    var r=document.createElement('div');r.className='dcity';r.setAttribute('data-z',z);\n    r.innerHTML='<span class=\"g\"></span><div class=\"n\"><div class=\"c\">'+esc(cityFor(z)[0])+'</div><div class=\"s\"></div></div><div class=\"tm\"></div>';\n    box.appendChild(r);\n  });\n  $('dock').classList.toggle('has',box.children.length>0);\n}\nfunction dockTick(){\n  var lz=Intl.DateTimeFormat().resolvedOptions().timeZone;\n  $('dClock').textContent=fmtTime(lz);$('dSec').textContent=fmtSec(lz);$('dDate').textContent=fmtLong(lz);\n  var rows=$('dCities').children;\n  for(var i=0;i<rows.length;i++){\n    var z=rows[i].getAttribute('data-z'),rel=relLabel(z),g=rows[i].querySelector('.g'),day=isDay(z);\n    rows[i].querySelector('.tm').textContent=fmtTime(z);\n    rows[i].querySelector('.s').textContent=relOff(z)+(rel==='Today'?'':' · '+rel);\n    if(g.getAttribute('data-d')!==String(day)){g.setAttribute('data-d',String(day));g.innerHTML=day?SUN:MOON}\n  }\n}\nfunction syncSecs(){$('dock').classList.toggle('nosec',!dockSecs);$('dSecs').classList.toggle('hot',dockSecs)}\nfunction openDock(){\n  haptic('medium');\n  dockOn=true;\n  document.body.classList.remove('editing');$('edit').textContent='Edit';\n  dockBuild();dockTick();driftOnce();syncSecs();\n  $('dock').classList.add('on');document.body.classList.add('lock');\n  $('dCtl').classList.remove('on');$('dHint').style.opacity='1';\n  setTimeout(function(){$('dHint').style.opacity='0'},4000);\n  dockDrift=setInterval(driftOnce,60000);\n  requestWake();syncChrome();\n}\nfunction closeDock(){\n  haptic('light');\n  dockOn=false;\n  $('dock').classList.remove('on');document.body.classList.remove('lock');\n  clearInterval(dockDrift);clearTimeout(dockCtlTimer);dockDrift=dockCtlTimer=null;\n  releaseWake();syncChrome();\n}\nfunction dockTap(){\n  if(!dockOn)return;\n  $('dHint').style.opacity='0';$('dCtl').classList.add('on');\n  clearTimeout(dockCtlTimer);\n  dockCtlTimer=setTimeout(function(){$('dCtl').classList.remove('on')},5000);\n}\n$('desk').onclick=openDock;\n$('dock').onclick=dockTap;\n$('dExit').onclick=function(e){e.stopPropagation();closeDock()};\n$('dSecs').onclick=function(e){\n  e.stopPropagation();dockSecs=!dockSecs;syncSecs();dockTap();haptic('selection');\n  if(window.myllmStorage)try{myllmStorage.setItem('worldclock.secs',dockSecs?'1':'0')}catch(_){}\n};\ndocument.addEventListener('visibilitychange',function(){\n  if(document.hidden){releaseWake();return}\n  tick();\n  if(dockOn){requestWake();syncChrome()}       /* MyLLM puts its bars back when the app is left */\n});\n\nfunction save(){if(window.myllmStorage)myllmStorage.setItem('worldclock',JSON.stringify(saved))}\nfunction load(){\n  if(!window.myllmStorage){render();start();return}\n  myllmStorage.getItem('worldclock').then(function(v){if(v)try{var a=JSON.parse(v);if(Array.isArray(a))saved=a}catch(e){}render();start()});\n  myllmStorage.getItem('worldclock.secs').then(function(v){if(v==='0')dockSecs=false}).catch(function(){});\n}\nfunction start(){tick();setInterval(tick,1000)}\nload();\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes.\n   The spacer keeps the header clear of the status bar / Dynamic Island. It is\n   live CSS — env(safe-area-inset-top) — not a measured number: the inset is\n   still 0 when the page loads and only grows once MyLLM's bar has gone (v1\n   measured once, so the title sat under the island). If the page's own styles\n   already pad the header down by the inset, the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  /* Does any rule that applies to the header or an ancestor already use the top inset? */\n  function pageHandlesInset(head){\n    var chain = [], n, found = false;\n    for (n = head; n && n.nodeType === 1; n = n.parentElement) chain.push(n);\n    function walk(rules){\n      for (var i = 0; i < rules.length && !found; i++){\n        var r = rules[i];\n        if (r.cssRules && !r.selectorText) { walk(r.cssRules); continue; }\n        if (!r.selectorText || !/safe-area-inset-top/.test(r.cssText) || !/(padding|margin|top)\\s*:/.test(r.cssText)) continue;\n        if (/\\.imm-safe/.test(r.selectorText)) continue;\n        for (var k = 0; k < chain.length; k++){\n          try { if (chain[k].matches(r.selectorText)) { found = true; break; } } catch(e){}\n        }\n      }\n    }\n    for (var s = 0; s < document.styleSheets.length && !found; s++){\n      try { walk(document.styleSheets[s].cssRules); } catch(e){}\n    }\n    for (n = head; n && n.nodeType === 1 && !found; n = n.parentElement){\n      if (/safe-area-inset-top/.test(n.getAttribute(\"style\") || \"\")) found = true;\n    }\n    return found;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = (document.body.classList.contains(\"imm\") && !pageHandlesInset(head)) ? \"env(safe-area-inset-top)\" : \"0px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script>\n</body>\n</html>\n", "kind": "html", "iconSymbol": "globe.europe.africa.fill", "iconColor": "teal"}