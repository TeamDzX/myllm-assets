{"name": "Mini Browser", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Mini Browser</title>\n<style>\n:root{\n  color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7);--surface:var(--myllm-surface,#fff);\n  --text:var(--myllm-text,#111);--muted:var(--myllm-muted,#6b6b72);\n  --accent:var(--myllm-accent,#0b5ed7);--border:var(--myllm-border,rgba(120,120,128,.25));\n  --radius:var(--myllm-radius,12px);--font:var(--myllm-font,-apple-system,system-ui,sans-serif);\n}\n@media(prefers-color-scheme:dark){:root{--bg:var(--myllm-bg,#000);--surface:var(--myllm-surface,#1c1c1e);--text:var(--myllm-text,#eee);--muted:var(--myllm-muted,#98989f)}}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nhtml,body{height:100%}\nbody{margin:0;font-family:var(--font);background:var(--bg);color:var(--text);display:flex;flex-direction:column}\n.bar{display:flex;gap:6px;align-items:center;padding:8px 10px;border-bottom:1px solid var(--border);background:var(--bg)}\n.nav{display:flex;gap:2px}\n.icon{width:34px;height:34px;border:0;background:none;color:var(--accent);font-size:17px;border-radius:8px;cursor:pointer;flex:none}\n.icon:disabled{opacity:.3}\n#url{flex:1;min-width:0;padding:9px 12px;border:1px solid var(--border);border-radius:999px;font:inherit;font-size:15px;background:var(--surface);color:var(--text)}\n#go{border:0;background:var(--accent);color:#fff;border-radius:999px;padding:0 15px;height:34px;font:inherit;font-weight:600;cursor:pointer;flex:none}\n.tools{display:flex;gap:4px;padding:5px 10px;border-bottom:1px solid var(--border);overflow-x:auto;scrollbar-width:none}.tools::-webkit-scrollbar{display:none}\n.tools button{flex:none;border:0;background:var(--surface);border:1px solid var(--border);color:var(--text);border-radius:8px;padding:7px 11px;font:inherit;font-size:13px;font-weight:600;cursor:pointer}\n.tools button.on{color:var(--accent);border-color:var(--accent)}\n#frame{flex:1;width:100%;border:0;background:#fff}\n#start{flex:1;overflow:auto;padding:22px 18px 30px}\n#status{display:none;position:absolute;left:0;right:0;top:92px;text-align:center;color:var(--muted);font-size:14px;padding:14px;background:var(--bg)}\n.sec{font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;margin:18px 2px 8px}\n.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:10px}\n.tile{display:flex;flex-direction:column;gap:4px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:13px;cursor:pointer}\n.tile b{font-size:14px}.tile span{font-size:12px;color:var(--muted);word-break:break-all}\n.list .row{display:flex;align-items:center;gap:8px;background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:10px 12px;margin-bottom:7px;cursor:pointer}\n.list .row .t{flex:1;min-width:0}\n.list .row .t b{display:block;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.list .row .t span{font-size:12px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block}\n.list .row .x{color:var(--muted);font-size:16px;padding:4px}\n.empty{color:var(--muted);font-size:14px;padding:4px 2px}\n.note{color:var(--muted);font-size:12px;line-height:1.5;margin-top:22px;border-top:1px solid var(--border);padding-top:14px}\n</style>\n</head>\n<body>\n<div class=\"bar\">\n  <div class=\"nav\">\n    <button class=\"icon\" id=\"back\" title=\"Back\">‹</button>\n    <button class=\"icon\" id=\"fwd\" title=\"Forward\">›</button>\n  </div>\n  <input id=\"url\" placeholder=\"Search or enter address\" enterkeyhint=\"go\" autocapitalize=\"off\" autocorrect=\"off\" autocomplete=\"off\" spellcheck=\"false\" inputmode=\"url\">\n  <button id=\"go\">Go</button>\n</div>\n<div class=\"tools\">\n  <button id=\"reload\">⟳ Reload</button>\n  <button id=\"home\">⌂ Home</button>\n  <button id=\"star\">☆ Bookmark</button>\n  <button id=\"safari\">↗ Open in Safari</button>\n</div>\n<iframe id=\"frame\" title=\"page\" style=\"display:none\"></iframe>\n<div id=\"start\"></div>\n<div id=\"status\"></div>\n<script>\nvar QUICK=[\n  {name:\"Wikipedia\",url:\"https://en.wikipedia.org/wiki/Main_Page\"},\n  {name:\"Hacker News\",url:\"https://news.ycombinator.com/\"},\n  {name:\"CNN Lite\",url:\"https://lite.cnn.com/\"},\n  {name:\"BBC News\",url:\"https://www.bbc.com/news\"},\n  {name:\"MDN Web Docs\",url:\"https://developer.mozilla.org/\"},\n  {name:\"Old Reddit\",url:\"https://old.reddit.com/\"}\n];\nvar hist=[],hi=-1,curUrl=\"\",curTitle=\"\",bookmarks=[],recents=[];\nvar frame=document.getElementById('frame');\nfunction $(i){return document.getElementById(i)}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nfunction status(t){var s=$('status');s.style.display=t?'block':'none';s.textContent=t||''}\n\nfunction normalize(input){\n  var s=(input||'').trim();if(!s)return null;\n  // search if it has a space, or no dot and isn't localhost\n  if(/\\s/.test(s)||(!/\\./.test(s)&&!/^localhost/i.test(s))) return 'https://html.duckduckgo.com/html/?q='+encodeURIComponent(s);\n  if(!/^https?:\\/\\//i.test(s)) s='https://'+s;\n  return s;\n}\nfunction host(u){try{return new URL(u).hostname.replace(/^www\\./,'')}catch(e){return u}}\n\nfunction sanitize(html,baseUrl){\n  var doc=new DOMParser().parseFromString(html,'text/html');\n  var title=(doc.querySelector('title')&&doc.querySelector('title').textContent.trim())||host(baseUrl);\n  // Remove anything that could run code or hijack navigation. Scripts are\n  // stripped so a fetched page can never reach the native bridges.\n  Array.prototype.forEach.call(doc.querySelectorAll('script,noscript,template'),function(n){n.remove()});\n  Array.prototype.forEach.call(doc.querySelectorAll('meta[http-equiv]'),function(n){var v=(n.getAttribute('http-equiv')||'').toLowerCase();if(v==='content-security-policy'||v==='refresh')n.remove()});\n  Array.prototype.forEach.call(doc.querySelectorAll('*'),function(el){\n    for(var i=el.attributes.length-1;i>=0;i--){\n      var a=el.attributes[i],n=a.name.toLowerCase();\n      if(n.indexOf('on')===0)el.removeAttribute(a.name);\n      else if((n==='href'||n==='src'||n==='xlink:href')&&/^\\s*javascript:/i.test(a.value))el.removeAttribute(a.name);\n    }\n  });\n  var head=doc.head||doc.documentElement;\n  Array.prototype.forEach.call(doc.querySelectorAll('base'),function(b){b.remove()});\n  var base=doc.createElement('base');base.setAttribute('href',baseUrl);head.insertBefore(base,head.firstChild);\n  return {html:'<!doctype html>'+doc.documentElement.outerHTML,title:title};\n}\n\nfunction hookLinks(){\n  var d;try{d=frame.contentDocument}catch(e){return}if(!d)return;\n  d.addEventListener('click',function(e){\n    var el=e.target;while(el&&el.tagName!=='A')el=el.parentElement;\n    if(!el)return;var href=el.href||'';\n    if(/^https?:/i.test(href)){e.preventDefault();haptic('selection');navigate(href,true)}\n  },true);\n}\n\nfunction navigate(input,push){\n  var url=/^https?:\\/\\//i.test(input)?input:normalize(input);\n  if(!url)return;\n  if(!window.myllmFetch){status('This browser needs network access — update MyLLM and turn on “Allow apps to use the network” in Settings → MyLLMos Apps.');return}\n  $('start').style.display='none';frame.style.display='block';\n  status('Loading '+host(url)+'…');haptic('light');\n  myllmFetch(url,{headers:{Accept:'text/html,application/xhtml+xml'}})\n    .then(function(r){\n      if(!r||!r.ok)throw new Error('the site returned '+((r&&r.status)||'no response'));\n      var ct='';try{for(var k in r.headers){if(k.toLowerCase()==='content-type')ct=(''+r.headers[k]).toLowerCase()}}catch(e){}\n      if(ct&&ct.indexOf('html')===-1&&ct.indexOf('xml')===-1){\n        status('This isn’t a web page ('+ct.split(';')[0]+'). Tap ↗ Open in Safari to view it.');\n        curUrl=url;$('url').value=url;return;\n      }\n      var s=sanitize(r.body||'',url);\n      var d=frame.contentDocument||frame.contentWindow.document;\n      d.open();d.write(s.html);d.close();\n      hookLinks();\n      curUrl=url;curTitle=s.title;$('url').value=url;status('');\n      updateStar();\n      if(push){hist=hist.slice(0,hi+1);hist.push(url);hi=hist.length-1}\n      addRecent(url,s.title);updateNav();\n      try{frame.contentWindow.scrollTo(0,0)}catch(e){}\n    })\n    .catch(function(e){status('Couldn’t load this page: '+e.message)});\n}\nfunction updateNav(){$('back').disabled=hi<=0;$('fwd').disabled=hi>=hist.length-1}\n\n$('go').onclick=function(){navigate($('url').value,true)};\n$('url').addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();navigate($('url').value,true);this.blur()}});\n$('back').onclick=function(){if(hi>0){hi--;haptic('selection');navigate(hist[hi],false)}};\n$('fwd').onclick=function(){if(hi<hist.length-1){hi++;haptic('selection');navigate(hist[hi],false)}};\n$('reload').onclick=function(){if(curUrl){haptic('light');navigate(curUrl,false)}};\n$('home').onclick=function(){haptic('selection');frame.style.display='none';status('');$('start').style.display='block';renderStart()};\n$('safari').onclick=function(){var u=curUrl||normalize($('url').value);if(u&&window.open){haptic('light');window.open(u,'_blank')}};\n$('star').onclick=function(){\n  if(!curUrl)return;haptic('success');\n  var i=bookmarks.findIndex(function(b){return b.url===curUrl});\n  if(i>=0)bookmarks.splice(i,1);else bookmarks.unshift({url:curUrl,title:curTitle||host(curUrl)});\n  save();updateStar();\n};\nfunction updateStar(){var on=bookmarks.some(function(b){return b.url===curUrl});$('star').textContent=on?'★ Saved':'☆ Bookmark';$('star').classList.toggle('on',on)}\n\nfunction addRecent(url,title){\n  recents=recents.filter(function(r){return r.url!==url});\n  recents.unshift({url:url,title:title||host(url)});\n  if(recents.length>20)recents.length=20;save();\n}\n\nfunction renderStart(){\n  var h='<div class=\"sec\">Quick links</div><div class=\"grid\">';\n  QUICK.forEach(function(q){h+='<div class=\"tile\" data-u=\"'+enc(q.url)+'\"><b>'+enc(q.name)+'</b><span>'+enc(host(q.url))+'</span></div>'});\n  h+='</div>';\n  h+='<div class=\"sec\">Bookmarks</div><div class=\"list\" id=\"bm\">';\n  if(!bookmarks.length)h+='<div class=\"empty\">Tap ☆ on a page to save it here.</div>';\n  bookmarks.forEach(function(b,i){h+=row(b,i,'bm')});\n  h+='</div>';\n  h+='<div class=\"sec\">Recent</div><div class=\"list\" id=\"rc\">';\n  if(!recents.length)h+='<div class=\"empty\">Pages you visit will appear here.</div>';\n  recents.slice(0,12).forEach(function(b,i){h+=row(b,i,'rc')});\n  h+='</div>';\n  h+='<div class=\"note\">Pages open as fast, private, read-only snapshots — perfect for articles, wikis, news and docs. Logins and interactive web apps won’t work here; tap ↗ Open in Safari for those.</div>';\n  $('start').innerHTML=h;\n  Array.prototype.forEach.call($('start').querySelectorAll('.tile'),function(t){t.onclick=function(){navigate(t.getAttribute('data-u'),true)}});\n  wireRows('bm',bookmarks);wireRows('rc',recents);\n}\nfunction row(b,i,kind){return '<div class=\"row\" data-i=\"'+i+'\" data-k=\"'+kind+'\"><div class=\"t\"><b>'+enc(b.title||host(b.url))+'</b><span>'+enc(host(b.url))+'</span></div>'+(kind==='bm'?'<span class=\"x\" data-del=\"'+i+'\">✕</span>':'')+'</div>'}\nfunction wireRows(kind,arr){\n  var box=$(kind);if(!box)return;\n  Array.prototype.forEach.call(box.querySelectorAll('.row'),function(r){\n    r.onclick=function(e){if(e.target.hasAttribute('data-del')){arr.splice(+e.target.getAttribute('data-del'),1);save();renderStart();return}navigate(arr[+r.getAttribute('data-i')].url,true)};\n  });\n}\nfunction enc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;')}\n\nfunction save(){if(window.myllmStorage)myllmStorage.setItem('browser',JSON.stringify({bookmarks:bookmarks,recents:recents}))}\nfunction load(){\n  if(!window.myllmStorage){renderStart();return}\n  myllmStorage.getItem('browser').then(function(v){\n    if(v)try{var s=JSON.parse(v);bookmarks=s.bookmarks||[];recents=s.recents||[]}catch(e){}\n    renderStart();\n  });\n}\nupdateNav();load();\n</script>\n</body>\n</html>\n", "kind": "html", "iconSymbol": "globe", "iconColor": "blue"}