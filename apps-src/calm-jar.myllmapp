{"name": "Calm Jar", "html": "<!doctype html>\n<!--\n  Calm Jar — MyLLMos App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\">\n<style>:root{--build-id:\"c26e5ba24b\";color-scheme:light dark}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none}\nhtml,body{margin:0;height:100%;overflow:hidden;font-family:-apple-system,system-ui,sans-serif}\nbody{background:#0b1020;color:#fff;display:flex;flex-direction:column;touch-action:none}\ncanvas{flex:1;display:block;width:100%}\n.hint{position:fixed;left:0;right:0;top:calc(14px + env(safe-area-inset-top));text-align:center;font-size:15px;opacity:.85;pointer-events:none;transition:opacity .6s}\n.bar{position:fixed;left:0;right:0;bottom:0;display:flex;gap:10px;justify-content:center;padding:12px 14px calc(12px + env(safe-area-inset-bottom))}\n.bar button{border:0;background:rgba(255,255,255,.14);color:#fff;border-radius:16px;padding:11px 18px;font-size:15px;font-weight:600;backdrop-filter:blur(6px)}\n.bar button:active{background:rgba(255,255,255,.28)}\n</style></head><body>\n<canvas id=\"c\"></canvas>\n<div class=\"hint\" id=\"hint\">Tap anywhere to shake the jar 🌟<br><span style=\"font-size:13px;opacity:.7\">then watch the glitter settle and breathe slowly</span></div>\n<div class=\"bar\">\n  <button onclick=\"shake()\">Shake</button>\n  <button onclick=\"nextTheme()\">Colours</button>\n</div>\n<script>\nfunction haptic(s){if(window.myllmHaptic)try{myllmHaptic(s)}catch(e){}}\nvar c=document.getElementById('c'),ctx=c.getContext('2d');\nvar dpr=Math.max(1,Math.min(3,window.devicePixelRatio||1)),W=0,H=0;\nvar THEMES=[[200,260],[280,330],[150,200],[20,60],[330,30]]; // hue ranges\nvar theme=0,parts=[];\nfunction resize(){W=c.clientWidth;H=c.clientHeight;c.width=W*dpr;c.height=H*dpr;ctx.setTransform(dpr,0,0,dpr,0,0)}\nfunction rnd(a,b){return a+Math.random()*(b-a)}\nfunction makeParts(){\n  parts=[];var n=Math.min(170,Math.floor(W*H/4200));\n  for(var i=0;i<n;i++){\n    parts.push({x:rnd(20,W-20),y:rnd(20,H-20),vx:0,vy:0,r:rnd(2.2,5.2),hue:0,a:rnd(.6,1),tw:rnd(0,6.28)});\n  }\n  recolor();\n}\nfunction recolor(){var t=THEMES[theme];parts.forEach(function(p){p.hue=rnd(t[0],t[1])})}\nfunction nextTheme(){theme=(theme+1)%THEMES.length;recolor();haptic('selection')}\nfunction shake(x,y){\n  haptic('medium');\n  hideHint();\n  parts.forEach(function(p){\n    var ang=rnd(0,6.28),sp=rnd(2,7);\n    p.vx+=Math.cos(ang)*sp+(x!=null?(p.x-x)*0.01:0);\n    p.vy+=Math.sin(ang)*sp-rnd(1,4);\n  });\n}\nvar hintGone=false;\nfunction hideHint(){if(!hintGone){hintGone=true;document.getElementById('hint').style.opacity='0'}}\nfunction step(){\n  ctx.fillStyle='rgba(11,16,32,0.30)';ctx.fillRect(0,0,W,H); // motion trails\n  for(var i=0;i<parts.length;i++){\n    var p=parts[i];\n    p.vy+=0.045;            // gentle gravity\n    p.vx*=0.975;p.vy*=0.975; // fluid drag → slow, dreamy settle\n    p.x+=p.vx;p.y+=p.vy;\n    if(p.x<p.r){p.x=p.r;p.vx*=-0.45}\n    if(p.x>W-p.r){p.x=W-p.r;p.vx*=-0.45}\n    if(p.y>H-p.r){p.y=H-p.r;p.vy*=-0.35;p.vx*=0.9}\n    if(p.y<p.r){p.y=p.r;p.vy*=-0.4}\n    p.tw+=0.05;\n    var tw=0.65+0.35*Math.sin(p.tw);\n    ctx.globalAlpha=p.a*tw;\n    ctx.fillStyle='hsl('+p.hue+',85%,'+(62+10*Math.sin(p.tw))+'%)';\n    ctx.shadowBlur=8;ctx.shadowColor='hsl('+p.hue+',90%,70%)';\n    ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,6.2832);ctx.fill();\n  }\n  ctx.globalAlpha=1;ctx.shadowBlur=0;\n  requestAnimationFrame(step);\n}\nfunction pt(e){var t=e.touches?e.touches[0]:e,r=c.getBoundingClientRect();return{x:t.clientX-r.left,y:t.clientY-r.top}}\nc.addEventListener('touchstart',function(e){var q=pt(e);shake(q.x,q.y);e.preventDefault()},{passive:false});\nc.addEventListener('mousedown',function(e){var q=pt(e);shake(q.x,q.y)});\nwindow.addEventListener('resize',function(){resize();makeParts()});\nresize();makeParts();shake();step();\n</script></body></html>\n", "kind": "html", "iconSymbol": "sparkles", "iconColor": "indigo"}