 COL.scrap2, COL.rust][k % 3];\n    box(m2, -s, s, -.3, s * 1.1, -s * .6, s * .6, jit(col, .2), s * .2, function(x, y, z){ return [cx + x * c - z * sn, y + x * tilt * .3, cz + x * sn + z * c]; });\n  }\n  MESH.heap = new Float32Array(m2);\n  // selection ring + blob shadow\n  var ring = []; for (k = 0; k < 24; k++){ var a0 = k / 24 * TAU, a1 = (k + 1) / 24 * TAU; quad(ring, [Math.cos(a0), .15, Math.sin(a0)], [Math.cos(a1), .15, Math.sin(a1)], [Math.cos(a1) * .82, .15, Math.sin(a1) * .82], [Math.cos(a0) * .82, .15, Math.sin(a0) * .82], [1, 1, 1]); }\n  MESH.ring = new Float32Array(ring);\n  var blob = []; for (k = 0; k < 12; k++){ var b0 = k / 12 * TAU, b1 = (k + 1) / 12 * TAU; tri(blob, [0, .08, 0], [Math.cos(b0), .08, Math.sin(b0)], [Math.cos(b1), .08, Math.sin(b1)], [0, 0, 0]); }\n  MESH.blob = new Float32Array(blob);\n  var wreck = []; box(wreck, -1.8, 1.8, 0, .7, -1, 1, [.22, .19, .17], .2); box(wreck, -.8, .6, .7, 1.1, -.6, .6, [.28, .22, .18], .1); MESH.wreck = new Float32Array(wreck);\n  var crater = []; box(crater, -1, 1, 0, .6, -1, 1, [.13, .12, .11], .3); MESH.rubble = new Float32Array(crater);\n}\n\n// ---------- particles ----------\nfunction spawnP(x, y, z, vx, vy, vz, c, s, l){ if (parts.length > 900) parts.shift(); parts.push({ x: x, y: y, z: z, vx: vx, vy: vy, vz: vz, c: c, s: s, l: l, l0: l }); }\nfunction puff(x, y, z, c, s, n){ for (var i = 0; i < n; i++) spawnP(x + (rnd() - .5), y, z + (rnd() - .5), (rnd() - .5) * 1.5, .8 + rnd(), (rnd() - .5) * 1.5, c, s * (1 + rnd()), 1.4 + rnd()); }\nfunction explode(x, y, z, k){\n  for (var i = 0; i < 26 * k; i++) spawnP(x, y, z, (rnd() - .5) * 14 * k, rnd() * 9 * k, (rnd() - .5) * 14 * k, [1, .45 + rnd() * .4, .15, 1], .8 * k, .35 + rnd() * .3);\n  puff(x, y, z, [.22, .2, .2, .7], 2.6 * k, Math.round(10 * k));\n  boom = Math.max(boom, k * .6); sfx('boom', x, z, k);\n}\nvar boom = 0;\nfunction stepParts(dt){\n  for (var i = parts.length - 1; i >= 0; i--){ var p = parts[i]; p.l -= dt; if (p.l <= 0){ parts.splice(i, 1); continue; }\n    p.x += p.vx * dt; p.y += p.vy * dt; p.z += p.vz * dt; p.vx *= .96; p.vz *= .96; p.vy = p.vy * .96 + (p.s > 1 ? .5 : -9) * dt; }\n}\nvar floats = [];\nfunction floatText(x, z, t){ floats.push({ x: x, z: z, t: t, l: 1.6 }); }\n\n// ===================================================================\n// CAMERA + PICKING\n// ===================================================================\nvar cam = { x: BASES[0][0] + 20, z: BASES[0][1] - 16, d: 78, tx: 0, tz: 0, td: 78 }, VP = null, EYE = [0, 0, 0], FOV = 40 * PI / 180, PITCH = 56 * PI / 180, W = 1, H = 1;\nfunction camEye(){ return [cam.x, cam.d * Math.sin(PITCH) + heightAt(cam.x, cam.z), cam.z + cam.d * Math.cos(PITCH)]; }\nfunction screenRay(sx, sy){\n  var ndcX = sx / W * 2 - 1, ndcY = 1 - sy / H * 2, th = Math.tan(FOV / 2), asp = W / H;\n  var dx = -CAMB.z[0] + CAMB.x[0] * ndcX * th * asp + CAMB.y[0] * ndcY * th, dy = -CAMB.z[1] + CAMB.x[1] * ndcX * th * asp + CAMB.y[1] * ndcY * th, dz = -CAMB.z[2] + CAMB.x[2] * ndcX * th * asp + CAMB.y[2] * ndcY * th;\n  var l = Math.hypot(dx, dy, dz); return [dx / l, dy / l, dz / l];\n}\nfunction groundAt(sx, sy){\n  var d = screenRay(sx, sy), e = EYE, t = 0, prev = 0;\n  for (var i = 0; i < 400; i++){\n    t += 1.5; var x = e[0] + d[0] * t, y = e[1] + d[1] * t, z = e[2] + d[2] * t;\n    if (y < Math.max(-1.1, heightAt(x, z))){ var lo = prev, hi = t; for (var k = 0; k < 8; k++){ var m = (lo + hi) / 2; var yy = e[1] + d[1] * m, xx = e[0] + d[0] * m, zz = e[2] + d[2] * m; if (yy < Math.max(-1.1, heightAt(xx, zz))) hi = m; else lo = m; } return [e[0] + d[0] * hi, e[2] + d[2] * hi]; }\n    prev = t;\n  }\n  return null;\n}\nfunction toScreen(x, y, z){\n  var v = VP, cx = v[0] * x + v[4] * y + v[8] * z + v[12], cy = v[1] * x + v[5] * y + v[9] * z + v[13], cw = v[3] * x + v[7] * y + v[11] * z + v[15];\n  if (cw <= 0) return null; return [(cx / cw * .5 + .5) * W, (1 - (cy / cw * .5 + .5)) * H, cw];\n}\nfunction pickEntity(sx, sy){\n  var best = null, bd = 30;\n  units.forEach(function(u){ if (u.dead) return; var s = toScreen(u.x, heightAt(u.x, u.z) + 1, u.z); if (!s) return; var d = Math.hypot(s[0] - sx, s[1] - sy) * (u.team === 0 ? 1 : 0.9); if (d < bd){ bd = d; best = u; } });\n  if (best) return best;\n  var g = groundAt(sx, sy); if (!g) return null;\n  for (var i = 0; i < blds.length; i++){ var b = blds[i]; if (!b.dead && insideB(b, g[0], g[1], 1.5)) return b; }\n  for (i = 0; i < heaps.length; i++){ var h = heaps[i]; if (h.amount > 0 && Math.hypot(h.x - g[0], h.z - g[1]) < 4.5) return h; }\n  return null;\n}\n\n// ===================================================================\n// RENDER\n// ===================================================================\nvar LIGHT = { sun: norm3([-.55, .62, .45]), sunCol: [1.05, .86, .68], amb: [.46, .42, .52], fog: [.95, .7, .58] };\nfunction norm3(v){ var l = Math.hypot(v[0], v[1], v[2]); return [v[0] / l, v[1] / l, v[2] / l]; }\nvar lastW = 0, lastH = 0, pData = new Float32Array(1400 * 8);\nfunction resize(){\n  var dpr = Math.min(window.devicePixelRatio || 1, 2), w = Math.round(canvas.clientWidth * dpr), h = Math.round(canvas.clientHeight * dpr);\n  if (w !== lastW || h !== lastH){ canvas.width = w; canvas.height = h; lastW = w; lastH = h; ui.width = w; ui.height = h; }\n  W = canvas.clientWidth; H = canvas.clientHeight;\n}\nfunction bindMesh(prog, m){\n  gl.bindBuffer(gl.ARRAY_BUFFER, m.b);\n  gl.enableVertexAttribArray(prog.a.aP); gl.vertexAttribPointer(prog.a.aP, 3, gl.FLOAT, false, 36, 0);\n  gl.enableVertexAttribArray(prog.a.aN); gl.vertexAttribPointer(prog.a.aN, 3, gl.FLOAT, false, 36, 12);\n  gl.enableVertexAttribArray(prog.a.aC); gl.vertexAttribPointer(prog.a.aC, 3, gl.FLOAT, false, 36, 24);\n}\nfunction draw(m, M){ gl.uniformMatrix4fv(R.main.u.uM, false, M); bindMesh(R.main, m); gl.drawArrays(gl.TRIANGLES, 0, m.n); }\nfunction render(dt){\n  if (R.lost) return;\n  resize();\n  cam.x = clamp(cam.x, 20, WM - 20); cam.z = clamp(cam.z, 30, HM + 10); cam.d = clamp(cam.d, 34, 150);\n  EYE = camEye();\n  var shk = boom > 0 ? boom : 0; boom = Math.max(0, boom - dt * 3);\n  var e = [EYE[0] + (rnd() - .5) * shk * .4, EYE[1] + (rnd() - .5) * shk * .4, EYE[2]];\n  var P = perspective(FOV, W / H, 1, 1200), V = lookAt(e, [cam.x, heightAt(cam.x, cam.z), cam.z], [0, 1, 0]);\n  VP = mul(P, V); EYE = e;\n  gl.viewport(0, 0, canvas.width, canvas.height);\n  gl.clearColor(0, 0, 0, 0); gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);\n  var m = R.main; gl.useProgram(m.p);\n  gl.uniformMatrix4fv(m.u.uVP, false, VP); gl.uniform3fv(m.u.uCam, e); gl.uniform3fv(m.u.uSun, LIGHT.sun); gl.uniform3fv(m.u.uSunCol, LIGHT.sunCol);\n  gl.uniform3fv(m.u.uAmb, LIGHT.amb); gl.uniform3fv(m.u.uFog, LIGHT.fog); gl.uniform1f(m.u.uFogD, 1 / 520); gl.uniform1f(m.u.uAlpha, 1); gl.uniform3f(m.u.uTint, 1, 1, 1);\n  gl.uniform1f(m.u.uDetail, 1);\n  draw(R.world, IDENT);\n  gl.uniform1f(m.u.uDetail, 0);\n  heaps.forEach(function(h){ if (h.amount <= 0) return; var k = .45 + .75 * h.amount / h.max; draw(R.mesh.heap, mul(mModel(h.x, heightAt(h.x, h.z), h.z, h.seed, k * 1.3, k, k * 1.3), IDENT)); });\n  wrecks.forEach(function(w){ var y = w.y - Math.max(0, w.t - 35) * .25; if (w.w) draw(R.mesh.rubble, mModel(w.x, y, w.z, 0, w.w * 2, 1, w.d * 2)); else draw(R.mesh.wreck, mModel(w.x, y, w.z, w.h)); });\n  blds.forEach(function(b){\n    if (b.dead) return;\n    var rise = b.rise < 1 ? smooth(0, 1, b.rise) : 1, M = mModel(b.x, b.y, b.z, 0, 1, Math.max(.04, rise), 1);\n    draw(R.mesh[b.type + b.team], M);\n    if (b.rise < 1){ draw(R.mesh['scaf_' + b.type], mModel(b.x, b.y, b.z, 0)); return; }\n    if (b.type === 'missile') draw(R.mesh['missileTop' + b.team], mModel(b.x - Math.cos(b.aim) * (b.recoil || 0) * .2, b.y + 3.6, b.z - Math.sin(b.aim) * (b.recoil || 0) * .2, b.aim));\n    else if (b.type === 'techlab'){ var pl = 1 + .35 * Math.sin(gameT * 2.4 + b.id); gl.uniform3f(m.u.uTint, pl, pl, pl); draw(R.mesh.core, mModel(b.x, b.y, b.z, gameT * .5)); gl.uniform3f(m.u.uTint, 1, 1, 1); }\n    else if (b.type === 'turret') draw(R.mesh['turretTop' + b.team], mModel(b.x - Math.cos(b.aim) * (b.recoil || 0) * .3, b.y + 1.7, b.z - Math.sin(b.aim) * (b.recoil || 0) * .3, b.aim));\n    else if (b.type === 'hq'){\n      draw(R.mesh.dish, mModel(b.x + 1.2, b.y + 7.95, b.z - 1.5, gameT * .7 + b.id));\n      var on = Math.sin(gameT * 5 + b.id) > .55; gl.uniform3f(m.u.uTint, on ? 1.3 : .3, on ? 1.3 : .3, on ? 1.3 : .3);\n      draw(R.mesh.beacon, mModel(b.x + 3.0, b.y + 11.9, b.z - 3.4, 0)); gl.uniform3f(m.u.uTint, 1, 1, 1);\n    } else if (b.type === 'smelter'){\n      var fl = .75 + .25 * Math.sin(gameT * 9 + b.id) + .15 * Math.sin(gameT * 23); gl.uniform3f(m.u.uTint, fl, fl, fl);\n      draw(R.mesh.glow, M); gl.uniform3f(m.u.uTint, 1, 1, 1);\n    } else if (b.type === 'factory'){\n      draw(R.mesh.door, mModel(b.x, b.y + (b.door || 0) * 3.5, b.z, 0, 1, 1 - (b.door || 0) * .85, 1));\n      draw(R.mesh.crane, mModel(b.x, b.y, b.z + Math.sin(gameT * .22 + b.id) * 4.2 - .4, 0));\n    }\n  });\n  units.forEach(function(u){\n    if (u.dead) return;\n    var y = heightAt(u.x, u.z), rec = u.recoil * .25, M = mModel(u.x - Math.cos(u.h) * rec * .3, y, u.z - Math.sin(u.h) * rec * .3, u.h);\n    draw(R.mesh[u.type + u.team], M);\n    if (TOPS[u.type]) draw(R.mesh[u.type + 'Top' + u.team], mModel(u.x - Math.cos(u.th) * rec, y + TOPS[u.type], u.z - Math.sin(u.th) * rec, u.th));\n  });\n  // ghosts, rings, shadows (blended)\n  gl.enable(gl.BLEND); gl.depthMask(false);\n  gl.uniform1f(m.u.uAlpha, .32); gl.uniform3f(m.u.uTint, 1, 1, 1);\n  units.forEach(function(u){ if (!u.dead){ var r = UT[u.type].r * 1.15; draw(R.mesh.blob, mModel(u.x, heightAt(u.x, u.z), u.z, 0, r * 1.2, 1, r)); } });\n  gl.uniform1f(m.u.uAlpha, .85);\n  sel.forEach(function(u){ if (u.dead) return; gl.uniform3f(m.u.uTint, .5, 2.2, .9); var r = UT[u.type].r * 1.3; draw(R.mesh.ring, mModel(u.x, heightAt(u.x, u.z), u.z, 0, r, 1, r)); });\n  if (selB && !selB.dead){ gl.uniform3f(m.u.uTint, .5, 2.2, .9); var rb = Math.max(selB.w, selB.d) * CELL * .75; draw(R.mesh.ring, mModel(selB.x, selB.y, selB.z, 0, rb, 1, rb)); }\n  if (placing && placing.cell){\n    var Bp = BT[placing.type], gx = (placing.cell[0] + Bp.w / 2) * CELL, gz = (placing.cell[1] + Bp.d / 2) * CELL;\n    gl.uniform1f(m.u.uAlpha, .55); gl.uniform3f(m.u.uTint, placing.ok ? .6 : 2.2, placing.ok ? 2.0 : .5, placing.ok ? .8 : .4);\n    gl.depthMask(true); draw(R.mesh[placing.type + '0'], mModel(gx, heightAt(gx, gz), gz, 0)); gl.depthMask(false);\n  }\n  gl.uniform3f(m.u.uTint, 1, 1, 1); gl.uniform1f(m.u.uAlpha, 1);\n  gl.disableVertexAttribArray(m.a.aP); gl.disableVertexAttribArray(m.a.aN); gl.disableVertexAttribArray(m.a.aC);\n  // particles + shells\n  var n = 0, o = 0, total = Math.min(parts.length, 1300);\n  for (var q = parts.length - total; q < parts.length; q++){\n    var p = parts[q], life = p.l / p.l0;\n    pData[o++] = p.x; pData[o++] = p.y; pData[o++] = p.z; pData[o++] = p.c[0]; pData[o++] = p.c[1]; pData[o++] = p.c[2]; pData[o++] = p.c[3] * (p.s > 1 ? life : Math.min(1, life * 2)); pData[o++] = p.s * (p.s > 1 ? (2 - life) : 1); n++;\n  }\n  shots.forEach(function(s){ if (n >= 1390 || s.t < 0) return; pData[o++] = s.x; pData[o++] = s.y; pData[o++] = s.z; pData[o++] = 1; pData[o++] = s.kind === 'rocket' || s.kind === 'missile' ? .5 : .85; pData[o++] = .3; pData[o++] = 1; pData[o++] = s.kind === 'rocket' || s.kind === 'missile' ? 1.1 : .55; n++; });\n  if (n){\n    var pp = R.pts; gl.useProgram(pp.p);\n    gl.bindBuffer(gl.ARRAY_BUFFER, R.pbuf); gl.bufferData(gl.ARRAY_BUFFER, pData.subarray(0, o), gl.DYNAMIC_DRAW);\n    gl.enableVertexAttribArray(pp.a.aP); gl.vertexAttribPointer(pp.a.aP, 3, gl.FLOAT, false, 32, 0);\n    gl.enableVertexAttribArray(pp.a.aC); gl.vertexAttribPointer(pp.a.aC, 4, gl.FLOAT, false, 32, 12);\n    gl.enableVertexAttribArray(pp.a.aS); gl.vertexAttribPointer(pp.a.aS, 1, gl.FLOAT, false, 32, 28);\n    gl.uniformMatrix4fv(pp.u.uVP, false, VP); gl.uniform1f(pp.u.uScale, canvas.height / 2 / Math.tan(FOV / 2));\n    gl.drawArrays(gl.POINTS, 0, n);\n    gl.disableVertexAttribArray(pp.a.aP); gl.disableVertexAttribArray(pp.a.aC); gl.disableVertexAttribArray(pp.a.aS);\n  }\n  gl.disable(gl.BLEND); gl.depthMask(true);\n  drawUI(dt);\n}\n// ---------- 2D overlay: health bars, box, markers ----------\nvar ui = document.getElementById('ui'), ux = ui.getContext('2d'), marker = null, boxSel = null;\nfunction drawUI(dt){\n  var dpr = canvas.width / W; ux.setTransform(dpr, 0, 0, dpr, 0, 0); ux.clearRect(0, 0, W, H);\n  var bar = function(e, y, wpx){\n    var s = toScreen(e.x, y, e.z); if (!s) return; var f = clamp(e.hp / e.max, 0, 1);\n    ux.fillStyle = 'rgba(0,0,0,.6)'; ux.fillRect(s[0] - wpx / 2 - 1, s[1] - 1, wpx + 2, 6);\n    ux.fillStyle = f > .6 ? '#5ee08a' : f > .3 ? '#ffc23d' : '#ff5a4a'; ux.fillRect(s[0] - wpx / 2, s[1], wpx * f, 4);\n    if (e.team === 1){ ux.fillStyle = '#ff6a50'; ux.fillRect(s[0] - wpx / 2 - 1, s[1] - 3, 4, 2); }\n  };\n  units.forEach(function(u){ if (u.dead) return; if (sel.indexOf(u) >= 0 || u.hp < u.max) bar(u, heightAt(u.x, u.z) + 3.2, 26);\n    if (u.type === 'salvager' && u.carry > 0 && sel.indexOf(u) >= 0){ var s = toScreen(u.x, heightAt(u.x, u.z) + 3.2, u.z); if (s){ ux.fillStyle = '#ffd77a'; ux.fillRect(s[0] - 13, s[1] + 6, 26 * u.carry / CAP, 3); } } });\n  blds.forEach(function(b){ if (!b.dead && (b === selB || b.hp < b.max)) bar(b, b.y + 8, 46); });\n  if (selB && selB.type === 'factory' && teams[0].rally){ var r = toScreen(teams[0].rally[0], heightAt(teams[0].rally[0], teams[0].rally[1]) + .2, teams[0].rally[1]); if (r){ ux.strokeStyle = '#7cf7b0'; ux.lineWidth = 2; ux.beginPath(); ux.moveTo(r[0], r[1]); ux.lineTo(r[0], r[1] - 18); ux.stroke(); ux.fillStyle = '#7cf7b0'; ux.fillRect(r[0], r[1] - 18, 10, 7); } }\n  if (marker){ marker.l -= dt; var ms = toScreen(marker.x, heightAt(marker.x, marker.z) + .2, marker.z); if (ms && marker.l > 0){ var k = marker.l / .7; ux.strokeStyle = marker.atk ? 'rgba(255,90,70,' + k + ')' : 'rgba(124,247,176,' + k + ')'; ux.lineWidth = 2.5; ux.beginPath(); ux.ellipse(ms[0], ms[1], 18 * (1.4 - k * .6), 9 * (1.4 - k * .6), 0, 0, TAU); ux.stroke(); } if (marker.l <= 0) marker = null; }\n  floats = floats.filter(function(f){ f.l -= dt; var s = toScreen(f.x, heightAt(f.x, f.z) + 6 + (1.6 - f.l) * 4, f.z); if (s){ ux.font = '800 13px -apple-system,system-ui,sans-serif'; ux.textAlign = 'center'; ux.fillStyle = 'rgba(255,215,122,' + Math.min(1, f.l) + ')'; ux.fillText(f.t, s[0], s[1]); } return f.l > 0; });\n  if (boxSel){ ux.strokeStyle = '#7cf7b0'; ux.lineWidth = 1.5; ux.fillStyle = 'rgba(124,247,176,.12)'; var x0 = Math.min(boxSel.x0, boxSel.x1), y0 = Math.min(boxSel.y0, boxSel.y1); ux.fillRect(x0, y0, Math.abs(boxSel.x1 - boxSel.x0), Math.abs(boxSel.y1 - boxSel.y0)); ux.strokeRect(x0, y0, Math.abs(boxSel.x1 - boxSel.x0), Math.abs(boxSel.y1 - boxSel.y0)); }\n}\n\n// ===================================================================\n// MINIMAP\n// ===================================================================\nvar mini = document.getElementById('mini'), mx = mini.getContext('2d'), miniBg = null;\nfunction buildMiniBg(){\n  miniBg = document.createElement('canvas'); miniBg.width = miniBg.height = 132; var c = miniBg.getContext('2d'), img = c.createImageData(132, 132);\n  for (var j = 0; j < 132; j++) for (var i = 0; i < 132; i++){\n    var x = i / 132 * WM, z = j / 132 * HM, h = heightAt(x, z), o = (j * 132 + i) * 4, col;\n    var cc = cellOf(x, z);\n    if (h < -0.3) col = [40, 100, 140]; else if (!PASS[cidx(cc[0], cc[1])]) col = [130, 118, 108]; else if (z > COASTF(x) - 12 && h < 1.4) col = [220, 196, 140]; else col = [110 + h * 6, 140 + h * 4, 70];\n    img.data[o] = col[0]; img.data[o + 1] = col[1]; img.data[o + 2] = col[2]; img.data[o + 3] = 255;\n  }\n  c.putImageData(img, 0, 0);\n}\nfunction drawMini(){\n  var S = mini.width / WM; mx.setTransform(1, 0, 0, 1, 0, 0); mx.clearRect(0, 0, mini.width, mini.height);\n  mx.drawImage(miniBg, 0, 0, mini.width, mini.height);\n  mx.fillStyle = '#ffd24a'; heaps.forEach(function(h){ if (h.amount > 0) mx.fillRect(h.x * S - 2, h.z * S - 2, 4, 4); });\n  blds.forEach(function(b){ if (b.dead) return; mx.fillStyle = b.team ? '#ff4a3a' : '#4a8cff'; mx.fillRect(b.cx * CELL * S, b.cz * CELL * S, b.w * CELL * S, b.d * CELL * S); });\n  units.forEach(function(u){ if (u.dead) return; mx.fillStyle = u.team ? '#ff8a7a' : (sel.indexOf(u) >= 0 ? '#c8ffde' : '#9cc4ff'); mx.fillRect(u.x * S - 3, u.z * S - 3, 6, 6); });\n  // view rectangle from the four screen corners\n  var cs = [[0, 0], [W, 0], [W, H], [0, H]].map(function(p){ return groundAt(p[0], p[1]) || [cam.x, cam.z - 120]; });\n  mx.strokeStyle = 'rgba(255,255,255,.9)'; mx.lineWidth = 2; mx.beginPath(); cs.forEach(function(c, i){ i ? mx.lineTo(c[0] * S, c[1] * S) : mx.moveTo(c[0] * S, c[1] * S); }); mx.closePath(); mx.stroke();\n}\n\n// ===================================================================\n// INPUT\n// ===================================================================\nvar ptrs = {}, gesture = null, boxMode = false, lastTap = { t: 0, id: 0 }, hoverCell = null, isMouse = false;\nui.addEventListener('contextmenu', function(e){ e.preventDefault(); });\nui.addEventListener('pointerdown', function(e){\n  if (state !== 'play') return;\n  audioInit();\n  isMouse = e.pointerType === 'mouse';\n  ptrs[e.pointerId] = { x: e.clientX, y: e.clientY, x0: e.clientX, y0: e.clientY, b: e.button, moved: false, t: performance.now() };\n  try { ui.setPointerCapture(e.pointerId); } catch (er) {}\n  var ids = Object.keys(ptrs);\n  if (ids.length === 2){ var a = ptrs[ids[0]], b = ptrs[ids[1]]; gesture = { d0: Math.hypot(a.x - b.x, a.y - b.y), cd: cam.d, mx: (a.x + b.x) / 2, my: (a.y + b.y) / 2 }; boxSel = null; }\n});\nui.addEventListener('pointermove', function(e){\n  if (state !== 'play') return;\n  if (e.pointerType === 'mouse' && placing){ var g0 = groundAt(e.clientX, e.clientY); if (g0) updateGhost(g0[0], g0[1]); }\n  var p = ptrs[e.pointerId]; if (!p) return;\n  var dx = e.clientX - p.x, dy = e.clientY - p.y; p.x = e.clientX; p.y = e.clientY;\n  if (Math.hypot(p.x - p.x0, p.y - p.y0) > 9) p.moved = true;\n  var ids = Object.keys(ptrs);\n  if (ids.length >= 2 && gesture){\n    var a = ptrs[ids[0]], b = ptrs[ids[1]], d = Math.hypot(a.x - b.x, a.y - b.y), mxp = (a.x + b.x) / 2, myp = (a.y + b.y) / 2;\n    cam.d = clamp(gesture.cd * gesture.d0 / Math.max(20, d), 34, 150);\n    pan(mxp - gesture.mx, myp - gesture.my); gesture.mx = mxp; gesture.my = myp; return;\n  }\n  if (!p.moved) return;\n  var boxing = (boxMode && !isMouse) || (isMouse && p.b === 0 && !placing);\n  if (boxing){ boxSel = { x0: p.x0, y0: p.y0, x1: p.x, y1: p.y }; }\n  else if (p.b !== 2) pan(dx, dy);\n});\nfunction pan(dx, dy){ var k = cam.d / H * 1.15; cam.x -= dx * k; cam.z -= dy * k / Math.sin(PITCH) * .9; if (placing && !isMouse) ghostToCenter(); }\nfunction ptrEnd(e){\n  var p = ptrs[e.pointerId]; if (!p) return; delete ptrs[e.pointerId];\n  if (Object.keys(ptrs).length < 2) gesture = null;\n  if (state !== 'play') return;\n  if (boxSel){ finishBox(); boxSel = null; return; }\n  if (!p.moved && e.type === 'pointerup' && Object.keys(ptrs).length === 0) onTap(e.clientX, e.clientY, p.b === 2);\n}\nui.addEventListener('pointerup', ptrEnd); ui.addEventListener('pointercancel', ptrEnd);\nui.addEventListener('wheel', function(e){ e.preventDefault(); cam.d = clamp(cam.d * (1 + e.deltaY * .0012), 34, 150); }, { passive: false });\nfunction finishBox(){\n  var x0 = Math.min(boxSel.x0, boxSel.x1), x1 = Math.max(boxSel.x0, boxSel.x1), y0 = Math.min(boxSel.y0, boxSel.y1), y1 = Math.max(boxSel.y0, boxSel.y1);\n  var got = units.filter(function(u){ if (u.dead || u.team !== 0) return false; var s = toScreen(u.x, heightAt(u.x, u.z) + 1, u.z); return s && s[0] >= x0 && s[0] <= x1 && s[1] >= y0 && s[1] <= y1; });\n  if (got.some(function(u){ return UT[u.type].w; })) got = got.filter(function(u){ return UT[u.type].w; });\n  sel = got; selB = null; if (got.length){ sfx('click'); haptic('selection'); }\n  updateSelUI();\n}\nfunction onTap(sx, sy, right){\n  if (placing){ var g0 = groundAt(sx, sy); if (!g0) return; if (isMouse){ updateGhost(g0[0], g0[1]); tryPlace(); } else { updateGhost(g0[0], g0[1]); } return; }\n  var e = pickEntity(sx, sy), mine = sel.filter(function(u){ return !u.dead; });\n  if (!right && e && e.team === 0 && e.kind === 'unit'){\n    var now = performance.now();\n    if (now - lastTap.t < 380 && lastTap.type === e.type){ sel = units.filter(function(u){ if (u.dead || u.team !== 0 || u.type !== e.type) return false; var s = toScreen(u.x, heightAt(u.x, u.z), u.z); return s && s[0] > 0 && s[0] < W && s[1] > 0 && s[1] < H; }); }\n    else sel = [e];\n    lastTap = { t: now, type: e.type }; selB = null; sfx('click'); haptic('selection'); updateSelUI(); return;\n  }\n  if (!right && e && e.team === 0 && e.kind === 'bld'){ sel = []; selB = e; sfx('click'); haptic('selection'); updateSelUI(); return; }\n  if (mine.length){\n    if (e && e.team === 1){ orderAttack(mine, e); marker = { x: e.x, z: e.z, l: .7, atk: true }; sfx('ack'); haptic('light'); return; }\n    if (e && e.kind === 'heap' && mine.some(function(u){ return u.type === 'salvager'; })){ orderHarvest(mine, e); var rest = mine.filter(function(u){ return u.type !== 'salvager'; }); if (rest.length) orderMove(rest, e.x, e.z, false); marker = { x: e.x, z: e.z, l: .7 }; sfx('ack'); return; }\n    var g = groundAt(sx, sy); if (!g) return;\n    orderMove(mine, g[0], g[1], false); marker = { x: g[0], z: g[1], l: .7 }; sfx('ack'); haptic('light');\n    return;\n  }\n  if (selB && selB.type === 'factory' && !right){ var gr = groundAt(sx, sy); if (gr){ teams[0].rally = gr; marker = { x: gr[0], z: gr[1], l: .7 }; toast('Rally point set'); return; } }\n  sel = []; selB = null; updateSelUI();\n}\nmini.addEventListener('pointerdown', function(e){ e.preventDefault(); var r = mini.getBoundingClientRect(); cam.x = (e.clientX - r.left) / r.width * WM; cam.z = (e.clientY - r.top) / r.height * HM + cam.d * .25; if (placing && !isMouse) ghostToCenter(); });\nvar keys = {};\nwindow.addEventListener('keydown', function(e){\n  keys[e.code] = true;\n  if (state === 'play'){\n    if (e.code === 'Escape'){ if (placing) cancelPlace(); else pause(); }\n    if (e.code === 'KeyA' && !e.repeat) selectArmy();\n    if (e.code === 'KeyS' && !e.repeat) stopSel();\n  } else if (state === 'paused' && e.code === 'Escape') resume();\n});\nwindow.addEventListener('keyup', function(e){ keys[e.code] = false; });\nfunction keyPan(dt){ var s = cam.d * 1.1 * dt; if (keys.KeyW || keys.ArrowUp) cam.z -= s; if (keys.ArrowDown) cam.z += s; if (keys.KeyD || keys.ArrowRight) cam.x += s; if (keys.ArrowLeft) cam.x -= s; }\nfunction selectArmy(){ sel = teamUnits(0).filter(function(u){ return UT[u.type].w || UT[u.type].fix; }); selB = null; updateSelUI(); sfx('click'); haptic('selection'); if (!sel.length) toast('No fighting units yet'); }\nfunction stopSel(){ sel.forEach(function(u){ u.path = null; u.order = 'idle'; u.tgt = null; }); }\n\n// ---------- placement ----------\nfunction updateGhost(x, z){ var B = BT[placing.type]; var c = cellOf(x - (B.w - 1) * CELL / 2, z - (B.d - 1) * CELL / 2); placing.cell = c; placing.ok = canPlace(0, placing.type, c[0], c[1], false); }\nfunction ghostToCenter(){ var g = groundAt(W / 2, H * .45); if (g) updateGhost(g[0], g[1]); }\nfunction enterPlace(type){ placing = { type: type, cell: null, ok: false }; show('place'); hide('bar'); if (!isMouse) ghostToCenter(); toast('Pan to a spot near your base, then tap Place here'); }\nfunction cancelPlace(){ placing = null; hide('place'); show('bar'); }\nfunction tryPlace(){\n  if (!placing || !placing.cell) return;\n  if (!placing.ok){ toast('Can’t build there. Keep it near your base, on clear flat ground', true); sfx('err'); return; }\n  addBuilding(0, placing.type, placing.cell[0], placing.cell[1], false); teams[0].bq = null; sfx('place'); haptic('success'); cancelPlace(); refreshBar(true);\n}\ndocument.getElementById('placeOk').addEventListener('click', function(){ tryPlace(); });\ndocument.getElementById('placeNo').addEventListener('click', function(){ cancelPlace(); });\n\n// ===================================================================\n// UI: build bar, toasts, selection\n// ===================================================================\nvar el = function(id){ return document.getElementById(id); };\nfunction show(id){ el(id).classList.remove('hidden'); }\nfunction hide(id){ el(id).classList.add('hidden'); }\nvar toastT = 0;\nfunction toast(t, warn){ var d = el('toast'); d.textContent = t; d.className = 'on' + (warn ? ' warn' : ''); clearTimeout(toastT); toastT = setTimeout(function(){ d.className = ''; }, 2200); }\nvar ITEMS = [{ k: 'smelter', b: 1 }, { k: 'factory', b: 1 }, { k: 'turret', b: 1 }, { k: 'techlab', b: 1 }, { k: 'missile', b: 1 }, { sep: 1 }, { k: 'salvager' }, { k: 'buggy' }, { k: 'tank' }, { k: 'rocket' }, { k: 'repair' }, { k: 'heavy' }, { k: 'rail' }];\nvar bbEls = {};\nfunction buildBar(){\n  var wrap = el('build'); wrap.innerHTML = '';\n  ITEMS.forEach(function(it){\n    if (it.sep){ var s = document.createElement('div'); s.className = 'sep'; wrap.appendChild(s); return; }\n    var D = it.b ? BT[it.k] : UT[it.k], b = document.createElement('button'); b.className = 'bb';\n    if (PORTRAITS[it.k]) b.style.backgroundImage = 'url(' + PORTRAITS[it.k] + ')';\n    b.innerHTML = '<div class=\"pr\"></div><div class=\"nm\">' + D.name.replace('Scout ', '').replace('Battle ', '').replace('Gun ', '').replace(' Truck', '').replace('Missile Tower', 'Missiles').replace(' Tank', '') + '</div><div class=\"cs\">' + D.cost + '</div><div class=\"q\" style=\"display:none\"></div><div class=\"rd\">PLACE</div>';\n    b.addEventListener('click', function(){ audioInit(); onBuildTap(it); });\n    wrap.appendChild(b); bbEls[it.k] = b;\n  });\n}\nfunction onBuildTap(it){\n  var tm = teams[0];\n  if (it.b){\n    if (tm.bq && tm.bq.type === it.k && tm.bq.ready){ enterPlace(it.k); return; }\n    if (tm.bq){ toast(tm.bq.ready ? 'Place the ' + BT[tm.bq.type].name + ' first' : 'Already building the ' + BT[tm.bq.type].name, true); sfx('err'); return; }\n    var r = startBuild(0, it.k);\n    if (r === 'money'){ toast('Not enough credits', true); sfx('err'); }\n    else if (r === 'needs'){ toast('Needs a ' + BT[BT[it.k].needs].name + ' first', true); sfx('err'); }\n    else if (r === 'nohq'){ toast('Your HQ is gone. You can’t build structures', true); sfx('err'); }\n    else { sfx('click'); haptic('selection'); }\n  } else {\n    var r2 = startUnit(0, it.k);\n    if (r2 === 'money'){ toast('Not enough credits', true); sfx('err'); }\n    else if (r2 === 'needs'){ toast('Build a Factory first', true); sfx('err'); }\n    else if (r2 === 'needs2'){ toast('Needs a ' + BT[UT[it.k].needs].name + ' first', true); sfx('err'); }\n    else if (r2 === 'full'){ toast('Factory queue is full', true); sfx('err'); }\n    else { sfx('click'); haptic('selection'); }\n  }\n  refreshBar(true);\n}\nvar barT = 0;\nfunction refreshBar(force){\n  barT -= 1; if (!force && barT > 0) return; barT = 6;\n  var tm = teams[0];\n  ITEMS.forEach(function(it){\n    if (it.sep) return;\n    var b = bbEls[it.k], D = it.b ? BT[it.k] : UT[it.k], lock = false, prog = 0, qn = 0, ready = false;\n    if (it.b){ lock = !teamBlds(0, 'hq').length || (D.needs && !teamBlds(0, D.needs).length); if (tm.bq && tm.bq.type === it.k){ prog = tm.bq.t / tm.bq.total; ready = tm.bq.ready; } }\n    else { lock = !teamBlds(0, 'factory').length || (D.needs && !teamBlds(0, D.needs).length); qn = tm.uq.filter(function(q){ return q.type === it.k; }).length; if (tm.uq.length && tm.uq[0].type === it.k) prog = tm.uq[0].t / tm.uq[0].total; }\n    b.classList.toggle('lock', !!lock); b.classList.toggle('ready', ready);\n    b.querySelector('.pr').style.height = (prog > 0 && !ready ? Math.round((1 - prog) * 100) : 0) + '%';\n    var qe = b.querySelector('.q'); qe.style.display = qn ? 'block' : 'none'; qe.textContent = qn;\n  });\n}\nfunction updateSelUI(){\n  var s = el('sel');\n  var live = sel.filter(function(u){ return !u.dead; });\n  if (live.length){ var c = {}; live.forEach(function(u){ c[UT[u.type].name] = (c[UT[u.type].name] || 0) + 1; }); s.textContent = Object.keys(c).map(function(k){ return c[k] + ' ' + k + (c[k] > 1 ? 's' : ''); }).join(' · '); show('sel'); }\n  else if (selB && !selB.dead){ s.textContent = BT[selB.type].name + ' · ' + Math.ceil(selB.hp) + '/' + selB.max + (selB.type === 'factory' ? ' · tap ground to set rally' : ''); show('sel'); }\n  else hide('sel');\n}\nel('aArmy').addEventListener('click', selectArmy);\nel('aStop').addEventListener('click', function(){ stopSel(); sfx('click'); });\nel('aBox').addEventListener('click', function(){ boxMode = !boxMode; el('aBox').classList.toggle('on', boxMode); haptic('selection'); if (boxMode) toast('Drag to box-select. Tap Box again to pan'); });\n\n// ===================================================================\n// AUDIO (synthesized)\n// ===================================================================\nvar AU = { ctx: null };\nfunction audioInit(){\n  if (AU.ctx){ if (AU.ctx.state !== 'running') AU.ctx.resume(); return; }\n  var AC = window.AudioContext || window.webkitAudioContext; if (!AC) return;\n  try { AU.ctx = new AC(); } catch (e) { return; }\n  var ctx = AU.ctx;\n  try { var b = ctx.createBuffer(1, 1, 22050), s0 = ctx.createBufferSource(); s0.buffer = b; s0.connect(ctx.destination); s0.start(0); } catch (e) {}\n  AU.master = ctx.createGain(); AU.master.gain.value = .8; AU.master.connect(ctx.destination);\n  AU.sfx = ctx.createGain(); AU.sfx.gain.value = .8; AU.sfx.connect(AU.master);\n  AU.music = ctx.createGain(); AU.music.gain.value = SET.music ? .26 : 0; AU.music.connect(AU.master);\n  var nb = ctx.createBuffer(1, ctx.sampleRate * 2, ctx.sampleRate), nd = nb.getChannelData(0); for (var i = 0; i < nd.length; i++) nd[i] = Math.random() * 2 - 1; AU.noise = nb;\n  AU.mNext = ctx.currentTime + .1; AU.mStep = 0; AU.last = {};\n}\nfunction env(g, t, a, peak, d){ g.gain.setValueAtTime(.0001, t); g.gain.exponentialRampToValueAtTime(peak, t + a); g.gain.exponentialRampToValueAtTime(.0001, t + a + d); }\nfunction tone(type, f, t, dur, vol, dest, f2){ var c = AU.ctx, o = c.createOscillator(), g = c.createGain(); o.type = type; o.frequency.setValueAtTime(f, t); if (f2) o.frequency.exponentialRampToValueAtTime(f2, t + dur); o.connect(g); g.connect(dest || AU.sfx); env(g, t, .005, vol, dur); o.start(t); o.stop(t + dur + .05); }\nfunction noise(t, dur, vol, type, freq, dest){ var c = AU.ctx, s = c.createBufferSource(), f = c.createBiquadFilter(), g = c.createGain(); s.buffer = AU.noise; f.type = type; f.frequency.value = freq; s.connect(f); f.connect(g); g.connect(dest || AU.sfx); env(g, t, .003, vol, dur); s.start(t, Math.random()); s.stop(t + dur + .05); }\nfunction sfx(k, x, z, amt){\n  if (!AU.ctx || AU.ctx.state !== 'running' || AIBOTH) return;\n  var t = AU.ctx.currentTime, vol = 1;\n  if (x !== undefined){ var d = Math.hypot(x - cam.x, z - cam.z); vol = clamp(1.2 - d / (cam.d * 1.8), 0, 1); if (vol <= 0.02) return; }\n  var lastK = AU.last[k] || 0; if (t - lastK < (k === 'mg' ? .07 : .03)) return; AU.last[k] = t;\n  if (k === 'mg') noise(t, .05, .12 * vol, 'bandpass', 2400);\n  else if (k === 'shell'){ noise(t, .25, .35 * vol, 'lowpass', 700); tone('sine', 120, t, .2, .25 * vol, null, 50); }\n  else if (k === 'rocket'){ noise(t, .6, .2 * vol, 'bandpass', 900); }\n  else if (k === 'hit') noise(t, .18, .2 * vol, 'lowpass', 900);\n  else if (k === 'rail'){ tone('sawtooth', 1600, t, .35, .12 * vol, null, 120); noise(t, .2, .25 * vol, 'highpass', 3000); }\n  else if (k === 'missile'){ noise(t, .5, .16 * vol, 'bandpass', 1300); }\n  else if (k === 'boom'){ noise(t, .9 * (amt || 1), .5 * vol, 'lowpass', 380); tone('sine', 90, t, .5, .35 * vol, null, 35); }\n  else if (k === 'click') tone('triangle', 900, t, .05, .08);\n  else if (k === 'ack'){ tone('triangle', 660, t, .06, .08); tone('triangle', 880, t + .06, .06, .08); }\n  else if (k === 'ready'){ tone('triangle', 784, t, .12, .12); tone('triangle', 1046, t + .12, .2, .12); }\n  else if (k === 'place'){ noise(t, .3, .25, 'lowpass', 500); tone('triangle', 520, t + .05, .2, .12); }\n  else if (k === 'err') tone('square', 180, t, .14, .07);\n  else if (k === 'alert'){ tone('square', 740, t, .12, .08); tone('square', 740, t + .2, .12, .08); }\n}\nvar CH = [[45, 52, 57, 60], [41, 48, 53, 57], [43, 50, 55, 59], [40, 47, 52, 56]];\nfunction musicTick(){\n  var c = AU.ctx; if (!c || c.state !== 'running') return;\n  AU.music.gain.setTargetAtTime(SET.music ? (state === 'menu' ? .3 : .18) : 0, c.currentTime, .4);\n  if (!SET.music) return;\n  if (AU.mNext < c.currentTime) AU.mNext = c.currentTime + .05;\n  var M = function(m){ return 440 * Math.pow(2, (m - 69) / 12); };\n  while (AU.mNext < c.currentTime + .2){\n    var s = AU.mStep, bar = Math.floor(s / 16) % 4, st = s % 16, ch = CH[bar], t = AU.mNext;\n    if (st % 8 === 0) tone('sine', 110, t, .35, .45, AU.music, 40);\n    if (st === 4 || st === 12) noise(t, .12, .12, 'bandpass', 1500, AU.music);\n    if (st % 4 === 2) noise(t, .03, .05, 'highpass', 7000, AU.music);\n    if (st % 4 === 0) tone('triangle', M(ch[0] - 12), t, .5, .28, AU.music);\n    if (st === 0) for (var k = 1; k < 4; k++) tone('sawtooth', M(ch[k]), t, 2.6, .02, AU.music);\n    if (Math.floor(s / 64) % 2 && st % 2 === 0) tone('square', M(ch[(st / 2) % 4] + 12), t, .1, .03, AU.music);\n    AU.mStep = (s + 1) % 256; AU.mNext += 60 / 92 / 4;\n  }\n}\n\n// ===================================================================\n// FLOW\n// ===================================================================\nfunction startGame(){\n  audioInit(); haptic('selection');\n  mapSeed = SET.map === 0 ? 1 : (Date.now() % 100000) + 2;\n  EID = 0; units = []; blds = []; shots = []; parts = []; wrecks = []; floats = []; sel = []; selB = null; placing = null; gameT = 0;\n  genMap(mapSeed);\n  teams = [newTeam(0), newTeam(1)];\n  BASES.forEach(function(B, t){\n    var c = cellOf(B[0] - CELL * 1.5, B[1] - CELL * 1.5); addBuilding(t, 'hq', c[0], c[1], true);\n    var hq = blds[blds.length - 1];\n    for (var k = 0; k < 2; k++){ var dk = nearestWalk(c[0] + (t ? -2 : 4), c[1] + (t ? 4 : -2) + k * 2, 6); spawnUnit(t, 'buggy', null, (dk[0] + .5) * CELL, (dk[1] + .5) * CELL); }\n  });\n  WORLDDATA = buildWorld(); if (R.world) gl.deleteBuffer(R.world.b); R.world = vbo(WORLDDATA);\n  buildMiniBg();\n  cam.x = BASES[0][0] + 18; cam.z = BASES[0][1] + 6; cam.d = 80;\n  hide('menu'); hide('endOv'); hide('pauseOv'); show('top'); show('bar'); show('mini'); hide('place');\n  buildBar(); refreshBar(true); updateSelUI();\n  state = 'play'; immersive(true);\n  toast('Build a Smelter to start salvaging');\n}\nfunction endGame(win){\n  state = 'over'; immersive(false); hide('bar'); hide('place'); hide('sel');\n  var tm = teams[0], D = DIFF[SET.diff];\n  REC.played++;\n  var newBest = false;\n  if (win){ REC.wins[SET.diff]++; if (!REC.best[SET.diff] || gameT < REC.best[SET.diff]){ REC.best[SET.diff] = gameT; newBest = true; } }\n  store.setItem('is.records', JSON.stringify(REC));\n  el('endTag').textContent = win ? D.name + ' opponent defeated' : 'The Rust Syndicate holds the coast';\n  el('endTitle').textContent = win ? 'Victory' : 'Defeat';\n  el('endList').innerHTML = '<p><span>Time</span><span>' + fmt(gameT) + (newBest ? ' · best' : '') + '</span></p><p><span>Credits salvaged</span><span>' + tm.earned.toLocaleString() + '</span></p>' +\n    '<p><span>Units and buildings made</span><span>' + tm.built + '</span></p><p><span>Enemy destroyed</span><span>' + tm.kills + '</span></p><p><span>Losses</span><span>' + tm.lost + '</span></p>';\n  setTimeout(function(){ show('endOv'); }, 1400);\n  sfx(win ? 'ready' : 'alert'); haptic(win ? 'success' : 'light');\n}\nfunction fmt(t){ var m = Math.floor(t / 60), s = Math.floor(t % 60); return m + ':' + (s < 10 ? '0' : '') + s; }\nfunction toMenu(){ state = 'menu'; immersive(false); ['top', 'bar', 'mini', 'place', 'sel', 'pauseOv', 'endOv'].forEach(hide); show('menu'); refreshMenu(); }\nfunction pause(){ if (state !== 'play') return; state = 'paused'; show('pauseOv'); if (AU.ctx) AU.ctx.suspend(); immersive(false); }\nfunction resume(){ if (state !== 'paused') return; state = 'play'; hide('pauseOv'); if (AU.ctx) AU.ctx.resume(); immersive(true); last = 0; }\nel('menuBtn').addEventListener('click', pause);\nel('pResume').addEventListener('click', resume);\nel('pRestart').addEventListener('click', function(){ if (AU.ctx) AU.ctx.resume(); startGame(); });\nel('pQuit').addEventListener('click', function(){ if (AU.ctx) AU.ctx.resume(); toMenu(); });\nel('goPlay').addEventListener('click', startGame);\nel('goHelp').addEventListener('click', function(){ el('helpBox').classList.toggle('hidden'); });\nel('eAgain').addEventListener('click', startGame);\nel('eMenu').addEventListener('click', toMenu);\nel('tgMusic').addEventListener('click', function(){ SET.music = !SET.music; audioInit(); saveSet(); refreshMenu(); });\nfunction saveSet(){ store.setItem('is.settings', JSON.stringify(SET)); }\nfunction refreshMenu(){\n  var dr = el('diffRow'); dr.innerHTML = '';\n  DIFF.forEach(function(D, i){ var b = document.createElement('button'); b.className = 'tg' + (i === SET.diff ? ' on' : ''); b.textContent = D.name; b.addEventListener('click', function(){ SET.diff = i; saveSet(); refreshMenu(); haptic('selection'); }); dr.appendChild(b); });\n  var mr = el('mapRow'); mr.innerHTML = '';\n  ['Breakwater', 'Random coast'].forEach(function(n, i){ var b = document.createElement('button'); b.className = 'tg' + (i === SET.map ? ' on' : ''); b.textContent = n; b.addEventListener('click', function(){ SET.map = i; saveSet(); refreshMenu(); haptic('selection'); }); mr.appendChild(b); });\n  el('tgMusic').classList.toggle('on', SET.music);\n  var w = REC.wins; el('recLine').textContent = REC.played ? ('Wins: Easy ' + w[0] + ' · Normal ' + w[1] + ' · Hard ' + w[2] + (REC.best[SET.diff] ? ' · fastest ' + DIFF[SET.diff].name.toLowerCase() + ' win ' + fmt(REC.best[SET.diff]) : '')) : '';\n}\ndocument.addEventListener('visibilitychange', function(){ if (document.hidden && state === 'play') pause(); });\n\n// ===================================================================\n// LOOP\n// ===================================================================\nvar last = 0, acc = 0, uiT = 0, endCheck = 0;\nfunction simTick(dt){\n  gameT += dt;\n  for (var t = 0; t < 2; t++){ stepProduction(t, dt); if (teams[t].ai || AIBOTH) aiThink(t, dt); }\n  for (var i = 0; i < units.length; i++) if (!units[i].dead) stepUnit(units[i], dt);\n  separate();\n  for (i = 0; i < blds.length; i++) if (!blds[i].dead) stepBuilding(blds[i], dt);\n  stepShots(dt);\n  units = units.filter(function(u){ return !u.dead; }); blds = blds.filter(function(b){ return !b.dead; });\n  wrecks.forEach(function(w){ w.t += dt; }); if (wrecks.length && wrecks[0].t > 45) wrecks = wrecks.filter(function(w){ return w.t < 45; });\n  endCheck -= dt;\n  if (endCheck <= 0){ endCheck = .5;\n    var a0 = blds.some(function(b){ return b.team === 0; }), a1 = blds.some(function(b){ return b.team === 1; });\n    if (!a1 && state === 'play') endGame(true); else if (!a0 && state === 'play') endGame(false);\n  }\n}\nfunction separate(){\n  for (var i = 0; i < units.length; i++){ var a = units[i]; if (a.dead) continue;\n    for (var j = i + 1; j < units.length; j++){ var b = units[j]; if (b.dead) continue;\n      var dx = b.x - a.x, dz = b.z - a.z, rr = UT[a.type].r + UT[b.type].r, d2 = dx * dx + dz * dz;\n      if (d2 < rr * rr && d2 > 1e-4){\n        var d = Math.sqrt(d2), push = (rr - d) * .5, nx = dx / d, nz = dz / d;\n        var am = a.path && a.pi < a.path.length, bm = b.path && b.pi < b.path.length, ka = am && !bm ? .25 : bm && !am ? .75 : .5;\n        tryMove(a, -nx * push * 2 * (1 - ka), -nz * push * 2 * (1 - ka)); tryMove(b, nx * push * 2 * ka, nz * push * 2 * ka);\n      }\n    }\n  }\n}\nfunction tryMove(u, dx, dz){ var c = cellOf(u.x + dx, u.z + dz); if (walk(c[0], c[1])){ u.x += dx; u.z += dz; } }\nfunction frame(ts){\n  requestAnimationFrame(frame);\n  var dt = last ? Math.min(.1, (ts - last) / 1000) : 0; last = ts;\n  if (state === 'play' || state === 'over'){\n    acc += dt; var guard = 0;\n    while (acc >= TICK && guard++ < 6){ simTick(TICK); acc -= TICK; }\n    if (guard >= 6) acc = 0;\n    keyPan(dt); stepParts(dt);\n    uiT -= dt;\n    if (uiT <= 0 && state === 'play'){ uiT = .15; el('crv').textContent = Math.floor(teams[0].credits).toLocaleString(); el('clock').textContent = fmt(gameT); refreshBar(true); updateSelUI(); drawMini(); }\n  } else if (state === 'menu'){ cam.x += Math.cos(ts / 9000) * dt * 4; cam.z += Math.sin(ts / 7000) * dt * 3; stepParts(dt); }\n  if (state !== 'boot' && WORLDDATA){ render(dt); }\n  musicTick();\n}\nfunction boot(){\n  mapSeed = 1; genMap(1); teams = [newTeam(0), newTeam(1)];\n  buildMeshes(); WORLDDATA = buildWorld();\n  BASES.forEach(function(B, t){ var c = cellOf(B[0] - CELL * 1.5, B[1] - CELL * 1.5); addBuilding(t, 'hq', c[0], c[1], true); });\n  try { initGL(); } catch (e) { var er = document.createElement('div'); er.id = 'err'; er.textContent = 'Graphics error: ' + e.message; document.body.appendChild(er); return; }\n  if (TITLE_URI) el('menu').style.setProperty('--title', 'url(' + TITLE_URI + ')');\n  cam.x = 160; cam.z = 170; cam.d = 120;\n  Promise.all([store.getItem('is.settings'), store.getItem('is.records')]).then(function(v){\n    try { if (v[0]) Object.assign(SET, JSON.parse(v[0])); } catch (e) {}\n    try { if (v[1]) Object.assign(REC, JSON.parse(v[1])); } catch (e) {}\n  }).catch(function(){}).then(function(){ toMenu(); });\n  requestAnimationFrame(frame);\n}\nwindow.__isProj = function(id){ var u = units.find(function(x){ return x.id === id; }); return toScreen(u.x, heightAt(u.x, u.z) + 1, u.z); };\nwindow.__is = { get state(){ return state; }, get teams(){ return teams; }, get units(){ return units; }, get blds(){ return blds; }, get heaps(){ return heaps; }, get t(){ return gameT; },\n  set both(v){ AIBOTH = !!v; teams.forEach(function(t, i){ t.ai = AIBOTH || i === 1; }); }, start: function(){ startGame(); }, sim: function(sec){ for (var i = 0; i < sec / TICK && state !== 'over'; i++) simTick(TICK); },\n  cam: cam, set diff(v){ SET.diff = v; }, spawn: function(t, ty, x, z){ var u = spawnUnit(t, ty, null, x, z); u.h = u.th = PI / 2 + .5; return u; } };\nboot();\n})();\n</script>\n</body></html>\n"}