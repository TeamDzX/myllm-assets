{"name": "Cursive", "kind": "html", "iconSymbol": "signature", "iconColor": "teal", "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Cursive</title>\n<style>\n:root{color-scheme:light;--paper:#faf8f3;--card:#ffffff;--ink:#2c2b33;--mut:#98928a;--line:#e8e3da;\n  --teal:#3eb8ac;--pink:#f26d9a;--gold:#e8b64c}\n*{box-sizing:border-box;margin:0}\nhtml,body{height:100%}\nbody{font-family:-apple-system,system-ui,sans-serif;background:var(--paper);color:var(--ink);\n  position:fixed;inset:0;width:100%;height:100dvh;overflow:hidden;display:flex;flex-direction:column;\n  -webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none}\n.top{padding:calc(14px + env(safe-area-inset-top)) 20px 8px;display:flex;align-items:baseline;gap:10px}\nh1{font-size:26px;font-weight:800;letter-spacing:-.02em}\nh1 i{font-style:italic;background:linear-gradient(90deg,var(--teal),var(--pink));\n  -webkit-background-clip:text;background-clip:text;color:transparent}\n.prog{margin-left:auto;font-size:13px;color:var(--mut);font-weight:700}\n.prog b{color:var(--gold)}\n.tabs{display:flex;gap:8px;padding:6px 20px 10px}\n.tab{flex:1;border:1.5px solid var(--line);background:var(--card);color:var(--mut);border-radius:12px;\n  padding:9px;font-size:16px;font-weight:800;font-style:italic}\n.tab.on{color:var(--teal);border-color:var(--teal);box-shadow:0 2px 10px rgba(62,184,172,.15)}\n#grid{flex:1;overflow-y:auto;padding:4px 16px calc(20px + env(safe-area-inset-bottom));\n  display:grid;grid-template-columns:repeat(4,1fr);gap:10px;align-content:start}\n.lcard{aspect-ratio:1;border:1.5px solid var(--line);background:var(--card);border-radius:16px;\n  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;\n  box-shadow:0 2px 8px rgba(60,50,30,.05)}\n.lcard .g{font-size:30px;font-style:italic;font-weight:600;font-family:\"Snell Roundhand\",\"Savoye LET\",cursive}\n.lcard .s{font-size:10px;letter-spacing:1px;color:var(--gold);min-height:12px}\n.lcard.done{border-color:rgba(232,182,76,.55)}\n/* practice */\n.practice{position:fixed;inset:0;background:var(--paper);display:none;flex-direction:column;z-index:10}\n.practice.on{display:flex}\n.phead{padding:calc(12px + env(safe-area-inset-top)) 16px 6px;display:flex;align-items:center;gap:12px}\n.pletter{font-size:34px;font-family:\"Snell Roundhand\",\"Savoye LET\",cursive;font-weight:600;min-width:44px;text-align:center}\n.phint{flex:1;font-size:12.5px;color:var(--mut);font-weight:600;line-height:1.4}\n.pclose{border:0;background:var(--card);border:1.5px solid var(--line);border-radius:50%;width:36px;height:36px;\n  font-size:16px;color:var(--mut);font-weight:700}\n#wrap{flex:1;display:flex;align-items:center;justify-content:center;min-height:0;padding:8px 14px}\n#pad{background:var(--card);border:1.5px solid var(--line);border-radius:22px;touch-action:none;\n  box-shadow:0 6px 24px rgba(60,50,30,.08);max-width:100%;max-height:100%}\n.pbar{display:flex;gap:9px;padding:10px 16px calc(16px + env(safe-area-inset-bottom))}\n.pbtn{flex:1;border:1.5px solid var(--line);background:var(--card);color:var(--ink);border-radius:13px;\n  padding:13px;font-size:14px;font-weight:700}\n.pbtn.go{background:linear-gradient(135deg,var(--teal),#2f9a90);border:0;color:#fff}\n.pbtn:disabled{opacity:.4}\n.stars{font-size:26px;letter-spacing:4px;text-align:center;color:var(--gold);min-height:32px;padding-top:2px}\n.toast{position:fixed;left:50%;top:26%;transform:translateX(-50%);background:var(--ink);color:#fff;\n  border-radius:12px;padding:9px 18px;font-size:14px;font-weight:700;opacity:0;transition:opacity .25s;\n  pointer-events:none;z-index:40;font-style:italic}\n.toast.on{opacity:1}\n</style></head><body>\n\n<div class=\"top\"><h1>Handwriting · <i>Cursive</i></h1><div class=\"prog\"><b id=\"starCount\">0</b> ★</div></div>\n<div class=\"tabs\">\n  <button class=\"tab on\" id=\"tabLower\">abc</button>\n  <button class=\"tab\" id=\"tabUpper\">ABC</button>\n</div>\n<div id=\"grid\"></div>\n\n<div class=\"practice\" id=\"practice\">\n  <div class=\"phead\">\n    <div class=\"pletter\" id=\"pLetter\">a</div>\n    <div class=\"phint\" id=\"pHint\">Watch the pen, then trace the stroke</div>\n    <button class=\"pclose\" id=\"pClose\">✕</button>\n  </div>\n  <div id=\"wrap\"><canvas id=\"pad\"></canvas></div>\n  <div class=\"stars\" id=\"pStars\"></div>\n  <div class=\"pbar\">\n    <button class=\"pbtn\" id=\"btnDemo\">Show me</button>\n    <button class=\"pbtn\" id=\"btnClear\">Start over</button>\n    <button class=\"pbtn go\" id=\"btnNext\" disabled>Next letter</button>\n  </div>\n</div>\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\n\"use strict\";\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nfunction el(i){return document.getElementById(i)}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k||'light')}catch(e){}}\n\nvar LETTERS=[{\"ch\":\"a\",\"cat\":\"lowercase\",\"strokes\":[[[0.55,0.35],[0.5,0.3],[0.4,0.3],[0.35,0.35],[0.35,0.5],[0.4,0.55],[0.5,0.55],[0.55,0.5]],[[0.55,0.3],[0.55,0.55],[0.6,0.6]]]},{\"ch\":\"b\",\"cat\":\"lowercase\",\"strokes\":[[[0.4,0.2],[0.4,0.55],[0.45,0.6]],[[0.4,0.35],[0.5,0.3],[0.55,0.35],[0.55,0.45],[0.5,0.55],[0.4,0.55]]]},{\"ch\":\"c\",\"cat\":\"lowercase\",\"strokes\":[[[0.55,0.32],[0.48,0.28],[0.4,0.3],[0.35,0.4],[0.35,0.5],[0.4,0.55],[0.48,0.57],[0.55,0.55]]]},{\"ch\":\"d\",\"cat\":\"lowercase\",\"strokes\":[[[0.55,0.35],[0.5,0.3],[0.4,0.3],[0.35,0.4],[0.35,0.5],[0.4,0.55],[0.5,0.55],[0.55,0.5]],[[0.55,0.2],[0.55,0.55],[0.6,0.6]]]},{\"ch\":\"e\",\"cat\":\"lowercase\",\"strokes\":[[[0.35,0.42],[0.55,0.42],[0.55,0.35],[0.48,0.28],[0.4,0.3],[0.35,0.4],[0.35,0.5],[0.4,0.55],[0.5,0.57],[0.58,0.55]]]},{\"ch\":\"f\",\"cat\":\"lowercase\",\"strokes\":[[[0.52,0.22],[0.47,0.18],[0.42,0.22],[0.42,0.55],[0.38,0.65],[0.35,0.7]],[[0.35,0.35],[0.55,0.35]]]},{\"ch\":\"g\",\"cat\":\"lowercase\",\"strokes\":[[[0.55,0.35],[0.5,0.3],[0.4,0.3],[0.35,0.4],[0.35,0.5],[0.4,0.55],[0.5,0.55],[0.55,0.5]],[[0.55,0.3],[0.55,0.65],[0.5,0.72],[0.4,0.72]]]},{\"ch\":\"h\",\"cat\":\"lowercase\",\"strokes\":[[[0.38,0.2],[0.38,0.55],[0.42,0.6]],[[0.38,0.38],[0.45,0.3],[0.55,0.3],[0.58,0.38],[0.58,0.55],[0.62,0.6]]]},{\"ch\":\"i\",\"cat\":\"lowercase\",\"strokes\":[[[0.48,0.32],[0.48,0.55],[0.52,0.6]],[[0.48,0.24],[0.48,0.26]]]},{\"ch\":\"j\",\"cat\":\"lowercase\",\"strokes\":[[[0.52,0.32],[0.52,0.62],[0.48,0.7],[0.4,0.72]],[[0.52,0.24],[0.52,0.26]]]},{\"ch\":\"k\",\"cat\":\"lowercase\",\"strokes\":[[[0.4,0.2],[0.4,0.55],[0.44,0.6]],[[0.55,0.3],[0.4,0.42],[0.55,0.55]]]},{\"ch\":\"l\",\"cat\":\"lowercase\",\"strokes\":[[[0.48,0.2],[0.48,0.55],[0.52,0.6]]]},{\"ch\":\"m\",\"cat\":\"lowercase\",\"strokes\":[[[0.3,0.55],[0.3,0.32],[0.35,0.6]],[[0.3,0.38],[0.38,0.3],[0.45,0.35],[0.45,0.55]],[[0.45,0.38],[0.52,0.3],[0.6,0.35],[0.6,0.55],[0.65,0.6]]]},{\"ch\":\"n\",\"cat\":\"lowercase\",\"strokes\":[[[0.38,0.55],[0.38,0.32],[0.42,0.6]],[[0.38,0.38],[0.48,0.3],[0.57,0.35],[0.57,0.55],[0.62,0.6]]]},{\"ch\":\"o\",\"cat\":\"lowercase\",\"strokes\":[[[0.48,0.28],[0.4,0.3],[0.35,0.4],[0.35,0.5],[0.4,0.57],[0.5,0.57],[0.57,0.5],[0.57,0.4],[0.52,0.3],[0.48,0.28]]]},{\"ch\":\"p\",\"cat\":\"lowercase\",\"strokes\":[[[0.4,0.3],[0.4,0.72]],[[0.4,0.35],[0.5,0.28],[0.57,0.35],[0.57,0.48],[0.5,0.55],[0.4,0.52]]]},{\"ch\":\"q\",\"cat\":\"lowercase\",\"strokes\":[[[0.55,0.35],[0.48,0.28],[0.4,0.3],[0.35,0.4],[0.35,0.5],[0.4,0.55],[0.48,0.55],[0.55,0.5]],[[0.55,0.3],[0.55,0.72],[0.6,0.75]]]},{\"ch\":\"r\",\"cat\":\"lowercase\",\"strokes\":[[[0.4,0.32],[0.4,0.55],[0.44,0.6]],[[0.4,0.38],[0.48,0.3],[0.55,0.32]]]},{\"ch\":\"s\",\"cat\":\"lowercase\",\"strokes\":[[[0.55,0.32],[0.48,0.28],[0.4,0.3],[0.38,0.37],[0.42,0.42],[0.52,0.47],[0.56,0.52],[0.52,0.57],[0.44,0.58],[0.38,0.55]]]},{\"ch\":\"t\",\"cat\":\"lowercase\",\"strokes\":[[[0.47,0.2],[0.47,0.55],[0.52,0.6]],[[0.38,0.35],[0.55,0.35]]]},{\"ch\":\"u\",\"cat\":\"lowercase\",\"strokes\":[[[0.38,0.3],[0.38,0.5],[0.42,0.57],[0.5,0.57],[0.57,0.5]],[[0.57,0.3],[0.57,0.55],[0.62,0.6]]]},{\"ch\":\"v\",\"cat\":\"lowercase\",\"strokes\":[[[0.35,0.3],[0.47,0.57]],[[0.47,0.57],[0.6,0.3]]]},{\"ch\":\"w\",\"cat\":\"lowercase\",\"strokes\":[[[0.28,0.3],[0.35,0.55],[0.43,0.35],[0.5,0.55],[0.58,0.3]]]},{\"ch\":\"x\",\"cat\":\"lowercase\",\"strokes\":[[[0.38,0.3],[0.58,0.57]],[[0.58,0.3],[0.38,0.57]]]},{\"ch\":\"y\",\"cat\":\"lowercase\",\"strokes\":[[[0.38,0.3],[0.48,0.5]],[[0.58,0.3],[0.45,0.55],[0.38,0.7]]]},{\"ch\":\"z\",\"cat\":\"lowercase\",\"strokes\":[[[0.38,0.3],[0.58,0.3],[0.38,0.57],[0.58,0.57]]]},{\"ch\":\"A\",\"cat\":\"uppercase\",\"strokes\":[[[0.3,0.6],[0.47,0.2],[0.65,0.6]],[[0.37,0.45],[0.58,0.45]]]},{\"ch\":\"B\",\"cat\":\"uppercase\",\"strokes\":[[[0.38,0.2],[0.38,0.6]],[[0.38,0.2],[0.52,0.2],[0.58,0.28],[0.52,0.38],[0.38,0.4]],[[0.38,0.4],[0.55,0.4],[0.6,0.5],[0.55,0.58],[0.38,0.6]]]},{\"ch\":\"C\",\"cat\":\"uppercase\",\"strokes\":[[[0.6,0.25],[0.5,0.2],[0.4,0.22],[0.33,0.32],[0.33,0.48],[0.4,0.58],[0.5,0.6],[0.6,0.57]]]},{\"ch\":\"D\",\"cat\":\"uppercase\",\"strokes\":[[[0.38,0.2],[0.38,0.6]],[[0.38,0.2],[0.52,0.2],[0.62,0.3],[0.62,0.5],[0.52,0.6],[0.38,0.6]]]},{\"ch\":\"E\",\"cat\":\"uppercase\",\"strokes\":[[[0.38,0.2],[0.38,0.6]],[[0.38,0.2],[0.6,0.2]],[[0.38,0.4],[0.55,0.4]],[[0.38,0.6],[0.6,0.6]]]},{\"ch\":\"F\",\"cat\":\"uppercase\",\"strokes\":[[[0.38,0.2],[0.38,0.6]],[[0.38,0.2],[0.6,0.2]],[[0.38,0.4],[0.55,0.4]]]},{\"ch\":\"G\",\"cat\":\"uppercase\",\"strokes\":[[[0.6,0.25],[0.5,0.2],[0.4,0.22],[0.33,0.32],[0.33,0.48],[0.4,0.58],[0.5,0.6],[0.6,0.57],[0.6,0.42]],[[0.5,0.42],[0.6,0.42]]]},{\"ch\":\"H\",\"cat\":\"uppercase\",\"strokes\":[[[0.35,0.2],[0.35,0.6]],[[0.6,0.2],[0.6,0.6]],[[0.35,0.4],[0.6,0.4]]]},{\"ch\":\"I\",\"cat\":\"uppercase\",\"strokes\":[[[0.42,0.2],[0.55,0.2]],[[0.485,0.2],[0.485,0.6]],[[0.42,0.6],[0.55,0.6]]]},{\"ch\":\"J\",\"cat\":\"uppercase\",\"strokes\":[[[0.42,0.2],[0.58,0.2]],[[0.52,0.2],[0.52,0.52],[0.47,0.6],[0.38,0.58]]]},{\"ch\":\"K\",\"cat\":\"uppercase\",\"strokes\":[[[0.38,0.2],[0.38,0.6]],[[0.6,0.2],[0.38,0.4]],[[0.44,0.36],[0.6,0.6]]]},{\"ch\":\"L\",\"cat\":\"uppercase\",\"strokes\":[[[0.38,0.2],[0.38,0.6]],[[0.38,0.6],[0.6,0.6]]]},{\"ch\":\"M\",\"cat\":\"uppercase\",\"strokes\":[[[0.3,0.6],[0.3,0.2]],[[0.3,0.2],[0.47,0.48]],[[0.47,0.48],[0.65,0.2]],[[0.65,0.2],[0.65,0.6]]]},{\"ch\":\"N\",\"cat\":\"uppercase\",\"strokes\":[[[0.35,0.6],[0.35,0.2]],[[0.35,0.2],[0.62,0.6]],[[0.62,0.6],[0.62,0.2]]]},{\"ch\":\"O\",\"cat\":\"uppercase\",\"strokes\":[[[0.48,0.2],[0.38,0.22],[0.32,0.32],[0.32,0.48],[0.38,0.58],[0.48,0.6],[0.58,0.58],[0.64,0.48],[0.64,0.32],[0.58,0.22],[0.48,0.2]]]},{\"ch\":\"P\",\"cat\":\"uppercase\",\"strokes\":[[[0.38,0.2],[0.38,0.6]],[[0.38,0.2],[0.52,0.2],[0.6,0.28],[0.6,0.35],[0.52,0.42],[0.38,0.42]]]},{\"ch\":\"Q\",\"cat\":\"uppercase\",\"strokes\":[[[0.48,0.2],[0.38,0.22],[0.32,0.32],[0.32,0.48],[0.38,0.58],[0.48,0.6],[0.58,0.58],[0.64,0.48],[0.64,0.32],[0.58,0.22],[0.48,0.2]],[[0.52,0.5],[0.62,0.65]]]},{\"ch\":\"R\",\"cat\":\"uppercase\",\"strokes\":[[[0.38,0.2],[0.38,0.6]],[[0.38,0.2],[0.52,0.2],[0.6,0.28],[0.6,0.35],[0.52,0.42],[0.38,0.42]],[[0.48,0.42],[0.6,0.6]]]},{\"ch\":\"S\",\"cat\":\"uppercase\",\"strokes\":[[[0.58,0.25],[0.5,0.2],[0.4,0.22],[0.35,0.3],[0.4,0.38],[0.55,0.42],[0.6,0.5],[0.58,0.57],[0.48,0.6],[0.38,0.57]]]},{\"ch\":\"T\",\"cat\":\"uppercase\",\"strokes\":[[[0.32,0.2],[0.65,0.2]],[[0.485,0.2],[0.485,0.6]]]},{\"ch\":\"U\",\"cat\":\"uppercase\",\"strokes\":[[[0.35,0.2],[0.35,0.48],[0.4,0.58],[0.48,0.6],[0.56,0.58],[0.62,0.48],[0.62,0.2]]]},{\"ch\":\"V\",\"cat\":\"uppercase\",\"strokes\":[[[0.32,0.2],[0.48,0.6]],[[0.48,0.6],[0.65,0.2]]]},{\"ch\":\"W\",\"cat\":\"uppercase\",\"strokes\":[[[0.25,0.2],[0.35,0.6],[0.47,0.32],[0.58,0.6],[0.7,0.2]]]},{\"ch\":\"X\",\"cat\":\"uppercase\",\"strokes\":[[[0.35,0.2],[0.62,0.6]],[[0.62,0.2],[0.35,0.6]]]},{\"ch\":\"Y\",\"cat\":\"uppercase\",\"strokes\":[[[0.32,0.2],[0.48,0.4]],[[0.65,0.2],[0.48,0.4]],[[0.48,0.4],[0.48,0.6]]]},{\"ch\":\"Z\",\"cat\":\"uppercase\",\"strokes\":[[[0.35,0.2],[0.62,0.2],[0.35,0.6],[0.62,0.6]]]}];\n\n/* ---- path sampling: identical smoothing to the iOS app (quad through midpoints) ---- */\nfunction sampleStroke(pts,per){\n  per=per||14;\n  if(pts.length<2)return pts.slice();\n  if(pts.length===2){\n    var out=[];for(var t=0;t<=per;t++)out.push([pts[0][0]+(pts[1][0]-pts[0][0])*t/per,pts[0][1]+(pts[1][1]-pts[0][1])*t/per]);\n    return out;\n  }\n  var s=[pts[0].slice()],cur=pts[0];\n  for(var i=1;i<pts.length;i++){\n    if(i<pts.length-1){\n      var mid=[(pts[i][0]+pts[i+1][0])/2,(pts[i][1]+pts[i+1][1])/2];\n      for(var t2=1;t2<=per;t2++){\n        var u=t2/per,a=1-u;\n        s.push([a*a*cur[0]+2*a*u*pts[i][0]+u*u*mid[0], a*a*cur[1]+2*a*u*pts[i][1]+u*u*mid[1]]);\n      }\n      cur=mid;\n    } else { s.push(pts[i].slice()); cur=pts[i]; }\n  }\n  return s;\n}\n\n/* ---- evaluation (ported spirit of StrokeEvaluator: coverage + accuracy) ---- */\nfunction evalStroke(guide,ink){\n  if(ink.length<4)return {cov:0,acc:0,pass:false};\n  var TH_COV=0.10,TH_ACC=0.13;\n  function near(p,arr,th){\n    for(var i=0;i<arr.length;i++){\n      var dx=p[0]-arr[i][0],dy=p[1]-arr[i][1];\n      if(dx*dx+dy*dy<th*th)return true;\n    }\n    return false;\n  }\n  var covHit=0;guide.forEach(function(g){if(near(g,ink,TH_COV))covHit++});\n  var accHit=0,dSum=0;\n  ink.forEach(function(p){\n    if(near(p,guide,TH_ACC))accHit++;\n    var best=1e9;\n    for(var i=0;i<guide.length;i++){\n      var dx=p[0]-guide[i][0],dy=p[1]-guide[i][1],d2=dx*dx+dy*dy;\n      if(d2<best)best=d2;\n    }\n    dSum+=Math.sqrt(best);\n  });\n  var cov=covHit/guide.length,acc=accHit/ink.length,dAvg=dSum/ink.length;\n  /* quality is DISTANCE-based, not hit-based — neat tracing earns the stars */\n  var q=Math.max(0,1-dAvg/0.08);\n  return {cov:cov,acc:acc,q:q,pass:cov>=0.72&&acc>=0.6};\n}\n\n/* ---- state ---- */\nvar tab='lowercase',stars={},cur=null,strokeIdx=0,quals=[],ink=[],drawing=false,demoT=null,earned=null;\nfunction letterList(){return LETTERS.filter(function(l){return l.cat===tab})}\n\n/* ---- grid ---- */\nfunction starStr(n){return n?'★★★'.slice(0,n):''}\nfunction renderGrid(){\n  var g=el('grid');g.innerHTML='';\n  letterList().forEach(function(l){\n    var d=document.createElement('button');d.className='lcard'+(stars[l.ch]?' done':'');\n    d.innerHTML='<span class=\"g\">'+l.ch+'</span><span class=\"s\">'+starStr(stars[l.ch]||0)+'</span>';\n    d.onclick=function(){openPractice(l);haptic('selection')};\n    g.appendChild(d);\n  });\n  var tot=0;for(var k in stars)tot+=stars[k];\n  el('starCount').textContent=tot;\n}\nel('tabLower').onclick=function(){tab='lowercase';el('tabLower').classList.add('on');el('tabUpper').classList.remove('on');renderGrid();haptic('selection')};\nel('tabUpper').onclick=function(){tab='uppercase';el('tabUpper').classList.add('on');el('tabLower').classList.remove('on');renderGrid();haptic('selection')};\n\n/* ---- practice canvas ---- */\nvar cv=el('pad'),ctx=cv.getContext('2d'),SZ=300,DPR=1;\nfunction fitCanvas(){\n  var w=el('wrap');\n  var s=Math.min(w.clientWidth-28,w.clientHeight-16,430);\n  DPR=Math.min(window.devicePixelRatio||1,2);\n  SZ=Math.max(200,s);\n  cv.width=Math.round(SZ*DPR);cv.height=Math.round(SZ*DPR);\n  cv.style.width=SZ+'px';cv.style.height=SZ+'px';\n}\nfunction P(n){return n*SZ*DPR}\nfunction guides(){\n  var ys=tab==='lowercase'?[0.18,0.30,0.58,0.75]:[0.20,0.65];\n  ctx.lineWidth=1*DPR;\n  ys.forEach(function(y,i){\n    ctx.strokeStyle=(y===0.58||y===0.65)?'rgba(80,70,60,.35)':'rgba(80,70,60,.14)';\n    ctx.setLineDash(i===0||i===3?[4*DPR,5*DPR]:[]);\n    ctx.beginPath();ctx.moveTo(P(0.04),P(y));ctx.lineTo(P(0.96),P(y));ctx.stroke();\n  });\n  ctx.setLineDash([]);\n}\nfunction drawGuidePath(){\n  cur.strokes.forEach(function(stk,i){\n    var s=sampleStroke(stk);\n    ctx.strokeStyle=i<strokeIdx?'rgba(62,184,172,.9)':(i===strokeIdx?'rgba(150,140,130,.5)':'rgba(150,140,130,.22)');\n    ctx.lineWidth=(i===strokeIdx?7:6)*DPR;ctx.lineCap='round';ctx.lineJoin='round';\n    ctx.beginPath();ctx.moveTo(P(s[0][0]),P(s[0][1]));\n    for(var j=1;j<s.length;j++)ctx.lineTo(P(s[j][0]),P(s[j][1]));\n    ctx.stroke();\n  });\n  /* entry dot on the active stroke */\n  if(strokeIdx<cur.strokes.length){\n    var p0=cur.strokes[strokeIdx][0];\n    ctx.fillStyle='#f26d9a';\n    ctx.beginPath();ctx.arc(P(p0[0]),P(p0[1]),7*DPR,0,7);ctx.fill();\n    ctx.fillStyle='rgba(242,109,154,.25)';\n    ctx.beginPath();ctx.arc(P(p0[0]),P(p0[1]),13*DPR,0,7);ctx.fill();\n  }\n}\nfunction drawInk(){\n  if(ink.length<2)return;\n  ctx.strokeStyle='#2c2b33';ctx.lineWidth=8*DPR;ctx.lineCap='round';ctx.lineJoin='round';\n  ctx.beginPath();ctx.moveTo(P(ink[0][0]),P(ink[0][1]));\n  for(var i=1;i<ink.length;i++)ctx.lineTo(P(ink[i][0]),P(ink[i][1]));\n  ctx.stroke();\n}\nfunction paint(demoPt){\n  ctx.clearRect(0,0,cv.width,cv.height);\n  guides();drawGuidePath();drawInk();\n  if(demoPt){ctx.fillStyle='#3eb8ac';ctx.beginPath();ctx.arc(P(demoPt[0]),P(demoPt[1]),8*DPR,0,7);ctx.fill();}\n}\n\n/* ---- demo animation: a pen-dot travels the active stroke ---- */\nfunction demo(){\n  if(!cur||strokeIdx>=cur.strokes.length)return;\n  clearInterval(demoT);\n  var s=sampleStroke(cur.strokes[strokeIdx]),i=0;\n  el('pHint').textContent='Watch… then trace from the pink dot';\n  demoT=setInterval(function(){\n    if(i>=s.length){clearInterval(demoT);demoT=null;paint();el('pHint').textContent='Your turn — trace the grey stroke';return;}\n    paint(s[i]);i++;\n  },28);\n}\n\n/* ---- tracing ---- */\nfunction pos(e){var r=cv.getBoundingClientRect();return [(e.clientX-r.left)/r.width,(e.clientY-r.top)/r.height]}\ncv.addEventListener('pointerdown',function(e){\n  if(!cur||strokeIdx>=cur.strokes.length||demoT)return;\n  drawing=true;ink=[pos(e)];cv.setPointerCapture(e.pointerId);\n});\ncv.addEventListener('pointermove',function(e){\n  if(!drawing)return;ink.push(pos(e));paint();\n});\n['pointerup','pointercancel'].forEach(function(ev){cv.addEventListener(ev,function(){\n  if(!drawing)return;drawing=false;finishStroke();\n})});\nfunction finishStroke(){\n  var guide=sampleStroke(cur.strokes[strokeIdx]);\n  var r=evalStroke(guide,ink);\n  if(r.pass){\n    quals.push(r.q);\n    strokeIdx++;ink=[];\n    haptic('success');\n    if(strokeIdx>=cur.strokes.length)finishLetter();\n    else{el('pHint').textContent='Lovely — next stroke from the pink dot';paint();}\n  } else {\n    haptic('warning');ink=[];\n    el('pHint').textContent=r.cov<0.3?'Start at the pink dot and follow the grey stroke':'Close! Try that stroke once more';\n    paint();\n  }\n}\nfunction finishLetter(){\n  var q=quals.reduce(function(a,b){return a+b},0)/quals.length;\n  earned=q>=0.72?3:(q>=0.45?2:1);\n  var prev=stars[cur.ch]||0;\n  if(earned>prev){stars[cur.ch]=earned;store.setItem('cursive.stars',JSON.stringify(stars));}\n  el('pStars').textContent='★★★'.slice(0,earned)+'☆☆☆'.slice(0,3-earned);\n  el('pHint').textContent=earned===3?'Beautiful penmanship!':(earned===2?'Lovely — smooth those curves for 3 stars':'Done! Practice makes perfect');\n  el('btnNext').disabled=false;\n  toast(earned===3?'Beautiful!':'Well done!');\n  haptic('success');paint();renderGrid();\n}\n\n/* ---- flow ---- */\nfunction openPractice(l){\n  cur=l;strokeIdx=0;quals=[];ink=[];earned=null;\n  el('practice').classList.add('on');\n  el('pLetter').textContent=l.ch;\n  el('pStars').textContent='';\n  el('btnNext').disabled=true;\n  fitCanvas();paint();demo();\n}\nfunction nextLetter(){\n  var list=letterList(),i=list.indexOf(cur);\n  openPractice(list[(i+1)%list.length]);haptic('selection');\n}\nel('pClose').onclick=function(){clearInterval(demoT);demoT=null;el('practice').classList.remove('on');haptic('light')};\nel('btnDemo').onclick=function(){if(!demoT)demo()};\nel('btnClear').onclick=function(){strokeIdx=0;quals=[];ink=[];el('btnNext').disabled=true;el('pStars').textContent='';paint();demo();haptic('light')};\nel('btnNext').onclick=nextLetter;\nvar toastT=null;\nfunction toast(t){var x=el('toast');x.textContent=t;x.classList.add('on');clearTimeout(toastT);toastT=setTimeout(function(){x.classList.remove('on')},1300)}\nwindow.addEventListener('resize',function(){if(cur){fitCanvas();paint();}});\n\nstore.getItem('cursive.stars').then(function(v){\n  if(v)try{stars=JSON.parse(v)||{}}catch(e){}\n  renderGrid();\n});\n</script>\n</body></html>\n"}