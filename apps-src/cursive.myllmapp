{"name": "Cursive", "kind": "html", "iconSymbol": "signature", "iconColor": "teal", "html": "<!doctype html>\n<!--\n  Handwriting — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Cursive</title>\n<style>\n:root{--build-id:\"6dff3e5a5c\";color-scheme:light;--paper:#faf8f3;--card:#ffffff;--ink:#2c2b33;--mut:#98928a;--line:#e8e3da;\n  --teal:#3eb8ac;--pink:#f26d9a;--gold:#e8b64c}\n*{box-sizing:border-box;margin:0}\nhtml,body{height:100%}\nbody{font-family:-apple-system,system-ui,sans-serif;background:var(--paper);color:var(--ink);\n  position:fixed;inset:0;width:100%;height:100dvh;overflow:hidden;display:flex;flex-direction:column;\n  -webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none}\n.rowsel{display:flex;gap:7px;padding:6px 16px 4px;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch}\n.rowsel::-webkit-scrollbar{display:none}\n.tab{flex:0 0 auto;border:1.5px solid var(--line);background:var(--card);color:var(--mut);border-radius:12px;\n  padding:8px 14px;font-size:15px;font-weight:700;white-space:nowrap}\n.tab.on{color:var(--teal);border-color:var(--teal);box-shadow:0 2px 10px rgba(62,184,172,.15)}\n.styles{display:flex;gap:7px;padding:2px 20px 8px}\n.sty{flex:1;border:1.5px solid var(--line);background:none;color:var(--mut);border-radius:999px;\n  padding:7px 4px;font-size:12px;font-weight:700}\n.sty.on{color:var(--pink);border-color:var(--pink)}\n#grid{flex:1;overflow-y:auto;padding:2px 16px calc(20px + env(safe-area-inset-bottom));\n  display:grid;grid-template-columns:repeat(auto-fill,minmax(76px,1fr));gap:9px;align-content:start}\n.lcard{position:relative;width:100%;height:0;padding-bottom:100%;   /* a guaranteed square */\n  border:1.5px solid var(--line);background:var(--card);border-radius:14px;cursor:pointer;\n  box-shadow:0 2px 8px rgba(60,50,30,.05);overflow:hidden}\n.lcard .in{position:absolute;inset:0;display:flex;align-items:center;justify-content:center}\n.lcard .g{line-height:1;color:var(--ink)}\n.lcard .py{position:absolute;left:0;right:2px;bottom:13px;text-align:center;font-size:8px;color:var(--mut);\n  font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding:0 2px}\n.lcard .s{position:absolute;left:0;right:0;bottom:3px;text-align:center;font-size:9px;letter-spacing:1px;color:var(--gold);min-height:10px}\n.lcard .pen{position:absolute;top:4px;right:6px;font-size:9px;opacity:.85}\n.lcard.done{border-color:rgba(232,182,76,.55)}\n/* practice */\n.practice{position:fixed;inset:0;background:var(--paper);display:none;flex-direction:column;z-index:10}\n.practice.on{display:flex}\n.phead{padding:calc(12px + env(safe-area-inset-top)) 16px 4px;display:flex;align-items:center;gap:12px}\n.pletter{font-size:30px;min-width:40px;text-align:center;line-height:1}\n.phint{flex:1;font-size:12.5px;color:var(--mut);font-weight:600;line-height:1.4}\n.ftag{font-size:8.5px;letter-spacing:.12em;color:var(--mut);font-weight:800;text-align:center;line-height:1.5}\n.ftag b{font-size:11px;color:var(--teal);letter-spacing:.06em}\n.pclose{border:0;background:var(--card);border:1.5px solid var(--line);border-radius:50%;width:36px;height:36px;\n  font-size:16px;color:var(--mut);font-weight:700}\n#wrap{flex:1;display:flex;align-items:center;justify-content:center;min-height:0;padding:8px 14px}\n#pad{background:var(--card);border:1.5px solid var(--line);border-radius:22px;touch-action:none;\n  box-shadow:0 6px 24px rgba(60,50,30,.08)}\n.stars{font-size:26px;letter-spacing:4px;text-align:center;color:var(--gold);min-height:32px}\n.pbar{display:flex;gap:9px;padding:8px 16px calc(16px + env(safe-area-inset-bottom))}\n.pbtn{flex:1;border:1.5px solid var(--line);background:var(--card);color:var(--ink);border-radius:13px;\n  padding:13px;font-size:14px;font-weight:700}\n.pbtn.go{background:linear-gradient(135deg,var(--teal),#2f9a90);border:0;color:#fff}\n.pbtn:disabled{opacity:.4}\n.toast{position:fixed;left:50%;top:26%;transform:translateX(-50%);background:var(--ink);color:#fff;\n  border-radius:12px;padding:9px 18px;font-size:14px;font-weight:700;opacity:0;transition:opacity .25s;\n  pointer-events:none;z-index:40}\n.toast.on{opacity:1}\n\n/* standard header */\n:root{--h:172}\nbody{padding-left:env(safe-area-inset-left);padding-right:env(safe-area-inset-right)}\nsvg.i{width:1.25em;height:1.25em;fill:currentColor;flex-shrink:0}\n.head{display:flex;align-items:center;gap:12px;padding:calc(16px + env(safe-area-inset-top)) 18px 8px}\n.tile{display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0;\n  background:linear-gradient(145deg,hsl(var(--h) 62% 50%),hsl(calc(var(--h) + 40) 58% 28%))}\n.head .tile{width:44px;height:44px;border-radius:13px;font-size:19px}\n.head .ht{flex:1;min-width:0}\n.head h1{font-size:22px;font-weight:800;letter-spacing:-.01em}\n.head p{font-size:13px;color:var(--mut);margin-top:1px}\n.head .acts{display:flex;gap:8px;flex-shrink:0}\n.prog{display:flex;align-items:center;gap:5px;height:36px;padding:0 12px;border-radius:99px;background:var(--card);border:1.5px solid var(--line);font-size:14px;color:var(--ink);font-weight:800;font-variant-numeric:tabular-nums}\n.prog svg{color:var(--gold);font-size:14px}\n.lcard .pen{color:var(--teal);font-size:11px;line-height:1}\n.pclose{width:44px;height:44px;display:flex;align-items:center;justify-content:center;font-size:15px}\n.pbtn{display:flex;align-items:center;justify-content:center;gap:6px}\n.phead{padding-left:16px;padding-right:16px}\n/* phone on its side: the pad on the left, everything else on the right */\n@media (max-height:520px){\n  .practice.on{display:grid;grid-template-columns:1fr minmax(230px,38%);grid-template-rows:auto 1fr auto auto}\n  .phead{grid-column:2;grid-row:1}\n  #wrap{grid-column:1;grid-row:1/5;padding:calc(8px + env(safe-area-inset-top)) 8px calc(8px + env(safe-area-inset-bottom)) 14px}\n  .stars{grid-column:2;grid-row:3}\n  .pbar{grid-column:2;grid-row:4;flex-wrap:wrap}\n  .pbar .pbtn{flex:1 1 40%}\n  .head{padding-top:calc(10px + env(safe-area-inset-top))}\n}\n</style></head><body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-sign\" viewBox=\"0 0 24 24\"><path d=\"M3 17.5c2.2-4.6 4-9.5 5.4-10.9 1.2-1.2 2.4-.2 1.7 1.8-.9 2.6-3.1 6.4-3.6 8.2-.4 1.4.6 1.7 1.5.6 1.3-1.6 2.7-4.4 3.9-4.2 1 .2.2 2.5 1.1 2.8.9.3 2-1.6 3-1.5.8.1.6 1.4 1.6 1.4 1 0 2-.9 2.9-1.8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M3 20.5h18\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" opacity=\".55\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.8l2.8 5.8 6.3.9-4.6 4.4 1.1 6.3L12 17.2l-5.6 3 1.1-6.3L2.9 9.5l6.3-.9z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-pen\" viewBox=\"0 0 24 24\"><path d=\"M15.2 4.3a2.2 2.2 0 0 1 3.1 0l1.4 1.4a2.2 2.2 0 0 1 0 3.1L9.4 19.1 4 20l.9-5.4z\" fill=\"currentColor\"/></symbol>\n</defs></svg>\n<div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-sign\"/></svg></div>\n  <div class=\"ht\"><h1>Handwriting</h1><p>Trace beautiful letters in eleven scripts</p></div>\n  <div class=\"acts\"><div class=\"prog\" aria-label=\"Stars earned\"><svg class=\"i\"><use href=\"#i-star\"/></svg><b id=\"starCount\">0</b></div></div>\n</div>\n<div class=\"rowsel\" id=\"rowsel\"></div>\n<div class=\"styles\" id=\"styles\"></div>\n<div id=\"grid\"></div>\n\n<div class=\"practice\" id=\"practice\">\n  <div class=\"phead\">\n    <div class=\"pletter\" id=\"pLetter\">a</div>\n    <div class=\"phint\" id=\"pHint\">Trace over the letter</div>\n    <div class=\"ftag\" id=\"fadeTag\">GUIDE<br><b>FULL</b></div>\n    <button class=\"pclose\" id=\"pClose\" aria-label=\"Close\"><svg class=\"i\"><use href=\"#i-x\"/></svg></button>\n  </div>\n  <div id=\"wrap\"><canvas id=\"pad\"></canvas></div>\n  <div class=\"stars\" id=\"pStars\"></div>\n  <div class=\"pbar\">\n    <button class=\"pbtn\" id=\"btnClear\">Start over</button>\n    <button class=\"pbtn\" id=\"btnCheck\">Check</button>\n    <button class=\"pbtn go\" id=\"btnNext\" disabled></button>\n  </div>\n</div>\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\n\"use strict\";\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nvar store={getItem:function(k){var s=window.myllmStorage;return s?s.getItem(k):Promise.resolve(null)},\n           setItem:function(k,v){var s=window.myllmStorage;return s?s.setItem(k,v):Promise.resolve()}};\nvar FAINTER='Fainter <svg class=\"i\"><use href=\"#i-pen\"/></svg>';\nfunction el(i){return document.getElementById(i)}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k||'light')}catch(e){}}\n\n/* ---- the letters are drawn by a real typeface, not by hand-authored paths ---- */\nvar LOWER='abcdefghijklmnopqrstuvwxyz'.split('');\nvar UPPER='ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');\nvar FADE=[1,.42,.18,.05],FADE_NAME=['FULL','FAINT','GHOST','MEMORY'],MAXFADE=3;\nvar tab='lower',styleId='roman',stars={},levels={},cur=null,fade=0,earned=null;\nvar strokesInk=[],ink=[],drawing=false;\nvar STYLES=[{id:'roman',name:'Roman',size:1},{id:'script',name:'Calligraphy',size:1.18},{id:'print',name:'Print',size:.94}];\nvar LATIN_FONTS={roman:'\"New York\",\"Baskerville\",Georgia,\"Times New Roman\",serif',\n                 script:'\"Snell Roundhand\",\"Apple Chancery\",\"Segoe Script\",cursive',\n                 print:'-apple-system,\"Helvetica Neue\",Arial,sans-serif'};\nvar HANZI=[['一','yī','one'],['二','èr','two'],['三','sān','three'],['四','sì','four'],['五','wǔ','five'],\n ['六','liù','six'],['七','qī','seven'],['八','bā','eight'],['九','jiǔ','nine'],['十','shí','ten'],\n ['人','rén','person'],['大','dà','big'],['小','xiǎo','small'],['上','shàng','above'],['下','xià','below'],\n ['中','zhōng','middle'],['日','rì','sun'],['月','yuè','moon'],['山','shān','mountain'],['水','shuǐ','water'],\n ['火','huǒ','fire'],['木','mù','tree'],['土','tǔ','earth'],['田','tián','field'],['天','tiān','sky'],\n ['口','kǒu','mouth'],['手','shǒu','hand'],['目','mù','eye'],['心','xīn','heart'],['子','zǐ','child'],\n ['女','nǚ','woman'],['男','nán','man'],['好','hǎo','good'],['不','bù','not'],['我','wǒ','I'],\n ['你','nǐ','you'],['他','tā','he'],['爱','ài','love'],['家','jiā','home'],['学','xué','study'],\n ['书','shū','book'],['门','mén','door'],['车','chē','car'],['马','mǎ','horse'],['鸟','niǎo','bird'],\n ['鱼','yú','fish'],['花','huā','flower'],['雨','yǔ','rain']];\n/* the 44 Thai consonants, each learned with its traditional name word */\nvar THAI=[['ก','ko kai','chicken'],['ข','kho khai','egg'],['ฃ','kho khuat','bottle'],['ค','kho khwai','buffalo'],\n ['ฅ','kho khon','person'],['ฆ','kho rakhang','bell'],['ง','ngo ngu','snake'],['จ','cho chan','plate'],\n ['ฉ','cho ching','cymbals'],['ช','cho chang','elephant'],['ซ','so so','chain'],['ฌ','cho choe','tree'],\n ['ญ','yo ying','woman'],['ฎ','do chada','headdress'],['ฏ','to patak','goad'],['ฐ','tho san','pedestal'],\n ['ฑ','tho montho','Montho'],['ฒ','tho phuthao','elder'],['ณ','no nen','novice'],['ด','do dek','child'],\n ['ต','to tao','turtle'],['ถ','tho thung','sack'],['ท','tho thahan','soldier'],['ธ','tho thong','flag'],\n ['น','no nu','mouse'],['บ','bo baimai','leaf'],['ป','po pla','fish'],['ผ','pho phueng','bee'],\n ['ฝ','fo fa','lid'],['พ','pho phan','tray'],['ฟ','fo fan','teeth'],['ภ','pho samphao','sailboat'],\n ['ม','mo ma','horse'],['ย','yo yak','giant'],['ร','ro ruea','boat'],['ล','lo ling','monkey'],\n ['ว','wo waen','ring'],['ศ','so sala','pavilion'],['ษ','so ruesi','hermit'],['ส','so suea','tiger'],\n ['ห','ho hip','chest'],['ฬ','lo chula','kite'],['อ','o ang','basin'],['ฮ','ho nokhuk','owl']];\nfunction infoMap(rows){var m={};rows.forEach(function(r){m[r[0]]={p:r[1],m:r[2]}});return m}\nvar HZ=infoMap(HANZI),TH=infoMap(THAI);\n/* --- scripts whose symbols carry names: shown on the card and while practising --- */\nvar GREEK_L=[['α','alpha'],['β','beta'],['γ','gamma'],['δ','delta'],['ε','epsilon'],['ζ','zeta'],\n ['η','eta'],['θ','theta'],['ι','iota'],['κ','kappa'],['λ','lambda'],['μ','mu'],['ν','nu'],['ξ','xi'],\n ['ο','omicron'],['π','pi'],['ρ','rho'],['σ','sigma'],['τ','tau'],['υ','upsilon'],['φ','phi'],\n ['χ','chi'],['ψ','psi'],['ω','omega']];\nvar CYR_L=[['а','a'],['б','be'],['в','ve'],['г','ge'],['д','de'],['е','ye'],['ё','yo'],['ж','zhe'],\n ['з','ze'],['и','i'],['й','short i'],['к','ka'],['л','el'],['м','em'],['н','en'],['о','o'],['п','pe'],\n ['р','er'],['с','es'],['т','te'],['у','u'],['ф','ef'],['х','kha'],['ц','tse'],['ч','che'],['ш','sha'],\n ['щ','shcha'],['ъ','hard sign'],['ы','yery'],['ь','soft sign'],['э','e'],['ю','yu'],['я','ya']];\nvar KANA=[['a'],['i'],['u'],['e'],['o'],['ka'],['ki'],['ku'],['ke'],['ko'],['sa'],['shi'],['su'],['se'],['so'],\n ['ta'],['chi'],['tsu'],['te'],['to'],['na'],['ni'],['nu'],['ne'],['no'],['ha'],['hi'],['fu'],['he'],['ho'],\n ['ma'],['mi'],['mu'],['me'],['mo'],['ya'],['yu'],['yo'],['ra'],['ri'],['ru'],['re'],['ro'],['wa'],['wo'],['n']];\nvar HIRA='あいうえおかきくけこさしすせそたちつてとなにぬねのはひふへほまみむめもやゆよらりるれろわをん'.split('');\nvar KATA='アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン'.split('');\nvar HANGUL=[['ㄱ','giyeok'],['ㄴ','nieun'],['ㄷ','digeut'],['ㄹ','rieul'],['ㅁ','mieum'],['ㅂ','bieup'],\n ['ㅅ','siot'],['ㅇ','ieung'],['ㅈ','jieut'],['ㅊ','chieut'],['ㅋ','kieuk'],['ㅌ','tieut'],['ㅍ','pieup'],\n ['ㅎ','hieut'],['ㅏ','a'],['ㅑ','ya'],['ㅓ','eo'],['ㅕ','yeo'],['ㅗ','o'],['ㅛ','yo'],['ㅜ','u'],['ㅠ','yu'],\n ['ㅡ','eu'],['ㅣ','i']];\nfunction pairMap(rows){var m={};rows.forEach(function(r){m[r[0]]={p:r[1],m:''}});return m}\nfunction zipMap(chars,rows){var m={};chars.forEach(function(c,i){m[c]={p:rows[i][0],m:''}});return m}\nvar GRK=pairMap(GREEK_L),CYR=pairMap(CYR_L),HAN=pairMap(HANGUL);\nvar GRK_U={},CYR_U={};\nGREEK_L.forEach(function(r){GRK_U[r[0].toUpperCase()]={p:r[1],m:''}});\nCYR_L.forEach(function(r){CYR_U[r[0].toUpperCase()]={p:r[1],m:''}});\nvar HIRA_I=zipMap(HIRA,KANA),KATA_I=zipMap(KATA,KANA);\nvar EURO_FONTS={roman:'\"New York\",Georgia,\"Times New Roman\",serif',\n                script:'\"Palatino\",\"Book Antiqua\",Didot,serif',\n                print:'-apple-system,\"Helvetica Neue\",Arial,sans-serif'};\nvar EURO_NAMES={roman:'Serif',script:'Elegant',print:'Sans'};\nvar JP_FONTS={roman:'\"Hiragino Mincho ProN\",\"YuMincho\",\"Hiragino Sans GB\",serif',\n              script:'\"Klee\",\"Hiragino Mincho ProN\",cursive',\n              print:'\"Hiragino Sans\",\"Hiragino Kaku Gothic ProN\",sans-serif'};\nvar KO_FONTS={roman:'\"AppleMyungjo\",\"Nanum Myeongjo\",serif',\n              script:'\"Nanum Pen Script\",\"AppleMyungjo\",cursive',\n              print:'\"Apple SD Gothic Neo\",\"AppleGothic\",\"Malgun Gothic\",sans-serif'};\n/* Adding a script is just another entry here — fonts, characters, guides. */\nvar SETS=[\n {id:'lower',label:'abc',latin:true,chars:LOWER,fonts:LATIN_FONTS,\n  metrics:{asc:'h',desc:'p',xh:'x'},fit:.62},\n {id:'upper',label:'ABC',latin:true,chars:UPPER,fonts:LATIN_FONTS,\n  metrics:{asc:'H',desc:'H',xh:'H'},fit:.50},\n {id:'hanzi',label:'漢字',square:true,chars:HANZI.map(function(h){return h[0]}),info:HZ,scale:.98,\n  styleNames:{roman:'Song 宋',script:'Kai 楷',print:'Hei 黑'},\n  fonts:{roman:'\"Songti SC\",\"STSong\",\"Songti TC\",\"SimSun\",serif',\n         script:'\"Kaiti SC\",\"STKaiti\",\"Kaiti\",\"KaiTi\",\"Songti SC\",serif',\n         print:'\"PingFang SC\",\"Heiti SC\",\"STHeiti\",\"Microsoft YaHei\",sans-serif'}},\n {id:'thai',label:'ไทย',chars:THAI.map(function(t){return t[0]}),info:TH,scale:1.02,\n  styleNames:{roman:'Looped',script:'Classic',print:'Modern'},\n  fonts:{roman:'\"Thonburi\",\"Sukhumvit Set\",serif',\n         script:'\"Ayuthaya\",\"Thonburi\",cursive',\n         print:'\"Sukhumvit Set\",\"Thonburi\",-apple-system,sans-serif'},\n  metrics:{asc:'ป',desc:'ฐ',xh:'ก'},fit:.52},\n {id:'greek',label:'αβγ',chars:GREEK_L.map(function(r){return r[0]}),info:GRK,fonts:EURO_FONTS,\n  styleNames:EURO_NAMES,metrics:{asc:'λ',desc:'γ',xh:'ο'},fit:.60},\n {id:'greekU',label:'ΑΒΓ',chars:GREEK_L.map(function(r){return r[0].toUpperCase()}),info:GRK_U,\n  fonts:EURO_FONTS,styleNames:EURO_NAMES,metrics:{asc:'Α',desc:'Α',xh:'Α'},fit:.50},\n {id:'cyr',label:'абв',chars:CYR_L.map(function(r){return r[0]}),info:CYR,fonts:EURO_FONTS,\n  styleNames:EURO_NAMES,metrics:{asc:'б',desc:'у',xh:'о'},fit:.58},\n {id:'cyrU',label:'АБВ',chars:CYR_L.map(function(r){return r[0].toUpperCase()}),info:CYR_U,\n  fonts:EURO_FONTS,styleNames:EURO_NAMES,metrics:{asc:'А',desc:'А',xh:'А'},fit:.50},\n {id:'hira',label:'あいう',square:true,chars:HIRA,info:HIRA_I,fonts:JP_FONTS,scale:.96,\n  styleNames:{roman:'Mincho 明朝',script:'Klee 手書',print:'Gothic ゴシック'}},\n {id:'kata',label:'アイウ',square:true,chars:KATA,info:KATA_I,fonts:JP_FONTS,scale:.96,\n  styleNames:{roman:'Mincho 明朝',script:'Klee 手書',print:'Gothic ゴシック'}},\n {id:'hangul',label:'한글',square:true,chars:HANGUL.map(function(r){return r[0]}),info:HAN,\n  fonts:KO_FONTS,scale:.94,\n  styleNames:{roman:'Myeongjo 명조',script:'Pen 손글씨',print:'Gothic 고딕'}}\n];\nfunction styleDef(){for(var i=0;i<STYLES.length;i++)if(STYLES[i].id===styleId)return STYLES[i];return STYLES[0]}\nfunction curSet(){for(var i=0;i<SETS.length;i++)if(SETS[i].id===tab)return SETS[i];return SETS[0]}\nfunction isSquare(){return !!curSet().square}\nfunction faceFont(){var s=curSet();return s.fonts[styleId]||s.fonts.roman}\nfunction faceSize(){var s=curSet();return (s.latin?styleDef().size:1)*(s.scale||1)}\nfunction styleLabel(s){var c=curSet();return (c.styleNames&&c.styleNames[s.id])||s.name}\nfunction letters(){return curSet().chars}\nfunction infoFor(ch){var s=curSet();return s.info&&s.info[ch]}\n\n/* ================= grading (pure — the harness drives these directly) ================= */\n/* Compare two boolean grids: what the letter covers, and what you drew. */\nfunction scoreGrids(mask,tol,inkG,n){\n  var maskN=0,maskHit=0,inkN=0,inkHit=0;\n  for(var i=0;i<n*n;i++){\n    if(mask[i]){maskN++;if(inkG[i])maskHit++;}\n    if(inkG[i]){inkN++;if(tol[i])inkHit++;}\n  }\n  if(!maskN||!inkN)return {cov:0,acc:0,q:0,pass:false};\n  var cov=maskHit/maskN, acc=inkHit/inkN;\n  var q=Math.max(0,Math.min(1,(cov-.35)/.5))*.55 + Math.max(0,Math.min(1,(acc-.45)/.45))*.45;\n  return {cov:cov,acc:acc,q:q,pass:cov>=.55&&acc>=.60};\n}\nfunction starsFor(q){return q>=.80?3:(q>=.52?2:1)}\n\n/* ================= canvas ================= */\nvar cv=el('pad'),ctx=cv.getContext('2d'),SZ=300,DPR=1;\nvar GRID=64, maskG=null, tolG=null;      // rasterised letter + tolerance band\nfunction fitCanvas(){\n  var w=el('wrap');\n  var s=Math.min(w.clientWidth-28,w.clientHeight-16,440);\n  DPR=Math.min(window.devicePixelRatio||1,2);\n  SZ=Math.max(200,s);\n  cv.width=Math.round(SZ*DPR);cv.height=Math.round(SZ*DPR);\n  cv.style.width=SZ+'px';cv.style.height=SZ+'px';\n}\n/* fit the glyph to the writing bands using the font's own metrics */\nfunction layout(){\n  var W=cv.width,H=cv.height,f=styleDef();\n  var S=curSet(),FF=faceFont();\n  if(S.square){\n    /* characters that sit in a square cell rather than on a baseline */\n    var box=Math.min(W,H)*.62, size=Math.round(box*faceSize());\n    ctx.font=size+'px '+FF;\n    var m2=ctx.measureText(cur||S.chars[0]);\n    var a3=m2.actualBoundingBoxAscent||size*.85, d3=m2.actualBoundingBoxDescent||0;\n    return {font:size+'px '+FF,size:size,base:H/2+(a3-d3)/2,box:box,\n            asc:a3,desc:d3,xh:a3,w:m2.width,cx:W/2,square:true};\n  }\n  var MP=S.metrics||{asc:'h',desc:'p',xh:'x'};\n  var probe=Math.round(H*.4);\n  ctx.font=probe+'px '+FF;\n  var asc=ctx.measureText(MP.asc).actualBoundingBoxAscent||probe*.7;\n  var desc=ctx.measureText(MP.desc).actualBoundingBoxDescent||probe*.2;\n  var want=H*(S.fit||.6);\n  var size=Math.round(probe*want/Math.max(1,asc+desc)*faceSize());\n  ctx.font=size+'px '+FF;\n  var m=ctx.measureText(cur||S.chars[0]);\n  var a2=ctx.measureText(MP.asc).actualBoundingBoxAscent;\n  var d2=ctx.measureText(MP.desc).actualBoundingBoxDescent;\n  var x2=ctx.measureText(MP.xh).actualBoundingBoxAscent||a2*.55;\n  var base=H/2+(a2-d2)/2;\n  return {font:size+'px '+FF,size:size,base:base,asc:a2,desc:d2,xh:x2,\n          w:m.width,cx:W/2};\n}\nfunction guides(L){\n  var W=cv.width,H=cv.height;\n  ctx.lineWidth=1*DPR;\n  if(L.square){\n    var b=L.box*1.12,x0=(W-b)/2,y0=(H-b)/2;\n    ctx.strokeStyle='rgba(80,70,60,.30)';ctx.setLineDash([]);\n    ctx.strokeRect(x0,y0,b,b);\n    ctx.strokeStyle='rgba(80,70,60,.15)';ctx.setLineDash([5*DPR,5*DPR]);\n    ctx.beginPath();\n    ctx.moveTo(x0+b/2,y0);ctx.lineTo(x0+b/2,y0+b);\n    ctx.moveTo(x0,y0+b/2);ctx.lineTo(x0+b,y0+b/2);\n    ctx.moveTo(x0,y0);ctx.lineTo(x0+b,y0+b);\n    ctx.moveTo(x0+b,y0);ctx.lineTo(x0,y0+b);\n    ctx.stroke();ctx.setLineDash([]);\n    return;\n  }\n  var ys=[[L.base,'rgba(80,70,60,.34)'],[L.base-L.xh,'rgba(80,70,60,.13)'],\n          [L.base-L.asc,'rgba(80,70,60,.13)'],[L.base+L.desc,'rgba(80,70,60,.10)']];\n  ys.forEach(function(g,i){\n    ctx.strokeStyle=g[1];ctx.setLineDash(i>=2?[4*DPR,5*DPR]:[]);\n    ctx.beginPath();ctx.moveTo(W*.05,g[0]);ctx.lineTo(W*.95,g[0]);ctx.stroke();\n  });\n  ctx.setLineDash([]);\n}\nfunction drawGlyph(L,alpha){\n  ctx.save();ctx.font=L.font;ctx.textAlign='center';ctx.textBaseline='alphabetic';\n  ctx.fillStyle='rgba(120,112,104,'+alpha.toFixed(3)+')';\n  ctx.fillText(cur,L.cx,L.base);\n  ctx.restore();\n}\nfunction drawInk(){\n  ctx.strokeStyle='#2c2b33';ctx.lineWidth=Math.max(6,cv.width*.026);\n  ctx.lineCap='round';ctx.lineJoin='round';\n  strokesInk.concat([ink]).forEach(function(s){\n    if(s.length<2)return;\n    ctx.beginPath();ctx.moveTo(s[0][0]*cv.width,s[0][1]*cv.height);\n    for(var i=1;i<s.length;i++)ctx.lineTo(s[i][0]*cv.width,s[i][1]*cv.height);\n    ctx.stroke();\n  });\n}\nfunction paint(){\n  if(!cur)return;\n  var L=layout();\n  ctx.clearRect(0,0,cv.width,cv.height);\n  guides(L);drawGlyph(L,FADE[fade]*.85);drawInk();\n}\n/* rasterise the letter (and a tolerance band around it) onto a small grid */\nfunction buildMask(){\n  var L=layout(),n=GRID;\n  var oc=document.createElement('canvas');oc.width=oc.height=n;\n  var o=oc.getContext('2d');\n  var k=n/cv.width;\n  o.fillStyle='#000';o.fillRect(0,0,n,n);\n  o.save();o.scale(k,k);\n  o.font=L.font;o.textAlign='center';o.textBaseline='alphabetic';\n  o.fillStyle='#fff';o.fillText(cur,L.cx,L.base);\n  o.restore();\n  var a=o.getImageData(0,0,n,n).data;\n  maskG=new Uint8Array(n*n);\n  for(var i=0;i<n*n;i++)maskG[i]=a[i*4]>110?1:0;\n  /* tolerance band: the same glyph, fattened */\n  o.fillStyle='#000';o.fillRect(0,0,n,n);\n  o.save();o.scale(k,k);\n  o.font=L.font;o.textAlign='center';o.textBaseline='alphabetic';\n  o.fillStyle='#fff';o.strokeStyle='#fff';o.lineWidth=cv.width*.055;\n  o.lineJoin='round';o.miterLimit=2;\n  o.fillText(cur,L.cx,L.base);o.strokeText(cur,L.cx,L.base);\n  o.restore();\n  var b=o.getImageData(0,0,n,n).data;\n  tolG=new Uint8Array(n*n);\n  for(var j=0;j<n*n;j++)tolG[j]=b[j*4]>110?1:0;\n}\nfunction inkGrid(){\n  var n=GRID,oc=document.createElement('canvas');oc.width=oc.height=n;\n  var o=oc.getContext('2d');\n  o.fillStyle='#000';o.fillRect(0,0,n,n);\n  o.strokeStyle='#fff';o.lineWidth=Math.max(2,n*.028);o.lineCap='round';o.lineJoin='round';\n  strokesInk.forEach(function(s){\n    if(s.length<2)return;\n    o.beginPath();o.moveTo(s[0][0]*n,s[0][1]*n);\n    for(var i=1;i<s.length;i++)o.lineTo(s[i][0]*n,s[i][1]*n);\n    o.stroke();\n  });\n  var a=o.getImageData(0,0,n,n).data,g=new Uint8Array(n*n);\n  for(var i2=0;i2<n*n;i2++)g[i2]=a[i2*4]>110?1:0;\n  return g;\n}\n\n/* ================= grid of cards ================= */\nfunction starStr(n){return n?'★★★'.slice(0,n):''}\n\nvar glyphs=[];\nfunction renderGrid(){\n  var g=el('grid');g.innerHTML='';glyphs=[];\n  var f=styleDef();\n  letters().forEach(function(ch){\n    var d=document.createElement('div');d.className='lcard'+(stars[ch]?' done':'');\n    d.setAttribute('role','button');d.setAttribute('tabindex','0');\n    var box=document.createElement('span');box.className='in';\n    var sp=document.createElement('span');sp.className='g';\n    sp.style.fontFamily=faceFont();sp.textContent=ch;\n    box.appendChild(sp);d.appendChild(box);glyphs.push(sp);\n    var nf=infoFor(ch);\n    if(nf){var py=document.createElement('span');py.className='py';py.textContent=nf.p;d.appendChild(py)}\n    var s=document.createElement('span');s.className='s';s.textContent=starStr(stars[ch]||0);d.appendChild(s);\n    if((levels[ch]||0)>=MAXFADE){var p=document.createElement('span');p.className='pen';p.innerHTML='<svg class=\"i\"><use href=\"#i-pen\"/></svg>';d.appendChild(p)}\n    d.onclick=function(){openPractice(ch);haptic('selection')};\n    g.appendChild(d);\n  });\n  var tot=0;for(var k in stars)tot+=stars[k];\n  el('starCount').textContent=tot;\n  sizeGlyphs();\n}\n/* the glyph is scaled to the card's real width once the grid has laid out —\n   a percentage font-size would resolve against the parent's font-size instead */\nfunction sizeGlyphs(){\n  if(!glyphs.length)return;\n  var g=el('grid'),first=g.children&&g.children[0];\n  var w=(first&&(first.clientWidth||first.offsetWidth))||0;\n  if(!w){var cols=Math.max(1,Math.round((g.clientWidth||360)/86));w=((g.clientWidth||360)-32-(cols-1)*9)/cols}\n  var px=Math.max(18,Math.round(w*(isSquare()?.60:.54)*faceSize()));\n  for(var i=0;i<glyphs.length;i++)glyphs[i].style.fontSize=px+'px';\n}\nfunction buildStyles(){\n  var w=el('styles');w.innerHTML='';\n  STYLES.forEach(function(s){\n    var b=document.createElement('button');b.className='sty'+(s.id===styleId?' on':'');\n    b.textContent=styleLabel(s);b.style.fontFamily=faceFont();\n    b.onclick=function(){styleId=s.id;store.setItem('cursive.style',styleId);\n      buildStyles();renderGrid();if(cur){fitCanvas();buildMask();paint()}haptic('selection')};\n    w.appendChild(b);\n  });\n}\nfunction buildTabs(){\n  var w=el('rowsel');w.innerHTML='';\n  SETS.forEach(function(s){\n    var b=document.createElement('button');b.className='tab'+(s.id===tab?' on':'');\n    b.textContent=s.label;b.style.fontFamily=s.fonts[styleId]||s.fonts.roman;\n    b.onclick=function(){setTab(s.id)};\n    w.appendChild(b);\n  });\n}\nfunction setTab(t){\n  tab=t;store.setItem('cursive.set',t);\n  buildTabs();buildStyles();renderGrid();haptic('selection');\n}\n\n/* ================= tracing ================= */\nfunction pos(e){var r=cv.getBoundingClientRect();return [(e.clientX-r.left)/r.width,(e.clientY-r.top)/r.height]}\ncv.addEventListener('pointerdown',function(e){\n  if(!cur)return;\n  drawing=true;ink=[pos(e)];cv.setPointerCapture(e.pointerId);paint();\n});\ncv.addEventListener('pointermove',function(e){ if(!drawing)return; ink.push(pos(e)); paint(); });\n['pointerup','pointercancel'].forEach(function(ev){cv.addEventListener(ev,function(){\n  if(!drawing)return;drawing=false;\n  if(ink.length>1)strokesInk.push(ink);\n  ink=[];paint();\n  el('btnCheck').disabled=false;\n})});\n\nfunction check(){\n  if(!strokesInk.length){toast('Trace the letter first');return}\n  if(!maskG)buildMask();\n  var r=scoreGrids(maskG,tolG,inkGrid(),GRID);\n  if(!r.pass){\n    el('pHint').textContent=r.cov<.45?'Cover the whole character — follow its shape':'Stay closer to the strokes';\n    toast('Not quite — try again');haptic('warning');return;\n  }\n  earned=starsFor(r.q);\n  if((levels[cur]||0)<fade){levels[cur]=fade;store.setItem('cursive.levels',JSON.stringify(levels))}\n  if(earned>(stars[cur]||0)){stars[cur]=earned;store.setItem('cursive.stars',JSON.stringify(stars))}\n  el('pStars').textContent='★★★'.slice(0,earned)+'☆☆☆'.slice(0,3-earned);\n  el('pHint').textContent=fade>=MAXFADE\n    ?(earned===3?'Written from memory — beautiful!':'Written from memory. Well done!')\n    :(earned===3?'Beautiful! Try it again with a fainter guide':'Nicely done — fade the guide and try again');\n  el('btnNext').disabled=false;\n  el('btnNext').innerHTML=fade>=MAXFADE?'Next letter':FAINTER;\n  toast(fade>=MAXFADE?'From memory!':(earned===3?'Beautiful!':'Well done!'));\n  haptic('success');renderGrid();\n}\nfunction updFadeTag(){el('fadeTag').innerHTML='GUIDE<br><b>'+FADE_NAME[fade]+'</b>'}\nfunction fainter(){\n  fade=Math.min(MAXFADE,fade+1);\n  strokesInk=[];ink=[];earned=null;\n  el('pStars').textContent='';el('btnNext').disabled=true;el('btnNext').innerHTML=FAINTER;\n  el('btnCheck').disabled=true;\n  el('pHint').textContent=fade>=MAXFADE?'No guide now — write it from memory':'Fainter guide — trace it again';\n  updFadeTag();paint();haptic('success');\n}\nfunction openPractice(ch){\n  cur=ch;fade=0;strokesInk=[];ink=[];earned=null;\n  el('practice').classList.add('on');syncChrome(true);\n  el('pLetter').style.fontFamily=faceFont();el('pLetter').style.fontSize='30px';\n  el('pLetter').textContent=ch;\n  el('pStars').textContent='';\n  el('btnNext').disabled=true;el('btnNext').innerHTML=FAINTER;\n  el('btnCheck').disabled=true;\n  var nfo=infoFor(ch);\n  el('pHint').textContent=nfo\n    ? (nfo.p+' \\u00b7 '+nfo.m+(isSquare()?' \\u2014 trace inside the square':' \\u2014 trace over it'))\n    : 'Trace over the letter';\n  updFadeTag();fitCanvas();buildMask();paint();\n}\nfunction nextLetter(){\n  var list=letters(),i=list.indexOf(cur);\n  openPractice(list[(i+1)%list.length]);haptic('selection');\n}\nel('pClose').onclick=function(){el('practice').classList.remove('on');cur=null;syncChrome(false);haptic('light')};\n/* Practice takes the whole display: MyLLM's bars go while a letter is open\n   (myllmImmersive, looked up per call) and come back with the grid. */\nfunction syncChrome(on){\n  if(!window.myllmImmersive)return;\n  try{myllmImmersive(on,{keepAwake:false}).catch(function(){})}catch(e){}\n}\ndocument.addEventListener('visibilitychange',function(){if(!document.hidden&&cur)syncChrome(true)});\nel('btnNext').innerHTML=FAINTER;\nel('btnClear').onclick=function(){strokesInk=[];ink=[];earned=null;el('pStars').textContent='';\n  el('btnNext').disabled=true;el('btnCheck').disabled=true;paint();haptic('light')};\nel('btnCheck').onclick=check;\nel('btnNext').onclick=function(){(earned!==null&&fade<MAXFADE)?fainter():nextLetter()};\nvar toastT=null;\nfunction toast(t){var x=el('toast');x.textContent=t;x.classList.add('on');\n  clearTimeout(toastT);toastT=setTimeout(function(){x.classList.remove('on')},1400)}\nvar rgT=null;\nwindow.addEventListener('resize',function(){\n  if(cur){fitCanvas();buildMask();paint()}\n  clearTimeout(rgT);rgT=setTimeout(function(){renderGrid();sizeGlyphs()},150);\n});\n\nstore.getItem('cursive.style').then(function(v){\n  if(v&&STYLES.some(function(s){return s.id===v}))styleId=v;\n  return store.getItem('cursive.stars');\n}).then(function(v){\n  if(v)try{stars=JSON.parse(v)||{}}catch(e){}\n  return store.getItem('cursive.levels');\n}).then(function(v){\n  if(v)try{levels=JSON.parse(v)||{}}catch(e){}\n  return store.getItem('cursive.set');\n}).then(function(v){\n  if(v&&SETS.some(function(s){return s.id===v}))tab=v;\n  buildTabs();buildStyles();renderGrid();\n});\n</script>\n</body></html>\n"}