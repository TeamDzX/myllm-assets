{"name": "Fridge Chef", "html": "<!doctype html>\n<!--\n  Fridge Chef — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Fridge Chef</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"62148eb5a3\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); --h:28; }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:680px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.96); }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 90% 52%), hsl(calc(var(--h) - 22) 80% 44%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n\n  .snap{ width:100%; border:0; border-radius:20px; padding:22px 18px; color:#fff; text-align:left; display:flex; align-items:center; gap:14px;\n    background:linear-gradient(145deg, hsl(var(--h) 92% 54%), hsl(calc(var(--h) - 22) 82% 46%)); box-shadow:0 12px 30px hsl(var(--h) 80% 40% / .3); }\n  .snap .cam{ width:56px; height:56px; border-radius:18px; background:rgba(255,255,255,.2); border:1px solid rgba(255,255,255,.3);\n    display:flex; align-items:center; justify-content:center; font-size:24px; flex-shrink:0; }\n  .snap b{ display:block; font-size:19px; font-weight:800; letter-spacing:-.01em; }\n  .snap span{ display:block; font-size:13px; opacity:.88; margin-top:2px; }\n  .note{ font-size:12.5px; color:var(--muted); text-align:center; line-height:1.5; margin:12px 8px 0; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:16px; margin-top:12px; }\n  .card .top{ display:flex; align-items:center; gap:11px; margin-bottom:10px; }\n  .card .top .tile{ width:36px; height:36px; border-radius:10px; font-size:15px; }\n  .card .top b{ font-size:17px; font-weight:750; }\n  .answer{ font-size:16px; line-height:1.6; white-space:pre-wrap; overflow-wrap:anywhere; }\n  .go{ width:100%; min-height:48px; margin-top:14px; border:none; border-radius:14px; font-size:15.5px; font-weight:700;\n    display:flex; align-items:center; justify-content:center; gap:8px; background:hsl(var(--h) 90% 50% / .14); color:hsl(var(--h) 85% 34%); }\n  @media (prefers-color-scheme:dark){ .go{ color:hsl(var(--h) 95% 62%); } }\n\n  .busy .top b{ display:flex; align-items:center; gap:9px; }\n  .spin{ width:16px; height:16px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n  .skel{ height:14px; border-radius:7px; background:var(--fill); margin-top:10px; animation:shimmer 1.4s ease-in-out infinite; }\n  .skel.w8{ width:80%; } .skel.w6{ width:60%; } .skel.w9{ width:92%; }\n  @keyframes shimmer{ 50%{ opacity:.45; } }\n  .warn{ display:flex; gap:10px; align-items:flex-start; }\n  .warn svg{ color:#ff9f0a; margin-top:2px; font-size:18px; }\n  .warn p{ font-size:14.5px; line-height:1.5; }\n  .warn p b{ display:block; font-size:15.5px; margin-bottom:2px; }\n\n  [hidden]{ display:none !important; }\n  @media (prefers-reduced-motion:reduce){ .spin{ animation-duration:2.4s; } .skel{ animation:none; } button:active{ transform:none; } }\n\n/* myllm-fullscreen-v1 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-fork\" viewBox=\"0 0 24 24\"><g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 3v6a2 2 0 0 0 4 0V3M9 11v10\"/><path d=\"M17 21V3c-2 1.2-3 3.8-3 7.5h3\"/></g></symbol>\n  <symbol id=\"i-cam\" viewBox=\"0 0 24 24\"><g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\"><path d=\"M4 8.5A1.5 1.5 0 0 1 5.5 7H8l1.5-2h5L16 7h2.5A1.5 1.5 0 0 1 20 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 17.5z\"/><circle cx=\"12\" cy=\"13\" r=\"3.5\"/></g></symbol>\n  <symbol id=\"i-warn\" viewBox=\"0 0 24 24\"><path d=\"M10.3 3.9a2 2 0 0 1 3.4 0l8 13.6a2 2 0 0 1-1.7 3H4a2 2 0 0 1-1.7-3zM12 9a1 1 0 0 0-1 1v4a1 1 0 0 0 2 0v-4a1 1 0 0 0-1-1zm0 7.2a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z\" fill=\"currentColor\"/></symbol>\n</defs></svg>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-fork\"/></svg></div>\n  <div class=\"ht\"><h1>Fridge Chef</h1><p>Snap what's in your fridge and get recipe ideas from it</p></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Fridge Chef\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n\n<div id=\"home\">\n  <button class=\"snap\" id=\"snapBtn\" type=\"button\">\n    <span class=\"cam\"><svg class=\"i\"><use href=\"#i-cam\"/></svg></span>\n    <span><b>Snap my fridge</b><span>Or your cupboard — whatever you've got</span></span>\n  </button>\n  <p class=\"note\" id=\"hint\">Uses your camera and your AI, privately on your device. Needs the latest MyLLM with “Allow apps to use the AI” on.</p>\n</div>\n<div id=\"out\"></div>\n\n<script>\nfunction el(id){return document.getElementById(id)}\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\n\nvar PROMPT = 'You are a resourceful home cook. Look at this photo of fridge or pantry contents and list the main ingredients you can identify. Then suggest 3 quick recipes I could make mostly from them, each as a title plus a one-line description. Keep it concise and practical; note if a common staple is assumed.';\n\nfunction icon(n){return '<svg class=\"i\"><use href=\"#i-'+n+'\"/></svg>'}\nfunction card(html){el('out').innerHTML='';var d=document.createElement('div');d.className='card';d.innerHTML=html;el('out').appendChild(d);return d}\nfunction home(){el('out').innerHTML='';el('home').hidden=false}\n\nfunction cook(){\n  var VISION=window.myllmVision;\n  if(!VISION){\n    var d=card('<div class=\"warn\">'+icon('warn')+'<p><b>Your AI can’t see photos here yet</b>This needs the latest MyLLM with “Allow apps to use the AI” enabled in Settings.</p></div>');\n    return;\n  }\n  haptic('light');\n  /* The camera opens over the page; this card waits underneath for the answer. */\n  el('home').hidden=true;\n  card('<div class=\"busy\"><div class=\"top\"><div class=\"tile\">'+icon('fork')+'</div><b><i class=\"spin\"></i>Looking at your photo…</b></div>'+\n    '<div class=\"skel w9\"></div><div class=\"skel w8\"></div><div class=\"skel w6\"></div><div class=\"skel w8\"></div></div>');\n  VISION(PROMPT).then(function(answer){\n    if(answer == null){ home(); return; } // cancelled\n    show(answer);\n  }).catch(function(e){\n    fail((e && e.message) ? e.message : 'Something went wrong.');\n  });\n}\n\nfunction show(text){\n  el('home').hidden=true;\n  var d=card('<div class=\"top\"><div class=\"tile\">'+icon('fork')+'</div><b>What you can cook</b></div><div class=\"answer\"></div>'+\n    '<button class=\"go\" type=\"button\">'+icon('cam')+'Snap again</button>');\n  d.querySelector('.answer').textContent = text;\n  d.querySelector('button').onclick = function(){ home(); cook(); };\n  haptic('success');\n  window.scrollTo(0,0);\n}\nfunction fail(msg){\n  el('home').hidden=true;\n  var d=card('<div class=\"warn\">'+icon('warn')+'<p><b>Couldn’t read that photo</b><span></span></p></div>'+\n    '<button class=\"go\" type=\"button\">'+icon('cam')+'Try again</button>');\n  d.querySelector('.warn span').textContent=msg;\n  d.querySelector('button').onclick=function(){ home(); cook(); };\n}\nel('snapBtn').onclick=cook;\n\n/* myllm-fullscreen-v1 — full screen where MyLLM can also close the app for us (myllmClose,\n   5.6.2+): full screen hides MyLLM's Done, and a page with no way out is\n   worse than a repeated title, so elsewhere nothing changes. The spacer keeps\n   the header clear of the status bar only if the page doesn't already. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  function inset(){\n    var p = document.createElement(\"div\");\n    p.style.cssText = \"position:fixed;top:0;left:0;width:1px;visibility:hidden;height:env(safe-area-inset-top)\";\n    document.body.appendChild(p); var h = p.offsetHeight; p.parentNode.removeChild(p); return h;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = \"0px\";\n    if (!document.body.classList.contains(\"imm\")) return;\n    var need = inset() + 6 - (head.getBoundingClientRect().top + window.scrollY);\n    sp.style.height = Math.max(0, Math.round(need)) + \"px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  window.addEventListener(\"resize\", fit);\n  sync();\n})();\n</script></body></html>\n"}