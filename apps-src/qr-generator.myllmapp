{"name": "QR Generator", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>:root{color-scheme:light dark;--accent:#0a84ff}\n*{box-sizing:border-box}\nbody{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:18px 16px;background:#f2f2f7;color:#111}\n@media(prefers-color-scheme:dark){body{background:#000;color:#eee}textarea,select,.qrwrap{background:#1c1c1e;color:#eee;border-color:#3a3a3c}}\nh1{font-size:22px;margin:0 0 4px}\n.sub{font-size:13px;opacity:.6;margin-bottom:14px}\ntextarea{width:100%;height:84px;padding:12px;border:1px solid #d1d1d6;border-radius:11px;font-size:15px;background:#fff;color:#111;resize:vertical;-webkit-user-select:text;user-select:text}\n.opts{display:flex;gap:8px;margin:10px 0}\n.opts label{flex:1;font-size:12px;opacity:.6}\nselect{width:100%;padding:9px;border:1px solid #d1d1d6;border-radius:9px;font-size:15px;background:#fff;color:#111;margin-top:3px}\nbutton.go{width:100%;border:0;background:var(--accent);color:#fff;border-radius:11px;padding:13px;font-size:15px;font-weight:600}\nbutton:disabled{opacity:.5}\n#status{font-size:13px;opacity:.75;min-height:18px;text-align:center;margin:12px 0}\n.qrwrap{background:#fff;border-radius:18px;padding:18px;margin-top:8px;text-align:center;box-shadow:0 1px 4px rgba(0,0,0,.1);display:none}\n.qrwrap img{width:100%;max-width:300px;image-rendering:pixelated;border-radius:8px}\n.acts{display:flex;gap:8px;margin-top:14px}\n.acts button{flex:1;border:0;border-radius:10px;padding:11px;font-size:14px;font-weight:600;background:#e8eefc;color:var(--accent)}\n@media(prefers-color-scheme:dark){.acts button{background:#15223a}}\n</style></head><body>\n<h1>🔳 QR Generator</h1>\n<div class=\"sub\">Turn any text or link into a scannable QR code — then save it to Photos.</div>\n<textarea id=\"text\" placeholder=\"Text, URL, Wi-Fi, contact… anything\" enterkeyhint=\"go\" autocapitalize=\"off\">https://www.opticell-limited.com/myllm</textarea>\n<div class=\"opts\">\n  <label>Size<select id=\"size\"><option value=\"240\">Small</option><option value=\"360\" selected>Medium</option><option value=\"600\">Large</option></select></label>\n  <label>Error correction<select id=\"ecc\"><option value=\"L\">Low</option><option value=\"M\" selected>Medium</option><option value=\"Q\">Quartile</option><option value=\"H\">High</option></select></label>\n</div>\n<button class=\"go\" id=\"go\" onclick=\"generate()\">Generate QR</button>\n<div id=\"status\"></div>\n<div class=\"qrwrap\" id=\"qrwrap\">\n  <img id=\"qr\" alt=\"QR code\">\n  <div class=\"acts\">\n    <button onclick=\"saveImg()\">⬇︎ Save to Photos</button>\n    <button onclick=\"shareText()\">↗︎ Share text</button>\n  </div>\n</div>\n<script>\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar dataUrl=null;\nfunction el(i){return document.getElementById(i)}\nfunction setStatus(t){el('status').textContent=t||''}\n\nfunction generate(){\n  var text=el('text').value.trim();\n  if(!text){setStatus('Enter some text or a link first.');return}\n  if(!window.myllmFetch){setStatus('QR codes are generated over the network — turn on app network access in Settings → MyLLMos Apps.');return}\n  store.setItem('last',text);\n  var size=el('size').value,ecc=el('ecc').value;\n  el('go').disabled=true;setStatus('Generating…');el('qrwrap').style.display='none';\n  var url='https://api.qrserver.com/v1/create-qr-code/?size='+size+'x'+size+'&ecc='+ecc+'&margin=8&data='+encodeURIComponent(text);\n  myllmFetch(url,{headers:{Accept:'image/png'}})\n  .then(function(r){\n    if(!r||!r.ok)throw new Error('the QR service returned '+((r&&r.status)||'no response'));\n    var b64=r.bodyBase64||'';\n    if(!b64)throw new Error('no image came back');\n    dataUrl='data:image/png;base64,'+b64;\n    el('qr').src=dataUrl;el('qrwrap').style.display='block';setStatus('');\n    if(window.myllmHaptic)myllmHaptic('success');\n  }).catch(function(err){setStatus('Couldn’t generate: '+err.message)})\n  .then(function(){el('go').disabled=false});\n}\nfunction saveImg(){\n  if(!dataUrl)return;\n  if(!window.myllmSaveImage){setStatus('Saving to Photos needs the latest MyLLM.');return}\n  Promise.resolve(myllmSaveImage(dataUrl)).then(function(){setStatus('✓ Saved to Photos')})\n  .catch(function(e){setStatus('Couldn’t save: '+(e&&e.message||e))});\n}\nfunction shareText(){var t=el('text').value.trim();if(t&&window.myllmShare)myllmShare(t)}\n\nel('text').addEventListener('keydown',function(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();generate()}});\nstore.getItem('last').then(function(v){if(v)el('text').value=v});\nif(!window.myllmFetch)setStatus('Heads-up: this app needs app network access (Settings → MyLLMos Apps).');\n</script></body></html>\n", "kind": "html", "iconSymbol": "qrcode", "iconColor": "blue"}