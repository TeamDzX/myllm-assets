{"name": "Reader", "html": "<!doctype html>\n<!--\n  Reader — MyLLMos App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>:root{--build-id:\"45fb2e6045\";color-scheme:light dark;--accent:#0a84ff}\n*{box-sizing:border-box}\nbody{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:0;background:#f2f2f7;color:#111}\n@media(prefers-color-scheme:dark){body{background:#000;color:#eee}.bar{background:rgba(20,20,22,.92)}input{background:#1c1c1e;color:#eee;border-color:#3a3a3c}.ask,.answer{background:#1c1c1e}}\n.bar{position:sticky;top:0;background:rgba(242,242,247,.94);backdrop-filter:saturate(180%) blur(12px);padding:12px 14px;display:flex;gap:8px;z-index:5;border-bottom:1px solid rgba(128,128,128,.18)}\ninput{flex:1;padding:11px 13px;border:1px solid #d1d1d6;border-radius:10px;font-size:16px;background:#fff}\n.bar button{border:0;background:var(--accent);color:#fff;border-radius:10px;padding:0 16px;font-weight:600;font-size:15px}\n.content{padding:20px 18px 32px;max-width:680px;margin:0 auto}\n.title{font-size:26px;font-weight:700;line-height:1.2;margin-bottom:6px}\n.src{font-size:13px;opacity:.55;margin-bottom:18px;word-break:break-all}\n.content p,.content li{font-size:18px;line-height:1.65;margin:0 0 16px}\n.content li{margin-bottom:8px}\n.content h2,.content h3{font-size:20px;margin:24px 0 10px;line-height:1.3}\n#status{padding:30px 18px;text-align:center;opacity:.7;font-size:15px}\n.welcome{padding:40px 24px;text-align:center;opacity:.7}\n.welcome h2{font-size:18px}.welcome p{font-size:14px;line-height:1.5}\n.ask{position:sticky;bottom:0;background:#fff;border-top:1px solid rgba(128,128,128,.2);padding:10px 14px;display:none;gap:8px}\n.ask input{font-size:15px}\n.ask button{border:0;background:#5e5ce6;color:#fff;border-radius:10px;padding:0 14px;font-weight:600}\n.answer{background:#eef;border-radius:12px;padding:14px 16px;margin:0 18px 18px;font-size:15px;line-height:1.55;display:none;white-space:pre-wrap}\n@media(prefers-color-scheme:dark){.answer{background:#15152a}}\n.answer b{color:#5e5ce6}\n</style></head><body>\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-family:-apple-system,system-ui,sans-serif;font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;line-height:1;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n@media(min-width:768px){.content{max-width:720px}}\n</style>\n<script>\n(function(){\n  if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;\n  window.__myllmAiWrap=true;\n  var orig=window.myllmAsk,depth=0,node=null;\n  function ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\n    node.innerHTML='<span class=\"myllm-ai-cog\">\\u2699\\uFE0F</span><span>AI is thinking\\u2026 <small>privately, on your device</small></span>';\n    (document.body||document.documentElement).appendChild(node);}\n  function show(){ensure();depth++;node.classList.add('on');}\n  function hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\n  window.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\n    return Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};\n})();\n</script>\n\n<div class=\"bar\">\n  <input id=\"url\" placeholder=\"Enter a web address…\" enterkeyhint=\"go\" autocapitalize=\"off\" autocorrect=\"off\">\n  <button onclick=\"go()\">Read</button>\n</div>\n<div id=\"status\"></div>\n<div class=\"welcome\" id=\"welcome\">\n  <h2>📖 Reader</h2>\n  <p>Type any article URL above. The page is fetched and stripped down to clean, readable text — then you can ask your AI about it.</p>\n</div>\n<div class=\"content\" id=\"content\" style=\"display:none\"></div>\n<div class=\"answer\" id=\"answer\"></div>\n<div class=\"ask\" id=\"ask\">\n  <input id=\"q\" placeholder=\"Ask about this page…\" enterkeyhint=\"send\">\n  <button onclick=\"askAI()\">Ask</button>\n</div>\n<script>\nvar lastText='',lastTitle='';\nfunction el(i){return document.getElementById(i)}\nfunction setStatus(t){var s=el('status');s.style.display=t?'block':'none';s.textContent=t||''}\n\nfunction normUrl(u){u=u.trim();if(!u)return'';if(!/^https?:\\/\\//i.test(u))u='https://'+u;return u}\n\nfunction go(){\n  var u=normUrl(el('url').value);if(!u)return;\n  el('url').value=u;el('url').blur();\n  el('welcome').style.display='none';el('content').style.display='none';\n  el('answer').style.display='none';el('ask').style.display='none';\n  if(!window.myllmFetch){setStatus('This app needs network access — update MyLLM and enable app network access in Settings.');return}\n  setStatus('Fetching…');\n  myllmFetch(u,{headers:{Accept:'text/html'}})\n  .then(function(r){\n    if(!r||!r.ok)throw new Error('the site returned '+((r&&r.status)||'no response'));\n    var parsed=extract(r.body,u);\n    if(!parsed.html){throw new Error('couldn’t find readable text on this page')}\n    lastText=parsed.text;lastTitle=parsed.title;\n    el('content').innerHTML='<div class=\"title\">'+esc(parsed.title)+'</div><div class=\"src\">'+esc(u)+'</div>'+parsed.html;\n    el('content').style.display='block';setStatus('');\n    if(window.myllmAsk){el('ask').style.display='flex'}\n    window.scrollTo(0,0);\n  }).catch(function(err){setStatus('Couldn’t open this page: '+err.message)});\n}\n\nfunction extract(html,base){\n  var doc=new DOMParser().parseFromString(html,'text/html');\n  var title=(doc.querySelector('title')&&doc.querySelector('title').textContent.trim())||\n            (doc.querySelector('h1')&&doc.querySelector('h1').textContent.trim())||'Untitled';\n  ['script','style','noscript','nav','header','footer','aside','form','iframe','svg','button'].forEach(function(t){\n    Array.prototype.forEach.call(doc.querySelectorAll(t),function(n){n.remove()});\n  });\n  // Pick the densest container: <article>, else the node whose <p> text is longest.\n  var root=doc.querySelector('article');\n  if(!root){\n    var best=null,bestLen=0;\n    Array.prototype.forEach.call(doc.querySelectorAll('main,section,div'),function(n){\n      var len=0;Array.prototype.forEach.call(n.querySelectorAll(':scope > p'),function(p){len+=p.textContent.length});\n      if(len>bestLen){bestLen=len;best=n}\n    });\n    root=best||doc.body;\n  }\n  var out='',text='';\n  Array.prototype.forEach.call(root.querySelectorAll('h2,h3,p,li'),function(n){\n    var t=n.textContent.replace(/\\s+/g,' ').trim();\n    if(t.length<2)return;\n    var tag=n.tagName.toLowerCase();\n    if((tag==='p'||tag==='li')&&t.length<25)return;   // drop boilerplate scraps\n    out+='<'+tag+'>'+esc(t)+'</'+tag+'>';\n    text+=t+'\\n';\n  });\n  return {title:title,html:out,text:text.trim()};\n}\n\nfunction askAI(){\n  var q=el('q').value.trim();if(!q)return;\n  if(!window.myllmAsk)return;\n  var A=el('answer');A.style.display='block';A.innerHTML='<b>Thinking…</b>';\n  var ctx=lastText.slice(0,7000);\n  myllmAsk('Based ONLY on this article, answer the question. If the answer isn’t in the text, say so.\\n\\nARTICLE (\"'+lastTitle+'\"):\\n'+ctx+'\\n\\nQUESTION: '+q,\n           {system:'You are a concise reading assistant. Answer from the provided article only.'})\n  .then(function(reply){A.innerHTML='<b>'+esc(q)+'</b>\\n\\n'+esc(reply.trim())})\n  .catch(function(err){A.innerHTML='Couldn’t answer: '+esc(err.message)});\n  el('q').value='';\n}\nfunction esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;')}\n\nel('url').addEventListener('keydown',function(e){if(e.key==='Enter')go()});\nel('q').addEventListener('keydown',function(e){if(e.key==='Enter')askAI()});\n</script></body></html>\n", "kind": "html", "iconSymbol": "book.fill", "iconColor": "blue"}