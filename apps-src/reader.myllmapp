{"name": "Reader", "html": "<!doctype html>\n<!--\n  Reader — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Reader</title>\n<style>:root{--build-id:\"45fb2e6045\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); --h:212; }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:720px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) 0 calc(16px + env(safe-area-inset-left)); }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.96); }\n  [hidden]{ display:none !important; }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 6px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 28%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n\n  /* the address bar stays put while an article scrolls; the header scrolls away */\n  .stick{ position:sticky; top:0; z-index:5; margin:0 calc(-16px - env(safe-area-inset-right)) 0 calc(-16px - env(safe-area-inset-left));\n    padding:8px calc(16px + env(safe-area-inset-right)) 10px calc(16px + env(safe-area-inset-left));\n    background:color-mix(in srgb, var(--bg) 90%, transparent); -webkit-backdrop-filter:saturate(180%) blur(12px); backdrop-filter:saturate(180%) blur(12px); }\n  .bar{ display:flex; gap:8px; }\n  .field{ flex:1; min-width:0; display:flex; align-items:center; gap:8px; border:1px solid var(--line); background:var(--surface); border-radius:12px; padding:0 12px; }\n  .field svg{ color:var(--muted); }\n  .field input{ flex:1; min-width:0; border:0; background:none; outline:none; font:inherit; font-size:16px; padding:12px 0; color:var(--ink); }\n  .field:focus-within{ border-color:var(--acc); }\n  .go{ flex-shrink:0; min-height:46px; border:0; border-radius:12px; padding:0 16px; background:var(--acc); color:#fff; font-size:15px; font-weight:700; display:flex; align-items:center; gap:7px; }\n  .go:disabled{ opacity:.55; }\n  .spin{ width:16px; height:16px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n\n  .welcome{ text-align:center; background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:26px 22px; margin-top:6px; }\n  .welcome .tile{ width:48px; height:48px; border-radius:14px; font-size:21px; margin:0 auto 10px; }\n  .welcome b{ display:block; font-size:16px; font-weight:750; }\n  .welcome p{ font-size:13.5px; color:var(--muted); line-height:1.5; max-width:320px; margin:6px auto 0; }\n\n  .notice{ display:flex; gap:12px; align-items:flex-start; background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:14px; margin:6px 0 12px; }\n  .notice .tile{ width:36px; height:36px; border-radius:10px; font-size:15px; }\n  .notice.err .tile{ background:linear-gradient(145deg,#ff6b5f,#c0392b); }\n  .notice.off .tile{ background:linear-gradient(145deg,#8e8e93,#48484a); }\n  .notice b{ display:block; font-size:15px; font-weight:750; }\n  .notice p{ font-size:13.5px; color:var(--muted); margin-top:2px; line-height:1.45; overflow-wrap:anywhere; }\n  .notice button{ margin-top:10px; min-height:36px; padding:0 14px; border-radius:10px; border:0; background:var(--acc); color:#fff; font-weight:700; font-size:13.5px; display:inline-flex; align-items:center; gap:6px; }\n\n  .sk{ padding:18px 4px; }\n  .sk i{ display:block; height:14px; border-radius:7px; background:var(--fill); margin-bottom:12px; animation:pulse 1.3s ease-in-out infinite; }\n  .sk i.t{ height:26px; width:80%; margin-bottom:18px; }\n  .sk i:nth-child(4n){ width:70%; margin-bottom:22px; }\n  @keyframes pulse{ 50%{ opacity:.45; } }\n\n  /* the article: comfortable measure and rhythm */\n  .content{ max-width:68ch; margin:0 auto; padding:14px 4px 28px; }\n  .content .title{ font-size:27px; font-weight:800; line-height:1.18; letter-spacing:-.015em; margin-bottom:8px; overflow-wrap:anywhere; }\n  .content .src{ display:flex; align-items:center; gap:6px; font-size:13px; color:var(--muted); margin-bottom:22px; }\n  .content .src span{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  .content p, .content li{ font-size:18px; line-height:1.62; margin:0 0 1.05em; overflow-wrap:break-word; }\n  .content li{ margin:0 0 .5em 1.2em; }\n  .content h2, .content h3{ font-size:21px; font-weight:750; line-height:1.3; margin:1.5em 0 .5em; }\n\n  .answer{ max-width:68ch; margin:0 auto 12px; background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:14px 15px; }\n  .answer .q{ display:flex; gap:8px; align-items:flex-start; font-size:13px; font-weight:750; color:hsl(var(--h) 70% 45%); margin-bottom:7px; }\n  @media (prefers-color-scheme:dark){ .answer .q{ color:hsl(var(--h) 85% 68%); } }\n  .answer .a{ font-size:15.5px; line-height:1.55; white-space:pre-wrap; }\n  .answer .a.err{ color:#ff453a; }\n  .answer .wait{ display:flex; align-items:center; gap:8px; color:var(--muted); font-size:14px; }\n\n  .ask{ position:sticky; bottom:0; z-index:5; margin:0 calc(-16px - env(safe-area-inset-right)) 0 calc(-16px - env(safe-area-inset-left));\n    padding:10px calc(16px + env(safe-area-inset-right)) calc(10px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left));\n    background:color-mix(in srgb, var(--bg) 90%, transparent); -webkit-backdrop-filter:saturate(180%) blur(12px); backdrop-filter:saturate(180%) blur(12px); border-top:1px solid var(--line); }\n  .ask .bar{ max-width:68ch; margin:0 auto; }\n  .ask .go{ background:hsl(252 70% 58%); }\n  .pad{ height:calc(30px + env(safe-area-inset-bottom)); }\n\n  @media (max-width:350px){ .go span{ display:none; } }\n  @media (prefers-reduced-motion:reduce){ .sk i{ animation:none; } .spin{ animation-duration:2.4s; } button:active{ transform:none; } }\n  @keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n  .myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n  .myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n  .myllm-ai-cog{width:16px;height:16px;border-radius:50%;border:2.4px solid #a78bfa;border-right-color:transparent;animation:myllmAiSpin .9s linear infinite;flex-shrink:0}\n  .myllm-ai-busy small{font-weight:400;opacity:.6}\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-book\" viewBox=\"0 0 24 24\"><path d=\"M12 6.2C10.2 4.9 7.8 4.3 4.5 4.5a1 1 0 0 0-1 1v11.8a1 1 0 0 0 1.05 1c3-.14 5.2.4 6.9 1.6.35.25.75.25 1.1 0 1.7-1.2 3.9-1.74 6.9-1.6a1 1 0 0 0 1.05-1V5.5a1 1 0 0 0-1-1c-3.3-.2-5.7.4-7.5 1.7zM11 8v9.1c-1.6-.8-3.5-1.2-5.5-1.2V6.4c2.3-.05 4 .45 5.5 1.6zm2 0c1.5-1.15 3.2-1.65 5.5-1.6v9.5c-2 0-3.9.4-5.5 1.2z\"/></symbol>\n  <symbol id=\"i-link\" viewBox=\"0 0 24 24\"><path d=\"M10.6 13.4a1 1 0 0 1 0-1.4l3.5-3.5a1 1 0 1 1 1.4 1.4L12 13.4a1 1 0 0 1-1.4 0zM8.5 10.1a1 1 0 0 1 0 1.4L6.4 13.6a3 3 0 0 0 4.2 4.2l2.1-2.1a1 1 0 1 1 1.4 1.4L12 19.2A5 5 0 0 1 4.8 12l2.3-2.1a1 1 0 0 1 1.4.2zM12 4.8A5 5 0 0 1 19.2 12l-2.3 2.1a1 1 0 1 1-1.4-1.4l2.1-2.1a3 3 0 0 0-4.2-4.2l-2.1 2.1a1 1 0 1 1-1.4-1.4z\"/></symbol>\n  <symbol id=\"i-arrow\" viewBox=\"0 0 24 24\"><path d=\"M5 12h13M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-send\" viewBox=\"0 0 24 24\"><path d=\"M3.4 11.1L19.6 3.6a1 1 0 0 1 1.3 1.3l-7.5 16.2a1 1 0 0 1-1.8-.1L9.9 14.1 3.5 12.9a1 1 0 0 1-.1-1.8z\"/></symbol>\n  <symbol id=\"i-spark\" viewBox=\"0 0 24 24\"><path d=\"M10 2.5l1.9 5.6 5.6 1.9-5.6 1.9L10 17.5l-1.9-5.6L2.5 10l5.6-1.9zM18.5 14l.95 2.55L22 17.5l-2.55.95L18.5 21l-.95-2.55L15 17.5l2.55-.95z\"/></symbol>\n  <symbol id=\"i-refresh\" viewBox=\"0 0 24 24\"><path d=\"M20 12a8 8 0 1 1-2.6-5.9M20 4v5h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-off\" viewBox=\"0 0 24 24\"><path d=\"M3.3 3.3a1 1 0 0 1 1.4 0l16 16a1 1 0 0 1-1.4 1.4l-3.5-3.5a2 2 0 1 1-2.5-2.5L10.8 12a5 5 0 0 0-3.4 1.6 1 1 0 0 1-1.5-1.3 7 7 0 0 1 3.1-2L7 8.4a10 10 0 0 0-3.2 2.2 1 1 0 0 1-1.4-1.4A12 12 0 0 1 5.6 7L3.3 4.7a1 1 0 0 1 0-1.4zM12 6c3.5 0 6.8 1.4 9.2 3.8a1 1 0 0 1-1.4 1.4A11 11 0 0 0 12 8h-.6L9.6 6.2C10.4 6.1 11.2 6 12 6z\"/></symbol>\n  <symbol id=\"i-warn\" viewBox=\"0 0 24 24\"><path d=\"M10.3 3.9a2 2 0 0 1 3.4 0l8 13.6a2 2 0 0 1-1.7 3H4a2 2 0 0 1-1.7-3zM12 9a1 1 0 0 0-1 1v4a1 1 0 0 0 2 0v-4a1 1 0 0 0-1-1zm0 7.2a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z\"/></symbol>\n</defs></svg>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\"></span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n\n<div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-book\"/></svg></div>\n  <div class=\"ht\"><h1>Reader</h1><p>Clean reading, then ask your AI</p></div>\n</div>\n<div class=\"stick\"><div class=\"bar\">\n  <label class=\"field\"><svg class=\"i\"><use href=\"#i-link\"/></svg><input id=\"url\" placeholder=\"Paste an article address…\" enterkeyhint=\"go\" autocapitalize=\"off\" autocorrect=\"off\" spellcheck=\"false\" aria-label=\"Web address\"></label>\n  <button class=\"go\" id=\"readBtn\" type=\"button\"><svg class=\"i\"><use href=\"#i-arrow\"/></svg><span>Read</span></button>\n</div></div>\n<div id=\"status\"></div>\n<div class=\"welcome\" id=\"welcome\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-book\"/></svg></div>\n  <b>Any article, without the clutter</b>\n  <p>Paste an article’s address above. The page is fetched and stripped down to clean, readable text on your phone — then you can ask your AI about it.</p>\n</div>\n<div class=\"content\" id=\"content\" hidden></div>\n<div class=\"answer\" id=\"answer\" hidden></div>\n<div class=\"pad\" id=\"pad\"></div>\n<div class=\"ask\" id=\"ask\" hidden><div class=\"bar\">\n  <label class=\"field\"><svg class=\"i\"><use href=\"#i-spark\"/></svg><input id=\"q\" placeholder=\"Ask about this page…\" enterkeyhint=\"send\" aria-label=\"Question\"></label>\n  <button class=\"go\" id=\"askBtn\" type=\"button\" aria-label=\"Ask\"><svg class=\"i\"><use href=\"#i-send\"/></svg><span>Ask</span></button>\n</div></div>\n\n<script>\nvar lastText='',lastTitle='',lastUrl='';\nfunction el(i){return document.getElementById(i)}\n/* Looked up when used, never kept: MyLLM can add bridges after this script runs. */\nfunction net(){return window.myllmFetch||null}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nfunction icon(n){return '<svg class=\"i\"><use href=\"#i-'+n+'\"/></svg>'}\nfunction notice(kind,title,text,retry){\n  var S=el('status');\n  if(!kind){S.innerHTML='';return}\n  S.innerHTML='<div class=\"notice '+kind+'\"><div class=\"tile\">'+icon(kind==='off'?'off':'warn')+'</div><div><b>'+esc(title)+'</b><p>'+esc(text)+'</p>'+\n    (retry?'<button type=\"button\">'+icon('refresh')+'Try again</button>':'')+'</div></div>';\n  if(retry)S.querySelector('button').onclick=retry;\n}\nfunction skeleton(){var h='<div class=\"sk\"><i class=\"t\"></i>';for(var i=0;i<9;i++)h+='<i></i>';el('status').innerHTML=h+'</div>'}\n\nfunction normUrl(u){u=u.trim();if(!u)return'';if(!/^https?:\\/\\//i.test(u))u='https://'+u;return u}\nfunction host(u){try{return new URL(u).hostname.replace(/^www\\./,'')}catch(e){return u}}\n\nfunction go(){\n  var u=normUrl(el('url').value);if(!u)return;\n  el('url').value=u;el('url').blur();lastUrl=u;\n  el('welcome').hidden=true;el('content').hidden=true;\n  el('answer').hidden=true;el('ask').hidden=true;\n  if(!net()){notice('off','Network access is off','Reader needs “Allow apps to use the internet” in MyLLM’s Settings.',go);return}\n  skeleton();\n  var b=el('readBtn');b.disabled=true;b.innerHTML='<i class=\"spin\"></i><span>Reading</span>';\n  net()(u,{headers:{Accept:'text/html'}})\n  .then(function(r){\n    if(!r||!r.ok)throw new Error('the site returned '+((r&&r.status)||'no response'));\n    var parsed=extract(r.body,u);\n    if(!parsed.html){throw new Error('couldn’t find readable text on this page')}\n    lastText=parsed.text;lastTitle=parsed.title;\n    el('content').innerHTML='<div class=\"title\">'+esc(parsed.title)+'</div><div class=\"src\">'+icon('link')+'<span>'+esc(host(u))+'</span></div>'+parsed.html;\n    el('content').hidden=false;notice(null);\n    if(window.myllmAsk){el('ask').hidden=false}\n    el('pad').hidden=!!window.myllmAsk;\n    window.scrollTo(0,0);haptic('light');\n  }).catch(function(err){notice('err','Couldn’t open this page',err.message,go)})\n  .then(function(){b.disabled=false;b.innerHTML=icon('arrow')+'<span>Read</span>'});\n}\n\nfunction extract(html,base){\n  var doc=new DOMParser().parseFromString(html,'text/html');\n  var title=(doc.querySelector('title')&&doc.querySelector('title').textContent.trim())||\n            (doc.querySelector('h1')&&doc.querySelector('h1').textContent.trim())||'Untitled';\n  ['script','style','noscript','nav','header','footer','aside','form','iframe','svg','button'].forEach(function(t){\n    Array.prototype.forEach.call(doc.querySelectorAll(t),function(n){n.remove()});\n  });\n  // Pick the densest container: <article>, else the node whose <p> text is longest.\n  var root=doc.querySelector('article');\n  if(!root){\n    var best=null,bestLen=0;\n    Array.prototype.forEach.call(doc.querySelectorAll('main,section,div'),function(n){\n      var len=0;Array.prototype.forEach.call(n.querySelectorAll(':scope > p'),function(p){len+=p.textContent.length});\n      if(len>bestLen){bestLen=len;best=n}\n    });\n    root=best||doc.body;\n  }\n  var out='',text='';\n  Array.prototype.forEach.call(root.querySelectorAll('h2,h3,p,li'),function(n){\n    var t=n.textContent.replace(/\\s+/g,' ').trim();\n    if(t.length<2)return;\n    var tag=n.tagName.toLowerCase();\n    if((tag==='p'||tag==='li')&&t.length<25)return;   // drop boilerplate scraps\n    out+='<'+tag+'>'+esc(t)+'</'+tag+'>';\n    text+=t+'\\n';\n  });\n  return {title:title,html:out,text:text.trim()};\n}\n\nfunction askAI(){\n  var q=el('q').value.trim();if(!q)return;\n  if(!window.myllmAsk)return;\n  var A=el('answer');A.hidden=false;\n  A.innerHTML='<div class=\"q\">'+icon('spark')+'<span>'+esc(q)+'</span></div><div class=\"wait\"><i class=\"spin\"></i>Reading the article…</div>';\n  var btn=el('askBtn');btn.disabled=true;\n  var ctx=lastText.slice(0,7000);\n  myllmAsk('Based ONLY on this article, answer the question. If the answer isn’t in the text, say so.\\n\\nARTICLE (\"'+lastTitle+'\"):\\n'+ctx+'\\n\\nQUESTION: '+q,\n           {system:'You are a concise reading assistant. Answer from the provided article only.'})\n  .then(function(reply){A.innerHTML='<div class=\"q\">'+icon('spark')+'<span>'+esc(q)+'</span></div><div class=\"a\">'+esc(String(reply).trim())+'</div>';haptic('success')})\n  .catch(function(err){A.innerHTML='<div class=\"q\">'+icon('spark')+'<span>'+esc(q)+'</span></div><div class=\"a err\">Couldn’t answer: '+esc(err&&err.message||'the AI is unavailable')+'</div>'})\n  .then(function(){btn.disabled=false;A.scrollIntoView({block:'nearest',behavior:'smooth'})});\n  el('q').value='';\n}\nfunction esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;')}\n\nel('readBtn').onclick=go;\nel('askBtn').onclick=askAI;\nel('url').addEventListener('keydown',function(e){if(e.key==='Enter')go()});\nel('q').addEventListener('keydown',function(e){if(e.key==='Enter')askAI()});\n</script></body></html>\n", "kind": "html", "iconSymbol": "book.fill", "iconColor": "blue"}