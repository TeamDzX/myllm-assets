 binjgb core wasm, base64-inlined so the player is fully offline -->\n<script>window.BINJGB_WASM_B64=\"\";</script>\n<script>\n(function(){\n  var GB_W=160, GB_H=144;\n  var FRAME_BYTES=GB_W*GB_H*4;          // 92160, RGBA8888\n  var PPU_FRAME_TICKS=70224;            // ticks per video frame\n  var EVENT_NEW_FRAME=0x1, EVENT_AUDIO_BUFFER_FULL=0x2, EVENT_UNTIL_TICKS=0x4;\n  var CGB_COLOR_CURVE_GAMBATTE=2;       // 0=NONE,1=SAMEBOY,2=GAMBATTE\n  var AUDIO_FRAMES=1024;                // stereo pairs per AUDIO_BUFFER_FULL (smaller = lower latency)\n\n  var canvas=document.getElementById('screen'), ctx=canvas.getContext('2d');\n  var img=ctx.createImageData(GB_W,GB_H);\n  function status(m){ document.getElementById('status').textContent=m||''; }\n\n  // Inlined core missing/incomplete? Say so instead of dying silently.\n  if(typeof Binjgb==='undefined'){\n    status('Emulator core didn’t load — the app likely updated incompletely. Delete this app and re-install it from the gallery.');\n    var fb0=document.getElementById('file');\n    if(fb0) fb0.addEventListener('change', function(){ status('Please delete and re-install the app first — the emulator core is missing.'); });\n    return;\n  }\n\n  // --- Audio: schedule small AudioBuffers back-to-back on the timeline. iOS\n  //     WKWebView is unreliable with ScriptProcessorNode (that's why the NES\n  //     player is silent); scheduled BufferSources are the robust path. binjgb\n  //     resamples its PCM to our AudioContext rate, so no conversion is needed. ---\n  var AC=window.AudioContext||window.webkitAudioContext;\n  var actx=AC?new AC():null, RATE=actx?actx.sampleRate:44100;\n  var playHead=0;\n  function scheduleAudio(left,right){\n    // Only feed once the context is actually running (post user-gesture resume),\n    // so we never queue stale buffers against a frozen clock.\n    if(!actx || actx.state!=='running' || !left || left.length===0) return;\n    var n=left.length, buf=actx.createBuffer(2,n,RATE);\n    buf.getChannelData(0).set(left); buf.getChannelData(1).set(right);\n    var src=actx.createBufferSource(); src.buffer=buf; src.connect(actx.destination);\n    var now=actx.currentTime;\n    if(playHead < now+0.05) playHead = now+0.05;   // keep ~50ms lead; re-floor on underrun\n    src.start(playHead); playHead += n/RATE;\n  }\n  function resumeAudio(){ try{ if(actx && actx.state==='suspended') actx.resume(); }catch(e){} }\n\n  // ============================================================================\n  // GBCore — binjgb adapter (jsnes-style contract: WE own canvas/audio/input).\n  // All export names verified against the live binjgb.js export table.\n  // ============================================================================\n  function decodeWasmBase64(b64){\n    var bin=atob(b64), u8=new Uint8Array(bin.length);\n    for(var i=0;i<bin.length;i++) u8[i]=bin.charCodeAt(i);\n    return u8;\n  }\n  function GBCore(Module, sampleRate){\n    this.m=Module; this.sampleRate=sampleRate|0; this.audioFrames=AUDIO_FRAMES;\n    this.e=0; this.romPtr=0; this.romSize=0; this._romCopy=null; this.joypadBufferPtr=0;\n    this._fbPtr=0; this._fbSize=0; this._auPtr=0; this._auCapBytes=0; this._audioOut=[];\n  }\n  GBCore.create=function(wasmBytes, sampleRate){\n    // wasmBinary => plain WebAssembly.instantiate (no fetch/stream, no SAB). Offline.\n    return Binjgb({ wasmBinary:wasmBytes, locateFile:function(p){return p;},\n                    print:function(){}, printErr:function(){} })\n      .then(function(Module){ return new GBCore(Module, sampleRate); });\n  };\n  GBCore.prototype._destroyEmu=function(){\n    if(this.e){ this.m._emulator_delete(this.e); this.e=0; }\n    if(this.joypadBufferPtr){ this.m._joypad_delete(this.joypadBufferPtr); this.joypadBufferPtr=0; }\n    if(this.romPtr){ this.m._free(this.romPtr); this.romPtr=0; }\n    this._audioOut.length=0;\n  };\n  GBCore.prototype.load=function(romBytes){\n    this._destroyEmu();\n    var rom=(romBytes instanceof Uint8Array)?romBytes:new Uint8Array(romBytes);\n    var size=(rom.byteLength+0x7fff)&~0x7fff;           // align up to 32K (binjgb req)\n    var ptr=this.m._malloc(size);\n    new Uint8Array(this.m.HEAPU8.buffer, ptr, size).fill(0).set(rom);\n    var e=this.m._emulator_new_simple(ptr, size, this.sampleRate, this.audioFrames, CGB_COLOR_CURVE_GAMBATTE);\n    if(e===0){ this.m._free(ptr); throw new Error('Invalid or unsupported ROM'); }\n    this.e=e; this.romPtr=ptr; this.romSize=size; this._romCopy=rom.slice();\n    // CRITICAL: emulator_new_simple does NOT wire up joypad reading. binjgb reads\n    // input through a callback that copies the s_buttons state (written by\n    // _set_joyp_*) into the emulator each poll. Install the default callback (with\n    // a JoypadBuffer) or all button presses are silently ignored. (binjgb demo.js.)\n    this.joypadBufferPtr=this.m._joypad_new();\n    this.m._emulator_set_default_joypad_callback(e, this.joypadBufferPtr);\n    this._fbPtr=this.m._get_frame_buffer_ptr(e);\n    this._fbSize=this.m._get_frame_buffer_size(e);        // == 92160\n    this._auPtr=this.m._get_audio_buffer_ptr(e);\n    this._auCapBytes=this.m._get_audio_buffer_capacity(e);// == 2*audioFrames bytes\n  };\n  GBCore.prototype.runFrame=function(outRGBA){\n    if(!this.e) return false;\n    var m=this.m, e=this.e, target=m._emulator_get_ticks_f64(e)+PPU_FRAME_TICKS;\n    var gotFrame=false, guard=0;\n    while(guard++<16){\n      var event=m._emulator_run_until_f64(e, target);\n      if(event & EVENT_AUDIO_BUFFER_FULL) this._drainAudio();\n      if(event & EVENT_NEW_FRAME) gotFrame=true;\n      if(event & EVENT_UNTIL_TICKS){ if(m._emulator_get_ticks_f64(e)>=target) break; }\n    }\n    outRGBA.set(new Uint8Array(m.HEAPU8.buffer, this._fbPtr, this._fbSize)); // RGBA already\n    return gotFrame;\n  };\n  GBCore.prototype._drainAudio=function(){\n    var m=this.m, capBytes=this._auCapBytes; if(capBytes<=0) return;\n    var src=new Uint8Array(m.HEAPU8.buffer, this._auPtr, capBytes), frames=capBytes>>1;\n    var left=new Float32Array(frames), right=new Float32Array(frames);\n    for(var i=0,j=0;i<frames;i++,j+=2){ left[i]=(src[j]-128)/128; right[i]=(src[j+1]-128)/128; }\n    this._audioOut.push({left:left,right:right});\n  };\n  GBCore.prototype.pullAudio=function(){\n    if(this._audioOut.length===0) return null;\n    if(this._audioOut.length===1){ var c=this._audioOut.shift(); return {left:c.left,right:c.right}; }\n    var total=0,k; for(k=0;k<this._audioOut.length;k++) total+=this._audioOut[k].left.length;\n    var left=new Float32Array(total), right=new Float32Array(total), off=0;\n    for(k=0;k<this._audioOut.length;k++){ var ch=this._audioOut[k]; left.set(ch.left,off); right.set(ch.right,off); off+=ch.left.length; }\n    this._audioOut.length=0; return {left:left,right:right};\n  };\n  GBCore.prototype.setButton=function(name, pressed){\n    if(!this.e) return; var m=this.m, e=this.e, on=pressed?1:0;\n    switch(String(name).toLowerCase()){\n      case 'up': m._set_joyp_up(e,on); break;\n      case 'down': m._set_joyp_down(e,on); break;\n      case 'left': m._set_joyp_left(e,on); break;\n      case 'right': m._set_joyp_right(e,on); break;\n      case 'a': m._set_joyp_A(e,on); break;   // A/B exports are UPPERCASE\n      case 'b': m._set_joyp_B(e,on); break;\n      case 'start': m._set_joyp_start(e,on); break;\n      case 'select': m._set_joyp_select(e,on); break;\n    }\n  };\n  GBCore.prototype.reset=function(){ if(this._romCopy) this.load(this._romCopy); };\n\n  // --- Boot the core (async), then the file picker is live --------------------\n  var core=null, running=false;\n  GBCore.create(decodeWasmBase64(window.BINJGB_WASM_B64), RATE).then(function(c){\n    core=c;\n  }).catch(function(err){\n    status('Couldn’t start the emulator core: '+((err&&err.message)||err));\n  });\n\n  function loop(){ if(!running) return;\n    try{\n      if(core.runFrame(img.data)) ctx.putImageData(img,0,0);\n      var a=core.pullAudio(); if(a) scheduleAudio(a.left, a.right);\n    }catch(e){ running=false; status('Emulation stopped: '+((e&&e.message)||e)); return; }\n    requestAnimationFrame(loop);\n  }\n\n  function startROM(bytes){\n    if(!core){ status('Still starting up — tap Load ROM again in a moment.'); return; }\n    try{ core.load(bytes); }catch(e){ status('That doesn’t look like a valid Game Boy ROM.'); return; }\n    running=true; resumeAudio(); document.body.classList.add('playing'); status('');\n    requestAnimationFrame(loop);\n  }\n\n  document.getElementById('file').addEventListener('change', function(e){\n    var f=e.target.files && e.target.files[0]; if(!f) return;\n    resumeAudio(); status('Loading '+f.name+'…');\n    var rd=new FileReader();\n    rd.onload=function(ev){\n      try{\n        var bytes=new Uint8Array(ev.target.result);\n        // ZIP? (local-file-header magic \"PK\\x03\\x04\") — extract the first .gb/.gbc.\n        if(bytes.length>4 && bytes[0]===0x50 && bytes[1]===0x4B && (bytes[2]===0x03||bytes[2]===0x05||bytes[2]===0x07)){\n          if(!window.fflate || !fflate.unzipSync){ status('Couldn’t unzip — load the ROM directly.'); return; }\n          var entries=fflate.unzipSync(bytes), romName=null;\n          for(var nm in entries){ if(/\\.gbc$/i.test(nm)){ romName=nm; break; } }      // prefer Color\n          if(!romName){ for(var nm2 in entries){ if(/\\.gb$/i.test(nm2)){ romName=nm2; break; } } }\n          if(!romName){ status('No .gb/.gbc ROM found inside that .zip.'); return; }\n          bytes=entries[romName];\n          status('Loaded '+romName.split('/').pop()+'…');\n        }\n        startROM(bytes);\n      }catch(err){ status('Couldn’t read that file: '+((err&&err.message)||err)); }\n    };\n    rd.onerror=function(){ status('Couldn’t read that file.'); };\n    rd.readAsArrayBuffer(f);\n  });\n\n  // --- Controls (touch + mouse + keyboard) ---\n  function bind(el){\n    var name=el.getAttribute('data-btn');\n    var downAt=0, relT=null;\n    function dn(e){ if(e.cancelable) e.preventDefault(); resumeAudio();\n      if(relT){ clearTimeout(relT); relT=null; }\n      if(core) core.setButton(name, true); el.classList.add('on'); downAt=Date.now(); }\n    // Minimum hold: a fast tap can fire down+up inside one emulated frame, so the\n    // press is never seen. ~50ms (≈3 frames) registers reliably yet stays snappy.\n    function up(e){ if(e&&e.cancelable) e.preventDefault(); el.classList.remove('on');\n      var rel=function(){ relT=null; if(core) core.setButton(name, false); };\n      var held=Date.now()-downAt, MIN=50;\n      if(held>=MIN){ rel(); } else { if(relT) clearTimeout(relT); relT=setTimeout(rel, MIN-held); } }\n    el.addEventListener('touchstart',dn,{passive:false});\n    el.addEventListener('touchend',up,{passive:false});\n    el.addEventListener('touchcancel',up,{passive:false});\n    el.addEventListener('mousedown',dn);\n    el.addEventListener('mouseup',up);\n    el.addEventListener('mouseleave',function(e){ if(el.classList.contains('on')) up(e); });\n    el.addEventListener('contextmenu',function(e){ e.preventDefault(); });\n  }\n  [].forEach.call(document.querySelectorAll('[data-btn]'), bind);\n\n  var KMAP={ArrowUp:'UP',ArrowDown:'DOWN',ArrowLeft:'LEFT',ArrowRight:'RIGHT',KeyZ:'B',KeyX:'A',KeyA:'B',KeyS:'A',Enter:'START',ShiftRight:'SELECT',ShiftLeft:'SELECT',Backspace:'SELECT'};\n  document.addEventListener('keydown',function(e){ var k=KMAP[e.code]; if(k){ e.preventDefault(); resumeAudio(); if(core) core.setButton(k, true); }});\n  document.addEventListener('keyup',function(e){ var k=KMAP[e.code]; if(k){ e.preventDefault(); if(core) core.setButton(k, false); }});\n\n  // Pause the loop when backgrounded; resume on return.\n  document.addEventListener('visibilitychange', function(){\n    if(document.visibilityState==='hidden'){ running=false; }\n    else if(core && document.body.classList.contains('playing') && !running){ running=true; requestAnimationFrame(loop); }\n  });\n})();\n</script>\n</body>\n</html>\n", "kind": "html", "iconSymbol": "gamecontroller.fill", "iconColor": "green"}