{"name": "Pocket Player", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover\">\n<title>Pocket Player</title>\n<style>\n  :root{\n    --accent: var(--myllm-accent, #4caf6e);\n    --bg:#0c0d12; --panel:#15171f; --panel2:#1d2030; --text:#eef0f6; --muted:#9aa0b4; --line:rgba(255,255,255,.10);\n  }\n  *{ box-sizing:border-box; -webkit-tap-highlight-color:transparent; -webkit-user-select:none; user-select:none; }\n  html,body{ margin:0; height:100%; overflow:hidden; }\n  body{ background:var(--bg); color:var(--text);\n    font-family:var(--myllm-font,-apple-system,system-ui,'Segoe UI',Roboto,sans-serif);\n    display:flex; flex-direction:column; padding-top:env(safe-area-inset-top); }\n  .top{ display:flex; align-items:center; gap:10px; padding:10px 14px; }\n  .top h1{ font-size:16px; margin:0; font-weight:800; letter-spacing:.2px; }\n  .top .sp{ flex:1; }\n  .load{ font:inherit; font-weight:700; font-size:14px; color:#fff; background:var(--accent);\n    border:0; border-radius:10px; padding:9px 14px; cursor:pointer; }\n  .load input{ display:none; }\n  .screen-wrap{ flex:1; display:flex; align-items:center; justify-content:center; min-height:0; background:#000;\n    margin:0 0 6px; position:relative; }\n  canvas{ image-rendering:pixelated; image-rendering:crisp-edges; width:100%; height:auto;\n    max-width:100%; max-height:100%; display:block; background:#000; }\n  .hint{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center;\n    gap:10px; text-align:center; color:var(--muted); font-size:14px; padding:24px; }\n  .hint b{ color:var(--text); font-size:16px; }\n  body.playing .hint{ display:none; }\n  .status{ min-height:18px; text-align:center; color:var(--muted); font-size:12px; padding:0 14px 4px; }\n  /* Controls */\n  .pad{ display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:10px;\n    padding:8px 16px calc(14px + env(safe-area-inset-bottom)); }\n  .dpad{ position:relative; width:140px; height:140px; }\n  .dpad .d{ position:absolute; width:48px; height:48px; background:var(--panel2); color:var(--muted);\n    border:1px solid var(--line); font-size:16px; display:flex; align-items:center; justify-content:center; }\n  .dpad .up{ top:0; left:46px; border-radius:10px 10px 0 0; }\n  .dpad .down{ bottom:0; left:46px; border-radius:0 0 10px 10px; }\n  .dpad .left{ left:0; top:46px; border-radius:10px 0 0 10px; }\n  .dpad .right{ right:0; top:46px; border-radius:0 10px 10px 0; }\n  .mid{ display:flex; flex-direction:column; gap:8px; }\n  .sm{ font:inherit; font-weight:700; font-size:11px; letter-spacing:.5px; color:var(--muted);\n    background:var(--panel2); border:1px solid var(--line); border-radius:20px; padding:8px 14px; }\n  .ab{ display:flex; align-items:center; gap:14px; justify-self:end; }\n  .ab-btn{ width:64px; height:64px; border-radius:50%; font:inherit; font-weight:800; font-size:22px; color:#fff;\n    background:var(--accent); border:0; box-shadow:0 4px 0 rgba(0,0,0,.35); }\n  .ab-btn:last-child{ transform:translateY(-14px); }\n  button{ cursor:pointer; }\n  button.on{ filter:brightness(1.4); }\n  @media (min-width:768px){\n    body{ max-width:760px; margin:0 auto; }\n    .ab-btn{ width:76px; height:76px; font-size:26px; }\n    .dpad{ width:168px; height:168px; }\n    .dpad .d{ width:58px; height:58px; }\n    .dpad .up,.dpad .down{ left:55px; } .dpad .left,.dpad .right{ top:55px; }\n  }\n</style>\n</head>\n<body>\n<div class=\"top\">\n  <h1>Pocket Player</h1>\n  <span class=\"sp\"></span>\n  <label class=\"load\">Load ROM<input id=\"file\" type=\"file\" accept=\".gb,.gbc,.zip,application/zip,application/octet-stream\"></label>\n</div>\n\n<div class=\"screen-wrap\">\n  <canvas id=\"screen\" width=\"160\" height=\"144\"></canvas>\n  <div class=\"hint\">\n    <b>Bring your own ROM</b>\n    <div>Tap <b>Load ROM</b> and pick a <b>.gb</b> or <b>.gbc</b> (or a <b>.zip</b> containing one) you own.<br>Classic handheld <i>and</i> Color games, in colour. No games are included — this is just the player.</div>\n  </div>\n</div>\n<div class=\"status\" id=\"status\"></div>\n\n<div class=\"pad\">\n  <div class=\"dpad\">\n    <button class=\"d up\"    data-btn=\"UP\" aria-label=\"Up\">▲</button>\n    <button class=\"d down\"  data-btn=\"DOWN\" aria-label=\"Down\">▼</button>\n    <button class=\"d left\"  data-btn=\"LEFT\" aria-label=\"Left\">◀</button>\n    <button class=\"d right\" data-btn=\"RIGHT\" aria-label=\"Right\">▶</button>\n  </div>\n  <div class=\"mid\">\n    <button class=\"sm\" data-btn=\"SELECT\">SELECT</button>\n    <button class=\"sm\" data-btn=\"START\">START</button>\n  </div>\n  <div class=\"ab\">\n    <button class=\"ab-btn\" data-btn=\"B\">B</button>\n    <button class=\"ab-btn\" data-btn=\"A\">A</button>\n  </div>\n</div>\n\n<!-- binjgb (MIT, Ben Smith) Emscripten loader: sets global async factory `Binjgb`. -->\n<script>var Binjgb=(()=>{var _scriptName=globalThis.document?.currentScript?.src;return async function(moduleArg={}){var moduleRtn;var Module=moduleArg;var ENVIRONMENT_IS_WEB=true;var ENVIRONMENT_IS_WORKER=false;var arguments_=[];var thisProgram=\"./this.program\";var quit_=(status,toThrow)=>{throw toThrow};var scriptDirectory=\"\";function locateFile(path){if(Module[\"locateFile\"]){return Module[\"locateFile\"](path,scriptDirectory)}return scriptDirectory+path}var readAsync,readBinary;if(ENVIRONMENT_IS_WEB||ENVIRONMENT_IS_WORKER){try{scriptDirectory=new URL(\".\",_scriptName).href}catch{}{readAsync=async url=>{var response=await fetch(url,{credentials:\"same-origin\"});if(response.ok){return response.arrayBuffer()}throw new Error(response.status+\" : \"+response.url)}}}else{}var out=console.log.bind(console);var err=console.error.bind(console);var wasmBinary;var ABORT=false;var EXITSTATUS;class EmscriptenEH{}class EmscriptenSjLj extends Emsc