{"name": "Net Worth", "kind": "html", "iconSymbol": "chart.line.uptrend.xyaxis", "iconColor": "teal", "html": "<!doctype html>\n<!--\n  Net Worth — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Net Worth</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"1cf73ca098\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#6e6e73); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); --h:172;\n  --c-free:#e0a100; --c-val:#7a5af8; --c-cash:#1fa971; --c-debt:#e5484d; --c-net:#0a84ff;--grain:0.282026462035;}\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#98989f); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24);\n  --c-free:#ffc53d; --c-val:#9e8cff; --c-cash:#3dd68c; --c-debt:#ff6369; --c-net:#4ea1ff; } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(96px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:760px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; border:none; background:none; } button:active{ transform:scale(.96); }\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 40%), hsl(calc(var(--h) + 40) 58% 26%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  .head .acts button{ width:40px; height:40px; border-radius:12px; background:var(--surface); border:1px solid var(--line); display:grid; place-items:center; color:var(--ink); }\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:20px 2px 10px; display:flex; align-items:center; gap:8px; }\n  h2 .sp{ flex:1; }\n  h2 button{ font-size:12.5px; letter-spacing:0; text-transform:none; color:var(--acc); font-weight:700; }\n\n  .hero{ border-radius:20px; padding:16px 18px; color:#fff; margin-bottom:12px;\n    background:linear-gradient(145deg, hsl(var(--h) 58% 34%), hsl(calc(var(--h) + 34) 56% 22%)); box-shadow:0 10px 28px hsl(var(--h) 60% 18% / .25); }\n  .hero .k{ font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.85; }\n  .hero .n{ font-size:38px; font-weight:800; line-height:1.08; letter-spacing:-.03em; font-variant-numeric:tabular-nums; margin-top:2px; }\n  .hero .meta{ display:flex; gap:14px; flex-wrap:wrap; margin-top:8px; font-size:13px; font-variant-numeric:tabular-nums; }\n  .hero .meta b{ font-weight:750; }\n  .hero .split{ display:flex; height:10px; border-radius:99px; overflow:hidden; background:rgba(255,255,255,.18); margin-top:12px; }\n  .hero .split i{ display:block; height:100%; }\n\n  .pots{ display:grid; grid-template-columns:1fr 1fr; gap:10px; }\n  .pot{ background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:12px 13px; text-align:left; display:block; width:100%; }\n  .pot .pk{ display:flex; align-items:center; gap:7px; font-size:12.5px; font-weight:750; color:var(--muted); }\n  .pot .pk i{ width:10px; height:10px; border-radius:3px; flex-shrink:0; }\n  .pot .pv{ font-size:20px; font-weight:800; letter-spacing:-.02em; margin-top:4px; font-variant-numeric:tabular-nums; }\n  .pot .pd{ font-size:12px; font-weight:650; margin-top:2px; font-variant-numeric:tabular-nums; color:var(--muted); }\n  .up{ color:#1f9d55 !important; } .down{ color:#d93a3f !important; }\n  @media (prefers-color-scheme:dark){ .up{ color:#4ade80 !important; } .down{ color:#ff7a7e !important; } }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  .card .ct{ font-size:15px; font-weight:750; margin-bottom:2px; }\n  .card .cs{ font-size:12.5px; color:var(--muted); margin-bottom:10px; line-height:1.45; }\n  .big{ font-size:26px; font-weight:800; letter-spacing:-.02em; font-variant-numeric:tabular-nums; }\n  .meter{ height:10px; border-radius:99px; background:var(--fill); overflow:hidden; margin:10px 0 6px; }\n  .meter i{ display:block; height:100%; border-radius:99px; background:var(--c-free); }\n  .note{ font-size:13px; color:var(--muted); line-height:1.5; }\n  .note b{ color:var(--ink); }\n\n  .rows{ display:grid; }\n  .row{ display:flex; align-items:center; gap:10px; padding:10px 2px; border-bottom:1px solid var(--line); }\n  .row:last-child{ border-bottom:none; }\n  .row .nm{ flex:1; min-width:0; font-weight:600; overflow:hidden; text-overflow:ellipsis; }\n  .row .nm small{ display:block; font-weight:500; font-size:12px; color:var(--muted); white-space:normal; }\n  .row .amt{ font-variant-numeric:tabular-nums; font-weight:700; white-space:nowrap; }\n  .row .sw{ width:10px; height:10px; border-radius:3px; flex-shrink:0; }\n  .row button.lnk{ color:var(--acc); font-weight:700; font-size:13.5px; padding:6px 4px; }\n  .row input.num{ width:132px; text-align:right; }\n\n  .tabs{ position:fixed; left:0; right:0; bottom:0; z-index:15; display:flex; justify-content:center;\n    padding:8px calc(10px + env(safe-area-inset-right)) calc(8px + env(safe-area-inset-bottom)) calc(10px + env(safe-area-inset-left));\n    background:color-mix(in srgb, var(--bg) 88%, transparent); -webkit-backdrop-filter:blur(18px); backdrop-filter:blur(18px); border-top:1px solid var(--line); }\n  .tabs .in{ display:flex; gap:4px; width:100%; max-width:600px; }\n  .tabs button{ flex:1; display:flex; flex-direction:column; align-items:center; gap:3px; padding:6px 0 4px; border-radius:12px; font-size:11.5px; font-weight:700; color:var(--muted); }\n  .tabs button svg{ width:22px; height:22px; }\n  .tabs button.on{ color:var(--acc); background:var(--fill); }\n\n  label.f{ display:block; font-size:12.5px; font-weight:700; color:var(--muted); margin:10px 2px 6px; }\n  input,select{ width:100%; font:inherit; font-size:16px; padding:11px 12px; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; }\n  input:focus,select:focus{ border-color:var(--acc); }\n  .potH{ display:flex; align-items:center; gap:8px; margin:18px 2px 8px; }\n  .potH i{ width:12px; height:12px; border-radius:4px; }\n  .potH b{ font-size:15px; font-weight:800; flex:1; }\n  .potH span{ font-size:13px; font-weight:700; font-variant-numeric:tabular-nums; color:var(--muted); }\n  .hint{ font-size:12.5px; color:var(--muted); margin:-2px 2px 8px; line-height:1.45; }\n  .btn{ display:flex; align-items:center; justify-content:center; gap:8px; width:100%; min-height:48px; border-radius:14px; font-weight:750; background:var(--fill); margin-top:10px; }\n  .btn.pri{ background:var(--acc); color:#fff; }\n  .btn.dan{ color:#d93a3f; }\n  .chips{ display:flex; flex-wrap:wrap; gap:8px; }\n  .chips button{ padding:8px 12px; border-radius:99px; background:var(--fill); font-weight:650; font-size:14px; }\n  .chips button.on{ background:var(--acc); color:#fff; }\n  .seg{ display:flex; background:var(--fill); border-radius:11px; padding:3px; gap:3px; margin-bottom:10px; overflow-x:auto; scrollbar-width:none; }\n  .seg::-webkit-scrollbar{ display:none; }\n  .seg button{ flex:1 0 auto; padding:7px 10px; border-radius:9px; font-size:13px; font-weight:700; color:var(--muted); white-space:nowrap; }\n  .seg button.on{ background:var(--surface); color:var(--ink); box-shadow:0 1px 3px rgba(0,0,0,.12); }\n\n  svg.chart{ display:block; width:100%; height:auto; overflow:visible; }\n  svg.chart text{ fill:var(--muted); font-size:10.5px; font-family:inherit; font-variant-numeric:tabular-nums; }\n  svg.chart .grid{ stroke:var(--line); stroke-width:1; }\n  .legend{ display:flex; flex-wrap:wrap; gap:12px; font-size:12.5px; font-weight:650; color:var(--muted); margin-top:8px; }\n  .legend span{ display:inline-flex; align-items:center; gap:6px; }\n  .legend i{ width:12px; height:4px; border-radius:2px; }\n  .bars{ display:grid; gap:10px; }\n  .bar{ display:grid; grid-template-columns:110px 1fr auto; gap:10px; align-items:center; font-size:13.5px; }\n  .bar .tr{ height:14px; border-radius:7px; background:var(--fill); overflow:hidden; }\n  .bar .tr i{ display:block; height:100%; border-radius:7px; }\n  .bar b{ font-variant-numeric:tabular-nums; }\n  .empty{ text-align:center; padding:26px 18px 20px; }\n  .empty .tile{ width:54px; height:54px; border-radius:16px; font-size:24px; margin:0 auto 12px; }\n  .empty b{ display:block; font-size:17px; font-weight:800; }\n  .empty p{ font-size:14px; color:var(--muted); line-height:1.5; max-width:330px; margin:6px auto 0; }\n  .guide h3{ font-size:15px; font-weight:800; margin:14px 0 4px; display:flex; align-items:center; gap:8px; }\n  .guide h3 i{ width:10px; height:10px; border-radius:3px; }\n  .guide p, .guide li{ font-size:14px; line-height:1.5; color:var(--ink); }\n  .guide ul{ padding-left:20px; margin:4px 0 6px; }\n  .guide .src{ font-size:12.5px; color:var(--muted); margin-top:14px; }\n  .guide a{ color:var(--acc); }\n\n  .sheet{ position:fixed; inset:0; background:rgba(0,0,0,.38); display:flex; align-items:flex-end; justify-content:center; z-index:30; }\n  .sheet .panel{ width:100%; max-width:600px; max-height:88dvh; overflow-y:auto; background:var(--surface); border-radius:20px 20px 0 0; padding:18px 16px calc(18px + env(safe-area-inset-bottom)); }\n  .sheet h3{ font-size:17px; font-weight:800; margin-bottom:4px; }\n  .sheet p{ font-size:13.5px; color:var(--muted); line-height:1.45; margin-bottom:6px; }\n  .sheet .acts{ display:flex; gap:8px; margin-top:14px; }\n  .sheet .acts button{ flex:1; min-height:46px; border-radius:12px; font-weight:750; background:var(--fill); }\n  .sheet .acts button.pri{ background:var(--acc); color:#fff; }\n  .sheet .acts button.dan{ background:#e5484d; color:#fff; }\n  .toast{ position:fixed; left:50%; bottom:calc(84px + env(safe-area-inset-bottom)); transform:translateX(-50%); z-index:40; background:rgba(28,28,30,.95); color:#fff;\n    padding:10px 16px; border-radius:99px; font-size:14px; font-weight:650; opacity:0; pointer-events:none; transition:opacity .2s; }\n  .toast.on{ opacity:1; }\n  [hidden]{ display:none !important; }\n  @media (prefers-reduced-motion:reduce){ button:active{ transform:none; } .toast{ transition:none; } }\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n/* lists-kit:css */\n/* lists-kit v1 — list bar + sheet (uses the app's --bg/--surface/--ink/--muted/--line/--acc/--fill) */\n.lk-bar{ display:flex; align-items:center; gap:8px; margin:0 0 12px; }\n.lk-chips{ flex:1; min-width:0; display:flex; gap:6px; overflow-x:auto; scrollbar-width:none; -webkit-overflow-scrolling:touch; padding:2px 1px; }\n.lk-chips::-webkit-scrollbar{ display:none; }\n.lk-chip{ flex-shrink:0; display:inline-flex; align-items:center; gap:6px; height:34px; padding:0 13px; border-radius:99px; font-size:13.5px; font-weight:700;\n  background:var(--surface); border:1px solid var(--line); color:var(--ink); max-width:62vw; }\n.lk-chip span{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n.lk-chip.on{ background:var(--acc); border-color:var(--acc); color:#fff; }\n.lk-chip.lk-new{ color:var(--acc); border-style:dashed; }\n.lk-i{ width:15px; height:15px; flex-shrink:0; }\n.lk-dot{ width:7px; height:7px; border-radius:50%; background:#ff9f0a; flex-shrink:0; }\n.lk-share{ flex-shrink:0; display:inline-flex; align-items:center; gap:6px; height:34px; padding:0 12px; border-radius:99px; font-size:13px; font-weight:700;\n  color:var(--acc); background:var(--fill); }\n.lk-line{ font-size:12.5px; color:var(--muted); margin:-6px 4px 10px; min-height:0; }\n.lk-line:empty{ display:none; }\n.lk-line.bad{ color:#e8890c; }\n.lk-wrap{ position:fixed; inset:0; z-index:50; background:rgba(0,0,0,0); display:flex; align-items:flex-end; justify-content:center; transition:background .2s; }\n.lk-wrap.show{ background:rgba(0,0,0,.38); }\n.lk-sheet{ width:100%; max-width:520px; background:var(--surface); color:var(--ink); border-radius:22px 22px 0 0; display:flex; flex-direction:column; gap:10px;\n  padding:18px 16px calc(18px + env(safe-area-inset-bottom)); transform:translateY(100%); transition:transform .25s cubic-bezier(.2,.8,.2,1); max-height:88dvh; overflow:auto; }\n.lk-wrap.show .lk-sheet{ transform:none; }\n.lk-sheet h3{ font-size:19px; font-weight:800; overflow-wrap:anywhere; }\n.lk-sub{ font-size:13.5px; color:var(--muted); margin-top:-6px; }\n.lk-sheet input{ width:100%; font:inherit; font-size:16px; color:var(--ink); background:var(--bg); border:1px solid var(--line); border-radius:12px; padding:11px 12px; outline:none; -webkit-appearance:none; }\n.lk-sheet input:focus{ border-color:var(--acc); }\n.lk-sheet input:disabled{ opacity:.6; }\n.lk-field{ display:flex; gap:8px; } .lk-field input{ flex:1; min-width:0; }\n.lk-row{ display:flex; gap:8px; } .lk-row .lk-btn{ flex:1; }\n.lk-btn{ min-height:44px; padding:0 14px; border-radius:13px; font-size:15px; font-weight:700; background:var(--fill); color:var(--ink);\n  display:inline-flex; align-items:center; justify-content:center; gap:8px; flex-shrink:0; }\n.lk-btn.wide{ width:100%; }\n.lk-btn.pri{ background:var(--acc); color:#fff; }\n.lk-btn.danger{ color:#ff453a; }\n.lk-btn:disabled{ opacity:.45; }\n.lk-note{ font-size:12.5px; color:var(--muted); line-height:1.4; }\n.lk-err{ color:#ff453a; }\n.lk-toast{ position:fixed; left:50%; bottom:calc(24px + env(safe-area-inset-bottom)); transform:translate(-50%, 20px); opacity:0; pointer-events:none; z-index:60;\n  background:rgba(30,30,32,.94); color:#fff; font-size:14px; font-weight:600; padding:10px 16px; border-radius:99px; max-width:86vw; text-align:center; transition:all .25s; }\n.lk-toast.show{ opacity:1; transform:translate(-50%, 0); }\n@media (prefers-reduced-motion:reduce){ .lk-wrap,.lk-sheet,.lk-toast{ transition:none; } }\n/* /lists-kit:css */\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-trend\" viewBox=\"0 0 24 24\"><path d=\"M3 17l6-6 4 4 7-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M15 8h5v5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-home\" viewBox=\"0 0 24 24\"><path d=\"M4 11l8-7 8 7v8a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-plus\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\" fill=\"currentColor\" opacity=\".18\"/><path d=\"M12 7v10M7 12h10\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-chart\" viewBox=\"0 0 24 24\"><path d=\"M5 20V10M10 20V4M15 20v-7M20 20V8\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-list\" viewBox=\"0 0 24 24\"><path d=\"M9 6h11M9 12h11M9 18h11\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"/><circle cx=\"4.5\" cy=\"6\" r=\"1.6\" fill=\"currentColor\"/><circle cx=\"4.5\" cy=\"12\" r=\"1.6\" fill=\"currentColor\"/><circle cx=\"4.5\" cy=\"18\" r=\"1.6\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-help\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M9.6 9.3a2.5 2.5 0 1 1 3.4 2.3c-.7.3-1 .8-1 1.5v.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/><circle cx=\"12\" cy=\"17\" r=\"1.2\" fill=\"currentColor\"/></symbol>\n</defs></svg>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-trend\"/></svg></div>\n  <div class=\"ht\"><h1>Net Worth</h1><p>Where you stand, and how close to freedom</p></div>\n  <div class=\"acts\"><button type=\"button\" id=\"helpBtn\" aria-label=\"How it works\"><svg class=\"i\"><use href=\"#i-help\"/></svg></button></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Net Worth\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n<!-- lists-kit:bar --><div class=\"lk-bar\" id=\"lkBar\"></div><p class=\"lk-line\" id=\"lkLine\"></p><!-- /lists-kit:bar -->\n<!-- ============ Overview ============ -->\n<section id=\"v-home\">\n  <div class=\"card empty\" id=\"homeEmpty\" hidden>\n    <div class=\"tile\"><svg class=\"i\"><use href=\"#i-trend\"/></svg></div>\n    <b>Your first snapshot</b>\n    <p>Once a month, write down what each of your accounts is worth and what you owe. Net Worth adds it up, splits it into four pots and shows you the direction of travel.</p>\n    <button class=\"btn pri\" type=\"button\" data-go=\"update\">Take your first snapshot</button>\n    <button class=\"btn\" type=\"button\" id=\"emptyHelp\">How it works</button>\n  </div>\n  <div id=\"homeMain\" hidden>\n    <div class=\"hero\">\n      <div class=\"k\" id=\"hK\">Net worth</div>\n      <div class=\"n\" id=\"hN\">£0</div>\n      <div class=\"meta\" id=\"hMeta\"></div>\n      <div class=\"split\" id=\"hSplit\"></div>\n    </div>\n    <div class=\"pots\" id=\"pots\"></div>\n    <h2>What your Freedom Fund could pay for</h2>\n    <div class=\"card\" id=\"fourCard\"></div>\n    <h2><span>Net worth over time</span><span class=\"sp\"></span><button type=\"button\" data-go=\"charts\">All charts</button></h2>\n    <div class=\"card\"><div id=\"homeChart\"></div></div>\n  </div>\n</section>\n\n<!-- ============ Update (a snapshot) ============ -->\n<section id=\"v-update\" hidden>\n  <h2 id=\"upTitle\">New snapshot</h2>\n  <div class=\"card\">\n    <label class=\"f\" for=\"upDate\" style=\"margin-top:0\">Date of this snapshot</label>\n    <input type=\"date\" id=\"upDate\">\n    <div class=\"hint\" id=\"upDateHint\" style=\"margin:8px 2px 0\"></div>\n  </div>\n  <div id=\"upPots\"></div>\n  <div class=\"card\" style=\"margin-top:14px\">\n    <div class=\"ct\">Net worth on this date</div>\n    <div class=\"big\" id=\"upTotal\">£0</div>\n    <div class=\"note\" id=\"upDelta\"></div>\n  </div>\n  <button class=\"btn pri\" type=\"button\" id=\"upSave\">Save snapshot</button>\n  <button class=\"btn dan\" type=\"button\" id=\"upDelete\" hidden>Delete this snapshot</button>\n  <button class=\"btn\" type=\"button\" id=\"upCancel\" hidden>Cancel</button>\n</section>\n\n<!-- ============ Charts ============ -->\n<section id=\"v-charts\" hidden>\n  <div class=\"seg\" id=\"chartSeg\">\n    <button type=\"button\" data-c=\"net\" class=\"on\">Over time</button>\n    <button type=\"button\" data-c=\"split\">Split</button>\n    <button type=\"button\" data-c=\"four\">4% figure</button>\n    <button type=\"button\" data-c=\"debt\">Debts</button>\n    <button type=\"button\" data-c=\"units\">Units</button>\n  </div>\n  <div class=\"card\"><div class=\"ct\" id=\"chT\"></div><div class=\"cs\" id=\"chS\"></div><div id=\"chBody\"></div></div>\n  <h2>Snapshots</h2>\n  <div class=\"card\"><div class=\"rows\" id=\"history\"></div></div>\n</section>\n\n<!-- ============ Accounts ============ -->\n<section id=\"v-accounts\" hidden>\n  <div class=\"hint\" style=\"margin:0 2px 4px\">The things you own and owe, in four pots. Rename them to match your real accounts. Removing an account keeps its past values in your history.</div>\n  <div id=\"accPots\"></div>\n  <h2>Settings</h2>\n  <div class=\"card\">\n    <label class=\"f\" style=\"margin-top:0\">Currency</label>\n    <div class=\"chips\" id=\"curChips\"></div>\n    <label class=\"f\" for=\"spendIn\">Your yearly spending (optional)</label>\n    <input id=\"spendIn\" inputmode=\"decimal\" placeholder=\"e.g. 30000\" autocomplete=\"off\">\n    <div class=\"hint\" style=\"margin-top:8px\">Used to show how much of a year your Freedom Fund's 4% could cover.</div>\n  </div>\n  <h2>Your data</h2>\n  <div class=\"card\">\n    <div class=\"note\">Everything stays in this app on your device. Export a copy to keep a backup or open it in a spreadsheet.</div>\n    <button class=\"btn\" type=\"button\" id=\"exportBtn\">Export as CSV</button>\n    <button class=\"btn dan\" type=\"button\" id=\"resetBtn\">Start again</button>\n  </div>\n</section>\n\n<nav class=\"tabs\" aria-label=\"Sections\"><div class=\"in\">\n  <button type=\"button\" data-tab=\"home\" class=\"on\"><svg class=\"i\"><use href=\"#i-home\"/></svg>Overview</button>\n  <button type=\"button\" data-tab=\"update\"><svg class=\"i\"><use href=\"#i-plus\"/></svg>Update</button>\n  <button type=\"button\" data-tab=\"charts\"><svg class=\"i\"><use href=\"#i-chart\"/></svg>Charts</button>\n  <button type=\"button\" data-tab=\"accounts\"><svg class=\"i\"><use href=\"#i-list\"/></svg>Accounts</button>\n</div></nav>\n\n<div class=\"sheet\" id=\"sheet\" hidden><div class=\"panel\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"shT\">\n  <h3 id=\"shT\"></h3><div id=\"shB\"></div>\n  <div class=\"acts\" id=\"shA\"></div>\n</div></div>\n<div class=\"toast\" id=\"toast\"></div>\n\n<script id=\"lists-kit\">\n/* lists-kit v1 — several lists in one app; any of them can move to iCloud and\n   be shared with other iCloud users, who edit the same list from their own\n   MyLLM (myllmLists, MyLLM 6.1+). Without iCloud everything stays on this\n   device, as before.\n   The app keeps its own item code and calls:\n     ListsKit.start({kind, storeKey, defaultName, noun, fix, legacy, render, main, changed, ready})\n     main(items): the first list changed · changed(list): any list changed\n     ListsKit.items()  → the open list's items (the app may mutate it)\n     ListsKit.set(arr[, list]) → after any change (saves, mirrors, syncs)\n     ListsKit.byName(name) / ListsKit.current() / ListsKit.all() */\n(function(){\n  var K = window.ListsKit = {};\n  var o = null, st = { current: null, lists: [] };\n  var cloud = null, why = \"\";           // null = not asked yet\n  var pushing = {}, timers = {}, polling = null;\n\n  function el(id){ return document.getElementById(id); }\n  function esc(s){ return String(s).replace(/[&<>\"]/g, function(c){ return {\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\"}[c]; }); }\n  function haptic(k){ try { if (window.myllmHaptic) myllmHaptic(k || \"light\"); } catch(e){} }\n  function uid(){ return \"l_\" + Date.now().toString(36) + Math.random().toString(36).slice(2, 6); }\n  function find(id){ for (var i = 0; i < st.lists.length; i++) if (st.lists[i].id === id) return st.lists[i]; return null; }\n  function cur(){ return find(st.current) || st.lists[0]; }\n  function fixAll(a){ return (Array.isArray(a) ? a : []).filter(function(x){ return x && typeof x === \"object\"; }).map(o.fix); }\n  function same(a, b){ return JSON.stringify(a) === JSON.stringify(b); }\n\n  /* ---- this device ---- */\n  /* myllmStorage only: MyLLM always has it, and outside MyLLM the lists just\n     last while the page is open. */\n  function persist(){\n    var S = window.myllmStorage;\n    try { if (S) S.setItem(o.storeKey, JSON.stringify(st)).catch(function(){}); } catch(e){}\n  }\n  function restore(){\n    var S = window.myllmStorage;\n    if (!S) return Promise.resolve(null);\n    return Promise.resolve().then(function(){ return S.getItem(o.storeKey); }).catch(function(){ return null; })\n      .then(function(v){ try { return v ? JSON.parse(v) : null; } catch(e){ return null; } });\n  }\n  function afterChange(list){\n    persist();\n    if (list === st.lists[0] && o.main) try { o.main(list.items); } catch(e){}\n    if (o.changed) try { o.changed(list); } catch(e){}\n  }\n\n  /* ---- merge: what changed here since `base` wins, the rest follows `remote`\n     (the same rules MyLLM uses in iCloud) ---- */\n  function merge(base, local, remote){\n    function idx(a){ var m = {}; a.forEach(function(x){ m[x.id] = x; }); return m; }\n    var b = idx(base), r = idx(remote), out = [], placed = {};\n    local.forEach(function(x){\n      if (placed[x.id]) return;\n      var mine = !same(x, b[x.id]);\n      if (r[x.id]) out.push(mine ? x : r[x.id]);\n      else if (!b[x.id] || mine) out.push(x);\n      else return;\n      placed[x.id] = 1;\n    });\n    var prev = null;\n    remote.forEach(function(x){\n      var p = prev; prev = x.id;\n      if (placed[x.id] || b[x.id]) return;\n      var at = 0;\n      if (p != null) for (var i = 0; i < out.length; i++) if (out[i].id === p) { at = i + 1; break; }\n      out.splice(at, 0, x); placed[x.id] = 1;\n    });\n    return out;\n  }\n  K._merge = merge;\n\n  /* ---- iCloud ---- */\n  function check(){\n    if (!window.myllmLists) { cloud = false; why = \"Sharing needs MyLLM 6.1 or later on iPhone, iPad or Mac.\"; return Promise.resolve(); }\n    return myllmLists.available().then(function(a){ cloud = !!(a && a.available); why = (a && a.reason) || \"\"; })\n      .catch(function(e){ cloud = false; why = e.message || \"iCloud couldn't be reached.\"; });\n  }\n  function meta(l, r){\n    l.name = r.name || l.name;\n    l.cloud = { shared: !!r.shared, owner: !!r.owner, ownerName: r.ownerName || \"\", people: r.people || [] };\n  }\n  function pull(){\n    if (!cloud) return Promise.resolve();\n    return myllmLists.all(o.kind).then(function(remote){\n      var seen = {}, gone = [];\n      remote.forEach(function(r){\n        seen[r.id] = 1;\n        var l = find(r.id);\n        if (!l) { l = { id: r.id, items: fixAll(r.items) }; meta(l, r); st.lists.push(l); return; }\n        l.err = null;\n        if (l.dirty || pushing[l.id]) { meta(l, r); return; }    // our change is on its way\n        l.items = fixAll(r.items); meta(l, r);\n      });\n      st.lists = st.lists.filter(function(l){ if (l.cloud && !seen[l.id]) { gone.push(l.name); return false; } return true; });\n      if (!st.lists.length) st.lists.push({ id: uid(), name: o.defaultName, items: [] });\n      if (!find(st.current)) st.current = st.lists[0].id;\n      if (gone.length) toast(\"“\" + gone[0] + \"” was deleted or is no longer shared with you\");\n      afterChange(st.lists[0]); paint(); o.render();\n    }).catch(function(e){\n      st.lists.forEach(function(l){ if (l.cloud) l.err = e.message; }); paint();\n    });\n  }\n  function schedule(l){\n    clearTimeout(timers[l.id]);\n    timers[l.id] = setTimeout(function(){ push(l.id); }, 450);\n  }\n  function push(id){\n    var l = find(id);\n    if (!l || !l.cloud || !l.dirty || !cloud) return Promise.resolve();\n    if (pushing[id]) return pushing[id];\n    var sent = JSON.parse(JSON.stringify(l.items));\n    l.dirty = false;\n    pushing[id] = myllmLists.save(id, sent).then(function(r){\n      var now = find(id); if (!now) return;\n      var merged = fixAll(r.items);\n      if (same(now.items, sent)) now.items = merged;\n      else { now.items = merge(sent, now.items, merged); now.dirty = true; }   // edited while saving\n      meta(now, r); now.err = null;\n    }).catch(function(e){\n      var now = find(id); if (now) { now.dirty = true; now.err = e.message || \"Not synced\"; }\n    }).then(function(){\n      delete pushing[id];\n      var now = find(id);\n      if (now) { afterChange(now); if (now === cur()) o.render(); paint(); if (now.dirty && !now.err) schedule(now); }\n    });\n    return pushing[id];\n  }\n  function accepted(){\n    if (!cloud || !myllmLists.takeAccepted) return Promise.resolve();\n    return myllmLists.takeAccepted(o.kind).then(function(id){\n      if (!id) return;\n      return pull().then(function(){\n        var l = find(id); if (!l) return;\n        st.current = id; persist(); paint(); o.render();\n        toast(\"You've joined “\" + l.name + \"”\");\n      });\n    }).catch(function(){});\n  }\n  function tick(){\n    if (document.hidden) return;\n    var errs = st.lists.filter(function(l){ return l.cloud && l.dirty && l.err; });\n    errs.forEach(function(l){ l.err = null; push(l.id); });\n    pull();\n  }\n\n  /* ---- the list bar ---- */\n  function people(l){\n    if (!l.cloud) return \"\";\n    if (!l.cloud.owner) return \"Shared by \" + (l.cloud.ownerName || \"someone\");\n    if (l.cloud.people.length) return \"Shared with \" + l.cloud.people.join(\", \");\n    return \"In your iCloud\";\n  }\n  function paint(){\n    var bar = el(\"lkBar\"); if (!bar) return;\n    var c = cur(), h = '<div class=\"lk-chips\" role=\"tablist\">';\n    st.lists.forEach(function(l){\n      h += '<button class=\"lk-chip' + (l === c ? \" on\" : \"\") + '\" role=\"tab\" aria-selected=\"' + (l === c) + '\" data-lk=\"' + esc(l.id) + '\">' +\n        (l.cloud && (l.cloud.shared || !l.cloud.owner) ? '<svg class=\"lk-i\" viewBox=\"0 0 24 24\" aria-label=\"Shared\"><use href=\"#lk-people\"/></svg>' : \"\") +\n        '<span>' + esc(l.name) + '</span>' + (l.cloud && l.err ? '<i class=\"lk-dot\" title=\"Not synced\"></i>' : \"\") + '</button>';\n    });\n    h += '<button class=\"lk-chip lk-new\" data-lk-new aria-label=\"New ' + o.noun + '\"><svg class=\"lk-i\" viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></svg><span>New</span></button></div>';\n    h += '<button class=\"lk-share\" data-lk-menu aria-label=\"Share or edit this ' + o.noun + '\"><svg class=\"lk-i\" viewBox=\"0 0 24 24\"><use href=\"#lk-people\"/></svg><span>' + (c.cloud && (c.cloud.shared || !c.cloud.owner) ? \"Shared\" : \"Share\") + '</span></button>';\n    bar.innerHTML = h;\n    var line = el(\"lkLine\");\n    if (line) {\n      var t = people(c);\n      if (c.cloud && c.err) t = (t ? t + \" · \" : \"\") + \"Not synced: \" + c.err;\n      line.textContent = t; line.classList.toggle(\"bad\", !!(c.cloud && c.err));\n    }\n    var on = bar.querySelector(\".lk-chip.on\");\n    if (on && on.scrollIntoView) try { on.scrollIntoView({ block: \"nearest\", inline: \"nearest\" }); } catch(e){}\n  }\n\n  /* ---- sheet ---- */\n  function sheet(html, wire){\n    close();\n    var w = document.createElement(\"div\");\n    w.className = \"lk-wrap\"; w.id = \"lkWrap\";\n    w.innerHTML = '<div class=\"lk-sheet\" role=\"dialog\" aria-modal=\"true\">' + html + '</div>';\n    w.addEventListener(\"click\", function(e){ if (e.target === w) close(); });\n    document.body.appendChild(w);\n    requestAnimationFrame(function(){ w.classList.add(\"show\"); });\n    wire(w);\n  }\n  function close(){ var w = el(\"lkWrap\"); if (w) w.remove(); }\n  function busy(btn, on, label){ if (!btn) return; btn.disabled = on; if (label) btn.textContent = label; }\n\n  function newSheet(){\n    sheet('<h3>New ' + o.noun + '</h3><input id=\"lkName\" maxlength=\"60\" placeholder=\"Name, e.g. ' + esc(o.example) + '\" enterkeyhint=\"done\" autocomplete=\"off\">' +\n      '<div class=\"lk-row\"><button class=\"lk-btn\" data-x>Cancel</button><button class=\"lk-btn pri\" id=\"lkMake\">Create</button></div>' +\n      '<p class=\"lk-note\">' + (cloud ? \"Kept on this device until you share it.\" : \"Kept on this device.\") + '</p>', function(w){\n      var inp = w.querySelector(\"#lkName\"), go = w.querySelector(\"#lkMake\");\n      w.querySelector(\"[data-x]\").onclick = close;\n      function make(){\n        var name = inp.value.trim(); if (!name) { inp.focus(); return; }\n        var l = { id: uid(), name: name.slice(0, 60), items: [] };\n        st.lists.push(l); st.current = l.id; persist(); close(); haptic(\"success\"); paint(); o.render();\n      }\n      go.onclick = make;\n      inp.addEventListener(\"keydown\", function(e){ if (e.key === \"Enter\") make(); });\n      setTimeout(function(){ inp.focus(); }, 60);\n    });\n  }\n\n  function menuSheet(){\n    var l = cur(), isCloud = !!l.cloud, owner = !isCloud || l.cloud.owner, only = st.lists.length < 2;\n    var status = isCloud ? people(l) : \"On this device only\";\n    var shareLabel = !isCloud ? \"Share with people…\" : owner ? \"Manage sharing…\" : \"See who's sharing…\";\n    var del = !owner ? \"Leave this \" + o.noun : isCloud && l.cloud.shared ? \"Delete for everyone\" : \"Delete \" + o.noun;\n    sheet('<h3>' + esc(l.name) + '</h3><p class=\"lk-sub\">' + esc(status) + '</p>' +\n      '<button class=\"lk-btn pri wide\" id=\"lkShare\"><svg class=\"lk-i\" viewBox=\"0 0 24 24\"><use href=\"#lk-people\"/></svg>' + shareLabel + '</button>' +\n      (cloud === false ? '<p class=\"lk-note\">' + esc(why) + '</p>' : !isCloud ? '<p class=\"lk-note\">Sharing moves this ' + o.noun + ' to your iCloud. People you invite need MyLLM 6.1 or later and edit it from their own app.</p>' : \"\") +\n      '<div class=\"lk-field\"><input id=\"lkRename\" maxlength=\"60\" value=\"' + esc(l.name) + '\" aria-label=\"Name\" enterkeyhint=\"done\" autocomplete=\"off\"' + (owner ? \"\" : \" disabled\") + '>' +\n      (owner ? '<button class=\"lk-btn\" id=\"lkSave\">Rename</button>' : \"\") + '</div>' +\n      '<button class=\"lk-btn danger wide\" id=\"lkDel\"' + (only && owner ? \" disabled\" : \"\") + '>' + del + '</button>' +\n      (only && owner ? '<p class=\"lk-note\">This is your only ' + o.noun + '. Make another first to delete it.</p>' : \"\") +\n      '<button class=\"lk-btn wide\" data-x>Done</button>', function(w){\n      w.querySelector(\"[data-x]\").onclick = close;\n      var share = w.querySelector(\"#lkShare\"), msg = function(t){ var n = w.querySelector(\".lk-err\") || w.querySelector(\".lk-sheet\").appendChild(Object.assign(document.createElement(\"p\"), { className: \"lk-note lk-err\" })); n.textContent = t; };\n      share.disabled = cloud === false;\n      share.onclick = function(){ busy(share, true); shareList(l).then(close, function(e){ busy(share, false); msg(e.message || String(e)); }); };\n      var ren = w.querySelector(\"#lkSave\");\n      if (ren) ren.onclick = function(){\n        var name = w.querySelector(\"#lkRename\").value.trim().slice(0, 60); if (!name || name === l.name) return;\n        busy(ren, true);\n        (l.cloud ? myllmLists.rename(l.id, name).then(function(r){ meta(l, r); }) : Promise.resolve(l.name = name))\n          .then(function(){ persist(); paint(); close(); haptic(\"success\"); }, function(e){ busy(ren, false); msg(e.message); });\n      };\n      var d = w.querySelector(\"#lkDel\"), armed = false;\n      d.onclick = function(){\n        if (!armed) { armed = true; d.textContent = \"Tap again to \" + del.charAt(0).toLowerCase() + del.slice(1); haptic(\"warning\"); return; }\n        busy(d, true);\n        (l.cloud ? myllmLists.remove(l.id) : Promise.resolve()).then(function(){\n          st.lists = st.lists.filter(function(x){ return x !== l; });\n          if (!st.lists.length) st.lists.push({ id: uid(), name: o.defaultName, items: [] });\n          st.current = st.lists[0].id; afterChange(st.lists[0]); close(); paint(); o.render(); haptic(\"light\");\n        }, function(e){ busy(d, false); msg(e.message); });\n      };\n    });\n  }\n\n  /* Moving a list to iCloud the first time it's shared: create it there, put\n     the items in, swap it into place, then open Apple's sharing sheet. */\n  function shareList(l){\n    var go = cloud === null ? check() : Promise.resolve();\n    return go.then(function(){\n      if (!cloud) throw new Error(why || \"iCloud isn't available.\");\n      if (l.cloud) return myllmLists.share(l.id);\n      return myllmLists.create(o.kind, l.name).then(function(c){\n        return myllmLists.save(c.id, l.items).then(function(r){\n          var at = st.lists.indexOf(l), moved = { id: r.id, items: fixAll(r.items) };\n          meta(moved, r);\n          if (at >= 0) st.lists[at] = moved; else st.lists.push(moved);\n          if (st.current === l.id) st.current = moved.id;\n          afterChange(moved); paint(); o.render();\n          return myllmLists.share(moved.id);\n        });\n      });\n    });\n  }\n\n  var toastT = null;\n  function toast(t){\n    var n = el(\"lkToast\");\n    if (!n) { n = document.createElement(\"div\"); n.id = \"lkToast\"; n.className = \"lk-toast\"; document.body.appendChild(n); }\n    n.textContent = t; n.classList.add(\"show\");\n    clearTimeout(toastT); toastT = setTimeout(function(){ n.classList.remove(\"show\"); }, 2600);\n  }\n\n  /* ---- public ---- */\n  K.items = function(){ return cur().items; };\n  K.current = function(){ return cur(); };\n  K.all = function(){ return st.lists; };\n  K.byName = function(name){\n    var n = String(name || \"\").trim().toLowerCase(); if (!n) return null;\n    for (var i = 0; i < st.lists.length; i++) if (st.lists[i].name.toLowerCase() === n) return st.lists[i];\n    return null;\n  };\n  K.set = function(arr, list){\n    var l = list || cur(); l.items = arr;\n    afterChange(l); paint();\n    if (l.cloud) { l.dirty = true; schedule(l); }\n  };\n  K.start = function(opts){\n    o = opts; o.noun = o.noun || \"list\"; o.example = o.example || \"Weekend\";\n    var defs = document.createElement(\"div\");\n    defs.innerHTML = '<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><symbol id=\"lk-people\" viewBox=\"0 0 24 24\">' +\n      '<circle cx=\"9\" cy=\"8\" r=\"3.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"/><path d=\"M2.8 19.5c.6-3.3 3.1-5.2 6.2-5.2s5.6 1.9 6.2 5.2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"/>' +\n      '<path d=\"M15.6 4.9a3.2 3.2 0 0 1 0 6.2M18 14.6c1.7.7 2.9 2.4 3.2 4.9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"/></symbol></svg>';\n    document.body.appendChild(defs.firstChild);\n    document.addEventListener(\"click\", function(e){\n      var t = e.target.closest ? e.target : null; if (!t) return;\n      var chip = t.closest(\"[data-lk]\"), add = t.closest(\"[data-lk-new]\"), menu = t.closest(\"[data-lk-menu]\");\n      if (chip) { var id = chip.getAttribute(\"data-lk\"); if (id !== st.current) { st.current = id; persist(); haptic(\"selection\"); paint(); o.render(); } else menuSheet(); }\n      else if (add) newSheet();\n      else if (menu) menuSheet();\n    });\n    return restore().then(function(saved){\n      if (saved && Array.isArray(saved.lists) && saved.lists.length) {\n        st = saved;\n        st.lists.forEach(function(l){ l.items = fixAll(l.items); l.err = null; });\n        return null;\n      }\n      return Promise.resolve(o.legacy ? o.legacy() : []).catch(function(){ return []; }).then(function(items){\n        st = { current: null, lists: [{ id: uid(), name: o.defaultName, items: fixAll(items) }] };\n        st.current = st.lists[0].id; persist();\n      });\n    }).then(function(){\n      if (!find(st.current)) st.current = st.lists[0].id;\n      paint(); o.render();\n      if (o.ready) try { o.ready(); } catch(e){}     // lists are usable now; iCloud follows\n      return check();\n    }).then(function(){\n      paint();\n      if (!cloud) return;\n      return pull().then(function(){\n        st.lists.forEach(function(l){ if (l.cloud && l.dirty) push(l.id); });\n        return accepted();\n      }).then(function(){\n        polling = setInterval(tick, 12000);\n        document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) { tick(); accepted(); } });\n      });\n    });\n  };\n})();\n</script>\n<script>\n/* Net Worth — a monthly snapshot of what you own minus what you owe, split\n   into four pots so you can see whether you're moving towards financial\n   freedom. The four-pot method (Freedom Fund, Valuable Liabilities, Cash &\n   planned spending, Debts) is Alan and Katie Donegan's, from their free net\n   worth tracker (rebeldonegans.com); the app and its wording are our own.\n\n   Data: one JSON blob in myllmStorage, key \"nw1\":\n     accounts  [{id, name, pot, sub?, units?, archived?}]\n                pot  = freedom | valuable | cash | debt\n                sub  = \"against\" on a valuable account: owed against it (a\n                       mortgage), so it is SUBTRACTED inside that pot\n                units= also track how many fund units the account holds\n     snaps     [{date:'YYYY-MM-DD', v:{accountId: amount}, u:{accountId: units}}]\n     cur, spend (yearly spending, optional) */\n\nvar POTS = [\n  { id:'freedom',  name:'Freedom Fund',            color:'var(--c-free)', short:'Freedom',\n    what:'Investments that can pay for your future: pensions, stocks and shares ISAs, other investments.' },\n  { id:'valuable', name:'Valuable Liabilities',    color:'var(--c-val)',  short:'Valuable',\n    what:'Things worth money that don’t pay for your freedom, like the home you live in (its value, minus the mortgage).' },\n  { id:'cash',     name:'Cash & planned spending', color:'var(--c-cash)', short:'Cash',\n    what:'Current accounts, emergency fund, and savings for things you plan to spend on.' },\n  { id:'debt',     name:'Debts',                   color:'var(--c-debt)', short:'Debts',\n    what:'Money you owe and are paying off. Enter as positive numbers; they are taken away for you.' }\n];\nvar STARTER = [\n  ['Stocks & Shares ISA','freedom'], ['Personal pension (SIPP)','freedom'], ['Workplace pension','freedom'], ['General investment account','freedom'],\n  ['Home: market value','valuable'], ['Home: mortgage','valuable','against'],\n  ['Current account','cash'], ['Emergency fund','cash'], ['Premium Bonds','cash'], ['Cash ISA','cash'],\n  ['Credit card','debt'], ['Car loan','debt'], ['Student loan','debt']\n];\nvar CURS = ['£','$','€','¥','₹','kr','CHF'];\n\nfunction el(id){ return document.getElementById(id); }\nvar store = window.myllmStorage || { getItem:function(){ return Promise.resolve(null); }, setItem:function(){ return Promise.resolve(); } };\nfunction haptic(k){ try{ if (window.myllmHaptic) window.myllmHaptic(k || 'light'); }catch(e){} }\nfunction esc(s){ return String(s == null ? '' : s).replace(/[&<>\"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]; }); }\nfunction uid(){ return 'a' + Date.now().toString(36) + Math.floor(Math.random() * 1e6).toString(36); }\nfunction pad(n){ return (n < 10 ? '0' : '') + n; }\nfunction todayISO(){ var d = new Date(); return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()); }\n/* Dates are local calendar days: parsed as local midnight, never UTC (a UTC\n   parse shows every date a day early west of Greenwich). */\nfunction parseD(s){ var m = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(s || ''); return m ? new Date(+m[1], +m[2] - 1, +m[3]) : null; }\nfunction fmtDate(s, short){ var d = parseD(s); if (!d) return s;\n  return d.toLocaleDateString(undefined, short ? { month:'short', year:'2-digit' } : { day:'numeric', month:'short', year:'numeric' }); }\nfunction num(v){ if (v == null || v === '') return null; var n = parseFloat(String(v).replace(/[^\\d.\\-]/g, '')); return isFinite(n) ? n : null; }\n\nvar S = { accounts:[], snaps:[], cur:'£', spend:null };\nvar tab = 'home', chartKind = 'net', editing = null, splitDate = null;\n\n/* Trackers (v2): several, each one shareable through iCloud (lists-kit +\n   myllmLists, MyLLM 6.1). A tracker travels as a flat list of small items so\n   two people can update different accounts in the same month and both\n   changes land: one item for settings, one per account, one per amount\n   (v|date|account) and per unit count (u|date|account). The first tracker is\n   also written to \"nw1\", the v1 format. */\nfunction encode(d){\n  var out = [{ id:'set', t:'set', cur:d.cur || '£', spend:d.spend || null }];\n  d.accounts.forEach(function(a){\n    var it = { id:'a|' + a.id, t:'a', aid:a.id, name:a.name, pot:a.pot };\n    if (a.sub) it.sub = a.sub; if (a.units) it.units = true; if (a.archived) it.archived = true;\n    out.push(it);\n  });\n  d.snaps.slice().sort(function(a, b){ return a.date < b.date ? -1 : a.date > b.date ? 1 : 0; }).forEach(function(s){\n    Object.keys(s.v || {}).sort().forEach(function(k){ out.push({ id:'v|' + s.date + '|' + k, t:'v', d:s.date, a:k, n:s.v[k] }); });\n    Object.keys(s.u || {}).sort().forEach(function(k){ out.push({ id:'u|' + s.date + '|' + k, t:'u', d:s.date, a:k, n:s.u[k] }); });\n  });\n  return out;\n}\nfunction decode(items){\n  var d = { accounts:[], snaps:[], cur:'£', spend:null }, by = {};\n  function snap(date){ if (!by[date]){ by[date] = { date:date, v:{}, u:{} }; d.snaps.push(by[date]); } return by[date]; }\n  (items || []).forEach(function(it){\n    if (it.t === 'set'){ d.cur = it.cur || '£'; d.spend = it.spend || null; }\n    else if (it.t === 'a' && it.aid){ var a = { id:it.aid, name:String(it.name || ''), pot:it.pot }; if (it.sub) a.sub = it.sub; if (it.units) a.units = true; if (it.archived) a.archived = true; d.accounts.push(a); }\n    else if ((it.t === 'v' || it.t === 'u') && parseD(it.d) && it.a && typeof it.n === 'number' && isFinite(it.n)) snap(it.d)[it.t][it.a] = it.n;\n  });\n  d.snaps = d.snaps.filter(function(s){ return Object.keys(s.v).length; });\n  return d;\n}\nfunction save(){ ListsKit.set(encode(S)); }\nfunction money(n, opt){\n  opt = opt || {};\n  if (n == null || !isFinite(n)) return '—';\n  var abs = Math.abs(n), s;\n  if (opt.compact && abs >= 1e6) s = (abs / 1e6).toFixed(abs >= 1e7 ? 0 : 1).replace(/\\.0$/, '') + 'm';\n  else if (opt.compact && abs >= 1e4) s = Math.round(abs / 1e3) + 'k';\n  else s = abs.toLocaleString(undefined, { maximumFractionDigits: abs >= 1000 || opt.whole ? 0 : 2, minimumFractionDigits: 0 });\n  var sym = S.cur, pre = sym.length <= 1 || sym === '₹';\n  var out = pre ? sym + s : s + ' ' + sym;\n  return (n < 0 ? '−' : (opt.sign && n > 0 ? '+' : '')) + out;\n}\nfunction weeks(pc){ var w = Math.round(pc * 52); return w < 1 ? 'less than a week' : w === 1 ? '1 week' : w + ' weeks'; }\nfunction sorted(){ return S.snaps.slice().sort(function(a, b){ return a.date < b.date ? -1 : a.date > b.date ? 1 : 0; }); }\nfunction acct(id){ for (var i = 0; i < S.accounts.length; i++) if (S.accounts[i].id === id) return S.accounts[i]; return null; }\nfunction potOf(id){ for (var i = 0; i < POTS.length; i++) if (POTS[i].id === id) return POTS[i]; return POTS[0]; }\n\n/* One snapshot's totals. An account that has since been removed still counts\n   in the snapshots it was part of. */\nfunction totals(snap){\n  var t = { freedom:0, valuable:0, cash:0, debt:0, units:0, hasUnits:false };\n  Object.keys(snap.v || {}).forEach(function(id){\n    var a = acct(id), val = snap.v[id];\n    if (!a || val == null || !isFinite(val)) return;\n    if (a.pot === 'valuable' && a.sub === 'against') t.valuable -= val; else t[a.pot] += val;\n  });\n  Object.keys(snap.u || {}).forEach(function(id){ var u = snap.u[id]; if (u != null && isFinite(u)){ t.units += u; t.hasUnits = true; } });\n  t.own = t.freedom + t.valuable + t.cash;\n  t.net = t.own - t.debt;\n  return t;\n}\n\n/* ---------- navigation ---------- */\nfunction go(t){\n  if (t === 'update' && tab !== 'update') startEdit(null);\n  tab = t;\n  ['home','update','charts','accounts'].forEach(function(k){ el('v-' + k).hidden = k !== t; });\n  [].forEach.call(document.querySelectorAll('.tabs button'), function(b){ b.classList.toggle('on', b.getAttribute('data-tab') === t); });\n  render(); window.scrollTo(0, 0);\n}\ndocument.querySelector('.tabs').addEventListener('click', function(e){ var b = e.target.closest('button'); if (!b) return; haptic('selection'); go(b.getAttribute('data-tab')); });\ndocument.addEventListener('click', function(e){ var b = e.target.closest('[data-go]'); if (b){ haptic('selection'); go(b.getAttribute('data-go')); } });\n\nfunction render(){\n  if (tab === 'home') renderHome();\n  else if (tab === 'update') renderUpdate();\n  else if (tab === 'charts') renderCharts();\n  else renderAccounts();\n}\n\n/* ---------- Overview ---------- */\nfunction renderHome(){\n  var list = sorted();\n  el('homeEmpty').hidden = list.length > 0; el('homeMain').hidden = !list.length;\n  if (!list.length) return;\n  var last = list[list.length - 1], prev = list.length > 1 ? list[list.length - 2] : null;\n  var t = totals(last), p = prev ? totals(prev) : null;\n  el('hK').textContent = 'Net worth on ' + fmtDate(last.date);\n  el('hN').textContent = money(t.net);\n  var meta = [];\n  if (p){ var d = t.net - p.net; meta.push('<span><b>' + esc(money(d, { sign:true })) + '</b> since ' + esc(fmtDate(prev.date)) + '</span>'); }\n  if (list.length > 2){ var first = totals(list[0]); meta.push('<span><b>' + esc(money(t.net - first.net, { sign:true })) + '</b> since you started</span>'); }\n  el('hMeta').innerHTML = meta.join('') || '<span>Your first snapshot. Add another next month to see the change.</span>';\n  var pos = Math.max(0, t.freedom) + Math.max(0, t.valuable) + Math.max(0, t.cash) + Math.max(0, t.debt);\n  el('hSplit').innerHTML = pos ? POTS.map(function(P){ var v = Math.max(0, t[P.id]); return v ? '<i title=\"' + esc(P.name) + '\" style=\"width:' + (v / pos * 100) + '%;background:' + P.color + '\"></i>' : ''; }).join('') : '';\n  el('pots').innerHTML = POTS.map(function(P){\n    var v = t[P.id], dd = p ? v - p[P.id] : null, good = P.id === 'debt' ? dd < 0 : dd > 0;\n    return '<button class=\"pot\" type=\"button\" data-pot=\"' + P.id + '\"><div class=\"pk\"><i style=\"background:' + P.color + '\"></i>' + esc(P.name) + '</div>' +\n      '<div class=\"pv\">' + esc(money(v)) + '</div>' +\n      '<div class=\"pd' + (dd ? (good ? ' up' : ' down') : '') + '\">' + (dd == null ? '&nbsp;' : dd === 0 ? 'No change' : esc(money(dd, { sign:true }))) + '</div></button>';\n  }).join('');\n  /* The 4% figure: a rough rule for what a pot of investments could pay out\n     each year without running down too fast. */\n  var four = t.freedom > 0 ? t.freedom * 0.04 : 0, h = '';\n  if (four > 0){\n    h = '<div class=\"big\">' + esc(money(four, { whole:true })) + '<span style=\"font-size:15px;color:var(--muted);font-weight:700\"> a year</span></div>' +\n        '<div class=\"note\">That’s ' + esc(money(four / 12, { whole:true })) + ' a month: 4% of your Freedom Fund.</div>';\n    if (S.spend > 0){\n      var pc = four / S.spend;\n      h += '<div class=\"meter\"><i style=\"width:' + Math.min(100, pc * 100) + '%\"></i></div>' +\n           '<div class=\"note\">' + (pc >= 1 ? '<b>All of your yearly spending</b> (' + esc(money(S.spend, { whole:true })) + '). Your Freedom Fund could cover it.'\n             : 'Enough for about <b>' + weeks(pc) + '</b> of your yearly spending (' + esc(money(S.spend, { whole:true })) + ').') + '</div>';\n    } else h += '<div class=\"note\" style=\"margin-top:8px\"><button type=\"button\" class=\"lnk\" style=\"color:var(--acc);font-weight:700\" data-go=\"accounts\">Add your yearly spending</button> to see how much of a year it covers.</div>';\n  } else {\n    h = '<div class=\"note\">Nothing in your Freedom Fund yet, and that’s fine: this is where you start from. As it grows, this shows how much of a year it could pay for.</div>';\n  }\n  el('fourCard').innerHTML = h;\n  el('homeChart').innerHTML = lineChart(list, [\n    { key:'net', name:'Net worth', color:'var(--c-net)' }, { key:'freedom', name:'Freedom Fund', color:'var(--c-free)' }]);\n}\nel('pots').addEventListener('click', function(e){ var b = e.target.closest('[data-pot]'); if (!b) return; haptic('light'); potSheet(b.getAttribute('data-pot')); });\nfunction potSheet(potId){\n  var P = potOf(potId), last = sorted().slice(-1)[0]; if (!last) return;\n  var rows = S.accounts.filter(function(a){ return a.pot === potId && last.v[a.id] != null; }).map(function(a){\n    var v = last.v[a.id], neg = a.pot === 'valuable' && a.sub === 'against';\n    return '<div class=\"row\"><span class=\"nm\">' + esc(a.name) + (a.archived ? '<small>removed account</small>' : '') + '</span><span class=\"amt\">' + esc(money(neg ? -v : v)) + '</span></div>';\n  }).join('');\n  sheet(P.name, '<p>' + esc(P.what) + '</p><div class=\"rows\">' + (rows || '<div class=\"row\"><span class=\"nm\" style=\"color:var(--muted)\">Nothing in this pot on ' + esc(fmtDate(last.date)) + '</span></div>') + '</div>',\n        [{ label:'Close' }]);\n}\n\n/* ---------- Update: a snapshot ---------- */\nfunction lastWorkingDay(){ var d = new Date(); d = new Date(d.getFullYear(), d.getMonth() + 1, 0); while (d.getDay() === 0 || d.getDay() === 6) d.setDate(d.getDate() - 1); return d; }\nfunction startEdit(date){\n  var src = null, list = sorted();\n  if (date){ for (var i = 0; i < list.length; i++) if (list[i].date === date) src = list[i]; }\n  editing = { date: date || todayISO(), original: date || null, v:{}, u:{} };\n  var base = src || list[list.length - 1];          /* a new snapshot starts from the last one's numbers */\n  /* A new snapshot leaves out accounts you've removed since; editing an old one keeps everything it had. */\n  function keep(k){ var a = acct(k); return a && (src || !a.archived); }\n  if (base){ Object.keys(base.v || {}).forEach(function(k){ if (keep(k)) editing.v[k] = base.v[k]; }); Object.keys(base.u || {}).forEach(function(k){ if (keep(k)) editing.u[k] = base.u[k]; }); }\n}\nfunction activeOrUsed(potId){\n  return S.accounts.filter(function(a){ return a.pot === potId && (!a.archived || (editing && editing.original && editing.v[a.id] != null)); });\n}\nfunction renderUpdate(){\n  if (!editing) startEdit(null);\n  var isEdit = !!editing.original;\n  el('upTitle').textContent = isEdit ? 'Edit snapshot' : 'New snapshot';\n  el('upDate').value = editing.date;\n  var lw = lastWorkingDay();\n  el('upDateHint').textContent = isEdit ? 'Changing the date moves this snapshot.' :\n    'Pick the same point each month, for example the last working day (this month: ' + lw.toLocaleDateString(undefined, { weekday:'short', day:'numeric', month:'short' }) + '). Numbers start from your last snapshot, so only change what moved.';\n  el('upPots').innerHTML = POTS.map(function(P){\n    var accs = activeOrUsed(P.id);\n    return '<div class=\"potH\"><i style=\"background:' + P.color + '\"></i><b>' + esc(P.name) + '</b><span id=\"pt-' + P.id + '\"></span></div>' +\n      '<div class=\"card\" style=\"padding:4px 12px\">' + (accs.length ? accs.map(function(a){\n        var v = editing.v[a.id], u = editing.u[a.id];\n        return '<div class=\"row\"><span class=\"nm\">' + esc(a.name) + '<small>' + (a.sub === 'against' ? 'owed against it: taken away' : (P.id === 'debt' ? 'enter what you owe' : '')) + '</small></span>' +\n          '<input class=\"num\" inputmode=\"decimal\" data-acc=\"' + a.id + '\" value=\"' + (v == null ? '' : esc(v)) + '\" placeholder=\"0\" aria-label=\"' + esc(a.name) + '\"></div>' +\n          (a.units ? '<div class=\"row\"><span class=\"nm\" style=\"font-weight:500;color:var(--muted)\"> Units held</span><input class=\"num\" inputmode=\"decimal\" data-units=\"' + a.id + '\" value=\"' + (u == null ? '' : esc(u)) + '\" placeholder=\"units\" aria-label=\"Units in ' + esc(a.name) + '\"></div>' : '');\n      }).join('') : '<div class=\"row\"><span class=\"nm\" style=\"color:var(--muted);font-weight:500\">No accounts here. <button type=\"button\" class=\"lnk\" data-go=\"accounts\">Add one</button></span></div>') + '</div>';\n  }).join('');\n  el('upDelete').hidden = !isEdit; el('upCancel').hidden = !isEdit;\n  updateTotals();\n}\nfunction updateTotals(){\n  var t = totals(editing);\n  POTS.forEach(function(P){ var n = el('pt-' + P.id); if (n) n.textContent = money(t[P.id]); });\n  el('upTotal').textContent = money(t.net);\n  var list = sorted().filter(function(s){ return s.date < editing.date; });\n  var prev = list[list.length - 1];\n  el('upDelta').textContent = prev ? money(t.net - totals(prev).net, { sign:true }) + ' since ' + fmtDate(prev.date) : 'What you own minus what you owe.';\n}\nel('upPots').addEventListener('input', function(e){\n  var t = e.target, id;\n  if ((id = t.getAttribute('data-acc'))){ var n = num(t.value); if (n == null) delete editing.v[id]; else editing.v[id] = acct(id).pot === 'debt' ? Math.abs(n) : n; }   /* debts are stored as positive amounts */\n  else if ((id = t.getAttribute('data-units'))){ var u = num(t.value); if (u == null) delete editing.u[id]; else editing.u[id] = u; }\n  updateTotals();\n});\nel('upPots').addEventListener('keydown', function(e){\n  if (e.key !== 'Enter' || !e.target.matches('input')) return;\n  var all = [].slice.call(el('upPots').querySelectorAll('input')), i = all.indexOf(e.target);\n  if (all[i + 1]) all[i + 1].focus(); else e.target.blur();\n});\nel('upDate').addEventListener('change', function(){ if (parseD(el('upDate').value)) { editing.date = el('upDate').value; updateTotals(); } });\nel('upSave').onclick = function(){\n  var date = el('upDate').value;\n  if (!parseD(date)){ toast('Pick a date first'); return; }\n  if (!Object.keys(editing.v).length){ toast('Enter at least one amount'); return; }\n  var clash = S.snaps.filter(function(s){ return s.date === date && s.date !== editing.original; })[0];\n  function commit(){\n    S.snaps = S.snaps.filter(function(s){ return s.date !== date && s.date !== editing.original; });\n    S.snaps.push({ date:date, v:editing.v, u:editing.u });\n    save(); haptic('success'); toast('Snapshot saved'); editing = null; go('home');\n  }\n  if (clash) sheet('Replace ' + fmtDate(date) + '?', '<p>You already have a snapshot on this date. Saving replaces it.</p>', [{ label:'Cancel' }, { label:'Replace', cls:'pri', fn:commit }]);\n  else commit();\n};\nel('upDelete').onclick = function(){\n  var d = editing.original;\n  sheet('Delete this snapshot?', '<p>The snapshot from ' + esc(fmtDate(d)) + ' will be removed. This can’t be undone.</p>',\n    [{ label:'Cancel' }, { label:'Delete', cls:'dan', fn:function(){ S.snaps = S.snaps.filter(function(s){ return s.date !== d; }); save(); haptic('success'); toast('Snapshot deleted'); editing = null; go('charts'); } }]);\n};\nel('upCancel').onclick = function(){ editing = null; go('charts'); };\n\n/* ---------- Charts ---------- */\nfunction niceMax(v){ if (v <= 0) return 1; var p = Math.pow(10, Math.floor(Math.log10(v))), f = v / p; return (f <= 1 ? 1 : f <= 2 ? 2 : f <= 5 ? 5 : 10) * p; }\n/* A line chart of snapshot totals: one line per series key, dots at each snapshot. */\nfunction lineChart(list, series, opt){\n  opt = opt || {};\n  if (list.length < 2) return '<div class=\"note\">Charts start once you have two snapshots. Add one each month and the line builds up.</div>';\n  var W = 340, H = 190, L = 46, R = 10, T = 10, B = 26;\n  var vals = []; list.forEach(function(s){ var t = opt.map ? opt.map(s) : totals(s); series.forEach(function(se){ vals.push(t[se.key]); }); });\n  vals = vals.concat(opt.include || []);              /* e.g. the yearly-spending line, so it stays on the chart */\n  var fmt = opt.fmt || function(v){ return money(v, { compact:true }); };\n  var hi = Math.max.apply(null, vals.concat([0])), lo = Math.min.apply(null, vals.concat([0]));\n  var top = niceMax(hi), bot = lo < 0 ? -niceMax(-lo) : 0, span = top - bot || 1;\n  var t0 = parseD(list[0].date).getTime(), t1 = parseD(list[list.length - 1].date).getTime(), tspan = t1 - t0 || 1;\n  function x(s){ return L + (parseD(s.date).getTime() - t0) / tspan * (W - L - R); }\n  function y(v){ return T + (top - v) / span * (H - T - B); }\n  var g = '';\n  [top, (top + bot) / 2, bot].forEach(function(v){ g += '<line class=\"grid\" x1=\"' + L + '\" x2=\"' + (W - R) + '\" y1=\"' + y(v) + '\" y2=\"' + y(v) + '\"/><text x=\"' + (L - 6) + '\" y=\"' + (y(v) + 3.5) + '\" text-anchor=\"end\">' + esc(fmt(v)) + '</text>'; });\n  if (bot < 0) g += '<line x1=\"' + L + '\" x2=\"' + (W - R) + '\" y1=\"' + y(0) + '\" y2=\"' + y(0) + '\" stroke=\"var(--muted)\" stroke-width=\"1\"/>';\n  var ticks = list.length <= 6 ? list : [list[0], list[Math.floor(list.length / 3)], list[Math.floor(2 * list.length / 3)], list[list.length - 1]];\n  ticks.forEach(function(s, i){ g += '<text x=\"' + x(s) + '\" y=\"' + (H - 8) + '\" text-anchor=\"' + (i === 0 ? 'start' : i === ticks.length - 1 ? 'end' : 'middle') + '\">' + esc(fmtDate(s.date, true)) + '</text>'; });\n  series.forEach(function(se){\n    var pts = list.map(function(s){ var t = opt.map ? opt.map(s) : totals(s); return [x(s), y(t[se.key])]; });\n    g += '<polyline fill=\"none\" stroke=\"' + se.color + '\" stroke-width=\"2.4\" stroke-linejoin=\"round\" stroke-linecap=\"round\" points=\"' + pts.map(function(p){ return p[0].toFixed(1) + ',' + p[1].toFixed(1); }).join(' ') + '\"/>';\n    if (list.length <= 36) pts.forEach(function(p){ g += '<circle cx=\"' + p[0].toFixed(1) + '\" cy=\"' + p[1].toFixed(1) + '\" r=\"3.2\" fill=\"var(--surface)\" stroke=\"' + se.color + '\" stroke-width=\"2\"/>'; });\n  });\n  if (opt.extra) g += opt.extra(y, L, W - R);\n  return '<svg class=\"chart\" viewBox=\"0 0 ' + W + ' ' + H + '\" role=\"img\" aria-label=\"' + esc(series.map(function(s){ return s.name; }).join(' and ')) + ' over time\">' + g + '</svg>' +\n    '<div class=\"legend\">' + series.map(function(se){ return '<span><i style=\"background:' + se.color + '\"></i>' + esc(se.name) + '</span>'; }).join('') + (opt.legendExtra || '') + '</div>';\n}\nvar CHARTS = {\n  net:   { t:'Net worth and Freedom Fund', s:'Your total net worth and your Freedom Fund at each snapshot. The gap between them is your home, cash and debts.' },\n  split: { t:'Net worth split', s:'What made up your net worth on one date. Pick the date below.' },\n  four:  { t:'What your Freedom Fund could cover', s:'4% of your Freedom Fund each year: a rough guide to what it could pay out without running down too fast.' },\n  debt:  { t:'Debt payoff', s:'How much you owed at each snapshot. Shrinking bars mean you’re getting there.' },\n  units: { t:'Fund units', s:'The number of fund units you hold. Unlike values, units don’t move with the market, so this shows what you’ve actually bought.' }\n};\nfunction renderCharts(){\n  var list = sorted();\n  [].forEach.call(el('chartSeg').children, function(b){ b.classList.toggle('on', b.getAttribute('data-c') === chartKind); });\n  el('chT').textContent = CHARTS[chartKind].t; el('chS').textContent = CHARTS[chartKind].s;\n  var body = '';\n  if (!list.length) body = '<div class=\"note\">No snapshots yet. <button type=\"button\" class=\"lnk\" style=\"color:var(--acc);font-weight:700\" data-go=\"update\">Take your first</button>.</div>';\n  else if (chartKind === 'net') body = lineChart(list, [{ key:'net', name:'Net worth', color:'var(--c-net)' }, { key:'freedom', name:'Freedom Fund', color:'var(--c-free)' }]);\n  else if (chartKind === 'split'){\n    if (!splitDate || !list.some(function(s){ return s.date === splitDate; })) splitDate = list[list.length - 1].date;\n    var snap = list.filter(function(s){ return s.date === splitDate; })[0], t = totals(snap);\n    var max = Math.max(1, t.freedom, t.valuable, t.cash, t.debt);\n    body = '<select id=\"splitSel\" aria-label=\"Snapshot date\">' + list.slice().reverse().map(function(s){ return '<option value=\"' + s.date + '\"' + (s.date === splitDate ? ' selected' : '') + '>' + esc(fmtDate(s.date)) + '</option>'; }).join('') + '</select>' +\n      '<div class=\"bars\" style=\"margin-top:14px\">' + POTS.map(function(P){ var v = t[P.id];\n        return '<div class=\"bar\"><span>' + esc(P.short) + '</span><div class=\"tr\"><i style=\"width:' + Math.max(0, v) / max * 100 + '%;background:' + P.color + '\"></i></div><b>' + esc(money(P.id === 'debt' ? -v : v, { compact:true })) + '</b></div>'; }).join('') + '</div>' +\n      '<div class=\"note\" style=\"margin-top:12px\">You own <b>' + esc(money(t.own)) + '</b>, owe <b>' + esc(money(t.debt)) + '</b>. Net worth <b>' + esc(money(t.net)) + '</b>.' +\n      (t.own > 0 ? ' The Freedom Fund is <b>' + Math.round(Math.max(0, t.freedom) / t.own * 100) + '%</b> of what you own.' : '') + '</div>';\n  }\n  else if (chartKind === 'four'){\n    body = lineChart(list, [{ key:'four', name:'4% a year', color:'var(--c-free)' }], {\n      map:function(s){ return { four: Math.max(0, totals(s).freedom) * 0.04 }; },\n      include: S.spend > 0 ? [S.spend] : [],\n      extra: S.spend > 0 ? function(y, x0, x1){ return '<line x1=\"' + x0 + '\" x2=\"' + x1 + '\" y1=\"' + y(S.spend) + '\" y2=\"' + y(S.spend) + '\" stroke=\"var(--muted)\" stroke-dasharray=\"4 4\" stroke-width=\"1.5\"/>'; } : null,\n      legendExtra: S.spend > 0 ? '<span><i style=\"background:var(--muted)\"></i>Your yearly spending</span>' : ''\n    });\n    if (!S.spend) body += '<div class=\"note\" style=\"margin-top:8px\"><button type=\"button\" class=\"lnk\" style=\"color:var(--acc);font-weight:700\" data-go=\"accounts\">Add your yearly spending</button> to draw it as a line.</div>';\n  }\n  else if (chartKind === 'debt'){\n    var dmax = Math.max.apply(null, list.map(function(s){ return totals(s).debt; }).concat([1]));\n    var any = list.some(function(s){ return totals(s).debt > 0; });\n    body = any ? '<div style=\"display:flex;align-items:flex-end;gap:6px;height:150px;padding-top:6px\">' + list.slice(-12).map(function(s){ var d = totals(s).debt;\n        return '<div style=\"flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;min-width:0\"><em style=\"font-style:normal;font-size:10px;color:var(--muted);white-space:nowrap\">' + (d ? esc(money(d, { compact:true })) : '') + '</em>' +\n          '<i style=\"display:block;width:100%;max-width:34px;border-radius:7px 7px 3px 3px;background:var(--c-debt);min-height:2px;height:' + (d / dmax * 110) + 'px\"></i>' +\n          '<span style=\"font-size:10.5px;color:var(--muted);font-weight:650\">' + esc(fmtDate(s.date, true)) + '</span></div>'; }).join('') + '</div>' +\n        (list.length > 12 ? '<div class=\"note\" style=\"margin-top:8px\">The last 12 snapshots.</div>' : '')\n      : '<div class=\"note\">No debts in any snapshot. Nothing to pay off.</div>';\n  }\n  else {\n    var withU = list.filter(function(s){ return totals(s).hasUnits; });\n    body = withU.length ? lineChart(withU, [{ key:'units', name:'Units held', color:'var(--c-val)' }], { map:function(s){ return { units: totals(s).units }; },\n        fmt:function(v){ return v >= 1e4 ? Math.round(v / 1e3) + 'k' : String(Math.round(v * 10) / 10); } }) :\n      '<div class=\"note\">Optional. To track units, turn on <b>Track units</b> for an investment in Accounts, then enter the units with each snapshot.</div>';\n  }\n  el('chBody').innerHTML = body;\n  el('history').innerHTML = list.length ? list.slice().reverse().map(function(s){ var t = totals(s);\n    return '<div class=\"row\"><span class=\"nm\">' + esc(fmtDate(s.date)) + '<small>Freedom ' + esc(money(t.freedom, { compact:true })) + ' · Debts ' + esc(money(t.debt, { compact:true })) + '</small></span><span class=\"amt\">' + esc(money(t.net)) + '</span><button type=\"button\" class=\"lnk\" data-edit=\"' + s.date + '\">Edit</button></div>'; }).join('')\n    : '<div class=\"row\"><span class=\"nm\" style=\"color:var(--muted);font-weight:500\">None yet</span></div>';\n}\nel('chartSeg').addEventListener('click', function(e){ var b = e.target.closest('button'); if (!b) return; haptic('selection'); chartKind = b.getAttribute('data-c'); renderCharts(); });\nel('chBody').addEventListener('change', function(e){ if (e.target.id === 'splitSel'){ splitDate = e.target.value; renderCharts(); } });\nel('history').addEventListener('click', function(e){ var b = e.target.closest('[data-edit]'); if (!b) return; haptic('light'); startEdit(b.getAttribute('data-edit')); tab = 'update';\n  ['home','update','charts','accounts'].forEach(function(k){ el('v-' + k).hidden = k !== 'update'; });\n  [].forEach.call(document.querySelectorAll('.tabs button'), function(x){ x.classList.toggle('on', x.getAttribute('data-tab') === 'update'); });\n  renderUpdate(); window.scrollTo(0, 0); });\n\n/* ---------- Accounts ---------- */\nfunction renderAccounts(){\n  el('accPots').innerHTML = POTS.map(function(P){\n    var accs = S.accounts.filter(function(a){ return a.pot === P.id && !a.archived; });\n    return '<div class=\"potH\"><i style=\"background:' + P.color + '\"></i><b>' + esc(P.name) + '</b></div><div class=\"hint\">' + esc(P.what) + '</div>' +\n      '<div class=\"card\" style=\"padding:4px 12px\">' + accs.map(function(a){\n        var tags = []; if (a.sub === 'against') tags.push('owed against it: taken away'); if (a.units) tags.push('tracking units');\n        return '<div class=\"row\"><span class=\"nm\">' + esc(a.name) + (tags.length ? '<small>' + esc(tags.join(' · ')) + '</small>' : '') + '</span><button type=\"button\" class=\"lnk\" data-acc-edit=\"' + a.id + '\">Edit</button></div>';\n      }).join('') + '<div class=\"row\"><button type=\"button\" class=\"lnk\" data-acc-add=\"' + P.id + '\">+ Add to ' + esc(P.short) + '</button></div></div>';\n  }).join('');\n  el('curChips').innerHTML = CURS.map(function(c){ return '<button type=\"button\" class=\"' + (c === S.cur ? 'on' : '') + '\" data-cur=\"' + esc(c) + '\">' + esc(c) + '</button>'; }).join('');\n  el('spendIn').value = S.spend || '';\n}\nel('accPots').addEventListener('click', function(e){\n  var b = e.target.closest('[data-acc-edit],[data-acc-add]'); if (!b) return; haptic('light');\n  if (b.hasAttribute('data-acc-add')) accountSheet(null, b.getAttribute('data-acc-add')); else accountSheet(acct(b.getAttribute('data-acc-edit')));\n});\nfunction accountSheet(a, potId){\n  var isNew = !a; a = a || { id:uid(), name:'', pot:potId };\n  var pot = a.pot;\n  function body(){\n    return '<label class=\"f\" for=\"acName\" style=\"margin-top:4px\">Name</label><input id=\"acName\" autocomplete=\"off\" value=\"' + esc(a.name) + '\" placeholder=\"e.g. Vanguard ISA, Nationwide mortgage\">' +\n      '<label class=\"f\">Pot</label><div class=\"chips\" id=\"acPot\">' + POTS.map(function(P){ return '<button type=\"button\" data-p=\"' + P.id + '\" class=\"' + (P.id === pot ? 'on' : '') + '\">' + esc(P.short) + '</button>'; }).join('') + '</div>' +\n      '<div id=\"acOpts\"></div>';\n  }\n  function opts(){\n    var h = '';\n    if (pot === 'valuable') h += '<label class=\"f\">This is</label><div class=\"chips\" id=\"acSub\"><button type=\"button\" data-s=\"\" class=\"' + (a.sub !== 'against' ? 'on' : '') + '\">Something you own</button><button type=\"button\" data-s=\"against\" class=\"' + (a.sub === 'against' ? 'on' : '') + '\">Owed against it (mortgage)</button></div>';\n    if (pot === 'freedom') h += '<label class=\"f\">Units</label><div class=\"chips\" id=\"acUnits\"><button type=\"button\" data-u=\"0\" class=\"' + (!a.units ? 'on' : '') + '\">Value only</button><button type=\"button\" data-u=\"1\" class=\"' + (a.units ? 'on' : '') + '\">Track units too</button></div>';\n    h += '<p style=\"margin-top:10px\">' + esc(potOf(pot).what) + '</p>';\n    return h;\n  }\n  var acts = [{ label:'Cancel' }];\n  /* A shared tracker can refresh while this sheet is open, so changes go to\n     the account as it is now, found by id. */\n  if (!isNew) acts.push({ label:'Remove', cls:'dan', fn:function(){\n    var t = acct(a.id); if (t) t.archived = true; save(); renderAccounts(); toast('Removed. Past snapshots keep its values.'); } });\n  acts.push({ label: isNew ? 'Add' : 'Save', cls:'pri', keep:true, fn:function(){\n    var name = el('acName').value.trim(); if (!name){ el('acName').focus(); return false; }\n    var t = acct(a.id);\n    if (!t){ t = { id:a.id }; S.accounts.push(t); }\n    t.name = name; t.pot = pot;\n    if (pot === 'valuable' && a.sub) t.sub = a.sub; else delete t.sub;\n    if (pot === 'freedom' && a.units) t.units = true; else delete t.units;\n    save(); renderAccounts(); haptic('success'); return true; } });\n  sheet(isNew ? 'Add an account' : 'Edit account', body(), acts);\n  el('acOpts').innerHTML = opts();\n  el('shB').onclick = function(e){\n    var p = e.target.closest('[data-p]'), s = e.target.closest('[data-s]'), u = e.target.closest('[data-u]');\n    if (p){ pot = p.getAttribute('data-p'); [].forEach.call(el('acPot').children, function(x){ x.classList.toggle('on', x === p); }); el('acOpts').innerHTML = opts(); haptic('selection'); }\n    if (s){ a.sub = s.getAttribute('data-s') || undefined; el('acOpts').innerHTML = opts(); haptic('selection'); }\n    if (u){ a.units = u.getAttribute('data-u') === '1'; el('acOpts').innerHTML = opts(); haptic('selection'); }\n  };\n  if (isNew) setTimeout(function(){ el('acName').focus(); }, 80);\n}\nel('curChips').addEventListener('click', function(e){ var b = e.target.closest('[data-cur]'); if (!b) return; S.cur = b.getAttribute('data-cur'); save(); haptic('selection'); renderAccounts(); });\nel('spendIn').addEventListener('change', function(){ var n = num(el('spendIn').value); S.spend = n && n > 0 ? n : null; save(); toast(S.spend ? 'Yearly spending saved' : 'Yearly spending cleared'); });\nel('spendIn').addEventListener('keydown', function(e){ if (e.key === 'Enter') el('spendIn').blur(); });\nel('exportBtn').onclick = function(){\n  var list = sorted();\n  if (!list.length){ toast('Nothing to export yet'); return; }\n  var used = S.accounts.filter(function(a){ return list.some(function(s){ return s.v[a.id] != null; }); });\n  function q(s){ s = String(s); return /[\",\\n]/.test(s) ? '\"' + s.replace(/\"/g, '\"\"') + '\"' : s; }\n  var lines = [['Pot', 'Account'].concat(list.map(function(s){ return s.date; })).map(q).join(',')];\n  used.forEach(function(a){ lines.push([potOf(a.pot).name, a.name + (a.sub === 'against' ? ' (owed against)' : '')].concat(list.map(function(s){ return s.v[a.id] == null ? '' : s.v[a.id]; })).map(q).join(',')); });\n  POTS.forEach(function(P){ lines.push(['Total', P.name].concat(list.map(function(s){ return Math.round(totals(s)[P.id] * 100) / 100; })).map(q).join(',')); });\n  lines.push(['Total', 'Net worth'].concat(list.map(function(s){ return Math.round(totals(s).net * 100) / 100; })).map(q).join(','));\n  var csv = lines.join('\\n');\n  if (window.myllmShare){ try{ Promise.resolve(window.myllmShare(csv)).catch(function(){}); haptic('success'); }catch(e){ toast('Couldn’t open the share sheet'); } }\n  else { try{ navigator.clipboard.writeText(csv).then(function(){ toast('CSV copied'); }); }catch(e){ toast('Sharing isn’t available here'); } }\n};\nel('resetBtn').onclick = function(){\n  var cl = ListsKit.current().cloud, shared = cl && (cl.shared || !cl.owner);\n  sheet('Start again?', '<p>This deletes every snapshot and account in “' + esc(ListsKit.current().name) + '”' + (shared ? ', for everyone it’s shared with' : '') + '. Export a CSV first if you want a copy. This can’t be undone.</p>',\n    [{ label:'Cancel' }, { label:'Delete everything', cls:'dan', fn:function(){ S = { accounts:starter(), snaps:[], cur:S.cur, spend:null }; save(); haptic('success'); toast('Started again'); go('home'); } }]);\n};\n\n/* ---------- How it works ---------- */\nfunction guide(){\n  sheet('How it works', '<div class=\"guide\">' +\n    '<p>Your net worth is a snapshot: <b>what you own minus what you owe</b>. It isn’t a budget, so leave out your salary, rent and day-to-day spending. The question it answers is: where am I now, and am I moving towards financial freedom?</p>' +\n    '<p>Everything goes into one of four pots, sorted by whether it helps pay for your freedom:</p>' +\n    POTS.map(function(P){ return '<h3><i style=\"background:' + P.color + '\"></i>' + esc(P.name) + '</h3><p>' + esc(P.what) + '</p>'; }).join('') +\n    '<h3>Tips</h3><ul>' +\n    '<li>Take a snapshot once a month, on the same kind of day each time. Being consistent matters more than the exact date.</li>' +\n    '<li>The first one takes some digging: old pensions, forgotten accounts, mortgage balances. It’s worth it.</li>' +\n    '<li>A final-salary (defined benefit) pension: multiply the yearly amount you’re promised by 25 and put that in your Freedom Fund.</li>' +\n    '<li>An investment property that pays you each month belongs in the Freedom Fund; one that costs you each month is a Valuable Liability. Enter its equity (value minus mortgage).</li>' +\n    '<li>A credit card you clear in full each month can be left out. Include cards you carry a balance on.</li>' +\n    '<li>UK student loans work more like a tax, and many are never fully repaid. Include yours only if you expect to pay it off.</li>' +\n    '<li>Keep more than one tracker with <b>New</b> at the top, for example your own and a joint household one. <b>Share</b> lets a partner update the same tracker from their own MyLLM through iCloud (MyLLM 6.1 or later). A tracker you don’t share stays on this device.</li>' +\n    '<li>The 4% figure is a rough rule of thumb, not advice. Compare it with your yearly spending to see how far your Freedom Fund could take you.</li></ul>' +\n    '<p class=\"src\">The four-pot method comes from Alan and Katie Donegan’s free net worth tracker. Their full guide and video: <a href=\"https://rebeldonegans.com/finance/take-control/net-worth-tracker/\" target=\"_top\" rel=\"noopener\">rebeldonegans.com</a>. This app isn’t made by or affiliated with them. Nothing here is financial advice.</p>' +\n    '</div>', [{ label:'Close', cls:'pri' }]);\n}\nel('helpBtn').onclick = function(){ haptic('light'); guide(); };\nel('emptyHelp').onclick = function(){ haptic('light'); guide(); };\n\n/* ---------- sheet + toast (the web view has no alert/confirm) ---------- */\nfunction sheet(title, html, actions){\n  el('shT').textContent = title; el('shB').innerHTML = html; el('shB').onclick = null;\n  el('shA').innerHTML = '';\n  actions.forEach(function(a){\n    var b = document.createElement('button'); b.type = 'button'; b.textContent = a.label; if (a.cls) b.className = a.cls;\n    b.onclick = function(){ var r = a.fn ? a.fn() : true; if (r !== false) closeSheet(); };\n    el('shA').appendChild(b);\n  });\n  el('sheet').hidden = false; el('sheet').querySelector('.panel').scrollTop = 0;\n}\nfunction closeSheet(){ el('sheet').hidden = true; }\nel('sheet').addEventListener('click', function(e){ if (e.target === el('sheet')) closeSheet(); });\ndocument.addEventListener('keydown', function(e){ if (e.key === 'Escape' && !el('sheet').hidden) closeSheet(); });\nvar toastT = null;\nfunction toast(msg){ var t = el('toast'); t.textContent = msg; t.classList.add('on'); clearTimeout(toastT); toastT = setTimeout(function(){ t.classList.remove('on'); }, 2200); }\n\n/* ---------- load ---------- */\nfunction starter(){ return STARTER.map(function(r, i){ var a = { id:'s' + i, name:r[0], pot:r[1] }; if (r[2]) a.sub = r[2]; return a; }); }\nfunction fresh(){ return { accounts:starter(), snaps:[], cur:'£', spend:null }; }\n/* The open tracker changed (picked, edited elsewhere, or synced). A tracker\n   that was just made here starts with the usual accounts. While a snapshot is\n   being typed the screen is left alone; it picks the new numbers up after. */\nvar shown = null;\nfunction fromKit(){\n  var l = ListsKit.current();\n  S = decode(l.items);\n  if (!l.cloud && !l.items.length){ S = fresh(); ListsKit.set(encode(S)); }\n  if (l.id !== shown){\n    var first = shown === null; shown = l.id; splitDate = null;\n    if (!first && tab === 'update'){ editing = null; go('home'); return; }\n  } else if (tab === 'update') return;\n  render();\n}\nListsKit.start({\n  kind:'networth', storeKey:'nw2', defaultName:'My net worth', noun:'tracker', example:'Household',\n  fix:function(x){ return x; },\n  legacy:function(){\n    return Promise.resolve(store.getItem('nw1')).then(function(v){\n      var d = null; try{ d = v ? JSON.parse(v) : null; }catch(e){}\n      if (d && Array.isArray(d.accounts) && Array.isArray(d.snaps))\n        return encode({ accounts:d.accounts, snaps:d.snaps.filter(function(s){ return s && parseD(s.date) && s.v; }), cur:d.cur || '£', spend:d.spend || null });\n      return encode(fresh());\n    }, function(){ return encode(fresh()); });\n  },\n  render:fromKit,\n  main:function(items){ try{ store.setItem('nw1', JSON.stringify(decode(items))); }catch(e){} }\n});\n</script>\n<script>\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes.\n   The spacer keeps the header clear of the status bar / Dynamic Island. It is\n   live CSS — env(safe-area-inset-top) — not a measured number: the inset is\n   still 0 when the page loads and only grows once MyLLM's bar has gone (v1\n   measured once, so the title sat under the island). If the page's own styles\n   already pad the header down by the inset, the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  /* Does any rule that applies to the header or an ancestor already use the top inset? */\n  function pageHandlesInset(head){\n    var chain = [], n, found = false;\n    for (n = head; n && n.nodeType === 1; n = n.parentElement) chain.push(n);\n    function walk(rules){\n      for (var i = 0; i < rules.length && !found; i++){\n        var r = rules[i];\n        if (r.cssRules && !r.selectorText) { walk(r.cssRules); continue; }\n        if (!r.selectorText || !/safe-area-inset-top/.test(r.cssText) || !/(padding|margin|top)\\s*:/.test(r.cssText)) continue;\n        if (/\\.imm-safe/.test(r.selectorText)) continue;\n        for (var k = 0; k < chain.length; k++){\n          try { if (chain[k].matches(r.selectorText)) { found = true; break; } } catch(e){}\n        }\n      }\n    }\n    for (var s = 0; s < document.styleSheets.length && !found; s++){\n      try { walk(document.styleSheets[s].cssRules); } catch(e){}\n    }\n    for (n = head; n && n.nodeType === 1 && !found; n = n.parentElement){\n      if (/safe-area-inset-top/.test(n.getAttribute(\"style\") || \"\")) found = true;\n    }\n    return found;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = (document.body.classList.contains(\"imm\") && !pageHandlesInset(head)) ? \"env(safe-area-inset-top)\" : \"0px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n\n</script></body></html>\n"}