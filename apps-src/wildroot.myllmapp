{"name": "Wildroot", "kind": "html", "iconSymbol": "leaf.fill", "iconColor": "green", "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Wildroot</title>\n<style>\n:root{color-scheme:dark;--bg:#0a0d0a;--panel:#131a13;--ink:#e9efe6;--mut:#7f8f7c;--line:#243024;\n  --p0:#5fd08a;--p1:#e0965a;--gold:#ffd23f;--danger:#e06060}\n*{box-sizing:border-box;margin:0}\nhtml,body{height:100%}\nbody{font-family:-apple-system,system-ui,sans-serif;background:radial-gradient(120% 100% at 50% 0%,#101810,var(--bg));color:var(--ink);\n  position:fixed;inset:0;width:100%;height:100dvh;overflow:hidden;display:flex;flex-direction:column;\n  -webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none}\n/* top: opponent + score */\n.top{padding:calc(10px + env(safe-area-inset-top)) 16px 6px;display:flex;align-items:center;gap:10px}\n.pname{font-size:13px;font-weight:800}\n.pname.foe{color:var(--p1)}\n.pname.you{color:var(--p0)}\n.sp{flex:1}\n.scorebar{height:10px;border-radius:6px;background:var(--panel);overflow:hidden;display:flex;margin:4px 16px 2px;border:1px solid var(--line)}\n.scorebar i{display:block;height:100%;transition:width .5s ease}\n.scorebar .s0{background:var(--p0)}\n.scorebar .s1{background:var(--p1);margin-left:auto}\n.scores{display:flex;justify-content:space-between;padding:0 16px;font-size:12px;font-weight:800;color:var(--mut)}\n/* board */\n#stage{flex:1;display:flex;align-items:center;justify-content:center;min-height:0;padding:6px}\n.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;width:min(92vw,46dvh)}\n.cell{aspect-ratio:3/4;border-radius:13px;border:1.5px dashed #2c3a2c;background:rgba(19,26,19,.5);\n  position:relative;display:flex;align-items:center;justify-content:center;transition:border-color .2s,box-shadow .2s}\n.cell.open.can{border-color:var(--p0);box-shadow:0 0 14px rgba(95,208,138,.25);cursor:pointer}\n.cell .remains{font-size:22px;opacity:.55}\n.cell .rlabel{position:absolute;bottom:6px;font-size:8px;letter-spacing:.1em;color:var(--mut);font-weight:800}\n/* creature card (board + hand share the look) */\n.card{width:100%;height:100%;border-radius:12px;padding:6px 7px;display:flex;flex-direction:column;position:relative;\n  background:linear-gradient(180deg,#1a231a,#131a13);border:2px solid var(--line);overflow:hidden}\n.card.own{border-color:var(--p0)}\n.card.foe{border-color:var(--p1)}\n.card .art{flex:1;display:flex;align-items:center;justify-content:center;font-size:clamp(22px,6dvh,40px);\n  filter:drop-shadow(0 3px 8px rgba(0,0,0,.6))}\n.card .nm{font-size:clamp(8px,1.3dvh,11px);font-weight:800;text-align:center;line-height:1.15;letter-spacing:.02em}\n.card .tag{position:absolute;top:5px;left:6px;font-size:8px;font-weight:900;letter-spacing:.08em;color:var(--mut)}\n.card .pw{position:absolute;top:3px;right:6px;font-size:clamp(14px,2.4dvh,20px);font-weight:900;color:var(--gold);\n  text-shadow:0 0 10px rgba(255,210,63,.45);font-variant-numeric:tabular-nums}\n.card.bumped .pw{color:#8dffb5}\n.card.hit{animation:shake .35s}\n@keyframes shake{25%{transform:translateX(-3px)}75%{transform:translateX(3px)}}\n.card.eaten{animation:gulp .4s forwards}\n@keyframes gulp{to{transform:scale(.1) rotate(14deg);opacity:0}}\n/* hand */\n.handwrap{flex:0 0 auto;padding:6px 10px calc(12px + env(safe-area-inset-bottom))}\n.hlabel{font-size:10px;letter-spacing:.14em;color:var(--mut);font-weight:800;padding:0 8px 6px}\n.hand{display:flex;gap:8px;justify-content:center}\n.hand .hcard{width:17.5%;aspect-ratio:3/4;border-radius:11px;cursor:pointer;transition:transform .15s}\n.hand .hcard.sel{transform:translateY(-10px) scale(1.06)}\n.hand .hcard.sel .card{border-color:var(--gold);box-shadow:0 6px 18px rgba(255,210,63,.25)}\n.pilebox{flex:1;border:1.5px solid var(--line);border-radius:14px;padding:10px 8px;cursor:pointer;background:rgba(19,26,19,.6);transition:border-color .2s,box-shadow .2s}\n.pilebox:active{border-color:var(--gold)}\n.pilebox .ph{font-size:10px;letter-spacing:.14em;color:var(--mut);font-weight:800;text-align:center;margin-bottom:8px}\n.pilebox .prow{display:flex;align-items:center;gap:7px;padding:4px 2px;font-size:12px;font-weight:700}\n.pilebox .prow .e{font-size:18px}\n.pilebox .prow .p{margin-left:auto;color:var(--gold);font-weight:900}\n/* ability toast + log line */\n.toast{position:fixed;left:50%;top:38%;transform:translateX(-50%);background:rgba(10,16,10,.94);border:1px solid var(--line);\n  color:var(--ink);border-radius:12px;padding:9px 16px;font-size:13px;font-weight:700;opacity:0;transition:opacity .25s;pointer-events:none;z-index:40;max-width:86%;text-align:center}\n.toast.on{opacity:1}\n/* overlays */\n.overlay{position:fixed;inset:0;z-index:50;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;\n  background:radial-gradient(120% 90% at 50% 18%,rgba(16,26,16,.85),rgba(6,9,6,.97));padding:26px}\n.overlay.hide{display:none}\n.title{font-size:44px;font-weight:900;letter-spacing:.03em;line-height:1.05;\n  background:linear-gradient(180deg,#8dffb5,#3f9d5f);-webkit-background-clip:text;background-clip:text;color:transparent;\n  filter:drop-shadow(0 0 26px rgba(95,208,138,.3))}\n.subtitle{font-size:14.5px;color:var(--mut);line-height:1.65;margin:16px 0 20px;max-width:310px}\n.subtitle b{color:var(--ink)}\n.big{border:0;border-radius:15px;background:linear-gradient(135deg,#5fd08a,#2f7d4f);color:#04160a;font-weight:900;\n  font-size:16px;padding:15px 34px;margin-top:9px;min-width:240px}\n.big.alt{background:none;border:1.5px solid #2c3a2c;color:var(--mut);font-weight:700}\n.gbnote{margin-top:12px;font-size:11px;color:#4c5c4a;letter-spacing:.08em;font-weight:700}\n.tiny{position:absolute;bottom:calc(14px + env(safe-area-inset-bottom));left:0;right:0;font-size:11px;color:#39433a;text-align:center}\n.result{font-size:15px;line-height:1.7;color:var(--mut)}\n.result b{color:var(--ink)}\n</style></head><body>\n\n<div class=\"top\">\n  <span class=\"pname foe\" id=\"foeName\">KEEPER</span><span class=\"sp\"></span><span class=\"pname you\">YOU</span>\n</div>\n<div class=\"scorebar\"><i class=\"s0\" id=\"s0bar\" style=\"width:50%\"></i><i class=\"s1\" id=\"s1bar\" style=\"width:50%\"></i></div>\n<div class=\"scores\"><span id=\"s0v\" style=\"color:var(--p0)\">0</span><span id=\"s1v\" style=\"color:var(--p1)\">0</span></div>\n\n<div id=\"stage\"><div class=\"grid\" id=\"grid\"></div></div>\n\n<div class=\"handwrap\">\n  <div class=\"hlabel\" id=\"handHint\">YOUR HAND — pick a creature, then a glowing spot</div>\n  <div class=\"hand\" id=\"hand\"></div>\n</div>\n<div class=\"toast\" id=\"toast\"></div>\n\n<div class=\"overlay\" id=\"start\">\n  <div class=\"title\">WILDROOT</div>\n  <div class=\"subtitle\">One wild grid, two keepers. <b>Every creature you plant can eat, feed, or shield its neighbours</b> — grow the mightier ecosystem before the ground runs out.</div>\n  <button class=\"big\" id=\"startBtn\">Take root</button>\n  <div class=\"gbnote\">GREY-BOX PROTOTYPE · emoji stand in for painted creatures</div>\n  <div class=\"tiny\">A MyLLMos mini-game · everything runs on your device</div>\n</div>\n\n<div class=\"overlay hide\" id=\"draft\" style=\"justify-content:flex-start;padding-top:calc(44px + env(safe-area-inset-top))\">\n  <div class=\"title\" style=\"font-size:24px\">THE KEEPER<br>CUTS THE GROVE</div>\n  <div class=\"subtitle\" style=\"margin:10px 0 12px\">Two halves of one wild grove. <b>Choose yours</b> — the keeper takes the other, and plants first.</div>\n  <div id=\"pileWrap\" style=\"display:flex;gap:10px;width:min(94vw,430px)\">\n    <div class=\"pilebox\" id=\"pile0\"></div>\n    <div class=\"pilebox\" id=\"pile1\"></div>\n  </div>\n</div>\n\n<div class=\"overlay hide\" id=\"over\">\n  <div class=\"title\" id=\"overTitle\" style=\"font-size:36px\">THE GROVE<br>IS YOURS</div>\n  <div class=\"subtitle result\" id=\"overStats\"></div>\n  <button class=\"big\" id=\"againBtn\">Grow again</button>\n</div>\n\n<script>\n\"use strict\";\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nfunction el(i){return document.getElementById(i)}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k||'light')}catch(e){}}\n\n/* ============================ SPECIES ============================\n   tag food chain: PLANT < GRAZER < HUNTER < APEX. FUNGUS eats nothing —\n   it grows on death. Abilities are the design space; emoji are grey-box art. */\nvar SPECIES=[\n {id:'sunpetal', name:'Sunpetal',     tag:'PLANT', pw:2, emo:'🌻', ab:'bloom',  abTx:'Adjacent allied plants +1'},\n {id:'thornbark',name:'Thornbark',    tag:'PLANT', pw:2, emo:'🌵', ab:'armor',  abTx:'Grazers cannot eat it'},\n {id:'moonfern', name:'Moonfern',     tag:'PLANT', pw:2, emo:'🌿', ab:'lush',   abTx:'On remains: +3 instead of +1'},\n {id:'mosshare', name:'Moss Hare',    tag:'GRAZER',pw:3, emo:'🐇', ab:'fed',    abTx:'+1 per adjacent allied plant'},\n {id:'riverelk', name:'River Elk',    tag:'GRAZER',pw:3, emo:'🦌', ab:null,     abTx:'Sturdy and plain'},\n {id:'emberbeetle',name:'Ember Beetle',tag:'GRAZER',pw:3,emo:'🪲', ab:'toxic',  abTx:'Its eater loses 2'},\n {id:'ashwolf',  name:'Ash Wolf',     tag:'HUNTER',pw:4, emo:'🐺', ab:'pack',   abTx:'+1 per adjacent allied hunter'},\n {id:'marshlynx',name:'Marsh Lynx',   tag:'HUNTER',pw:4, emo:'🐈‍⬛', ab:'pounce', abTx:'Counts +2 power when eating'},\n {id:'skytyrant',name:'Sky Tyrant',   tag:'APEX',  pw:5, emo:'🦅', ab:'lone',   abTx:'-1 per adjacent ally'},\n {id:'gravecap', name:'Gravecap',     tag:'FUNGUS',pw:2, emo:'🍄', ab:'scav',   abTx:'+2 whenever a neighbour dies'}\n];\nvar BYID={};SPECIES.forEach(function(s){BYID[s.id]=s});\nvar EATS={PLANT:[],GRAZER:['PLANT'],HUNTER:['GRAZER'],APEX:['HUNTER'],FUNGUS:[]};\nvar NB=[[1,3],[0,2,4],[1,5],[0,4,6],[1,3,5,7],[2,4,8],[3,7],[4,6,8],[5,7]];\n\n/* ============================ ENGINE (pure) ============================ */\n/* Divide-and-choose: one keeper SPLITS the grove into two piles of five, the\n   other CHOOSES which pile to keep. The splitter is incentivised to cut\n   evenly — fairness is built into the rule, not tuned into the numbers.\n   The splitter plants first (the chooser already got the pick). */\nfunction newMatch(seed,splitter){\n  var g={board:[],remains:[],hands:[[],[]],biomass:[0,0],turn:0,over:false,log:[],seed:seed||1234,\n         phase:'split',splitter:splitter||0,piles:null};\n  for(var i=0;i<9;i++){g.board.push(null);g.remains.push(false);}\n  return g;\n}\nfunction setSplit(g,pileA){ /* pileA: array of 5 species ids; rest form pile B */\n  if(g.phase!=='split')return;\n  var rest=SPECIES.map(function(s){return s.id}).filter(function(id){return pileA.indexOf(id)<0});\n  g.piles=[pileA.slice(),rest];\n  g.phase='choose';\n}\nfunction choosePile(g,idx){\n  if(g.phase!=='choose')return;\n  var chooser=1-g.splitter;\n  g.hands[chooser]=g.piles[idx].slice();\n  g.hands[g.splitter]=g.piles[1-idx].slice();\n  g.phase='play';g.turn=g.splitter;\n}\nfunction rnd(g){g.seed=(g.seed*1664525+1013904223)>>>0;return g.seed/4294967296}\nfunction clone(g){return JSON.parse(JSON.stringify(g))}\nfunction legalMoves(g){\n  var mv=[];if(g.over||g.phase!=='play')return mv;\n  var hand=g.hands[g.turn];\n  for(var h=0;h<hand.length;h++)for(var s=0;s<9;s++)if(!g.board[s])mv.push({h:h,s:s});\n  return mv;\n}\nfunction place(g,mv){\n  var p=g.turn,sp=BYID[g.hands[p][mv.h]],ev=[];\n  g.hands[p].splice(mv.h,1);\n  var pw=sp.pw;\n  /* remains nourish whoever plants on them */\n  if(g.remains[mv.s]){pw+=(sp.ab==='lush')?3:1;g.remains[mv.s]=false;ev.push({t:'nourish',s:mv.s});}\n  var unit={sp:sp.id,owner:p,pw:pw};\n  g.board[mv.s]=unit;\n  /* --- predation: eat every weaker neighbour in this creature's diet --- */\n  var bite=(sp.ab==='pounce')?2:0;\n  NB[mv.s].forEach(function(n){\n    var v=g.board[n];if(!v)return;\n    if(v.owner===p)return;             // never eats allies — no self-farming\n    var vsp=BYID[v.sp];\n    if(EATS[sp.tag].indexOf(vsp.tag)<0)return;\n    if(vsp.ab==='armor'&&sp.tag==='GRAZER')return;\n    if(v.pw>=unit.pw+bite)return;\n    /* eaten */\n    g.board[n]=null;g.remains[n]=true;\n    g.biomass[p]+=v.pw;unit.pw+=1;\n    ev.push({t:'eat',s:mv.s,n:n,prey:v.sp,preyOwner:v.owner});\n    if(vsp.ab==='toxic'){unit.pw=Math.max(1,unit.pw-2);ev.push({t:'toxic',s:mv.s});}\n    /* fungi feast on any adjacent death */\n    NB[n].forEach(function(f){\n      var fu=g.board[f];\n      if(fu&&BYID[fu.sp].ab==='scav'){fu.pw+=2;ev.push({t:'scav',s:f});}\n    });\n  });\n  /* --- symbiosis --- */\n  if(sp.ab==='bloom')NB[mv.s].forEach(function(n){var v=g.board[n];\n    if(v&&v.owner===p&&BYID[v.sp].tag==='PLANT'){v.pw+=1;ev.push({t:'bloom',s:n});}});\n  if(sp.ab==='fed'){var plants=0;NB[mv.s].forEach(function(n){var v=g.board[n];\n    if(v&&v.owner===p&&BYID[v.sp].tag==='PLANT')plants++;});\n    if(plants){unit.pw+=plants;ev.push({t:'fed',s:mv.s,n:plants});}}\n  if(sp.ab==='pack'){var mates=0;NB[mv.s].forEach(function(n){var v=g.board[n];\n    if(v&&v.owner===p&&BYID[v.sp].tag==='HUNTER')mates++;});\n    if(mates){unit.pw+=mates;ev.push({t:'pack',s:mv.s,n:mates});}}\n  if(sp.ab==='lone'){var allies=0;NB[mv.s].forEach(function(n){var v=g.board[n];\n    if(v&&v.owner===p)allies++;});\n    if(allies){unit.pw=Math.max(1,unit.pw-allies);ev.push({t:'lone',s:mv.s,n:allies});}}\n  g.log.push({p:p,sp:sp.id,s:mv.s,ev:ev});\n  /* end conditions: ground full, or both keepers out of cards */\n  var full=g.board.every(function(b){return b});\n  var empty=g.hands[0].length===0&&g.hands[1].length===0;\n  var nextHasCards=g.hands[1-p].length>0;\n  if(full||empty)g.over=true;\n  else g.turn=nextHasCards?1-p:p;\n  return ev;\n}\nfunction score(g){\n  var s=[g.biomass[0],g.biomass[1]];\n  g.board.forEach(function(v){if(v)s[v.owner]+=v.pw});\n  return s;\n}\n\n/* ============================ BOTS ============================ */\nvar AB_VAL={bloom:1.5,armor:1,lush:1,fed:.5,pack:1,pounce:1.5,lone:-1,scav:1.5,toxic:.5};\nfunction draftValue(id){var s=BYID[id];\n  var v=s.pw+(AB_VAL[s.ab]||0);\n  if(EATS[s.tag].length&&s.tag==='APEX')v+=2.5;   // nothing eats an apex — priced in\n  return v;\n}\nfunction pileValue(ids){return ids.reduce(function(a,id){return a+draftValue(id)},0)}\nfunction botSplit(g){ /* enumerate all 252 cuts, take the most even one */\n  var ids=SPECIES.map(function(s){return s.id}),best=null,bd=1e9;\n  for(var m=0;m<1024;m++){\n    if(popcount(m)!==5)continue;\n    var a=[],b=[];\n    for(var i=0;i<10;i++)((m>>i)&1?a:b).push(ids[i]);\n    var d=Math.abs(pileValue(a)-pileValue(b))+rnd(g)*.001;\n    if(d<bd){bd=d;best=a;}\n  }\n  return best;\n}\nfunction popcount(n){var c=0;while(n){c+=n&1;n>>=1}return c}\nfunction botChoose(g){return pileValue(g.piles[0])>=pileValue(g.piles[1])?0:1}\nfunction botRandom(g){var mv=legalMoves(g);return mv[Math.floor(rnd(g)*mv.length)]}\nfunction evalFor(g,p){var s=score(g);return s[p]-s[1-p]}\nfunction botGreedy(g){\n  var best=null,bv=-1e9,me=g.turn;\n  legalMoves(g).forEach(function(mv){\n    var c=clone(g);place(c,mv);\n    var v=evalFor(c,me)+rnd(g)*.01;\n    if(v>bv){bv=v;best=mv;}\n  });\n  return best;\n}\nfunction botDeep(g){ /* 2-ply: my move vs opponent's best greedy reply */\n  var best=null,bv=-1e9,me=g.turn;\n  legalMoves(g).forEach(function(mv){\n    var c=clone(g);place(c,mv);\n    var v;\n    if(c.over||c.turn===me){v=evalFor(c,me);}\n    else{\n      var worst=1e9;\n      legalMoves(c).forEach(function(om){\n        var c2=clone(c);place(c2,om);\n        var ov=evalFor(c2,me);\n        if(ov<worst)worst=ov;\n      });\n      v=worst===1e9?evalFor(c,me):worst;\n    }\n    v+=rnd(g)*.01;\n    if(v>bv){bv=v;best=mv;}\n  });\n  return best;\n}\n\n/* ============================ UI ============================ */\nvar G=null,selHand=-1,busy=false,wins=0,games=0;\nvar TAGEMO={PLANT:'🌱',GRAZER:'🌾',HUNTER:'🐾',APEX:'👑',FUNGUS:'💀'};\nfunction cardHTML(spId,owner,pw,base){\n  var s=BYID[spId];\n  var bump=pw>s.pw?' bumped':'';\n  return '<div class=\"card '+(owner===0?'own':'foe')+bump+'\">'+\n    '<span class=\"tag\">'+s.tag+'</span><span class=\"pw\">'+pw+'</span>'+\n    '<div class=\"art\">'+s.emo+'</div><div class=\"nm\">'+s.name+'</div></div>';\n}\nfunction renderBoard(hl){\n  var grid=el('grid');grid.innerHTML='';\n  for(var i=0;i<9;i++){\n    var c=document.createElement('div');\n    var v=G.board[i];\n    if(v){c.className='cell';c.innerHTML=cardHTML(v.sp,v.owner,v.pw);}\n    else{\n      c.className='cell open'+((selHand>=0&&!busy&&G.turn===0)?' can':'');\n      if(G.remains[i])c.innerHTML='<span class=\"remains\">🍂</span><span class=\"rlabel\">REMAINS +1</span>';\n      (function(slot){c.onclick=function(){tapCell(slot)}})(i);\n    }\n    if(hl&&hl.indexOf(i)>=0)c.firstChild&&c.firstChild.classList&&c.firstChild.classList.add('hit');\n    grid.appendChild(c);\n  }\n  var s=score(G);\n  var tot=Math.max(1,s[0]+s[1]);\n  el('s0bar').style.width=(s[0]/tot*100)+'%';\n  el('s1bar').style.width=(s[1]/tot*100)+'%';\n  el('s0v').textContent=s[0]+(G.biomass[0]?' ('+G.biomass[0]+' eaten)':'');\n  el('s1v').textContent=s[1]+(G.biomass[1]?' ('+G.biomass[1]+' eaten)':'');\n}\nfunction renderHand(){\n  var h=el('hand');h.innerHTML='';\n  G.hands[0].forEach(function(id,i){\n    var d=document.createElement('div');\n    d.className='hcard'+(i===selHand?' sel':'');\n    d.innerHTML=cardHTML(id,0,BYID[id].pw);\n    d.onclick=function(){\n      selHand=(selHand===i)?-1:i;\n      el('handHint').textContent=selHand>=0?BYID[id].abTx.toUpperCase()+' — now pick a glowing spot':'YOUR HAND — pick a creature, then a glowing spot';\n      renderHand();renderBoard();haptic('selection');\n    };\n    h.appendChild(d);\n  });\n}\nvar toastT=null;\nfunction toast(t){var x=el('toast');x.textContent=t;x.classList.add('on');\n  clearTimeout(toastT);toastT=setTimeout(function(){x.classList.remove('on')},1400)}\nfunction narrate(ev){\n  var eats=ev.filter(function(e){return e.t==='eat'});\n  if(eats.length)toast((eats.length>1?eats.length+' creatures':BYID[eats[0].prey].name)+' devoured! 🍂');\n  else{\n    var e=ev.find(function(x){return ['bloom','fed','pack','scav','nourish','lone','toxic'].indexOf(x.t)>=0});\n    if(e){var tx={bloom:'The plants bloom 🌸',fed:'Well fed +'+e.n,pack:'The pack gathers +'+e.n,\n      scav:'The fungus feasts +2',nourish:'Rooted in remains +1',lone:'Too crowded −'+e.n,toxic:'Poisoned! −2'}[e.t];\n      if(tx)toast(tx);}\n  }\n}\nfunction tapCell(slot){\n  if(busy||G.over||G.turn!==0||selHand<0||G.board[slot])return;\n  busy=true;\n  var ev=place(G,{h:selHand,s:slot});\n  selHand=-1;\n  el('handHint').textContent='YOUR HAND — pick a creature, then a glowing spot';\n  renderHand();renderBoard(ev.filter(function(e){return e.t==='eat'}).map(function(e){return e.n}));\n  narrate(ev);haptic(ev.some(function(e){return e.t==='eat'})?'success':'light');\n  setTimeout(aiTurn,900);\n}\nfunction aiTurn(){\n  if(G.over){busy=false;endMatch();return;}\n  if(G.turn!==0){\n    var mv=botDeep(G);\n    if(mv){\n      var ev=place(G,mv);\n      renderBoard(ev.filter(function(e){return e.t==='eat'}).map(function(e){return e.n}));\n      renderHand();narrate(ev);\n    }\n    if(G.over){busy=false;endMatch();return;}\n    if(G.turn!==0){setTimeout(aiTurn,700);return;}\n  }\n  busy=false;\n  if(G.over)endMatch();\n}\nfunction endMatch(){\n  var s=score(G);games++;\n  var won=s[0]>s[1],draw=s[0]===s[1];\n  if(won)wins++;\n  store.setItem('wildroot.record',wins+'/'+games);\n  el('overTitle').innerHTML=draw?'THE GROVE<br>SHARED':(won?'THE GROVE<br>IS YOURS':'THE KEEPER<br>PREVAILS');\n  el('overTitle').style.background=won?'':'linear-gradient(180deg,#e0965a,#9d5f2f)';\n  el('overStats').innerHTML='You <b>'+s[0]+'</b> · Keeper <b>'+s[1]+'</b><br>'+\n    'Eaten: you '+G.biomass[0]+' · keeper '+G.biomass[1]+'<br>Record <b>'+wins+' / '+games+'</b>';\n  setTimeout(function(){el('over').classList.remove('hide')},700);\n  haptic(won?'success':'warning');\n}\nfunction renderPiles(){\n  [0,1].forEach(function(pi){\n    var box=el('pile'+pi);\n    box.innerHTML='<div class=\"ph\">'+(pi===0?'FIRST CUT':'SECOND CUT')+'</div>'+\n      G.piles[pi].map(function(id){var s=BYID[id];\n        return '<div class=\"prow\"><span class=\"e\">'+s.emo+'</span>'+s.name+'<span class=\"p\">'+s.pw+'</span></div>';\n      }).join('');\n    box.onclick=function(){\n      choosePile(G,pi);haptic('success');\n      toast('The keeper takes the other half — and plants first');\n      beginPlay();\n    };\n  });\n}\nfunction beginPlay(){\n  el('draft').classList.add('hide');\n  renderBoard();renderHand();\n  if(G.turn!==0){busy=true;setTimeout(aiTurn,800);}\n}\nfunction startMatch(){\n  /* the KEEPER always splits; you always choose — the flattering seat */\n  G=newMatch(Date.now()>>>0,1);selHand=-1;busy=false;\n  setSplit(G,botSplit(G));\n  el('start').classList.add('hide');el('over').classList.add('hide');\n  el('draft').classList.remove('hide');\n  renderPiles();haptic('success');\n}\nel('startBtn').onclick=startMatch;\nel('againBtn').onclick=startMatch;\nstore.getItem('wildroot.record').then(function(v){\n  if(v){var m=String(v).split('/');wins=+m[0]||0;games=+m[1]||0;}\n});\n</script>\n</body></html>\n"}