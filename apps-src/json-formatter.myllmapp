{"name": "JSON Formatter", "html": "<!doctype html>\n<!--\n  JSON Formatter — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>JSON Formatter</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"7aef683605\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); --h:145;\n  --key:#0a6fd6; --str:#c93b6b; --num:#9a6f00; --bool:#7b3ff2; --nul:#8a8a8e; --ok:#1f9d55; --bad:#e5342f; }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24);\n  --key:#5ac8fa; --str:#ff7ab2; --num:#ffd479; --bool:#bf9cff; --nul:#8e8e93; --ok:#34c759; --bad:#ff5a52; } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.96); }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 44%), hsl(calc(var(--h) + 40) 58% 26%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; min-width:0; }\n  .lbl{ display:flex; align-items:center; gap:8px; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:0 2px 8px; min-height:26px; }\n  .lbl .sp{ flex:1; }\n  textarea{ display:block; width:100%; height:170px; padding:12px; border:1px solid var(--line); border-radius:12px;\n    font:16px/1.45 ui-monospace,Menlo,monospace; background:var(--bg); color:var(--ink); resize:vertical; outline:none;\n    -webkit-user-select:text; user-select:text; }\n  textarea:focus{ border-color:var(--acc); }\n  .bar{ display:flex; gap:8px; flex-wrap:wrap; margin-top:10px; align-items:center; }\n  .btn{ min-height:44px; border:1px solid var(--line); background:var(--bg); border-radius:12px; padding:0 13px; font-size:14.5px; font-weight:700;\n    display:inline-flex; align-items:center; justify-content:center; gap:6px; }\n  .btn.pri{ background:var(--acc); border-color:var(--acc); color:#fff; }\n  .indent{ margin-left:auto; display:flex; align-items:center; gap:8px; font-size:13px; font-weight:650; color:var(--muted); }\n  select{ min-height:40px; border:1px solid var(--line); border-radius:10px; padding:0 10px; background:var(--bg); color:var(--ink); font:inherit; font-size:15px; }\n\n  .badge{ display:inline-flex; align-items:center; gap:5px; border-radius:99px; padding:3px 9px 3px 7px; font-size:11.5px; font-weight:800; letter-spacing:.04em; text-transform:uppercase; }\n  .badge svg{ width:13px; height:13px; }\n  .badge.ok{ background:color-mix(in srgb, var(--ok) 16%, transparent); color:var(--ok); }\n  .badge.err{ background:color-mix(in srgb, var(--bad) 16%, transparent); color:var(--bad); }\n  .meta{ font-size:12px; font-weight:600; letter-spacing:0; text-transform:none; color:var(--muted); font-variant-numeric:tabular-nums; }\n  #msg{ font-size:13.5px; line-height:1.45; min-height:0; margin:0 2px 8px; }\n  #msg:empty{ display:none; }\n  #msg.err{ color:var(--bad); } #msg.ok{ color:var(--ok); }\n  pre{ margin:0; padding:13px; border:1px solid var(--line); border-radius:12px; background:var(--bg); font:14px/1.5 ui-monospace,Menlo,monospace;\n    overflow:auto; white-space:pre; -webkit-user-select:text; user-select:text; min-height:120px; max-height:60vh; }\n  pre:empty::before{ content:\"Beautified JSON appears here.\"; color:var(--muted); font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); font-size:14px; }\n  .key{color:var(--key)}.str{color:var(--str)}.num{color:var(--num)}.bool{color:var(--bool)}.nul{color:var(--nul)}\n\n  @media (min-width:700px){\n    body{ max-width:1080px; }\n    .grid{ display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:12px; align-items:start; }\n    textarea{ height:calc(60vh + 26px); }\n  }\n  @media (max-width:360px){ .indent span{ display:none; } }\n  @media (prefers-reduced-motion:reduce){ button:active{ transform:none; } }\n\n/* myllm-fullscreen-v1 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-braces\" viewBox=\"0 0 24 24\"><path d=\"M8.5 3.5a1 1 0 0 1 0 2c-.8 0-1.3.5-1.3 1.4v2.4c0 1.2-.5 2.1-1.3 2.7.8.6 1.3 1.5 1.3 2.7v2.4c0 .9.5 1.4 1.3 1.4a1 1 0 0 1 0 2c-2 0-3.3-1.3-3.3-3.4v-2.4c0-.9-.5-1.4-1.4-1.4a1 1 0 0 1 0-2c.9 0 1.4-.5 1.4-1.4V6.9c0-2.1 1.3-3.4 3.3-3.4zm7 0c2 0 3.3 1.3 3.3 3.4v2.4c0 .9.5 1.4 1.4 1.4a1 1 0 0 1 0 2c-.9 0-1.4.5-1.4 1.4v2.4c0 2.1-1.3 3.4-3.3 3.4a1 1 0 0 1 0-2c.8 0 1.3-.5 1.3-1.4v-2.4c0-1.2.5-2.1 1.3-2.7-.8-.6-1.3-1.5-1.3-2.7V6.9c0-.9-.5-1.4-1.3-1.4a1 1 0 0 1 0-2z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-spark\" viewBox=\"0 0 24 24\"><path d=\"M10 2.5l1.9 5.6 5.6 1.9-5.6 1.9L10 17.5l-1.9-5.6L2.5 10l5.6-1.9zM18.5 14l.95 2.55L22 17.5l-2.55.95L18.5 21l-.95-2.55L15 17.5l2.55-.95z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-min\" viewBox=\"0 0 24 24\"><path d=\"M4 12h16M8 7.5L4 12l4 4.5M16 7.5l4 4.5-4 4.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-copy\" viewBox=\"0 0 24 24\"><path d=\"M9 3h9.5A2.5 2.5 0 0 1 21 5.5V15a2.5 2.5 0 0 1-2.5 2.5H17v1A2.5 2.5 0 0 1 14.5 21h-9A2.5 2.5 0 0 1 3 18.5v-9A2.5 2.5 0 0 1 5.5 7h1V5.5A2.5 2.5 0 0 1 9 3zm0 2a.5.5 0 0 0-.5.5V15c0 .3.2.5.5.5h9.5c.3 0 .5-.2.5-.5V5.5a.5.5 0 0 0-.5-.5zM6.5 9h-1a.5.5 0 0 0-.5.5v9c0 .3.2.5.5.5h9c.3 0 .5-.2.5-.5v-1H9a2.5 2.5 0 0 1-2.5-2.5z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M5 12.6l4.6 4.6L19.2 7.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-bad\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5a9.5 9.5 0 1 1 0 19 9.5 9.5 0 0 1 0-19zm0 5a1.2 1.2 0 0 0-1.2 1.2v4.2a1.2 1.2 0 0 0 2.4 0V8.7A1.2 1.2 0 0 0 12 7.5zm0 8.3a1.35 1.35 0 1 0 0 2.7 1.35 1.35 0 0 0 0-2.7z\" fill=\"currentColor\"/></symbol>\n</defs></svg>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-braces\"/></svg></div>\n  <div class=\"ht\"><h1>JSON Formatter</h1><p>Beautify, minify and validate JSON — fully offline, nothing leaves your device.</p></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close JSON Formatter\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n\n<div class=\"grid\">\n  <div class=\"card\">\n    <div class=\"lbl\">Input</div>\n    <textarea id=\"in\" placeholder='Paste JSON here, e.g. {\"hello\":\"world\",\"items\":[1,2,3]}' autocapitalize=\"off\" autocorrect=\"off\" spellcheck=\"false\"></textarea>\n    <div class=\"bar\">\n      <button class=\"btn pri\" type=\"button\" onclick=\"format()\"><svg class=\"i\"><use href=\"#i-spark\"/></svg>Beautify</button>\n      <button class=\"btn\" type=\"button\" onclick=\"minify()\"><svg class=\"i\"><use href=\"#i-min\"/></svg>Minify</button>\n      <button class=\"btn\" type=\"button\" onclick=\"clearAll()\" aria-label=\"Clear\"><svg class=\"i\"><use href=\"#i-x\"/></svg>Clear</button>\n      <label class=\"indent\"><span>Indent</span>\n        <select id=\"indent\"><option value=\"2\">2</option><option value=\"4\">4</option><option value=\"\\t\">Tab</option></select>\n      </label>\n    </div>\n  </div>\n  <div class=\"card\">\n    <div class=\"lbl\">Output <span id=\"state\"></span><span class=\"sp\"></span>\n      <button class=\"btn\" type=\"button\" onclick=\"copyOut()\" style=\"min-height:36px;padding:0 11px;font-size:13.5px;letter-spacing:0;text-transform:none;color:var(--ink)\"><svg class=\"i\"><use href=\"#i-copy\"/></svg>Copy</button>\n    </div>\n    <div id=\"msg\"></div>\n    <pre id=\"out\"></pre>\n  </div>\n</div>\n<script>\n/* The bridge is looked up when used, never kept: MyLLM can add it after this\n   script has run. */\nfunction store(){return window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}}}\nvar lastOut='';\nfunction el(i){return document.getElementById(i)}\nfunction esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}\nfunction msg(t,cls){var m=el('msg');m.textContent=t||'';m.className=cls||''}\n/* valid / invalid badge in the output header, with the size line beside it */\nfunction state(kind,meta){\n  var s=el('state');\n  if(!kind){s.innerHTML='';return}\n  s.innerHTML=kind==='ok'\n    ?'<span class=\"badge ok\"><svg><use href=\"#i-check\"/></svg>Valid</span>'+(meta?' <span class=\"meta\">'+esc(meta)+'</span>':'')\n    :'<span class=\"badge err\"><svg><use href=\"#i-bad\"/></svg>Invalid</span>';\n}\n\nfunction parseInput(){\n  var raw=el('in').value;\n  store().setItem('json',raw);\n  if(!raw.trim()){msg('');state('');el('out').innerHTML='';lastOut='';return null}\n  try{return {ok:true,val:JSON.parse(raw)}}\n  catch(e){return {ok:false,err:e,raw:raw}}\n}\nfunction showError(r){\n  el('out').innerHTML='';lastOut='';\n  var m=String(r.err.message||r.err);\n  var pos=m.match(/position\\s+(\\d+)/);\n  state('err');\n  if(pos){var i=+pos[1],before=r.raw.slice(0,i),line=before.split('\\n').length,col=i-before.lastIndexOf('\\n');\n    msg('Line '+line+', column '+col+': '+m,'err');}\n  else msg(m,'err');\n  if(window.myllmHaptic)myllmHaptic('error');\n}\nfunction render(text){\n  lastOut=text;el('out').innerHTML=highlight(text);\n  var bytes=new Blob([text]).size;\n  msg('');state('ok',text.split('\\n').length+' lines · '+bytes+' bytes');\n  if(window.myllmHaptic)myllmHaptic('light');\n}\nfunction format(){\n  var r=parseInput();if(!r)return;if(!r.ok)return showError(r);\n  var ind=el('indent').value;render(JSON.stringify(r.val,null,ind==='\\\\t'?'\\t':parseInt(ind,10)));\n}\nfunction minify(){var r=parseInput();if(!r)return;if(!r.ok)return showError(r);render(JSON.stringify(r.val))}\nfunction clearAll(){el('in').value='';store().setItem('json','');msg('');state('');el('out').innerHTML='';lastOut=''}\nfunction copyOut(){\n  if(!lastOut){msg('Nothing to copy yet — Beautify or Minify first.','');return}\n  var done=function(){msg('Copied to clipboard','ok')};\n  if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(lastOut).then(done,function(){fallbackCopy()});\n  else fallbackCopy();\n  function fallbackCopy(){if(window.myllmShare){myllmShare(lastOut);msg('Opened the share sheet','ok')}else msg('Copy unavailable on this version.','')}\n}\nfunction highlight(json){\n  json=json.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n  return json.replace(/(\"(\\\\u[a-zA-Z0-9]{4}|\\\\[^u]|[^\\\\\"])*\"(\\s*:)?|\\b(true|false)\\b|\\bnull\\b|-?\\d+(?:\\.\\d*)?(?:[eE][+\\-]?\\d+)?)/g,function(m){\n    var cls='num';\n    if(/^\"/.test(m))cls=/:$/.test(m)?'key':'str';\n    else if(/true|false/.test(m))cls='bool';\n    else if(/null/.test(m))cls='nul';\n    return '<span class=\"'+cls+'\">'+m+'</span>';\n  });\n}\nel('in').addEventListener('input',function(){if(el('in').value.trim()&&JSONtest())format()});\nfunction JSONtest(){try{JSON.parse(el('in').value);return true}catch(e){msg('');state('');el('out').innerHTML='';return false}}\nstore().getItem('json').then(function(v){if(v){el('in').value=v;if(v.trim())format()}});\n\n/* myllm-fullscreen-v1 — full screen where MyLLM can also close the app for us (myllmClose,\n   5.6.2+): full screen hides MyLLM's Done, and a page with no way out is\n   worse than a repeated title, so elsewhere nothing changes. The spacer keeps\n   the header clear of the status bar only if the page doesn't already. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  function inset(){\n    var p = document.createElement(\"div\");\n    p.style.cssText = \"position:fixed;top:0;left:0;width:1px;visibility:hidden;height:env(safe-area-inset-top)\";\n    document.body.appendChild(p); var h = p.offsetHeight; p.parentNode.removeChild(p); return h;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = \"0px\";\n    if (!document.body.classList.contains(\"imm\")) return;\n    var need = inset() + 6 - (head.getBoundingClientRect().top + window.scrollY);\n    sp.style.height = Math.max(0, Math.round(need)) + \"px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  window.addEventListener(\"resize\", fit);\n  sync();\n})();\n</script></body></html>\n", "kind": "html", "iconSymbol": "curlybraces", "iconColor": "green"}