{"name": "JSON Formatter", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>:root{color-scheme:light dark;--accent:#30b56a;--key:#0a84ff;--str:#c93b6b;--num:#9a6f00;--bool:#7b3ff2;--nul:#8a8a8e}\n@media(prefers-color-scheme:dark){:root{--key:#5ac8fa;--str:#ff7ab2;--num:#ffd479;--bool:#bf9cff;--nul:#8a8a8e}}\n*{box-sizing:border-box}\nbody{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:16px;background:#f2f2f7;color:#111}\n@media(prefers-color-scheme:dark){body{background:#000;color:#eee}textarea,pre,.bar{background:#1c1c1e;color:#eee;border-color:#3a3a3c}}\nh1{font-size:21px;margin:0 0 4px}\n.sub{font-size:13px;opacity:.6;margin-bottom:12px}\ntextarea{width:100%;height:150px;padding:12px;border:1px solid #d1d1d6;border-radius:11px;font:13px ui-monospace,Menlo,monospace;background:#fff;color:#111;resize:vertical;-webkit-user-select:text;user-select:text}\n.bar{display:flex;gap:7px;flex-wrap:wrap;margin:10px 0}\n.bar button{border:0;background:var(--accent);color:#fff;border-radius:9px;padding:9px 13px;font-size:14px;font-weight:600}\n.bar button.sec{background:#e5e5ea;color:#333}\n@media(prefers-color-scheme:dark){.bar button.sec{background:#2c2c2e;color:#eee}}\n.bar .indent{margin-left:auto;display:flex;align-items:center;gap:6px;font-size:13px;opacity:.7}\n.bar select{border:1px solid #d1d1d6;border-radius:8px;padding:5px 8px;background:#fff;color:#111;font-size:13px}\n@media(prefers-color-scheme:dark){.bar select{background:#1c1c1e;color:#eee;border-color:#3a3a3c}}\n#msg{font-size:13px;min-height:18px;margin-bottom:8px;font-weight:600}\n#msg.ok{color:var(--accent)}#msg.err{color:#ff453a}\npre{margin:0;padding:14px;border:1px solid #d1d1d6;border-radius:11px;background:#fff;font:13px ui-monospace,Menlo,monospace;line-height:1.5;overflow:auto;white-space:pre;-webkit-user-select:text;user-select:text;min-height:60px}\n.key{color:var(--key)}.str{color:var(--str)}.num{color:var(--num)}.bool{color:var(--bool)}.nul{color:var(--nul)}\n</style></head><body>\n<h1>🧩 JSON Formatter</h1>\n<div class=\"sub\">Beautify, minify and validate JSON — fully offline, nothing leaves your device.</div>\n<textarea id=\"in\" placeholder='Paste JSON here, e.g. {\"hello\":\"world\",\"items\":[1,2,3]}' autocapitalize=\"off\" autocorrect=\"off\" spellcheck=\"false\"></textarea>\n<div class=\"bar\">\n  <button onclick=\"format()\">Beautify</button>\n  <button class=\"sec\" onclick=\"minify()\">Minify</button>\n  <button class=\"sec\" onclick=\"copyOut()\">Copy</button>\n  <button class=\"sec\" onclick=\"clearAll()\">Clear</button>\n  <span class=\"indent\">Indent\n    <select id=\"indent\"><option value=\"2\">2</option><option value=\"4\">4</option><option value=\"\\t\">Tab</option></select>\n  </span>\n</div>\n<div id=\"msg\"></div>\n<pre id=\"out\"></pre>\n<script>\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar lastOut='';\nfunction el(i){return document.getElementById(i)}\nfunction msg(t,cls){var m=el('msg');m.textContent=t||'';m.className=cls||''}\n\nfunction parseInput(){\n  var raw=el('in').value;\n  store.setItem('json',raw);\n  if(!raw.trim()){msg('');el('out').innerHTML='';lastOut='';return null}\n  try{return {ok:true,val:JSON.parse(raw)}}\n  catch(e){return {ok:false,err:e,raw:raw}}\n}\nfunction showError(r){\n  el('out').innerHTML='';lastOut='';\n  var m=String(r.err.message||r.err);\n  var pos=m.match(/position\\s+(\\d+)/);\n  if(pos){var i=+pos[1],before=r.raw.slice(0,i),line=before.split('\\n').length,col=i-before.lastIndexOf('\\n');\n    msg('✗ Invalid JSON — line '+line+', column '+col+': '+m,'err');}\n  else msg('✗ Invalid JSON — '+m,'err');\n  if(window.myllmHaptic)myllmHaptic('error');\n}\nfunction render(text){\n  lastOut=text;el('out').innerHTML=highlight(text);\n  var bytes=new Blob([text]).size;\n  msg('✓ Valid JSON · '+text.split('\\n').length+' lines · '+bytes+' bytes','ok');\n  if(window.myllmHaptic)myllmHaptic('light');\n}\nfunction format(){\n  var r=parseInput();if(!r)return;if(!r.ok)return showError(r);\n  var ind=el('indent').value;render(JSON.stringify(r.val,null,ind==='\\\\t'?'\\t':parseInt(ind,10)));\n}\nfunction minify(){var r=parseInput();if(!r)return;if(!r.ok)return showError(r);render(JSON.stringify(r.val))}\nfunction clearAll(){el('in').value='';store.setItem('json','');msg('');el('out').innerHTML='';lastOut=''}\nfunction copyOut(){\n  if(!lastOut){msg('Nothing to copy yet — Beautify or Minify first.','');return}\n  var done=function(){msg('✓ Copied to clipboard','ok')};\n  if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(lastOut).then(done,function(){fallbackCopy()});\n  else fallbackCopy();\n  function fallbackCopy(){if(window.myllmShare){myllmShare(lastOut);msg('✓ Opened share sheet','ok')}else msg('Copy unavailable on this version.','')}\n}\nfunction highlight(json){\n  json=json.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n  return json.replace(/(\"(\\\\u[a-zA-Z0-9]{4}|\\\\[^u]|[^\\\\\"])*\"(\\s*:)?|\\b(true|false)\\b|\\bnull\\b|-?\\d+(?:\\.\\d*)?(?:[eE][+\\-]?\\d+)?)/g,function(m){\n    var cls='num';\n    if(/^\"/.test(m))cls=/:$/.test(m)?'key':'str';\n    else if(/true|false/.test(m))cls='bool';\n    else if(/null/.test(m))cls='nul';\n    return '<span class=\"'+cls+'\">'+m+'</span>';\n  });\n}\nel('in').addEventListener('input',function(){if(el('in').value.trim()&&JSONtest())format()});\nfunction JSONtest(){try{JSON.parse(el('in').value);return true}catch(e){msg('');el('out').innerHTML='';return false}}\nstore.getItem('json').then(function(v){if(v){el('in').value=v;if(v.trim())format()}});\n</script></body></html>\n", "kind": "html", "iconSymbol": "curlybraces", "iconColor": "green"}