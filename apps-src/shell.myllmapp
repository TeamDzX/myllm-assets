{"name": "Shell", "kind": "html", "iconSymbol": "terminal", "iconColor": "gray", "html": "<!doctype html>\n<!--\n  Shell — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Shell</title>\n<style>\n  *{box-sizing:border-box}\n  body{margin:0;background:#0d1117;color:#d6deeb;\n       font:13.5px/1.55 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;\n       display:flex;flex-direction:column;height:100dvh;overflow:hidden}\n  /* phone on its side: keep clear of the notch and the rounded corners */\n  body{padding-left:env(safe-area-inset-left);padding-right:env(safe-area-inset-right)}\n  header{padding:10px 14px;border-bottom:1px solid #1e2733;display:flex;align-items:center;gap:10px}\n  header b{font-size:14px;color:#e7eef8;font-weight:650}\n  header .hint{font-size:11.5px;color:#6b7a90}\n  #out{flex:1;overflow:auto;padding:12px 14px 4px;white-space:pre-wrap;word-break:break-word}\n  .cmd{color:#7ee787}\n  .err{color:#ff7b72}\n  .ok{color:#79c0ff}\n  .dim{color:#6b7a90}\n  .dir{color:#79c0ff;font-weight:650}\n  /* The composer, shaped like Claude Code's: one quiet bordered box with a\n     chevron, the text filling it, and a status line underneath. No Run button —\n     Return submits, and a button competing with the prompt is the thing that\n     made this look like a form rather than a terminal. */\n  .composer{padding:0 12px calc(12px + env(safe-area-inset-bottom));background:#0d1117}\n  .composer hr{border:0;border-top:1px solid #1e2733;margin:0 -12px 10px}\n  form{display:flex;gap:9px;align-items:center;background:#0d1117;\n       border:1px solid #2a3646;border-radius:10px;padding:11px 12px}\n  form:focus-within{border-color:#3c5680}\n  .ps1{color:#6b7a90;align-self:center;user-select:none}\n  input{flex:1;min-width:0;background:transparent;border:0;color:#d6deeb;padding:0;\n        font:13.5px ui-monospace,SFMono-Regular,Menlo,monospace}\n  input:focus{outline:none}\n  input::placeholder{color:#3f4c5f}\n  /* One line, always. A status bar that wraps stops reading as a status bar —\n     the left half truncates, the right half is short enough never to. */\n  .statusbar{display:flex;justify-content:space-between;align-items:baseline;gap:12px;\n             padding:8px 3px 0;font-size:11.5px;color:#6b7a90;white-space:nowrap}\n  .statusbar .left{color:#7ee787;overflow:hidden;text-overflow:ellipsis;min-width:0}\n  .statusbar .right{color:#6b7a90;flex:none}\n  .chips{display:flex;gap:6px;overflow-x:auto;padding:0 12px 10px}\n  .chip{background:#111823;border:1px solid #1e2733;color:#9db2cd;border-radius:999px;\n        padding:6px 11px;font-size:12px;white-space:nowrap}\n  .ask{color:#c9a3ff}\n  .step{color:#6b7a90;border-left:2px solid #2d3a4d;padding-left:9px;margin:3px 0}\n  .say{color:#e7eef8;border-left:2px solid #7ee787;padding-left:9px;margin:6px 0 8px;white-space:pre-wrap}\n  .propose{color:#ffb86b;border-left:2px solid #ffb86b;padding-left:9px;margin:6px 0}\n  .ps1{color:#7ee787;align-self:center;white-space:nowrap;max-width:46%;overflow:hidden;text-overflow:ellipsis}\n  /* Tappable paths: a phone has no Tab key, so anything the shell prints that\n     you might type next can be tapped into the prompt instead. */\n  .path{cursor:pointer;text-decoration:underline;text-decoration-style:dotted;text-decoration-color:#3c5680;text-underline-offset:3px}\n  .chip.comp{color:#7ee787;border-color:#2d3a4d}\n  .chip.dirc{color:#79c0ff}\n  .chip.undo{color:#ffb86b}\n  .hit{color:#6b7a90}\n  .hit b{color:#e7eef8;font-weight:650}\n</style><style>:root{--build-id:\"301f85fd18\";}</style>\n</head>\n<body>\n\n<header>\n  <b>Shell</b>\n  <span class=\"hint\">the shared workspace, on the command line</span>\n</header>\n\n<div id=\"out\"></div>\n\n<div class=\"chips\" id=\"chips\"></div>\n\n<div class=\"composer\">\n  <hr>\n  <form id=\"form\" autocomplete=\"off\">\n    <span class=\"ps1\">&#10095;</span>\n    <input id=\"in\" placeholder=\"a command, or a question\" autocapitalize=\"off\" autocorrect=\"off\" spellcheck=\"false\">\n  </form>\n  <div class=\"statusbar\">\n    <span class=\"left\" id=\"statusLeft\">~</span>\n    <span class=\"right\" id=\"statusRight\"></span>\n  </div>\n</div>\n\n<script>\n/* Shell over the MyLLMos shared workspace.\n   The command grammar deliberately MATCHES the assistant's `workspace_shell`\n   tool, so what you learn here is what you can ask MyLLM for in words — and what\n   it prints back to you looks like what it prints back to itself.\n\n   Difference: you are a person at a prompt, so this one can also WRITE. The\n   store itself has no trash and no undo, so this app supplies both: rm moves\n   into a hidden .trash folder, and undo reverses the last change. */\n/* Looked up on each use, never kept: MyLLM can add its bridges after this script has run. */\nObject.defineProperty(window, \"files\", { configurable:true, get:function(){ return window.myllmFiles || null; } });\nvar out = document.getElementById('out');\nvar input = document.getElementById('in');\n/* NOT `history` — that is window.history (the History API), so `var history`\n   silently keeps the built-in and cmdHistory.push is undefined. The runtime\n   harness caught this; a regex scan never would. */\nvar cmdHistory = [];\nvar hIndex = -1;\nvar pending = null;      /* a confirmation waiting on y/n */\nvar cwd = '';            /* current directory, '' = workspace root */\nvar TRASH = '.trash';    /* where rm puts things; hidden from ls unless -a or you cd into it */\nvar undoStack = [];      /* this session's reversible changes, newest last */\nvar lastSnap = null;     /* most recent listing, for completion chips */\nvar stdin = null;        /* text piped into the next stage of a pipeline */\nvar aliases = {};        /* name -> expansion, kept in myllmStorage */\nObject.defineProperty(window, \"store\", { configurable:true, get:function(){ return window.myllmStorage || null; } });\nvar HISTORY_KEY = 'shell.history', ALIAS_KEY = 'shell.aliases';\n/* v9: the change log, the undo stack and path bookmarks survive closing the\n   app. Before, undo forgot everything the moment Shell was closed. */\nvar LOG_KEY = 'shell.log', UNDO_KEY = 'shell.undo', MARK_KEY = 'shell.marks';\nvar changeLog = [];      /* [{id, t, text}] newest last, the last 200 */\nvar marks = {};          /* bookmark name -> path, used as @name */\nvar prevCwd = null;      /* for  cd -  */\nvar batchId = null;      /* set while an approved batch runs, so undo reverses all of it */\nvar RC = '.shellrc';     /* optional startup script, in the workspace root */\nvar ASK_MAX = 8000;      /* how much material one `ask` may carry; a small on-device model has a small window */\nvar VERBS = ['ls','tree','cat','head','tail','sed','stat','find','grep','diff','jq','wc','sort','uniq','cut','history','du','ask','dictate','open','share','mkdir','mv','cp','write','replace','edit','rm','rmdir','undo','log','revert','trash','restore','alias','unalias','mark','cd','pwd','clear','help'];\nvar KNOWN = VERBS.concat(['dir']);   /* everything the switch below answers to */\nfunction inTrash(path){ return path === TRASH || path.indexOf(TRASH + '/') === 0; }\n\n/* The APP may be stateful — you are standing somewhere. The assistant's\n   workspace_shell tool deliberately is NOT: state that persists between tool\n   calls is a trap for a model that cannot see the prompt. Same grammar, one\n   extra verb here. */\nfunction resolve(p){\n  var s = String(p||'').trim();\n  /* @name and @name/sub/path: a saved place, so a long path is typed once. */\n  if (s.charAt(0) === '@'){\n    var mSlash = s.indexOf('/'), mName = (mSlash < 0 ? s.slice(1) : s.slice(1, mSlash)).toLowerCase();\n    if (Object.prototype.hasOwnProperty.call(marks, mName)) s = '/' + marks[mName] + (mSlash < 0 ? '' : s.slice(mSlash));\n  }\n  if (!s || s === '.') return cwd;\n  if (s.charAt(0) === '/') return normalise(s);\n  if (s === '..') return cwd.indexOf('/') < 0 ? '' : cwd.slice(0, cwd.lastIndexOf('/'));\n  var joined = cwd ? cwd + '/' + s : s;\n  /* collapse any a/b/../c the model or user typed */\n  var parts = [];\n  normalise(joined).split('/').forEach(function(seg){\n    if (seg === '..') parts.pop(); else if (seg && seg !== '.') parts.push(seg);\n  });\n  return parts.join('/');\n}\nfunction prompt$(){ return cwd ? '~/' + cwd : '~'; }\n\n/* Left: where you are. Right: what the workspace costs. Both refresh after any\n   command, so the bar is a live readout rather than decoration. */\nasync function paintPrompt(){\n  var l = document.getElementById('statusLeft');\n  if (l) l.textContent = prompt$() + (undoStack.length ? '  \\u00b7  undo \\u00d7' + undoStack.length : '');\n  var r = document.getElementById('statusRight');\n  if (r && files){\n    try{\n      var list = (await files.list()).filter(function(f){ return !inTrash(f.path); });\n      var total = list.reduce(function(a,b){ return a + b.size; }, 0);\n      r.textContent = list.length + (list.length === 1 ? ' file' : ' files') + '  \\u00b7  ' + bytes(total);\n    }catch(e){ r.textContent = ''; }\n  }\n}\n\n/* Two lines an entry, not one padded to a column. The old shape assumed a\n   terminal ~78 characters wide; this one is ~44 on a phone, so every line wrapped\n   and the list read as rubble. A command and its description, each on its own\n   line, never wraps raggedly however long the description gets. */\nvar HELP = [\n  ['ls [-R] [path]', 'list a folder (-R for the whole tree)'],\n  ['tree [path]', 'same as ls -R'],\n  ['cat <path>', 'print a file'],\n  ['head [-n N] <path>', 'the first N lines (default 20)'],\n  ['tail [-n N] <path>', 'the last N lines'],\n  ['stat <path>', 'size, modified, type'],\n  ['ls -t / ls -S', 'newest first / biggest first'],\n  ['sed -n 40,80p <path>', 'just lines 40 to 80'],\n  ['find <glob>', 'match filenames, e.g. find *.json'],\n  ['find -mtime -7', 'changed in the last 7 days'],\n  ['find -newer <path>', 'changed since that file'],\n  ['find -size +10k', 'bigger than 10 KB (-type d: folders)'],\n  ['grep <text> [path]', 'search inside files (-l for names)'],\n  ['grep -n -C 2 -v -c', 'numbers, context, non-matches, counts'],\n  ['grep /re?gex/', 'a pattern (or -E); -s matches case'],\n  ['diff <a> <b>', 'what changed between two files'],\n  ['diff <path>@2', 'version 2 against now'],\n  ['jq .a.b <path>', 'pull a value out of JSON'],\n  ['jq \".list[] | .name\"', 'each name in a list (also keys)'],\n  ['wc [-l] <path>', 'count lines, words, characters'],\n  ['sort [-r -n -k N]', 'sort lines (reverse, numbers, field)'],\n  ['uniq [-c]', 'fold repeats, with counts'],\n  ['cut -d , -f 2', 'pick fields (or -c 1-20)'],\n  ['du', 'space used per folder'],\n  '',\n  ['ask \"<question>\"', 'ask MyLLM; pipe a file in to work on it'],\n  ['dictate', 'speak instead of typing'],\n  ['open <path>', 'open the file in another app'],\n  ['share <path>', 'send the file out through iOS'],\n  '',\n  ['a | b', 'send a\\'s output into b'],\n  ['', 'cat, head, tail, grep, ask all read one'],\n  ['> <path>', 'put the output in a file'],\n  ['>> <path>', 'add it to the end of one instead'],\n  '',\n  ['mkdir <path>', 'create a folder'],\n  ['mv <from> <to>', 'move or rename (-f replaces)'],\n  ['write <path> <text>', 'replace a file with that text'],\n  ['replace <p> \"old\" \"new\"', 'swap text in a file (-1: first only)'],\n  ['edit <p> 3-5 \"text\"', 'change lines 3 to 5 (5+ inserts)'],\n  ['cp <from> <to>', 'copy a file or folder (-f replaces)'],\n  ['rm <path>', 'move a file to .trash'],\n  ['rmdir <path>', 'move a folder to .trash'],\n  ['rm -p / rmdir -p', 'delete for good; asks first'],\n  ['undo', 'reverse your last change (or batch)'],\n  ['log', 'recent changes, kept between visits'],\n  ['trash', 'what is in .trash'],\n  ['restore <path>', 'put something back from .trash'],\n  ['trash empty', 'delete all of it for good; asks first'],\n  ['history <path>', 'previous versions of a file'],\n  ['revert <path> [N]', 'put version N back (1 = newest)'],\n  '',\n  ['history', 'the commands you have typed'],\n  ['!!', 'run the last one again'],\n  ['!5   !gr', 'number 5, or the last one starting gr'],\n  ['alias ll \"ls -R\"', 'make a shortcut'],\n  ['alias / unalias ll', 'list them / remove one'],\n  ['.shellrc', 'its lines run when Shell opens'],\n  ['cd <path>', 'change directory (cd .. goes up)'],\n  ['cd -', 'back to the previous folder'],\n  ['mark work', 'save this folder as @work'],\n  ['cd @work   ls @work', 'use it anywhere in a path'],\n  ['mark / mark -d work', 'list them / forget one'],\n  ['ls -a', 'show .trash too'],\n  ['clear', 'clear the screen'],\n  ['help', 'this list'],\n  '',\n  'Anything else is a question for MyLLM. It',\n  'can run the read-only commands above to',\n  'answer, and asks before changing anything,',\n  'showing the diff of any edit it proposes.',\n  '',\n  'Try:',\n  'cat notes.md | ask \"sum this up\" > out.md'\n];\nfunction helpHTML(){\n  return HELP.map(function(row){\n    if (typeof row === 'string') return row ? '<span class=\"dim\">' + esc(row) + '</span>' : '';\n    return '<span class=\"cmd\">' + esc(row[0]) + '</span>\\n<span class=\"dim\">   ' + esc(row[1]) + '</span>';\n  }).join('\\n');\n}\n\n\nfunction esc(s){ return String(s==null?'':s)\n  .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }\n\n/* capture: when set, print() also COLLECTS text — for the agent loop, and for\n   each stage of a pipeline. quiet: and does not put it on screen, which is what\n   makes `cat big.md | ask \"summarise\"` show the summary and not the file. */\nvar capture = null;\nvar quiet = false;\nvar captureHadError = false;   /* did this capture print anything in red? */\nvar lastCaptureError = false;  /* ...read by the caller straight after captureOf */\n\nfunction print(text, cls){\n  if (capture !== null){\n    capture.push(String(text));\n    if (cls === 'err') captureHadError = true;\n  }\n  if (quiet) return;\n  var d = document.createElement('div');\n  if (cls) d.className = cls;\n  d.innerHTML = esc(text);\n  out.appendChild(d);\n  out.scrollTop = out.scrollHeight;\n}\nfunction printHTML(html){\n  if (capture !== null) capture.push(html.replace(/<[^>]+>/g, ''));\n  if (quiet) return;\n  var d = document.createElement('div');\n  d.innerHTML = html;\n  out.appendChild(d);\n  out.scrollTop = out.scrollHeight;\n}\n/* On screen only: never captured, never piped, removable. For \"asking\\u2026\",\n   which belongs to the person watching and not to the file being written. */\nfunction status(text){\n  var d = document.createElement('div');\n  d.className = 'dim'; d.textContent = text;\n  out.appendChild(d); out.scrollTop = out.scrollHeight;\n  return d;\n}\nfunction unstatus(d){ if (d && d.parentNode) d.parentNode.removeChild(d); }\nfunction haptic(k){ try{ window.myllmHaptic && myllmHaptic(k); }catch(e){} }\n\n/* ---------- helpers that mirror the tool ---------- */\n\nfunction tokenize(s){\n  var outv = [], cur = '', q = null;\n  for (var i=0;i<s.length;i++){\n    var c = s[i];\n    if (q){ if (c === q) q = null; else cur += c; }\n    else if (c === '\"' || c === \"'\"){ q = c; }\n    else if (c === ' '){ if (cur){ outv.push(cur); cur = ''; } }\n    else cur += c;\n  }\n  if (cur) outv.push(cur);\n  return outv;\n}\n\nfunction normalise(p){\n  var s = String(p||'').trim();\n  while (s.indexOf('./') === 0) s = s.slice(2);\n  while (s.charAt(0) === '/') s = s.slice(1);\n  while (s.charAt(s.length-1) === '/') s = s.slice(0,-1);\n  return s === '.' ? '' : s;\n}\n\nfunction bytes(n){ return n < 1024 ? n + 'B' : (n/1024).toFixed(1) + 'K'; }\n\n/* ---------- the line, before it is a command ----------\n   A pipeline is split here rather than in run(), so every command stays a\n   command: it reads stdin if there is any, prints as it always did, and knows\n   nothing about where its output is going. */\n\nfunction restOf(line){\n  var t = String(line || '').trim();\n  var sp = t.search(/\\s/);\n  return sp < 0 ? '' : t.slice(sp + 1).trim();\n}\nfunction unquote(s){\n  var t = String(s || '').trim(), a = t.charAt(0);\n  if (t.length > 1 && (a === '\"' || a === \"'\") && t.charAt(t.length - 1) === a) return t.slice(1, -1);\n  return t;\n}\n/* Models fence their output even when told not to; a fence in a saved file is\n   the kind of thing you only notice a week later. */\nfunction stripFence(t){\n  var s2 = String(t || '').trim();\n  if (s2.indexOf('```') !== 0) return s2;\n  s2 = s2.replace(/^```[a-z]*\\s*\\n?/i, '');\n  var end = s2.lastIndexOf('```');\n  return (end >= 0 ? s2.slice(0, end) : s2).trim();\n}\n\n/* `a | b > c` -> { stages:['a','b'], redirect:{path:'c', append:false} }\n   Quotes are respected, so  grep \"a > b\"  is a search and not a redirect. */\nfunction splitPipeline(line){\n  var stages = [], cur = '', q = null, redirect = null;\n  var text = String(line || '');\n  for (var i = 0; i < text.length; i++){\n    var c = text.charAt(i);\n    if (q){ cur += c; if (c === q) q = null; continue; }\n    if (c === '\"' || c === \"'\"){ q = c; cur += c; continue; }\n    if (c === '|'){ stages.push(cur); cur = ''; continue; }\n    if (c === '>'){\n      var append = text.charAt(i + 1) === '>';\n      redirect = { path: unquote(text.slice(i + (append ? 2 : 1)).trim()), append: append };\n      break;\n    }\n    cur += c;\n  }\n  stages.push(cur);\n  stages = stages.map(function(x){ return x.trim(); }).filter(function(x){ return x.length; });\n  return { stages: stages, redirect: redirect };\n}\n\n/* One pass only: an alias that expands to another alias is a loop waiting to\n   happen, and nobody needs two levels on a phone. */\nfunction expandAlias(stage){\n  var first = (tokenize(stage)[0] || '').toLowerCase();\n  if (!Object.prototype.hasOwnProperty.call(aliases, first)) return stage;\n  var rest = restOf(stage);\n  return aliases[first] + (rest ? ' ' + rest : '');\n}\n\n/* Only a line that STARTS with a command is parsed as a pipeline. \"which files\n   are > 1 kB?\" is a sentence, and splitting it on the > would quietly eat it. */\nfunction isCommandLine(line){\n  var first = (tokenize(line)[0] || '').toLowerCase();\n  if (!first) return false;\n  if (first.charAt(0) === '!') return true;\n  return KNOWN.indexOf(first) >= 0 || Object.prototype.hasOwnProperty.call(aliases, first);\n}\n\n/* Every stage read-only, and nothing being written to a file. Both callers run\n   without anyone typing y — the agent, and .shellrc at launch — so a redirect\n   has to count as a mutation here even though every verb in it is read-only. */\nfunction unsafeReason(line, allowed){\n  var pl = splitPipeline(line);\n  if (pl.redirect) return 'writing to a file with > or >> is a change — propose it instead';\n  if (!pl.stages.length) return 'empty command';\n  for (var i = 0; i < pl.stages.length; i++){\n    var v = (tokenize(expandAlias(pl.stages[i]))[0] || '').toLowerCase();\n    if (allowed.indexOf(v) < 0) return 'only ' + allowed.join(', ') + ' may run without asking';\n  }\n  return null;\n}\n\n/* Run something with its output collected instead of (or as well as) shown.\n   Saves and restores, so a pipeline inside the agent loop nests correctly. */\nasync function captureOf(fn, silent){\n  var savedCap = capture, savedQuiet = quiet, savedErr = captureHadError;\n  capture = []; quiet = !!silent; captureHadError = false;\n  try { await fn(); }\n  catch(e){ capture.push('error: ' + (e && e.message || e)); captureHadError = true; }\n  var text = capture.join('\\n');\n  lastCaptureError = captureHadError;\n  capture = savedCap; quiet = savedQuiet; captureHadError = savedErr;\n  return text;\n}\nfunction runner(stage){ return function(){ return run(stage); }; }\n\nfunction mimeFor(name){\n  var n = String(name).toLowerCase(), dot = n.lastIndexOf('.');\n  var ext = dot > 0 ? n.slice(dot + 1) : '';\n  if (ext === 'json') return 'application/json';\n  if (ext === 'csv') return 'text/csv';\n  if (ext === 'html' || ext === 'htm') return 'text/html';\n  if (ext === 'md' || ext === 'markdown') return 'text/markdown';\n  return 'text/plain';\n}\n/* UTF-8 safe: btoa alone mangles anything above ASCII, and notes have accents\n   and em dashes in them. Chunked so a 5 MB file does not blow the stack. */\nfunction dataURL(text, mime){\n  var bs = new TextEncoder().encode(String(text == null ? '' : text));\n  var bin = '', CH = 0x8000;\n  for (var i = 0; i < bs.length; i += CH) bin += String.fromCharCode.apply(null, bs.subarray(i, i + CH));\n  return 'data:' + mime + ';base64,' + btoa(bin);\n}\n\n/* ---------- what persists between sessions (myllmStorage, not the workspace) ----------\n   History and aliases are the shell's own memory, not the user's documents, so\n   they live in per-app storage where they cannot clutter a file listing. */\nasync function loadState(){\n  if (!store) return;\n  try {\n    var h = await store.getItem(HISTORY_KEY);\n    if (h){ var arr = JSON.parse(h); if (Array.isArray(arr)) cmdHistory = arr.slice(-200); }\n  } catch(e){}\n  try {\n    var a = await store.getItem(ALIAS_KEY);\n    if (a){ var obj = JSON.parse(a); if (obj && typeof obj === 'object') aliases = obj; }\n  } catch(e){}\n  try { var lg = JSON.parse(await store.getItem(LOG_KEY) || '[]'); if (Array.isArray(lg)) changeLog = lg.slice(-200); } catch(e){}\n  try { var us = JSON.parse(await store.getItem(UNDO_KEY) || '[]'); if (Array.isArray(us)) undoStack = us.slice(-30); } catch(e){}\n  try { var mk = JSON.parse(await store.getItem(MARK_KEY) || '{}'); if (mk && typeof mk === 'object') marks = mk; } catch(e){}\n  hIndex = cmdHistory.length;\n}\n/* Written on every command rather than debounced: a command is something a\n   person typed, not a per-frame event, and a debounce only buys the chance to\n   lose the last one when the app is closed straight after running it. */\nfunction saveHistory(){\n  if (!store) return;\n  try { store.setItem(HISTORY_KEY, JSON.stringify(cmdHistory.slice(-200))); } catch(e){}\n}\nfunction saveAliases(){\n  if (!store) return;\n  try { store.setItem(ALIAS_KEY, JSON.stringify(aliases)); } catch(e){}\n}\nfunction saveMarks(){ if (store) try { store.setItem(MARK_KEY, JSON.stringify(marks)); } catch(e){} }\nfunction saveLog(){ if (store) try { store.setItem(LOG_KEY, JSON.stringify(changeLog.slice(-200))); } catch(e){} }\n/* App storage is ~1 MB for everything, and an undo entry for a rewritten file\n   carries the old text. Oldest entries go first until the stack fits; an entry\n   whose old text alone is too big is kept but marked, so undo can say so\n   rather than \"restore\" an empty file. */\nfunction saveUndo(){\n  if (!store) return;\n  var ops = undoStack.map(function(op){\n    if (op.prev != null && op.prev.length > 150000){ var c = Object.assign({}, op); delete c.prev; c.prevLost = true; return c; }\n    if (op.items){ var c2 = Object.assign({}, op); c2.items = op.items.map(function(it){\n      return it.prev != null && it.prev.length > 150000 ? { path: it.path, prevLost: true } : it; }); return c2; }\n    return op;\n  });\n  var json = JSON.stringify(ops);\n  while (json.length > 600000 && ops.length){ ops.shift(); json = JSON.stringify(ops); }\n  try { store.setItem(UNDO_KEY, json); } catch(e){}\n}\n\n/* !! / !5 / !gr — resolved before the line is echoed, so what you see in the\n   scrollback and what goes into history is the command that actually ran. */\nfunction expandBang(line){\n  if (line.charAt(0) !== '!') return line;\n  var rest = line.slice(1);\n  if (!rest || rest === '!') return cmdHistory.length ? cmdHistory[cmdHistory.length - 1] : null;\n  if (/^\\d+$/.test(rest)) return cmdHistory[parseInt(rest, 10) - 1] || null;\n  for (var i = cmdHistory.length - 1; i >= 0; i--)\n    if (cmdHistory[i].toLowerCase().indexOf(rest.toLowerCase()) === 0) return cmdHistory[i];\n  return null;\n}\n\n/* .shellrc: the lines that run when Shell opens. Nobody is at the prompt yet,\n   so it is held to the same bar as the agent — look around, set up, change\n   nothing. A rm in a startup file would run before you could stop it. */\nvar RC_SAFE = ['cd','alias','unalias','mark','clear','ls','dir','tree','pwd','du','cat','head','tail','sed','stat','find','grep','diff','jq','wc','sort','uniq','cut','history','log'];\nasync function runRC(){\n  var text = null;\n  try { text = await files.read(RC); } catch(e){}\n  if (text == null) return;\n  var lines = text.split('\\n'), ran = 0;\n  for (var i = 0; i < lines.length; i++){\n    var l = lines[i].trim();\n    if (!l || l.charAt(0) === '#') continue;\n    var why = unsafeReason(l, RC_SAFE);\n    if (why){ print(RC + ':' + (i + 1) + ': skipped — ' + why, 'err'); continue; }\n    try { await runLine(l); } catch(e){ print(RC + ':' + (i + 1) + ': ' + (e && e.message || e), 'err'); }\n    if (++ran >= 20){ print(RC + ': stopped after 20 lines', 'dim'); break; }\n  }\n}\n\n/* ---------- a line, end to end ---------- */\nasync function runLine(line){\n  var text = String(line || '').trim();\n  if (!text) return;\n  if (!isCommandLine(text)){ stdin = null; return run(text); }\n\n  var pl = splitPipeline(text);\n  if (!pl.stages.length) return;\n  if (pl.redirect && !pl.redirect.path) return print('> needs a file name, e.g.  ls > list.txt', 'err');\n\n  var piped = null;\n  for (var i = 0; i < pl.stages.length; i++){\n    var stage = expandAlias(pl.stages[i]);\n    stdin = piped;\n    /* The last stage of a plain pipeline prints for itself — in colour, with\n       its paths still tappable. Only what is on its way to a file is captured. */\n    if (i === pl.stages.length - 1 && !pl.redirect) return run(stage);\n    piped = await captureOf(runner(stage), true);\n    if (lastCaptureError){ print(piped, 'err'); return; }   /* a failed stage never reaches a file */\n  }\n\n  var dest = resolve(pl.redirect.path);\n  if (!dest) return print('> needs a file name, e.g.  ls > list.txt', 'err');\n  var body = piped == null ? '' : piped;\n  var added = body.length;\n  var prev = await files.read(dest);\n  if (pl.redirect.append && prev != null && prev.length)\n    body = prev + (prev.charAt(prev.length - 1) === '\\n' ? '' : '\\n') + body;\n  await files.write(dest, body);\n  remember({ type: 'write', path: dest, prev: prev });\n  haptic('success');\n  print((pl.redirect.append ? 'appended ' : 'wrote ') + added + ' chars to ' + dest +\n        (prev != null && !pl.redirect.append ? ' (replaced ' + prev.length + ')' : '') +\n        '  —  undo  puts it back', 'ok');\n}\n\nfunction when(ms){\n  var d = new Date(ms);\n  function p(x){ return (x<10?'0':'') + x; }\n  return d.getFullYear() + '-' + p(d.getMonth()+1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());\n}\n\nfunction glob(pattern, name){\n  if (pattern.indexOf('*') < 0 && pattern.indexOf('?') < 0)\n    return name.toLowerCase().indexOf(pattern.toLowerCase()) >= 0;\n  var rx = '^' + pattern.replace(/[.+^${}()|[\\]\\\\]/g,'\\\\$&')\n                        .replace(/\\*/g,'.*').replace(/\\?/g,'.') + '$';\n  return new RegExp(rx,'i').test(name);\n}\n\nasync function snapshot(includeHidden){\n  var list = await files.list();\n  var folders = files.folders ? await files.folders() : [];\n  var all = { files: list, folders: folders };\n  lastSnap = all;\n  if (includeHidden || inTrash(cwd)) return all;\n  return { files: list.filter(function(f){ return !inTrash(f.path); }),\n           folders: folders.filter(function(d){ return !inTrash(d); }) };\n}\n/* Where a deleted thing goes. Keeps the original path under .trash so restore\n   is a straight move back; a second delete of the same name gets a suffix. */\nfunction trashPath(target){\n  var snap = lastSnap || { files: [], folders: [] };   /* the UNFILTERED listing — run()'s hides .trash */\n  var dest = TRASH + '/' + target;\n  var taken = snap.files.some(function(f){ return f.path === dest || f.path.indexOf(dest + '/') === 0; }) || snap.folders.indexOf(dest) >= 0;\n  if (!taken) return dest;\n  var dot = target.lastIndexOf('.'), slash = target.lastIndexOf('/');\n  var stamp = '~' + new Date().toISOString().slice(0,19).replace(/[-:T]/g,'');\n  return TRASH + '/' + (dot > slash ? target.slice(0,dot) + stamp + target.slice(dot) : target + stamp);\n}\n/* After a restore, the folder that held the item may be left empty inside\n   .trash. Sweep those (deepest first) so `trash` never shows hollow folders. */\nasync function pruneTrash(){\n  try{\n    var all = await snapshot(true);\n    var dirs = all.folders.filter(function(d){ return inTrash(d) && d !== TRASH; }).sort(function(a,b){ return b.length - a.length; });\n    for (var i = 0; i < dirs.length; i++){\n      var d = dirs[i];\n      var busy = all.files.some(function(f){ return f.path.indexOf(d + '/') === 0; }) ||\n                 all.folders.some(function(x){ return x !== d && x.indexOf(d + '/') === 0 && !dirs.slice(0, i).some(function(gone){ return gone === x; }); });\n      if (!busy) await files.removeFolder(d, false);\n    }\n    var again = await snapshot(true);\n    if (again.folders.indexOf(TRASH) >= 0 && !again.files.some(function(f){ return inTrash(f.path); }) &&\n        !again.folders.some(function(d){ return d !== TRASH && inTrash(d); })) await files.removeFolder(TRASH, false);\n  }catch(e){}\n}\nfunction pathHTML(p, label){ return '<span class=\"path\" data-path=\"' + esc(p) + '\">' + esc(label == null ? p : label) + '</span>'; }\n\n/* ---------- v9 helpers: options, text tools, diff, json, edits ---------- */\n\n/* Options for commands whose flags take a value (sort -k 2, cut -d ,).\n   `withValue` names those letters; everything else is a boolean flag. */\nfunction parseOpts(raw, withValue){\n  var o = { flags: {}, vals: {}, ops: [] };\n  for (var i = 0; i < raw.length; i++){\n    var a = raw[i];\n    if (a.length > 1 && a.charAt(0) === '-' && !/^-\\d/.test(a)){\n      for (var j = 1; j < a.length; j++){\n        var c = a.charAt(j);\n        if (withValue.indexOf(c) >= 0){\n          var v = a.slice(j + 1); if (!v && i + 1 < raw.length) v = raw[++i];\n          o.vals[c] = v; break;\n        }\n        o.flags[c] = true;\n      }\n    } else o.ops.push(a);\n  }\n  return o;\n}\n/* What a text command works on: what was piped in, or a file. */\nasync function textFrom(sin, pathArg, verb){\n  if (sin != null && !pathArg) return { text: sin };\n  if (!pathArg) return { err: verb + ' needs a path, or something piped in' };\n  var t = await files.read(resolve(pathArg));\n  if (t == null) return { err: 'No such file: ' + resolve(pathArg) };\n  return { text: t };\n}\n/* A footnote for the person at the screen. Never captured, so it can't land in\n   a pipe or a file the way head's \"[N lines total]\" does. */\nfunction note(text){ if (capture === null) print(text, 'dim'); }\nfunction lines$(t){ var l = String(t).split('\\n'); if (l.length && l[l.length - 1] === '') l.pop(); return l; }\n\n/* Line diff: LCS over what is left after the common head and tail, then\n   unified hunks with 3 lines of context. Big files fall back to a summary\n   rather than freezing the page. */\nfunction lineDiff(a, b){\n  var pre = 0; while (pre < a.length && pre < b.length && a[pre] === b[pre]) pre++;\n  var suf = 0; while (suf < a.length - pre && suf < b.length - pre && a[a.length-1-suf] === b[b.length-1-suf]) suf++;\n  var A = a.slice(pre, a.length - suf), B = b.slice(pre, b.length - suf);\n  if (A.length * B.length > 4000000) return null;\n  var n = A.length, m = B.length, i, j;\n  var L = []; for (i = 0; i <= n; i++){ L.push(new Uint32Array(m + 1)); }\n  for (i = n - 1; i >= 0; i--) for (j = m - 1; j >= 0; j--)\n    L[i][j] = A[i] === B[j] ? L[i+1][j+1] + 1 : Math.max(L[i+1][j], L[i][j+1]);\n  var ops = [];\n  for (i = 0; i < pre; i++) ops.push([' ', a[i]]);\n  i = 0; j = 0;\n  while (i < n && j < m){\n    if (A[i] === B[j]){ ops.push([' ', A[i]]); i++; j++; }\n    else if (L[i+1][j] >= L[i][j+1]) ops.push(['-', A[i++]]);\n    else ops.push(['+', B[j++]]);\n  }\n  while (i < n) ops.push(['-', A[i++]]);\n  while (j < m) ops.push(['+', B[j++]]);\n  for (i = a.length - suf; i < a.length; i++) ops.push([' ', a[i]]);\n  return ops;\n}\nfunction diffHTML(ops, labelA, labelB){\n  var CTX = 3, out = ['<span class=\"dim\">--- ' + esc(labelA) + '\\n+++ ' + esc(labelB) + '</span>'];\n  var adds = 0, dels = 0, k, aN = 0, bN = 0, pos = [];\n  for (k = 0; k < ops.length; k++){ pos.push([aN, bN]); if (ops[k][0] !== '+') aN++; if (ops[k][0] !== '-') bN++; }\n  var changed = []; for (k = 0; k < ops.length; k++) if (ops[k][0] !== ' ') changed.push(k);\n  if (!changed.length) return null;\n  var hunks = [], s0 = Math.max(0, changed[0] - CTX), e0 = Math.min(ops.length - 1, changed[0] + CTX);\n  for (k = 1; k < changed.length; k++){\n    if (changed[k] - CTX <= e0 + 1) e0 = Math.min(ops.length - 1, changed[k] + CTX);\n    else { hunks.push([s0, e0]); s0 = Math.max(0, changed[k] - CTX); e0 = Math.min(ops.length - 1, changed[k] + CTX); }\n  }\n  hunks.push([s0, e0]);\n  hunks.forEach(function(h){\n    var aCount = 0, bCount = 0;\n    for (var x = h[0]; x <= h[1]; x++){ if (ops[x][0] !== '+') aCount++; if (ops[x][0] !== '-') bCount++; }\n    out.push('<span class=\"dim\">@@ -' + (pos[h[0]][0] + 1) + ',' + aCount + ' +' + (pos[h[0]][1] + 1) + ',' + bCount + ' @@</span>');\n    for (var y = h[0]; y <= h[1]; y++){\n      var t = ops[y][0], line = esc(ops[y][1]);\n      if (t === '-'){ dels++; out.push('<span class=\"err\">-' + line + '</span>'); }\n      else if (t === '+'){ adds++; out.push('<span class=\"ok\">+' + line + '</span>'); }\n      else out.push('<span class=\"dim\"> ' + line + '</span>');\n    }\n  });\n  return { html: out.join('\\n'), adds: adds, dels: dels };\n}\n/* file, file@N (a saved version, 1 = newest), or - for what was piped in. */\nasync function loadSpec(spec, sin){\n  if (spec === '-'){ if (sin == null) return { err: '- means piped input, and nothing was piped' }; return { label: '(piped)', text: sin }; }\n  var m = /^(.*)@(\\d+)$/.exec(spec), path = resolve(m ? m[1] : spec);\n  if (!m){\n    var t = await files.read(path);\n    return t == null ? { err: 'No such file: ' + path } : { label: path, text: t };\n  }\n  if (!files.versions || !files.readVersion) return { err: 'Version history needs the latest MyLLM build.' };\n  var vs = await files.versions(path), v = +m[2];\n  if (!vs.length) return { err: 'No previous versions of ' + path };\n  if (v < 1 || v > vs.length) return { err: path + ' has versions 1\\u2013' + vs.length + '  (see  history ' + path + ')' };\n  var old = await files.readVersion(path, vs[v - 1].stamp);\n  if (old == null) return { err: 'Could not read version ' + v + ' of ' + path };\n  return { label: path + '@' + v + '  (' + when(vs[v - 1].stamp) + ')', text: old };\n}\n\n/* A small jq: paths (.a.b, .a[0], .a[], .\"odd key\", .[\"odd key\"]), pipes, and\n   keys / length / type / values. Enough to pull one field out of a file. */\nfunction jqSplit(f){\n  var parts = [], cur = '', depth = 0, q = false;\n  for (var i = 0; i < f.length; i++){\n    var c = f.charAt(i);\n    if (q){ cur += c; if (c === '\"' && f.charAt(i-1) !== '\\\\') q = false; continue; }\n    if (c === '\"'){ q = true; cur += c; continue; }\n    if (c === '[') depth++; if (c === ']') depth--;\n    if (c === '|' && !depth){ parts.push(cur.trim()); cur = ''; continue; }\n    cur += c;\n  }\n  parts.push(cur.trim());\n  return parts;\n}\nfunction jqStage(stage, inputs){\n  var outv = [];\n  if (stage === '.' || stage === '') return inputs;\n  if (/^(keys|length|type|values)$/.test(stage)){\n    inputs.forEach(function(v){\n      if (stage === 'type') outv.push(v === null ? 'null' : Array.isArray(v) ? 'array' : typeof v);\n      else if (stage === 'length') outv.push(v == null ? 0 : typeof v === 'object' ? (Array.isArray(v) ? v.length : Object.keys(v).length) : String(v).length);\n      else if (stage === 'keys'){ if (!v || typeof v !== 'object') throw new Error('keys needs an object or array'); outv.push(Array.isArray(v) ? v.map(function(_, i){ return i; }) : Object.keys(v).sort()); }\n      else { if (!v || typeof v !== 'object') throw new Error('values needs an object or array'); outv = outv.concat(Array.isArray(v) ? v : Object.keys(v).map(function(k){ return v[k]; })); }\n    });\n    return outv;\n  }\n  if (stage.charAt(0) !== '.') throw new Error('unknown filter \"' + stage + '\" — try .field, .list[0], .list[], keys, length');\n  var steps = [], i = 0, rx;\n  while (i < stage.length){\n    var rest = stage.slice(i);\n    if ((rx = /^\\.\\[/.exec(rest))){ i += 1; continue; }\n    if ((rx = /^\\.([A-Za-z_][A-Za-z0-9_$-]*)/.exec(rest))){ steps.push(['key', rx[1]]); i += rx[0].length; continue; }\n    if ((rx = /^\\.\"((?:[^\"\\\\]|\\\\.)*)\"/.exec(rest))){ steps.push(['key', rx[1]]); i += rx[0].length; continue; }\n    if ((rx = /^\\[\\s*(-?\\d+)\\s*\\]/.exec(rest))){ steps.push(['idx', +rx[1]]); i += rx[0].length; continue; }\n    if ((rx = /^\\[\\s*\"((?:[^\"\\\\]|\\\\.)*)\"\\s*\\]/.exec(rest))){ steps.push(['key', rx[1]]); i += rx[0].length; continue; }\n    if ((rx = /^\\[\\s*\\]/.exec(rest))){ steps.push(['each']); i += rx[0].length; continue; }\n    if (rest === '.') break;\n    throw new Error('cannot read \"' + rest + '\" in the filter');\n  }\n  var cur = inputs;\n  steps.forEach(function(st){\n    var next = [];\n    cur.forEach(function(v){\n      if (st[0] === 'key') next.push(v != null && typeof v === 'object' && !Array.isArray(v) ? (v.hasOwnProperty(st[1]) ? v[st[1]] : null) : null);\n      else if (st[0] === 'idx') next.push(Array.isArray(v) ? v[st[1] < 0 ? v.length + st[1] : st[1]] : null);\n      else { if (!v || typeof v !== 'object') throw new Error('cannot iterate over ' + (v === null ? 'null' : typeof v)); next = next.concat(Array.isArray(v) ? v : Object.keys(v).map(function(k){ return v[k]; })); }\n    });\n    cur = next.map(function(x){ return x === undefined ? null : x; });\n  });\n  return cur;\n}\n\n/* write / replace / edit, worked out WITHOUT writing: the commands use it to\n   do the change, and a proposal uses it to show the diff before anyone types\n   y. Patch-sized edits are reviewable; a whole-file rewrite is not. */\nasync function planEdit(line){\n  var argv = tokenize(line), verb = (argv.shift() || '').toLowerCase();\n  var o = parseOpts(argv, '');\n  if (o.ops[0] === '-1'){ o.ops.shift(); o.flags['1'] = true; }   /* replace -1: first occurrence only */\n  var path = o.ops[0] ? resolve(o.ops[0]) : '';\n  if (!path) return { err: verb + ' needs a path' };\n  var prev = await files.read(path);\n  if (verb === 'write'){\n    var body = line.slice(line.indexOf(o.ops[0]) + o.ops[0].length).trim();\n    if (!body) return { err: 'write <path> <text>  — the text replaces the file' };\n    return { path: path, prev: prev, next: body, how: prev == null ? 'created ' : 'rewrote ', said: 'wrote ' + body.length + ' chars to ' + path + (prev != null ? ' (replaced ' + prev.length + ')' : '') };\n  }\n  if (prev == null) return { err: 'No such file: ' + path };\n  if (verb === 'replace'){\n    if (o.ops.length < 3) return { err: 'replace <path> \"old text\" \"new text\"  (-1 changes only the first)' };\n    var from = o.ops[1].replace(/\\\\n/g, '\\n'), to = o.ops[2].replace(/\\\\n/g, '\\n');\n    if (!from) return { err: 'replace needs the text to find' };\n    var count = prev.split(from).length - 1;\n    if (!count) return { err: '\"' + o.ops[1] + '\" is not in ' + path + ' — nothing to replace' };\n    var next = o.flags['1'] ? prev.replace(from, function(){ return to; }) : prev.split(from).join(to);\n    var n = o.flags['1'] ? 1 : count;\n    return { path: path, prev: prev, next: next, how: 'edited ', said: 'replaced ' + n + ' occurrence' + (n === 1 ? '' : 's') + ' in ' + path };\n  }\n  /* edit <path> <A[-B]> <text>  replaces lines A..B;  <A>+ <text>  inserts after A\n     (0+ is the top); an empty text deletes the lines. */\n  var spec = o.ops[1] || '', text = o.ops.slice(2).join(' ').replace(/\\\\n/g, '\\n');\n  var ls = prev.split('\\n'), mm;\n  if ((mm = /^(\\d+)\\+$/.exec(spec))){\n    var after = +mm[1]; if (after > ls.length) return { err: path + ' has ' + ls.length + ' lines' };\n    if (!text) return { err: 'edit ' + o.ops[0] + ' ' + spec + ' \"text to insert\"' };\n    ls.splice.apply(ls, [after, 0].concat(text.split('\\n')));\n    return { path: path, prev: prev, next: ls.join('\\n'), how: 'edited ', said: 'inserted ' + text.split('\\n').length + ' line(s) after line ' + after + ' of ' + path };\n  }\n  if (!(mm = /^(\\d+)(?:-(\\d+|\\$))?$/.exec(spec))) return { err: 'edit <path> <line or A-B> \"new text\"   or   edit <path> <A>+ \"inserted text\"' };\n  var a = +mm[1], b = mm[2] === '$' ? ls.length : mm[2] ? +mm[2] : a;\n  if (a < 1 || b < a || b > ls.length) return { err: path + ' has lines 1\\u2013' + ls.length };\n  ls.splice.apply(ls, [a - 1, b - a + 1].concat(text === '' ? [] : text.split('\\n')));\n  return { path: path, prev: prev, next: ls.join('\\n'), how: 'edited ', said: (text === '' ? 'deleted' : 'replaced') + ' line' + (a === b ? ' ' + a : 's ' + a + '\\u2013' + b) + ' of ' + path };\n}\nasync function previewEdit(line){\n  var v = (tokenize(line)[0] || '').toLowerCase();\n  if (['write','replace','edit'].indexOf(v) < 0) return;\n  var plan = await planEdit(line);\n  if (plan.err){ print('   (' + plan.err + ')', 'err'); return; }\n  var d = diffHTML(lineDiff(lines$(plan.prev || ''), lines$(plan.next)) || [], plan.prev == null ? '(new file)' : plan.path, plan.path + ' after');\n  if (d) printHTML(d.html);\n}\n\n/* ---------- commands ---------- */\n\nasync function run(line){\n  if (!files){ print('Shared files are off. Turn on \"Shared files\" in MyLLMos settings.', 'err'); return; }\n  /* Taken and cleared in one go: whatever this command does next — including\n     running another command — must not inherit the text piped into this one. */\n  var sin = stdin; stdin = null;\n  var argv = tokenize(line);\n  var verb = (argv.shift()||'').toLowerCase();\n  var raw = argv.slice();   /* for commands whose options take values (find, sort, cut) */\n\n  var flags = {}, n = 20, ops = [], ctx = 0;\n  for (var i=0;i<argv.length;i++){\n    var a = argv[i];\n    if (a === '-n' && argv[i+1] && !isNaN(+argv[i+1])){ n = Math.max(1, Math.min(+argv[i+1], 500)); i++; continue; }\n    if (a === '-C' && argv[i+1] && !isNaN(+argv[i+1])){ ctx = Math.max(0, Math.min(+argv[i+1], 10)); i++; continue; }\n    if (/^-C\\d+$/.test(a)){ ctx = Math.min(+a.slice(2), 10); continue; }\n    if (a.charAt(0) === '-'){ a.slice(1).split('').forEach(function(f){ flags[f] = true; }); continue; }\n    ops.push(a);\n  }\n  var target = ops.length ? resolve(ops[0]) : cwd;\n  var snap = await snapshot(!!flags.a);\n\n  switch (verb){\n    case 'help': printHTML(helpHTML()); return;\n    case 'clear': out.innerHTML = ''; return;\n    case 'pwd': print('/' + cwd, 'dim'); return;\n\n    case 'cd': {\n      var dest;\n      if (raw[0] === '-'){ if (prevCwd == null) return print('no previous folder yet', 'dim'); dest = prevCwd; }\n      else dest = ops.length ? resolve(ops[0]) : '';\n      if (ops[0] && ops[0].charAt(0) === '@' && !Object.prototype.hasOwnProperty.call(marks, ops[0].slice(1).split('/')[0].toLowerCase()))\n        return print('no bookmark ' + ops[0].split('/')[0] + ' — see  mark', 'err');\n      if (dest && snap.folders.indexOf(dest) < 0) return print('No such folder: ' + dest, 'err');\n      prevCwd = cwd; cwd = dest; paintPrompt();\n      return print('/' + cwd, 'dim');\n    }\n\n    case 'mark': {\n      /* mark            list bookmarks\n         mark name [p]   save p (default: here) as @name\n         mark -d name    forget one */\n      if (flags.d){\n        var dName = (ops[0] || '').toLowerCase().replace(/^@/, '');\n        if (!Object.prototype.hasOwnProperty.call(marks, dName)) return print('no bookmark @' + dName, 'dim');\n        delete marks[dName]; saveMarks(); return print('forgot @' + dName, 'ok');\n      }\n      if (!ops.length){\n        var mNames = Object.keys(marks).sort();\n        if (!mNames.length) return print('no bookmarks yet — stand somewhere and type  mark work  then use  cd @work  or  ls @work', 'dim');\n        return printHTML(mNames.map(function(k){ return '<span class=\"cmd\">@' + esc(k) + '</span>\\t' + pathHTML(marks[k], '/' + marks[k]); }).join('\\n'));\n      }\n      var mName = ops[0].toLowerCase().replace(/^@/, '');\n      if (!/^[a-z0-9_-]+$/.test(mName)) return print('a bookmark name is letters, digits, - or _', 'err');\n      var mPath = ops[1] ? resolve(ops[1]) : cwd;\n      if (mPath && snap.folders.indexOf(mPath) < 0 && !snap.files.some(function(x){ return x.path === mPath; })) return print('No such file or folder: ' + mPath, 'err');\n      marks[mName] = mPath; saveMarks();\n      return print('@' + mName + ' -> /' + mPath, 'ok');\n    }\n\n    case 'ls': case 'dir': case 'tree':\n      return listing(snap, target, verb === 'tree' || flags.R || flags.r, flags.t ? 't' : flags.S ? 'S' : null);\n\n    case 'cat': case 'head': case 'tail': {\n      var text;\n      if (sin != null && !ops.length) text = sin;          /* ... | head -n 5 */\n      else {\n        if (!target) return print(verb + ' needs a path', 'err');\n        text = await files.read(target);\n        if (text == null) return print('No such file: ' + target, 'err');\n      }\n      if (verb === 'cat') return print(text);\n      var lines = text.split('\\n');\n      print((verb === 'head' ? lines.slice(0, n) : lines.slice(-n)).join('\\n'));\n      if (lines.length > n) print('[' + lines.length + ' lines total]', 'dim');\n      return;\n    }\n\n    case 'stat': {\n      var f = snap.files.filter(function(x){ return x.path === target; })[0];\n      if (f) return print(f.path + '\\ntype: file\\nsize: ' + f.size + ' bytes\\nmodified: ' + when(f.modified*1000));\n      if (snap.folders.indexOf(target) >= 0){\n        var inside = snap.files.filter(function(x){ return x.path.indexOf(target + '/') === 0; });\n        var total = inside.reduce(function(a,b){ return a + b.size; }, 0);\n        return print(target + '/\\ntype: folder\\ncontains: ' + inside.length + ' file(s), ' + total + ' bytes');\n      }\n      return print('No such file or folder: ' + target, 'err');\n    }\n\n    case 'find': {\n      /* find [glob] [-mtime -7] [-newer path] [-size +10k] [-type f|d]\n         -mtime counts days: -7 within the last 7, +30 older than 30. */\n      var fPat = null, fNewer = null, fMtime = null, fSize = null, fType = 'f';\n      for (var k = 0; k < raw.length; k++){\n        var w = raw[k];\n        if (w === '-newer' && raw[k+1]){ fNewer = raw[++k]; continue; }\n        if (w === '-mtime' && raw[k+1]){ fMtime = raw[++k]; continue; }\n        if (w === '-size' && raw[k+1]){ fSize = raw[++k]; continue; }\n        if (w === '-type' && raw[k+1]){ fType = raw[++k] === 'd' ? 'd' : 'f'; continue; }\n        if (w === '-name' && raw[k+1]){ fPat = raw[++k]; continue; }\n        if (w.charAt(0) === '-'){ return print('find: unknown option ' + w + ' — try -mtime -7, -newer <file>, -size +10k, -type d', 'err'); }\n        if (fPat === null) fPat = w;\n      }\n      if (fPat === null && fNewer === null && fMtime === null && fSize === null && fType === 'f')\n        return print('find needs a name or glob, e.g.  find *.json   or a filter:  find -mtime -7', 'err');\n      var now = Date.now() / 1000, newerThan = null;\n      if (fNewer !== null){\n        var ref = snap.files.filter(function(x){ return x.path === resolve(fNewer); })[0];\n        if (!ref) return print('find -newer: no such file ' + resolve(fNewer), 'err');\n        newerThan = ref.modified;\n      }\n      var mt = fMtime === null ? null : /^([+-]?)(\\d+(?:\\.\\d+)?)$/.exec(fMtime);\n      if (fMtime !== null && !mt) return print('find -mtime takes days: -7 (last week) or +30 (older than a month)', 'err');\n      var sz = fSize === null ? null : /^([+-]?)(\\d+(?:\\.\\d+)?)([kKmM]?)$/.exec(fSize);\n      if (fSize !== null && !sz) return print('find -size takes +10k, -2k, +1m or a byte count', 'err');\n      var szBytes = sz ? +sz[2] * (/k/i.test(sz[3]) ? 1024 : /m/i.test(sz[3]) ? 1048576 : 1) : 0;\n      if (fType === 'd'){\n        var dHits = snap.folders.filter(function(d){ return fPat === null || glob(fPat, d.split('/').pop()) || glob(fPat, d); });\n        if (!dHits.length) return print('No matching folder', 'dim');\n        return printHTML(dHits.sort().map(function(d){ return pathHTML(d, d + '/'); }).join('\\n'));\n      }\n      var hits = snap.files.filter(function(f){\n        if (fPat !== null && !(glob(fPat, f.path.split('/').pop()) || glob(fPat, f.path))) return false;\n        if (newerThan !== null && !(f.modified > newerThan)) return false;\n        if (mt){\n          var age = (now - f.modified) / 86400, days = +mt[2];\n          if (mt[1] === '-' && !(age < days)) return false;\n          if (mt[1] === '+' && !(age > days)) return false;\n          if (!mt[1] && !(age >= days && age < days + 1)) return false;\n        }\n        if (sz){\n          if (sz[1] === '+' && !(f.size > szBytes)) return false;\n          if (sz[1] === '-' && !(f.size < szBytes)) return false;\n          if (!sz[1] && f.size !== szBytes) return false;\n        }\n        return true;\n      });\n      if (!hits.length) return print('No match' + (fPat ? ' for ' + fPat : ''), 'dim');\n      /* With a time filter you are asking \"what changed?\", so newest first. */\n      hits.sort(function(a, b){ return (mt || newerThan !== null) ? b.modified - a.modified : (a.path < b.path ? -1 : 1); });\n      return printHTML(hits.map(function(f){ return pathHTML(f.path); }).join('\\n'));\n    }\n\n    case 'grep': {\n      /* Search INSIDE files — find only knows names. Case-insensitive unless -s,\n         because a phone keyboard capitalises the first letter whether you like\n         it or not (-i is accepted too). -n numbers piped lines, -C N adds context,\n         -v keeps the lines that DON'T match, -c counts, -l names files only.\n         -E or /pattern/ is a regular expression. */\n      if (!ops[0]) return print('grep needs some text, e.g. grep dentist  or  grep -l invoice notes', 'err');\n      var pat = ops[0], rx = null;\n      var slashRe = pat.length > 2 && pat.charAt(0) === '/' && pat.lastIndexOf('/') > 0;\n      if (flags.E || slashRe){\n        try { rx = new RegExp(slashRe ? pat.slice(1, pat.lastIndexOf('/')) : pat, flags.s ? '' : 'i'); }\n        catch(e){ return print('grep: that pattern is not a valid regular expression (' + e.message + ')', 'err'); }\n      }\n      var needle = flags.s ? pat : pat.toLowerCase();\n      var findIn = function(l){\n        if (rx){ var m = rx.exec(l); return m ? { at: m.index, len: Math.max(1, m[0].length) } : null; }\n        var at = (flags.s ? l : l.toLowerCase()).indexOf(needle);\n        return at < 0 ? null : { at: at, len: needle.length };\n      };\n      var isHit = function(l){ var h = findIn(l); return flags.v ? !h : !!h; };\n      var mark = function(l, cut){\n        var h = flags.v ? null : findIn(l);\n        if (!h) return esc(cut ? l.slice(0, 120) : l);\n        if (!cut) return esc(l.slice(0, h.at)) + '<b>' + esc(l.slice(h.at, h.at + h.len)) + '</b>' + esc(l.slice(h.at + h.len));\n        var start = Math.max(0, h.at - 40), snippet = l.slice(start, start + 120), rel = h.at - start;\n        return (start ? '…' : '') + esc(snippet.slice(0, rel)) + '<b>' + esc(snippet.slice(rel, rel + h.len)) + '</b>' + esc(snippet.slice(rel + h.len));\n      };\n      /* Which lines to show: the hits, plus ctx lines around each (null = a \"--\" gap). */\n      var pick = function(ls){\n        var hitIdx = []; for (var q = 0; q < ls.length; q++) if (isHit(ls[q])) hitIdx.push(q);\n        if (!ctx) return { hits: hitIdx, rows: hitIdx.map(function(x){ return [x, true]; }) };\n        var want = {}, rows = [], last = -2;\n        hitIdx.forEach(function(x){ for (var y = Math.max(0, x - ctx); y <= Math.min(ls.length - 1, x + ctx); y++) want[y] = want[y] || (y === x); });\n        Object.keys(want).map(Number).sort(function(p1, p2){ return p1 - p2; }).forEach(function(y){\n          if (last >= 0 && y > last + 1) rows.push(null);\n          rows.push([y, hitIdx.indexOf(y) >= 0]); last = y;\n        });\n        return { hits: hitIdx, rows: rows };\n      };\n      /* Piped in: there are no files here, just lines. */\n      if (sin != null && ops.length < 2){\n        var sl = sin.split('\\n'), pk = pick(sl);\n        if (flags.c) return print(String(pk.hits.length));\n        if (!pk.hits.length) return print('No match for \"' + ops[0] + '\"', 'dim');\n        return printHTML(pk.rows.map(function(r){\n          if (!r) return '<span class=\"dim\">--</span>';\n          var num = flags.n || ctx ? '<span class=\"dim\">' + (r[0] + 1) + (r[1] ? ':' : '-') + '</span>' : '';\n          return num + (r[1] ? mark(sl[r[0]], false) : '<span class=\"dim\">' + esc(sl[r[0]]) + '</span>');\n        }).join('\\n'));\n      }\n      var scope = ops[1] ? resolve(ops[1]) : cwd;\n      var pool = snap.files.filter(function(f){ return !scope || f.path === scope || f.path.indexOf(scope + '/') === 0; });\n      if (!pool.length) return print('Nothing to search in ' + (scope || 'the workspace'), 'dim');\n      var rows = [], hitFiles = 0, shown = 0, LIMIT = 200;\n      for (var fi = 0; fi < pool.length && shown < LIMIT; fi++){\n        var f = pool[fi], txt = await files.read(f.path);\n        if (txt == null) continue;\n        var ls = txt.split('\\n'), got = pick(ls);\n        if (!got.hits.length) continue;\n        hitFiles++;\n        if (flags.l){ rows.push(pathHTML(f.path)); continue; }\n        if (flags.c){ rows.push(pathHTML(f.path) + '<span class=\"hit\">:' + got.hits.length + '</span>'); continue; }\n        for (var ri = 0; ri < got.rows.length && shown < LIMIT; ri++){\n          var r = got.rows[ri];\n          if (!r){ rows.push('<span class=\"dim\">--</span>'); continue; }\n          if (r[1]) shown++;\n          rows.push(pathHTML(f.path) + (r[1]\n            ? '<span class=\"hit\">:' + (r[0] + 1) + ': ' + mark(ls[r[0]], true) + '</span>'\n            : '<span class=\"dim\">-' + (r[0] + 1) + '- ' + esc(ls[r[0]].slice(0, 120)) + '</span>'));\n        }\n      }\n      if (!rows.length) return print('No match for \"' + ops[0] + '\" in ' + (scope || 'the workspace'), 'dim');\n      printHTML(rows.join('\\n'));\n      if (!flags.l && !flags.c) print('[' + shown + (shown >= LIMIT ? '+' : '') + ' line(s) in ' + hitFiles + ' file(s)]', 'dim');\n      return;\n    }\n\n    /* ---- v9: the text tools. Each reads a file or whatever was piped in, so\n       they chain:  find *.md | cut -d / -f 1 | sort | uniq -c | sort -rn ---- */\n\n    case 'sed': {\n      /* Only the read-a-range form:  sed -n '40,80p' file  (also 40,$p and 40p). */\n      var sm = /^(\\d+|\\$)(?:,(\\d+|\\$|\\+\\d+))?p$/.exec(ops[0] || '');\n      if (!flags.n || !sm) return print(\"sed -n '40,80p' <path>  prints lines 40 to 80 (this shell's sed reads ranges only; use  edit  to change lines)\", 'err');\n      var st = await textFrom(sin, ops[1], 'sed'); if (st.err) return print(st.err, 'err');\n      var sls = lines$(st.text), total = sls.length;\n      var from = sm[1] === '$' ? total : +sm[1];\n      var to = !sm[2] ? from : sm[2] === '$' ? total : sm[2].charAt(0) === '+' ? from + +sm[2].slice(1) : +sm[2];\n      if (from < 1 || from > total) return print('there are ' + total + ' lines', 'err');\n      print(sls.slice(from - 1, Math.min(to, total)).join('\\n'));\n      return note('[lines ' + from + '–' + Math.min(to, total) + ' of ' + total + ']');\n    }\n\n    case 'wc': {\n      var wo = parseOpts(raw, '');\n      var count = function(t){ var ls = lines$(t); return { l: ls.length, w: (t.match(/\\S+/g) || []).length, c: t.length }; };\n      var cols = (wo.flags.l || wo.flags.w || wo.flags.c) ? ['l','w','c'].filter(function(k){ return wo.flags[k]; }) : ['l','w','c'];\n      var fmt = function(r, name){ return cols.map(function(k){ return String(r[k]); }).join('\\t') + (name ? '\\t' + name : ''); };\n      if (sin != null && !wo.ops.length) return print(fmt(count(sin)));\n      if (!wo.ops.length) return print('wc [-l|-w|-c] <path…>  — lines, words, characters', 'err');\n      var tot = { l: 0, w: 0, c: 0 }, rowsW = [];\n      for (var wi = 0; wi < wo.ops.length; wi++){\n        var wt = await files.read(resolve(wo.ops[wi]));\n        if (wt == null) return print('No such file: ' + resolve(wo.ops[wi]), 'err');\n        var r1 = count(wt); rowsW.push(fmt(r1, resolve(wo.ops[wi]))); tot.l += r1.l; tot.w += r1.w; tot.c += r1.c;\n      }\n      if (wo.ops.length > 1) rowsW.push(fmt(tot, 'total'));\n      if (cols.length === 3) note('lines\\twords\\tchars');\n      return print(rowsW.join('\\n'));\n    }\n\n    case 'sort': {\n      /* -r reverse, -n numeric, -u drop repeats, -k N sort on field N, -t X fields split on X */\n      var so = parseOpts(raw, 'kt');\n      var sst = await textFrom(sin, so.ops[0], 'sort'); if (sst.err) return print(sst.err, 'err');\n      var keyOf = function(l){\n        if (!so.vals.k) return l;\n        var parts = so.vals.t ? l.split(so.vals.t) : l.trim().split(/\\s+/);\n        return parts[(+so.vals.k || 1) - 1] || '';\n      };\n      var sorted = lines$(sst.text).slice().sort(function(x, y){\n        var a1 = keyOf(x), b1 = keyOf(y), c;\n        if (so.flags.n){ c = (parseFloat(a1) || 0) - (parseFloat(b1) || 0); if (c) return c; }\n        c = a1.localeCompare(b1, undefined, { sensitivity: 'base' });\n        return c || (x < y ? -1 : x > y ? 1 : 0);\n      });\n      if (so.flags.r) sorted.reverse();\n      if (so.flags.u) sorted = sorted.filter(function(x, i2){ return i2 === 0 || keyOf(x) !== keyOf(sorted[i2 - 1]); });\n      return print(sorted.join('\\n'));\n    }\n\n    case 'uniq': {\n      /* Folds REPEATED NEIGHBOURS, as uniq always has — sort first. -c counts, -d repeats only. */\n      var uo = parseOpts(raw, '');\n      var ust = await textFrom(sin, uo.ops[0], 'uniq'); if (ust.err) return print(ust.err, 'err');\n      var runs = [];\n      lines$(ust.text).forEach(function(l){ if (runs.length && runs[runs.length - 1][0] === l) runs[runs.length - 1][1]++; else runs.push([l, 1]); });\n      if (uo.flags.d) runs = runs.filter(function(r2){ return r2[1] > 1; });\n      return print(runs.map(function(r2){ return uo.flags.c ? ('      ' + r2[1]).slice(-7) + ' ' + r2[0] : r2[0]; }).join('\\n'));\n    }\n\n    case 'cut': {\n      /* cut -d , -f 1,3   or   -f 2-4   (tab-separated by default)   or  -c 1-20 */\n      var co = parseOpts(raw, 'dfc');\n      var cst = await textFrom(sin, co.ops[0], 'cut'); if (cst.err) return print(cst.err, 'err');\n      var spec2 = co.vals.f || co.vals.c;\n      if (!spec2) return print('cut -d , -f 1,3  (fields)   or   cut -c 1-20  (characters)', 'err');\n      var want = function(nn){ return spec2.split(',').some(function(part){\n        var mm2 = /^(\\d*)-(\\d*)$/.exec(part); if (!mm2) return +part === nn;\n        return nn >= (mm2[1] ? +mm2[1] : 1) && nn <= (mm2[2] ? +mm2[2] : Infinity); }); };\n      var delim = co.vals.d == null ? '\\t' : co.vals.d === '\\\\t' ? '\\t' : co.vals.d;\n      return print(lines$(cst.text).map(function(l){\n        if (co.vals.c) return l.split('').filter(function(_, i3){ return want(i3 + 1); }).join('');\n        if (l.indexOf(delim) < 0) return l;\n        return l.split(delim).filter(function(_, i3){ return want(i3 + 1); }).join(delim);\n      }).join('\\n'));\n    }\n\n    case 'diff': {\n      /* diff a b  ·  diff notes.md@2  (that version vs now)  ·  diff notes.md\n         (the newest saved version vs now)  ·  diff notes.md@3 notes.md@1 */\n      if (!ops.length) return print('diff <a> <b>   or   diff <file>@N  (version N vs now — see  history <file>)', 'err');\n      var A, B;\n      if (ops.length === 1){\n        if (/@\\d+$/.test(ops[0])){ A = await loadSpec(ops[0], sin); B = await loadSpec(ops[0].replace(/@\\d+$/, ''), sin); }\n        else { A = await loadSpec(ops[0] + '@1', sin); B = await loadSpec(ops[0], sin); }\n      } else { A = await loadSpec(ops[0], sin); B = await loadSpec(ops[1], sin); }\n      if (A.err) return print(A.err, 'err');\n      if (B.err) return print(B.err, 'err');\n      var dops = lineDiff(lines$(A.text), lines$(B.text));\n      if (!dops) return print('too big to compare line by line (' + lines$(A.text).length + ' vs ' + lines$(B.text).length + ' lines)', 'err');\n      var dh = diffHTML(dops, A.label, B.label);\n      if (!dh) return print('no differences', 'dim');\n      printHTML(dh.html);\n      return note('[' + dh.adds + ' line(s) added, ' + dh.dels + ' removed]');\n    }\n\n    case 'jq': {\n      /* jq '.field.sub' file   ·   jq '.items[] | .name' file   ·   cat x.json | jq keys\n         -r prints strings without quotes. */\n      var jo = parseOpts(raw, '');\n      var filter = '.', jpath = null;\n      if (jo.ops.length >= 2){ filter = jo.ops[0]; jpath = jo.ops[1]; }\n      else if (jo.ops.length === 1){ if (sin != null || /^[.\\[]|^(keys|length|type|values)\\b/.test(jo.ops[0])) filter = jo.ops[0]; else jpath = jo.ops[0]; }\n      var jt = await textFrom(sin, jpath, 'jq'); if (jt.err) return print(jt.err, 'err');\n      var data;\n      try { data = JSON.parse(jt.text); }\n      catch(e){ return print((jpath ? resolve(jpath) : 'that') + ' is not valid JSON (' + e.message + ')', 'err'); }\n      var results;\n      try { results = jqSplit(filter).reduce(function(acc, stage){ return jqStage(stage, acc); }, [data]); }\n      catch(e){ return print('jq: ' + e.message, 'err'); }\n      return print(results.map(function(v){ return jo.flags.r && typeof v === 'string' ? v : JSON.stringify(v, null, 2); }).join('\\n'));\n    }\n\n    case 'du': {\n      var byDir = {};\n      snap.files.forEach(function(f){\n        var d = f.path.indexOf('/') < 0 ? '.' : f.path.slice(0, f.path.lastIndexOf('/'));\n        byDir[d] = (byDir[d]||0) + f.size;\n      });\n      var rows = Object.keys(byDir).sort(function(a,b){ return byDir[b]-byDir[a]; })\n        .map(function(d){ return bytes(byDir[d]) + '\\t' + d; });\n      var total = snap.files.reduce(function(a,b){ return a + b.size; }, 0);\n      return print(rows.concat([bytes(total) + '\\ttotal of 25 MB']).join('\\n'));\n    }\n\n    /* ---- the model as a filter, and the phone as an input device ---- */\n\n    case 'ask': {\n      /* The agent (anything that is not a command) EXPLORES: it runs commands\n         and decides what to do next. This verb TRANSFORMS: one call, no tools,\n         whatever came down the pipe as its material, and the answer is just\n         text — so it can be piped onward or redirected into a file. */\n      if (!window.myllmAsk) return print('AI is off for apps — turn on \"Allow apps to use the AI\" in MyLLMos settings.', 'err');\n      var q = unquote(restOf(line));\n      if (!q && sin == null) return print('ask \"a question\"  —  or pipe something in:  cat notes.md | ask \"summarise\"', 'err');\n      var material = sin;\n      var clipped = false;\n      if (material != null && material.length > ASK_MAX){ material = material.slice(0, ASK_MAX); clipped = true; }\n      var prompt = material != null\n        ? (q || 'Summarise this.') + '\\n\\n--- material ---\\n' + material + (clipped ? '\\n[truncated]' : '')\n        : q;\n      var spin = status('asking\\u2026');\n      var answer;\n      try { answer = await myllmAsk(prompt, { system: FILTER_SYSTEM }); }\n      catch(e){ unstatus(spin); return print('ask failed: ' + (e && e.message || e), 'err'); }\n      unstatus(spin);\n      var clean = stripFence(String(answer == null ? '' : answer));\n      if (!clean) return print('(no answer)', 'dim');\n      if (clipped) print('[used the first ' + ASK_MAX + ' characters]', 'dim');\n      return print(clean, 'say');\n    }\n\n    case 'dictate': {\n      /* Typing at a prompt is the worst thing about a terminal on a phone.\n         No path argument: it prints, and  >  is how anything gets saved. */\n      if (!window.myllmTranscribe) return print('Dictation needs a newer MyLLM build.', 'err');\n      var heard;\n      try { heard = await myllmTranscribe(); }\n      catch(e){ return print('dictation failed: ' + (e && e.message || e), 'err'); }\n      if (heard == null || !String(heard).trim()) return print('nothing heard', 'dim');\n      haptic('success');\n      return print(String(heard).trim());\n    }\n\n    case 'open': {\n      /* The intent bus, with the same action name the Files app uses, so Shell\n         reaches exactly the apps that already declare they can take text. */\n      if (!ops.length) return print('open <path>  — hands the file to an app that can open text', 'err');\n      if (!snap.files.some(function(x){ return x.path === target; })) return print('No such file: ' + target, 'err');\n      var body = await files.read(target);\n      if (body == null) return print('Cannot read ' + target + ' — Shell handles text files.', 'err');\n      if (!window.myllmIntent) return print('Handing files to other apps needs a newer MyLLM build.', 'err');\n      var oName = target.split('/').pop(), oDot = oName.lastIndexOf('.');\n      try {\n        var routed = await myllmIntent.send('open-text', {\n          name: oName, path: target, ext: oDot > 0 ? oName.slice(oDot + 1).toLowerCase() : '', text: body\n        });\n        haptic('success');\n        return print('opened ' + oName + (routed && routed.handlers > 1 ? ' — pick an app' : ''), 'ok');\n      } catch(e){\n        /* Nothing installed takes text yet. An error here would read as broken\n           rather than un-adopted, so do the useful thing instead. */\n        print('No installed app can open text yet — here it is instead.', 'dim');\n        return print(body);\n      }\n    }\n\n    case 'share': {\n      if (!ops.length) return print('share <path>  — sends the file out through iOS', 'err');\n      var sBody = await files.read(target);\n      if (sBody == null) return print('No such file: ' + target, 'err');\n      if (!window.myllmShareFile) return print('Sharing needs a newer MyLLM build.', 'err');\n      var sName = target.split('/').pop(), sMime = mimeFor(sName);\n      try { await myllmShareFile(dataURL(sBody, sMime), { filename: sName, mime: sMime }); }\n      catch(e){ return print('share failed: ' + (e && e.message || e), 'err'); }\n      haptic('success');\n      return print('shared ' + sName, 'ok');\n    }\n\n    case 'alias': {\n      var aRest = restOf(line);\n      if (!aRest){\n        var names = Object.keys(aliases).sort();\n        if (!names.length) return print('no aliases yet — e.g.  alias ll \"ls -R\"', 'dim');\n        return print(names.map(function(k){ return k + '\\t' + aliases[k]; }).join('\\n'));\n      }\n      var aName = (tokenize(aRest)[0] || '').toLowerCase();\n      var aBody = unquote(restOf(aRest));\n      if (!aBody) return print(aliases[aName] ? aName + '\\t' + aliases[aName] : 'no alias ' + aName, aliases[aName] ? '' : 'dim');\n      if (KNOWN.indexOf(aName) >= 0) return print(aName + ' is already a command — pick another name', 'err');\n      aliases[aName] = aBody; saveAliases();\n      return print('alias ' + aName + ' -> ' + aBody, 'ok');\n    }\n\n    case 'unalias': {\n      var uName = (ops[0] || '').toLowerCase();\n      if (!uName) return print('unalias <name>', 'err');\n      if (!Object.prototype.hasOwnProperty.call(aliases, uName)) return print('no alias ' + uName, 'dim');\n      delete aliases[uName]; saveAliases();\n      return print('removed alias ' + uName, 'ok');\n    }\n\n    /* ---- mutations: this is a person at a prompt, so they are allowed ---- */\n\n    case 'mkdir':\n      if (!target) return print('mkdir needs a path', 'err');\n      if (snap.folders.indexOf(target) >= 0) return print(target + '/ already exists', 'dim');\n      await files.makeFolder(target);\n      remember({ type: 'mkdir', path: target });\n      haptic('success');\n      return print('created ' + target + '/', 'ok');\n\n    case 'mv': {\n      if (ops.length < 2) return print('mv needs a source and a destination', 'err');\n      var to = resolve(ops[1]);\n      if (!to) return print('mv needs a destination name', 'err');\n      /* Checked here, not left to the store: a missing source used to \"move\"\n         nothing and report success, which a batch would sail past. */\n      if (!snap.files.some(function(x){ return x.path === target; }) && snap.folders.indexOf(target) < 0)\n        return print('No such file or folder: ' + target, 'err');\n      var exists = snap.files.some(function(x){ return x.path === to; }) || snap.folders.indexOf(to) >= 0;\n      /* The store replaces a destination silently, and a replaced file cannot be\n         undone — so say so, and make replacing a deliberate flag. */\n      if (exists && !flags.f) return print(to + ' already exists — use  mv -f  to replace it', 'err');\n      await files.move(target, to);\n      remember({ type: 'mv', from: target, to: to });\n      haptic('success');\n      return print(target + ' -> ' + to, 'ok');\n    }\n\n    case 'write': case 'replace': case 'edit': {\n      /* write replaces the whole file; replace swaps text; edit changes lines.\n         All three are worked out by planEdit first, which is also what shows a\n         proposal's diff before anyone types y. */\n      var plan = await planEdit(line);\n      if (plan.err) return print(plan.err, 'err');\n      if (plan.prev === plan.next) return print('no change to ' + plan.path, 'dim');\n      await files.write(plan.path, plan.next);\n      remember({ type: 'write', path: plan.path, prev: plan.prev, how: plan.how });\n      haptic('success');\n      return print(plan.said + '  —  undo  puts it back', 'ok');\n    }\n\n    case 'cp': {\n      /* cp a b  ·  cp a folder/  ·  cp -r folder copy  — -f replaces what is there.\n         The store holds text, so this is read-and-write; undo removes the copies\n         (or puts back what -f replaced). */\n      if (ops.length < 2) return print('cp <from> <to>   (-f replaces an existing file)', 'err');\n      var cFrom = resolve(ops[0]), cTo = resolve(ops[1]);\n      if (!cTo) return print('cp needs a destination name', 'err');\n      var cIsDir = snap.folders.indexOf(cFrom) >= 0;\n      var cFile = snap.files.some(function(x){ return x.path === cFrom; });\n      if (!cIsDir && !cFile) return print('No such file or folder: ' + cFrom, 'err');\n      var into = snap.folders.indexOf(cTo) >= 0 || /\\/$/.test(ops[1]);\n      var pairs = cIsDir\n        ? snap.files.filter(function(x){ return x.path.indexOf(cFrom + '/') === 0; }).map(function(x){\n            return [x.path, (into ? cTo + '/' + cFrom.split('/').pop() : cTo) + x.path.slice(cFrom.length)]; })\n        : [[cFrom, into ? cTo + '/' + cFrom.split('/').pop() : cTo]];\n      if (!pairs.length) return print(cFrom + '/ is empty', 'dim');\n      var clashes = pairs.filter(function(pr){ return snap.files.some(function(x){ return x.path === pr[1]; }); });\n      if (clashes.length && !flags.f) return print(clashes[0][1] + (clashes.length > 1 ? ' and ' + (clashes.length - 1) + ' more' : '') + ' already exist' + (clashes.length > 1 ? '' : 's') + ' — use  cp -f  to replace', 'err');\n      var items = [];\n      for (var ci = 0; ci < pairs.length; ci++){\n        var cBody = await files.read(pairs[ci][0]);\n        if (cBody == null){ print('skipped ' + pairs[ci][0] + ' (not readable as text)', 'dim'); continue; }\n        var cPrev = await files.read(pairs[ci][1]);\n        await files.write(pairs[ci][1], cBody);\n        items.push({ path: pairs[ci][1], prev: cPrev });\n      }\n      if (!items.length) return print('nothing copied', 'dim');\n      remember({ type: 'cp', to: cIsDir ? (into ? cTo + '/' + cFrom.split('/').pop() : cTo) + '/' : items[0].path, items: items });\n      haptic('success');\n      return print('copied ' + (items.length === 1 ? cFrom + ' -> ' + items[0].path : items.length + ' files to ' + (into ? cTo + '/' + cFrom.split('/').pop() : cTo) + '/') + '  —  undo  removes the copy', 'ok');\n    }\n\n    case 'rm': case 'rmdir': {\n      if (!target) return print(verb + ' needs a path', 'err');\n      var isDir = snap.folders.indexOf(target) >= 0;\n      var isFile = snap.files.some(function(x){ return x.path === target; });\n      if (!isDir && !isFile) return print('No such file or folder: ' + target, 'err');\n      if (verb === 'rm' && isDir) return print(target + ' is a folder — use rmdir', 'err');\n      if (verb === 'rmdir' && !isDir) return print(target + ' is not a folder — use rm', 'err');\n      var count = isDir ? snap.files.filter(function(x){ return x.path.indexOf(target+'/') === 0; }).length : 1;\n      if (inTrash(target) || flags.p){\n        /* Already in the trash, or explicitly permanent: this one really is gone,\n           so it still has to be said twice. */\n        pending = { verb: verb, target: target, count: count };\n        return print('delete ' + target + (isDir ? '/ and its ' + count + ' file(s)' : '') + ' for good? no undo — type  y  to confirm', 'err');\n      }\n      var dest = trashPath(target);\n      await files.move(target, dest);\n      remember({ type: 'rm', from: target, to: dest, isDir: isDir });\n      haptic('warning');\n      return print('moved ' + target + (isDir ? '/ (' + count + ' file(s))' : '') + ' to ' + TRASH + '  \\u2014  undo  puts it back', 'ok');\n    }\n\n    case 'undo': {\n      /* Reverses the newest change — all of it, if it was an approved batch.\n         The stack is kept in app storage, so it survives closing Shell. */\n      if (!undoStack.length) return print('nothing to undo', 'dim');\n      var top = undoStack[undoStack.length - 1], group = [];\n      if (top.batch != null){ while (undoStack.length && undoStack[undoStack.length - 1].batch === top.batch) group.push(undoStack.pop()); }\n      else group.push(undoStack.pop());\n      if (group.length > 1) print('undoing a batch of ' + group.length + ' changes', 'dim');\n      for (var gi = 0; gi < group.length; gi++){\n        var okU = await undoOne(group[gi]);\n        if (okU === false){ undoStack.push.apply(undoStack, group.slice(gi).reverse()); break; }\n        changeLog.push({ id: Date.now() + Math.random(), t: Date.now(), text: 'undid: ' + describeOp(group[gi]) });\n      }\n      if (changeLog.length > 200) changeLog.splice(0, changeLog.length - 200);\n      saveUndo(); saveLog();\n      haptic('success');\n      return;\n    }\n\n    case 'log': {\n      /* Every change made here — by you, or proposals you approved — newest\n         first, kept between sessions. \"undo\" marks what  undo  can still reverse. */\n      if (!changeLog.length) return print('no changes yet', 'dim');\n      var howMany = Math.max(1, Math.min(ops[0] && !isNaN(+ops[0]) ? +ops[0] : 20, 200));\n      var live = {}; undoStack.forEach(function(u){ live[u.id] = true; });\n      var nextUndo = undoStack.length ? undoStack[undoStack.length - 1].id : null;\n      print(changeLog.slice(-howMany).reverse().map(function(e, i4){\n        return '#' + (i4 + 1) + '\\t' + when(e.t) + '\\t' + e.text + (e.id === nextUndo ? '   ← undo reverses this' : live[e.id] ? '   (undoable)' : '');\n      }).join('\\n'));\n      return note('trash  lists deleted files;  restore <path>  puts one back');\n    }\n\n    case 'history': {\n      /* No path? Then you meant the other kind of history — the commands you\n         typed. With a path it is the file's own versions, as the native\n         workspace_shell tool spells it, and that meaning does not move. */\n      if (!ops.length){\n        if (!cmdHistory.length) return print('no commands yet', 'dim');\n        var hStart = Math.max(0, cmdHistory.length - 30);\n        print(cmdHistory.slice(hStart).map(function(c, i){ return (hStart + i + 1) + '\\t' + c; }).join('\\n'));\n        return print('!5 runs number 5, !! runs the last one again', 'dim');\n      }\n      if (!files.versions) return print('Version history needs the latest MyLLM build.', 'err');\n      var vs = await files.versions(target);\n      if (!vs.length) return print('No previous versions of ' + target + ' \\u2014 versions are kept from the first overwrite or delete.', 'dim');\n      print(vs.map(function(v, i){ return '#' + (i + 1) + '\\t' + when(v.stamp) + '\\t' + bytes(v.size); }).join('\\n'));\n      return print('revert ' + target + ' N  puts one back', 'dim');\n    }\n\n    case 'revert': {\n      if (!target) return print('revert needs a path', 'err');\n      if (!files.restoreVersion) return print('Version history needs the latest MyLLM build.', 'err');\n      var vn = ops[1] ? parseInt(ops[1], 10) : 1;\n      var vlist = await files.versions(target);\n      if (!vlist.length) return print('No previous versions of ' + target, 'dim');\n      if (!(vn >= 1 && vn <= vlist.length)) return print('revert: choose 1\\u2013' + vlist.length + ' (see  history ' + target + ')', 'err');\n      /* The store snapshots the current bytes before restoring, so undo is\n         simply \"restore the newest version\". */\n      await files.restoreVersion(target, vlist[vn - 1].stamp);\n      remember({ type: 'revert', path: target });\n      haptic('success');\n      return print('reverted ' + target + ' to #' + vn + ' (' + when(vlist[vn - 1].stamp) + ')  \\u2014  undo  puts it back', 'ok');\n    }\n\n    case 'trash': {\n      if ((ops[0] || '').toLowerCase() === 'empty'){\n        var all = await snapshot(true);\n        var inside = all.files.filter(function(x){ return inTrash(x.path); });\n        if (!inside.length && all.folders.indexOf(TRASH) < 0) return print(TRASH + ' is empty', 'dim');\n        pending = { verb: 'trash-empty', count: inside.length };\n        return print('delete ' + inside.length + ' file(s) in ' + TRASH + ' for good? no undo — type  y  to confirm', 'err');\n      }\n      var allT = await snapshot(true);\n      if (allT.folders.indexOf(TRASH) < 0) return print(TRASH + ' is empty', 'dim');\n      print(TRASH + '/  \\u2014  restore <path> puts something back, trash empty clears it', 'dim');\n      return listing(allT, TRASH, true);\n    }\n\n    case 'restore': {\n      if (!ops[0]) return print('restore needs a path as shown by  trash', 'err');\n      var all2 = await snapshot(true);\n      var src = normalise(ops[0]);\n      if (!inTrash(src)) src = TRASH + '/' + src;\n      var back = src.slice(TRASH.length + 1).replace(/~\\d{14}(?=\\.[^.\\/]+$|$)/, '');\n      var known = all2.files.some(function(x){ return x.path === src; }) || all2.folders.indexOf(src) >= 0;\n      if (!known) return print('Not in ' + TRASH + ': ' + src.slice(TRASH.length + 1), 'err');\n      var clash = all2.files.some(function(x){ return x.path === back; }) || all2.folders.indexOf(back) >= 0;\n      if (clash && !flags.f) return print(back + ' already exists — use  restore -f  to replace it', 'err');\n      await files.move(src, back);\n      await pruneTrash();\n      remember({ type: 'mv', from: src, to: back });\n      haptic('success');\n      return print('restored ' + back, 'ok');\n    }\n\n    default:\n      /* Not a command? Then it was a question. This is the line that turns a\n         terminal into an assistant that happens to live in a directory. */\n      print('thinking…', 'dim');\n      return agent(line);\n  }\n}\n\nfunction remember(op){\n  op.id = Date.now() + Math.random();\n  if (batchId != null) op.batch = batchId;\n  undoStack.push(op);\n  if (undoStack.length > 30) undoStack.shift();\n  changeLog.push({ id: op.id, t: Date.now(), text: describeOp(op) + (op.batch != null ? '  (batch)' : '') });\n  if (changeLog.length > 200) changeLog.shift();\n  saveUndo(); saveLog();\n}\nfunction describeOp(op){\n  switch (op.type){\n    case 'rm': return 'moved ' + op.from + (op.isDir ? '/' : '') + ' to ' + TRASH;\n    case 'mv': return op.from + ' -> ' + op.to;\n    case 'mkdir': return 'created ' + op.path + '/';\n    case 'write': return (op.how || (op.prev == null ? 'created ' : 'changed ')) + op.path;\n    case 'revert': return 'reverted ' + op.path;\n    case 'cp': return 'copied ' + op.items.length + ' file(s) to ' + op.to;\n  }\n  return op.type;\n}\n/* Reverse one change. Returns false when it cannot be done safely. */\nasync function undoOne(op){\n  switch (op.type){\n    case 'rm': await files.move(op.to, op.from); await pruneTrash(); print('restored ' + op.from, 'ok'); break;\n    case 'revert': {\n      var rv = files.versions ? await files.versions(op.path) : [];\n      if (rv.length) { await files.restoreVersion(op.path, rv[0].stamp); print('restored ' + op.path + ' to before the revert', 'ok'); }\n      else print('nothing to restore for ' + op.path, 'dim');\n      break;\n    }\n    case 'mv': await files.move(op.to, op.from); print(op.to + ' -> ' + op.from, 'ok'); break;\n    case 'mkdir': await files.removeFolder(op.path, false); print('removed ' + op.path + '/', 'ok'); break;\n    case 'write':\n      if (op.prevLost){ print('cannot undo ' + op.path + ': the earlier text was too big to keep after Shell closed — try  history ' + op.path, 'err'); return false; }\n      if (op.prev == null){ await files.remove(op.path); print('removed ' + op.path, 'ok'); }\n      else { await files.write(op.path, op.prev); print('restored ' + op.path + ' (' + op.prev.length + ' chars)', 'ok'); }\n      break;\n    case 'cp':\n      for (var i = op.items.length - 1; i >= 0; i--){\n        var it = op.items[i];\n        if (it.prevLost){ print('cannot restore ' + it.path + ': the earlier text was too big to keep', 'err'); continue; }\n        if (it.prev == null) await files.remove(it.path); else await files.write(it.path, it.prev);\n      }\n      print('undid the copy of ' + op.items.length + ' file(s)', 'ok'); break;\n  }\n  return true;\n}\n\nfunction listing(snap, root, recursive, sortBy){\n  var prefix = root ? root + '/' : '';\n  if (root && snap.folders.indexOf(root) < 0){\n    var one = snap.files.filter(function(f){ return f.path === root; })[0];\n    if (one) return printHTML(pathHTML(one.path) + '\\t<span class=\"dim\">' + one.size + 'B\\t' + when(one.modified*1000) + '</span>');\n    return print('No such file or folder: ' + root, 'err');\n  }\n  var depth = prefix ? prefix.split('/').length : 1;\n  var subs = snap.folders.filter(function(f){\n    return f.indexOf(prefix) === 0 && f !== root && (recursive || f.split('/').length === depth);\n  }).sort();\n  var here = snap.files.filter(function(f){\n    return f.path.indexOf(prefix) === 0 && (recursive || f.path.split('/').length === depth);\n  }).sort(function(a,b){\n    /* -t newest first, -S biggest first; otherwise by name */\n    if (sortBy === 't' && a.modified !== b.modified) return b.modified - a.modified;\n    if (sortBy === 'S' && a.size !== b.size) return b.size - a.size;\n    return a.path < b.path ? -1 : 1;\n  });\n  if (!subs.length && !here.length) return print(root ? root + '/ is empty' : 'The workspace is empty', 'dim');\n  var html = subs.map(function(d){ return '<span class=\"dir\">' + pathHTML(d, d + '/') + '</span>'; })\n    .concat(here.map(function(f){\n      return pathHTML(f.path) + '\\t<span class=\"dim\">' + f.size + 'B\\t' + when(f.modified*1000) + '</span>';\n    })).join('\\n');\n  printHTML(html);\n}\n\n/* ================= the assistant, inside the directory =================\n   Type anything that is not a command and it becomes a question. The model is\n   given the working directory and the command list, and answers with ONE JSON\n   object per turn: run a command, or say something. The app executes the\n   command locally and feeds the output back — which is the whole trick, because\n   myllmAsk has no tools of its own. The shell commands ARE the tools.\n\n   READ-ONLY autonomously. Anything that writes or deletes comes back as a\n   proposal the user has to accept: a model running rm across someone's\n   documents unattended is the one outcome worth designing against. */\n\nvar READ_ONLY = ['ls','dir','tree','cat','head','tail','sed','stat','find','grep','diff','jq','wc','sort','uniq','cut','history','du','pwd','log'];\nvar MAX_STEPS = 5;          /* myllmAsk is rate-limited; five is plenty and stays inside it */\n\n/* The system prompt for the `ask` VERB — a filter, not an assistant. Anything\n   it says that is not the answer ends up in the user's file, so say none of it. */\nvar FILTER_SYSTEM = [\n  'You are a filter in a command-line pipeline, inside the user\\'s file workspace.',\n  'Do exactly what the instruction asks of the material you are given, and output ONLY the result.',\n  'No preamble, no sign-off, no explanation of what you did, no markdown code fences.',\n  'Plain text unless the instruction asks for another format. Never invent material you were not given.'\n].join('\\n');\n\nfunction systemPrompt(listing){\n  return [\n    'You are working inside a directory of the user\\'s MyLLMos shared workspace, like a terminal assistant.',\n    'Current directory: /' + (cwd || ''),\n    '',\n    'Contents right now:',\n    listing || '(empty)',\n    '',\n    'You may run these READ-ONLY commands: ls [-R] [-t newest first | -S biggest first] [path], tree [path], cat <path>, head -n N <path>, tail -n N <path>, sed -n \\'40,80p\\' <path> (a line range), stat <path>, find <glob> [-mtime -7] [-newer <path>] [-size +10k] [-type d], grep [-n] [-C N] [-v] [-c] [-l] [-s] <text or /regex/> [path], diff <a> <b> or diff <path>@N (version N vs now), jq \\'.field\\' <path> (pull values out of JSON: .a.b, .list[0], .list[], keys, length), wc [-l], sort [-r] [-n] [-k N], uniq [-c], cut -d X -f N, history <path> (previous versions), log (recent changes), du.',\n    'You may pipe them: `a | b` sends a\\'s output into b, and cat, head, tail, sed, grep, wc, sort, uniq, cut and jq read what is piped in — e.g. `grep -l invoice notes | wc -l` or `find *.md | cut -d / -f 1 | sort | uniq -c | sort -rn`. One pipeline is one step, so prefer it over three separate looks.',\n    'Paths are relative to the current directory. There is no cd.',\n    'Writing output to a file with > or >> is a CHANGE: propose it, never run it.',\n    '',\n    'Reply with ONE JSON object and nothing else:',\n    '  {\"run\":\"<command>\"}                     to look at something first',\n    '  {\"say\":\"<answer>\"}                      when you can answer',\n    '  {\"propose\":\"<command>\",\"why\":\"<reason>\"} to CHANGE something (mkdir, mv, cp, write, replace, edit, rm, rmdir, revert <path> N) — the user approves it, you never run it. rm moves to a trash folder and can be undone; revert puts a previous version back.',\n    '  {\"propose\":[\"<command>\",\"<command>\",…],\"why\":\"<reason>\"} for several changes approved together, e.g. a folder reorganisation: they run in order, stop at the first failure, and one undo reverses all of them.',\n    'To change part of a file, propose a SMALL edit rather than rewriting it: replace <path> \"old text\" \"new text\" (every occurrence; -1 for the first only), or edit <path> <A-B> \"new lines\" (\\\\n for a line break; empty text deletes the lines; <A>+ inserts after line A). The user sees the diff before approving. Use write only for a new file or a full rewrite.',\n    '',\n    'Prefer running a command over guessing. Answer in plain prose, briefly. Do not invent file contents.'\n  ].join('\\n');\n}\n\nasync function runCaptured(line){\n  /* The agent's steps stay visible on screen (silent: false) — watching it look\n     around is most of why the loop is trustworthy. */\n  var text = await captureOf(function(){ return runLine(line); }, false);\n  return text.length > 4000 ? text.slice(0, 4000) + '\\n[truncated]' : text;\n}\n\nfunction parseReply(raw){\n  var t = String(raw || '').trim();\n  /* Models fence JSON even when told not to. */\n  t = t.replace(/^```(?:json)?/i, '').replace(/```$/, '').trim();\n  var a = t.indexOf('{'), b = t.lastIndexOf('}');\n  if (a < 0 || b < a) return null;\n  try { return JSON.parse(t.slice(a, b + 1)); } catch(e){ return null; }\n}\n\nasync function agent(question){\n  if (!window.myllmAsk){\n    print('AI is off for apps — turn on \"Allow apps to use the AI\" in MyLLMos settings.', 'err');\n    return;\n  }\n  var snap = await snapshot();\n  capture = []; listing(snap, cwd, false); var here = capture.join('\\n'); capture = null;\n\n  var transcript = 'User: ' + question;\n  for (var step = 0; step < MAX_STEPS; step++){\n    var raw;\n    try { raw = await myllmAsk(transcript + '\\n\\nReply with one JSON object.', { system: systemPrompt(here) }); }\n    catch(e){ print('ask failed: ' + (e.message || e), 'err'); return; }\n\n    var reply = parseReply(raw);\n    if (!reply){\n      /* Not JSON — treat it as the answer rather than failing in the user's face. */\n      print(String(raw).trim(), 'say');\n      return;\n    }\n    if (reply.say){ print(String(reply.say).trim(), 'say'); return; }\n\n    if (reply.propose){\n      var why = reply.why ? ' — ' + reply.why : '';\n      /* A list (or a multi-line string) is a batch: one approval, run in order. */\n      var steps = Array.isArray(reply.propose) ? reply.propose.map(String)\n        : String(reply.propose).split('\\n');\n      steps = steps.map(function(x){ return x.trim(); }).filter(Boolean).slice(0, 20);\n      if (!steps.length){ print(String(raw).trim(), 'say'); return; }\n      if (steps.length === 1){\n        print('proposes: ' + steps[0] + why, 'propose');\n        await previewEdit(steps[0]);\n        print('run it? type  y  to confirm', 'propose');\n        pending = { verb: 'raw', line: steps[0] };\n        return;\n      }\n      print('proposes ' + steps.length + ' changes' + why + ':', 'propose');\n      for (var si2 = 0; si2 < steps.length; si2++){\n        print('  ' + (si2 + 1) + '. ' + steps[si2], 'propose');\n        await previewEdit(steps[si2]);\n      }\n      print('run all ' + steps.length + '? type  y  to confirm — one  undo  reverses the lot', 'propose');\n      pending = { verb: 'batch', lines: steps };\n      return;\n    }\n    if (reply.run){\n      var cmd = String(reply.run).trim();\n      /* Every stage, not just the first verb — and a redirect turns a pipeline\n         of read-only commands into a write, which is exactly the hole worth\n         closing before the model finds it. */\n      var why = unsafeReason(cmd, READ_ONLY);\n      if (why){\n        transcript += '\\n\\nAssistant tried: ' + cmd + '\\nBlocked: ' + why + '. Use \"propose\" for anything that changes files.';\n        continue;\n      }\n      print('$ ' + cmd, 'step');\n      var output = await runCaptured(cmd);\n      transcript += '\\n\\nAssistant ran: ' + cmd + '\\nOutput:\\n' + (output || '(no output)');\n      continue;\n    }\n    print(String(raw).trim(), 'say');\n    return;\n  }\n  print('Stopped after ' + MAX_STEPS + ' steps. Ask something narrower, or run the commands yourself.', 'dim');\n}\n\n/* ---------- prompt ---------- */\n\ndocument.getElementById('form').addEventListener('submit', async function(ev){\n  ev.preventDefault();\n  var line = input.value.trim();\n  input.value = '';\n  if (!line) return;\n\n  if (pending){\n    var p = pending; pending = null;\n    if (line.toLowerCase() === 'y' || line.toLowerCase() === 'yes'){\n      try{\n        if (p.verb === 'raw'){ print('$ ' + p.line, 'cmd'); await runLine(p.line); }\n        else if (p.verb === 'batch'){\n          batchId = Date.now();\n          try {\n            for (var bi = 0; bi < p.lines.length; bi++){\n              print('$ ' + p.lines[bi], 'cmd');\n              await captureOf(function(){ return runLine(p.lines[bi]); }, false);\n              if (lastCaptureError){ print('stopped at step ' + (bi + 1) + ' of ' + p.lines.length + ' — undo reverses the steps that ran', 'err'); break; }\n            }\n          } finally { batchId = null; }\n        }\n        else if (p.verb === 'trash-empty') await files.removeFolder(TRASH, true);\n        else if (p.verb === 'rm') await files.remove(p.target);\n        else await files.removeFolder(p.target, true);\n        haptic('warning');\n        if (p.verb === 'trash-empty') print('emptied ' + TRASH, 'ok');\n        else if (p.verb !== 'raw' && p.verb !== 'batch') print('deleted ' + p.target, 'ok');\n      }catch(e){ print(e.message, 'err'); }\n    } else print('cancelled', 'dim');\n    paintPrompt(); renderChips();\n    return;\n  }\n\n  /* !! and friends resolve here, so the scrollback and the history both record\n     the command that actually ran rather than the shorthand for it. */\n  if (line.charAt(0) === '!'){\n    var recalled = expandBang(line);\n    if (!recalled){ print(prompt$() + ' \\u276f ' + line, 'cmd'); print('no matching command in history', 'err'); renderChips(); return; }\n    line = recalled;\n  }\n\n  cmdHistory.push(line); hIndex = cmdHistory.length;\n  if (cmdHistory.length > 200) cmdHistory.shift();\n  saveHistory();\n  print(prompt$() + ' \\u276f ' + line, 'cmd');\n  try { await runLine(line); }\n  catch(e){ print(String(e && e.message || e), 'err'); }\n  stdin = null;\n  paintPrompt();\n  renderChips();\n});\n\n/* Up/down through history, as a shell does. */\ninput.addEventListener('keydown', function(e){\n  if (e.key === 'ArrowUp'){ if (hIndex > 0){ hIndex--; input.value = cmdHistory[hIndex]; } e.preventDefault(); }\n  if (e.key === 'ArrowDown'){ if (hIndex < cmdHistory.length-1){ hIndex++; input.value = cmdHistory[hIndex]; } else { hIndex = cmdHistory.length; input.value = ''; } e.preventDefault(); }\n});\n\n/* ---------- completion, for a keyboard with no Tab key ----------\n   The chip row follows what you type: verbs while you type the first word,\n   then names from the folder you are pointing at. A folder completes with a\n   trailing slash and keeps going. Empty input shows the usual shortcuts. */\nvar chipsEl = document.getElementById('chips');\nvar DEFAULT_CHIPS = ['ls','ls -R','ask ','grep ','open ','help'];\nvar SINKS = ['grep','sort','uniq','wc','cut','jq','head','ask'];   /* the commands that read a pipe */\n/* The last | that is not inside quotes. */\nfunction lastPipe(v){\n  var q = null, at = -1;\n  for (var i = 0; i < v.length; i++){\n    var c = v.charAt(i);\n    if (q){ if (c === q) q = null; continue; }\n    if (c === '\"' || c === \"'\") q = c;\n    else if (c === '|') at = i;\n    else if (c === '>') return at;   /* past a redirect you are naming a file again */\n  }\n  return at;\n}\n\nfunction chip(label, cls, onTap){\n  var b = document.createElement('button');\n  b.className = 'chip' + (cls ? ' ' + cls : ''); b.type = 'button'; b.textContent = label;\n  b.addEventListener('pointerdown', function(e){ e.preventDefault(); });  /* keep the keyboard up */\n  b.addEventListener('click', onTap);\n  return b;\n}\nfunction setInput(v){ input.value = v; input.focus(); renderChips(); }\n\nfunction renderChips(){\n  chipsEl.innerHTML = '';\n  var v = input.value, atStart = v.length === 0;\n  if (pending){ [['y','ok'],['n','dim']].forEach(function(x){ chipsEl.appendChild(chip(x[0], '', function(){ setInput(x[0]); })); }); return; }\n  if (atStart){\n    DEFAULT_CHIPS.forEach(function(c){ chipsEl.appendChild(chip(c, '', function(){ setInput(c); })); });\n    if (undoStack.length) chipsEl.appendChild(chip('undo', 'undo', function(){ setInput('undo'); }));\n    if (cwd) chipsEl.appendChild(chip('cd ..', 'dirc', function(){ setInput('cd ..'); }));\n    return;\n  }\n  var endsWithSpace = /\\s$/.test(v);\n  var tokens = tokenize(v);\n  var partial = endsWithSpace ? '' : (tokens[tokens.length - 1] || '');\n  var head = endsWithSpace ? v : v.slice(0, v.length - partial.length);\n  /* Completion follows the STAGE, not the line: after a pipe you are naming a\n     command again, so offering file names there would be offering the one thing\n     that cannot go next. */\n  var pipeAt = lastPipe(v);\n  var stageTokens = tokenize(pipeAt >= 0 ? v.slice(pipeAt + 1) : v);\n  var firstWord = stageTokens.length === 0 || (stageTokens.length === 1 && !endsWithSpace);\n  var items = [];\n  if (firstWord){\n    /* Straight after a pipe, lead with the commands that can actually read one. */\n    if (pipeAt >= 0 && !partial)\n      SINKS.forEach(function(x){ items.push({ label: x, value: x + ' ', cls: 'comp' }); });\n    Object.keys(aliases).sort().filter(function(x){ return x.indexOf(partial.toLowerCase()) === 0 && x !== partial; })\n      .forEach(function(x){ items.push({ label: x, value: x + ' ', cls: 'undo' }); });\n    VERBS.filter(function(x){ return x.indexOf(partial.toLowerCase()) === 0 && x !== partial\n                                     && !(pipeAt >= 0 && !partial && SINKS.indexOf(x) >= 0); })\n      .forEach(function(x){ items.push({ label: x, value: x + ' ', cls: '' }); });\n  } else if (lastSnap){\n    var slash = partial.lastIndexOf('/');\n    var dirPart = slash >= 0 ? partial.slice(0, slash + 1) : '';\n    var namePart = slash >= 0 ? partial.slice(slash + 1) : partial;\n    var base = resolve(dirPart || '.');\n    var prefix = base ? base + '/' : '';\n    var depth = prefix ? prefix.split('/').length : 1;\n    var seen = {};\n    var showHidden = inTrash(base) || namePart.charAt(0) === '.';\n    lastSnap.folders.forEach(function(d){\n      if (d.indexOf(prefix) !== 0 || d === base || d.split('/').length !== depth) return;\n      if (!showHidden && inTrash(d)) return;\n      var name = d.slice(prefix.length);\n      if (name.toLowerCase().indexOf(namePart.toLowerCase()) === 0 && !seen[name]){ seen[name] = 1; items.push({ label: name + '/', value: dirPart + name + '/', cls: 'dirc' }); }\n    });\n    lastSnap.files.forEach(function(f){\n      if (f.path.indexOf(prefix) !== 0 || f.path.split('/').length !== depth) return;\n      if (!showHidden && inTrash(f.path)) return;\n      var name = f.path.slice(prefix.length);\n      if (name.toLowerCase().indexOf(namePart.toLowerCase()) === 0 && !seen[name] && name !== namePart){ seen[name] = 1; items.push({ label: name, value: dirPart + name, cls: 'comp' }); }\n    });\n    if (base && !namePart) items.push({ label: '..', value: dirPart + '../', cls: 'dirc' });\n  }\n  /* On a phone | and > live two taps down in the symbol plane, which is enough\n     friction to stop anyone discovering pipelines at all. */\n  if (!firstWord && isCommandLine(v) && !/[|>]/.test(v)){\n    var base = v.replace(/\\s+$/, '');\n    items.unshift({ label: '>', value: null, cls: 'undo', raw: base + ' > ' });\n    items.unshift({ label: '|', value: null, cls: 'undo', raw: base + ' | ' });\n  }\n\n  items.slice(0, 12).forEach(function(it){\n    chipsEl.appendChild(chip(it.label, it.cls, function(){\n      if (it.raw != null) return setInput(it.raw);\n      var val = /[\\s\"']/.test(it.value) ? '\"' + it.value + '\"' : it.value;\n      setInput(head + val);\n    }));\n  });\n  if (!items.length && !firstWord) DEFAULT_CHIPS.slice(0, 3).forEach(function(c){ chipsEl.appendChild(chip(c, 'dim', function(){ setInput(c); })); });\n}\ninput.addEventListener('input', renderChips);\ninput.addEventListener('focus', renderChips);\n\n/* Tap a path the shell printed and it lands in the prompt — appended after a\n   space if you were mid-command, or on its own if the prompt was empty. */\nout.addEventListener('click', function(e){\n  var el = e.target.closest('.path');\n  if (!el) return;\n  var p = el.getAttribute('data-path');\n  if (cwd && p.indexOf(cwd + '/') === 0) p = p.slice(cwd.length + 1);   /* relative to where you stand */\n  else if (cwd) p = '/' + p;\n  var val = /[\\s\"']/.test(p) ? '\"' + p + '\"' : p;\n  var v = input.value;\n  setInput(v && !/\\s$/.test(v) ? v + ' ' + val : v + val);\n  haptic('selection');\n});\nrenderChips();\n\npaintPrompt();\nprint('MyLLMos workspace shell. Type  help  for commands.', 'dim');\nprint('Anything that is not a command is a question — MyLLM answers it from here,', 'dim');\nprint('running the read-only commands itself and asking before it changes anything.', 'dim');\nprint('Pipe things about:  cat notes.md | ask \"summarise this\" > summary.md', 'dim');\nprint('rm moves things to .trash and  undo  reverses your last change. Tap any path to use it.', 'dim');\n\n/* History and aliases come back from storage before anything runs, so .shellrc\n   can use an alias it defined last time and !! works on the first line typed. */\n(async function boot(){\n  await loadState();\n  renderChips();\n  if (!window.myllmFiles){ print('\\nShared files are off — turn them on in MyLLMos settings.', 'err'); return; }\n  try { await runRC(); } catch(e){ print('.shellrc: ' + (e && e.message || e), 'err'); }\n  await runLine('ls');\n  paintPrompt();\n  renderChips();\n})();\n</script>\n</body></html>\n"}