{"name": "Shell", "kind": "html", "iconSymbol": "terminal", "iconColor": "gray", "html": "<!doctype html>\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Shell</title>\n<style>\n  *{box-sizing:border-box}\n  body{margin:0;background:#0d1117;color:#d6deeb;\n       font:13.5px/1.55 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;\n       display:flex;flex-direction:column;height:100dvh;overflow:hidden}\n  header{padding:10px 14px;border-bottom:1px solid #1e2733;display:flex;align-items:center;gap:10px}\n  header b{font-size:14px;color:#e7eef8;font-weight:650}\n  header .hint{font-size:11.5px;color:#6b7a90}\n  #out{flex:1;overflow:auto;padding:12px 14px 4px;white-space:pre-wrap;word-break:break-word}\n  .cmd{color:#7ee787}\n  .err{color:#ff7b72}\n  .ok{color:#79c0ff}\n  .dim{color:#6b7a90}\n  .dir{color:#79c0ff;font-weight:650}\n  form{display:flex;gap:8px;padding:10px 12px calc(10px + env(safe-area-inset-bottom));\n       border-top:1px solid #1e2733;background:#0d1117}\n  .ps1{color:#7ee787;align-self:center}\n  input{flex:1;background:#111823;border:1px solid #1e2733;border-radius:9px;color:#d6deeb;\n        padding:10px 11px;font:13.5px ui-monospace,SFMono-Regular,Menlo,monospace}\n  input:focus{outline:2px solid #1f6feb;outline-offset:-1px}\n  button{background:#1f6feb;border:0;color:#fff;border-radius:9px;padding:0 14px;font-weight:650;font-size:13.5px}\n  .chips{display:flex;gap:6px;overflow-x:auto;padding:0 12px 10px}\n  .chip{background:#111823;border:1px solid #1e2733;color:#9db2cd;border-radius:999px;\n        padding:6px 11px;font-size:12px;white-space:nowrap}\n</style></head>\n<body>\n\n<header>\n  <b>Shell</b>\n  <span class=\"hint\">the shared workspace, on the command line</span>\n</header>\n\n<div id=\"out\"></div>\n\n<div class=\"chips\" id=\"chips\"></div>\n\n<form id=\"form\" autocomplete=\"off\">\n  <span class=\"ps1\">$</span>\n  <input id=\"in\" placeholder=\"ls -R\" autocapitalize=\"off\" autocorrect=\"off\" spellcheck=\"false\">\n  <button type=\"submit\">Run</button>\n</form>\n\n<script>\n/* Shell over the MyLLMos shared workspace.\n   The command grammar deliberately MATCHES the assistant's `workspace_shell`\n   tool, so what you learn here is what you can ask MyLLM for in words — and what\n   it prints back to you looks like what it prints back to itself.\n\n   Difference: you are a person at a prompt, so this one can also WRITE. rm asks\n   first, because the store has no undo and no trash. */\nvar files = window.myllmFiles || null;\nvar out = document.getElementById('out');\nvar input = document.getElementById('in');\n/* NOT `history` — that is window.history (the History API), so `var history`\n   silently keeps the built-in and cmdHistory.push is undefined. The runtime\n   harness caught this; a regex scan never would. */\nvar cmdHistory = [];\nvar hIndex = -1;\nvar pending = null;      /* a confirmation waiting on y/n */\n\nvar HELP = [\n  'ls [-R] [path]     list a folder (-R for the whole tree)',\n  'tree [path]        same as ls -R',\n  'cat <path>         print a file',\n  'head [-n N] <path> first N lines (default 20)',\n  'tail [-n N] <path> last N lines',\n  'stat <path>        size, modified, type',\n  'find <glob>        match filenames, e.g. find *.json',\n  'du                 space used per folder',\n  'mkdir <path>       create a folder',\n  'mv <from> <to>     move or rename a file or folder',\n  'rm <path>          delete a file (asks first)',\n  'rmdir <path>       delete a folder (asks; refuses if not empty)',\n  'write <path>       type a line into a file (replaces it)',\n  'clear              clear the screen',\n  'help               this list'\n].join('\\n');\n\nfunction esc(s){ return String(s==null?'':s)\n  .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }\n\nfunction print(text, cls){\n  var d = document.createElement('div');\n  if (cls) d.className = cls;\n  d.innerHTML = esc(text);\n  out.appendChild(d);\n  out.scrollTop = out.scrollHeight;\n}\nfunction printHTML(html){\n  var d = document.createElement('div');\n  d.innerHTML = html;\n  out.appendChild(d);\n  out.scrollTop = out.scrollHeight;\n}\nfunction haptic(k){ try{ window.myllmHaptic && myllmHaptic(k); }catch(e){} }\n\n/* ---------- helpers that mirror the tool ---------- */\n\nfunction tokenize(s){\n  var outv = [], cur = '', q = null;\n  for (var i=0;i<s.length;i++){\n    var c = s[i];\n    if (q){ if (c === q) q = null; else cur += c; }\n    else if (c === '\"' || c === \"'\"){ q = c; }\n    else if (c === ' '){ if (cur){ outv.push(cur); cur = ''; } }\n    else cur += c;\n  }\n  if (cur) outv.push(cur);\n  return outv;\n}\n\nfunction normalise(p){\n  var s = String(p||'').trim();\n  while (s.indexOf('./') === 0) s = s.slice(2);\n  while (s.charAt(0) === '/') s = s.slice(1);\n  while (s.charAt(s.length-1) === '/') s = s.slice(0,-1);\n  return s === '.' ? '' : s;\n}\n\nfunction bytes(n){ return n < 1024 ? n + 'B' : (n/1024).toFixed(1) + 'K'; }\n\nfunction when(ms){\n  var d = new Date(ms);\n  function p(x){ return (x<10?'0':'') + x; }\n  return d.getFullYear() + '-' + p(d.getMonth()+1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());\n}\n\nfunction glob(pattern, name){\n  if (pattern.indexOf('*') < 0 && pattern.indexOf('?') < 0)\n    return name.toLowerCase().indexOf(pattern.toLowerCase()) >= 0;\n  var rx = '^' + pattern.replace(/[.+^${}()|[\\]\\\\]/g,'\\\\$&')\n                        .replace(/\\*/g,'.*').replace(/\\?/g,'.') + '$';\n  return new RegExp(rx,'i').test(name);\n}\n\nasync function snapshot(){\n  var list = await files.list();\n  var folders = await files.folders ? await files.folders() : [];\n  return { files: list, folders: folders };\n}\n\n/* ---------- commands ---------- */\n\nasync function run(line){\n  if (!files){ print('Shared files are off. Turn on \"Shared files\" in MyLLMos settings.', 'err'); return; }\n  var argv = tokenize(line);\n  var verb = (argv.shift()||'').toLowerCase();\n\n  var flags = {}, n = 20, ops = [];\n  for (var i=0;i<argv.length;i++){\n    var a = argv[i];\n    if (a === '-n' && argv[i+1] && !isNaN(+argv[i+1])){ n = Math.max(1, Math.min(+argv[i+1], 500)); i++; continue; }\n    if (a.charAt(0) === '-'){ a.slice(1).split('').forEach(function(f){ flags[f] = true; }); continue; }\n    ops.push(a);\n  }\n  var target = normalise(ops[0] || '');\n  var snap = await snapshot();\n\n  switch (verb){\n    case 'help': print(HELP, 'dim'); return;\n    case 'clear': out.innerHTML = ''; return;\n    case 'pwd': print('/ (workspace root — all paths are relative; there is no cd)', 'dim'); return;\n\n    case 'ls': case 'dir': case 'tree':\n      return listing(snap, target, verb === 'tree' || flags.R || flags.r);\n\n    case 'cat': case 'head': case 'tail': {\n      if (!target) return print(verb + ' needs a path', 'err');\n      var text = await files.read(target);\n      if (text == null) return print('No such file: ' + target, 'err');\n      if (verb === 'cat') return print(text);\n      var lines = text.split('\\n');\n      print((verb === 'head' ? lines.slice(0, n) : lines.slice(-n)).join('\\n'));\n      if (lines.length > n) print('[' + lines.length + ' lines total]', 'dim');\n      return;\n    }\n\n    case 'stat': {\n      var f = snap.files.filter(function(x){ return x.path === target; })[0];\n      if (f) return print(f.path + '\\ntype: file\\nsize: ' + f.size + ' bytes\\nmodified: ' + when(f.modified*1000));\n      if (snap.folders.indexOf(target) >= 0){\n        var inside = snap.files.filter(function(x){ return x.path.indexOf(target + '/') === 0; });\n        var total = inside.reduce(function(a,b){ return a + b.size; }, 0);\n        return print(target + '/\\ntype: folder\\ncontains: ' + inside.length + ' file(s), ' + total + ' bytes');\n      }\n      return print('No such file or folder: ' + target, 'err');\n    }\n\n    case 'find': {\n      if (!ops[0]) return print('find needs a name or glob, e.g. find *.json', 'err');\n      var hits = snap.files.map(function(f){ return f.path; }).filter(function(p){\n        return glob(ops[0], p.split('/').pop()) || glob(ops[0], p);\n      });\n      return print(hits.length ? hits.sort().join('\\n') : 'No match for ' + ops[0], hits.length ? '' : 'dim');\n    }\n\n    case 'du': {\n      var byDir = {};\n      snap.files.forEach(function(f){\n        var d = f.path.indexOf('/') < 0 ? '.' : f.path.slice(0, f.path.lastIndexOf('/'));\n        byDir[d] = (byDir[d]||0) + f.size;\n      });\n      var rows = Object.keys(byDir).sort(function(a,b){ return byDir[b]-byDir[a]; })\n        .map(function(d){ return bytes(byDir[d]) + '\\t' + d; });\n      var total = snap.files.reduce(function(a,b){ return a + b.size; }, 0);\n      return print(rows.concat([bytes(total) + '\\ttotal of 25 MB']).join('\\n'));\n    }\n\n    /* ---- mutations: this is a person at a prompt, so they are allowed ---- */\n\n    case 'mkdir':\n      if (!target) return print('mkdir needs a path', 'err');\n      await files.makeFolder(target);\n      haptic('success');\n      return print('created ' + target + '/', 'ok');\n\n    case 'mv': {\n      if (ops.length < 2) return print('mv needs a source and a destination', 'err');\n      var to = normalise(ops[1]);\n      await files.move(target, to);\n      haptic('success');\n      return print(target + ' -> ' + to, 'ok');\n    }\n\n    case 'write': {\n      if (!target) return print('write needs a path', 'err');\n      var body = line.slice(line.indexOf(ops[0]) + ops[0].length).trim();\n      if (!body) return print('write <path> <text>  — the text replaces the file', 'err');\n      await files.write(target, body);\n      haptic('success');\n      return print('wrote ' + body.length + ' chars to ' + target, 'ok');\n    }\n\n    case 'rm': case 'rmdir': {\n      if (!target) return print(verb + ' needs a path', 'err');\n      var isDir = snap.folders.indexOf(target) >= 0;\n      if (verb === 'rm' && isDir) return print(target + ' is a folder — use rmdir', 'err');\n      if (verb === 'rmdir' && !isDir) return print(target + ' is not a folder — use rm', 'err');\n      var count = isDir ? snap.files.filter(function(x){ return x.path.indexOf(target+'/') === 0; }).length : 1;\n      /* No undo, no trash. A one-word delete of someone's documents should have\n         to be said twice. */\n      pending = { verb: verb, target: target, count: count };\n      return print('delete ' + target + (isDir ? '/ and its ' + count + ' file(s)' : '') + '? there is no undo — type  y  to confirm', 'err');\n    }\n\n    default:\n      return print('Unknown command: ' + verb + '  (type help)', 'err');\n  }\n}\n\nfunction listing(snap, root, recursive){\n  var prefix = root ? root + '/' : '';\n  if (root && snap.folders.indexOf(root) < 0){\n    var one = snap.files.filter(function(f){ return f.path === root; })[0];\n    if (one) return print(one.path + '\\t' + one.size + 'B\\t' + when(one.modified*1000));\n    return print('No such file or folder: ' + root, 'err');\n  }\n  var depth = prefix ? prefix.split('/').length : 1;\n  var subs = snap.folders.filter(function(f){\n    return f.indexOf(prefix) === 0 && f !== root && (recursive || f.split('/').length === depth);\n  }).sort();\n  var here = snap.files.filter(function(f){\n    return f.path.indexOf(prefix) === 0 && (recursive || f.path.split('/').length === depth);\n  }).sort(function(a,b){ return a.path < b.path ? -1 : 1; });\n  if (!subs.length && !here.length) return print(root ? root + '/ is empty' : 'The workspace is empty', 'dim');\n  var html = subs.map(function(d){ return '<span class=\"dir\">' + esc(d) + '/</span>'; })\n    .concat(here.map(function(f){\n      return esc(f.path) + '\\t<span class=\"dim\">' + f.size + 'B\\t' + when(f.modified*1000) + '</span>';\n    })).join('\\n');\n  printHTML(html);\n}\n\n/* ---------- prompt ---------- */\n\ndocument.getElementById('form').addEventListener('submit', async function(ev){\n  ev.preventDefault();\n  var line = input.value.trim();\n  input.value = '';\n  if (!line) return;\n\n  if (pending){\n    var p = pending; pending = null;\n    if (line.toLowerCase() === 'y' || line.toLowerCase() === 'yes'){\n      try{\n        if (p.verb === 'rm') await files.remove(p.target);\n        else await files.removeFolder(p.target, true);\n        haptic('warning');\n        print('deleted ' + p.target, 'ok');\n      }catch(e){ print(e.message, 'err'); }\n    } else print('cancelled', 'dim');\n    return;\n  }\n\n  cmdHistory.push(line); hIndex = cmdHistory.length;\n  print('$ ' + line, 'cmd');\n  try { await run(line); }\n  catch(e){ print(String(e && e.message || e), 'err'); }\n});\n\n/* Up/down through history, as a shell does. */\ninput.addEventListener('keydown', function(e){\n  if (e.key === 'ArrowUp'){ if (hIndex > 0){ hIndex--; input.value = cmdHistory[hIndex]; } e.preventDefault(); }\n  if (e.key === 'ArrowDown'){ if (hIndex < cmdHistory.length-1){ hIndex++; input.value = cmdHistory[hIndex]; } else { hIndex = cmdHistory.length; input.value = ''; } e.preventDefault(); }\n});\n\n['ls -R','du','find *.json','help'].forEach(function(c){\n  var b = document.createElement('button');\n  b.className = 'chip'; b.type = 'button'; b.textContent = c;\n  b.onclick = function(){ input.value = c; input.focus(); };\n  document.getElementById('chips').appendChild(b);\n});\n\nprint('MyLLMos workspace shell. Type  help  for commands.', 'dim');\nprint('The same commands work when you ask MyLLM — it has this shell too.', 'dim');\nif (!window.myllmFiles) print('\\nShared files are off — turn them on in MyLLMos settings.', 'err');\nelse run('ls');\n</script>\n</body></html>\n"}