{"name": "Shell", "kind": "html", "iconSymbol": "terminal", "iconColor": "gray", "html": "<!doctype html>\n<!--\n  Shell — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Shell</title>\n<style>\n  *{box-sizing:border-box}\n  body{margin:0;background:#0d1117;color:#d6deeb;\n       font:13.5px/1.55 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;\n       display:flex;flex-direction:column;height:100dvh;overflow:hidden}\n  header{padding:10px 14px;border-bottom:1px solid #1e2733;display:flex;align-items:center;gap:10px}\n  header b{font-size:14px;color:#e7eef8;font-weight:650}\n  header .hint{font-size:11.5px;color:#6b7a90}\n  #out{flex:1;overflow:auto;padding:12px 14px 4px;white-space:pre-wrap;word-break:break-word}\n  .cmd{color:#7ee787}\n  .err{color:#ff7b72}\n  .ok{color:#79c0ff}\n  .dim{color:#6b7a90}\n  .dir{color:#79c0ff;font-weight:650}\n  /* The composer, shaped like Claude Code's: one quiet bordered box with a\n     chevron, the text filling it, and a status line underneath. No Run button —\n     Return submits, and a button competing with the prompt is the thing that\n     made this look like a form rather than a terminal. */\n  .composer{padding:0 12px calc(12px + env(safe-area-inset-bottom));background:#0d1117}\n  .composer hr{border:0;border-top:1px solid #1e2733;margin:0 -12px 10px}\n  form{display:flex;gap:9px;align-items:center;background:#0d1117;\n       border:1px solid #2a3646;border-radius:10px;padding:11px 12px}\n  form:focus-within{border-color:#3c5680}\n  .ps1{color:#6b7a90;align-self:center;user-select:none}\n  input{flex:1;min-width:0;background:transparent;border:0;color:#d6deeb;padding:0;\n        font:13.5px ui-monospace,SFMono-Regular,Menlo,monospace}\n  input:focus{outline:none}\n  input::placeholder{color:#3f4c5f}\n  /* One line, always. A status bar that wraps stops reading as a status bar —\n     the left half truncates, the right half is short enough never to. */\n  .statusbar{display:flex;justify-content:space-between;align-items:baseline;gap:12px;\n             padding:8px 3px 0;font-size:11.5px;color:#6b7a90;white-space:nowrap}\n  .statusbar .left{color:#7ee787;overflow:hidden;text-overflow:ellipsis;min-width:0}\n  .statusbar .right{color:#6b7a90;flex:none}\n  .chips{display:flex;gap:6px;overflow-x:auto;padding:0 12px 10px}\n  .chip{background:#111823;border:1px solid #1e2733;color:#9db2cd;border-radius:999px;\n        padding:6px 11px;font-size:12px;white-space:nowrap}\n  .ask{color:#c9a3ff}\n  .step{color:#6b7a90;border-left:2px solid #2d3a4d;padding-left:9px;margin:3px 0}\n  .say{color:#e7eef8;border-left:2px solid #7ee787;padding-left:9px;margin:6px 0 8px;white-space:pre-wrap}\n  .propose{color:#ffb86b;border-left:2px solid #ffb86b;padding-left:9px;margin:6px 0}\n  .ps1{color:#7ee787;align-self:center;white-space:nowrap;max-width:46%;overflow:hidden;text-overflow:ellipsis}\n  /* Tappable paths: a phone has no Tab key, so anything the shell prints that\n     you might type next can be tapped into the prompt instead. */\n  .path{cursor:pointer;text-decoration:underline;text-decoration-style:dotted;text-decoration-color:#3c5680;text-underline-offset:3px}\n  .chip.comp{color:#7ee787;border-color:#2d3a4d}\n  .chip.dirc{color:#79c0ff}\n  .chip.undo{color:#ffb86b}\n  .hit{color:#6b7a90}\n  .hit b{color:#e7eef8;font-weight:650}\n</style><style>:root{--build-id:\"301f85fd18\";}</style>\n</head>\n<body>\n\n<header>\n  <b>Shell</b>\n  <span class=\"hint\">the shared workspace, on the command line</span>\n</header>\n\n<div id=\"out\"></div>\n\n<div class=\"chips\" id=\"chips\"></div>\n\n<div class=\"composer\">\n  <hr>\n  <form id=\"form\" autocomplete=\"off\">\n    <span class=\"ps1\">&#10095;</span>\n    <input id=\"in\" placeholder=\"a command, or a question\" autocapitalize=\"off\" autocorrect=\"off\" spellcheck=\"false\">\n  </form>\n  <div class=\"statusbar\">\n    <span class=\"left\" id=\"statusLeft\">~</span>\n    <span class=\"right\" id=\"statusRight\"></span>\n  </div>\n</div>\n\n<script>\n/* Shell over the MyLLMos shared workspace.\n   The command grammar deliberately MATCHES the assistant's `workspace_shell`\n   tool, so what you learn here is what you can ask MyLLM for in words — and what\n   it prints back to you looks like what it prints back to itself.\n\n   Difference: you are a person at a prompt, so this one can also WRITE. The\n   store itself has no trash and no undo, so this app supplies both: rm moves\n   into a hidden .trash folder, and undo reverses the last change. */\nvar files = window.myllmFiles || null;\nvar out = document.getElementById('out');\nvar input = document.getElementById('in');\n/* NOT `history` — that is window.history (the History API), so `var history`\n   silently keeps the built-in and cmdHistory.push is undefined. The runtime\n   harness caught this; a regex scan never would. */\nvar cmdHistory = [];\nvar hIndex = -1;\nvar pending = null;      /* a confirmation waiting on y/n */\nvar cwd = '';            /* current directory, '' = workspace root */\nvar TRASH = '.trash';    /* where rm puts things; hidden from ls unless -a or you cd into it */\nvar undoStack = [];      /* this session's reversible changes, newest last */\nvar lastSnap = null;     /* most recent listing, for completion chips */\nvar VERBS = ['ls','tree','cat','head','tail','stat','find','grep','du','mkdir','mv','write','rm','rmdir','undo','trash','restore','cd','pwd','clear','help'];\nfunction inTrash(path){ return path === TRASH || path.indexOf(TRASH + '/') === 0; }\n\n/* The APP may be stateful — you are standing somewhere. The assistant's\n   workspace_shell tool deliberately is NOT: state that persists between tool\n   calls is a trap for a model that cannot see the prompt. Same grammar, one\n   extra verb here. */\nfunction resolve(p){\n  var s = String(p||'').trim();\n  if (!s || s === '.') return cwd;\n  if (s.charAt(0) === '/') return normalise(s);\n  if (s === '..') return cwd.indexOf('/') < 0 ? '' : cwd.slice(0, cwd.lastIndexOf('/'));\n  var joined = cwd ? cwd + '/' + s : s;\n  /* collapse any a/b/../c the model or user typed */\n  var parts = [];\n  normalise(joined).split('/').forEach(function(seg){\n    if (seg === '..') parts.pop(); else if (seg && seg !== '.') parts.push(seg);\n  });\n  return parts.join('/');\n}\nfunction prompt$(){ return cwd ? '~/' + cwd : '~'; }\n\n/* Left: where you are. Right: what the workspace costs. Both refresh after any\n   command, so the bar is a live readout rather than decoration. */\nasync function paintPrompt(){\n  var l = document.getElementById('statusLeft');\n  if (l) l.textContent = prompt$() + (undoStack.length ? '  \\u00b7  undo \\u00d7' + undoStack.length : '');\n  var r = document.getElementById('statusRight');\n  if (r && files){\n    try{\n      var list = (await files.list()).filter(function(f){ return !inTrash(f.path); });\n      var total = list.reduce(function(a,b){ return a + b.size; }, 0);\n      r.textContent = list.length + (list.length === 1 ? ' file' : ' files') + '  \\u00b7  ' + bytes(total);\n    }catch(e){ r.textContent = ''; }\n  }\n}\n\nvar HELP = [\n  'ls [-R] [path]     list a folder (-R for the whole tree)',\n  'tree [path]        same as ls -R',\n  'cat <path>         print a file',\n  'head [-n N] <path> first N lines (default 20)',\n  'tail [-n N] <path> last N lines',\n  'stat <path>        size, modified, type',\n  'find <glob>        match filenames, e.g. find *.json',\n  'grep <text> [path] search inside files (add -l for names only)',\n  'du                 space used per folder',\n  'mkdir <path>       create a folder',\n  'mv <from> <to>     move or rename (-f to replace an existing file)',\n  'rm <path>          move a file to .trash  (rm -p deletes for good, asks first)',\n  'rmdir <path>       move a folder to .trash (rmdir -p deletes for good)',\n  'undo               reverse the last change: rm, rmdir, mv, write, mkdir',\n  'trash              what is in .trash;  trash empty  deletes it all (asks)',\n  'restore <path>     put something back from .trash',\n  'write <path>       type a line into a file (replaces it)',\n  'cd <path>          change directory (cd .. to go up); ls -a shows .trash',\n  'clear              clear the screen',\n  'help               this list',\n  '',\n  'Anything else is a question for MyLLM. It can run the read-only commands',\n  'above to answer, and will ask before changing anything.'\n].join('\\n');\n\nfunction esc(s){ return String(s==null?'':s)\n  .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }\n\nvar capture = null;   /* when set, print() also collects text for the agent loop */\n\nfunction print(text, cls){\n  if (capture !== null) capture.push(String(text));\n  var d = document.createElement('div');\n  if (cls) d.className = cls;\n  d.innerHTML = esc(text);\n  out.appendChild(d);\n  out.scrollTop = out.scrollHeight;\n}\nfunction printHTML(html){\n  if (capture !== null) capture.push(html.replace(/<[^>]+>/g, ''));\n  var d = document.createElement('div');\n  d.innerHTML = html;\n  out.appendChild(d);\n  out.scrollTop = out.scrollHeight;\n}\nfunction haptic(k){ try{ window.myllmHaptic && myllmHaptic(k); }catch(e){} }\n\n/* ---------- helpers that mirror the tool ---------- */\n\nfunction tokenize(s){\n  var outv = [], cur = '', q = null;\n  for (var i=0;i<s.length;i++){\n    var c = s[i];\n    if (q){ if (c === q) q = null; else cur += c; }\n    else if (c === '\"' || c === \"'\"){ q = c; }\n    else if (c === ' '){ if (cur){ outv.push(cur); cur = ''; } }\n    else cur += c;\n  }\n  if (cur) outv.push(cur);\n  return outv;\n}\n\nfunction normalise(p){\n  var s = String(p||'').trim();\n  while (s.indexOf('./') === 0) s = s.slice(2);\n  while (s.charAt(0) === '/') s = s.slice(1);\n  while (s.charAt(s.length-1) === '/') s = s.slice(0,-1);\n  return s === '.' ? '' : s;\n}\n\nfunction bytes(n){ return n < 1024 ? n + 'B' : (n/1024).toFixed(1) + 'K'; }\n\nfunction when(ms){\n  var d = new Date(ms);\n  function p(x){ return (x<10?'0':'') + x; }\n  return d.getFullYear() + '-' + p(d.getMonth()+1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());\n}\n\nfunction glob(pattern, name){\n  if (pattern.indexOf('*') < 0 && pattern.indexOf('?') < 0)\n    return name.toLowerCase().indexOf(pattern.toLowerCase()) >= 0;\n  var rx = '^' + pattern.replace(/[.+^${}()|[\\]\\\\]/g,'\\\\$&')\n                        .replace(/\\*/g,'.*').replace(/\\?/g,'.') + '$';\n  return new RegExp(rx,'i').test(name);\n}\n\nasync function snapshot(includeHidden){\n  var list = await files.list();\n  var folders = files.folders ? await files.folders() : [];\n  var all = { files: list, folders: folders };\n  lastSnap = all;\n  if (includeHidden || inTrash(cwd)) return all;\n  return { files: list.filter(function(f){ return !inTrash(f.path); }),\n           folders: folders.filter(function(d){ return !inTrash(d); }) };\n}\n/* Where a deleted thing goes. Keeps the original path under .trash so restore\n   is a straight move back; a second delete of the same name gets a suffix. */\nfunction trashPath(target){\n  var snap = lastSnap || { files: [], folders: [] };   /* the UNFILTERED listing — run()'s hides .trash */\n  var dest = TRASH + '/' + target;\n  var taken = snap.files.some(function(f){ return f.path === dest || f.path.indexOf(dest + '/') === 0; }) || snap.folders.indexOf(dest) >= 0;\n  if (!taken) return dest;\n  var dot = target.lastIndexOf('.'), slash = target.lastIndexOf('/');\n  var stamp = '~' + new Date().toISOString().slice(0,19).replace(/[-:T]/g,'');\n  return TRASH + '/' + (dot > slash ? target.slice(0,dot) + stamp + target.slice(dot) : target + stamp);\n}\n/* After a restore, the folder that held the item may be left empty inside\n   .trash. Sweep those (deepest first) so `trash` never shows hollow folders. */\nasync function pruneTrash(){\n  try{\n    var all = await snapshot(true);\n    var dirs = all.folders.filter(function(d){ return inTrash(d) && d !== TRASH; }).sort(function(a,b){ return b.length - a.length; });\n    for (var i = 0; i < dirs.length; i++){\n      var d = dirs[i];\n      var busy = all.files.some(function(f){ return f.path.indexOf(d + '/') === 0; }) ||\n                 all.folders.some(function(x){ return x !== d && x.indexOf(d + '/') === 0 && !dirs.slice(0, i).some(function(gone){ return gone === x; }); });\n      if (!busy) await files.removeFolder(d, false);\n    }\n    var again = await snapshot(true);\n    if (again.folders.indexOf(TRASH) >= 0 && !again.files.some(function(f){ return inTrash(f.path); }) &&\n        !again.folders.some(function(d){ return d !== TRASH && inTrash(d); })) await files.removeFolder(TRASH, false);\n  }catch(e){}\n}\nfunction pathHTML(p, label){ return '<span class=\"path\" data-path=\"' + esc(p) + '\">' + esc(label == null ? p : label) + '</span>'; }\n\n/* ---------- commands ---------- */\n\nasync function run(line){\n  if (!files){ print('Shared files are off. Turn on \"Shared files\" in MyLLMos settings.', 'err'); return; }\n  var argv = tokenize(line);\n  var verb = (argv.shift()||'').toLowerCase();\n\n  var flags = {}, n = 20, ops = [];\n  for (var i=0;i<argv.length;i++){\n    var a = argv[i];\n    if (a === '-n' && argv[i+1] && !isNaN(+argv[i+1])){ n = Math.max(1, Math.min(+argv[i+1], 500)); i++; continue; }\n    if (a.charAt(0) === '-'){ a.slice(1).split('').forEach(function(f){ flags[f] = true; }); continue; }\n    ops.push(a);\n  }\n  var target = ops.length ? resolve(ops[0]) : cwd;\n  var snap = await snapshot(!!flags.a);\n\n  switch (verb){\n    case 'help': print(HELP, 'dim'); return;\n    case 'clear': out.innerHTML = ''; return;\n    case 'pwd': print('/' + cwd, 'dim'); return;\n\n    case 'cd': {\n      var dest = ops.length ? resolve(ops[0]) : '';\n      if (dest && snap.folders.indexOf(dest) < 0) return print('No such folder: ' + dest, 'err');\n      cwd = dest; paintPrompt();\n      return print('/' + cwd, 'dim');\n    }\n\n    case 'ls': case 'dir': case 'tree':\n      return listing(snap, target, verb === 'tree' || flags.R || flags.r);\n\n    case 'cat': case 'head': case 'tail': {\n      if (!target) return print(verb + ' needs a path', 'err');\n      var text = await files.read(target);\n      if (text == null) return print('No such file: ' + target, 'err');\n      if (verb === 'cat') return print(text);\n      var lines = text.split('\\n');\n      print((verb === 'head' ? lines.slice(0, n) : lines.slice(-n)).join('\\n'));\n      if (lines.length > n) print('[' + lines.length + ' lines total]', 'dim');\n      return;\n    }\n\n    case 'stat': {\n      var f = snap.files.filter(function(x){ return x.path === target; })[0];\n      if (f) return print(f.path + '\\ntype: file\\nsize: ' + f.size + ' bytes\\nmodified: ' + when(f.modified*1000));\n      if (snap.folders.indexOf(target) >= 0){\n        var inside = snap.files.filter(function(x){ return x.path.indexOf(target + '/') === 0; });\n        var total = inside.reduce(function(a,b){ return a + b.size; }, 0);\n        return print(target + '/\\ntype: folder\\ncontains: ' + inside.length + ' file(s), ' + total + ' bytes');\n      }\n      return print('No such file or folder: ' + target, 'err');\n    }\n\n    case 'find': {\n      if (!ops[0]) return print('find needs a name or glob, e.g. find *.json', 'err');\n      var hits = snap.files.map(function(f){ return f.path; }).filter(function(p){\n        return glob(ops[0], p.split('/').pop()) || glob(ops[0], p);\n      });\n      if (!hits.length) return print('No match for ' + ops[0], 'dim');\n      return printHTML(hits.sort().map(function(p){ return pathHTML(p); }).join('\\n'));\n    }\n\n    case 'grep': {\n      /* Search INSIDE files — find only knows names. Case-insensitive, because\n         a phone keyboard capitalises the first letter whether you like it or\n         not; -l lists matching files only. Scope with a folder or file path. */\n      if (!ops[0]) return print('grep needs some text, e.g. grep dentist  or  grep -l invoice notes', 'err');\n      var needle = ops[0].toLowerCase();\n      var scope = ops[1] ? resolve(ops[1]) : cwd;\n      var pool = snap.files.filter(function(f){ return !scope || f.path === scope || f.path.indexOf(scope + '/') === 0; });\n      if (!pool.length) return print('Nothing to search in ' + (scope || 'the workspace'), 'dim');\n      var rows = [], hitFiles = 0, shown = 0, LIMIT = 200;\n      for (var fi = 0; fi < pool.length && shown < LIMIT; fi++){\n        var f = pool[fi], txt = await files.read(f.path);\n        if (txt == null || txt.toLowerCase().indexOf(needle) < 0) continue;\n        hitFiles++;\n        if (flags.l){ rows.push(pathHTML(f.path)); continue; }\n        var ls = txt.split('\\n');\n        for (var li = 0; li < ls.length && shown < LIMIT; li++){\n          var lower = ls[li].toLowerCase(), at = lower.indexOf(needle);\n          if (at < 0) continue;\n          shown++;\n          var start = Math.max(0, at - 40), snippet = ls[li].slice(start, start + 120);\n          var rel = at - start;\n          var marked = esc(snippet.slice(0, rel)) + '<b>' + esc(snippet.slice(rel, rel + needle.length)) + '</b>' + esc(snippet.slice(rel + needle.length));\n          rows.push(pathHTML(f.path) + '<span class=\"hit\">:' + (li + 1) + ': ' + (start ? '\\u2026' : '') + marked + '</span>');\n        }\n      }\n      if (!rows.length) return print('No match for \"' + ops[0] + '\" in ' + (scope || 'the workspace'), 'dim');\n      printHTML(rows.join('\\n'));\n      if (!flags.l) print('[' + shown + (shown >= LIMIT ? '+' : '') + ' line(s) in ' + hitFiles + ' file(s)]', 'dim');\n      return;\n    }\n\n    case 'du': {\n      var byDir = {};\n      snap.files.forEach(function(f){\n        var d = f.path.indexOf('/') < 0 ? '.' : f.path.slice(0, f.path.lastIndexOf('/'));\n        byDir[d] = (byDir[d]||0) + f.size;\n      });\n      var rows = Object.keys(byDir).sort(function(a,b){ return byDir[b]-byDir[a]; })\n        .map(function(d){ return bytes(byDir[d]) + '\\t' + d; });\n      var total = snap.files.reduce(function(a,b){ return a + b.size; }, 0);\n      return print(rows.concat([bytes(total) + '\\ttotal of 25 MB']).join('\\n'));\n    }\n\n    /* ---- mutations: this is a person at a prompt, so they are allowed ---- */\n\n    case 'mkdir':\n      if (!target) return print('mkdir needs a path', 'err');\n      if (snap.folders.indexOf(target) >= 0) return print(target + '/ already exists', 'dim');\n      await files.makeFolder(target);\n      remember({ type: 'mkdir', path: target });\n      haptic('success');\n      return print('created ' + target + '/', 'ok');\n\n    case 'mv': {\n      if (ops.length < 2) return print('mv needs a source and a destination', 'err');\n      var to = resolve(ops[1]);\n      if (!to) return print('mv needs a destination name', 'err');\n      var exists = snap.files.some(function(x){ return x.path === to; }) || snap.folders.indexOf(to) >= 0;\n      /* The store replaces a destination silently, and a replaced file cannot be\n         undone — so say so, and make replacing a deliberate flag. */\n      if (exists && !flags.f) return print(to + ' already exists — use  mv -f  to replace it', 'err');\n      await files.move(target, to);\n      remember({ type: 'mv', from: target, to: to });\n      haptic('success');\n      return print(target + ' -> ' + to, 'ok');\n    }\n\n    case 'write': {\n      if (!target) return print('write needs a path', 'err');\n      var body = line.slice(line.indexOf(ops[0]) + ops[0].length).trim();\n      if (!body) return print('write <path> <text>  — the text replaces the file', 'err');\n      var prev = await files.read(target);\n      await files.write(target, body);\n      remember({ type: 'write', path: target, prev: prev });\n      haptic('success');\n      return print('wrote ' + body.length + ' chars to ' + target + (prev != null ? ' (replaced ' + prev.length + ')' : ''), 'ok');\n    }\n\n    case 'rm': case 'rmdir': {\n      if (!target) return print(verb + ' needs a path', 'err');\n      var isDir = snap.folders.indexOf(target) >= 0;\n      var isFile = snap.files.some(function(x){ return x.path === target; });\n      if (!isDir && !isFile) return print('No such file or folder: ' + target, 'err');\n      if (verb === 'rm' && isDir) return print(target + ' is a folder — use rmdir', 'err');\n      if (verb === 'rmdir' && !isDir) return print(target + ' is not a folder — use rm', 'err');\n      var count = isDir ? snap.files.filter(function(x){ return x.path.indexOf(target+'/') === 0; }).length : 1;\n      if (inTrash(target) || flags.p){\n        /* Already in the trash, or explicitly permanent: this one really is gone,\n           so it still has to be said twice. */\n        pending = { verb: verb, target: target, count: count };\n        return print('delete ' + target + (isDir ? '/ and its ' + count + ' file(s)' : '') + ' for good? no undo — type  y  to confirm', 'err');\n      }\n      var dest = trashPath(target);\n      await files.move(target, dest);\n      remember({ type: 'rm', from: target, to: dest, isDir: isDir });\n      haptic('warning');\n      return print('moved ' + target + (isDir ? '/ (' + count + ' file(s))' : '') + ' to ' + TRASH + '  \\u2014  undo  puts it back', 'ok');\n    }\n\n    case 'undo': {\n      var op = undoStack.pop();\n      if (!op) return print('nothing to undo', 'dim');\n      switch (op.type){\n        case 'rm': await files.move(op.to, op.from); await pruneTrash(); print('restored ' + op.from, 'ok'); break;\n        case 'mv': await files.move(op.to, op.from); print(op.to + ' -> ' + op.from, 'ok'); break;\n        case 'mkdir': await files.removeFolder(op.path, false); print('removed ' + op.path + '/', 'ok'); break;\n        case 'write':\n          if (op.prev == null){ await files.remove(op.path); print('removed ' + op.path, 'ok'); }\n          else { await files.write(op.path, op.prev); print('restored ' + op.path + ' (' + op.prev.length + ' chars)', 'ok'); }\n          break;\n      }\n      haptic('success');\n      return;\n    }\n\n    case 'trash': {\n      if ((ops[0] || '').toLowerCase() === 'empty'){\n        var all = await snapshot(true);\n        var inside = all.files.filter(function(x){ return inTrash(x.path); });\n        if (!inside.length && all.folders.indexOf(TRASH) < 0) return print(TRASH + ' is empty', 'dim');\n        pending = { verb: 'trash-empty', count: inside.length };\n        return print('delete ' + inside.length + ' file(s) in ' + TRASH + ' for good? no undo — type  y  to confirm', 'err');\n      }\n      var allT = await snapshot(true);\n      if (allT.folders.indexOf(TRASH) < 0) return print(TRASH + ' is empty', 'dim');\n      print(TRASH + '/  \\u2014  restore <path> puts something back, trash empty clears it', 'dim');\n      return listing(allT, TRASH, true);\n    }\n\n    case 'restore': {\n      if (!ops[0]) return print('restore needs a path as shown by  trash', 'err');\n      var all2 = await snapshot(true);\n      var src = normalise(ops[0]);\n      if (!inTrash(src)) src = TRASH + '/' + src;\n      var back = src.slice(TRASH.length + 1).replace(/~\\d{14}(?=\\.[^.\\/]+$|$)/, '');\n      var known = all2.files.some(function(x){ return x.path === src; }) || all2.folders.indexOf(src) >= 0;\n      if (!known) return print('Not in ' + TRASH + ': ' + src.slice(TRASH.length + 1), 'err');\n      var clash = all2.files.some(function(x){ return x.path === back; }) || all2.folders.indexOf(back) >= 0;\n      if (clash && !flags.f) return print(back + ' already exists — use  restore -f  to replace it', 'err');\n      await files.move(src, back);\n      await pruneTrash();\n      remember({ type: 'mv', from: src, to: back });\n      haptic('success');\n      return print('restored ' + back, 'ok');\n    }\n\n    default:\n      /* Not a command? Then it was a question. This is the line that turns a\n         terminal into an assistant that happens to live in a directory. */\n      print('thinking…', 'dim');\n      return ask(line);\n  }\n}\n\nfunction remember(op){\n  undoStack.push(op);\n  if (undoStack.length > 30) undoStack.shift();\n}\n\nfunction listing(snap, root, recursive){\n  var prefix = root ? root + '/' : '';\n  if (root && snap.folders.indexOf(root) < 0){\n    var one = snap.files.filter(function(f){ return f.path === root; })[0];\n    if (one) return printHTML(pathHTML(one.path) + '\\t<span class=\"dim\">' + one.size + 'B\\t' + when(one.modified*1000) + '</span>');\n    return print('No such file or folder: ' + root, 'err');\n  }\n  var depth = prefix ? prefix.split('/').length : 1;\n  var subs = snap.folders.filter(function(f){\n    return f.indexOf(prefix) === 0 && f !== root && (recursive || f.split('/').length === depth);\n  }).sort();\n  var here = snap.files.filter(function(f){\n    return f.path.indexOf(prefix) === 0 && (recursive || f.path.split('/').length === depth);\n  }).sort(function(a,b){ return a.path < b.path ? -1 : 1; });\n  if (!subs.length && !here.length) return print(root ? root + '/ is empty' : 'The workspace is empty', 'dim');\n  var html = subs.map(function(d){ return '<span class=\"dir\">' + pathHTML(d, d + '/') + '</span>'; })\n    .concat(here.map(function(f){\n      return pathHTML(f.path) + '\\t<span class=\"dim\">' + f.size + 'B\\t' + when(f.modified*1000) + '</span>';\n    })).join('\\n');\n  printHTML(html);\n}\n\n/* ================= the assistant, inside the directory =================\n   Type anything that is not a command and it becomes a question. The model is\n   given the working directory and the command list, and answers with ONE JSON\n   object per turn: run a command, or say something. The app executes the\n   command locally and feeds the output back — which is the whole trick, because\n   myllmAsk has no tools of its own. The shell commands ARE the tools.\n\n   READ-ONLY autonomously. Anything that writes or deletes comes back as a\n   proposal the user has to accept: a model running rm across someone's\n   documents unattended is the one outcome worth designing against. */\n\nvar READ_ONLY = ['ls','tree','cat','head','tail','stat','find','grep','du','pwd'];\nvar MAX_STEPS = 5;          /* myllmAsk is rate-limited; five is plenty and stays inside it */\n\nfunction systemPrompt(listing){\n  return [\n    'You are working inside a directory of the user\\'s MyLLMos shared workspace, like a terminal assistant.',\n    'Current directory: /' + (cwd || ''),\n    '',\n    'Contents right now:',\n    listing || '(empty)',\n    '',\n    'You may run these READ-ONLY commands: ls [-R] [path], tree [path], cat <path>, head -n N <path>, tail -n N <path>, stat <path>, find <glob>, grep <text> [path] (searches inside files), du.',\n    'Paths are relative to the current directory. There is no cd.',\n    '',\n    'Reply with ONE JSON object and nothing else:',\n    '  {\"run\":\"<command>\"}                     to look at something first',\n    '  {\"say\":\"<answer>\"}                      when you can answer',\n    '  {\"propose\":\"<command>\",\"why\":\"<reason>\"} to CHANGE something (mkdir, mv, write, rm, rmdir) — the user approves it, you never run it. rm moves to a trash folder and can be undone.',\n    '',\n    'Prefer running a command over guessing. Answer in plain prose, briefly. Do not invent file contents.'\n  ].join('\\n');\n}\n\nasync function runCaptured(line){\n  capture = [];\n  try { await run(line); } catch(e){ capture.push('error: ' + (e.message || e)); }\n  var text = capture.join('\\n');\n  capture = null;\n  return text.length > 4000 ? text.slice(0, 4000) + '\\n[truncated]' : text;\n}\n\nfunction parseReply(raw){\n  var t = String(raw || '').trim();\n  /* Models fence JSON even when told not to. */\n  t = t.replace(/^```(?:json)?/i, '').replace(/```$/, '').trim();\n  var a = t.indexOf('{'), b = t.lastIndexOf('}');\n  if (a < 0 || b < a) return null;\n  try { return JSON.parse(t.slice(a, b + 1)); } catch(e){ return null; }\n}\n\nasync function ask(question){\n  if (!window.myllmAsk){\n    print('AI is off for apps — turn on \"Allow apps to use the AI\" in MyLLMos settings.', 'err');\n    return;\n  }\n  var snap = await snapshot();\n  capture = []; listing(snap, cwd, false); var here = capture.join('\\n'); capture = null;\n\n  var transcript = 'User: ' + question;\n  for (var step = 0; step < MAX_STEPS; step++){\n    var raw;\n    try { raw = await myllmAsk(transcript + '\\n\\nReply with one JSON object.', { system: systemPrompt(here) }); }\n    catch(e){ print('ask failed: ' + (e.message || e), 'err'); return; }\n\n    var reply = parseReply(raw);\n    if (!reply){\n      /* Not JSON — treat it as the answer rather than failing in the user's face. */\n      print(String(raw).trim(), 'say');\n      return;\n    }\n    if (reply.say){ print(String(reply.say).trim(), 'say'); return; }\n\n    if (reply.propose){\n      var why = reply.why ? ' — ' + reply.why : '';\n      print('proposes: ' + reply.propose + why, 'propose');\n      print('run it? type  y  to confirm', 'propose');\n      pending = { verb: 'raw', line: String(reply.propose) };\n      return;\n    }\n    if (reply.run){\n      var cmd = String(reply.run).trim();\n      var verb = cmd.split(/\\s+/)[0].toLowerCase();\n      if (READ_ONLY.indexOf(verb) < 0){\n        transcript += '\\n\\nAssistant tried: ' + cmd + '\\nBlocked: only ' + READ_ONLY.join(', ') + ' may run automatically. Use \"propose\" for anything that changes files.';\n        continue;\n      }\n      print('$ ' + cmd, 'step');\n      var output = await runCaptured(cmd);\n      transcript += '\\n\\nAssistant ran: ' + cmd + '\\nOutput:\\n' + (output || '(no output)');\n      continue;\n    }\n    print(String(raw).trim(), 'say');\n    return;\n  }\n  print('Stopped after ' + MAX_STEPS + ' steps. Ask something narrower, or run the commands yourself.', 'dim');\n}\n\n/* ---------- prompt ---------- */\n\ndocument.getElementById('form').addEventListener('submit', async function(ev){\n  ev.preventDefault();\n  var line = input.value.trim();\n  input.value = '';\n  if (!line) return;\n\n  if (pending){\n    var p = pending; pending = null;\n    if (line.toLowerCase() === 'y' || line.toLowerCase() === 'yes'){\n      try{\n        if (p.verb === 'raw'){ print('$ ' + p.line, 'cmd'); await run(p.line); }\n        else if (p.verb === 'trash-empty') await files.removeFolder(TRASH, true);\n        else if (p.verb === 'rm') await files.remove(p.target);\n        else await files.removeFolder(p.target, true);\n        haptic('warning');\n        if (p.verb === 'trash-empty') print('emptied ' + TRASH, 'ok');\n        else if (p.verb !== 'raw') print('deleted ' + p.target, 'ok');\n      }catch(e){ print(e.message, 'err'); }\n    } else print('cancelled', 'dim');\n    paintPrompt(); renderChips();\n    return;\n  }\n\n  cmdHistory.push(line); hIndex = cmdHistory.length;\n  if (cmdHistory.length > 200) cmdHistory.shift();\n  print(prompt$() + ' \\u276f ' + line, 'cmd');\n  try { await run(line); }\n  catch(e){ print(String(e && e.message || e), 'err'); }\n  paintPrompt();\n  renderChips();\n});\n\n/* Up/down through history, as a shell does. */\ninput.addEventListener('keydown', function(e){\n  if (e.key === 'ArrowUp'){ if (hIndex > 0){ hIndex--; input.value = cmdHistory[hIndex]; } e.preventDefault(); }\n  if (e.key === 'ArrowDown'){ if (hIndex < cmdHistory.length-1){ hIndex++; input.value = cmdHistory[hIndex]; } else { hIndex = cmdHistory.length; input.value = ''; } e.preventDefault(); }\n});\n\n/* ---------- completion, for a keyboard with no Tab key ----------\n   The chip row follows what you type: verbs while you type the first word,\n   then names from the folder you are pointing at. A folder completes with a\n   trailing slash and keeps going. Empty input shows the usual shortcuts. */\nvar chipsEl = document.getElementById('chips');\nvar DEFAULT_CHIPS = ['ls','ls -R','grep ','du','trash','help'];\n\nfunction chip(label, cls, onTap){\n  var b = document.createElement('button');\n  b.className = 'chip' + (cls ? ' ' + cls : ''); b.type = 'button'; b.textContent = label;\n  b.addEventListener('pointerdown', function(e){ e.preventDefault(); });  /* keep the keyboard up */\n  b.addEventListener('click', onTap);\n  return b;\n}\nfunction setInput(v){ input.value = v; input.focus(); renderChips(); }\n\nfunction renderChips(){\n  chipsEl.innerHTML = '';\n  var v = input.value, atStart = v.length === 0;\n  if (pending){ [['y','ok'],['n','dim']].forEach(function(x){ chipsEl.appendChild(chip(x[0], '', function(){ setInput(x[0]); })); }); return; }\n  if (atStart){\n    DEFAULT_CHIPS.forEach(function(c){ chipsEl.appendChild(chip(c, '', function(){ setInput(c); })); });\n    if (undoStack.length) chipsEl.appendChild(chip('undo', 'undo', function(){ setInput('undo'); }));\n    if (cwd) chipsEl.appendChild(chip('cd ..', 'dirc', function(){ setInput('cd ..'); }));\n    return;\n  }\n  var endsWithSpace = /\\s$/.test(v);\n  var tokens = tokenize(v);\n  var partial = endsWithSpace ? '' : (tokens[tokens.length - 1] || '');\n  var head = endsWithSpace ? v : v.slice(0, v.length - partial.length);\n  var firstWord = tokens.length <= 1 && !endsWithSpace;\n  var items = [];\n  if (firstWord){\n    VERBS.filter(function(x){ return x.indexOf(partial.toLowerCase()) === 0 && x !== partial; })\n      .forEach(function(x){ items.push({ label: x, value: x + ' ', cls: '' }); });\n  } else if (lastSnap){\n    var slash = partial.lastIndexOf('/');\n    var dirPart = slash >= 0 ? partial.slice(0, slash + 1) : '';\n    var namePart = slash >= 0 ? partial.slice(slash + 1) : partial;\n    var base = resolve(dirPart || '.');\n    var prefix = base ? base + '/' : '';\n    var depth = prefix ? prefix.split('/').length : 1;\n    var seen = {};\n    var showHidden = inTrash(base) || namePart.charAt(0) === '.';\n    lastSnap.folders.forEach(function(d){\n      if (d.indexOf(prefix) !== 0 || d === base || d.split('/').length !== depth) return;\n      if (!showHidden && inTrash(d)) return;\n      var name = d.slice(prefix.length);\n      if (name.toLowerCase().indexOf(namePart.toLowerCase()) === 0 && !seen[name]){ seen[name] = 1; items.push({ label: name + '/', value: dirPart + name + '/', cls: 'dirc' }); }\n    });\n    lastSnap.files.forEach(function(f){\n      if (f.path.indexOf(prefix) !== 0 || f.path.split('/').length !== depth) return;\n      if (!showHidden && inTrash(f.path)) return;\n      var name = f.path.slice(prefix.length);\n      if (name.toLowerCase().indexOf(namePart.toLowerCase()) === 0 && !seen[name] && name !== namePart){ seen[name] = 1; items.push({ label: name, value: dirPart + name, cls: 'comp' }); }\n    });\n    if (base && !namePart) items.push({ label: '..', value: dirPart + '../', cls: 'dirc' });\n  }\n  items.slice(0, 12).forEach(function(it){\n    chipsEl.appendChild(chip(it.label, it.cls, function(){\n      var val = /[\\s\"']/.test(it.value) ? '\"' + it.value + '\"' : it.value;\n      setInput(head + val);\n    }));\n  });\n  if (!items.length && !firstWord) DEFAULT_CHIPS.slice(0, 3).forEach(function(c){ chipsEl.appendChild(chip(c, 'dim', function(){ setInput(c); })); });\n}\ninput.addEventListener('input', renderChips);\ninput.addEventListener('focus', renderChips);\n\n/* Tap a path the shell printed and it lands in the prompt — appended after a\n   space if you were mid-command, or on its own if the prompt was empty. */\nout.addEventListener('click', function(e){\n  var el = e.target.closest('.path');\n  if (!el) return;\n  var p = el.getAttribute('data-path');\n  if (cwd && p.indexOf(cwd + '/') === 0) p = p.slice(cwd.length + 1);   /* relative to where you stand */\n  else if (cwd) p = '/' + p;\n  var val = /[\\s\"']/.test(p) ? '\"' + p + '\"' : p;\n  var v = input.value;\n  setInput(v && !/\\s$/.test(v) ? v + ' ' + val : v + val);\n  haptic('selection');\n});\nrenderChips();\n\npaintPrompt();\nprint('MyLLMos workspace shell. Type  help  for commands.', 'dim');\nprint('Anything that is not a command is a question — MyLLM answers it from here,', 'dim');\nprint('running the read-only commands itself and asking before it changes anything.', 'dim');\nprint('rm moves things to .trash and  undo  reverses your last change. Tap any path to use it.', 'dim');\nif (!window.myllmFiles) print('\\nShared files are off — turn them on in MyLLMos settings.', 'err');\nelse run('ls');\n</script>\n</body></html>\n"}