{"name": "Shell", "kind": "html", "iconSymbol": "terminal", "iconColor": "gray", "html": "<!doctype html>\n<!--\n  Shell — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover\">\n<meta name=\"myllm:immersive\" content=\"on\">\n<title>Shell</title>\n<style>\n  *{box-sizing:border-box}\n  body{margin:0;background:#0d1117;color:#d6deeb;\n       font:13.5px/1.55 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;\n       display:flex;flex-direction:column;height:100dvh;overflow:hidden}\n  /* phone on its side: keep clear of the notch and the rounded corners */\n  body{padding-left:env(safe-area-inset-left);padding-right:env(safe-area-inset-right)}\n  header{padding:10px 14px;border-bottom:1px solid #1e2733;display:flex;align-items:center;gap:10px}\n  /* v12: full screen (MyLLM 5.6.2+), with the header clear of the Dynamic\n     Island — live env(), never measured — and a ✕ as the way out. */\n  body.imm header{padding-top:calc(10px + env(safe-area-inset-top))}\n  header .imm-x{display:none;margin-left:auto;width:34px;height:34px;border-radius:10px;border:1px solid #2a3646;\n                background:#111823;color:#9db2cd;place-items:center;padding:0;flex:none}\n  body.imm header .imm-x{display:grid}\n  header .imm-x svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n  header .imm-x:active{transform:scale(.94)}\n  /* No pinch, no double-tap zoom: a terminal that rescales under your fingers\n     feels flimsy. (The viewport meta stops the focus-zoom on the prompt.) */\n  html,body{touch-action:manipulation;-webkit-text-size-adjust:100%}\n  header b{font-size:14px;color:#e7eef8;font-weight:650}\n  header .hint{font-size:11.5px;color:#6b7a90}\n  #out{flex:1;overflow:auto;padding:12px 14px 4px;white-space:pre-wrap;word-break:break-word}\n  .cmd{color:#7ee787}\n  /* v13: your questions to MyLLM stand apart from its steps, notes and answers. */\n  .you{color:#e7eef8;background:#14233a;border-left:3px solid #58a6ff;border-radius:6px;\n       padding:7px 10px;margin:12px 0 6px;font-weight:550}\n  .you .who{color:#58a6ff;font-weight:650;margin-right:6px}\n  /* v13: the working bar — what MyLLM is doing right now, how long, and Stop. */\n  .work{display:flex;align-items:center;gap:9px;margin:0 12px 8px;padding:8px 10px;border-radius:10px;\n        background:#111b29;border:1px solid #23406a;color:#9db2cd;font-size:12.5px}\n  .work[hidden]{display:none}\n  .work .txt{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#cfe0f5}\n  .work .t{color:#6b7a90;font-variant-numeric:tabular-nums;flex:none}\n  .work button{flex:none;background:#2a1720;border:1px solid #6e2b3a;color:#ff9aa8;border-radius:8px;padding:4px 10px;font:inherit}\n  .work .spin{flex:none;width:12px;height:12px;border-radius:50%;border:2px solid #23406a;border-top-color:#58a6ff;animation:shspin .8s linear infinite}\n  @keyframes shspin{to{transform:rotate(360deg)}}\n  @media (prefers-reduced-motion: reduce){ .work .spin{animation:none;border-top-color:#58a6ff} }\n  body.busy form{border-color:#23406a}\n  .err{color:#ff7b72}\n  .ok{color:#79c0ff}\n  .dim{color:#6b7a90}\n  .dir{color:#79c0ff;font-weight:650}\n  /* The composer, shaped like Claude Code's: one quiet bordered box with a\n     chevron, the text filling it, and a status line underneath. No Run button —\n     Return submits, and a button competing with the prompt is the thing that\n     made this look like a form rather than a terminal. */\n  .composer{padding:0 12px calc(12px + env(safe-area-inset-bottom));background:#0d1117}\n  .composer hr{border:0;border-top:1px solid #1e2733;margin:0 -12px 10px}\n  form{display:flex;gap:9px;align-items:center;background:#0d1117;\n       border:1px solid #2a3646;border-radius:10px;padding:11px 12px}\n  form:focus-within{border-color:#3c5680}\n  .ps1{color:#6b7a90;align-self:center;user-select:none}\n  input{flex:1;min-width:0;background:transparent;border:0;color:#d6deeb;padding:0;\n        font:13.5px ui-monospace,SFMono-Regular,Menlo,monospace}\n  input:focus{outline:none}\n  input::placeholder{color:#3f4c5f}\n  /* One line, always. A status bar that wraps stops reading as a status bar —\n     the left half truncates, the right half is short enough never to. */\n  .statusbar{display:flex;justify-content:space-between;align-items:baseline;gap:12px;\n             padding:8px 3px 0;font-size:11.5px;color:#6b7a90;white-space:nowrap}\n  .statusbar .left{color:#7ee787;overflow:hidden;text-overflow:ellipsis;min-width:0}\n  .statusbar .right{color:#6b7a90;flex:none}\n  .chips{display:flex;gap:6px;overflow-x:auto;padding:0 12px 10px}\n  .chip{background:#111823;border:1px solid #1e2733;color:#9db2cd;border-radius:999px;\n        padding:6px 11px;font-size:12px;white-space:nowrap}\n  .ask{color:#c9a3ff}\n  .step{color:#6b7a90;border-left:2px solid #2d3a4d;padding-left:9px;margin:3px 0}\n  .say{color:#e7eef8;border-left:2px solid #7ee787;padding-left:9px;margin:6px 0 8px;white-space:pre-wrap}\n  .note{color:#9fb3c8;font-style:italic;padding-left:11px;margin:4px 0;white-space:pre-wrap}\n  .propose{color:#ffb86b;border-left:2px solid #ffb86b;padding-left:9px;margin:6px 0}\n  .ps1{color:#7ee787;align-self:center;white-space:nowrap;max-width:46%;overflow:hidden;text-overflow:ellipsis}\n  /* Tappable paths: a phone has no Tab key, so anything the shell prints that\n     you might type next can be tapped into the prompt instead. */\n  .path{cursor:pointer;text-decoration:underline;text-decoration-style:dotted;text-decoration-color:#3c5680;text-underline-offset:3px}\n  .chip.comp{color:#7ee787;border-color:#2d3a4d}\n  .chip.dirc{color:#79c0ff}\n  .chip.undo{color:#ffb86b}\n  .hit{color:#6b7a90}\n  .hit b{color:#e7eef8;font-weight:650}\n</style><style>:root{--build-id:\"301f85fd18\";}</style>\n</head>\n<body>\n\n<header>\n  <b>Shell</b>\n  <span class=\"hint\">the shared workspace, on the command line</span>\n  <button type=\"button\" class=\"imm-x\" aria-label=\"Close Shell\" onclick=\"shellClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button>\n</header>\n\n<div id=\"out\"></div>\n\n<div class=\"work\" id=\"work\" hidden role=\"status\" aria-live=\"polite\"><span class=\"spin\" aria-hidden=\"true\"></span><span class=\"txt\" id=\"workTxt\">MyLLM is thinking…</span><span class=\"t\" id=\"workT\">0s</span><button type=\"button\" id=\"workStop\">Stop</button></div>\n<div class=\"chips\" id=\"chips\"></div>\n\n<div class=\"composer\">\n  <hr>\n  <form id=\"form\" autocomplete=\"off\">\n    <span class=\"ps1\">&#10095;</span>\n    <input id=\"in\" placeholder=\"a command, or a question\" autocapitalize=\"off\" autocorrect=\"off\" spellcheck=\"false\">\n  </form>\n  <div class=\"statusbar\">\n    <span class=\"left\" id=\"statusLeft\">~</span>\n    <span class=\"right\" id=\"statusRight\"></span>\n  </div>\n</div>\n\n<script>\n/* Shell over the MyLLMos shared workspace.\n   The command grammar deliberately MATCHES the assistant's `workspace_shell`\n   tool, so what you learn here is what you can ask MyLLM for in words — and what\n   it prints back to you looks like what it prints back to itself.\n\n   Difference: you are a person at a prompt, so this one can also WRITE. The\n   store itself has no trash and no undo, so this app supplies both: rm moves\n   into a hidden .trash folder, and undo reverses the last change. */\n/* Looked up on each use, never kept: MyLLM can add its bridges after this script has run. */\nObject.defineProperty(window, \"files\", { configurable:true, get:function(){ return window.myllmFiles || null; } });\nvar out = document.getElementById('out');\nvar input = document.getElementById('in');\n/* NOT `history` — that is window.history (the History API), so `var history`\n   silently keeps the built-in and cmdHistory.push is undefined. The runtime\n   harness caught this; a regex scan never would. */\nvar cmdHistory = [];\nvar hIndex = -1;\nvar pending = null;      /* a confirmation waiting on y/n */\nvar cwd = '';            /* current directory, '' = workspace root */\nvar TRASH = '.trash';    /* where rm puts things; hidden from ls unless -a or you cd into it */\nvar undoStack = [];      /* this session's reversible changes, newest last */\nvar lastSnap = null;     /* most recent listing, for completion chips */\nvar stdin = null;        /* text piped into the next stage of a pipeline */\nvar aliases = {};        /* name -> expansion, kept in myllmStorage */\nObject.defineProperty(window, \"store\", { configurable:true, get:function(){ return window.myllmStorage || null; } });\nvar HISTORY_KEY = 'shell.history', ALIAS_KEY = 'shell.aliases';\n/* v9: the change log, the undo stack and path bookmarks survive closing the\n   app. Before, undo forgot everything the moment Shell was closed. */\nvar LOG_KEY = 'shell.log', UNDO_KEY = 'shell.undo', MARK_KEY = 'shell.marks';\nvar changeLog = [];      /* [{id, t, text}] newest last, the last 200 */\nvar marks = {};          /* bookmark name -> path, used as @name */\nvar prevCwd = null;      /* for  cd -  */\nvar batchId = null;      /* set while an approved batch runs, so undo reverses all of it */\nvar RC = '.shellrc';     /* optional startup script, in the workspace root */\nvar ASK_MAX = 8000;      /* how much material one `ask` may carry; a small on-device model has a small window */\nvar VERBS = ['ls','tree','cat','head','tail','sed','stat','find','grep','diff','jq','wc','sort','uniq','cut','tr','paste','comm','awk','xargs','man','changes','preview','date','info','scratch','versions','history','du','ask','dictate','open','share','mkdir','mv','cp','write','replace','edit','rm','rmdir','undo','log','revert','trash','restore','alias','unalias','mark','cd','pwd','clear','help'];\nvar KNOWN = VERBS.concat(['dir']);   /* everything the switch below answers to */\nfunction inTrash(path){ return path === TRASH || path.indexOf(TRASH + '/') === 0; }\n/* v12 (#9): the assistant's scratch space. Hidden like .trash, always at the\n   workspace root, capped, emptied each time Shell opens — and the ONE place\n   the assistant may write without asking. Nothing of yours lives there. */\nvar SCRATCH = '.scratch', SCRATCH_MAX = 200 * 1024;\nfunction inScratch(path){ return path === SCRATCH || path.indexOf(SCRATCH + '/') === 0; }\nfunction isHidden(path){ return inTrash(path) || inScratch(path); }\n/* Empty .scratch: every file, then the folder (folder removal alone is not\n   something every store does recursively). */\nasync function clearScratch(){\n  var lst = await files.list(), gone = 0;\n  for (var i = 0; i < lst.length; i++) if (inScratch(lst[i].path)){ await files.remove(lst[i].path); gone++; }\n  try { var fl = files.folders ? await files.folders() : [];\n    var dirs = fl.filter(inScratch).sort(function(a, b){ return b.length - a.length; });\n    for (var j = 0; j < dirs.length; j++) await files.removeFolder(dirs[j], false);\n  } catch(e){}\n  return gone;\n}\nasync function scratchUsed(except){\n  try { return (await files.list()).filter(function(f){ return inScratch(f.path) && f.path !== except; }).reduce(function(a, b){ return a + b.size; }, 0); }\n  catch(e){ return 0; }\n}\n\n/* The APP may be stateful — you are standing somewhere. The assistant's\n   workspace_shell tool deliberately is NOT: state that persists between tool\n   calls is a trap for a model that cannot see the prompt. Same grammar, one\n   extra verb here. */\nfunction resolve(p){\n  var s = String(p||'').trim();\n  /* .scratch is always the one at the root, wherever you (or the assistant) stand. */\n  if (s === SCRATCH || s.indexOf(SCRATCH + '/') === 0) return normalise(s);\n  /* @name and @name/sub/path: a saved place, so a long path is typed once. */\n  if (s.charAt(0) === '@'){\n    var mSlash = s.indexOf('/'), mName = (mSlash < 0 ? s.slice(1) : s.slice(1, mSlash)).toLowerCase();\n    if (Object.prototype.hasOwnProperty.call(marks, mName)) s = '/' + marks[mName] + (mSlash < 0 ? '' : s.slice(mSlash));\n  }\n  if (!s || s === '.') return cwd;\n  if (s.charAt(0) === '/') return normalise(s);\n  if (s === '..') return cwd.indexOf('/') < 0 ? '' : cwd.slice(0, cwd.lastIndexOf('/'));\n  var joined = cwd ? cwd + '/' + s : s;\n  /* collapse any a/b/../c the model or user typed */\n  var parts = [];\n  normalise(joined).split('/').forEach(function(seg){\n    if (seg === '..') parts.pop(); else if (seg && seg !== '.') parts.push(seg);\n  });\n  return parts.join('/');\n}\nfunction prompt$(){ return cwd ? '~/' + cwd : '~'; }\n\n/* Left: where you are. Right: what the workspace costs. Both refresh after any\n   command, so the bar is a live readout rather than decoration. */\nasync function paintPrompt(){\n  var l = document.getElementById('statusLeft');\n  if (l) l.textContent = prompt$() + (undoStack.length ? '  \\u00b7  undo \\u00d7' + undoStack.length : '');\n  var r = document.getElementById('statusRight');\n  if (r && files){\n    try{\n      var list = (await files.list()).filter(function(f){ return !isHidden(f.path); });\n      var total = list.reduce(function(a,b){ return a + b.size; }, 0);\n      r.textContent = list.length + (list.length === 1 ? ' file' : ' files') + '  \\u00b7  ' + bytes(total);\n    }catch(e){ r.textContent = ''; }\n  }\n}\n\n/* Two lines an entry, not one padded to a column. The old shape assumed a\n   terminal ~78 characters wide; this one is ~44 on a phone, so every line wrapped\n   and the list read as rubble. A command and its description, each on its own\n   line, never wraps raggedly however long the description gets. */\nvar HELP = [\n  ['ls [-R] [path]', 'list a folder (-R for the whole tree)'],\n  ['tree [path]', 'same as ls -R'],\n  ['cat <path>', 'print a file'],\n  ['head [-n N] <path>', 'the first N lines (default 20)'],\n  ['tail [-n N] <path>', 'the last N lines'],\n  ['stat <path>', 'size, modified, type'],\n  ['ls -t / ls -S', 'newest first / biggest first'],\n  ['sed -n 40,80p <path>', 'just lines 40 to 80'],\n  ['find <glob>', 'match filenames, e.g. find *.json'],\n  ['find -mtime -7', 'changed in the last 7 days'],\n  ['find -newer <path>', 'changed since that file'],\n  ['find -size +10k', 'bigger than 10 KB (-type d: folders)'],\n  ['grep <text> [path]', 'search inside files (-l for names)'],\n  ['grep -n -C 2 -v -c', 'numbers, context, non-matches, counts'],\n  ['grep -o -m 5 -w', 'match only, first 5, whole words'],\n  ['--include=*.md', 'grep only those (--exclude-dir=x)'],\n  ['grep /re?gex/', 'a pattern (or -E); -s matches case'],\n  ['diff <a> <b>', 'what changed between two files'],\n  ['diff <path>@2', 'version 2 against now'],\n  ['jq .a.b <path>', 'pull a value out of JSON'],\n  ['jq \".list[] | .name\"', 'each name in a list (also keys)'],\n  ['wc [-l] <path>', 'count lines, words, characters'],\n  ['sort [-r -n -k N]', 'sort lines (reverse, numbers, field)'],\n  ['uniq [-c]', 'fold repeats, with counts'],\n  ['cut -d , -f 2', 'pick fields (or -c 1-20)'],\n  ['awk \\'{print $2}\\'', 'columns (-F , for commas)'],\n  ['tr a-z A-Z', 'change characters (-d deletes)'],\n  ['paste a b / comm a b', 'side by side / what they share'],\n  ['… | xargs head -n 3', 'run a command on piped paths'],\n  ['du', 'space used per folder'],\n  '',\n  ['ask \"<question>\"', 'ask MyLLM; pipe a file in to work on it'],\n  ['dictate', 'speak instead of typing'],\n  ['open <path>', 'open the file in another app'],\n  ['share <path>', 'send the file out through iOS'],\n  '',\n  ['a | b', 'send a\\'s output into b'],\n  ['', 'cat, head, tail, grep, ask all read one'],\n  ['> <path>', 'put the output in a file'],\n  ['>> <path>', 'add it to the end of one instead'],\n  '',\n  ['mkdir <path>', 'create a folder'],\n  ['mv <from> <to>', 'move or rename (-f replaces)'],\n  ['write <path> <text>', 'replace a file with that text'],\n  ['replace <p> \"old\" \"new\"', 'swap text in a file (-1: first only)'],\n  ['edit <p> 3-5 \"text\"', 'change lines 3 to 5 (5+ inserts)'],\n  ['cp <from> <to>', 'copy a file or folder (-f replaces)'],\n  ['rm <path>', 'move a file to .trash'],\n  ['rmdir <path>', 'move a folder to .trash'],\n  ['rm -p / rmdir -p', 'delete for good; asks first'],\n  ['undo', 'reverse your last change (or batch)'],\n  ['log', 'recent changes, kept between visits'],\n  ['trash', 'what is in .trash'],\n  ['restore <path>', 'put something back from .trash'],\n  ['trash empty', 'delete all of it for good; asks first'],\n  ['versions <path>', 'previous versions of a file'],\n  ['revert <path> [N]', 'put version N back (1 = newest)'],\n  '',\n  ['history', 'the commands you have typed'],\n  ['!!', 'run the last one again'],\n  ['!5   !gr', 'number 5, or the last one starting gr'],\n  ['alias ll \"ls -R\"', 'make a shortcut'],\n  ['alias / unalias ll', 'list them / remove one'],\n  ['.shellrc', 'its lines run when Shell opens'],\n  ['cd <path>', 'change directory (cd .. goes up)'],\n  ['cd -', 'back to the previous folder'],\n  ['mark work', 'save this folder as @work'],\n  ['cd @work   ls @work', 'use it anywhere in a path'],\n  ['mark / mark -d work', 'list them / forget one'],\n  ['ls -a', 'show .trash too'],\n  ['clear', 'clear the screen'],\n  ['help', 'this list'],\n  ['man <command>', 'its exact flags'],\n  ['changes', 'what is new in Shell'],\n  ['preview <change>', 'what a change would do, safely'],\n  ['date   info', 'the time / the workspace at a glance'],\n  ['scratch [clear]', \"the assistant's notes (no approval)\"],\n  '',\n  'Anything else is a question for MyLLM. It',\n  'can run the read-only commands above to',\n  'answer, and asks before changing anything,',\n  'showing the diff of any edit it proposes.',\n  '',\n  'Try:',\n  'cat notes.md | ask \"sum this up\" > out.md'\n];\nfunction helpHTML(){\n  return HELP.map(function(row){\n    if (typeof row === 'string') return row ? '<span class=\"dim\">' + esc(row) + '</span>' : '';\n    return '<span class=\"cmd\">' + esc(row[0]) + '</span>\\n<span class=\"dim\">   ' + esc(row[1]) + '</span>';\n  }).join('\\n');\n}\n\n\nfunction esc(s){ return String(s==null?'':s)\n  .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }\n\n/* capture: when set, print() also COLLECTS text — for the agent loop, and for\n   each stage of a pipeline. quiet: and does not put it on screen, which is what\n   makes `cat big.md | ask \"summarise\"` show the summary and not the file. */\nvar capture = null;\nvar quiet = false;\nvar captureHadError = false;   /* did this capture print anything in red? */\nvar lastCaptureError = false;  /* ...read by the caller straight after captureOf */\n\nfunction print(text, cls){\n  if (capture !== null){\n    capture.push(String(text));\n    if (cls === 'err') captureHadError = true;\n  }\n  if (quiet) return;\n  var d = document.createElement('div');\n  if (cls) d.className = cls;\n  d.innerHTML = esc(text);\n  out.appendChild(d);\n  out.scrollTop = out.scrollHeight;\n}\nfunction printHTML(html){\n  /* Tags off AND entities back: a grep hit with an & in it used to reach the\n     pipe (or the file) as &amp;. */\n  if (capture !== null) capture.push(html.replace(/<[^>]+>/g, '')\n    .replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '\"').replace(/&#39;/g, \"'\").replace(/&amp;/g, '&'));\n  if (quiet) return;\n  var d = document.createElement('div');\n  d.innerHTML = html;\n  out.appendChild(d);\n  out.scrollTop = out.scrollHeight;\n}\n/* On screen only: never captured, never piped, removable. For \"asking\\u2026\",\n   which belongs to the person watching and not to the file being written. */\nfunction status(text){\n  var d = document.createElement('div');\n  d.className = 'dim'; d.textContent = text;\n  out.appendChild(d); out.scrollTop = out.scrollHeight;\n  return d;\n}\nfunction unstatus(d){ if (d && d.parentNode) d.parentNode.removeChild(d); }\nfunction haptic(k){ try{ window.myllmHaptic && myllmHaptic(k); }catch(e){} }\n\n/* ---------- helpers that mirror the tool ---------- */\n\nfunction tokenize(s){\n  var outv = [], cur = '', q = null;\n  /* grep/edit/replace: a /regex/ word may hold spaces (/todo \\w+/). Only a\n     span with no other / in it, so two paths are never glued together. */\n  var rxVerb = /^\\s*(grep|edit|replace)\\b/i.test(s);\n  for (var i=0;i<s.length;i++){\n    var c = s[i];\n    if (q){\n      if (c === '\\\\' && s[i+1] === q){ cur += q; i++; continue; }   /* \\\" inside \"…\" */\n      if (c === q) q = null; else cur += c;\n      continue;\n    }\n    if (rxVerb && c === '/' && !cur){\n      var close = -1;\n      for (var j = i + 1; j < s.length; j++){\n        if (s[j] === '\\\\'){ j++; continue; }\n        if (s[j] === '/'){ if (j + 1 === s.length || /[\\s+]/.test(s[j+1])) close = j; break; }\n      }\n      if (close > i + 1 && /\\s/.test(s.slice(i, close))){\n        cur = s.slice(i, close + 1); i = close;\n        if (s[i+1] === '+'){ cur += '+'; i++; }\n        continue;\n      }\n    }\n    if (c === '\"' || c === \"'\"){ q = c; }\n    else if (c === ' '){ if (cur){ outv.push(cur); cur = ''; } }\n    else cur += c;\n  }\n  if (cur) outv.push(cur);\n  return outv;\n}\n\nfunction normalise(p){\n  var s = String(p||'').trim();\n  while (s.indexOf('./') === 0) s = s.slice(2);\n  while (s.charAt(0) === '/') s = s.slice(1);\n  while (s.charAt(s.length-1) === '/') s = s.slice(0,-1);\n  return s === '.' ? '' : s;\n}\n\nfunction bytes(n){ return n < 1024 ? n + 'B' : (n/1024).toFixed(1) + 'K'; }\n\n/* ---------- the line, before it is a command ----------\n   A pipeline is split here rather than in run(), so every command stays a\n   command: it reads stdin if there is any, prints as it always did, and knows\n   nothing about where its output is going. */\n\nfunction restOf(line){\n  var t = String(line || '').trim();\n  var sp = t.search(/\\s/);\n  return sp < 0 ? '' : t.slice(sp + 1).trim();\n}\nfunction unquote(s){\n  var t = String(s || '').trim(), a = t.charAt(0);\n  if (t.length > 1 && (a === '\"' || a === \"'\") && t.charAt(t.length - 1) === a) return t.slice(1, -1);\n  return t;\n}\n/* Models fence their output even when told not to; a fence in a saved file is\n   the kind of thing you only notice a week later. */\nfunction stripFence(t){\n  var s2 = String(t || '').trim();\n  if (s2.indexOf('```') !== 0) return s2;\n  s2 = s2.replace(/^```[a-z]*\\s*\\n?/i, '');\n  var end = s2.lastIndexOf('```');\n  return (end >= 0 ? s2.slice(0, end) : s2).trim();\n}\n\n/* `a | b > c` -> { stages:['a','b'], redirect:{path:'c', append:false} }\n   Quotes are respected, so  grep \"a > b\"  is a search and not a redirect. */\nfunction splitPipeline(line){\n  var stages = [], cur = '', q = null, redirect = null;\n  var text = String(line || '');\n  for (var i = 0; i < text.length; i++){\n    var c = text.charAt(i);\n    if (q){ cur += c; if (c === q) q = null; continue; }\n    if (c === '\"' || c === \"'\"){ q = c; cur += c; continue; }\n    /* v10: a /regex/ word is quoted too, so  grep /a(b|c)/  stays one stage.\n       Only when it opens a word and closes before a space or the end: an\n       absolute path like /notes.md never has a closing slash there. */\n    if (c === '/' && (!cur.length || /\\s$/.test(cur))){\n      var close = -1;\n      for (var j = i + 1; j < text.length; j++){\n        if (text.charAt(j) === '\\\\'){ j++; continue; }\n        if (text.charAt(j) === '/' && (j + 1 === text.length || /\\s/.test(text.charAt(j + 1)))){ close = j; break; }\n      }\n      if (close > i + 1 && text.slice(i + 1, close).indexOf('|') >= 0){ cur += text.slice(i, close + 1); i = close; continue; }\n    }\n    if (c === '|'){ stages.push(cur); cur = ''; continue; }\n    if (c === '>'){\n      var append = text.charAt(i + 1) === '>';\n      redirect = { path: unquote(text.slice(i + (append ? 2 : 1)).trim()), append: append };\n      break;\n    }\n    cur += c;\n  }\n  stages.push(cur);\n  stages = stages.map(function(x){ return x.trim(); }).filter(function(x){ return x.length; });\n  return { stages: stages, redirect: redirect };\n}\n\n/* One pass only: an alias that expands to another alias is a loop waiting to\n   happen, and nobody needs two levels on a phone. */\nfunction expandAlias(stage){\n  var first = (tokenize(stage)[0] || '').toLowerCase();\n  if (!Object.prototype.hasOwnProperty.call(aliases, first)) return stage;\n  var rest = restOf(stage);\n  return aliases[first] + (rest ? ' ' + rest : '');\n}\n\n/* Only a line that STARTS with a command is parsed as a pipeline. \"which files\n   are > 1 kB?\" is a sentence, and splitting it on the > would quietly eat it. */\nfunction isCommandLine(line){\n  var first = (tokenize(line)[0] || '').toLowerCase();\n  if (!first) return false;\n  if (first.charAt(0) === '!') return true;\n  return KNOWN.indexOf(first) >= 0 || Object.prototype.hasOwnProperty.call(aliases, first);\n}\n\n/* Every stage read-only, and nothing being written to a file. Both callers run\n   without anyone typing y — the agent, and .shellrc at launch — so a redirect\n   has to count as a mutation here even though every verb in it is read-only. */\nfunction unsafeReason(line, allowed){\n  var pl = splitPipeline(line);\n  if (pl.redirect) return 'writing to a file with > or >> is a change — propose it instead';\n  if (!pl.stages.length) return 'empty command';\n  for (var i = 0; i < pl.stages.length; i++){\n    var tk = tokenize(expandAlias(pl.stages[i])), v = (tk[0] || '').toLowerCase();\n    if (KNOWN.indexOf(v) < 0) return 'stage ' + (i + 1) + ' \"' + pl.stages[i] + '\" is not a command (a | outside quotes or /regex/ was treated as a pipe)';\n    if (allowed.indexOf(v) < 0) return '\"' + v + '\" changes things, so it needs the user: propose it (read-only: ' + allowed.join(', ') + ')';\n    /* xargs runs another command: that one has to be read-only too. */\n    if (v === 'xargs'){ var inner = (tk[1] || '').toLowerCase(); if (allowed.indexOf(inner) < 0) return 'xargs ' + inner + ' changes things — propose it instead'; }\n  }\n  return null;\n}\n\n/* Run something with its output collected instead of (or as well as) shown.\n   Saves and restores, so a pipeline inside the agent loop nests correctly. */\nasync function captureOf(fn, silent){\n  var savedCap = capture, savedQuiet = quiet, savedErr = captureHadError;\n  capture = []; quiet = !!silent; captureHadError = false;\n  try { await fn(); }\n  catch(e){ capture.push('error: ' + (e && e.message || e)); captureHadError = true; }\n  var text = capture.join('\\n');\n  lastCaptureError = captureHadError;\n  capture = savedCap; quiet = savedQuiet; captureHadError = savedErr;\n  return text;\n}\nfunction runner(stage){ return function(){ return run(stage); }; }\n\nfunction mimeFor(name){\n  var n = String(name).toLowerCase(), dot = n.lastIndexOf('.');\n  var ext = dot > 0 ? n.slice(dot + 1) : '';\n  if (ext === 'json') return 'application/json';\n  if (ext === 'csv') return 'text/csv';\n  if (ext === 'html' || ext === 'htm') return 'text/html';\n  if (ext === 'md' || ext === 'markdown') return 'text/markdown';\n  return 'text/plain';\n}\n/* UTF-8 safe: btoa alone mangles anything above ASCII, and notes have accents\n   and em dashes in them. Chunked so a 5 MB file does not blow the stack. */\nfunction dataURL(text, mime){\n  var bs = new TextEncoder().encode(String(text == null ? '' : text));\n  var bin = '', CH = 0x8000;\n  for (var i = 0; i < bs.length; i += CH) bin += String.fromCharCode.apply(null, bs.subarray(i, i + CH));\n  return 'data:' + mime + ';base64,' + btoa(bin);\n}\n\n/* ---------- what persists between sessions (myllmStorage, not the workspace) ----------\n   History and aliases are the shell's own memory, not the user's documents, so\n   they live in per-app storage where they cannot clutter a file listing. */\nasync function loadState(){\n  if (!store) return;\n  try {\n    var h = await store.getItem(HISTORY_KEY);\n    if (h){ var arr = JSON.parse(h); if (Array.isArray(arr)) cmdHistory = arr.slice(-200); }\n  } catch(e){}\n  try {\n    var a = await store.getItem(ALIAS_KEY);\n    if (a){ var obj = JSON.parse(a); if (obj && typeof obj === 'object') aliases = obj; }\n  } catch(e){}\n  try { var lg = JSON.parse(await store.getItem(LOG_KEY) || '[]'); if (Array.isArray(lg)) changeLog = lg.slice(-200); } catch(e){}\n  try { var us = JSON.parse(await store.getItem(UNDO_KEY) || '[]'); if (Array.isArray(us)) undoStack = us.slice(-30); } catch(e){}\n  try { var mk = JSON.parse(await store.getItem(MARK_KEY) || '{}'); if (mk && typeof mk === 'object') marks = mk; } catch(e){}\n  hIndex = cmdHistory.length;\n}\n/* Written on every command rather than debounced: a command is something a\n   person typed, not a per-frame event, and a debounce only buys the chance to\n   lose the last one when the app is closed straight after running it. */\nfunction saveHistory(){\n  if (!store) return;\n  try { store.setItem(HISTORY_KEY, JSON.stringify(cmdHistory.slice(-200))); } catch(e){}\n}\nfunction saveAliases(){\n  if (!store) return;\n  try { store.setItem(ALIAS_KEY, JSON.stringify(aliases)); } catch(e){}\n}\nfunction saveMarks(){ if (store) try { store.setItem(MARK_KEY, JSON.stringify(marks)); } catch(e){} }\nfunction saveLog(){ if (store) try { store.setItem(LOG_KEY, JSON.stringify(changeLog.slice(-200))); } catch(e){} }\n/* App storage is ~1 MB for everything, and an undo entry for a rewritten file\n   carries the old text. Oldest entries go first until the stack fits; an entry\n   whose old text alone is too big is kept but marked, so undo can say so\n   rather than \"restore\" an empty file. */\nfunction saveUndo(){\n  if (!store) return;\n  var ops = undoStack.map(function(op){\n    if (op.prev != null && op.prev.length > 150000){ var c = Object.assign({}, op); delete c.prev; c.prevLost = true; return c; }\n    if (op.items){ var c2 = Object.assign({}, op); c2.items = op.items.map(function(it){\n      return it.prev != null && it.prev.length > 150000 ? { path: it.path, prevLost: true } : it; }); return c2; }\n    return op;\n  });\n  var json = JSON.stringify(ops);\n  while (json.length > 600000 && ops.length){ ops.shift(); json = JSON.stringify(ops); }\n  try { store.setItem(UNDO_KEY, json); } catch(e){}\n}\n\n/* !! / !5 / !gr — resolved before the line is echoed, so what you see in the\n   scrollback and what goes into history is the command that actually ran. */\nfunction expandBang(line){\n  if (line.charAt(0) !== '!') return line;\n  var rest = line.slice(1);\n  if (!rest || rest === '!') return cmdHistory.length ? cmdHistory[cmdHistory.length - 1] : null;\n  if (/^\\d+$/.test(rest)) return cmdHistory[parseInt(rest, 10) - 1] || null;\n  for (var i = cmdHistory.length - 1; i >= 0; i--)\n    if (cmdHistory[i].toLowerCase().indexOf(rest.toLowerCase()) === 0) return cmdHistory[i];\n  return null;\n}\n\n/* .shellrc: the lines that run when Shell opens. Nobody is at the prompt yet,\n   so it is held to the same bar as the agent — look around, set up, change\n   nothing. A rm in a startup file would run before you could stop it. */\nvar RC_SAFE = ['cd','alias','unalias','mark','clear','ls','dir','tree','pwd','du','cat','head','tail','sed','stat','find','grep','diff','jq','wc','sort','uniq','cut','tr','paste','comm','awk','xargs','man','changes','preview','date','info','scratch','versions','history','log'];\nasync function runRC(){\n  var text = null;\n  try { text = await files.read(RC); } catch(e){}\n  if (text == null) return;\n  var lines = text.split('\\n'), ran = 0;\n  for (var i = 0; i < lines.length; i++){\n    var l = lines[i].trim();\n    if (!l || l.charAt(0) === '#') continue;\n    var why = unsafeReason(l, RC_SAFE);\n    if (why){ print(RC + ':' + (i + 1) + ': skipped — ' + why, 'err'); continue; }\n    try { await runLine(l); } catch(e){ print(RC + ':' + (i + 1) + ': ' + (e && e.message || e), 'err'); }\n    if (++ran >= 20){ print(RC + ': stopped after 20 lines', 'dim'); break; }\n  }\n}\n\n/* ---------- a line, end to end ---------- */\nasync function runLine(line){\n  var text = String(line || '').trim();\n  if (!text) return;\n  if (!isCommandLine(text)){ stdin = null; return run(text); }\n\n  var pl = splitPipeline(text);\n  if (!pl.stages.length) return;\n  if (pl.redirect && !pl.redirect.path) return print('> needs a file name, e.g.  ls > list.txt', 'err');\n\n  /* A stage that isn't a command would otherwise be sent to the assistant as a\n     question, which is never what a | meant. Say where the split happened. */\n  if (pl.stages.length > 1){\n    for (var si = 0; si < pl.stages.length; si++){\n      var sv = (tokenize(expandAlias(pl.stages[si]))[0] || '').toLowerCase();\n      if (KNOWN.indexOf(sv) < 0) return print('stage ' + (si + 1) + ' (' + pl.stages[si] + ') is not a command: a | outside quotes or /regex/ starts a new stage. Put the pattern in quotes or /…/.', 'err');\n    }\n  }\n  var piped = null;\n  for (var i = 0; i < pl.stages.length; i++){\n    var stage = expandAlias(pl.stages[i]);\n    stdin = piped;\n    /* The last stage of a plain pipeline prints for itself — in colour, with\n       its paths still tappable. Only what is on its way to a file is captured. */\n    if (i === pl.stages.length - 1 && !pl.redirect) return run(stage);\n    piped = await captureOf(runner(stage), true);\n    if (lastCaptureError){ print(piped, 'err'); return; }   /* a failed stage never reaches a file */\n  }\n\n  var dest = resolve(pl.redirect.path);\n  if (!dest) return print('> needs a file name, e.g.  ls > list.txt', 'err');\n  var body = piped == null ? '' : piped;\n  var added = body.length;\n  var prev = await files.read(dest);\n  if (pl.redirect.append && prev != null && prev.length)\n    body = prev + (prev.charAt(prev.length - 1) === '\\n' ? '' : '\\n') + body;\n  if (inScratch(dest) && (await scratchUsed(dest)) + body.length > SCRATCH_MAX)\n    return print(SCRATCH + ' is full (200 KB) — scratch clear  empties it', 'err');\n  await files.write(dest, body);\n  /* Scratch is the assistant's working paper: not on your undo stack or log. */\n  if (inScratch(dest)){ print((pl.redirect.append ? 'appended ' : 'wrote ') + added + ' chars to ' + dest + '  (scratch — cleared when Shell opens)', 'dim'); return; }\n  remember({ type: 'write', path: dest, prev: prev });\n  haptic('success');\n  print((pl.redirect.append ? 'appended ' : 'wrote ') + added + ' chars to ' + dest +\n        (prev != null && !pl.redirect.append ? ' (replaced ' + prev.length + ')' : '') +\n        '  —  undo  puts it back', 'ok');\n}\n\nfunction when(ms){\n  var d = new Date(ms);\n  function p(x){ return (x<10?'0':'') + x; }\n  return d.getFullYear() + '-' + p(d.getMonth()+1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());\n}\n\nfunction glob(pattern, name){\n  if (pattern.indexOf('*') < 0 && pattern.indexOf('?') < 0)\n    return name.toLowerCase().indexOf(pattern.toLowerCase()) >= 0;\n  var rx = '^' + pattern.replace(/[.+^${}()|[\\]\\\\]/g,'\\\\$&')\n                        .replace(/\\*/g,'.*').replace(/\\?/g,'.') + '$';\n  return new RegExp(rx,'i').test(name);\n}\n\n/* Path-aware globs: * stays inside one folder, ** crosses folders, ? is one\n   character. A pattern is relative to where you stand unless it starts with /. */\nfunction globRx(pattern){\n  var src = '', i = 0;\n  while (i < pattern.length){\n    var c = pattern.charAt(i);\n    if (c === '*' && pattern.charAt(i + 1) === '*'){ src += pattern.charAt(i + 2) === '/' ? '(?:.*/)?' : '.*'; i += pattern.charAt(i + 2) === '/' ? 3 : 2; continue; }\n    if (c === '*'){ src += '[^/]*'; i++; continue; }\n    if (c === '?'){ src += '[^/]'; i++; continue; }\n    src += c.replace(/[.+^${}()|[\\]\\\\]/g, '\\\\$&'); i++;\n  }\n  return new RegExp('^' + src + '$', 'i');\n}\nfunction isGlob(s){ return /[*?]/.test(String(s)); }\n/* Expand the operands of a multi-path command. Plain paths pass through (even\n   missing ones, so the command can say so); a glob becomes every match. */\nfunction expandPaths(opsList, snap, withFolders){\n  var outp = [];\n  opsList.forEach(function(o){\n    if (!isGlob(o)){ outp.push(resolve(o)); return; }\n    var abs = o.charAt(0) === '/' ? normalise(o) : (cwd ? cwd + '/' : '') + o;\n    var rx = globRx(abs);\n    var hits = snap.files.map(function(f){ return f.path; }).filter(function(p){ return rx.test(p); });\n    if (withFolders) hits = hits.concat(snap.folders.filter(function(d){ return rx.test(d); }));\n    hits.sort();\n    if (!hits.length) outp.push({ noMatch: o }); else outp.push.apply(outp, hits);\n  });\n  return outp;\n}\n\nasync function snapshot(includeHidden){\n  var list = await files.list();\n  var folders = files.folders ? await files.folders() : [];\n  var all = { files: list, folders: folders };\n  lastSnap = all;\n  if (includeHidden || isHidden(cwd)) return all;\n  return { files: list.filter(function(f){ return !isHidden(f.path); }),\n           folders: folders.filter(function(d){ return !isHidden(d); }) };\n}\n/* Where a deleted thing goes. Keeps the original path under .trash so restore\n   is a straight move back; a second delete of the same name gets a suffix. */\nfunction trashPath(target){\n  var snap = lastSnap || { files: [], folders: [] };   /* the UNFILTERED listing — run()'s hides .trash */\n  var dest = TRASH + '/' + target;\n  var taken = snap.files.some(function(f){ return f.path === dest || f.path.indexOf(dest + '/') === 0; }) || snap.folders.indexOf(dest) >= 0;\n  if (!taken) return dest;\n  var dot = target.lastIndexOf('.'), slash = target.lastIndexOf('/');\n  var stamp = '~' + new Date().toISOString().slice(0,19).replace(/[-:T]/g,'');\n  return TRASH + '/' + (dot > slash ? target.slice(0,dot) + stamp + target.slice(dot) : target + stamp);\n}\n/* After a restore, the folder that held the item may be left empty inside\n   .trash. Sweep those (deepest first) so `trash` never shows hollow folders. */\nasync function pruneTrash(){\n  try{\n    var all = await snapshot(true);\n    var dirs = all.folders.filter(function(d){ return inTrash(d) && d !== TRASH; }).sort(function(a,b){ return b.length - a.length; });\n    for (var i = 0; i < dirs.length; i++){\n      var d = dirs[i];\n      var busy = all.files.some(function(f){ return f.path.indexOf(d + '/') === 0; }) ||\n                 all.folders.some(function(x){ return x !== d && x.indexOf(d + '/') === 0 && !dirs.slice(0, i).some(function(gone){ return gone === x; }); });\n      if (!busy) await files.removeFolder(d, false);\n    }\n    var again = await snapshot(true);\n    if (again.folders.indexOf(TRASH) >= 0 && !again.files.some(function(f){ return inTrash(f.path); }) &&\n        !again.folders.some(function(d){ return d !== TRASH && inTrash(d); })) await files.removeFolder(TRASH, false);\n  }catch(e){}\n}\nfunction pathHTML(p, label){ return '<span class=\"path\" data-path=\"' + esc(p) + '\">' + esc(label == null ? p : label) + '</span>'; }\n\n/* ---------- man pages: the exact flags each command takes ----------\n   Kept beside the code they describe, so a flag added there is a line added here. */\nvar MAN = {\n  ls: ['ls [path]   ls -R / tree   ls -a (show .trash)', '-t newest first   -S biggest first', '-l long: type, readable size, modified, name (folders: total + file count)', 'tree -L N  only N levels deep'],\n  tree: ['tree [path] [-L N]  — the whole tree, or N levels'],\n  cat: ['cat <path…>  (several paths or a glob: a header per file)', 'reads stdin when given no path'],\n  head: ['head [-n N] [-c N] <path…>  first N lines (20) or N characters', 'several paths or a glob (head -n 3 *.md): a header per file'],\n  tail: ['tail [-n N] [-c N] <path…>  last N lines or characters'],\n  sed: [\"sed -n '40,80p' <path>   also '40p', '40,$p', '40,+20p'\", 'reads ranges only — use  edit  to change lines'],\n  stat: ['stat <path…>  size (bytes and readable), modified; folders: file count, total', 'globs work: stat notes/*'],\n  find: ['find [start] [glob] — a glob with / matches the whole path (projects/**/*.md),', '  otherwise the file name', '-name/-path <glob>   -maxdepth N   -type f|d', '-mtime -7 (days)  -mtime -2h  -mtime -30m  +30 = older than', '-mmin -30   -newer <path>   -size +10k / -2k / +1m / exact bytes', 'time filters sort newest first'],\n  grep: ['grep [flags] <text|/regex/> [path]  — case-insensitive unless -s (-i accepted)', '-n line numbers (piped)  -C N context  -v non-matching  -c counts', '-l file names  -o only the match  -m N first N per file  -w whole words', '-E regex   --include=*.md   --exclude-dir=archives', 'a | inside /regex/ or quotes stays part of the pattern'],\n  diff: ['diff <a> <b>   diff <path>@N (version N vs now)   diff <path> (newest saved vs now)', 'diff <path>@3 <path>@1   two old versions   - = piped input', 'versions are numbered as  history <path>  lists them, 1 = newest'],\n  jq: ['jq [-r] <filter> <path>   or  cat x.json | jq <filter>', '.a.b  .list[0]  .list[]  .\"odd key\"  .a?  ..  (every value)', 'select(.n > 1)  select(.name | test(\"re\"))  select(has(\"k\"))', 'map(.name)  to_entries  from_entries  keys  length  type  values  not', '== != < <= > >=   -r prints strings without quotes'],\n  wc: ['wc [-l] [-w] [-c] <path…>  lines, words, characters (stdin too)'],\n  sort: ['sort [-r] [-n] [-u] [-k N] [-t X] [path]', '-r reverse  -n numeric  -u drop repeats  -k field N  -t field separator'],\n  uniq: ['uniq [-c] [-d]  folds repeated NEIGHBOURS (sort first)  -c counts  -d repeats only'],\n  cut: ['cut -d X -f 1,3 | -f 2-4   cut -c 1-20   (tab-separated by default)'],\n  tr: ['tr <from> <to>   tr -d <chars>   tr -s <chars>   ranges like a-z, and \\\\n \\\\t'],\n  paste: ['paste <a> <b>  side by side (tab; -d , for commas)   paste -s  one line per file'],\n  comm: ['comm <a> <b>  only-in-a | only-in-b | both (sorted)  -12 common only  -23 only in a'],\n  awk: [\"awk [-F X] '[/regex/] {print $1, $3}'   $0 line  $NF last field  NF  NR  \\\"text\\\"\", 'print is all this awk does'],\n  xargs: ['… | xargs <command>  runs it on the paths that came down the pipe', 'e.g.  grep -l TODO notes | xargs head -n 5   find *.md | xargs wc -l'],\n  history: ['history            the commands you typed  (!! / !5 / !gr rerun)', 'history <path>     same as versions <path>'],\n  versions: ['versions <path>  saved versions of a file, 1 = newest  (diff <path>@N shows a change; revert <path> N puts one back)'],\n  du: ['du  space per folder, biggest first (sizes are already readable; -h accepted)'],\n  ask: ['ask \"question\"   or   … | ask \"instruction\"  — one answer, no tools; pipe it on or > save it'],\n  open: ['open <path>  hand a text file to an app that opens text'],\n  share: ['share <path>  send the file out through the iOS share sheet'],\n  dictate: ['dictate  speak instead of typing; > saves it'],\n  mkdir: ['mkdir <path>'],\n  mv: ['mv [-f] <from> <to>   mv [-f] <a> <b> <folder>   mv *.md archive  (one undo for all)', '-f replaces an existing destination'],\n  cp: ['cp [-f] <from> <to>   cp <folder> <copy>   cp *.md backup  (one undo for all)'],\n  write: ['write <path> <text>  replaces the whole file (new files too)'],\n  replace: ['replace [-1] <path> \"old\" \"new\"   -1 first only   \\\\n = line break', 'replace -E <path> \"re(gex)\" \"new $1\"   or \"/re/\" as the old text'],\n  edit: ['edit <path> 3 \"text\"   edit <path> 3-5 \"text\"   edit <path> 5+ \"insert after 5\"', 'edit <path> /pattern/ \"text\"  the first matching line (-a every one)', 'edit <path> /pattern/+ \"insert after it\"   empty text deletes   \\\\n = line break'],\n  rm: ['rm <path>  to .trash (undo / restore)   rm -p  for good, asks first'],\n  rmdir: ['rmdir <path>  folder to .trash   rmdir -p  for good, asks first'],\n  undo: ['undo  reverses your last change — or the whole batch it was part of; survives closing Shell'],\n  log: ['log [-n N] [path]  changes made via Shell (newest first, what undo would reverse), then files', 'changed OUTSIDE Shell in the last 7 days (other apps, the assistant, sync), from file times'],\n  revert: ['revert <path> [N]  put saved version N back (1 = newest)'],\n  trash: ['trash  what is in .trash    trash empty  delete it for good (asks)'],\n  restore: ['restore [-f] <path>  from .trash back to where it was'],\n  alias: ['alias  list   alias ll \"ls -l\"  make one   unalias ll  remove'],\n  unalias: ['unalias <name>'],\n  mark: ['mark  list   mark work [path]  save here (or path) as @work   mark -d work', 'use @work anywhere a path goes: cd @work, ls @work/reports'],\n  cd: ['cd <path>   cd ..   cd /   cd -  (previous folder)   cd @mark'],\n  pwd: ['pwd  where you are'],\n  clear: ['clear  the screen'],\n  help: ['help  every command   man <command>  its flags   changes  what is new'],\n  man: ['man <command>  the flags a command takes'],\n  changes: ['changes  what is new in Shell, newest first'],\n  preview: ['preview <write|replace|edit|mv|cp|rm|rmdir|mkdir …>  what it WOULD do — the diff, the moves, clashes, missing files', 'changes nothing; the assistant can run it before proposing'],\n  date: ['date  today, time, zone, ISO and unix time'],\n  scratch: ['scratch  what is in .scratch, the assistant\\'s working paper   scratch clear  empty it', 'the assistant may write there without asking; 200 KB; emptied each time Shell opens; hidden from ls (ls -a shows it)'],\n  info: ['info  the workspace at a glance: files, size of 25 MB, top folders, newest changes, oldest file, bookmarks']\n};\nvar CHANGES = [\n  'Shell v13 (5 Oct 2026)',\n  '  a working bar while MyLLM thinks or runs a step: what it is doing, seconds, and Stop',\n  '  a second Enter no longer re-sends a question that is still being worked on',\n  '  your questions to MyLLM have their own colour',\n  'Shell v12 (5 Oct 2026)',\n  '  full screen with a ✕ (MyLLM 5.6.2+) · no pinch or focus zoom',\n  '  .scratch: the assistant\\'s working notes, no approval needed (200 KB, emptied each launch) · scratch [clear]',\n  '  log also lists files changed outside Shell · preview rm/rmdir names every file, size, date, recent edits',\n  '  times say their zone · key-like values are masked before anything reaches the model',\n  '  versions <path> (history <path> still works) · info shows hidden .trash/.scratch counts',\n  'Shell v11 (5 Oct 2026)',\n  '  the assistant: no folder dump on screen per question; several looks per step; a note to you',\n  '  while it works; its own cd (yours is put back); it learns what became of its proposals',\n  '  preview <change> (dry run) · date · info · long output says where it was cut and how to read on',\n  'Shell v10 (5 Oct 2026)',\n  '  | inside /regex/ or quotes stays in the pattern; a pipe stage that is not a command says so',\n  '  xargs · tr · paste · comm · awk {print $N} · head/tail -c N',\n  '  find: path globs (projects/**/*.md), start folder, -maxdepth, -mtime -2h/-30m, -mmin',\n  '  grep: --include=, --exclude-dir=, -o, -m N, -w',\n  '  jq: select, map, to_entries, from_entries, .., test/has/contains, comparisons',\n  '  ls -l, tree -L N · cat/head/tail/stat take several paths or globs',\n  '  log <path>, log -n N · replace -E (regex) · edit /pattern/ · mv/cp several or *.md',\n  '  man <command> · changes · the assistant sees ok / found nothing / failed per step',\n  'Shell v9 (5 Oct 2026)',\n  '  diff (file@N), grep -n -C -v -c -s /regex/, sed -n ranges, wc sort uniq cut,',\n  '  ls -t/-S, find -mtime/-newer/-size/-type d, jq, replace/edit with a diff before y,',\n  '  cp, batch proposals (one y, one undo), log, undo kept between visits, cd -, mark/@name',\n  'Shell v7–v8: pipes and > >>, ask as a filter, open/share/dictate, history !!, aliases, .shellrc',\n  'Shell v5: .trash, undo, restore, grep, tap-to-complete'\n];\n\n/* The phone's zone, said once wherever times are listed (BST ends 25 Oct). */\nfunction zoneLabel(){\n  var off = -new Date().getTimezoneOffset(), tz = '';\n  try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch(e){}\n  return (tz ? tz + ' ' : '') + 'UTC' + (off >= 0 ? '+' : '-') + Math.floor(Math.abs(off) / 60) + (Math.abs(off) % 60 ? ':' + ('0' + Math.abs(off) % 60).slice(-2) : '');\n}\n/* v12: anything bound for the MODEL (the assistant's steps, ask's material)\n   has values that look like keys masked. The person at the screen still sees\n   them; a token in system/github.json shouldn't travel to a cloud model. */\nvar SECRET_KEY_RX = /([\"']?)([A-Za-z0-9_.-]*(?:token|secret|password|passwd|api[_-]?key|access[_-]?key|private[_-]?key|authorization|credential|cookie)[A-Za-z0-9_.-]*)\\1(\\s*[:=]\\s*)([\"']?)([^\"'\\s,}\\]]{8,})\\4/gi;\nvar SECRET_RAW_RX = /\\b(?:sk-(?:ant-)?[A-Za-z0-9_-]{16,}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|xox[abpr]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{30,}|eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,})\\b|(Bearer\\s+)[A-Za-z0-9._~+\\/-]{12,}=*/g;\nfunction maskSecrets(t){\n  var masked = 0;\n  var r = String(t == null ? '' : t).replace(SECRET_KEY_RX, function(m, q1, key, sep, q2, val){\n    if (/^\\d+$/.test(val) || /^(true|false|null)$/i.test(val)) return m;   /* \"tokens\": 1234 is a count */\n    masked++; return q1 + key + q1 + sep + q2 + '[masked]' + q2;\n  }).replace(SECRET_RAW_RX, function(m, bearer){ masked++; return bearer ? bearer + '[masked]' : '[masked]'; });\n  return masked ? r + '\\n[' + masked + ' value(s) that look like keys were masked — the user sees them]' : r;\n}\n\n/* ---------- v9 helpers: options, text tools, diff, json, edits ---------- */\n\n/* Options for commands whose flags take a value (sort -k 2, cut -d ,).\n   `withValue` names those letters; everything else is a boolean flag. */\nfunction parseOpts(raw, withValue){\n  var o = { flags: {}, vals: {}, ops: [] };\n  for (var i = 0; i < raw.length; i++){\n    var a = raw[i];\n    if (a.length > 1 && a.charAt(0) === '-' && !/^-\\d/.test(a)){\n      for (var j = 1; j < a.length; j++){\n        var c = a.charAt(j);\n        if (withValue.indexOf(c) >= 0){\n          var v = a.slice(j + 1); if (!v && i + 1 < raw.length) v = raw[++i];\n          o.vals[c] = v; break;\n        }\n        o.flags[c] = true;\n      }\n    } else o.ops.push(a);\n  }\n  return o;\n}\n/* What a text command works on: what was piped in, or a file. */\nasync function textFrom(sin, pathArg, verb){\n  if (sin != null && !pathArg) return { text: sin };\n  if (!pathArg) return { err: verb + ' needs a path, or something piped in' };\n  var t = await files.read(resolve(pathArg));\n  if (t == null) return { err: 'No such file: ' + resolve(pathArg) };\n  return { text: t };\n}\n/* A footnote for the person at the screen. Never captured, so it can't land in\n   a pipe or a file the way head's \"[N lines total]\" does. */\nfunction note(text){ if (capture === null) print(text, 'dim'); }\nfunction lines$(t){ var l = String(t).split('\\n'); if (l.length && l[l.length - 1] === '') l.pop(); return l; }\n\n/* Line diff: LCS over what is left after the common head and tail, then\n   unified hunks with 3 lines of context. Big files fall back to a summary\n   rather than freezing the page. */\nfunction lineDiff(a, b){\n  var pre = 0; while (pre < a.length && pre < b.length && a[pre] === b[pre]) pre++;\n  var suf = 0; while (suf < a.length - pre && suf < b.length - pre && a[a.length-1-suf] === b[b.length-1-suf]) suf++;\n  var A = a.slice(pre, a.length - suf), B = b.slice(pre, b.length - suf);\n  if (A.length * B.length > 4000000) return null;\n  var n = A.length, m = B.length, i, j;\n  var L = []; for (i = 0; i <= n; i++){ L.push(new Uint32Array(m + 1)); }\n  for (i = n - 1; i >= 0; i--) for (j = m - 1; j >= 0; j--)\n    L[i][j] = A[i] === B[j] ? L[i+1][j+1] + 1 : Math.max(L[i+1][j], L[i][j+1]);\n  var ops = [];\n  for (i = 0; i < pre; i++) ops.push([' ', a[i]]);\n  i = 0; j = 0;\n  while (i < n && j < m){\n    if (A[i] === B[j]){ ops.push([' ', A[i]]); i++; j++; }\n    else if (L[i+1][j] >= L[i][j+1]) ops.push(['-', A[i++]]);\n    else ops.push(['+', B[j++]]);\n  }\n  while (i < n) ops.push(['-', A[i++]]);\n  while (j < m) ops.push(['+', B[j++]]);\n  for (i = a.length - suf; i < a.length; i++) ops.push([' ', a[i]]);\n  return ops;\n}\nfunction diffHTML(ops, labelA, labelB){\n  var CTX = 3, out = ['<span class=\"dim\">--- ' + esc(labelA) + '\\n+++ ' + esc(labelB) + '</span>'];\n  var adds = 0, dels = 0, k, aN = 0, bN = 0, pos = [];\n  for (k = 0; k < ops.length; k++){ pos.push([aN, bN]); if (ops[k][0] !== '+') aN++; if (ops[k][0] !== '-') bN++; }\n  var changed = []; for (k = 0; k < ops.length; k++) if (ops[k][0] !== ' ') changed.push(k);\n  if (!changed.length) return null;\n  var hunks = [], s0 = Math.max(0, changed[0] - CTX), e0 = Math.min(ops.length - 1, changed[0] + CTX);\n  for (k = 1; k < changed.length; k++){\n    if (changed[k] - CTX <= e0 + 1) e0 = Math.min(ops.length - 1, changed[k] + CTX);\n    else { hunks.push([s0, e0]); s0 = Math.max(0, changed[k] - CTX); e0 = Math.min(ops.length - 1, changed[k] + CTX); }\n  }\n  hunks.push([s0, e0]);\n  hunks.forEach(function(h){\n    var aCount = 0, bCount = 0;\n    for (var x = h[0]; x <= h[1]; x++){ if (ops[x][0] !== '+') aCount++; if (ops[x][0] !== '-') bCount++; }\n    out.push('<span class=\"dim\">@@ -' + (pos[h[0]][0] + 1) + ',' + aCount + ' +' + (pos[h[0]][1] + 1) + ',' + bCount + ' @@</span>');\n    for (var y = h[0]; y <= h[1]; y++){\n      var t = ops[y][0], line = esc(ops[y][1]);\n      if (t === '-'){ dels++; out.push('<span class=\"err\">-' + line + '</span>'); }\n      else if (t === '+'){ adds++; out.push('<span class=\"ok\">+' + line + '</span>'); }\n      else out.push('<span class=\"dim\"> ' + line + '</span>');\n    }\n  });\n  return { html: out.join('\\n'), adds: adds, dels: dels };\n}\n/* file, file@N (a saved version, 1 = newest), or - for what was piped in. */\nasync function loadSpec(spec, sin){\n  if (spec === '-'){ if (sin == null) return { err: '- means piped input, and nothing was piped' }; return { label: '(piped)', text: sin }; }\n  var m = /^(.*)@(\\d+)$/.exec(spec), path = resolve(m ? m[1] : spec);\n  if (!m){\n    var t = await files.read(path);\n    return t == null ? { err: 'No such file: ' + path } : { label: path, text: t };\n  }\n  if (!files.versions || !files.readVersion) return { err: 'Version history needs the latest MyLLM build.' };\n  var vs = await files.versions(path), v = +m[2];\n  if (!vs.length) return { err: 'No previous versions of ' + path };\n  if (v < 1 || v > vs.length) return { err: path + ' has versions 1\\u2013' + vs.length + '  (see  history ' + path + ')' };\n  var old = await files.readVersion(path, vs[v - 1].stamp);\n  if (old == null) return { err: 'Could not read version ' + v + ' of ' + path };\n  return { label: path + '@' + v + '  (' + when(vs[v - 1].stamp) + ')', text: old };\n}\n\n/* A small jq. Paths (.a.b, .a[0], .a[], .\"odd key\", .[\"odd key\"], a trailing ?),\n   pipes, ..  (every value in the document), select(cond), map(f), to_entries,\n   from_entries, keys, length, type, values, not, test(\"re\"), has(\"k\"),\n   contains(\"s\"), ascii_downcase, and == != < <= > >= against literals or paths. */\nfunction jqSplit(f, sep){\n  sep = sep || '|';\n  var parts = [], cur = '', depth = 0, q = false;\n  for (var i = 0; i < f.length; i++){\n    var c = f.charAt(i);\n    if (q){ cur += c; if (c === '\\\\'){ cur += f.charAt(++i); continue; } if (c === '\"') q = false; continue; }\n    if (c === '\"'){ q = true; cur += c; continue; }\n    if (c === '[' || c === '(') depth++;\n    if (c === ']' || c === ')') depth--;\n    if (c === sep && !depth){ parts.push(cur.trim()); cur = ''; continue; }\n    cur += c;\n  }\n  parts.push(cur.trim());\n  return parts;\n}\nfunction jqEval(filter, inputs){\n  return jqSplit(filter).reduce(function(acc, stage){\n    var outv = [];\n    acc.forEach(function(v){ outv = outv.concat(jqOne(stage, v)); });\n    return outv;\n  }, inputs);\n}\nfunction jqLiteral(t){\n  t = t.trim();\n  if (/^-?\\d+(\\.\\d+)?$/.test(t)) return { ok: true, v: +t };\n  if (/^\"(?:[^\"\\\\]|\\\\.)*\"$/.test(t)) return { ok: true, v: JSON.parse(t) };\n  if (t === 'true' || t === 'false' || t === 'null') return { ok: true, v: JSON.parse(t) };\n  return { ok: false };\n}\nfunction jqTruthy(x){ return !(x === false || x === null || x === undefined); }\nfunction jqOne(stage, v){\n  var m;\n  if (stage === '.' || stage === '') return [v];\n  if (stage === '..'){\n    var all = [];\n    (function walk(x){ all.push(x); if (x && typeof x === 'object') (Array.isArray(x) ? x : Object.keys(x).map(function(k){ return x[k]; })).forEach(walk); })(v);\n    return all;\n  }\n  var lit = jqLiteral(stage); if (lit.ok) return [lit.v];\n  /* comparisons, at the top level of this stage */\n  var ops2 = ['==','!=','<=','>=','<','>'];\n  for (var oi = 0; oi < ops2.length; oi++){\n    var at = jqTopIndex(stage, ops2[oi]);\n    if (at > 0){\n      var L = jqEval(stage.slice(0, at), [v])[0], Rt = stage.slice(at + ops2[oi].length);\n      var R = jqLiteral(Rt).ok ? jqLiteral(Rt).v : jqEval(Rt.trim(), [v])[0];\n      switch (ops2[oi]){\n        case '==': return [JSON.stringify(L) === JSON.stringify(R)];\n        case '!=': return [JSON.stringify(L) !== JSON.stringify(R)];\n        case '<=': return [L <= R]; case '>=': return [L >= R];\n        case '<': return [L < R]; case '>': return [L > R];\n      }\n    }\n  }\n  if ((m = /^select\\((.*)\\)$/.exec(stage))) return jqEval(m[1], [v]).some(jqTruthy) ? [v] : [];\n  if ((m = /^map\\((.*)\\)$/.exec(stage))){\n    if (!Array.isArray(v)) throw new Error('map needs an array');\n    var mapped = []; v.forEach(function(x){ mapped = mapped.concat(jqEval(m[1], [x])); }); return [mapped];\n  }\n  if ((m = /^test\\(\\s*(\"(?:[^\"\\\\]|\\\\.)*\")\\s*\\)$/.exec(stage))) return [typeof v === 'string' && new RegExp(JSON.parse(m[1]), 'i').test(v)];\n  if ((m = /^has\\(\\s*(\"(?:[^\"\\\\]|\\\\.)*\"|\\d+)\\s*\\)$/.exec(stage))){ var key = JSON.parse(m[1]); return [v != null && typeof v === 'object' && Object.prototype.hasOwnProperty.call(v, key)]; }\n  if ((m = /^contains\\(\\s*(\"(?:[^\"\\\\]|\\\\.)*\")\\s*\\)$/.exec(stage))) return [typeof v === 'string' ? v.indexOf(JSON.parse(m[1])) >= 0 : JSON.stringify(v).indexOf(JSON.parse(m[1])) >= 0];\n  switch (stage){\n    case 'not': return [!jqTruthy(v)];\n    case 'type': return [v === null ? 'null' : Array.isArray(v) ? 'array' : typeof v];\n    case 'length': return [v == null ? 0 : typeof v === 'object' ? (Array.isArray(v) ? v.length : Object.keys(v).length) : String(v).length];\n    case 'ascii_downcase': return [typeof v === 'string' ? v.toLowerCase() : v];\n    case 'keys': if (!v || typeof v !== 'object') throw new Error('keys needs an object or array'); return [Array.isArray(v) ? v.map(function(_, i){ return i; }) : Object.keys(v).sort()];\n    case 'values': if (!v || typeof v !== 'object') throw new Error('values needs an object or array'); return Array.isArray(v) ? v : Object.keys(v).map(function(k){ return v[k]; });\n    case 'to_entries': if (!v || typeof v !== 'object' || Array.isArray(v)) throw new Error('to_entries needs an object'); return [Object.keys(v).map(function(k){ return { key: k, value: v[k] }; })];\n    case 'from_entries': if (!Array.isArray(v)) throw new Error('from_entries needs an array'); var o2 = {}; v.forEach(function(e){ if (e && typeof e === 'object') o2[e.key != null ? e.key : e.name] = e.value; }); return [o2];\n  }\n  if (stage.charAt(0) !== '.') throw new Error('unknown filter \"' + stage + '\" — see  man jq');\n  return jqPath(stage, v);\n}\n/* Where `op` first appears outside quotes and brackets, or -1. */\nfunction jqTopIndex(s2, op){\n  var depth = 0, q = false;\n  for (var i = 0; i < s2.length; i++){\n    var c = s2.charAt(i);\n    if (q){ if (c === '\\\\') i++; else if (c === '\"') q = false; continue; }\n    if (c === '\"'){ q = true; continue; }\n    if (c === '[' || c === '(') depth++;\n    if (c === ']' || c === ')') depth--;\n    if (!depth && s2.substr(i, op.length) === op){\n      /* don't read the < of <= as < */\n      if ((op === '<' || op === '>') && s2.charAt(i + 1) === '=') continue;\n      if ((op === '==' || op === '!=') || op.length === 2 || (s2.charAt(i - 1) !== '!' && s2.charAt(i - 1) !== '=' )) return i;\n    }\n  }\n  return -1;\n}\nfunction jqPath(stage, v){\n  var steps = [], i = 0, rx;\n  while (i < stage.length){\n    var rest = stage.slice(i);\n    if (rest.charAt(0) === '?'){ i++; continue; }\n    if ((rx = /^\\.\\[/.exec(rest))){ i += 1; continue; }\n    if ((rx = /^\\.([A-Za-z_][A-Za-z0-9_$-]*)/.exec(rest))){ steps.push(['key', rx[1]]); i += rx[0].length; continue; }\n    if ((rx = /^\\.\"((?:[^\"\\\\]|\\\\.)*)\"/.exec(rest))){ steps.push(['key', rx[1]]); i += rx[0].length; continue; }\n    if ((rx = /^\\[\\s*(-?\\d+)\\s*\\]/.exec(rest))){ steps.push(['idx', +rx[1]]); i += rx[0].length; continue; }\n    if ((rx = /^\\[\\s*\"((?:[^\"\\\\]|\\\\.)*)\"\\s*\\]/.exec(rest))){ steps.push(['key', rx[1]]); i += rx[0].length; continue; }\n    if ((rx = /^\\[\\s*\\]/.exec(rest))){ steps.push(['each']); i += rx[0].length; continue; }\n    if (rest === '.') break;\n    throw new Error('cannot read \"' + rest + '\" in the filter — see  man jq');\n  }\n  var cur = [v];\n  steps.forEach(function(st){\n    var next = [];\n    cur.forEach(function(x){\n      if (st[0] === 'key') next.push(x != null && typeof x === 'object' && !Array.isArray(x) ? (Object.prototype.hasOwnProperty.call(x, st[1]) ? x[st[1]] : null) : null);\n      else if (st[0] === 'idx') next.push(Array.isArray(x) ? x[st[1] < 0 ? x.length + st[1] : st[1]] : null);\n      else { if (!x || typeof x !== 'object') return; next = next.concat(Array.isArray(x) ? x : Object.keys(x).map(function(k){ return x[k]; })); }\n    });\n    cur = next.map(function(x){ return x === undefined ? null : x; });\n  });\n  return cur;\n}\n\n/* write / replace / edit, worked out WITHOUT writing: the commands use it to\n   do the change, and a proposal uses it to show the diff before anyone types\n   y. Patch-sized edits are reviewable; a whole-file rewrite is not. */\nasync function planEdit(line){\n  var argv = tokenize(line), verb = (argv.shift() || '').toLowerCase();\n  var o = parseOpts(argv, '');\n  if (o.ops[0] === '-1'){ o.ops.shift(); o.flags['1'] = true; }   /* replace -1: first occurrence only */\n  if (o.ops[0] === '-1E' || o.ops[0] === '-E1'){ o.ops.shift(); o.flags['1'] = true; o.flags.E = true; }\n  var path = o.ops[0] ? resolve(o.ops[0]) : '';\n  if (!path) return { err: verb + ' needs a path' };\n  var prev = await files.read(path);\n  if (verb === 'write'){\n    var body = line.slice(line.indexOf(o.ops[0]) + o.ops[0].length).trim();\n    /* write x \"the text\" — one quoted text loses its quotes (and \\\" inside). */\n    var q0 = body.charAt(0);\n    if ((q0 === '\"' || q0 === \"'\") && body.length > 1 && body.charAt(body.length - 1) === q0 && body.slice(1, -1).indexOf(q0) < 0) body = body.slice(1, -1);\n    else if (q0 === '\"' && body.length > 1 && body.charAt(body.length - 1) === '\"' && !/[^\\\\]\"/.test(body.slice(1, -1).replace(/\\\\\"/g, ''))) body = body.slice(1, -1).replace(/\\\\\"/g, '\"');\n    body = body.replace(/\\\\n/g, '\\n');\n    if (!body) return { err: 'write <path> <text>  — the text replaces the file' };\n    return { path: path, prev: prev, next: body, how: prev == null ? 'created ' : 'rewrote ', said: 'wrote ' + body.length + ' chars to ' + path + (prev != null ? ' (replaced ' + prev.length + ')' : '') };\n  }\n  if (prev == null) return { err: 'No such file: ' + path };\n  if (verb === 'replace'){\n    if (o.ops.length < 3) return { err: 'replace <path> \"old text\" \"new text\"  (-1 changes only the first, -E for a regex with $1 groups)' };\n    var from = o.ops[1].replace(/\\\\n/g, '\\n'), to = o.ops[2].replace(/\\\\n/g, '\\n');\n    if (!from) return { err: 'replace needs the text to find' };\n    /* -E (or /…/): a regular expression, with $1… in the new text. */\n    var reSrc = o.flags.E ? from : (from.length > 2 && from.charAt(0) === '/' && from.charAt(from.length - 1) === '/' ? from.slice(1, -1) : null);\n    if (reSrc != null){\n      var rre;\n      try { rre = new RegExp(reSrc, o.flags['1'] ? 'm' : 'gm'); } catch(e){ return { err: 'replace: not a valid regular expression (' + e.message + ')' }; }\n      var rCount = (prev.match(new RegExp(reSrc, 'gm')) || []).length;\n      if (!rCount) return { err: 'nothing in ' + path + ' matches /' + reSrc + '/' };\n      var rNext = prev.replace(rre, to), rN = o.flags['1'] ? 1 : rCount;\n      return { path: path, prev: prev, next: rNext, how: 'edited ', said: 'replaced ' + rN + ' match' + (rN === 1 ? '' : 'es') + ' of /' + reSrc + '/ in ' + path };\n    }\n    var count = prev.split(from).length - 1;\n    if (!count) return { err: '\"' + o.ops[1] + '\" is not in ' + path + ' — nothing to replace' };\n    var next = o.flags['1'] ? prev.replace(from, function(){ return to; }) : prev.split(from).join(to);\n    var n = o.flags['1'] ? 1 : count;\n    return { path: path, prev: prev, next: next, how: 'edited ', said: 'replaced ' + n + ' occurrence' + (n === 1 ? '' : 's') + ' in ' + path };\n  }\n  /* edit <path> <A[-B]> <text>  replaces lines A..B;  <A>+ <text>  inserts after A\n     (0+ is the top); an empty text deletes the lines. */\n  var spec = o.ops[1] || '', text = o.ops.slice(2).join(' ').replace(/\\\\n/g, '\\n');\n  var ls = prev.split('\\n'), mm;\n  /* edit <path> /pattern/ \"text\": the FIRST matching line (-a: every one) —\n     no line numbers to get wrong.  /pattern/+ inserts after it. */\n  if ((mm = /^\\/(.+)\\/(\\+?)$/.exec(spec))){\n    var ere; try { ere = new RegExp(mm[1], 'i'); } catch(e){ return { err: 'edit: not a valid regular expression (' + e.message + ')' }; }\n    var at2 = []; ls.forEach(function(l, ix){ if (ere.test(l)) at2.push(ix); });\n    if (!at2.length) return { err: 'no line in ' + path + ' matches /' + mm[1] + '/' };\n    if (!o.flags.a) at2 = at2.slice(0, 1);\n    if (mm[2] && !text) return { err: 'edit ' + o.ops[0] + ' ' + spec + ' \"text to insert\"' };\n    for (var q5 = at2.length - 1; q5 >= 0; q5--){\n      if (mm[2]) ls.splice.apply(ls, [at2[q5] + 1, 0].concat(text.split('\\n')));\n      else ls.splice.apply(ls, [at2[q5], 1].concat(text === '' ? [] : text.split('\\n')));\n    }\n    return { path: path, prev: prev, next: ls.join('\\n'), how: 'edited ', said: (mm[2] ? 'inserted after ' : text === '' ? 'deleted ' : 'replaced ') + at2.length + ' line' + (at2.length === 1 ? '' : 's') + ' matching /' + mm[1] + '/ in ' + path + ' (line ' + at2.map(function(x){ return x + 1; }).join(', ') + ')' };\n  }\n  if ((mm = /^(\\d+)\\+$/.exec(spec))){\n    var after = +mm[1]; if (after > ls.length) return { err: path + ' has ' + ls.length + ' lines' };\n    if (!text) return { err: 'edit ' + o.ops[0] + ' ' + spec + ' \"text to insert\"' };\n    ls.splice.apply(ls, [after, 0].concat(text.split('\\n')));\n    return { path: path, prev: prev, next: ls.join('\\n'), how: 'edited ', said: 'inserted ' + text.split('\\n').length + ' line(s) after line ' + after + ' of ' + path };\n  }\n  if (!(mm = /^(\\d+)(?:-(\\d+|\\$))?$/.exec(spec))) return { err: 'edit <path> <line or A-B> \"new text\"   or   edit <path> <A>+ \"inserted text\"' };\n  var a = +mm[1], b = mm[2] === '$' ? ls.length : mm[2] ? +mm[2] : a;\n  if (a < 1 || b < a || b > ls.length) return { err: path + ' has lines 1\\u2013' + ls.length };\n  ls.splice.apply(ls, [a - 1, b - a + 1].concat(text === '' ? [] : text.split('\\n')));\n  return { path: path, prev: prev, next: ls.join('\\n'), how: 'edited ', said: (text === '' ? 'deleted' : 'replaced') + ' line' + (a === b ? ' ' + a : 's ' + a + '\\u2013' + b) + ' of ' + path };\n}\nasync function previewEdit(line){\n  var v = (tokenize(line)[0] || '').toLowerCase();\n  if (['write','replace','edit'].indexOf(v) < 0) return;\n  var plan = await planEdit(line);\n  if (plan.err){ print('   (' + plan.err + ')', 'err'); return; }\n  var d = diffHTML(lineDiff(lines$(plan.prev || ''), lines$(plan.next)) || [], plan.prev == null ? '(new file)' : plan.path, plan.path + ' after');\n  if (d) printHTML(d.html);\n}\n\nasync function copyOne(snap, ops, flags){\n      /* cp a b  ·  cp a folder/  ·  cp -r folder copy  — -f replaces what is there.\n         The store holds text, so this is read-and-write; undo removes the copies\n         (or puts back what -f replaced). */\n      if (ops.length < 2) return print('cp <from> <to>   (-f replaces an existing file)', 'err');\n      var cFrom = resolve(ops[0]), cTo = resolve(ops[1]);\n      if (!cTo) return print('cp needs a destination name', 'err');\n      var cIsDir = snap.folders.indexOf(cFrom) >= 0;\n      var cFile = snap.files.some(function(x){ return x.path === cFrom; });\n      if (!cIsDir && !cFile) return print('No such file or folder: ' + cFrom, 'err');\n      var into = snap.folders.indexOf(cTo) >= 0 || /\\/$/.test(ops[1]);\n      var pairs = cIsDir\n        ? snap.files.filter(function(x){ return x.path.indexOf(cFrom + '/') === 0; }).map(function(x){\n            return [x.path, (into ? cTo + '/' + cFrom.split('/').pop() : cTo) + x.path.slice(cFrom.length)]; })\n        : [[cFrom, into ? cTo + '/' + cFrom.split('/').pop() : cTo]];\n      if (!pairs.length) return print(cFrom + '/ is empty', 'dim');\n      var clashes = pairs.filter(function(pr){ return snap.files.some(function(x){ return x.path === pr[1]; }); });\n      if (clashes.length && !flags.f) return print(clashes[0][1] + (clashes.length > 1 ? ' and ' + (clashes.length - 1) + ' more' : '') + ' already exist' + (clashes.length > 1 ? '' : 's') + ' — use  cp -f  to replace', 'err');\n      var items = [];\n      for (var ci = 0; ci < pairs.length; ci++){\n        var cBody = await files.read(pairs[ci][0]);\n        if (cBody == null){ print('skipped ' + pairs[ci][0] + ' (not readable as text)', 'dim'); continue; }\n        var cPrev = await files.read(pairs[ci][1]);\n        await files.write(pairs[ci][1], cBody);\n        items.push({ path: pairs[ci][1], prev: cPrev });\n      }\n      if (!items.length) return print('nothing copied', 'dim');\n      remember({ type: 'cp', to: cIsDir ? (into ? cTo + '/' + cFrom.split('/').pop() : cTo) + '/' : items[0].path, items: items });\n      haptic('success');\n      return print('copied ' + (items.length === 1 ? cFrom + ' -> ' + items[0].path : items.length + ' files to ' + (into ? cTo + '/' + cFrom.split('/').pop() : cTo) + '/') + '  —  undo  removes the copy', 'ok');\n    }\n\n/* ---------- commands ---------- */\n\nasync function run(line){\n  if (!files){ print('Shared files are off. Turn on \"Shared files\" in MyLLMos settings.', 'err'); return; }\n  /* Taken and cleared in one go: whatever this command does next — including\n     running another command — must not inherit the text piped into this one. */\n  var sin = stdin; stdin = null;\n  var argv = tokenize(line);\n  var verb = (argv.shift()||'').toLowerCase();\n  var raw = argv.slice();   /* for commands whose options take values (find, sort, cut) */\n\n  var flags = {}, n = 20, ops = [], ctx = 0, longs = {}, maxHits = 0, depthL = 0, nChars = 0;\n  for (var i=0;i<argv.length;i++){\n    var a = argv[i];\n    /* --include=*.md, --exclude-dir=archives: long options keep their value. */\n    if (a.indexOf('--') === 0 && a.length > 2){ var eq = a.indexOf('='); longs[eq > 0 ? a.slice(2, eq) : a.slice(2)] = eq > 0 ? a.slice(eq + 1) : true; continue; }\n    if (a === '-m' && argv[i+1] && !isNaN(+argv[i+1])){ maxHits = Math.max(1, +argv[i+1]); i++; continue; }\n    if (a === '-L' && argv[i+1] && !isNaN(+argv[i+1])){ depthL = Math.max(1, +argv[i+1]); i++; continue; }\n    if (a === '-c' && argv[i+1] && !isNaN(+argv[i+1]) && (verb === 'head' || verb === 'tail')){ nChars = Math.max(1, +argv[i+1]); i++; continue; }\n    if (a === '-n' && argv[i+1] && !isNaN(+argv[i+1])){ n = Math.max(1, Math.min(+argv[i+1], 500)); i++; continue; }\n    if (a === '-C' && argv[i+1] && !isNaN(+argv[i+1])){ ctx = Math.max(0, Math.min(+argv[i+1], 10)); i++; continue; }\n    if (/^-C\\d+$/.test(a)){ ctx = Math.min(+a.slice(2), 10); continue; }\n    if (a.charAt(0) === '-'){ a.slice(1).split('').forEach(function(f){ flags[f] = true; }); continue; }\n    ops.push(a);\n  }\n  var target = ops.length ? resolve(ops[0]) : cwd;\n  var snap = await snapshot(!!flags.a || isHidden(target));\n\n  switch (verb){\n    case 'help': printHTML(helpHTML()); return;\n    case 'clear': out.innerHTML = ''; return;\n    case 'pwd': print('/' + cwd, 'dim'); return;\n\n    case 'cd': {\n      var dest;\n      if (raw[0] === '-'){ if (prevCwd == null) return print('no previous folder yet', 'dim'); dest = prevCwd; }\n      else dest = ops.length ? resolve(ops[0]) : '';\n      if (ops[0] && ops[0].charAt(0) === '@' && !Object.prototype.hasOwnProperty.call(marks, ops[0].slice(1).split('/')[0].toLowerCase()))\n        return print('no bookmark ' + ops[0].split('/')[0] + ' — see  mark', 'err');\n      if (dest && snap.folders.indexOf(dest) < 0) return print('No such folder: ' + dest, 'err');\n      prevCwd = cwd; cwd = dest; paintPrompt();\n      return print('/' + cwd, 'dim');\n    }\n\n    case 'mark': {\n      /* mark            list bookmarks\n         mark name [p]   save p (default: here) as @name\n         mark -d name    forget one */\n      if (flags.d){\n        var dName = (ops[0] || '').toLowerCase().replace(/^@/, '');\n        if (!Object.prototype.hasOwnProperty.call(marks, dName)) return print('no bookmark @' + dName, 'dim');\n        delete marks[dName]; saveMarks(); return print('forgot @' + dName, 'ok');\n      }\n      if (!ops.length){\n        var mNames = Object.keys(marks).sort();\n        if (!mNames.length) return print('no bookmarks yet — stand somewhere and type  mark work  then use  cd @work  or  ls @work', 'dim');\n        return printHTML(mNames.map(function(k){ return '<span class=\"cmd\">@' + esc(k) + '</span>\\t' + pathHTML(marks[k], '/' + marks[k]); }).join('\\n'));\n      }\n      var mName = ops[0].toLowerCase().replace(/^@/, '');\n      if (!/^[a-z0-9_-]+$/.test(mName)) return print('a bookmark name is letters, digits, - or _', 'err');\n      var mPath = ops[1] ? resolve(ops[1]) : cwd;\n      if (mPath && snap.folders.indexOf(mPath) < 0 && !snap.files.some(function(x){ return x.path === mPath; })) return print('No such file or folder: ' + mPath, 'err');\n      marks[mName] = mPath; saveMarks();\n      return print('@' + mName + ' -> /' + mPath, 'ok');\n    }\n\n    case 'ls': case 'dir': case 'tree':\n      return listing(snap, target, verb === 'tree' || flags.R || flags.r, flags.t ? 't' : flags.S ? 'S' : null,\n                     { long: !!flags.l, depth: depthL });\n\n    case 'cat': case 'head': case 'tail': {\n      /* One file, what was piped in, or several (cat a b, head -n 3 *.md) with a\n         ==> name <== header each, as head does. -c N counts characters. */\n      var cut1 = function(text){\n        if (nChars) return verb === 'tail' ? text.slice(-nChars) : text.slice(0, nChars);\n        if (verb === 'cat') return text;\n        var ls1 = text.split('\\n');\n        return (verb === 'head' ? ls1.slice(0, n) : ls1.slice(-n)).join('\\n');\n      };\n      if (sin != null && !ops.length){ print(cut1(sin)); return; }\n      if (!ops.length) return print(verb + ' needs a path (or several, or a glob like *.md)', 'err');\n      /* Several files get a ==> name <== header each — except cat into a pipe or\n         a file, where it joins them the way cat always has (cat a b | sort). */\n      var cps = expandPaths(ops, snap, false), multi = cps.length > 1 && (verb !== 'cat' || !quiet), failed = 0;   /* quiet = mid-pipe or bound for a file */\n      for (var ci1 = 0; ci1 < cps.length; ci1++){\n        var cp1 = cps[ci1];\n        if (cp1.noMatch){ print('no file matches ' + cp1.noMatch, 'err'); failed++; continue; }\n        var t1 = await files.read(cp1);\n        if (t1 == null){ print('No such file: ' + cp1, 'err'); failed++; continue; }\n        if (multi) printHTML((ci1 ? '\\n' : '') + '<span class=\"dim\">==&gt; </span>' + pathHTML(cp1) + '<span class=\"dim\"> &lt;==</span>');\n        print(cut1(t1));\n        if (!multi && !nChars && verb !== 'cat' && t1.split('\\n').length > n) note('[' + t1.split('\\n').length + ' lines total]');\n      }\n      return;\n    }\n\n    case 'stat': {\n      var stps = ops.length ? expandPaths(ops, snap, true) : [cwd];\n      for (var sti = 0; sti < stps.length; sti++){\n        var tg = stps[sti];\n        if (tg.noMatch){ print('nothing matches ' + tg.noMatch, 'err'); continue; }\n        if (sti) print('');\n        var f = snap.files.filter(function(x){ return x.path === tg; })[0];\n        if (f){ print(f.path + '\\ntype: file\\nsize: ' + f.size + ' bytes (' + bytes(f.size) + ')\\nmodified: ' + when(f.modified*1000) + ' (' + zoneLabel() + ')'); continue; }\n        if (snap.folders.indexOf(tg) >= 0 || tg === ''){\n          var inside = snap.files.filter(function(x){ return !tg || x.path.indexOf(tg + '/') === 0; });\n          var total = inside.reduce(function(a,b){ return a + b.size; }, 0);\n          print((tg || '.') + '/\\ntype: folder\\ncontains: ' + inside.length + ' file(s), ' + total + ' bytes (' + bytes(total) + ')');\n          continue;\n        }\n        print('No such file or folder: ' + tg, 'err');\n      }\n      return;\n    }\n\n    case 'find': {\n      /* find [start] [glob] [-name glob] [-maxdepth N] [-mtime -7|+30|-2h|-30m]\n              [-mmin -30] [-newer path] [-size +10k] [-type f|d]\n         A glob with a / is matched against the whole path (projects/** then /*.md);\n         without one, against the file name. -mtime counts days unless you give\n         h or m; newest first whenever time is involved. */\n      var fPat = null, fNewer = null, fAge = null, fSize = null, fType = 'f', fStart = null, fMax = 0;\n      var operands = [];\n      for (var k = 0; k < raw.length; k++){\n        var w = raw[k];\n        if (w === '-newer' && raw[k+1]){ fNewer = raw[++k]; continue; }\n        if (w === '-mtime' && raw[k+1]){ fAge = { v: raw[++k], unit: 'd' }; continue; }\n        if (w === '-mmin' && raw[k+1]){ fAge = { v: raw[++k], unit: 'm' }; continue; }\n        if (w === '-size' && raw[k+1]){ fSize = raw[++k]; continue; }\n        if (w === '-type' && raw[k+1]){ fType = raw[++k] === 'd' ? 'd' : 'f'; continue; }\n        if ((w === '-name' || w === '-path' || w === '-iname') && raw[k+1]){ fPat = raw[++k]; continue; }\n        if (w === '-maxdepth' && raw[k+1]){ fMax = Math.max(1, +raw[++k] || 1); continue; }\n        if (w.charAt(0) === '-' && w.length > 1){ return print('find: unknown option ' + w + ' — see  man find', 'err'); }\n        operands.push(w);\n      }\n      /* A first operand that is a folder is where to start (find notes -name *.md). */\n      if (operands.length && !isGlob(operands[0]) && (snap.folders.indexOf(resolve(operands[0])) >= 0 || operands[0] === '.' || operands[0] === '/')){\n        fStart = resolve(operands.shift());\n      }\n      if (operands.length && fPat === null) fPat = operands.shift();\n      if (fPat === null && fNewer === null && fAge === null && fSize === null && fType === 'f' && fStart === null)\n        return print('find needs a name or glob, e.g.  find *.json   or a filter:  find -mtime -7  (see  man find)', 'err');\n      var startDir = fStart === null ? '' : fStart;\n      var now = Date.now() / 1000, newerThan = null;\n      if (fNewer !== null){\n        var ref = snap.files.filter(function(x){ return x.path === resolve(fNewer); })[0];\n        if (!ref) return print('find -newer: no such file ' + resolve(fNewer), 'err');\n        newerThan = ref.modified;\n      }\n      var mt = null, unitSec = 86400;\n      if (fAge){\n        mt = /^([+-]?)(\\d+(?:\\.\\d+)?)([dhm]?)$/i.exec(fAge.v);\n        if (!mt) return print('find -mtime takes -7 (days), -2h, -30m, or +30; -mmin takes minutes', 'err');\n        var u = (mt[3] || fAge.unit).toLowerCase();\n        unitSec = u === 'h' ? 3600 : u === 'm' ? 60 : 86400;\n      }\n      var sz = fSize === null ? null : /^([+-]?)(\\d+(?:\\.\\d+)?)([kKmM]?)$/.exec(fSize);\n      if (fSize !== null && !sz) return print('find -size takes +10k, -2k, +1m or a byte count', 'err');\n      var szBytes = sz ? +sz[2] * (/k/i.test(sz[3]) ? 1024 : /m/i.test(sz[3]) ? 1048576 : 1) : 0;\n      var pathRx = fPat !== null && fPat.indexOf('/') >= 0\n        ? globRx(fPat.charAt(0) === '/' ? normalise(fPat) : (startDir ? startDir + '/' : (cwd ? cwd + '/' : '')) + fPat) : null;\n      var nameOk = function(p){\n        if (fPat === null) return true;\n        if (pathRx) return pathRx.test(p);\n        return glob(fPat, p.split('/').pop());\n      };\n      var under = function(p){\n        if (startDir && p.indexOf(startDir + '/') !== 0) return false;\n        if (fMax){ var rel = startDir ? p.slice(startDir.length + 1) : p; if (rel.split('/').length > fMax) return false; }\n        return true;\n      };\n      if (fType === 'd'){\n        var dHits = snap.folders.filter(function(d){ return under(d) && nameOk(d); });\n        if (!dHits.length) return print('found nothing: no matching folder', 'dim');\n        return printHTML(dHits.sort().map(function(d){ return pathHTML(d, d + '/'); }).join('\\n'));\n      }\n      var hits = snap.files.filter(function(f){\n        if (!under(f.path) || !nameOk(f.path)) return false;\n        if (newerThan !== null && !(f.modified > newerThan)) return false;\n        if (mt){\n          var age = (now - f.modified) / unitSec, amt = +mt[2];\n          if (mt[1] === '-' && !(age < amt)) return false;\n          if (mt[1] === '+' && !(age > amt)) return false;\n          if (!mt[1] && !(age >= amt && age < amt + 1)) return false;\n        }\n        if (sz){\n          if (sz[1] === '+' && !(f.size > szBytes)) return false;\n          if (sz[1] === '-' && !(f.size < szBytes)) return false;\n          if (!sz[1] && f.size !== szBytes) return false;\n        }\n        return true;\n      });\n      if (!hits.length) return print('found nothing' + (fPat ? ' matching ' + fPat : '') + (startDir ? ' in ' + startDir : ''), 'dim');\n      hits.sort(function(a, b){ return (mt || newerThan !== null) ? b.modified - a.modified : (a.path < b.path ? -1 : 1); });\n      return printHTML(hits.map(function(f){ return pathHTML(f.path); }).join('\\n'));\n    }\n\n    case 'grep': {\n      /* Search INSIDE files — find only knows names. Case-insensitive unless -s,\n         because a phone keyboard capitalises the first letter whether you like\n         it or not (-i is accepted too). -n numbers piped lines, -C N adds context,\n         -v keeps the lines that DON'T match, -c counts, -l names files only.\n         -E or /pattern/ is a regular expression. */\n      if (!ops[0]) return print('grep needs some text, e.g. grep dentist  or  grep -l invoice notes', 'err');\n      var pat = ops[0], rx = null;\n      var slashRe = pat.length > 2 && pat.charAt(0) === '/' && pat.lastIndexOf('/') > 0;\n      if (flags.E || slashRe){\n        try { rx = new RegExp(slashRe ? pat.slice(1, pat.lastIndexOf('/')) : pat, flags.s ? '' : 'i'); }\n        catch(e){ return print('grep: that pattern is not a valid regular expression (' + e.message + ')', 'err'); }\n      }\n      var needle = flags.s ? pat : pat.toLowerCase();\n      /* -w: whole words only — a regex either way, with word boundaries. */\n      if (flags.w){\n        var wsrc = rx ? rx.source : pat.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n        rx = new RegExp('\\\\b(?:' + wsrc + ')\\\\b', flags.s ? '' : 'i');\n      }\n      /* -o: just the matching text, every match on the line. */\n      var allMatches = function(l){\n        var g = rx ? new RegExp(rx.source, rx.flags + 'g') : new RegExp(pat.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&'), flags.s ? 'g' : 'gi');\n        return (l.match(g) || []).filter(function(x){ return x.length; });\n      };\n      var findIn = function(l){\n        if (rx){ var m = rx.exec(l); return m ? { at: m.index, len: Math.max(1, m[0].length) } : null; }\n        var at = (flags.s ? l : l.toLowerCase()).indexOf(needle);\n        return at < 0 ? null : { at: at, len: needle.length };\n      };\n      var isHit = function(l){ var h = findIn(l); return flags.v ? !h : !!h; };\n      var mark = function(l, cut){\n        var h = flags.v ? null : findIn(l);\n        if (!h) return esc(cut ? l.slice(0, 120) : l);\n        if (!cut) return esc(l.slice(0, h.at)) + '<b>' + esc(l.slice(h.at, h.at + h.len)) + '</b>' + esc(l.slice(h.at + h.len));\n        var start = Math.max(0, h.at - 40), snippet = l.slice(start, start + 120), rel = h.at - start;\n        return (start ? '…' : '') + esc(snippet.slice(0, rel)) + '<b>' + esc(snippet.slice(rel, rel + h.len)) + '</b>' + esc(snippet.slice(rel + h.len));\n      };\n      /* Which lines to show: the hits, plus ctx lines around each (null = a \"--\" gap). */\n      var pick = function(ls){\n        var hitIdx = []; for (var q = 0; q < ls.length; q++) if (isHit(ls[q])){ hitIdx.push(q); if (maxHits && hitIdx.length >= maxHits) break; }\n        if (!ctx) return { hits: hitIdx, rows: hitIdx.map(function(x){ return [x, true]; }) };\n        var want = {}, rows = [], last = -2;\n        hitIdx.forEach(function(x){ for (var y = Math.max(0, x - ctx); y <= Math.min(ls.length - 1, x + ctx); y++) want[y] = want[y] || (y === x); });\n        Object.keys(want).map(Number).sort(function(p1, p2){ return p1 - p2; }).forEach(function(y){\n          if (last >= 0 && y > last + 1) rows.push(null);\n          rows.push([y, hitIdx.indexOf(y) >= 0]); last = y;\n        });\n        return { hits: hitIdx, rows: rows };\n      };\n      /* Piped in: there are no files here, just lines. */\n      if (sin != null && ops.length < 2){\n        var sl = sin.split('\\n'), pk = pick(sl);\n        if (flags.c) return print(String(pk.hits.length));\n        if (!pk.hits.length) return print('found nothing: no line matches \"' + ops[0] + '\"', 'dim');\n        if (flags.o && !flags.v) return print(pk.hits.map(function(x){ return allMatches(sl[x]).join('\\n'); }).join('\\n'));\n        return printHTML(pk.rows.map(function(r){\n          if (!r) return '<span class=\"dim\">--</span>';\n          var num = flags.n || ctx ? '<span class=\"dim\">' + (r[0] + 1) + (r[1] ? ':' : '-') + '</span>' : '';\n          return num + (r[1] ? mark(sl[r[0]], false) : '<span class=\"dim\">' + esc(sl[r[0]]) + '</span>');\n        }).join('\\n'));\n      }\n      var scope = ops[1] ? resolve(ops[1]) : cwd;\n      /* --include=*.md keeps matching file names; --exclude-dir=archives skips\n         any folder of that name (globs allowed in both). */\n      var incl = typeof longs.include === 'string' ? longs.include : null;\n      var exclD = typeof longs['exclude-dir'] === 'string' ? longs['exclude-dir'] : null;\n      var pool = snap.files.filter(function(f){\n        if (scope && f.path !== scope && f.path.indexOf(scope + '/') !== 0) return false;\n        if (incl && !glob(incl, f.path.split('/').pop())) return false;\n        if (exclD && f.path.split('/').slice(0, -1).some(function(seg){ return glob(exclD, seg); })) return false;\n        return true;\n      });\n      if (!pool.length) return print('found nothing to search in ' + (scope || 'the workspace') + (incl || exclD ? ' with those filters' : ''), 'dim');\n      var rows = [], hitFiles = 0, shown = 0, LIMIT = 200;\n      for (var fi = 0; fi < pool.length && shown < LIMIT; fi++){\n        var f = pool[fi], txt = await files.read(f.path);\n        if (txt == null) continue;\n        var ls = txt.split('\\n'), got = pick(ls);\n        if (!got.hits.length) continue;\n        hitFiles++;\n        if (flags.l){ rows.push(pathHTML(f.path)); continue; }\n        if (flags.c){ rows.push(pathHTML(f.path) + '<span class=\"hit\">:' + got.hits.length + '</span>'); continue; }\n        if (flags.o && !flags.v){\n          got.hits.forEach(function(x){ allMatches(ls[x]).forEach(function(mm3){ shown++; rows.push(pathHTML(f.path) + '<span class=\"hit\">:' + (x + 1) + ': <b>' + esc(mm3) + '</b></span>'); }); });\n          continue;\n        }\n        for (var ri = 0; ri < got.rows.length && shown < LIMIT; ri++){\n          var r = got.rows[ri];\n          if (!r){ rows.push('<span class=\"dim\">--</span>'); continue; }\n          if (r[1]) shown++;\n          rows.push(pathHTML(f.path) + (r[1]\n            ? '<span class=\"hit\">:' + (r[0] + 1) + ': ' + mark(ls[r[0]], true) + '</span>'\n            : '<span class=\"dim\">-' + (r[0] + 1) + '- ' + esc(ls[r[0]].slice(0, 120)) + '</span>'));\n        }\n      }\n      if (!rows.length) return print('found nothing: no match for \"' + ops[0] + '\" in ' + (scope || 'the workspace'), 'dim');\n      printHTML(rows.join('\\n'));\n      if (!flags.l && !flags.c) print('[' + shown + (shown >= LIMIT ? '+' : '') + ' line(s) in ' + hitFiles + ' file(s)]', 'dim');\n      return;\n    }\n\n    /* ---- v9: the text tools. Each reads a file or whatever was piped in, so\n       they chain:  find *.md | cut -d / -f 1 | sort | uniq -c | sort -rn ---- */\n\n    case 'sed': {\n      /* Only the read-a-range form:  sed -n '40,80p' file  (also 40,$p and 40p). */\n      var sm = /^(\\d+|\\$)(?:,(\\d+|\\$|\\+\\d+))?p$/.exec(ops[0] || '');\n      if (!flags.n || !sm) return print(\"sed -n '40,80p' <path>  prints lines 40 to 80 (this shell's sed reads ranges only; use  edit  to change lines)\", 'err');\n      var st = await textFrom(sin, ops[1], 'sed'); if (st.err) return print(st.err, 'err');\n      var sls = lines$(st.text), total = sls.length;\n      var from = sm[1] === '$' ? total : +sm[1];\n      var to = !sm[2] ? from : sm[2] === '$' ? total : sm[2].charAt(0) === '+' ? from + +sm[2].slice(1) : +sm[2];\n      if (from < 1 || from > total) return print('there are ' + total + ' lines', 'err');\n      print(sls.slice(from - 1, Math.min(to, total)).join('\\n'));\n      return note('[lines ' + from + '–' + Math.min(to, total) + ' of ' + total + ']');\n    }\n\n    case 'wc': {\n      var wo = parseOpts(raw, '');\n      var count = function(t){ var ls = lines$(t); return { l: ls.length, w: (t.match(/\\S+/g) || []).length, c: t.length }; };\n      var cols = (wo.flags.l || wo.flags.w || wo.flags.c) ? ['l','w','c'].filter(function(k){ return wo.flags[k]; }) : ['l','w','c'];\n      var fmt = function(r, name){ return cols.map(function(k){ return String(r[k]); }).join('\\t') + (name ? '\\t' + name : ''); };\n      if (sin != null && !wo.ops.length) return print(fmt(count(sin)));\n      if (!wo.ops.length) return print('wc [-l|-w|-c] <path…>  — lines, words, characters', 'err');\n      var tot = { l: 0, w: 0, c: 0 }, rowsW = [];\n      for (var wi = 0; wi < wo.ops.length; wi++){\n        var wt = await files.read(resolve(wo.ops[wi]));\n        if (wt == null) return print('No such file: ' + resolve(wo.ops[wi]), 'err');\n        var r1 = count(wt); rowsW.push(fmt(r1, resolve(wo.ops[wi]))); tot.l += r1.l; tot.w += r1.w; tot.c += r1.c;\n      }\n      if (wo.ops.length > 1) rowsW.push(fmt(tot, 'total'));\n      if (cols.length === 3) note('lines\\twords\\tchars');\n      return print(rowsW.join('\\n'));\n    }\n\n    case 'sort': {\n      /* -r reverse, -n numeric, -u drop repeats, -k N sort on field N, -t X fields split on X */\n      var so = parseOpts(raw, 'kt');\n      var sst = await textFrom(sin, so.ops[0], 'sort'); if (sst.err) return print(sst.err, 'err');\n      var keyOf = function(l){\n        if (!so.vals.k) return l;\n        var parts = so.vals.t ? l.split(so.vals.t) : l.trim().split(/\\s+/);\n        return parts[(+so.vals.k || 1) - 1] || '';\n      };\n      var sorted = lines$(sst.text).slice().sort(function(x, y){\n        var a1 = keyOf(x), b1 = keyOf(y), c;\n        if (so.flags.n){ c = (parseFloat(a1) || 0) - (parseFloat(b1) || 0); if (c) return c; }\n        c = a1.localeCompare(b1, undefined, { sensitivity: 'base' });\n        return c || (x < y ? -1 : x > y ? 1 : 0);\n      });\n      if (so.flags.r) sorted.reverse();\n      if (so.flags.u) sorted = sorted.filter(function(x, i2){ return i2 === 0 || keyOf(x) !== keyOf(sorted[i2 - 1]); });\n      return print(sorted.join('\\n'));\n    }\n\n    case 'uniq': {\n      /* Folds REPEATED NEIGHBOURS, as uniq always has — sort first. -c counts, -d repeats only. */\n      var uo = parseOpts(raw, '');\n      var ust = await textFrom(sin, uo.ops[0], 'uniq'); if (ust.err) return print(ust.err, 'err');\n      var runs = [];\n      lines$(ust.text).forEach(function(l){ if (runs.length && runs[runs.length - 1][0] === l) runs[runs.length - 1][1]++; else runs.push([l, 1]); });\n      if (uo.flags.d) runs = runs.filter(function(r2){ return r2[1] > 1; });\n      return print(runs.map(function(r2){ return uo.flags.c ? ('      ' + r2[1]).slice(-7) + ' ' + r2[0] : r2[0]; }).join('\\n'));\n    }\n\n    case 'cut': {\n      /* cut -d , -f 1,3   or   -f 2-4   (tab-separated by default)   or  -c 1-20 */\n      var co = parseOpts(raw, 'dfc');\n      var cst = await textFrom(sin, co.ops[0], 'cut'); if (cst.err) return print(cst.err, 'err');\n      var spec2 = co.vals.f || co.vals.c;\n      if (!spec2) return print('cut -d , -f 1,3  (fields)   or   cut -c 1-20  (characters)', 'err');\n      var want = function(nn){ return spec2.split(',').some(function(part){\n        var mm2 = /^(\\d*)-(\\d*)$/.exec(part); if (!mm2) return +part === nn;\n        return nn >= (mm2[1] ? +mm2[1] : 1) && nn <= (mm2[2] ? +mm2[2] : Infinity); }); };\n      var delim = co.vals.d == null ? '\\t' : co.vals.d === '\\\\t' ? '\\t' : co.vals.d;\n      return print(lines$(cst.text).map(function(l){\n        if (co.vals.c) return l.split('').filter(function(_, i3){ return want(i3 + 1); }).join('');\n        if (l.indexOf(delim) < 0) return l;\n        return l.split(delim).filter(function(_, i3){ return want(i3 + 1); }).join(delim);\n      }).join('\\n'));\n    }\n\n    case 'tr': {\n      /* tr a-z A-Z  ·  tr -d '0-9'  ·  tr -s ' '  (ranges and \\n \\t work) */\n      var to2 = parseOpts(raw, '');\n      if (sin == null) return print('tr reads what is piped in:  cat x | tr a-z A-Z', 'err');\n      var setOf = function(sp){ sp = String(sp || '').replace(/\\\\n/g, '\\n').replace(/\\\\t/g, '\\t'); var r3 = [];\n        for (var q3 = 0; q3 < sp.length; q3++){ if (sp.charAt(q3 + 1) === '-' && q3 + 2 < sp.length){ for (var cc = sp.charCodeAt(q3); cc <= sp.charCodeAt(q3 + 2); cc++) r3.push(String.fromCharCode(cc)); q3 += 2; } else r3.push(sp.charAt(q3)); }\n        return r3; };\n      var s1 = setOf(to2.ops[0]);\n      if (!s1.length) return print(\"tr <from> <to>   ·   tr -d <chars>   ·   tr -s <chars>\", 'err');\n      var outT = sin;\n      if (to2.flags.d) outT = outT.split('').filter(function(ch){ return s1.indexOf(ch) < 0; }).join('');\n      else if (to2.ops[1] != null){ var s2 = setOf(to2.ops[1]); outT = outT.split('').map(function(ch){ var ix = s1.indexOf(ch); return ix < 0 ? ch : s2[Math.min(ix, s2.length - 1)]; }).join(''); }\n      if (to2.flags.s){ var sq = to2.ops[1] != null ? setOf(to2.ops[1]) : s1;\n        outT = outT.split('').filter(function(ch, ix2, arr){ return !(ix2 && ch === arr[ix2 - 1] && sq.indexOf(ch) >= 0); }).join(''); }\n      return print(outT);\n    }\n\n    case 'paste': {\n      /* paste a b — side by side, tab between (-d X);  paste -s — one line per file */\n      var po = parseOpts(raw, 'd');\n      var pd = po.vals.d == null ? '\\t' : po.vals.d === '\\\\t' ? '\\t' : po.vals.d;\n      var cols2 = [];\n      if (sin != null && !po.ops.length) cols2.push(lines$(sin));\n      for (var pi = 0; pi < po.ops.length; pi++){\n        if (po.ops[pi] === '-'){ cols2.push(lines$(sin || '')); continue; }\n        var pt = await files.read(resolve(po.ops[pi]));\n        if (pt == null) return print('No such file: ' + resolve(po.ops[pi]), 'err');\n        cols2.push(lines$(pt));\n      }\n      if (!cols2.length) return print('paste <a> <b>   (-d , for commas, -s to join each file onto one line)', 'err');\n      if (po.flags.s) return print(cols2.map(function(c3){ return c3.join(pd); }).join('\\n'));\n      var rowsP = Math.max.apply(null, cols2.map(function(c3){ return c3.length; })), outP = [];\n      for (var r4 = 0; r4 < rowsP; r4++) outP.push(cols2.map(function(c3){ return c3[r4] == null ? '' : c3[r4]; }).join(pd));\n      return print(outP.join('\\n'));\n    }\n\n    case 'comm': {\n      /* comm a b — lines only in a | only in b | in both (sorted first, as comm\n         always wants). -1 -2 -3 hide a column: comm -12 a b = common lines only. */\n      var cmo = parseOpts(raw.filter(function(x){ return !/^-[123]+$/.test(x); }), '');\n      raw.forEach(function(x){ if (/^-[123]+$/.test(x)) x.slice(1).split('').forEach(function(d){ cmo.flags[d] = true; }); });\n      if (cmo.ops.length < 2) return print('comm <a> <b>   (-12 for common lines only, -23 for lines only in a)', 'err');\n      var ca = await loadSpec(cmo.ops[0], sin), cb = await loadSpec(cmo.ops[1], sin);\n      if (ca.err) return print(ca.err, 'err');\n      if (cb.err) return print(cb.err, 'err');\n      var la = lines$(ca.text).slice().sort(), lb = lines$(cb.text).slice().sort(), ia = 0, ib = 0, outC = [];\n      var col = function(k, t){ if (cmo.flags[k]) return; var lead = ''; for (var z = 1; z < +k; z++) if (!cmo.flags[String(z)]) lead += '\\t'; outC.push(lead + t); };\n      while (ia < la.length || ib < lb.length){\n        if (ib >= lb.length || (ia < la.length && la[ia] < lb[ib])) col('1', la[ia++]);\n        else if (ia >= la.length || lb[ib] < la[ia]) col('2', lb[ib++]);\n        else { col('3', la[ia]); ia++; ib++; }\n      }\n      return print(outC.join('\\n'));\n    }\n\n    case 'awk': {\n      /* The column-work subset: awk [-F ,] '[/regex/] {print $1, $3}'.\n         $0 is the line, NF the field count, NR the line number, $NF the last field. */\n      var ao = parseOpts(raw, 'F');\n      var prog = (ao.ops[0] || '').trim();\n      var am = /^(?:\\/((?:[^\\/\\\\]|\\\\.)*)\\/\\s*)?\\{\\s*print\\s*(.*?)\\s*;?\\s*\\}$/.exec(prog);\n      if (!am) return print(\"awk '{print $1, $3}'  ·  awk -F , '{print $2}'  ·  awk '/todo/ {print NR, $0}'  (print is all this awk does)\", 'err');\n      var ast = await textFrom(sin, ao.ops[1], 'awk'); if (ast.err) return print(ast.err, 'err');\n      var arx;\n      try { arx = am[1] != null ? new RegExp(am[1], 'i') : null; } catch(e){ return print('awk: bad pattern (' + e.message + ')', 'err'); }\n      var fs = ao.vals.F == null ? null : ao.vals.F === '\\\\t' ? '\\t' : ao.vals.F;\n      var items2 = am[2] ? am[2].split(/\\s*,\\s*/) : ['$0'];\n      var outA = [];\n      lines$(ast.text).forEach(function(l, ix){\n        if (arx && !arx.test(l)) return;\n        var fl = fs == null ? l.trim().split(/\\s+/) : l.split(fs);\n        outA.push(items2.map(function(it){\n          if (it === '$0') return l;\n          if (/^\\$\\d+$/.test(it)) return fl[+it.slice(1) - 1] == null ? '' : fl[+it.slice(1) - 1];\n          if (it === '$NF') return fl[fl.length - 1] || '';\n          if (it === 'NF') return String(fl.length);\n          if (it === 'NR') return String(ix + 1);\n          if (/^\".*\"$/.test(it)) return it.slice(1, -1);\n          return it;\n        }).join(fs == null ? ' ' : fs));\n      });\n      return print(outA.join('\\n'));\n    }\n\n    case 'xargs': {\n      /* grep -l TODO notes | xargs head -n 5 — the paths that came down the pipe\n         are handed to the command (made absolute, so where you stand doesn't\n         matter). The assistant may only xargs a read-only command. */\n      if (sin == null) return print('xargs runs a command on paths piped in:  grep -l TODO notes | xargs head -n 3', 'err');\n      var xCmd = restOf(line);\n      if (!xCmd) return print('xargs <command> — e.g.  find *.md | xargs wc -l', 'err');\n      var xv = (tokenize(xCmd)[0] || '').toLowerCase();\n      if (['xargs', 'ask', 'dictate'].indexOf(xv) >= 0 || KNOWN.indexOf(xv) < 0) return print('xargs: ' + xv + ' is not something xargs can run', 'err');\n      var xPaths = sin.split('\\n').map(function(l){ return l.replace(/\\t.*$/, '').replace(/:\\d+:.*$/, '').trim(); })\n        .filter(Boolean).filter(function(x, ix3, arr){ return arr.indexOf(x) === ix3; }).slice(0, 50);\n      if (!xPaths.length) return print('found nothing: no paths came down the pipe', 'dim');\n      var quoted = function(x){ return '\"/' + x.replace(/^\\//, '') + '\"'; };\n      var multiOk = ['cat','head','tail','stat','wc','paste','rm','cp','mv'].indexOf(xv) >= 0;\n      if (multiOk) return run(xCmd + ' ' + xPaths.map(quoted).join(' '));\n      for (var xi = 0; xi < xPaths.length; xi++){\n        printHTML('<span class=\"dim\">==&gt; </span>' + pathHTML(xPaths[xi].replace(/^\\//, '')) + '<span class=\"dim\"> &lt;==</span>');\n        await run(xCmd + ' ' + quoted(xPaths[xi]));\n      }\n      return;\n    }\n\n    case 'man': {\n      var mv2 = (ops[0] || '').toLowerCase();\n      if (!mv2) return print('man <command> — the exact flags it takes.  help  lists every command;  changes  says what is new.', 'dim');\n      if (!MAN[mv2]) return print('no manual for ' + mv2 + ' — commands: ' + VERBS.join(' '), 'err');\n      return printHTML('<span class=\"cmd\">' + esc(mv2) + '</span>\\n' + MAN[mv2].map(function(l){ return '<span class=\"dim\">' + esc(l) + '</span>'; }).join('\\n'));\n    }\n\n    case 'changes': {\n      /* Shell's own changelog, so you (or the assistant) can check what already\n         exists before asking for it. */\n      return print(CHANGES.join('\\n'));\n    }\n\n    case 'preview': case 'dryrun': {\n      /* What a change WOULD do, without doing it — read-only, so the assistant\n         can check a replace -E or a batch step before proposing it. */\n      var pl2 = restOf(line), pv = (tokenize(pl2)[0] || '').toLowerCase();\n      if (!pv) return print('preview <write|replace|edit|mv|cp|rm|rmdir|mkdir …>  shows what it would do, changing nothing', 'err');\n      if (['write','replace','edit'].indexOf(pv) >= 0){\n        var pp = await planEdit(pl2);\n        if (pp.err) return print('would fail: ' + pp.err, 'err');\n        if (pp.prev === pp.next) return print('would change nothing in ' + pp.path, 'dim');\n        var pd2 = diffHTML(lineDiff(lines$(pp.prev || ''), lines$(pp.next)) || [], pp.prev == null ? '(new file)' : pp.path, pp.path + ' after');\n        if (pd2) printHTML(pd2.html);\n        return print('would: ' + pp.said + '  (nothing changed — preview only)', 'dim');\n      }\n      var pa = parseOpts(tokenize(pl2).slice(1), ''), lines2 = [];\n      if (pv === 'mkdir'){ var mk2 = resolve(pa.ops[0] || ''); return print(snap.folders.indexOf(mk2) >= 0 ? mk2 + '/ already exists — would do nothing' : 'would create ' + mk2 + '/'); }\n      if (pv === 'rm' || pv === 'rmdir'){\n        var targets = expandPaths(pa.ops, snap, true);\n        var dayAgo = Date.now() / 1000 - 86400;\n        targets.forEach(function(t){\n          if (t.noMatch) return lines2.push('nothing matches ' + t.noMatch);\n          var isD = snap.folders.indexOf(t) >= 0, isF = snap.files.some(function(x){ return x.path === t; });\n          if (!isD && !isF) return lines2.push('missing: ' + t + ' (the step would fail)');\n          if (pv === 'rm' && isD) return lines2.push('would fail: ' + t + ' is a folder — use  rmdir ' + t + '  (no -r needed; it takes the contents too)');\n          if (pv === 'rmdir' && !isD) return lines2.push('would fail: ' + t + ' is a file — use  rm');\n          /* Name what goes: path, size, last change — and flag anything recent. */\n          var gone = isD ? snap.files.filter(function(x){ return x.path.indexOf(t + '/') === 0; }) : snap.files.filter(function(x){ return x.path === t; });\n          var tot2 = gone.reduce(function(a, b){ return a + b.size; }, 0);\n          lines2.push((pa.flags.p ? 'would DELETE FOR GOOD ' : 'would move to ' + TRASH + ': ') + t + (isD ? '/ — ' + gone.length + ' file(s), ' + bytes(tot2) : ''));\n          gone.slice(0, 25).forEach(function(x){ lines2.push('   ' + bytes(x.size) + '\t' + when(x.modified * 1000) + '\t' + x.path + (x.modified > dayAgo ? '   ⚠ changed in the last 24 h' : '')); });\n          if (gone.length > 25) lines2.push('   …and ' + (gone.length - 25) + ' more');\n        });\n        if (targets.length) lines2.push('(times ' + zoneLabel() + ')');\n        return print(lines2.join('\\n') || 'nothing to do');\n      }\n      if (pv === 'mv' || pv === 'cp'){\n        if (pa.ops.length < 2) return print(pv + ' needs a source and a destination', 'err');\n        var pDest = resolve(pa.ops[pa.ops.length - 1]), pInto = snap.folders.indexOf(pDest) >= 0;\n        var pSrc = expandPaths(pa.ops.slice(0, -1), snap, true);\n        if (pSrc.length > 1 && !pInto) return print('would fail: several sources need an existing folder last', 'err');\n        pSrc.forEach(function(t){\n          if (t.noMatch) return lines2.push('nothing matches ' + t.noMatch);\n          var exists2 = snap.files.some(function(x){ return x.path === t; }) || snap.folders.indexOf(t) >= 0;\n          if (!exists2) return lines2.push('missing: ' + t + ' (the step would fail)');\n          var to2b = pInto ? pDest + '/' + t.split('/').pop() : pDest;\n          var clash = snap.files.some(function(x){ return x.path === to2b; });\n          lines2.push('would ' + (pv === 'mv' ? 'move ' : 'copy ') + t + ' -> ' + to2b + (clash ? (pa.flags.f ? '  (replacing it)' : '  — CLASH: exists, the step would fail without -f') : ''));\n        });\n        return print(lines2.join('\\n'));\n      }\n      return print('preview works on write, replace, edit, mv, cp, rm, rmdir and mkdir', 'err');\n    }\n\n    case 'scratch': {\n      /* scratch          what is in .scratch\n         scratch clear    empty it (it is emptied anyway each time Shell opens) */\n      var allS = await snapshot(true);\n      var inS = allS.files.filter(function(f){ return inScratch(f.path); });\n      if ((ops[0] || '').toLowerCase() === 'clear') return print('emptied ' + SCRATCH + ' (' + (await clearScratch()) + ' file(s))', 'ok');\n      if (!inS.length) return print(SCRATCH + ' is empty — the assistant writes working notes there without asking (200 KB, cleared when Shell opens)', 'dim');\n      return print(inS.map(function(f){ return f.path + '\\t' + bytes(f.size); }).join('\\n') + '\\n' + bytes(inS.reduce(function(a, b){ return a + b.size; }, 0)) + ' of 200 KB · cleared when Shell opens');\n    }\n\n    case 'date': {\n      /* For -mtime, \"recent\" and deadlines: the phone's own clock and zone. */\n      var dnow = new Date(), off = -dnow.getTimezoneOffset();\n      var tz = ''; try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch(e){}\n      return print(dnow.toLocaleDateString(undefined, { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) + ' ' + when(dnow.getTime()).slice(11) +\n        '\\nzone ' + (tz || '?') + ' (UTC' + (off >= 0 ? '+' : '-') + Math.floor(Math.abs(off) / 60) + (Math.abs(off) % 60 ? ':' + ('0' + Math.abs(off) % 60).slice(-2) : '') + ')' +\n        '\\niso ' + dnow.toISOString() + '\\nunix ' + Math.floor(dnow.getTime() / 1000));\n    }\n\n    case 'info': {\n      /* The workspace at a glance: size, shape, what changed lately. */\n      var allI = await snapshot(true);\n      var live = allI.files.filter(function(f){ return !isHidden(f.path); });\n      var trashN = allI.files.filter(function(f){ return inTrash(f.path); }).length;\n      var totalI = live.reduce(function(a, b){ return a + b.size; }, 0);\n      var tops = {};\n      live.forEach(function(f){ var t = f.path.indexOf('/') < 0 ? '.' : f.path.split('/')[0]; tops[t] = tops[t] || { n: 0, b: 0 }; tops[t].n++; tops[t].b += f.size; });\n      var newest = live.slice().sort(function(a, b){ return b.modified - a.modified; }).slice(0, 5);\n      var oldest = live.slice().sort(function(a, b){ return a.modified - b.modified; })[0];\n      var outI = [live.length + ' files, ' + allI.folders.filter(function(d){ return !isHidden(d); }).length + ' folders, ' + bytes(totalI) + ' of 25 MB' + (trashN ? ' · ' + trashN + ' in .trash' : ''), '', 'top level:'];\n      Object.keys(tops).sort(function(a, b){ return tops[b].b - tops[a].b; }).forEach(function(t){ outI.push('  ' + (t === '.' ? '(root files)' : t + '/') + '\\t' + tops[t].n + ' file(s)\\t' + bytes(tops[t].b)); });\n      if (newest.length){ outI.push('', 'changed most recently:'); newest.forEach(function(f){ outI.push('  ' + when(f.modified * 1000) + '  ' + f.path); }); }\n      if (oldest) outI.push('', 'oldest: ' + when(oldest.modified * 1000) + '  ' + oldest.path);\n      var mk3 = Object.keys(marks); if (mk3.length) outI.push('', 'bookmarks: ' + mk3.map(function(k){ return '@' + k; }).join(' '));\n      var scrN = allI.files.filter(function(f){ return inScratch(f.path); }).length;\n      outI.push('', 'hidden: ' + TRASH + ' ' + trashN + ' file(s) · ' + SCRATCH + ' ' + scrN + ' file(s) (the assistant\\'s notes, emptied each launch) — ls -a or  trash / scratch  show them');\n      outI.push('', 'now: ' + when(Date.now()) + ' · times are ' + zoneLabel());\n      return print(outI.join('\\n'));\n    }\n\n    case 'diff': {\n      /* diff a b  ·  diff notes.md@2  (that version vs now)  ·  diff notes.md\n         (the newest saved version vs now)  ·  diff notes.md@3 notes.md@1 */\n      if (!ops.length) return print('diff <a> <b>   or   diff <file>@N  (version N vs now — see  history <file>)', 'err');\n      var A, B;\n      if (ops.length === 1){\n        if (/@\\d+$/.test(ops[0])){ A = await loadSpec(ops[0], sin); B = await loadSpec(ops[0].replace(/@\\d+$/, ''), sin); }\n        else { A = await loadSpec(ops[0] + '@1', sin); B = await loadSpec(ops[0], sin); }\n      } else { A = await loadSpec(ops[0], sin); B = await loadSpec(ops[1], sin); }\n      if (A.err) return print(A.err, 'err');\n      if (B.err) return print(B.err, 'err');\n      var dops = lineDiff(lines$(A.text), lines$(B.text));\n      if (!dops) return print('too big to compare line by line (' + lines$(A.text).length + ' vs ' + lines$(B.text).length + ' lines)', 'err');\n      var dh = diffHTML(dops, A.label, B.label);\n      if (!dh) return print('no differences', 'dim');\n      printHTML(dh.html);\n      return note('[' + dh.adds + ' line(s) added, ' + dh.dels + ' removed]');\n    }\n\n    case 'jq': {\n      /* jq '.field.sub' file   ·   jq '.items[] | .name' file   ·   cat x.json | jq keys\n         -r prints strings without quotes. */\n      var jo = parseOpts(raw, '');\n      var filter = '.', jpath = null;\n      if (jo.ops.length >= 2){ filter = jo.ops[0]; jpath = jo.ops[1]; }\n      else if (jo.ops.length === 1){ if (sin != null || /^[.\\[]|^(keys|length|type|values|to_entries|map|select)\\b/.test(jo.ops[0])) filter = jo.ops[0]; else jpath = jo.ops[0]; }\n      var jt = await textFrom(sin, jpath, 'jq'); if (jt.err) return print(jt.err, 'err');\n      var data;\n      try { data = JSON.parse(jt.text); }\n      catch(e){ return print((jpath ? resolve(jpath) : 'that') + ' is not valid JSON (' + e.message + ')', 'err'); }\n      var results;\n      try { results = jqEval(filter, [data]); }\n      catch(e){ return print('jq: ' + e.message, 'err'); }\n      return print(results.map(function(v){ return jo.flags.r && typeof v === 'string' ? v : JSON.stringify(v, null, 2); }).join('\\n'));\n    }\n\n    case 'du': {\n      var byDir = {};\n      snap.files.forEach(function(f){\n        var d = f.path.indexOf('/') < 0 ? '.' : f.path.slice(0, f.path.lastIndexOf('/'));\n        byDir[d] = (byDir[d]||0) + f.size;\n      });\n      var rows = Object.keys(byDir).sort(function(a,b){ return byDir[b]-byDir[a]; })\n        .map(function(d){ return bytes(byDir[d]) + '\\t' + d; });\n      var total = snap.files.reduce(function(a,b){ return a + b.size; }, 0);\n      return print(rows.concat([bytes(total) + '\\ttotal of 25 MB']).join('\\n'));\n    }\n\n    /* ---- the model as a filter, and the phone as an input device ---- */\n\n    case 'ask': {\n      /* The agent (anything that is not a command) EXPLORES: it runs commands\n         and decides what to do next. This verb TRANSFORMS: one call, no tools,\n         whatever came down the pipe as its material, and the answer is just\n         text — so it can be piped onward or redirected into a file. */\n      if (!window.myllmAsk) return print('AI is off for apps — turn on \"Allow apps to use the AI\" in MyLLMos settings.', 'err');\n      var q = unquote(restOf(line));\n      if (!q && sin == null) return print('ask \"a question\"  —  or pipe something in:  cat notes.md | ask \"summarise\"', 'err');\n      var material = sin == null ? null : maskSecrets(sin);\n      var clipped = false;\n      if (material != null && material.length > ASK_MAX){ material = material.slice(0, ASK_MAX); clipped = true; }\n      var prompt = material != null\n        ? (q || 'Summarise this.') + '\\n\\n--- material ---\\n' + material + (clipped ? '\\n[truncated]' : '')\n        : q;\n      var spin = status('asking\\u2026');\n      var askBar = workStart('MyLLM is working on: ' + (q || 'the piped text').slice(0, 60));\n      var answer;\n      try { answer = await myllmAsk(prompt, { system: FILTER_SYSTEM }); }\n      catch(e){ unstatus(spin); if (askBar) workEnd(); return print('ask failed: ' + (e && e.message || e), 'err'); }\n      unstatus(spin); if (askBar) workEnd();\n      var clean = stripFence(String(answer == null ? '' : answer));\n      if (!clean) return print('(no answer)', 'dim');\n      if (clipped) print('[used the first ' + ASK_MAX + ' characters]', 'dim');\n      return print(clean, 'say');\n    }\n\n    case 'dictate': {\n      /* Typing at a prompt is the worst thing about a terminal on a phone.\n         No path argument: it prints, and  >  is how anything gets saved. */\n      if (!window.myllmTranscribe) return print('Dictation needs a newer MyLLM build.', 'err');\n      var heard;\n      try { heard = await myllmTranscribe(); }\n      catch(e){ return print('dictation failed: ' + (e && e.message || e), 'err'); }\n      if (heard == null || !String(heard).trim()) return print('nothing heard', 'dim');\n      haptic('success');\n      return print(String(heard).trim());\n    }\n\n    case 'open': {\n      /* The intent bus, with the same action name the Files app uses, so Shell\n         reaches exactly the apps that already declare they can take text. */\n      if (!ops.length) return print('open <path>  — hands the file to an app that can open text', 'err');\n      if (!snap.files.some(function(x){ return x.path === target; })) return print('No such file: ' + target, 'err');\n      var body = await files.read(target);\n      if (body == null) return print('Cannot read ' + target + ' — Shell handles text files.', 'err');\n      if (!window.myllmIntent) return print('Handing files to other apps needs a newer MyLLM build.', 'err');\n      var oName = target.split('/').pop(), oDot = oName.lastIndexOf('.');\n      try {\n        var routed = await myllmIntent.send('open-text', {\n          name: oName, path: target, ext: oDot > 0 ? oName.slice(oDot + 1).toLowerCase() : '', text: body\n        });\n        haptic('success');\n        return print('opened ' + oName + (routed && routed.handlers > 1 ? ' — pick an app' : ''), 'ok');\n      } catch(e){\n        /* Nothing installed takes text yet. An error here would read as broken\n           rather than un-adopted, so do the useful thing instead. */\n        print('No installed app can open text yet — here it is instead.', 'dim');\n        return print(body);\n      }\n    }\n\n    case 'share': {\n      if (!ops.length) return print('share <path>  — sends the file out through iOS', 'err');\n      var sBody = await files.read(target);\n      if (sBody == null) return print('No such file: ' + target, 'err');\n      if (!window.myllmShareFile) return print('Sharing needs a newer MyLLM build.', 'err');\n      var sName = target.split('/').pop(), sMime = mimeFor(sName);\n      try { await myllmShareFile(dataURL(sBody, sMime), { filename: sName, mime: sMime }); }\n      catch(e){ return print('share failed: ' + (e && e.message || e), 'err'); }\n      haptic('success');\n      return print('shared ' + sName, 'ok');\n    }\n\n    case 'alias': {\n      var aRest = restOf(line);\n      if (!aRest){\n        var names = Object.keys(aliases).sort();\n        if (!names.length) return print('no aliases yet — e.g.  alias ll \"ls -R\"', 'dim');\n        return print(names.map(function(k){ return k + '\\t' + aliases[k]; }).join('\\n'));\n      }\n      var aName = (tokenize(aRest)[0] || '').toLowerCase();\n      var aBody = unquote(restOf(aRest));\n      if (!aBody) return print(aliases[aName] ? aName + '\\t' + aliases[aName] : 'no alias ' + aName, aliases[aName] ? '' : 'dim');\n      if (KNOWN.indexOf(aName) >= 0) return print(aName + ' is already a command — pick another name', 'err');\n      aliases[aName] = aBody; saveAliases();\n      return print('alias ' + aName + ' -> ' + aBody, 'ok');\n    }\n\n    case 'unalias': {\n      var uName = (ops[0] || '').toLowerCase();\n      if (!uName) return print('unalias <name>', 'err');\n      if (!Object.prototype.hasOwnProperty.call(aliases, uName)) return print('no alias ' + uName, 'dim');\n      delete aliases[uName]; saveAliases();\n      return print('removed alias ' + uName, 'ok');\n    }\n\n    /* ---- mutations: this is a person at a prompt, so they are allowed ---- */\n\n    case 'mkdir':\n      if (!target) return print('mkdir needs a path', 'err');\n      if (snap.folders.indexOf(target) >= 0) return print(target + '/ already exists', 'dim');\n      await files.makeFolder(target);\n      remember({ type: 'mkdir', path: target });\n      haptic('success');\n      return print('created ' + target + '/', 'ok');\n\n    case 'mv': case 'cp': {\n      /* v10: several sources or a glob (mv *.md archive/) — the destination must\n         be a folder, and the moves run as one batch that one undo reverses. */\n      var mSrc = ops.length > 2 || (ops.length === 2 && isGlob(ops[0]));\n      if (mSrc){\n        var mDest = resolve(ops[ops.length - 1]);\n        if (snap.folders.indexOf(mDest) < 0) return print(verb + ' with several sources needs an existing folder last (mkdir it first)', 'err');\n        var mList = expandPaths(ops.slice(0, -1), snap, true);\n        var missing = mList.filter(function(x){ return x.noMatch; });\n        if (missing.length) return print('nothing matches ' + missing[0].noMatch, 'err');\n        if (!mList.length) return print('found nothing to ' + verb, 'dim');\n        var ownBatch = batchId == null;\n        if (ownBatch) batchId = Date.now();\n        try {\n          for (var mi = 0; mi < mList.length; mi++){\n            await run(verb + (flags.f ? ' -f ' : ' ') + '\"/' + mList[mi] + '\" \"/' + mDest + '/' + mList[mi].split('/').pop() + '\"');\n          }\n        } finally { if (ownBatch) batchId = null; }\n        return note(mList.length + ' item(s) — one  undo  reverses them all');\n      }\n      if (verb === 'cp') return copyOne(snap, ops, flags);\n      if (ops.length < 2) return print('mv needs a source and a destination', 'err');\n      var to = resolve(ops[1]);\n      if (!to) return print('mv needs a destination name', 'err');\n      /* Checked here, not left to the store: a missing source used to \"move\"\n         nothing and report success, which a batch would sail past. */\n      if (!snap.files.some(function(x){ return x.path === target; }) && snap.folders.indexOf(target) < 0)\n        return print('No such file or folder: ' + target, 'err');\n      var exists = snap.files.some(function(x){ return x.path === to; }) || snap.folders.indexOf(to) >= 0;\n      /* The store replaces a destination silently, and a replaced file cannot be\n         undone — so say so, and make replacing a deliberate flag. */\n      if (exists && !flags.f) return print(to + ' already exists — use  mv -f  to replace it', 'err');\n      await files.move(target, to);\n      remember({ type: 'mv', from: target, to: to });\n      haptic('success');\n      return print(target + ' -> ' + to, 'ok');\n    }\n\n    case 'write': case 'replace': case 'edit': {\n      /* write replaces the whole file; replace swaps text; edit changes lines.\n         All three are worked out by planEdit first, which is also what shows a\n         proposal's diff before anyone types y. */\n      var plan = await planEdit(line);\n      if (plan.err) return print(plan.err, 'err');\n      if (plan.prev === plan.next) return print('no change to ' + plan.path, 'dim');\n      if (inScratch(plan.path)){\n        if ((await scratchUsed(plan.path)) + plan.next.length > SCRATCH_MAX) return print(SCRATCH + ' is full (200 KB) — scratch clear  empties it', 'err');\n        await files.write(plan.path, plan.next);\n        return print(plan.said + '  (scratch — cleared when Shell opens)', 'dim');\n      }\n      await files.write(plan.path, plan.next);\n      remember({ type: 'write', path: plan.path, prev: plan.prev, how: plan.how });\n      haptic('success');\n      return print(plan.said + '  —  undo  puts it back', 'ok');\n    }\n\n    case 'rm': case 'rmdir': {\n      if (!target) return print(verb + ' needs a path', 'err');\n      var isDir = snap.folders.indexOf(target) >= 0;\n      var isFile = snap.files.some(function(x){ return x.path === target; });\n      if (!isDir && !isFile) return print('No such file or folder: ' + target, 'err');\n      if (verb === 'rm' && isDir) return print(target + ' is a folder — use rmdir', 'err');\n      if (verb === 'rmdir' && !isDir) return print(target + ' is not a folder — use rm', 'err');\n      var count = isDir ? snap.files.filter(function(x){ return x.path.indexOf(target+'/') === 0; }).length : 1;\n      if (inTrash(target) || flags.p){\n        /* Already in the trash, or explicitly permanent: this one really is gone,\n           so it still has to be said twice. */\n        pending = { verb: verb, target: target, count: count };\n        return print('delete ' + target + (isDir ? '/ and its ' + count + ' file(s)' : '') + ' for good? no undo — type  y  to confirm', 'err');\n      }\n      var dest = trashPath(target);\n      await files.move(target, dest);\n      remember({ type: 'rm', from: target, to: dest, isDir: isDir });\n      haptic('warning');\n      return print('moved ' + target + (isDir ? '/ (' + count + ' file(s))' : '') + ' to ' + TRASH + '  \\u2014  undo  puts it back', 'ok');\n    }\n\n    case 'undo': {\n      /* Reverses the newest change — all of it, if it was an approved batch.\n         The stack is kept in app storage, so it survives closing Shell. */\n      if (!undoStack.length) return print('nothing to undo', 'dim');\n      var top = undoStack[undoStack.length - 1], group = [];\n      if (top.batch != null){ while (undoStack.length && undoStack[undoStack.length - 1].batch === top.batch) group.push(undoStack.pop()); }\n      else group.push(undoStack.pop());\n      if (group.length > 1) print('undoing a batch of ' + group.length + ' changes', 'dim');\n      for (var gi = 0; gi < group.length; gi++){\n        var okU = await undoOne(group[gi]);\n        if (okU === false){ undoStack.push.apply(undoStack, group.slice(gi).reverse()); break; }\n        changeLog.push({ id: Date.now() + Math.random(), t: Date.now(), text: 'undid: ' + describeOp(group[gi]) });\n      }\n      if (changeLog.length > 200) changeLog.splice(0, changeLog.length - 200);\n      saveUndo(); saveLog();\n      haptic('success');\n      return;\n    }\n\n    case 'log': {\n      /* Changes made through Shell (yours, and proposals you approved), newest\n         first, kept between visits — plus files that changed OUTSIDE Shell\n         (other apps, the MyLLM assistant, collectors), read from file times so\n         \"no changes\" is never said when there were some. */\n      var howMany = Math.max(1, Math.min(ops[0] && !isNaN(+ops[0]) ? +ops[0] : n, 200));\n      var logPath = ops[0] && isNaN(+ops[0]) ? resolve(ops[0]) : null;\n      var pool2 = logPath ? changeLog.filter(function(e){ return e.text.indexOf(logPath) >= 0; }) : changeLog;\n      var live2 = {}; undoStack.forEach(function(u){ live2[u.id] = true; });\n      var nextUndo = undoStack.length ? undoStack[undoStack.length - 1].id : null;\n      var shellRows = pool2.slice(-howMany).reverse().map(function(e, i4){\n        return '#' + (i4 + 1) + '\\t' + when(e.t) + '\\t' + e.text + (e.id === nextUndo ? '   ← undo reverses this' : live2[e.id] ? '   (undoable)' : '');\n      });\n      var weekAgo = Date.now() / 1000 - 7 * 86400;\n      var outside = snap.files.filter(function(f){\n        if (f.modified < weekAgo || (logPath && f.path !== logPath && f.path.indexOf(logPath + '/') !== 0)) return false;\n        return !changeLog.some(function(e){ return e.text.indexOf(f.path) >= 0 && Math.abs(e.t / 1000 - f.modified) < 15; });\n      }).sort(function(a, b){ return b.modified - a.modified; }).slice(0, howMany);\n      print(shellRows.length ? 'via Shell:\\n' + shellRows.join('\\n') : 'no changes made via Shell' + (logPath ? ' to ' + logPath : '') + ' yet');\n      if (outside.length) print('\\nchanged outside Shell in the last 7 days (other apps, the assistant, sync — from file times):\\n' +\n        outside.map(function(f){ return '  ' + when(f.modified * 1000) + '\\t' + f.path; }).join('\\n'));\n      return note('times are ' + zoneLabel() + ' · trash  lists deleted files;  restore <path>  puts one back');\n    }\n\n    case 'versions':\n      if (!ops.length) return print('versions <path>  — saved versions of a file, 1 = newest  (history alone = your commands)', 'err');\n      /* falls through: versions <path> is history <path> */\n    case 'history': {\n      /* No path? Then you meant the other kind of history — the commands you\n         typed. With a path it is the file's own versions, as the native\n         workspace_shell tool spells it, and that meaning does not move. */\n      if (!ops.length){\n        if (!cmdHistory.length) return print('no commands yet', 'dim');\n        var hStart = Math.max(0, cmdHistory.length - 30);\n        print(cmdHistory.slice(hStart).map(function(c, i){ return (hStart + i + 1) + '\\t' + c; }).join('\\n'));\n        return print('!5 runs number 5, !! runs the last one again', 'dim');\n      }\n      if (!files.versions) return print('Version history needs the latest MyLLM build.', 'err');\n      var vs = await files.versions(target);\n      if (!vs.length) return print('No previous versions of ' + target + ' \\u2014 versions are kept from the first overwrite or delete.', 'dim');\n      print(vs.map(function(v, i){ return '#' + (i + 1) + '\\t' + when(v.stamp) + '\\t' + bytes(v.size); }).join('\\n'));\n      return print('revert ' + target + ' N  puts one back', 'dim');\n    }\n\n    case 'revert': {\n      if (!target) return print('revert needs a path', 'err');\n      if (!files.restoreVersion) return print('Version history needs the latest MyLLM build.', 'err');\n      var vn = ops[1] ? parseInt(ops[1], 10) : 1;\n      var vlist = await files.versions(target);\n      if (!vlist.length) return print('No previous versions of ' + target, 'dim');\n      if (!(vn >= 1 && vn <= vlist.length)) return print('revert: choose 1\\u2013' + vlist.length + ' (see  history ' + target + ')', 'err');\n      /* The store snapshots the current bytes before restoring, so undo is\n         simply \"restore the newest version\". */\n      await files.restoreVersion(target, vlist[vn - 1].stamp);\n      remember({ type: 'revert', path: target });\n      haptic('success');\n      return print('reverted ' + target + ' to #' + vn + ' (' + when(vlist[vn - 1].stamp) + ')  \\u2014  undo  puts it back', 'ok');\n    }\n\n    case 'trash': {\n      if ((ops[0] || '').toLowerCase() === 'empty'){\n        var all = await snapshot(true);\n        var inside = all.files.filter(function(x){ return inTrash(x.path); });\n        if (!inside.length && all.folders.indexOf(TRASH) < 0) return print(TRASH + ' is empty', 'dim');\n        pending = { verb: 'trash-empty', count: inside.length };\n        return print('delete ' + inside.length + ' file(s) in ' + TRASH + ' for good? no undo — type  y  to confirm', 'err');\n      }\n      var allT = await snapshot(true);\n      if (allT.folders.indexOf(TRASH) < 0) return print(TRASH + ' is empty', 'dim');\n      print(TRASH + '/  \\u2014  restore <path> puts something back, trash empty clears it', 'dim');\n      return listing(allT, TRASH, true);\n    }\n\n    case 'restore': {\n      if (!ops[0]) return print('restore needs a path as shown by  trash', 'err');\n      var all2 = await snapshot(true);\n      var src = normalise(ops[0]);\n      if (!inTrash(src)) src = TRASH + '/' + src;\n      var back = src.slice(TRASH.length + 1).replace(/~\\d{14}(?=\\.[^.\\/]+$|$)/, '');\n      var known = all2.files.some(function(x){ return x.path === src; }) || all2.folders.indexOf(src) >= 0;\n      if (!known) return print('Not in ' + TRASH + ': ' + src.slice(TRASH.length + 1), 'err');\n      var clash = all2.files.some(function(x){ return x.path === back; }) || all2.folders.indexOf(back) >= 0;\n      if (clash && !flags.f) return print(back + ' already exists — use  restore -f  to replace it', 'err');\n      await files.move(src, back);\n      await pruneTrash();\n      remember({ type: 'mv', from: src, to: back });\n      haptic('success');\n      return print('restored ' + back, 'ok');\n    }\n\n    default:\n      /* Not a command? Then it was a question. This is the line that turns a\n         terminal into an assistant that happens to live in a directory. */\n      return agent(line);\n  }\n}\n\nfunction remember(op){\n  op.id = Date.now() + Math.random();\n  if (batchId != null) op.batch = batchId;\n  undoStack.push(op);\n  if (undoStack.length > 30) undoStack.shift();\n  changeLog.push({ id: op.id, t: Date.now(), text: describeOp(op) + (op.batch != null ? '  (batch)' : '') });\n  if (changeLog.length > 200) changeLog.shift();\n  saveUndo(); saveLog();\n}\nfunction describeOp(op){\n  switch (op.type){\n    case 'rm': return 'moved ' + op.from + (op.isDir ? '/' : '') + ' to ' + TRASH;\n    case 'mv': return op.from + ' -> ' + op.to;\n    case 'mkdir': return 'created ' + op.path + '/';\n    case 'write': return (op.how || (op.prev == null ? 'created ' : 'changed ')) + op.path;\n    case 'revert': return 'reverted ' + op.path;\n    case 'cp': return 'copied ' + op.items.length + ' file(s) to ' + op.to;\n  }\n  return op.type;\n}\n/* Reverse one change. Returns false when it cannot be done safely. */\nasync function undoOne(op){\n  switch (op.type){\n    case 'rm': await files.move(op.to, op.from); await pruneTrash(); print('restored ' + op.from, 'ok'); break;\n    case 'revert': {\n      var rv = files.versions ? await files.versions(op.path) : [];\n      if (rv.length) { await files.restoreVersion(op.path, rv[0].stamp); print('restored ' + op.path + ' to before the revert', 'ok'); }\n      else print('nothing to restore for ' + op.path, 'dim');\n      break;\n    }\n    case 'mv': await files.move(op.to, op.from); print(op.to + ' -> ' + op.from, 'ok'); break;\n    case 'mkdir': await files.removeFolder(op.path, false); print('removed ' + op.path + '/', 'ok'); break;\n    case 'write':\n      if (op.prevLost){ print('cannot undo ' + op.path + ': the earlier text was too big to keep after Shell closed — try  history ' + op.path, 'err'); return false; }\n      if (op.prev == null){ await files.remove(op.path); print('removed ' + op.path, 'ok'); }\n      else { await files.write(op.path, op.prev); print('restored ' + op.path + ' (' + op.prev.length + ' chars)', 'ok'); }\n      break;\n    case 'cp':\n      for (var i = op.items.length - 1; i >= 0; i--){\n        var it = op.items[i];\n        if (it.prevLost){ print('cannot restore ' + it.path + ': the earlier text was too big to keep', 'err'); continue; }\n        if (it.prev == null) await files.remove(it.path); else await files.write(it.path, it.prev);\n      }\n      print('undid the copy of ' + op.items.length + ' file(s)', 'ok'); break;\n  }\n  return true;\n}\n\nfunction listing(snap, root, recursive, sortBy, opt){\n  opt = opt || {};\n  var prefix = root ? root + '/' : '';\n  /* tree -L N: only N levels below where you started. */\n  var baseDepth = prefix ? prefix.split('/').length - 1 : 0;\n  var within = function(p){ return !opt.depth || p.split('/').length - baseDepth <= opt.depth; };\n  if (root && snap.folders.indexOf(root) < 0){\n    var one = snap.files.filter(function(f){ return f.path === root; })[0];\n    if (one) return printHTML(pathHTML(one.path) + '\\t<span class=\"dim\">' + one.size + 'B\\t' + when(one.modified*1000) + '</span>');\n    return print('No such file or folder: ' + root, 'err');\n  }\n  var depth = prefix ? prefix.split('/').length : 1;\n  var subs = snap.folders.filter(function(f){\n    return f.indexOf(prefix) === 0 && f !== root && (recursive || f.split('/').length === depth) && within(f);\n  }).sort();\n  var here = snap.files.filter(function(f){\n    return f.path.indexOf(prefix) === 0 && (recursive || f.path.split('/').length === depth) && within(f.path);\n  }).sort(function(a,b){\n    /* -t newest first, -S biggest first; otherwise by name */\n    if (sortBy === 't' && a.modified !== b.modified) return b.modified - a.modified;\n    if (sortBy === 'S' && a.size !== b.size) return b.size - a.size;\n    return a.path < b.path ? -1 : 1;\n  });\n  if (!subs.length && !here.length) return print(root ? root + '/ is empty' : 'The workspace is empty', 'dim');\n  if (opt.long){\n    /* ls -l: one aligned line each — readable size, modified, name. There is\n       no owner column: everything in the workspace is yours. */\n    var pad = function(t, w){ t = String(t); return t.length >= w ? t : '        '.slice(0, w - t.length) + t; };\n    var rowsL = subs.map(function(d){\n      var inD = snap.files.filter(function(x){ return x.path.indexOf(d + '/') === 0; });\n      var newest = inD.reduce(function(m, x){ return Math.max(m, x.modified); }, 0);\n      return '<span class=\"dim\">d ' + pad(bytes(inD.reduce(function(a, b){ return a + b.size; }, 0)), 7) + '  ' + (newest ? when(newest*1000) : '                ') + '  </span>' + '<span class=\"dir\">' + pathHTML(d, d.slice(prefix.length) + '/') + '</span><span class=\"dim\">  (' + inD.length + ')</span>';\n    }).concat(here.map(function(f){\n      return '<span class=\"dim\">- ' + pad(bytes(f.size), 7) + '  ' + when(f.modified*1000) + '  </span>' + pathHTML(f.path, f.path.slice(prefix.length));\n    }));\n    printHTML(rowsL.join('\\n'));\n    return note(here.length + ' file(s), ' + subs.length + ' folder(s), ' + bytes(here.reduce(function(a, b){ return a + b.size; }, 0)) + ' · times ' + zoneLabel());\n  }\n  var html = subs.map(function(d){ return '<span class=\"dir\">' + pathHTML(d, d + '/') + '</span>'; })\n    .concat(here.map(function(f){\n      return pathHTML(f.path) + '\\t<span class=\"dim\">' + f.size + 'B\\t' + when(f.modified*1000) + '</span>';\n    })).join('\\n');\n  printHTML(html);\n}\n\n/* ================= the assistant, inside the directory =================\n   Type anything that is not a command and it becomes a question. The model is\n   given the working directory and the command list, and answers with ONE JSON\n   object per turn: run a command, or say something. The app executes the\n   command locally and feeds the output back — which is the whole trick, because\n   myllmAsk has no tools of its own. The shell commands ARE the tools.\n\n   READ-ONLY autonomously. Anything that writes or deletes comes back as a\n   proposal the user has to accept: a model running rm across someone's\n   documents unattended is the one outcome worth designing against. */\n\nvar READ_ONLY = ['ls','dir','tree','cat','head','tail','sed','stat','find','grep','diff','jq','wc','sort','uniq','cut','tr','paste','comm','awk','xargs','man','changes','preview','date','info','scratch','versions','history','du','pwd','log'];\n/* The assistant may also cd — its own working folder, put back afterwards. */\nvar AGENT_OK = READ_ONLY.concat(['cd', 'scratch']);\n/* Writes the assistant may make without asking: into .scratch only. A pipeline\n   of read-only stages redirected there, or write/replace/edit of a scratch file. */\nfunction scratchOnly(cmd){\n  var pl = splitPipeline(cmd);\n  if (!pl.stages.length) return false;\n  if (pl.redirect){\n    if (!pl.redirect.path || !inScratch(resolve(pl.redirect.path))) return false;\n    return pl.stages.every(function(st){ var v = (tokenize(expandAlias(st))[0] || '').toLowerCase(); return READ_ONLY.indexOf(v) >= 0; });\n  }\n  if (pl.stages.length !== 1) return false;\n  var tk = tokenize(pl.stages[0]), v1 = (tk[0] || '').toLowerCase();\n  if (['write','replace','edit'].indexOf(v1) < 0) return false;\n  var o = parseOpts(tk.slice(1), '');\n  if (o.ops[0] === '-1' || o.ops[0] === '-1E' || o.ops[0] === '-E1') o.ops.shift();\n  return !!o.ops[0] && inScratch(resolve(o.ops[0]));\n}\nvar MAX_STEPS = 6;          /* myllmAsk is rate-limited; five is plenty and stays inside it */\n\n/* The system prompt for the `ask` VERB — a filter, not an assistant. Anything\n   it says that is not the answer ends up in the user's file, so say none of it. */\nvar FILTER_SYSTEM = [\n  'You are a filter in a command-line pipeline, inside the user\\'s file workspace.',\n  'Do exactly what the instruction asks of the material you are given, and output ONLY the result.',\n  'No preamble, no sign-off, no explanation of what you did, no markdown code fences.',\n  'Plain text unless the instruction asks for another format. Never invent material you were not given.'\n].join('\\n');\n\nfunction systemPrompt(listing){\n  return [\n    'You are working inside a directory of the user\\'s MyLLMos shared workspace, like a terminal assistant.',\n    'Current directory: /' + (cwd || ''),\n    '',\n    'Contents right now:',\n    listing || '(empty)',\n    '',\n    'You may run these READ-ONLY commands: ls [-R] [-t newest first | -S biggest first] [path], tree [path], cat <path>, head -n N <path>, tail -n N <path>, sed -n \\'40,80p\\' <path> (a line range), stat <path>, find <glob> [-mtime -7] [-newer <path>] [-size +10k] [-type d], grep [-n] [-C N] [-v] [-c] [-l] [-s] <text or /regex/> [path], diff <a> <b> or diff <path>@N (version N vs now), jq \\'.field\\' <path> (pull values out of JSON: .a.b, .list[0], .list[], keys, length), wc [-l], sort [-r] [-n] [-k N], uniq [-c], cut -d X -f N, versions <path> (saved versions; `history` alone is the command history), log (recent changes), du.',\n    'You may pipe them: `a | b` sends a\\'s output into b, and cat, head, tail, sed, grep, wc, sort, uniq, cut and jq read what is piped in — e.g. `grep -l invoice notes | wc -l` or `find *.md | cut -d / -f 1 | sort | uniq -c | sort -rn`. One pipeline is one step, so prefer it over three separate looks.',\n    'Paths are relative to your working folder. You may `cd <path>` (also `cd ..`, `cd -`, `cd @bookmark`) to work deeper without spelling long paths; it is YOUR folder for this question and the user\\'s prompt is put back afterwards.' + (Object.keys(marks).length ? ' Bookmarks: ' + Object.keys(marks).map(function(k){ return '@' + k + ' = /' + marks[k]; }).join(', ') + '.' : ''),\n    'Today: ' + when(Date.now()) + '. All times shown are ' + zoneLabel() + '. `info` summarises the workspace (size, top folders, newest changes, hidden .trash/.scratch counts); `log` lists changes made via Shell AND files changed outside it.',\n    'Hidden: .trash (deleted files; `trash`, `ls -a`) and .scratch (your notes). Values that look like keys or tokens are shown to you as [masked]; never ask the user to paste them.',\n    'Writing output to a file with > or >> is a CHANGE: propose it, never run it.',\n    '',\n    'Reply with ONE JSON object and nothing else:',\n    '  {\"run\":\"<command>\"}                     to look at something first',\n    '  {\"run\":[\"<command>\",\"<command>\"]}         up to 4 unrelated looks in one step (e.g. cat two files and log)',\n    '  {\"say\":\"<answer>\"}                      when you can answer',\n    '  add \"say\" to a run or propose to tell the user what you are doing (\"checking the log first…\")',\n    '  {\"propose\":\"<command>\",\"why\":\"<reason>\"} to CHANGE something (mkdir, mv, cp, write, replace, edit, rm, rmdir, revert <path> N) — the user approves it, you never run it. rm moves to a trash folder and can be undone; revert puts a previous version back.',\n    '  {\"propose\":[\"<command>\",\"<command>\",…],\"why\":\"<reason>\"} for several changes approved together, e.g. a folder reorganisation: they run in order, stop at the first failure, and one undo reverses all of them.',\n    'To change part of a file, propose a SMALL edit rather than rewriting it: replace <path> \"old text\" \"new text\" (every occurrence; -1 for the first only), or edit <path> <A-B> \"new lines\" (\\\\n for a line break; empty text deletes the lines; <A>+ inserts after line A). The user sees the diff before approving. Use write only for a new file or a full rewrite.',\n    '',\n    'More read-only tools: tr, paste, comm, awk \\'{print $N}\\', xargs <read-only command> (e.g. grep -l x | xargs head -n 3), date, info, and man <command> for its exact flags. Run `man <cmd>` instead of guessing a flag; `changes` lists what Shell can do now.',\n    'Before proposing a change you are unsure of, run `preview <the command>` (e.g. preview replace -E notes.md \"re\" \"new\", preview mv *.md archive): it shows exactly what would change, touching nothing. A batch cannot branch, so check first, then propose the exact steps.',\n    'Scratch: you may WRITE working notes into /.scratch/ without asking — `write .scratch/notes.md \"…\"`, `grep -l x notes > .scratch/hits.txt`, `… >> .scratch/log.md`, replace/edit there too. It is hidden from the user\\'s listings, capped at 200 KB, emptied each time Shell opens, and never the place for the user\\'s documents: anything they should keep is still a proposal.',\n    'Long output is cut at a line with a marker telling you how to read on. \"Earlier in this session\" tells you what became of your last proposals (approved, failed, or declined) — do not re-propose a declined change unless asked.',\n    'Each output ends with [status: ok], [status: found nothing] or [status: failed]; a blocked command says why.',\n    'Prefer running a command over guessing. Answer in plain prose, briefly. Do not invent file contents.'\n  ].join('\\n');\n}\n\nasync function runCaptured(line){\n  /* The agent's steps stay visible on screen (silent: false) — watching it look\n     around is most of why the loop is trustworthy. Each output ends with a\n     status the model can't misread: ok, found nothing, or failed (and why). */\n  var text = await captureOf(function(){ return runLine(line); }, false);\n  var failed = lastCaptureError;\n  var empty = !text.trim() || /^(found nothing|no match|no file matches|nothing matches|.* is empty$)/i.test(text.trim());\n  var status = failed ? '[status: failed — the error is above]' : empty ? '[status: found nothing]' : '[status: ok]';\n  /* Cut at a line, and say exactly where and how to read on. */\n  if (text.length > 4000){\n    var allL = text.split('\\n'), keep = [], used = 0;\n    for (var li = 0; li < allL.length && used + allL[li].length + 1 <= 4000; li++){ keep.push(allL[li]); used += allL[li].length + 1; }\n    var nKeep = Math.max(1, keep.length);\n    text = keep.join('\\n') + '\\n[output cut at line ' + nKeep + ' of ' + allL.length + ' — read on with:  ' + line.replace(/\\s*$/, '') + \" | sed -n '\" + (nKeep + 1) + \",+80p'  (or narrow it with grep/head)]\";\n  }\n  return maskSecrets(text) + '\\n' + status;\n}\n\nfunction parseReply(raw){\n  var t = String(raw || '').trim();\n  /* Models fence JSON even when told not to. */\n  t = t.replace(/^```(?:json)?/i, '').replace(/```$/, '').trim();\n  var a = t.indexOf('{'), b = t.lastIndexOf('}');\n  if (a < 0 || b < a) return null;\n  try { return JSON.parse(t.slice(a, b + 1)); } catch(e){ return null; }\n}\n\n/* ---------- v13: the working bar ----------\n   While MyLLM works you see what it is doing and for how long, and a second\n   Enter doesn't send the question again (sent three times, it confused the\n   model). Stop ends it after the current step. */\nvar busy = null;\nfunction workStart(text){\n  if (busy) return false;\n  busy = { started: Date.now(), stopped: false, steps: 0 };\n  var bar = document.getElementById('work');\n  bar.hidden = false; document.body.classList.add('busy');\n  workStep(text);\n  busy.tick = setInterval(function(){\n    if (busy) document.getElementById('workT').textContent = Math.round((Date.now() - busy.started) / 1000) + 's';\n  }, 500);\n  input.setAttribute('data-ph', input.placeholder || '');\n  input.placeholder = 'MyLLM is working — wait, or tap Stop';\n  return true;\n}\nfunction workStep(text){\n  if (!busy) return;\n  document.getElementById('workTxt').textContent = text;\n  document.getElementById('workT').textContent = Math.round((Date.now() - busy.started) / 1000) + 's';\n}\nfunction workEnd(){\n  if (!busy) return;\n  clearInterval(busy.tick); busy = null;\n  document.getElementById('work').hidden = true; document.body.classList.remove('busy');\n  input.placeholder = input.getAttribute('data-ph') || '';\n}\nfunction workStopped(){ return !!(busy && busy.stopped); }\ndocument.getElementById('workStop').addEventListener('click', function(){\n  if (!busy) return;\n  busy.stopped = true; haptic('light');\n  workStep('stopping after this step…');\n});\n\n/* What the assistant remembers between questions in this session: what was\n   asked, what it said, and what became of anything it proposed (approved and\n   ran, approved but failed, declined). Before, it never learnt the outcome. */\nvar agentMemory = [];\nvar pendingMemo = null;   /* the memory entry whose proposal awaits y/n */\nfunction rememberAgent(entry){ agentMemory.push(entry); if (agentMemory.length > 6) agentMemory.shift(); return entry; }\nfunction memoryText(){\n  if (!agentMemory.length) return '';\n  return 'Earlier in this session (oldest first):\\n' + agentMemory.map(function(m){\n    var t = '- User: ' + m.q.slice(0, 200);\n    if (m.said) t += '\\n  You said: ' + m.said.slice(0, 300);\n    if (m.proposed) t += '\\n  You proposed: ' + m.proposed.join(' ; ').slice(0, 300) + '\\n  Outcome: ' + m.outcome;\n    return t;\n  }).join('\\n') + '\\n\\n';\n}\n\nasync function agent(question){\n  if (!window.myllmAsk){\n    print('AI is off for apps — turn on \"Allow apps to use the AI\" in MyLLMos settings.', 'err');\n    return;\n  }\n  /* The listing goes to the MODEL only. It used to be printed on screen with\n     every question (capture without quiet), which was most of the noise. */\n  var snap = await snapshot();\n  var here = await captureOf(function(){ return listing(snap, cwd, false); }, true);\n  var hl = here.split('\\n');\n  if (hl.length > 40) here = hl.slice(0, 40).join('\\n') + '\\n[' + (hl.length - 40) + ' more — run ls]';\n\n  /* The assistant may cd while it works; that is ITS working folder for this\n     question. Yours is put back when it finishes. */\n  var userCwd = cwd;\n  var transcript = memoryText() + 'User: ' + question;\n  var memo = rememberAgent({ q: question });\n  var ownBar = workStart('MyLLM is thinking…');\n  try {\n    for (var step = 0; step < MAX_STEPS; step++){\n      var raw;\n      workStep(step ? 'MyLLM is thinking · step ' + (step + 1) : 'MyLLM is thinking…');\n      try { raw = await myllmAsk(transcript + '\\n\\nReply with one JSON object.', { system: systemPrompt(here) }); }\n      catch(e){ print('ask failed: ' + (e.message || e), 'err'); return; }\n      if (workStopped()){ print('stopped — ask again whenever you like', 'dim'); memo.said = '(stopped by the user)'; return; }\n\n      var reply = parseReply(raw);\n      if (!reply){\n        /* Not JSON — treat it as the answer rather than failing in the user's face. */\n        print(String(raw).trim(), 'say'); memo.said = String(raw).trim();\n        return;\n      }\n      var acting = reply.run || reply.propose;\n      /* \"say\" alongside a command is a note to the user (\"checking the log\n         first…\"); on its own it is the answer. */\n      if (reply.say && acting) print(String(reply.say).trim(), 'note');\n      if (reply.say && !acting){ print(String(reply.say).trim(), 'say'); memo.said = String(reply.say).trim(); return; }\n\n      if (reply.propose){\n        var why = reply.why ? ' — ' + reply.why : '';\n        /* A list (or a multi-line string) is a batch: one approval, run in order. */\n        var steps = Array.isArray(reply.propose) ? reply.propose.map(String)\n          : String(reply.propose).split('\\n');\n        steps = steps.map(function(x){ return x.trim(); }).filter(Boolean).slice(0, 20);\n        if (!steps.length){ print(String(raw).trim(), 'say'); return; }\n        /* Proposals are written relative to the assistant's folder; pin them to\n           absolute paths by running them from there. */\n        var runFrom = cwd;\n        memo.proposed = steps; memo.outcome = 'waiting for the user';\n        pendingMemo = memo;\n        if (steps.length === 1){\n          print('proposes: ' + steps[0] + why, 'propose');\n          await previewEdit(steps[0]);\n          print('run it? type  y  to confirm', 'propose');\n          pending = { verb: 'raw', line: steps[0], from: runFrom };\n          return;\n        }\n        print('proposes ' + steps.length + ' changes' + why + ':', 'propose');\n        for (var si2 = 0; si2 < steps.length; si2++){\n          print('  ' + (si2 + 1) + '. ' + steps[si2], 'propose');\n          await previewEdit(steps[si2]);\n        }\n        print('run all ' + steps.length + '? type  y  to confirm — one  undo  reverses the lot', 'propose');\n        pending = { verb: 'batch', lines: steps, from: runFrom };\n        return;\n      }\n      if (reply.run){\n        /* One command, or a few unrelated looks in one step (max 4). */\n        var cmds = (Array.isArray(reply.run) ? reply.run : [reply.run]).map(function(x){ return String(x).trim(); }).filter(Boolean).slice(0, 4);\n        for (var ci = 0; ci < cmds.length; ci++){\n          var cmd = cmds[ci];\n          /* Every stage, not just the first verb — and a redirect turns a pipeline\n             of read-only commands into a write, which is exactly the hole worth\n             closing before the model finds it. */\n          var why2 = scratchOnly(cmd) ? null : unsafeReason(cmd, AGENT_OK);\n          if (why2){\n            print('blocked: ' + cmd + ' — ' + why2, 'dim');\n            transcript += '\\n\\nAssistant tried: ' + cmd + '\\n[status: blocked — ' + why2 + ']. Use \"propose\" for anything that changes files.';\n            continue;\n          }\n          print('$ ' + cmd + (cwd !== userCwd ? '   (in /' + cwd + ')' : ''), 'step');\n          workStep('running  ' + cmd);\n          var output = await runCaptured(cmd);\n          if (workStopped()){ print('stopped — ask again whenever you like', 'dim'); return; }\n          transcript += '\\n\\nAssistant ran: ' + cmd + (cwd ? '  (working folder /' + cwd + ')' : '') + '\\nOutput:\\n' + (output || '(no output)');\n        }\n        continue;\n      }\n      print(String(raw).trim(), 'say');\n      return;\n    }\n    print('Stopped after ' + MAX_STEPS + ' steps. Ask something narrower, or run the commands yourself.', 'dim');\n  } finally {\n    if (ownBar) workEnd();\n    if (cwd !== userCwd){ cwd = userCwd; paintPrompt(); }\n  }\n}\n\n/* ---------- prompt ---------- */\n\ndocument.getElementById('form').addEventListener('submit', async function(ev){\n  ev.preventDefault();\n  var line = input.value.trim();\n  if (!line) return;\n  /* Still working: don't send it again. Keep what was typed. */\n  if (busy){\n    if (line.toLowerCase() === 'stop'){ input.value = ''; document.getElementById('workStop').click(); return; }\n    haptic('warning');\n    workStep(document.getElementById('workTxt').textContent.replace(/ — still working.*$/, '') + ' — still working, tap Stop to cancel');\n    return;\n  }\n  input.value = '';\n\n  if (pending){\n    var p = pending; pending = null;\n    var memoP = pendingMemo; pendingMemo = null;\n    if (line.toLowerCase() === 'y' || line.toLowerCase() === 'yes'){\n      var heldCwd = cwd;\n      if (p.from != null) cwd = p.from;   /* run where the assistant wrote it */\n      try{\n        if (p.verb === 'raw'){\n          print('$ ' + p.line, 'cmd');\n          var rOut = await captureOf(function(){ return runLine(p.line); }, false);\n          if (memoP) memoP.outcome = lastCaptureError ? 'approved, but it FAILED: ' + rOut.slice(0, 200) : 'approved and done: ' + rOut.slice(0, 160);\n        }\n        else if (p.verb === 'batch'){\n          batchId = Date.now();\n          try {\n            for (var bi = 0; bi < p.lines.length; bi++){\n              print('$ ' + p.lines[bi], 'cmd');\n              await captureOf(function(){ return runLine(p.lines[bi]); }, false);\n              if (lastCaptureError){ print('stopped at step ' + (bi + 1) + ' of ' + p.lines.length + ' — undo reverses the steps that ran', 'err');\n                if (memoP) memoP.outcome = 'approved; steps 1–' + bi + ' ran, step ' + (bi + 1) + ' FAILED, the rest did not run'; break; }\n            }\n            if (memoP && !lastCaptureError) memoP.outcome = 'approved and all ' + p.lines.length + ' steps ran';\n          } finally { batchId = null; }\n        }\n        else if (p.verb === 'trash-empty') await files.removeFolder(TRASH, true);\n        else if (p.verb === 'rm') await files.remove(p.target);\n        else await files.removeFolder(p.target, true);\n        haptic('warning');\n        if (p.verb === 'trash-empty') print('emptied ' + TRASH, 'ok');\n        else if (p.verb !== 'raw' && p.verb !== 'batch') print('deleted ' + p.target, 'ok');\n      }catch(e){ print(e.message, 'err'); if (memoP) memoP.outcome = 'approved, but it failed: ' + e.message; }\n      finally { if (p.from != null) cwd = heldCwd; }\n    } else { print('cancelled', 'dim'); if (memoP) memoP.outcome = 'the user DECLINED it (typed \"' + line.slice(0, 40) + '\")'; }\n    paintPrompt(); renderChips();\n    return;\n  }\n\n  /* !! and friends resolve here, so the scrollback and the history both record\n     the command that actually ran rather than the shorthand for it. */\n  if (line.charAt(0) === '!'){\n    var recalled = expandBang(line);\n    if (!recalled){ print(prompt$() + ' \\u276f ' + line, 'cmd'); print('no matching command in history', 'err'); renderChips(); return; }\n    line = recalled;\n  }\n\n  cmdHistory.push(line); hIndex = cmdHistory.length;\n  if (cmdHistory.length > 200) cmdHistory.shift();\n  saveHistory();\n  if (isCommandLine(line)) print(prompt$() + ' \\u276f ' + line, 'cmd');\n  else printHTML('<div class=\"you\"><span class=\"who\">you</span>' + esc(line) + '</div>');\n  try { await runLine(line); }\n  catch(e){ print(String(e && e.message || e), 'err'); }\n  stdin = null;\n  paintPrompt();\n  renderChips();\n});\n\n/* Up/down through history, as a shell does. */\ninput.addEventListener('keydown', function(e){\n  if (e.key === 'ArrowUp'){ if (hIndex > 0){ hIndex--; input.value = cmdHistory[hIndex]; } e.preventDefault(); }\n  if (e.key === 'ArrowDown'){ if (hIndex < cmdHistory.length-1){ hIndex++; input.value = cmdHistory[hIndex]; } else { hIndex = cmdHistory.length; input.value = ''; } e.preventDefault(); }\n});\n\n/* ---------- completion, for a keyboard with no Tab key ----------\n   The chip row follows what you type: verbs while you type the first word,\n   then names from the folder you are pointing at. A folder completes with a\n   trailing slash and keeps going. Empty input shows the usual shortcuts. */\nvar chipsEl = document.getElementById('chips');\nvar DEFAULT_CHIPS = ['ls','ls -R','ask ','grep ','open ','help'];\nvar SINKS = ['grep','sort','uniq','wc','cut','jq','head','ask'];   /* the commands that read a pipe */\n/* The last | that is not inside quotes. */\nfunction lastPipe(v){\n  var q = null, at = -1;\n  for (var i = 0; i < v.length; i++){\n    var c = v.charAt(i);\n    if (q){ if (c === q) q = null; continue; }\n    if (c === '\"' || c === \"'\") q = c;\n    else if (c === '|') at = i;\n    else if (c === '>') return at;   /* past a redirect you are naming a file again */\n  }\n  return at;\n}\n\nfunction chip(label, cls, onTap){\n  var b = document.createElement('button');\n  b.className = 'chip' + (cls ? ' ' + cls : ''); b.type = 'button'; b.textContent = label;\n  b.addEventListener('pointerdown', function(e){ e.preventDefault(); });  /* keep the keyboard up */\n  b.addEventListener('click', onTap);\n  return b;\n}\nfunction setInput(v){ input.value = v; input.focus(); renderChips(); }\n\nfunction renderChips(){\n  chipsEl.innerHTML = '';\n  var v = input.value, atStart = v.length === 0;\n  if (pending){ [['y','ok'],['n','dim']].forEach(function(x){ chipsEl.appendChild(chip(x[0], '', function(){ setInput(x[0]); })); }); return; }\n  if (atStart){\n    DEFAULT_CHIPS.forEach(function(c){ chipsEl.appendChild(chip(c, '', function(){ setInput(c); })); });\n    if (undoStack.length) chipsEl.appendChild(chip('undo', 'undo', function(){ setInput('undo'); }));\n    if (cwd) chipsEl.appendChild(chip('cd ..', 'dirc', function(){ setInput('cd ..'); }));\n    return;\n  }\n  var endsWithSpace = /\\s$/.test(v);\n  var tokens = tokenize(v);\n  var partial = endsWithSpace ? '' : (tokens[tokens.length - 1] || '');\n  var head = endsWithSpace ? v : v.slice(0, v.length - partial.length);\n  /* Completion follows the STAGE, not the line: after a pipe you are naming a\n     command again, so offering file names there would be offering the one thing\n     that cannot go next. */\n  var pipeAt = lastPipe(v);\n  var stageTokens = tokenize(pipeAt >= 0 ? v.slice(pipeAt + 1) : v);\n  var firstWord = stageTokens.length === 0 || (stageTokens.length === 1 && !endsWithSpace);\n  var items = [];\n  if (firstWord){\n    /* Straight after a pipe, lead with the commands that can actually read one. */\n    if (pipeAt >= 0 && !partial)\n      SINKS.forEach(function(x){ items.push({ label: x, value: x + ' ', cls: 'comp' }); });\n    Object.keys(aliases).sort().filter(function(x){ return x.indexOf(partial.toLowerCase()) === 0 && x !== partial; })\n      .forEach(function(x){ items.push({ label: x, value: x + ' ', cls: 'undo' }); });\n    VERBS.filter(function(x){ return x.indexOf(partial.toLowerCase()) === 0 && x !== partial\n                                     && !(pipeAt >= 0 && !partial && SINKS.indexOf(x) >= 0); })\n      .forEach(function(x){ items.push({ label: x, value: x + ' ', cls: '' }); });\n  } else if (lastSnap){\n    var slash = partial.lastIndexOf('/');\n    var dirPart = slash >= 0 ? partial.slice(0, slash + 1) : '';\n    var namePart = slash >= 0 ? partial.slice(slash + 1) : partial;\n    var base = resolve(dirPart || '.');\n    var prefix = base ? base + '/' : '';\n    var depth = prefix ? prefix.split('/').length : 1;\n    var seen = {};\n    var showHidden = inTrash(base) || namePart.charAt(0) === '.';\n    lastSnap.folders.forEach(function(d){\n      if (d.indexOf(prefix) !== 0 || d === base || d.split('/').length !== depth) return;\n      if (!showHidden && inTrash(d)) return;\n      var name = d.slice(prefix.length);\n      if (name.toLowerCase().indexOf(namePart.toLowerCase()) === 0 && !seen[name]){ seen[name] = 1; items.push({ label: name + '/', value: dirPart + name + '/', cls: 'dirc' }); }\n    });\n    lastSnap.files.forEach(function(f){\n      if (f.path.indexOf(prefix) !== 0 || f.path.split('/').length !== depth) return;\n      if (!showHidden && inTrash(f.path)) return;\n      var name = f.path.slice(prefix.length);\n      if (name.toLowerCase().indexOf(namePart.toLowerCase()) === 0 && !seen[name] && name !== namePart){ seen[name] = 1; items.push({ label: name, value: dirPart + name, cls: 'comp' }); }\n    });\n    if (base && !namePart) items.push({ label: '..', value: dirPart + '../', cls: 'dirc' });\n  }\n  /* On a phone | and > live two taps down in the symbol plane, which is enough\n     friction to stop anyone discovering pipelines at all. */\n  if (!firstWord && isCommandLine(v) && !/[|>]/.test(v)){\n    var base = v.replace(/\\s+$/, '');\n    items.unshift({ label: '>', value: null, cls: 'undo', raw: base + ' > ' });\n    items.unshift({ label: '|', value: null, cls: 'undo', raw: base + ' | ' });\n  }\n\n  items.slice(0, 12).forEach(function(it){\n    chipsEl.appendChild(chip(it.label, it.cls, function(){\n      if (it.raw != null) return setInput(it.raw);\n      var val = /[\\s\"']/.test(it.value) ? '\"' + it.value + '\"' : it.value;\n      setInput(head + val);\n    }));\n  });\n  if (!items.length && !firstWord) DEFAULT_CHIPS.slice(0, 3).forEach(function(c){ chipsEl.appendChild(chip(c, 'dim', function(){ setInput(c); })); });\n}\ninput.addEventListener('input', renderChips);\ninput.addEventListener('focus', renderChips);\n\n/* Tap a path the shell printed and it lands in the prompt — appended after a\n   space if you were mid-command, or on its own if the prompt was empty. */\nout.addEventListener('click', function(e){\n  var el = e.target.closest('.path');\n  if (!el) return;\n  var p = el.getAttribute('data-path');\n  if (cwd && p.indexOf(cwd + '/') === 0) p = p.slice(cwd.length + 1);   /* relative to where you stand */\n  else if (cwd) p = '/' + p;\n  var val = /[\\s\"']/.test(p) ? '\"' + p + '\"' : p;\n  var v = input.value;\n  setInput(v && !/\\s$/.test(v) ? v + ' ' + val : v + val);\n  haptic('selection');\n});\nrenderChips();\n\n/* Full screen where MyLLM can also close the app (5.6.2+); elsewhere nothing\n   changes, so there is never a full screen without a way out. */\nfunction fullScreenOK(){ return !!(window.myllmClose && window.myllmImmersive); }\nfunction syncFullScreen(){\n  var f = fullScreenOK();\n  document.body.classList.toggle('imm', f);\n  if (f) try { window.myllmImmersive(true, { keepAwake: false }).catch(function(){}); } catch(e){}\n}\nwindow.shellClose = function(){ haptic('light'); try { window.myllmClose().catch(function(){}); } catch(e){} };\ndocument.addEventListener('visibilitychange', function(){ if (!document.hidden) syncFullScreen(); });\ndocument.addEventListener('gesturestart', function(e){ e.preventDefault(); });\nsyncFullScreen();\n\npaintPrompt();\nprint('MyLLMos workspace shell. Type  help  for commands.', 'dim');\nprint('Anything that is not a command is a question — MyLLM answers it from here,', 'dim');\nprint('running the read-only commands itself and asking before it changes anything.', 'dim');\nprint('Pipe things about:  cat notes.md | ask \"summarise this\" > summary.md', 'dim');\nprint('rm moves things to .trash and  undo  reverses your last change. Tap any path to use it.', 'dim');\n\n/* History and aliases come back from storage before anything runs, so .shellrc\n   can use an alias it defined last time and !! works on the first line typed. */\n(async function boot(){\n  await loadState();\n  /* Scratch starts empty every time: working paper, not storage. */\n  try {\n    if (window.myllmFiles) await clearScratch();\n  } catch(e){}\n  renderChips();\n  if (!window.myllmFiles){ print('\\nShared files are off — turn them on in MyLLMos settings.', 'err'); return; }\n  try { await runRC(); } catch(e){ print('.shellrc: ' + (e && e.message || e), 'err'); }\n  await runLine('ls');\n  paintPrompt();\n  renderChips();\n})();\n</script>\n</body></html>\n"}