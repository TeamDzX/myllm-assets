{"name": "Colouring Page Maker", "html": "<!doctype html>\n<!--\n  Colouring Page Maker — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Colouring Page Maker</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"57b4b7ca62\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); --h:330; }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.96); }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 28%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  @media (max-width:360px){ h1{ font-size:19px; letter-spacing:-.02em; } .head{ gap:10px; } }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  label{ display:block; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:0 2px 7px; }\n  input{ width:100%; font:inherit; font-size:16px; padding:12px; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; }\n  input:focus{ border-color:var(--acc); }\n  .chips{ display:flex; gap:7px; overflow-x:auto; -webkit-overflow-scrolling:touch; scrollbar-width:none; margin:9px -14px 0; padding:0 14px 2px; }\n  .chips::-webkit-scrollbar{ display:none; }\n  .chip{ flex:0 0 auto; min-height:36px; border:1px solid var(--line); background:var(--bg); border-radius:99px; padding:0 14px; font-size:13.5px; font-weight:650; white-space:nowrap; }\n  .go{ width:100%; min-height:50px; margin-top:14px; border:none; border-radius:14px; background:var(--acc); color:#fff; font-size:16px; font-weight:700;\n    display:flex; align-items:center; justify-content:center; gap:8px; }\n  .go:disabled{ opacity:.6; }\n  .spin{ width:16px; height:16px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n\n  .page{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:10px; }\n  .paper{ background:#fff; border-radius:12px; overflow:hidden; }\n  .paper img{ width:100%; display:block; }\n  .skel{ aspect-ratio:3/4; border-radius:12px; background:var(--fill); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px;\n    color:var(--muted); font-size:14px; font-weight:600; animation:shimmer 1.6s ease-in-out infinite; }\n  .skel .tile{ width:48px; height:48px; border-radius:14px; font-size:21px; }\n  @keyframes shimmer{ 50%{ opacity:.55; } }\n  .acts2{ display:flex; gap:8px; margin-top:10px; }\n  .acts2 button{ flex:1; min-height:46px; border:none; border-radius:12px; font-size:14.5px; font-weight:700; display:flex; align-items:center; justify-content:center; gap:7px;\n    background:var(--fill); color:var(--acc); }\n  .acts2 button:first-child{ background:var(--acc); color:#fff; }\n  .notice{ display:flex; gap:10px; align-items:flex-start; font-size:14px; line-height:1.45; border-radius:16px; padding:13px 14px; background:var(--surface); border:1px solid var(--line); }\n  .notice svg{ color:#ff9f0a; margin-top:1px; }\n  .notice .b{ flex:1; }\n  .notice button{ margin-top:10px; min-height:40px; border:none; border-radius:11px; padding:0 14px; font-size:14px; font-weight:700; background:var(--fill); color:var(--acc); display:inline-flex; align-items:center; gap:6px; }\n  .hint{ font-size:12.5px; color:var(--muted); text-align:center; margin-top:10px; }\n  [hidden]{ display:none !important; }\n  @media (prefers-reduced-motion:reduce){ .spin{ animation-duration:2.4s; } .skel{ animation:none; } button:active{ transform:none; } }\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-palette\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5a9.5 9.5 0 0 0 0 19c1.5 0 2.3-1 2.3-2.2 0-.6-.2-1-.5-1.4-.3-.4-.5-.8-.5-1.3 0-1 .8-1.8 1.8-1.8h2.2a4.2 4.2 0 0 0 4.2-4.2C21.5 6.1 17.2 2.5 12 2.5zM6.8 12.6a1.6 1.6 0 1 1 0-3.2 1.6 1.6 0 0 1 0 3.2zm2.8-4a1.6 1.6 0 1 1 0-3.2 1.6 1.6 0 0 1 0 3.2zm4.8 0a1.6 1.6 0 1 1 0-3.2 1.6 1.6 0 0 1 0 3.2zm2.8 4a1.6 1.6 0 1 1 0-3.2 1.6 1.6 0 0 1 0 3.2z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-brush\" viewBox=\"0 0 24 24\"><path d=\"M20.3 3.7a1.6 1.6 0 0 0-2.3 0l-8 8 2.3 2.3 8-8a1.6 1.6 0 0 0 0-2.3zM8.9 13.1c-1.9 0-3.4 1.5-3.4 3.4 0 1.2-.8 2.1-2 2.4 1 1.3 2.6 2 4.2 2 2.6 0 4.6-2 4.6-4.6z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-save\" viewBox=\"0 0 24 24\"><path d=\"M12 3a1 1 0 0 1 1 1v9.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-5 5a1 1 0 0 1-1.4 0l-5-5a1 1 0 1 1 1.4-1.4l3.3 3.3V4a1 1 0 0 1 1-1zM4 18a1 1 0 0 1 1 1v.5h14V19a1 1 0 1 1 2 0v1.5a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V19a1 1 0 0 1 1-1z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-again\" viewBox=\"0 0 24 24\"><path d=\"M12 5V2.6a.6.6 0 0 0-1-.45L7.2 5.55a.6.6 0 0 0 0 .9L11 9.85a.6.6 0 0 0 1-.45V7a5.5 5.5 0 1 1-5.5 5.5 1 1 0 0 0-2 0A7.5 7.5 0 1 0 12 5z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-warn\" viewBox=\"0 0 24 24\"><path d=\"M10.3 3.9a2 2 0 0 1 3.4 0l8 13.6a2 2 0 0 1-1.7 3H4a2 2 0 0 1-1.7-3zM12 9a1 1 0 0 0-1 1v4a1 1 0 0 0 2 0v-4a1 1 0 0 0-1-1zm0 7.2a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z\" fill=\"currentColor\"/></symbol>\n</defs></svg>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-palette\"/></svg></div>\n  <div class=\"ht\"><h1>Colouring Page Maker</h1><p>Printable pages to colour, from a prompt</p></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Colouring Page Maker\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n\n<div class=\"card\">\n  <label for=\"what\">What should it be?</label>\n  <input id=\"what\" placeholder=\"A friendly dinosaur in a jungle\" autocomplete=\"off\" enterkeyhint=\"go\">\n  <div class=\"chips\" id=\"chips\"></div>\n  <button class=\"go\" id=\"goBtn\" type=\"button\"></button>\n</div>\n<div id=\"out\"></div>\n\n<script>\nfunction el(id){return document.getElementById(id)}\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nfunction icon(n){return '<svg class=\"i\"><use href=\"#i-'+n+'\"/></svg>'}\nfunction esc(s){return String(s).replace(/[&<>\"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]})}\nvar lastUrl = null;\nvar IDEAS = [\"a friendly dinosaur\",\"a unicorn in a meadow\",\"a race car\",\"a butterfly garden\",\"a space rocket\",\"an underwater reef\",\"a cosy cottage\",\"a dragon\"];\n\nfunction chips(){\n  var c = el('chips');\n  IDEAS.forEach(function(t){\n    var b=document.createElement('button'); b.type='button'; b.className='chip'; b.textContent=t;\n    b.onclick=function(){ haptic('selection'); el('what').value=t; make(); };\n    c.appendChild(b);\n  });\n}\nfunction goBtn(busy){\n  var b=el('goBtn'); b.disabled=!!busy;\n  b.innerHTML = busy ? '<i class=\"spin\"></i><span>Drawing… about 30 seconds</span>' : icon('brush')+'<span>Make my page</span>';\n}\nfunction notice(msg, retry){\n  el('out').innerHTML='<div class=\"notice\">'+icon('warn')+'<div class=\"b\">'+msg+(retry?'<br><button type=\"button\" id=\"retryB\">'+icon('again')+'Try again</button>':'')+'</div></div>';\n  if(retry) el('retryB').onclick=make;\n}\n\nfunction make(){\n  var what = el('what').value.trim();\n  if(!what){ el('what').focus(); return; }\n  var GEN = window.myllmGenerateImage;\n  if(!GEN){ notice('This app needs the latest MyLLM with <b>Settings → Allow apps to use the AI</b> turned on and an image server configured.'); return; }\n  haptic('light');\n  goBtn(true);\n  el('out').innerHTML='<div class=\"page\"><div class=\"skel\"><div class=\"tile\"><svg class=\"i\"><use href=\"#i-brush\"/></svg></div>Drawing your colouring page…</div></div>';\n  var prompt = 'Black and white line-art colouring book page of '+what+'. Bold clean black outlines on a pure white background, no shading, no grey, no colour, simple and friendly, suitable for a child to colour in.';\n  GEN(prompt, {aspect:'portrait'})\n    .then(function(url){\n      lastUrl = url;\n      var div=document.createElement('div'); div.className='page';\n      div.innerHTML='<div class=\"paper\"><img alt=\"colouring page\"></div><div class=\"acts2\">'+\n        '<button type=\"button\" id=\"saveB\">'+icon('save')+'Save to Photos</button><button type=\"button\" id=\"againB\">'+icon('again')+'Another</button></div>'+\n        '<div class=\"hint\">Save it, then print from Photos.</div>';\n      div.querySelector('img').src=url;\n      el('out').innerHTML=''; el('out').appendChild(div);\n      el('saveB').onclick=savePage; el('againB').onclick=make;\n    })\n    .catch(function(e){ notice(esc(e&&e.message?e.message:'Could not make the page'), true); })\n    .then(function(){ goBtn(false); });\n}\n\nfunction savePage(){\n  if(!lastUrl || !window.myllmSaveImage) return;\n  haptic('success');\n  window.myllmSaveImage(lastUrl).catch(function(){});\n}\n\nel('goBtn').onclick=make;\nel('what').addEventListener('keydown',function(e){ if(e.key==='Enter') make(); });\ngoBtn(false); chips();\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes.\n   The spacer keeps the header clear of the status bar / Dynamic Island. It is\n   live CSS — env(safe-area-inset-top) — not a measured number: the inset is\n   still 0 when the page loads and only grows once MyLLM's bar has gone (v1\n   measured once, so the title sat under the island). If the page's own styles\n   already pad the header down by the inset, the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  /* Does any rule that applies to the header or an ancestor already use the top inset? */\n  function pageHandlesInset(head){\n    var chain = [], n, found = false;\n    for (n = head; n && n.nodeType === 1; n = n.parentElement) chain.push(n);\n    function walk(rules){\n      for (var i = 0; i < rules.length && !found; i++){\n        var r = rules[i];\n        if (r.cssRules && !r.selectorText) { walk(r.cssRules); continue; }\n        if (!r.selectorText || !/safe-area-inset-top/.test(r.cssText) || !/(padding|margin|top)\\s*:/.test(r.cssText)) continue;\n        if (/\\.imm-safe/.test(r.selectorText)) continue;\n        for (var k = 0; k < chain.length; k++){\n          try { if (chain[k].matches(r.selectorText)) { found = true; break; } } catch(e){}\n        }\n      }\n    }\n    for (var s = 0; s < document.styleSheets.length && !found; s++){\n      try { walk(document.styleSheets[s].cssRules); } catch(e){}\n    }\n    for (n = head; n && n.nodeType === 1 && !found; n = n.parentElement){\n      if (/safe-area-inset-top/.test(n.getAttribute(\"style\") || \"\")) found = true;\n    }\n    return found;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = (document.body.classList.contains(\"imm\") && !pageHandlesInset(head)) ? \"env(safe-area-inset-top)\" : \"0px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script></body></html>\n"}