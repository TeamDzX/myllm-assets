{"name": "Colouring Page Maker", "html": "<!doctype html>\n<!--\n  Colouring Page Maker — MyLLMos App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>:root{--build-id:\"57b4b7ca62\";color-scheme:light dark}\n*{box-sizing:border-box}\nbody{font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);margin:0;padding:16px;background:var(--myllm-bg,#f2f2f7);color:var(--myllm-text,#111)}\nh1{font-size:22px;margin:0 0 2px}\n.sub{font-size:13px;color:var(--myllm-muted,#8a8a8e);margin:0 0 14px}\ninput{width:100%;padding:12px;border:1px solid var(--myllm-border,#d1d1d6);border-radius:12px;font-size:16px;background:var(--myllm-surface,#fff);color:var(--myllm-text,#111)}\nbutton.go{width:100%;border:0;background:var(--myllm-accent,#0a84ff);color:#fff;border-radius:12px;padding:13px;font-size:16px;font-weight:700;margin-top:12px}\nbutton.go:disabled{opacity:.5}\n.chips{display:flex;gap:8px;overflow-x:auto;padding:10px 0 4px;-webkit-overflow-scrolling:touch}\n.chip{flex:0 0 auto;background:var(--myllm-surface,#fff);border:1px solid var(--myllm-border,#d1d1d6);color:var(--myllm-text,#111);border-radius:999px;padding:8px 13px;font-size:14px}\n.page{margin-top:16px;background:#fff;border-radius:16px;padding:8px;border:1px solid var(--myllm-border,#e3e3e8)}\n.page img{width:100%;border-radius:10px;display:block}\n.acts{display:flex;gap:8px;margin-top:10px}\n.acts button{flex:1;border:0;border-radius:10px;padding:11px;font-size:14px;font-weight:600;background:rgba(10,132,255,.14);color:var(--myllm-accent,#0a84ff)}\n.note{color:var(--myllm-muted,#8a8a8e);font-size:14px;text-align:center;margin-top:18px;line-height:1.5;padding:0 6px}\n@media(min-width:768px){body{max-width:680px;margin-left:auto;margin-right:auto}}\n</style></head><body>\n<h1>🖍️ Colouring Page Maker</h1>\n<p class=\"sub\">Describe anything and get a printable black-and-white page to colour in.</p>\n<input id=\"what\" placeholder=\"A friendly dinosaur in a jungle\">\n<div class=\"chips\" id=\"chips\"></div>\n<button class=\"go\" id=\"goBtn\" onclick=\"make()\">Make my page</button>\n<div id=\"out\"></div>\n\n<script>\nvar GEN = window.myllmGenerateImage || null;\nvar haptic = window.myllmHaptic || function(){};\nvar lastUrl = null;\nvar IDEAS = [\"a friendly dinosaur\",\"a unicorn in a meadow\",\"a race car\",\"a butterfly garden\",\"a space rocket\",\"an underwater reef\",\"a cosy cottage\",\"a dragon\"];\n\nfunction el(id){return document.getElementById(id)}\n\nfunction chips(){\n  var c = el('chips');\n  IDEAS.forEach(function(t){\n    var b=document.createElement('button'); b.className='chip'; b.textContent=t;\n    b.onclick=function(){ haptic('selection'); el('what').value=t; make(); };\n    c.appendChild(b);\n  });\n}\n\nfunction make(){\n  var what = el('what').value.trim();\n  if(!what){ el('what').focus(); return; }\n  if(!GEN){ el('out').innerHTML='<p class=\"note\">This app needs the latest MyLLM with <b>Settings → Allow apps to use the AI</b> turned on and an image server configured.</p>'; return; }\n  haptic('light');\n  el('goBtn').disabled=true; el('goBtn').textContent='Drawing… (~30s)';\n  el('out').innerHTML='<p class=\"note\">🖍️ Drawing your colouring page…</p>';\n  var prompt = 'Black and white line-art colouring book page of '+what+'. Bold clean black outlines on a pure white background, no shading, no grey, no colour, simple and friendly, suitable for a child to colour in.';\n  GEN(prompt, {aspect:'portrait'})\n    .then(function(url){\n      lastUrl = url;\n      var div=document.createElement('div'); div.className='page';\n      div.innerHTML='<img alt=\"colouring page\"><div class=\"acts\">'+\n        '<button id=\"saveB\">💾 Save to Photos</button><button id=\"againB\">🔄 Another</button></div>';\n      div.querySelector('img').src=url;\n      el('out').innerHTML=''; el('out').appendChild(div);\n      el('saveB').onclick=savePage; el('againB').onclick=make;\n    })\n    .catch(function(e){ el('out').innerHTML='<p class=\"note\">'+(e&&e.message?e.message:'Could not make the page')+'</p>'; })\n    .then(function(){ el('goBtn').disabled=false; el('goBtn').textContent='Make my page'; });\n}\n\nfunction savePage(){\n  if(!lastUrl || !window.myllmSaveImage) return;\n  haptic('success');\n  window.myllmSaveImage(lastUrl).catch(function(){});\n}\n\nchips();\n</script></body></html>\n"}