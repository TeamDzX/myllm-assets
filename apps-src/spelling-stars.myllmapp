{"name": "Spelling Stars", "html": "<!doctype html>\n<!--\n  Spelling Stars — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover\">\n<title>Spelling Stars</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"557463d871\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); --h:264; }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink); min-height:100dvh; font-size:15.5px; line-height:1.4; }\n  body.lock{ overflow:hidden; }\n  .home{ max-width:600px; margin:0 auto;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ .home{ max-width:760px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.96); }\n  [hidden]{ display:none !important; }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 28%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  .head .acts{ display:flex; gap:8px; flex-shrink:0; }\n  h2.sec{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:20px 2px 9px; }\n\n  .hero{ border-radius:20px; padding:16px 18px; color:#fff; margin-bottom:12px; display:flex; align-items:center; gap:16px;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 46%), hsl(calc(var(--h) + 40) 58% 24%)); box-shadow:0 10px 28px hsl(var(--h) 60% 30% / .25); }\n  .hero .n{ font-size:44px; font-weight:800; line-height:1; letter-spacing:-.03em; font-variant-numeric:tabular-nums; flex-shrink:0; }\n  .hero .k{ display:block; font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.78; }\n  .hero b{ display:block; font-size:17px; font-weight:750; line-height:1.25; overflow-wrap:anywhere; }\n  .hero span.s{ display:block; font-size:12.5px; line-height:1.4; opacity:.82; margin-top:3px; overflow-wrap:anywhere; }\n  .hero .grow{ flex:1; min-width:0; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  label{ display:block; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:14px 2px 7px; }\n  label:first-child{ margin-top:0; }\n  input, textarea, select{ width:100%; font:inherit; font-size:16px; padding:12px; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; }\n  input:focus, textarea:focus{ border-color:hsl(var(--h) 60% 55%); }\n  .go{ width:100%; min-height:50px; margin-top:14px; border:none; border-radius:14px; background:hsl(var(--h) 62% 52%); color:#fff; font-size:16px; font-weight:700;\n    display:flex; align-items:center; justify-content:center; gap:8px; box-shadow:0 8px 20px hsl(var(--h) 60% 40% / .25); }\n  .go.soft{ background:var(--fill); color:var(--ink); box-shadow:none; }\n  .go:disabled{ opacity:.55; }\n  .status{ font-size:13px; color:var(--muted); min-height:18px; margin-top:10px; text-align:center; line-height:1.45; }\n  .status.err{ color:#ff453a; }\n  .spin{ width:16px; height:16px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; display:inline-block; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n  .empty{ text-align:center; padding:24px 18px 14px; }\n  .empty .tile{ width:48px; height:48px; border-radius:14px; font-size:21px; margin:0 auto 10px; opacity:.9; }\n  .empty b{ display:block; font-size:16px; font-weight:750; }\n  .empty p{ font-size:13.5px; color:var(--muted); line-height:1.5; max-width:280px; margin:5px auto 0; }\n  @media (prefers-reduced-motion:reduce){ .spin{ animation-duration:2.4s; } button:active{ transform:none; } }\n  /* ---------- the full-screen stage ---------- */\n  .stage{ display:none; position:fixed; inset:0; z-index:50; color:#fff; }\n  .stage.on{ display:block; }\n  .bg{ position:absolute; inset:0; transition:opacity .6s ease; }\n  .bg.d{ background:radial-gradient(120% 90% at 20% 10%, hsl(var(--h) 64% 34%), transparent 60%),\n      radial-gradient(120% 90% at 85% 95%, hsl(calc(var(--h) + 60) 60% 26%), transparent 62%), #0b0b10; }\n  .bg.l{ opacity:0; background:radial-gradient(120% 90% at 20% 0%, hsl(var(--h) 85% 88%), transparent 60%),\n      radial-gradient(120% 90% at 85% 100%, hsl(calc(var(--h) + 60) 80% 88%), transparent 62%), #f4f4f8; }\n  .lite{ color:#15151a; } .lite .bg.l{ opacity:1; } .lite .bg.d{ opacity:0; }\n  .col{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; overflow-y:auto; -webkit-overflow-scrolling:touch;\n    padding:calc(10px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(16px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  .top{ width:100%; max-width:560px; height:44px; display:flex; align-items:center; justify-content:space-between; gap:8px; flex-shrink:0; }\n  .glass{ border:1px solid rgba(255,255,255,.16); background:rgba(255,255,255,.12); color:inherit;\n    -webkit-backdrop-filter:blur(18px); backdrop-filter:blur(18px); }\n  .lite .glass{ border-color:rgba(0,0,0,.09); background:rgba(255,255,255,.62); }\n  .rnd{ width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:15px; flex-shrink:0; }\n  .pill{ min-width:44px; height:44px; border-radius:99px; padding:0 15px; display:flex; align-items:center; justify-content:center; gap:5px;\n    font-size:17px; font-weight:800; font-variant-numeric:tabular-nums; }\n  .pill small{ font-size:10.5px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; opacity:.7; }\n  .pill.hide{ visibility:hidden; }\n  .dots{ display:flex; gap:6px; align-items:center; flex-wrap:wrap; justify-content:center; }\n  .dots i{ width:8px; height:8px; border-radius:50%; background:currentColor; opacity:.22; transition:all .3s; }\n  .dots i.now{ opacity:1; transform:scale(1.35); } .dots i.ok{ opacity:1; background:#34c759; } .dots i.no{ opacity:1; background:#ff6259; }\n  .body{ flex:1 0 auto; width:100%; max-width:560px; display:flex; flex-direction:column; gap:12px; padding:12px 0 4px;\n    transition:opacity .3s, filter .3s; }\n  /* centred when there's room, top-aligned when there isn't: two growing spacers\n     instead of justify-content:center, which pushes tall content up under the bar */\n  .body::before, .body::after{ content:\"\"; flex:1 1 0; }\n  .veil .body{ opacity:.3; filter:blur(7px); pointer-events:none; }\n  .kick{ font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; opacity:.62; }\n  .pri{ width:100%; height:54px; border:none; border-radius:99px; font-size:16.5px; font-weight:750; background:#fff; color:#0b0b10;\n    box-shadow:0 10px 30px rgba(0,0,0,.3); display:flex; align-items:center; justify-content:center; gap:8px; flex-shrink:0; }\n  .lite .pri{ background:#15151a; color:#fff; box-shadow:0 10px 26px rgba(20,20,40,.22); }\n  .pri:disabled{ opacity:.5; }\n  .sec2{ width:100%; height:50px; border-radius:99px; font-size:15.5px; font-weight:750; display:flex; align-items:center; justify-content:center; gap:8px; flex-shrink:0; }\n  .center{ position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); border-radius:26px; padding:24px 20px 18px; text-align:center;\n    width:min(340px, calc(100% - 32px)); max-height:calc(100% - 40px); overflow-y:auto; z-index:5;\n    box-shadow:0 24px 60px rgba(0,0,0,.35); animation:pop .28s cubic-bezier(.2,.8,.2,1) both; }\n  .lite .center{ box-shadow:0 22px 50px rgba(20,20,40,.18); }\n  @keyframes pop{ from{ opacity:0; transform:translate(-50%,-50%) scale(.96); } to{ opacity:1; transform:translate(-50%,-50%); } }\n  .center h2{ font-size:24px; font-weight:800; letter-spacing:-.015em; margin-top:6px; }\n  .center p{ font-size:14px; line-height:1.45; opacity:.76; margin-top:8px; }\n  .center .big{ font-size:64px; font-weight:800; line-height:1.05; letter-spacing:-.03em; font-variant-numeric:tabular-nums; margin-top:4px; }\n  .center .big small{ font-size:.42em; opacity:.55; font-weight:750; }\n  .center .best{ display:inline-block; margin-top:10px; font-size:11.5px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; color:#0b0b10; background:#ffd60a; border-radius:99px; padding:5px 11px; }\n  .center .pri{ margin-top:18px; } .center .sec2{ margin-top:10px; }\n  .stars3{ display:flex; justify-content:center; gap:6px; margin-top:10px; font-size:30px; }\n  .stars3 svg{ width:1em; height:1em; fill:currentColor; opacity:.22; } .stars3 svg.on{ opacity:1; color:#ffd60a; }\n  @media (prefers-reduced-motion:reduce){ .center{ animation:none; } .dots i{ transition:none; } }\n\n  .lvl{ width:100%; display:flex; align-items:center; gap:13px; padding:10px 0; border:none; background:none; border-bottom:1px solid var(--line); text-align:left; }\n  .lvl:first-child{ padding-top:2px; } .lvl:last-child{ border-bottom:none; padding-bottom:2px; }\n  .lvl:active{ transform:none; opacity:.7; }\n  .lvl .tile{ width:46px; height:46px; border-radius:13px; font-size:20px; }\n  .lvl .t{ flex:1; min-width:0; } .lvl .t b{ display:block; font-size:16px; font-weight:700; } .lvl .t small{ display:block; font-size:13px; color:var(--muted); margin-top:1px; }\n  .lvl .bst{ flex-shrink:0; display:flex; align-items:center; gap:4px; font-size:12.5px; font-weight:750; color:#b07d00; background:rgba(255,204,0,.16); border-radius:99px; padding:4px 9px; font-variant-numeric:tabular-nums; }\n  @media (prefers-color-scheme:dark){ .lvl .bst{ color:#ffd60a; } }\n  .lvl .bst svg{ font-size:12px; }\n\n  .back{ display:inline-flex; align-items:center; gap:4px; min-height:40px; border:none; background:none; color:hsl(var(--h) 62% 50%); font-size:15px; font-weight:700; padding:0 6px 0 0; margin:0 0 6px -4px; }\n  @media (prefers-color-scheme:dark){ .back{ color:hsl(var(--h) 80% 74%); } }\n  .erow{ display:flex; gap:8px; }\n  .erow input{ flex:1; -webkit-user-select:text; user-select:text; }\n  .erow button{ flex-shrink:0; border:none; border-radius:12px; padding:0 16px; background:hsl(var(--h) 62% 52%); color:#fff; font-weight:700; display:flex; align-items:center; gap:6px; }\n  .chips{ display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }\n  .chip{ display:flex; align-items:center; gap:2px; background:var(--bg); border:1px solid var(--line); border-radius:99px; padding:0 2px 0 13px; font-size:15px; font-weight:600; min-height:40px; }\n  .chip button{ width:36px; height:36px; border:none; background:none; color:var(--muted); font-size:12px; display:flex; align-items:center; justify-content:center; }\n  .note0{ font-size:13.5px; color:var(--muted); }\n\n  .card2{ border-radius:26px; padding:22px 18px; text-align:center; display:flex; flex-direction:column; align-items:center; gap:14px; }\n  .bigword{ font-size:clamp(38px, 12vw, 56px); font-weight:800; letter-spacing:.06em; line-height:1.15; overflow-wrap:anywhere; }\n  .hear{ min-height:44px; border-radius:99px; padding:0 18px; font-size:15px; font-weight:700; display:inline-flex; align-items:center; gap:8px; }\n  .hear.on svg{ animation:pulse 1s ease-in-out infinite; } @keyframes pulse{ 50%{ opacity:.4; } }\n  .inp{ width:100%; font-size:30px; font-weight:750; text-align:center; letter-spacing:.08em; padding:14px; border-radius:18px;\n    border:2px solid rgba(255,255,255,.28); background:rgba(255,255,255,.1); color:inherit; -webkit-user-select:text; user-select:text; }\n  .lite .inp{ border-color:rgba(20,20,40,.14); background:rgba(255,255,255,.75); }\n  .inp::placeholder{ color:currentColor; opacity:.4; font-weight:600; letter-spacing:.02em; font-size:20px; }\n  .inp:focus{ outline:none; border-color:hsl(var(--h) 80% 70%); }\n  .feedback{ font-size:clamp(34px, 11vw, 50px); font-weight:800; letter-spacing:.08em; overflow-wrap:anywhere; }\n  .feedback .g{ color:#4be07d; } .feedback .r{ color:#ff8a82; text-decoration:underline; text-underline-offset:6px; }\n  .lite .feedback .g{ color:#1c9a4a; } .lite .feedback .r{ color:#d92d20; }\n  .note{ font-size:15px; line-height:1.45; opacity:.85; min-height:20px; }\n  .note b{ font-weight:800; }\n  .row{ display:flex; gap:10px; width:100%; } .row > *{ flex:1; }\n  .ctl{ width:100%; max-width:560px; flex-shrink:0; display:flex; flex-direction:column; gap:10px; padding-top:8px; }\n  .vnote{ display:flex; gap:10px; align-items:flex-start; text-align:left; font-size:13.5px; line-height:1.45; border-radius:16px; padding:11px 13px; }\n  .vnote svg{ color:#ffb340; margin-top:1px; }\n  .shake{ animation:shake .45s ease; }\n  @keyframes shake{ 20%{ transform:translateX(-6px); } 40%{ transform:translateX(5px); } 60%{ transform:translateX(-3px); } 80%{ transform:translateX(2px); } }\n  @media (max-height:520px){ .card2{ padding:14px 16px; gap:10px; } .inp{ font-size:24px; padding:10px; } }\n  @media (prefers-reduced-motion:reduce){ .shake, .hear.on svg{ animation:none; } }\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-abc\" viewBox=\"0 0 24 24\"><text x=\"12\" y=\"16.2\" text-anchor=\"middle\" font-size=\"11.5\" font-weight=\"800\" font-family=\"-apple-system,system-ui,sans-serif\" fill=\"currentColor\">abc</text></symbol>\n  <symbol id=\"i-close\" viewBox=\"0 0 24 24\"><path d=\"M6.4 5a1 1 0 0 0-1.4 1.4L10.6 12 5 17.6A1 1 0 0 0 6.4 19l5.6-5.6 5.6 5.6a1 1 0 0 0 1.4-1.4L13.4 12 19 6.4A1 1 0 0 0 17.6 5L12 10.6z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M5 12.6l4.6 4.6L19.2 7.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-play\" viewBox=\"0 0 24 24\"><path d=\"M8 5.5v13a1 1 0 0 0 1.52.85l10.4-6.5a1 1 0 0 0 0-1.7L9.52 4.65A1 1 0 0 0 8 5.5z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-again\" viewBox=\"0 0 24 24\"><path d=\"M12 5V2.6a.6.6 0 0 0-1-.45L7.2 5.55a.6.6 0 0 0 0 .9L11 9.85a.6.6 0 0 0 1-.45V7a5.5 5.5 0 1 1-5.5 5.5 1 1 0 0 0-2 0A7.5 7.5 0 1 0 12 5z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.8l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 16.8l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-flame\" viewBox=\"0 0 24 24\"><path d=\"M12.6 2.4c.3 3-1.3 4.6-2.8 6.1C8.4 9.9 7 11.4 7 14a5 5 0 0 0 10 0c0-1.6-.6-2.9-1.3-3.9-.2 1.2-.9 2.2-2 2.6.6-3.3-.3-7.7-1.1-10.3zM12 21.5A7 7 0 0 1 5 14.5c0-3.4 1.9-5.3 3.4-6.8C9.9 6.2 11 5 10.7 2.3A1 1 0 0 1 12 1.2c3.6 1.6 7 6.4 7 13.3a7 7 0 0 1-7 7z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-speaker\" viewBox=\"0 0 24 24\"><path d=\"M11 4.6a.9.9 0 0 1 1.5.7v13.4a.9.9 0 0 1-1.5.7L6.6 15.6H4a1 1 0 0 1-1-1V9.4a1 1 0 0 1 1-1h2.6z\" fill=\"currentColor\"/><path d=\"M15.6 8.6a4.6 4.6 0 0 1 0 6.8M18.4 5.9a8.6 8.6 0 0 1 0 12.2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-chevl\" viewBox=\"0 0 24 24\"><path d=\"M14.5 5.5L8 12l6.5 6.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-plus\" viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-sprout\" viewBox=\"0 0 24 24\"><path d=\"M11 21v-7.1C7.2 13.6 4.5 11 4.5 7V5.8a.8.8 0 0 1 .8-.8C9 5 11.5 7.5 12 10.6 12.8 7.9 15.2 6 18.7 6a.8.8 0 0 1 .8.8V8c0 3.7-2.7 6.2-6.5 6.4V21a1 1 0 0 1-2 0z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-book\" viewBox=\"0 0 24 24\"><path d=\"M4 5.5A2.5 2.5 0 0 1 6.5 3H19a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H6.5a.5.5 0 0 0 0 1H19a1 1 0 0 1 0 2H6.5A2.5 2.5 0 0 1 4 18.5z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-bookopen\" viewBox=\"0 0 24 24\"><path d=\"M2.5 5.2a1 1 0 0 1 1-1c3 0 5.4.6 7.5 2v13.3c-2.1-1.2-4.5-1.8-7.5-1.8a1 1 0 0 1-1-1zm19 0v11.5a1 1 0 0 1-1 1c-3 0-5.4.6-7.5 1.8V6.2c2.1-1.4 4.5-2 7.5-2a1 1 0 0 1 1 1z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-cap\" viewBox=\"0 0 24 24\"><path d=\"M11.5 3.6a1.2 1.2 0 0 1 1 0l10 4.6a.8.8 0 0 1 0 1.5l-10 4.6a1.2 1.2 0 0 1-1 0l-10-4.6a.8.8 0 0 1 0-1.5zM5.5 12.6l5.6 2.6a2.2 2.2 0 0 0 1.8 0l5.6-2.6v3.6c0 1.8-3 3.6-6.5 3.6s-6.5-1.8-6.5-3.6zM21 10.4v5.4a1 1 0 0 1-2 0v-4.5z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-pen\" viewBox=\"0 0 24 24\"><path d=\"M15.2 4.3a2.2 2.2 0 0 1 3.1 0l1.4 1.4a2.2 2.2 0 0 1 0 3.1L9.4 19.1 4 20l.9-5.4z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-warn\" viewBox=\"0 0 24 24\"><path d=\"M10.3 3.9a2 2 0 0 1 3.4 0l8 13.6a2 2 0 0 1-1.7 3H4a2 2 0 0 1-1.7-3zM12 9a1 1 0 0 0-1 1v4a1 1 0 0 0 2 0v-4a1 1 0 0 0-1-1zm0 7.2a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z\" fill=\"currentColor\"/></symbol>\n</defs></svg>\n<div class=\"home\" id=\"home\">\n  <div class=\"imm-safe\"></div><div class=\"head\">\n    <div class=\"tile\"><svg class=\"i\"><use href=\"#i-abc\"/></svg></div>\n    <div class=\"ht\"><h1>Spelling Stars</h1><p>Look, cover, write, check</p></div>\n  <div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Spelling Stars\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n  <p style=\"font-size:13.5px;color:var(--muted);margin:-4px 2px 12px\">Look at the word, cover it, write it, then check. Build your spelling, one star at a time.</p>\n  <div class=\"card\" id=\"levels\"></div>\n</div>\n\n<div class=\"home\" id=\"editor\" hidden>\n  <button class=\"back\" type=\"button\" id=\"back\"><svg class=\"i\"><use href=\"#i-chevl\"/></svg>Levels</button>\n  <div class=\"head\">\n    <div class=\"tile\"><svg class=\"i\"><use href=\"#i-pen\"/></svg></div>\n    <div class=\"ht\"><h1>My Words</h1><p>Add this week’s spelling words</p></div>\n  </div>\n  <div class=\"card\">\n    <div class=\"erow\"><input id=\"newword\" placeholder=\"type a word\" autocorrect=\"off\" autocapitalize=\"off\" spellcheck=\"false\" enterkeyhint=\"done\"><button type=\"button\" id=\"addw\"><svg class=\"i\"><use href=\"#i-plus\"/></svg>Add</button></div>\n    <div class=\"chips\" id=\"chips\"></div>\n    <button class=\"go\" type=\"button\" id=\"practise\"><svg class=\"i\"><use href=\"#i-play\"/></svg>Practise these</button>\n  </div>\n</div>\n\n<div class=\"stage\" id=\"stage\">\n  <div class=\"bg d\"></div><div class=\"bg l\"></div>\n  <div class=\"col\" id=\"col\">\n    <div class=\"top\">\n      <button class=\"glass rnd\" id=\"bClose\" type=\"button\" aria-label=\"Pause\"><svg class=\"i\"><use href=\"#i-close\"/></svg></button>\n      <div class=\"dots\" id=\"dots\"></div>\n      <div class=\"glass pill hide\" id=\"streak\"></div>\n    </div>\n    <div class=\"body\" id=\"mid\"></div>\n    <div class=\"ctl\" id=\"controls\"></div>\n    <div class=\"center glass\" id=\"card\" hidden></div>\n  </div>\n</div>\n\n<script>\nfunction el(i){return document.getElementById(i)}\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction store(){return window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}}}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nfunction icon(n){return '<svg class=\"i\"><use href=\"#i-'+n+'\"/></svg>'}\nfunction esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]})}\n/* The quiz takes the whole display. Where MyLLM can't hide its own title\n   bar, a dark stage under a white bar looks cut in half — so in light mode,\n   without myllmImmersive, the stage stays light. */\nvar stageOn=false;\nfunction isLight(){return !(window.matchMedia&&matchMedia('(prefers-color-scheme: dark)').matches)}\nfunction syncLook(){el('stage').classList.toggle('lite',isLight()&&!window.myllmImmersive)}\nfunction syncChrome(){\n  if(!window.myllmImmersive)return;\n  try{myllmImmersive((window.myllmClose ? true : (stageOn)), {keepAwake:false}).catch(function(){})}catch(_){}\n}\nfunction openStage(){if(stageOn)return;stageOn=true;syncLook();el('stage').classList.add('on');document.body.classList.add('lock');syncChrome()}\nfunction closeStage(){if(!stageOn)return;stageOn=false;el('stage').classList.remove('on','veil');document.body.classList.remove('lock');syncChrome()}\nif(window.matchMedia){var mq=matchMedia('(prefers-color-scheme: dark)');if(mq.addEventListener)mq.addEventListener('change',syncLook);else if(mq.addListener)mq.addListener(syncLook)}\nvar LEVELS=[\n {ic:'sprout',t:'Beginner',d:'First words & sight words',\n  w:['cat','dog','sun','run','big','red','box','you','and','the','was','for','play','jump','like','went','said','they','here','help','look','some','come','make','that','this']},\n {ic:'book',t:'Year 3–4',d:'Everyday words',\n  w:['because','friend','before','animal','school','family','people','water','money','morning','should','enough','answer','length','popular','remember','perhaps','special','thought','through','various','straight']},\n {ic:'bookopen',t:'Year 5–6',d:'Trickier spellings',\n  w:['separate','believe','special','different','important','question','sentence','favourite','beautiful','knowledge','necessary','probably','occasion','sincerely','definite','immediately','experience','available','community','accidentally']},\n {ic:'cap',t:'Middle School',d:'Challenge words',\n  w:['necessary','definitely','embarrass','rhythm','conscience','accommodate','occurrence','parliament','vocabulary','achievement','environment','recommend','privilege','perseverance','exaggerate','questionnaire','maintenance','noticeable','restaurant','government']},\n {ic:'pen',t:'My Words',d:'Add your own spelling list',custom:true,w:[]}\n];\nvar best={},myWords=[];\nvar lvl=0,words=[],idx=0,correct=0,streak=0,phase='look',target='',results=[],paused=false;\n\n/* ---------- speech ----------\n   The web view's own speechSynthesis (MyLLM has no speak bridge). Same\n   approach as Language Lab: pick an English voice explicitly, only cancel\n   when something is actually speaking (cancel-then-speak in the same tick can\n   swallow the new word), and say plainly when no voice played. */\nfunction canSpeak(){return !!(window.speechSynthesis&&window.SpeechSynthesisUtterance)}\nvar voiceCache={},speakToken=0,speakBtn=null;\nif(canSpeak())try{speechSynthesis.onvoiceschanged=function(){voiceCache={}}}catch(e){}\n/* The word lists use British spellings; an English-speaking phone keeps its own accent. */\nfunction langCode(){var l=String(navigator.language||'');return /^en/i.test(l)?l:'en-GB'}\nfunction pickVoice(code){\n  if(voiceCache[code]!==undefined)return voiceCache[code];\n  var all=[];try{all=speechSynthesis.getVoices()||[]}catch(e){}\n  function norm(v){return String(v.lang||'').replace('_','-').toLowerCase()}\n  var want=code.toLowerCase(),base=want.slice(0,2);\n  var inLang=all.filter(function(v){return norm(v).slice(0,2)===base});\n  var better=function(list){return list.filter(function(v){return /enhanced|premium/i.test(v.name)})[0]||list[0]};\n  var exact=inLang.filter(function(v){return norm(v)===want});\n  voiceCache[code]=better(exact)||better(inLang)||null;\n  return voiceCache[code];\n}\nfunction markSpeaking(btn,on){\n  if(speakBtn&&speakBtn!==btn)speakBtn.classList.remove('on');\n  if(btn)btn.classList.toggle('on',on);\n  speakBtn=on?btn:null;\n}\nfunction noVoice(){\n  var n=el('vnote');if(!n)return;\n  n.hidden=false;\n}\nfunction speak(text,btn){\n  if(!canSpeak()||!text)return;\n  var ss=window.speechSynthesis,token=++speakToken,started=false;\n  var u=new SpeechSynthesisUtterance(text),code=langCode();\n  u.lang=code;var v=pickVoice(code);if(v)u.voice=v;\n  u.rate=.85;u.volume=1;\n  u.onstart=function(){started=true;if(token===speakToken){markSpeaking(btn,true);var n=el('vnote');if(n)n.hidden=true}};\n  u.onend=function(){if(token===speakToken)markSpeaking(btn,false)};\n  u.onerror=function(e){\n    if(token!==speakToken)return;\n    markSpeaking(btn,false);\n    var why=e&&e.error;\n    if(!started&&why!=='interrupted'&&why!=='canceled')noVoice();\n  };\n  function go(){try{if(ss.paused)ss.resume();ss.speak(u)}catch(e){noVoice()}}\n  try{\n    if(ss.speaking||ss.pending){ss.cancel();setTimeout(go,80)}\n    else go();                                   /* first word stays inside the tap, which iOS requires */\n  }catch(e){noVoice();return}\n  setTimeout(function(){\n    if(token===speakToken&&!started&&!ss.speaking){markSpeaking(btn,false);noVoice()}\n  },2500);\n}\nfunction stopSpeaking(){speakToken++;markSpeaking(null,false);if(canSpeak())try{speechSynthesis.cancel()}catch(e){}}\n\n/* ---------- home ---------- */\nfunction renderHome(){\n  var L=el('levels');L.innerHTML='';\n  LEVELS.forEach(function(lv,i){\n    var b=document.createElement('button');b.type='button';b.className='lvl';\n    var bs=best['s'+i]?('<span class=\"bst\">'+icon('star')+best['s'+i]+'</span>'):'';\n    var count=lv.custom?(myWords.length+' words'):(lv.w.length+' words');\n    b.innerHTML='<div class=\"tile\">'+icon(lv.ic)+'</div><div class=\"t\"><b>'+esc(lv.t)+'</b><small>'+esc(lv.d)+' · '+count+'</small></div>'+bs;\n    b.onclick=function(){lv.custom?openEditor():startSet(i)};\n    L.appendChild(b);\n  });\n}\nfunction showHome(){el('editor').hidden=true;el('home').hidden=false;renderHome()}\nfunction shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t}return a}\n\n/* ---------- a round ---------- */\nfunction showCard(html){var c=el('card');c.innerHTML=html;c.hidden=false;el('stage').classList.add('veil')}\nfunction hideCard(){el('card').hidden=true;el('stage').classList.remove('veil')}\nfunction startSet(i){\n  lvl=i;var pool=LEVELS[i].custom?myWords:LEVELS[i].w;\n  if(!pool.length)return;\n  words=shuffle(pool).slice(0,Math.min(10,pool.length));\n  idx=0;correct=0;streak=0;results=[];paused=false;\n  hideCard();openStage();haptic('light');loadWord();\n}\nfunction renderTop(){\n  el('dots').innerHTML=words.map(function(_,i){return '<i class=\"'+(i<results.length?(results[i]?'ok':'no'):i===idx?'now':'')+'\"></i>'}).join('');\n  var s=el('streak');s.classList.toggle('hide',streak<2);s.innerHTML=icon('flame')+streak;\n}\nvar VNOTE='<div class=\"vnote glass\" id=\"vnote\" hidden><svg class=\"i\"><use href=\"#i-warn\"/></svg><span>Couldn’t play the word out loud. Check the volume, or add a voice in iPhone Settings → Accessibility → Spoken Content → Voices.</span></div>';\nfunction hearBtn(label){return canSpeak()?'<button class=\"hear glass\" type=\"button\" id=\"hear\">'+icon('speaker')+'<span>'+label+'</span></button>':''}\nfunction wireHear(){if(canSpeak())el('hear').onclick=function(){speak(target,el('hear'))}}\nfunction loadWord(){\n  target=words[idx];phase='look';\n  renderTop();\n  el('mid').innerHTML='<div class=\"card2 glass\"><div class=\"kick\">Look</div><div class=\"bigword\">'+esc(target)+'</div>'+hearBtn('Hear it')+'</div>'+VNOTE;\n  wireHear();\n  el('controls').innerHTML='<button class=\"pri\" type=\"button\" id=\"cover\">'+icon('pen')+'Cover &amp; spell</button>';\n  el('cover').onclick=writePhase;\n  speak(target,canSpeak()?el('hear'):null);\n}\nfunction writePhase(){\n  phase='write';\n  el('mid').innerHTML='<div class=\"card2 glass\"><div class=\"kick\">Write</div>'+hearBtn('Hear it again')+\n    '<input class=\"inp\" id=\"answer\" autocomplete=\"off\" autocorrect=\"off\" autocapitalize=\"off\" spellcheck=\"false\" placeholder=\"type the word\" enterkeyhint=\"done\"></div>'+VNOTE;\n  wireHear();\n  el('controls').innerHTML='<button class=\"pri\" type=\"button\" id=\"check\">'+icon('check')+'Check</button>';\n  el('check').onclick=check;\n  var inp=el('answer');inp.addEventListener('keydown',function(e){if(e.key==='Enter')check()});\n  setTimeout(function(){inp.focus()},80);\n}\nfunction check(){\n  var typed=(el('answer').value||'').trim();\n  if(!typed){el('answer').focus();return}\n  var ok=typed.toLowerCase()===target.toLowerCase();\n  // letter-by-letter feedback against the correct word\n  var fb='';for(var i=0;i<target.length;i++){var c=esc(target[i]);var good=typed[i]&&typed[i].toLowerCase()===target[i].toLowerCase();fb+='<span class=\"'+(good?'g':'r')+'\">'+c+'</span>'}\n  phase='check';\n  if(ok){correct++;streak++;haptic('success')}else{streak=0;haptic('error')}\n  results[idx]=ok;renderTop();\n  el('mid').innerHTML='<div class=\"card2 glass'+(ok?'':' shake')+'\"><div class=\"kick\">'+(ok?'Perfect':'Check')+'</div><div class=\"feedback\">'+fb+'</div>'+\n    '<div class=\"note\">'+(ok?'Well spelt!':'You wrote “<b>'+esc(typed)+'</b>”. The correct spelling is above.')+'</div></div>';\n  if(ok){el('controls').innerHTML='<button class=\"pri\" type=\"button\" id=\"next\">Next word</button>';el('next').onclick=advance;}\n  else{el('controls').innerHTML='<div class=\"row\"><button class=\"sec2 glass\" type=\"button\" id=\"retry\">'+icon('again')+'Try again</button><button class=\"pri\" type=\"button\" id=\"next\">Next word</button></div>';\n    el('retry').onclick=function(){results.length=idx;renderTop();writePhase()};el('next').onclick=advance;}\n}\nfunction advance(){idx++;if(idx>=words.length)finish();else loadWord()}\nfunction finish(){\n  stopSpeaking();\n  var pct=words.length?correct/words.length:0;\n  var n=pct>=1?3:pct>=0.7?2:pct>=0.4?1:0;\n  var key='s'+lvl,isBest=!best[key]||correct>best[key];\n  if(isBest&&words.length){best[key]=correct;store().setItem('ss_best',JSON.stringify(best))}\n  haptic(pct>=0.7?'success':'warning');\n  var stars='';for(var i=0;i<3;i++)stars+='<svg class=\"'+(i<n?'on':'')+'\"><use href=\"#i-star\"/></svg>';\n  el('mid').innerHTML='';el('controls').innerHTML='';\n  showCard('<div class=\"kick\">'+esc(LEVELS[lvl].t)+' spelt</div><div class=\"stars3\">'+stars+'</div><div class=\"big\">'+correct+'<small>/'+words.length+'</small></div>'+\n    (isBest&&words.length?'<div class=\"best\">New best</div>':'')+\n    '<button class=\"pri\" type=\"button\" id=\"cA\">'+icon('again')+'Practise again</button><button class=\"sec2 glass\" type=\"button\" id=\"cB\">Back to levels</button>');\n  el('cA').onclick=function(){startSet(lvl)};\n  el('cB').onclick=goHome;\n}\nfunction pause(){\n  if(!stageOn||!el('card').hidden)return;\n  paused=true;stopSpeaking();\n  showCard('<div class=\"kick\">Paused</div><h2>'+esc(LEVELS[lvl].t)+'</h2><p>Word '+(idx+1)+' of '+words.length+' · '+correct+' right so far</p>'+\n    '<button class=\"pri\" type=\"button\" id=\"cA\">'+icon('play')+'Keep going</button><button class=\"sec2 glass\" type=\"button\" id=\"cB\">Stop practising</button>');\n  el('cA').onclick=function(){paused=false;hideCard();haptic('light')};\n  el('cB').onclick=goHome;\n}\nfunction goHome(){paused=false;stopSpeaking();hideCard();closeStage();showHome();haptic('light')}\n\n// ---- custom word editor ----\nfunction openEditor(){el('home').hidden=true;el('editor').hidden=false;renderChips();window.scrollTo(0,0)}\nfunction addWord(){var v=(el('newword').value||'').trim();if(!v)return;if(myWords.indexOf(v)<0){myWords.push(v);persistWords()}el('newword').value='';el('newword').focus();renderChips();haptic('light')}\nfunction removeWord(w){myWords=myWords.filter(function(x){return x!==w});persistWords();renderChips()}\nfunction renderChips(){\n  var C=el('chips');\n  C.innerHTML=myWords.length?myWords.map(function(w){return '<span class=\"chip\">'+esc(w)+'<button type=\"button\" aria-label=\"Remove '+esc(w)+'\" data-w=\"'+esc(w)+'\">'+icon('x')+'</button></span>'}).join(''):'<div class=\"note0\">No words yet — add some above.</div>';\n  Array.prototype.forEach.call(C.querySelectorAll('button'),function(b){b.onclick=function(){removeWord(b.getAttribute('data-w'))}});\n  el('practise').disabled=!myWords.length;\n}\nfunction persistWords(){store().setItem('ss_mywords',JSON.stringify(myWords))}\n\nel('addw').onclick=addWord;\nel('newword').addEventListener('keydown',function(e){if(e.key==='Enter')addWord()});\nel('practise').onclick=function(){if(myWords.length){lvl=4;startSet(4)}};\nel('back').onclick=showHome;\nel('bClose').onclick=function(){haptic('light');pause()};\ndocument.addEventListener('visibilitychange',function(){\n  if(document.hidden){pause();return}\n  if(stageOn)syncChrome();          /* MyLLM puts its bars back when the app is left */\n});\n\nrenderHome();\nPromise.all([store().getItem('ss_best'),store().getItem('ss_mywords')]).then(function(r){\n  if(r[0]){try{best=JSON.parse(r[0])||{}}catch(e){}}\n  if(r[1]){try{myWords=JSON.parse(r[1])||[]}catch(e){}}\n  renderHome();\n});\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes.\n   The spacer keeps the header clear of the status bar / Dynamic Island. It is\n   live CSS — env(safe-area-inset-top) — not a measured number: the inset is\n   still 0 when the page loads and only grows once MyLLM's bar has gone (v1\n   measured once, so the title sat under the island). If the page's own styles\n   already pad the header down by the inset, the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  /* Does any rule that applies to the header or an ancestor already use the top inset? */\n  function pageHandlesInset(head){\n    var chain = [], n, found = false;\n    for (n = head; n && n.nodeType === 1; n = n.parentElement) chain.push(n);\n    function walk(rules){\n      for (var i = 0; i < rules.length && !found; i++){\n        var r = rules[i];\n        if (r.cssRules && !r.selectorText) { walk(r.cssRules); continue; }\n        if (!r.selectorText || !/safe-area-inset-top/.test(r.cssText) || !/(padding|margin|top)\\s*:/.test(r.cssText)) continue;\n        if (/\\.imm-safe/.test(r.selectorText)) continue;\n        for (var k = 0; k < chain.length; k++){\n          try { if (chain[k].matches(r.selectorText)) { found = true; break; } } catch(e){}\n        }\n      }\n    }\n    for (var s = 0; s < document.styleSheets.length && !found; s++){\n      try { walk(document.styleSheets[s].cssRules); } catch(e){}\n    }\n    for (n = head; n && n.nodeType === 1 && !found; n = n.parentElement){\n      if (/safe-area-inset-top/.test(n.getAttribute(\"style\") || \"\")) found = true;\n    }\n    return found;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = (document.body.classList.contains(\"imm\") && !pageHandlesInset(head)) ? \"env(safe-area-inset-top)\" : \"0px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script></body></html>\n", "kind": "html", "iconSymbol": "textformat.abc", "iconColor": "purple"}