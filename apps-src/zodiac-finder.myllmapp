{"name": "Zodiac Finder", "html": "<!doctype html>\n<!--\n  Zodiac Finder — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Zodiac Finder</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"275499756d\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); --h:282; }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:760px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  svg.z{ width:1.5em; height:1.5em; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.96); }\n  [hidden]{ display:none !important; }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 28%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  @media (max-width:360px){ h1{ font-size:20px; } }\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:18px 2px 10px; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  label{ display:block; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:0 2px 7px; }\n  input, select{ width:100%; font:inherit; font-size:16px; padding:12px; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; }\n  input:focus, select:focus{ border-color:var(--acc); }\n  select{ -webkit-appearance:none; appearance:none; padding-right:36px;\n    background-image:linear-gradient(45deg, transparent 50%, var(--muted) 50%), linear-gradient(135deg, var(--muted) 50%, transparent 50%);\n    background-position:calc(100% - 18px) 55%, calc(100% - 13px) 55%; background-size:5px 5px; background-repeat:no-repeat; }\n  .go{ min-height:50px; border:none; border-radius:14px; background:var(--acc); color:#fff; font-size:16px; font-weight:700;\n    display:flex; align-items:center; justify-content:center; gap:8px; padding:0 18px; }\n  .go.wide{ width:100%; margin-top:12px; }\n  .go:disabled{ opacity:.55; }\n  .status{ font-size:13px; color:var(--muted); min-height:18px; margin:8px 2px 0; text-align:center; }\n  .status.err{ color:#ff453a; }\n  .spin{ width:16px; height:16px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n\n  /* the night-sky hero: the app's hue over deep space, a scatter of fixed\n     stars, and a second, fainter layer that breathes very slowly */\n  .sky{ position:relative; overflow:hidden; border-radius:20px; padding:18px; color:#fff; margin-bottom:12px; isolation:isolate;\n    background:radial-gradient(120% 90% at 12% 0%, hsl(var(--h) 62% 34%), transparent 62%),\n      radial-gradient(110% 90% at 100% 100%, hsl(calc(var(--h) + 45) 55% 26%), transparent 60%),\n      linear-gradient(160deg, #0e1133, #070918 70%);\n    box-shadow:0 12px 30px hsl(var(--h) 50% 18% / .3); }\n  .sky::before, .sky::after{ content:\"\"; position:absolute; inset:0; pointer-events:none; z-index:-1; }\n  .sky::before{ background:radial-gradient(1px 1px at 22% 54%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 12% 72%, #fff 50%, transparent 51%),radial-gradient(1.5px 1.5px at 77% 11%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 30% 8%, #fff 50%, transparent 51%),radial-gradient(1.5px 1.5px at 56% 12%, #fff 50%, transparent 51%),radial-gradient(1.5px 1.5px at 73% 58%, #fff 50%, transparent 51%),radial-gradient(1.5px 1.5px at 75% 19%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 83% 84%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 10% 77%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 9% 32%, #fff 50%, transparent 51%),radial-gradient(1.5px 1.5px at 20% 41%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 72% 19%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 74% 91%, #fff 50%, transparent 51%),radial-gradient(1.5px 1.5px at 77% 77%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 50% 16%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 11% 76%, #fff 50%, transparent 51%); opacity:.85; }\n  .sky::after{ background:radial-gradient(1px 1px at 69% 19%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 53% 48%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 40% 78%, #fff 50%, transparent 51%),radial-gradient(1.5px 1.5px at 36% 17%, #fff 50%, transparent 51%),radial-gradient(1.5px 1.5px at 44% 38%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 44% 43%, #fff 50%, transparent 51%),radial-gradient(1.5px 1.5px at 82% 29%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 28% 18%, #fff 50%, transparent 51%); opacity:.5; animation:twinkle 7s ease-in-out infinite alternate; }\n  @keyframes twinkle{ from{ opacity:.18; } to{ opacity:.75; } }\n  .sky .k{ font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.72; }\n  .glass{ border:1px solid rgba(255,255,255,.2); background:rgba(255,255,255,.14); color:#fff;\n    -webkit-backdrop-filter:blur(14px); backdrop-filter:blur(14px); }\n  .gbtn{ min-height:48px; border-radius:14px; padding:0 16px; font-size:15.5px; font-weight:750; display:flex; align-items:center; justify-content:center; gap:8px; width:100%; }\n  .gbtn.solid{ border:none; background:#fff; color:#0d1030; box-shadow:0 8px 22px rgba(0,0,0,.28); }\n  .gbtn:disabled{ opacity:.6; }\n\n  /* zodiac tiles: stroke glyphs, never the emoji-prone Unicode symbols */\n  .zt{ display:flex; align-items:center; justify-content:center; flex-shrink:0; border-radius:13px; width:44px; height:44px; font-size:17px; color:#fff;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 52%), hsl(calc(var(--h) + 40) 58% 30%)); }\n  .sky .zt{ background:rgba(255,255,255,.14); border:1px solid rgba(255,255,255,.22); }\n  .zt.big{ width:68px; height:68px; border-radius:20px; font-size:27px; }\n\n  @media (prefers-reduced-motion:reduce){ .sky::after{ animation:none; } .spin{ animation-duration:2.4s; } button:active{ transform:none; } }\n\n  @keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n  .myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n  .myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n  .myllm-ai-cog{width:16px;height:16px;border-radius:50%;border:2.4px solid #a78bfa;border-right-color:transparent;animation:myllmAiSpin .9s linear infinite;flex-shrink:0}\n  .myllm-ai-busy small{font-weight:400;opacity:.6}\n\n  .row{ display:flex; gap:8px; }\n  .row input{ flex:1; min-width:0; }\n  .row .go{ flex-shrink:0; }\n  .sky.res{ text-align:center; padding:22px 18px 20px; }\n  .sky.res .zt{ margin:4px auto 10px; }\n  .sky.res .nm{ font-size:28px; font-weight:800; letter-spacing:-.02em; line-height:1.1; }\n  .sky.res .dt{ font-size:13.5px; opacity:.75; margin-top:3px; }\n  .badge{ display:inline-flex; align-items:center; gap:6px; margin-top:12px; padding:5px 12px; border-radius:99px; font-size:12.5px; font-weight:800; color:#fff; letter-spacing:.02em; }\n  .badge i{ width:8px; height:8px; border-radius:50%; background:#fff; opacity:.9; }\n  .sky.res .t{ font-size:15.5px; line-height:1.55; margin:14px auto 0; max-width:420px; }\n  .kw{ display:flex; flex-wrap:wrap; gap:6px; justify-content:center; margin-top:14px; }\n  .kw span{ font-size:12.5px; font-weight:700; padding:5px 11px; border-radius:99px; }\n  .empty{ text-align:center; padding:22px 16px 18px; }\n  .empty .zrow{ display:flex; justify-content:center; gap:10px; color:hsl(var(--h) 60% 55%); font-size:13px; opacity:.8; flex-wrap:wrap; }\n  .empty b{ display:block; font-size:16px; font-weight:750; margin-top:12px; }\n  .empty p{ font-size:13.5px; color:var(--muted); margin-top:4px; }\n  @media (max-width:340px){ .row{ flex-direction:column; } .row .go{ width:100%; } }\n  @media (max-height:520px) and (min-width:600px){ body{ max-width:none; display:grid; grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr); column-gap:22px; align-items:start; }\n    .head{ grid-column:1 / -1; } .left{ grid-column:1; } .right{ grid-column:2; } }\n\n/* myllm-fullscreen-v1 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"z-aries\" viewBox=\"0 0 24 24\"><path d=\"M5 9.5C5 6.5 6.8 4.5 9 4.5s3 2.2 3 5V20M19 9.5c0-3-1.8-5-4-5s-3 2.2-3 5\"/></symbol>\n  <symbol id=\"z-taurus\" viewBox=\"0 0 24 24\"><path d=\"M5 4.5c1 3.2 3.6 5.3 7 5.3s6-2.1 7-5.3M17 14.8a5 5 0 1 1-10 0 5 5 0 0 1 10 0z\"/></symbol>\n  <symbol id=\"z-gemini\" viewBox=\"0 0 24 24\"><path d=\"M5 4.5c4.5 1.4 9.5 1.4 14 0M5 19.5c4.5-1.4 9.5-1.4 14 0M9 5.5v13M15 5.5v13\"/></symbol>\n  <symbol id=\"z-cancer\" viewBox=\"0 0 24 24\"><path d=\"M9.2 9A2.2 2.2 0 1 1 4.8 9a2.2 2.2 0 0 1 4.4 0zM7 6.8C10 4.6 16 5 19.2 8.2M19.2 15a2.2 2.2 0 1 1-4.4 0 2.2 2.2 0 0 1 4.4 0zM17 17.2c-3 2.2-9 1.8-12.2-1.4\"/></symbol>\n  <symbol id=\"z-leo\" viewBox=\"0 0 24 24\"><path d=\"M10.8 15a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM10.6 13.2C9.6 8.6 11.2 4.5 14.6 4.5s4.6 3 3 6.6c-1.3 3-2.7 5.4-.9 7.8 1.2 1.6 3.3 1.1 3.3 1.1\"/></symbol>\n  <symbol id=\"z-virgo\" viewBox=\"0 0 24 24\"><path d=\"M4 7.5c1.2 0 2 .8 2 2V18M6 10c0-2 1-3 2.5-3S11 8 11 10v8M11 10c0-2 1-3 2.5-3S16 8 16 10v6.5c0 1.8 1.2 3.2 3.2 3.5M16 14c1-1.8 4-2.2 4-.2 0 1.8-2.6 3.8-5.6 6.2\"/></symbol>\n  <symbol id=\"z-libra\" viewBox=\"0 0 24 24\"><path d=\"M4 19.5h16M4 15.5h5.2a3.8 3.8 0 1 1 5.6 0H20\"/></symbol>\n  <symbol id=\"z-scorpio\" viewBox=\"0 0 24 24\"><path d=\"M4 7.5c1.2 0 2 .8 2 2V17M6 10c0-2 1-3 2.5-3S11 8 11 10v7M11 10c0-2 1-3 2.5-3S16 8 16 10v7c0 1.6 1 2.5 2.6 2.5H20.5M18.6 17.6l2 1.9-2 1.9\"/></symbol>\n  <symbol id=\"z-sagittarius\" viewBox=\"0 0 24 24\"><path d=\"M5 19L19 5M12 5h7v7M7.5 11.5l5 5\"/></symbol>\n  <symbol id=\"z-capricorn\" viewBox=\"0 0 24 24\"><path d=\"M4 6.5c2 0 3 2 3.5 4L10 18l3.5-10.5C14 6 15 5 16 5s2 1 2 2.5V14.5M20.3 16.8a2.3 2.3 0 1 1-4.6 0 2.3 2.3 0 0 1 4.6 0zM15.7 17c0 1.8-1.3 3-3.2 3.4\"/></symbol>\n  <symbol id=\"z-aquarius\" viewBox=\"0 0 24 24\"><path d=\"M3 10.5l3-3 3 3 3-3 3 3 3-3 3 3M3 17l3-3 3 3 3-3 3 3 3-3 3 3\"/></symbol>\n  <symbol id=\"z-pisces\" viewBox=\"0 0 24 24\"><path d=\"M6 4c3.2 3.6 3.2 12.4 0 16M18 4c-3.2 3.6-3.2 12.4 0 16M4.5 12h15\"/></symbol>\n  <symbol id=\"i-spark\" viewBox=\"0 0 24 24\"><path d=\"M10 2.5l1.9 5.6 5.6 1.9-5.6 1.9L10 17.5l-1.9-5.6L2.5 10l5.6-1.9zM18.5 14l.95 2.55L22 17.5l-2.55.95L18.5 21l-.95-2.55L15 17.5l2.55-.95z\" fill=\"currentColor\"/></symbol>\n</defs></svg>\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-spark\"/></svg></div>\n  <div class=\"ht\"><h1>Zodiac Finder</h1><p>Your birthday, your star sign and traits</p></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Zodiac Finder\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n<div class=\"left\">\n<div class=\"card\">\n  <label for=\"dob\">Your birthday</label>\n  <div class=\"row\"><input id=\"dob\" type=\"date\" aria-label=\"your birthday\"><button class=\"go\" type=\"button\" onclick=\"find()\">Find my sign</button></div>\n  <div id=\"status\" class=\"status\" hidden></div>\n</div>\n</div>\n<div class=\"right\">\n<div class=\"card empty\" id=\"empty\">\n  <div class=\"zrow\" id=\"zrow\"></div>\n  <b>Your sign appears here</b>\n  <p>Works offline — nothing leaves your phone.</p>\n</div>\n<div class=\"sky res\" id=\"card\" hidden></div>\n</div>\n<script>\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction store(){return window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}}}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nfunction zg(name){return '<svg class=\"z\"><use href=\"#z-'+String(name).toLowerCase()+'\"/></svg>'}\nfunction icon(n){return '<svg class=\"i\"><use href=\"#i-'+n+'\"/></svg>'}\nvar EL={Fire:'#ff453a',Earth:'#30d158',Air:'#32ade6',Water:'#0a84ff'};\nvar DATA={\n Aries:{s:'♈',el:'Fire',d:'Mar 21 – Apr 19',t:'Bold, energetic and brave — a natural pioneer who dives in headfirst.',k:'Confident · Driven · Spontaneous'},\n Taurus:{s:'♉',el:'Earth',d:'Apr 20 – May 20',t:'Steady, patient and loyal, with a love of comfort and life’s good things.',k:'Reliable · Grounded · Sensual'},\n Gemini:{s:'♊',el:'Air',d:'May 21 – Jun 20',t:'Curious, witty and sociable — a quick mind that loves to talk and learn.',k:'Adaptable · Clever · Expressive'},\n Cancer:{s:'♋',el:'Water',d:'Jun 21 – Jul 22',t:'Caring, intuitive and protective, deeply tuned to home and feelings.',k:'Nurturing · Loyal · Sensitive'},\n Leo:{s:'♌',el:'Fire',d:'Jul 23 – Aug 22',t:'Warm, generous and confident — born to shine and lead with heart.',k:'Charismatic · Proud · Creative'},\n Virgo:{s:'♍',el:'Earth',d:'Aug 23 – Sep 22',t:'Practical, precise and helpful, with a sharp eye for detail.',k:'Analytical · Kind · Diligent'},\n Libra:{s:'♎',el:'Air',d:'Sep 23 – Oct 22',t:'Charming, fair and sociable — a lover of balance, beauty and harmony.',k:'Diplomatic · Romantic · Easygoing'},\n Scorpio:{s:'♏',el:'Water',d:'Oct 23 – Nov 21',t:'Intense, passionate and determined, with deep emotional currents.',k:'Magnetic · Loyal · Fearless'},\n Sagittarius:{s:'♐',el:'Fire',d:'Nov 22 – Dec 21',t:'Adventurous, optimistic and free-spirited — always chasing the horizon.',k:'Bold · Honest · Curious'},\n Capricorn:{s:'♑',el:'Earth',d:'Dec 22 – Jan 19',t:'Ambitious, disciplined and patient — a steady climber who plays the long game.',k:'Driven · Responsible · Wise'},\n Aquarius:{s:'♒',el:'Air',d:'Jan 20 – Feb 18',t:'Original, independent and humane — an inventive thinker ahead of the curve.',k:'Visionary · Free · Friendly'},\n Pisces:{s:'♓',el:'Water',d:'Feb 19 – Mar 20',t:'Dreamy, compassionate and artistic, with a rich imagination and a big heart.',k:'Empathic · Creative · Gentle'}};\nvar EARLY=['Capricorn','Aquarius','Pisces','Aries','Taurus','Gemini','Cancer','Leo','Virgo','Libra','Scorpio','Sagittarius'];\nvar LATE =['Aquarius','Pisces','Aries','Taurus','Gemini','Cancer','Leo','Virgo','Libra','Scorpio','Sagittarius','Capricorn'];\nvar LAST =[19,18,20,19,20,20,22,22,22,22,21,21];\nfunction el(i){return document.getElementById(i)}\nfunction sunSign(m,d){return d<=LAST[m-1]?EARLY[m-1]:LATE[m-1]}\n\nfunction find(){\n  var v=el('dob').value;\n  if(!v){el('status').hidden=false;el('status').textContent='Pick your birthday first.';el('status').classList.add('err');return}\n  el('status').hidden=true;el('status').textContent='';store().setItem('dob',v);\n  var parts=v.split('-');var m=+parts[1],d=+parts[2];\n  var name=sunSign(m,d),s=DATA[name],col=EL[s.el];\n  var c=el('card');\n  c.innerHTML='<div class=\"k\">Your sun sign</div><div class=\"zt big\">'+zg(name)+'</div><div class=\"nm\">'+name+'</div>'+\n    '<div class=\"dt\">'+s.d+'</div>'+\n    '<span class=\"badge\" style=\"background:'+col+'\"><i></i>'+s.el+' sign</span>'+\n    '<div class=\"t\">'+s.t+'</div><div class=\"kw\">'+s.k.split(' · ').map(function(w){return '<span class=\"glass\">'+w+'</span>'}).join('')+'</div>';\n  c.hidden=false;el('empty').hidden=true;\n  haptic('success');\n}\nel('zrow').innerHTML=['Aries','Leo','Libra','Pisces'].map(zg).join('');\nel('dob').addEventListener('change',find);\nstore().getItem('dob').then(function(v){if(v){el('dob').value=v;find()}});\n\n/* myllm-fullscreen-v1 — full screen where MyLLM can also close the app for us (myllmClose,\n   5.6.2+): full screen hides MyLLM's Done, and a page with no way out is\n   worse than a repeated title, so elsewhere nothing changes. The spacer keeps\n   the header clear of the status bar only if the page doesn't already. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  function inset(){\n    var p = document.createElement(\"div\");\n    p.style.cssText = \"position:fixed;top:0;left:0;width:1px;visibility:hidden;height:env(safe-area-inset-top)\";\n    document.body.appendChild(p); var h = p.offsetHeight; p.parentNode.removeChild(p); return h;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = \"0px\";\n    if (!document.body.classList.contains(\"imm\")) return;\n    var need = inset() + 6 - (head.getBoundingClientRect().top + window.scrollY);\n    sp.style.height = Math.max(0, Math.round(need)) + \"px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  window.addEventListener(\"resize\", fit);\n  sync();\n})();\n</script></body></html>\n", "kind": "html", "iconSymbol": "sparkles", "iconColor": "purple"}