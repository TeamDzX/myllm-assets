code function.\n\n  return qrcode;\n}();\n\n// multibyte support\n!function() {\n\n  qrcode.stringToBytesFuncs['UTF-8'] = function(s) {\n    // http://stackoverflow.com/questions/18729405/how-to-convert-utf8-string-to-byte-array\n    function toUTF8Array(str) {\n      var utf8 = [];\n      for (var i=0; i < str.length; i++) {\n        var charcode = str.charCodeAt(i);\n        if (charcode < 0x80) utf8.push(charcode);\n        else if (charcode < 0x800) {\n          utf8.push(0xc0 | (charcode >> 6),\n              0x80 | (charcode & 0x3f));\n        }\n        else if (charcode < 0xd800 || charcode >= 0xe000) {\n          utf8.push(0xe0 | (charcode >> 12),\n              0x80 | ((charcode>>6) & 0x3f),\n              0x80 | (charcode & 0x3f));\n        }\n        // surrogate pair\n        else {\n          i++;\n          // UTF-16 encodes 0x10000-0x10FFFF by\n          // subtracting 0x10000 and splitting the\n          // 20 bits of 0x0-0xFFFFF into two halves\n          charcode = 0x10000 + (((charcode & 0x3ff)<<10)\n            | (str.charCodeAt(i) & 0x3ff));\n          utf8.push(0xf0 | (charcode >>18),\n              0x80 | ((charcode>>12) & 0x3f),\n              0x80 | ((charcode>>6) & 0x3f),\n              0x80 | (charcode & 0x3f));\n        }\n      }\n      return utf8;\n    }\n    return toUTF8Array(s);\n  };\n\n}();\n\n(function (factory) {\n  if (typeof define === 'function' && define.amd) {\n      define([], factory);\n  } else if (typeof exports === 'object') {\n      module.exports = factory();\n  }\n}(function () {\n    return qrcode;\n}));\n\n</script>\n<script>\n'use strict';\nvar $=function(i){return document.getElementById(i)};\nvar OLC=window.OpenLocationCode;\nvar PP={fix:null,addr:'',addrAt:null,locality:'',shortCode:'',target:null,heading:null,headingSrc:'',dms:false,places:[],recents:[],watching:false,emoji:'📍',editing:null,lastDeleted:null,geoOk:true};\nvar STORE='pinpoint.v1';\nvar EMOJI=['📍','🚗','⛺','🏠','🚪','🎪','🅿️','🏖️','⛰️','🍽️','🎒','⭐'];\nvar TINT=['#dbeafe','#dcfce7','#fef3c7','#fce7f3','#ede9fe','#cffafe','#fee2e2','#e0e7ff','#f1f5f9','#ffedd5','#d1fae5','#fef9c3'];\n\n/* ---------- Storage ---------- */\nfunction save(){\n  var d=JSON.stringify({places:PP.places,recents:PP.recents.slice(0,8),dms:PP.dms});\n  try{ if(window.myllmStorage){ myllmStorage.setItem(STORE,d); return; } }catch(e){}\n  try{ localStorage.setItem(STORE,d); }catch(e){}\n}\nfunction load(done){\n  function apply(v){ if(v){ try{ var d=JSON.parse(v);\n    if(Array.isArray(d.places))PP.places=d.places.filter(function(p){return p&&isFinite(p.lat)&&isFinite(p.lon)});\n    if(Array.isArray(d.recents))PP.recents=d.recents.filter(function(r){return r&&r.code});\n    PP.dms=!!d.dms; }catch(e){} } done(); }\n  try{ if(window.myllmStorage){ myllmStorage.getItem(STORE).then(apply,function(){apply(null)}); return; } }catch(e){}\n  var v=null; try{ v=localStorage.getItem(STORE); }catch(e){} apply(v);\n}\n\n/* ---------- Helpers ---------- */\nfunction haptic(s){ try{ if(window.myllmHaptic)myllmHaptic(s||'light'); }catch(e){} }\nvar tt;\nfunction toast(msg,undo){\n  $('toastMsg').textContent=msg; var b=$('toastBtn'); b.hidden=!undo; b.onclick=undo?function(){undo();hideToast();}:null;\n  $('toast').classList.add('on'); clearTimeout(tt); tt=setTimeout(hideToast,undo?5000:1800);\n}\nfunction hideToast(){ $('toast').classList.remove('on'); }\nfunction esc(s){ return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]}); }\nfunction codeHTML(code){\n  var i=code.indexOf('+'); if(i<0)return esc(code);\n  var head=code.slice(0,i), tail=code.slice(i+1);\n  var area=head.length>4?head.slice(0,head.length-4):'', local=head.slice(area.length);\n  return (area?'<span class=\"area\">'+esc(area)+'</span>':'')+esc(local)+'<span class=\"plus\">+</span>'+esc(tail);\n}\nfunction toRad(d){return d*Math.PI/180}\nfunction distance(a,b,c,d){ // metres, haversine\n  var R=6371008.8, p1=toRad(a), p2=toRad(c), dp=toRad(c-a), dl=toRad(d-b);\n  var h=Math.sin(dp/2)*Math.sin(dp/2)+Math.cos(p1)*Math.cos(p2)*Math.sin(dl/2)*Math.sin(dl/2);\n  return 2*R*Math.asin(Math.min(1,Math.sqrt(h)));\n}\nfunction bearing(a,b,c,d){\n  var p1=toRad(a),p2=toRad(c),dl=toRad(d-b);\n  var y=Math.sin(dl)*Math.cos(p2), x=Math.cos(p1)*Math.sin(p2)-Math.sin(p1)*Math.cos(p2)*Math.cos(dl);\n  return (Math.atan2(y,x)*180/Math.PI+360)%360;\n}\nvar DIRS=['north','north-east','east','south-east','south','south-west','west','north-west'];\nfunction dirName(b){ return DIRS[Math.round(b/45)%8]; }\nfunction fmtDist(m){\n  if(m<1)return 'Here';\n  if(m<1000)return Math.round(m)+' m';\n  if(m<10000)return (m/1000).toFixed(1)+' km';\n  return Math.round(m/1000).toLocaleString('en-GB')+' km';\n}\nfunction dec(lat,lon){ return lat.toFixed(5)+', '+lon.toFixed(5); }\nfunction dmsOne(v,pos,neg){ var a=Math.abs(v), d=Math.floor(a), mf=(a-d)*60, m=Math.floor(mf), s=((mf-m)*60).toFixed(1); if(s==='60.0'){s='0.0';m++;} if(m===60){m=0;d++;}\n  return d+'°'+m+'′'+s+'″'+(v>=0?pos:neg); }\nfunction dms(lat,lon){ return dmsOne(lat,'N','S')+' '+dmsOne(lon,'E','W'); }\nfunction prettyLL(lat,lon){ return lat.toFixed(5)+'° '+(lat>=0?'N':'S')+', '+Math.abs(lon).toFixed(5)+'° '+(lon>=0?'E':'W'); }\nvar PH={'2':'Two','3':'Three','4':'Four','5':'Five','6':'Six','7':'Seven','8':'Eight','9':'Nine','C':'Charlie','F':'Foxtrot','G':'Golf','H':'Hotel','J':'Juliett','M':'Mike','P':'Papa','Q':'Quebec','R':'Romeo','V':'Victor','W':'Whiskey','X':'X-ray','+':'plus'};\nfunction phonetic(code){ return code.split('').map(function(c){return PH[c]||c}).join(' · '); }\nfunction mapsURL(lat,lon,label){ return 'https://maps.apple.com/?ll='+lat.toFixed(6)+','+lon.toFixed(6)+'&q='+encodeURIComponent(label); }\nfunction plusURL(code){ return 'https://plus.codes/'+code; }\nfunction shareText(code,lat,lon,shortForm,title,acc){\n  var lines=[(title||'My location')+': '+code+(shortForm?' ('+shortForm+')':'')];\n  lines.push(plusURL(code));\n  lines.push('Apple Maps: '+mapsURL(lat,lon,code));\n  if(acc!=null&&isFinite(acc)&&acc>0)lines.push('Accurate to about '+Math.round(acc)+' m');\n  return lines.join('\\n');\n}\nfunction share(text){\n  haptic('light');\n  if(window.myllmShare){ Promise.resolve(myllmShare(text)).catch(function(){ copyText(text); }); }\n  else copyText(text);\n}\nfunction copyText(s){\n  var ok=false;\n  try{ var ta=document.createElement('textarea'); ta.value=s; ta.setAttribute('readonly',''); ta.style.position='fixed'; ta.style.opacity='0';\n    document.body.appendChild(ta); ta.select(); ta.setSelectionRange(0,s.length); ok=document.execCommand('copy'); document.body.removeChild(ta); }catch(e){}\n  if(!ok&&navigator.clipboard&&navigator.clipboard.writeText){ navigator.clipboard.writeText(s).then(function(){toast('Copied')},function(){toast('Copy not available')}); return; }\n  toast(ok?'Copied':'Copy not available');\n}\n\n/* ---------- Topographic backdrop (decorative, seeded by the code) ---------- */\nfunction drawTopo(seed){\n  var svg=$('topo'), w=400, h=240, s=0; for(var i=0;i<seed.length;i++)s=(s*31+seed.charCodeAt(i))>>>0;\n  function rnd(){ s=(s*1664525+1013904223)>>>0; return s/4294967296; }\n  var cx=w*(.55+rnd()*.35), cy=h*(.2+rnd()*.5), out='';\n  for(var r=1;r<=9;r++){\n    var pts=[], n=28, base=22*r;\n    for(var k=0;k<=n;k++){ var a=k/n*Math.PI*2, wob=1+.18*Math.sin(a*3+r*.7+rnd()*.25)+.08*Math.sin(a*5+r); pts.push([cx+Math.cos(a)*base*wob*1.35, cy+Math.sin(a)*base*wob]); }\n    out+='<path d=\"M'+pts.map(function(p){return p[0].toFixed(1)+' '+p[1].toFixed(1)}).join(' L')+'Z\"/>';\n  }\n  svg.setAttribute('viewBox','0 0 '+w+' '+h); svg.innerHTML=out;\n}\n\n/* ---------- Location ---------- */\nfunction hasLoc(){ return !!(window.myllmLocation&&typeof myllmLocation.current==='function'); }\nfunction onFix(f){\n  if(!f||f.error){ if(f&&f.error)locError(f.error); return; }\n  if(!isFinite(f.latitude)||!isFinite(f.longitude))return;\n  var prev=PP.fix;\n  PP.fix={lat:f.latitude,lon:f.longitude,acc:f.accuracy,alt:isFinite(f.altitude)?f.altitude:null,course:f.course,speed:f.speed,t:f.timestamp||Date.now()};\n  if(f.address&&typeof f.address==='string'){ PP.addrAt={lat:f.latitude,lon:f.longitude}; setAddress(f.address); }\n  // movement-based heading when walking and no compass\n  if(PP.headingSrc!=='compass'&&isFinite(f.course)&&f.course>=0&&isFinite(f.speed)&&f.speed>1){ PP.heading=f.course; PP.headingSrc='course'; }\n  $('stateBox').innerHTML='';\n  if(!PP.addrAt||distance(PP.addrAt.lat,PP.addrAt.lon,f.latitude,f.longitude)>40)lookupAddress(f.latitude,f.longitude);\n  renderHere(); renderFind(); renderPlaces();\n  if(!prev)haptic('success');\n}\nfunction locError(msg){\n  var m=String(msg||'');\n  var denied=/denied|not allowed|permission|allow|off|disabled|restricted|settings/i.test(m);\n  if(PP.fix)return; // keep the last good fix on screen\n  $('code').className='code wait'; $('code').textContent=denied?'Location is off':'No location yet';\n  $('pulse').className='pulse off'; $('acc').textContent=denied?'Location off':'No signal';\n  $('stateBox').innerHTML='<div class=\"state\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0C18.5 15.4 12 21 12 21z\"/><path d=\"M4 4l16 16\"/></svg>'+\n    '<h2>'+(denied?'Pinpoint needs your location':'Can’t find you yet')+'</h2>'+\n    '<p>'+(denied?'In MyLLM, allow location for apps (Settings → MyLLMos Apps → Location), and allow MyLLM to use your location in the iPhone’s Settings → Privacy → Location Services.':'Step outside or near a window; GPS needs a view of the sky. '+esc(m))+'</p>'+\n    '<button id=\"retryLoc\">Try again</button></div>';\n  var b=$('retryLoc'); if(b)b.onclick=function(){ haptic('light'); startLocation(true); };\n}\nfunction startLocation(force){\n  if(!hasLoc()){\n    if(navigator.geolocation&&!PP.triedWeb){ PP.triedWeb=true;\n      try{ navigator.geolocation.watchPosition(function(p){ onFix({latitude:p.coords.latitude,longitude:p.coords.longitude,accuracy:p.coords.accuracy,altitude:p.coords.altitude,timestamp:p.timestamp}); },\n        function(){ noBridge(); },{enableHighAccuracy:true,maximumAge:5000,timeout:20000}); return; }catch(e){}\n    }\n    return noBridge();\n  }\n  myllmLocation.current({accuracy:'best'}).then(onFix,function(e){ locError(e&&e.message); });\n  if(typeof myllmLocation.watch==='function'&&(!PP.watching||force)){\n    PP.watching=true;\n    myllmLocation.watch(onFix,{accuracy:'best',distanceFilter:2}).catch(function(e){ PP.watching=false; locError(e&&e.message); });\n  }\n}\nfunction stopLocation(){ if(PP.watching&&hasLoc()&&typeof myllmLocation.stop==='function'){ try{ myllmLocation.stop(); }catch(e){} } PP.watching=false; }\nfunction noBridge(){\n  if(PP.fix)return;\n  $('code').className='code wait'; $('code').textContent='Location unavailable';\n  $('pulse').className='pulse off'; $('acc').textContent='No location';\n  $('stateBox').innerHTML='<div class=\"state\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 8v5M12 16h.01\"/></svg><h2>Location isn’t available here</h2><p>Open Pinpoint in MyLLM on your iPhone to see your own Plus Code. You can still look up codes in Find.</p></div>';\n}\n\n/* Street and town: the phone's own geocoder; OpenStreetMap only as a fallback. */\nfunction lookupAddress(lat,lon){\n  PP.addrAt={lat:lat,lon:lon};\n  var p;\n  if(hasLoc()&&typeof myllmLocation.reverse==='function'){\n    p=myllmLocation.reverse(lat,lon).then(function(r){ return r&&r.address||''; });\n  } else if(window.myllmFetch){\n    PP.usedOSM=true; $('geoCredit').innerHTML='Street names from OpenStreetMap Nominatim, © OpenStreetMap contributors (ODbL).';\n    p=myllmFetch('https://nominatim.openstreetmap.org/reverse?format=jsonv2&zoom=16&lat='+lat+'&lon='+lon,{headers:{Accept:'application/json'}})\n      .then(function(r){ if(!r||!r.ok)throw new Error('lookup failed'); var j=JSON.parse(r.body||'{}'); return j.display_name||''; });\n  } else return;\n  p.then(function(a){ setAddress(a||''); },function(){ renderHere(); });\n}\nfunction setAddress(a){\n  var changed=a!==PP.addr; PP.addr=a; renderHere();\n  if(changed||(PP.fix&&PP.shortFor!==OLC.encode(PP.fix.lat,PP.fix.lon)))computeShort();\n}\n/* The short form (\"GV2F+7X London\") is only offered when the town named\n   really recovers this exact code; otherwise the full code stands alone. */\nfunction localityCandidates(addr){\n  var parts=String(addr||'').split(',').map(function(s){return s.trim()}).filter(Boolean);\n  if(parts.length>=3)parts=parts.slice(1);          // the first part is the street\n  if(parts.length>1)parts=parts.slice(0,-1);        // the last is the country\n  var out=[];\n  parts.forEach(function(p){ if(/\\d/.test(p))return; if(out.indexOf(p)<0)out.push(p); });\n  return out.slice(0,2);\n}\nfunction computeShort(){\n  var f=PP.fix; if(!f||!OLC)return;\n  var full=OLC.encode(f.lat,f.lon);\n  PP.shortCode=''; PP.locality=''; PP.shortFor=full;\n  var cands=localityCandidates(PP.addr); if(!cands.length||!hasLoc()||typeof myllmLocation.search!=='function'){ renderHere(); return; }\n  var chain=Promise.resolve(false);\n  cands.forEach(function(name){\n    chain=chain.then(function(done){ if(done)return true;\n      return myllmLocation.search(name,{limit:1}).then(function(list){\n        var hit=list&&list[0]; if(!hit||!isFinite(hit.latitude))return false;\n        // Always drop exactly the first four characters (\"GV2F+7X London\"):\n        // shorter forms only work very near the town's centre.\n        var sc=full.slice(4);\n        try{ if(OLC.recoverNearest(sc,hit.latitude,hit.longitude)!==full)return false; }catch(e){ return false; }\n        PP.shortCode=sc; PP.locality=name; return true;\n      },function(){ return false; });\n    });\n  });\n  chain.then(function(){ renderHere(); });\n}\n\n/* ---------- Here ---------- */\nfunction fitCode(el,max,min){\n  var size=max; el.style.fontSize=size+'px';\n  while(el.scrollWidth>el.clientWidth+1&&size>min){ size-=1; el.style.fontSize=size+'px'; }\n}\nfunction renderHere(){\n  var f=PP.fix;\n  ['shareBtn','qrBtn','copyBtn','saveBtn'].forEach(function(i){ $(i).disabled=!f; });\n  $('aiBtn').hidden=!(f&&typeof window.myllmAsk==='function');\n  $('coords').hidden=!f;\n  if(!f)return;\n  var full=OLC.encode(f.lat,f.lon);\n  if(PP.drawn!==full.slice(0,8)){ PP.drawn=full.slice(0,8); drawTopo(full.slice(0,8)); }\n  var c=$('code'); c.className='code'; c.innerHTML=codeHTML(full);\n  var land=matchMedia('(orientation:landscape) and (max-height:560px)').matches;\n  fitCode(c,land?36:(innerWidth<=360?36:44),22);\n  $('short').innerHTML=PP.shortCode?esc(PP.shortCode)+' <span class=\"loc\">'+esc(PP.locality)+'</span>':'';\n  $('addr').textContent=PP.addr||'';\n  var acc=f.acc, pl=$('pulse');\n  pl.className='pulse '+(!isFinite(acc)||acc<0?'off':acc<=15?'':acc<=50?'mid':'poor');\n  $('acc').textContent=isFinite(acc)&&acc>=0?'±'+Math.round(acc)+' m':'Accuracy unknown';\n  $('coords').textContent=PP.dms?dms(f.lat,f.lon):prettyLL(f.lat,f.lon);\n  var age=(Date.now()-f.t)/1000;\n  $('fresh').textContent=age<5?'Live':age<60?Math.round(age)+' s ago':age<3600?Math.round(age/60)+' min ago':'Last known';\n}\nsetInterval(function(){ if(PP.fix&&!document.hidden)renderHere(); },5000);\n$('coords').addEventListener('click',function(){ PP.dms=!PP.dms; haptic('light'); save(); renderHere(); });\n$('shareBtn').addEventListener('click',function(){ var f=PP.fix; if(!f)return; var full=OLC.encode(f.lat,f.lon);\n  share(shareText(full,f.lat,f.lon,PP.shortCode?PP.shortCode+' '+PP.locality:'', 'My location',f.acc)); });\n$('copyBtn').addEventListener('click',function(){ var f=PP.fix; if(!f)return; haptic('light'); copyText(OLC.encode(f.lat,f.lon)); });\n$('qrBtn').addEventListener('click',function(){ var f=PP.fix; if(!f)return; openQR(OLC.encode(f.lat,f.lon)); });\n$('saveBtn').addEventListener('click',function(){ if(PP.fix)openPlaceSheet(null,PP.fix.lat,PP.fix.lon,PP.fix.acc); });\n\n/* ---------- AI: describe this spot ---------- */\n$('aiBtn').addEventListener('click',function(){\n  var f=PP.fix; if(!f||typeof window.myllmAsk!=='function')return;\n  var btn=$('aiBtn'); btn.disabled=true; btn.lastChild.textContent='Describing…'; haptic('light');\n  var full=OLC.encode(f.lat,f.lon);\n  var q='In one or two short sentences, describe how a friend could find this exact spot when they get near it. Use only the address and place names given; do not invent landmarks, shops or directions you cannot know.\\n'+\n        'Plus Code: '+full+'\\nCoordinates: '+dec(f.lat,f.lon)+'\\nNearest address: '+(PP.addr||'unknown')+(PP.locality?'\\nTown: '+PP.locality:'');\n  Promise.resolve(myllmAsk(q)).then(function(r){\n    var t=String(r||'').trim(); if(!t)throw new Error('empty');\n    $('aiOut').innerHTML='<div class=\"aibox\">'+esc(t)+'<small>Written by your AI from the address above. Check it before you rely on it.</small></div>';\n  }).catch(function(){ $('aiOut').innerHTML='<div class=\"aibox\">Couldn’t reach your AI just now.<small>Your Plus Code above is all a friend needs.</small></div>'; })\n  .then(function(){ btn.disabled=false; btn.lastChild.textContent='Describe this spot'; });\n});\n\n/* ---------- QR ---------- */\nfunction drawQR(canvas,text){\n  var q=qrcode(0,'M'); q.addData(text); q.make();\n  var n=q.getModuleCount(), quiet=2, cells=n+quiet*2, px=Math.floor(canvas.width/cells), off=Math.floor((canvas.width-px*cells)/2);\n  var g=canvas.getContext('2d'); g.fillStyle='#fff'; g.fillRect(0,0,canvas.width,canvas.height); g.fillStyle='#0b1220';\n  for(var r=0;r<n;r++)for(var c=0;c<n;c++)if(q.isDark(r,c))g.fillRect(off+(c+quiet)*px,off+(r+quiet)*px,px,px);\n  return n;\n}\nfunction openQR(code){\n  drawQR($('qrCanvas'),plusURL(code)); $('qrCap').innerHTML=codeHTML(code); PP.qrCode=code; openSheet('qrSheet'); haptic('light');\n}\n$('qrClose').addEventListener('click',closeSheets);\n$('qrSave').addEventListener('click',function(){\n  var url=$('qrCanvas').toDataURL('image/png');\n  if(window.myllmSaveImage){ Promise.resolve(myllmSaveImage(url)).then(function(){ toast('Saved to Photos'); haptic('success'); },function(e){ toast('Couldn’t save'); }); }\n  else toast('Saving isn’t available here');\n});\n\n/* ---------- Sheets ---------- */\nfunction openSheet(id){ closeSheets(true); $('scrim').classList.add('on'); $(id).classList.add('on'); }\nfunction closeSheets(keepScrim){ document.querySelectorAll('.sheet.on').forEach(function(s){s.classList.remove('on')}); if(keepScrim!==true)$('scrim').classList.remove('on'); }\n$('scrim').addEventListener('click',closeSheets);\n$('aboutBtn').addEventListener('click',function(){ haptic('light'); openSheet('aboutSheet'); });\n$('aboutClose').addEventListener('click',closeSheets);\n\n/* ---------- Saved places ---------- */\nfunction newId(){ return Date.now().toString(36)+Math.random().toString(36).slice(2,6); }\nfunction openPlaceSheet(existing,lat,lon,acc){\n  PP.editing=existing?existing.id:null; PP.pending={lat:lat,lon:lon,acc:acc};\n  PP.emoji=existing?existing.emoji:'📍';\n  $('psTitle').textContent=existing?'Rename this place':'Save this spot';\n  $('psSub').innerHTML=codeHTML(OLC.encode(lat,lon))+(isFinite(acc)&&acc>0?' · ±'+Math.round(acc)+' m':'');\n  $('psName').value=existing?existing.name:'';\n  var row=$('psEmoji'); row.innerHTML='';\n  EMOJI.forEach(function(e){ var b=document.createElement('button'); b.textContent=e; b.className=e===PP.emoji?'on':''; b.setAttribute('aria-label','Icon '+e);\n    b.onclick=function(){ PP.emoji=e; row.querySelectorAll('button').forEach(function(x){x.className=x===b?'on':''}); haptic('light'); }; row.appendChild(b); });\n  openSheet('placeSheet'); setTimeout(function(){ try{ $('psName').focus(); }catch(e){} },300);\n}\n$('psCancel').addEventListener('click',closeSheets);\n$('psOk').addEventListener('click',function(){\n  var name=$('psName').value.trim()||'Saved spot', p=PP.pending; if(!p)return;\n  if(PP.editing){ var ex=PP.places.find(function(x){return x.id===PP.editing}); if(ex){ ex.name=name; ex.emoji=PP.emoji; } }\n  else PP.places.unshift({id:newId(),name:name,emoji:PP.emoji,lat:p.lat,lon:p.lon,acc:isFinite(p.acc)?Math.round(p.acc):null,code:OLC.encode(p.lat,p.lon),t:Date.now()});\n  save(); closeSheets(); renderPlaces(); haptic('success'); toast('Saved “'+name+'”');\n});\n$('addPlace').addEventListener('click',function(){ if(!PP.fix){ toast('Waiting for your location'); return; } openPlaceSheet(null,PP.fix.lat,PP.fix.lon,PP.fix.acc); });\nfunction renderPlaces(){\n  var list=$('placeList');\n  if(!PP.places.length){ list.innerHTML='<div class=\"empty\"><b>No saved places yet</b>Save where you parked, your tent, or the gate you’re meeting at. Pinpoint leads you back, even offline.</div>'; return; }\n  var f=PP.fix, h='<h3>Saved places</h3>';\n  PP.places.forEach(function(p,i){\n    var d=f?distance(f.lat,f.lon,p.lat,p.lon):null;\n    h+='<div class=\"place\" data-id=\"'+esc(p.id)+'\"><div class=\"em\" style=\"background:'+TINT[EMOJI.indexOf(p.emoji)>=0?EMOJI.indexOf(p.emoji):i%TINT.length]+'\">'+esc(p.emoji)+'</div>'+\n       '<div class=\"tx\"><div class=\"nm\">'+esc(p.name)+'</div><div class=\"sb\">'+esc(p.code)+'</div></div>'+\n       (d!=null?'<div class=\"d\">'+fmtDist(d)+'<small>'+dirName(bearing(f.lat,f.lon,p.lat,p.lon))+'</small></div>':'')+\n       '<button class=\"more\" aria-label=\"More for '+esc(p.name)+'\"><svg viewBox=\"0 0 24 24\"><circle cx=\"5\" cy=\"12\" r=\"1.3\"/><circle cx=\"12\" cy=\"12\" r=\"1.3\"/><circle cx=\"19\" cy=\"12\" r=\"1.3\"/></svg></button></div>';\n  });\n  list.innerHTML=h;\n  list.querySelectorAll('.place').forEach(function(el){\n    var p=PP.places.find(function(x){return x.id===el.getAttribute('data-id')});\n    el.querySelector('.more').onclick=function(ev){ ev.stopPropagation(); openActions(p); };\n    el.onclick=function(){ goFind({lat:p.lat,lon:p.lon,code:p.code,label:p.name}); };\n  });\n}\nfunction openActions(p){\n  PP.act=p; $('asTitle').textContent=p.emoji+' '+p.name; $('asSub').innerHTML=codeHTML(p.code)+(p.acc?' · ±'+p.acc+' m':''); openSheet('actSheet');\n}\n$('asCancel').addEventListener('click',closeSheets);\n$('asFind').addEventListener('click',function(){ var p=PP.act; closeSheets(); if(p)goFind({lat:p.lat,lon:p.lon,code:p.code,label:p.name}); });\n$('asShare').addEventListener('click',function(){ var p=PP.act; closeSheets(); if(p)share(shareText(p.code,p.lat,p.lon,'',p.name,p.acc)); });\n$('asDel').addEventListener('click',function(){\n  var p=PP.act; if(!p)return; var idx=PP.places.indexOf(p); if(idx<0)return;\n  PP.places.splice(idx,1); PP.lastDeleted={p:p,idx:idx}; save(); closeSheets(); renderPlaces(); haptic('medium');\n  toast('Deleted “'+p.name+'”',function(){ var d=PP.lastDeleted; if(!d)return; PP.places.splice(Math.min(d.idx,PP.places.length),0,d.p); PP.lastDeleted=null; save(); renderPlaces(); haptic('light'); });\n});\n\n/* ---------- Find ---------- */\nvar CODE_RE=/([23456789CFGHJMPQRVWX]{2,8}\\+[23456789CFGHJMPQRVWX]{0,3})/i;\nfunction fmsg(t,err){ var m=$('fmsg'); m.innerHTML=t; m.className='fmsg'+(err?' err':''); }\nfunction parseInput(raw){\n  var s=String(raw||'').trim(); var m=s.match(CODE_RE); if(!m)return null;\n  var code=m[1].toUpperCase(); var rest=(s.slice(0,m.index)+' '+s.slice(m.index+m[1].length)).replace(/https?:\\/\\/\\S+/g,'').replace(/[,;]+/g,' ').trim();\n  return {code:code,locality:rest};\n}\nfunction resolveCode(raw){\n  if(!OLC)return Promise.reject(new Error('no-lib'));\n  var p=parseInput(raw); if(!p)return Promise.reject(new Error('That doesn’t look like a Plus Code. They look like <b>9C3XGV2F+7X</b> or <b>GV2F+7X London</b>.'));\n  if(OLC.isFull(p.code)){ var a=OLC.decode(p.code); return Promise.resolve({lat:a.latitudeCenter,lon:a.longitudeCenter,code:p.code,label:p.code}); }\n  if(!OLC.isValid(p.code)||!OLC.isShort(p.code))return Promise.reject(new Error('That code isn’t complete. Check it and try again.'));\n  function recoverAt(lat,lon,label){ var full=OLC.recoverNearest(p.code,lat,lon); var a=OLC.decode(full); return {lat:a.latitudeCenter,lon:a.longitudeCenter,code:full,label:label}; }\n  if(p.locality){\n    if(hasLoc()&&typeof myllmLocation.search==='function'){\n      return myllmLocation.search(p.locality,{limit:1}).then(function(list){ var h=list&&list[0]; if(!h||!isFinite(h.latitude))throw new Error('Couldn’t find the town “'+esc(p.locality)+'”.');\n        return recoverAt(h.latitude,h.longitude,p.code+' '+p.locality); });\n    }\n    if(window.myllmFetch){\n      return myllmFetch('https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&q='+encodeURIComponent(p.locality),{headers:{Accept:'application/json'}}).then(function(r){\n        var j=JSON.parse(r&&r.body||'[]'); if(!j[0])throw new Error('Couldn’t find the town “'+esc(p.locality)+'”.');\n        return recoverAt(parseFloat(j[0].lat),parseFloat(j[0].lon),p.code+' '+p.locality); });\n    }\n  }\n  if(PP.fix)return Promise.resolve(recoverAt(PP.fix.lat,PP.fix.lon,p.code));\n  return Promise.reject(new Error('A short code needs its town, like <b>'+esc(p.code)+' London</b>, or your location.'));\n}\nfunction doFind(){\n  var v=$('findIn').value; if(!v.trim())return;\n  fmsg('Finding…'); haptic('light');\n  resolveCode(v).then(function(t){ goFind(t,true); },function(e){ fmsg(e&&e.message&&e.message!=='no-lib'?e.message:'Couldn’t read that code.',true); haptic('error'); });\n}\n$('findGo').addEventListener('click',doFind);\n$('findIn').addEventListener('keydown',function(e){ if(e.key==='Enter'){ e.preventDefault(); $('findIn').blur(); doFind(); } });\nfunction goFind(t,fromInput){\n  PP.target=t;\n  PP.recents=[{code:t.code,label:t.label||t.code,lat:t.lat,lon:t.lon}].concat(PP.recents.filter(function(r){return r.code!==t.code})).slice(0,8); save();\n  if(!fromInput)$('findIn').value=t.label&&t.label!==t.code?t.code:t.code;\n  switchTab('find'); fmsg(''); renderFind(); haptic('success');\n}\nfunction renderFind(){\n  var t=PP.target, res=$('findRes');\n  renderRecents();\n  if(!t){ res.hidden=true; return; }\n  res.hidden=false;\n  $('tgtCode').innerHTML=codeHTML(t.code);\n  $('tgtSub').textContent=(t.label&&t.label!==t.code?t.label+' · ':'')+prettyLL(t.lat,t.lon);\n  var f=PP.fix;\n  if(!f){ $('dist').textContent='—'; $('dir').textContent='Waiting for your location to point the way'; setArrow(null); return; }\n  var d=distance(f.lat,f.lon,t.lat,t.lon), b=bearing(f.lat,f.lon,t.lat,t.lon);\n  $('dist').textContent=fmtDist(d);\n  var hs=PP.heading!=null&&PP.headingSrc;\n  if(d<Math.max(8,(f.acc||0))){ $('dir').textContent='You’re there, within your GPS accuracy'; }\n  else $('dir').textContent=dirName(b)+' · '+Math.round(b)+'°'+(hs?(PP.headingSrc==='compass'?' · arrow follows your compass':' · arrow follows your walking direction'):' · arrow points from north');\n  setArrow(b);\n}\nfunction setArrow(b){\n  var h=(PP.heading!=null&&PP.headingSrc)?PP.heading:0;\n  $('rose').style.transform='rotate('+(-h)+'deg)';\n  $('arrow').style.transform=b==null?'rotate(0deg)':'rotate('+(b-h)+'deg)';\n  $('arrow').style.opacity=b==null?'.25':'1';\n}\nfunction renderRecents(){\n  var r=PP.recents.filter(function(x){return !PP.target||x.code!==PP.target.code}).slice(0,5), box=$('recents');\n  if(!r.length){ box.innerHTML=''; return; }\n  box.innerHTML='<h3>Recent</h3>'+r.map(function(x,i){ return '<button class=\"ritem\" data-i=\"'+i+'\"><div><div class=\"c\">'+esc(x.code)+'</div><div class=\"s\">'+esc(x.label&&x.label!==x.code?x.label:prettyLL(x.lat,x.lon))+'</div></div></button>'; }).join('');\n  box.querySelectorAll('.ritem').forEach(function(b){ b.onclick=function(){ goFind(r[+b.getAttribute('data-i')]); }; });\n}\n$('mapsBtn').addEventListener('click',function(){ var t=PP.target; if(!t)return; haptic('light'); window.open(mapsURL(t.lat,t.lon,t.label||t.code),'_blank'); });\n$('tgtSave').addEventListener('click',function(){ var t=PP.target; if(t)openPlaceSheet(null,t.lat,t.lon,null); });\n$('tgtShare').addEventListener('click',function(){ var t=PP.target; if(t)share(shareText(t.code,t.lat,t.lon,'',t.label&&t.label!==t.code?t.label:'Meet here',null)); });\n\n/* Scan a printed code (the scanner reads text; the code is picked out of it). */\nif(typeof window.myllmScan==='function')$('scanBtn').hidden=false;\n$('scanBtn').addEventListener('click',function(){\n  haptic('light');\n  Promise.resolve(myllmScan()).then(function(text){\n    if(!text){ fmsg('Nothing scanned.'); return; }\n    var p=parseInput(text); if(!p){ fmsg('No Plus Code found in what was scanned.',true); return; }\n    $('findIn').value=p.code+(p.locality?' '+p.locality.split(/\\s+/).slice(0,3).join(' '):''); doFind();\n  },function(){ fmsg('The scanner isn’t available right now.',true); });\n});\n\n/* Compass: iOS gives webkitCompassHeading once motion access is allowed. */\nfunction onOrient(e){\n  var h=null;\n  if(typeof e.webkitCompassHeading==='number'&&isFinite(e.webkitCompassHeading))h=e.webkitCompassHeading;\n  else if(e.absolute&&typeof e.alpha==='number')h=(360-e.alpha)%360;\n  if(h==null)return;\n  PP.heading=h; PP.headingSrc='compass'; $('compassLbl').textContent='Compass on';\n  if(!PP.orientRaf){ PP.orientRaf=requestAnimationFrame(function(){ PP.orientRaf=0; if(PP.target)renderFind(); else setArrow(null); }); }\n}\n$('compassBtn').addEventListener('click',function(){\n  haptic('light');\n  function listen(){ window.addEventListener('deviceorientation',onOrient,true); window.addEventListener('deviceorientationabsolute',onOrient,true);\n    $('compassLbl').textContent='Hold the phone flat…';\n    setTimeout(function(){ if(PP.headingSrc!=='compass'){ $('compassLbl').textContent='No compass here'; fmsg('No compass reading: the arrow points from north, or follows you once you walk.'); } },2500); }\n  try{\n    if(window.DeviceOrientationEvent&&typeof DeviceOrientationEvent.requestPermission==='function'){\n      DeviceOrientationEvent.requestPermission().then(function(r){ if(r==='granted')listen(); else { $('compassLbl').textContent='Compass not allowed'; } },function(){ $('compassLbl').textContent='No compass here'; });\n    } else listen();\n  }catch(e){ $('compassLbl').textContent='No compass here'; }\n});\n\n/* ---------- Emergency card ---------- */\nfunction full(){ return !!(window.myllmClose&&window.myllmImmersive); }\nfunction renderSOS(){\n  var f=PP.fix;\n  if(!f){ $('sosCode').textContent='Finding you…'; $('sosPh').textContent=''; $('sosLL').textContent='—'; $('sosAcc').textContent='—'; $('sosAddr').textContent='—'; $('sosTime').textContent='—'; return; }\n  var code=OLC.encode(f.lat,f.lon), i=code.indexOf('+');\n  $('sosCode').innerHTML='<span class=\"a\">'+esc(code.slice(0,4))+'</span><span class=\"l\" id=\"sosL\">'+esc(code.slice(4,i))+'<span class=\"plus\">+</span>'+esc(code.slice(i+1))+'</span>';\n  var l=$('sosL'), sz=64; l.style.fontSize=sz+'px'; while(l.scrollWidth>l.clientWidth+1&&sz>30){ sz-=2; l.style.fontSize=sz+'px'; }\n  $('sosPh').textContent=phonetic(code);\n  $('sosLL').innerHTML=esc(f.lat.toFixed(5))+'<br>'+esc(f.lon.toFixed(5));\n  $('sosAcc').textContent=isFinite(f.acc)&&f.acc>=0?'± '+Math.round(f.acc)+' m':'Unknown';\n  $('sosAddrRow').style.display=PP.addr?'':'none'; $('sosAddr').textContent=PP.addr||'';\n  $('sosTime').textContent=new Date(f.t).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit',second:'2-digit'});\n}\n$('sosBtn').addEventListener('click',function(){\n  haptic('medium'); renderSOS(); $('sos').classList.add('on'); PP.sosOn=true;\n  try{ if(window.myllmImmersive)myllmImmersive(true,{keepAwake:true}).catch(function(){}); }catch(e){}\n});\n$('sosClose').addEventListener('click',function(){\n  $('sos').classList.remove('on'); PP.sosOn=false; haptic('light');\n  try{ if(window.myllmImmersive)myllmImmersive(full(),{keepAwake:false}).catch(function(){}); }catch(e){}\n});\nsetInterval(function(){ if(PP.sosOn)renderSOS(); },2000);\n\n/* ---------- Tabs ---------- */\nfunction switchTab(id){\n  document.querySelectorAll('.view').forEach(function(v){ v.classList.toggle('on',v.id===id); });\n  document.querySelectorAll('.tabs button').forEach(function(b){ b.classList.toggle('on',b.getAttribute('data-tab')===id); b.setAttribute('aria-selected',b.getAttribute('data-tab')===id); });\n  if(id==='here')renderHere(); if(id==='find')renderFind(); if(id==='saved')renderPlaces();\n}\ndocument.querySelectorAll('.tabs button').forEach(function(b){ b.addEventListener('click',function(){ haptic('light'); switchTab(b.getAttribute('data-tab')); }); });\n\ndocument.addEventListener('visibilitychange',function(){ if(document.hidden)stopLocation(); else startLocation(true); });\naddEventListener('resize',function(){ renderHere(); });\ndrawTopo('PINPOINT');\nload(function(){ renderPlaces(); renderRecents(); startLocation(); if(PP.fix)renderHere(); });\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes. This page\n   pads its own top by env(safe-area-inset-top), so the spacer stays at 0. */\n(function(){\n  function fullOK(){ return !!(window.myllmClose && window.myllmImmersive); }\n  function sync(){\n    var f = fullOK();\n    document.body.classList.toggle(\"imm\", f);\n    var sp = document.querySelector(\".imm-safe\"); if (sp) sp.style.height = \"0px\";\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:!!PP.sosOn }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script></body></html>\n", "kind": "html", "iconSymbol": "mappin.and.ellipse", "iconColor": "green"}