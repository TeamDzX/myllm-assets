{"name": "Mochi", "kind": "html", "iconSymbol": "pawprint.fill", "iconColor": "mint", "html": "<!doctype html>\n<!--\n  Mochi — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover\">\n<title>Mochi</title>\n<style>\n  :root { color-scheme: light; --ink:#3f372e; --muted:#a3947f; --line:#eadfce; --card:#fffdf8; --mint:#7cc9a0; }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  /* No double-tap zoom, no text or image selection on a double tap: it's a toy,\n     tapped a lot. Only the chat field keeps normal selection. */\n  html, body{ touch-action:manipulation; -webkit-user-select:none; user-select:none; -webkit-touch-callout:none; overscroll-behavior:none; }\n  input{ -webkit-user-select:text; user-select:text; }\n  img{ -webkit-user-drag:none; }\n  body{\n    font-family:var(--myllm-font,ui-rounded,-apple-system,system-ui,sans-serif);\n    background:radial-gradient(120% 60% at 50% 0%,#fff6ea 0%,#fbefe0 55%,#f6e7d4 100%);\n    color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh;\n    padding:calc(12px + env(safe-area-inset-top)) calc(14px + env(safe-area-inset-right)) calc(16px + env(safe-area-inset-bottom)) calc(14px + env(safe-area-inset-left));\n    display:flex; flex-direction:column; gap:12px;\n  }\n  .top{ display:flex; align-items:center; justify-content:space-between; padding:2px 4px 0; }\n  .who{ display:flex; flex-direction:column; }\n  h1{ font-size:24px; font-weight:850; letter-spacing:-.2px; }\n  .age{ font-size:12.5px; color:var(--muted); font-weight:700; }\n  .moodchip{ font-size:13px; font-weight:750; color:var(--ink); background:var(--card); border:1.5px solid var(--line);\n             border-radius:99px; padding:7px 12px; box-shadow:0 2px 6px rgba(120,90,50,.06); }\n  .moodchip:empty{ display:none; }\n\n  /* Four round gauges: a ring that empties, the emoji in the middle. */\n  .stats{ display:grid; grid-template-columns:repeat(4,1fr); gap:8px; }\n  .stat{ position:relative; display:flex; flex-direction:column; align-items:center; gap:3px; }\n  .ring{ position:relative; width:54px; height:54px; }\n  .ring svg{ width:100%; height:100%; transform:rotate(-90deg); }\n  .ring .rt{ fill:var(--card); stroke:#f0e5d3; stroke-width:5; }\n  .ring .rf{ fill:none; stroke:var(--mint); stroke-width:5; stroke-linecap:round; stroke-dasharray:113.1; stroke-dashoffset:113.1;\n             transition:stroke-dashoffset .7s cubic-bezier(.3,.8,.3,1), stroke .6s; }\n  .ring .rf.low{ stroke:#f2a65e; } .ring .rf.crit{ stroke:#e8806e; }\n  .stat.crit .ring{ animation:needs 1.6s ease-in-out infinite; }\n  @keyframes needs{ 50%{ transform:scale(1.07); } }\n  .ring .se{ position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-size:22px; }\n  .stat small{ font-size:11px; font-weight:750; color:var(--muted); }\n  .stat small b{ color:var(--ink); font-weight:800; margin-left:2px; }\n  .delta{ position:absolute; top:-4px; left:50%; font-size:13px; font-weight:850; color:#4f9e72; pointer-events:none;\n          animation:dpop 1.3s ease-out forwards; }\n  @keyframes dpop{ 0%{ opacity:0; transform:translate(-10%,6px) scale(.7); } 20%{ opacity:1; transform:translate(-10%,-4px) scale(1.1); } 100%{ opacity:0; transform:translate(-10%,-22px) scale(1); } }\n\n  /* The stage is Mochi's room: a painted backdrop, Mochi sitting on the rug. */\n  .stage{ position:relative; flex:1; min-height:330px; border-radius:30px; overflow:hidden;\n          box-shadow:0 10px 30px rgba(120,90,50,.14), inset 0 0 0 1.5px rgba(255,255,255,.6); }\n  .room{ position:absolute; inset:0; background:#f6e6d6 url(\"https://raw.githubusercontent.com/TeamDzX/myllm-assets/main/apps/mochi/room.jpg\") center 72% / cover no-repeat; }\n  .night{ position:absolute; inset:0; opacity:0; transition:opacity 1.4s ease; pointer-events:none;\n          background:radial-gradient(60% 40% at 50% 88%, rgba(255,210,140,.22), transparent 70%),\n                     linear-gradient(180deg, rgba(28,32,78,.62), rgba(22,22,56,.5)); }\n  .stage.sleeping .night{ opacity:1; }\n  .star{ position:absolute; width:3px; height:3px; border-radius:50%; background:#fff; opacity:0; animation:twinkle 3s ease-in-out infinite; }\n  .stage.sleeping .star{ opacity:.9; }\n  @keyframes twinkle{ 50%{ transform:scale(1.8); opacity:.4; } }\n  .petbox{ position:absolute; left:50%; bottom:4%; transform:translateX(-50%); width:min(64%,300px); }\n  .petbox #pet{ width:100%; height:auto; display:block; cursor:pointer; }\n  .fx{ position:absolute; inset:0; pointer-events:none; overflow:hidden; }\n  .fxp{ position:absolute; font-size:24px; animation:rise 1.7s cubic-bezier(.2,.7,.3,1) forwards; }\n  @keyframes rise{ 0%{ opacity:0; transform:translate(0,0) scale(.6); } 15%{ opacity:1; } 100%{ opacity:0; transform:translate(var(--dx,0px),-150px) scale(1.15) rotate(var(--rot,0deg)); } }\n  /* Accessory overlays are taller than the sprite (extra band above the head so\n     hats aren't clipped) and bottom-aligned, so their pet-region maps 1:1 onto\n     the pet and the surplus sits above it. Placement is baked into each asset.\n     A gentle bob keeps them feeling attached to the breathing pet. */\n  .petbox .acc{ position:absolute; left:0; bottom:0; width:100%; height:auto; pointer-events:none;\n                animation:accbob 2.6s ease-in-out infinite alternate; }\n  @keyframes accbob{ from{ transform:translateY(0); } to{ transform:translateY(-3px); } }\n  .stage.sleeping #pet{ filter:brightness(.9) saturate(.9); }\n  .bubble{\n    position:absolute; top:64px; left:50%; transform:translateX(-50%) translateY(-6px); z-index:3;\n    width:max-content; max-width:84%;\n    box-shadow:0 4px 14px rgba(80,60,40,.12);\n    max-width:88%; background:#fffdf8; border:2px solid #eadfce; border-radius:16px;\n    padding:10px 14px; font-size:14.5px; line-height:1.45; opacity:0;\n    transition:opacity .3s, transform .3s; pointer-events:none;\n  }\n  .bubble.show{ opacity:1; transform:translateX(-50%) translateY(0); animation:bpop .38s cubic-bezier(.34,1.56,.64,1); }\n  @keyframes bpop{ 0%{ transform:translateX(-50%) translateY(6px) scale(.82); } 70%{ transform:translateX(-50%) translateY(-2px) scale(1.04); } 100%{ transform:translateX(-50%) translateY(0) scale(1); } }\n  .bubble.dream.show{ animation:bdrift 5.5s ease-in-out both; }\n  @keyframes bdrift{ 0%{ opacity:0; transform:translateX(-50%) translateY(10px) scale(.85); } 12%{ opacity:1; transform:translateX(-50%) translateY(0) scale(1); } 88%{ opacity:1; transform:translateX(-50%) translateY(-10px) rotate(1.5deg); } 100%{ opacity:0; transform:translateX(-50%) translateY(-18px); } }\n  .bubble::after{\n    content:\"\"; position:absolute; bottom:-9px; left:50%; margin-left:-7px;\n    border:7px solid transparent; border-top-color:#eadfce; border-bottom:none;\n  }\n  .bubble.dream{\n    background:#f4f1fb; border-color:#ddd6f0; border-style:dashed;\n    font-style:italic; color:#7a6f95; border-radius:22px;\n  }\n  .bubble.dream::after{ display:none; }\n  .bubble.dream::before{\n    content:\"\"; position:absolute; bottom:-16px; left:50%; margin-left:-14px;\n    width:10px; height:10px; border-radius:50%; background:#f4f1fb;\n    border:2px dashed #ddd6f0;\n    box-shadow:16px 8px 0 -3px #f4f1fb, 16px 8px 0 -1px #ddd6f0;\n  }\n  /* Centred by margins, sized to its text: a left:50% box only gets half the\n     stage's width and wrapped after a few words. */\n  .hint{ position:absolute; top:12px; left:0; right:0; margin:0 auto; width:max-content; max-width:88%; z-index:2;\n          font-size:12.5px; font-weight:700; color:var(--ink); text-align:center;\n          background:rgba(255,253,248,.88); border-radius:99px; padding:7px 14px; box-shadow:0 2px 8px rgba(80,60,40,.1); }\n  .hint:empty{ display:none; }\n\n  /* Action dock: one colour per thing you can do. */\n  .dock{ display:grid; grid-template-columns:repeat(6,1fr); gap:4px; background:rgba(255,253,248,.92);\n         border:1.5px solid var(--line); border-radius:26px; padding:10px 6px 8px; box-shadow:0 6px 20px rgba(120,90,50,.08); }\n  .act{ border:none; background:none; color:var(--ink); display:flex; flex-direction:column; align-items:center; gap:5px;\n        font-size:11.5px; font-weight:750; font-family:inherit; }\n  .act .ico{ width:48px; height:48px; border-radius:17px; display:flex; align-items:center; justify-content:center; font-size:24px;\n             background:var(--c); box-shadow:inset 0 -3px 0 rgba(0,0,0,.07), 0 2px 6px rgba(0,0,0,.05); transition:transform .12s; }\n  .act:active .ico{ transform:scale(.88); }\n  .act:disabled{ opacity:.38; }\n  .act.feed{ --c:#ffe3c9; } .act.play{ --c:#d7ebff; } .act.bath{ --c:#d3f2ef; }\n  .act.walk{ --c:#e0f3d2; } .act.sleep{ --c:#e4dffb; } .act.style{ --c:#ffdbe7; }\n\n  .chatrow{ display:flex; align-items:center; gap:6px; background:var(--card); border:1.5px solid var(--line);\n            border-radius:99px; padding:5px 5px 5px 16px; box-shadow:0 4px 14px rgba(120,90,50,.06); }\n  .chatrow input{ flex:1; min-width:0; font-size:16px; border:none; background:none; color:var(--ink); outline:none; font-family:inherit; }\n  .chatrow button{ border:none; border-radius:50%; width:40px; height:40px; background:var(--mint); color:#fff; display:flex; align-items:center; justify-content:center; flex:0 0 auto; }\n\n  /* walk mode */\n  .walkview{ position:fixed; inset:0; background:linear-gradient(180deg,#fdf6ec 0%,#f3ecdd 100%); display:none; flex-direction:column; z-index:8; }\n  .walkview.show{ display:flex; }\n  .walkview .sky{ flex:1; }\n  .walkscene{ position:relative; height:62%; overflow:hidden; }\n  .walktrack{ position:absolute; bottom:0; left:0; height:100%; display:flex; width:max-content; animation:scroll 26s linear infinite; }\n  .walktrack img{ height:100%; width:auto; display:block; }\n  .walktrack img.flip{ transform:scaleX(-1); }\n  @keyframes scroll{ from{ transform:translateX(0); } to{ transform:translateX(-50%); } }\n  .walker{ position:absolute; left:50%; bottom:6%; transform:translateX(-50%); width:min(46vw,210px); animation:bob 0.62s ease-in-out infinite alternate; z-index:2; }\n  @keyframes bob{ from{ transform:translateX(-50%) translateY(0) rotate(-1.2deg); } to{ transform:translateX(-50%) translateY(-7px) rotate(1.2deg); } }\n  .walker img{ width:100%; }\n  /* Mochi's walk is a 6x6 sprite sheet stepped by our own clock rather than an\n     animated webp, because a webp's playhead can't be read from JS — and the\n     accessories below have to know exactly which frame is showing. */\n  .walker .pet{ width:100%; aspect-ratio:1/1; background-repeat:no-repeat;\n                background-size:600% 600%; background-position:0% 0%; }\n  .walker .pet.plain{ background-size:100% 100%; background-position:0% 0%; }\n  /* Walk accessories are children of .walker, so they inherit the waddle bob\n     for free. On top of that each one rides the head track (set per frame in\n     JS), which is what stops a hat drifting off the head mid-stride. */\n  .walker .wacc{ position:absolute; left:0; bottom:0; width:100%; height:auto; pointer-events:none;\n     /* pivot = the head centre (210.7, 101.9) in sprite space, expressed in the\n        400x580 overlay: x 210.7/400, y (101.9+180)/580 */\n                 transform-origin:52.7% 48.6%; will-change:transform; }\n  /* A neck item pivots lower down — swinging a bowtie about the head reads wrong. */\n  .walker .wacc.neck{ transform-origin:52.7% 82.8%; }\n  .wbubble-wrap{ position:absolute; top:8px; left:0; right:0; display:flex; justify-content:center; }\n  .critters{ position:absolute; inset:0; overflow:hidden; pointer-events:none; }\n  .critter{ position:absolute; left:-12%; will-change:transform; }\n  .critter span{ display:inline-block; animation:flutter 1.1s ease-in-out infinite alternate; }\n  .critter.back{ z-index:0; filter:saturate(.85) brightness(1.04); }\n  .critter.front{ z-index:3; }\n  @keyframes flutter{ from{ transform:translateY(0) rotate(-6deg); } to{ transform:translateY(-9px) rotate(6deg); } }\n  @keyframes drift{ from{ transform:translateX(0); } to{ transform:translateX(125vw); } }\n  .walkhud{ display:flex; justify-content:space-between; align-items:center; padding:14px calc(16px + env(safe-area-inset-right)) calc(16px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  .walkhud .steps{ font-size:13px; color:#a89a88; font-weight:700; }\n  .walkhud button{ border:2px solid #eadfce; background:#fffdf8; color:#4a4238; border-radius:14px; padding:11px 18px; font-size:14px; font-weight:750; }\n\n  /* wardrobe (dress-up) sheet */\n  .wardrobe{ position:fixed; inset:0; background:rgba(74,66,56,.35); display:none; align-items:flex-end; justify-content:center; z-index:9; }\n  .wardrobe.show{ display:flex; }\n  .wardcard{ background:#fffdf8; border-radius:22px 22px 0 0; padding:16px calc(16px + env(safe-area-inset-right)) calc(18px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); width:100%; max-width:600px; max-height:76dvh; overflow-y:auto; }\n  .wardhead{ display:flex; align-items:center; justify-content:space-between; margin-bottom:6px; }\n  .wardhead h2{ font-size:18px; }\n  .wardhead button{ border:none; background:#8fd3a8; color:#fff; border-radius:12px; padding:0 18px; min-height:40px; font-size:14px; font-weight:750; }\n  .wardslot{ margin-top:12px; }\n  .wardslot > small{ font-size:12px; font-weight:750; color:#a89a88; padding-left:2px; }\n  .wardrow{ display:flex; gap:9px; overflow-x:auto; padding:8px 2px 4px; -webkit-overflow-scrolling:touch; }\n  .chip{ flex:0 0 auto; width:70px; text-align:center; background:none; border:none; padding:0; cursor:pointer; }\n  .chip .thumb{ width:66px; height:66px; border-radius:16px; border:2px solid #eadfce; background:#fdf6ec;\n                display:flex; align-items:center; justify-content:center; overflow:hidden; }\n  .chip.on .thumb{ border-color:#8fd3a8; background:#eaf7ef; box-shadow:0 0 0 2px #8fd3a8 inset; }\n  .chip .thumb img{ width:100%; height:100%; object-fit:contain; }\n  .chip .thumb .none{ font-size:22px; color:#c9bda9; }\n  .chip span{ display:block; font-size:10.5px; font-weight:700; color:#a89a88; margin-top:3px; line-height:1.2; }\n  .chip.on span{ color:#5aa87a; }\n  .chip .thumb{ position:relative; }\n  .chip .lock{ position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-size:22px; }\n  .chip.locked .thumb img{ opacity:.32; filter:grayscale(1); }\n  .chip.locked span{ color:#c9bda9; }\n\n  /* food picker (long-press Feed) */\n  .foodmenu{ position:fixed; inset:0; background:rgba(74,66,56,.35); display:none; align-items:flex-end; justify-content:center; z-index:9; }\n  .foodmenu.show{ display:flex; }\n  .foodcard{ background:#fffdf8; border-radius:22px 22px 0 0; padding:16px calc(16px + env(safe-area-inset-right)) calc(18px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); width:100%; max-width:600px; }\n  .foodhead{ display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; }\n  .foodhead h2{ font-size:18px; }\n  .foodhead button{ border:none; background:#f1e7d6; color:#8a7d6a; width:40px; height:40px; border-radius:50%; font-size:15px; display:flex; align-items:center; justify-content:center; }\n  .foodhead button svg, .chatrow button svg{ width:1.2em; height:1.2em; fill:none; stroke:currentColor; stroke-width:2.6; stroke-linecap:round; stroke-linejoin:round; }\n  .foodgrid{ display:grid; grid-template-columns:repeat(4,1fr); gap:10px; }\n  .fooditem{ background:#fdf6ec; border:2px solid #eadfce; border-radius:16px; padding:12px 4px 10px; text-align:center; }\n  .fooditem .fe{ display:block; font-size:30px; margin-bottom:3px; }\n  .fooditem .fn{ font-size:11.5px; font-weight:750; color:#4a4238; }\n  .fooditem.fav{ border-color:#e8b06e; background:#fdf3e6; }\n  .fooditem .ft{ display:block; font-size:9px; color:#d98b3a; font-weight:800; margin-top:2px; letter-spacing:.3px; }\n\n  .namer{ position:fixed; inset:0; background:rgba(74,66,56,.35); display:none; align-items:center; justify-content:center; z-index:9; }\n  .namer.show{ display:flex; }\n  .namecard{ background:#fffdf8; border-radius:22px; padding:22px; width:min(84vw,340px); text-align:center; }\n  .namecard h2{ font-size:19px; margin-bottom:6px; }\n  .namecard p{ font-size:13.5px; color:#a89a88; margin-bottom:14px; line-height:1.5; }\n  .namecard input{ width:100%; font-size:17px; text-align:center; padding:11px; border-radius:13px; border:2px solid #eadfce; background:#fdf6ec; color:#4a4238; }\n  .namecard button{ width:100%; border:none; border-radius:13px; padding:13px; margin-top:12px; font-size:15px; font-weight:750; background:#8fd3a8; color:#fff; }\n</style>\n<style>:root{--build-id:\"b7e049fb00\";}</style>\n</head>\n<body>\n\n<div class=\"top\">\n  <div class=\"who\"><h1 id=\"title\">🥚 A little egg</h1><span class=\"age\" id=\"age\"></span></div>\n  <span class=\"moodchip\" id=\"moodchip\"></span>\n</div>\n\n<div class=\"stats\" id=\"bars\" style=\"display:none\">\n  <div class=\"stat\" id=\"sHunger\"><div class=\"ring\"><svg viewBox=\"0 0 44 44\"><circle class=\"rt\" cx=\"22\" cy=\"22\" r=\"18\"/><circle class=\"rf\" id=\"bHunger\" cx=\"22\" cy=\"22\" r=\"18\"/></svg><span class=\"se\">🍙</span></div><small>Food<b id=\"vHunger\"></b></small></div>\n  <div class=\"stat\" id=\"sHappy\"><div class=\"ring\"><svg viewBox=\"0 0 44 44\"><circle class=\"rt\" cx=\"22\" cy=\"22\" r=\"18\"/><circle class=\"rf\" id=\"bHappy\" cx=\"22\" cy=\"22\" r=\"18\"/></svg><span class=\"se\">💖</span></div><small>Happy<b id=\"vHappy\"></b></small></div>\n  <div class=\"stat\" id=\"sEnergy\"><div class=\"ring\"><svg viewBox=\"0 0 44 44\"><circle class=\"rt\" cx=\"22\" cy=\"22\" r=\"18\"/><circle class=\"rf\" id=\"bEnergy\" cx=\"22\" cy=\"22\" r=\"18\"/></svg><span class=\"se\">⚡</span></div><small>Energy<b id=\"vEnergy\"></b></small></div>\n  <div class=\"stat\" id=\"sClean\"><div class=\"ring\"><svg viewBox=\"0 0 44 44\"><circle class=\"rt\" cx=\"22\" cy=\"22\" r=\"18\"/><circle class=\"rf\" id=\"bClean\" cx=\"22\" cy=\"22\" r=\"18\"/></svg><span class=\"se\">🫧</span></div><small>Clean<b id=\"vClean\"></b></small></div>\n</div>\n\n<div class=\"stage\" id=\"stage\">\n  <div class=\"room\"></div>\n  <div class=\"night\"><i class=\"star\" style=\"left:14%;top:10%;animation-delay:0.0s\"></i><i class=\"star\" style=\"left:24%;top:16%;animation-delay:0.8s\"></i><i class=\"star\" style=\"left:33%;top:8%;animation-delay:1.6s\"></i><i class=\"star\" style=\"left:19%;top:22%;animation-delay:2.2s\"></i><i class=\"star\" style=\"left:28%;top:12%;animation-delay:0.4s\"></i><i class=\"star\" style=\"left:71%;top:6%;animation-delay:1.2s\"></i><i class=\"star\" style=\"left:83%;top:14%;animation-delay:2.6s\"></i></div>\n  <p class=\"hint\" id=\"hint\"></p>\n  <div class=\"bubble\" id=\"bubble\"></div>\n  <div class=\"petbox\" id=\"petbox\">\n    <img id=\"pet\" src=\"\" alt=\"Your pet\">\n    <img class=\"acc\" id=\"acc_head\" alt=\"\" style=\"display:none\">\n    <img class=\"acc\" id=\"acc_eyes\" alt=\"\" style=\"display:none\">\n    <img class=\"acc\" id=\"acc_neck\" alt=\"\" style=\"display:none\">\n    <img class=\"acc\" id=\"smudge\" alt=\"\" style=\"display:none\">\n  </div>\n  <div class=\"fx\" id=\"fx\"></div>\n</div>\n\n<div class=\"dock\" id=\"actions\" style=\"display:none\">\n  <button class=\"act feed\" id=\"feedBtn\"><span class=\"ico\">🍙</span><span>Feed</span></button>\n  <button class=\"act play\" onclick=\"play()\" id=\"playBtn\"><span class=\"ico\">⚽</span><span>Play</span></button>\n  <button class=\"act bath\" onclick=\"bath()\"><span class=\"ico\">🫧</span><span>Bath</span></button>\n  <button class=\"act walk\" onclick=\"startWalk()\" id=\"walkBtn\"><span class=\"ico\">🌼</span><span>Walk</span></button>\n  <button class=\"act sleep\" onclick=\"toggleSleep()\" id=\"sleepBtn\"><span class=\"ico\">🌙</span><span>Sleep</span></button>\n  <button class=\"act style\" onclick=\"openWardrobe()\"><span class=\"ico\">👒</span><span>Style</span></button>\n</div>\n\n<div class=\"walkview\" id=\"walkview\">\n  <div class=\"sky\"></div>\n  <div class=\"walkscene\">\n    <div class=\"walktrack\" id=\"walktrack\"></div>\n    <div class=\"critters\" id=\"critters\"></div>\n    <div class=\"wbubble-wrap\"><div class=\"bubble\" id=\"wbubble\" style=\"position:relative; top:0;\"></div></div>\n    <div class=\"walker\" id=\"walker\">\n      <div class=\"pet\" id=\"walkpet\" role=\"img\" aria-label=\"Mochi walking\"></div>\n      <img class=\"wacc\" id=\"wacc_head\" alt=\"\" style=\"display:none\">\n      <img class=\"wacc\" id=\"wacc_eyes\" alt=\"\" style=\"display:none\">\n      <img class=\"wacc neck\" id=\"wacc_neck\" alt=\"\" style=\"display:none\">\n      <img class=\"wacc\" id=\"wsmudge\" alt=\"\" style=\"display:none\">\n    </div>\n  </div>\n  <div class=\"walkhud\">\n    <span class=\"steps\" id=\"walksteps\"></span>\n    <button onclick=\"endWalk(false)\">🏠 Head home</button>\n  </div>\n</div>\n\n<div class=\"chatrow\" id=\"chatrow\" style=\"display:none\">\n  <input id=\"say\" type=\"text\" autocomplete=\"off\" placeholder=\"Say something…\">\n  <button onclick=\"talk()\" aria-label=\"Say it\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 12l15-7-5 15-3-6z\"/><path d=\"M11 14l8-9\"/></svg></button>\n</div>\n\n<div class=\"namer\" id=\"namer\">\n  <div class=\"namecard\">\n    <h2>It hatched! 🐣</h2>\n    <p>A tiny mochi blinks up at you.<br>What will you call it?</p>\n    <input id=\"nameInput\" maxlength=\"16\" placeholder=\"Mochi\">\n    <button onclick=\"setName()\">That's the one</button>\n  </div>\n</div>\n\n<div class=\"wardrobe\" id=\"wardrobe\">\n  <div class=\"wardcard\">\n    <div class=\"wardhead\">\n      <h2>Dress up ✨</h2>\n      <button onclick=\"closeWardrobe()\">Done</button>\n    </div>\n    <div id=\"wardslots\"></div>\n  </div>\n</div>\n\n<div class=\"foodmenu\" id=\"foodmenu\">\n  <div class=\"foodcard\">\n    <div class=\"foodhead\">\n      <h2>Pick a snack 🍽️</h2>\n      <button onclick=\"closeFoodMenu()\" aria-label=\"Close\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button>\n    </div>\n    <div class=\"foodgrid\" id=\"foodgrid\"></div>\n  </div>\n</div>\n\n<script>\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. ASK and store stay usable as names everywhere below. */\nvar storeFallback = {getItem:function(){return Promise.resolve(null)}, setItem:function(){return Promise.resolve()}};\nObject.defineProperty(window, \"ASK\", { configurable:true, get:function(){ return window.myllmAsk || null; } });\nObject.defineProperty(window, \"store\", { configurable:true, get:function(){ return window.myllmStorage || storeFallback; } });\n/* A walk is a full-screen moment: MyLLM's own bars step aside while Mochi is\n   outside, and come back when she heads home. Builds without the bridge keep\n   today's overlay under the title bar. */\nfunction syncChrome(){\n  if (!window.myllmImmersive) return;\n  try { myllmImmersive(walking, {keepAwake:false}).catch(function(){}); } catch(_){}\n}\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s==null?'':s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\"); }\n\nvar ART = \"https://raw.githubusercontent.com/TeamDzX/myllm-assets/main/apps/mochi/\";\nvar ANIM = { egg:\"anim_egg.webp\", hatch:\"anim_hatch.webp\", idle:\"anim_idle2.webp\",\n             happy:\"anim_happy.webp\", eat:\"anim_eat.webp\", sleep:\"anim_sleep.webp\",\n             sad:\"anim_sad.webp\", bath:\"anim_bath.webp\", play:\"anim_play.webp\",\n             walk:\"anim_walk.webp\", pet:\"anim_pet.webp\" };\n/* v15: the home screen is a room, so Mochi needs to be cut out of the cream\n   the loops were rendered on. \"<name>_k.webp\" is the same loop with the\n   background keyed to alpha; the originals stay for older installs. */\nfunction keyed(file){ return file.replace(\".webp\", \"_k.webp\"); }\n\n/* ---------- wardrobe ---------- */\n/* Accessories are pre-positioned 400x400 overlays: \"<id>.png\" sits over the\n   idle sprite, \"<id>_w.png\" over the walk sprite, \"<id>_chip.png\" is the picker\n   thumbnail. One item per slot; slots stack. */\nvar ACC_BASE = ART + \"acc/\";\nvar CATALOG = [\n  { id:\"beanie\",        slot:\"head\", label:\"Beanie\" },\n  { id:\"bucket_hat\",    slot:\"head\", label:\"Bucket\" },\n  { id:\"crown\",         slot:\"head\", label:\"Crown\" },\n  { id:\"flower\",        slot:\"head\", label:\"Flower\" },\n  { id:\"bow\",           slot:\"head\", label:\"Bow\" },\n  { id:\"sunglasses\",    slot:\"eyes\", label:\"Shades\" },\n  { id:\"heart_glasses\", slot:\"eyes\", label:\"Hearts\" },\n  { id:\"round_glasses\", slot:\"eyes\", label:\"Specs\" },\n  { id:\"bowtie\",        slot:\"neck\", label:\"Bow tie\" },\n  { id:\"chain\",         slot:\"neck\", label:\"Chain\" }\n];\nvar SLOT_ORDER = [\"head\",\"eyes\",\"neck\"];\nvar SLOT_NAME = { head:\"On the head\", eyes:\"Eyes\", neck:\"Neck\" };\nvar W = { head:null, eyes:null, neck:null };\n\n/* Milestone unlocks: one accessory per slot is unlocked from the start\n   (beanie/sunglasses/bowtie); the rest are earned by caring for Mochi. Each\n   entry is test(state)->bool + the hint shown while it's still locked. */\nvar UNLOCKS = {\n  bucket_hat:    { test:function(s){ return (s.walks||0) >= 1; },        hint:\"Go on your first walk 🌼\" },\n  flower:        { test:function(s){ return (s.finds||0) >= 10; },       hint:\"Find 10 treasures on walks 🌸\" },\n  crown:         { test:function(s){ return daysTogether() >= 7; },      hint:\"Spend 7 days together 👑\" },\n  bow:           { test:function(s){ return !!s.maxHappy; },             hint:\"Reach 100% happiness 🎀\" },\n  heart_glasses: { test:function(s){ return (s.chats||0) >= 10; },       hint:\"Chat with Mochi 10 times 💗\" },\n  round_glasses: { test:function(s){ return (s.plays||0) >= 15; },       hint:\"Play together 15 times 🤓\" },\n  chain:         { test:function(s){ return !!s.choc; },                 hint:\"Give Mochi its favourite treat 🍫\" }\n};\n\n/* ---------- state ---------- */\nvar S = null;    /* {name, hatched, tapCount, born, last, hunger, happy, energy, clean, sleeping} */\nvar transient = null, transientTimer = null;\nvar HOUR = 3600000;\n\nfunction fresh(){\n  return { name:null, hatched:false, tapCount:0, born:Date.now(), last:Date.now(),\n           hunger:80, happy:80, energy:90, clean:90, sleeping:false, messy:false,\n           walks:0, finds:0, plays:0, chats:0, choc:false, maxHappy:false, unlocked:[] };\n}\n\n/* Kind decay: stats drift down over real time but floor at 12 — Mochi can get\n   hungry and mopey, never worse. While sleeping, energy recovers instead. */\nfunction applyDecay(){\n  var now = Date.now();\n  var hrs = Math.min(72, (now - S.last) / HOUR);\n  if (hrs <= 0){ S.last = now; return; }\n  var floor = function(v){ return Math.max(12, v); };\n  S.hunger = floor(S.hunger - hrs * 6);\n  S.clean  = floor(S.clean  - hrs * 3);\n  if (S.sleeping){\n    S.energy = Math.min(100, S.energy + hrs * 18);\n    S.happy  = floor(S.happy - hrs * 2);\n    if (S.energy >= 100) S.sleeping = false;   /* fully rested — woke up on its own */\n  } else {\n    S.energy = floor(S.energy - hrs * 4);\n    S.happy  = floor(S.happy - hrs * 4);\n  }\n  S.last = now;\n}\n\nfunction mood(){\n  if (!S.hatched) return \"egg\";\n  if (transient) return transient;\n  if (S.sleeping) return \"sleep\";\n  if (S.hunger < 30 || S.happy < 30 || S.clean < 25 || S.energy < 20) return \"sad\";\n  return \"idle\";\n}\n\nfunction moodHint(){\n  if (!S.hatched) return \"Tap the egg…\";\n  if (S.sleeping) return esc(S.name) + \" is snoozing. Tap to wake gently.\";\n  if (S.messy) return esc(S.name) + \" has a chocolatey face — bath time! 🍫\";\n  if (S.hunger < 30) return esc(S.name) + \" is peckish… 🍙\";\n  if (S.clean < 25) return esc(S.name) + \" could use a bath. 🫧\";\n  if (S.energy < 20) return esc(S.name) + \" is sleepy. 🌙\";\n  if (S.happy < 30) return esc(S.name) + \" wants to play! ⚽\";\n  return \"\";\n}\n\nfunction save(){ store.setItem(\"mochi_state\", JSON.stringify(S)); }\n\n/* ---------- rendering ---------- */\nfunction render(){\n  var m = mood();\n  var src = ART + keyed(ANIM[m]);\n  if (el(\"pet\").getAttribute(\"src\") !== src) el(\"pet\").src = src;\n  el(\"stage\").className = \"stage\" + (S.sleeping && !transient ? \" sleeping\" : \"\");\n  el(\"hint\").textContent = moodHint();\n  if (S.hatched){\n    el(\"title\").textContent = \"🐣 \" + S.name;\n    var days = Math.max(1, Math.ceil((Date.now() - S.born) / 86400000));\n    el(\"age\").textContent = \"Day \" + days + \" together\";\n    el(\"bars\").style.display = \"grid\";\n    el(\"actions\").style.display = \"grid\";\n    el(\"chatrow\").style.display = \"flex\";\n    bar(\"Hunger\", S.hunger); bar(\"Happy\", S.happy); bar(\"Energy\", S.energy); bar(\"Clean\", S.clean);\n    el(\"sleepBtn\").innerHTML = S.sleeping ? '<span class=\"ico\">☀️</span><span>Wake</span>' : '<span class=\"ico\">🌙</span><span>Sleep</span>';\n    el(\"playBtn\").disabled = S.sleeping;\n  }\n  el(\"moodchip\").textContent = !S.hatched ? \"\" : S.sleeping ? \"💤 Asleep\" : m === \"sad\" ? \"🥺 Needs you\" :\n    (S.happy >= 80 && S.hunger >= 50) ? \"😊 Happy\" : \"🙂 Content\";\n  zzz(S.hatched && S.sleeping && !transient);\n}\n\n/* ---------- little bits of joy ---------- */\n/* A few emoji that float up from Mochi when something nice happens. */\nvar FX = { pet:[\"💗\",\"💕\",\"💖\",\"💗\"], play:[\"⭐\",\"✨\",\"⚽\",\"🌟\"], bath:[\"🫧\",\"🫧\",\"✨\",\"🫧\"],\n           eat:[\"😋\",\"✨\",\"💛\"], wake:[\"☀️\",\"✨\"], happy:[\"✨\",\"🎶\",\"💚\"], hatch:[\"✨\",\"🌱\",\"💫\",\"✨\"] };\nfunction fx(kind){\n  var host = el(\"fx\"), box = el(\"petbox\");\n  if (!host || !box || !FX[kind]) return;\n  var hb = host.getBoundingClientRect(), pb = box.getBoundingClientRect();\n  var cx = pb.left - hb.left + pb.width / 2, cy = pb.top - hb.top + pb.height * 0.35;\n  FX[kind].forEach(function(e, i){\n    var s = document.createElement(\"span\");\n    s.className = \"fxp\"; s.textContent = e;\n    s.style.left = (cx - 12 + (Math.random() - 0.5) * pb.width * 0.6) + \"px\";\n    s.style.top = (cy + Math.random() * 30) + \"px\";\n    s.style.setProperty(\"--dx\", ((Math.random() - 0.5) * 70).toFixed(0) + \"px\");\n    s.style.setProperty(\"--rot\", ((Math.random() - 0.5) * 40).toFixed(0) + \"deg\");\n    s.style.animationDelay = (i * 0.12) + \"s\";\n    host.appendChild(s);\n    setTimeout(function(){ if (s.parentNode) s.parentNode.removeChild(s); }, 2200 + i * 120);\n  });\n}\n/* \"+26\" rising over the gauge that just went up. */\nfunction delta(key, amount){\n  amount = Math.round(amount);\n  if (!amount || amount < 1) return;\n  var host = el(\"s\" + key); if (!host) return;\n  var d = document.createElement(\"span\");\n  d.className = \"delta\"; d.textContent = \"+\" + amount;\n  host.appendChild(d);\n  setTimeout(function(){ if (d.parentNode) d.parentNode.removeChild(d); }, 1400);\n}\n/* Change a stat and show the rise. */\nfunction bump(key, prop, by, cap){\n  var before = S[prop];\n  S[prop] = Math.min(cap == null ? 100 : cap, S[prop] + by);\n  delta(key, S[prop] - before);\n}\nvar zzzTimer = null;\nfunction zzz(on){\n  if (on && !zzzTimer){\n    zzzTimer = setInterval(function(){\n      var host = el(\"fx\"), box = el(\"petbox\"); if (!host || !box) return;\n      var hb = host.getBoundingClientRect(), pb = box.getBoundingClientRect();\n      var s = document.createElement(\"span\");\n      s.className = \"fxp\"; s.textContent = \"💤\"; s.style.fontSize = \"20px\";\n      s.style.left = (pb.left - hb.left + pb.width * 0.62) + \"px\";\n      s.style.top = (pb.top - hb.top + pb.height * 0.18) + \"px\";\n      s.style.setProperty(\"--dx\", \"26px\");\n      host.appendChild(s);\n      setTimeout(function(){ if (s.parentNode) s.parentNode.removeChild(s); }, 1900);\n    }, 2600);\n  } else if (!on && zzzTimer){ clearInterval(zzzTimer); zzzTimer = null; }\n}\n\nfunction bar(key, v){\n  v = Math.round(v);\n  var f = el(\"b\" + key);\n  f.style.strokeDashoffset = (113.1 * (1 - v / 100)).toFixed(1);\n  f.setAttribute(\"class\", \"rf\" + (v < 25 ? \" crit\" : v < 45 ? \" low\" : \"\"));\n  el(\"s\" + key).className = \"stat\" + (v < 25 ? \" crit\" : \"\");\n  el(\"v\" + key).textContent = v;\n}\n\nfunction pulse(anim, ms){\n  transient = anim;\n  clearTimeout(transientTimer);\n  transientTimer = setTimeout(function(){ transient = null; render(); save(); }, ms || 5200);\n  render();\n}\n\nfunction bubble(text, ms, dreamy){\n  var b = el(walking ? \"wbubble\" : \"bubble\");\n  b.textContent = text;\n  b.className = \"bubble show\" + (dreamy ? \" dream\" : \"\");\n  if (!dreamy && !walking) b.style.left = (42 + Math.random() * 16) + \"%\";\n  clearTimeout(b._t);\n  b._t = setTimeout(function(){ b.classList.remove(\"show\"); }, ms || 4200);\n}\n\n/* ---------- actions ---------- */\n/* Snacks — tap Feed for the default rice ball, press-and-hold to pick one.\n   Chocolate is the favourite (big happy boost) but leaves a chocolatey face\n   that needs a bath. */\nvar SMUDGE  = ART + \"chocolate_smudge.png\";\nvar SMUDGE_W = ART + \"chocolate_smudge_w.png\";\nvar FOODS = [\n  { id:\"riceball\",  emoji:\"🍙\", name:\"Rice ball\", hunger:32, happy:4 },\n  { id:\"banana\",    emoji:\"🍌\", name:\"Banana\",    hunger:28, happy:8 },\n  { id:\"apple\",     emoji:\"🍎\", name:\"Apple\",     hunger:24, happy:6 },\n  { id:\"chocolate\", emoji:\"🍫\", name:\"Chocolate\", hunger:18, happy:24, fav:true, messy:true }\n];\nfunction food(id){ return FOODS.filter(function(f){ return f.id === id; })[0] || FOODS[0]; }\n\nfunction feed(){ feedWith(\"riceball\"); }     /* quick tap = the default snack */\n\nfunction feedWith(id){\n  closeFoodMenu();\n  if (S.sleeping){ bubble(\"Shh — \" + esc(S.name) + \" is sleeping.\"); return; }\n  var f = food(id);\n  haptic(f.fav ? \"success\" : \"light\");\n  bump(\"Hunger\", \"hunger\", f.hunger);\n  bump(\"Happy\", \"happy\", f.happy);\n  fx(\"eat\");\n  if (f.messy){\n    S.messy = true;\n    S.clean = Math.max(12, S.clean - 28);   /* chocolate = messy face */\n    applyMessy();\n  }\n  if (f.id === \"chocolate\") S.choc = true;   /* milestone: favourite treat */\n  pulse(\"eat\", 5600);\n  bubble(f.fav ? f.emoji + \" my favourite!! *munch munch*\" : f.emoji + \" yum!\", 3400);\n  checkUnlocks(); save();\n}\n\n/* Toggle the chocolate smudge overlay (idle + walk) when the face is messy. */\nfunction applyMessy(){\n  var on = !!(S && S.hatched && S.messy);\n  el(\"smudge\").style.display  = on ? \"block\" : \"none\";\n  el(\"wsmudge\").style.display = on ? \"block\" : \"none\";\n}\n\nfunction buildFoodMenu(){\n  el(\"foodgrid\").innerHTML = FOODS.map(function(f){\n    return '<button class=\"fooditem' + (f.fav ? ' fav' : '') +\n           '\" onclick=\"feedWith(\\'' + f.id + '\\')\">' +\n           '<span class=\"fe\">' + f.emoji + '</span>' +\n           '<span class=\"fn\">' + esc(f.name) + '</span>' +\n           (f.fav ? '<span class=\"ft\">FAVOURITE</span>' : '') +\n           '</button>';\n  }).join(\"\");\n}\nfunction openFoodMenu(){\n  if (!S || !S.hatched) return;\n  if (S.sleeping){ bubble(\"Shh — \" + esc(S.name) + \" is sleeping.\"); return; }\n  haptic(\"light\");\n  el(\"foodmenu\").classList.add(\"show\");\n}\nfunction closeFoodMenu(){ el(\"foodmenu\").classList.remove(\"show\"); }\nfunction play(){\n  if (S.sleeping) return;\n  haptic(\"light\");\n  bump(\"Happy\", \"happy\", 26);\n  fx(\"play\");\n  S.energy = Math.max(5, S.energy - 10);\n  S.hunger = Math.max(12, S.hunger - 5);\n  S.plays = (S.plays || 0) + 1;\n  pulse(\"play\", 5600); checkUnlocks(); save();\n}\nfunction bath(){\n  if (S.sleeping){ bubble(\"Bathtime after nap time.\"); return; }\n  haptic(\"light\");\n  bump(\"Clean\", \"clean\", 100 - S.clean);\n  fx(\"bath\");\n  if (S.messy){ S.messy = false; applyMessy(); bubble(\"All clean again! ✨\", 2800); }\n  pulse(\"bath\", 5600); save();\n}\nfunction toggleSleep(){\n  haptic(\"selection\");\n  if (S.sleeping){\n    S.sleeping = false;\n    bump(\"Happy\", \"happy\", 6);\n    fx(\"wake\");\n    pulse(\"happy\", 3800);\n  } else {\n    S.sleeping = true;\n    transient = null;\n  }\n  render(); save();\n}\n\n/* ---------- egg & hatching ---------- */\nfunction stageTap(){\n  if (!S.hatched){\n    S.tapCount++;\n    haptic(S.tapCount >= 3 ? \"success\" : \"light\");\n    if (S.tapCount >= 3){\n      S.hatched = true;\n      transient = \"hatch\";\n      el(\"pet\").src = ART + keyed(ANIM.hatch);\n      setTimeout(function(){ el(\"namer\").classList.add(\"show\"); }, 2600);\n    } else {\n      el(\"hint\").textContent = S.tapCount === 1 ? \"It wobbled!\" : \"Something's moving in there…\";\n      var p = el(\"pet\");\n      p.style.transition = \"transform .12s\";\n      p.style.transform = \"rotate(\" + (S.tapCount % 2 ? 4 : -4) + \"deg)\";\n      setTimeout(function(){ p.style.transform = \"\"; }, 140);\n    }\n    save();\n    return;\n  }\n  if (S.sleeping){ toggleSleep(); return; }\n  haptic(\"light\");\n  bump(\"Happy\", \"happy\", 2);\n  fx(\"pet\");\n  pulse(\"pet\", 3400);          /* heart-eyes: being petted */\n  save();\n}\n\nfunction setName(){\n  var n = el(\"nameInput\").value.trim() || \"Mochi\";\n  S.name = n.slice(0, 16);\n  S.born = Date.now();\n  el(\"namer\").classList.remove(\"show\");\n  haptic(\"success\");\n  transient = null;\n  render(); save();\n  bubble(\"Hello! I'm \" + esc(S.name) + \"! 🌱\", 5000);\n  fx(\"hatch\");\n}\n\n/* ---------- talking (the MyLLM twist) ---------- */\nvar CANNED = [\"mochi mochi! 🌱\",\"*happy wiggle*\",\"(◕ᴗ◕)\",\"*bounces softly*\",\"squeak!\",\"*does a tiny spin*\"];\n\nfunction talk(){\n  var t = el(\"say\").value.trim();\n  if (!t || !S.hatched) return;\n  el(\"say\").value = \"\";\n  haptic(\"light\");\n  if (S.sleeping){ bubble(\"…zzz…\"); return; }\n  S.chats = (S.chats || 0) + 1; checkUnlocks();\n  if (!ASK){\n    bubble(CANNED[Math.floor(Math.random() * CANNED.length)]);\n    S.happy = Math.min(100, S.happy + 3); render(); save();\n    return;\n  }\n  var vibe = S.hunger < 30 ? \"hungry\" : S.happy < 30 ? \"a bit lonely\" : S.energy < 20 ? \"sleepy\" : \"happy and playful\";\n  var p = \"You are \" + S.name + \", a tiny newly-hatched pet blob creature. You are currently feeling \" + vibe + \".\\n\" +\n    \"Your owner says: \\\"\" + t + \"\\\"\\n\" +\n    \"Reply as \" + S.name + \" in ONE short, sweet sentence (max 12 words). Babyish, adorable, warm. \" +\n    \"You may use one emoji. Never break character, never mention being an AI.\";\n  ASK(p).then(function(r){\n    var line = String(r||\"\").split(\"\\n\")[0].replace(/^[\"']|[\"']$/g, \"\").trim();\n    if (!line || line.length > 120) line = CANNED[0];\n    bubble(line, 5200);\n    S.happy = Math.min(100, S.happy + 5);\n    pulse(\"happy\", 3600); save();\n  }).catch(function(){\n    bubble(CANNED[Math.floor(Math.random() * CANNED.length)]);\n  });\n}\n\n/* ---------- walk mode ---------- */\nvar walking = false, walkTimer = null, walkStart = 0, lastFind = 0, findCount = 0;\n\n/* ---------- walk rig ----------\n   Mochi's head travels ~32px across and ~20px up and down inside the 400px\n   sprite as she waddles. An accessory pinned to the walker box can't follow\n   that, which is why a hat used to drift beside her head instead of sitting on\n   it. RIG_TRACK is where the head is on each of the 33 unique frames, measured\n   from the loop itself (see build_mochi_rig.py); the accessories ride it.\n\n   Rebuild both the sheet and this table with:  python3 build_mochi_rig.py --apply */\nvar RIG_PIVOT = [210.7, 101.9];        /* head centre in sprite px */\nvar RIG_TRACK = [\n  [-8.5,5.0,-3.55],[-7.0,5.4,-2.94],[-3.1,6.7,-1.32],[0.7,6.7,0.29],\n  [4.2,4.3,1.76],[6.9,-1.5,2.88],[8.4,-7.2,3.54],[8.1,-10.2,3.42],\n  [6.5,-9.1,2.71],[3.9,-5.2,1.66],[1.1,-1.4,0.46],[-1.3,1.9,-0.54],\n  [-2.2,3.7,-0.92],[-0.8,4.6,-0.33],[2.5,4.1,1.04],[6.8,2.9,2.87],\n  [11.2,0.4,4.7],[14.4,-3.3,6.04],[14.9,-8.8,6.25],[11.6,-12.5,4.86],\n  [4.6,-12.8,1.95],[-4.0,-8.6,-1.67],[-11.6,-4.2,-4.88],[-16.2,-1.2,-6.81],\n  [-17.5,0.2,-7.35],[-16.3,1.7,-6.83],[-13.6,3.6,-5.72],[-9.9,5.6,-4.14],\n  [-5.4,7.0,-2.26],[-0.7,7.6,-0.3],[2.7,6.4,1.14],[4.5,4.6,1.91],\n  [5.0,3.5,2.08]\n];\nvar SHEET_COLS = 6, SHEET_N = RIG_TRACK.length, WALK_FRAMES = 2 * (SHEET_N - 1), FRAME_MS = 71;\n\n/* How much of the head's motion each slot inherits. A bowtie sits on the neck,\n   which sways less than the crown does — giving it the full head track makes it\n   look flung about. */\nvar SLOT_RIDE = { head:1, eyes:1, neck:0.55 };\n\n/* Per-item character. Rather than a canned wobble, each accessory reacts to how\n   the head is MOVING this frame — lag trails the horizontal swing, give softens\n   the vertical, swing adds a little life of its own. So a floppy bucket hat\n   lollops, a crown stays regal and stiff, and glasses stay clamped to the face.\n     lag   how far behind the head's sideways motion it drags (degrees per px/frame)\n     give  how much it keeps bouncing after a step lands (px per px/frame)\n     swing its own idle sway, in degrees, over one stride */\nvar ACC_MOTION = {\n  beanie:        { lag:0.55, give:0.35, swing:0    },  /* snug knit */\n  bucket_hat:    { lag:1.05, give:0.60, swing:0.7  },  /* floppy brim */\n  crown:         { lag:0.20, give:0.15, swing:0    },  /* rigid, regal */\n  flower:        { lag:1.35, give:0.80, swing:1.8  },  /* springy stem */\n  bow:           { lag:0.85, give:0.50, swing:1.0  },\n  sunglasses:    { lag:0.12, give:0.08, swing:0    },  /* clamped to the face */\n  heart_glasses: { lag:0.30, give:0.18, swing:0.55 },\n  round_glasses: { lag:0.12, give:0.08, swing:0    },\n  bowtie:        { lag:0.75, give:0.45, swing:1.2  },\n  chain:         { lag:1.15, give:0.90, swing:0.6  },  /* heavy, swings late */\n  _smudge:       { lag:0,    give:0,    swing:0    }   /* painted on her face */\n};\n\n/* Played frame -> unique sheet cell. The loop is a palindrome, so the second\n   half is the first half walked backwards; only 33 frames are stored. */\nfunction walkCell(played){\n  var p = ((played % WALK_FRAMES) + WALK_FRAMES) % WALK_FRAMES;\n  return p < SHEET_N ? p : WALK_FRAMES - p;\n}\n/* One entry per PLAYED frame: where the head is, plus how fast it's moving\n   (which is what the per-item character reacts to). Built once. */\nvar PLAY = null;\nfunction buildPlay(){\n  if (PLAY) return PLAY;\n  PLAY = [];\n  var i, c;\n  for (i = 0; i < WALK_FRAMES; i++){\n    c = RIG_TRACK[walkCell(i)];\n    PLAY.push({ dx:c[0], dy:c[1], lean:c[2], vx:0, vy:0 });\n  }\n  for (i = 0; i < WALK_FRAMES; i++){\n    var prev = PLAY[(i + WALK_FRAMES - 1) % WALK_FRAMES];\n    PLAY[i].vx = PLAY[i].dx - prev.dx;\n    PLAY[i].vy = PLAY[i].dy - prev.dy;\n  }\n  return PLAY;\n}\n/* The transform one accessory wears on one frame. Pure — the harness drives it\n   directly. `sc` converts sprite px to on-screen px. */\nfunction accTransform(played, slot, id, sc){\n  var p = buildPlay()[((played % WALK_FRAMES) + WALK_FRAMES) % WALK_FRAMES];\n  var m = ACC_MOTION[id] || { lag:0.5, give:0.3, swing:0 };\n  var ride = SLOT_RIDE[slot] == null ? 1 : SLOT_RIDE[slot];\n  var x = p.dx * ride;\n  var y = p.dy * ride + p.vy * m.give;\n  var r = p.lean * ride - p.vx * m.lag\n        + (m.swing ? Math.sin(played / WALK_FRAMES * Math.PI * 2) * m.swing : 0);\n  return \"translate(\" + (x * sc).toFixed(2) + \"px,\" + (y * sc).toFixed(2) + \"px) rotate(\" + r.toFixed(2) + \"deg)\";\n}\n/* Sprite-sheet cell -> CSS background-position. With background-size 600%, the\n   step between cells is 100/(cols-1) percent, not 100/cols. */\nfunction cellPos(cell){\n  var rows = Math.ceil(SHEET_N / SHEET_COLS);\n  return { x: (cell % SHEET_COLS) * (100 / (SHEET_COLS - 1)),\n           y: Math.floor(cell / SHEET_COLS) * (100 / (rows - 1)) };\n}\n\n/* Meadow friends: birds up high, bugs mid-air, crawlers on the ground —\n   drifting past on two depth layers. Config is pure (rng-injectable). */\nvar CRITTERS = [\n  { e:\"🦋\", band:[18, 42], dur:[13, 20], layer:\"front\", size:[20, 28] },\n  { e:\"🐝\", band:[26, 50], dur:[9, 14],  layer:\"front\", size:[17, 22] },\n  { e:\"🐦\", band:[4, 20],  dur:[8, 13],  layer:\"back\",  size:[18, 26] },\n  { e:\"🐞\", band:[55, 70], dur:[14, 20], layer:\"front\", size:[15, 19] },\n  { e:\"🐌\", band:[80, 88], dur:[30, 40], layer:\"front\", size:[16, 20] }\n];\nvar critterTimer = null;\n\nfunction critterSpec(rng){\n  var c = CRITTERS[Math.floor(rng() * CRITTERS.length)];\n  var lerp = function(r){ return r[0] + rng() * (r[1] - r[0]); };\n  return { e: c.e, top: lerp(c.band), dur: lerp(c.dur), layer: c.layer, size: Math.round(lerp(c.size)) };\n}\n\nfunction spawnCritter(rng){\n  var host = el(\"critters\");\n  if (!host || host.childElementCount >= 4) return null;\n  var s = critterSpec(rng || Math.random);\n  var d = document.createElement(\"div\");\n  d.className = \"critter \" + s.layer;\n  d.style.top = s.top + \"%\";\n  d.style.fontSize = s.size + \"px\";\n  d.style.animation = \"drift \" + s.dur.toFixed(1) + \"s linear forwards\";\n  d.innerHTML = \"<span>\" + s.e + \"</span>\";\n  host.appendChild(d);\n  setTimeout(function(){ if (d.parentNode) d.parentNode.removeChild(d); }, s.dur * 1000 + 400);\n  return s;\n}\n\nfunction startCritters(){\n  stopCritters();\n  spawnCritter();                                     /* one friend right away */\n  critterTimer = setInterval(function(){\n    if (Math.random() < 0.55) spawnCritter();\n  }, 6000);\n}\nfunction stopCritters(){\n  if (critterTimer){ clearInterval(critterTimer); critterTimer = null; }\n  var host = el(\"critters\");\n  if (host) host.innerHTML = \"\";\n}\n\nfunction buildTrack(){\n  var track = el(\"walktrack\");\n  if (track.childElementCount) return;\n  /* palindrome tiling: strip + mirrored strip, scrolled 50% = seamless loop */\n  track.innerHTML = '<img src=\"' + ART + 'walk_bg.jpg\" alt=\"\">' +\n                    '<img class=\"flip\" src=\"' + ART + 'walk_bg.jpg\" alt=\"\">' +\n                    '<img src=\"' + ART + 'walk_bg.jpg\" alt=\"\">' +\n                    '<img class=\"flip\" src=\"' + ART + 'walk_bg.jpg\" alt=\"\">';\n}\nvar FINDS = [\n  {e:\"🌼\", t:\"found a little flower!\"}, {e:\"🦋\", t:\"a butterfly friend!\"},\n  {e:\"🍄\", t:\"ooh, a tiny mushroom!\"}, {e:\"✨\", t:\"something sparkly!\"},\n  {e:\"🐌\", t:\"met a slow friend.\"}, {e:\"🍀\", t:\"a lucky clover!\"},\n  {e:\"🍙\", t:\"A WILD BUN!! nom.\", rare:true}\n];\n\nfunction startWalk(){\n  if (walking || !S.hatched) return;\n  if (S.sleeping){ bubble(\"Wake \" + esc(S.name) + \" up first. 🌙\"); return; }\n  if (S.energy < 25){ bubble(esc(S.name) + \" is too tired for a walk right now. 🌙\"); return; }\n  haptic(\"success\");\n  walking = true; walkStart = Date.now(); lastFind = Date.now(); findCount = 0;\n  S.walks = (S.walks || 0) + 1; checkUnlocks();   /* milestone: first walk */\n  buildTrack();\n  /* WebKit quirk: percentage-transform keyframes computed against a\n     not-yet-loaded (zero-width) strip don't recover — restart the animation\n     now that we're visible so the first walk scrolls like every other. */\n  var track = el(\"walktrack\");\n  track.style.animation = \"none\";\n  void track.offsetWidth;\n  track.style.animation = \"\";\n  el(\"walkview\").classList.add(\"show\");\n  syncChrome();\n  startWalkAnim();\n  el(\"walksteps\").textContent = \"\";\n  walkTimer = setInterval(walkTick, 5000);\n  startCritters();\n  bubble(\"*waddle waddle*\", 3200);\n}\n\n/* ---- walk playback ----\n   Sheet if we have it (frame-exact, so accessories can ride the head), the old\n   animated webp if we don't. The fallback isn't only for a failed download: the\n   sheet may simply not have arrived yet on a first run, and making Mochi wait\n   to go outside would be a worse trade than a few seconds of static hats. */\nvar walkRAF = null, walkFrame = -1, sheetReady = false;\n/* Fetched at boot so it's warm before the first walk. If it lands while Mochi is\n   already outside, upgrade her mid-stroll — the sheet starts at the same pose,\n   so the swap isn't visible. */\nfunction preloadSheet(){\n  var im = new Image();\n  im.onload = function(){\n    sheetReady = true;\n    if (walking && !walkRAF) startWalkAnim();\n  };\n  im.src = ART + \"walk_sheet.webp\";\n}\nfunction startWalkAnim(){\n  var pet = el(\"walkpet\");\n  if (sheetReady){\n    pet.classList.remove(\"plain\");\n    pet.style.backgroundImage = \"url(\" + ART + \"walk_sheet.webp)\";\n    paintWalkFrame(0);\n    stopWalkAnim();\n    walkRAF = requestAnimationFrame(walkStep);\n  } else {\n    /* alpha-keyed: Mochi IS in the meadow, not pasted over it */\n    pet.classList.add(\"plain\");\n    pet.style.backgroundImage = \"url(\" + ART + \"anim_walk_t.webp)\";\n    clearAccTransforms();\n  }\n}\nfunction stopWalkAnim(){\n  if (walkRAF){ cancelAnimationFrame(walkRAF); walkRAF = null; }\n  walkFrame = -1;\n}\nfunction walkStep(){\n  if (!walking){ walkRAF = null; return; }\n  paintWalkFrame(Math.floor((Date.now() - walkStart) / FRAME_MS));\n  walkRAF = requestAnimationFrame(walkStep);\n}\n/* rAF runs at 60fps for a 14fps animation, so only touch the DOM when the frame\n   actually changes — four out of five wake-ups have nothing to do. */\nfunction paintWalkFrame(played){\n  if (played === walkFrame) return;\n  walkFrame = played;\n  var cell = walkCell(played), pos = cellPos(cell);\n  el(\"walkpet\").style.backgroundPosition = pos.x.toFixed(3) + \"% \" + pos.y.toFixed(3) + \"%\";\n  var sc = (el(\"walker\").clientWidth || 210) / 400;\n  SLOT_ORDER.forEach(function(slot){\n    var img = el(\"wacc_\" + slot);\n    if (img.style.display !== \"none\" && W[slot]) img.style.transform = accTransform(played, slot, W[slot], sc);\n  });\n  var sm = el(\"wsmudge\");\n  if (sm.style.display !== \"none\") sm.style.transform = accTransform(played, \"eyes\", \"_smudge\", sc);\n}\nfunction clearAccTransforms(){\n  SLOT_ORDER.forEach(function(slot){ el(\"wacc_\" + slot).style.transform = \"\"; });\n  el(\"wsmudge\").style.transform = \"\";\n}\n\nfunction walkTick(){\n  S.energy = Math.max(12, S.energy - 0.45);\n  S.happy = Math.min(100, S.happy + 0.35);\n  var mins = Math.floor((Date.now() - walkStart) / 60000);\n  el(\"walksteps\").textContent = mins < 1 ? \"out for a stroll…\" : mins + \" min stroll · \" + findCount + \" finds\";\n  if (S.energy <= 20){ endWalk(true); return; }\n  maybeFind(Date.now(), Math.random);\n  save();\n}\n\nfunction maybeFind(now, rng){\n  if (now - lastFind < 16000) return null;\n  if (rng() > 0.4) return null;\n  lastFind = now;\n  var pool = FINDS.filter(function(f){ return !f.rare || rng() < 0.18; });\n  var f = pool[Math.floor(rng() * pool.length)];\n  findCount++;\n  S.finds = (S.finds || 0) + 1;                 /* milestone: treasures found */\n  S.happy = Math.min(100, S.happy + (f.rare ? 8 : 3));\n  if (f.rare) S.hunger = Math.min(100, S.hunger + 10);\n  haptic(f.rare ? \"success\" : \"light\");\n  bubble(f.e + \" \" + f.t, 4200);\n  checkUnlocks();\n  return f;\n}\n\nfunction endWalk(tired){\n  if (!walking) return;\n  walking = false;\n  clearInterval(walkTimer); walkTimer = null;\n  stopCritters();\n  stopWalkAnim();\n  /* Drop the sheet's decoded surface — it's 2400x2400, and Mochi is indoors now.\n     The HTTP cache still has it, so the next walk starts just as fast. */\n  el(\"walkpet\").style.backgroundImage = \"\";\n  clearAccTransforms();\n  el(\"walkview\").classList.remove(\"show\");\n  syncChrome();\n  haptic(\"selection\");\n  render(); save();\n  bubble(tired ? esc(S.name) + \" got sleepy on the walk… 🥱\" :\n         \"That was lovely! \" + (findCount ? findCount + \" treasures found.\" : \"🌱\"), 4600);\n}\n\n/* MyLLM puts its bars back when the app is left; ask again on return. */\ndocument.addEventListener(\"visibilitychange\", function(){ if (!document.hidden && walking) syncChrome(); });\n\n/* ---------- ambient life: idle mutterings & dreams ---------- */\nvar CHATTER = {\n  happy:  [\"mochi mochi~ 🌱\",\"*hums a tiny song*\",\"today is a good day!\",\"*wiggles contentedly*\",\"(◕ᴗ◕)♪\",\"*watches a dust mote float by*\"],\n  hungry: [\"*tummy rumbles softly*\",\"...thinking about buns...\",\"is it snack time? 🍙\",\"*sniffs the air hopefully*\"],\n  lonely: [\"*looks up at you*\",\"play with me? 🥺\",\"*rolls the ball hopefully*\",\"*little sigh*\"],\n  sleepy: [\"*yawns a tiny yawn*\",\"...eyelids heavy...\",\"*blinks slowly* 🌙\",\"five more minutes of awake...\"]\n};\nvar DREAMS = [\"💭 🍙🍙🍙✨\",\"💭 bouncing on clouds…\",\"💭 ⚽🌈\",\"💭 a mountain of buns…\",\"💭 🫧🐟🫧\",\"💭 swimming in warm milk…\",\"💭 🌙⭐️ tiny star friends…\",\"💭 the great bun in the sky…\"];\nvar lastAmbient = Date.now();\n\nfunction chatterMood(){\n  if (S.hunger < 35) return \"hungry\";\n  if (S.energy < 30) return \"sleepy\";\n  if (S.happy < 40) return \"lonely\";\n  return \"happy\";\n}\n\n/* Ambient tick — rng + now injectable so it's testable.\n   Returns what it did: null | \"dream\" | \"chatter\" | \"ai\" */\nfunction ambientTick(now, rng){\n  if (!S || !S.hatched || transient) return null;\n  var gap = now - lastAmbient;\n  /* Dreams come easier than chatter: a sleeping pet dreams within ~30-60s and\n     roughly every minute after; awake mutterings stay rarer (~1.5-2.5 min). */\n  var minGap = S.sleeping ? 22000 : 40000;\n  var ramp   = S.sleeping ? 45000 : 110000;\n  if (gap < minGap) return null;\n  if (rng() > Math.min(0.9, (gap - minGap) / ramp)) return null;\n  lastAmbient = now;\n  if (S.sleeping){\n    bubble(DREAMS[Math.floor(rng() * DREAMS.length)], 5600, true);\n    return \"dream\";\n  }\n  var pool = CHATTER[chatterMood()];\n  if (ASK && rng() < 0.3){\n    var vibe = chatterMood();\n    ASK(\"You are \" + S.name + \", a tiny pet blob creature feeling \" + vibe + \". \" +\n        \"Say ONE spontaneous cute little thought, max 9 words, babyish, may use one emoji. \" +\n        \"Just the thought, nothing else.\")\n      .then(function(r){\n        var line = String(r||\"\").split(\"\\n\")[0].replace(/^[\"']|[\"']$/g, \"\").trim();\n        bubble(line && line.length <= 90 ? line : pool[0], 5200);\n      })\n      .catch(function(){ bubble(pool[Math.floor(rng() * pool.length)], 5200); });\n    return \"ai\";\n  }\n  bubble(pool[Math.floor(rng() * pool.length)], 5200);\n  return \"chatter\";\n}\n\nsetInterval(function(){ ambientTick(Date.now(), Math.random); }, 9000);\n/* Opening the app onto a sleeping pet shouldn't mean a long wait for the\n   first dream — start the clock most of the way there. */\nlastAmbient = Date.now() - 15000;\n\nel(\"say\").addEventListener(\"keydown\", function(e){ if (e.key === \"Enter\") talk(); });\nel(\"petbox\").addEventListener(\"click\", stageTap);\n/* Belt and braces against double-tap zoom and pinch in the web view. */\ndocument.addEventListener(\"dblclick\", function(e){ e.preventDefault(); }, { passive:false });\ndocument.addEventListener(\"gesturestart\", function(e){ e.preventDefault(); }, { passive:false });\n\n/* Feed: a quick tap gives the default snack; press-and-hold opens the picker.\n   Pointer events give one unified path (no touch/mouse double-fire in WKWebView). */\n(function(){\n  var fb = el(\"feedBtn\"), timer = null, held = false;\n  fb.addEventListener(\"pointerdown\", function(){\n    held = false;\n    timer = setTimeout(function(){ held = true; haptic(\"medium\"); openFoodMenu(); }, 450);\n  });\n  fb.addEventListener(\"pointerup\", function(){\n    clearTimeout(timer);\n    if (!held) feed();\n  });\n  fb.addEventListener(\"pointerleave\", function(){ clearTimeout(timer); });\n  fb.addEventListener(\"pointercancel\", function(){ clearTimeout(timer); });\n})();\n\n/* ---------- wardrobe logic ---------- */\nfunction saveWard(){ store.setItem(\"mochi_wardrobe\", JSON.stringify(W)); }\n\n/* Point the six overlay <img>s (3 stage + 3 walk) at whatever's equipped, or\n   hide them. Gated on hatched so a bare egg never wears a hat. */\nfunction applyAccessories(){\n  SLOT_ORDER.forEach(function(slot){\n    var id = (S && S.hatched) ? W[slot] : null;\n    var a = el(\"acc_\" + slot), wa = el(\"wacc_\" + slot);\n    if (id){\n      a.src = ACC_BASE + id + \".png\";      a.style.display = \"block\";\n      wa.src = ACC_BASE + id + \"_w.png\";   wa.style.display = \"block\";\n    } else {\n      a.style.display = \"none\";\n      wa.style.display = \"none\";\n      wa.style.transform = \"\";\n    }\n  });\n  /* A change of outfit mid-stroll must not wait for the next frame tick to be\n     placed on the head — repaint the current one. */\n  if (walking && walkRAF){ var f = walkFrame; walkFrame = -1; paintWalkFrame(f < 0 ? 0 : f); }\n}\n\nfunction daysTogether(){ return Math.max(1, Math.ceil((Date.now() - (S ? S.born : Date.now())) / 86400000)); }\nfunction label(id){ var c = CATALOG.filter(function(x){ return x.id === id; })[0]; return c ? c.name : id; }\n\n/* Starters (not in UNLOCKS) are always available; a gated item is available\n   only once its milestone has been reached and recorded in S.unlocked. */\nfunction isUnlocked(id){\n  if (!(id in UNLOCKS)) return true;\n  return !!(S && S.unlocked && S.unlocked.indexOf(id) >= 0);\n}\n\n/* Award any newly-earned items. silent=true at boot (retroactive, no fanfare);\n   silent=false during play so a fresh unlock is celebrated once. */\nfunction checkUnlocks(silent){\n  if (!S || !S.hatched) return;\n  if (!S.unlocked) S.unlocked = [];\n  if (S.happy >= 100) S.maxHappy = true;     /* latch: \"reached 100 once\" */\n  var newly = [];\n  for (var id in UNLOCKS){\n    if (S.unlocked.indexOf(id) < 0 && UNLOCKS[id].test(S)){\n      S.unlocked.push(id);\n      newly.push(id);\n    }\n  }\n  if (newly.length){\n    save();\n    if (el(\"wardrobe\").classList.contains(\"show\")) renderWardrobe();\n    if (!silent){\n      haptic(\"success\");\n      bubble(\"🎉 Unlocked \" + label(newly[0]) + \"! It's in the 👒 wardrobe.\", 5200);\n    }\n  }\n}\n\nfunction equip(slot, id){\n  if (id && !isUnlocked(id)){                /* tapped a locked item — show how to earn it */\n    haptic(\"warning\");\n    var u = UNLOCKS[id];\n    bubble(\"🔒 \" + (u ? u.hint : \"Locked\"), 4200);\n    return;\n  }\n  W[slot] = (W[slot] === id) ? null : id;    /* tapping the worn one takes it off */\n  haptic(\"selection\");\n  applyAccessories();\n  renderWardrobe();\n  saveWard();\n}\n\nfunction chipHTML(slot, id, name, on){\n  var locked = id && !isUnlocked(id);\n  var inner = id ? '<img src=\"' + ACC_BASE + id + '_chip.png\" alt=\"\">'\n                 : '<span class=\"none\">🚫</span>';\n  if (locked) inner += '<span class=\"lock\">🔒</span>';\n  var arg = id ? \"'\" + id + \"'\" : \"null\";\n  return '<button class=\"chip' + (on ? ' on' : '') + (locked ? ' locked' : '') +\n         '\" onclick=\"equip(\\'' + slot + '\\',' + arg + ')\">' +\n         '<div class=\"thumb\">' + inner + '</div><span>' + esc(name) + '</span></button>';\n}\n\nfunction renderWardrobe(){\n  var html = \"\";\n  SLOT_ORDER.forEach(function(slot){\n    html += '<div class=\"wardslot\"><small>' + SLOT_NAME[slot] + '</small><div class=\"wardrow\">';\n    html += chipHTML(slot, null, \"None\", !W[slot]);\n    CATALOG.filter(function(c){ return c.slot === slot; }).forEach(function(c){\n      html += chipHTML(slot, c.id, c.label, W[slot] === c.id);\n    });\n    html += '</div></div>';\n  });\n  el(\"wardslots\").innerHTML = html;\n}\n\nfunction openWardrobe(){\n  if (!S || !S.hatched) return;\n  haptic(\"light\");\n  renderWardrobe();\n  el(\"wardrobe\").classList.add(\"show\");\n}\nfunction closeWardrobe(){ el(\"wardrobe\").classList.remove(\"show\"); }\n\n/* ---------- boot ---------- */\n(function boot(){\n  /* preload all loops so mood switches are instant */\n  Object.keys(ANIM).forEach(function(k){ new Image().src = ART + ANIM[k]; });\n  new Image().src = ART + \"anim_walk_t.webp\";     /* fallback loop, and old installs */\n  preloadSheet();\n  new Image().src = ART + \"walk_bg.jpg\";\n  new Image().src = SMUDGE; new Image().src = SMUDGE_W;\n  el(\"smudge\").src = SMUDGE; el(\"wsmudge\").src = SMUDGE_W;\n  buildFoodMenu();\n  buildTrack();\n  store.getItem(\"mochi_state\").then(function(v){\n    if (v){ try { S = JSON.parse(v); } catch(_){} }\n    if (!S || typeof S.hunger !== \"number\") S = fresh();\n    applyDecay();\n    return store.getItem(\"mochi_wardrobe\");\n  }).then(function(wv){\n    if (wv){ try { var w = JSON.parse(wv);\n      if (w) W = { head:w.head||null, eyes:w.eyes||null, neck:w.neck||null };\n    } catch(_){} }\n    /* a returning owner gets a welcome-back, not a guilt trip */\n    applyAccessories();\n    applyMessy();\n    checkUnlocks(true);   /* retroactively grant anything already earned, quietly */\n    render(); save();\n    setInterval(function(){ applyDecay(); checkUnlocks(false); render(); save(); }, 30000);\n    /* one-time nudge so people discover the snack picker */\n    store.getItem(\"mochi_food_tip\").then(function(seen){\n      if (!seen && S && S.hatched){\n        store.setItem(\"mochi_food_tip\", \"1\");\n        setTimeout(function(){ if (!S.sleeping) bubble(\"Tip: press & hold 🍙 Feed to pick a snack!\", 5200); }, 4200);\n      }\n    });\n  });\n})();\n</script>\n</body>\n</html>\n"}