{"name": "Mochi", "kind": "html", "iconSymbol": "pawprint.fill", "iconColor": "mint", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Mochi</title>\n<style>\n  :root { color-scheme: light; }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:linear-gradient(180deg,#fdf6ec 0%,#f7ede0 100%);\n    color:#4a4238;\n    max-width:600px; margin:0 auto; min-height:100dvh;\n    padding:14px 14px calc(24px + env(safe-area-inset-bottom));\n    display:flex; flex-direction:column;\n  }\n  .top{ display:flex; align-items:baseline; justify-content:space-between; margin:2px 4px 6px; }\n  h1{ font-size:20px; font-weight:800; }\n  .age{ font-size:12.5px; color:#a89a88; font-weight:650; }\n\n  .bars{ display:grid; grid-template-columns:1fr 1fr 1fr 1fr; gap:8px; margin-bottom:10px; }\n  .bar{ background:#fffdf8; border:1.5px solid #eadfce; border-radius:12px; padding:7px 9px; }\n  .bar small{ font-size:10.5px; font-weight:750; color:#a89a88; display:flex; justify-content:space-between; }\n  .bar .track{ height:7px; border-radius:99px; background:#f1e7d6; margin-top:5px; overflow:hidden; }\n  .bar .fill{ height:100%; border-radius:99px; background:#8fd3a8; transition:width .6s, background .6s; }\n  .bar .fill.low{ background:#f2a65e; } .bar .fill.crit{ background:#e8806e; }\n\n  .stage{ position:relative; flex:1; min-height:280px; display:flex; align-items:center; justify-content:center; }\n  .stage img{ width:min(78vw,340px); height:auto; border-radius:26px; }\n  .stage.sleeping img{ filter:brightness(.82) saturate(.85); }\n  .bubble{\n    position:absolute; top:2px; left:50%; transform:translateX(-50%) translateY(-6px);\n    max-width:88%; background:#fffdf8; border:2px solid #eadfce; border-radius:16px;\n    padding:10px 14px; font-size:14.5px; line-height:1.45; opacity:0;\n    transition:opacity .3s, transform .3s; pointer-events:none;\n  }\n  .bubble.show{ opacity:1; transform:translateX(-50%) translateY(0); animation:bpop .38s cubic-bezier(.34,1.56,.64,1); }\n  @keyframes bpop{ 0%{ transform:translateX(-50%) translateY(6px) scale(.82); } 70%{ transform:translateX(-50%) translateY(-2px) scale(1.04); } 100%{ transform:translateX(-50%) translateY(0) scale(1); } }\n  .bubble.dream.show{ animation:bdrift 5.5s ease-in-out both; }\n  @keyframes bdrift{ 0%{ opacity:0; transform:translateX(-50%) translateY(10px) scale(.85); } 12%{ opacity:1; transform:translateX(-50%) translateY(0) scale(1); } 88%{ opacity:1; transform:translateX(-50%) translateY(-10px) rotate(1.5deg); } 100%{ opacity:0; transform:translateX(-50%) translateY(-18px); } }\n  .bubble::after{\n    content:\"\"; position:absolute; bottom:-9px; left:50%; margin-left:-7px;\n    border:7px solid transparent; border-top-color:#eadfce; border-bottom:none;\n  }\n  .bubble.dream{\n    background:#f4f1fb; border-color:#ddd6f0; border-style:dashed;\n    font-style:italic; color:#7a6f95; border-radius:22px;\n  }\n  .bubble.dream::after{ display:none; }\n  .bubble.dream::before{\n    content:\"\"; position:absolute; bottom:-16px; left:50%; margin-left:-14px;\n    width:10px; height:10px; border-radius:50%; background:#f4f1fb;\n    border:2px dashed #ddd6f0;\n    box-shadow:16px 8px 0 -3px #f4f1fb, 16px 8px 0 -1px #ddd6f0;\n  }\n  .hint{ text-align:center; font-size:13px; color:#a89a88; margin:4px 0 8px; min-height:18px; }\n\n  .actions{ display:grid; grid-template-columns:1fr 1fr 1fr 1fr; gap:9px; margin-bottom:10px; }\n  .actions button{\n    border:2px solid #eadfce; background:#fffdf8; color:#4a4238;\n    border-radius:15px; padding:11px 4px 9px; font-size:12px; font-weight:750;\n  }\n  .actions button .ico{ display:block; font-size:22px; margin-bottom:2px; }\n  .actions button:disabled{ opacity:.4; }\n\n  .chatrow{ display:flex; gap:8px; }\n  .chatrow input{\n    flex:1; font-size:16px; padding:11px 13px; border-radius:14px;\n    border:2px solid #eadfce; background:#fffdf8; color:#4a4238;\n  }\n  .chatrow button{ border:none; border-radius:14px; width:46px; font-size:17px; background:#8fd3a8; color:#fff; }\n\n  /* walk mode */\n  .walkview{ position:fixed; inset:0; background:linear-gradient(180deg,#fdf6ec 0%,#f3ecdd 100%); display:none; flex-direction:column; z-index:8; }\n  .walkview.show{ display:flex; }\n  .walkview .sky{ flex:1; }\n  .walkscene{ position:relative; height:62%; overflow:hidden; }\n  .walktrack{ position:absolute; bottom:0; left:0; height:100%; display:flex; width:max-content; animation:scroll 26s linear infinite; }\n  .walktrack img{ height:100%; width:auto; display:block; }\n  .walktrack img.flip{ transform:scaleX(-1); }\n  @keyframes scroll{ from{ transform:translateX(0); } to{ transform:translateX(-50%); } }\n  .walker{ position:absolute; left:50%; bottom:6%; transform:translateX(-50%); width:min(46vw,210px); animation:bob 0.62s ease-in-out infinite alternate; }\n  @keyframes bob{ from{ transform:translateX(-50%) translateY(0) rotate(-1.2deg); } to{ transform:translateX(-50%) translateY(-7px) rotate(1.2deg); } }\n  .walker img{ width:100%; border-radius:22px; }\n  .wbubble-wrap{ position:absolute; top:8px; left:0; right:0; display:flex; justify-content:center; }\n  .walkhud{ display:flex; justify-content:space-between; align-items:center; padding:14px 16px calc(16px + env(safe-area-inset-bottom)); }\n  .walkhud .steps{ font-size:13px; color:#a89a88; font-weight:700; }\n  .walkhud button{ border:2px solid #eadfce; background:#fffdf8; color:#4a4238; border-radius:14px; padding:11px 18px; font-size:14px; font-weight:750; }\n\n  .namer{ position:fixed; inset:0; background:rgba(74,66,56,.35); display:none; align-items:center; justify-content:center; z-index:9; }\n  .namer.show{ display:flex; }\n  .namecard{ background:#fffdf8; border-radius:22px; padding:22px; width:min(84vw,340px); text-align:center; }\n  .namecard h2{ font-size:19px; margin-bottom:6px; }\n  .namecard p{ font-size:13.5px; color:#a89a88; margin-bottom:14px; line-height:1.5; }\n  .namecard input{ width:100%; font-size:17px; text-align:center; padding:11px; border-radius:13px; border:2px solid #eadfce; background:#fdf6ec; color:#4a4238; }\n  .namecard button{ width:100%; border:none; border-radius:13px; padding:13px; margin-top:12px; font-size:15px; font-weight:750; background:#8fd3a8; color:#fff; }\n</style>\n</head>\n<body>\n\n<div class=\"top\">\n  <h1 id=\"title\">🥚 A little egg</h1>\n  <span class=\"age\" id=\"age\"></span>\n</div>\n\n<div class=\"bars\" id=\"bars\" style=\"display:none\">\n  <div class=\"bar\"><small>🍙 Food <span id=\"vHunger\"></span></small><div class=\"track\"><div class=\"fill\" id=\"bHunger\"></div></div></div>\n  <div class=\"bar\"><small>💖 Happy <span id=\"vHappy\"></span></small><div class=\"track\"><div class=\"fill\" id=\"bHappy\"></div></div></div>\n  <div class=\"bar\"><small>⚡ Energy <span id=\"vEnergy\"></span></small><div class=\"track\"><div class=\"fill\" id=\"bEnergy\"></div></div></div>\n  <div class=\"bar\"><small>🫧 Clean <span id=\"vClean\"></span></small><div class=\"track\"><div class=\"fill\" id=\"bClean\"></div></div></div>\n</div>\n\n<div class=\"stage\" id=\"stage\">\n  <div class=\"bubble\" id=\"bubble\"></div>\n  <img id=\"pet\" src=\"\" alt=\"Your pet\">\n</div>\n<p class=\"hint\" id=\"hint\"></p>\n\n<div class=\"actions\" id=\"actions\" style=\"display:none; grid-template-columns:repeat(5,1fr);\">\n  <button onclick=\"feed()\"><span class=\"ico\">🍙</span>Feed</button>\n  <button onclick=\"play()\" id=\"playBtn\"><span class=\"ico\">⚽</span>Play</button>\n  <button onclick=\"bath()\"><span class=\"ico\">🫧</span>Bath</button>\n  <button onclick=\"startWalk()\" id=\"walkBtn\"><span class=\"ico\">🌼</span>Walk</button>\n  <button onclick=\"toggleSleep()\" id=\"sleepBtn\"><span class=\"ico\">🌙</span>Sleep</button>\n</div>\n\n<div class=\"walkview\" id=\"walkview\">\n  <div class=\"sky\"></div>\n  <div class=\"walkscene\">\n    <div class=\"walktrack\" id=\"walktrack\"></div>\n    <div class=\"wbubble-wrap\"><div class=\"bubble\" id=\"wbubble\" style=\"position:relative; top:0;\"></div></div>\n    <div class=\"walker\"><img id=\"walkpet\" alt=\"\"></div>\n  </div>\n  <div class=\"walkhud\">\n    <span class=\"steps\" id=\"walksteps\"></span>\n    <button onclick=\"endWalk(false)\">🏠 Head home</button>\n  </div>\n</div>\n\n<div class=\"chatrow\" id=\"chatrow\" style=\"display:none\">\n  <input id=\"say\" type=\"text\" autocomplete=\"off\" placeholder=\"Say something…\">\n  <button onclick=\"talk()\">💬</button>\n</div>\n\n<div class=\"namer\" id=\"namer\">\n  <div class=\"namecard\">\n    <h2>It hatched! 🐣</h2>\n    <p>A tiny mochi blinks up at you.<br>What will you call it?</p>\n    <input id=\"nameInput\" maxlength=\"16\" placeholder=\"Mochi\">\n    <button onclick=\"setName()\">That's the one</button>\n  </div>\n</div>\n\n<script>\nvar ASK = window.myllmAsk || null;\nvar store = window.myllmStorage || {getItem:function(){return Promise.resolve(null)}, setItem:function(){return Promise.resolve()}};\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s==null?'':s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\"); }\n\nvar ART = \"https://raw.githubusercontent.com/TeamDzX/myllm-assets/main/apps/mochi/\";\nvar ANIM = { egg:\"anim_egg.webp\", hatch:\"anim_hatch.webp\", idle:\"anim_idle2.webp\",\n             happy:\"anim_happy.webp\", eat:\"anim_eat.webp\", sleep:\"anim_sleep.webp\",\n             sad:\"anim_sad.webp\", bath:\"anim_bath.webp\", play:\"anim_play.webp\",\n             walk:\"anim_walk.webp\", pet:\"anim_pet.webp\" };\n\n/* ---------- state ---------- */\nvar S = null;    /* {name, hatched, tapCount, born, last, hunger, happy, energy, clean, sleeping} */\nvar transient = null, transientTimer = null;\nvar HOUR = 3600000;\n\nfunction fresh(){\n  return { name:null, hatched:false, tapCount:0, born:Date.now(), last:Date.now(),\n           hunger:80, happy:80, energy:90, clean:90, sleeping:false };\n}\n\n/* Kind decay: stats drift down over real time but floor at 12 — Mochi can get\n   hungry and mopey, never worse. While sleeping, energy recovers instead. */\nfunction applyDecay(){\n  var now = Date.now();\n  var hrs = Math.min(72, (now - S.last) / HOUR);\n  if (hrs <= 0){ S.last = now; return; }\n  var floor = function(v){ return Math.max(12, v); };\n  S.hunger = floor(S.hunger - hrs * 6);\n  S.clean  = floor(S.clean  - hrs * 3);\n  if (S.sleeping){\n    S.energy = Math.min(100, S.energy + hrs * 18);\n    S.happy  = floor(S.happy - hrs * 2);\n    if (S.energy >= 100) S.sleeping = false;   /* fully rested — woke up on its own */\n  } else {\n    S.energy = floor(S.energy - hrs * 4);\n    S.happy  = floor(S.happy - hrs * 4);\n  }\n  S.last = now;\n}\n\nfunction mood(){\n  if (!S.hatched) return \"egg\";\n  if (transient) return transient;\n  if (S.sleeping) return \"sleep\";\n  if (S.hunger < 30 || S.happy < 30 || S.clean < 25 || S.energy < 20) return \"sad\";\n  return \"idle\";\n}\n\nfunction moodHint(){\n  if (!S.hatched) return \"Tap the egg…\";\n  if (S.sleeping) return esc(S.name) + \" is snoozing. Tap to wake gently.\";\n  if (S.hunger < 30) return esc(S.name) + \" is peckish… 🍙\";\n  if (S.clean < 25) return esc(S.name) + \" could use a bath. 🫧\";\n  if (S.energy < 20) return esc(S.name) + \" is sleepy. 🌙\";\n  if (S.happy < 30) return esc(S.name) + \" wants to play! ⚽\";\n  return \"\";\n}\n\nfunction save(){ store.setItem(\"mochi_state\", JSON.stringify(S)); }\n\n/* ---------- rendering ---------- */\nfunction render(){\n  var m = mood();\n  el(\"pet\").src = ART + ANIM[m];\n  el(\"stage\").className = \"stage\" + (S.sleeping && !transient ? \" sleeping\" : \"\");\n  el(\"hint\").textContent = moodHint();\n  if (S.hatched){\n    el(\"title\").textContent = \"🐣 \" + S.name;\n    var days = Math.max(1, Math.ceil((Date.now() - S.born) / 86400000));\n    el(\"age\").textContent = \"Day \" + days + \" together\";\n    el(\"bars\").style.display = \"grid\";\n    el(\"actions\").style.display = \"grid\";\n    el(\"chatrow\").style.display = \"flex\";\n    bar(\"Hunger\", S.hunger); bar(\"Happy\", S.happy); bar(\"Energy\", S.energy); bar(\"Clean\", S.clean);\n    el(\"sleepBtn\").innerHTML = S.sleeping ? '<span class=\"ico\">☀️</span>Wake' : '<span class=\"ico\">🌙</span>Sleep';\n    el(\"playBtn\").disabled = S.sleeping;\n  }\n}\n\nfunction bar(key, v){\n  v = Math.round(v);\n  var f = el(\"b\" + key);\n  f.style.width = v + \"%\";\n  f.className = \"fill\" + (v < 25 ? \" crit\" : v < 45 ? \" low\" : \"\");\n  el(\"v\" + key).textContent = v;\n}\n\nfunction pulse(anim, ms){\n  transient = anim;\n  clearTimeout(transientTimer);\n  transientTimer = setTimeout(function(){ transient = null; render(); save(); }, ms || 5200);\n  render();\n}\n\nfunction bubble(text, ms, dreamy){\n  var b = el(walking ? \"wbubble\" : \"bubble\");\n  b.textContent = text;\n  b.className = \"bubble show\" + (dreamy ? \" dream\" : \"\");\n  if (!dreamy && !walking) b.style.left = (42 + Math.random() * 16) + \"%\";\n  clearTimeout(b._t);\n  b._t = setTimeout(function(){ b.classList.remove(\"show\"); }, ms || 4200);\n}\n\n/* ---------- actions ---------- */\nfunction feed(){\n  if (S.sleeping){ bubble(\"Shh — \" + S.name + \" is sleeping.\"); return; }\n  haptic(\"light\");\n  S.hunger = Math.min(100, S.hunger + 32);\n  S.happy = Math.min(100, S.happy + 4);\n  pulse(\"eat\", 5600); save();\n}\nfunction play(){\n  if (S.sleeping) return;\n  haptic(\"light\");\n  S.happy = Math.min(100, S.happy + 26);\n  S.energy = Math.max(5, S.energy - 10);\n  S.hunger = Math.max(12, S.hunger - 5);\n  pulse(\"play\", 5600); save();\n}\nfunction bath(){\n  if (S.sleeping){ bubble(\"Bathtime after nap time.\"); return; }\n  haptic(\"light\");\n  S.clean = 100;\n  pulse(\"bath\", 5600); save();\n}\nfunction toggleSleep(){\n  haptic(\"selection\");\n  if (S.sleeping){\n    S.sleeping = false;\n    S.happy = Math.min(100, S.happy + 6);\n    pulse(\"happy\", 3800);\n  } else {\n    S.sleeping = true;\n    transient = null;\n  }\n  render(); save();\n}\n\n/* ---------- egg & hatching ---------- */\nfunction stageTap(){\n  if (!S.hatched){\n    S.tapCount++;\n    haptic(S.tapCount >= 3 ? \"success\" : \"light\");\n    if (S.tapCount >= 3){\n      S.hatched = true;\n      transient = \"hatch\";\n      el(\"pet\").src = ART + ANIM.hatch;\n      setTimeout(function(){ el(\"namer\").classList.add(\"show\"); }, 2600);\n    } else {\n      el(\"hint\").textContent = S.tapCount === 1 ? \"It wobbled!\" : \"Something's moving in there…\";\n      var p = el(\"pet\");\n      p.style.transition = \"transform .12s\";\n      p.style.transform = \"rotate(\" + (S.tapCount % 2 ? 4 : -4) + \"deg)\";\n      setTimeout(function(){ p.style.transform = \"\"; }, 140);\n    }\n    save();\n    return;\n  }\n  if (S.sleeping){ toggleSleep(); return; }\n  haptic(\"light\");\n  S.happy = Math.min(100, S.happy + 2);\n  pulse(\"pet\", 3400);          /* heart-eyes: being petted */\n  save();\n}\n\nfunction setName(){\n  var n = el(\"nameInput\").value.trim() || \"Mochi\";\n  S.name = n.slice(0, 16);\n  S.born = Date.now();\n  el(\"namer\").classList.remove(\"show\");\n  haptic(\"success\");\n  transient = null;\n  render(); save();\n  bubble(\"Hello! I'm \" + esc(S.name) + \"! 🌱\", 5000);\n}\n\n/* ---------- talking (the MyLLM twist) ---------- */\nvar CANNED = [\"mochi mochi! 🌱\",\"*happy wiggle*\",\"(◕ᴗ◕)\",\"*bounces softly*\",\"squeak!\",\"*does a tiny spin*\"];\n\nfunction talk(){\n  var t = el(\"say\").value.trim();\n  if (!t || !S.hatched) return;\n  el(\"say\").value = \"\";\n  haptic(\"light\");\n  if (S.sleeping){ bubble(\"…zzz…\"); return; }\n  if (!ASK){\n    bubble(CANNED[Math.floor(Math.random() * CANNED.length)]);\n    S.happy = Math.min(100, S.happy + 3); render(); save();\n    return;\n  }\n  var vibe = S.hunger < 30 ? \"hungry\" : S.happy < 30 ? \"a bit lonely\" : S.energy < 20 ? \"sleepy\" : \"happy and playful\";\n  var p = \"You are \" + S.name + \", a tiny newly-hatched pet blob creature. You are currently feeling \" + vibe + \".\\n\" +\n    \"Your owner says: \\\"\" + t + \"\\\"\\n\" +\n    \"Reply as \" + S.name + \" in ONE short, sweet sentence (max 12 words). Babyish, adorable, warm. \" +\n    \"You may use one emoji. Never break character, never mention being an AI.\";\n  ASK(p).then(function(r){\n    var line = String(r||\"\").split(\"\\n\")[0].replace(/^[\"']|[\"']$/g, \"\").trim();\n    if (!line || line.length > 120) line = CANNED[0];\n    bubble(line, 5200);\n    S.happy = Math.min(100, S.happy + 5);\n    pulse(\"happy\", 3600); save();\n  }).catch(function(){\n    bubble(CANNED[Math.floor(Math.random() * CANNED.length)]);\n  });\n}\n\n/* ---------- walk mode ---------- */\nvar walking = false, walkTimer = null, walkStart = 0, lastFind = 0, findCount = 0;\nvar FINDS = [\n  {e:\"🌼\", t:\"found a little flower!\"}, {e:\"🦋\", t:\"a butterfly friend!\"},\n  {e:\"🍄\", t:\"ooh, a tiny mushroom!\"}, {e:\"✨\", t:\"something sparkly!\"},\n  {e:\"🐌\", t:\"met a slow friend.\"}, {e:\"🍀\", t:\"a lucky clover!\"},\n  {e:\"🍙\", t:\"A WILD BUN!! nom.\", rare:true}\n];\n\nfunction startWalk(){\n  if (walking || !S.hatched) return;\n  if (S.sleeping){ bubble(\"Wake \" + esc(S.name) + \" up first. 🌙\"); return; }\n  if (S.energy < 25){ bubble(esc(S.name) + \" is too tired for a walk right now. 🌙\"); return; }\n  haptic(\"success\");\n  walking = true; walkStart = Date.now(); lastFind = Date.now(); findCount = 0;\n  var track = el(\"walktrack\");\n  if (!track.childElementCount){\n    /* palindrome tiling: strip + mirrored strip, scrolled 50% = seamless loop */\n    track.innerHTML = '<img src=\"' + ART + 'walk_bg.jpg\" alt=\"\">' +\n                      '<img class=\"flip\" src=\"' + ART + 'walk_bg.jpg\" alt=\"\">' +\n                      '<img src=\"' + ART + 'walk_bg.jpg\" alt=\"\">' +\n                      '<img class=\"flip\" src=\"' + ART + 'walk_bg.jpg\" alt=\"\">';\n  }\n  el(\"walkpet\").src = ART + ANIM.walk;\n  el(\"walkview\").classList.add(\"show\");\n  el(\"walksteps\").textContent = \"\";\n  walkTimer = setInterval(walkTick, 5000);\n  bubble(\"*waddle waddle*\", 3200);\n}\n\nfunction walkTick(){\n  S.energy = Math.max(12, S.energy - 0.45);\n  S.happy = Math.min(100, S.happy + 0.35);\n  var mins = Math.floor((Date.now() - walkStart) / 60000);\n  el(\"walksteps\").textContent = mins < 1 ? \"out for a stroll…\" : mins + \" min stroll · \" + findCount + \" finds\";\n  if (S.energy <= 20){ endWalk(true); return; }\n  maybeFind(Date.now(), Math.random);\n  save();\n}\n\nfunction maybeFind(now, rng){\n  if (now - lastFind < 16000) return null;\n  if (rng() > 0.4) return null;\n  lastFind = now;\n  var pool = FINDS.filter(function(f){ return !f.rare || rng() < 0.18; });\n  var f = pool[Math.floor(rng() * pool.length)];\n  findCount++;\n  S.happy = Math.min(100, S.happy + (f.rare ? 8 : 3));\n  if (f.rare) S.hunger = Math.min(100, S.hunger + 10);\n  haptic(f.rare ? \"success\" : \"light\");\n  bubble(f.e + \" \" + f.t, 4200);\n  return f;\n}\n\nfunction endWalk(tired){\n  if (!walking) return;\n  walking = false;\n  clearInterval(walkTimer); walkTimer = null;\n  el(\"walkview\").classList.remove(\"show\");\n  haptic(\"selection\");\n  render(); save();\n  bubble(tired ? esc(S.name) + \" got sleepy on the walk… 🥱\" :\n         \"That was lovely! \" + (findCount ? findCount + \" treasures found.\" : \"🌱\"), 4600);\n}\n\n/* ---------- ambient life: idle mutterings & dreams ---------- */\nvar CHATTER = {\n  happy:  [\"mochi mochi~ 🌱\",\"*hums a tiny song*\",\"today is a good day!\",\"*wiggles contentedly*\",\"(◕ᴗ◕)♪\",\"*watches a dust mote float by*\"],\n  hungry: [\"*tummy rumbles softly*\",\"...thinking about buns...\",\"is it snack time? 🍙\",\"*sniffs the air hopefully*\"],\n  lonely: [\"*looks up at you*\",\"play with me? 🥺\",\"*rolls the ball hopefully*\",\"*little sigh*\"],\n  sleepy: [\"*yawns a tiny yawn*\",\"...eyelids heavy...\",\"*blinks slowly* 🌙\",\"five more minutes of awake...\"]\n};\nvar DREAMS = [\"💭 🍙🍙🍙✨\",\"💭 bouncing on clouds…\",\"💭 ⚽🌈\",\"💭 a mountain of buns…\",\"💭 🫧🐟🫧\",\"💭 swimming in warm milk…\",\"💭 🌙⭐️ tiny star friends…\",\"💭 the great bun in the sky…\"];\nvar lastAmbient = Date.now();\n\nfunction chatterMood(){\n  if (S.hunger < 35) return \"hungry\";\n  if (S.energy < 30) return \"sleepy\";\n  if (S.happy < 40) return \"lonely\";\n  return \"happy\";\n}\n\n/* Ambient tick — rng + now injectable so it's testable.\n   Returns what it did: null | \"dream\" | \"chatter\" | \"ai\" */\nfunction ambientTick(now, rng){\n  if (!S || !S.hatched || transient) return null;\n  var gap = now - lastAmbient;\n  /* Dreams come easier than chatter: a sleeping pet dreams within ~30-60s and\n     roughly every minute after; awake mutterings stay rarer (~1.5-2.5 min). */\n  var minGap = S.sleeping ? 22000 : 40000;\n  var ramp   = S.sleeping ? 45000 : 110000;\n  if (gap < minGap) return null;\n  if (rng() > Math.min(0.9, (gap - minGap) / ramp)) return null;\n  lastAmbient = now;\n  if (S.sleeping){\n    bubble(DREAMS[Math.floor(rng() * DREAMS.length)], 5600, true);\n    return \"dream\";\n  }\n  var pool = CHATTER[chatterMood()];\n  if (ASK && rng() < 0.3){\n    var vibe = chatterMood();\n    ASK(\"You are \" + S.name + \", a tiny pet blob creature feeling \" + vibe + \". \" +\n        \"Say ONE spontaneous cute little thought, max 9 words, babyish, may use one emoji. \" +\n        \"Just the thought, nothing else.\")\n      .then(function(r){\n        var line = String(r||\"\").split(\"\\n\")[0].replace(/^[\"']|[\"']$/g, \"\").trim();\n        bubble(line && line.length <= 90 ? line : pool[0], 5200);\n      })\n      .catch(function(){ bubble(pool[Math.floor(rng() * pool.length)], 5200); });\n    return \"ai\";\n  }\n  bubble(pool[Math.floor(rng() * pool.length)], 5200);\n  return \"chatter\";\n}\n\nsetInterval(function(){ ambientTick(Date.now(), Math.random); }, 9000);\n/* Opening the app onto a sleeping pet shouldn't mean a long wait for the\n   first dream — start the clock most of the way there. */\nlastAmbient = Date.now() - 15000;\n\nel(\"say\").addEventListener(\"keydown\", function(e){ if (e.key === \"Enter\") talk(); });\nel(\"stage\").addEventListener(\"click\", stageTap);\n\n/* ---------- boot ---------- */\n(function boot(){\n  /* preload all loops so mood switches are instant */\n  Object.keys(ANIM).forEach(function(k){ new Image().src = ART + ANIM[k]; });\n  store.getItem(\"mochi_state\").then(function(v){\n    if (v){ try { S = JSON.parse(v); } catch(_){} }\n    if (!S || typeof S.hunger !== \"number\") S = fresh();\n    applyDecay();\n    /* a returning owner gets a welcome-back, not a guilt trip */\n    render(); save();\n    setInterval(function(){ applyDecay(); render(); save(); }, 30000);\n  });\n})();\n</script>\n</body>\n</html>\n"}