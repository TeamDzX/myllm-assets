{"name": "Mochi", "kind": "html", "iconSymbol": "pawprint.fill", "iconColor": "mint", "html": "<!doctype html>\n<!--\n  Mochi — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Mochi</title>\n<style>\n  :root { color-scheme: light; }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:linear-gradient(180deg,#fdf6ec 0%,#f7ede0 100%);\n    color:#4a4238;\n    max-width:600px; margin:0 auto; min-height:100dvh;\n    padding:14px 14px calc(24px + env(safe-area-inset-bottom));\n    display:flex; flex-direction:column;\n  }\n  .top{ display:flex; align-items:baseline; justify-content:space-between; margin:2px 4px 6px; }\n  h1{ font-size:20px; font-weight:800; }\n  .age{ font-size:12.5px; color:#a89a88; font-weight:650; }\n\n  .bars{ display:grid; grid-template-columns:1fr 1fr 1fr 1fr; gap:8px; margin-bottom:10px; }\n  .bar{ background:#fffdf8; border:1.5px solid #eadfce; border-radius:12px; padding:7px 9px; }\n  .bar small{ font-size:10.5px; font-weight:750; color:#a89a88; display:flex; justify-content:space-between; }\n  .bar .track{ height:7px; border-radius:99px; background:#f1e7d6; margin-top:5px; overflow:hidden; }\n  .bar .fill{ height:100%; border-radius:99px; background:#8fd3a8; transition:width .6s, background .6s; }\n  .bar .fill.low{ background:#f2a65e; } .bar .fill.crit{ background:#e8806e; }\n\n  .stage{ position:relative; flex:1; min-height:280px; display:flex; align-items:center; justify-content:center; }\n  .petbox{ position:relative; width:min(78vw,340px); }\n  .petbox #pet{ width:100%; height:auto; border-radius:26px; display:block; }\n  /* Accessory overlays are taller than the sprite (extra band above the head so\n     hats aren't clipped) and bottom-aligned, so their pet-region maps 1:1 onto\n     the pet and the surplus sits above it. Placement is baked into each asset.\n     A gentle bob keeps them feeling attached to the breathing pet. */\n  .petbox .acc{ position:absolute; left:0; bottom:0; width:100%; height:auto; pointer-events:none;\n                animation:accbob 2.6s ease-in-out infinite alternate; }\n  @keyframes accbob{ from{ transform:translateY(0); } to{ transform:translateY(-3px); } }\n  .stage.sleeping img{ filter:brightness(.82) saturate(.85); }\n  .bubble{\n    position:absolute; top:2px; left:50%; transform:translateX(-50%) translateY(-6px);\n    max-width:88%; background:#fffdf8; border:2px solid #eadfce; border-radius:16px;\n    padding:10px 14px; font-size:14.5px; line-height:1.45; opacity:0;\n    transition:opacity .3s, transform .3s; pointer-events:none;\n  }\n  .bubble.show{ opacity:1; transform:translateX(-50%) translateY(0); animation:bpop .38s cubic-bezier(.34,1.56,.64,1); }\n  @keyframes bpop{ 0%{ transform:translateX(-50%) translateY(6px) scale(.82); } 70%{ transform:translateX(-50%) translateY(-2px) scale(1.04); } 100%{ transform:translateX(-50%) translateY(0) scale(1); } }\n  .bubble.dream.show{ animation:bdrift 5.5s ease-in-out both; }\n  @keyframes bdrift{ 0%{ opacity:0; transform:translateX(-50%) translateY(10px) scale(.85); } 12%{ opacity:1; transform:translateX(-50%) translateY(0) scale(1); } 88%{ opacity:1; transform:translateX(-50%) translateY(-10px) rotate(1.5deg); } 100%{ opacity:0; transform:translateX(-50%) translateY(-18px); } }\n  .bubble::after{\n    content:\"\"; position:absolute; bottom:-9px; left:50%; margin-left:-7px;\n    border:7px solid transparent; border-top-color:#eadfce; border-bottom:none;\n  }\n  .bubble.dream{\n    background:#f4f1fb; border-color:#ddd6f0; border-style:dashed;\n    font-style:italic; color:#7a6f95; border-radius:22px;\n  }\n  .bubble.dream::after{ display:none; }\n  .bubble.dream::before{\n    content:\"\"; position:absolute; bottom:-16px; left:50%; margin-left:-14px;\n    width:10px; height:10px; border-radius:50%; background:#f4f1fb;\n    border:2px dashed #ddd6f0;\n    box-shadow:16px 8px 0 -3px #f4f1fb, 16px 8px 0 -1px #ddd6f0;\n  }\n  .hint{ text-align:center; font-size:13px; color:#a89a88; margin:4px 0 8px; min-height:18px; }\n\n  .actions{ display:grid; grid-template-columns:1fr 1fr 1fr 1fr; gap:9px; margin-bottom:10px; }\n  .actions button{\n    border:2px solid #eadfce; background:#fffdf8; color:#4a4238;\n    border-radius:15px; padding:11px 4px 9px; font-size:12px; font-weight:750;\n    -webkit-user-select:none; user-select:none; -webkit-touch-callout:none;\n  }\n  .actions button .ico{ display:block; font-size:22px; margin-bottom:2px; }\n  .actions button:disabled{ opacity:.4; }\n\n  .chatrow{ display:flex; gap:8px; }\n  .chatrow input{\n    flex:1; font-size:16px; padding:11px 13px; border-radius:14px;\n    border:2px solid #eadfce; background:#fffdf8; color:#4a4238;\n  }\n  .chatrow button{ border:none; border-radius:14px; width:46px; font-size:17px; background:#8fd3a8; color:#fff; }\n\n  /* walk mode */\n  .walkview{ position:fixed; inset:0; background:linear-gradient(180deg,#fdf6ec 0%,#f3ecdd 100%); display:none; flex-direction:column; z-index:8; }\n  .walkview.show{ display:flex; }\n  .walkview .sky{ flex:1; }\n  .walkscene{ position:relative; height:62%; overflow:hidden; }\n  .walktrack{ position:absolute; bottom:0; left:0; height:100%; display:flex; width:max-content; animation:scroll 26s linear infinite; }\n  .walktrack img{ height:100%; width:auto; display:block; }\n  .walktrack img.flip{ transform:scaleX(-1); }\n  @keyframes scroll{ from{ transform:translateX(0); } to{ transform:translateX(-50%); } }\n  .walker{ position:absolute; left:50%; bottom:6%; transform:translateX(-50%); width:min(46vw,210px); animation:bob 0.62s ease-in-out infinite alternate; z-index:2; }\n  @keyframes bob{ from{ transform:translateX(-50%) translateY(0) rotate(-1.2deg); } to{ transform:translateX(-50%) translateY(-7px) rotate(1.2deg); } }\n  .walker img{ width:100%; }\n  /* Walk accessories are children of .walker, so they inherit the waddle bob\n     for free — perfectly synced to the walk. Same tall/bottom-aligned overlay. */\n  .walker .wacc{ position:absolute; left:0; bottom:0; width:100%; height:auto; pointer-events:none; }\n  .wbubble-wrap{ position:absolute; top:8px; left:0; right:0; display:flex; justify-content:center; }\n  .critters{ position:absolute; inset:0; overflow:hidden; pointer-events:none; }\n  .critter{ position:absolute; left:-12%; will-change:transform; }\n  .critter span{ display:inline-block; animation:flutter 1.1s ease-in-out infinite alternate; }\n  .critter.back{ z-index:0; filter:saturate(.85) brightness(1.04); }\n  .critter.front{ z-index:3; }\n  @keyframes flutter{ from{ transform:translateY(0) rotate(-6deg); } to{ transform:translateY(-9px) rotate(6deg); } }\n  @keyframes drift{ from{ transform:translateX(0); } to{ transform:translateX(125vw); } }\n  .walkhud{ display:flex; justify-content:space-between; align-items:center; padding:14px 16px calc(16px + env(safe-area-inset-bottom)); }\n  .walkhud .steps{ font-size:13px; color:#a89a88; font-weight:700; }\n  .walkhud button{ border:2px solid #eadfce; background:#fffdf8; color:#4a4238; border-radius:14px; padding:11px 18px; font-size:14px; font-weight:750; }\n\n  /* wardrobe (dress-up) sheet */\n  .wardrobe{ position:fixed; inset:0; background:rgba(74,66,56,.35); display:none; align-items:flex-end; justify-content:center; z-index:9; }\n  .wardrobe.show{ display:flex; }\n  .wardcard{ background:#fffdf8; border-radius:22px 22px 0 0; padding:16px 16px calc(18px + env(safe-area-inset-bottom)); width:100%; max-width:600px; max-height:76dvh; overflow-y:auto; }\n  .wardhead{ display:flex; align-items:center; justify-content:space-between; margin-bottom:6px; }\n  .wardhead h2{ font-size:18px; }\n  .wardhead button{ border:none; background:#8fd3a8; color:#fff; border-radius:12px; padding:8px 16px; font-size:14px; font-weight:750; }\n  .wardslot{ margin-top:12px; }\n  .wardslot > small{ font-size:12px; font-weight:750; color:#a89a88; padding-left:2px; }\n  .wardrow{ display:flex; gap:9px; overflow-x:auto; padding:8px 2px 4px; -webkit-overflow-scrolling:touch; }\n  .chip{ flex:0 0 auto; width:70px; text-align:center; background:none; border:none; padding:0; cursor:pointer; }\n  .chip .thumb{ width:66px; height:66px; border-radius:16px; border:2px solid #eadfce; background:#fdf6ec;\n                display:flex; align-items:center; justify-content:center; overflow:hidden; }\n  .chip.on .thumb{ border-color:#8fd3a8; background:#eaf7ef; box-shadow:0 0 0 2px #8fd3a8 inset; }\n  .chip .thumb img{ width:100%; height:100%; object-fit:contain; }\n  .chip .thumb .none{ font-size:22px; color:#c9bda9; }\n  .chip span{ display:block; font-size:10.5px; font-weight:700; color:#a89a88; margin-top:3px; line-height:1.2; }\n  .chip.on span{ color:#5aa87a; }\n  .chip .thumb{ position:relative; }\n  .chip .lock{ position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-size:22px; }\n  .chip.locked .thumb img{ opacity:.32; filter:grayscale(1); }\n  .chip.locked span{ color:#c9bda9; }\n\n  /* food picker (long-press Feed) */\n  .foodmenu{ position:fixed; inset:0; background:rgba(74,66,56,.35); display:none; align-items:flex-end; justify-content:center; z-index:9; }\n  .foodmenu.show{ display:flex; }\n  .foodcard{ background:#fffdf8; border-radius:22px 22px 0 0; padding:16px 16px calc(18px + env(safe-area-inset-bottom)); width:100%; max-width:600px; }\n  .foodhead{ display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; }\n  .foodhead h2{ font-size:18px; }\n  .foodhead button{ border:none; background:#f1e7d6; color:#8a7d6a; width:30px; height:30px; border-radius:50%; font-size:15px; }\n  .foodgrid{ display:grid; grid-template-columns:repeat(4,1fr); gap:10px; }\n  .fooditem{ background:#fdf6ec; border:2px solid #eadfce; border-radius:16px; padding:12px 4px 10px; text-align:center; }\n  .fooditem .fe{ display:block; font-size:30px; margin-bottom:3px; }\n  .fooditem .fn{ font-size:11.5px; font-weight:750; color:#4a4238; }\n  .fooditem.fav{ border-color:#e8b06e; background:#fdf3e6; }\n  .fooditem .ft{ display:block; font-size:9px; color:#d98b3a; font-weight:800; margin-top:2px; letter-spacing:.3px; }\n\n  .namer{ position:fixed; inset:0; background:rgba(74,66,56,.35); display:none; align-items:center; justify-content:center; z-index:9; }\n  .namer.show{ display:flex; }\n  .namecard{ background:#fffdf8; border-radius:22px; padding:22px; width:min(84vw,340px); text-align:center; }\n  .namecard h2{ font-size:19px; margin-bottom:6px; }\n  .namecard p{ font-size:13.5px; color:#a89a88; margin-bottom:14px; line-height:1.5; }\n  .namecard input{ width:100%; font-size:17px; text-align:center; padding:11px; border-radius:13px; border:2px solid #eadfce; background:#fdf6ec; color:#4a4238; }\n  .namecard button{ width:100%; border:none; border-radius:13px; padding:13px; margin-top:12px; font-size:15px; font-weight:750; background:#8fd3a8; color:#fff; }\n</style>\n<style>:root{--build-id:\"b7e049fb00\";}</style>\n</head>\n<body>\n\n<div class=\"top\">\n  <h1 id=\"title\">🥚 A little egg</h1>\n  <span class=\"age\" id=\"age\"></span>\n</div>\n\n<div class=\"bars\" id=\"bars\" style=\"display:none\">\n  <div class=\"bar\"><small>🍙 Food <span id=\"vHunger\"></span></small><div class=\"track\"><div class=\"fill\" id=\"bHunger\"></div></div></div>\n  <div class=\"bar\"><small>💖 Happy <span id=\"vHappy\"></span></small><div class=\"track\"><div class=\"fill\" id=\"bHappy\"></div></div></div>\n  <div class=\"bar\"><small>⚡ Energy <span id=\"vEnergy\"></span></small><div class=\"track\"><div class=\"fill\" id=\"bEnergy\"></div></div></div>\n  <div class=\"bar\"><small>🫧 Clean <span id=\"vClean\"></span></small><div class=\"track\"><div class=\"fill\" id=\"bClean\"></div></div></div>\n</div>\n\n<div class=\"stage\" id=\"stage\">\n  <div class=\"bubble\" id=\"bubble\"></div>\n  <div class=\"petbox\" id=\"petbox\">\n    <img id=\"pet\" src=\"\" alt=\"Your pet\">\n    <img class=\"acc\" id=\"acc_head\" alt=\"\" style=\"display:none\">\n    <img class=\"acc\" id=\"acc_eyes\" alt=\"\" style=\"display:none\">\n    <img class=\"acc\" id=\"acc_neck\" alt=\"\" style=\"display:none\">\n    <img class=\"acc\" id=\"smudge\" alt=\"\" style=\"display:none\">\n  </div>\n</div>\n<p class=\"hint\" id=\"hint\"></p>\n\n<div class=\"actions\" id=\"actions\" style=\"display:none; grid-template-columns:repeat(6,1fr);\">\n  <button id=\"feedBtn\"><span class=\"ico\">🍙</span>Feed</button>\n  <button onclick=\"play()\" id=\"playBtn\"><span class=\"ico\">⚽</span>Play</button>\n  <button onclick=\"bath()\"><span class=\"ico\">🫧</span>Bath</button>\n  <button onclick=\"startWalk()\" id=\"walkBtn\"><span class=\"ico\">🌼</span>Walk</button>\n  <button onclick=\"toggleSleep()\" id=\"sleepBtn\"><span class=\"ico\">🌙</span>Sleep</button>\n  <button onclick=\"openWardrobe()\"><span class=\"ico\">👒</span>Style</button>\n</div>\n\n<div class=\"walkview\" id=\"walkview\">\n  <div class=\"sky\"></div>\n  <div class=\"walkscene\">\n    <div class=\"walktrack\" id=\"walktrack\"></div>\n    <div class=\"critters\" id=\"critters\"></div>\n    <div class=\"wbubble-wrap\"><div class=\"bubble\" id=\"wbubble\" style=\"position:relative; top:0;\"></div></div>\n    <div class=\"walker\">\n      <img id=\"walkpet\" alt=\"\">\n      <img class=\"wacc\" id=\"wacc_head\" alt=\"\" style=\"display:none\">\n      <img class=\"wacc\" id=\"wacc_eyes\" alt=\"\" style=\"display:none\">\n      <img class=\"wacc\" id=\"wacc_neck\" alt=\"\" style=\"display:none\">\n      <img class=\"wacc\" id=\"wsmudge\" alt=\"\" style=\"display:none\">\n    </div>\n  </div>\n  <div class=\"walkhud\">\n    <span class=\"steps\" id=\"walksteps\"></span>\n    <button onclick=\"endWalk(false)\">🏠 Head home</button>\n  </div>\n</div>\n\n<div class=\"chatrow\" id=\"chatrow\" style=\"display:none\">\n  <input id=\"say\" type=\"text\" autocomplete=\"off\" placeholder=\"Say something…\">\n  <button onclick=\"talk()\">💬</button>\n</div>\n\n<div class=\"namer\" id=\"namer\">\n  <div class=\"namecard\">\n    <h2>It hatched! 🐣</h2>\n    <p>A tiny mochi blinks up at you.<br>What will you call it?</p>\n    <input id=\"nameInput\" maxlength=\"16\" placeholder=\"Mochi\">\n    <button onclick=\"setName()\">That's the one</button>\n  </div>\n</div>\n\n<div class=\"wardrobe\" id=\"wardrobe\">\n  <div class=\"wardcard\">\n    <div class=\"wardhead\">\n      <h2>Dress up ✨</h2>\n      <button onclick=\"closeWardrobe()\">Done</button>\n    </div>\n    <div id=\"wardslots\"></div>\n  </div>\n</div>\n\n<div class=\"foodmenu\" id=\"foodmenu\">\n  <div class=\"foodcard\">\n    <div class=\"foodhead\">\n      <h2>Pick a snack 🍽️</h2>\n      <button onclick=\"closeFoodMenu()\">✕</button>\n    </div>\n    <div class=\"foodgrid\" id=\"foodgrid\"></div>\n  </div>\n</div>\n\n<script>\nvar ASK = window.myllmAsk || null;\nvar store = window.myllmStorage || {getItem:function(){return Promise.resolve(null)}, setItem:function(){return Promise.resolve()}};\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s==null?'':s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\"); }\n\nvar ART = \"https://raw.githubusercontent.com/TeamDzX/myllm-assets/main/apps/mochi/\";\nvar ANIM = { egg:\"anim_egg.webp\", hatch:\"anim_hatch.webp\", idle:\"anim_idle2.webp\",\n             happy:\"anim_happy.webp\", eat:\"anim_eat.webp\", sleep:\"anim_sleep.webp\",\n             sad:\"anim_sad.webp\", bath:\"anim_bath.webp\", play:\"anim_play.webp\",\n             walk:\"anim_walk.webp\", pet:\"anim_pet.webp\" };\n\n/* ---------- wardrobe ---------- */\n/* Accessories are pre-positioned 400x400 overlays: \"<id>.png\" sits over the\n   idle sprite, \"<id>_w.png\" over the walk sprite, \"<id>_chip.png\" is the picker\n   thumbnail. One item per slot; slots stack. */\nvar ACC_BASE = ART + \"acc/\";\nvar CATALOG = [\n  { id:\"beanie\",        slot:\"head\", label:\"Beanie\" },\n  { id:\"bucket_hat\",    slot:\"head\", label:\"Bucket\" },\n  { id:\"crown\",         slot:\"head\", label:\"Crown\" },\n  { id:\"flower\",        slot:\"head\", label:\"Flower\" },\n  { id:\"bow\",           slot:\"head\", label:\"Bow\" },\n  { id:\"sunglasses\",    slot:\"eyes\", label:\"Shades\" },\n  { id:\"heart_glasses\", slot:\"eyes\", label:\"Hearts\" },\n  { id:\"round_glasses\", slot:\"eyes\", label:\"Specs\" },\n  { id:\"bowtie\",        slot:\"neck\", label:\"Bow tie\" },\n  { id:\"chain\",         slot:\"neck\", label:\"Chain\" }\n];\nvar SLOT_ORDER = [\"head\",\"eyes\",\"neck\"];\nvar SLOT_NAME = { head:\"On the head\", eyes:\"Eyes\", neck:\"Neck\" };\nvar W = { head:null, eyes:null, neck:null };\n\n/* Milestone unlocks: one accessory per slot is unlocked from the start\n   (beanie/sunglasses/bowtie); the rest are earned by caring for Mochi. Each\n   entry is test(state)->bool + the hint shown while it's still locked. */\nvar UNLOCKS = {\n  bucket_hat:    { test:function(s){ return (s.walks||0) >= 1; },        hint:\"Go on your first walk 🌼\" },\n  flower:        { test:function(s){ return (s.finds||0) >= 10; },       hint:\"Find 10 treasures on walks 🌸\" },\n  crown:         { test:function(s){ return daysTogether() >= 7; },      hint:\"Spend 7 days together 👑\" },\n  bow:           { test:function(s){ return !!s.maxHappy; },             hint:\"Reach 100% happiness 🎀\" },\n  heart_glasses: { test:function(s){ return (s.chats||0) >= 10; },       hint:\"Chat with Mochi 10 times 💗\" },\n  round_glasses: { test:function(s){ return (s.plays||0) >= 15; },       hint:\"Play together 15 times 🤓\" },\n  chain:         { test:function(s){ return !!s.choc; },                 hint:\"Give Mochi its favourite treat 🍫\" }\n};\n\n/* ---------- state ---------- */\nvar S = null;    /* {name, hatched, tapCount, born, last, hunger, happy, energy, clean, sleeping} */\nvar transient = null, transientTimer = null;\nvar HOUR = 3600000;\n\nfunction fresh(){\n  return { name:null, hatched:false, tapCount:0, born:Date.now(), last:Date.now(),\n           hunger:80, happy:80, energy:90, clean:90, sleeping:false, messy:false,\n           walks:0, finds:0, plays:0, chats:0, choc:false, maxHappy:false, unlocked:[] };\n}\n\n/* Kind decay: stats drift down over real time but floor at 12 — Mochi can get\n   hungry and mopey, never worse. While sleeping, energy recovers instead. */\nfunction applyDecay(){\n  var now = Date.now();\n  var hrs = Math.min(72, (now - S.last) / HOUR);\n  if (hrs <= 0){ S.last = now; return; }\n  var floor = function(v){ return Math.max(12, v); };\n  S.hunger = floor(S.hunger - hrs * 6);\n  S.clean  = floor(S.clean  - hrs * 3);\n  if (S.sleeping){\n    S.energy = Math.min(100, S.energy + hrs * 18);\n    S.happy  = floor(S.happy - hrs * 2);\n    if (S.energy >= 100) S.sleeping = false;   /* fully rested — woke up on its own */\n  } else {\n    S.energy = floor(S.energy - hrs * 4);\n    S.happy  = floor(S.happy - hrs * 4);\n  }\n  S.last = now;\n}\n\nfunction mood(){\n  if (!S.hatched) return \"egg\";\n  if (transient) return transient;\n  if (S.sleeping) return \"sleep\";\n  if (S.hunger < 30 || S.happy < 30 || S.clean < 25 || S.energy < 20) return \"sad\";\n  return \"idle\";\n}\n\nfunction moodHint(){\n  if (!S.hatched) return \"Tap the egg…\";\n  if (S.sleeping) return esc(S.name) + \" is snoozing. Tap to wake gently.\";\n  if (S.messy) return esc(S.name) + \" has a chocolatey face — bath time! 🍫\";\n  if (S.hunger < 30) return esc(S.name) + \" is peckish… 🍙\";\n  if (S.clean < 25) return esc(S.name) + \" could use a bath. 🫧\";\n  if (S.energy < 20) return esc(S.name) + \" is sleepy. 🌙\";\n  if (S.happy < 30) return esc(S.name) + \" wants to play! ⚽\";\n  return \"\";\n}\n\nfunction save(){ store.setItem(\"mochi_state\", JSON.stringify(S)); }\n\n/* ---------- rendering ---------- */\nfunction render(){\n  var m = mood();\n  el(\"pet\").src = ART + ANIM[m];\n  el(\"stage\").className = \"stage\" + (S.sleeping && !transient ? \" sleeping\" : \"\");\n  el(\"hint\").textContent = moodHint();\n  if (S.hatched){\n    el(\"title\").textContent = \"🐣 \" + S.name;\n    var days = Math.max(1, Math.ceil((Date.now() - S.born) / 86400000));\n    el(\"age\").textContent = \"Day \" + days + \" together\";\n    el(\"bars\").style.display = \"grid\";\n    el(\"actions\").style.display = \"grid\";\n    el(\"chatrow\").style.display = \"flex\";\n    bar(\"Hunger\", S.hunger); bar(\"Happy\", S.happy); bar(\"Energy\", S.energy); bar(\"Clean\", S.clean);\n    el(\"sleepBtn\").innerHTML = S.sleeping ? '<span class=\"ico\">☀️</span>Wake' : '<span class=\"ico\">🌙</span>Sleep';\n    el(\"playBtn\").disabled = S.sleeping;\n  }\n}\n\nfunction bar(key, v){\n  v = Math.round(v);\n  var f = el(\"b\" + key);\n  f.style.width = v + \"%\";\n  f.className = \"fill\" + (v < 25 ? \" crit\" : v < 45 ? \" low\" : \"\");\n  el(\"v\" + key).textContent = v;\n}\n\nfunction pulse(anim, ms){\n  transient = anim;\n  clearTimeout(transientTimer);\n  transientTimer = setTimeout(function(){ transient = null; render(); save(); }, ms || 5200);\n  render();\n}\n\nfunction bubble(text, ms, dreamy){\n  var b = el(walking ? \"wbubble\" : \"bubble\");\n  b.textContent = text;\n  b.className = \"bubble show\" + (dreamy ? \" dream\" : \"\");\n  if (!dreamy && !walking) b.style.left = (42 + Math.random() * 16) + \"%\";\n  clearTimeout(b._t);\n  b._t = setTimeout(function(){ b.classList.remove(\"show\"); }, ms || 4200);\n}\n\n/* ---------- actions ---------- */\n/* Snacks — tap Feed for the default rice ball, press-and-hold to pick one.\n   Chocolate is the favourite (big happy boost) but leaves a chocolatey face\n   that needs a bath. */\nvar SMUDGE  = ART + \"chocolate_smudge.png\";\nvar SMUDGE_W = ART + \"chocolate_smudge_w.png\";\nvar FOODS = [\n  { id:\"riceball\",  emoji:\"🍙\", name:\"Rice ball\", hunger:32, happy:4 },\n  { id:\"banana\",    emoji:\"🍌\", name:\"Banana\",    hunger:28, happy:8 },\n  { id:\"apple\",     emoji:\"🍎\", name:\"Apple\",     hunger:24, happy:6 },\n  { id:\"chocolate\", emoji:\"🍫\", name:\"Chocolate\", hunger:18, happy:24, fav:true, messy:true }\n];\nfunction food(id){ return FOODS.filter(function(f){ return f.id === id; })[0] || FOODS[0]; }\n\nfunction feed(){ feedWith(\"riceball\"); }     /* quick tap = the default snack */\n\nfunction feedWith(id){\n  closeFoodMenu();\n  if (S.sleeping){ bubble(\"Shh — \" + esc(S.name) + \" is sleeping.\"); return; }\n  var f = food(id);\n  haptic(f.fav ? \"success\" : \"light\");\n  S.hunger = Math.min(100, S.hunger + f.hunger);\n  S.happy  = Math.min(100, S.happy + f.happy);\n  if (f.messy){\n    S.messy = true;\n    S.clean = Math.max(12, S.clean - 28);   /* chocolate = messy face */\n    applyMessy();\n  }\n  if (f.id === \"chocolate\") S.choc = true;   /* milestone: favourite treat */\n  pulse(\"eat\", 5600);\n  bubble(f.fav ? f.emoji + \" my favourite!! *munch munch*\" : f.emoji + \" yum!\", 3400);\n  checkUnlocks(); save();\n}\n\n/* Toggle the chocolate smudge overlay (idle + walk) when the face is messy. */\nfunction applyMessy(){\n  var on = !!(S && S.hatched && S.messy);\n  el(\"smudge\").style.display  = on ? \"block\" : \"none\";\n  el(\"wsmudge\").style.display = on ? \"block\" : \"none\";\n}\n\nfunction buildFoodMenu(){\n  el(\"foodgrid\").innerHTML = FOODS.map(function(f){\n    return '<button class=\"fooditem' + (f.fav ? ' fav' : '') +\n           '\" onclick=\"feedWith(\\'' + f.id + '\\')\">' +\n           '<span class=\"fe\">' + f.emoji + '</span>' +\n           '<span class=\"fn\">' + esc(f.name) + '</span>' +\n           (f.fav ? '<span class=\"ft\">FAVOURITE</span>' : '') +\n           '</button>';\n  }).join(\"\");\n}\nfunction openFoodMenu(){\n  if (!S || !S.hatched) return;\n  if (S.sleeping){ bubble(\"Shh — \" + esc(S.name) + \" is sleeping.\"); return; }\n  haptic(\"light\");\n  el(\"foodmenu\").classList.add(\"show\");\n}\nfunction closeFoodMenu(){ el(\"foodmenu\").classList.remove(\"show\"); }\nfunction play(){\n  if (S.sleeping) return;\n  haptic(\"light\");\n  S.happy = Math.min(100, S.happy + 26);\n  S.energy = Math.max(5, S.energy - 10);\n  S.hunger = Math.max(12, S.hunger - 5);\n  S.plays = (S.plays || 0) + 1;\n  pulse(\"play\", 5600); checkUnlocks(); save();\n}\nfunction bath(){\n  if (S.sleeping){ bubble(\"Bathtime after nap time.\"); return; }\n  haptic(\"light\");\n  S.clean = 100;\n  if (S.messy){ S.messy = false; applyMessy(); bubble(\"All clean again! ✨\", 2800); }\n  pulse(\"bath\", 5600); save();\n}\nfunction toggleSleep(){\n  haptic(\"selection\");\n  if (S.sleeping){\n    S.sleeping = false;\n    S.happy = Math.min(100, S.happy + 6);\n    pulse(\"happy\", 3800);\n  } else {\n    S.sleeping = true;\n    transient = null;\n  }\n  render(); save();\n}\n\n/* ---------- egg & hatching ---------- */\nfunction stageTap(){\n  if (!S.hatched){\n    S.tapCount++;\n    haptic(S.tapCount >= 3 ? \"success\" : \"light\");\n    if (S.tapCount >= 3){\n      S.hatched = true;\n      transient = \"hatch\";\n      el(\"pet\").src = ART + ANIM.hatch;\n      setTimeout(function(){ el(\"namer\").classList.add(\"show\"); }, 2600);\n    } else {\n      el(\"hint\").textContent = S.tapCount === 1 ? \"It wobbled!\" : \"Something's moving in there…\";\n      var p = el(\"pet\");\n      p.style.transition = \"transform .12s\";\n      p.style.transform = \"rotate(\" + (S.tapCount % 2 ? 4 : -4) + \"deg)\";\n      setTimeout(function(){ p.style.transform = \"\"; }, 140);\n    }\n    save();\n    return;\n  }\n  if (S.sleeping){ toggleSleep(); return; }\n  haptic(\"light\");\n  S.happy = Math.min(100, S.happy + 2);\n  pulse(\"pet\", 3400);          /* heart-eyes: being petted */\n  save();\n}\n\nfunction setName(){\n  var n = el(\"nameInput\").value.trim() || \"Mochi\";\n  S.name = n.slice(0, 16);\n  S.born = Date.now();\n  el(\"namer\").classList.remove(\"show\");\n  haptic(\"success\");\n  transient = null;\n  render(); save();\n  bubble(\"Hello! I'm \" + esc(S.name) + \"! 🌱\", 5000);\n}\n\n/* ---------- talking (the MyLLM twist) ---------- */\nvar CANNED = [\"mochi mochi! 🌱\",\"*happy wiggle*\",\"(◕ᴗ◕)\",\"*bounces softly*\",\"squeak!\",\"*does a tiny spin*\"];\n\nfunction talk(){\n  var t = el(\"say\").value.trim();\n  if (!t || !S.hatched) return;\n  el(\"say\").value = \"\";\n  haptic(\"light\");\n  if (S.sleeping){ bubble(\"…zzz…\"); return; }\n  S.chats = (S.chats || 0) + 1; checkUnlocks();\n  if (!ASK){\n    bubble(CANNED[Math.floor(Math.random() * CANNED.length)]);\n    S.happy = Math.min(100, S.happy + 3); render(); save();\n    return;\n  }\n  var vibe = S.hunger < 30 ? \"hungry\" : S.happy < 30 ? \"a bit lonely\" : S.energy < 20 ? \"sleepy\" : \"happy and playful\";\n  var p = \"You are \" + S.name + \", a tiny newly-hatched pet blob creature. You are currently feeling \" + vibe + \".\\n\" +\n    \"Your owner says: \\\"\" + t + \"\\\"\\n\" +\n    \"Reply as \" + S.name + \" in ONE short, sweet sentence (max 12 words). Babyish, adorable, warm. \" +\n    \"You may use one emoji. Never break character, never mention being an AI.\";\n  ASK(p).then(function(r){\n    var line = String(r||\"\").split(\"\\n\")[0].replace(/^[\"']|[\"']$/g, \"\").trim();\n    if (!line || line.length > 120) line = CANNED[0];\n    bubble(line, 5200);\n    S.happy = Math.min(100, S.happy + 5);\n    pulse(\"happy\", 3600); save();\n  }).catch(function(){\n    bubble(CANNED[Math.floor(Math.random() * CANNED.length)]);\n  });\n}\n\n/* ---------- walk mode ---------- */\nvar walking = false, walkTimer = null, walkStart = 0, lastFind = 0, findCount = 0;\n\n/* Meadow friends: birds up high, bugs mid-air, crawlers on the ground —\n   drifting past on two depth layers. Config is pure (rng-injectable). */\nvar CRITTERS = [\n  { e:\"🦋\", band:[18, 42], dur:[13, 20], layer:\"front\", size:[20, 28] },\n  { e:\"🐝\", band:[26, 50], dur:[9, 14],  layer:\"front\", size:[17, 22] },\n  { e:\"🐦\", band:[4, 20],  dur:[8, 13],  layer:\"back\",  size:[18, 26] },\n  { e:\"🐞\", band:[55, 70], dur:[14, 20], layer:\"front\", size:[15, 19] },\n  { e:\"🐌\", band:[80, 88], dur:[30, 40], layer:\"front\", size:[16, 20] }\n];\nvar critterTimer = null;\n\nfunction critterSpec(rng){\n  var c = CRITTERS[Math.floor(rng() * CRITTERS.length)];\n  var lerp = function(r){ return r[0] + rng() * (r[1] - r[0]); };\n  return { e: c.e, top: lerp(c.band), dur: lerp(c.dur), layer: c.layer, size: Math.round(lerp(c.size)) };\n}\n\nfunction spawnCritter(rng){\n  var host = el(\"critters\");\n  if (!host || host.childElementCount >= 4) return null;\n  var s = critterSpec(rng || Math.random);\n  var d = document.createElement(\"div\");\n  d.className = \"critter \" + s.layer;\n  d.style.top = s.top + \"%\";\n  d.style.fontSize = s.size + \"px\";\n  d.style.animation = \"drift \" + s.dur.toFixed(1) + \"s linear forwards\";\n  d.innerHTML = \"<span>\" + s.e + \"</span>\";\n  host.appendChild(d);\n  setTimeout(function(){ if (d.parentNode) d.parentNode.removeChild(d); }, s.dur * 1000 + 400);\n  return s;\n}\n\nfunction startCritters(){\n  stopCritters();\n  spawnCritter();                                     /* one friend right away */\n  critterTimer = setInterval(function(){\n    if (Math.random() < 0.55) spawnCritter();\n  }, 6000);\n}\nfunction stopCritters(){\n  if (critterTimer){ clearInterval(critterTimer); critterTimer = null; }\n  var host = el(\"critters\");\n  if (host) host.innerHTML = \"\";\n}\n\nfunction buildTrack(){\n  var track = el(\"walktrack\");\n  if (track.childElementCount) return;\n  /* palindrome tiling: strip + mirrored strip, scrolled 50% = seamless loop */\n  track.innerHTML = '<img src=\"' + ART + 'walk_bg.jpg\" alt=\"\">' +\n                    '<img class=\"flip\" src=\"' + ART + 'walk_bg.jpg\" alt=\"\">' +\n                    '<img src=\"' + ART + 'walk_bg.jpg\" alt=\"\">' +\n                    '<img class=\"flip\" src=\"' + ART + 'walk_bg.jpg\" alt=\"\">';\n}\nvar FINDS = [\n  {e:\"🌼\", t:\"found a little flower!\"}, {e:\"🦋\", t:\"a butterfly friend!\"},\n  {e:\"🍄\", t:\"ooh, a tiny mushroom!\"}, {e:\"✨\", t:\"something sparkly!\"},\n  {e:\"🐌\", t:\"met a slow friend.\"}, {e:\"🍀\", t:\"a lucky clover!\"},\n  {e:\"🍙\", t:\"A WILD BUN!! nom.\", rare:true}\n];\n\nfunction startWalk(){\n  if (walking || !S.hatched) return;\n  if (S.sleeping){ bubble(\"Wake \" + esc(S.name) + \" up first. 🌙\"); return; }\n  if (S.energy < 25){ bubble(esc(S.name) + \" is too tired for a walk right now. 🌙\"); return; }\n  haptic(\"success\");\n  walking = true; walkStart = Date.now(); lastFind = Date.now(); findCount = 0;\n  S.walks = (S.walks || 0) + 1; checkUnlocks();   /* milestone: first walk */\n  buildTrack();\n  /* WebKit quirk: percentage-transform keyframes computed against a\n     not-yet-loaded (zero-width) strip don't recover — restart the animation\n     now that we're visible so the first walk scrolls like every other. */\n  var track = el(\"walktrack\");\n  track.style.animation = \"none\";\n  void track.offsetWidth;\n  track.style.animation = \"\";\n  el(\"walkpet\").src = ART + \"anim_walk_t.webp\";   /* alpha-keyed: Mochi IS in the meadow */\n  el(\"walkview\").classList.add(\"show\");\n  el(\"walksteps\").textContent = \"\";\n  walkTimer = setInterval(walkTick, 5000);\n  startCritters();\n  bubble(\"*waddle waddle*\", 3200);\n}\n\nfunction walkTick(){\n  S.energy = Math.max(12, S.energy - 0.45);\n  S.happy = Math.min(100, S.happy + 0.35);\n  var mins = Math.floor((Date.now() - walkStart) / 60000);\n  el(\"walksteps\").textContent = mins < 1 ? \"out for a stroll…\" : mins + \" min stroll · \" + findCount + \" finds\";\n  if (S.energy <= 20){ endWalk(true); return; }\n  maybeFind(Date.now(), Math.random);\n  save();\n}\n\nfunction maybeFind(now, rng){\n  if (now - lastFind < 16000) return null;\n  if (rng() > 0.4) return null;\n  lastFind = now;\n  var pool = FINDS.filter(function(f){ return !f.rare || rng() < 0.18; });\n  var f = pool[Math.floor(rng() * pool.length)];\n  findCount++;\n  S.finds = (S.finds || 0) + 1;                 /* milestone: treasures found */\n  S.happy = Math.min(100, S.happy + (f.rare ? 8 : 3));\n  if (f.rare) S.hunger = Math.min(100, S.hunger + 10);\n  haptic(f.rare ? \"success\" : \"light\");\n  bubble(f.e + \" \" + f.t, 4200);\n  checkUnlocks();\n  return f;\n}\n\nfunction endWalk(tired){\n  if (!walking) return;\n  walking = false;\n  clearInterval(walkTimer); walkTimer = null;\n  stopCritters();\n  el(\"walkview\").classList.remove(\"show\");\n  haptic(\"selection\");\n  render(); save();\n  bubble(tired ? esc(S.name) + \" got sleepy on the walk… 🥱\" :\n         \"That was lovely! \" + (findCount ? findCount + \" treasures found.\" : \"🌱\"), 4600);\n}\n\n/* ---------- ambient life: idle mutterings & dreams ---------- */\nvar CHATTER = {\n  happy:  [\"mochi mochi~ 🌱\",\"*hums a tiny song*\",\"today is a good day!\",\"*wiggles contentedly*\",\"(◕ᴗ◕)♪\",\"*watches a dust mote float by*\"],\n  hungry: [\"*tummy rumbles softly*\",\"...thinking about buns...\",\"is it snack time? 🍙\",\"*sniffs the air hopefully*\"],\n  lonely: [\"*looks up at you*\",\"play with me? 🥺\",\"*rolls the ball hopefully*\",\"*little sigh*\"],\n  sleepy: [\"*yawns a tiny yawn*\",\"...eyelids heavy...\",\"*blinks slowly* 🌙\",\"five more minutes of awake...\"]\n};\nvar DREAMS = [\"💭 🍙🍙🍙✨\",\"💭 bouncing on clouds…\",\"💭 ⚽🌈\",\"💭 a mountain of buns…\",\"💭 🫧🐟🫧\",\"💭 swimming in warm milk…\",\"💭 🌙⭐️ tiny star friends…\",\"💭 the great bun in the sky…\"];\nvar lastAmbient = Date.now();\n\nfunction chatterMood(){\n  if (S.hunger < 35) return \"hungry\";\n  if (S.energy < 30) return \"sleepy\";\n  if (S.happy < 40) return \"lonely\";\n  return \"happy\";\n}\n\n/* Ambient tick — rng + now injectable so it's testable.\n   Returns what it did: null | \"dream\" | \"chatter\" | \"ai\" */\nfunction ambientTick(now, rng){\n  if (!S || !S.hatched || transient) return null;\n  var gap = now - lastAmbient;\n  /* Dreams come easier than chatter: a sleeping pet dreams within ~30-60s and\n     roughly every minute after; awake mutterings stay rarer (~1.5-2.5 min). */\n  var minGap = S.sleeping ? 22000 : 40000;\n  var ramp   = S.sleeping ? 45000 : 110000;\n  if (gap < minGap) return null;\n  if (rng() > Math.min(0.9, (gap - minGap) / ramp)) return null;\n  lastAmbient = now;\n  if (S.sleeping){\n    bubble(DREAMS[Math.floor(rng() * DREAMS.length)], 5600, true);\n    return \"dream\";\n  }\n  var pool = CHATTER[chatterMood()];\n  if (ASK && rng() < 0.3){\n    var vibe = chatterMood();\n    ASK(\"You are \" + S.name + \", a tiny pet blob creature feeling \" + vibe + \". \" +\n        \"Say ONE spontaneous cute little thought, max 9 words, babyish, may use one emoji. \" +\n        \"Just the thought, nothing else.\")\n      .then(function(r){\n        var line = String(r||\"\").split(\"\\n\")[0].replace(/^[\"']|[\"']$/g, \"\").trim();\n        bubble(line && line.length <= 90 ? line : pool[0], 5200);\n      })\n      .catch(function(){ bubble(pool[Math.floor(rng() * pool.length)], 5200); });\n    return \"ai\";\n  }\n  bubble(pool[Math.floor(rng() * pool.length)], 5200);\n  return \"chatter\";\n}\n\nsetInterval(function(){ ambientTick(Date.now(), Math.random); }, 9000);\n/* Opening the app onto a sleeping pet shouldn't mean a long wait for the\n   first dream — start the clock most of the way there. */\nlastAmbient = Date.now() - 15000;\n\nel(\"say\").addEventListener(\"keydown\", function(e){ if (e.key === \"Enter\") talk(); });\nel(\"stage\").addEventListener(\"click\", stageTap);\n\n/* Feed: a quick tap gives the default snack; press-and-hold opens the picker.\n   Pointer events give one unified path (no touch/mouse double-fire in WKWebView). */\n(function(){\n  var fb = el(\"feedBtn\"), timer = null, held = false;\n  fb.addEventListener(\"pointerdown\", function(){\n    held = false;\n    timer = setTimeout(function(){ held = true; haptic(\"medium\"); openFoodMenu(); }, 450);\n  });\n  fb.addEventListener(\"pointerup\", function(){\n    clearTimeout(timer);\n    if (!held) feed();\n  });\n  fb.addEventListener(\"pointerleave\", function(){ clearTimeout(timer); });\n  fb.addEventListener(\"pointercancel\", function(){ clearTimeout(timer); });\n})();\n\n/* ---------- wardrobe logic ---------- */\nfunction saveWard(){ store.setItem(\"mochi_wardrobe\", JSON.stringify(W)); }\n\n/* Point the six overlay <img>s (3 stage + 3 walk) at whatever's equipped, or\n   hide them. Gated on hatched so a bare egg never wears a hat. */\nfunction applyAccessories(){\n  SLOT_ORDER.forEach(function(slot){\n    var id = (S && S.hatched) ? W[slot] : null;\n    var a = el(\"acc_\" + slot), wa = el(\"wacc_\" + slot);\n    if (id){\n      a.src = ACC_BASE + id + \".png\";      a.style.display = \"block\";\n      wa.src = ACC_BASE + id + \"_w.png\";   wa.style.display = \"block\";\n    } else {\n      a.style.display = \"none\";\n      wa.style.display = \"none\";\n    }\n  });\n}\n\nfunction daysTogether(){ return Math.max(1, Math.ceil((Date.now() - (S ? S.born : Date.now())) / 86400000)); }\nfunction label(id){ var c = CATALOG.filter(function(x){ return x.id === id; })[0]; return c ? c.name : id; }\n\n/* Starters (not in UNLOCKS) are always available; a gated item is available\n   only once its milestone has been reached and recorded in S.unlocked. */\nfunction isUnlocked(id){\n  if (!(id in UNLOCKS)) return true;\n  return !!(S && S.unlocked && S.unlocked.indexOf(id) >= 0);\n}\n\n/* Award any newly-earned items. silent=true at boot (retroactive, no fanfare);\n   silent=false during play so a fresh unlock is celebrated once. */\nfunction checkUnlocks(silent){\n  if (!S || !S.hatched) return;\n  if (!S.unlocked) S.unlocked = [];\n  if (S.happy >= 100) S.maxHappy = true;     /* latch: \"reached 100 once\" */\n  var newly = [];\n  for (var id in UNLOCKS){\n    if (S.unlocked.indexOf(id) < 0 && UNLOCKS[id].test(S)){\n      S.unlocked.push(id);\n      newly.push(id);\n    }\n  }\n  if (newly.length){\n    save();\n    if (el(\"wardrobe\").classList.contains(\"show\")) renderWardrobe();\n    if (!silent){\n      haptic(\"success\");\n      bubble(\"🎉 Unlocked \" + label(newly[0]) + \"! It's in the 👒 wardrobe.\", 5200);\n    }\n  }\n}\n\nfunction equip(slot, id){\n  if (id && !isUnlocked(id)){                /* tapped a locked item — show how to earn it */\n    haptic(\"warning\");\n    var u = UNLOCKS[id];\n    bubble(\"🔒 \" + (u ? u.hint : \"Locked\"), 4200);\n    return;\n  }\n  W[slot] = (W[slot] === id) ? null : id;    /* tapping the worn one takes it off */\n  haptic(\"selection\");\n  applyAccessories();\n  renderWardrobe();\n  saveWard();\n}\n\nfunction chipHTML(slot, id, name, on){\n  var locked = id && !isUnlocked(id);\n  var inner = id ? '<img src=\"' + ACC_BASE + id + '_chip.png\" alt=\"\">'\n                 : '<span class=\"none\">🚫</span>';\n  if (locked) inner += '<span class=\"lock\">🔒</span>';\n  var arg = id ? \"'\" + id + \"'\" : \"null\";\n  return '<button class=\"chip' + (on ? ' on' : '') + (locked ? ' locked' : '') +\n         '\" onclick=\"equip(\\'' + slot + '\\',' + arg + ')\">' +\n         '<div class=\"thumb\">' + inner + '</div><span>' + esc(name) + '</span></button>';\n}\n\nfunction renderWardrobe(){\n  var html = \"\";\n  SLOT_ORDER.forEach(function(slot){\n    html += '<div class=\"wardslot\"><small>' + SLOT_NAME[slot] + '</small><div class=\"wardrow\">';\n    html += chipHTML(slot, null, \"None\", !W[slot]);\n    CATALOG.filter(function(c){ return c.slot === slot; }).forEach(function(c){\n      html += chipHTML(slot, c.id, c.label, W[slot] === c.id);\n    });\n    html += '</div></div>';\n  });\n  el(\"wardslots\").innerHTML = html;\n}\n\nfunction openWardrobe(){\n  if (!S || !S.hatched) return;\n  haptic(\"light\");\n  renderWardrobe();\n  el(\"wardrobe\").classList.add(\"show\");\n}\nfunction closeWardrobe(){ el(\"wardrobe\").classList.remove(\"show\"); }\n\n/* ---------- boot ---------- */\n(function boot(){\n  /* preload all loops so mood switches are instant */\n  Object.keys(ANIM).forEach(function(k){ new Image().src = ART + ANIM[k]; });\n  new Image().src = ART + \"anim_walk_t.webp\";\n  new Image().src = ART + \"walk_bg.jpg\";\n  new Image().src = SMUDGE; new Image().src = SMUDGE_W;\n  el(\"smudge\").src = SMUDGE; el(\"wsmudge\").src = SMUDGE_W;\n  buildFoodMenu();\n  buildTrack();\n  store.getItem(\"mochi_state\").then(function(v){\n    if (v){ try { S = JSON.parse(v); } catch(_){} }\n    if (!S || typeof S.hunger !== \"number\") S = fresh();\n    applyDecay();\n    return store.getItem(\"mochi_wardrobe\");\n  }).then(function(wv){\n    if (wv){ try { var w = JSON.parse(wv);\n      if (w) W = { head:w.head||null, eyes:w.eyes||null, neck:w.neck||null };\n    } catch(_){} }\n    /* a returning owner gets a welcome-back, not a guilt trip */\n    applyAccessories();\n    applyMessy();\n    checkUnlocks(true);   /* retroactively grant anything already earned, quietly */\n    render(); save();\n    setInterval(function(){ applyDecay(); checkUnlocks(false); render(); save(); }, 30000);\n    /* one-time nudge so people discover the snack picker */\n    store.getItem(\"mochi_food_tip\").then(function(seen){\n      if (!seen && S && S.hatched){\n        store.setItem(\"mochi_food_tip\", \"1\");\n        setTimeout(function(){ if (!S.sleeping) bubble(\"Tip: press & hold 🍙 Feed to pick a snack!\", 5200); }, 4200);\n      }\n    });\n  });\n})();\n</script>\n</body>\n</html>\n"}