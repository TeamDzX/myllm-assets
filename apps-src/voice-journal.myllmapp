{"name": "Voice Journal", "html": "<!doctype html>\n<!--\n  Voice Journal — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Voice Journal</title>\n<style>:root{--build-id:\"9b62084ccb\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --h:245; }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; } button:active{ transform:scale(.96); }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 56%), hsl(calc(var(--h) + 40) 58% 30%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:20px 2px 10px; }\n\n  /* The one thing this app is for: a big button on the app's own colour. */\n  .hero{ border-radius:22px; padding:22px 18px 18px; color:#fff; text-align:center; margin-bottom:12px;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 52%), hsl(calc(var(--h) + 40) 58% 26%)); box-shadow:0 10px 28px hsl(var(--h) 60% 30% / .25); }\n  .rec{ position:relative; width:84px; height:84px; border-radius:50%; border:none; background:#fff; color:hsl(var(--h) 60% 40%); font-size:30px;\n    display:flex; align-items:center; justify-content:center; margin:0 auto; box-shadow:0 10px 30px rgba(0,0,0,.3); }\n  .rec::after{ content:\"\"; position:absolute; inset:-9px; border-radius:50%; border:2px solid rgba(255,255,255,.35); opacity:0; }\n  .rec.busy{ color:#ff453a; }\n  .rec.busy::after{ opacity:1; animation:ring 1.6s ease-out infinite; }\n  @keyframes ring{ from{ transform:scale(.9); opacity:.9; } to{ transform:scale(1.3); opacity:0; } }\n  .hero b{ display:block; font-size:17px; font-weight:750; margin-top:14px; }\n  .hero span{ display:block; font-size:12.5px; line-height:1.4; opacity:.8; margin-top:3px; }\n  .hero .stat{ display:inline-block; margin-top:12px; font-size:11px; font-weight:800; letter-spacing:.1em; text-transform:uppercase;\n    border:1px solid rgba(255,255,255,.18); background:rgba(255,255,255,.14); border-radius:99px; padding:5px 11px; font-variant-numeric:tabular-nums; }\n\n  .entry{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:10px; }\n  .entry .d{ font-size:12px; font-weight:700; color:var(--muted); margin-bottom:6px; font-variant-numeric:tabular-nums; }\n  .entry p{ font-size:15.5px; line-height:1.5; white-space:pre-wrap; overflow-wrap:anywhere; -webkit-user-select:text; user-select:text; }\n  .entry p.clamp{ display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }\n  .acts{ display:flex; gap:7px; margin-top:12px; flex-wrap:wrap; }\n  .acts button{ min-height:36px; border:1px solid var(--line); background:var(--bg); border-radius:99px; padding:0 13px; font-size:13px; font-weight:650;\n    display:inline-flex; align-items:center; gap:6px; }\n  .acts .del{ margin-left:auto; color:#ff453a; }\n  .acts .more svg{ transition:transform .2s; } .acts .more.open svg{ transform:rotate(180deg); }\n\n  .empty{ background:var(--surface); border:1px solid var(--line); border-radius:18px; text-align:center; padding:22px 18px; color:var(--muted); font-size:13.5px; line-height:1.5; }\n  .empty .tile{ width:48px; height:48px; border-radius:14px; font-size:21px; margin:0 auto 10px; opacity:.85; }\n  .empty b{ display:block; color:var(--ink); font-size:15px; margin-bottom:3px; }\n  .err{ display:none; color:#ff453a; font-size:13px; text-align:center; line-height:1.45; padding:2px 10px 10px; }\n  .err.on{ display:block; }\n\n  @media (min-width:768px){ body{ max-width:760px; } }\n  @media (max-height:520px){ .hero{ display:flex; align-items:center; gap:18px; text-align:left; padding:14px 18px; } .rec{ margin:0; width:68px; height:68px; font-size:25px; flex-shrink:0; } .hero b{ margin-top:0; } .hero .stat{ margin-top:8px; } }\n  @media (prefers-reduced-motion:reduce){ .rec.busy::after{ animation:none; } button:active{ transform:none; } }\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-mic\" viewBox=\"0 0 24 24\"><rect x=\"9\" y=\"2.5\" width=\"6\" height=\"12\" rx=\"3\"/><path d=\"M6 11a1 1 0 0 0-2 0 8 8 0 0 0 7 7.94V21a1 1 0 0 0 2 0v-2.06A8 8 0 0 0 20 11a1 1 0 0 0-2 0 6 6 0 0 1-12 0z\"/></symbol>\n  <symbol id=\"i-chev\" viewBox=\"0 0 24 24\"><path d=\"M6.3 8.8a1 1 0 0 1 1.4 0l4.3 4.3 4.3-4.3a1 1 0 1 1 1.4 1.4l-5 5a1 1 0 0 1-1.4 0l-5-5a1 1 0 0 1 0-1.4z\"/></symbol>\n  <symbol id=\"i-share\" viewBox=\"0 0 24 24\"><path d=\"M12 2.6a1 1 0 0 0-.7.3L7.8 6.4a1 1 0 0 0 1.4 1.4L11 6v8.5a1 1 0 0 0 2 0V6l1.8 1.8a1 1 0 0 0 1.4-1.4l-3.5-3.5a1 1 0 0 0-.7-.3zM6 10a3 3 0 0 0-3 3v5a3 3 0 0 0 3 3h12a3 3 0 0 0 3-3v-5a3 3 0 0 0-3-3h-1a1 1 0 0 0 0 2h1a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-5a1 1 0 0 1 1-1h1a1 1 0 0 0 0-2z\"/></symbol>\n  <symbol id=\"i-trash\" viewBox=\"0 0 24 24\"><path d=\"M10 2.5a2 2 0 0 0-2 2V5H4.5a1 1 0 0 0 0 2h.6l.8 11.2A3 3 0 0 0 8.9 21h6.2a3 3 0 0 0 3-2.8L18.9 7h.6a1 1 0 0 0 0-2H16v-.5a2 2 0 0 0-2-2zm0 2h4V5h-4zM7.1 7h9.8l-.8 11.06a1 1 0 0 1-1 .94H8.9a1 1 0 0 1-1-.94z\"/></symbol>\n</defs></svg>\n\n<div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-mic\"/></svg></div>\n  <div><h1>Voice Journal</h1><p>Speak it, it writes itself</p></div>\n</div>\n\n<div class=\"hero\">\n  <button class=\"rec\" id=\"rec\" aria-label=\"New entry\"><svg class=\"i\"><use href=\"#i-mic\"/></svg></button>\n  <div><b id=\"recLabel\">New entry</b>\n  <span>Speak your thoughts — they're transcribed on your device and saved.</span>\n  <div class=\"stat\" id=\"stat\">No entries yet</div></div>\n</div>\n<p class=\"err\" id=\"err\"></p>\n\n<h2 id=\"listHead\">Entries</h2>\n<div id=\"list\"></div>\n<div class=\"empty\" id=\"hint\"><div class=\"tile\"><svg class=\"i\"><use href=\"#i-mic\"/></svg></div><b>Your entries will appear here</b>\n  <span id=\"hintText\">Recording and transcription happen privately on your device. Needs the latest MyLLM with microphone access allowed for apps.</span></div>\n\n<script>\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction haptic(s){ if (window.myllmHaptic) try { myllmHaptic(s); } catch(_){} }\nfunction loadKey(k){ var s = window.myllmStorage; return s ? s.getItem(k).catch(function(){ return null; }) : Promise.resolve(null); }\nfunction keepKey(k, v){ var s = window.myllmStorage; if (s) try { s.setItem(k, v).catch(function(){}); } catch(_){} }\n\nvar entries = [], busy = false, busyTimer = null;\nfunction el(id){ return document.getElementById(id); }\nfunction fail(text){ var e = el(\"err\"); e.textContent = text || \"\"; e.classList.toggle(\"on\", !!text); }\n\n/* MyLLM shows its own recorder over the app, so there is nothing to draw here\n   while it listens — the button just says so, and won't start a second one. */\nfunction setBusy(on){\n  busy = on; clearTimeout(busyTimer);\n  el(\"rec\").classList.toggle(\"busy\", on);\n  el(\"recLabel\").textContent = on ? \"Listening…\" : \"New entry\";\n  if (on) busyTimer = setTimeout(function(){ setBusy(false); }, 180000);   /* never leave the button stuck */\n}\nfunction record(){\n  if (busy) return;\n  var transcribe = window.myllmTranscribe;\n  if (!transcribe){ fail(\"This needs the latest MyLLM (v3.7+) with “Allow apps to use the microphone” enabled in Settings.\"); return; }\n  fail(\"\"); haptic(\"light\"); setBusy(true);\n  transcribe().then(function(text){\n    setBusy(false);\n    if (!text){ return; }   /* cancelled / nothing heard */\n    entries.unshift({ text: text, at: Date.now() });\n    save(); render(); haptic(\"success\");\n  }).catch(function(e){ setBusy(false); fail((e && e.message) ? e.message : \"Recording failed\"); });\n}\n\nfunction when(at){\n  var d = new Date(at);\n  try { return new Intl.DateTimeFormat([], {weekday:\"short\", day:\"numeric\", month:\"short\", year:\"numeric\", hour:\"numeric\", minute:\"2-digit\"}).format(d); }\n  catch(_){ return d.toLocaleString(); }\n}\nfunction render(){\n  var L = el(\"list\"), n = entries.length; L.innerHTML = \"\";\n  el(\"stat\").textContent = n ? (n + (n === 1 ? \" entry\" : \" entries\")) : \"No entries yet\";\n  el(\"hint\").style.display = n ? \"none\" : \"block\";\n  el(\"listHead\").style.display = n ? \"block\" : \"none\";\n  entries.forEach(function(it, i){\n    var d = document.createElement(\"div\"); d.className = \"entry\";\n    d.innerHTML = '<div class=\"d\"></div><p class=\"clamp\"></p>' +\n      '<div class=\"acts\"><button class=\"more\"><svg class=\"i\"><use href=\"#i-chev\"/></svg><span>Show more</span></button>' +\n      '<button class=\"sh\"><svg class=\"i\"><use href=\"#i-share\"/></svg>Share</button>' +\n      '<button class=\"del\"><svg class=\"i\"><use href=\"#i-trash\"/></svg>Delete</button></div>';\n    d.querySelector(\".d\").textContent = when(it.at);\n    var p = d.querySelector(\"p\"); p.textContent = it.text;\n    var more = d.querySelector(\".more\");\n    more.onclick = function(){ var c = p.classList.toggle(\"clamp\"); more.classList.toggle(\"open\", !c); more.querySelector(\"span\").textContent = c ? \"Show more\" : \"Show less\"; };\n    d.querySelector(\".sh\").onclick = function(){ if (window.myllmShare) myllmShare(it.text); haptic(\"light\"); };\n    d.querySelector(\".del\").onclick = function(){ entries.splice(i, 1); save(); render(); haptic(\"warning\"); };\n    L.appendChild(d);\n    if (p.scrollHeight <= p.clientHeight + 1) more.style.display = \"none\";   /* nothing more to show */\n  });\n}\n\nfunction save(){ keepKey(\"entries\", JSON.stringify(entries.slice(0, 200))); }\nfunction load(){ return loadKey(\"entries\").then(function(v){ try { var a = v ? JSON.parse(v) : []; return Array.isArray(a) ? a : []; } catch(e){ return []; } }); }\n\nel(\"rec\").onclick = record;\nrender();\nload().then(function(v){ entries = v; render(); });\n</script></body></html>\n"}