{"name": "Voice Journal", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>:root{color-scheme:light dark}\n*{box-sizing:border-box}\nbody{font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);margin:0;padding:16px;background:var(--myllm-bg,#f2f2f7);color:var(--myllm-text,#111)}\nh1{font-size:22px;margin:0 0 2px}\n.sub{font-size:13px;color:var(--myllm-muted,#8a8a8e);margin:0 0 16px}\nbutton.go{width:100%;border:0;background:var(--myllm-accent,#0a84ff);color:#fff;border-radius:14px;padding:16px;font-size:17px;font-weight:700}\nbutton.go span{font-size:22px;margin-right:8px;vertical-align:middle}\n.entry{background:var(--myllm-surface,#fff);border-radius:14px;padding:14px;margin-top:10px}\n.entry .d{font-size:12px;color:var(--myllm-muted,#8a8a8e);margin-bottom:4px}\n.entry p{margin:0;font-size:15px;line-height:1.5;white-space:pre-wrap}\n.entry p.clamp{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}\n.entry .acts{display:flex;gap:14px;margin-top:10px}\n.entry .acts button{border:0;background:none;font-size:13px;font-weight:600;color:var(--myllm-accent,#0a84ff);padding:0}\n.entry .acts button.del{color:#ff453a}\n.note{color:var(--myllm-muted,#8a8a8e);font-size:14px;text-align:center;margin-top:20px;line-height:1.5;padding:0 8px}\n@media(min-width:768px){body{max-width:720px;margin-left:auto;margin-right:auto}}\n</style></head><body>\n<h1>🎙️ Voice Journal</h1>\n<p class=\"sub\">Speak your thoughts — they're transcribed on your device and saved.</p>\n<button class=\"go\" onclick=\"record()\"><span>🎙️</span>New entry</button>\n<div id=\"list\"></div>\n<p class=\"note\" id=\"hint\">Recording and transcription happen privately on your device. Needs the latest MyLLM with microphone access allowed for apps.</p>\n\n<script>\nvar TRANSCRIBE = window.myllmTranscribe || null;\nvar store = window.myllmStorage || {getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar haptic = window.myllmHaptic || function(){};\nvar entries = [];\n\nfunction el(id){return document.getElementById(id)}\n\nfunction record(){\n  if(!TRANSCRIBE){ el('hint').textContent='This needs the latest MyLLM (v3.7+) with “Allow apps to use the microphone” enabled in Settings.'; return; }\n  haptic('light');\n  TRANSCRIBE().then(function(text){\n    if(!text){ return; } // cancelled / nothing heard\n    entries.unshift({ text: text, at: Date.now() });\n    save(); render(); haptic('success');\n  }).catch(function(e){ el('hint').textContent=(e&&e.message)?e.message:'Recording failed'; });\n}\n\nfunction render(){\n  var L = el('list'); L.innerHTML='';\n  if(!entries.length){ el('hint').style.display='block'; return; }\n  el('hint').style.display='none';\n  entries.forEach(function(it, i){\n    var d = document.createElement('div'); d.className='entry';\n    d.innerHTML='<div class=\"d\"></div><p class=\"clamp\"></p>'+\n      '<div class=\"acts\"><button class=\"more\">Show more</button><button class=\"sh\">Share</button><button class=\"del\">Delete</button></div>';\n    d.querySelector('.d').textContent = new Date(it.at).toLocaleString();\n    var p = d.querySelector('p'); p.textContent = it.text;\n    d.querySelector('.more').onclick = function(){ p.classList.toggle('clamp'); this.textContent = p.classList.contains('clamp')?'Show more':'Show less'; };\n    d.querySelector('.sh').onclick = function(){ if(window.myllmShare) myllmShare(it.text); haptic('light'); };\n    d.querySelector('.del').onclick = function(){ entries.splice(i,1); save(); render(); haptic('warning'); };\n    L.appendChild(d);\n  });\n}\n\nfunction save(){ store.setItem('entries', JSON.stringify(entries.slice(0,200))); }\nfunction load(){ return store.getItem('entries').then(function(v){ try{return v?JSON.parse(v):[]}catch(e){return []} }); }\n\nload().then(function(v){ entries=v; render(); });\n</script></body></html>\n"}