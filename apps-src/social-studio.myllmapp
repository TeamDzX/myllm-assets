{"name": "Social Studio", "kind": "html", "iconSymbol": "photo.on.rectangle.angled", "iconColor": "blue", "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Social Studio</title>\n<style>\n:root{\n  color-scheme:dark;\n  --bg:#101216;--deck:#181b21;--card:#20242c;--ink:#edeef2;--mut:#8d94a3;--line:#2b303a;\n  --ac:#4f8df9;--ac-soft:rgba(79,141,249,.16);--danger:#d07a63;\n}\n*{box-sizing:border-box;margin:0}\nhtml,body{height:100%}\nbody{font-family:-apple-system,system-ui,sans-serif;background:var(--bg);color:var(--ink);\n  display:flex;flex-direction:column;height:100dvh;overflow:hidden;-webkit-tap-highlight-color:transparent;\n  position:fixed;inset:0;width:100%}\n/* top bar */\n.top{display:flex;align-items:center;gap:10px;padding:calc(10px + env(safe-area-inset-top)) 16px 10px}\n.top .logo{font-weight:800;font-size:17px;letter-spacing:-.01em}\n.top .logo span{color:var(--ac)}\n.top .sp{flex:1}\n.top button{border:0;border-radius:12px;background:var(--ac);color:#fff;font-weight:700;font-size:14px;\n  padding:9px 16px;display:flex;align-items:center;gap:7px}\n.top button svg{width:16px;height:16px}\n/* undo sits quiet next to Save — an icon-only ghost so it never competes with it */\n.top button.ghosttop{background:var(--card);color:var(--ink);padding:9px 11px}\n.top button.ghosttop:disabled{opacity:.32}\n/* preview */\n#stage{flex:1;display:flex;align-items:center;justify-content:center;min-height:0;padding:4px 14px 10px;position:relative;overflow:hidden}\n/* Safe zones are a DOM overlay, never canvas paint. Exports all go through\n   render(...,forExport=true) onto a detached canvas, so guides drawn here\n   cannot reach a saved image even by accident. */\n/* Feed chrome is a GENERIC mock — a plain avatar, a name row and outline\n   glyphs. It deliberately does not reproduce any platform's logo, wordmark or\n   exact iconography; the job is to judge how the post reads at feed size, and\n   copying real marks would be a trademark problem for no extra benefit. */\n#feedTop,#feedBot{position:absolute;display:none;color:var(--ink);pointer-events:none;z-index:4}\n#feedTop.on,#feedBot.on{display:block}\n#feedTop{display:none;align-items:center;gap:8px}\n#feedTop.on{display:flex}\n#feedTop .av{width:26px;height:26px;border-radius:50%;background:linear-gradient(135deg,#4f8df9,#b06df9);flex:0 0 auto}\n#feedTop .nm{font-size:12.5px;font-weight:700;line-height:1.15}\n#feedTop .nm small{display:block;font-weight:400;font-size:10.5px;color:var(--mut)}\n#feedTop .dots{margin-left:auto;color:var(--mut);font-size:15px;letter-spacing:1px}\n#feedBot .icons{display:flex;gap:14px;padding:7px 0 5px}\n#feedBot svg{width:19px;height:19px;stroke:var(--ink);fill:none;stroke-width:1.7}\n#feedBot .cap{font-size:11.5px;line-height:1.45;color:var(--ink);\n  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}\n#feedBot .cap b{font-weight:700}\n#feedBot .cap i{font-style:normal;color:var(--mut)}\n#safeOv{position:absolute;pointer-events:none;display:none;z-index:3}\n#safeOv.on{display:block}\n#safeOv .band,#safeOv .rail{position:absolute;background:repeating-linear-gradient(135deg,rgba(208,122,99,.30) 0 7px,rgba(208,122,99,.16) 7px 14px)}\n#safeOv .band{left:0;right:0}\n#safeOv .rail{top:0;bottom:0;right:0}\n#safeOv .edge{position:absolute;left:0;right:0;border-top:1px dashed rgba(255,255,255,.8)}\n#safeOv .cut{position:absolute;top:0;bottom:0;width:0;border-left:2px dashed rgba(255,255,255,.9);\n  filter:drop-shadow(0 0 3px rgba(0,0,0,.8))}\n#safeOv .zlbl{position:absolute;left:6px;font-size:9.5px;font-weight:700;letter-spacing:.05em;\n  color:#fff;text-shadow:0 1px 3px rgba(0,0,0,.85);text-transform:uppercase}\n#pv{border-radius:14px;box-shadow:0 14px 44px -12px rgba(0,0,0,.7);flex:0 0 auto;touch-action:none}\n#stageHint{position:absolute;bottom:14px;left:0;right:0;text-align:center;font-size:11.5px;color:var(--mut);pointer-events:none;opacity:.85}\n/* deck */\n.deck{background:var(--deck);border-top:1px solid var(--line);border-radius:20px 20px 0 0;\n  padding-bottom:env(safe-area-inset-bottom);flex:0 0 auto}\n.tabs{display:flex;gap:4px;padding:10px 12px 4px;overflow-x:auto;scrollbar-width:none}\n.tabs::-webkit-scrollbar{display:none}\n.tabs button{flex:1;border:0;background:none;color:var(--mut);font-size:12px;font-weight:650;\n  padding:8px 2px 9px;border-radius:11px;display:flex;flex-direction:column;align-items:center;gap:4px;white-space:nowrap}\n.tabs button svg{width:20px;height:20px}\n.tabs button.on{color:var(--ac);background:var(--ac-soft)}\n.panel{display:none;height:216px;overflow-y:auto;padding:10px 16px 16px;overscroll-behavior:contain}\n.panel.on{display:block}\n.lbl{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--mut);margin:12px 0 7px}\n.lbl:first-child{margin-top:2px}\n/* generic controls */\n.chips{display:flex;gap:7px;flex-wrap:wrap}\n.chip{border:1.5px solid var(--line);background:none;color:var(--mut);border-radius:999px;padding:8px 14px;font-size:13px;font-weight:600}\n.chip.on{color:var(--ac);border-color:var(--ac)}\ninput[type=text],textarea{width:100%;padding:11px 12px;border:1px solid var(--line);border-radius:12px;\n  background:var(--card);color:var(--ink);font-size:15px;outline:none}\ntextarea{resize:none;min-height:56px;line-height:1.4}\n.row{display:flex;gap:8px;align-items:center}\n.btn{border:0;border-radius:12px;background:var(--ac);color:#fff;font-weight:700;font-size:14px;padding:11px 16px}\n.btn.ghost{background:var(--ac-soft);color:var(--ac)}\n.btn.line{background:none;border:1.5px solid var(--line);color:var(--mut);font-weight:600}\n.btn:disabled{opacity:.4}\n.hint{font-size:12px;color:var(--mut);margin-top:8px;line-height:1.45;min-height:16px}\n/* template grid */\n.tgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}\n.tcell{border:2px solid transparent;border-radius:12px;overflow:hidden;padding:0;background:var(--card);position:relative}\n.tcell.on{border-color:var(--ac)}\n.tcell canvas{width:100%;display:block}\n.tcell span{position:absolute;left:0;right:0;bottom:0;font-size:9.5px;font-weight:700;color:#fff;\n  padding:8px 4px 3px;background:linear-gradient(transparent,rgba(0,0,0,.75));text-align:center}\n/* gradient swatches */\n.grads{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}\n.grad{aspect-ratio:1;border-radius:10px;border:2px solid transparent;padding:0}\n.grad.on{border-color:#fff}\n/* emoji grid */\n.egrid{display:grid;grid-template-columns:repeat(8,1fr);gap:2px}\n.egrid button{border:0;background:none;font-size:24px;padding:6px 0;border-radius:8px}\n/* colour dots */\n.slidestrip{display:flex;gap:8px;overflow-x:auto;padding:4px 2px 8px;-webkit-overflow-scrolling:touch}\n.slidechip{position:relative;flex:0 0 auto;width:60px;border-radius:10px;overflow:hidden;\n  border:2px solid transparent;cursor:pointer;line-height:0}\n.slidechip.on{border-color:var(--ac)}\n.slidechip img{width:100%;display:block}\n.slidechip .sn{position:absolute;left:4px;bottom:3px;background:rgba(0,0,0,.7);color:#fff;\n  font-size:10px;font-weight:800;border-radius:5px;padding:0 5px;line-height:15px}\n.slidechip .sx{position:absolute;right:2px;top:2px;width:17px;height:17px;border:0;border-radius:50%;\n  background:rgba(0,0,0,.7);color:#fff;font-size:10px;line-height:17px;padding:0;cursor:pointer}\n.slideadd{flex:0 0 auto;width:60px;border-radius:10px;border:1px dashed var(--line);\n  background:transparent;color:var(--mut);font-size:20px;cursor:pointer}\n.slicestrip{display:flex;gap:6px;justify-content:center;margin:4px 0 2px}\n.slice{margin:0;flex:1;min-width:0;position:relative}\n.slice img{width:100%;border-radius:8px;display:block;border:1px solid var(--line)}\n.slice figcaption{position:absolute;left:6px;top:5px;background:rgba(0,0,0,.66);color:#fff;\n  font-size:11px;font-weight:800;border-radius:6px;padding:1px 6px}\n.orderbox{background:var(--card);border:1px solid var(--line);border-radius:10px;\n  padding:11px 13px;font-size:12.5px;line-height:1.6;color:var(--mut);text-align:left}\n.orderbox b{color:var(--ink)}\n.palrow{display:flex;gap:9px;flex-wrap:wrap;margin:2px 0 4px}\n.pal{width:46px;height:34px;border-radius:10px;border:1px solid var(--line);cursor:pointer;padding:0;\n  color:#fff;font-weight:800;font-size:12px;display:grid;place-items:center}\n.pal.accent{border-radius:50%;width:34px}\n.dots{display:flex;gap:8px;flex-wrap:wrap}\n.dot{width:30px;height:30px;border-radius:50%;border:2.5px solid transparent;padding:0;\n  color:#fff;font-size:11px;font-weight:800;text-shadow:0 1px 2px rgba(0,0,0,.6);cursor:pointer}\n.dot.on{border-color:#fff}\n/* slider */\ninput[type=range]{width:100%;accent-color:var(--ac)}\n/* render progress */\n.bar{height:6px;border-radius:999px;background:var(--line);overflow:hidden}\n.bar i{display:block;height:100%;width:0;background:var(--ac);border-radius:999px;transition:width .12s linear}\n/* toggle */\n.tog{display:flex;align-items:center;justify-content:space-between;padding:4px 0}\n.tog small{color:var(--mut);font-size:12px;display:block;margin-top:2px}\n.sw{width:46px;height:28px;border-radius:999px;background:var(--line);border:0;position:relative;flex:0 0 auto;transition:background .2s}\n.sw i{position:absolute;top:3px;left:3px;width:22px;height:22px;border-radius:50%;background:#fff;transition:left .2s}\n.sw.on{background:var(--ac)}\n.sw.on i{left:21px}\n/* sheet */\n.scrim{position:fixed;inset:0;background:rgba(4,6,10,.62);display:none;align-items:flex-end;z-index:70}\n.scrim.on{display:flex}\n.sheet{background:var(--deck);border-radius:20px 20px 0 0;width:100%;max-height:88dvh;overflow-y:auto;overscroll-behavior:contain;\n  padding:20px 18px calc(24px + env(safe-area-inset-bottom));display:flex;flex-direction:column;gap:11px}\n.sheet h3{font-size:17px}\n.sheet img{width:62%;align-self:center;border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,.5)}\n.sheet .ok{color:#6cc296;font-size:13.5px;font-weight:600}\n/* posts library */\n.pgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:10px}\n.pcard2{position:relative;border:1.5px solid var(--line);border-radius:12px;overflow:hidden;background:var(--card);padding:0;cursor:pointer}\n.pcard2 img{width:100%;display:block}\n.pcard2 .pn{position:absolute;left:0;right:0;bottom:0;font-size:9px;font-weight:700;color:#fff;padding:10px 4px 3px;background:linear-gradient(transparent,rgba(0,0,0,.8));text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.pact{position:absolute;top:4px;width:22px;height:22px;border:0;border-radius:7px;background:rgba(10,14,22,.8);color:#fff;font-size:11px;line-height:1;padding:0}\n.pdup{left:4px}\n.pdel{right:4px;color:#ff6b60}\n.pdel.armed{width:auto;padding:0 7px;font-weight:700;background:#8c2a20;color:#fff}\n@media(prefers-reduced-motion:no-preference){\n  .panel.on{animation:pi .25s ease}\n  @keyframes pi{from{opacity:0;transform:translateY(6px)}to{opacity:1}}\n}\n</style></head><body>\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;top:calc(14px + env(safe-area-inset-top));transform:translateX(-50%) translateY(-16px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-family:-apple-system,system-ui,sans-serif;font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;line-height:1;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\">⚙️</span><span>AI is working… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n\n<div class=\"top\">\n  <div class=\"logo\">Social <span>Studio</span></div>\n  <div class=\"sp\"></div>\n  <button id=\"undoBtn\" class=\"ghosttop\" onclick=\"doUndo()\" disabled title=\"Undo\" aria-label=\"Undo\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 14L4 9l5-5\"/><path d=\"M4 9h10a6 6 0 0 1 0 12h-3\"/></svg></button>\n  <button onclick=\"doExport()\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3v12M7.5 10.5L12 15l4.5-4.5\"/><path d=\"M4 17v2.5A1.5 1.5 0 0 0 5.5 21h13a1.5 1.5 0 0 0 1.5-1.5V17\"/></svg>Save</button>\n</div>\n\n<div id=\"stage\"><div id=\"feedTop\"></div><canvas id=\"pv\"></canvas><div id=\"safeOv\"></div><div id=\"feedBot\"></div><div id=\"stageHint\"></div></div>\n\n<div class=\"deck\">\n  <div class=\"tabs\" id=\"tabs\"></div>\n\n  <div class=\"panel on\" id=\"p-layout\">\n    <div class=\"lbl\">Format</div>\n    <div class=\"chips\" id=\"fmtChips\"></div>\n    <div class=\"lbl\">Preview</div>\n    <div class=\"chips\" id=\"feedRow\"></div>\n    <p class=\"hint\" id=\"feedHint\"></p>\n    <div class=\"lbl\">Post type</div>\n    <div class=\"chips\" id=\"caroRow\"></div>\n    <div class=\"slidestrip\" id=\"caroStrip\" style=\"display:none\"></div>\n    <p class=\"hint\" id=\"caroHint\"></p>\n    <div id=\"splitCtl\">\n      <div class=\"lbl\">Lay one design across…</div>\n      <div class=\"chips\" id=\"splitRow\"></div>\n      <p class=\"hint\" id=\"splitHint\"></p>\n    </div>\n    <div id=\"safeCtl\" style=\"display:none\">\n      <div class=\"lbl\">Safe zones — where the app covers your post</div>\n      <div class=\"chips\" id=\"safeRow\"></div>\n      <p class=\"hint\" id=\"safeHint\"></p>\n    </div>\n    <div class=\"lbl\">Template</div>\n    <div class=\"tgrid\" id=\"tgrid\"></div>\n    <div class=\"lbl\">Type style</div>\n    <div class=\"chips\" id=\"typeRow\"></div>\n    <p class=\"hint\">Changes the lettering on every template.</p>\n  </div>\n\n  <div class=\"panel\" id=\"p-words\">\n    <div class=\"lbl\">What's the post about?</div>\n    <input type=\"text\" id=\"topic\" maxlength=\"120\" placeholder=\"e.g. weekend sale on houseplants\">\n    <div class=\"lbl\">Tone</div>\n    <div class=\"chips\" id=\"toneChips\"></div>\n    <div style=\"height:10px\"></div>\n    <button class=\"btn\" id=\"designBtn\" onclick=\"designMe()\" style=\"width:100%;background:linear-gradient(135deg,#7d5cff,#e05c8a)\">✨ Design it for me</button>\n    <div style=\"height:8px\"></div>\n    <button class=\"btn ghost\" id=\"writeBtn\" onclick=\"writeCopy()\" style=\"width:100%\">Write the words only</button>\n    <p class=\"hint\" id=\"wordsHint\"></p>\n    <div style=\"height:6px\"></div>\n    <button class=\"btn ghost\" id=\"weekBtn\" onclick=\"makeWeek()\" style=\"width:100%\">📅 Make me a week of posts</button>\n    <button class=\"btn line\" id=\"weekStop\" onclick=\"stopWeek()\" style=\"display:none;width:100%\">Stop</button>\n    <p class=\"hint\" id=\"weekHint\"></p>\n    <div class=\"lbl\">Headline</div>\n    <input type=\"text\" id=\"fHook\" maxlength=\"60\" oninput=\"S.copy.hook=this.value;paint()\">\n    <div class=\"lbl\">Supporting line</div>\n    <input type=\"text\" id=\"fSub\" maxlength=\"110\" oninput=\"S.copy.sub=this.value;paint()\">\n    <div class=\"lbl\">Button / call to action — drawn on the image</div>\n    <input type=\"text\" id=\"fCta\" maxlength=\"30\" oninput=\"S.copy.cta=this.value;paint();updCtaHint()\">\n    <p class=\"hint\" id=\"ctaHint\"></p>\n    <div class=\"lbl\">Text colour</div>\n    <div class=\"chips\" id=\"inkRow\"></div>\n    <p class=\"hint\" id=\"inkHint\"></p>\n    <div class=\"lbl\">Button style</div>\n    <div class=\"chips\" id=\"ctaStyleRow\"></div>\n    <button class=\"btn line\" id=\"ctaResetBtn\" style=\"display:none;width:100%\" onclick=\"S.ctaPos=null;paint();saveDraft();updCtaHint()\">Reset button position</button>\n    <div class=\"lbl\">Link — goes in your caption, not the image</div>\n    <input type=\"text\" id=\"fLink\" maxlength=\"120\" placeholder=\"https://…\" oninput=\"S.copy.link=this.value;saveDraft()\">\n    <div class=\"lbl\">Word size</div>\n    <input type=\"range\" id=\"tsize\" min=\"60\" max=\"150\" value=\"100\" oninput=\"S.textScale=this.value/100;paint();saveDraft()\">\n    <div class=\"lbl\">Word position — up / down</div>\n    <input type=\"range\" id=\"tpos\" min=\"-22\" max=\"22\" value=\"0\" oninput=\"S.textY=this.value/100;paint();saveDraft()\">\n    <div class=\"lbl\">Caption &amp; hashtags — copied when you save</div>\n    <textarea id=\"fCaption\" rows=\"3\" oninput=\"S.copy.caption=this.value;updCount()\"></textarea>\n    <div class=\"row\" style=\"margin-top:6px;align-items:center\">\n      <button class=\"btn ghost\" style=\"flex:1\" id=\"tagBtn\" onclick=\"suggestTags()\"># Suggest hashtags</button>\n      <span id=\"capCount\" style=\"font-size:11px;color:var(--mut);white-space:nowrap\"></span>\n    </div>\n    <div class=\"chips\" id=\"tagSets\" style=\"margin-top:6px\"></div>\n  </div>\n\n  <div class=\"panel\" id=\"p-style\">\n    <div class=\"lbl\">Background</div>\n    <div class=\"row\">\n      <button class=\"btn ghost\" style=\"flex:1\" onclick=\"pickPhoto('bg')\">Use a photo</button>\n      <button class=\"btn ghost\" style=\"flex:1\" id=\"aiBgBtn\" onclick=\"aiBackground()\">AI background</button>\n    </div>\n    <input type=\"file\" id=\"photoIn\" accept=\"image/*\" style=\"display:none\" onchange=\"loadPhoto(this)\">\n    <p class=\"hint\" id=\"styleHint\"></p>\n    <div id=\"photoCtl\" style=\"display:none\">\n      <div class=\"lbl\">Filter</div>\n      <div class=\"chips\" id=\"filterRow\" style=\"display:none\"></div>\n      <div class=\"lbl\">Photo zoom — drag to move, pinch to zoom</div>\n      <input type=\"range\" id=\"pzoom\" min=\"100\" max=\"400\" value=\"100\" oninput=\"S.photoPos.scale=this.value/100;paint()\">\n      <div class=\"lbl\">Background blur</div>\n      <input type=\"range\" id=\"pblur\" min=\"0\" max=\"16\" step=\"2\" value=\"0\" onchange=\"S.photoBlur=+this.value;bakePhoto();saveDraft()\">\n      <div id=\"palCtl\" style=\"display:none\">\n        <div class=\"lbl\">Match colours to the photo</div>\n        <div class=\"palrow\" id=\"palRow\"></div>\n        <p class=\"hint\">Swaps the photo for a gradient pulled out of it. “A” sets your accent colour.</p>\n      </div>\n      <div style=\"height:8px\"></div>\n      <button class=\"btn line\" onclick=\"clearPhoto()\" style=\"width:100%\">Remove photo</button>\n    </div>\n    <div class=\"lbl\">Gradients</div>\n    <div class=\"grads\" id=\"grads\"></div>\n    <div class=\"lbl\">Gradient direction</div>\n    <div class=\"chips\" id=\"dirRow\"></div>\n    <div class=\"lbl\">Solid colours</div>\n    <div class=\"dots\" id=\"solidRow\"></div>\n    <div class=\"lbl\">Finish</div>\n    <div class=\"chips\" id=\"texRow\"></div>\n    <div class=\"lbl\">Text backdrop</div>\n    <div class=\"chips\" id=\"plateRow\"></div>\n    <p class=\"hint\" id=\"plateHint\"></p>\n    <div class=\"lbl\">Scrim strength</div>\n    <div class=\"chips\" id=\"scrimRow\"></div>\n    <div class=\"lbl\">Frame</div>\n    <div class=\"chips\" id=\"frameRow\"></div>\n    <div class=\"lbl\">Photo in the post</div>\n    <button class=\"btn ghost\" style=\"width:100%\" onclick=\"pickPhoto('item')\">＋ Add a framed photo</button>\n    <p class=\"hint\">It lands on the preview — drag to place, select it to resize or remove.</p>\n  </div>\n\n  <div class=\"panel\" id=\"p-stickers\">\n    <div class=\"lbl\">Tap to add — then drag on the preview</div>\n    <div class=\"egrid\" id=\"egrid\"></div>\n    <div class=\"row\" style=\"margin-top:8px\">\n      <input type=\"text\" id=\"anyEmoji\" maxlength=\"4\" placeholder=\"Any emoji…\" style=\"flex:1\">\n      <button class=\"btn ghost\" onclick=\"addAnyEmoji()\">Add</button>\n    </div>\n    <div class=\"lbl\">Banner badge</div>\n    <div class=\"row\">\n      <input type=\"text\" id=\"banText\" maxlength=\"12\" placeholder=\"SALE\" style=\"flex:1\">\n      <button class=\"btn ghost\" onclick=\"addBanner()\">Add</button>\n    </div>\n    <div class=\"lbl\">Badge shape</div>\n    <div class=\"chips\" id=\"badgeRow\"></div>\n    <div class=\"lbl\">Badge colour</div>\n    <div class=\"dots\" id=\"badgeCols\"></div>\n    <div id=\"selCtl\" style=\"display:none\">\n      <div class=\"lbl\">Selected sticker</div>\n      <input type=\"range\" id=\"ssize\" min=\"24\" max=\"200\" oninput=\"if(sel){sel.size=+this.value;paint()}\">\n      <div id=\"selBadge\" style=\"display:none\">\n        <p class=\"hint\" style=\"margin:8px 0 0\">Shape and colour above change this badge while it's selected.</p>\n      </div>\n      <div style=\"height:8px\"></div>\n      <button class=\"btn line\" style=\"width:100%;border-color:var(--danger);color:var(--danger)\" onclick=\"deleteSel()\">Remove sticker</button>\n    </div>\n  </div>\n\n  <div class=\"panel\" id=\"p-video\">\n    <p class=\"hint\" id=\"vidSplitWarn\" style=\"display:none;color:var(--danger)\">\n      This design is split across frames, so it exports as still images. Set “Lay one design across” back to Single to make a reel.</p>\n    <p class=\"hint\" id=\"vidFmtHint\"></p>\n    <button class=\"btn line\" id=\"vidFmtBtn\" style=\"display:none;width:100%\" onclick=\"useReelFormat()\">Switch to 9:16 for Reels &amp; Stories</button>\n    <div class=\"lbl\">Motion</div>\n    <div class=\"chips\" id=\"motionRow\"></div>\n    <p class=\"hint\" id=\"motionHint\"></p>\n    <div class=\"lbl\">How the words arrive</div>\n    <div class=\"chips\" id=\"textInRow\"></div>\n    <p class=\"hint\" id=\"textInHint\"></p>\n    <div class=\"lbl\">Light effect</div>\n    <div class=\"chips\" id=\"lightRow\"></div>\n    <p class=\"hint\" id=\"lightHint\"></p>\n    <div class=\"lbl\">End card</div>\n    <div class=\"chips\" id=\"endRow\"></div>\n    <p class=\"hint\" id=\"endHint\"></p>\n    <div class=\"lbl\">Length — <span id=\"vidLen\">6s</span></div>\n    <input type=\"range\" id=\"vsecs\" min=\"3\" max=\"15\" value=\"6\" oninput=\"setReelSecs(+this.value)\">\n    <div style=\"height:10px\"></div>\n    <button class=\"btn ghost\" id=\"playBtn\" style=\"width:100%\" onclick=\"toggleReel()\">▶ Play preview</button>\n    <div style=\"height:8px\"></div>\n    <button class=\"btn\" id=\"vidBtn\" style=\"width:100%\" onclick=\"exportReel()\">Save reel to Photos</button>\n    <div id=\"vidProg\" style=\"display:none;margin-top:12px\">\n      <div class=\"bar\"><i id=\"vidBarFill\"></i></div>\n      <p class=\"hint\" id=\"vidProgTxt\"></p>\n      <button class=\"btn line\" style=\"width:100%\" onclick=\"cancelReel()\">Stop</button>\n    </div>\n    <p class=\"hint\" id=\"vidHint\"></p>\n  </div>\n\n  <div class=\"panel\" id=\"p-brand\">\n    <div class=\"lbl\">Your handle — shown on every post</div>\n    <input type=\"text\" id=\"bHandle\" maxlength=\"30\" placeholder=\"@yourname\" oninput=\"BRAND.handle=this.value;saveBrand();paint()\">\n    <div class=\"lbl\">Accent colour</div>\n    <div class=\"dots\" id=\"bDots\"></div>\n    <div class=\"lbl\">Watermark</div>\n    <div class=\"tog\"><div>Made with Social Studio<small>A little corner credit on exports</small></div>\n      <button class=\"sw\" id=\"wmSw\" onclick=\"BRAND.wm=!BRAND.wm;saveBrand();renderBrand();paint()\"><i></i></button></div>\n    <div class=\"lbl\">Logo — shown on every post</div>\n    <div class=\"row\">\n      <button class=\"btn ghost\" style=\"flex:1\" onclick=\"pickLogo()\">Add logo</button>\n      <button class=\"btn line\" id=\"logoRm\" style=\"display:none\" onclick=\"removeLogo()\">Remove</button>\n    </div>\n    <input type=\"file\" id=\"logoIn\" accept=\"image/*\" style=\"display:none\" onchange=\"loadLogoFile(this)\">\n    <div id=\"logoCtl\" style=\"display:none\">\n      <div class=\"lbl\">Corner</div>\n      <div class=\"chips\" id=\"logoPosRow\"></div>\n      <div class=\"lbl\">Logo size</div>\n      <input type=\"range\" id=\"logoSizeR\" min=\"6\" max=\"20\" value=\"12\" oninput=\"BRAND.logoSize=this.value/100;saveBrand();paint()\">\n    </div>\n  </div>\n\n  <div class=\"panel\" id=\"p-posts\">\n    <button class=\"btn ghost\" style=\"width:100%\" onclick=\"savePost()\">＋ Save current post to library</button>\n    <p class=\"hint\" id=\"libHint\"></p>\n    <div class=\"pgrid\" id=\"libGrid\"></div>\n  </div>\n</div>\n\n<div class=\"scrim\" id=\"scrim\" onclick=\"if(event.target===this)el('scrim').classList.remove('on')\">\n  <div class=\"sheet\" id=\"sheet\"></div>\n</div>\n\n<script>\n\"use strict\";\nvar store = window.myllmStorage || {\n  getItem:function(k){ try{return Promise.resolve(localStorage.getItem(k));}catch(e){return Promise.resolve(null);} },\n  setItem:function(k,v){ try{localStorage.setItem(k,v);}catch(e){} return Promise.resolve(); }\n};\nfunction el(i){ return document.getElementById(i); }\nfunction haptic(k){ if(window.myllmHaptic) try{ myllmHaptic(k||'light'); }catch(e){} }\n\n/* ---------------- model ---------------- */\nvar FORMATS = { square:{w:1080,h:1080,name:\"1:1\"}, portrait:{w:1080,h:1350,name:\"4:5\"}, story:{w:1080,h:1920,name:\"9:16\"} };\n/* Saved posts and drafts store S.bg.grad as an INDEX into this array, so new\n   palettes may only ever be APPENDED — inserting one would silently restyle\n   every post in everyone's library. */\nvar GRADS = [[\"#1b2a4a\",\"#4f8df9\"],[\"#2d1b4a\",\"#b06df9\"],[\"#0f3d3a\",\"#2fbf9b\"],[\"#4a1b2d\",\"#f9646c\"],\n             [\"#4a3a1b\",\"#f9b64f\"],[\"#1b1d22\",\"#5b6472\"],[\"#0e2233\",\"#3fa7d6\"],[\"#331b3d\",\"#e05c8a\"],\n             [\"#12331e\",\"#6cc267\"],[\"#33270e\",\"#d69a3f\"],[\"#101010\",\"#3c3c44\"],[\"#26123d\",\"#7d5cff\"],\n             /* light palettes — added with the dark-ink option, which is what\n                finally makes them usable */\n             [\"#fdf6ec\",\"#f2c9a0\"],[\"#f4f1fb\",\"#c9b6f2\"],[\"#eef7f3\",\"#a8d8c4\"],\n             [\"#fdf0f2\",\"#f3b8c2\"],[\"#f2f5fa\",\"#b9cbe4\"],[\"#fbf7ed\",\"#e0d3ae\"],\n             /* neon — near-black bases so the second colour reads as emitted\n                light rather than as paint. They only work with light ink. */\n             /* the third value holds the dark colour out to that stop, so the\n                bright one stays a glow at one edge instead of filling half the\n                frame — which is the whole difference between neon and a plain\n                two-colour ramp. Older palettes have no third value and are\n                unaffected. */\n             [\"#07070f\",\"#00e5ff\",.52],[\"#0b0413\",\"#ff2fd0\",.52],[\"#050d0a\",\"#39ff88\",.55],\n             [\"#0d0616\",\"#a855ff\",.5],[\"#100604\",\"#ff6a00\",.55],[\"#00070f\",\"#3d5bff\",.5]];\nvar GRAD_LIGHT_FROM = 12;   // index of the first light palette (the six after\n                            // those are neon, and dark again)\nvar TONES = [\"Playful\",\"Premium\",\"Bold\",\"Minimal\"];\nvar EMOJI = \"🔥✨🎉💥⭐️❤️💙💚🖤🙌👏💪🚀🌈☀️🌙🌸🌿🍕☕️🍰🥂🎁🏷️📣📸🎵🏆✅➡️💡🛍️🎯🕐📍🌍😄😍🤩😎🥳🤍💫🫶🍂❄️🌊\".match(/./gu).filter(function(c){return c.trim();});\n\n/* template text layout: blocks positioned in fractions of canvas */\nvar TEMPLATES = {\n  quote:   { name:\"Quote\",   scrim:.45, blocks:[\n      {key:\"hook\", font:\"600 %fpx ui-serif, Georgia, serif\", size:.085, y:.42, maxLines:4, quote:true},\n      {key:\"sub\",  font:\"500 %fpx -apple-system, sans-serif\", size:.031, y:.68, maxLines:1, caps:true}]},\n  promo:   { name:\"Promo\",   scrim:.5, blocks:[\n      {key:\"hook\", font:\"800 %fpx -apple-system, sans-serif\", size:.093, y:.45, maxLines:3},\n      {key:\"sub\",  font:\"500 %fpx -apple-system, sans-serif\", size:.036, y:.63, maxLines:2},\n      {key:\"cta\",  pill:true, size:.034, y:.76}]},\n  announce:{ name:\"Announce\",scrim:.42, rule:true, blocks:[\n      {key:\"sub\",  font:\"600 %fpx -apple-system, sans-serif\", size:.03,  y:.34, maxLines:1, caps:true},\n      {key:\"hook\", font:\"750 %fpx ui-serif, Georgia, serif\",  size:.082, y:.5,  maxLines:3},\n      {key:\"cta\",  font:\"600 %fpx -apple-system, sans-serif\", size:.031, y:.68, maxLines:1}]},\n  tips:    { name:\"Tip list\",scrim:.55, blocks:[\n      {key:\"hook\", font:\"800 %fpx -apple-system, sans-serif\", size:.062, y:.2, maxLines:2},\n      {key:\"sub\",  font:\"500 %fpx -apple-system, sans-serif\", size:.037, y:.5, maxLines:6, list:true}]},\n  photocap:{ name:\"Caption\", scrim:0, band:.3, blocks:[\n      {key:\"hook\", font:\"700 %fpx -apple-system, sans-serif\", size:.05,  y:.84, maxLines:2},\n      {key:\"sub\",  font:\"400 %fpx -apple-system, sans-serif\", size:.03,  y:.93, maxLines:1}]},\n  bold:    { name:\"Bold\",    scrim:.25, blocks:[\n      {key:\"hook\", font:\"850 %fpx -apple-system, sans-serif\", size:.135, y:.5, maxLines:4, caps:true}]}\n};\n\n/* Type styles override the FAMILY a template asks for while keeping its weight\n   and size intent, so \"Editorial\" reads as itself on every layout.\n\n   System faces only — a webfont would break the one-self-contained-file rule\n   and cost more than the whole app weighs. These six all ship with iOS.\n   `auto` keeps each template's original font, so every post made before this\n   existed still renders exactly as it did.                                    */\nvar TYPES = {\n  auto:     { name:\"Template\" },\n  sans:     { name:\"Modern\",     display:'-apple-system, \"Helvetica Neue\", sans-serif',\n                                 body:'-apple-system, \"Helvetica Neue\", sans-serif' },\n  serif:    { name:\"Editorial\",  display:'ui-serif, Georgia, \"Times New Roman\", serif',\n                                 body:'-apple-system, sans-serif' },\n  condensed:{ name:\"Impact\",     display:'\"Avenir Next Condensed\", \"HelveticaNeue-CondensedBold\", Impact, sans-serif',\n                                 body:'\"Avenir Next Condensed\", -apple-system, sans-serif', wDisplay:800 },\n  rounded:  { name:\"Friendly\",   display:'ui-rounded, \"SF Pro Rounded\", -apple-system, sans-serif',\n                                 body:'ui-rounded, \"SF Pro Rounded\", -apple-system, sans-serif' },\n  slab:     { name:\"Typewriter\", display:'\"American Typewriter\", Rockwell, Georgia, serif',\n                                 body:'\"American Typewriter\", Rockwell, Georgia, serif', wDisplay:700 },\n  mono:     { name:\"Mono\",       display:'ui-monospace, Menlo, \"Courier New\", monospace',\n                                 body:'ui-monospace, Menlo, \"Courier New\", monospace', wDisplay:700 }\n};\n/* Template fonts look like `600 %fpx ui-serif, Georgia, serif` — split the\n   weight off the front and the family off the back so we can swap either. */\nfunction fontFor(b,fs){\n  var raw=b.font||\"600 %fpx -apple-system, sans-serif\";\n  var T=TYPES[S.type]||TYPES.auto;\n  if(!T.display)return raw.replace(\"%f\",fs);\n  var m=/^\\s*(\\d+)\\s+%fpx\\s+(.+)$/.exec(raw);\n  var w=m?+m[1]:600;\n  var isDisplay=(b.key===\"hook\");\n  if(isDisplay&&T.wDisplay)w=T.wDisplay;\n  return w+\" \"+fs+\"px \"+(isDisplay?T.display:T.body);\n}\nfunction bodyFamily(){\n  var T=TYPES[S.type]||TYPES.auto;\n  return T.body||'-apple-system, sans-serif';\n}\n\nvar S = {\n  format:\"square\", template:\"promo\", textScale:1, ink:\"light\", type:\"auto\", split:1,\n  gradDir:\"diag\", texture:\"none\", plate:\"none\", vig:false, scrimAdj:1, frame:\"none\", photoBlur:0, textY:0, ctaStyle:\"pill\", ctaPos:null,\n  bg:{ type:\"grad\", grad:0, aiUrl:null },\n  photo:null, photoPos:{x:0,y:0,scale:1},\n  copy:{ hook:\"Weekend plant sale\", sub:\"Every leafy friend 20% off, Saturday only\", cta:\"Visit us\", caption:\"\", tone:\"Playful\" },\n  stickers:[],  // {kind:'emoji'|'banner', txt, x,y (0..1), size(px @1080)}\n  video:{ motion:\"drift\", textIn:\"word\", secs:6, fps:30, end:\"off\", light:\"none\" }\n};\nvar BRAND = { handle:\"\", accent:\"#4f8df9\", wm:true, logo:null, logoPos:\"tr\", logoSize:0.12, logoImg:null };\nvar sel = null;\n\n/* ---------------- ink ----------------\n\n   Everything used to be drawn white, which quietly capped the app at one\n   aesthetic: dark background, white words. Ink is threaded through every text\n   site instead, and three things have to flip with it, not just the fill:\n\n     · the shadow — a black drop behind dark words is mud; dark ink wants a\n       light halo to lift it off a busy photo\n     · the scrim — the wash that buys legibility must go WHITE under dark ink,\n       otherwise it fights the text it exists to help\n     · the rules, handle and watermark, or they strand as white on cream        */\nvar INKS = { light:\"#ffffff\", dark:\"#14151c\" };\nfunction inkColor(){\n  if(S.ink===\"accent\")return BRAND.accent;\n  return INKS[S.ink]||INKS.light;\n}\n/* Relative luminance, the same weighting the contrast maths uses. */\nfunction lumaHex(h){\n  h=String(h||\"\").replace(\"#\",\"\");\n  if(h.length===3)h=h[0]+h[0]+h[1]+h[1]+h[2]+h[2];\n  var n=parseInt(h,16);if(isNaN(n))return 1;\n  return (0.2126*((n>>16)&255)+0.7152*((n>>8)&255)+0.0722*(n&255))/255;\n}\nfunction inkIsDark(){ return lumaHex(inkColor())<.5; }\n/* [r,g,b] from a hex colour, or null if it isn't one — callers fall back\n   rather than painting with NaN */\nfunction hexRGB(h){\n  h=String(h||\"\").replace(\"#\",\"\");\n  if(h.length===3)h=h[0]+h[0]+h[1]+h[1]+h[2]+h[2];\n  if(!/^[0-9a-f]{6}$/i.test(h))return null;\n  var n=parseInt(h,16);\n  return [(n>>16)&255,(n>>8)&255,n&255];\n}\n/* Label colour for anything drawn ON a coloured surface — a pale badge needs\n   dark text whatever the page ink is doing. */\nfunction onColor(c){ return lumaHex(c)>.62?\"#14151c\":\"#ffffff\"; }\nfunction onAccent(){ return onColor(BRAND.accent); }\n/* Dark words get a soft light halo; light words keep the original black drop,\n   so an untouched post renders exactly as it always did. */\nfunction inkShadow(){ return inkIsDark()?\"rgba(255,255,255,.55)\":\"rgba(0,0,0,.45)\"; }\nfunction scrimRGBA(a){ return inkIsDark()?\"rgba(255,255,255,\"+a+\")\":\"rgba(8,10,16,\"+a+\")\"; }\nfunction inkAlpha(a){\n  var c=inkColor();\n  if(c===\"#ffffff\")return \"rgba(255,255,255,\"+a+\")\";\n  if(c===INKS.dark) return \"rgba(20,21,28,\"+a+\")\";\n  return c;   // accent: no alpha variant, it is already a deliberate colour\n}\n\n/* Suggest an ink by measuring the finished background. Renders the background\n   layers only — flag read by render() — so the answer accounts for gradient,\n   photo, texture, vignette AND the scrim, rather than guessing from a swatch. */\nvar _bgOnly=false;\nfunction bgLuma(){\n  var c=document.createElement(\"canvas\");\n  _bgOnly=true;\n  try{ render(c,64,64,true); }catch(e){ return 0; }finally{ _bgOnly=false; }\n  var d;\n  try{ d=c.getContext(\"2d\").getImageData(0,0,64,64).data; }catch(e){ return 0; }\n  var s=0,n=0;\n  for(var i=0;i<d.length;i+=4){ s+=0.2126*d[i]+0.7152*d[i+1]+0.0722*d[i+2]; n++; }\n  return n?s/n/255:0;\n}\n/* ---------------- feed chrome ----------------\n\n   A post never appears alone. Seen at feed size under a name row and above a\n   two-line caption, a headline that felt bold in the editor often turns out to\n   be unreadable — this is the cheapest way to catch that before posting.\n\n   Generic by design: no platform logo, wordmark or exact icon set. It is a\n   sanity check on scale and crop, not an impersonation of anyone's app.       */\nvar feedChrome=false;\nvar FEED_TOP_H=36, FEED_BOT_H=64;\nfunction buildFeed(){\n  var row=el('feedRow'); if(!row)return;\n  row.innerHTML='';\n  [['off','Plain'],['on','In a feed']].forEach(function(o){\n    var b=document.createElement('button');\n    b.className='chip'+((feedChrome?'on':'off')===o[0]?' on':'');\n    b.textContent=o[1];\n    b.onclick=function(){ feedChrome=(o[0]==='on');buildFeed();paint();saveDraft();haptic('selection'); };\n    row.appendChild(b);\n  });\n  el('feedHint').textContent = feedChrome\n    ? 'A stand-in feed, not any particular app — for judging size and crop.'\n    : 'See the post at feed size, under a name row and above the caption.';\n}\nfunction paintFeed(){\n  var top=el('feedTop'),bot=el('feedBot'),cv=el('pv');\n  if(!top||!bot||!cv)return;\n  if(!feedChrome){ top.className='';bot.className='';return; }\n  var st=el('stage'),r=cv.getBoundingClientRect(),sr=st.getBoundingClientRect();\n  var L=r.left-sr.left,W=r.width;\n  top.className='on';bot.className='on';\n  top.style.left=L+'px';top.style.width=W+'px';\n  top.style.top=(r.top-sr.top-FEED_TOP_H)+'px';top.style.height=(FEED_TOP_H-6)+'px';\n  bot.style.left=L+'px';bot.style.width=W+'px';\n  bot.style.top=(r.bottom-sr.top)+'px';\n  var handle=BRAND.handle||'@yourname';\n  top.innerHTML='<div class=\"av\"></div><div class=\"nm\">'+esc(handle)+\n    '<small>Sponsored</small></div><div class=\"dots\">•••</div>';\n  var cap=(S.copy.caption||S.copy.sub||'').trim();\n  bot.innerHTML=\n    '<div class=\"icons\">'+\n      '<svg viewBox=\"0 0 24 24\"><path d=\"M12 20s-7-4.35-7-9a4 4 0 0 1 7-2.65A4 4 0 0 1 19 11c0 4.65-7 9-7 9z\"/></svg>'+\n      '<svg viewBox=\"0 0 24 24\"><path d=\"M21 12a8 8 0 1 1-3.2-6.4L21 4l-1 4\"/></svg>'+\n      '<svg viewBox=\"0 0 24 24\"><path d=\"M4 12l16-8-6 16-2.5-6z\"/></svg>'+\n    '</div>'+\n    '<div class=\"cap\"><b>'+esc(handle.replace(/^@/,''))+'</b> '+\n      (cap?esc(cap):'<i>your caption appears here</i>')+'</div>';\n}\nfunction esc(t){ return String(t||'').replace(/[&<>]/g,function(c){\n  return {'&':'&amp;','<':'&lt;','>':'&gt;'}[c]; }); }\n\n/* ---------------- carousel ----------------\n\n   A carousel is a SET, so the design is shared and only the content varies —\n   that is how people actually build them, and it removes the main way they go\n   wrong (slide 3 quietly drifting off-brand). Format, template, type style,\n   ink, background, texture and frame all live on S and stay put; a slide\n   carries just the words and the stickers.\n\n   Slides are stored as the same packed shape the library already uses, so the\n   sticker packing, budget shedding and restore paths are all reused rather\n   than reinvented.                                                            */\nvar CARO={on:false,slides:[],idx:0};\nvar CARO_MAX=10;\n\nfunction caroCapture(){                    // current editor -> slide record\n  return { copy:JSON.parse(JSON.stringify(S.copy)),\n           stickers:packStickers(S.stickers),\n           ctaPos:S.ctaPos||null, textY:S.textY||0 };\n}\nfunction caroApply(sl){                    // slide record -> editor\n  if(!sl)return;\n  S.copy=Object.assign({},S.copy,sl.copy||{});\n  S.stickers=restoreStickers(sl.stickers);\n  S.ctaPos=sl.ctaPos||null;\n  S.textY=typeof sl.textY==='number'?sl.textY:0;\n  sel=null;var sc=el('selCtl');if(sc)sc.style.display='none';\n}\nfunction caroSync(){ if(CARO.on)CARO.slides[CARO.idx]=caroCapture(); }\nfunction caroGo(i){\n  if(!CARO.on||i<0||i>=CARO.slides.length)return;\n  caroSync();\n  CARO.idx=i;\n  caroApply(CARO.slides[i]);\n  fillWordFields();buildCaro();paint();saveDraft();haptic('selection');\n}\nfunction caroAdd(){\n  if(!CARO.on||CARO.slides.length>=CARO_MAX)return;\n  caroSync();\n  // a new slide inherits the current words as a starting point, which beats\n  // facing an empty canvas mid-flow\n  CARO.slides.splice(CARO.idx+1,0,caroCapture());\n  CARO.idx++;\n  caroApply(CARO.slides[CARO.idx]);\n  fillWordFields();buildCaro();paint();saveDraft();haptic('success');\n}\nfunction caroDel(i){\n  if(!CARO.on||CARO.slides.length<=1)return;\n  CARO.slides.splice(i,1);\n  if(CARO.idx>=CARO.slides.length)CARO.idx=CARO.slides.length-1;\n  caroApply(CARO.slides[CARO.idx]);\n  fillWordFields();buildCaro();paint();saveDraft();haptic('warning');\n}\nfunction caroToggle(on){\n  if(on===CARO.on)return;\n  if(on){\n    CARO.on=true;CARO.slides=[caroCapture()];CARO.idx=0;\n    S.split=1;                              // a split strip and a carousel are different jobs\n    buildSplit();\n  }else{\n    caroSync();\n    CARO.on=false;                          // slide 1 stays loaded as the single post\n    CARO.slides=[];CARO.idx=0;\n  }\n  buildCaro();buildSplit();paint();saveDraft();haptic('selection');\n}\n/* Thumbnails come from the real renderer at 96px, so what you scrub through is\n   genuinely what will export. */\nfunction caroThumb(i){\n  var keepCopy=S.copy,keepSt=S.stickers,keepCta=S.ctaPos,keepY=S.textY,keepSel=sel;\n  var sl=CARO.slides[i];\n  if(i!==CARO.idx&&sl){\n    S.copy=Object.assign({},S.copy,sl.copy||{});\n    S.stickers=(sl.stickers||[]).filter(function(s){return s.kind!=='photo';});\n    S.ctaPos=sl.ctaPos||null;S.textY=sl.textY||0;\n  }\n  sel=null;\n  var f=FORMATS[S.format],c=document.createElement('canvas');\n  try{ render(c,96,Math.round(96*f.h/f.w),true); }catch(e){}\n  S.copy=keepCopy;S.stickers=keepSt;S.ctaPos=keepCta;S.textY=keepY;sel=keepSel;\n  return c.toDataURL('image/jpeg',.7);\n}\nfunction buildCaro(){\n  var row=el('caroRow'),strip=el('caroStrip'); if(!row)return;\n  row.innerHTML='';\n  [['off','Single post'],['on','Carousel']].forEach(function(o){\n    var b=document.createElement('button');\n    b.className='chip'+((CARO.on?'on':'off')===o[0]?' on':'');\n    b.textContent=o[1];\n    b.onclick=function(){ caroToggle(o[0]==='on'); };\n    row.appendChild(b);\n  });\n  if(!CARO.on){ strip.style.display='none'; strip.innerHTML=''; el('caroHint').textContent=\n    'Build a set of slides that share one design — only the words change.'; return; }\n  strip.style.display='';\n  strip.innerHTML='';\n  CARO.slides.forEach(function(_,i){\n    var d=document.createElement('div');\n    d.className='slidechip'+(i===CARO.idx?' on':'');\n    var im=document.createElement('img');im.src=caroThumb(i);im.alt='';\n    d.appendChild(im);\n    var nm=document.createElement('span');nm.className='sn';nm.textContent=i+1;d.appendChild(nm);\n    d.onclick=function(){ caroGo(i); };\n    if(CARO.slides.length>1){\n      var x=document.createElement('button');x.className='sx';x.textContent='✕';\n      x.onclick=function(ev){ ev.stopPropagation();caroDel(i); };\n      d.appendChild(x);\n    }\n    strip.appendChild(d);\n  });\n  if(CARO.slides.length<CARO_MAX){\n    var a=document.createElement('button');\n    a.className='slideadd';a.textContent='＋';a.title='Add a slide';\n    a.onclick=caroAdd;\n    strip.appendChild(a);\n  }\n  el('caroHint').textContent='Slide '+(CARO.idx+1)+' of '+CARO.slides.length+\n    ' — the design is shared, the words are per slide.';\n}\nfunction exportCarousel(){\n  caroSync();\n  var f=FORMATS[S.format];\n  var keepIdx=CARO.idx,keepSel=sel;sel=null;\n  var imgs=CARO.slides.map(function(sl,i){\n    caroApply(sl);\n    var c=document.createElement('canvas');\n    render(c,f.w,f.h,true);\n    return c.toDataURL('image/jpeg',.92);\n  });\n  CARO.idx=keepIdx;caroApply(CARO.slides[keepIdx]);sel=keepSel;\n  fillWordFields();paint();\n\n  splitParts=imgs;\n  var saved=0;\n  if(window.myllmSaveImage)imgs.forEach(function(d){ try{ myllmSaveImage(d);saved++; }catch(e){} });\n  var caption=captionOut(),copied=false;\n  if(caption){\n    try{\n      var ta=document.createElement('textarea');ta.value=caption;document.body.appendChild(ta);\n      ta.select();copied=document.execCommand('copy');document.body.removeChild(ta);\n    }catch(e){}\n  }\n  var strip=imgs.map(function(d,i){\n    return '<figure class=\"slice\"><img src=\"'+d+'\" alt=\"Slide '+(i+1)+'\">'+\n           '<figcaption>'+(i+1)+'</figcaption></figure>';\n  }).join('');\n  el('sheet').innerHTML=\n    '<h3>'+(saved===imgs.length?('All '+imgs.length+' slides saved to Photos'):('Your '+imgs.length+' slides are ready'))+'</h3>'+\n    '<div class=\"slicestrip\">'+strip+'</div>'+\n    '<div class=\"orderbox\">Add them to your carousel in order — 1 first. '+\n      'They are saved to Photos in the same order.</div>'+\n    (window.myllmShareFile?imgs.map(function(_,i){\n      return '<button class=\"btn ghost\" onclick=\"shareSplitPart('+i+')\">Share slide '+(i+1)+'…</button>';\n    }).join(''):'')+\n    (saved===imgs.length?'':'<p class=\"hint\">Press and hold each slide to save it.</p>')+\n    (caption&&copied?'<p class=\"ok\">Caption + hashtags copied.</p>':'')+\n    '<button class=\"btn line\" onclick=\"el(\\'scrim\\').classList.remove(\\'on\\')\">Done</button>';\n  el('scrim').classList.add('on');\n  haptic('success');\n}\n\n/* ---------------- split across frames ----------------\n\n   One design laid over 2 or 3 tiles. It needs no new state model at all:\n   render() positions everything in FRACTIONS of the canvas it is handed, so\n   asking it for a canvas N times as wide spreads the whole composition — type,\n   scrim, gradient, stickers — across the full span for free. We then cut it\n   into N square frames.\n\n   Two ways to use the result, and the difference is only in posting order:\n\n     · Carousel — upload the slices in order 1,2,3. Swiping pans across one\n       unbroken picture.\n     · Profile grid — the grid fills newest-first from the top left, so the\n       slices must be posted in REVERSE (3,2,1) to end up left-to-right. Get\n       that wrong and the picture is mirrored, which is why the export sheet\n       spells it out rather than assuming it's known.                          */\nfunction splitN(){ return Math.max(1,Math.min(3,S.split||1)); }\nfunction splitSlices(){\n  var f=FORMATS[S.format],n=splitN();\n  var wide=document.createElement('canvas');\n  var keep=sel;sel=null;\n  render(wide,f.w*n,f.h,true);\n  sel=keep;\n  var out=[];\n  for(var i=0;i<n;i++){\n    var c=document.createElement('canvas');c.width=f.w;c.height=f.h;\n    c.getContext('2d').drawImage(wide,i*f.w,0,f.w,f.h,0,0,f.w,f.h);\n    out.push(c.toDataURL('image/jpeg',.92));\n  }\n  return out;\n}\nfunction buildSplit(){\n  var row=el('splitRow'); if(!row)return;\n  row.innerHTML='';\n  [1,2,3].forEach(function(n){\n    var b=document.createElement('button');\n    b.className='chip'+(splitN()===n?' on':'');\n    b.textContent=n===1?'Single':(n+' frames');\n    b.onclick=function(){\n      S.split=n;\n      if(n>1&&reelRAF)stopReel();\n      buildSplit();buildSafe();paint();saveDraft();haptic('selection');\n    };\n    row.appendChild(b);\n  });\n  var sc=el('splitCtl'); if(sc)sc.style.display=CARO.on?'none':'';\n  el('splitHint').textContent = splitN()===1\n    ? 'Lay one design across 2 or 3 posts — a panorama for a carousel, or a strip in your profile grid.'\n    : 'The design spreads across '+splitN()+' frames. Dashed lines show where they cut.';\n  var v=el('vidSplitWarn'); if(v)v.style.display=splitN()>1?'':'none';\n}\n/* Dividers ride the same DOM overlay as the safe zones, so they can never be\n   baked into an exported slice. */\nfunction paintSplitGuides(ov,w,h){\n  var n=splitN(),html='';\n  for(var i=1;i<n;i++)\n    html+='<div class=\"cut\" style=\"left:'+(i/n*100)+'%\"></div>';\n  return html;\n}\n\nvar splitParts=[];\nfunction shareSplitPart(i){\n  if(!splitParts[i]||!window.myllmShareFile)return;\n  myllmShareFile(splitParts[i],{filename:'post-'+(i+1)+'.jpg',mime:'image/jpeg'}).catch(function(){});\n}\nfunction exportSplit(){\n  var n=splitN();\n  splitParts=splitSlices();\n  var saved=0;\n  if(window.myllmSaveImage){\n    // Saved in order, so Photos holds them 1..N — the reverse-posting note\n    // below is about which one you UPLOAD first, not how they are stored.\n    splitParts.forEach(function(d){ try{ myllmSaveImage(d);saved++; }catch(e){} });\n  }\n  var caption=captionOut(),copied=false;\n  if(caption){\n    try{\n      var ta=document.createElement('textarea');ta.value=caption;document.body.appendChild(ta);\n      ta.select();copied=document.execCommand('copy');document.body.removeChild(ta);\n    }catch(e){}\n  }\n  var strip=splitParts.map(function(d,i){\n    return '<figure class=\"slice\"><img src=\"'+d+'\" alt=\"Frame '+(i+1)+'\">'+\n           '<figcaption>'+(i+1)+'</figcaption></figure>';\n  }).join('');\n  var shareBtns=window.myllmShareFile\n    ? splitParts.map(function(_,i){\n        return '<button class=\"btn ghost\" onclick=\"shareSplitPart('+i+')\">Share frame '+(i+1)+'…</button>';\n      }).join('')\n    : '';\n  el('sheet').innerHTML=\n    '<h3>'+(saved===n?('All '+n+' frames saved to Photos'):('Your '+n+' frames are ready'))+'</h3>'+\n    '<div class=\"slicestrip\">'+strip+'</div>'+\n    '<div class=\"orderbox\">'+\n      '<b>Posting as a carousel?</b> Add them in order — 1, then 2'+(n>2?', then 3':'')+'.'+\n      '<br><b>Posting to your profile grid?</b> Post them in <b>reverse</b> — '+\n      n+(n>2?', then 2, then 1':', then 1')+\n      '. The grid fills newest-first, so posting forwards leaves the picture mirrored.'+\n    '</div>'+\n    shareBtns+\n    (saved===n?'':'<p class=\"hint\">Press and hold each frame to save it.</p>')+\n    (caption&&copied?'<p class=\"ok\">Caption + hashtags copied.</p>':'')+\n    '<button class=\"btn line\" onclick=\"el(\\'scrim\\').classList.remove(\\'on\\')\">Done</button>';\n  el('scrim').classList.add('on');\n  haptic('success');\n}\n\n/* ---------------- palette from photo ----------------\n\n   A stock gradient behind someone's own photograph is the tell that a post was\n   made from a template. Pulling the palette out of the picture makes the two\n   look designed together.\n\n   Hues are bucketed and scored by frequency WEIGHTED BY SATURATION, because\n   the largest region of a photo is usually a flat grey sky or wall — the\n   colour a person would actually name is rarely the most common one.          */\nfunction rgb2hsl(r,g,b){\n  r/=255;g/=255;b/=255;\n  var mx=Math.max(r,g,b),mn=Math.min(r,g,b),h=0,s=0,l=(mx+mn)/2,d=mx-mn;\n  if(d){\n    s=l>.5?d/(2-mx-mn):d/(mx+mn);\n    h=mx===r?((g-b)/d+(g<b?6:0)):mx===g?((b-r)/d+2):((r-g)/d+4);\n    h/=6;\n  }\n  return [h,s,l];\n}\nfunction hsl2hex(h,s,l){\n  function f(n){\n    var k=(n+h*12)%12,a=s*Math.min(l,1-l);\n    var v=l-a*Math.max(-1,Math.min(k-3,Math.min(9-k,1)));\n    return Math.round(255*v).toString(16).padStart(2,\"0\");\n  }\n  return \"#\"+f(0)+f(8)+f(4);\n}\nfunction photoPalette(){\n  var im=S.photoDraw||S.photo; if(!im||!im.width)return null;\n  var c=document.createElement(\"canvas\");c.width=c.height=40;\n  var x=c.getContext(\"2d\");\n  try{ x.drawImage(im,0,0,40,40); }catch(e){ return null; }\n  var d;try{ d=x.getImageData(0,0,40,40).data; }catch(e){ return null; }\n  // Two passes. The first ignores near-neutral pixels entirely, because a grey\n  // has no hue worth building a palette from — and greys dominate photographs\n  // (sky, road, wall, shadow). Merely WEIGHTING by saturation is not enough:\n  // a 75% grey field still out-votes a 25% vivid subject, which is precisely\n  // the colour a person would have named. If the picture really is monochrome\n  // the second pass lets the greys back in, so a moody shot still yields a\n  // tasteful desaturated palette rather than nothing at all.\n  function collect(minS){\n    var bk={};\n    for(var i=0;i<d.length;i+=4){\n      var hsl=rgb2hsl(d[i],d[i+1],d[i+2]);\n      if(hsl[2]<.08||hsl[2]>.94)continue;       // near-black and blown-out white carry no hue\n      if(hsl[1]<minS)continue;\n      var key=Math.round(hsl[0]*12)%12;\n      var e=bk[key]||(bk[key]={n:0,h:0,s:0,l:0});\n      e.n++;e.h+=hsl[0];e.s+=hsl[1];e.l+=hsl[2];\n    }\n    return Object.keys(bk).map(function(k){\n      var e=bk[k];return {h:e.h/e.n,s:e.s/e.n,l:e.l/e.n,n:e.n};\n    });\n  }\n  var list=collect(.18);\n  if(!list.length)list=collect(0);\n  if(!list.length)return null;\n  list.sort(function(a,b){ return (b.n*(0.35+b.s))-(a.n*(0.35+a.s)); });\n  return list.slice(0,3).map(function(o){\n    var s=Math.min(.72,Math.max(.28,o.s));\n    return { pair:[hsl2hex(o.h,Math.min(.62,s+.06),.15), hsl2hex(o.h,Math.min(.80,s+.20),.56)],\n             accent:hsl2hex(o.h,Math.min(.78,s+.16),.55) };\n  });\n}\nfunction buildPalette(){\n  var wrap=el(\"palCtl\"),row=el(\"palRow\"); if(!wrap||!row)return;\n  var pal=(S.photo&&S.bg.type===\"photo\")?photoPalette():null;\n  if(!pal||!pal.length){ wrap.style.display=\"none\"; return; }\n  wrap.style.display=\"\";\n  row.innerHTML=\"\";\n  pal.forEach(function(o){\n    var b=document.createElement(\"button\");\n    b.className=\"pal\";\n    b.style.background=\"linear-gradient(135deg,\"+o.pair[0]+\",\"+o.pair[1]+\")\";\n    b.title=\"Use this palette\";\n    b.onclick=function(){\n      S.bg={type:\"grad\",grad:S.bg.grad||0,pal:o.pair,aiUrl:null};\n      S.photo=null;S.photoDraw=null;\n      buildGrads();buildStyleControls();refreshStyle();paint();saveDraft();haptic(\"success\");\n    };\n    row.appendChild(b);\n  });\n  var a=document.createElement(\"button\");\n  a.className=\"pal accent\";a.style.background=pal[0].accent;a.title=\"Use as accent colour\";\n  a.textContent=\"A\";\n  a.onclick=function(){ BRAND.accent=pal[0].accent;saveBrand();renderBrand();paint();haptic(\"success\"); };\n  row.appendChild(a);\n}\n\nfunction buildLight(){\n  var row=el('lightRow'); if(!row)return;\n  row.innerHTML='';\n  var cur=(S.video&&S.video.light)||'none';\n  LIGHTS.forEach(function(o){\n    var b=document.createElement('button');\n    b.className='chip'+(cur===o[0]?' on':'');\n    b.textContent=o[1];\n    b.onclick=function(){\n      S.video.light=o[0];buildLight();saveDraft();haptic('selection');\n      // a lighting pass only exists in motion, so show it moving straight away\n      // rather than leaving the chip looking like it did nothing\n      if(o[0]!=='none'){ if(!reelRAF)playReel(); } else { paint(); }\n    };\n    row.appendChild(b);\n  });\n  el('lightHint').textContent = cur==='none'\n    ? 'Adds moving light to the reel. Still images are unaffected.'\n    : 'Plays in the reel only. Light adds rather than covers, so it shows most on darker designs.';\n}\nfunction buildEndCard(){\n  var row=el('endRow'); if(!row)return;\n  row.innerHTML='';\n  var cur=endStyle()||'off';\n  ENDCARDS.forEach(function(o){\n    var b=document.createElement('button');\n    b.className='chip'+(cur===o[0]?' on':'');\n    b.textContent=o[1];\n    b.onclick=function(){\n      S.video.end=o[0];buildEndCard();saveDraft();haptic('selection');\n      // the card only exists in the last second, so jump straight to it rather\n      // than making the user watch the whole reel to see what they picked\n      if(o[0]==='off')paint(); else playReel(Math.max(0,reelDur()-END_LEN-.35));\n    };\n    row.appendChild(b);\n  });\n  var has=!!(BRAND.handle||BRAND.logoImg||S.copy.cta);\n  el('endHint').textContent = cur==='off'\n    ? 'Hold your handle and button on screen at the end — the beat where a view becomes a follow.'\n    : (has?('Last '+END_LEN.toFixed(2).replace(/0$/,'')+'s of the reel.'\n            +(cur==='minimal'?' Minimal keeps the design visible behind it.':''))\n          :'Add a handle, logo or button first — the end card has nothing to show yet.');\n}\nfunction buildType(){\n  var row=el(\"typeRow\"); if(!row)return;\n  row.innerHTML=\"\";\n  Object.keys(TYPES).forEach(function(k){\n    var b=document.createElement(\"button\");\n    b.className=\"chip\"+(S.type===k?\" on\":\"\");\n    b.textContent=TYPES[k].name;\n    // preview the face on the chip itself — picking type blind is no fun\n    if(TYPES[k].display)b.style.fontFamily=TYPES[k].display;\n    b.onclick=function(){ S.type=k;buildType();buildTemplates();paint();saveDraft();haptic(\"selection\"); };\n    row.appendChild(b);\n  });\n}\nfunction buildInk(){\n  var row=el(\"inkRow\"); if(!row)return;\n  row.innerHTML=\"\";\n  [[\"light\",\"White\"],[\"dark\",\"Black\"],[\"accent\",\"Accent\"]].forEach(function(o){\n    var b=document.createElement(\"button\");\n    b.className=\"chip\"+(S.ink===o[0]?\" on\":\"\");\n    b.textContent=o[1];\n    b.onclick=function(){ S.ink=o[0];buildInk();buildTemplates();paint();saveDraft();\n      el(\"inkHint\").textContent=\"\";haptic(\"selection\"); };\n    row.appendChild(b);\n  });\n  var a=document.createElement(\"button\");\n  a.className=\"chip\";a.textContent=\"✨ Auto\";\n  a.onclick=autoInk;\n  row.appendChild(a);\n}\nfunction autoInk(){\n  var L=bgLuma();\n  S.ink = L>.55 ? \"dark\" : \"light\";\n  buildInk();buildTemplates();paint();saveDraft();\n  el(\"inkHint\").textContent = \"Background reads \"+Math.round(L*100)+\"% bright — picked \"+\n    (S.ink===\"dark\"?\"dark\":\"light\")+\" words.\";\n  haptic(\"success\");\n}\n\n/* ---------------- canvas engine ---------------- */\nfunction roundRect(ctx,x,y,w,h,r){ctx.beginPath();ctx.moveTo(x+r,y);ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath();}\nfunction wrap(ctx,text,maxW,maxLines){\n  var words=String(text||\"\").split(/\\s+/).filter(Boolean),lines=[],cur=\"\";\n  words.forEach(function(w){\n    var t=cur?cur+\" \"+w:w;\n    if(ctx.measureText(t).width<=maxW||!cur){cur=t;}else{lines.push(cur);cur=w;}\n  });\n  if(cur)lines.push(cur);\n  if(lines.length>maxLines){lines=lines.slice(0,maxLines);lines[maxLines-1]=lines[maxLines-1].replace(/\\s*\\S*$/,\"…\");}\n  return lines;\n}\n/* procedural finishes: baked once to a small tile, pattern-filled — seeded so\n   repaints during drags don't shimmer */\nvar _texTiles={};\n/* Tiles are drawn in the INK's colour, not always white: a white grain on a\n   cream background is a control that appears to do nothing, which is how the\n   light palettes shipped. Cached per kind AND per polarity, so switching ink\n   rebuilds rather than re-serving the invisible one. */\nfunction texTile(kind){\n  var lightArt=inkIsDark(), key=kind+(lightArt?'|d':'|l');\n  if(_texTiles[key])return _texTiles[key];\n  var c=document.createElement('canvas');c.width=c.height=220;\n  var t=c.getContext('2d');\n  var RGB=lightArt?'0,0,0':'255,255,255';\n  function ink(a){ return 'rgba('+RGB+','+a+')'; }\n  var seed=42;function rnd(){seed=(seed*1664525+1013904223)>>>0;return seed/4294967296;}\n  var i,d,xx,yy;\n  if(kind==='grain'){\n    for(i=0;i<2600;i++){t.fillStyle=ink((rnd()*.09).toFixed(3));\n      t.fillRect(Math.floor(rnd()*220),Math.floor(rnd()*220),1,1);}\n  } else if(kind==='dots'){\n    t.fillStyle=ink(.08);\n    for(yy=8;yy<220;yy+=22)for(xx=8;xx<220;xx+=22){t.beginPath();t.arc(xx,yy,2.1,0,7);t.fill();}\n  } else if(kind==='lines'){\n    t.strokeStyle=ink(.055);t.lineWidth=3;\n    for(d=-220;d<440;d+=24){t.beginPath();t.moveTo(d,220);t.lineTo(d+220,0);t.stroke();}\n  } else if(kind==='grid'){\n    t.strokeStyle=ink(.055);t.lineWidth=1.4;\n    for(i=0;i<=220;i+=22){t.beginPath();t.moveTo(i,0);t.lineTo(i,220);t.stroke();\n                          t.beginPath();t.moveTo(0,i);t.lineTo(220,i);t.stroke();}\n    t.strokeStyle=ink(.10);t.lineWidth=2;\n    t.strokeRect(0,0,220,220);       // the tile edge doubles as the heavier rule\n  } else if(kind==='halftone'){\n    // staggered rows of graded dots — print screen rather than polka dot\n    for(yy=0;yy<220;yy+=20){\n      for(xx=(yy/20)%2?10:0;xx<220;xx+=20){\n        var rr=1.4+2.6*rnd();\n        t.fillStyle=ink((.05+rnd()*.07).toFixed(3));\n        t.beginPath();t.arc(xx,yy,rr,0,7);t.fill();\n      }\n    }\n  } else if(kind==='cross'){\n    t.strokeStyle=ink(.05);t.lineWidth=1.6;\n    for(d=-220;d<440;d+=18){\n      t.beginPath();t.moveTo(d,220);t.lineTo(d+220,0);t.stroke();\n      t.beginPath();t.moveTo(d,0);t.lineTo(d+220,220);t.stroke();\n    }\n  } else if(kind==='film'){\n    // grain, plus the vertical scratches and specks of a worn print\n    for(i=0;i<3400;i++){t.fillStyle=ink((rnd()*.10).toFixed(3));\n      t.fillRect(Math.floor(rnd()*220),Math.floor(rnd()*220),1,1);}\n    for(i=0;i<5;i++){\n      var sx=rnd()*220, h=60+rnd()*160, sy=rnd()*220;\n      t.fillStyle=ink((.05+rnd()*.06).toFixed(3));\n      t.fillRect(sx,sy,rnd()<.5?1:1.6,h);\n    }\n    for(i=0;i<26;i++){\n      t.fillStyle=ink((.06+rnd()*.09).toFixed(3));\n      t.beginPath();t.arc(rnd()*220,rnd()*220,.6+rnd()*1.6,0,7);t.fill();\n    }\n  }\n  _texTiles[key]=c;return c;\n}\n/* The travelling light that makes Motion read on a flat background. Kept low\n   and very wide so it passes for the sheen on a surface rather than for the\n   Light effect, which is a separate control and composites over everything. */\nfunction drawBgSheen(x,W,H,A){\n  var cx=W*(.5+A.bgDx*7+A.gradShift*.22), cy=H*(.40+A.bgDy*7+(A.p-.5)*.22-A.gradShift*.10);\n  var r=Math.max(W,H)*.85;\n  var g=x.createRadialGradient(cx,cy,0,cx,cy,r);\n  // light artwork wants a shadow travelling over it; dark artwork wants a light\n  var c=inkIsDark()?\"0,0,0\":\"255,255,255\", a=inkIsDark()?.055:.075;\n  g.addColorStop(0,\"rgba(\"+c+\",\"+a+\")\");\n  g.addColorStop(.6,\"rgba(\"+c+\",\"+(a*.35).toFixed(4)+\")\");\n  g.addColorStop(1,\"rgba(\"+c+\",0)\");\n  x.save();x.fillStyle=g;x.fillRect(0,0,W,H);x.restore();\n}\nfunction drawTexture(x,W,H){\n  if(!S.texture||S.texture==='none')return;\n  try{var p=x.createPattern(texTile(S.texture),'repeat');if(!p)return;\n    x.save();x.fillStyle=p;x.fillRect(0,0,W,H);x.restore();}catch(e){}\n}\n/* ---------------- text backdrop ----------------\n\n   A surface behind the words themselves, as opposed to the template scrim,\n   which washes the whole frame. It is what makes a headline hold on a busy\n   photo without dimming the photo.\n\n   Returns null when there is no backdrop, '' when there is one and the ink is\n   unchanged, or a colour when the backdrop takes the ink with it (Bars invert\n   the type onto a solid block). Measured from the SAME wrapped lines the text\n   is about to be drawn from, so the box can never disagree with the words. */\nvar PLATES=[[\"none\",\"None\"],[\"plate\",\"Plate\"],[\"bars\",\"Bars\"],\n            [\"highlight\",\"Marker\"],[\"outline\",\"Outline\"]];\n/* How much of each line is on screen right now, in pixels, under a word,\n   typewriter or line reveal. The backdrop needs this or it paints a full-width\n   slab around two words — the box has to arrive WITH the type, not before it. */\nfunction revealWidths(x,lines,rev,mode){\n  var n=lines.length,out=new Array(n),li,i;\n  if(rev>=1||!mode||REVEALS.indexOf(mode)<0){\n    for(li=0;li<n;li++)out[li]=x.measureText(lines[li]).width;\n    return out;\n  }\n  if(mode===\"line\"){\n    var step=1/n;\n    for(li=0;li<n;li++)out[li]=(rev-li*step)>0?x.measureText(lines[li]).width:0;\n    return out;\n  }\n  if(mode===\"type\"){\n    var total=lines.join(\"\").length||1,shown=rev*total,used=0;\n    for(li=0;li<n;li++){\n      var ln=lines[li],take=Math.max(0,Math.min(ln.length,Math.round(shown-used)));\n      used+=ln.length;\n      out[li]=take>0?x.measureText(ln.slice(0,take)).width:0;\n    }\n    return out;\n  }\n  var words=lines.map(function(l){return l.split(/\\s+/).filter(Boolean);});\n  var count=words.reduce(function(a,ws){return a+ws.length;},0)||1;\n  var target=rev*count,seen=0;\n  for(li=0;li<n;li++){\n    var shownWords=[];\n    for(i=0;i<words[li].length;i++){ if(target-seen>0)shownWords.push(words[li][i]); seen++; }\n    out[li]=shownWords.length?x.measureText(shownWords.join(\" \")).width:0;\n  }\n  return out;\n}\nfunction drawPlate(x,W,H,lines,cy,lh,fs,rev,mode){\n  var k=S.plate||\"none\";\n  if(k===\"none\"||!lines.length)return null;\n  var n=lines.length, px=fs*.42, py=fs*.26, i, wide=0;\n  var w=revealWidths(x,lines,rev==null?1:rev,mode);\n  for(i=0;i<n;i++){ var full=x.measureText(lines[i]).width; if(full>wide)wide=full; }\n  var top=cy-(n-1)/2*lh-fs*.62, boxH=(n-1)*lh+fs*1.24;\n  var surface=inkIsDark()?\"rgba(255,255,255,.82)\":\"rgba(12,14,20,.55)\";\n  x.save();\n  // A panel can't grow sideways without the words jumping around inside it, so\n  // it keeps its full size and fades up with the reveal instead.\n  if(k===\"plate\"||k===\"outline\"){\n    if(rev!=null&&rev<1)x.globalAlpha=x.globalAlpha*Math.min(1,rev*1.4);\n    if(k===\"plate\"){\n      x.fillStyle=surface;\n      roundRect(x,W/2-wide/2-px,top-py,wide+px*2,boxH+py*2,fs*.28);x.fill();\n    }else{\n      x.strokeStyle=inkAlpha(.55);x.lineWidth=Math.max(1.5,fs*.045);\n      roundRect(x,W/2-wide/2-px,top-py,wide+px*2,boxH+py*2,fs*.28);x.stroke();\n    }\n    x.restore();return \"\";\n  }\n  if(k===\"highlight\")x.globalAlpha=x.globalAlpha*.62;   // set once; restore() puts it back\n  for(i=0;i<n;i++){\n    if(!w[i])continue;                       // nothing revealed on this line yet\n    // the block sits under the words as they land: left edge fixed at the line's\n    // own left edge, right edge tracking the reveal\n    var x0=W/2-x.measureText(lines[i]).width/2;\n    var ly=cy+(i-(n-1)/2)*lh;\n    if(k===\"bars\"){\n      // solid blocks, one per line, with the type knocked out of them\n      x.fillStyle=inkColor();\n      x.fillRect(x0-px,ly-fs*.66,w[i]+px*2,fs*1.28);\n    }else{\n      // Marker: a band across the middle of the line, like a highlighter that\n      // doesn't quite cover the caps — the words keep their own colour\n      x.fillStyle=BRAND.accent;\n      x.fillRect(x0-px*.55,ly-fs*.34,w[i]+px*1.1,fs*.78);\n    }\n  }\n  x.restore();\n  return k===\"bars\"?onColor(inkColor()):\"\";\n}\nfunction drawFrame(x,W,H){\n  if(!S.frame||S.frame==='none')return;\n  var m=Math.round(W*.035);\n  // a white hairline vanishes on a cream background — frames follow the ink too\n  if(S.frame==='border'){x.strokeStyle=inkAlpha(.92);x.lineWidth=W*.008;\n    x.strokeRect(m,m,W-2*m,H-2*m);}\n  else if(S.frame==='inset'){x.strokeStyle=inkAlpha(.7);x.lineWidth=W*.0038;\n    roundRect(x,m,m,W-2*m,H-2*m,W*.03);x.stroke();}\n  else if(S.frame==='polaroid'){var bp=Math.round(W*.05),bb=Math.round(H*.13);\n    x.fillStyle='#f6f4ee';\n    x.fillRect(0,0,W,bp);x.fillRect(0,0,bp,H);x.fillRect(W-bp,0,bp,H);x.fillRect(0,H-bb,W,bb);}\n}\n/* ---------------- banner badges ----------------\n\n   Eight drawn shapes rather than one. Each is a real drawing, not a recoloured\n   pill, because the shape carries as much tone as the words do — a starburst\n   and a rubber stamp say very different things about the same \"SALE\".\n\n   Colour is per badge and defaults to the brand accent, so an existing badge\n   keeps rendering exactly as it did. Label colour is picked for contrast\n   against the BADGE, never the page ink — a badge is its own surface.         */\nvar BADGES=[\n  [\"pill\",   \"Pill\"],\n  [\"block\",  \"Block\"],\n  [\"outline\",\"Outline\"],\n  [\"ribbon\", \"Ribbon\"],\n  [\"burst\",  \"Burst\"],\n  [\"tag\",    \"Tag\"],\n  [\"stamp\",  \"Stamp\"],\n  [\"marker\", \"Marker\"]\n];\nvar BADGE_COLS=[\"\",\"#e0485a\",\"#f2a63b\",\"#3fa564\",\"#3987e5\",\"#b06df9\",\"#14151c\",\"#f6f4ee\"];\nfunction badgeCol(st){ return st.col||BRAND.accent; }\nfunction drawBadge(x,st,cx,cy,fs){\n  var style=st.style||\"pill\", col=badgeCol(st), ink=onColor(col);\n  x.save();\n  x.font=\"800 \"+fs*.42+\"px \"+bodyFamily();\n  x.textAlign=\"center\";x.textBaseline=\"middle\";\n  var tw=x.measureText(st.txt).width, bw=tw+fs*.55, bh=fs*.72;\n  x.translate(cx,cy);\n\n  if(style===\"burst\"){\n    // spikes ride an ellipse sized to the label, so long words still fit\n    var rx=Math.max(bw*.62,bh*.9), ry=bh*.92, spikes=14;\n    x.rotate(-.05);\n    x.beginPath();\n    for(var i=0;i<spikes*2;i++){\n      var a=i*Math.PI/spikes, k=(i%2)?.76:1;\n      var px=Math.cos(a)*rx*k, py=Math.sin(a)*ry*k;\n      i?x.lineTo(px,py):x.moveTo(px,py);\n    }\n    x.closePath();x.fillStyle=col;x.fill();\n    x.fillStyle=ink;x.fillText(st.txt,0,fs*.02);\n\n  } else if(style===\"ribbon\"){\n    var t=bh*.62;                                   // tail depth\n    x.rotate(-.04);\n    x.fillStyle=shade(col,-.28);                    // tails sit behind, darker\n    x.beginPath();x.moveTo(-bw/2-t,-bh*.34);x.lineTo(-bw/2,-bh*.34);\n      x.lineTo(-bw/2,bh*.34);x.lineTo(-bw/2-t,bh*.34);x.lineTo(-bw/2-t*.55,0);x.closePath();x.fill();\n    x.beginPath();x.moveTo(bw/2+t,-bh*.34);x.lineTo(bw/2,-bh*.34);\n      x.lineTo(bw/2,bh*.34);x.lineTo(bw/2+t,bh*.34);x.lineTo(bw/2+t*.55,0);x.closePath();x.fill();\n    x.fillStyle=col;x.fillRect(-bw/2,-bh/2,bw,bh);\n    x.fillStyle=ink;x.fillText(st.txt,0,fs*.02);\n\n  } else if(style===\"tag\"){\n    var pt=bh*.52;                                  // pointed left end\n    x.rotate(-.05);\n    x.fillStyle=col;\n    x.beginPath();x.moveTo(-bw/2-pt,0);x.lineTo(-bw/2,-bh/2);x.lineTo(bw/2-bh*.2,-bh/2);\n      x.arcTo(bw/2,-bh/2,bw/2,0,bh*.2);x.lineTo(bw/2,bh/2-bh*.2);\n      x.arcTo(bw/2,bh/2,bw/2-bh*.2,bh/2,bh*.2);x.lineTo(-bw/2,bh/2);x.closePath();x.fill();\n    x.beginPath();x.arc(-bw/2+bh*.03,0,bh*.11,0,7);   // the eyelet\n    x.fillStyle=\"rgba(0,0,0,.34)\";x.fill();\n    x.fillStyle=ink;x.fillText(st.txt,bh*.12,fs*.02);\n\n  } else if(style===\"stamp\"){\n    x.rotate(-.13);\n    x.strokeStyle=col;x.lineWidth=Math.max(2,fs*.055);\n    roundRect(x,-bw/2-fs*.1,-bh/2-fs*.06,bw+fs*.2,bh+fs*.12,fs*.1);x.stroke();\n    x.lineWidth=Math.max(1,fs*.022);\n    roundRect(x,-bw/2+fs*.02,-bh/2+fs*.02,bw-fs*.04,bh-fs*.04,fs*.07);x.stroke();\n    x.fillStyle=col;x.fillText(st.txt,0,fs*.02);\n\n  } else if(style===\"outline\"){\n    x.rotate(-.06);\n    x.strokeStyle=col;x.lineWidth=Math.max(2,fs*.06);\n    roundRect(x,-bw/2,-bh/2,bw,bh,bh*.24);x.stroke();\n    x.fillStyle=col;x.fillText(st.txt,0,fs*.02);\n\n  } else if(style===\"marker\"){\n    // a highlighter swipe: uneven edges, multiplied so it reads as ink on paper\n    x.save();\n    x.globalAlpha=.62;x.fillStyle=col;\n    x.beginPath();\n    x.moveTo(-bw/2-fs*.06,-bh*.30);x.lineTo(bw/2+fs*.09,-bh*.36);\n    x.lineTo(bw/2+fs*.04,bh*.34);x.lineTo(-bw/2-fs*.10,bh*.29);\n    x.closePath();x.fill();\n    x.restore();\n    x.fillStyle=inkColor();x.fillText(st.txt,0,fs*.02);\n\n  } else if(style===\"block\"){\n    x.fillStyle=col;x.fillRect(-bw/2,-bh/2,bw,bh);\n    x.fillStyle=ink;x.fillText(st.txt,0,fs*.02);\n\n  } else {                                          // pill — the original\n    x.rotate(-.06);\n    x.fillStyle=col;roundRect(x,-bw/2,-bh/2,bw,bh,bh*.24);x.fill();\n    x.fillStyle=ink;x.fillText(st.txt,0,fs*.02);\n  }\n  x.restore();\n}\n/* Lighten or darken a hex by a fraction — used for the ribbon's folded tails. */\nfunction shade(hex,f){\n  var h=String(hex||\"\").replace(\"#\",\"\");\n  if(h.length===3)h=h[0]+h[0]+h[1]+h[1]+h[2]+h[2];\n  var n=parseInt(h,16); if(isNaN(n))return hex;\n  var r=(n>>16)&255,g=(n>>8)&255,b=n&255;\n  function m(v){ return Math.max(0,Math.min(255,Math.round(v+(f<0?v*f:(255-v)*f)))); }\n  return \"#\"+[m(r),m(g),m(b)].map(function(v){return v.toString(16).padStart(2,\"0\");}).join(\"\");\n}\n\n/* the CTA is part of the picture (a JPEG can't carry a tappable link) — four\n   drawn styles, and templates without a native cta spot get it near the bottom */\nvar CTA_FALLBACK_Y={quote:.84,tips:.9,photocap:.7,bold:.86};\nfunction drawCta(x,W,H,val,yF){\n  var fs=H*.034*(S.textScale||1);\n  x.font=\"700 \"+fs+\"px \"+bodyFamily();\n  var style=S.ctaStyle||'pill';\n  var label=style==='link'?val+'  ›':val;\n  var tw=x.measureText(label).width,pw=tw+fs*2.2,ph=fs*2.1;\n  var cxF=S.ctaPos?S.ctaPos.x:.5, cy=H*(S.ctaPos?S.ctaPos.y:yF), cx=W*cxF;\n  S._ctaBox={x:cxF,y:cy/H,hw:(pw/2+fs*.3)/W,hh:(ph/2+fs*.45)/H};   // pointer hit-test\n  x.textAlign=\"center\";x.textBaseline=\"middle\";\n  if(style==='outline'){\n    x.strokeStyle=BRAND.accent;x.lineWidth=Math.max(2,fs*.13);\n    roundRect(x,cx-pw/2,cy-ph/2,pw,ph,ph/2);x.stroke();\n    x.fillStyle=inkColor();x.shadowColor=inkShadow();x.shadowBlur=fs*.2;\n    x.fillText(label,cx,cy+fs*.06);x.shadowBlur=0;\n  } else if(style==='ghost'){\n    x.fillStyle=inkAlpha(.16);roundRect(x,cx-pw/2,cy-ph/2,pw,ph,ph/2);x.fill();\n    x.strokeStyle=inkAlpha(.55);x.lineWidth=Math.max(1.5,fs*.07);\n    roundRect(x,cx-pw/2,cy-ph/2,pw,ph,ph/2);x.stroke();\n    x.fillStyle=inkColor();x.fillText(label,cx,cy+fs*.06);\n  } else if(style==='link'){\n    x.fillStyle=inkColor();x.shadowColor=inkShadow();x.shadowBlur=fs*.25;\n    x.fillText(label,cx,cy);x.shadowBlur=0;\n    x.fillStyle=BRAND.accent;x.fillRect(cx-tw/2,cy+fs*.75,tw,Math.max(2,fs*.09));\n  } else { // pill\n    // The pill is its own surface: its label must contrast with the ACCENT it\n    // sits on, not with the page ink. A pale accent needs dark text regardless.\n    x.fillStyle=BRAND.accent;roundRect(x,cx-pw/2,cy-ph/2,pw,ph,ph/2);x.fill();\n    x.fillStyle=onAccent();x.fillText(label,cx,cy+fs*.06);\n  }\n}\n/* Reveal text without it shifting: the line breaks and the centring both come\n   from the FULL string, and we simply stop drawing partway through. Anything\n   that re-measured the visible substring would make the words jitter. */\nfunction drawReveal(x,lines,cx,cy,lh,rev,mode){\n  var li,i,align=x.textAlign;\n  x.textAlign=\"left\";\n  if(mode===\"type\"){\n    var total=lines.join(\"\").length||1,shown=rev*total,used=0;\n    for(li=0;li<lines.length;li++){\n      var ln=lines[li],take=Math.max(0,Math.min(ln.length,Math.round(shown-used)));\n      used+=ln.length;\n      if(take<=0)break;\n      x.fillText(ln.slice(0,take),cx-x.measureText(ln).width/2,cy+(li-(lines.length-1)/2)*lh);\n      if(take<ln.length)break;\n    }\n    x.textAlign=align;return;\n  }\n  if(mode===\"line\"){\n    // each line rises into place as it fades — the last one lands on the beat\n    // the block would otherwise have finished, so the timing still reads\n    x.textAlign=align;\n    var n=lines.length,step=1/n;\n    for(li=0;li<n;li++){\n      var lq=Math.min(1,Math.max(0,(rev-li*step)/step)),le=ease(lq);\n      if(lq<=0)break;\n      var ga=x.globalAlpha;x.globalAlpha=ga*le;\n      x.fillText(lines[li],cx,cy+(li-(n-1)/2)*lh+(1-le)*lh*.55);\n      x.globalAlpha=ga;\n    }\n    return;\n  }\n  var words=lines.map(function(l){return l.split(/\\s+/).filter(Boolean);});\n  var count=words.reduce(function(n,w){return n+w.length;},0);\n  if(!count){x.textAlign=align;return;}\n  var target=rev*count,seen=0;\n  for(li=0;li<lines.length;li++){\n    var cur=cx-x.measureText(lines[li]).width/2,y=cy+(li-(lines.length-1)/2)*lh;\n    for(i=0;i<words[li].length;i++){\n      var a=Math.min(1,Math.max(0,target-seen));   // the newest word fades in\n      if(a>0){\n        var g0=x.globalAlpha;x.globalAlpha=g0*a;\n        x.fillText(words[li][i],cur,y);\n        x.globalAlpha=g0;\n      }\n      cur+=x.measureText(words[li][i]+\" \").width;\n      seen++;\n    }\n  }\n  x.textAlign=align;\n}\n/* A soft-focus entrance. ctx.filter would be the obvious tool and WebKit still\n   doesn't have it — a silent no-op there would ship an export that doesn't\n   match the preview. Instead the glyphs are drawn far off-canvas and their\n   drop shadow is offset back into place: what lands is the shadow alone, which\n   IS a real gaussian blur of the letterforms, in one pass.\n   The sharp copy crossfades under it, so the word resolves rather than\n   snapping into focus at the end. */\nfunction drawSoft(x,fn,r,soft){\n  if(!(r>.4)){fn(0,0);return;}\n  var g0=x.globalAlpha;\n  var off=(x.canvas.width||1080)*2+2000;\n  x.globalAlpha=g0*Math.max(0,1-soft*1.25);\n  if(x.globalAlpha>.004)fn(0,0);\n  x.save();\n  x.shadowColor=inkColor();x.shadowBlur=r;x.shadowOffsetX=off;x.shadowOffsetY=0;\n  x.globalAlpha=g0;\n  fn(-off,0);\n  x.restore();\n  x.globalAlpha=g0;\n}\n/* dx / ts from the entrance, applied around the block's own centre so a scale\n   grows the words in place instead of walking them across the frame */\nfunction blockXform(x,W,an,cx,cy){\n  if(an.dx)x.translate(an.dx*W,0);\n  if(an.ts&&an.ts!==1){x.translate(cx,cy);x.scale(an.ts,an.ts);x.translate(-cx,-cy);}\n}\n/* one text block, optionally mid-entrance (an) */\nfunction drawBlock(x,W,H,b,val,an){\n  var by=b.y+(S.textY||0)+(an?an.dy:0);\n  if(b.list){\n    var items=val.split(/\\n|(?:^|\\s)[•·-]\\s+/).map(function(s){return s.trim();}).filter(Boolean).slice(0,6);\n    var fs=H*b.size*(S.textScale||1);x.font=b.font.replace(\"%f\",fs);x.textAlign=\"left\";x.textBaseline=\"middle\";x.fillStyle=\"#fff\";\n    var y0=H*(.32+(S.textY||0)+(an?an.dy:0)),gap=fs*1.9;\n    items.forEach(function(it,i){\n      x.fillStyle=BRAND.accent;x.beginPath();x.arc(W*.12,y0+i*gap,fs*.22,0,7);x.fill();\n      x.fillStyle=\"#fff\";\n      var ln=wrap(x,it,W*.72,1);x.fillText(ln[0]||\"\",W*.12+fs*.8,y0+i*gap);\n    });\n    return;\n  }\n  if(b.pill||b.key===\"cta\"){\n    var cs=an?an.cs:1;\n    if(cs!==1){var ccx=W*(S.ctaPos?S.ctaPos.x:.5),ccy=H*by;\n      x.save();x.translate(ccx,ccy);x.scale(cs,cs);x.translate(-ccx,-ccy);}\n    drawCta(x,W,H,b.caps?val.toUpperCase():val,by);\n    if(cs!==1)x.restore();\n    return;\n  }\n  var t=b.caps?val.toUpperCase():val;\n  if(b.quote)t=\"“\"+t+\"”\";\n  var fs3=H*b.size*(S.textScale||1);x.font=fontFor(b,fs3);\n  x.textAlign=\"center\";x.textBaseline=\"middle\";\n  var lines=wrap(x,t,W*.82,b.maxLines||2),lh=fs3*1.18;\n  var rev=(an&&b.key===\"hook\")?an.rev:1;\n  var plateInk=drawPlate(x,W,H,lines,H*by,lh,fs3,rev,an&&an.mode);\n  // a drop shadow under a backdrop is just mud — the backdrop IS the lift\n  if(plateInk===null){x.shadowColor=inkShadow();x.shadowBlur=fs3*.25;}\n  x.fillStyle=plateInk||inkColor();\n  var put=function(ox,oy){\n    if(rev>=1)lines.forEach(function(ln,i){x.fillText(ln,W/2+ox,H*by+(i-(lines.length-1)/2)*lh+oy);});\n    else drawReveal(x,lines,W/2+ox,H*by+oy,lh,rev,an.mode);\n  };\n  drawSoft(x,put,(an?an.soft:0)*fs3*.30,an?an.soft:0);\n  x.shadowBlur=0;\n  if(b.caps&&b.key===\"sub\"){x.fillStyle=BRAND.accent;x.fillRect(W/2-W*.045,H*by+fs3*1.1,W*.09,H*.004);}\n}\n/* Set while a reel plays or exports; null for ordinary stills — so an untouched\n   still renders byte-for-byte as it always did. */\nvar ANIM=null;\nfunction render(cv,W,H,forExport){\n  cv.width=W;cv.height=H;\n  var x=cv.getContext(\"2d\"),T=TEMPLATES[S.template];\n  var A=ANIM;\n  /* background — scaled about the centre, so a zoom/pan never exposes an edge */\n  if(A){x.save();x.translate(W/2,H/2);x.scale(A.bgScale,A.bgScale);\n        x.translate(-W/2+A.bgDx*W,-H/2+A.bgDy*H);}\n  if(S.photo&&S.bg.type===\"photo\"){\n    var im=S.photoDraw||S.photo,sc=Math.max(W/im.width,H/im.height)*S.photoPos.scale;\n    var dw=im.width*sc,dh=im.height*sc;\n    var dx=(W-dw)/2+S.photoPos.x*W,dy=(H-dh)/2+S.photoPos.y*H;\n    dx=Math.min(0,Math.max(W-dw,dx));dy=Math.min(0,Math.max(H-dh,dy));\n    x.drawImage(im,dx,dy,dw,dh);\n  } else if(S.bg.type===\"ai\"&&S.bg.aiImg){\n    var a=S.bg.aiImg,s2=Math.max(W/a.width,H/a.height);\n    x.drawImage(a,(W-a.width*s2)/2,(H-a.height*s2)/2,a.width*s2,a.height*s2);\n  } else if(S.bg.type===\"solid\"){\n    x.fillStyle=S.bg.solid||\"#101216\";x.fillRect(0,0,W,H);\n  } else {\n    /* A flat gradient would sit dead still in a reel: the frame transform above\n       is a zoom, and zooming a full-bleed gradient lands on very nearly the\n       same pixels. So the AXIS travels instead, and it has to travel far — the\n       old sixth-of-a-frame shift measured out at about 2 levels of 255 across\n       two seconds, which is why Motion looked like it did nothing on anything\n       but a photo. Moving both ends by different amounts stretches the ramp as\n       it slides, so the colours change rather than merely translating. */\n    var g,gs=A?A.gradShift:0;\n    if(S.gradDir===\"radial\")g=x.createRadialGradient(W/2+gs*W*.34,H*(.42-gs*.14),W*.08,W/2,H*.5,Math.max(W,H)*(.78+gs*.16));\n    else if(S.gradDir===\"down\")g=x.createLinearGradient(0,-gs*H*.62,0,H-gs*H*.22);\n    else if(S.gradDir===\"right\")g=x.createLinearGradient(-gs*W*.62,0,W-gs*W*.22,0);\n    else g=x.createLinearGradient(gs*W*.55,0,W*.7+gs*W*.20,H);\n    // A photo-derived palette is carried as an explicit colour PAIR, never as a\n    // new GRADS index — appending per-photo entries would renumber the array\n    // that every saved post indexes into.\n    var pair=S.bg.pal||GRADS[S.bg.grad]||GRADS[0];\n    g.addColorStop(0,pair[0]);\n    if(pair[2])g.addColorStop(Math.max(0,Math.min(.95,pair[2])),pair[0]);\n    g.addColorStop(1,pair[1]);\n    x.fillStyle=g;x.fillRect(0,0,W,H);\n  }\n  // A solid colour cannot be moved at all by a transform, and a gradient only\n  // just — so flat artwork gets a light that travels over it instead. It is\n  // driven by the same numbers as the frame, so each motion moves it its own\n  // way, and it is off entirely on photos, which have their own detail to move.\n  if(A&&!(S.photo&&S.bg.type===\"photo\")&&!(S.bg.type===\"ai\"&&S.bg.aiImg))drawBgSheen(x,W,H,A);\n  if(A)x.restore();\n  // autoInk() measures EXACTLY this much: the raw background, before any\n  // ink-dependent layer. The scrim and vignette flip colour with the ink, so\n  // including them would make the measurement depend on the answer it is\n  // being used to choose — a light background under a dark scrim reads as\n  // dark, and Auto would then confidently pick white words for cream.\n  if(_bgOnly)return;\n  /* scrim / band */\n  var dk=inkIsDark();\n  if(T.band){x.save();x.globalAlpha=Math.min(1,S.scrimAdj||1);\n    var bg2=x.createLinearGradient(0,H*(1-T.band-.12),0,H);\n    bg2.addColorStop(0,dk?\"rgba(255,255,255,0)\":\"rgba(0,0,0,0)\");\n    bg2.addColorStop(.45,dk?\"rgba(255,255,255,.62)\":\"rgba(0,0,0,.62)\");\n    bg2.addColorStop(1,dk?\"rgba(255,255,255,.82)\":\"rgba(0,0,0,.78)\");\n    x.fillStyle=bg2;x.fillRect(0,H*(1-T.band-.12),W,H*(T.band+.12));x.restore();}\n  else if(T.scrim){x.fillStyle=scrimRGBA(Math.min(.85,T.scrim*(S.scrimAdj||1)));x.fillRect(0,0,W,H);}\n  drawTexture(x,W,H);\n  if(S.vig){var vg=x.createRadialGradient(W/2,H/2,Math.min(W,H)*.42,W/2,H/2,Math.max(W,H)*.72);\n    vg.addColorStop(0,dk?\"rgba(255,255,255,0)\":\"rgba(0,0,0,0)\");\n    vg.addColorStop(1,dk?\"rgba(255,255,255,.45)\":\"rgba(0,0,0,.4)\");x.fillStyle=vg;x.fillRect(0,0,W,H);}\n  /* rule lines (announce) */\n  if(T.rule){x.strokeStyle=inkAlpha(.65);x.lineWidth=W*.0035;\n    x.beginPath();x.moveTo(W*.3,H*.28);x.lineTo(W*.7,H*.28);x.stroke();\n    x.beginPath();x.moveTo(W*.3,H*.74);x.lineTo(W*.7,H*.74);x.stroke();}\n  /* text blocks */\n  T.blocks.forEach(function(b,bi){\n    var val=S.copy[b.key]||\"\";if(!val)return;\n    var an=A?A.block(bi):null;\n    if(an&&an.a<=0)return;               // hasn't entered yet\n    if(an){x.save();x.globalAlpha=an.a;\n      blockXform(x,W,an,W/2,H*((b.list?.32:b.y)+(S.textY||0)));}\n    drawBlock(x,W,H,b,val,an);\n    if(an)x.restore();\n  });\n  /* CTA on templates without their own spot — the field works everywhere */\n  if(!S.copy.cta)S._ctaBox=null;\n  else if(!T.blocks.some(function(b){return b.pill||b.key===\"cta\"})){\n    var ca=A?A.block(T.blocks.length):null;\n    var cyF=(CTA_FALLBACK_Y[S.template]||.84)+(S.textY||0);\n    if(!ca||ca.a>0){\n      if(ca){x.save();x.globalAlpha=ca.a;\n        blockXform(x,W,ca,W*(S.ctaPos?S.ctaPos.x:.5),H*(S.ctaPos?S.ctaPos.y:cyF));}\n      drawCta(x,W,H,S.copy.cta,cyF+(ca?ca.dy:0));\n      if(ca)x.restore();\n    }\n  }\n  /* stickers */\n  S.stickers.forEach(function(st,si){\n    var sa=A?A.sticker(si):null;\n    if(sa&&sa.a<=0)return;\n    if(sa){x.save();x.globalAlpha=sa.a;\n      x.translate(st.x*W,st.y*H);x.scale(sa.s,sa.s);x.translate(-st.x*W,-st.y*H);}\n    var px2=st.x*W,py=st.y*H,fs=st.size*(W/1080);\n    if(st.kind===\"photo\"){\n      if(st._img&&st._img.naturalWidth){\n        var pw=fs,ph=pw*st._img.naturalHeight/st._img.naturalWidth;\n        var pb=pw*.05,pbb=pw*.15;\n        x.save();\n        x.shadowColor=\"rgba(0,0,0,.5)\";x.shadowBlur=pw*.06;x.shadowOffsetY=pw*.02;\n        x.fillStyle=\"#f8f6f1\";x.fillRect(px2-pw/2-pb,py-ph/2-pb,pw+pb*2,ph+pb+pbb);\n        x.shadowColor=\"transparent\";x.shadowBlur=0;x.shadowOffsetY=0;\n        x.drawImage(st._img,px2-pw/2,py-ph/2,pw,ph);\n        x.restore();\n      }\n    } else if(st.kind===\"emoji\"){\n      x.font=fs+\"px -apple-system\";x.textAlign=\"center\";x.textBaseline=\"middle\";\n      x.fillText(st.txt,px2,py);\n    } else {\n      drawBadge(x,st,px2,py,fs);\n    }\n    if(!forExport&&!A&&st===sel){\n      x.strokeStyle=\"#4f8df9\";x.lineWidth=3;x.setLineDash([8,6]);\n      var hw,hh;\n      if(st.kind===\"photo\"){\n        var ar=(st._img&&st._img.naturalWidth)?st._img.naturalHeight/st._img.naturalWidth:1;\n        hw=fs*.58;hh=fs*ar*.58+fs*.1;\n      } else { hw=fs*.62;hh=fs*.62*.72; }\n      roundRect(x,px2-hw,py-hh,hw*2,hh*2,10);\n      x.stroke();x.setLineDash([]);\n      st._box={hw:hw/W,hh:hh/H};   // pointer code hit-tests the same geometry\n      /* corner handles: red ✕ removes, blue dot resizes */\n      var hr=Math.max(14,W*.022);\n      x.fillStyle=\"#e0485a\";x.beginPath();x.arc(px2+hw,py-hh,hr,0,7);x.fill();\n      x.strokeStyle=\"#fff\";x.lineWidth=Math.max(2,hr*.2);\n      x.beginPath();x.moveTo(px2+hw-hr*.38,py-hh-hr*.38);x.lineTo(px2+hw+hr*.38,py-hh+hr*.38);x.stroke();\n      x.beginPath();x.moveTo(px2+hw+hr*.38,py-hh-hr*.38);x.lineTo(px2+hw-hr*.38,py-hh+hr*.38);x.stroke();\n      x.fillStyle=\"#4f8df9\";x.beginPath();x.arc(px2+hw,py+hh,hr,0,7);x.fill();\n      x.strokeStyle=\"#fff\";\n      x.beginPath();x.moveTo(px2+hw-hr*.34,py+hh+hr*.34);x.lineTo(px2+hw+hr*.34,py+hh-hr*.34);x.stroke();\n      x.beginPath();x.moveTo(px2+hw+hr*.05,py+hh-hr*.34);x.lineTo(px2+hw+hr*.34,py+hh-hr*.34);x.stroke();\n      x.beginPath();x.moveTo(px2+hw+hr*.34,py+hh-hr*.05);x.lineTo(px2+hw+hr*.34,py+hh-hr*.34);x.stroke();\n    }\n    if(sa)x.restore();\n  });\n  drawFrame(x,W,H);\n  if(A)drawLight(x,W,H,A);\n  /* brand + watermark (dark ink on the polaroid band so they stay visible) */\n  var onBand=S.frame==='polaroid';\n  // the end card carries the handle itself — the corner copy fading out as it\n  // arrives is what stops the two reading as a doubled-up watermark\n  if(A&&A.end>0){x.save();x.globalAlpha=1-A.end;}\n  if(BRAND.handle){\n    x.font=\"650 \"+H*.021+\"px -apple-system, sans-serif\";x.textAlign=\"left\";x.textBaseline=\"alphabetic\";\n    x.fillStyle=onBand?\"rgba(58,54,46,.9)\":inkAlpha(.92);x.fillText(BRAND.handle,W*.05,H*.955);\n  }\n  if(BRAND.wm){\n    x.font=\"500 \"+H*.016+\"px -apple-system, sans-serif\";x.textAlign=\"right\";\n    x.fillStyle=onBand?\"rgba(58,54,46,.45)\":inkAlpha(.4);x.fillText(\"Made with Social Studio\",W*.95,H*.958);\n  }\n  if(BRAND.logoImg&&BRAND.logoImg.naturalWidth){\n    var lw=W*(BRAND.logoSize||0.12),lh=lw*BRAND.logoImg.naturalHeight/BRAND.logoImg.naturalWidth,lm=W*0.045;\n    var lp=BRAND.logoPos||'tr';\n    var lx=lp.indexOf('l')>=0?lm:W-lm-lw;\n    var ly=lp.charAt(0)==='t'?lm:H-lm-lh;\n    x.save();x.shadowColor='rgba(0,0,0,.4)';x.shadowBlur=W*0.012;\n    x.drawImage(BRAND.logoImg,lx,ly,lw,lh);x.restore();\n  }\n  if(A&&A.end>0){x.restore();drawEndCard(x,W,H,A.end);}\n}\n\n/* preview — while the keyboard is up the stage box is frozen so the canvas\n   doesn't thrash through resizes on every viewport change */\nvar kbOpen=false,stageBox=null;\nfunction paint(){\n  var f=FORMATS[S.format],stage=el('stage');\n  if(!kbOpen||!stageBox)stageBox={w:stage.clientWidth-28,h:stage.clientHeight-26};\n  var maxW=stageBox.w,maxH=stageBox.h;\n  // Split lays one design over N tiles, so the preview IS the wide canvas —\n  // render() spreads everything by fraction, and the cut lines are overlaid.\n  var vw=f.w*splitN(),vh=f.h;\n  // the chrome sits ABOVE and BELOW the canvas inside the same stage, so the\n  //