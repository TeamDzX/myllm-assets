lose together, so the NEAREST one wins.\n    if(sel&&sel._box){\n      var b=sel._box;\n      var dDel=cssDist(p,sel.x+b.hw,sel.y-b.hh),dRs=cssDist(p,sel.x+b.hw,sel.y+b.hh);\n      if(Math.min(dDel,dRs)<24){\n        if(dRs<=dDel){\n          drag={kind:\"rs\",st:sel,s0:sel.size,d0:Math.max(8,cssDist(p,sel.x,sel.y))};\n          cv.setPointerCapture(e.pointerId);haptic('selection');\n        } else deleteSel();\n        return;\n      }\n    }\n    for(var i=S.stickers.length-1;i>=0;i--){\n      var st=S.stickers[i],rx=(st.size*(1/1080))*.75,ry=rx*(f.w/f.h);\n      if(Math.abs(p.x-st.x)<rx&&Math.abs(p.y-st.y)<ry){\n        sel=st;S.stickers.splice(i,1);S.stickers.push(st);\n        el('selCtl').style.display='block';setSizeSlider(st);buildBadgeCtl();\n        drag={kind:\"st\",st:st,dx:p.x-st.x,dy:p.y-st.y};\n        cv.setPointerCapture(e.pointerId);paint();haptic('selection');return;\n      }\n    }\n    if(sel){sel=null;el('selCtl').style.display='none';buildBadgeCtl();paint();}\n    // the call-to-action is draggable too (stickers above it win the tap)\n    if(S._ctaBox&&S.copy.cta){\n      var cb=S._ctaBox;\n      if(Math.abs(p.x-cb.x)<cb.hw&&Math.abs(p.y-cb.y)<cb.hh){\n        drag={kind:\"cta\",dx:p.x-cb.x,dy:p.y-cb.y};\n        cv.setPointerCapture(e.pointerId);haptic('selection');return;\n      }\n    }\n    if(photoBg()){drag={kind:\"photo\",px:p.x,py:p.y,ox:S.photoPos.x,oy:S.photoPos.y};cv.setPointerCapture(e.pointerId);}\n  });\n  cv.addEventListener(\"pointermove\",function(e){\n    if(pts[e.pointerId])pts[e.pointerId]={x:e.clientX,y:e.clientY};\n    if(pinch){var t=twoPts();if(t){setZoom(pinch.s0*(dist(t[0],t[1])/pinch.d0));paint();}return;}\n    if(!drag)return;var p=pos(e);\n    if(drag.kind===\"st\"){drag.st.x=Math.min(.98,Math.max(.02,p.x-drag.dx));drag.st.y=Math.min(.98,Math.max(.02,p.y-drag.dy));}\n    else if(drag.kind===\"cta\"){\n      S.ctaPos={x:Math.min(.92,Math.max(.08,p.x-drag.dx)),y:Math.min(.95,Math.max(.05,p.y-drag.dy))};\n      updCta