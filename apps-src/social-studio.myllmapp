e look that existed then, which is \"classic\".\n          end:normEnd(v.end),\n          light:LIGHTS.some(function(l){return l[0]===v.light;})?v.light:\"none\",\n          secs:Math.min(15,Math.max(3,Math.round(+v.secs||d.secs))),fps:30};\n}\nfunction normEnd(e){\n  if(e===1||e===true)return \"classic\";\n  return ENDCARDS.some(function(o){return o[0]===e&&e!==\"off\";})?e:\"off\";\n}\n/* '' when there is no end card — every caller treats that as off, and a bare\n   truthiness test on the stored value would read the string \"off\" as on */\nfunction endStyle(){ var e=S.video&&S.video.end; return (e&&e!==\"off\")?e:\"\"; }\nfunction ease(p){return 1-Math.pow(1-p,3);}                       // easeOutCubic\nfunction easeBack(p){var c=1.7;return 1+(c+1)*Math.pow(p-1,3)+c*Math.pow(p-1,2);}\nfunction animAt(t,D){\n  var p=D>0?Math.min(1,Math.max(0,t/D)):0;\n  var m=(S.video&&S.video.motion)||\"drift\",mode=(S.video&&S.video.textIn)||\"word\";\n  var A={p:p,mode:mode,bgScale:1,bgDx:0,bgDy:0,gradShift:0};\n  /* gradShift is what each motion does to a FLAT background: the gradient axis\n     and the travelling sheen both ride it, so the seven motions stay seven\n     distinct things on a design with no photo in it. Signed, and not bounded\n     to 0..1 — a sweep wants to run past both edges. */\n  if(m===\"drift\"){ A.bgScale=1.03+.09*p; A.bgDx=(p-.5)*.03;\n                   A.gradShift=p*.9+.45*Math.sin(t*Math.PI*2/2.8); }\n  // every motion keeps a slow continuing component — a reel that goes completely\n  // static after its intro reads as a broken video rather than a still\n  else if(m===\"pop\"){ A.bgScale=1.12-.08*ease(Math.min(1,t/.9))+.05*p;\n                      A.gradShift=ease(Math.min(1,t/.9))*.8+.45*Math.sin(t*Math.PI*2/3.2); }\n  else if(m===\"slide\"){ A.bgScale=1.10; A.bgDx=(.5-p)*.06; A.gradShift=(p-.5)*2.2; }\n  // starts pushed right in and settles back — the opposite read to Drift, and\n  // the one that makes a photo feel like it was filmed rather than placed\n  else if(m===\"zoom\"){ A.bgScale=1.22-.14*ease(Math.min(1,t/1.6))-.02*p; A.bgDy=(1-ease(Math.min(1,t/1.6)))*.012;\n                       A.gradShift=1.05-1.25*ease(Math.min(1,t/1.6))+.42*Math.sin(t*Math.PI*2/3.4); }\n  // two sines at unrelated periods never repeat inside a 15s clip, so the frame\n  // wanders like a held camera instead of tracing a visible loop\n  else if(m===\"sway\"){ A.bgScale=1.07+.01*Math.sin(t*Math.PI*2/4.3);\n                       A.bgDx=.018*Math.sin(t*Math.PI*2/3.7);\n                       A.bgDy=.014*Math.sin(t*Math.PI*2/2.9+1.1);\n                       A.gradShift=.9*Math.sin(t*Math.PI*2/3.7); }\n  // background and words travel opposite ways: the depth cue is the offset\n  // between the two layers, so the text drift is set on the block below\n  else if(m===\"parallax\"){ A.bgScale=1.09+.03*p; A.bgDx=(.5-p)*.05; A.bgDy=(p-.5)*.02;\n                           A.gradShift=(.5-p)*1.6; }   // against the words, like everything else here\n  else { A.bgScale=1.04+.05*(Math.sin(t*Math.PI*2/1.5)*.5+.5);\n         A.gradShift=.75*Math.sin(t*Math.PI*2/1.5); }   // pulse: the whole surface breathes\n  // Settle motions keep a slow wander on top of their ramp, or a flat design\n  // freezes the moment the intro lands. Clamped so the ramp can never carry the\n  // gradient clean off the frame and leave a solid colour behind.\n  A.gradShift=Math.max(-1.3,Math.min(1.3,A.gradShift));\n  // a pan must never drag the canvas edge into view\n  var room=(A.bgScale-1)/2*.9;\n  A.bgDx=Math.max(-room,Math.min(room,A.bgDx));\n  A.bgDy=Math.max(-room,Math.min(room,A.bgDy));\n  A.block=function(i){\n    var at=.22+i*.34,q=Math.min(1,Math.max(0,(t-at)/.62)),e=ease(q);\n    var o={a:e,dy:0,dx:0,rev:1,mode:mode,cs:1,ts:1,soft:0};\n    if(m===\"slide\"||mode===\"rise\")o.dy=(1-e)*.055;\n    if(m===\"pop\")o.cs=.9+.1*easeBack(q);\n    else if(m===\"pulse\")o.cs=1+.03*Math.sin(t*Math.PI*2/1.5);\n    // Parallax: the words hold their own course against the background for the\n    // whole clip, not just the entrance — that is the entire effect\n    else if(m===\"parallax\")o.dx=(p-.5)*.022+(1-e)*.02;\n    else if(m===\"sway\")o.dx=.006*Math.sin(t*Math.PI*2/3.1+i);\n    // ts scales the block about its own centre; soft blurs it on the way in.\n    // Both stay at rest (1 and 0) once the entrance is over, so a long reel\n    // never sits on a permanently soft or oversized headline.\n    if(mode===\"scale\")o.ts=1+.18*(1-easeBack(q));\n    else if(mode===\"blur\"){o.soft=1-q;o.a=Math.min(1,e*1.15);}\n    else if(mode===\"swipe\")o.dx=(1-e)*(i%2?-.09:.09);\n    if(i===0&&REVEALS.indexOf(mode)>=0){\n      // the headline reveals itself, so the block as a whole never fades\n      o.rev=Math.min(1,Math.max(0,(t-at)/Math.max(.9,Math.min(2.4,D*.45))));\n      o.a=1;\n    }\n    // Clear the design's own words as the end card arrives — last, so it also\n    // takes the headline the branch above just pinned to full. Without it the\n    // type ghosts through the wash and, on Minimal, collides outright with the\n    // handle: two sets of words fighting over the same beat.\n    if(A.end>0)o.a*=1-A.end;\n    return o;\n  };\n  A.sticker=function(i){\n    var q=Math.min(1,Math.max(0,(t-(.5+i*.16))/.5));\n    return {a:Math.min(1,q*1.6)*(A.end>0?1-A.end:1),s:.6+.4*easeBack(q)};\n  };\n  // End card: a held frame carrying the handle and CTA. Reels that simply stop\n  // give a viewer nothing to act on, and this is the beat where a view turns\n  // into a follow. Fades in over the last stretch rather than cutting, so the\n  // clip still loops cleanly.\n  A.t = t;                       // the lighting pass is a pure function of it\n  A.end = endStyle()\n    ? Math.min(1,Math.max(0,(t-(D-END_LEN))/.5))\n    : 0;\n  return A;\n}\nvar END_LEN=1.35;\n/* text-in modes that reveal the headline word/line at a time rather than\n   moving the block as a whole */\nvar REVEALS=[\"word\",\"type\",\"line\"];\n\n/* ---------------- light effects ----------------\n\n   A lighting pass over the finished frame. Every value is a pure function of\n   t: exportReel renders each frame independently by calling animAt(i/fps,D),\n   so anything holding state — or reaching for Math.random — would strobe\n   between frames instead of moving.\n\n   Positions come from a hash of the particle INDEX, which gives a scattered\n   but identical layout on every frame, at any fps, in preview and in export.\n\n   Composited with 'screen' so the effect adds light rather than painting over\n   the design. That also means it does most of its work on darker artwork —\n   screening onto near-white has little left to give, which is honest to how\n   real light behaves and is said plainly in the hint.                         */\nvar LIGHTS=[[\"none\",\"None\"],[\"sweep\",\"Shine\"],[\"glow\",\"Glow\"],\n            [\"bokeh\",\"Bokeh\"],[\"leak\",\"Light leak\"],[\"sparkle\",\"Sparkle\"],\n            [\"rays\",\"Sun rays\"],[\"neon\",\"Neon\"],[\"prism\",\"Prism\"],[\"dust\",\"Dust\"]];\nfunction lightRnd(i){\n  var v=Math.sin(i*127.1+311.7)*43758.5453;\n  return v-Math.floor(v);\n}\nfunction softDot(x,cx,cy,r,col,a){\n  var g=x.createRadialGradient(cx,cy,0,cx,cy,r);\n  g.addColorStop(0,col.replace(\"%a\",a));\n  g.addColorStop(.55,col.replace(\"%a\",a*.45));\n  g.addColorStop(1,col.replace(\"%a\",0));\n  x.fillStyle=g;x.fillRect(cx-r,cy-r,r*2,r*2);\n}\nfunction drawLight(x,W,H,A){\n  var kind=(S.video&&S.video.light)||\"none\";\n  if(kind===\"none\")return;\n  var t=A.t||0, i, D=Math.max(W,H);\n  x.save();\n  x.globalCompositeOperation=\"screen\";\n\n  if(kind===\"sweep\"){\n    // a gloss band crossing the frame, as if light raked across glass\n    var per=2.6, ph=(t%per)/per, bw=W*.30;\n    var cx=-bw+ph*(W+bw*2);\n    var g=x.createLinearGradient(cx-bw,0,cx+bw,H);\n    g.addColorStop(0,\"rgba(255,255,255,0)\");\n    g.addColorStop(.5,\"rgba(255,255,255,.20)\");\n    g.addColorStop(1,\"rgba(255,255,255,0)\");\n    x.fillStyle=g;x.fillRect(0,0,W,H);\n\n  }else if(kind===\"glow\"){\n    var a=.10+.06*Math.sin(t*Math.PI*2/2.4);\n    softDot(x,W/2,H*.46,D*.62,\"rgba(255,246,225,%a)\",a);\n\n  }else if(kind===\"bokeh\"){\n    for(i=0;i<20;i++){\n      var rx=lightRnd(i), ry=lightRnd(i+37), rz=lightRnd(i+91);\n      var sp=.035+rz*.055;                       // each orb drifts at its own pace\n      var yy=(1.15-((t*sp+ry)%1.3))*H;\n      var r=W*(.014+rz*.038);\n      softDot(x,rx*W,yy,r,\"rgba(255,250,235,%a)\",.10+ry*.13);\n    }\n\n  }else if(kind===\"leak\"){\n    // two slow warm blooms crossing, the way a light leak crawls over film\n    var p1=t*.075, p2=t*.052+.4;\n    softDot(x,W*(.12+.75*(.5+.5*Math.sin(p1*Math.PI*2))),H*(.18+.12*Math.sin(p1*3.1)),\n            D*.55,\"rgba(255,176,92,%a)\",.17);\n    softDot(x,W*(.88-.75*(.5+.5*Math.sin(p2*Math.PI*2))),H*(.78-.14*Math.cos(p2*2.3)),\n            D*.48,\"rgba(255,110,160,%a)\",.13);\n\n  }else if(kind===\"sparkle\"){\n    for(i=0;i<14;i++){\n      var sx=lightRnd(i+11)*W, sy=lightRnd(i+53)*H;\n      var tw=Math.sin(t*Math.PI*2/1.5+lightRnd(i+77)*6.28);\n      if(tw<=0)continue;                          // off for half its cycle\n      var s=W*.012*(0.5+tw), a2=.55*tw;\n      x.strokeStyle=\"rgba(255,255,255,\"+a2.toFixed(3)+\")\";\n      x.lineWidth=Math.max(1,W*.0022);\n      x.beginPath();\n      x.moveTo(sx-s,sy);x.lineTo(sx+s,sy);\n      x.moveTo(sx,sy-s);x.lineTo(sx,sy+s);\n      x.stroke();\n      softDot(x,sx,sy,s*1.5,\"rgba(255,255,255,%a)\",a2*.5);\n    }\n\n  }else if(kind===\"rays\"){\n    // shafts fanning from a point off the top corner, the fan swinging slowly.\n    // Drawn as one rotated group so the beams stay parallel to each other.\n    var ox=W*.16,oy=-H*.12,sw=.10*Math.sin(t*Math.PI*2/7);\n    x.save();x.translate(ox,oy);x.rotate(.55+sw);\n    for(i=0;i<9;i++){\n      var off=(i-4)*W*.17, bw2=W*(.045+lightRnd(i+5)*.060);\n      var gr=x.createLinearGradient(off,0,off,D*1.7);\n      var ga=.10+.07*lightRnd(i+29)+.03*Math.sin(t*Math.PI*2/3.3+i);\n      gr.addColorStop(0,\"rgba(255,247,224,\"+ga.toFixed(3)+\")\");\n      gr.addColorStop(1,\"rgba(255,247,224,0)\");\n      x.fillStyle=gr;\n      x.beginPath();\n      x.moveTo(off-bw2*.25,0);x.lineTo(off+bw2*.25,0);\n      x.lineTo(off+bw2*1.6,D*1.7);x.lineTo(off-bw2*1.6,D*1.7);\n      x.closePath();x.fill();\n    }\n    x.restore();\n    softDot(x,ox,oy,D*.5,\"rgba(255,240,210,%a)\",.13);\n\n  }else if(kind===\"neon\"){\n    // takes the brand accent rather than white, so the glow belongs to the\n    // design instead of sitting on top of it\n    var ac=hexRGB(BRAND.accent)||[255,90,160];\n    var col=\"rgba(\"+ac[0]+\",\"+ac[1]+\",\"+ac[2]+\",%a)\";\n    var beat=.5+.5*Math.sin(t*Math.PI*2/1.9);\n    softDot(x,W*.5,H*1.02,D*.80,col,.16+.14*beat);\n    softDot(x,W*(.18+.10*Math.sin(t*.9)),H*.16,D*.38,col,.10+.09*(1-beat));\n    var eg=x.createLinearGradient(0,0,W,0);\n    eg.addColorStop(0,col.replace(\"%a\",(.17+.09*beat).toFixed(3)));\n    eg.addColorStop(.35,col.replace(\"%a\",0));\n    eg.addColorStop(.65,col.replace(\"%a\",0));\n    eg.addColorStop(1,col.replace(\"%a\",(.17+.09*(1-beat)).toFixed(3)));\n    x.fillStyle=eg;x.fillRect(0,0,W,H);\n\n  }else if(kind===\"prism\"){\n    // three offset bands of split light — the same rake as Shine, but the\n    // colours trail each other the way glass separates them\n    var cols=[[255,90,120],[110,240,180],[120,150,255]],per2=3.2;\n    for(i=0;i<3;i++){\n      var ph2=((t+i*.16)%per2)/per2, bw3=W*.22;\n      var cx2=-bw3+ph2*(W+bw3*2);\n      var g3=x.createLinearGradient(cx2-bw3,0,cx2+bw3,H*.6);\n      var c=cols[i];\n      g3.addColorStop(0,\"rgba(\"+c[0]+\",\"+c[1]+\",\"+c[2]+\",0)\");\n      g3.addColorStop(.5,\"rgba(\"+c[0]+\",\"+c[1]+\",\"+c[2]+\",.16)\");\n      g3.addColorStop(1,\"rgba(\"+c[0]+\",\"+c[1]+\",\"+c[2]+\",0)\");\n      x.fillStyle=g3;x.fillRect(0,0,W,H);\n    }\n\n  }else if(kind===\"dust\"){\n    // fine motes rising through the beam of light — smaller, slower and far\n    // more numerous than Bokeh, so it reads as air rather than as lens shape\n    for(i=0;i<46;i++){\n      var dxr=lightRnd(i+7), dyr=lightRnd(i+61), dzr=lightRnd(i+131);\n      var dsp=.020+dzr*.030;\n      var dy2=((dyr-t*dsp)%1+1)%1;\n      var wob=Math.sin(t*.7+i)*.012;\n      var dr=W*(.0022+dzr*.0055);\n      softDot(x,(dxr+wob)*W,dy2*H,dr*4,\"rgba(255,252,240,%a)\",.10+dzr*.16);\n    }\n  }\n  x.restore();\n}\n/* End-card looks. \"classic\" is the original and stays first, because a reel\n   saved before this list existed reopens as that one. */\nvar ENDCARDS=[[\"off\",\"Off\"],[\"classic\",\"Classic\"],[\"accent\",\"Brand colour\"],\n              [\"minimal\",\"Minimal\"],[\"card\",\"Card\"]];\nfunction drawEndCard(x,W,H,a){\n  var st=endStyle();if(!st)return;\n  var e=ease(Math.min(1,a));                  // contents settle as the card lands\n  x.save();\n  x.globalAlpha=Math.min(1,a);\n  // true when the INK is dark, which means the artwork under it is light — so\n  // every surface below flips to the pale side of the pair\n  var dark=inkIsDark();\n  var ink=inkColor(), gap=H*.035, lg=BRAND.logoImg, hasLogo=!!(lg&&lg.naturalWidth);\n\n  if(st===\"accent\"){\n    // the whole frame becomes the brand colour, so ink is decided by the\n    // accent rather than by whatever the artwork behind it was doing\n    x.fillStyle=BRAND.accent;x.fillRect(0,0,W,H);\n    ink=onAccent();\n  }else if(st===\"minimal\"){\n    // the design keeps playing — only the lower third is weighted down enough\n    // to carry the handle. Nothing is hidden, so it suits photo reels.\n    var mg=x.createLinearGradient(0,H*.42,0,H);\n    mg.addColorStop(0,dark?\"rgba(255,255,255,0)\":\"rgba(8,10,16,0)\");\n    mg.addColorStop(1,dark?\"rgba(255,255,255,.88)\":\"rgba(8,10,16,.86)\");\n    x.fillStyle=mg;x.fillRect(0,H*.42,W,H*.58);\n  }else{\n    x.fillStyle=dark?\"rgba(255,255,255,.90)\":\"rgba(10,12,18,.86)\";\n    x.fillRect(0,0,W,H);\n  }\n\n  /* Measure the stack before drawing any of it: Card has to wrap it, and a\n     panel sized to a fixed fraction leaves a hole under a handle-only card. */\n  var hFs=H*(st===\"card\"?.038:.045), cFs=H*(st===\"card\"?.032:.036);\n  var lw=0,lh=0;\n  if(hasLogo){ lw=W*(st===\"card\"?.24:.30); lh=lw*lg.naturalHeight/lg.naturalWidth; }\n  var hasH=!!BRAND.handle, hasC=!!S.copy.cta;\n  var stack=(hasLogo?lh:0)+(hasH?hFs*1.2:0)+(hasC?cFs*2.1:0)\n           +((hasLogo&&(hasH||hasC))?gap*.8:0)+((hasH&&hasC)?gap*.9:0);\n\n  // where the stack sits: Minimal hangs it low over the band, the rest centre it\n  var mid=(st===\"minimal\"?H*.76:H*.5)+(1-e)*H*.035;\n  var y=mid-stack/2;\n  x.globalAlpha=Math.min(1,a)*e;\n  x.textAlign=\"center\";x.textBaseline=\"middle\";\n\n  if(st===\"card\"){\n    // a panel with its own edge, so the card reads as a card and not as the\n    // reel having simply faded out\n    var wide=hasLogo?lw:0;\n    if(hasH){x.font=\"700 \"+hFs+\"px \"+bodyFamily();wide=Math.max(wide,x.measureText(BRAND.handle).width);}\n    if(hasC){x.font=\"700 \"+cFs+\"px \"+bodyFamily();wide=Math.max(wide,x.measureText(S.copy.cta).width+cFs*2.2);}\n    var pad=H*.055, cw=Math.min(W*.86,Math.max(W*.58,wide+W*.16));\n    var chh=stack+pad*2, cx0=(W-cw)/2, cy0=mid-chh/2;\n    x.save();\n    // a white panel on a white wash has only its border to stand on, so it\n    // gets the heavier drop of the two\n    x.shadowColor=\"rgba(0,0,0,\"+(dark?.28:.45)+\")\";x.shadowBlur=W*.05;x.shadowOffsetY=W*.012;\n    x.fillStyle=dark?\"rgba(255,255,255,.96)\":\"rgba(20,22,30,.96)\";\n    roundRect(x,cx0,cy0,cw,chh,W*.06);x.fill();\n    x.restore();\n    x.strokeStyle=BRAND.accent;x.lineWidth=Math.max(2,W*.005);\n    roundRect(x,cx0,cy0,cw,chh,W*.06);x.stroke();\n  }\n\n  if(hasLogo){ x.drawImage(lg,(W-lw)/2,y,lw,lh); y+=lh+((hasH||hasC)?gap*.8:0); }\n  if(hasH){\n    x.font=\"700 \"+hFs+\"px \"+bodyFamily();\n    x.fillStyle=ink;\n    x.fillText(BRAND.handle,W/2,y+hFs*.6);\n    y+=hFs*1.2+(hasC?gap*.9:0);\n  }\n  if(hasC){\n    x.font=\"700 \"+cFs+\"px \"+bodyFamily();\n    var tw=x.measureText(S.copy.cta).width,pw=tw+cFs*2.2,ph=cFs*2.1,py=y+ph/2;\n    // on the accent fill a solid accent pill would vanish, so the pill inverts\n    x.fillStyle=st===\"accent\"?ink:BRAND.accent;\n    roundRect(x,W/2-pw/2,py-ph/2,pw,ph,ph/2);x.fill();\n    x.fillStyle=st===\"accent\"?BRAND.accent:onAccent();\n    x.fillText(S.copy.cta,W/2,py+cFs*.06);\n  }\n  x.restore();\n}\nfunction reelDur(){return (S.video&&S.video.secs)||6;}\nvar reelRAF=null,reelT0=0;\nfunction toggleReel(){ reelRAF?stopReel():playReel(); }\n/* from: seconds to start at, for previewing a beat near the end without\n   sitting through the whole clip */\nfunction playReel(from){\n  stopReel();\n  sel=null;el('selCtl').style.display='none';\n  var D=reelDur();reelT0=(window.performance||Date).now()-Math.max(0,(+from||0))*1000;\n  (function step(){\n    var t=((window.performance||Date).now()-reelT0)/1000;\n    if(t>=D+.35){stopReel();return;}\n    ANIM=animAt(Math.min(t,D),D);paint();\n    reelRAF=requestAnimationFrame(step);\n  })();\n  updVideo();haptic('light');\n}\nfunction stopReel(){\n  if(reelRAF)cancelAnimationFrame(reelRAF);\n  reelRAF=null;ANIM=null;paint();updVideo();\n}\nfunction setReelSecs(v){\n  S.video.secs=v;el('vidLen').textContent=v+'s';saveDraft();updVideo();\n}\nfunction useReelFormat(){\n  S.format='story';buildFormats();buildTemplates();paint();saveDraft();updVideo();haptic('success');\n}\nfunction vidChips(id,items,cur,set){\n  var w=el(id);if(!w)return;w.innerHTML='';\n  items.forEach(function(it){\n    var b=document.createElement('button');b.className='chip'+(it[0]===cur?' on':'');b.textContent=it[1];\n    b.onclick=function(){set(it[0]);buildVideoControls();saveDraft();haptic('selection');playReel();};\n    w.appendChild(b);\n  });\n}\n/* One line per option, because the chip names alone can't say which ones move\n   the frame and which only touch the headline. */\nvar MOTION_HINT={\n  drift:'A slow push in with a little pan — the safe one.',\n  pop:'Snaps in from wide, then keeps easing.',\n  slide:'The frame travels sideways under the words.',\n  pulse:'Breathes in and out on a steady beat.',\n  zoom:'Starts tight and pulls back to reveal the frame.',\n  sway:'Wanders like a handheld camera — never repeats itself.',\n  parallax:'Words and background travel opposite ways, for depth.'};\nvar TEXTIN_HINT={\n  fade:'Everything fades up where it sits.',\n  rise:'Blocks lift into place as they appear.',\n  word:'The headline builds a word at a time.',\n  type:'The headline types itself out.',\n  blur:'Words arrive out of focus and sharpen as they land.',\n  scale:'Blocks grow into place and settle.',\n  line:'The headline arrives a line at a time.',\n  swipe:'Blocks slide in from alternating sides.'};\nfunction buildVideoControls(){\n  vidChips('motionRow',MOTIONS,S.video.motion,function(v){S.video.motion=v;});\n  vidChips('textInRow',TEXTINS,S.video.textIn,function(v){S.video.textIn=v;});\n  el('motionHint').textContent=MOTION_HINT[S.video.motion]||'';\n  el('textInHint').textContent=TEXTIN_HINT[S.video.textIn]||'';\n  el('vsecs').value=S.video.secs;el('vidLen').textContent=S.video.secs+'s';\n  updVideo();\n}\nfunction updVideo(){\n  var story=S.format==='story';\n  el('vidFmtHint').textContent=story\n    ? 'Every reel exports at 1080 × 1920 — the right shape for Reels, Stories and TikTok.'\n    : 'Reels and Stories are 9:16. This one exports at '+FORMATS[S.format].name+' instead.';\n  el('vidFmtBtn').style.display=story?'none':'block';\n  el('playBtn').textContent=reelRAF?'■ Stop preview':'▶ Play preview';\n  el('vidBtn').textContent=window.myllmVideo?'Save reel to Photos':'Save a still instead';\n  el('vidHint').textContent=vidMsg||(window.myllmVideo\n    ? 'Silent by design — add music in Instagram, TikTok or Reels. Rendering takes about '\n      +Math.max(10,Math.round(reelDur()*3))+' seconds.'\n    : 'The preview works right now — saving it as a video needs a newer version of MyLLM.');\n}\n/* The result of the last export outlives the tidy-up pass that re-renders the\n   panel — otherwise updVideo() wipes the very message the user needs to read. */\nvar vidMsg='';\nfunction setVidMsg(t){ vidMsg=t||''; if(el('vidHint'))updVideo(); }\n/* Export: render every frame at full size and hand it to the native encoder one\n   at a time. Each frame() resolves only once it's encoded, so this loop is its\n   own back-pressure — memory stays at one frame however long the clip is. */\nvar reelCancel=false;\nfunction cancelReel(){ reelCancel=true; el('vidProgTxt').textContent='Stopping…'; }\nfunction exportReel(){\n  stopReel();\n  if(!window.myllmVideo){ doExport(); return; }   // older build: still image\n  var f=FORMATS[S.format],D=reelDur(),fps=S.video.fps||30;\n  var total=Math.max(1,Math.round(D*fps)),cv=document.createElement('canvas');\n  var keep=sel;sel=null;reelCancel=false;setVidMsg('');\n  var name=((S.copy.hook||'Social reel').replace(/[^\\w .-]/g,'').trim()||'Social reel').slice(0,40);\n  el('vidBtn').disabled=true;el('playBtn').disabled=true;\n  el('vidProg').style.display='block';setReelProgress(0,total);\n  myllmVideo.start({width:f.w,height:f.h,fps:fps}).then(function(){\n    var i=0;\n    return (function next(){\n      if(reelCancel)return myllmVideo.cancel().then(function(){return null;});\n      if(i>=total)return myllmVideo.finish({save:true,filename:name});\n      ANIM=animAt(i/fps,D);\n      render(cv,f.w,f.h,true);\n      if(i%3===0)paint();                       // let the preview show it building\n      var frame=cv.toDataURL('image/jpeg',.88);\n      setReelProgress(i+1,total);\n      return myllmVideo.frame(frame).then(function(){i++;return next();});\n    })();\n  }).then(function(res){\n    if(!res){setVidMsg('Reel cancelled.');haptic('warning');return;}\n    reelDoneSheet(res,name,D);\n  }).catch(function(e){\n    setVidMsg('The reel didn’t save: '+(e&&e.message||'something went wrong'));\n    haptic('error');\n    try{myllmVideo.cancel();}catch(e2){}\n  }).then(function(){\n    ANIM=null;sel=keep;paint();\n    el('vidBtn').disabled=false;el('playBtn').disabled=false;\n    el('vidProg').style.display='none';updVideo();\n  });\n}\nfunction setReelProgress(n,total){\n  el('vidBarFill').style.width=Math.round(n/total*100)+'%';\n  el('vidProgTxt').textContent='Rendering frame '+n+' of '+total+'…';\n}\nfunction reelDoneSheet(res,name,D){\n  var caption=captionOut(),copied=false;\n  if(caption){\n    try{\n      var ta=document.createElement('textarea');ta.value=caption;document.body.appendChild(ta);\n      ta.select();copied=document.execCommand('copy');document.body.removeChild(ta);\n    }catch(e){}\n  }\n  var saved=res&&res.saved;\n  el('sheet').innerHTML='<h3>'+(saved?'Reel saved to Photos':'Your reel is ready')+'</h3>'+\n    '<p class=\"hint\">'+Math.round((res&&res.seconds)||D)+' seconds · '+FORMATS[S.format].name+\n      ' · no sound, so add music where you post it.</p>'+\n    (saved?'':'<p class=\"hint\">'+((res&&res.note)||'It wasn’t added to Photos.')+'</p>')+\n    '<button class=\"btn\" onclick=\"shareReel()\">Share the reel…</button>'+\n    (caption?'<p class=\"ok\">'+(copied?'Caption + hashtags copied — just paste when you post.':'')+'</p>':'')+\n    '<button class=\"btn line\" onclick=\"el(\\'scrim\\').classList.remove(\\'on\\')\">Done</button>';\n  el('scrim').classList.add('on');\n  setVidMsg(saved?'Saved to Photos ✓':'');\n  haptic('success');\n}\n/* Sharing re-renders the clip: the encoder hands the finished file straight to\n   the iOS share sheet, so there's no multi-megabyte round trip through JS. */\nfunction shareReel(){\n  el('scrim').classList.remove('on');\n  if(!window.myllmVideo)return;\n  var f=FORMATS[S.format],D=reelDur(),fps=S.video.fps||30;\n  var total=Math.max(1,Math.round(D*fps)),cv=document.createElement('canvas');\n  var name=((S.copy.hook||'Social reel').replace(/[^\\w .-]/g,'').trim()||'Social reel').slice(0,40);\n  reelCancel=false;setVidMsg('');\n  el('vidBtn').disabled=true;el('vidProg').style.display='block';setReelProgress(0,total);\n  myllmVideo.start({width:f.w,height:f.h,fps:fps}).then(function(){\n    var i=0;\n    return (function next(){\n      if(reelCancel)return myllmVideo.cancel().then(function(){return null;});\n      if(i>=total)return myllmVideo.finish({save:false,share:true,filename:name});\n      ANIM=animAt(i/fps,D);render(cv,f.w,f.h,true);\n      setReelProgress(i+1,total);\n      return myllmVideo.frame(cv.toDataURL('image/jpeg',.88)).then(function(){i++;return next();});\n    })();\n  }).catch(function(e){\n    setVidMsg('Couldn’t share the reel: '+(e&&e.message||'something went wrong'));\n  }).then(function(){\n    ANIM=null;paint();el('vidBtn').disabled=false;el('vidProg').style.display='none';\n  });\n}\n\n/* ---------------- panels ---------------- */\nvar TABS=[[\"layout\",\"Layout\",\"M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5zM4 10h16M10 10v10\"],\n [\"words\",\"Words\",\"M5 7h14M5 12h14M5 17h9\"],\n [\"style\",\"Style\",\"M12 3a9 9 0 1 0 0 18c1.2 0 2-.9 2-2 0-.6-.25-1.1-.6-1.5-.35-.4-.6-.9-.6-1.5a2 2 0 0 1 2-2h2.3A3.9 3.9 0 0 0 21 12c0-5-4-9-9-9zM7.5 10.5h.01M10.5 6.5h.01M15.5 6.5h.01\"],\n [\"stickers\",\"Stickers\",\"M12 3a9 9 0 1 0 9 9c0-.5 0-1-.14-1.5H12z M8.8 10.2h.01M14 14.5c-.6.7-1.4 1-2 1s-1.4-.3-2-1\"],\n [\"video\",\"Animation\",\"M12 3.5l1.7 4.3 4.3 1.7-4.3 1.7L12 15.5l-1.7-4.3L6 9.5l4.3-1.7zM18.5 15l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8zM5.5 14l.6 1.5 1.5.6-1.5.6L5.5 18l-.6-1.5L3.4 16l1.5-.6z\"],\n [\"brand\",\"Brand\",\"M4 8l8-5 8 5v8l-8 5-8-5zM12 3v18\"],\n [\"posts\",\"Posts\",\"M4 6.5A1.5 1.5 0 0 1 5.5 5H9l2 2h7.5A1.5 1.5 0 0 1 20 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 17.5z\"]];\nfunction buildTabs(){\n  var t=el('tabs');t.innerHTML='';\n  TABS.forEach(function(tb,i){\n    var b=document.createElement('button');b.className=i===0?'on':'';\n    b.innerHTML='<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"'+tb[2]+'\"/></svg>'+tb[1];\n    b.onclick=function(){\n      if(reelRAF&&tb[0]!=='video')stopReel();   // leaving Video ends the preview\n      document.querySelectorAll('.tabs button').forEach(function(x){x.classList.remove('on');});\n      document.querySelectorAll('.panel').forEach(function(x){x.classList.remove('on');});\n      b.classList.add('on');el('p-'+tb[0]).classList.add('on');\n      if(tb[0]==='posts')renderLibrary();\n      if(tb[0]==='video'){buildVideoControls();playReel();}\n      haptic('selection');\n    };\n    t.appendChild(b);\n  });\n}\nfunction buildFormats(){\n  var c=el('fmtChips');c.innerHTML='';\n  Object.keys(FORMATS).forEach(function(k){\n    var b=document.createElement('button');b.className='chip'+(k===S.format?' on':'');b.textContent=FORMATS[k].name;\n    b.onclick=function(){S.format=k;buildFormats();buildTemplates();buildSafe();paint();saveDraft();haptic('selection');};\n    c.appendChild(b);\n  });\n}\nfunction buildTemplates(){\n  var g=el('tgrid');g.innerHTML='';\n  Object.keys(TEMPLATES).forEach(function(k){\n    var cell=document.createElement('button');cell.className='tcell'+(k===S.template?' on':'');\n    var cv=document.createElement('canvas'),f=FORMATS[S.format];\n    var old=S.template;S.template=k;\n    render(cv,150,Math.round(150*f.h/f.w),true);\n    S.template=old;\n    cell.appendChild(cv);\n    var sp=document.createElement('span');sp.textContent=TEMPLATES[k].name;cell.appendChild(sp);\n    cell.onclick=function(){S.template=k;buildTemplates();paint();saveDraft();updCtaHint();haptic('selection');};\n    g.appendChild(cell);\n  });\n}\nfunction buildTones(){\n  var c=el('toneChips');c.innerHTML='';\n  TONES.forEach(function(t){\n    var b=document.createElement('button');b.className='chip'+(t===S.copy.tone?' on':'');b.textContent=t;\n    b.onclick=function(){S.copy.tone=t;buildTones();haptic('selection');};\n    c.appendChild(b);\n  });\n}\nfunction buildGrads(){\n  var g=el('grads');g.innerHTML='';\n  GRADS.forEach(function(gr,i){\n    var b=document.createElement('button');b.className='grad'+(S.bg.type==='grad'&&!S.bg.pal&&S.bg.grad===i?' on':'');\n    b.style.background=gr[2]\n      ? 'linear-gradient(135deg,'+gr[0]+' '+Math.round(gr[2]*100)+'%,'+gr[1]+')'\n      : 'linear-gradient(135deg,'+gr[0]+','+gr[1]+')';\n    b.onclick=function(){S.bg={type:'grad',grad:i,aiUrl:null};buildGrads();buildStyleControls();refreshStyle();paint();saveDraft();haptic('selection');};\n    g.appendChild(b);\n  });\n}\nfunction buildEmoji(){\n  var g=el('egrid');g.innerHTML='';\n  EMOJI.slice(0,48).forEach(function(ch){\n    var b=document.createElement('button');b.textContent=ch;\n    b.onclick=function(){addSticker('emoji',ch);};\n    g.appendChild(b);\n  });\n}\nvar SOLIDS=[\"#0b0d12\",\"#14202e\",\"#1d2b23\",\"#2b1a2e\",\"#33231a\",\"#111f26\",\"#3a3f4a\",\"#5b2331\",\"#0f3b36\",\"#563a10\",\"#e9e4da\",\"#f4eee6\",\n            // the near-blacks a neon accent needs to glow against\n            \"#05060b\",\"#0a0116\",\"#001014\",\"#120009\"];\nfunction chipRow(id,items,cur,set){\n  var w=el(id);w.innerHTML='';\n  items.forEach(function(it){\n    var b=document.createElement('button');b.className='chip'+(String(it[0])===String(cur)?' on':'');b.textContent=it[1];\n    b.onclick=function(){set(it[0]);buildStyleControls();paint();saveDraft();haptic('selection');};\n    w.appendChild(b);\n  });\n}\nfunction buildStyleControls(){\n  chipRow('dirRow',[['diag','↘ Diagonal'],['down','↓ Down'],['right','→ Across'],['radial','◎ Glow']],S.gradDir,function(v){S.gradDir=v;if(S.bg.type!=='grad')S.bg={type:'grad',grad:S.bg.grad||0,aiUrl:null};buildGrads();refreshStyle();});\n  var tex=el('texRow');\n  chipRow('texRow',[['none','None'],['grain','Grain'],['dots','Dots'],['lines','Lines'],\n                    ['grid','Grid'],['halftone','Halftone'],['cross','Crosshatch'],['film','Film']],\n          S.texture,function(v){S.texture=v;});\n  var vb=document.createElement('button');vb.className='chip'+(S.vig?' on':'');vb.textContent='Vignette';\n  vb.onclick=function(){S.vig=!S.vig;buildStyleControls();paint();saveDraft();haptic('selection');};\n  tex.appendChild(vb);\n  chipRow('plateRow',PLATES,S.plate||'none',function(v){S.plate=v;});\n  el('plateHint').textContent = (S.plate&&S.plate!=='none')\n    ? {plate:'A panel behind the headline — the one that holds up on a busy photo.',\n       bars:'Solid blocks with the words knocked out of them.',\n       highlight:'A marker band in your accent colour, under the words.',\n       outline:'A hairline box, nothing filled in.'}[S.plate]||''\n    : 'Sits behind the words themselves, rather than washing the whole frame.';\n  chipRow('scrimRow',[[0.55,'Light'],[1,'Balanced'],[1.45,'Bold']],S.scrimAdj,function(v){S.scrimAdj=+v;});\n  chipRow('frameRow',[['none','None'],['border','Border'],['inset','Inset'],['polaroid','Polaroid']],S.frame,function(v){S.frame=v;});\n  chipRow('ctaStyleRow',[['pill','Pill'],['outline','Outline'],['ghost','Ghost'],['link','Link text ›']],S.ctaStyle||'pill',function(v){S.ctaStyle=v;});\n  var d=el('solidRow');d.innerHTML='';\n  SOLIDS.forEach(function(c){\n    var b=document.createElement('button');b.className='dot'+(S.bg.type==='solid'&&S.bg.solid===c?' on':'');b.style.background=c;\n    b.onclick=function(){S.bg={type:'solid',solid:c,grad:S.bg.grad||0,aiUrl:null};S.photo=null;S.photoDraw=null;buildStyleControls();buildGrads();refreshStyle();paint();saveDraft();haptic('selection');};\n    d.appendChild(b);\n  });\n}\nvar ACCENTS=[\"#4f8df9\",\"#7d5cff\",\"#e05c8a\",\"#f9646c\",\"#f9b64f\",\"#2fbf9b\",\"#6cc267\",\"#3fa7d6\",\"#ffffff\",\"#111318\",\n             /* neon, to pair with the neon gradients — these are the accents\n                that survive being screened over by the Neon light effect */\n             \"#00e5ff\",\"#ff2fd0\",\"#39ff88\",\"#a855ff\",\"#ff6a00\",\"#ffe500\"];\nfunction renderBrand(){\n  el('bHandle').value=BRAND.handle;\n  var d=el('bDots');d.innerHTML='';\n  ACCENTS.forEach(function(c){\n    var b=document.createElement('button');b.className='dot'+(c===BRAND.accent?' on':'');b.style.background=c;\n    b.onclick=function(){BRAND.accent=c;saveBrand();renderBrand();paint();haptic('selection');};\n    d.appendChild(b);\n  });\n  el('wmSw').classList.toggle('on',!!BRAND.wm);\n  var has=!!BRAND.logo;\n  el('logoRm').style.display=has?'block':'none';\n  el('logoCtl').style.display=has?'block':'none';\n  if(has){\n    el('logoSizeR').value=Math.round((BRAND.logoSize||0.12)*100);\n    var pr=el('logoPosRow');pr.innerHTML='';\n    [['tl','Top left'],['tr','Top right'],['bl','Bottom left'],['br','Bottom right']].forEach(function(p){\n      var b=document.createElement('button');b.className='chip'+((BRAND.logoPos||'tr')===p[0]?' on':'');b.textContent=p[1];\n      b.onclick=function(){BRAND.logoPos=p[0];saveBrand();renderBrand();paint();haptic('selection')};\n      pr.appendChild(b);\n    });\n  }\n}\n\n/* ---------------- stickers ---------------- */\nfunction addSticker(kind,txt){\n  var st={kind:kind,txt:txt,x:.5,y:kind==='banner'?.16:.3,size:kind==='banner'?150:96};\n  if(kind==='banner'){ st.style=badgeStyle; if(badgeColour)st.col=badgeColour; }\n  S.stickers.push(st);sel=st;\n  el('selCtl').style.display='block';setSizeSlider(st);buildBadgeCtl();\n  paint();saveDraft();haptic('success');\n}\nfunction addAnyEmoji(){\n  var v=el('anyEmoji').value.trim();if(!v)return;\n  addSticker('emoji',[...v][0]);el('anyEmoji').value='';\n}\nvar badgeStyle=\"pill\", badgeColour=\"\";   // \"\" = follow the brand accent\n\nfunction addBanner(){\n  var v=el('banText').value.trim();if(!v)return;\n  addSticker('banner',v.toUpperCase());el('banText').value='';\n}\n/* The same two rows do double duty: they set what the NEXT badge looks like,\n   and — when a badge is selected — retune that one live. Anything else means\n   deleting and re-adding a badge just to try another shape. */\nfunction buildBadgeCtl(){\n  var row=el('badgeRow'),cols=el('badgeCols');\n  if(!row||!cols)return;\n  var live=(sel&&sel.kind==='banner')?sel:null;\n  var curStyle=live?(live.style||\"pill\"):badgeStyle;\n  var curCol=live?(live.col||\"\"):badgeColour;\n\n  row.innerHTML=\"\";\n  BADGES.forEach(function(o){\n    var b=document.createElement(\"button\");\n    b.className=\"chip\"+(curStyle===o[0]?\" on\":\"\");\n    b.textContent=o[1];\n    b.onclick=function(){\n      if(live){ live.style=o[0]; } else { badgeStyle=o[0]; }\n      buildBadgeCtl();paint();saveDraft();haptic(\"selection\");\n    };\n    row.appendChild(b);\n  });\n\n  cols.innerHTML=\"\";\n  BADGE_COLS.forEach(function(c){\n    var b=document.createElement(\"button\");\n    b.className=\"dot\"+(curCol===c?\" on\":\"\");\n    b.style.background=c||BRAND.accent;\n    b.title=c?\"\":\"Brand accent\";\n    if(!c)b.textContent=\"A\";\n    b.onclick=function(){\n      if(live){ live.col=c||null; } else { badgeColour=c; }\n      buildBadgeCtl();paint();saveDraft();haptic(\"selection\");\n    };\n    cols.appendChild(b);\n  });\n  var sb=el('selBadge'); if(sb)sb.style.display=live?'':'none';\n}\nfunction deleteSel(){\n  if(!sel)return;\n  S.stickers=S.stickers.filter(function(s){return s!==sel;});\n  sel=null;el('selCtl').style.display='none';buildBadgeCtl();paint();saveDraft();haptic('warning');\n}\n\n/* ---------------- photo ---------------- */\n/* Set a fully-loaded Image as the background and reset its position. */\nvar FILTERS=[\n ['none','Original',''],\n ['bw','B&W','grayscale(1) contrast(1.06)'],\n ['warm','Warm','sepia(.32) saturate(1.3) contrast(1.03)'],\n ['cool','Cool','saturate(1.12) hue-rotate(14deg) brightness(1.04)'],\n ['fade','Fade','contrast(.85) brightness(1.14) saturate(.8)'],\n ['punch','Punch','contrast(1.28) saturate(1.4)'],\n ['duo','Duotone','DUO']   // accent-tinted two-colour treatment; manual pixel pass\n];\nfunction setPhoto(im){\n  S.photo=im;S.photoDraw=null;S.photoFilter='none';S.photoBlur=0;el('pblur').value=0;\n  S.bg.type='photo';S.photoPos={x:0,y:0,scale:1};el('pzoom').value=100;\n  refreshStyle();buildFilters();buildGrads();paint();saveDraft();haptic('success');\n}\n/* bake the chosen filter once (ctx.filter when supported, else a pixel pass) so\n   live drag/zoom repaints stay fast */\nfunction applyFilter(id){\n  S.photoFilter=id;buildFilters();bakePhoto();haptic('selection');\n}\nfunction hexRgb(h){var m=String(h||'#4f8df9').match(/^#?([0-9a-f]{6})$/i);\n  var n=parseInt(m?m[1]:'4f8df9',16);return [n>>16&255,n>>8&255,n&255];}\n/* bake filter + blur once to an offscreen canvas so drag/zoom repaints stay fast */\nfunction bakePhoto(){\n  if(!S.photo){S.photoDraw=null;paint();return}\n  var id=S.photoFilter||'none',blur=S.photoBlur||0;\n  if(id==='none'&&!blur){S.photoDraw=null;paint();return}\n  var f=null;for(var i=0;i<FILTERS.length;i++)if(FILTERS[i][0]===id)f=FILTERS[i];\n  var css=(f&&f[2]!=='DUO')?f[2]:'';\n  var im=S.photo,c=document.createElement('canvas');c.width=im.width;c.height=im.height;\n  var x=c.getContext('2d');\n  var parts=[];if(css)parts.push(css);if(blur)parts.push('blur('+(blur*Math.max(1,im.width/1080)).toFixed(1)+'px)');\n  x.filter=parts.join(' ')||'none';\n  var supported=parts.length===0||x.filter!=='none';\n  x.drawImage(im,0,0);\n  if(!supported||id==='duo'){\n    x.filter='none';x.drawImage(im,0,0);\n    try{\n      var d=x.getImageData(0,0,c.width,c.height),p=d.data;\n      var ac=hexRgb(BRAND.accent);\n      var dark=[ac[0]*.22,ac[1]*.22,ac[2]*.22];\n      var light=[ac[0]+(255-ac[0])*.85,ac[1]+(255-ac[1])*.85,ac[2]+(255-ac[2])*.85];\n      for(var j=0;j<p.length;j+=4){\n        var r=p[j],g=p[j+1],bl=p[j+2];\n        if(id==='duo'){var l=(r*0.299+g*0.587+bl*0.114)/255;\n          r=dark[0]+(light[0]-dark[0])*l;g=dark[1]+(light[1]-dark[1])*l;bl=dark[2]+(light[2]-dark[2])*l;}\n        else if(id==='bw'){var l2=r*0.299+g*0.587+bl*0.114;r=g=bl=l2;}\n        else if(id==='warm'){r=Math.min(255,r*1.12+10);g=Math.min(255,g*1.04);bl=bl*0.88;}\n        else if(id==='cool'){r=r*0.9;g=Math.min(255,g*1.02);bl=Math.min(255,bl*1.12+8);}\n        else if(id==='fade'){r=r*0.85+34;g=g*0.85+34;bl=bl*0.85+34;}\n        else if(id==='punch'){r=(r-128)*1.28+128;g=(g-128)*1.28+128;bl=(bl-128)*1.28+128;}\n        p[j]=Math.max(0,Math.min(255,r));p[j+1]=Math.max(0,Math.min(255,g));p[j+2]=Math.max(0,Math.min(255,bl));\n      }\n      x.putImageData(d,0,0);\n      if(id==='duo'&&blur){var c2=document.createElement('canvas');c2.width=c.width;c2.height=c.height;\n        var x2=c2.getContext('2d');x2.filter='blur('+(blur*Math.max(1,im.width/1080)).toFixed(1)+'px)';\n        x2.drawImage(c,0,0);c=c2;}\n    }catch(e){}\n  }\n  S.photoDraw=c;paint();\n}\nfunction buildFilters(){\n  var w=el('filterRow');if(!w)return;\n  w.style.display=(S.photo&&S.bg.type==='photo')?'flex':'none';\n  w.innerHTML='';\n  FILTERS.forEach(function(f){\n    var b=document.createElement('button');b.className='chip'+(S.photoFilter===f[0]?' on':'');b.textContent=f[1];\n    b.onclick=function(){applyFilter(f[0])};\n    w.appendChild(b);\n  });\n}\n/* Preferred path: the native picker bridge returns a ready data: URL. Falls back\n   to a plain <input type=file> (used in the web preview, where the bridge is\n   absent) — that input is unreliable inside the MyLLM app, hence the bridge. */\nvar pickTarget='bg';\nfunction pickPhoto(target){\n  pickTarget=target||'bg';\n  el('styleHint').textContent='';\n  if(window.myllmPickImage){\n    myllmPickImage({maxDim:pickTarget==='item'?900:2000}).then(function(url){\n      if(!url)return; // user cancelled\n      var im=new Image();\n      im.onload=function(){pickTarget==='item'?addPhotoItem(im):setPhoto(im);};\n      im.onerror=function(){el('styleHint').textContent='That photo couldn’t be read — try another.';};\n      im.src=url;\n    }).catch(function(){el('styleHint').textContent='Couldn’t open the photo picker.';});\n  } else {\n    el('photoIn').click();\n  }\n}\n/* framed photo dropped INTO the post — behaves like a sticker (drag/resize),\n   stored as a small jpeg data URL so it survives in the posts library */\nfunction addPhotoItem(im){\n  var mx=640,sc=Math.min(1,mx/Math.max(im.width,im.height));\n  var c=document.createElement('canvas');c.width=Math.round(im.width*sc);c.height=Math.round(im.height*sc);\n  c.getContext('2d').drawImage(im,0,0,c.width,c.height);\n  var data=c.toDataURL('image/jpeg',.78);\n  var st={kind:'photo',data:data,x:.5,y:.52,size:430};\n  var pi=new Image();\n  pi.onload=function(){st._img=pi;S.stickers.push(st);sel=st;\n    el('selCtl').style.display='block';setSizeSlider(st);buildBadgeCtl();\n    paint();saveDraft();haptic('success');};\n  pi.src=data;\n}\nfunction setSizeSlider(st){\n  var s=el('ssize');\n  if(st.kind==='photo'){s.min=140;s.max=760;}else{s.min=24;s.max=200;}\n  s.value=st.size;\n}\nfunction loadPhoto(inp){\n  var f=inp.files&&inp.files[0];if(!f)return;\n  var url=URL.createObjectURL(f),im=new Image();\n  im.onload=function(){\n    if(pickTarget==='item'){ addPhotoItem(im); URL.revokeObjectURL(url); return; }\n    // downscale huge camera images once so preview stays fast\n    var maxSide=2000,sc=Math.min(1,maxSide/Math.max(im.width,im.height));\n    var c=document.createElement('canvas');c.width=im.width*sc;c.height=im.height*sc;\n    c.getContext('2d').drawImage(im,0,0,c.width,c.height);\n    var im2=new Image();\n    im2.onload=function(){ setPhoto(im2); URL.revokeObjectURL(url); };\n    im2.src=c.toDataURL('image/jpeg',.9);\n  };\n  im.onerror=function(){el('styleHint').textContent='That image couldn’t be read — try another.';};\n  im.src=url;\n  inp.value='';\n}\nfunction clearPhoto(){\n  S.photo=null;S.photoDraw=null;S.photoFilter='none';S.photoBlur=0;el('pblur').value=0;buildFilters();if(S.bg.type==='photo')S.bg={type:'grad',grad:S.bg.grad||0,aiUrl:null};\n  refreshStyle();buildGrads();paint();saveDraft();\n}\nfunction refreshStyle(){ el('photoCtl').style.display = (S.photo&&S.bg.type==='photo')?'block':'none'; buildFilters(); buildPalette(); }\n\n/* ---------------- AI ---------------- */\nfunction needAI(hintEl){\n  if(window.myllmAsk)return false;\n  hintEl.textContent='This needs the latest MyLLM with “Allow apps to use the AI” enabled in Settings.';\n  return true;\n}\n/* Small on-device models garble JSON, so all AI replies use labelled lines\n   (LABEL: value) parsed leniently — same approach as Talk Tutor. */\nvar LINE_KEYS={template:1,palette:1,hook:1,sub:1,cta:1,caption:1,tags:1,broad:1,niche:1,local:1};\nfunction parseLines(reply){\n  var o={},key=null;\n  String(reply||'').split(/\\r?\\n/).forEach(function(raw){\n    var ln=raw.replace(/\\*\\*/g,'').trim();\n    var m=ln.match(/^[-*#>\\s]*([A-Za-z]+)\\s*[::]\\s*(.*)$/);\n    if(m&&LINE_KEYS[m[1].toLowerCase()]){key=m[1].toLowerCase();o[key]=m[2].trim();}\n    else if(key==='caption'&&ln){o.caption+=' '+ln;} // captions may wrap over lines\n  });\n  return o;\n}\nfunction unq(s){return String(s||'').trim().replace(/^[\"'“”‘’`]+|[\"'“”‘’`]+$/g,'').trim();}\nfunction tagsFrom(s){return String(s||'').split(/[\\s,]+/).filter(function(t){return t.charAt(0)==='#'&&t.length>1;});}\nfunction ask(p){\n  function go(q){return myllmAsk(q).then(function(r){\n    var o=parseLines(r);\n    if(!o.hook&&!o.broad&&!o.niche)throw new Error('the reply wasn’t in the expected format — try again');\n    return o;\n  });}\n  return go(p).catch(function(){return go(p+'\\nIMPORTANT: output only the labelled lines above, nothing else.');});\n}\nfunction applyCopy(o){\n  S.copy.hook=unq(o.hook).slice(0,60);\n  S.copy.sub=unq(o.sub).slice(0,110);\n  S.copy.cta=unq(o.cta).slice(0,30);\n  var tags=tagsFrom(o.tags).join(' ');\n  S.copy.caption=(unq(o.caption)+(tags?'\\n\\n'+tags:'')).trim();\n}\nfunction writeCopy(){\n  var hint=el('wordsHint');hint.textContent='';\n  if(needAI(hint))return;\n  var topic=el('topic').value.trim();\n  if(!topic){hint.textContent='Tell me what the post is about first.';return;}\n  var p='Write social media post copy about: \"'+topic+'\". Tone: '+S.copy.tone.toLowerCase()+'.\\n'+\n    'Reply with EXACTLY these 5 lines and nothing else:\\n'+\n    'HOOK: a punchy headline, max 7 words\\n'+\n    'SUB: a supporting line, max 16 words\\n'+\n    'CTA: a call to action, max 4 words\\n'+\n    'CAPTION: a 2-3 sentence caption for the post text\\n'+\n    'TAGS: 6-10 relevant hashtags separated by spaces';\n  el('writeBtn').disabled=true;hint.textContent='Writing…';\n  ask(p).then(function(o){\n    applyCopy(o);\n    hint.textContent='';fillWordFields();paint();saveDraft();haptic('success');\n  })\n  .catch(function(e){hint.textContent='Couldn’t write it: '+e.message;})\n  .then(function(){el('writeBtn').disabled=false;});\n}\n/* one tap: AI picks the template + palette, writes every field, then (if an\n   image server is set up) paints a background to match */\nfunction designMe(){\n  var hint=el('wordsHint');hint.textContent='';\n  if(needAI(hint))return;\n  var topic=el('topic').value.trim();\n  if(!topic){hint.textContent='Tell me what the post is about first.';return}\n  var p='Art-direct a social media post about: \"'+topic+'\". Tone: '+S.copy.tone.toLowerCase()+'.\\n'+\n    'Reply with EXACTLY these 7 lines and nothing else:\\n'+\n    'TEMPLATE: one of quote, promo, announce, tips, photocap, bold — whichever fits best\\n'+\n    'PALETTE: one number from 0 to 11 — 0 ocean blue, 1 violet, 2 emerald, 3 crimson, 4 amber, 5 slate, 6 sky, 7 magenta, 8 forest, 9 bronze, 10 charcoal, 11 electric purple\\n'+\n    'HOOK: a punchy headline, max 7 words\\n'+\n    'SUB: a supporting line, max 16 words\\n'+\n    'CTA: a call to action, max 4 words\\n'+\n    'CAPTION: a 2-3 sentence caption\\n'+\n    'TAGS: 6-10 relevant hashtags separated by spaces';\n  el('designBtn').disabled=true;setStatusWords('Designing your post…');\n  ask(p).then(function(o){\n    var tpl=String(o.template||'').toLowerCase().match(/quote|promo|announce|tips|photocap|bold/);\n    if(tpl&&TEMPLATES[tpl[0]])S.template=tpl[0];\n    var pm=String(o.palette||'').match(/\\d+/),pal=pm?parseInt(pm[0],10):-1;\n    if(pal>=0&&pal<GRADS.length){S.bg={type:'grad',grad:pal,aiUrl:null};S.photo=null;S.photoDraw=null;}\n    applyCopy(o);\n    fillWordFields();buildTemplates();buildGrads();buildStyleControls();refreshStyle();paint();saveDraft();\n    setStatusWords('');haptic('success');\n    if(window.myllmGenerateImage){aiBackground();}\n  })\n  .catch(function(e){setStatusWords('Couldn’t design it: '+e.message)})\n  .then(function(){el('designBtn').disabled=false});\n}\nfunction setStatusWords(t){el('wordsHint').textContent=t}\n/* ---------------- a week of posts ----------------\n\n   designMe() art-directs one post. A campaign needs several that belong\n   together, and asking a small on-device model for five at once reliably\n   collapses into mush — so this runs them one at a time, each told what the\n   others already cover so it doesn't repeat them.\n\n   Sequential model calls are slow enough to need a way out, so it reports\n   progress per post and can be stopped between them, the same contract\n   exportReel already offers.                                                  */\nvar weekStop=false;\nvar WEEK_ANGLES=[\n  \"the promise — what someone gets out of it\",\n  \"a concrete detail or number that proves it\",\n  \"an objection answered, or a myth corrected\",\n  \"a moment from behind the scenes\",\n  \"a direct invitation to act now\"\n];\nfunction stopWeek(){ weekStop=true; el('weekHint').textContent='Stopping after this one…'; }\nfunction makeWeek(){\n  var hint=el('weekHint');hint.textContent='';\n  if(needAI(hint))return;\n  var topic=el('topic').value.trim();\n  if(!topic){hint.textContent='Tell me what the posts are about first (the box above).';return}\n  var n=WEEK_ANGLES.length;\n  weekStop=false;\n  el('weekBtn').style.display='none';el('weekStop').style.display='';\n  var made=0,used=[];\n\n  function one(i){\n    if(weekStop||i>=n)return Promise.resolve();\n    hint.textContent='Writing post '+(i+1)+' of '+n+' — '+WEEK_ANGLES[i].split(' —')[0]+'…';\n    var p='Write social media post '+(i+1)+' of '+n+' in a series about: \"'+topic+'\". '+\n      'Tone: '+S.copy.tone.toLowerCase()+'. This one takes the angle: '+WEEK_ANGLES[i]+'.\\n'+\n      (used.length?('Do NOT repeat these headlines already used: '+used.join(' | ')+'\\n'):'')+\n      'Reply with EXACTLY these 6 lines and nothing else:\\n'+\n      'TEMPLATE: one of quote, promo, announce, tips, photocap, bold — whichever fits this angle\\n'+\n      'PALETTE: one number from 0 to '+(GRADS.length-1)+'\\n'+\n      'HOOK: a punchy headline, max 7 words\\n'+\n      'SUB: a supporting line, max 16 words\\n'+\n      'CTA: a call to action, max 4 words\\n'+\n      'CAPTION: a 2-3 sentence caption';\n    return ask(p).then(function(o){\n      var tpl=String(o.template||'').toLowerCase().match(/quote|promo|announce|tips|photocap|bold/);\n      if(tpl&&TEMPLATES[tpl[0]])S.template=tpl[0];\n      var pm=String(o.palette||'').match(/\\d+/),pal=pm?parseInt(pm[0],10):-1;\n      if(pal>=0&&pal<GRADS.length){S.bg={type:'grad',grad:pal,pal:null,aiUrl:null};S.photo=null;S.photoDraw=null;}\n      applyCopy(o);\n      if(S.copy.hook)used.push(S.copy.hook);\n      // straight into the library — the point is to end up with a week's worth\n      // sitting there, not to leave four of them lost in the editor\n      savePost();\n      made++;\n      fillWordFields();buildTemplates();buildGrads();refreshStyle();paint();\n      return one(i+1);\n    }).catch(function(e){\n      hint.textContent='Stopped at post '+(i+1)+': '+e.message;\n      weekStop=true;\n    });\n  }\n\n  one(0).then(function(){\n    el('weekBtn').style.display='';el('weekStop').style.display='none';\n    hint.textContent = made\n      ? (made+' post'+(made===1?'':'s')+' saved to My Posts'+(made<n?' (stopped early)':'')+' — open the Posts tab to edit any of them.')\n      : 'Nothing was generated.';\n    saveDraft();\n    if(made)haptic('success');\n  });\n}\n\nfunction aiBackground(){\n  var hint=el('styleHint');hint.textContent='';\n  if(!window.myllmGenerateImage){hint.textContent='AI backgrounds need image generation set up in MyLLM (Settings → Image Generation).';return;}\n  var topic=el('topic').value.trim()||S.copy.hook||'an announcement';\n  var aspect=S.format==='square'?'square':'portrait';\n  el('aiBgBtn').disabled=true;hint.textContent='Painting a background…';\n  myllmGenerateImage('abstract atmospheric background for a social media post about \"'+topic+'\", premium, moody, soft depth, no text, no words, no letters, no people',{aspect:aspect})\n  .then(function(url){\n    if(!url)throw new Error('no image came back');\n    var im=new Image();\n    im.onload=function(){S.bg={type:'ai',aiUrl:url,aiImg:im};S.photo=null;refreshStyle();buildGrads();buildStyleControls();paint();hint.textContent='';haptic('success');};\n    im.onerror=function(){hint.textContent='The image couldn’t be loaded.';};\n    im.src=url;\n  })\n  .catch(function(e){hint.textContent='No background: '+e.message;})\n  .then(function(){el('aiBgBtn').disabled=false;});\n}\n\n/* ---------------- export ---------------- */\nvar lastExport=null;\nfunction sharePost(){\n  if(!lastExport||!window.myllmShareFile)return;\n  var name=(S.copy.hook||'Social post').replace(/[^\\w .-]/g,'').trim()||'Social post';\n  myllmShareFile(lastExport,{filename:name,mime:'image/jpeg'}).catch(function(){});\n  haptic('light');\n}\nfunction doExport(){\n  if(CARO.on&&CARO.slides.length>1)return exportCarousel();\n  if(splitN()>1)return exportSplit();\n  var f=FORMATS[S.format],cv=document.createElement('canvas');\n  var keep=sel;sel=null;\n  render(cv,f.w,f.h,true);\n  sel=keep;\n  var data=cv.toDataURL('image/jpeg',.92);\n  lastExport=data;\n  var caption=captionOut();\n  var copied=false;\n  if(caption){\n    try{\n      var ta=document.createElement('textarea');ta.value=caption;document.body.appendChild(ta);\n      ta.select();copied=document.execCommand('copy');document.body.removeChild(ta);\n    }catch(e){}\n  }\n  var saved=false;\n  if(window.myllmSaveImage){try{myllmSaveImage(data);saved=true;}catch(e){}}\n  var s=el('sheet');\n  s.innerHTML='<h3>'+(saved?'Saved to Photos':'Your post is ready')+'</h3>'+\n    '<img src=\"'+data+'\" alt=\"Finished post\">'+\n    (window.myllmShareFile?'<button class=\"btn\" onclick=\"sharePost()\">Share post…</button>':'')+\n    '<button class=\"btn ghost\" onclick=\"savePost();el(\\'scrim\\').classList.remove(\\'on\\')\">Keep in My Posts</button>'+\n    (saved?'':'<p class=\"hint\">Press and hold the image to save it.</p>')+\n    (caption?('<p class=\"ok\">'+(copied?'Caption + hashtags copied — just paste when you post.':'')+'</p>'):'')+\n    (caption?'<button class=\"btn ghost\" onclick=\"shareCaption()\">Share caption text</button>':'')+\n    '<button class=\"btn line\" onclick=\"el(\\'scrim\\').classList.remove(\\'on\\')\">Done</button>';\n  el('scrim').classList.add('on');\n  haptic('success');\n}\nfunction shareCaption(){\n  var c=captionOut();if(!c)return;\n  if(window.myllmShare){try{myllmShare(c);return;}catch(e){}}\n}\n\n/* ---------------- posts library ---------------- */\nvar LIB=[],libArmed=null;\nfunction saveLibrary(){\n  var json=JSON.stringify(LIB),guard=0;\n  // myllmStorage budget (~1MB): shed oldest photos first, then oldest posts\n  while(json.length>880000&&guard++<60){\n    var shed=false;\n    for(var i=LIB.length-1;i>=0;i--){if(LIB[i].pd){LIB[i].pd=null;shed=true;break}}\n    if(!shed)for(var j=LIB.length-1;j>=0&&!shed;j--){\n      var sts=(LIB[j].st&&LIB[j].st.stickers)||[];\n      for(var k=0;k<sts.length;k++){if(sts[k].kind==='photo'&&sts[k].data){sts[k].data=null;shed=true;break}}\n    }\n    if(!shed)LIB.pop();\n    json=JSON.stringify(LIB);\n  }\n  store.setItem('socialstudio.library',json);\n}\nfunction postThumb(){\n  var f=FORMATS[S.format],tc=document.createElement('canvas');\n  var keep=sel;sel=null;\n  render(tc,240,Math.round(240*f.h/f.w),true);\n  sel=keep;\n  return tc.toDataURL('image/jpeg',.5);\n}\nfunction photoData(){\n  if(!S.photo||S.bg.type!=='photo')return null;\n  var im=S.photo,mx=1000,sc=Math.min(1,mx/Math.max(im.width,im.height));\n  var c=document.createElement('canvas');c.width=Math.round(im.width*sc);c.height=Math.round(im.height*sc);\n  c.getContext('2d').drawImage(im,0,0,c.width,c.height);\n  return c.toDataURL('image/jpeg',.6);\n}\nfunction savePost(){\n  var entry={\n    id:'p'+Date.now(),\n    name:(S.copy.hook||'Untitled post').slice(0,40),\n    date:new Date().toLocaleDateString(undefined,{month:'short',day:'numeric'}),\n    st:{format:S.format,template:S.template,ink:S.ink||'light',type:S.type||'auto',split:splitN(),textScale:S.textScale||1,textY:S.textY||0,ctaStyle:S.ctaStyle||'pill',ctaPos:S.ctaPos||null,\n        gradDir:S.gradDir,texture:S.texture,plate:S.plate||\"none\",vig:S.vig?1:0,scrimAdj:S.scrimAdj||1,frame:S.frame,\n        bg:{type:S.bg.type==='photo'?'photo':S.bg.type==='solid'?'solid':'grad',grad:S.bg.grad||0,solid:S.bg.solid||null,pal:S.bg.pal||null},\n        copy:JSON.parse(JSON.stringify(S.copy)),\n        stickers:packStickers(S.stickers),\n        photoFilter:S.photoFilter||'none',\n        video:JSON.parse(JSON.stringify(S.video)),\n        photoPos:JSON.parse(JSON.stringify(S.photoPos))},\n    thumb:postThumb(),\n    pd:photoData()\n  };\n  LIB.unshift(entry);saveLibrary();renderLibrary();\n  el('libHint').textContent='Saved “'+entry.name+'” ✓';\n  haptic('success');\n}\nfunction renderLibrary(){\n  var g=el('libGrid');if(!g)return;g.innerHTML='';\n  if(!LIB.length){el('libHint').textContent='Your saved posts appear here — keep several campaigns going at once.';return}\n  el('libHint').textContent=LIB.length+' saved post'+(LIB.length===1?'':'s')+' — tap to open.';\n  LIB.forEach(function(p){\n    var d=document.createElement('div');d.className='pcard2';\n    var im=document.createElement('img');im.src=p.thumb;im.alt='';d.appendChild(im);\n    var nm=document.createElement('span');nm.className='pn';nm.textContent=p.name;d.appendChild(nm);\n    var dup=document.createElement('button');dup.className='pact pdup';dup.textContent='⧉';\n    dup.onclick=function(ev){ev.stopPropagation();\n      var c=JSON.parse(JSON.stringify(p));c.id='p'+Date.now();c.name=(p.name+' copy').slice(0,40);\n      LIB.unshift(c);saveLibrary();renderLibrary();haptic('success')};\n    var del=document.createElement('button');del.className='pact pdel'+(libArmed===p.id?' armed':'');\n    del.textContent=libArmed===p.id?'Delete?':'✕';\n    del.onclick=function(ev){ev.stopPropagation();\n      if(libArmed!==p.id){libArmed=p.id;renderLibrary();setTimeout(function(){if(libArmed===p.id){libArmed=null;renderLibrary()}},2500);return}\n      libArmed=null;LIB=LIB.filter(function(x){return x.id!==p.id});saveLibrary();renderLibrary();haptic('warning')};\n    d.appendChild(dup);d.appendChild(del);\n    d.onclick=function(){openPost(p)};\n    g.appendChild(d);\n  });\n}\nfunction openPost(p){\n  var st=p.st||{};\n  S.format=FORMATS[st.format]?st.format:'square';\n  S.template=TEMPLATES[st.template]?st.template:'promo';\n  S.copy=Object.assign({},S.copy,st.copy||{});\n  S.textScale=typeof st.textScale==='number'?Math.min(1.5,Math.max(.6,st.textScale)):1;\n  S.textY=typeof st.textY==='number'?Math.min(.22,Math.max(-.22,st.textY)):0;\n  S.ctaStyle=st.ctaStyle||'pill';S.ink=st.ink||'light';S.type=TYPES[st.type]?st.type:'auto';S.split=Math.max(1,Math.min(3,+st.split||1));\n  S.ctaPos=(st.ctaPos&&typeof st.ctaPos.x==='number')?st.ctaPos:null;\n  S.gradDir=st.gradDir||'diag';S.texture=st.texture||'none';S.plate=st.plate||'none';S.vig=!!st.vig;\n  S.scrimAdj=+st.scrimAdj||1;S.frame=st.frame||'none';\n  S.stickers=restoreStickers(st.stickers);\n  S.video=normVideo(st.video);\n  S.photoFilter=st.photoFilter||'none';\n  S.photoPos=st.photoPos||{x:0,y:0,scale:1};\n  S.photo=null;S.photoDraw=null;\n  S.bg=(st.bg&&st.bg.type==='solid'&&st.bg.solid)?{type:'solid',solid:st.bg.solid,grad:st.bg.grad||0,aiUrl:null}\n      :{type:'grad',grad:(st.bg&&st.bg.grad)||0,pal:(st.bg&&st.bg.pal)||null,aiUrl:null};\n  function done(){\n    buildFormats();buildTemplates();buildGrads();buildStyleControls();buildVideoControls();fillWordFields();refreshStyle();buildInk();buildType();buildEndCard();buildLight();buildSafe();buildSplit();paint();saveDraft();\n    el('libHint').textContent='Opened “'+p.name+'”'+((st.bg&&st.bg.type==='photo'&&!p.pd)?' — its photo couldn’t be kept, re-add one.':'');\n    haptic('selection');\n  }\n  if(st.bg&&st.bg.type==='photo'&&p.pd){\n    var im=new Image();\n    im.onload=function(){\n      S.photo=im;S.bg.type='photo';el('pzoom').value=Math.round((S.photoPos.scale||1)*100);\n      if(S.photoFilter&&S.photoFilter!=='none')applyFilter(S.photoFilter);else S.photoDraw=null;\n      done();\n    };\n    im.src=p.pd;\n  } else done();\n}\n\n/* photo stickers carry an Image object at runtime; persist only the data URL */\nfunction packStickers(arr){\n  return (arr||[]).map(function(s){\n    return s.kind==='photo'?{kind:'photo',data:s.data||null,x:s.x,y:s.y,size:s.size}:s;\n  });\n}\nfunction restoreStickers(arr){\n  var out=[];\n  (arr||[]).forEach(function(s){\n    if(s&&s.kind==='photo'){\n      if(!s.data)return;              // shed for budget — drop the placeholder\n      var st={kind:'photo',data:s.data,x:s.x,y:s.y,size:s.size};\n      var im=new Image();im.onload=function(){st._img=im;paint();};im.src=s.data;\n      out.push(st);\n    } else if(s) out.push(s);\n  });\n  return out;\n}\n/* ---------------- safe zones ----------------\n\n   Reels, Stories and TikTok paint their own UI over your video: a status bar\n   and profile row at the top, caption and buttons at the bottom, an action rail\n   down the right. Words placed there are simply covered, and you only find out\n   after posting. These are the published-ish proportions each app reserves —\n   approximate by nature, so the guides are deliberately generous.\n\n   Preview only. Never persisted into a post, never part of an export.         */\nvar SAFE = {\n  off:     { name:\"Off\" },\n  reels:   { name:\"Reels\",   top:.13, bot:.20, right:.15 },\n  stories: { name:\"Stories\", top:.14, bot:.14, right:0   },\n  tiktok:  { name:\"TikTok\",  top:.10, bot:.22, right:.16 }\n};\nvar safeZone = 'off';\n\nfunction buildSafe(){\n  var row=el('safeRow'); if(!row)return;\n  row.innerHTML='';\n  Object.keys(SAFE).forEach(function(k){\n    var b=document.createElement('button');\n    b.className='chip'+(k===safeZone?' on':'');\n    b.textContent=SAFE[k].name;\n    b.onclick=function(){ safeZone=k; _safeSig=null; buildSafe(); paintSafe(); saveDraft(); haptic('selection'); };\n    row.appendChild(b);\n  });\n  var isStory=S.format==='story';\n  el('safeCtl').style.display=isStory?'':'none';\n  el('safeHint').textContent = safeZone==='off'\n    ? 'Turn on to see the area each app covers with its own buttons.'\n    : 'Striped areas sit behind the '+SAFE[safeZone].name+' interface. Guides never appear in your export.';\n}\n\n/* Match the overlay to the canvas box, then lay the reserved areas over it.\n   paint() runs at 60fps during reel playback, so bail unless something the\n   overlay actually depends on has moved. */\nvar _safeSig=null;\nfunction paintSafe(){\n  var ov=el('safeOv'), cv=el('pv'); if(!ov||!cv)return;\n  var z=SAFE[safeZone];\n  var wantZones=z&&safeZone!=='off'&&S.format==='story'&&splitN()===1;\n  var wantCuts=splitN()>1;\n  if(!wantZones&&!wantCuts){\n    // Clear on what the OVERLAY is actually showing, not on the signature:\n    // turning the guides off resets _safeSig first, and keying the clear off\n    // that meant the one call that had to wipe the overlay was the one call\n    // that skipped it — the stripes stayed up until the next relayout.\n    if(ov.className||ov.innerHTML){ ov.className=''; ov.innerHTML=''; }\n    _safeSig=null;\n    return;\n  }\n  var st=el('stage'), r=cv.getBoundingClientRect(), sr=st.getBoundingClientRect();\n  var sig=safeZone+'|'+splitN()+'|'+Math.round(r.width)+'x'+Math.round(r.height)+'|'+Math.round(r.left-sr.left)+','+Math.round(r.top-sr.top);\n  if(sig===_safeSig)return;\n  _safeSig=sig;\n  ov.style.left=(r.left-sr.left)+'px'; ov.style.top=(r.top-sr.top)+'px';\n  ov.style.width=r.width+'px'; ov.style.height=r.height+'px';\n  ov.className='on';\n  if(wantCuts){ ov.innerHTML=paintSplitGuides(ov,r.width,r.height); return; }\n  ov.innerHTML=\n    '<div class=\"band\" style=\"top:0;height:'+(z.top*100)+'%\"></div>'+\n    '<div class=\"band\" style=\"bottom:0;height:'+(z.bot*100)+'%\"></div>'+\n    (z.right?'<div class=\"rail\" style=\"width:'+(z.right*100)+'%\"></div>':'')+\n    '<div class=\"edge\" style=\"top:'+(z.top*100)+'%\"></div>'+\n    '<div class=\"edge\" style=\"bottom:'+(z.bot*100)+'%\"></div>'+\n    '<div class=\"zlbl\" style=\"top:calc('+(z.top*100)+'% + 4px)\">safe from here</div>'+\n    '<div class=\"zlbl\" style=\"bottom:calc('+(z.bot*100)+'% + 4px)\">to here</div>';\n}\n\n/* ---------------- undo ----------------\n\n   One hook, not fifty. Rather than calling push() from every oninput in the\n   deck, we watch for the state actually CHANGING: paint() runs after every\n   visual edit, so a debounced diff there catches drags, sliders, AI rewrites\n   and template switches alike, and coalesces a slider sweep into one step.\n\n   Runtime Image objects are held by reference instead of being re-decoded from\n   their data URLs, so undo restores a photo instantly — better than the draft,\n   which can't persist images at all inside the 1MB budget.                    */\nvar UNDO=[], UNDO_MAX=25, undoTimer=null, lastSnapJ=null, prevSnap=null, restoringSnap=false;\n\nfunction snapJSON(){\n  return JSON.stringify({\n    format:S.format, template:S.template, textScale:S.textScale||1, textY:S.textY||0, ink:S.ink, type:S.type, split:splitN(),\n    ctaStyle:S.ctaStyle||'pill', ctaPos:S.ctaPos||null, gradDir:S.gradDir, texture:S.texture, plate:S.plate||\"none\",\n    vig:S.vig?1:0, scrimAdj:S.scrimAdj||1, frame:S.frame, photoFilter:S.photoFilter||'none',\n    photoBlur:S.photoBlur||0, photoPos:S.photoPos||{x:0,y:0,scale:1},\n    bg:{type:S.bg.type,grad:S.bg.grad||0,solid:S.bg.solid||null,pal:S.bg.pal||null,aiUrl:S.bg.aiUrl||null},\n    copy:S.copy, stickers:packStickers(S.stickers), video:S.video\n  });\n}\nfunction snapNow(j){\n  return { j:j||snapJSON(), photo:S.photo, photoDraw:S.photoDraw,\n           imgs:(S.stickers||[]).map(function(s){ return (s&&s._img)||null; }) };\n}\nfunction applySnap(sn){\n  var d;\n  try{ d=JSON.parse(sn.j); }catch(e){ return; }\n  S.format=FORMATS[d.format]?d.format:'square';\n  S.template=TEMPLATES[d.template]?d.template:'promo';\n  S.copy=Object.assign({},S.copy,d.copy||{});\n  S.textScale=d.textScale;S.textY=d.textY;S.ctaStyle=d.ctaStyle;S.ctaPos=d.ctaPos;S.ink=d.ink||'light';S.type=TYPES[d.type]?d.type:'auto';S.split=Math.max(1,Math.min(3,+d.split||1));\n  S.gradDir=d.gradDir;S.texture=d.texture;S.plate=d.plate||\"none\";S.vig=!!d.vig;S.scrimAdj=d.scrimAdj;S.frame=d.frame;\n  S.photoFilter=d.photoFilter;S.photoBlur=d.photoBlur;S.photoPos=d.photoPos;\n  S.bg=d.bg; S.video=normVideo(d.video);\n  S.stickers=restoreStickers(d.stickers);\n  // packStickers preserves order, so live images map back by index — this is what\n  // keeps an undo from flashing blank while data URLs re-decode\n  (sn.imgs||[]).forEach(function(im,i){ if(im&&S.stickers[i])S.stickers[i]._img=im; });\n  S.photo=sn.photo||null; S.photoDraw=sn.photoDraw||null;\n  sel=null; var sc=el('selCtl'); if(sc)sc.style.display='none';\n}\nfunction updUndoBtn(){\n  var b=el('undoBtn'); if(b)b.disabled=!UNDO.length;\n}\n/* Called from paint(). Skipped during reel playback — paint() runs at 60fps\n   there and only ANIM changes, so diffing would be pure waste. */\nfunction noteChange(){\n  if(restoringSnap||reelRAF)return;\n  clearTimeout(undoTimer);\n  undoTimer=setTimeout(function(){\n    var j=snapJSON();\n    if(j===lastSnapJ)return;\n    if(lastSnapJ!==null){\n      UNDO.push(prevSnap);\n      if(UNDO.length>UNDO_MAX)UNDO.shift();\n      updUndoBtn();\n    }\n    lastSnapJ=j; prevSnap=snapNow(j);\n  },420);\n}\nfunction doUndo(){\n  if(!UNDO.length)return;\n  var sn=UNDO.pop();\n  restoringSnap=true;\n  applySnap(sn);\n  buildFormats();buildTemplates();buildGrads();buildStyleControls();buildVideoControls();\n  fillWordFields();refreshStyle();buildInk();buildType();buildEndCard();buildLight();buildSafe();buildSplit();paint();saveDraft();\n  lastSnapJ=sn.j; prevSnap=sn;\n  restoringSnap=false;\n  updUndoBtn(); haptic('selection');\n}\n\n/* ---------------- persistence ---------------- */\nvar draftTimer=null;\nfunction saveDraft(){\n  clearTimeout(draftTimer);\n  draftTimer=setTimeout(function(){\n    var d={format:S.format,template:S.template,textScale:S.textScale||1,textY:S.textY||0,ctaStyle:S.ctaStyle||'pill',ctaPos:S.ctaPos||null,\n      gradDir:S.gradDir,texture:S.texture,plate:S.plate||\"none\",vig:S.vig?1:0,scrimAdj:S.scrimAdj||1,frame:S.frame,\n      bg:{type:S.bg.type==='solid'?'solid':'grad',grad:S.bg.grad||0,solid:S.bg.solid||null,pal:S.bg.pal||null},\n      copy:S.copy,stickers:packStickers(S.stickers),video:S.video,safeZone:safeZone,ink:S.ink,type:S.type,split:splitN(),feed:feedChrome?1:0};\n    var dj=JSON.stringify(d);\n    if(dj.length>820000){ // photo items can outgrow the draft budget — shed their data, oldest first\n      for(var i=0;i<d.stickers.length&&dj.length>820000;i++){\n        if(d.stickers[i].kind==='photo'&&d.stickers[i].data){d.stickers[i].data=null;dj=JSON.stringify(d);}\n      }\n    }\n    store.setItem('socialstudio.draft',dj); // bg photos/AI images aren't persisted (1MB app budget)\n  },500);\n}\nfunction saveBrand(){\n  store.setItem('socialstudio.brand',JSON.stringify({\n    handle:BRAND.handle,accent:BRAND.accent,wm:BRAND.wm,\n    logo:BRAND.logo,logoPos:BRAND.logoPos,logoSize:BRAND.logoSize\n  }));\n}\n/* logo: picked natively (myllmPickImage) or via file input in a browser */\nfunction pickLogo(){\n  if(window.myllmPickImage){\n    myllmPickImage({maxDim:500}).then(function(url){if(url)setLogo(url)}).catch(function(){});\n  } else el('logoIn').click();\n}\nfunction loadLogoFile(inp){\n  var f=inp.files&&inp.files[0];if(!f)return;\n  var r=new FileReader();r.onload=function(){setLogo(r.result)};r.readAsDataURL(f);inp.value='';\n}\nfunction setLogo(url){\n  var im=new Image();\n  im.onload=function(){\n    // keep the stored copy small (brand kit shares the 1MB app budget)\n    var mx=400,sc=Math.min(1,mx/Math.max(im.width,im.height));\n    var c=document.createElement('canvas');c.width=Math.round(im.width*sc);c.height=Math.round(im.height*sc);\n    c.getContext('2d').drawImage(im,0,0,c.width,c.height);\n    BRAND.logo=c.toDataURL('image/jpeg',.8);\n    var im2=new Image();im2.onload=function(){BRAND.logoImg=im2;saveBrand();renderBrand();paint();haptic('success')};\n    im2.src=BRAND.logo;\n  };\n  im.src=url;\n}\nfunction removeLogo(){BRAND.logo=null;BRAND.logoImg=null;saveBrand();renderBrand();paint();haptic('warning')}\nfunction updCount(){\n  var len=(S.copy.caption||'').length;\n  el('capCount').textContent=len?(len+' / 2,200'):'';\n  el('capCount').style.color=len>2200?'var(--danger)':'var(--mut)';\n}\n/* three AI-suggested hashtag sets — tap one to swap it into the caption */\nvar TAGSETS=null;\nfunction suggestTags(){\n  var hint=el('wordsHint');hint.textContent='';\n  if(needAI(hint))return;\n  var topic=el('topic').value.trim()||S.copy.hook||'';\n  if(!topic){hint.textContent='Add a topic or headline first.';return}\n  el('tagBtn').disabled=true;hint.textContent='Finding hashtags…';\n  var p='Suggest hashtags for a social post about: \"'+topic+'\".\\n'+\n    'Reply with EXACTLY these 3 lines and nothing else:\\n'+\n    'BROAD: 6 popular high-reach hashtags separated by spaces\\n'+\n    'NICHE: 6 specific community hashtags separated by spaces\\n'+\n    'LOCAL: 5 location or scene hashtags separated by spaces (invent a plausible scene if unknown)';\n  ask(p).then(function(o){\n    TAGSETS={broad:tagsFrom(o.broad),niche:tagsFrom(o.niche),local:tagsFrom(o.local)};\n    if(!TAGSETS.broad.length&&!TAGSETS.niche.length&&!TAGSETS.local.length)throw new Error('none came back');\n    var w=el('tagSets');w.innerHTML='';\n    [['broad','Broad reach'],['niche','Niche'],['local','Local']].forEach(function(k){\n      var set=TAGSETS[k[0]];\n      if(!Array.isArray(set)||!set.length)return;\n      var b=document.createElement('button');b.className='chip';\n      b.textContent=k[1]+' · '+set.length;\n      b.title=set.join(' ');\n      b.onclick=function(){applyTags(set);document.querySelectorAll('#tagSets .chip').forEach(function(x){x.classList.remove('on')});b.classList.add('on')};\n      w.appendChild(b);\n    });\n    hint.textContent='Tap a set to use it.';haptic('success');\n  }).catch(function(e){hint.textContent='No hashtags: '+e.message})\n  .then(function(){el('tagBtn').disabled=false});\n}\nfunction applyTags(set){\n  // strip any trailing hashtag block, then append the chosen set\n  var cap=(S.copy.caption||'').replace(/(\\n\\s*)?(#[\\w\\u00c0-\\uffff]+[ \\t]*)+\\s*$/,'').trim();\n  S.copy.caption=(cap+'\\n\\n'+set.join(' ')).trim();\n  el('fCaption').value=S.copy.caption;updCount();saveDraft();haptic('selection');\n}\nfunction updCtaHint(){\n  var native=TEMPLATES[S.template].blocks.some(function(b){return b.pill||b.key==='cta'});\n  el('ctaHint').textContent=(S.copy.cta||'').trim()\n    ?((native?'Drawn as a button on this template — pick a style below.'\n             :'This template has no button spot, so it sits near the bottom.')+' Drag it on the preview to place it.')\n    :'The button is part of the picture — it can’t be tapped in a post. Put the destination in the Link field and it’s copied with your caption.';\n  el('ctaResetBtn').style.display=S.ctaPos?'block':'none';\n}\n/* caption as actually copied/shared: the Link field rides along at the end */\nfunction captionOut(){\n  var cap=(S.copy.caption||'').trim(),link=(S.copy.link||'').trim();\n  if(link)cap=(cap?cap+'\\n\\n':'')+'\\ud83d\\udd17 '+link;\n  return cap;\n}\nfunction fillWordFields(){\n  el('fHook').value=S.copy.hook||'';el('fSub').value=S.copy.sub||'';\n  el('fCta').value=S.copy.cta||'';el('fCaption').value=S.copy.caption||'';\n  el('fLink').value=S.copy.link||'';\n  el('tsize').value=Math.round((S.textScale||1)*100);\n  el('tpos').value=Math.round((S.textY||0)*100);updCount();updCtaHint();\n}\n\n/* ---------------- init ---------------- */\nbuildTabs();buildFormats();buildTones();buildGrads();buildEmoji();buildStyleControls();buildVideoControls();buildSafe();buildSplit();buildCaro();buildFeed();buildInk();buildType();buildEndCard();buildLight();buildBadgeCtl();renderBrand();fillWordFields();\nstore.getItem('socialstudio.brand').then(function(v){\n  if(v){try{var b=JSON.parse(v);if(b&&typeof b==='object')BRAND=Object.assign(BRAND,b);}catch(e){}}\n  if(BRAND.logo){var li=new Image();li.onload=function(){BRAND.logoImg=li;paint()};li.src=BRAND.logo;}\n  renderBrand();\n  return store.getItem('socialstudio.draft');\n}).then(function(v){\n  if(v){try{var d=JSON.parse(v);\n    if(d&&d.copy){S.format=FORMATS[d.format]?d.format:'square';S.template=TEMPLATES[d.template]?d.template:'promo';\n      S.bg=d.bg&&d.bg.type==='solid'&&d.bg.solid?{type:'solid',solid:d.bg.solid,grad:d.bg.grad||0}\n          :(d.bg&&typeof d.bg.grad==='number'?{type:'grad',grad:d.bg.grad,pal:d.bg.pal||null}:S.bg);\n      if(typeof d.textScale==='number')S.textScale=Math.min(1.5,Math.max(.6,d.textScale));\n      if(typeof d.textY==='number')S.textY=Math.min(.22,Math.max(-.22,d.textY));\n      if(d.ctaStyle)S.ctaStyle=d.ctaStyle;\n      S.ctaPos=(d.ctaPos&&typeof d.ctaPos.x==='number')?d.ctaPos:null;\n      if(d.gradDir)S.gradDir=d.gradDir; if(d.texture)S.texture=d.texture; if(d.plate)S.plate=d.plate;\n      S.vig=!!d.vig; if(d.scrimAdj)S.scrimAdj=+d.scrimAdj||1; if(d.frame)S.frame=d.frame;\n      S.copy=Object.assign(S.copy,d.copy);S.stickers=restoreStickers(d.stickers);\n      if(INKS[d.ink]||d.ink==='accent')S.ink=d.ink;\n      if(TYPES[d.type])S.type=d.type;\n      if(d.split)S.split=Math.max(1,Math.min(3,+d.split||1));\n      feedChrome=!!d.feed;\n      if(SAFE[d.safeZone])safeZone=d.safeZone;\n      S.video=normVideo(d.video);}\n  }catch(e){}}\n  buildFormats();buildGrads();buildStyleControls();buildVideoControls();fillWordFields();buildTemplates();buildSafe();buildSplit();buildCaro();buildFeed();buildInk();buildType();buildEndCard();buildLight();buildBadgeCtl();paint();\n  return store.getItem('socialstudio.library');\n}).then(function(v){\n  if(v)try{LIB=JSON.parse(v)||[]}catch(e){}\n  renderLibrary();\n});\ndocument.addEventListener('focusin',function(e){\n  var t=e.target;\n  if(t&&(t.tagName==='TEXTAREA'||(t.tagName==='INPUT'&&t.type!=='range'&&t.type!=='file')))kbOpen=true;\n});\ndocument.addEventListener('focusout',function(){\n  kbOpen=false;\n  // let the keyboard finish dismissing, then undo any page pan and re-fit\n  setTimeout(function(){if(!kbOpen){window.scrollTo(0,0);paint();}},250);\n});\nvar rzT=null;\nwindow.addEventListener('resize',function(){clearTimeout(rzT);rzT=setTimeout(paint,150);});\n</script>\n</body></html>\n"}