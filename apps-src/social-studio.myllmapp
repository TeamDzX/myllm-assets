{"name": "Social Studio", "kind": "html", "iconSymbol": "photo.on.rectangle.angled", "iconColor": "blue", "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Social Studio</title>\n<style>\n:root{\n  color-scheme:dark;\n  --bg:#101216;--deck:#181b21;--card:#20242c;--ink:#edeef2;--mut:#8d94a3;--line:#2b303a;\n  --ac:#4f8df9;--ac-soft:rgba(79,141,249,.16);--danger:#d07a63;\n}\n*{box-sizing:border-box;margin:0}\nhtml,body{height:100%}\nbody{font-family:-apple-system,system-ui,sans-serif;background:var(--bg);color:var(--ink);\n  display:flex;flex-direction:column;height:100dvh;overflow:hidden;-webkit-tap-highlight-color:transparent;\n  position:fixed;inset:0;width:100%}\n/* top bar */\n.top{display:flex;align-items:center;gap:10px;padding:calc(10px + env(safe-area-inset-top)) 16px 10px}\n.top .logo{font-weight:800;font-size:17px;letter-spacing:-.01em}\n.top .logo span{color:var(--ac)}\n.top .sp{flex:1}\n.top button{border:0;border-radius:12px;background:var(--ac);color:#fff;font-weight:700;font-size:14px;\n  padding:9px 16px;display:flex;align-items:center;gap:7px}\n.top button svg{width:16px;height:16px}\n/* preview */\n#stage{flex:1;display:flex;align-items:center;justify-content:center;min-height:0;padding:4px 14px 10px;position:relative;overflow:hidden}\n#pv{border-radius:14px;box-shadow:0 14px 44px -12px rgba(0,0,0,.7);flex:0 0 auto;touch-action:none}\n#stageHint{position:absolute;bottom:14px;left:0;right:0;text-align:center;font-size:11.5px;color:var(--mut);pointer-events:none;opacity:.85}\n/* deck */\n.deck{background:var(--deck);border-top:1px solid var(--line);border-radius:20px 20px 0 0;\n  padding-bottom:env(safe-area-inset-bottom);flex:0 0 auto}\n.tabs{display:flex;gap:4px;padding:10px 12px 4px;overflow-x:auto;scrollbar-width:none}\n.tabs::-webkit-scrollbar{display:none}\n.tabs button{flex:1;border:0;background:none;color:var(--mut);font-size:12px;font-weight:650;\n  padding:8px 2px 9px;border-radius:11px;display:flex;flex-direction:column;align-items:center;gap:4px;white-space:nowrap}\n.tabs button svg{width:20px;height:20px}\n.tabs button.on{color:var(--ac);background:var(--ac-soft)}\n.panel{display:none;height:216px;overflow-y:auto;padding:10px 16px 16px;overscroll-behavior:contain}\n.panel.on{display:block}\n.lbl{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--mut);margin:12px 0 7px}\n.lbl:first-child{margin-top:2px}\n/* generic controls */\n.chips{display:flex;gap:7px;flex-wrap:wrap}\n.chip{border:1.5px solid var(--line);background:none;color:var(--mut);border-radius:999px;padding:8px 14px;font-size:13px;font-weight:600}\n.chip.on{color:var(--ac);border-color:var(--ac)}\ninput[type=text],textarea{width:100%;padding:11px 12px;border:1px solid var(--line);border-radius:12px;\n  background:var(--card);color:var(--ink);font-size:15px;outline:none}\ntextarea{resize:none;min-height:56px;line-height:1.4}\n.row{display:flex;gap:8px;align-items:center}\n.btn{border:0;border-radius:12px;background:var(--ac);color:#fff;font-weight:700;font-size:14px;padding:11px 16px}\n.btn.ghost{background:var(--ac-soft);color:var(--ac)}\n.btn.line{background:none;border:1.5px solid var(--line);color:var(--mut);font-weight:600}\n.btn:disabled{opacity:.4}\n.hint{font-size:12px;color:var(--mut);margin-top:8px;line-height:1.45;min-height:16px}\n/* template grid */\n.tgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}\n.tcell{border:2px solid transparent;border-radius:12px;overflow:hidden;padding:0;background:var(--card);position:relative}\n.tcell.on{border-color:var(--ac)}\n.tcell canvas{width:100%;display:block}\n.tcell span{position:absolute;left:0;right:0;bottom:0;font-size:9.5px;font-weight:700;color:#fff;\n  padding:8px 4px 3px;background:linear-gradient(transparent,rgba(0,0,0,.75));text-align:center}\n/* gradient swatches */\n.grads{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}\n.grad{aspect-ratio:1;border-radius:10px;border:2px solid transparent;padding:0}\n.grad.on{border-color:#fff}\n/* emoji grid */\n.egrid{display:grid;grid-template-columns:repeat(8,1fr);gap:2px}\n.egrid button{border:0;background:none;font-size:24px;padding:6px 0;border-radius:8px}\n/* colour dots */\n.dots{display:flex;gap:8px;flex-wrap:wrap}\n.dot{width:30px;height:30px;border-radius:50%;border:2.5px solid transparent;padding:0}\n.dot.on{border-color:#fff}\n/* slider */\ninput[type=range]{width:100%;accent-color:var(--ac)}\n/* toggle */\n.tog{display:flex;align-items:center;justify-content:space-between;padding:4px 0}\n.tog small{color:var(--mut);font-size:12px;display:block;margin-top:2px}\n.sw{width:46px;height:28px;border-radius:999px;background:var(--line);border:0;position:relative;flex:0 0 auto;transition:background .2s}\n.sw i{position:absolute;top:3px;left:3px;width:22px;height:22px;border-radius:50%;background:#fff;transition:left .2s}\n.sw.on{background:var(--ac)}\n.sw.on i{left:21px}\n/* sheet */\n.scrim{position:fixed;inset:0;background:rgba(4,6,10,.62);display:none;align-items:flex-end;z-index:70}\n.scrim.on{display:flex}\n.sheet{background:var(--deck);border-radius:20px 20px 0 0;width:100%;max-height:88dvh;overflow-y:auto;overscroll-behavior:contain;\n  padding:20px 18px calc(24px + env(safe-area-inset-bottom));display:flex;flex-direction:column;gap:11px}\n.sheet h3{font-size:17px}\n.sheet img{width:62%;align-self:center;border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,.5)}\n.sheet .ok{color:#6cc296;font-size:13.5px;font-weight:600}\n/* posts library */\n.pgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:10px}\n.pcard2{position:relative;border:1.5px solid var(--line);border-radius:12px;overflow:hidden;background:var(--card);padding:0;cursor:pointer}\n.pcard2 img{width:100%;display:block}\n.pcard2 .pn{position:absolute;left:0;right:0;bottom:0;font-size:9px;font-weight:700;color:#fff;padding:10px 4px 3px;background:linear-gradient(transparent,rgba(0,0,0,.8));text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.pact{position:absolute;top:4px;width:22px;height:22px;border:0;border-radius:7px;background:rgba(10,14,22,.8);color:#fff;font-size:11px;line-height:1;padding:0}\n.pdup{left:4px}\n.pdel{right:4px;color:#ff6b60}\n.pdel.armed{width:auto;padding:0 7px;font-weight:700;background:#8c2a20;color:#fff}\n@media(prefers-reduced-motion:no-preference){\n  .panel.on{animation:pi .25s ease}\n  @keyframes pi{from{opacity:0;transform:translateY(6px)}to{opacity:1}}\n}\n</style></head><body>\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;top:calc(14px + env(safe-area-inset-top));transform:translateX(-50%) translateY(-16px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-family:-apple-system,system-ui,sans-serif;font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;line-height:1;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\">⚙️</span><span>AI is working… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n\n<div class=\"top\">\n  <div class=\"logo\">Social <span>Studio</span></div>\n  <div class=\"sp\"></div>\n  <button onclick=\"doExport()\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3v12M7.5 10.5L12 15l4.5-4.5\"/><path d=\"M4 17v2.5A1.5 1.5 0 0 0 5.5 21h13a1.5 1.5 0 0 0 1.5-1.5V17\"/></svg>Save</button>\n</div>\n\n<div id=\"stage\"><canvas id=\"pv\"></canvas><div id=\"stageHint\"></div></div>\n\n<div class=\"deck\">\n  <div class=\"tabs\" id=\"tabs\"></div>\n\n  <div class=\"panel on\" id=\"p-layout\">\n    <div class=\"lbl\">Format</div>\n    <div class=\"chips\" id=\"fmtChips\"></div>\n    <div class=\"lbl\">Template</div>\n    <div class=\"tgrid\" id=\"tgrid\"></div>\n  </div>\n\n  <div class=\"panel\" id=\"p-words\">\n    <div class=\"lbl\">What's the post about?</div>\n    <input type=\"text\" id=\"topic\" maxlength=\"120\" placeholder=\"e.g. weekend sale on houseplants\">\n    <div class=\"lbl\">Tone</div>\n    <div class=\"chips\" id=\"toneChips\"></div>\n    <div style=\"height:10px\"></div>\n    <button class=\"btn\" id=\"designBtn\" onclick=\"designMe()\" style=\"width:100%;background:linear-gradient(135deg,#7d5cff,#e05c8a)\">✨ Design it for me</button>\n    <div style=\"height:8px\"></div>\n    <button class=\"btn ghost\" id=\"writeBtn\" onclick=\"writeCopy()\" style=\"width:100%\">Write the words only</button>\n    <p class=\"hint\" id=\"wordsHint\"></p>\n    <div class=\"lbl\">Headline</div>\n    <input type=\"text\" id=\"fHook\" maxlength=\"60\" oninput=\"S.copy.hook=this.value;paint()\">\n    <div class=\"lbl\">Supporting line</div>\n    <input type=\"text\" id=\"fSub\" maxlength=\"110\" oninput=\"S.copy.sub=this.value;paint()\">\n    <div class=\"lbl\">Button / call to action</div>\n    <input type=\"text\" id=\"fCta\" maxlength=\"30\" oninput=\"S.copy.cta=this.value;paint()\">\n    <div class=\"lbl\">Word size</div>\n    <input type=\"range\" id=\"tsize\" min=\"60\" max=\"150\" value=\"100\" oninput=\"S.textScale=this.value/100;paint();saveDraft()\">\n    <div class=\"lbl\">Caption &amp; hashtags — copied when you save</div>\n    <textarea id=\"fCaption\" rows=\"3\" oninput=\"S.copy.caption=this.value;updCount()\"></textarea>\n    <div class=\"row\" style=\"margin-top:6px;align-items:center\">\n      <button class=\"btn ghost\" style=\"flex:1\" id=\"tagBtn\" onclick=\"suggestTags()\"># Suggest hashtags</button>\n      <span id=\"capCount\" style=\"font-size:11px;color:var(--mut);white-space:nowrap\"></span>\n    </div>\n    <div class=\"chips\" id=\"tagSets\" style=\"margin-top:6px\"></div>\n  </div>\n\n  <div class=\"panel\" id=\"p-style\">\n    <div class=\"lbl\">Background</div>\n    <div class=\"row\">\n      <button class=\"btn ghost\" style=\"flex:1\" onclick=\"pickPhoto()\">Use a photo</button>\n      <button class=\"btn ghost\" style=\"flex:1\" id=\"aiBgBtn\" onclick=\"aiBackground()\">AI background</button>\n    </div>\n    <input type=\"file\" id=\"photoIn\" accept=\"image/*\" style=\"display:none\" onchange=\"loadPhoto(this)\">\n    <p class=\"hint\" id=\"styleHint\"></p>\n    <div id=\"photoCtl\" style=\"display:none\">\n      <div class=\"lbl\">Filter</div>\n      <div class=\"chips\" id=\"filterRow\" style=\"display:none\"></div>\n      <div class=\"lbl\">Photo zoom — drag to move, pinch to zoom</div>\n      <input type=\"range\" id=\"pzoom\" min=\"100\" max=\"400\" value=\"100\" oninput=\"S.photoPos.scale=this.value/100;paint()\">\n      <div style=\"height:8px\"></div>\n      <button class=\"btn line\" onclick=\"clearPhoto()\" style=\"width:100%\">Remove photo</button>\n    </div>\n    <div class=\"lbl\">Gradients</div>\n    <div class=\"grads\" id=\"grads\"></div>\n  </div>\n\n  <div class=\"panel\" id=\"p-stickers\">\n    <div class=\"lbl\">Tap to add — then drag on the preview</div>\n    <div class=\"egrid\" id=\"egrid\"></div>\n    <div class=\"row\" style=\"margin-top:8px\">\n      <input type=\"text\" id=\"anyEmoji\" maxlength=\"4\" placeholder=\"Any emoji…\" style=\"flex:1\">\n      <button class=\"btn ghost\" onclick=\"addAnyEmoji()\">Add</button>\n    </div>\n    <div class=\"lbl\">Banner badge</div>\n    <div class=\"row\">\n      <input type=\"text\" id=\"banText\" maxlength=\"12\" placeholder=\"SALE\" style=\"flex:1\">\n      <button class=\"btn ghost\" onclick=\"addBanner()\">Add</button>\n    </div>\n    <div id=\"selCtl\" style=\"display:none\">\n      <div class=\"lbl\">Selected sticker</div>\n      <input type=\"range\" id=\"ssize\" min=\"24\" max=\"200\" oninput=\"if(sel){sel.size=+this.value;paint()}\">\n      <div style=\"height:8px\"></div>\n      <button class=\"btn line\" style=\"width:100%;border-color:var(--danger);color:var(--danger)\" onclick=\"deleteSel()\">Remove sticker</button>\n    </div>\n  </div>\n\n  <div class=\"panel\" id=\"p-brand\">\n    <div class=\"lbl\">Your handle — shown on every post</div>\n    <input type=\"text\" id=\"bHandle\" maxlength=\"30\" placeholder=\"@yourname\" oninput=\"BRAND.handle=this.value;saveBrand();paint()\">\n    <div class=\"lbl\">Accent colour</div>\n    <div class=\"dots\" id=\"bDots\"></div>\n    <div class=\"lbl\">Watermark</div>\n    <div class=\"tog\"><div>Made with Social Studio<small>A little corner credit on exports</small></div>\n      <button class=\"sw\" id=\"wmSw\" onclick=\"BRAND.wm=!BRAND.wm;saveBrand();renderBrand();paint()\"><i></i></button></div>\n    <div class=\"lbl\">Logo — shown on every post</div>\n    <div class=\"row\">\n      <button class=\"btn ghost\" style=\"flex:1\" onclick=\"pickLogo()\">Add logo</button>\n      <button class=\"btn line\" id=\"logoRm\" style=\"display:none\" onclick=\"removeLogo()\">Remove</button>\n    </div>\n    <input type=\"file\" id=\"logoIn\" accept=\"image/*\" style=\"display:none\" onchange=\"loadLogoFile(this)\">\n    <div id=\"logoCtl\" style=\"display:none\">\n      <div class=\"lbl\">Corner</div>\n      <div class=\"chips\" id=\"logoPosRow\"></div>\n      <div class=\"lbl\">Logo size</div>\n      <input type=\"range\" id=\"logoSizeR\" min=\"6\" max=\"20\" value=\"12\" oninput=\"BRAND.logoSize=this.value/100;saveBrand();paint()\">\n    </div>\n  </div>\n\n  <div class=\"panel\" id=\"p-posts\">\n    <button class=\"btn ghost\" style=\"width:100%\" onclick=\"savePost()\">＋ Save current post to library</button>\n    <p class=\"hint\" id=\"libHint\"></p>\n    <div class=\"pgrid\" id=\"libGrid\"></div>\n  </div>\n</div>\n\n<div class=\"scrim\" id=\"scrim\" onclick=\"if(event.target===this)el('scrim').classList.remove('on')\">\n  <div class=\"sheet\" id=\"sheet\"></div>\n</div>\n\n<script>\n\"use strict\";\nvar store = window.myllmStorage || {\n  getItem:function(k){ try{return Promise.resolve(localStorage.getItem(k));}catch(e){return Promise.resolve(null);} },\n  setItem:function(k,v){ try{localStorage.setItem(k,v);}catch(e){} return Promise.resolve(); }\n};\nfunction el(i){ return document.getElementById(i); }\nfunction haptic(k){ if(window.myllmHaptic) try{ myllmHaptic(k||'light'); }catch(e){} }\n\n/* ---------------- model ---------------- */\nvar FORMATS = { square:{w:1080,h:1080,name:\"1:1\"}, portrait:{w:1080,h:1350,name:\"4:5\"}, story:{w:1080,h:1920,name:\"9:16\"} };\nvar GRADS = [[\"#1b2a4a\",\"#4f8df9\"],[\"#2d1b4a\",\"#b06df9\"],[\"#0f3d3a\",\"#2fbf9b\"],[\"#4a1b2d\",\"#f9646c\"],\n             [\"#4a3a1b\",\"#f9b64f\"],[\"#1b1d22\",\"#5b6472\"],[\"#0e2233\",\"#3fa7d6\"],[\"#331b3d\",\"#e05c8a\"],\n             [\"#12331e\",\"#6cc267\"],[\"#33270e\",\"#d69a3f\"],[\"#101010\",\"#3c3c44\"],[\"#26123d\",\"#7d5cff\"]];\nvar TONES = [\"Playful\",\"Premium\",\"Bold\",\"Minimal\"];\nvar EMOJI = \"🔥✨🎉💥⭐️❤️💙💚🖤🙌👏💪🚀🌈☀️🌙🌸🌿🍕☕️🍰🥂🎁🏷️📣📸🎵🏆✅➡️💡🛍️🎯🕐📍🌍😄😍🤩😎🥳🤍💫🫶🍂❄️🌊\".match(/./gu).filter(function(c){return c.trim();});\n\n/* template text layout: blocks positioned in fractions of canvas */\nvar TEMPLATES = {\n  quote:   { name:\"Quote\",   scrim:.45, blocks:[\n      {key:\"hook\", font:\"600 %fpx ui-serif, Georgia, serif\", size:.085, y:.42, maxLines:4, quote:true},\n      {key:\"sub\",  font:\"500 %fpx -apple-system, sans-serif\", size:.031, y:.68, maxLines:1, caps:true}]},\n  promo:   { name:\"Promo\",   scrim:.5, blocks:[\n      {key:\"hook\", font:\"800 %fpx -apple-system, sans-serif\", size:.093, y:.45, maxLines:3},\n      {key:\"sub\",  font:\"500 %fpx -apple-system, sans-serif\", size:.036, y:.63, maxLines:2},\n      {key:\"cta\",  pill:true, size:.034, y:.76}]},\n  announce:{ name:\"Announce\",scrim:.42, rule:true, blocks:[\n      {key:\"sub\",  font:\"600 %fpx -apple-system, sans-serif\", size:.03,  y:.34, maxLines:1, caps:true},\n      {key:\"hook\", font:\"750 %fpx ui-serif, Georgia, serif\",  size:.082, y:.5,  maxLines:3},\n      {key:\"cta\",  font:\"600 %fpx -apple-system, sans-serif\", size:.031, y:.68, maxLines:1}]},\n  tips:    { name:\"Tip list\",scrim:.55, blocks:[\n      {key:\"hook\", font:\"800 %fpx -apple-system, sans-serif\", size:.062, y:.2, maxLines:2},\n      {key:\"sub\",  font:\"500 %fpx -apple-system, sans-serif\", size:.037, y:.5, maxLines:6, list:true}]},\n  photocap:{ name:\"Caption\", scrim:0, band:.3, blocks:[\n      {key:\"hook\", font:\"700 %fpx -apple-system, sans-serif\", size:.05,  y:.84, maxLines:2},\n      {key:\"sub\",  font:\"400 %fpx -apple-system, sans-serif\", size:.03,  y:.93, maxLines:1}]},\n  bold:    { name:\"Bold\",    scrim:.25, blocks:[\n      {key:\"hook\", font:\"850 %fpx -apple-system, sans-serif\", size:.135, y:.5, maxLines:4, caps:true}]}\n};\n\nvar S = {\n  format:\"square\", template:\"promo\", textScale:1,\n  bg:{ type:\"grad\", grad:0, aiUrl:null },\n  photo:null, photoPos:{x:0,y:0,scale:1},\n  copy:{ hook:\"Weekend plant sale\", sub:\"Every leafy friend 20% off, Saturday only\", cta:\"Visit us\", caption:\"\", tone:\"Playful\" },\n  stickers:[]   // {kind:'emoji'|'banner', txt, x,y (0..1), size(px @1080)}\n};\nvar BRAND = { handle:\"\", accent:\"#4f8df9\", wm:true, logo:null, logoPos:\"tr\", logoSize:0.12, logoImg:null };\nvar sel = null;\n\n/* ---------------- canvas engine ---------------- */\nfunction roundRect(ctx,x,y,w,h,r){ctx.beginPath();ctx.moveTo(x+r,y);ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath();}\nfunction wrap(ctx,text,maxW,maxLines){\n  var words=String(text||\"\").split(/\\s+/).filter(Boolean),lines=[],cur=\"\";\n  words.forEach(function(w){\n    var t=cur?cur+\" \"+w:w;\n    if(ctx.measureText(t).width<=maxW||!cur){cur=t;}else{lines.push(cur);cur=w;}\n  });\n  if(cur)lines.push(cur);\n  if(lines.length>maxLines){lines=lines.slice(0,maxLines);lines[maxLines-1]=lines[maxLines-1].replace(/\\s*\\S*$/,\"…\");}\n  return lines;\n}\nfunction render(cv,W,H,forExport){\n  cv.width=W;cv.height=H;\n  var x=cv.getContext(\"2d\"),T=TEMPLATES[S.template];\n  /* background */\n  if(S.photo&&S.bg.type===\"photo\"){\n    var im=S.photoDraw||S.photo,sc=Math.max(W/im.width,H/im.height)*S.photoPos.scale;\n    var dw=im.width*sc,dh=im.height*sc;\n    var dx=(W-dw)/2+S.photoPos.x*W,dy=(H-dh)/2+S.photoPos.y*H;\n    dx=Math.min(0,Math.max(W-dw,dx));dy=Math.min(0,Math.max(H-dh,dy));\n    x.drawImage(im,dx,dy,dw,dh);\n  } else if(S.bg.type===\"ai\"&&S.bg.aiImg){\n    var a=S.bg.aiImg,s2=Math.max(W/a.width,H/a.height);\n    x.drawImage(a,(W-a.width*s2)/2,(H-a.height*s2)/2,a.width*s2,a.height*s2);\n  } else {\n    var g=x.createLinearGradient(0,0,W*.7,H);\n    g.addColorStop(0,GRADS[S.bg.grad][0]);g.addColorStop(1,GRADS[S.bg.grad][1]);\n    x.fillStyle=g;x.fillRect(0,0,W,H);\n  }\n  /* scrim / band */\n  if(T.band){var bg2=x.createLinearGradient(0,H*(1-T.band-.12),0,H);bg2.addColorStop(0,\"rgba(0,0,0,0)\");bg2.addColorStop(.45,\"rgba(0,0,0,.62)\");bg2.addColorStop(1,\"rgba(0,0,0,.78)\");x.fillStyle=bg2;x.fillRect(0,H*(1-T.band-.12),W,H*(T.band+.12));}\n  else if(T.scrim){x.fillStyle=\"rgba(8,10,16,\"+T.scrim+\")\";x.fillRect(0,0,W,H);}\n  /* rule lines (announce) */\n  if(T.rule){x.strokeStyle=\"rgba(255,255,255,.65)\";x.lineWidth=W*.0035;\n    x.beginPath();x.moveTo(W*.3,H*.28);x.lineTo(W*.7,H*.28);x.stroke();\n    x.beginPath();x.moveTo(W*.3,H*.74);x.lineTo(W*.7,H*.74);x.stroke();}\n  /* text blocks */\n  T.blocks.forEach(function(b){\n    var val=S.copy[b.key]||\"\";if(!val)return;\n    if(b.list){\n      var items=val.split(/\\n|(?:^|\\s)[•·-]\\s+/).map(function(s){return s.trim();}).filter(Boolean).slice(0,6);\n      var fs=H*b.size*(S.textScale||1);x.font=b.font.replace(\"%f\",fs);x.textAlign=\"left\";x.textBaseline=\"middle\";x.fillStyle=\"#fff\";\n      var y0=H*.32,gap=fs*1.9;\n      items.forEach(function(it,i){\n        x.fillStyle=BRAND.accent;x.beginPath();x.arc(W*.12,y0+i*gap,fs*.22,0,7);x.fill();\n        x.fillStyle=\"#fff\";\n        var ln=wrap(x,it,W*.72,1);x.fillText(ln[0]||\"\",W*.12+fs*.8,y0+i*gap);\n      });\n      return;\n    }\n    if(b.pill){\n      var fs2=H*b.size*(S.textScale||1);x.font=\"700 \"+fs2+\"px -apple-system, sans-serif\";\n      var tw=x.measureText(val).width,pw=tw+fs2*2.2,ph=fs2*2.1;\n      x.fillStyle=BRAND.accent;roundRect(x,(W-pw)/2,H*b.y-ph/2,pw,ph,ph/2);x.fill();\n      x.fillStyle=\"#fff\";x.textAlign=\"center\";x.textBaseline=\"middle\";x.fillText(val,W/2,H*b.y+fs2*.06);\n      return;\n    }\n    var t=b.caps?val.toUpperCase():val;\n    if(b.quote)t=\"“\"+t+\"”\";\n    var fs3=H*b.size*(S.textScale||1);x.font=b.font.replace(\"%f\",fs3);\n    x.textAlign=\"center\";x.textBaseline=\"middle\";\n    var lines=wrap(x,t,W*.82,b.maxLines||2),lh=fs3*1.18;\n    x.shadowColor=\"rgba(0,0,0,.45)\";x.shadowBlur=fs3*.25;\n    x.fillStyle=\"#fff\";\n    lines.forEach(function(ln,i){x.fillText(ln,W/2,H*b.y+(i-(lines.length-1)/2)*lh);});\n    x.shadowBlur=0;\n    if(b.caps&&b.key===\"sub\"){x.fillStyle=BRAND.accent;x.fillRect(W/2-W*.045,H*b.y+fs3*1.1,W*.09,H*.004);}\n  });\n  /* stickers */\n  S.stickers.forEach(function(st){\n    var px2=st.x*W,py=st.y*H,fs=st.size*(W/1080);\n    if(st.kind===\"emoji\"){\n      x.font=fs+\"px -apple-system\";x.textAlign=\"center\";x.textBaseline=\"middle\";\n      x.fillText(st.txt,px2,py);\n    } else {\n      x.font=\"800 \"+fs*.42+\"px -apple-system, sans-serif\";\n      var tw2=x.measureText(st.txt).width,bw=tw2+fs*.55,bh=fs*.72;\n      x.save();x.translate(px2,py);x.rotate(-.06);\n      x.fillStyle=BRAND.accent;roundRect(x,-bw/2,-bh/2,bw,bh,bh*.24);x.fill();\n      x.fillStyle=\"#fff\";x.textAlign=\"center\";x.textBaseline=\"middle\";x.fillText(st.txt,0,fs*.02);\n      x.restore();\n    }\n    if(!forExport&&st===sel){\n      x.strokeStyle=\"#4f8df9\";x.lineWidth=3;x.setLineDash([8,6]);\n      var r=st.kind===\"emoji\"?fs*.62:fs*.62;\n      roundRect(x,px2-r,py-r*.72,r*2,r*1.44,10);x.stroke();x.setLineDash([]);\n    }\n  });\n  /* brand + watermark */\n  if(BRAND.handle){\n    x.font=\"650 \"+H*.021+\"px -apple-system, sans-serif\";x.textAlign=\"left\";x.textBaseline=\"alphabetic\";\n    x.fillStyle=\"rgba(255,255,255,.92)\";x.fillText(BRAND.handle,W*.05,H*.955);\n  }\n  if(BRAND.wm){\n    x.font=\"500 \"+H*.016+\"px -apple-system, sans-serif\";x.textAlign=\"right\";\n    x.fillStyle=\"rgba(255,255,255,.4)\";x.fillText(\"Made with Social Studio\",W*.95,H*.958);\n  }\n  if(BRAND.logoImg&&BRAND.logoImg.naturalWidth){\n    var lw=W*(BRAND.logoSize||0.12),lh=lw*BRAND.logoImg.naturalHeight/BRAND.logoImg.naturalWidth,lm=W*0.045;\n    var lp=BRAND.logoPos||'tr';\n    var lx=lp.indexOf('l')>=0?lm:W-lm-lw;\n    var ly=lp.charAt(0)==='t'?lm:H-lm-lh;\n    x.save();x.shadowColor='rgba(0,0,0,.4)';x.shadowBlur=W*0.012;\n    x.drawImage(BRAND.logoImg,lx,ly,lw,lh);x.restore();\n  }\n}\n\n/* preview — while the keyboard is up the stage box is frozen so the canvas\n   doesn't thrash through resizes on every viewport change */\nvar kbOpen=false,stageBox=null;\nfunction paint(){\n  var f=FORMATS[S.format],stage=el('stage');\n  if(!kbOpen||!stageBox)stageBox={w:stage.clientWidth-28,h:stage.clientHeight-26};\n  var maxW=stageBox.w,maxH=stageBox.h;\n  var sc=Math.min(maxW/f.w,maxH/f.h),dpr=Math.min(window.devicePixelRatio||1,2);\n  var cv=el('pv');\n  render(cv,Math.round(f.w*sc*dpr),Math.round(f.h*sc*dpr),false);\n  cv.style.width=Math.round(f.w*sc)+\"px\";cv.style.height=Math.round(f.h*sc)+\"px\";\n  el('stageHint').textContent = S.stickers.length? \"drag stickers to place them\" : (S.photo&&S.bg.type===\"photo\"? \"drag to move · pinch to zoom\":\"\");\n}\n\n/* ---------------- pointer drag ---------------- */\n(function(){\n  var cv=el('pv'),drag=null,pts={},pinch=null;\n  function pos(e){var r=cv.getBoundingClientRect();return {x:(e.clientX-r.left)/r.width,y:(e.clientY-r.top)/r.height};}\n  function count(){return Object.keys(pts).length;}\n  function dist(a,b){var dx=a.x-b.x,dy=a.y-b.y;return Math.sqrt(dx*dx+dy*dy);}\n  function twoPts(){var k=Object.keys(pts);return k.length>=2?[pts[k[0]],pts[k[1]]]:null;}\n  function setZoom(s){S.photoPos.scale=Math.min(4,Math.max(1,s));el('pzoom').value=Math.round(S.photoPos.scale*100);}\n  var photoBg=function(){return S.photo&&S.bg.type===\"photo\";};\n  cv.addEventListener(\"pointerdown\",function(e){\n    pts[e.pointerId]={x:e.clientX,y:e.clientY};\n    // A second finger on a photo background starts a pinch-zoom.\n    if(count()>=2&&photoBg()){var t=twoPts();drag=null;pinch={d0:dist(t[0],t[1])||1,s0:S.photoPos.scale};haptic('selection');return;}\n    var p=pos(e),f=FORMATS[S.format];\n    for(var i=S.stickers.length-1;i>=0;i--){\n      var st=S.stickers[i],rx=(st.size*(1/1080))*.75,ry=rx*(f.w/f.h);\n      if(Math.abs(p.x-st.x)<rx&&Math.abs(p.y-st.y)<ry){\n        sel=st;S.stickers.splice(i,1);S.stickers.push(st);\n        el('selCtl').style.display='block';el('ssize').value=st.size;\n        drag={kind:\"st\",st:st,dx:p.x-st.x,dy:p.y-st.y};\n        cv.setPointerCapture(e.pointerId);paint();haptic('selection');return;\n      }\n    }\n    if(sel){sel=null;el('selCtl').style.display='none';paint();}\n    if(photoBg()){drag={kind:\"photo\",px:p.x,py:p.y,ox:S.photoPos.x,oy:S.photoPos.y};cv.setPointerCapture(e.pointerId);}\n  });\n  cv.addEventListener(\"pointermove\",function(e){\n    if(pts[e.pointerId])pts[e.pointerId]={x:e.clientX,y:e.clientY};\n    if(pinch){var t=twoPts();if(t){setZoom(pinch.s0*(dist(t[0],t[1])/pinch.d0));paint();}return;}\n    if(!drag)return;var p=pos(e);\n    if(drag.kind===\"st\"){drag.st.x=Math.min(.98,Math.max(.02,p.x-drag.dx));drag.st.y=Math.min(.98,Math.max(.02,p.y-drag.dy));}\n    else {S.photoPos.x=drag.ox+(p.x-drag.px);S.photoPos.y=drag.oy+(p.y-drag.py);}\n    paint();\n  });\n  [\"pointerup\",\"pointercancel\"].forEach(function(ev){cv.addEventListener(ev,function(e){\n    delete pts[e.pointerId];\n    if(count()<2)pinch=null;\n    if(count()===0){drag=null;saveDraft();}\n  });});\n})();\n\n/* ---------------- panels ---------------- */\nvar TABS=[[\"layout\",\"Layout\",\"M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5zM4 10h16M10 10v10\"],\n [\"words\",\"Words\",\"M5 7h14M5 12h14M5 17h9\"],\n [\"style\",\"Style\",\"M12 3a9 9 0 1 0 0 18c1.2 0 2-.9 2-2 0-.6-.25-1.1-.6-1.5-.35-.4-.6-.9-.6-1.5a2 2 0 0 1 2-2h2.3A3.9 3.9 0 0 0 21 12c0-5-4-9-9-9zM7.5 10.5h.01M10.5 6.5h.01M15.5 6.5h.01\"],\n [\"stickers\",\"Stickers\",\"M12 3a9 9 0 1 0 9 9c0-.5 0-1-.14-1.5H12z M8.8 10.2h.01M14 14.5c-.6.7-1.4 1-2 1s-1.4-.3-2-1\"],\n [\"brand\",\"Brand\",\"M4 8l8-5 8 5v8l-8 5-8-5zM12 3v18\"],\n [\"posts\",\"Posts\",\"M4 6.5A1.5 1.5 0 0 1 5.5 5H9l2 2h7.5A1.5 1.5 0 0 1 20 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 17.5z\"]];\nfunction buildTabs(){\n  var t=el('tabs');t.innerHTML='';\n  TABS.forEach(function(tb,i){\n    var b=document.createElement('button');b.className=i===0?'on':'';\n    b.innerHTML='<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"'+tb[2]+'\"/></svg>'+tb[1];\n    b.onclick=function(){\n      document.querySelectorAll('.tabs button').forEach(function(x){x.classList.remove('on');});\n      document.querySelectorAll('.panel').forEach(function(x){x.classList.remove('on');});\n      b.classList.add('on');el('p-'+tb[0]).classList.add('on');if(tb[0]==='posts')renderLibrary();haptic('selection');\n    };\n    t.appendChild(b);\n  });\n}\nfunction buildFormats(){\n  var c=el('fmtChips');c.innerHTML='';\n  Object.keys(FORMATS).forEach(function(k){\n    var b=document.createElement('button');b.className='chip'+(k===S.format?' on':'');b.textContent=FORMATS[k].name;\n    b.onclick=function(){S.format=k;buildFormats();buildTemplates();paint();saveDraft();haptic('selection');};\n    c.appendChild(b);\n  });\n}\nfunction buildTemplates(){\n  var g=el('tgrid');g.innerHTML='';\n  Object.keys(TEMPLATES).forEach(function(k){\n    var cell=document.createElement('button');cell.className='tcell'+(k===S.template?' on':'');\n    var cv=document.createElement('canvas'),f=FORMATS[S.format];\n    var old=S.template;S.template=k;\n    render(cv,150,Math.round(150*f.h/f.w),true);\n    S.template=old;\n    cell.appendChild(cv);\n    var sp=document.createElement('span');sp.textContent=TEMPLATES[k].name;cell.appendChild(sp);\n    cell.onclick=function(){S.template=k;buildTemplates();paint();saveDraft();haptic('selection');};\n    g.appendChild(cell);\n  });\n}\nfunction buildTones(){\n  var c=el('toneChips');c.innerHTML='';\n  TONES.forEach(function(t){\n    var b=document.createElement('button');b.className='chip'+(t===S.copy.tone?' on':'');b.textContent=t;\n    b.onclick=function(){S.copy.tone=t;buildTones();haptic('selection');};\n    c.appendChild(b);\n  });\n}\nfunction buildGrads(){\n  var g=el('grads');g.innerHTML='';\n  GRADS.forEach(function(gr,i){\n    var b=document.createElement('button');b.className='grad'+(S.bg.type==='grad'&&S.bg.grad===i?' on':'');\n    b.style.background='linear-gradient(135deg,'+gr[0]+','+gr[1]+')';\n    b.onclick=function(){S.bg={type:'grad',grad:i,aiUrl:null};buildGrads();refreshStyle();paint();saveDraft();haptic('selection');};\n    g.appendChild(b);\n  });\n}\nfunction buildEmoji(){\n  var g=el('egrid');g.innerHTML='';\n  EMOJI.slice(0,48).forEach(function(ch){\n    var b=document.createElement('button');b.textContent=ch;\n    b.onclick=function(){addSticker('emoji',ch);};\n    g.appendChild(b);\n  });\n}\nvar ACCENTS=[\"#4f8df9\",\"#7d5cff\",\"#e05c8a\",\"#f9646c\",\"#f9b64f\",\"#2fbf9b\",\"#6cc267\",\"#3fa7d6\",\"#ffffff\",\"#111318\"];\nfunction renderBrand(){\n  el('bHandle').value=BRAND.handle;\n  var d=el('bDots');d.innerHTML='';\n  ACCENTS.forEach(function(c){\n    var b=document.createElement('button');b.className='dot'+(c===BRAND.accent?' on':'');b.style.background=c;\n    b.onclick=function(){BRAND.accent=c;saveBrand();renderBrand();paint();haptic('selection');};\n    d.appendChild(b);\n  });\n  el('wmSw').classList.toggle('on',!!BRAND.wm);\n  var has=!!BRAND.logo;\n  el('logoRm').style.display=has?'block':'none';\n  el('logoCtl').style.display=has?'block':'none';\n  if(has){\n    el('logoSizeR').value=Math.round((BRAND.logoSize||0.12)*100);\n    var pr=el('logoPosRow');pr.innerHTML='';\n    [['tl','Top left'],['tr','Top right'],['bl','Bottom left'],['br','Bottom right']].forEach(function(p){\n      var b=document.createElement('button');b.className='chip'+((BRAND.logoPos||'tr')===p[0]?' on':'');b.textContent=p[1];\n      b.onclick=function(){BRAND.logoPos=p[0];saveBrand();renderBrand();paint();haptic('selection')};\n      pr.appendChild(b);\n    });\n  }\n}\n\n/* ---------------- stickers ---------------- */\nfunction addSticker(kind,txt){\n  var st={kind:kind,txt:txt,x:.5,y:kind==='banner'?.16:.3,size:kind==='banner'?150:96};\n  S.stickers.push(st);sel=st;\n  el('selCtl').style.display='block';el('ssize').value=st.size;\n  paint();saveDraft();haptic('success');\n}\nfunction addAnyEmoji(){\n  var v=el('anyEmoji').value.trim();if(!v)return;\n  addSticker('emoji',[...v][0]);el('anyEmoji').value='';\n}\nfunction addBanner(){\n  var v=el('banText').value.trim();if(!v)return;\n  addSticker('banner',v.toUpperCase());el('banText').value='';\n}\nfunction deleteSel(){\n  if(!sel)return;\n  S.stickers=S.stickers.filter(function(s){return s!==sel;});\n  sel=null;el('selCtl').style.display='none';paint();saveDraft();haptic('warning');\n}\n\n/* ---------------- photo ---------------- */\n/* Set a fully-loaded Image as the background and reset its position. */\nvar FILTERS=[\n ['none','Original',''],\n ['bw','B&W','grayscale(1) contrast(1.06)'],\n ['warm','Warm','sepia(.32) saturate(1.3) contrast(1.03)'],\n ['cool','Cool','saturate(1.12) hue-rotate(14deg) brightness(1.04)'],\n ['fade','Fade','contrast(.85) brightness(1.14) saturate(.8)'],\n ['punch','Punch','contrast(1.28) saturate(1.4)']\n];\nfunction setPhoto(im){\n  S.photo=im;S.photoDraw=null;S.photoFilter='none';\n  S.bg.type='photo';S.photoPos={x:0,y:0,scale:1};el('pzoom').value=100;\n  refreshStyle();buildFilters();buildGrads();paint();saveDraft();haptic('success');\n}\n/* bake the chosen filter once (ctx.filter when supported, else a pixel pass) so\n   live drag/zoom repaints stay fast */\nfunction applyFilter(id){\n  S.photoFilter=id;buildFilters();\n  if(!S.photo){paint();return}\n  var f=null;for(var i=0;i<FILTERS.length;i++)if(FILTERS[i][0]===id)f=FILTERS[i];\n  if(!f||!f[2]){S.photoDraw=null;paint();return}\n  var im=S.photo,c=document.createElement('canvas');c.width=im.width;c.height=im.height;\n  var x=c.getContext('2d');\n  x.filter=f[2];\n  var supported=x.filter!=='none'&&x.filter!=='';\n  x.drawImage(im,0,0);\n  if(!supported){ // manual fallback: approximate with a pixel pass\n    x.filter='none';x.drawImage(im,0,0);\n    try{\n      var d=x.getImageData(0,0,c.width,c.height),p=d.data;\n      for(var j=0;j<p.length;j+=4){\n        var r=p[j],g=p[j+1],b=p[j+2];\n        if(id==='bw'){var l=r*0.299+g*0.587+b*0.114;r=g=b=l;}\n        else if(id==='warm'){r=Math.min(255,r*1.12+10);g=Math.min(255,g*1.04);b=b*0.88;}\n        else if(id==='cool'){r=r*0.9;g=Math.min(255,g*1.02);b=Math.min(255,b*1.12+8);}\n        else if(id==='fade'){r=r*0.85+34;g=g*0.85+34;b=b*0.85+34;}\n        else if(id==='punch'){r=(r-128)*1.28+128;g=(g-128)*1.28+128;b=(b-128)*1.28+128;}\n        p[j]=Math.max(0,Math.min(255,r));p[j+1]=Math.max(0,Math.min(255,g));p[j+2]=Math.max(0,Math.min(255,b));\n      }\n      x.putImageData(d,0,0);\n    }catch(e){}\n  }\n  S.photoDraw=c;paint();haptic('selection');\n}\nfunction buildFilters(){\n  var w=el('filterRow');if(!w)return;\n  w.style.display=(S.photo&&S.bg.type==='photo')?'flex':'none';\n  w.innerHTML='';\n  FILTERS.forEach(function(f){\n    var b=document.createElement('button');b.className='chip'+(S.photoFilter===f[0]?' on':'');b.textContent=f[1];\n    b.onclick=function(){applyFilter(f[0])};\n    w.appendChild(b);\n  });\n}\n/* Preferred path: the native picker bridge returns a ready data: URL. Falls back\n   to a plain <input type=file> (used in the web preview, where the bridge is\n   absent) — that input is unreliable inside the MyLLM app, hence the bridge. */\nfunction pickPhoto(){\n  el('styleHint').textContent='';\n  if(window.myllmPickImage){\n    myllmPickImage({maxDim:2000}).then(function(url){\n      if(!url)return; // user cancelled\n      var im=new Image();\n      im.onload=function(){setPhoto(im);};\n      im.onerror=function(){el('styleHint').textContent='That photo couldn’t be read — try another.';};\n      im.src=url;\n    }).catch(function(){el('styleHint').textContent='Couldn’t open the photo picker.';});\n  } else {\n    el('photoIn').click();\n  }\n}\nfunction loadPhoto(inp){\n  var f=inp.files&&inp.files[0];if(!f)return;\n  var url=URL.createObjectURL(f),im=new Image();\n  im.onload=function(){\n    // downscale huge camera images once so preview stays fast\n    var maxSide=2000,sc=Math.min(1,maxSide/Math.max(im.width,im.height));\n    var c=document.createElement('canvas');c.width=im.width*sc;c.height=im.height*sc;\n    c.getContext('2d').drawImage(im,0,0,c.width,c.height);\n    var im2=new Image();\n    im2.onload=function(){ setPhoto(im2); URL.revokeObjectURL(url); };\n    im2.src=c.toDataURL('image/jpeg',.9);\n  };\n  im.onerror=function(){el('styleHint').textContent='That image couldn’t be read — try another.';};\n  im.src=url;\n  inp.value='';\n}\nfunction clearPhoto(){\n  S.photo=null;S.photoDraw=null;S.photoFilter='none';buildFilters();if(S.bg.type==='photo')S.bg={type:'grad',grad:S.bg.grad||0,aiUrl:null};\n  refreshStyle();buildGrads();paint();saveDraft();\n}\nfunction refreshStyle(){ el('photoCtl').style.display = (S.photo&&S.bg.type==='photo')?'block':'none'; buildFilters(); }\n\n/* ---------------- AI ---------------- */\nfunction needAI(hintEl){\n  if(window.myllmAsk)return false;\n  hintEl.textContent='This needs the latest MyLLM with “Allow apps to use the AI” enabled in Settings.';\n  return true;\n}\n/* Small on-device models garble JSON, so all AI replies use labelled lines\n   (LABEL: value) parsed leniently — same approach as Talk Tutor. */\nvar LINE_KEYS={template:1,palette:1,hook:1,sub:1,cta:1,caption:1,tags:1,broad:1,niche:1,local:1};\nfunction parseLines(reply){\n  var o={},key=null;\n  String(reply||'').split(/\\r?\\n/).forEach(function(raw){\n    var ln=raw.replace(/\\*\\*/g,'').trim();\n    var m=ln.match(/^[-*#>\\s]*([A-Za-z]+)\\s*[::]\\s*(.*)$/);\n    if(m&&LINE_KEYS[m[1].toLowerCase()]){key=m[1].toLowerCase();o[key]=m[2].trim();}\n    else if(key==='caption'&&ln){o.caption+=' '+ln;} // captions may wrap over lines\n  });\n  return o;\n}\nfunction unq(s){return String(s||'').trim().replace(/^[\"'“”‘’`]+|[\"'“”‘’`]+$/g,'').trim();}\nfunction tagsFrom(s){return String(s||'').split(/[\\s,]+/).filter(function(t){return t.charAt(0)==='#'&&t.length>1;});}\nfunction ask(p){\n  function go(q){return myllmAsk(q).then(function(r){\n    var o=parseLines(r);\n    if(!o.hook&&!o.broad&&!o.niche)throw new Error('the reply wasn’t in the expected format — try again');\n    return o;\n  });}\n  return go(p).catch(function(){return go(p+'\\nIMPORTANT: output only the labelled lines above, nothing else.');});\n}\nfunction applyCopy(o){\n  S.copy.hook=unq(o.hook).slice(0,60);\n  S.copy.sub=unq(o.sub).slice(0,110);\n  S.copy.cta=unq(o.cta).slice(0,30);\n  var tags=tagsFrom(o.tags).join(' ');\n  S.copy.caption=(unq(o.caption)+(tags?'\\n\\n'+tags:'')).trim();\n}\nfunction writeCopy(){\n  var hint=el('wordsHint');hint.textContent='';\n  if(needAI(hint))return;\n  var topic=el('topic').value.trim();\n  if(!topic){hint.textContent='Tell me what the post is about first.';return;}\n  var p='Write social media post copy about: \"'+topic+'\". Tone: '+S.copy.tone.toLowerCase()+'.\\n'+\n    'Reply with EXACTLY these 5 lines and nothing else:\\n'+\n    'HOOK: a punchy headline, max 7 words\\n'+\n    'SUB: a supporting line, max 16 words\\n'+\n    'CTA: a call to action, max 4 words\\n'+\n    'CAPTION: a 2-3 sentence caption for the post text\\n'+\n    'TAGS: 6-10 relevant hashtags separated by spaces';\n  el('writeBtn').disabled=true;hint.textContent='Writing…';\n  ask(p).then(function(o){\n    applyCopy(o);\n    hint.textContent='';fillWordFields();paint();saveDraft();haptic('success');\n  })\n  .catch(function(e){hint.textContent='Couldn’t write it: '+e.message;})\n  .then(function(){el('writeBtn').disabled=false;});\n}\n/* one tap: AI picks the template + palette, writes every field, then (if an\n   image server is set up) paints a background to match */\nfunction designMe(){\n  var hint=el('wordsHint');hint.textContent='';\n  if(needAI(hint))return;\n  var topic=el('topic').value.trim();\n  if(!topic){hint.textContent='Tell me what the post is about first.';return}\n  var p='Art-direct a social media post about: \"'+topic+'\". Tone: '+S.copy.tone.toLowerCase()+'.\\n'+\n    'Reply with EXACTLY these 7 lines and nothing else:\\n'+\n    'TEMPLATE: one of quote, promo, announce, tips, photocap, bold — whichever fits best\\n'+\n    'PALETTE: one number from 0 to 11 — 0 ocean blue, 1 violet, 2 emerald, 3 crimson, 4 amber, 5 slate, 6 sky, 7 magenta, 8 forest, 9 bronze, 10 charcoal, 11 electric purple\\n'+\n    'HOOK: a punchy headline, max 7 words\\n'+\n    'SUB: a supporting line, max 16 words\\n'+\n    'CTA: a call to action, max 4 words\\n'+\n    'CAPTION: a 2-3 sentence caption\\n'+\n    'TAGS: 6-10 relevant hashtags separated by spaces';\n  el('designBtn').disabled=true;setStatusWords('Designing your post…');\n  ask(p).then(function(o){\n    var tpl=String(o.template||'').toLowerCase().match(/quote|promo|announce|tips|photocap|bold/);\n    if(tpl&&TEMPLATES[tpl[0]])S.template=tpl[0];\n    var pm=String(o.palette||'').match(/\\d+/),pal=pm?parseInt(pm[0],10):-1;\n    if(pal>=0&&pal<GRADS.length){S.bg={type:'grad',grad:pal,aiUrl:null};S.photo=null;S.photoDraw=null;}\n    applyCopy(o);\n    fillWordFields();buildTemplates();buildGrads();refreshStyle();paint();saveDraft();\n    setStatusWords('');haptic('success');\n    if(window.myllmGenerateImage){aiBackground();}\n  })\n  .catch(function(e){setStatusWords('Couldn’t design it: '+e.message)})\n  .then(function(){el('designBtn').disabled=false});\n}\nfunction setStatusWords(t){el('wordsHint').textContent=t}\nfunction aiBackground(){\n  var hint=el('styleHint');hint.textContent='';\n  if(!window.myllmGenerateImage){hint.textContent='AI backgrounds need image generation set up in MyLLM (Settings → Image Generation).';return;}\n  var topic=el('topic').value.trim()||S.copy.hook||'an announcement';\n  var aspect=S.format==='square'?'square':'portrait';\n  el('aiBgBtn').disabled=true;hint.textContent='Painting a background…';\n  myllmGenerateImage('abstract atmospheric background for a social media post about \"'+topic+'\", premium, moody, soft depth, no text, no words, no letters, no people',{aspect:aspect})\n  .then(function(url){\n    if(!url)throw new Error('no image came back');\n    var im=new Image();\n    im.onload=function(){S.bg={type:'ai',aiUrl:url,aiImg:im};S.photo=null;refreshStyle();buildGrads();paint();hint.textContent='';haptic('success');};\n    im.onerror=function(){hint.textContent='The image couldn’t be loaded.';};\n    im.src=url;\n  })\n  .catch(function(e){hint.textContent='No background: '+e.message;})\n  .then(function(){el('aiBgBtn').disabled=false;});\n}\n\n/* ---------------- export ---------------- */\nvar lastExport=null;\nfunction sharePost(){\n  if(!lastExport||!window.myllmShareFile)return;\n  var name=(S.copy.hook||'Social post').replace(/[^\\w .-]/g,'').trim()||'Social post';\n  myllmShareFile(lastExport,{filename:name,mime:'image/jpeg'}).catch(function(){});\n  haptic('light');\n}\nfunction doExport(){\n  var f=FORMATS[S.format],cv=document.createElement('canvas');\n  var keep=sel;sel=null;\n  render(cv,f.w,f.h,true);\n  sel=keep;\n  var data=cv.toDataURL('image/jpeg',.92);\n  lastExport=data;\n  var caption=(S.copy.caption||'').trim();\n  var copied=false;\n  if(caption){\n    try{\n      var ta=document.createElement('textarea');ta.value=caption;document.body.appendChild(ta);\n      ta.select();copied=document.execCommand('copy');document.body.removeChild(ta);\n    }catch(e){}\n  }\n  var saved=false;\n  if(window.myllmSaveImage){try{myllmSaveImage(data);saved=true;}catch(e){}}\n  var s=el('sheet');\n  s.innerHTML='<h3>'+(saved?'Saved to Photos':'Your post is ready')+'</h3>'+\n    '<img src=\"'+data+'\" alt=\"Finished post\">'+\n    (window.myllmShareFile?'<button class=\"btn\" onclick=\"sharePost()\">Share post…</button>':'')+\n    '<button class=\"btn ghost\" onclick=\"savePost();el(\\'scrim\\').classList.remove(\\'on\\')\">Keep in My Posts</button>'+\n    (saved?'':'<p class=\"hint\">Press and hold the image to save it.</p>')+\n    (caption?('<p class=\"ok\">'+(copied?'Caption + hashtags copied — just paste when you post.':'')+'</p>'):'')+\n    (caption?'<button class=\"btn ghost\" onclick=\"shareCaption()\">Share caption text</button>':'')+\n    '<button class=\"btn line\" onclick=\"el(\\'scrim\\').classList.remove(\\'on\\')\">Done</button>';\n  el('scrim').classList.add('on');\n  haptic('success');\n}\nfunction shareCaption(){\n  var c=(S.copy.caption||'').trim();if(!c)return;\n  if(window.myllmShare){try{myllmShare(c);return;}catch(e){}}\n}\n\n/* ---------------- posts library ---------------- */\nvar LIB=[],libArmed=null;\nfunction saveLibrary(){\n  var json=JSON.stringify(LIB),guard=0;\n  // myllmStorage budget (~1MB): shed oldest photos first, then oldest posts\n  while(json.length>880000&&guard++<40){\n    var shed=false;\n    for(var i=LIB.length-1;i>=0;i--){if(LIB[i].pd){LIB[i].pd=null;shed=true;break}}\n    if(!shed)LIB.pop();\n    json=JSON.stringify(LIB);\n  }\n  store.setItem('socialstudio.library',json);\n}\nfunction postThumb(){\n  var f=FORMATS[S.format],tc=document.createElement('canvas');\n  var keep=sel;sel=null;\n  render(tc,240,Math.round(240*f.h/f.w),true);\n  sel=keep;\n  return tc.toDataURL('image/jpeg',.5);\n}\nfunction photoData(){\n  if(!S.photo||S.bg.type!=='photo')return null;\n  var im=S.photo,mx=1000,sc=Math.min(1,mx/Math.max(im.width,im.height));\n  var c=document.createElement('canvas');c.width=Math.round(im.width*sc);c.height=Math.round(im.height*sc);\n  c.getContext('2d').drawImage(im,0,0,c.width,c.height);\n  return c.toDataURL('image/jpeg',.6);\n}\nfunction savePost(){\n  var entry={\n    id:'p'+Date.now(),\n    name:(S.copy.hook||'Untitled post').slice(0,40),\n    date:new Date().toLocaleDateString(undefined,{month:'short',day:'numeric'}),\n    st:{format:S.format,template:S.template,textScale:S.textScale||1,\n        bg:{type:S.bg.type==='photo'?'photo':'grad',grad:S.bg.grad||0},\n        copy:JSON.parse(JSON.stringify(S.copy)),\n        stickers:JSON.parse(JSON.stringify(S.stickers)),\n        photoFilter:S.photoFilter||'none',\n        photoPos:JSON.parse(JSON.stringify(S.photoPos))},\n    thumb:postThumb(),\n    pd:photoData()\n  };\n  LIB.unshift(entry);saveLibrary();renderLibrary();\n  el('libHint').textContent='Saved “'+entry.name+'” ✓';\n  haptic('success');\n}\nfunction renderLibrary(){\n  var g=el('libGrid');if(!g)return;g.innerHTML='';\n  if(!LIB.length){el('libHint').textContent='Your saved posts appear here — keep several campaigns going at once.';return}\n  el('libHint').textContent=LIB.length+' saved post'+(LIB.length===1?'':'s')+' — tap to open.';\n  LIB.forEach(function(p){\n    var d=document.createElement('div');d.className='pcard2';\n    var im=document.createElement('img');im.src=p.thumb;im.alt='';d.appendChild(im);\n    var nm=document.createElement('span');nm.className='pn';nm.textContent=p.name;d.appendChild(nm);\n    var dup=document.createElement('button');dup.className='pact pdup';dup.textContent='⧉';\n    dup.onclick=function(ev){ev.stopPropagation();\n      var c=JSON.parse(JSON.stringify(p));c.id='p'+Date.now();c.name=(p.name+' copy').slice(0,40);\n      LIB.unshift(c);saveLibrary();renderLibrary();haptic('success')};\n    var del=document.createElement('button');del.className='pact pdel'+(libArmed===p.id?' armed':'');\n    del.textContent=libArmed===p.id?'Delete?':'✕';\n    del.onclick=function(ev){ev.stopPropagation();\n      if(libArmed!==p.id){libArmed=p.id;renderLibrary();setTimeout(function(){if(libArmed===p.id){libArmed=null;renderLibrary()}},2500);return}\n      libArmed=null;LIB=LIB.filter(function(x){return x.id!==p.id});saveLibrary();renderLibrary();haptic('warning')};\n    d.appendChild(dup);d.appendChild(del);\n    d.onclick=function(){openPost(p)};\n    g.appendChild(d);\n  });\n}\nfunction openPost(p){\n  var st=p.st||{};\n  S.format=FORMATS[st.format]?st.format:'square';\n  S.template=TEMPLATES[st.template]?st.template:'promo';\n  S.copy=Object.assign({},S.copy,st.copy||{});\n  S.textScale=typeof st.textScale==='number'?Math.min(1.5,Math.max(.6,st.textScale)):1;\n  S.stickers=Array.isArray(st.stickers)?st.stickers:[];\n  S.photoFilter=st.photoFilter||'none';\n  S.photoPos=st.photoPos||{x:0,y:0,scale:1};\n  S.photo=null;S.photoDraw=null;S.bg={type:'grad',grad:(st.bg&&st.bg.grad)||0,aiUrl:null};\n  function done(){\n    buildFormats();buildTemplates();buildGrads();fillWordFields();refreshStyle();paint();saveDraft();\n    el('libHint').textContent='Opened “'+p.name+'”'+((st.bg&&st.bg.type==='photo'&&!p.pd)?' — its photo couldn’t be kept, re-add one.':'');\n    haptic('selection');\n  }\n  if(st.bg&&st.bg.type==='photo'&&p.pd){\n    var im=new Image();\n    im.onload=function(){\n      S.photo=im;S.bg.type='photo';el('pzoom').value=Math.round((S.photoPos.scale||1)*100);\n      if(S.photoFilter&&S.photoFilter!=='none')applyFilter(S.photoFilter);else S.photoDraw=null;\n      done();\n    };\n    im.src=p.pd;\n  } else done();\n}\n\n/* ---------------- persistence ---------------- */\nvar draftTimer=null;\nfunction saveDraft(){\n  clearTimeout(draftTimer);\n  draftTimer=setTimeout(function(){\n    var d={format:S.format,template:S.template,textScale:S.textScale||1,bg:{type:S.bg.type==='photo'?'grad':S.bg.type==='ai'?'grad':'grad',grad:S.bg.grad||0},copy:S.copy,stickers:S.stickers};\n    store.setItem('socialstudio.draft',JSON.stringify(d)); // photos/AI images aren't persisted (1MB app budget)\n  },500);\n}\nfunction saveBrand(){\n  store.setItem('socialstudio.brand',JSON.stringify({\n    handle:BRAND.handle,accent:BRAND.accent,wm:BRAND.wm,\n    logo:BRAND.logo,logoPos:BRAND.logoPos,logoSize:BRAND.logoSize\n  }));\n}\n/* logo: picked natively (myllmPickImage) or via file input in a browser */\nfunction pickLogo(){\n  if(window.myllmPickImage){\n    myllmPickImage({maxDim:500}).then(function(url){if(url)setLogo(url)}).catch(function(){});\n  } else el('logoIn').click();\n}\nfunction loadLogoFile(inp){\n  var f=inp.files&&inp.files[0];if(!f)return;\n  var r=new FileReader();r.onload=function(){setLogo(r.result)};r.readAsDataURL(f);inp.value='';\n}\nfunction setLogo(url){\n  var im=new Image();\n  im.onload=function(){\n    // keep the stored copy small (brand kit shares the 1MB app budget)\n    var mx=400,sc=Math.min(1,mx/Math.max(im.width,im.height));\n    var c=document.createElement('canvas');c.width=Math.round(im.width*sc);c.height=Math.round(im.height*sc);\n    c.getContext('2d').drawImage(im,0,0,c.width,c.height);\n    BRAND.logo=c.toDataURL('image/jpeg',.8);\n    var im2=new Image();im2.onload=function(){BRAND.logoImg=im2;saveBrand();renderBrand();paint();haptic('success')};\n    im2.src=BRAND.logo;\n  };\n  im.src=url;\n}\nfunction removeLogo(){BRAND.logo=null;BRAND.logoImg=null;saveBrand();renderBrand();paint();haptic('warning')}\nfunction updCount(){\n  var len=(S.copy.caption||'').length;\n  el('capCount').textContent=len?(len+' / 2,200'):'';\n  el('capCount').style.color=len>2200?'var(--danger)':'var(--mut)';\n}\n/* three AI-suggested hashtag sets — tap one to swap it into the caption */\nvar TAGSETS=null;\nfunction suggestTags(){\n  var hint=el('wordsHint');hint.textContent='';\n  if(needAI(hint))return;\n  var topic=el('topic').value.trim()||S.copy.hook||'';\n  if(!topic){hint.textContent='Add a topic or headline first.';return}\n  el('tagBtn').disabled=true;hint.textContent='Finding hashtags…';\n  var p='Suggest hashtags for a social post about: \"'+topic+'\".\\n'+\n    'Reply with EXACTLY these 3 lines and nothing else:\\n'+\n    'BROAD: 6 popular high-reach hashtags separated by spaces\\n'+\n    'NICHE: 6 specific community hashtags separated by spaces\\n'+\n    'LOCAL: 5 location or scene hashtags separated by spaces (invent a plausible scene if unknown)';\n  ask(p).then(function(o){\n    TAGSETS={broad:tagsFrom(o.broad),niche:tagsFrom(o.niche),local:tagsFrom(o.local)};\n    if(!TAGSETS.broad.length&&!TAGSETS.niche.length&&!TAGSETS.local.length)throw new Error('none came back');\n    var w=el('tagSets');w.innerHTML='';\n    [['broad','Broad reach'],['niche','Niche'],['local','Local']].forEach(function(k){\n      var set=TAGSETS[k[0]];\n      if(!Array.isArray(set)||!set.length)return;\n      var b=document.createElement('button');b.className='chip';\n      b.textContent=k[1]+' · '+set.length;\n      b.title=set.join(' ');\n      b.onclick=function(){applyTags(set);document.querySelectorAll('#tagSets .chip').forEach(function(x){x.classList.remove('on')});b.classList.add('on')};\n      w.appendChild(b);\n    });\n    hint.textContent='Tap a set to use it.';haptic('success');\n  }).catch(function(e){hint.textContent='No hashtags: '+e.message})\n  .then(function(){el('tagBtn').disabled=false});\n}\nfunction applyTags(set){\n  // strip any trailing hashtag block, then append the chosen set\n  var cap=(S.copy.caption||'').replace(/(\\n\\s*)?(#[\\w\\u00c0-\\uffff]+[ \\t]*)+\\s*$/,'').trim();\n  S.copy.caption=(cap+'\\n\\n'+set.join(' ')).trim();\n  el('fCaption').value=S.copy.caption;updCount();saveDraft();haptic('selection');\n}\nfunction fillWordFields(){\n  el('fHook').value=S.copy.hook||'';el('fSub').value=S.copy.sub||'';\n  el('fCta').value=S.copy.cta||'';el('fCaption').value=S.copy.caption||'';\n  el('tsize').value=Math.round((S.textScale||1)*100);updCount();\n}\n\n/* ---------------- init ---------------- */\nbuildTabs();buildFormats();buildTones();buildGrads();buildEmoji();renderBrand();fillWordFields();\nstore.getItem('socialstudio.brand').then(function(v){\n  if(v){try{var b=JSON.parse(v);if(b&&typeof b==='object')BRAND=Object.assign(BRAND,b);}catch(e){}}\n  if(BRAND.logo){var li=new Image();li.onload=function(){BRAND.logoImg=li;paint()};li.src=BRAND.logo;}\n  renderBrand();\n  return store.getItem('socialstudio.draft');\n}).then(function(v){\n  if(v){try{var d=JSON.parse(v);\n    if(d&&d.copy){S.format=FORMATS[d.format]?d.format:'square';S.template=TEMPLATES[d.template]?d.template:'promo';\n      S.bg=d.bg&&typeof d.bg.grad==='number'?{type:'grad',grad:d.bg.grad}:S.bg;\n      if(typeof d.textScale==='number')S.textScale=Math.min(1.5,Math.max(.6,d.textScale));\n      S.copy=Object.assign(S.copy,d.copy);S.stickers=Array.isArray(d.stickers)?d.stickers:[];}\n  }catch(e){}}\n  buildFormats();buildGrads();fillWordFields();buildTemplates();paint();\n  return store.getItem('socialstudio.library');\n}).then(function(v){\n  if(v)try{LIB=JSON.parse(v)||[]}catch(e){}\n  renderLibrary();\n});\ndocument.addEventListener('focusin',function(e){\n  var t=e.target;\n  if(t&&(t.tagName==='TEXTAREA'||(t.tagName==='INPUT'&&t.type!=='range'&&t.type!=='file')))kbOpen=true;\n});\ndocument.addEventListener('focusout',function(){\n  kbOpen=false;\n  // let the keyboard finish dismissing, then undo any page pan and re-fit\n  setTimeout(function(){if(!kbOpen){window.scrollTo(0,0);paint();}},250);\n});\nvar rzT=null;\nwindow.addEventListener('resize',function(){clearTimeout(rzT);rzT=setTimeout(paint,150);});\n</script>\n</body></html>\n"}