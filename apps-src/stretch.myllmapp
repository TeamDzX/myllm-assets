{"name": "Stretch", "kind": "html", "iconSymbol": "figure.flexibility", "iconColor": "teal", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Stretch</title>\n<style>\n:root{\n  color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7);--surface:var(--myllm-surface,#fff);\n  --text:var(--myllm-text,#111);--muted:var(--myllm-muted,#6b6b72);\n  --accent:var(--myllm-accent,#0e9aa7);--border:var(--myllm-border,rgba(120,120,128,.25));\n  --radius:var(--myllm-radius,16px);--font:var(--myllm-font,-apple-system,system-ui,sans-serif);\n  --img:#eef3f4;\n}\n@media(prefers-color-scheme:dark){:root{--bg:var(--myllm-bg,#000);--surface:var(--myllm-surface,#1c1c1e);--text:var(--myllm-text,#eee);--muted:var(--myllm-muted,#98989f);--img:#15171a}}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nbody{margin:0;font-family:var(--font);background:var(--bg);color:var(--text)}\n.head{position:sticky;top:0;z-index:10;background:var(--bg);border-bottom:1px solid var(--border)}\n.tabs{display:flex;gap:6px;overflow-x:auto;padding:12px 14px;scrollbar-width:none}.tabs::-webkit-scrollbar{display:none}\n.tab{flex:none;border:1px solid var(--border);background:var(--surface);color:var(--muted);border-radius:999px;padding:8px 14px;font:inherit;font-size:14px;font-weight:600;cursor:pointer;white-space:nowrap}\n.tab.on{background:var(--accent);color:#fff;border-color:transparent}\n.wrap{max-width:760px;margin:0 auto;padding:14px}\n.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}\n.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;cursor:pointer;text-align:left}\n.card .ph{aspect-ratio:3/4;background:var(--img);display:flex;align-items:center;justify-content:center}\n.card .ph img{width:100%;height:100%;object-fit:contain}\n.card .b{padding:10px 11px}\n.card .b h3{margin:0;font-size:15px;line-height:1.25}\n.card .b .m{font-size:12px;color:var(--muted);margin-top:3px}\n.fav{position:absolute;margin:-8px 0 0 -8px}\n.empty{color:var(--muted);text-align:center;padding:40px 20px;font-size:15px}\n.disc{color:var(--muted);font-size:12px;line-height:1.5;margin-top:18px;border-top:1px solid var(--border);padding-top:12px}\n\n/* detail */\n.detail{display:none}\n.dtop{display:flex;align-items:center;gap:8px;padding:10px 14px;position:sticky;top:0;background:var(--bg);z-index:5;border-bottom:1px solid var(--border)}\n.dtop button{border:0;background:none;color:var(--accent);font:inherit;font-weight:600;font-size:15px;cursor:pointer;padding:6px}\n.dtop .sp{flex:1}\n.hero{aspect-ratio:3/4;max-height:46vh;background:var(--img);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;overflow:hidden;margin-bottom:14px}\n.hero img{width:100%;height:100%;object-fit:contain}\n.dname{font-size:24px;font-weight:700;margin:0 0 8px}\n.badges{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px}\n.badge{font-size:12px;font-weight:600;background:var(--surface);border:1px solid var(--border);color:var(--muted);border-radius:999px;padding:5px 10px}\n.badge.t{color:var(--accent);border-color:var(--accent)}\n.benefit{background:var(--surface);border:1px solid var(--border);border-left:3px solid var(--accent);border-radius:12px;padding:11px 14px;font-size:14px;margin-bottom:16px}\n.steps{list-style:none;margin:0 0 18px;padding:0;counter-reset:s}\n.steps li{counter-increment:s;position:relative;padding:0 0 14px 38px;font-size:16px;line-height:1.5}\n.steps li:before{content:counter(s);position:absolute;left:0;top:-1px;width:26px;height:26px;background:var(--accent);color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700}\n.timer{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px;text-align:center;margin-bottom:16px}\n.ring{width:120px;height:120px;border-radius:50%;margin:4px auto 12px;display:flex;align-items:center;justify-content:center;font-size:34px;font-weight:700;background:conic-gradient(var(--accent) 0deg,var(--border) 0deg)}\n.ring .in{width:104px;height:104px;border-radius:50%;background:var(--surface);display:flex;align-items:center;justify-content:center}\n.timer .row{display:flex;gap:8px;justify-content:center}\n.timer button{border:0;border-radius:10px;padding:10px 18px;font:inherit;font-weight:600;font-size:14px;cursor:pointer}\n.timer .start{background:var(--accent);color:#fff}.timer .ghost{background:var(--bg);border:1px solid var(--border);color:var(--text)}\n.aiBtn{width:100%;border:1px solid var(--accent);background:var(--surface);color:var(--accent);border-radius:12px;padding:13px;font:inherit;font-weight:600;font-size:15px;cursor:pointer;margin-bottom:10px}\n#aiTip{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:13px 15px;font-size:14px;line-height:1.5;display:none;margin-bottom:10px;white-space:pre-wrap}\n.dnav{display:flex;justify-content:space-between;margin:8px 0 24px}\n.dnav button{border:0;background:none;color:var(--accent);font:inherit;font-weight:600;font-size:15px;cursor:pointer;padding:8px}\n.dnav button:disabled{opacity:.3}\n.dots:after{content:'';animation:d 1.1s steps(4) infinite}@keyframes d{0%{content:''}25%{content:'.'}50%{content:'..'}75%{content:'...'}}\n.sheet{position:fixed;inset:0;background:rgba(0,0,0,.5);display:none;align-items:center;justify-content:center;z-index:40;padding:24px}\n.sheet.show{display:flex}\n.sheetB{background:var(--bg);border-radius:18px;max-width:420px;padding:20px 22px}\n.sheetB h3{margin:0 0 8px}.sheetB p{font-size:14px;line-height:1.55;color:var(--muted)}\n.sheetB button{margin-top:14px;width:100%;border:0;background:var(--accent);color:#fff;border-radius:11px;padding:12px;font:inherit;font-weight:600;cursor:pointer}\n</style>\n</head>\n<body>\n<div id=\"library\">\n  <div class=\"head\"><div class=\"tabs\" id=\"tabs\"></div></div>\n  <div class=\"wrap\">\n    <div class=\"grid\" id=\"grid\"></div>\n    <div class=\"empty\" id=\"empty\" style=\"display:none\">No favourites yet — tap ♥ on a stretch to save it here.</div>\n    <p class=\"disc\">These stretches are general wellbeing suggestions, not medical advice. Move gently and slowly, never stretch into pain, and check with a healthcare professional if you have an injury or health condition. <a href=\"#\" id=\"discLink\" style=\"color:var(--accent)\">More</a></p>\n  </div>\n</div>\n\n<div class=\"detail\" id=\"detail\">\n  <div class=\"dtop\"><button id=\"back\">‹ Back</button><div class=\"sp\"></div><button id=\"favBtn\">♡</button></div>\n  <div class=\"wrap\">\n    <div class=\"hero\"><img id=\"dimg\" alt=\"\"></div>\n    <h1 class=\"dname\" id=\"dname\"></h1>\n    <div class=\"badges\" id=\"dbadges\"></div>\n    <div class=\"benefit\" id=\"dbenefit\"></div>\n    <ol class=\"steps\" id=\"dsteps\"></ol>\n    <div class=\"timer\">\n      <div class=\"ring\" id=\"ring\"><div class=\"in\" id=\"ringn\">30</div></div>\n      <div class=\"row\"><button class=\"start\" id=\"tStart\">Start hold</button><button class=\"ghost\" id=\"tReset\">Reset</button></div>\n    </div>\n    <button class=\"aiBtn\" id=\"aiBtn\">💡 Tip &amp; easier option</button>\n    <div id=\"aiTip\"></div>\n    <div class=\"dnav\"><button id=\"prev\">‹ Previous</button><button id=\"next\">Next ›</button></div>\n  </div>\n</div>\n\n<div class=\"sheet\" id=\"sheet\"><div class=\"sheetB\"><h3>Stay safe</h3><p>These stretches are general wellbeing suggestions, not medical advice. Warm up first, move slowly, breathe, and never push into pain. Ease off if you feel sharp or unusual discomfort. If you're pregnant, injured, or have a health condition, check with a healthcare professional before starting.</p><button id=\"sheetOk\">Got it</button></div></div>\n\n<script>\nvar IMG=\"https://raw.githubusercontent.com/TeamDzX/myllm-assets/main/apps/stretches/\";\nvar CATS=[[\"all\",\"All\"],[\"fav\",\"♥ Favourites\"],[\"neck\",\"Neck & Shoulders\"],[\"back\",\"Back\"],[\"hips\",\"Hips\"],[\"legs\",\"Legs\"],[\"desk\",\"Desk & Wrists\"],[\"full\",\"Full Body\"]];\nvar S=[\n {id:\"neck-side\",name:\"Neck Side Stretch\",cat:\"neck\",target:\"Neck, upper traps\",hold:\"20–30s each side\",level:\"Easy\",benefit:\"Eases neck and shoulder tension from screens and phones.\",steps:[\"Sit or stand tall, shoulders relaxed down.\",\"Slowly tilt your right ear toward your right shoulder.\",\"Rest your right hand lightly on your head for a gentle pull.\",\"Breathe, hold, then switch sides.\"]},\n {id:\"shoulder-rolls\",name:\"Shoulder Rolls\",cat:\"neck\",target:\"Shoulders, upper back\",hold:\"10 rolls each way\",level:\"Easy\",benefit:\"Loosens stiff shoulders and resets your posture.\",steps:[\"Stand or sit tall with arms relaxed.\",\"Lift your shoulders up toward your ears.\",\"Roll them back and down in a smooth circle.\",\"Repeat, then reverse the direction.\"]},\n {id:\"cross-shoulder\",name:\"Cross-Body Shoulder Stretch\",cat:\"neck\",target:\"Rear shoulder\",hold:\"20–30s each side\",level:\"Easy\",benefit:\"Relieves tight shoulders after lifting or sitting.\",steps:[\"Bring one straight arm across your chest.\",\"Use the other hand to gently press it closer.\",\"Keep your shoulders down — don't shrug.\",\"Hold, then switch arms.\"]},\n {id:\"cat-cow\",name:\"Cat–Cow\",cat:\"back\",target:\"Whole spine\",hold:\"8–10 slow rounds\",level:\"Easy\",benefit:\"Mobilises the whole spine and warms up the back.\",steps:[\"Start on hands and knees, wrists under shoulders.\",\"Exhale and round your back up like a cat.\",\"Inhale and let your belly drop, chest lifting.\",\"Move slowly, following your breath.\"]},\n {id:\"childs-pose\",name:\"Child's Pose\",cat:\"back\",target:\"Lower back, hips\",hold:\"30–60s\",level:\"Easy\",benefit:\"Gently decompresses the lower back; very calming.\",steps:[\"Kneel and sit back onto your heels.\",\"Fold forward and walk your hands out in front.\",\"Rest your forehead toward the floor.\",\"Relax and breathe into your back.\"]},\n {id:\"seated-twist\",name:\"Seated Spinal Twist\",cat:\"back\",target:\"Spine, obliques\",hold:\"20–30s each side\",level:\"Easy\",benefit:\"Improves spinal mobility and eases back stiffness.\",steps:[\"Sit tall, legs crossed or extended.\",\"Place one hand on the opposite knee.\",\"Twist your torso and gaze over your shoulder.\",\"Lengthen up on each inhale; hold, then switch.\"]},\n {id:\"figure-four\",name:\"Figure-Four Glute Stretch\",cat:\"hips\",target:\"Glutes, hips\",hold:\"30s each side\",level:\"Easy\",benefit:\"Opens tight glutes and hips from long sitting.\",steps:[\"Lie on your back, knees bent.\",\"Cross one ankle over the opposite thigh.\",\"Hold behind that thigh and draw it toward you.\",\"Keep your head down; hold, then switch.\"]},\n {id:\"low-lunge\",name:\"Low Lunge Hip Flexor\",cat:\"hips\",target:\"Hip flexors, quads\",hold:\"30s each side\",level:\"Medium\",benefit:\"Releases hip flexors tightened by sitting all day.\",steps:[\"Step one foot forward into a lunge.\",\"Lower the back knee to the floor.\",\"Keep your torso tall and tuck the hips slightly.\",\"Press gently forward; hold, then switch.\"]},\n {id:\"butterfly\",name:\"Butterfly Stretch\",cat:\"hips\",target:\"Inner thighs, groin\",hold:\"30–45s\",level:\"Easy\",benefit:\"Opens the inner thighs and groin.\",steps:[\"Sit and bring the soles of your feet together.\",\"Let your knees fall out to the sides.\",\"Hold your feet and sit up tall.\",\"Optionally fold gently forward.\"]},\n {id:\"hamstring\",name:\"Standing Hamstring Fold\",cat:\"legs\",target:\"Hamstrings, lower back\",hold:\"30s\",level:\"Easy\",benefit:\"Lengthens tight hamstrings and calms the mind.\",steps:[\"Stand with feet hip-width, knees soft.\",\"Hinge at the hips and fold forward.\",\"Let your head and arms hang toward the floor.\",\"Bend the knees as needed; rise slowly.\"]},\n {id:\"quad\",name:\"Standing Quad Stretch\",cat:\"legs\",target:\"Quadriceps\",hold:\"30s each side\",level:\"Medium\",benefit:\"Stretches the front thighs after walking or running.\",steps:[\"Stand tall, hold something for balance.\",\"Bend one knee and grab that foot behind you.\",\"Draw the heel toward your glute, knees together.\",\"Stand tall; hold, then switch.\"]},\n {id:\"calf\",name:\"Standing Calf Stretch\",cat:\"legs\",target:\"Calves\",hold:\"30s each side\",level:\"Easy\",benefit:\"Eases tight calves and supports ankle mobility.\",steps:[\"Face a wall, hands at chest height.\",\"Step one foot back, that leg straight.\",\"Press the back heel into the floor.\",\"Lean in gently; hold, then switch.\"]},\n {id:\"wrist-flexor\",name:\"Wrist Flexor Stretch\",cat:\"desk\",target:\"Forearm, wrist\",hold:\"20–30s each side\",level:\"Easy\",benefit:\"Relieves wrist strain from typing and mouse use.\",steps:[\"Extend one arm forward, palm up.\",\"With the other hand, pull the fingers down and back.\",\"Keep the elbow straight.\",\"Hold, then switch hands.\"]},\n {id:\"wrist-extensor\",name:\"Wrist Extensor Stretch\",cat:\"desk\",target:\"Forearm, wrist\",hold:\"20–30s each side\",level:\"Easy\",benefit:\"Counters tightness on top of the forearm from desk work.\",steps:[\"Extend one arm forward, palm down.\",\"With the other hand, gently pull the hand downward.\",\"Keep the elbow straight.\",\"Hold, then switch hands.\"]},\n {id:\"chest-opener\",name:\"Seated Chest Opener\",cat:\"desk\",target:\"Chest, shoulders\",hold:\"20–30s\",level:\"Easy\",benefit:\"Reverses the rounded-shoulder slump of desk work.\",steps:[\"Sit or stand tall.\",\"Clasp your hands behind your lower back.\",\"Gently straighten your arms and lift them slightly.\",\"Open your chest and breathe.\"]},\n {id:\"side-bend\",name:\"Standing Side Bend\",cat:\"full\",target:\"Obliques, side body\",hold:\"20–30s each side\",level:\"Easy\",benefit:\"Lengthens the side body and helps you breathe deeper.\",steps:[\"Stand tall, reach both arms overhead.\",\"Clasp your hands and lean to one side.\",\"Keep both feet grounded.\",\"Feel the stretch along your side; switch.\"]},\n {id:\"downward-dog\",name:\"Downward-Facing Dog\",cat:\"full\",target:\"Whole body\",hold:\"30–45s\",level:\"Medium\",benefit:\"A full-body stretch for shoulders, back and legs.\",steps:[\"From hands and knees, tuck your toes.\",\"Lift your hips up and back into an inverted V.\",\"Press your hands down, ease your heels toward the floor.\",\"Relax your neck and breathe.\"]},\n {id:\"standing-backbend\",name:\"Gentle Standing Backbend\",cat:\"full\",target:\"Front body, spine\",hold:\"10–15s\",level:\"Easy\",benefit:\"Opens the chest and counters forward hunching.\",steps:[\"Stand tall, hands supporting your lower back.\",\"Lift your chest and gently arch backward.\",\"Look slightly up; keep it small and comfortable.\",\"Return to standing slowly.\"]}\n];\nvar cat=\"all\",favs=[],list=[],di=0,timer=null,tleft=0,ttotal=30;\nfunction $(i){return document.getElementById(i)}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nfunction holdSecs(h){var m=(h||'').match(/\\d+/g);if(!m)return 30;return parseInt(m[m.length>1?1:0])||30}\n\nfunction tabs(){\n  var t=$('tabs');t.innerHTML='';\n  CATS.forEach(function(c){var b=document.createElement('button');b.className='tab'+(c[0]===cat?' on':'');b.textContent=c[1];\n    b.onclick=function(){cat=c[0];haptic('selection');tabs();renderGrid();window.scrollTo(0,0)};t.appendChild(b)});\n}\nfunction filtered(){return cat==='all'?S:cat==='fav'?S.filter(function(s){return favs.indexOf(s.id)>=0}):S.filter(function(s){return s.cat===cat})}\nfunction renderGrid(){\n  list=filtered();var g=$('grid');g.innerHTML='';\n  $('empty').style.display=(cat==='fav'&&!list.length)?'block':'none';\n  list.forEach(function(s,i){\n    var c=document.createElement('button');c.className='card';\n    c.innerHTML='<div class=\"ph\"><img loading=\"lazy\" src=\"'+IMG+s.id+'.jpg\" alt=\"'+esc(s.name)+'\" onerror=\"this.style.display=\\'none\\'\"></div><div class=\"b\"><h3>'+esc(s.name)+'</h3><div class=\"m\">'+esc(s.target)+' · '+esc(s.hold)+'</div></div>';\n    c.onclick=function(){openDetail(i)};g.appendChild(c);\n  });\n}\nfunction esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;')}\n\nfunction openDetail(i){\n  di=i;var s=list[i];\n  $('library').style.display='none';$('detail').style.display='block';window.scrollTo(0,0);\n  // Animated illustration when available: looping WebP in a plain <img> —\n  // autoplays, no video element, so iOS never shows player chrome on it.\n  var d=$('dimg');d.alt=s.name;\n  d.onerror=function(){this.onerror=null;this.src=IMG+s.id+'.jpg'};\n  d.src=IMG+s.id+'.webp';\n  $('dname').textContent=s.name;\n  $('dbadges').innerHTML='<span class=\"badge t\">'+esc(s.target)+'</span><span class=\"badge\">⏱ '+esc(s.hold)+'</span><span class=\"badge\">'+esc(s.level)+'</span>';\n  $('dbenefit').textContent=s.benefit;\n  $('dsteps').innerHTML=s.steps.map(function(x){return '<li>'+esc(x)+'</li>'}).join('');\n  $('aiTip').style.display='none';$('aiTip').textContent='';\n  $('prev').disabled=(i===0);$('next').disabled=(i===list.length-1);\n  updateFav();resetTimer(holdSecs(s.hold));\n}\nfunction updateFav(){var on=favs.indexOf(list[di].id)>=0;$('favBtn').textContent=on?'♥':'♡';$('favBtn').style.color=on?'#ff375f':'var(--accent)'}\n$('favBtn').onclick=function(){var id=list[di].id,k=favs.indexOf(id);if(k>=0)favs.splice(k,1);else favs.push(id);save();updateFav();haptic('success')};\n$('back').onclick=function(){stopTimer();$('detail').style.display='none';$('library').style.display='block';renderGrid()};\n$('prev').onclick=function(){if(di>0){haptic('selection');openDetail(di-1)}};\n$('next').onclick=function(){if(di<list.length-1){haptic('selection');openDetail(di+1)}};\n\n// hold timer\nfunction setRing(){var pct=ttotal?(tleft/ttotal):0;$('ring').style.background='conic-gradient(var(--accent) '+(pct*360)+'deg,var(--border) 0deg)';$('ringn').textContent=tleft}\nfunction resetTimer(sec){stopTimer();ttotal=sec;tleft=sec;setRing();$('tStart').textContent='Start hold'}\nfunction stopTimer(){if(timer){clearInterval(timer);timer=null}}\n$('tStart').onclick=function(){\n  if(timer){stopTimer();$('tStart').textContent='Resume';return}\n  if(tleft<=0)tleft=ttotal;\n  haptic('light');$('tStart').textContent='Pause';\n  timer=setInterval(function(){tleft--;setRing();if(tleft<=0){stopTimer();$('tStart').textContent='Start hold';haptic('success')}},1000);\n};\n$('tReset').onclick=function(){resetTimer(ttotal);haptic('selection')};\n\n// AI tip\n$('aiBtn').onclick=function(){\n  var s=list[di];\n  if(!window.myllmAsk){var t=$('aiTip');t.style.display='block';t.textContent='Turn on “Allow apps to use the AI” in Settings → MyLLMos Apps to get a personalised tip.';return}\n  $('aiBtn').disabled=true;var t=$('aiTip');t.style.display='block';t.innerHTML='<span class=\"dots\">Thinking</span>';haptic('light');\n  myllmAsk('Give one short, friendly tip plus an easier modification for the \"'+s.name+'\" stretch (targets: '+s.target+'). Two sentences max. Be safe and encouraging.',\n    {system:'You are a careful, friendly mobility and stretching coach. Keep advice short, gentle and safe. Never diagnose or give medical advice.'})\n   .then(function(r){t.textContent=(r||'').trim()||'Try again in a moment.'})\n   .catch(function(){t.textContent='Couldn’t get a tip right now.'})\n   .then(function(){$('aiBtn').disabled=false});\n};\n\n$('discLink').onclick=function(e){e.preventDefault();$('sheet').classList.add('show')};\n$('sheetOk').onclick=function(){$('sheet').classList.remove('show')};\n$('sheet').onclick=function(e){if(e.target===$('sheet'))$('sheet').classList.remove('show')};\n\nfunction save(){if(window.myllmStorage)myllmStorage.setItem('stretch',JSON.stringify({favs:favs}))}\nfunction load(){\n  tabs();\n  if(!window.myllmStorage){renderGrid();return}\n  myllmStorage.getItem('stretch').then(function(v){if(v)try{favs=(JSON.parse(v).favs)||[]}catch(e){}renderGrid()});\n}\nload();\n</script>\n</body>\n</html>\n"}