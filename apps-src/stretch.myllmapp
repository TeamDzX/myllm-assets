{"name": "Stretch", "kind": "html", "iconSymbol": "figure.flexibility", "iconColor": "teal", "html": "<!doctype html>\n<!--\n  Stretch — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Stretch</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>\n:root{--build-id:\"70236d71d3\";\n  color-scheme:light dark;\n  --h:184;\n  --bg:var(--myllm-bg,#f2f2f7);--surface:var(--myllm-surface,#fff);\n  --text:var(--myllm-text,#111);--muted:var(--myllm-muted,#8a8a8e);\n  --accent:var(--myllm-accent,#0e9aa7);--border:var(--myllm-border,#e3e3e8);\n  --radius:18px;--font:var(--myllm-font,-apple-system,system-ui,sans-serif);\n  --img:#eef3f4;\n}\n@media(prefers-color-scheme:dark){:root{--bg:var(--myllm-bg,#000);--surface:var(--myllm-surface,#1c1c1e);--text:var(--myllm-text,#f2f2f7);--muted:var(--myllm-muted,#8e8e93);--border:var(--myllm-border,#2c2c2e);--img:#15171a}}\n@property --h{ syntax:'<number>'; inherits:true; initial-value:184; }\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nbody{margin:0;font-family:var(--font);background:var(--bg);color:var(--text);padding:0 0 env(safe-area-inset-bottom)}\nbutton{font:inherit;cursor:pointer}button:active{transform:scale(.96)}\nsvg.i{width:1.25em;height:1.25em;fill:currentColor;flex-shrink:0;vertical-align:-.25em}\n.bar{position:sticky;top:0;z-index:10;background:var(--bg);border-bottom:1px solid var(--border);padding-top:env(safe-area-inset-top)}\n.lhead{max-width:760px;margin:0 auto;padding:calc(14px + env(safe-area-inset-top)) calc(14px + env(safe-area-inset-right)) 0 calc(14px + env(safe-area-inset-left))}\n.head{display:flex;align-items:center;gap:12px;margin:2px 2px 4px}\n.head .tile{display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0;width:44px;height:44px;border-radius:13px;font-size:19px;\n  background:linear-gradient(145deg,hsl(var(--h) 62% 50%),hsl(calc(var(--h) + 40) 58% 28%))}\n.head .tile svg.i{vertical-align:0}\n.head .ht{flex:1;min-width:0}\n.head h1{margin:0;font-size:22px;font-weight:800;letter-spacing:-.01em}\n.head p{margin:1px 0 0;font-size:13px;color:var(--muted)}\n.tabs{display:flex;gap:7px;overflow-x:auto;padding:10px calc(14px + env(safe-area-inset-right)) 10px calc(14px + env(safe-area-inset-left));scrollbar-width:none}.tabs::-webkit-scrollbar{display:none}\n.tab{flex:none;border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:999px;height:38px;padding:0 14px;font-size:13.5px;font-weight:650;white-space:nowrap;display:inline-flex;align-items:center;gap:6px}\n.tab.on{background:var(--accent);color:#fff;border-color:var(--accent)}\n.wrap{max-width:760px;margin:0 auto;padding:14px calc(14px + env(safe-area-inset-right)) 14px calc(14px + env(safe-area-inset-left))}\nh1{font-size:22px;font-weight:800;margin:4px 2px 12px}\n.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}\n.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;text-align:left;padding:0;color:inherit;position:relative}\n.card .ph{aspect-ratio:3/4;background:linear-gradient(160deg,hsl(var(--h) 45% 92%),hsl(calc(var(--h) + 30) 40% 86%));display:flex;align-items:center;justify-content:center}\n@media(prefers-color-scheme:dark){.card .ph{background:linear-gradient(160deg,hsl(var(--h) 30% 16%),hsl(calc(var(--h) + 30) 28% 12%))}}\n.card .ph img{width:100%;height:100%;object-fit:contain}\n.card .b{padding:10px 11px 12px}\n.card .b h3{margin:0;font-size:15px;line-height:1.25;font-weight:700}\n.card .b .m{font-size:12px;color:var(--muted);margin-top:3px}\n.card .fv{position:absolute;top:8px;right:8px;width:28px;height:28px;border-radius:50%;background:rgba(255,255,255,.85);color:#ff375f;display:none;align-items:center;justify-content:center;font-size:13px}\n.card.fav .fv{display:flex}\n.empty{text-align:center;padding:40px 20px}\n.empty .ico{width:64px;height:64px;border-radius:18px;margin:0 auto 12px;display:flex;align-items:center;justify-content:center;font-size:28px;color:#fff;background:linear-gradient(145deg,hsl(var(--h) 62% 46%),hsl(calc(var(--h) + 40) 58% 24%))}\n.empty b{display:block;font-size:16px;margin-bottom:4px}.empty p{margin:0;color:var(--muted);font-size:14px}\n.disc{color:var(--muted);font-size:12px;line-height:1.5;margin-top:18px;border-top:1px solid var(--border);padding-top:12px}\n\n/* detail */\n.detail{display:none}\n.dtop{display:flex;align-items:center;gap:8px;padding:calc(8px + env(safe-area-inset-top)) calc(12px + env(safe-area-inset-right)) 8px calc(12px + env(safe-area-inset-left));position:sticky;top:0;background:var(--bg);z-index:5;border-bottom:1px solid var(--border)}\n.dtop button{border:1px solid var(--border);background:var(--surface);color:var(--text);height:40px;min-width:40px;border-radius:999px;padding:0 14px;font-weight:650;font-size:14.5px;display:inline-flex;align-items:center;gap:6px}\n.dtop button.on{color:#ff375f;border-color:#ff375f}\n.dtop .sp{flex:1}\n.hero{aspect-ratio:3/4;max-height:46vh;background:linear-gradient(160deg,hsl(var(--h) 45% 92%),hsl(calc(var(--h) + 30) 40% 86%));border-radius:var(--radius);display:flex;align-items:center;justify-content:center;overflow:hidden;margin-bottom:14px}\n@media(prefers-color-scheme:dark){.hero{background:linear-gradient(160deg,hsl(var(--h) 30% 16%),hsl(calc(var(--h) + 30) 28% 12%))}}\n.hero img{width:100%;height:100%;object-fit:contain}\n.dname{font-size:26px;font-weight:800;margin:0 0 8px;letter-spacing:-.01em}\n.badges{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px}\n.badge{font-size:12px;font-weight:650;background:var(--surface);border:1px solid var(--border);color:var(--muted);border-radius:999px;padding:6px 11px;display:inline-flex;align-items:center;gap:5px}\n.badge.t{color:var(--accent);border-color:var(--accent)}\n.benefit{background:var(--surface);border:1px solid var(--border);border-left:3px solid var(--accent);border-radius:14px;padding:11px 14px;font-size:14.5px;margin-bottom:16px;line-height:1.45}\n.steps{list-style:none;margin:0 0 18px;padding:0;counter-reset:s}\n.steps li{counter-increment:s;position:relative;padding:0 0 14px 38px;font-size:16px;line-height:1.5}\n.steps li:before{content:counter(s);position:absolute;left:0;top:-1px;width:26px;height:26px;background:var(--accent);color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700}\n.hold{background:linear-gradient(145deg,hsl(var(--h) 62% 46%),hsl(calc(var(--h) + 40) 58% 24%));color:#fff;border-radius:var(--radius);padding:16px;margin-bottom:16px;display:flex;align-items:center;gap:14px;box-shadow:0 14px 34px hsl(var(--h) 60% 40% / .25)}\n.hold .n{font-size:38px;font-weight:800;font-variant-numeric:tabular-nums;line-height:1;min-width:64px}\n.hold .n small{display:block;font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;opacity:.8;margin-top:4px}\n.hold .t{flex:1;min-width:0;font-size:13.5px;opacity:.9;line-height:1.4}\n.hold button{border:1px solid rgba(255,255,255,.3);background:rgba(255,255,255,.18);color:#fff;border-radius:999px;height:44px;padding:0 16px;font-weight:750;display:inline-flex;align-items:center;gap:7px;-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px)}\n.aiBtn{width:100%;border:1px solid var(--border);background:var(--surface);color:var(--accent);border-radius:14px;height:48px;font-weight:650;font-size:15px;margin-bottom:10px;display:flex;align-items:center;justify-content:center;gap:8px}\n.aiBtn:disabled{opacity:.6}\n#aiTip{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:13px 15px;font-size:14.5px;line-height:1.5;display:none;margin-bottom:10px;white-space:pre-wrap}\n.dnav{display:flex;justify-content:space-between;gap:8px;margin:8px 0 24px}\n.dnav button{border:1px solid var(--border);background:var(--surface);color:var(--text);height:44px;border-radius:999px;padding:0 16px;font-weight:650;font-size:14.5px;display:inline-flex;align-items:center;gap:6px}\n.dnav button:disabled{opacity:.3}\n.dots:after{content:'';animation:d 1.1s steps(4) infinite}@keyframes d{0%{content:''}25%{content:'.'}50%{content:'..'}75%{content:'...'}}\n.sheet{position:fixed;inset:0;background:rgba(0,0,0,.5);display:none;align-items:center;justify-content:center;z-index:40;padding:24px}\n.sheet.show{display:flex}\n.sheetB{background:var(--bg);border-radius:22px;max-width:420px;padding:20px 22px}\n.sheetB h3{margin:0 0 8px;font-size:18px}.sheetB p{font-size:14px;line-height:1.55;color:var(--muted)}\n.sheetB button{margin-top:14px;width:100%;border:0;background:var(--accent);color:#fff;border-radius:14px;height:48px;font-weight:650}\n\n/* The hold: a full-screen stage — the illustration large, a ring counting the\n   hold down, glass controls. Two backdrop layers, dark and light, cross-faded. */\n.stage{display:none;position:fixed;inset:0;z-index:50;color:#fff;overflow:hidden}\n.stage.on{display:block}\n.stage .bg{position:absolute;inset:0;transition:opacity .6s ease}\n.stage .bg.d{background:radial-gradient(120% 90% at 20% 10%,hsl(var(--h) 60% 30%),transparent 60%),radial-gradient(120% 90% at 85% 95%,hsl(calc(var(--h) + 50) 55% 24%),transparent 62%),#0b0b10}\n.stage .bg.l{opacity:0;background:radial-gradient(120% 90% at 20% 0%,hsl(var(--h) 70% 84%),transparent 60%),radial-gradient(120% 90% at 85% 100%,hsl(calc(var(--h) + 50) 70% 87%),transparent 62%),#f4f4f8}\n.stage.lite{color:#15151a}.stage.lite .bg.l{opacity:1}.stage.lite .bg.d{opacity:0}\n.glass{border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.12);color:inherit;-webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px)}\n.stage.lite .glass{border-color:rgba(0,0,0,.09);background:rgba(255,255,255,.62)}\n.stage .col{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;text-align:center;\n  padding:calc(12px + env(safe-area-inset-top)) calc(20px + env(safe-area-inset-right)) calc(20px + env(safe-area-inset-bottom)) calc(20px + env(safe-area-inset-left))}\n.stage .top{width:100%;max-width:520px;height:44px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0}\n.stage .lbl{font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;opacity:.62}\n.rnd{width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:15px}\n.stage .mid{flex:1;min-height:0;width:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px}\n.stage .art{width:min(60vw,44vh,300px);height:min(60vw,44vh,300px);border-radius:30px;overflow:hidden;flex-shrink:0;background:rgba(255,255,255,.08);box-shadow:0 24px 60px rgba(0,0,0,.4)}\n.stage.lite .art{background:rgba(255,255,255,.5);box-shadow:0 22px 50px rgba(20,20,40,.18)}\n.stage .art img{width:100%;height:100%;object-fit:contain}\n.stage .ringbox{position:relative;width:min(38vw,150px);height:min(38vw,150px);flex-shrink:0}\n.stage .ringbox svg{position:absolute;inset:0;width:100%;height:100%;transform:rotate(-90deg)}\n.stage .ringbox circle{fill:none;stroke-width:8;stroke-linecap:round}\n.stage .ringbox .tr{stroke:currentColor;stroke-opacity:.15}\n.stage .ringbox .pr{stroke:hsl(var(--h) 90% 70%);transition:stroke-dashoffset .25s linear}\n.stage.lite .ringbox .pr{stroke:hsl(var(--h) 80% 40%)}\n.stage .num{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:min(13vw,52px);font-weight:800;font-variant-numeric:tabular-nums;letter-spacing:-.02em}\n.stage .sname{font-size:22px;font-weight:800;letter-spacing:-.01em;max-width:520px}\n.stage .sstate{font-size:11.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;opacity:.7;min-height:16px}\n.stage .ctl{display:flex;align-items:center;justify-content:center;gap:22px;flex-shrink:0;margin-top:6px}\n.stage .ctl .side{width:56px;height:56px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:19px}\n.stage .ctl .big{width:84px;height:84px;border-radius:50%;border:none;background:#fff;color:#0b0b10;font-size:28px;display:flex;align-items:center;justify-content:center;box-shadow:0 10px 30px rgba(0,0,0,.35)}\n.stage.lite .ctl .big{background:#15151a;color:#fff;box-shadow:0 10px 26px rgba(20,20,40,.25)}\n@media (max-height:520px){\n  .stage .col{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);grid-template-rows:44px minmax(0,1fr);column-gap:24px}\n  .stage .top{grid-column:1 / 3}\n  .stage .mid{display:contents}\n  .stage .art{grid-column:1;grid-row:2;align-self:center;justify-self:center}\n  .stage .art{width:min(36vw,calc(100vh - 88px),260px);height:min(36vw,calc(100vh - 88px),260px)}\n  .stage .words{grid-column:2;grid-row:2;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px}\n  .stage .ringbox{width:min(26vh,110px);height:min(26vh,110px)}\n  .stage .ctl{grid-column:2;grid-row:2;align-self:end;margin:0 0 4px}\n  .stage .sname{font-size:19px}\n}\n@media (prefers-reduced-motion:reduce){.stage .bg,.stage .ringbox .pr{transition:none}.dots:after{animation:none;content:'…'}}\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-stretch\" viewBox=\"0 0 24 24\"><path d=\"M12 2.2a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM4.6 6.6a1 1 0 0 0-.4 1.9L9 10.6V14l-2.3 6.6a1 1 0 0 0 1.9.7L10.8 15h2.4l2.2 6.3a1 1 0 0 0 1.9-.7L15 14v-3.4l4.8-2.1a1 1 0 1 0-.8-1.9l-5.3 2.3h-3.4L5.3 6.6a1 1 0 0 0-.7 0z\"/></symbol>\n  <symbol id=\"i-play\" viewBox=\"0 0 24 24\"><path d=\"M8 5.5v13a1 1 0 0 0 1.52.85l10.4-6.5a1 1 0 0 0 0-1.7L9.52 4.65A1 1 0 0 0 8 5.5z\"/></symbol>\n  <symbol id=\"i-pause\" viewBox=\"0 0 24 24\"><rect x=\"6\" y=\"5\" width=\"4.2\" height=\"14\" rx=\"1.4\"/><rect x=\"13.8\" y=\"5\" width=\"4.2\" height=\"14\" rx=\"1.4\"/></symbol>\n  <symbol id=\"i-reset\" viewBox=\"0 0 24 24\"><path d=\"M12 5V2.6a.6.6 0 0 0-1-.45L7.2 5.55a.6.6 0 0 0 0 .9L11 9.85a.6.6 0 0 0 1-.45V7a5.5 5.5 0 1 1-5.5 5.5 1 1 0 0 0-2 0A7.5 7.5 0 1 0 12 5z\"/></symbol>\n  <symbol id=\"i-close\" viewBox=\"0 0 24 24\"><path d=\"M6.4 5a1 1 0 0 0-1.4 1.4L10.6 12 5 17.6A1 1 0 0 0 6.4 19l5.6-5.6 5.6 5.6a1 1 0 0 0 1.4-1.4L13.4 12 19 6.4A1 1 0 0 0 17.6 5L12 10.6z\"/></symbol>\n  <symbol id=\"i-back\" viewBox=\"0 0 24 24\"><path d=\"M14.7 5.3a1 1 0 0 0-1.4 0l-6 6a1 1 0 0 0 0 1.4l6 6a1 1 0 0 0 1.4-1.4L9.4 12l5.3-5.3a1 1 0 0 0 0-1.4z\"/></symbol>\n  <symbol id=\"i-fwd\" viewBox=\"0 0 24 24\"><path d=\"M9.3 5.3a1 1 0 0 1 1.4 0l6 6a1 1 0 0 1 0 1.4l-6 6a1 1 0 0 1-1.4-1.4l5.3-5.3-5.3-5.3a1 1 0 0 1 0-1.4z\"/></symbol>\n  <symbol id=\"i-heart\" viewBox=\"0 0 24 24\"><path d=\"M12 21s-7.5-4.6-9.3-9.6C1.5 8 3.6 4.5 7.2 4.5c1.9 0 3.4 1 4.8 2.6 1.4-1.6 2.9-2.6 4.8-2.6 3.6 0 5.7 3.5 4.5 6.9C19.5 16.4 12 21 12 21z\"/></symbol>\n  <symbol id=\"i-heart-o\" viewBox=\"0 0 24 24\"><path d=\"M7.2 6.5c-2.2 0-3.5 2.2-2.6 4.2C5.8 14 9.7 17.2 12 18.7c2.3-1.5 6.2-4.7 7.4-8 .9-2-.4-4.2-2.6-4.2-1.2 0-2.2.7-3.3 2L12 10.3l-1.5-1.8c-1.1-1.3-2.1-2-3.3-2zM12 21s-7.5-4.6-9.3-9.6C1.5 8 3.6 4.5 7.2 4.5c1.9 0 3.4 1 4.8 2.6 1.4-1.6 2.9-2.6 4.8-2.6 3.6 0 5.7 3.5 4.5 6.9C19.5 16.4 12 21 12 21z\"/></symbol>\n  <symbol id=\"i-timer\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5a9.5 9.5 0 1 0 0 19 9.5 9.5 0 0 0 0-19zm0 2a7.5 7.5 0 1 1 0 15 7.5 7.5 0 0 1 0-15zM11 7v5.4l3.6 2.2a1 1 0 0 0 1-1.7L13 11.3V7a1 1 0 0 0-2 0z\"/></symbol>\n  <symbol id=\"i-bulb\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5a6.5 6.5 0 0 0-3.8 11.8c.5.4.8.9.8 1.5v.7a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1v-.7c0-.6.3-1.1.8-1.5A6.5 6.5 0 0 0 12 2.5zM9.5 19a1 1 0 0 0 0 2h5a1 1 0 0 0 0-2z\"/></symbol>\n</defs></svg>\n<div id=\"library\">\n  <div class=\"lhead\"><div class=\"imm-safe\"></div><div class=\"head\">\n    <div class=\"tile\"><svg class=\"i\"><use href=\"#i-stretch\"/></svg></div>\n    <div class=\"ht\"><h1>Stretch</h1><p>A stretch library with a hold timer</p></div>\n  <div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Stretch\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div></div>\n  <div class=\"bar\"><div class=\"tabs\" id=\"tabs\"></div></div>\n  <div class=\"wrap\">\n    <div class=\"grid\" id=\"grid\"></div>\n    <div class=\"empty\" id=\"empty\" style=\"display:none\"><div class=\"ico\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></div><b>No favourites yet</b><p>Tap the heart on a stretch to save it here.</p></div>\n    <p class=\"disc\">These stretches are general wellbeing suggestions, not medical advice. Move gently and slowly, never stretch into pain, and check with a healthcare professional if you have an injury or health condition. <a href=\"#\" id=\"discLink\" style=\"color:var(--accent)\">More</a></p>\n  </div>\n</div>\n\n<div class=\"detail\" id=\"detail\">\n  <div class=\"dtop\"><button id=\"back\"><svg class=\"i\"><use href=\"#i-back\"/></svg>Back</button><div class=\"sp\"></div><button id=\"favBtn\" aria-label=\"Favourite\"><svg class=\"i\"><use href=\"#i-heart-o\"/></svg></button></div>\n  <div class=\"wrap\">\n    <div class=\"hero\"><img id=\"dimg\" alt=\"\"></div>\n    <h1 class=\"dname\" id=\"dname\"></h1>\n    <div class=\"badges\" id=\"dbadges\"></div>\n    <div class=\"benefit\" id=\"dbenefit\"></div>\n    <ol class=\"steps\" id=\"dsteps\"></ol>\n    <div class=\"hold\">\n      <div class=\"n\"><span id=\"holdN\">30</span><small>seconds</small></div>\n      <div class=\"t\">Hold it full screen, with a count you can see from the floor.</div>\n      <button id=\"tStart\"><svg class=\"i\"><use href=\"#i-play\"/></svg>Hold</button>\n    </div>\n    <button class=\"aiBtn\" id=\"aiBtn\"><svg class=\"i\"><use href=\"#i-bulb\"/></svg>Tip &amp; easier option</button>\n    <div id=\"aiTip\"></div>\n    <div class=\"dnav\"><button id=\"prev\"><svg class=\"i\"><use href=\"#i-back\"/></svg>Previous</button><button id=\"next\">Next<svg class=\"i\"><use href=\"#i-fwd\"/></svg></button></div>\n  </div>\n</div>\n\n<div class=\"stage\" id=\"stage\">\n  <div class=\"bg d\"></div><div class=\"bg l\"></div>\n  <div class=\"col\">\n    <div class=\"top\">\n      <button class=\"glass rnd\" id=\"sClose\" aria-label=\"Stop\"><svg class=\"i\"><use href=\"#i-close\"/></svg></button>\n      <div class=\"lbl\">Hold</div>\n      <div class=\"rnd\" style=\"visibility:hidden\"></div>\n    </div>\n    <div class=\"mid\">\n      <div class=\"art\"><img id=\"simg\" alt=\"\"></div>\n      <div class=\"words\">\n        <div class=\"ringbox\"><svg viewBox=\"0 0 120 120\" aria-hidden=\"true\"><circle class=\"tr\" cx=\"60\" cy=\"60\" r=\"52\"/><circle class=\"pr\" id=\"spr\" cx=\"60\" cy=\"60\" r=\"52\" stroke-dasharray=\"326.7\" stroke-dashoffset=\"0\"/></svg><div class=\"num\" id=\"snum\">30</div></div>\n        <div class=\"sname\" id=\"sname\"></div>\n        <div class=\"sstate\" id=\"sstate\">Ready</div>\n      </div>\n    </div>\n    <div class=\"ctl\">\n      <button class=\"glass side\" id=\"sReset\" aria-label=\"Reset\"><svg class=\"i\"><use href=\"#i-reset\"/></svg></button>\n      <button class=\"big\" id=\"sGo\" aria-label=\"Start or pause\"><svg class=\"i\"><use href=\"#i-play\"/></svg></button>\n      <div class=\"side\" style=\"visibility:hidden\"></div>\n    </div>\n  </div>\n</div>\n\n<div class=\"sheet\" id=\"sheet\"><div class=\"sheetB\"><h3>Stay safe</h3><p>These stretches are general wellbeing suggestions, not medical advice. Warm up first, move slowly, breathe, and never push into pain. Ease off if you feel sharp or unusual discomfort. If you're pregnant, injured, or have a health condition, check with a healthcare professional before starting.</p><button id=\"sheetOk\">Got it</button></div></div>\n\n<script>\nvar IMG=\"https://raw.githubusercontent.com/TeamDzX/myllm-assets/main/apps/stretches/\";\nvar CATS=[[\"all\",\"All\"],[\"fav\",\"Favourites\"],[\"neck\",\"Neck & Shoulders\"],[\"back\",\"Back\"],[\"hips\",\"Hips\"],[\"legs\",\"Legs\"],[\"desk\",\"Desk & Wrists\"],[\"full\",\"Full Body\"]];\nvar S=[\n {id:\"neck-side\",name:\"Neck Side Stretch\",cat:\"neck\",target:\"Neck, upper traps\",hold:\"20–30s each side\",level:\"Easy\",benefit:\"Eases neck and shoulder tension from screens and phones.\",steps:[\"Sit or stand tall, shoulders relaxed down.\",\"Slowly tilt your right ear toward your right shoulder.\",\"Rest your right hand lightly on your head for a gentle pull.\",\"Breathe, hold, then switch sides.\"]},\n {id:\"shoulder-rolls\",name:\"Shoulder Rolls\",cat:\"neck\",target:\"Shoulders, upper back\",hold:\"10 rolls each way\",level:\"Easy\",benefit:\"Loosens stiff shoulders and resets your posture.\",steps:[\"Stand or sit tall with arms relaxed.\",\"Lift your shoulders up toward your ears.\",\"Roll them back and down in a smooth circle.\",\"Repeat, then reverse the direction.\"]},\n {id:\"cross-shoulder\",name:\"Cross-Body Shoulder Stretch\",cat:\"neck\",target:\"Rear shoulder\",hold:\"20–30s each side\",level:\"Easy\",benefit:\"Relieves tight shoulders after lifting or sitting.\",steps:[\"Bring one straight arm across your chest.\",\"Use the other hand to gently press it closer.\",\"Keep your shoulders down — don't shrug.\",\"Hold, then switch arms.\"]},\n {id:\"cat-cow\",name:\"Cat–Cow\",cat:\"back\",target:\"Whole spine\",hold:\"8–10 slow rounds\",level:\"Easy\",benefit:\"Mobilises the whole spine and warms up the back.\",steps:[\"Start on hands and knees, wrists under shoulders.\",\"Exhale and round your back up like a cat.\",\"Inhale and let your belly drop, chest lifting.\",\"Move slowly, following your breath.\"]},\n {id:\"childs-pose\",name:\"Child's Pose\",cat:\"back\",target:\"Lower back, hips\",hold:\"30–60s\",level:\"Easy\",benefit:\"Gently decompresses the lower back; very calming.\",steps:[\"Kneel and sit back onto your heels.\",\"Fold forward and walk your hands out in front.\",\"Rest your forehead toward the floor.\",\"Relax and breathe into your back.\"]},\n {id:\"seated-twist\",name:\"Seated Spinal Twist\",cat:\"back\",target:\"Spine, obliques\",hold:\"20–30s each side\",level:\"Easy\",benefit:\"Improves spinal mobility and eases back stiffness.\",steps:[\"Sit tall, legs crossed or extended.\",\"Place one hand on the opposite knee.\",\"Twist your torso and gaze over your shoulder.\",\"Lengthen up on each inhale; hold, then switch.\"]},\n {id:\"figure-four\",name:\"Figure-Four Glute Stretch\",cat:\"hips\",target:\"Glutes, hips\",hold:\"30s each side\",level:\"Easy\",benefit:\"Opens tight glutes and hips from long sitting.\",steps:[\"Lie on your back, knees bent.\",\"Cross one ankle over the opposite thigh.\",\"Hold behind that thigh and draw it toward you.\",\"Keep your head down; hold, then switch.\"]},\n {id:\"low-lunge\",name:\"Low Lunge Hip Flexor\",cat:\"hips\",target:\"Hip flexors, quads\",hold:\"30s each side\",level:\"Medium\",benefit:\"Releases hip flexors tightened by sitting all day.\",steps:[\"Step one foot forward into a lunge.\",\"Lower the back knee to the floor.\",\"Keep your torso tall and tuck the hips slightly.\",\"Press gently forward; hold, then switch.\"]},\n {id:\"butterfly\",name:\"Butterfly Stretch\",cat:\"hips\",target:\"Inner thighs, groin\",hold:\"30–45s\",level:\"Easy\",benefit:\"Opens the inner thighs and groin.\",steps:[\"Sit and bring the soles of your feet together.\",\"Let your knees fall out to the sides.\",\"Hold your feet and sit up tall.\",\"Optionally fold gently forward.\"]},\n {id:\"hamstring\",name:\"Standing Hamstring Fold\",cat:\"legs\",target:\"Hamstrings, lower back\",hold:\"30s\",level:\"Easy\",benefit:\"Lengthens tight hamstrings and calms the mind.\",steps:[\"Stand with feet hip-width, knees soft.\",\"Hinge at the hips and fold forward.\",\"Let your head and arms hang toward the floor.\",\"Bend the knees as needed; rise slowly.\"]},\n {id:\"quad\",name:\"Standing Quad Stretch\",cat:\"legs\",target:\"Quadriceps\",hold:\"30s each side\",level:\"Medium\",benefit:\"Stretches the front thighs after walking or running.\",steps:[\"Stand tall, hold something for balance.\",\"Bend one knee and grab that foot behind you.\",\"Draw the heel toward your glute, knees together.\",\"Stand tall; hold, then switch.\"]},\n {id:\"calf\",name:\"Standing Calf Stretch\",cat:\"legs\",target:\"Calves\",hold:\"30s each side\",level:\"Easy\",benefit:\"Eases tight calves and supports ankle mobility.\",steps:[\"Face a wall, hands at chest height.\",\"Step one foot back, that leg straight.\",\"Press the back heel into the floor.\",\"Lean in gently; hold, then switch.\"]},\n {id:\"wrist-flexor\",name:\"Wrist Flexor Stretch\",cat:\"desk\",target:\"Forearm, wrist\",hold:\"20–30s each side\",level:\"Easy\",benefit:\"Relieves wrist strain from typing and mouse use.\",steps:[\"Extend one arm forward, palm up.\",\"With the other hand, pull the fingers down and back.\",\"Keep the elbow straight.\",\"Hold, then switch hands.\"]},\n {id:\"wrist-extensor\",name:\"Wrist Extensor Stretch\",cat:\"desk\",target:\"Forearm, wrist\",hold:\"20–30s each side\",level:\"Easy\",benefit:\"Counters tightness on top of the forearm from desk work.\",steps:[\"Extend one arm forward, palm down.\",\"With the other hand, gently pull the hand downward.\",\"Keep the elbow straight.\",\"Hold, then switch hands.\"]},\n {id:\"chest-opener\",name:\"Seated Chest Opener\",cat:\"desk\",target:\"Chest, shoulders\",hold:\"20–30s\",level:\"Easy\",benefit:\"Reverses the rounded-shoulder slump of desk work.\",steps:[\"Sit or stand tall.\",\"Clasp your hands behind your lower back.\",\"Gently straighten your arms and lift them slightly.\",\"Open your chest and breathe.\"]},\n {id:\"side-bend\",name:\"Standing Side Bend\",cat:\"full\",target:\"Obliques, side body\",hold:\"20–30s each side\",level:\"Easy\",benefit:\"Lengthens the side body and helps you breathe deeper.\",steps:[\"Stand tall, reach both arms overhead.\",\"Clasp your hands and lean to one side.\",\"Keep both feet grounded.\",\"Feel the stretch along your side; switch.\"]},\n {id:\"downward-dog\",name:\"Downward-Facing Dog\",cat:\"full\",target:\"Whole body\",hold:\"30–45s\",level:\"Medium\",benefit:\"A full-body stretch for shoulders, back and legs.\",steps:[\"From hands and knees, tuck your toes.\",\"Lift your hips up and back into an inverted V.\",\"Press your hands down, ease your heels toward the floor.\",\"Relax your neck and breathe.\"]},\n {id:\"standing-backbend\",name:\"Gentle Standing Backbend\",cat:\"full\",target:\"Front body, spine\",hold:\"10–15s\",level:\"Easy\",benefit:\"Opens the chest and counters forward hunching.\",steps:[\"Stand tall, hands supporting your lower back.\",\"Lift your chest and gently arch backward.\",\"Look slightly up; keep it small and comfortable.\",\"Return to standing slowly.\"]}\n];\nvar cat=\"all\",favs=[],list=[],di=0,timer=null,tleft=0,ttotal=30;\nfunction $(i){return document.getElementById(i)}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nfunction holdSecs(h){var m=(h||'').match(/\\d+/g);if(!m)return 30;return parseInt(m[m.length>1?1:0])||30}\n\nfunction tabs(){\n  var t=$('tabs');t.innerHTML='';\n  CATS.forEach(function(c){var b=document.createElement('button');b.className='tab'+(c[0]===cat?' on':'');b.textContent=c[1];\n    if(c[0]==='fav')b.insertAdjacentHTML('afterbegin','<svg class=\"i\"><use href=\"#i-heart\"/></svg>');\n    b.onclick=function(){cat=c[0];haptic('selection');tabs();renderGrid();window.scrollTo(0,0)};t.appendChild(b)});\n}\nfunction filtered(){return cat==='all'?S:cat==='fav'?S.filter(function(s){return favs.indexOf(s.id)>=0}):S.filter(function(s){return s.cat===cat})}\nfunction renderGrid(){\n  list=filtered();var g=$('grid');g.innerHTML='';\n  $('empty').style.display=(cat==='fav'&&!list.length)?'block':'none';\n  list.forEach(function(s,i){\n    var c=document.createElement('button');c.className='card'+(favs.indexOf(s.id)>=0?' fav':'');\n    c.innerHTML='<div class=\"fv\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></div><div class=\"ph\"><img loading=\"lazy\" src=\"'+IMG+s.id+'.jpg\" alt=\"'+esc(s.name)+'\" onerror=\"this.style.display=\\'none\\'\"></div><div class=\"b\"><h3>'+esc(s.name)+'</h3><div class=\"m\">'+esc(s.target)+' · '+esc(s.hold)+'</div></div>';\n    c.onclick=function(){openDetail(i)};g.appendChild(c);\n  });\n}\nfunction esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;')}\n\nfunction openDetail(i){\n  di=i;var s=list[i];\n  $('library').style.display='none';$('detail').style.display='block';window.scrollTo(0,0);\n  // Animated illustration when available: looping WebP in a plain <img> —\n  // autoplays, no video element, so iOS never shows player chrome on it.\n  var d=$('dimg');d.alt=s.name;\n  d.onerror=function(){this.onerror=null;this.src=IMG+s.id+'.jpg'};\n  d.src=IMG+s.id+'.webp';\n  $('dname').textContent=s.name;\n  $('dbadges').innerHTML='<span class=\"badge t\">'+esc(s.target)+'</span><span class=\"badge\"><svg class=\"i\"><use href=\"#i-timer\"/></svg>'+esc(s.hold)+'</span><span class=\"badge\">'+esc(s.level)+'</span>';\n  $('dbenefit').textContent=s.benefit;\n  $('dsteps').innerHTML=s.steps.map(function(x){return '<li>'+esc(x)+'</li>'}).join('');\n  $('aiTip').style.display='none';$('aiTip').textContent='';\n  $('prev').disabled=(i===0);$('next').disabled=(i===list.length-1);\n  updateFav();resetTimer(holdSecs(s.hold));\n}\nfunction updateFav(){var on=favs.indexOf(list[di].id)>=0;$('favBtn').innerHTML='<svg class=\"i\"><use href=\"#i-heart'+(on?'':'-o')+'\"/></svg>';$('favBtn').className=on?'on':''}\n$('favBtn').onclick=function(){var id=list[di].id,k=favs.indexOf(id);if(k>=0)favs.splice(k,1);else favs.push(id);save();updateFav();haptic('success')};\n$('back').onclick=function(){closeStage();$('detail').style.display='none';$('library').style.display='block';renderGrid()};\n$('prev').onclick=function(){if(di>0){haptic('selection');closeStage();openDetail(di-1)}};\n$('next').onclick=function(){if(di<list.length-1){haptic('selection');closeStage();openDetail(di+1)}};\n\n// hold timer — a full-screen stage, timed from an end stamp (Date.now), so a\n// backgrounded web view or a dropped frame can't shorten the hold. The screen\n// is kept awake while holding: you can't tap a phone from a lunge.\nvar stageOn=false,holdEnd=0,holdLeft=0,raf=0,CIRC=326.7;\nfunction isLight(){return !(window.matchMedia&&matchMedia('(prefers-color-scheme: dark)').matches)}\n/* Where MyLLM can't hide its own title bar, a dark stage under a white bar\n   looks cut in half — so in light mode, without myllmImmersive, it stays light. */\nfunction syncLook(){$('stage').classList.toggle('lite',isLight()&&!(stageOn&&window.myllmImmersive))}\nfunction syncChrome(){\n  if(!window.myllmImmersive)return;\n  try{myllmImmersive((window.myllmClose ? true : (stageOn)), {keepAwake:stageOn&&!!timer}).catch(function(){})}catch(e){}\n}\nfunction paintHold(){\n  var left=timer?Math.max(0,holdEnd-Date.now()):holdLeft*1000;\n  var n=Math.ceil(left/1000);\n  $('holdN').textContent=n;$('snum').textContent=n;\n  $('spr').setAttribute('stroke-dashoffset',(CIRC*(1-left/(ttotal*1000))).toFixed(1));\n  if(timer){\n    if(left<=0){finishHold();return}\n    raf=requestAnimationFrame(paintHold);\n  }\n}\nfunction finishHold(){\n  timer=null;cancelAnimationFrame(raf);holdLeft=0;\n  $('sstate').textContent='Done — ease out slowly';\n  $('sGo').innerHTML='<svg class=\"i\"><use href=\"#i-reset\"/></svg>';$('tStart').innerHTML='<svg class=\"i\"><use href=\"#i-play\"/></svg>Again';\n  haptic('success');syncChrome();\n}\nfunction resetTimer(sec){stopTimer();ttotal=sec;tleft=sec;holdLeft=sec;$('sstate').textContent='Ready';\n  $('sGo').innerHTML='<svg class=\"i\"><use href=\"#i-play\"/></svg>';$('tStart').innerHTML='<svg class=\"i\"><use href=\"#i-play\"/></svg>Hold';paintHold()}\nfunction stopTimer(){if(timer){holdLeft=Math.max(0,(holdEnd-Date.now())/1000);timer=null;cancelAnimationFrame(raf)}}\nfunction startHold(){\n  if(holdLeft<=0)holdLeft=ttotal;\n  holdEnd=Date.now()+holdLeft*1000;timer=true;\n  $('sstate').textContent='Hold and breathe';$('sGo').innerHTML='<svg class=\"i\"><use href=\"#i-pause\"/></svg>';\n  haptic('light');syncChrome();paintHold();\n}\nfunction pauseHold(){stopTimer();$('sstate').textContent='Paused';$('sGo').innerHTML='<svg class=\"i\"><use href=\"#i-play\"/></svg>';haptic('light');syncChrome();paintHold()}\nfunction openStage(){\n  var s=list[di];stageOn=true;\n  $('sname').textContent=s.name;\n  var im=$('simg');im.onerror=function(){this.onerror=null;this.src=IMG+s.id+'.jpg'};im.src=$('dimg').src||(IMG+s.id+'.webp');\n  $('stage').classList.add('on');syncLook();\n  if(!timer)startHold();else syncChrome();\n}\nfunction closeStage(){\n  if(!stageOn){stopTimer();return}\n  stopTimer();stageOn=false;$('stage').classList.remove('on');syncLook();syncChrome();\n  if(holdLeft>0&&holdLeft<ttotal){$('tStart').innerHTML='<svg class=\"i\"><use href=\"#i-play\"/></svg>Resume'}\n  paintHold();\n}\n$('tStart').onclick=openStage;\n$('sGo').onclick=function(){if(timer)pauseHold();else if(holdLeft<=0){resetTimer(ttotal);startHold()}else startHold()};\n$('sReset').onclick=function(){resetTimer(ttotal);haptic('selection')};\n$('sClose').onclick=closeStage;\ndocument.addEventListener('visibilitychange',function(){\n  if(document.hidden){if(timer)pauseHold();return}\n  if(stageOn)syncChrome();      /* MyLLM puts its bars back when the app is left */\n});\nif(window.matchMedia){\n  var mq=matchMedia('(prefers-color-scheme: dark)');\n  if(mq.addEventListener)mq.addEventListener('change',syncLook);else if(mq.addListener)mq.addListener(syncLook);\n}\n\n// AI tip\n$('aiBtn').onclick=function(){\n  var s=list[di];\n  if(!window.myllmAsk){var t=$('aiTip');t.style.display='block';t.textContent='Turn on “Allow apps to use the AI” in Settings → MyLLMos Apps to get a personalised tip.';return}\n  $('aiBtn').disabled=true;var t=$('aiTip');t.style.display='block';t.innerHTML='<span class=\"dots\">Thinking</span>';haptic('light');\n  myllmAsk('Give one short, friendly tip plus an easier modification for the \"'+s.name+'\" stretch (targets: '+s.target+'). Two sentences max. Be safe and encouraging.',\n    {system:'You are a careful, friendly mobility and stretching coach. Keep advice short, gentle and safe. Never diagnose or give medical advice.'})\n   .then(function(r){t.textContent=(r||'').trim()||'Try again in a moment.'})\n   .catch(function(){t.textContent='Couldn’t get a tip right now.'})\n   .then(function(){$('aiBtn').disabled=false});\n};\n\n$('discLink').onclick=function(e){e.preventDefault();$('sheet').classList.add('show')};\n$('sheetOk').onclick=function(){$('sheet').classList.remove('show')};\n$('sheet').onclick=function(e){if(e.target===$('sheet'))$('sheet').classList.remove('show')};\n\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction save(){var st=window.myllmStorage;if(st)try{st.setItem('stretch',JSON.stringify({favs:favs})).catch(function(){})}catch(e){}}\nfunction load(){\n  tabs();\n  var st=window.myllmStorage;\n  if(!st){renderGrid();return}\n  st.getItem('stretch').then(function(v){if(v)try{favs=(JSON.parse(v).favs)||[]}catch(e){}renderGrid()}).catch(function(){renderGrid()});\n}\nload();\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes.\n   The spacer keeps the header clear of the status bar / Dynamic Island. It is\n   live CSS — env(safe-area-inset-top) — not a measured number: the inset is\n   still 0 when the page loads and only grows once MyLLM's bar has gone (v1\n   measured once, so the title sat under the island). If the page's own styles\n   already pad the header down by the inset, the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  /* Does any rule that applies to the header or an ancestor already use the top inset? */\n  function pageHandlesInset(head){\n    var chain = [], n, found = false;\n    for (n = head; n && n.nodeType === 1; n = n.parentElement) chain.push(n);\n    function walk(rules){\n      for (var i = 0; i < rules.length && !found; i++){\n        var r = rules[i];\n        if (r.cssRules && !r.selectorText) { walk(r.cssRules); continue; }\n        if (!r.selectorText || !/safe-area-inset-top/.test(r.cssText) || !/(padding|margin|top)\\s*:/.test(r.cssText)) continue;\n        if (/\\.imm-safe/.test(r.selectorText)) continue;\n        for (var k = 0; k < chain.length; k++){\n          try { if (chain[k].matches(r.selectorText)) { found = true; break; } } catch(e){}\n        }\n      }\n    }\n    for (var s = 0; s < document.styleSheets.length && !found; s++){\n      try { walk(document.styleSheets[s].cssRules); } catch(e){}\n    }\n    for (n = head; n && n.nodeType === 1 && !found; n = n.parentElement){\n      if (/safe-area-inset-top/.test(n.getAttribute(\"style\") || \"\")) found = true;\n    }\n    return found;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = (document.body.classList.contains(\"imm\") && !pageHandlesInset(head)) ? \"env(safe-area-inset-top)\" : \"0px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script>\n</body>\n</html>\n"}