{"name": "Post Studio", "kind": "html", "iconSymbol": "square.and.pencil", "iconColor": "orange", "html": "<!doctype html>\n<!--\n  Post Studio — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Post Studio</title>\n<style>\n:root{ color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); --h:24; --brand:hsl(var(--h) 88% 50%); }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink); font-size:15.5px;\n    max-width:600px; margin:0 auto; min-height:100dvh;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:760px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.96); }\n  [hidden]{ display:none !important; }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 28%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  .lbl{ display:block; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:0 2px 8px; }\n\n  /* art strip (the old banner, now without its title) */\n  .art{ height:72px; border-radius:18px; background:#432 center/cover; margin-bottom:12px; }\n\n  /* the post is the hero */\n  .post{ border-radius:20px; padding:14px; margin-bottom:12px; background:var(--surface); border:1px solid var(--line);\n    box-shadow:0 10px 28px hsl(var(--h) 60% 30% / .12); }\n  .post .top{ display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:10px; }\n  .post .who{ display:flex; align-items:center; gap:9px; min-width:0; }\n  .post .who .tile{ width:30px; height:30px; border-radius:9px; font-size:13px; }\n  .post .who b{ font-size:14px; font-weight:750; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .post .who span{ display:block; font-size:12px; color:var(--muted); font-weight:500; }\n  textarea{ width:100%; min-height:150px; font:inherit; font-size:17px; line-height:1.5; padding:0; resize:vertical; border:0; outline:0;\n    background:transparent; color:var(--ink); }\n  textarea::placeholder{ color:var(--muted); }\n  .meter{ margin-top:10px; }\n  .meter .bar{ height:5px; border-radius:99px; background:var(--fill); overflow:hidden; }\n  .meter .bar i{ display:block; height:100%; width:0; border-radius:99px; background:var(--brand); transition:width .2s, background .2s; }\n  .meter .bar i.over{ background:#ff3b30; }\n  .meta{ display:flex; justify-content:space-between; align-items:center; margin-top:7px; font-size:12.5px; color:var(--muted); font-variant-numeric:tabular-nums; }\n  .meta b{ font-weight:700; }\n  .meta b.over{ color:#ff3b30; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  .chips{ display:flex; flex-wrap:wrap; gap:7px; }\n  .chip{ min-height:36px; border:1px solid var(--line); background:var(--bg); border-radius:99px; padding:0 14px; font-size:13.5px; font-weight:650; }\n  .chip.on{ background:var(--brand); border-color:transparent; color:#fff; }\n\n  .actions{ display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:8px; }\n  .actions button{ min-height:46px; border:1px solid var(--line); border-radius:13px; padding:0 8px; font-size:14px; font-weight:700; background:var(--bg);\n    display:flex; align-items:center; justify-content:center; gap:7px; }\n  .actions button svg{ color:var(--brand); }\n  .actions button:disabled{ opacity:.5; }\n  .actions button.primary{ grid-column:1 / -1; background:var(--brand); border-color:transparent; color:#fff; min-height:50px; font-size:15.5px; }\n  .actions button.primary svg{ color:#fff; }\n  .spin{ width:15px; height:15px; border-radius:50%; border:2.3px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n  .aihint{ display:flex; gap:9px; align-items:flex-start; font-size:13px; color:var(--muted); margin-top:10px; line-height:1.45; }\n  .aihint:empty{ display:none; }\n  .aihint.err{ color:var(--ink); background:rgba(255,159,10,.12); border-radius:12px; padding:10px 11px; }\n\n  .out{ margin-top:10px; }\n  .out:empty{ display:none; }\n  .piece{ background:var(--bg); border:1px solid var(--line); border-radius:14px; padding:12px; margin-bottom:8px; font-size:15px; line-height:1.45; white-space:pre-wrap; overflow-wrap:anywhere; }\n  .piece:last-child{ margin-bottom:0; }\n  .piece small{ display:block; margin-top:7px; font-size:11.5px; color:var(--muted); white-space:normal; }\n  .piece .rowbtns{ display:flex; gap:8px; margin-top:9px; white-space:normal; }\n  .piece .rowbtns button{ min-height:36px; border:none; border-radius:10px; padding:0 13px; font-size:13px; font-weight:700; background:var(--brand); color:#fff;\n    display:inline-flex; align-items:center; gap:6px; }\n  .piece .rowbtns button.ghost{ background:var(--surface); color:var(--ink); border:1px solid var(--line); }\n\n  .drafts .row{ display:flex; align-items:center; gap:8px; padding:6px 0; border-bottom:1px solid var(--line); font-size:14px; }\n  .drafts .row:last-child{ border-bottom:none; }\n  .drafts .row span{ flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  .drafts .row button{ min-height:36px; border:1px solid var(--line); border-radius:10px; background:var(--bg); padding:0 12px; font-weight:700; font-size:13px; }\n  .drafts .row button.del{ width:44px; height:44px; border:none; background:none; color:var(--muted); padding:0; display:flex; align-items:center; justify-content:center; font-size:14px; }\n  .empty{ display:flex; align-items:center; gap:10px; font-size:13.5px; color:var(--muted); }\n  .empty .tile{ width:34px; height:34px; border-radius:10px; font-size:14px; opacity:.9; }\n\n  @media (min-width:700px){ .grid2{ display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:12px; } .grid2 .card{ margin-bottom:0; } .grid2{ margin-bottom:12px; } }\n  @media (prefers-reduced-motion:reduce){ .spin{ animation-duration:2.4s; } button:active{ transform:none; } }\n\n  @keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n  .myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n  .myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n  .myllm-ai-cog{width:16px;height:16px;border-radius:50%;border:2.4px solid #a78bfa;border-right-color:transparent;animation:myllmAiSpin .9s linear infinite;flex-shrink:0}\n  .myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n<style>:root{--build-id:\"c4e856fbcc\";}</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-pen\" viewBox=\"0 0 24 24\"><path d=\"M5.5 3h8a1 1 0 0 1 0 2h-8a.5.5 0 0 0-.5.5v13c0 .3.2.5.5.5h13c.3 0 .5-.2.5-.5v-8a1 1 0 1 1 2 0v8a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 18.5v-13A2.5 2.5 0 0 1 5.5 3zm12.7-.6a2 2 0 0 1 2.8 0l.6.6a2 2 0 0 1 0 2.8l-7.9 7.9a1 1 0 0 1-.5.3l-3 .8a.6.6 0 0 1-.7-.7l.8-3a1 1 0 0 1 .3-.5z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-spark\" viewBox=\"0 0 24 24\"><path d=\"M10 2.5l1.9 5.6 5.6 1.9-5.6 1.9L10 17.5l-1.9-5.6L2.5 10l5.6-1.9zM18.5 14l.95 2.55L22 17.5l-2.55.95L18.5 21l-.95-2.55L15 17.5l2.55-.95z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-hash\" viewBox=\"0 0 24 24\"><path d=\"M9.3 3.1a1 1 0 0 1 .8 1.2L9.5 8h4.9l.7-4.3a1 1 0 0 1 2 .3L16.5 8H19a1 1 0 0 1 0 2h-2.8l-.8 4H18a1 1 0 0 1 0 2h-2.9l-.7 4.3a1 1 0 0 1-2-.3l.7-4H8.2l-.7 4.3a1 1 0 0 1-2-.3l.7-4H4a1 1 0 0 1 0-2h2.5l.8-4H5a1 1 0 0 1 0-2h2.6l.6-4.1a1 1 0 0 1 1.1-.8zM9.2 10l-.7 4h4.9l.7-4z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-thread\" viewBox=\"0 0 24 24\"><path d=\"M5 3.5h14A1.5 1.5 0 0 1 20.5 5v4a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 9V5A1.5 1.5 0 0 1 5 3.5zm0 10h14a1.5 1.5 0 0 1 1.5 1.5v4a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 19v-4A1.5 1.5 0 0 1 5 13.5zM11 10.5h2v3h-2z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-save\" viewBox=\"0 0 24 24\"><path d=\"M7 3h10a2 2 0 0 1 2 2v15.3a.7.7 0 0 1-1.1.6L12 17.2l-5.9 3.7A.7.7 0 0 1 5 20.3V5a2 2 0 0 1 2-2z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-share\" viewBox=\"0 0 24 24\"><path d=\"M12 2.6a1 1 0 0 1 .7.3l3.6 3.6a1 1 0 1 1-1.4 1.4L13 6v8.5a1 1 0 0 1-2 0V6L9.1 7.9a1 1 0 1 1-1.4-1.4l3.6-3.6a1 1 0 0 1 .7-.3zM6 10.5a1 1 0 0 1 1 1V19c0 .3.2.5.5.5h9c.3 0 .5-.2.5-.5v-7.5a1 1 0 1 1 2 0V19a2.5 2.5 0 0 1-2.5 2.5h-9A2.5 2.5 0 0 1 5 19v-7.5a1 1 0 0 1 1-1z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-warn\" viewBox=\"0 0 24 24\"><path d=\"M10.3 3.9a2 2 0 0 1 3.4 0l8 13.6a2 2 0 0 1-1.7 3H4a2 2 0 0 1-1.7-3zM12 9a1 1 0 0 0-1 1v4a1 1 0 0 0 2 0v-4a1 1 0 0 0-1-1zm0 7.2a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z\" fill=\"currentColor\"/></symbol>\n</defs></svg>\n\n<div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-pen\"/></svg></div>\n  <div class=\"ht\"><h1>Post Studio</h1><p>Write it once, post it anywhere</p></div>\n</div>\n<div class=\"art\" id=\"hero\" aria-hidden=\"true\"></div>\n\n<div class=\"post\">\n  <div class=\"top\">\n    <div class=\"who\"><div class=\"tile\"><svg class=\"i\"><use href=\"#i-pen\"/></svg></div><div style=\"min-width:0\"><b>Your post</b><span id=\"voicelbl\">Plain voice</span></div></div>\n  </div>\n  <textarea id=\"draft\" placeholder=\"Type the rough version — or paste something you want to improve…\" oninput=\"onEdit()\"></textarea>\n  <div class=\"meter\"><div class=\"bar\"><i id=\"meterFill\"></i></div></div>\n  <div class=\"meta\">\n    <b id=\"count\">0</b>\n    <span id=\"limitlbl\"></span>\n  </div>\n</div>\n\n<div class=\"grid2\">\n  <div class=\"card\">\n    <span class=\"lbl\">Platform format</span>\n    <div class=\"chips\" id=\"platforms\"></div>\n    <div style=\"height:14px\"></div>\n    <span class=\"lbl\">Voice</span>\n    <div class=\"chips\" id=\"voices\"></div>\n  </div>\n\n  <div class=\"card\">\n    <div class=\"actions\">\n      <button id=\"polishBtn\" type=\"button\" onclick=\"aiPolish()\"></button>\n      <button id=\"hashBtn\" type=\"button\" onclick=\"aiHashtags()\"></button>\n      <button id=\"threadBtn\" type=\"button\" onclick=\"splitThread()\"><svg class=\"i\"><use href=\"#i-thread\"/></svg>Split into thread</button>\n      <button type=\"button\" onclick=\"saveDraft()\"><svg class=\"i\"><use href=\"#i-save\"/></svg>Save draft</button>\n      <button class=\"primary\" type=\"button\" onclick=\"shareNow()\"><svg class=\"i\"><use href=\"#i-share\"/></svg>Share…</button>\n    </div>\n    <p class=\"aihint\" id=\"aihint\"></p>\n    <div class=\"out\" id=\"out\"></div>\n  </div>\n</div>\n\n<div class=\"card drafts\">\n  <span class=\"lbl\">Drafts</span>\n  <div id=\"draftlist\"></div>\n</div>\n\n<!-- AI thinking pill (house convention) -->\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\"></span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n\n<script>\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nvar store = {\n  getItem:function(k){ return window.myllmStorage ? window.myllmStorage.getItem(k) : Promise.resolve(null); },\n  setItem:function(k,v){ return window.myllmStorage ? window.myllmStorage.setItem(k,v) : Promise.resolve(); }\n};\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction hasAsk(){ return typeof window.myllmAsk === \"function\"; }\nfunction ASK(){ return window.myllmAsk.apply(window, arguments); }\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\"); }\nfunction icon(n){ return '<svg class=\"i\"><use href=\"#i-' + n + '\"/></svg>'; }\n\nvar HERO = \"data:image/jpeg;base64,\";\nif (HERO.indexOf(\"data:\") === 0) el(\"hero\").style.backgroundImage = \"url(\" + HERO + \")\";\n\nvar PLATFORMS = [\n  {id:\"x\",    name:\"X / Threads\",  limit:280},\n  {id:\"bsky\", name:\"Bluesky\",      limit:300},\n  {id:\"masto\",name:\"Mastodon\",     limit:500},\n  {id:\"ig\",   name:\"Instagram\",    limit:2200},\n  {id:\"li\",   name:\"LinkedIn\",     limit:3000}\n];\nvar VOICES = [\n  {id:\"plain\",  name:\"Plain\",        hint:\"clear, unpretentious, no hype\"},\n  {id:\"friendly\", name:\"Friendly\",   hint:\"warm and conversational\"},\n  {id:\"pro\",    name:\"Professional\", hint:\"polished and credible, no jargon\"},\n  {id:\"witty\",  name:\"Witty\",        hint:\"light humour, never cringe\"},\n  {id:\"bold\",   name:\"Bold\",         hint:\"punchy, confident, short sentences\"}\n];\nvar platform = PLATFORMS[0];\nvar voice = VOICES[0];\nvar drafts = [];\nvar busy = {polish:false, hash:false};\n\nfunction aiButtons(){\n  el(\"polishBtn\").disabled = busy.polish;\n  el(\"polishBtn\").innerHTML = busy.polish ? '<i class=\"spin\"></i>Polishing…' : icon(\"spark\") + \"Polish\";\n  el(\"hashBtn\").disabled = busy.hash;\n  el(\"hashBtn\").innerHTML = busy.hash ? '<i class=\"spin\"></i>Thinking…' : icon(\"hash\") + \"Hashtags\";\n}\nfunction hint(t, err){ var h = el(\"aihint\"); h.className = \"aihint\" + (err ? \" err\" : \"\"); h.innerHTML = t ? (err ? icon(\"warn\") : \"\") + \"<span>\" + esc(t) + \"</span>\" : \"\"; }\n\nfunction renderChips(){\n  el(\"platforms\").innerHTML = PLATFORMS.map(function(p){\n    return '<button type=\"button\" class=\"chip' + (platform.id === p.id ? ' on' : '') + '\" onclick=\"setPlatform(\\'' + p.id + '\\')\">' + p.name + '</button>';\n  }).join(\"\");\n  el(\"voices\").innerHTML = VOICES.map(function(v){\n    return '<button type=\"button\" class=\"chip' + (voice.id === v.id ? ' on' : '') + '\" onclick=\"setVoice(\\'' + v.id + '\\')\">' + v.name + '</button>';\n  }).join(\"\");\n  el(\"limitlbl\").textContent = platform.name + \" · \" + platform.limit + \" chars\";\n  el(\"voicelbl\").textContent = voice.name + \" voice · \" + platform.name;\n  onEdit();\n}\nfunction setPlatform(id){ platform = PLATFORMS.filter(function(p){return p.id===id;})[0]; haptic(\"selection\"); renderChips(); }\nfunction setVoice(id){ voice = VOICES.filter(function(v){return v.id===id;})[0]; haptic(\"selection\"); renderChips(); }\n\nfunction onEdit(){\n  var n = el(\"draft\").value.length;\n  var c = el(\"count\");\n  c.textContent = n + (n > platform.limit ? \" — over by \" + (n - platform.limit) : \"\");\n  c.className = n > platform.limit ? \"over\" : \"\";\n  var f = el(\"meterFill\");\n  f.style.width = Math.min(100, n / platform.limit * 100) + \"%\";\n  f.className = n > platform.limit ? \"over\" : \"\";\n}\n\n/* ---------- AI actions (all graceful without AI) ---------- */\nfunction needText(){\n  var t = el(\"draft\").value.trim();\n  if (!t){ hint(\"Write something first — even a rough note is enough.\"); haptic(\"light\"); }\n  return t;\n}\nfunction aiUnavailable(){\n  hint(\"AI is off — polish and hashtags need it (enable AI in Settings). The thread splitter and sharing work without it.\", true);\n  haptic(\"light\");\n}\nfunction aiPolish(){\n  var t = needText(); if (!t) return;\n  if (!hasAsk()) return aiUnavailable();\n  if (busy.polish) return;\n  haptic(\"light\");\n  busy.polish = true; aiButtons(); hint(\"\");\n  ASK(\"Rewrite this social media post. Voice: \" + voice.hint + \". Hard limit: \" + platform.limit + \" characters — stay well under it. Keep the author's meaning and any @mentions/links exactly. No hashtags unless the original had them. Reply with ONLY the rewritten post, no quotes, no commentary.\\n\\nPost:\\n\" + t,\n    {system:\"You are a sharp social media editor. Output only the rewritten post text.\"})\n  .then(function(r){\n    var clean = String(r).trim().replace(/^[\"']|[\"']$/g, \"\");\n    showResult([{text:clean, label:\"Polished · \" + voice.name}], true);\n    haptic(\"success\");\n  }).catch(function(){ hint(\"The AI couldn't run just now — try again.\", true); })\n  .then(function(){ busy.polish = false; aiButtons(); });\n}\nfunction aiHashtags(){\n  var t = needText(); if (!t) return;\n  if (!hasAsk()) return aiUnavailable();\n  if (busy.hash) return;\n  haptic(\"light\");\n  busy.hash = true; aiButtons(); hint(\"\");\n  ASK(\"Suggest 6 hashtags for this post. Mix broad and niche. Reply with ONLY the hashtags on one line, space-separated, each starting with #.\\n\\nPost:\\n\" + t,\n    {system:\"You output only hashtags, one line, space-separated.\"})\n  .then(function(r){\n    var tags = String(r).match(/#[A-Za-z0-9_]+/g) || [];\n    if (!tags.length){ hint(\"No usable hashtags came back — try again.\", true); return; }\n    showResult([{text:tags.join(\" \"), label:\"Hashtags — tap Append to add them\"}], false, true);\n    haptic(\"success\");\n  }).catch(function(){ hint(\"The AI couldn't run just now — try again.\", true); })\n  .then(function(){ busy.hash = false; aiButtons(); });\n}\n\n/* deterministic thread splitter — no AI needed */\nfunction splitThread(){\n  var t = needText(); if (!t) return;\n  var limit = platform.limit - 8;   /* room for \" (12/99)\" */\n  var sentences = t.match(/[^.!?\\n]+[.!?]*\\s*/g) || [t];\n  var parts = [], curp = \"\";\n  sentences.forEach(function(s){\n    if ((curp + s).length > limit && curp){ parts.push(curp.trim()); curp = s; }\n    else curp += s;\n    while (curp.length > limit){        /* one giant sentence: hard wrap at a space */\n      var cut = curp.lastIndexOf(\" \", limit);\n      if (cut < limit * 0.5) cut = limit;\n      parts.push(curp.slice(0, cut).trim());\n      curp = curp.slice(cut).trim();\n    }\n  });\n  if (curp.trim()) parts.push(curp.trim());\n  if (parts.length === 1){\n    hint(\"That already fits in one \" + platform.name + \" post.\");\n    haptic(\"light\");\n    return;\n  }\n  showResult(parts.map(function(p, i){\n    return {text:p + \" (\" + (i+1) + \"/\" + parts.length + \")\", label:\"Part \" + (i+1) + \" of \" + parts.length};\n  }), false);\n  haptic(\"success\");\n}\n\n/* ---------- results ---------- */\nfunction showResult(pieces, offerUse, offerAppend){\n  hint(\"\");\n  el(\"out\").innerHTML = pieces.map(function(p, i){\n    var btns = '<button type=\"button\" onclick=\"sharePiece(' + i + ')\">' + icon(\"share\") + 'Share</button>';\n    if (offerUse) btns = '<button type=\"button\" onclick=\"usePiece(' + i + ')\">Use it</button>' + btns.replace(\"<button\", '<button class=\"ghost\"');\n    if (offerAppend) btns = '<button type=\"button\" onclick=\"appendPiece(' + i + ')\">Append</button>';\n    return '<div class=\"piece\" data-i=\"' + i + '\">' + esc(p.text) +\n      '<small>' + esc(p.label || \"\") + ' · ' + p.text.length + ' chars</small>' +\n      '<div class=\"rowbtns\">' + btns + '</div></div>';\n  }).join(\"\");\n  window.__pieces = pieces;\n}\nfunction usePiece(i){ el(\"draft\").value = window.__pieces[i].text; onEdit(); el(\"out\").innerHTML = \"\"; haptic(\"selection\"); }\nfunction appendPiece(i){\n  el(\"draft\").value = (el(\"draft\").value.trim() + \"\\n\\n\" + window.__pieces[i].text).trim();\n  onEdit(); el(\"out\").innerHTML = \"\"; haptic(\"selection\");\n}\nfunction sharePiece(i){\n  if (window.myllmShare){ try{ myllmShare({text:window.__pieces[i].text}); }catch(_){} }\n  haptic(\"light\");\n}\nfunction shareNow(){\n  var t = needText(); if (!t) return;\n  if (window.myllmShare){ try{ myllmShare({text:t}); }catch(_){} }\n  haptic(\"light\");\n}\n\n/* ---------- drafts ---------- */\nfunction saveDraft(){\n  var t = needText(); if (!t) return;\n  drafts.unshift({t:t, at:Date.now()});\n  if (drafts.length > 30) drafts.pop();\n  store.setItem(\"posts\", JSON.stringify(drafts));\n  renderDrafts();\n  haptic(\"success\");\n}\nfunction renderDrafts(){\n  if (!drafts.length){ el(\"draftlist\").innerHTML = '<p class=\"empty\"><span class=\"tile\">' + icon(\"save\") + '</span>Saved drafts appear here.</p>'; return; }\n  el(\"draftlist\").innerHTML = drafts.map(function(d, i){\n    return '<div class=\"row\"><span>' + esc(d.t.slice(0, 80)) + '</span>' +\n      '<button type=\"button\" onclick=\"loadDraft(' + i + ')\">Open</button>' +\n      '<button type=\"button\" class=\"del\" aria-label=\"Delete draft\" onclick=\"delDraft(' + i + ')\">' + icon(\"x\") + '</button></div>';\n  }).join(\"\");\n}\nfunction loadDraft(i){ el(\"draft\").value = drafts[i].t; onEdit(); haptic(\"selection\"); window.scrollTo(0,0); }\nfunction delDraft(i){ drafts.splice(i,1); store.setItem(\"posts\", JSON.stringify(drafts)); renderDrafts(); haptic(\"light\"); }\n\n/* ---------- boot ---------- */\naiButtons();\nstore.getItem(\"posts\").then(function(v){\n  if (v){ try{ drafts = JSON.parse(v) || []; }catch(e){} }\n  renderChips();\n  renderDrafts();\n  if (!hasAsk()) hint(\"Tip: enable AI in Settings to unlock Polish and Hashtags. Everything else works now.\");\n});\n</script>\n</body>\n</html>\n"}