{"name": "Post Studio", "kind": "html", "iconSymbol": "square.and.pencil", "iconColor": "orange", "html": "<!doctype html>\n<!--\n  Post Studio — MyLLMos App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Post Studio</title>\n<style>\n  :root { color-scheme: light dark; }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111);\n    max-width:640px; margin:0 auto; min-height:100dvh;\n    padding-bottom:calc(30px + env(safe-area-inset-bottom));\n  }\n  .hero{\n    height:120px; background:#432 center/cover; position:relative;\n    display:flex; align-items:flex-end; padding:14px 16px;\n  }\n  .hero::after{ content:\"\"; position:absolute; inset:0; background:linear-gradient(180deg, transparent 30%, rgba(0,0,0,.45)); }\n  .hero h1{ position:relative; z-index:1; color:#fff; font-size:24px; font-weight:800; letter-spacing:-0.02em; text-shadow:0 2px 10px rgba(0,0,0,.5); }\n  .wrap{ padding:14px 16px; }\n\n  .card{\n    background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8);\n    border-radius:16px; padding:14px; margin-bottom:12px;\n  }\n  label{ display:block; font-size:11.5px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:var(--myllm-muted,#8a8a8e); margin-bottom:7px; }\n  textarea{\n    width:100%; min-height:130px; font-size:16px; line-height:1.45; padding:12px; resize:vertical;\n    border-radius:12px; border:1px solid var(--myllm-border,#e3e3e8);\n    background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111);\n    font-family:inherit;\n  }\n  .meta{ display:flex; justify-content:space-between; align-items:center; margin-top:7px; font-size:12.5px; color:var(--myllm-muted,#8a8a8e); }\n  .meta b.over{ color:#ff3b30; }\n\n  .chips{ display:flex; flex-wrap:wrap; gap:7px; }\n  .chip{\n    border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111);\n    border-radius:99px; padding:7px 13px; font-size:13.5px; font-weight:600;\n  }\n  .chip.on{ background:var(--myllm-accent,#0a84ff); border-color:var(--myllm-accent,#0a84ff); color:#fff; }\n\n  .actions{ display:grid; grid-template-columns:1fr 1fr; gap:8px; }\n  .actions button{\n    border:1px solid var(--myllm-border,#e3e3e8); border-radius:12px; padding:12px 8px;\n    font-size:14px; font-weight:700; background:var(--myllm-surface,#fff); color:var(--myllm-text,#111);\n  }\n  .actions button:disabled{ opacity:.45; }\n  .actions button.primary{ grid-column:1 / -1; background:var(--myllm-accent,#0a84ff); border-color:var(--myllm-accent,#0a84ff); color:#fff; padding:14px; font-size:15.5px; }\n\n  .out{ margin-top:10px; }\n  .piece{\n    background:var(--myllm-bg,#f2f2f7); border:1px solid var(--myllm-border,#e3e3e8);\n    border-radius:12px; padding:11px 12px; margin-bottom:8px; font-size:15px; line-height:1.45; white-space:pre-wrap;\n  }\n  .piece small{ display:block; margin-top:6px; font-size:11.5px; color:var(--myllm-muted,#8a8a8e); }\n  .piece .rowbtns{ display:flex; gap:8px; margin-top:8px; }\n  .piece .rowbtns button{\n    border:none; border-radius:9px; padding:7px 13px; font-size:12.5px; font-weight:700;\n    background:var(--myllm-accent,#0a84ff); color:#fff;\n  }\n  .piece .rowbtns button.ghost{ background:var(--myllm-surface,#fff); color:var(--myllm-text,#111); border:1px solid var(--myllm-border,#e3e3e8); }\n\n  .drafts .row{\n    display:flex; align-items:center; gap:10px; padding:10px 2px;\n    border-bottom:1px solid var(--myllm-border,#e3e3e8); font-size:14px;\n  }\n  .drafts .row:last-child{ border-bottom:none; }\n  .drafts .row span{ flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  .drafts .row button{ border:none; background:none; color:var(--myllm-accent,#0a84ff); font-weight:700; font-size:13px; }\n  .drafts .row button.del{ color:#ff3b30; }\n  .empty{ font-size:13.5px; color:var(--myllm-muted,#8a8a8e); }\n  .aihint{ font-size:12.5px; color:var(--myllm-muted,#8a8a8e); margin-top:8px; line-height:1.45; }\n</style>\n<style>:root{--build-id:\"c4e856fbcc\";}</style>\n</head>\n<body>\n\n<div class=\"hero\" id=\"hero\"><h1>✍️ Post Studio</h1></div>\n<div class=\"wrap\">\n\n  <div class=\"card\">\n    <label>Your post</label>\n    <textarea id=\"draft\" placeholder=\"Type the rough version — or paste something you want to improve…\" oninput=\"onEdit()\"></textarea>\n    <div class=\"meta\">\n      <b id=\"count\">0</b>\n      <span id=\"limitlbl\"></span>\n    </div>\n  </div>\n\n  <div class=\"card\">\n    <label>Platform format</label>\n    <div class=\"chips\" id=\"platforms\"></div>\n    <div style=\"height:10px\"></div>\n    <label>Voice</label>\n    <div class=\"chips\" id=\"voices\"></div>\n  </div>\n\n  <div class=\"card\">\n    <div class=\"actions\">\n      <button id=\"polishBtn\" onclick=\"aiPolish()\">✨ Polish</button>\n      <button id=\"hashBtn\" onclick=\"aiHashtags()\">＃ Hashtags</button>\n      <button id=\"threadBtn\" onclick=\"splitThread()\">🧵 Split into thread</button>\n      <button onclick=\"saveDraft()\">💾 Save draft</button>\n      <button class=\"primary\" onclick=\"shareNow()\">Share…</button>\n    </div>\n    <p class=\"aihint\" id=\"aihint\"></p>\n    <div class=\"out\" id=\"out\"></div>\n  </div>\n\n  <div class=\"card drafts\">\n    <label>Drafts</label>\n    <div id=\"draftlist\"><p class=\"empty\">Saved drafts appear here.</p></div>\n  </div>\n</div>\n\n<!-- AI thinking pill (house convention) -->\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\">⚙️</span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n\n<script>\nvar store = window.myllmStorage || {getItem:function(){return Promise.resolve(null)}, setItem:function(){return Promise.resolve()}};\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nvar ASK = window.myllmAsk || null;\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\"); }\n\nvar HERO = \"data:image/jpeg;base64,\";\nif (HERO.indexOf(\"data:\") === 0) el(\"hero\").style.backgroundImage = \"url(\" + HERO + \")\";\n\nvar PLATFORMS = [\n  {id:\"x\",    name:\"X / Threads\",  limit:280},\n  {id:\"bsky\", name:\"Bluesky\",      limit:300},\n  {id:\"masto\",name:\"Mastodon\",     limit:500},\n  {id:\"ig\",   name:\"Instagram\",    limit:2200},\n  {id:\"li\",   name:\"LinkedIn\",     limit:3000}\n];\nvar VOICES = [\n  {id:\"plain\",  name:\"Plain\",        hint:\"clear, unpretentious, no hype\"},\n  {id:\"friendly\", name:\"Friendly\",   hint:\"warm and conversational\"},\n  {id:\"pro\",    name:\"Professional\", hint:\"polished and credible, no jargon\"},\n  {id:\"witty\",  name:\"Witty\",        hint:\"light humour, never cringe\"},\n  {id:\"bold\",   name:\"Bold\",         hint:\"punchy, confident, short sentences\"}\n];\nvar platform = PLATFORMS[0];\nvar voice = VOICES[0];\nvar drafts = [];\n\nfunction renderChips(){\n  el(\"platforms\").innerHTML = PLATFORMS.map(function(p){\n    return '<button class=\"chip' + (platform.id === p.id ? ' on' : '') + '\" onclick=\"setPlatform(\\'' + p.id + '\\')\">' + p.name + '</button>';\n  }).join(\"\");\n  el(\"voices\").innerHTML = VOICES.map(function(v){\n    return '<button class=\"chip' + (voice.id === v.id ? ' on' : '') + '\" onclick=\"setVoice(\\'' + v.id + '\\')\">' + v.name + '</button>';\n  }).join(\"\");\n  el(\"limitlbl\").textContent = platform.name + \" · \" + platform.limit + \" chars\";\n  onEdit();\n}\nfunction setPlatform(id){ platform = PLATFORMS.filter(function(p){return p.id===id;})[0]; haptic(\"selection\"); renderChips(); }\nfunction setVoice(id){ voice = VOICES.filter(function(v){return v.id===id;})[0]; haptic(\"selection\"); renderChips(); }\n\nfunction onEdit(){\n  var n = el(\"draft\").value.length;\n  var c = el(\"count\");\n  c.textContent = n + (n > platform.limit ? \" — over by \" + (n - platform.limit) : \"\");\n  c.className = n > platform.limit ? \"over\" : \"\";\n}\n\n/* ---------- AI actions (all graceful without AI) ---------- */\nfunction needText(){\n  var t = el(\"draft\").value.trim();\n  if (!t){ el(\"aihint\").textContent = \"Write something first — even a rough note is enough.\"; haptic(\"light\"); }\n  return t;\n}\nfunction aiUnavailable(){\n  el(\"aihint\").textContent = \"AI is off — polish and hashtags need it (enable AI in Settings). The thread splitter and sharing work without it.\";\n  haptic(\"light\");\n}\nfunction aiPolish(){\n  var t = needText(); if (!t) return;\n  if (!ASK) return aiUnavailable();\n  haptic(\"light\");\n  ASK(\"Rewrite this social media post. Voice: \" + voice.hint + \". Hard limit: \" + platform.limit + \" characters — stay well under it. Keep the author's meaning and any @mentions/links exactly. No hashtags unless the original had them. Reply with ONLY the rewritten post, no quotes, no commentary.\\n\\nPost:\\n\" + t,\n    {system:\"You are a sharp social media editor. Output only the rewritten post text.\"})\n  .then(function(r){\n    var clean = String(r).trim().replace(/^[\"']|[\"']$/g, \"\");\n    showResult([{text:clean, label:\"Polished · \" + voice.name}], true);\n    haptic(\"success\");\n  }).catch(function(){ el(\"aihint\").textContent = \"The AI couldn't run just now — try again.\"; });\n}\nfunction aiHashtags(){\n  var t = needText(); if (!t) return;\n  if (!ASK) return aiUnavailable();\n  haptic(\"light\");\n  ASK(\"Suggest 6 hashtags for this post. Mix broad and niche. Reply with ONLY the hashtags on one line, space-separated, each starting with #.\\n\\nPost:\\n\" + t,\n    {system:\"You output only hashtags, one line, space-separated.\"})\n  .then(function(r){\n    var tags = String(r).match(/#[A-Za-z0-9_]+/g) || [];\n    if (!tags.length){ el(\"aihint\").textContent = \"No usable hashtags came back — try again.\"; return; }\n    showResult([{text:tags.join(\" \"), label:\"Hashtags — tap Append to add them\"}], false, true);\n    haptic(\"success\");\n  }).catch(function(){ el(\"aihint\").textContent = \"The AI couldn't run just now — try again.\"; });\n}\n\n/* deterministic thread splitter — no AI needed */\nfunction splitThread(){\n  var t = needText(); if (!t) return;\n  var limit = platform.limit - 8;   /* room for \" (12/99)\" */\n  var sentences = t.match(/[^.!?\\n]+[.!?]*\\s*/g) || [t];\n  var parts = [], curp = \"\";\n  sentences.forEach(function(s){\n    if ((curp + s).length > limit && curp){ parts.push(curp.trim()); curp = s; }\n    else curp += s;\n    while (curp.length > limit){        /* one giant sentence: hard wrap at a space */\n      var cut = curp.lastIndexOf(\" \", limit);\n      if (cut < limit * 0.5) cut = limit;\n      parts.push(curp.slice(0, cut).trim());\n      curp = curp.slice(cut).trim();\n    }\n  });\n  if (curp.trim()) parts.push(curp.trim());\n  if (parts.length === 1){\n    el(\"aihint\").textContent = \"That already fits in one \" + platform.name + \" post.\";\n    haptic(\"light\");\n    return;\n  }\n  showResult(parts.map(function(p, i){\n    return {text:p + \" (\" + (i+1) + \"/\" + parts.length + \")\", label:\"Part \" + (i+1) + \" of \" + parts.length};\n  }), false);\n  haptic(\"success\");\n}\n\n/* ---------- results ---------- */\nfunction showResult(pieces, offerUse, offerAppend){\n  el(\"aihint\").textContent = \"\";\n  el(\"out\").innerHTML = pieces.map(function(p, i){\n    var btns = '<button onclick=\"sharePiece(' + i + ')\">Share</button>';\n    if (offerUse) btns = '<button onclick=\"usePiece(' + i + ')\">Use it</button>' + btns.replace(\"<button\", '<button class=\"ghost\"');\n    if (offerAppend) btns = '<button onclick=\"appendPiece(' + i + ')\">Append</button>';\n    return '<div class=\"piece\" data-i=\"' + i + '\">' + esc(p.text) +\n      '<small>' + esc(p.label || \"\") + ' · ' + p.text.length + ' chars</small>' +\n      '<div class=\"rowbtns\">' + btns + '</div></div>';\n  }).join(\"\");\n  window.__pieces = pieces;\n}\nfunction usePiece(i){ el(\"draft\").value = window.__pieces[i].text; onEdit(); el(\"out\").innerHTML = \"\"; haptic(\"selection\"); }\nfunction appendPiece(i){\n  el(\"draft\").value = (el(\"draft\").value.trim() + \"\\n\\n\" + window.__pieces[i].text).trim();\n  onEdit(); el(\"out\").innerHTML = \"\"; haptic(\"selection\");\n}\nfunction sharePiece(i){\n  if (window.myllmShare){ try{ myllmShare({text:window.__pieces[i].text}); }catch(_){} }\n  haptic(\"light\");\n}\nfunction shareNow(){\n  var t = needText(); if (!t) return;\n  if (window.myllmShare){ try{ myllmShare({text:t}); }catch(_){} }\n  haptic(\"light\");\n}\n\n/* ---------- drafts ---------- */\nfunction saveDraft(){\n  var t = needText(); if (!t) return;\n  drafts.unshift({t:t, at:Date.now()});\n  if (drafts.length > 30) drafts.pop();\n  store.setItem(\"posts\", JSON.stringify(drafts));\n  renderDrafts();\n  haptic(\"success\");\n}\nfunction renderDrafts(){\n  if (!drafts.length){ el(\"draftlist\").innerHTML = '<p class=\"empty\">Saved drafts appear here.</p>'; return; }\n  el(\"draftlist\").innerHTML = drafts.map(function(d, i){\n    return '<div class=\"row\"><span>' + esc(d.t.slice(0, 80)) + '</span>' +\n      '<button onclick=\"loadDraft(' + i + ')\">Open</button>' +\n      '<button class=\"del\" onclick=\"delDraft(' + i + ')\">✕</button></div>';\n  }).join(\"\");\n}\nfunction loadDraft(i){ el(\"draft\").value = drafts[i].t; onEdit(); haptic(\"selection\"); window.scrollTo(0,0); }\nfunction delDraft(i){ drafts.splice(i,1); store.setItem(\"posts\", JSON.stringify(drafts)); renderDrafts(); haptic(\"light\"); }\n\n/* ---------- boot ---------- */\nstore.getItem(\"posts\").then(function(v){\n  if (v){ try{ drafts = JSON.parse(v) || []; }catch(e){} }\n  renderChips();\n  renderDrafts();\n  if (!ASK) el(\"aihint\").textContent = \"Tip: enable AI in Settings to unlock Polish and Hashtags. Everything else works now.\";\n});\n</script>\n</body>\n</html>\n"}