{"name": "Visual Timer", "html": "<!doctype html>\n<!--\n  Visual Timer — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover\">\n<title>Visual Timer</title>\n<style>:root{--build-id:\"166c8542e4\";color-scheme:light dark}\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; -webkit-user-select:none; user-select:none; }\n  html,body{ height:100%; overflow:hidden; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:#0b0b10; color:#fff; touch-action:manipulation; }\n\n  /* The stage: a warm, muted backdrop — the disc is the only strong colour on\n     screen, and the backdrop never changes as time runs down. Two layers, dark\n     and light, cross-faded slowly. */\n  .stage{ position:fixed; inset:0; --h:6; color:#fff; }\n  .bg{ position:absolute; inset:0; transition:opacity 1.4s ease; }\n  .bg.d{ background:radial-gradient(120% 90% at 20% 10%, hsl(var(--h) 42% 24%), transparent 60%),\n      radial-gradient(120% 90% at 85% 95%, hsl(calc(var(--h) + 32) 40% 20%), transparent 62%), #0b0b10; }\n  .bg.l{ opacity:0; background:radial-gradient(120% 90% at 20% 0%, hsl(var(--h) 80% 91%), transparent 60%),\n      radial-gradient(120% 90% at 85% 100%, hsl(calc(var(--h) + 32) 78% 91%), transparent 62%), #f7f5f4; }\n  .lite{ color:#15151a; } .lite .bg.l{ opacity:1; } .lite .bg.d{ opacity:0; }\n\n  .col{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; text-align:center;\n    padding:calc(12px + env(safe-area-inset-top)) calc(18px + env(safe-area-inset-right)) calc(18px + env(safe-area-inset-bottom)) calc(18px + env(safe-area-inset-left)); }\n  .top{ width:100%; max-width:520px; height:58px; display:flex; align-items:center; justify-content:space-between; flex-shrink:0; }\n  .top .side{ width:112px; display:flex; }\n  .lbl{ font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; opacity:.62; }\n  .glass{ border:1px solid rgba(255,255,255,.16); background:rgba(255,255,255,.12); color:inherit;\n    -webkit-backdrop-filter:blur(18px); backdrop-filter:blur(18px); }\n  .lite .glass{ border-color:rgba(0,0,0,.09); background:rgba(255,255,255,.66); }\n  svg{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; } button:active{ transform:scale(.96); }\n  .big{ height:58px; min-width:58px; border-radius:99px; padding:0 22px; font-size:16.5px; font-weight:750;\n    display:inline-flex; align-items:center; justify-content:center; gap:9px; }\n  #bDone{ opacity:0; pointer-events:none; transition:opacity .8s ease; }\n  .staged #bDone{ opacity:1; pointer-events:auto; }\n\n  .mid{ flex:1; min-height:0; width:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; }\n  canvas{ display:block; flex-shrink:0; border-radius:50%; box-shadow:0 24px 60px rgba(0,0,0,.35); transition:box-shadow 1.4s ease; }\n  .lite canvas{ box-shadow:0 22px 50px rgba(20,20,40,.14); }\n  .digits{ font-size:46px; font-weight:800; letter-spacing:-.02em; font-variant-numeric:tabular-nums; margin-top:16px; min-height:56px; line-height:56px; flex-shrink:0; }\n  .digits.off{ visibility:hidden; }\n  .note{ font-size:14px; font-weight:650; opacity:.66; min-height:20px; flex-shrink:0; }\n\n  .ctl{ width:100%; max-width:420px; flex-shrink:0; }\n  .presets{ display:flex; flex-wrap:wrap; gap:8px; justify-content:center; margin-bottom:14px; }\n  .presets button{ height:48px; min-width:56px; border-radius:99px; padding:0 14px; font-size:15px; font-weight:750; font-variant-numeric:tabular-nums; }\n  .presets button.on{ background:var(--accent,#f0584f); border-color:var(--accent,#f0584f); color:#fff; }\n  .staged .presets{ display:none; }\n  .bar{ display:flex; gap:10px; }\n  .bar .big{ flex:1; }\n  #go{ flex:1.6; border:none; background:#fff; color:#0b0b10; box-shadow:0 10px 30px rgba(0,0,0,.3); font-size:18px; height:60px; }\n  .lite #go{ background:#15151a; color:#fff; box-shadow:0 10px 26px rgba(20,20,40,.22); }\n  .bar .big{ height:60px; }\n  #bNum{ flex:0 0 60px; padding:0; }\n  #bNum[aria-pressed=\"false\"]{ opacity:.55; }\n\n  @media (max-width:340px){ .digits{ font-size:38px; margin-top:8px; } .big{ padding:0 14px; font-size:15.5px; } .presets button{ height:44px; min-width:50px; padding:0 10px; } }\n  @media (max-height:520px){                       /* phone on its side: disc left, time beside it, buttons right */\n    .mid{ flex-direction:row; justify-content:center; gap:24px; padding:0 calc(min(300px,38vw) + 22px) 0 2vw; }\n    .digits{ margin-top:0; } .words{ text-align:left; min-width:130px; }\n    .ctl{ position:absolute; right:calc(18px + env(safe-area-inset-right)); top:50%; transform:translateY(-50%); width:min(300px,38vw); }\n    .presets{ margin-bottom:10px; gap:6px; } .presets button{ height:44px; min-width:48px; padding:0 10px; font-size:14px; }\n    .bar .big, #go{ height:56px; padding:0 12px; font-size:16px; } #bNum{ flex-basis:56px; }\n  }\n  @media (max-width:340px){ .top .side{ width:60px; } #bDone{ padding:0; width:56px; } #bDone span{ display:none; } }\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-play\" viewBox=\"0 0 24 24\"><path d=\"M8 5.5v13a1 1 0 0 0 1.52.85l10.4-6.5a1 1 0 0 0 0-1.7L9.52 4.65A1 1 0 0 0 8 5.5z\"/></symbol>\n  <symbol id=\"i-pause\" viewBox=\"0 0 24 24\"><rect x=\"6\" y=\"5\" width=\"4.2\" height=\"14\" rx=\"1.4\"/><rect x=\"13.8\" y=\"5\" width=\"4.2\" height=\"14\" rx=\"1.4\"/></symbol>\n  <symbol id=\"i-close\" viewBox=\"0 0 24 24\"><path d=\"M6.4 5a1 1 0 0 0-1.4 1.4L10.6 12 5 17.6A1 1 0 0 0 6.4 19l5.6-5.6 5.6 5.6a1 1 0 0 0 1.4-1.4L13.4 12 19 6.4A1 1 0 0 0 17.6 5L12 10.6z\"/></symbol>\n  <symbol id=\"i-reset\" viewBox=\"0 0 24 24\"><path d=\"M12 5V2.6a.6.6 0 0 0-1-.45L7.2 5.55a.6.6 0 0 0 0 .9L11 9.85a.6.6 0 0 0 1-.45V7a5.5 5.5 0 1 1-5.5 5.5 1 1 0 0 0-2 0A7.5 7.5 0 1 0 12 5z\"/></symbol>\n  <symbol id=\"i-num\" viewBox=\"0 0 24 24\"><path d=\"M12 5C6.8 5 3.2 9 2.2 11.3a1.8 1.8 0 0 0 0 1.4C3.2 15 6.8 19 12 19s8.8-4 9.8-6.3a1.8 1.8 0 0 0 0-1.4C20.8 9 17.2 5 12 5zm0 11a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm0-2.2a1.8 1.8 0 1 0 0-3.6 1.8 1.8 0 0 0 0 3.6z\"/></symbol>\n</defs></svg>\n\n<div class=\"stage\" id=\"stage\">\n  <div class=\"bg d\"></div><div class=\"bg l\"></div>\n  <div class=\"col\">\n    <div class=\"top\">\n      <div class=\"side\"><button class=\"glass big\" id=\"bDone\" aria-label=\"Leave full screen\"><svg><use href=\"#i-close\"/></svg><span>Done</span></button></div>\n      <div class=\"lbl\">Visual Timer</div>\n      <div class=\"side\"></div>\n    </div>\n    <div class=\"mid\" id=\"mid\">\n      <canvas id=\"c\" width=\"280\" height=\"280\"></canvas>\n      <div class=\"words\">\n        <div class=\"digits\" id=\"digits\"></div>\n        <div class=\"note\" id=\"note\"></div>\n      </div>\n    </div>\n    <div class=\"ctl\">\n      <div class=\"presets\" id=\"presets\"></div>\n      <div class=\"bar\">\n        <button class=\"big\" id=\"go\"><svg><use href=\"#i-play\"/></svg><span>Start</span></button>\n        <button class=\"glass big\" id=\"bReset\"><svg><use href=\"#i-reset\"/></svg>Reset</button>\n        <button class=\"glass big\" id=\"bNum\" aria-pressed=\"true\" aria-label=\"Show numbers\"><svg><use href=\"#i-num\"/></svg></button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\nfunction el(i){ return document.getElementById(i); }\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction haptic(s){ if (window.myllmHaptic) try { myllmHaptic(s); } catch(e){} }\n\nvar PRESETS = [1,2,3,5,10,15,20], COLOR = \"#f0584f\";\nvar total = 5 * 60, remaining = 5 * 60, running = false, endAt = 0, loop = null;\nvar staged = false, finished = false, showNum = true;\nvar c = el(\"c\"), ctx = c.getContext(\"2d\"), dpr = Math.max(1, Math.min(3, window.devicePixelRatio || 1)), C = 280;\n\n/* ---------- look ---------- */\nfunction isLight(){ return !(window.matchMedia && matchMedia(\"(prefers-color-scheme: dark)\").matches); }\n/* A running timer takes the whole display. Where MyLLM can't hide its own\n   title bar, a dark stage under a white bar looks cut in half — so in light\n   mode, without myllmImmersive, the stage stays light. */\nfunction syncLook(){\n  var s = el(\"stage\");\n  s.classList.toggle(\"lite\", isLight() && !(staged && window.myllmImmersive));\n  s.classList.toggle(\"staged\", staged);\n}\nfunction syncChrome(){\n  if (!window.myllmImmersive) return;\n  /* a timer nobody is touching must not be lost to auto-lock; once it's paused or done, the screen may sleep */\n  try { myllmImmersive(staged, {keepAwake:staged && running}).catch(function(){}); } catch(_){}\n}\nfunction sync(){\n  el(\"go\").innerHTML = running ? '<svg><use href=\"#i-pause\"/></svg><span>Pause</span>' : '<svg><use href=\"#i-play\"/></svg><span>Start</span>';\n  el(\"digits\").textContent = fmt(remaining);\n  el(\"digits\").classList.toggle(\"off\", !showNum);\n  el(\"note\").textContent = finished ? \"All done\" : \"\";\n  el(\"bNum\").setAttribute(\"aria-pressed\", showNum);\n  syncLook(); sizeCanvas(); draw();\n}\n\nfunction sizeCanvas(){\n  var m = el(\"mid\"), wide = window.innerHeight <= 520;\n  var s = wide ? Math.min(m.clientHeight - 6, m.clientWidth * .5, 340) : Math.min(m.clientWidth - 12, m.clientHeight - 96, 440);\n  s = Math.max(150, Math.floor(s));\n  if (s === C && c.width === Math.round(s * dpr)) return;\n  C = s; c.style.width = c.style.height = s + \"px\"; c.width = c.height = Math.round(s * dpr); ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n}\nfunction renderPresets(){\n  var P = el(\"presets\"); P.innerHTML = \"\";\n  PRESETS.forEach(function(m){\n    var b = document.createElement(\"button\"); b.textContent = m + \"m\"; b.className = \"glass\" + (total === m * 60 ? \" on\" : \"\");\n    b.onclick = function(){ if (running) return; total = remaining = m * 60; finished = false; haptic(\"selection\"); renderPresets(); sync(); };\n    P.appendChild(b);\n  });\n}\nfunction fmt(s){ s = Math.max(0, Math.ceil(s)); var m = Math.floor(s / 60), ss = s % 60; return m + \":\" + (ss < 10 ? \"0\" : \"\") + ss; }\nfunction draw(){\n  var L = el(\"stage\").classList.contains(\"lite\"), cx = C / 2, cy = C / 2, r = C / 2 - 6;\n  ctx.clearRect(0, 0, C, C);\n  /* track */\n  ctx.beginPath(); ctx.arc(cx, cy, r + 6, 0, 6.2832); ctx.fillStyle = L ? \"rgba(255,255,255,.7)\" : \"rgba(255,255,255,.08)\"; ctx.fill();\n  ctx.beginPath(); ctx.arc(cx, cy, r, 0, 6.2832); ctx.fillStyle = L ? \"rgba(20,20,40,.06)\" : \"rgba(0,0,0,.28)\"; ctx.fill();\n  /* remaining wedge (depletes clockwise from top) */\n  var frac = total > 0 ? remaining / total : 0;\n  if (frac > 0){\n    var g = ctx.createRadialGradient(cx - r * .3, cy - r * .35, r * .1, cx, cy, r);\n    g.addColorStop(0, \"#ff7d72\"); g.addColorStop(1, COLOR);\n    ctx.beginPath(); ctx.moveTo(cx, cy);\n    ctx.arc(cx, cy, r, -Math.PI / 2, -Math.PI / 2 + Math.min(frac, .99999) * 6.2832, false);\n    ctx.closePath(); ctx.fillStyle = g; ctx.fill();\n  }\n  /* rim + hub */\n  ctx.beginPath(); ctx.arc(cx, cy, r, 0, 6.2832); ctx.lineWidth = 2; ctx.strokeStyle = L ? \"rgba(20,20,40,.12)\" : \"rgba(255,255,255,.16)\"; ctx.stroke();\n  ctx.beginPath(); ctx.arc(cx, cy, Math.max(5, C * .028), 0, 6.2832); ctx.fillStyle = L ? \"#fff\" : \"rgba(255,255,255,.9)\"; ctx.fill();\n}\n\n/* ---------- timer ---------- */\nfunction tick(){\n  remaining = (endAt - Date.now()) / 1000;          /* always from the clock, so time spent away still counts */\n  if (remaining <= 0){ remaining = 0; finish(); return; }\n  el(\"digits\").textContent = fmt(remaining);\n  draw();\n}\nfunction toggle(){\n  if (total <= 0) return;\n  if (running){ running = false; remaining = (endAt - Date.now()) / 1000; if (loop) clearInterval(loop); }\n  else {\n    if (remaining <= 0) remaining = total;\n    running = true; finished = false; staged = true; endAt = Date.now() + remaining * 1000;\n    haptic(\"light\"); primeAudio(); loop = setInterval(tick, 100);\n  }\n  sync(); syncChrome();\n  if (running) tick();\n}\nfunction reset(){\n  running = false; finished = false; staged = false; if (loop) clearInterval(loop);\n  remaining = total; sync(); syncChrome();\n}\nfunction finish(){\n  running = false; finished = true; if (loop) clearInterval(loop);\n  sync(); syncChrome();\n  haptic(\"success\"); chime();\n}\nfunction leave(){ haptic(\"light\"); staged = false; sync(); syncChrome(); }     /* the timer carries on; only the full screen ends */\n\nvar actx = null;\n/* made on the Start tap, so the chime is allowed to sound when the time is up */\nfunction primeAudio(){\n  try {\n    if (!actx){ var AC = window.AudioContext || window.webkitAudioContext; actx = new AC(); }\n    if (actx.state === \"suspended\") actx.resume();\n  } catch(e){}\n}\nfunction chime(){\n  try {\n    primeAudio();\n    [523.25, 659.25, 783.99].forEach(function(f, i){\n      var o = actx.createOscillator(), g = actx.createGain(), t = actx.currentTime + i * 0.18;\n      o.type = \"sine\"; o.frequency.value = f;\n      g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.3, t + 0.03); g.gain.exponentialRampToValueAtTime(0.0001, t + 0.6);\n      o.connect(g); g.connect(actx.destination); o.start(t); o.stop(t + 0.65);\n    });\n  } catch(e){}\n}\n\nel(\"go\").onclick = toggle;\nel(\"bReset\").onclick = reset;\nel(\"bDone\").onclick = leave;\nel(\"bNum\").onclick = function(){ showNum = !showNum; haptic(\"selection\"); sync(); };\n\nwindow.addEventListener(\"resize\", function(){ sizeCanvas(); draw(); });\ndocument.addEventListener(\"visibilitychange\", function(){\n  if (document.hidden) return;\n  if (running) tick();                               /* if it ran out while away: finished, and one chime */\n  if (staged) syncChrome();                          /* MyLLM puts its bars back when the app is left */\n});\nif (window.matchMedia){\n  var mq = matchMedia(\"(prefers-color-scheme: dark)\");\n  if (mq.addEventListener) mq.addEventListener(\"change\", function(){ syncLook(); draw(); }); else if (mq.addListener) mq.addListener(function(){ syncLook(); draw(); });\n}\n\n/* ---------- boot ---------- */\nrenderPresets(); sync();\n</script></body></html>\n", "kind": "html", "iconSymbol": "timer", "iconColor": "red"}