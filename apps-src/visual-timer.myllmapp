{"name": "Visual Timer", "html": "<!doctype html>\n<!--\n  Visual Timer — MyLLMos App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\">\n<style>:root{--build-id:\"166c8542e4\";color-scheme:light dark;--bg:#f2f2f7;--fg:#111;--card:#fff}\n@media(prefers-color-scheme:dark){:root{--bg:#000;--fg:#eee;--card:#1c1c1e}}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none}\nhtml,body{margin:0;height:100%;overflow:hidden}\nbody{font-family:-apple-system,system-ui,sans-serif;background:var(--bg);color:var(--fg);display:flex;flex-direction:column;align-items:center;padding:calc(16px + env(safe-area-inset-top)) 16px calc(16px + env(safe-area-inset-bottom));touch-action:manipulation}\nh1{font-size:20px;margin:0 0 10px;font-weight:700}\n.presets{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:10px}\n.presets button{border:0;background:rgba(127,127,127,.16);color:var(--fg);border-radius:14px;padding:9px 14px;font-size:14px;font-weight:600}\n.presets button.on{background:var(--accent,#f0584f);color:#fff}\n.stage{flex:1;display:flex;align-items:center;justify-content:center;width:100%}\ncanvas{max-width:100%;max-height:100%}\n.digits{font-size:34px;font-weight:800;font-variant-numeric:tabular-nums;margin-top:4px;min-height:42px}\n.bar{display:flex;gap:10px;margin-top:8px}\n.bar button{border:0;border-radius:16px;padding:13px 30px;font-size:16px;font-weight:700}\n#go{background:#f0584f;color:#fff}\n.sec{background:rgba(127,127,127,.16);color:var(--fg)}\n.opts{display:flex;gap:14px;margin-top:10px;font-size:13px;opacity:.7}\n.opts label{display:flex;align-items:center;gap:5px}\n</style></head><body>\n<h1>⏳ Visual Timer</h1>\n<div class=\"presets\" id=\"presets\"></div>\n<div class=\"stage\"><canvas id=\"c\" width=\"280\" height=\"280\"></canvas></div>\n<div class=\"digits\" id=\"digits\"></div>\n<div class=\"bar\">\n  <button id=\"go\" onclick=\"toggle()\">Start</button>\n  <button class=\"sec\" onclick=\"reset()\">Reset</button>\n</div>\n<div class=\"opts\">\n  <label><input type=\"checkbox\" id=\"showNum\" checked onchange=\"draw()\"> Show numbers</label>\n</div>\n<script>\nfunction haptic(s){if(window.myllmHaptic)try{myllmHaptic(s)}catch(e){}}\nvar PRESETS=[1,2,3,5,10,15,20],COLOR='#f0584f';\nvar total=5*60,remaining=5*60,running=false,endAt=0,loop=null;\nvar c=document.getElementById('c'),ctx=c.getContext('2d'),dpr=Math.max(1,Math.min(3,window.devicePixelRatio||1));\nfunction sizeCanvas(){var s=Math.min(window.innerWidth-32,window.innerHeight-340,320);s=Math.max(180,s);c.style.width=s+'px';c.style.height=s+'px';c.width=s*dpr;c.height=s*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);C=s}\nvar C=280;\nfunction renderPresets(){var P=document.getElementById('presets');P.innerHTML='';PRESETS.forEach(function(m){var b=document.createElement('button');b.textContent=m+'m';if(total===m*60)b.className='on';b.onclick=function(){if(running)return;total=remaining=m*60;renderPresets();draw();document.getElementById('digits').textContent=fmt(remaining)};P.appendChild(b)})}\nfunction fmt(s){s=Math.max(0,Math.ceil(s));var m=Math.floor(s/60),ss=s%60;return m+':'+(ss<10?'0':'')+ss}\nfunction draw(){\n  var cx=C/2,cy=C/2,r=C/2-8;\n  ctx.clearRect(0,0,C,C);\n  // track\n  ctx.beginPath();ctx.arc(cx,cy,r,0,6.2832);ctx.fillStyle='rgba(127,127,127,.14)';ctx.fill();\n  // remaining wedge (depletes clockwise from top)\n  var frac=total>0?remaining/total:0;\n  if(frac>0){\n    ctx.beginPath();ctx.moveTo(cx,cy);\n    ctx.arc(cx,cy,r,-Math.PI/2,-Math.PI/2+frac*6.2832,false);\n    ctx.closePath();ctx.fillStyle=COLOR;ctx.fill();\n  }\n  // rim\n  ctx.beginPath();ctx.arc(cx,cy,r,0,6.2832);ctx.lineWidth=4;ctx.strokeStyle='rgba(127,127,127,.35)';ctx.stroke();\n  if(document.getElementById('showNum').checked){\n    ctx.fillStyle=getComputedStyle(document.body).color;\n    ctx.font='800 '+Math.round(C*0.16)+'px -apple-system,system-ui';\n    ctx.textAlign='center';ctx.textBaseline='middle';\n    ctx.fillText(fmt(remaining),cx,cy);\n  }\n}\nfunction tick(){\n  remaining=(endAt-Date.now())/1000;\n  if(remaining<=0){remaining=0;finish()}\n  document.getElementById('digits').textContent=fmt(remaining);\n  draw();\n}\nfunction toggle(){\n  if(total<=0)return;\n  if(running){running=false;remaining=(endAt-Date.now())/1000;document.getElementById('go').textContent='Start';if(loop)clearInterval(loop);}\n  else{if(remaining<=0)remaining=total;running=true;endAt=Date.now()+remaining*1000;document.getElementById('go').textContent='Pause';haptic('light');loop=setInterval(tick,100);tick();}\n}\nfunction reset(){running=false;if(loop)clearInterval(loop);remaining=total;document.getElementById('go').textContent='Start';document.getElementById('digits').textContent=fmt(remaining);draw();}\nfunction finish(){\n  running=false;if(loop)clearInterval(loop);\n  document.getElementById('go').textContent='Start';\n  haptic('success');chime();\n}\nvar actx=null;\nfunction chime(){\n  try{\n    if(!actx){var AC=window.AudioContext||window.webkitAudioContext;actx=new AC()}\n    if(actx.state==='suspended')actx.resume();\n    [523.25,659.25,783.99].forEach(function(f,i){\n      var o=actx.createOscillator(),g=actx.createGain(),t=actx.currentTime+i*0.18;\n      o.type='sine';o.frequency.value=f;\n      g.gain.setValueAtTime(0.0001,t);g.gain.exponentialRampToValueAtTime(0.3,t+0.03);g.gain.exponentialRampToValueAtTime(0.0001,t+0.6);\n      o.connect(g);g.connect(actx.destination);o.start(t);o.stop(t+0.65);\n    });\n  }catch(e){}\n}\nwindow.addEventListener('resize',function(){sizeCanvas();draw()});\nsizeCanvas();renderPresets();document.getElementById('digits').textContent=fmt(remaining);draw();\n</script></body></html>\n", "kind": "html", "iconSymbol": "timer", "iconColor": "red"}