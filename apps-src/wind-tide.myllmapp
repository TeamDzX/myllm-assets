{"name": "Wind & Tide", "kind": "html", "iconSymbol": "wind", "iconColor": "teal", "html": "<!doctype html>\n<!--\n  Wind & Tide — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Wind &amp; Tide</title>\n<style>\n  :root{--build-id:\"52208c9049\"; color-scheme:light dark;\n    --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n    --muted:var(--myllm-muted,#6e6e73); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0891b2);\n    --sea:rgba(14,116,144,.13); --go:#15803d; --warn:#b45309; --bad:#b91c1c; --live:#0e7490; --fc:#7c3aed;--grain:0.253669293067;}\n  @media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n    --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#a1a1a6); --line:var(--myllm-border,#2c2c2e);\n    --sea:rgba(34,211,238,.13); --go:#4ade80; --warn:#fbbf24; --bad:#f87171; --live:#22d3ee; --fc:#c4b5fd; } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:620px; margin:0 auto; min-height:100dvh; -webkit-user-select:none; user-select:none;\n    padding:calc(12px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(40px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  input,select{ -webkit-user-select:text; user-select:text; font:inherit; color:inherit; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.97); }\n  button:disabled{ opacity:.45; cursor:default; transform:none; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.02em; margin:4px 2px 10px; display:flex; align-items:center; gap:10px; }\n  h1 .spot{ margin-left:auto; font-size:14px; font-weight:700; color:var(--acc); background:none; border:none; max-width:55%;\n    white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .tile{ width:34px; height:34px; border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0;\n    background:linear-gradient(145deg,#22d3ee,#0e7490); }\n  .tile svg{ width:20px; height:20px; stroke:#fff; fill:none; stroke-width:2.2; stroke-linecap:round; }\n  .hero{ width:100%; aspect-ratio:3/1; border-radius:18px; object-fit:cover; display:block; margin-bottom:12px; background:#0b3b4f; }\n  .seg{ display:flex; background:var(--surface); border:1px solid var(--line); border-radius:14px; padding:3px; margin-bottom:12px;\n    position:sticky; top:calc(4px + env(safe-area-inset-top)); z-index:5; }\n  .seg button{ flex:1; border:none; background:none; color:var(--muted); border-radius:11px; padding:9px 2px; min-height:42px; font-size:15px; font-weight:700; }\n  .seg button.on{ background:var(--acc); color:#fff; }\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  .card h2{ font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:var(--muted); margin-bottom:10px;\n    display:flex; align-items:center; gap:8px; }\n  .card h2 .r{ margin-left:auto; text-transform:none; letter-spacing:0; font-weight:600; }\n  .note{ font-size:13px; color:var(--muted); margin-top:8px; line-height:1.45; }\n  .note.warn{ color:var(--warn); font-weight:600; }\n  .hidden{ display:none !important; }\n  .row{ display:flex; align-items:center; gap:10px; }\n  .row + .row{ margin-top:10px; }\n  .btn{ border:1px solid var(--line); background:var(--bg); border-radius:12px; padding:10px 14px; min-height:44px; font-size:15px; font-weight:700; }\n  .btn.pri{ background:var(--acc); border-color:var(--acc); color:#fff; }\n  .btn.small{ min-height:36px; padding:6px 12px; font-size:14px; }\n  .link{ background:none; border:none; color:var(--acc); font-weight:700; font-size:14px; padding:6px 0; }\n  .field{ width:100%; border:1px solid var(--line); border-radius:12px; padding:10px 12px; background:var(--bg); font-size:16px; min-height:44px; }\n  label.lb{ display:block; font-size:13px; font-weight:700; color:var(--muted); margin:12px 2px 6px; }\n\n  /* Now */\n  .now{ display:grid; grid-template-columns:auto 1fr; gap:14px; align-items:center; }\n  .compass{ width:168px; height:168px; }\n  .verdict{ display:inline-block; border-radius:999px; padding:6px 12px; font-weight:800; font-size:15px; color:#fff; background:var(--muted); }\n  .verdict.go{ background:var(--go); } .verdict.warn{ background:var(--warn); } .verdict.bad{ background:var(--bad); }\n  @media (prefers-color-scheme:dark){ .verdict.go,.verdict.warn,.verdict.bad{ color:#000; } }\n  .bigspd{ font-size:40px; font-weight:800; letter-spacing:-.03em; line-height:1; margin-top:10px; font-variant-numeric:tabular-nums; }\n  .bigspd small{ font-size:16px; font-weight:700; color:var(--muted); letter-spacing:0; }\n  .sub{ font-size:14px; color:var(--muted); margin-top:6px; line-height:1.4; }\n  .sub b{ color:var(--ink); }\n  .legend{ display:flex; gap:14px; font-size:12px; color:var(--muted); margin-top:10px; flex-wrap:wrap; }\n  .legend i{ display:inline-block; width:18px; height:3px; border-radius:2px; vertical-align:middle; margin-right:5px; }\n  .vs{ display:grid; grid-template-columns:1fr 1fr; gap:10px; }\n  .vs > div{ background:var(--bg); border:1px solid var(--line); border-radius:12px; padding:10px; }\n  .vs .k{ font-size:12px; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:.05em; }\n  .vs .v{ font-size:20px; font-weight:800; margin-top:4px; font-variant-numeric:tabular-nums; }\n  .diff{ margin-top:10px; font-size:14px; font-weight:700; }\n  .stations .st{ display:flex; align-items:center; gap:10px; padding:9px 0; border-top:1px solid var(--line); }\n  .stations .st:first-child{ border-top:none; padding-top:0; }\n  .st .nm{ flex:1; min-width:0; }\n  .st .nm b{ display:block; font-size:15px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .st .nm span{ font-size:12.5px; color:var(--muted); }\n  .st .w{ text-align:right; font-weight:800; font-variant-numeric:tabular-nums; }\n  .st .w span{ display:block; font-size:12px; font-weight:600; color:var(--muted); }\n  .arrow{ width:26px; height:26px; flex-shrink:0; }\n  .chart{ width:100%; height:170px; display:block; }\n  .raw{ font-family:ui-monospace,Menlo,monospace; font-size:12.5px; color:var(--muted); line-height:1.5; word-break:break-word;\n    background:var(--bg); border:1px solid var(--line); border-radius:10px; padding:8px 10px; margin-top:8px; -webkit-user-select:text; user-select:text; }\n\n  /* Forecast */\n  .day{ margin-bottom:12px; }\n  .dayhead{ display:flex; align-items:baseline; gap:8px; margin:4px 4px 8px; }\n  .dayhead b{ font-size:17px; }\n  .dayhead span{ font-size:13px; color:var(--muted); }\n  .dayhead .best{ margin-left:auto; color:var(--go); font-weight:700; text-align:right; }\n  .hours{ background:var(--surface); border:1px solid var(--line); border-radius:16px; overflow:hidden; }\n  .hr{ display:grid; grid-template-columns:48px 28px 1fr 66px; align-items:center; gap:8px; padding:7px 10px 7px 8px;\n    border-top:1px solid var(--line); border-left:4px solid transparent; }\n  .hr:first-child{ border-top:none; }\n  .hr.go{ border-left-color:var(--go); }\n  .hr.night{ opacity:.55; }\n  .hr .t{ font-weight:700; font-variant-numeric:tabular-nums; font-size:14.5px; }\n  .hr .t small{ display:block; font-size:10.5px; font-weight:600; color:var(--muted); }\n  .hr .mid{ min-width:0; }\n  .bar{ height:9px; border-radius:5px; }\n  .hr .meta{ font-size:12px; color:var(--muted); margin-top:4px; line-height:1.35; }\n  .hr .meta .bad{ color:var(--bad); font-weight:700; } .hr .meta .warn{ color:var(--warn); font-weight:700; }\n  .hr .kn{ text-align:right; font-weight:800; font-variant-numeric:tabular-nums; font-size:16px; }\n  .hr .kn small{ display:block; font-size:11.5px; font-weight:600; color:var(--muted); }\n  .scale{ display:flex; border-radius:6px; overflow:hidden; margin-top:6px; }\n  .scale div{ flex:1; font-size:10.5px; font-weight:700; text-align:center; padding:3px 0; color:#111; }\n\n  /* Tides */\n  .tides .ev{ display:flex; align-items:center; gap:10px; padding:8px 0; border-top:1px solid var(--line); font-variant-numeric:tabular-nums; }\n  .tides .ev:first-child{ border-top:none; }\n  .ev .ty{ width:56px; font-weight:800; }\n  .ev .ty.hw{ color:var(--live); } .ev .ty.lw{ color:var(--muted); }\n  .ev .tm{ flex:1; font-weight:600; }\n  .ev .ht{ font-weight:800; }\n  .ev.past{ opacity:.5; }\n  .tidebig{ font-size:22px; font-weight:800; margin-bottom:6px; }\n\n  /* Spots */\n  .spotrow{ display:flex; align-items:center; gap:10px; padding:10px 0; border-top:1px solid var(--line); }\n  .spotrow:first-child{ border-top:none; }\n  .spotrow .nm{ flex:1; min-width:0; }\n  .spotrow .nm b{ display:block; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .spotrow .nm span{ font-size:12.5px; color:var(--muted); }\n  .spotrow.cur .nm b{ color:var(--acc); }\n  .dial{ width:220px; height:220px; display:block; margin:6px auto 0; touch-action:none; }\n  .results button{ display:block; width:100%; text-align:left; border:none; border-top:1px solid var(--line); background:none; padding:10px 2px; }\n  .results button span{ display:block; font-size:12.5px; color:var(--muted); }\n  .grid2{ display:grid; grid-template-columns:1fr 1fr; gap:10px; }\n  .sheet{ position:fixed; inset:0; background:rgba(0,0,0,.4); z-index:50; display:flex; align-items:flex-end; justify-content:center; }\n  .sheet > div{ background:var(--bg); width:100%; max-width:620px; max-height:92dvh; overflow:auto; border-radius:20px 20px 0 0;\n    padding:16px 16px calc(24px + env(safe-area-inset-bottom)); }\n  .sheet h3{ font-size:18px; font-weight:800; margin-bottom:6px; display:flex; align-items:center; }\n  .sheet h3 button{ margin-left:auto; }\n  .spin{ display:inline-block; width:14px; height:14px; border:2px solid var(--line); border-top-color:var(--acc); border-radius:50%;\n    animation:sp 0.8s linear infinite; vertical-align:-2px; }\n  @keyframes sp{ to{ transform:rotate(360deg); } }\n  .ai{ font-size:15px; line-height:1.5; margin-top:10px; -webkit-user-select:text; user-select:text; }\n</style>\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\">⚙️</span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n</head>\n<body>\n<h1><span class=\"tile\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 8h11a3 3 0 1 0-3-3\"/><path d=\"M3 12h16a3 3 0 1 1-3 3\"/><path d=\"M3 16h7\"/></svg></span>Wind &amp; Tide\n  <button class=\"spot\" id=\"spotBtn\">Add a spot</button></h1>\n<img class=\"hero\" id=\"hero\" alt=\"\" src=\"data:image/webp;base64,\">\n\n<div class=\"seg\" role=\"tablist\">\n  <button data-tab=\"now\" class=\"on\">Now</button>\n  <button data-tab=\"fc\">Forecast</button>\n  <button data-tab=\"tide\">Tides</button>\n  <button data-tab=\"spots\">Spots</button>\n</div>\n\n<!-- Now -->\n<section id=\"tab-now\">\n  <div class=\"card hidden\" id=\"welcome\">\n    <h2>Welcome</h2>\n    <p style=\"font-size:15px;line-height:1.5\">Add the beach you ride from. Wind &amp; Tide shows the live wind from the nearest airports next to the forecast for your spot, picks out the hours that suit wingfoiling, and adds the tides.</p>\n    <div class=\"row\" style=\"margin-top:12px\"><button class=\"btn pri\" id=\"welcomeAdd\">Add my spot</button></div>\n  </div>\n\n  <div class=\"card hidden\" id=\"nowCard\">\n    <div class=\"now\">\n      <svg class=\"compass\" id=\"compass\" viewBox=\"-100 -100 200 200\" aria-label=\"Wind direction\"></svg>\n      <div>\n        <span class=\"verdict\" id=\"verdict\">…</span>\n        <div class=\"bigspd\" id=\"bigSpd\">–</div>\n        <div class=\"sub\" id=\"nowSub\"></div>\n      </div>\n    </div>\n    <div class=\"legend\"><span><i style=\"background:var(--live)\"></i>Live (airport)</span><span><i style=\"background:var(--fc)\"></i>Forecast at your spot</span><span><i style=\"background:var(--sea);height:8px\"></i>Sea side</span></div>\n    <div class=\"sub\" id=\"liveLine\" style=\"margin-top:10px\"></div>\n    <p class=\"note\" id=\"wingNote\"></p>\n  </div>\n\n  <div class=\"card hidden\" id=\"vsCard\">\n    <h2>Forecast or reality? <span class=\"r\" id=\"vsWhere\"></span></h2>\n    <div class=\"vs\">\n      <div><div class=\"k\">Forecast</div><div class=\"v\" id=\"vsFc\">–</div></div>\n      <div><div class=\"k\">Measured</div><div class=\"v\" id=\"vsLive\">–</div></div>\n    </div>\n    <div class=\"diff\" id=\"vsDiff\"></div>\n    <svg class=\"chart\" id=\"chart\" viewBox=\"0 0 340 170\" preserveAspectRatio=\"none\"></svg>\n    <div class=\"legend\"><span><i style=\"background:var(--fc)\"></i>Forecast</span><span><i style=\"background:var(--live);height:6px;width:6px;border-radius:3px\"></i>Measured</span></div>\n    <p class=\"note\" id=\"biasNote\"></p>\n  </div>\n\n  <div class=\"card hidden\" id=\"stCard\">\n    <h2>Nearby live wind <span class=\"r\"><button class=\"link\" id=\"refresh\">Refresh</button></span></h2>\n    <div class=\"stations\" id=\"stations\"></div>\n    <p class=\"note\">From airport weather reports (METAR), usually every 30 to 60 minutes. Airports sit inland, so a beach can be windier.</p>\n  </div>\n\n  <div class=\"card hidden\" id=\"tafCard\">\n    <h2>Airport forecast <span class=\"r\" id=\"tafWhere\"></span></h2>\n    <div class=\"sub\" id=\"tafSum\"></div>\n    <div class=\"raw\" id=\"tafRaw\"></div>\n  </div>\n\n  <div class=\"card hidden\" id=\"aiCard\">\n    <h2>Session summary</h2>\n    <button class=\"btn\" id=\"aiBtn\">Summarise the next two days</button>\n    <div class=\"ai\" id=\"aiOut\"></div>\n  </div>\n  <p class=\"note\" id=\"nowErr\"></p>\n</section>\n\n<!-- Forecast -->\n<section id=\"tab-fc\" class=\"hidden\">\n  <div class=\"card\">\n    <h2>Wind at your spot <span class=\"r\" id=\"fcUpdated\"></span></h2>\n    <div class=\"scale\" id=\"scale\"></div>\n    <p class=\"note\">Green edge = good for wingfoiling: inside your wind range, not offshore, in daylight. Gusts are estimated: the free forecast doesn't give them for the UK.</p>\n  </div>\n  <div id=\"fcList\"></div>\n  <p class=\"note\" id=\"fcErr\"></p>\n</section>\n\n<!-- Tides -->\n<section id=\"tab-tide\" class=\"hidden\">\n  <div class=\"card hidden\" id=\"tideKeyCard\">\n    <h2>Tides from the Admiralty</h2>\n    <p style=\"font-size:15px;line-height:1.5\">UK tide times come from the UK Hydrographic Office. Their free <b>Discovery</b> plan gives 7 days of high and low water for about 600 UK ports. It needs your own free key:</p>\n    <ol style=\"font-size:14.5px;line-height:1.55;margin:10px 0 0 20px\">\n      <li>Sign up at <a href=\"https://admiraltyapi.developer.azure-api.net\" target=\"_blank\" style=\"color:var(--acc)\">admiraltyapi.developer.azure-api.net</a>.</li>\n      <li>Under Products, subscribe to <b>UK Tidal API – Discovery</b>.</li>\n      <li>Copy the primary key from your profile and paste it here.</li>\n    </ol>\n    <input class=\"field\" id=\"tideKey\" placeholder=\"Paste your Admiralty key\" autocomplete=\"off\" autocapitalize=\"off\" spellcheck=\"false\" style=\"margin-top:12px\">\n    <div class=\"row\" style=\"margin-top:10px\"><button class=\"btn pri\" id=\"tideKeySave\">Save key</button></div>\n    <p class=\"note\">The key stays in this app on your phone and is only sent to the Admiralty.</p>\n  </div>\n  <div class=\"card hidden\" id=\"tideCard\">\n    <h2>Tide <span class=\"r\" id=\"tideWhere\"></span></h2>\n    <div class=\"tidebig\" id=\"tideNow\"></div>\n    <svg class=\"chart\" id=\"tideChart\" viewBox=\"0 0 340 170\" preserveAspectRatio=\"none\"></svg>\n    <div class=\"tides\" id=\"tideList\"></div>\n    <p class=\"note\">Predicted times from the UK Hydrographic Office. Wind and pressure can move the real tide by tens of minutes.</p>\n  </div>\n  <p class=\"note\" id=\"tideErr\"></p>\n</section>\n\n<!-- Spots -->\n<section id=\"tab-spots\" class=\"hidden\">\n  <div class=\"card\">\n    <h2>Your spots <span class=\"r\"><button class=\"link\" id=\"addSpot\">+ Add</button></span></h2>\n    <div id=\"spotList\"></div>\n  </div>\n  <div class=\"card\">\n    <h2>Your riding</h2>\n    <label class=\"lb\">Wind range for your kit</label>\n    <div class=\"grid2\">\n      <select class=\"field\" id=\"pMin\"></select>\n      <select class=\"field\" id=\"pMax\"></select>\n    </div>\n    <label class=\"lb\">Your weight (for the wing size guide)</label>\n    <select class=\"field\" id=\"pWeight\"></select>\n    <label class=\"lb\">Speed unit</label>\n    <select class=\"field\" id=\"pUnit\">\n      <option value=\"kn\">Knots</option><option value=\"mph\">mph</option><option value=\"kmh\">km/h</option><option value=\"ms\">m/s</option>\n    </select>\n    <label class=\"lb\">Admiralty tide key</label>\n    <div class=\"row\"><span class=\"sub\" id=\"keyState\" style=\"margin:0;flex:1\"></span><button class=\"btn small\" id=\"keyClear\">Remove</button></div>\n  </div>\n  <div class=\"card\">\n    <h2>About the data</h2>\n    <p class=\"note\" style=\"margin-top:0\">Forecast: MET Norway (CC BY 4.0). Live wind and airport forecasts: aviationweather.gov (US National Weather Service). Tides: UK Hydrographic Office, with your own key. Windguru has no public data feed, so each spot can open its Windguru page instead. Always check local conditions and never ride alone in offshore wind.</p>\n  </div>\n</section>\n\n<!-- Spot editor -->\n<div class=\"sheet hidden\" id=\"sheet\"><div>\n  <h3 id=\"sheetTitle\">Add a spot <button class=\"link\" id=\"sheetClose\">Cancel</button></h3>\n  <div id=\"stepFind\">\n    <div class=\"row\" style=\"margin-top:8px\"><button class=\"btn pri\" id=\"useLoc\" style=\"flex:1\">Use my location</button></div>\n    <label class=\"lb\">Or search for a beach or town</label>\n    <div class=\"row\"><input class=\"field\" id=\"q\" placeholder=\"e.g. Studland, Hayling Island\" enterkeyhint=\"search\"><button class=\"btn\" id=\"qGo\">Search</button></div>\n    <div class=\"results\" id=\"results\"></div>\n    <label class=\"lb\">Or type coordinates</label>\n    <div class=\"row\"><input class=\"field\" id=\"ll\" placeholder=\"50.6936, -1.9459\" inputmode=\"decimal\"><button class=\"btn\" id=\"llGo\">Use</button></div>\n    <p class=\"note\" id=\"findNote\"></p>\n  </div>\n  <div id=\"stepSet\" class=\"hidden\">\n    <label class=\"lb\">Name</label>\n    <input class=\"field\" id=\"sName\">\n    <label class=\"lb\">Which way is the sea? Tap or drag the dial.</label>\n    <svg class=\"dial\" id=\"dial\" viewBox=\"-110 -110 220 220\"></svg>\n    <p class=\"sub\" id=\"dialTxt\" style=\"text-align:center\"></p>\n    <label class=\"lb\">Windguru page (optional)</label>\n    <input class=\"field\" id=\"sWg\" placeholder=\"https://www.windguru.cz/…\" autocapitalize=\"off\" spellcheck=\"false\">\n    <div class=\"row\" style=\"margin-top:14px\"><button class=\"btn pri\" id=\"sSave\" style=\"flex:1\">Save spot</button><button class=\"btn hidden\" id=\"sDel\">Delete</button></div>\n  </div>\n</div></div>\n\n<script>\n(function(){\n'use strict';\nvar $ = function(id){ return document.getElementById(id); };\nvar store = window.myllmStorage || { getItem:function(){ return Promise.resolve(null); }, setItem:function(){ return Promise.resolve(); } };\nfunction haptic(k){ try{ if(window.myllmHaptic) window.myllmHaptic(k||'light'); }catch(e){} }\nvar UA = 'MyLLM-WindTide/1.0 (+https://github.com/TeamDzX/myllm-assets)';\nvar KN = 1.943844;          // m/s → knots\nvar GUST = 1.3;             // gust estimate when the source gives none\n\nvar S = { spots:[], cur:null, prefs:{ min:12, max:28, weight:80, unit:'kn' }, tideKey:'' };\nvar D = {};                 // data for the current spot, rebuilt on each load\nvar loadedAt = 0, loading = false;\n\n/* ---------- storage ---------- */\nfunction load(k, def){ return Promise.resolve(store.getItem('wt1.' + k)).then(function(v){ try{ return v ? JSON.parse(v) : def; }catch(e){ return def; } }, function(){ return def; }); }\nfunction save(k, v){ try{ return Promise.resolve(store.setItem('wt1.' + k, JSON.stringify(v))).catch(function(){}); }catch(e){ return Promise.resolve(); } }\n\n/* ---------- network: iOS answers {ok,status,body}, Android answers the body text ---------- */\nfunction getText(url, headers){\n  var f = window.myllmFetch;\n  if(typeof f !== 'function') return Promise.reject(new Error('This version of MyLLM has no network access for apps.'));\n  return Promise.resolve(f(url, { headers: headers || {} })).then(function(r){\n    if(typeof r === 'string') return r;\n    if(!r) throw new Error('No answer');\n    if(r.error) throw new Error(r.error);\n    if(r.ok === false) throw new Error('HTTP ' + r.status);\n    if(typeof r.body === 'string') return r.body;\n    if(r.bodyBase64) return atob(r.bodyBase64);\n    return '';\n  });\n}\nfunction getJSON(url, headers){\n  return getText(url, headers).then(function(t){\n    try{ return JSON.parse(t); }catch(e){ var err = new Error('unreadable answer'); err.body = String(t).slice(0, 200); throw err; }\n  });\n}\n\n/* ---------- units and angles ---------- */\nvar UNITS = { kn:{ f:1, s:'kn' }, mph:{ f:1.150779, s:'mph' }, kmh:{ f:1.852, s:'km/h' }, ms:{ f:0.514444, s:'m/s' } };\nfunction sp(kn){ var u = UNITS[S.prefs.unit] || UNITS.kn; return Math.round(kn * u.f); }\nfunction us(){ return (UNITS[S.prefs.unit] || UNITS.kn).s; }\nvar PTS = ['N','NNE','NE','ENE','E','ESE','SE','SSE','S','SSW','SW','WSW','W','WNW','NW','NNW'];\nfunction compassName(d){ return PTS[Math.round(((d % 360) + 360) % 360 / 22.5) % 16]; }\nfunction angDiff(a, b){ return Math.abs(((a - b) % 360 + 540) % 360 - 180); }\n// How the wind meets the beach. `facing` is the bearing from the beach out to sea.\nfunction relation(from, facing){\n  if(from == null || facing == null) return null;\n  var d = angDiff(from, facing);\n  if(d <= 30) return { k:'onshore', t:'onshore', lvl:'ok' };\n  if(d <= 75) return { k:'cross-on', t:'cross-onshore', lvl:'ok' };\n  if(d <= 105) return { k:'cross', t:'cross-shore', lvl:'ok' };\n  if(d <= 150) return { k:'cross-off', t:'cross-offshore', lvl:'warn' };\n  return { k:'off', t:'offshore', lvl:'bad' };\n}\nfunction verdict(kn, from, facing){\n  var r = relation(from, facing);\n  if(r && r.lvl === 'bad') return { t:'Offshore: stay in', c:'bad' };\n  if(kn < S.prefs.min) return { t: kn < S.prefs.min - 4 ? 'Too light' : 'Marginal', c: kn < S.prefs.min - 4 ? '' : 'warn' };\n  if(kn > S.prefs.max) return { t:'Too strong', c:'bad' };\n  if(r && r.lvl === 'warn') return { t:'Cross-offshore: take care', c:'warn' };\n  return { t:'Go', c:'go' };\n}\nfunction goodHour(h, facing){\n  var r = relation(h.dir, facing);\n  return h.kn >= S.prefs.min && h.kn <= S.prefs.max && !(r && r.lvl !== 'ok');\n}\n// A rough wing size, scaled from an 80 kg rider's quiver.\nfunction wingSize(kn){\n  if(kn < 9) return null;\n  var T = [[12,6],[14,5.5],[16,5],[18,4.5],[21,4],[25,3.5],[30,3],[99,2.5]];\n  var base = 2.5; for(var i = 0; i < T.length; i++){ if(kn < T[i][0]){ base = T[i][1]; break; } }\n  var m = Math.round(base * (S.prefs.weight / 80) * 2) / 2;\n  return Math.max(2, Math.min(7, m));\n}\nfunction colour(kn){\n  var C = [[5,'#dbeafe'],[8,'#a5f3fc'],[12,'#86efac'],[16,'#bef264'],[20,'#fde047'],[25,'#fdba74'],[30,'#f87171'],[999,'#e879f9']];\n  for(var i = 0; i < C.length; i++) if(kn < C[i][0]) return C[i][1];\n  return '#e879f9';\n}\nfunction km(a, b){\n  var R = 6371, toR = Math.PI / 180, dLa = (b.lat - a.lat) * toR, dLo = (b.lon - a.lon) * toR;\n  var x = Math.sin(dLa/2) * Math.sin(dLa/2) + Math.cos(a.lat*toR) * Math.cos(b.lat*toR) * Math.sin(dLo/2) * Math.sin(dLo/2);\n  return 2 * R * Math.asin(Math.sqrt(x));\n}\nfunction hm(d){ return d.toLocaleTimeString([], { hour:'2-digit', minute:'2-digit' }); }\nfunction hh(d){ return d.toLocaleTimeString([], { hour:'2-digit' }).replace(/:00$/, ''); }\nfunction dayName(d){\n  var t = new Date(); t.setHours(0,0,0,0); var x = new Date(d); x.setHours(0,0,0,0);\n  var n = Math.round((x - t) / 864e5);\n  if(n === 0) return 'Today'; if(n === 1) return 'Tomorrow';\n  return x.toLocaleDateString([], { weekday:'long' });\n}\nfunction ago(ms){ var m = Math.round((Date.now() - ms) / 60000); if(m < 1) return 'just now'; if(m < 60) return m + ' min ago'; var h = Math.floor(m / 60); return h + ' h ' + (m % 60) + ' min ago'; }\nfunction esc(s){ return String(s == null ? '' : s).replace(/[&<>\"]/g, function(c){ return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '\"':'&quot;' }[c]; }); }\nfunction hourKey(d){ var x = new Date(d); x.setMinutes(0,0,0); return x.toISOString().slice(0, 13); }\n\n/* ---------- sunrise and sunset (NOAA approximation) ---------- */\nfunction sunTimes(date, lat, lon){\n  var rad = Math.PI / 180, d = new Date(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate(), 12));\n  var n = Math.floor((d - Date.UTC(2000, 0, 1, 12)) / 864e5) + 0.0008;\n  var J = n - lon / 360, M = (357.5291 + 0.98560028 * J) % 360;\n  var C = 1.9148 * Math.sin(M*rad) + 0.02 * Math.sin(2*M*rad) + 0.0003 * Math.sin(3*M*rad);\n  var L = (M + C + 180 + 102.9372) % 360;\n  var Jt = 2451545 + J + 0.0053 * Math.sin(M*rad) - 0.0069 * Math.sin(2*L*rad);\n  var dec = Math.asin(Math.sin(L*rad) * Math.sin(23.44*rad));\n  var cosw = (Math.sin(-0.833*rad) - Math.sin(lat*rad) * Math.sin(dec)) / (Math.cos(lat*rad) * Math.cos(dec));\n  if(cosw > 1 || cosw < -1) return null;\n  var w = Math.acos(cosw) / rad;\n  var toDate = function(j){ return new Date((j - 2440587.5) * 864e5); };\n  return { rise: toDate(Jt - w / 360), set: toDate(Jt + w / 360) };\n}\nfunction daylight(t, spot){\n  var s = sunTimes(t, spot.lat, spot.lon); if(!s) return true;\n  return t >= new Date(s.rise.getTime() - 30*60000) && t <= new Date(s.set.getTime() + 30*60000);\n}\n\n/* ---------- sources ---------- */\nfunction metForecast(lat, lon){\n  var u = 'https://api.met.no/weatherapi/locationforecast/2.0/compact?lat=' + lat.toFixed(4) + '&lon=' + lon.toFixed(4);\n  return getJSON(u, { 'User-Agent': UA }).then(function(j){\n    if(!j || !j.properties || !j.properties.timeseries) throw new Error('no forecast');\n    var out = [], prev = null;\n    j.properties.timeseries.forEach(function(x){\n      var i = x.data.instant.details, t = new Date(x.time);\n      var nx = x.data.next_1_hours || x.data.next_6_hours || {};\n      var step = prev ? Math.round((t - prev) / 36e5) : 1; prev = t;\n      out.push({ t:t, kn: i.wind_speed * KN, dir: i.wind_from_direction, temp: i.air_temperature,\n                 rain: nx.details && nx.details.precipitation_amount, sym: nx.summary && nx.summary.symbol_code, step: step });\n    });\n    if(out.length > 1) out[0].step = Math.round((out[1].t - out[0].t) / 36e5);\n    return { hours: out, updated: new Date(j.properties.meta.updated_at) };\n  });\n}\nfunction metarNear(spot){\n  function q(dLat, dLon){\n    var b = [spot.lat - dLat, spot.lon - dLon, spot.lat + dLat, spot.lon + dLon].map(function(v){ return v.toFixed(2); }).join(',');\n    return getJSON('https://aviationweather.gov/api/data/metar?bbox=' + b + '&format=json');\n  }\n  return q(0.8, 1.2).then(function(a){ return (a && a.length) ? a : q(2, 3); }).then(function(a){\n    return (a || []).map(function(m){\n      return { id:m.icaoId, name:(m.name || m.icaoId).replace(/,\\s*[A-Z]{2},\\s*[A-Z]{2}$/, ''), lat:m.lat, lon:m.lon,\n               dir: typeof m.wdir === 'number' ? m.wdir : null, vrb: m.wdir === 'VRB', kn: m.wspd || 0, gust: m.wgst || null,\n               at: (m.obsTime ? m.obsTime * 1000 : Date.parse(m.reportTime)), raw: m.rawOb,\n               dist: km(spot, { lat:m.lat, lon:m.lon }) };\n    }).filter(function(m){ return isFinite(m.dist); }).sort(function(a, b){ return a.dist - b.dist; }).slice(0, 4);\n  });\n}\nfunction metarHistory(id){\n  return getJSON('https://aviationweather.gov/api/data/metar?ids=' + id + '&format=json&hours=12').then(function(a){\n    return (a || []).map(function(m){ return { at: m.obsTime ? m.obsTime * 1000 : Date.parse(m.reportTime), kn: m.wspd || 0, gust: m.wgst || null,\n      dir: typeof m.wdir === 'number' ? m.wdir : null }; }).sort(function(a, b){ return a.at - b.at; });\n  });\n}\nfunction taf(id){\n  return getJSON('https://aviationweather.gov/api/data/taf?ids=' + id + '&format=json').then(function(a){ return a && a[0] ? a[0].rawTAF : null; });\n}\nvar TIDE = 'https://admiraltyapi.azure-api.net/uktidalapi/api/V1/';\nvar tideStations = null;     // kept for this visit only\nfunction tideFor(spot){\n  if(!S.tideKey) return Promise.resolve(null);\n  var k = 'subscription-key=' + encodeURIComponent(S.tideKey);\n  var stations = tideStations ? Promise.resolve(tideStations) : getJSON(TIDE + 'Stations?' + k).then(function(j){\n    tideStations = (j.features || []).map(function(f){ return { id:f.properties.Id, name:f.properties.Name,\n      lon:f.geometry.coordinates[0], lat:f.geometry.coordinates[1] }; });\n    return tideStations;\n  });\n  return stations.then(function(list){\n    var best = null;\n    list.forEach(function(s){ var d = km(spot, s); if(!best || d < best.dist) best = { st:s, dist:d }; });\n    if(!best || best.dist > 60) return { none:true, dist: best && best.dist };\n    return getJSON(TIDE + 'Stations/' + encodeURIComponent(best.st.id) + '/TidalEvents?duration=7&' + k).then(function(ev){\n      var events = (ev || []).map(function(e){ var s = String(e.DateTime || ''); if(!/Z|[+-]\\d\\d:?\\d\\d$/.test(s)) s += 'Z';\n        return { t:new Date(s), hw:e.EventType === 'HighWater', h:e.Height, approx: !!(e.IsApproximateTime || e.IsApproximateHeight) }; })\n        .filter(function(e){ return !isNaN(e.t); }).sort(function(a, b){ return a.t - b.t; });\n      return { station:best.st, dist:best.dist, events:events };\n    });\n  });\n}\nfunction tideAt(t, events){\n  for(var i = 0; i < events.length - 1; i++){\n    var a = events[i], b = events[i + 1];\n    if(t >= a.t && t <= b.t && a.h != null && b.h != null){\n      var f = (t - a.t) / (b.t - a.t);\n      return { h: a.h + (b.h - a.h) * (1 - Math.cos(Math.PI * f)) / 2, rising: b.hw, next: b };\n    }\n  }\n  return null;\n}\n\n/* ---------- forecast against what was measured ---------- */\nfunction recordAirport(id, fc, hist){\n  return Promise.all([load('snap.' + id, {}), load('pairs.' + id, [])]).then(function(r){\n    var snap = r[0], pairs = r[1], now = Date.now();\n    // Each coming hour keeps the latest forecast made before it.\n    fc.hours.forEach(function(h){ if(h.step === 1 && h.t.getTime() >= now - 30*60000 && h.t.getTime() < now + 36*36e5) snap[hourKey(h.t)] = Math.round(h.kn * 10) / 10; });\n    var have = {}; pairs.forEach(function(p){ have[p[0]] = 1; });\n    hist.forEach(function(o){\n      var k = hourKey(new Date(Math.round(o.at / 36e5) * 36e5));   // the nearest whole hour\n      if(snap[k] != null && !have[k] && o.at < now){ pairs.push([k, snap[k], o.kn]); have[k] = 1; }\n    });\n    var cut = new Date(now - 3 * 864e5).toISOString().slice(0, 13);\n    Object.keys(snap).forEach(function(k){ if(k < cut) delete snap[k]; });\n    pairs = pairs.slice(-300);\n    save('snap.' + id, snap); save('pairs.' + id, pairs);\n    return { snap:snap, pairs:pairs };\n  });\n}\n\n/* ---------- loading ---------- */\nfunction loadAll(force){\n  var spot = S.cur;\n  if(!spot){ render(); return; }\n  if(loading) return;\n  if(!force && D.spotId === spot.id && Date.now() - loadedAt < 10 * 60000){ render(); return; }\n  loading = true;\n  D = { spotId: spot.id, busy: true };\n  render();\n  var fcP = metForecast(spot.lat, spot.lon).then(function(f){ D.fc = f; }, function(e){ D.fcErr = e; });\n  var stP = metarNear(spot).then(function(list){\n    D.stations = list;\n    var a = list[0]; if(!a) return;\n    D.airport = a;\n    return Promise.all([\n      metarHistory(a.id).catch(function(){ return []; }),\n      metForecast(a.lat, a.lon).catch(function(){ return null; }),\n      taf(a.id).catch(function(){ return null; })\n    ]).then(function(r){\n      D.hist = r[0]; D.apFc = r[1]; D.taf = r[2];\n      if(D.apFc) return recordAirport(a.id, D.apFc, D.hist).then(function(x){ D.snap = x.snap; D.pairs = x.pairs; });\n    });\n  }, function(e){ D.stErr = e; });\n  var tdP = tideFor(spot).then(function(t){ D.tide = t; }, function(e){ D.tideErr = e; });\n  Promise.all([fcP, stP, tdP]).then(function(){ D.busy = false; loading = false; loadedAt = Date.now(); render(); });\n}\n\n/* ---------- drawing ---------- */\nfunction arrowPath(r){ return 'M0,' + (-r) + ' L' + (r*0.32) + ',' + (r*0.18) + ' L0,' + (r*0.02) + ' L' + (-r*0.32) + ',' + (r*0.18) + ' Z'; }\n// An arrow pointing the way the wind blows (from + 180).\nfunction arrowSVG(from, colourVar){\n  if(from == null) return '<svg class=\"arrow\" viewBox=\"-12 -12 24 24\"><circle r=\"4\" fill=\"var(--muted)\"/></svg>';\n  return '<svg class=\"arrow\" viewBox=\"-12 -12 24 24\"><path d=\"' + arrowPath(10) + '\" fill=\"var(' + (colourVar || '--ink') + ')\" transform=\"rotate(' + (from + 180) + ')\"/></svg>';\n}\nfunction drawCompass(svg, facing, live, fc){\n  var h = '';\n  if(facing != null){\n    var a0 = (facing - 90) * Math.PI / 180, a1 = (facing + 90) * Math.PI / 180, r = 86;\n    var p = function(a){ return (r * Math.sin(a)).toFixed(1) + ',' + (-r * Math.cos(a)).toFixed(1); };\n    h += '<path d=\"M0,0 L' + p(a0) + ' A' + r + ',' + r + ' 0 0 1 ' + p(a1) + ' Z\" fill=\"var(--sea)\"/>';\n  }\n  h += '<circle r=\"86\" fill=\"none\" stroke=\"var(--line)\" stroke-width=\"2\"/>';\n  for(var i = 0; i < 16; i++){\n    var a = i * 22.5 * Math.PI / 180, o = i % 4 === 0 ? 74 : 80;\n    h += '<line x1=\"' + (o*Math.sin(a)).toFixed(1) + '\" y1=\"' + (-o*Math.cos(a)).toFixed(1) + '\" x2=\"' + (86*Math.sin(a)).toFixed(1) + '\" y2=\"' + (-86*Math.cos(a)).toFixed(1) + '\" stroke=\"var(--muted)\" stroke-width=\"' + (i % 4 === 0 ? 2.4 : 1) + '\"/>';\n  }\n  ['N','E','S','W'].forEach(function(t, i){\n    var a = i * Math.PI / 2;\n    h += '<text x=\"' + (62*Math.sin(a)).toFixed(1) + '\" y=\"' + (-62*Math.cos(a) + 5).toFixed(1) + '\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"800\" fill=\"var(--muted)\">' + t + '</text>';\n  });\n  if(fc && fc.dir != null) h += '<g transform=\"rotate(' + (fc.dir + 180) + ')\"><path d=\"' + arrowPath(56) + '\" fill=\"none\" stroke=\"var(--fc)\" stroke-width=\"3\" stroke-dasharray=\"6 4\"/></g>';\n  if(live && live.dir != null) h += '<g transform=\"rotate(' + (live.dir + 180) + ')\"><path d=\"' + arrowPath(56) + '\" fill=\"var(--live)\" opacity=\".92\"/></g>';\n  svg.innerHTML = h;\n}\nfunction drawLines(svg, series, opts){\n  // series: [{pts:[[t,v]], kind:'line'|'dots', col}], shared time and value axes\n  var W = 340, H = 170, L = 30, R = 8, T = 10, B = 22, all = [];\n  series.forEach(function(s){ s.pts.forEach(function(p){ all.push(p); }); });\n  if(!all.length){ svg.innerHTML = ''; return; }\n  var t0 = opts.t0 || Math.min.apply(null, all.map(function(p){ return p[0]; }));\n  var t1 = opts.t1 || Math.max.apply(null, all.map(function(p){ return p[0]; }));\n  if(t1 <= t0) t1 = t0 + 36e5;\n  var vmin = opts.vmin != null ? opts.vmin : Math.min.apply(null, all.map(function(p){ return p[1]; }));\n  var vmax = Math.max.apply(null, all.map(function(p){ return p[1]; }));\n  if(opts.vmin == null){ var pad = (vmax - vmin) * 0.15 || 0.5; vmin -= pad; vmax += pad; } else { vmax = Math.max(vmax * 1.15, vmin + 5); }\n  var x = function(t){ return L + (t - t0) / (t1 - t0) * (W - L - R); };\n  var y = function(v){ return T + (1 - (v - vmin) / (vmax - vmin)) * (H - T - B); };\n  var h = '';\n  var step = opts.vstep || Math.max(1, Math.round((vmax - vmin) / 4));\n  for(var v = Math.ceil(vmin / step) * step; v <= vmax; v += step){\n    h += '<line x1=\"' + L + '\" x2=\"' + (W - R) + '\" y1=\"' + y(v).toFixed(1) + '\" y2=\"' + y(v).toFixed(1) + '\" stroke=\"var(--line)\" stroke-width=\"1\"/>' +\n         '<text x=\"' + (L - 5) + '\" y=\"' + (y(v) + 4).toFixed(1) + '\" text-anchor=\"end\" font-size=\"10\" fill=\"var(--muted)\">' + (opts.fmtV ? opts.fmtV(v) : v) + '</text>';\n  }\n  var hrs = (t1 - t0) / 36e5, every = hrs > 30 ? 12 : hrs > 14 ? 6 : 3;\n  var first = new Date(t0); first.setMinutes(0,0,0);\n  for(var t = first.getTime(); t <= t1; t += 36e5){\n    var d = new Date(t); if(d.getHours() % every || t < t0) continue;\n    h += '<text x=\"' + x(t).toFixed(1) + '\" y=\"' + (H - 6) + '\" text-anchor=\"middle\" font-size=\"10\" fill=\"var(--muted)\">' + (d.getHours() === 0 && hrs > 30 ? d.toLocaleDateString([], { weekday:'short' }) : hh(d)) + '</text>';\n  }\n  if(opts.now && opts.now >= t0 && opts.now <= t1) h += '<line x1=\"' + x(opts.now).toFixed(1) + '\" x2=\"' + x(opts.now).toFixed(1) + '\" y1=\"' + T + '\" y2=\"' + (H - B) + '\" stroke=\"var(--muted)\" stroke-dasharray=\"3 3\"/>';\n  series.forEach(function(s){\n    if(s.kind === 'dots') s.pts.forEach(function(p){ h += '<circle cx=\"' + x(p[0]).toFixed(1) + '\" cy=\"' + y(p[1]).toFixed(1) + '\" r=\"3.4\" fill=\"' + s.col + '\"/>'; });\n    else if(s.pts.length) h += '<polyline fill=\"none\" stroke=\"' + s.col + '\" stroke-width=\"2.4\" stroke-linejoin=\"round\" points=\"' +\n      s.pts.map(function(p){ return x(p[0]).toFixed(1) + ',' + y(p[1]).toFixed(1); }).join(' ') + '\"/>';\n  });\n  if(opts.marker) h += '<circle cx=\"' + x(opts.marker[0]).toFixed(1) + '\" cy=\"' + y(opts.marker[1]).toFixed(1) + '\" r=\"5\" fill=\"var(--acc)\" stroke=\"var(--surface)\" stroke-width=\"2\"/>';\n  svg.innerHTML = h;\n}\n\n/* ---------- render ---------- */\nvar tab = 'now';\nfunction show(id, on){ $(id).classList.toggle('hidden', !on); }\nfunction currentHour(hours){\n  if(!hours) return null; var now = Date.now(), best = null;\n  hours.forEach(function(h){ if(!best || Math.abs(h.t - now) < Math.abs(best.t - now)) best = h; });\n  return best;\n}\nfunction render(){\n  var spot = S.cur;\n  $('spotBtn').textContent = spot ? spot.name + ' ▾' : 'Add a spot';\n  show('welcome', !spot);\n  ['nowCard','vsCard','stCard','tafCard','aiCard'].forEach(function(id){ show(id, false); });\n  $('nowErr').textContent = '';\n  if(spot) renderNow(spot);\n  renderFc(spot); renderTide(spot); renderSpots();\n}\nfunction renderNow(spot){\n  var fcNow = D.fc ? currentHour(D.fc.hours) : null, live = D.stations && D.stations[0];\n  show('nowCard', true);\n  drawCompass($('compass'), spot.facing, live, fcNow);\n  if(!fcNow && !live){\n    $('verdict').textContent = D.busy ? 'Loading…' : 'No data'; $('verdict').className = 'verdict';\n    $('bigSpd').innerHTML = D.busy ? '<span class=\"spin\"></span>' : '–'; $('nowSub').textContent = ''; $('liveLine').textContent = ''; $('wingNote').textContent = '';\n  } else {\n    // The headline is the forecast for the beach itself; an airport inland reads lighter.\n    var head = fcNow || live, isFc = !!fcNow;\n    var v = verdict(head.kn, head.dir, spot.facing), r = relation(head.dir, spot.facing);\n    $('verdict').textContent = v.t; $('verdict').className = 'verdict ' + v.c;\n    var g = isFc ? head.kn * GUST : head.gust;\n    $('bigSpd').innerHTML = sp(head.kn) + ' <small>' + us() + '</small>' +\n      (g ? '<div class=\"sub\" style=\"margin-top:4px;font-weight:600;letter-spacing:0\">gusts ' + (isFc ? 'about ' : '') + sp(g) + ' ' + us() + (isFc ? ' (estimated)' : '') + '</div>' : '');\n    var dirTxt = !isFc && head.vrb ? 'variable' : head.dir != null ? 'from the ' + compassName(head.dir) + ' (' + Math.round(head.dir) + '°)' : '';\n    $('nowSub').innerHTML = esc(dirTxt) + (r ? ', <b>' + r.t + '</b> here' : '') + '<br>' + (isFc ? 'Forecast for ' + esc(spot.name) + ' this hour' : 'Live at ' + esc(head.name) + ' (no forecast)');\n    $('liveLine').innerHTML = isFc && live ? '<b style=\"color:var(--live)\">Live:</b> ' + sp(live.kn) + (live.gust ? '–' + sp(live.gust) : '') + ' ' + us() + ' ' +\n      (live.vrb ? 'variable' : live.dir != null ? compassName(live.dir) : '') + ' at ' + esc(live.name) + ', ' + Math.round(live.dist) + ' km away, ' + ago(live.at) : '';\n    var w = wingSize(head.kn);\n    $('wingNote').textContent = w ? 'Rough wing size for ' + S.prefs.weight + ' kg: ' + w + ' m². Gusty or lumpy days call for less; ask local riders.' : '';\n  }\n\n  if(live && fcNow){\n    show('vsCard', true);\n    var apNow = D.apFc ? currentHour(D.apFc.hours) : null, f = apNow || fcNow;\n    $('vsWhere').textContent = live.name;\n    $('vsFc').textContent = sp(f.kn) + ' ' + us() + ' ' + compassName(f.dir);\n    $('vsLive').textContent = sp(live.kn) + (live.gust ? '–' + sp(live.gust) : '') + ' ' + us() + ' ' + (live.vrb ? 'VRB' : live.dir != null ? compassName(live.dir) : '');\n    var dk = live.kn - f.kn;\n    $('vsDiff').innerHTML = Math.abs(dk) < 2 ? 'The forecast is right on at ' + esc(live.name) + ' just now.' :\n      'It is <b>' + sp(Math.abs(dk)) + ' ' + us() + ' ' + (dk > 0 ? 'windier' : 'lighter') + '</b> than forecast at ' + esc(live.name) + ' just now.';\n    var now = Date.now(), t0 = now - 12 * 36e5, t1 = now + 12 * 36e5, fpts = [];\n    if(D.snap) Object.keys(D.snap).sort().forEach(function(k){ var t = Date.parse(k + ':00:00Z'); if(t >= t0 && t <= now) fpts.push([t, D.snap[k] * (UNITS[S.prefs.unit] || UNITS.kn).f]); });\n    if(D.apFc) D.apFc.hours.forEach(function(h){ var t = h.t.getTime(); if(t > now - 36e5 && t <= t1) fpts.push([t, h.kn * (UNITS[S.prefs.unit] || UNITS.kn).f]); });\n    fpts.sort(function(a, b){ return a[0] - b[0]; });\n    var opts = (D.hist || []).filter(function(o){ return o.at >= t0; }).map(function(o){ return [o.at, o.kn * (UNITS[S.prefs.unit] || UNITS.kn).f]; });\n    drawLines($('chart'), [{ pts:fpts, col:'var(--fc)' }, { pts:opts, kind:'dots', col:'var(--live)' }], { t0:t0, t1:t1, vmin:0, now:now, fmtV:function(v){ return Math.round(v); } });\n    var pairs = D.pairs || [];\n    if(pairs.length >= 3){\n      var m = pairs.reduce(function(a, p){ return a + (p[2] - p[1]); }, 0) / pairs.length;\n      $('biasNote').textContent = 'Over ' + pairs.length + ' hours checked at ' + live.id + ', the forecast was on average ' +\n        (Math.abs(m) < 1 ? 'within 1 ' + us() + ' of what was measured.' : sp(Math.abs(m)) + ' ' + us() + ' ' + (m > 0 ? 'below' : 'above') + ' what was measured.');\n    } else {\n      $('biasNote').textContent = 'The line before now shows forecasts this app saved earlier. Open the app now and then, and it learns how far the forecast is usually out here.';\n    }\n  }\n\n  if(D.stations && D.stations.length){\n    show('stCard', true);\n    $('stations').innerHTML = D.stations.map(function(s){\n      var old = Date.now() - s.at > 2 * 36e5;\n      return '<div class=\"st\">' + arrowSVG(s.vrb ? null : s.dir, '--live') + '<div class=\"nm\"><b>' + esc(s.name) + '</b><span>' + esc(s.id) + ' · ' +\n        Math.round(s.dist) + ' km · ' + (old ? '<b style=\"color:var(--warn)\">' + ago(s.at) + '</b>' : ago(s.at)) + '</span></div><div class=\"w\">' +\n        sp(s.kn) + (s.gust ? '–' + sp(s.gust) : '') + ' ' + us() + '<span>' + (s.vrb ? 'variable' : s.dir != null ? compassName(s.dir) + ' ' + s.dir + '°' : '') + '</span></div></div>';\n    }).join('');\n  }\n  if(D.taf && D.airport){\n    show('tafCard', true);\n    $('tafWhere').textContent = D.airport.id;\n    $('tafRaw').textContent = D.taf;\n    var m2 = /\\b(\\d{3}|VRB)(\\d{2,3})(?:G(\\d{2,3}))?KT\\b/.exec(D.taf);\n    $('tafSum').innerHTML = m2 ? 'Main wind: <b>' + (m2[1] === 'VRB' ? 'variable' : compassName(+m2[1]) + ' (' + m2[1] + '°)') + ', ' + sp(+m2[2]) + (m2[3] ? ' gusting ' + sp(+m2[3]) : '') + ' ' + us() + '</b>' : '';\n  }\n  show('aiCard', !!(D.fc && typeof window.myllmAsk === 'function'));\n  var errs = [];\n  if(D.stErr) errs.push('Live wind could not load (' + D.stErr.message + ').');\n  if(D.fcErr) errs.push(fcErrText(D.fcErr));\n  $('nowErr').textContent = errs.join(' ');\n}\nfunction fcErrText(e){\n  return /unreadable|403/.test(e.message) ? 'The forecast service turned this version of MyLLM away. It works on iPhone and iPad, and comes to Android in the next update; live wind and tides still work.' :\n    'The forecast could not load (' + e.message + ').';\n}\nfunction renderFc(spot){\n  var list = $('fcList');\n  if(!spot){ list.innerHTML = '<div class=\"card note\">Add a spot to see its forecast.</div>'; $('fcErr').textContent = ''; return; }\n  $('scale').innerHTML = [0,8,12,16,20,25,30].map(function(k, i, a){ return '<div style=\"background:' + colour(k) + '\">' + sp(k) + (i === a.length - 1 ? '+' : '') + '</div>'; }).join('');\n  $('fcErr').textContent = D.fcErr ? fcErrText(D.fcErr) : '';\n  if(!D.fc){ list.innerHTML = D.busy ? '<div class=\"card\"><span class=\"spin\"></span> Loading the forecast…</div>' : ''; $('fcUpdated').textContent = ''; return; }\n  $('fcUpdated').textContent = 'updated ' + hm(D.fc.updated);\n  var now = Date.now() - 30*60000, days = {}, order = [];\n  D.fc.hours.forEach(function(h){\n    if(h.t.getTime() < now) return;\n    var k = h.t.toDateString(); if(!days[k]){ days[k] = []; order.push(k); } days[k].push(h);\n  });\n  var events = D.tide && D.tide.events;\n  list.innerHTML = order.map(function(k){\n    var hs = days[k], good = hs.filter(function(h){ return h.step === 1 && goodHour(h, spot.facing) && daylight(h.t, spot); });\n    var best = '';\n    if(good.length){\n      // the longest run of consecutive good hours\n      var run = [], top = [];\n      good.forEach(function(h){ if(run.length && h.t - run[run.length - 1].t > 36e5) run = []; run.push(h); if(run.length > top.length) top = run.slice(); });\n      var lo = Math.min.apply(null, top.map(function(h){ return h.kn; })), hi = Math.max.apply(null, top.map(function(h){ return h.kn; }));\n      best = top.length > 1 ? hh(top[0].t) + '–' + hh(new Date(top[top.length - 1].t.getTime() + 36e5)) + ', ' + sp(lo) + '–' + sp(hi) + ' ' + us() : hh(top[0].t) + ', ' + sp(lo) + ' ' + us();\n    }\n    var sun = sunTimes(hs[0].t, spot.lat, spot.lon);\n    return '<div class=\"day\"><div class=\"dayhead\"><b>' + dayName(hs[0].t) + '</b><span>' + (sun ? '☀︎ ' + hm(sun.rise) + '–' + hm(sun.set) : '') + '</span>' +\n      (best ? '<span class=\"best\">Best ' + best + '</span>' : '') + '</div><div class=\"hours\">' +\n      hs.map(function(h){\n        var r = relation(h.dir, spot.facing), ok = goodHour(h, spot.facing) && daylight(h.t, spot), night = !daylight(h.t, spot);\n        var g = h.kn * GUST, w = Math.min(100, h.kn / 35 * 100), td = events ? tideAt(h.t, events) : null;\n        var meta = compassName(h.dir) + (r ? ' · <span class=\"' + (r.lvl === 'ok' ? '' : r.lvl) + '\">' + r.t + '</span>' : '') +\n          (h.temp != null ? ' · ' + Math.round(h.temp) + '°' : '') + (h.rain ? ' · ' + h.rain + ' mm' : '') +\n          (td ? ' · tide ' + (td.rising ? '↑' : '↓') + ' ' + td.h.toFixed(1) + ' m' : '');\n        return '<div class=\"hr' + (ok && h.step === 1 ? ' go' : '') + (night ? ' night' : '') + '\"><div class=\"t\">' + hh(h.t) + (h.step > 1 ? '<small>' + h.step + 'h</small>' : '') + '</div>' +\n          arrowSVG(h.dir) + '<div class=\"mid\"><div class=\"bar\" style=\"width:' + Math.max(6, w).toFixed(0) + '%;background:' + colour(h.kn) + '\"></div><div class=\"meta\">' + meta + '</div></div>' +\n          '<div class=\"kn\">' + sp(h.kn) + '<small>gust ~' + sp(g) + '</small></div></div>';\n      }).join('') + '</div></div>';\n  }).join('');\n}\nfunction renderTide(spot){\n  show('tideKeyCard', !S.tideKey);\n  show('tideCard', false);\n  $('tideErr').textContent = '';\n  if(!S.tideKey || !spot) return;\n  if(D.tideErr){ $('tideErr').textContent = /401|403/.test(D.tideErr.message) ? 'The Admiralty did not accept the key. Check it in Spots → Admiralty tide key.' : 'Tides could not load (' + D.tideErr.message + ').'; return; }\n  var t = D.tide;\n  if(!t){ $('tideErr').innerHTML = D.busy ? '<span class=\"spin\"></span> Loading tides…' : ''; return; }\n  if(t.none){ $('tideErr').textContent = 'No UK tide station within 60 km of this spot' + (t.dist ? ' (nearest ' + Math.round(t.dist) + ' km).' : '.'); return; }\n  show('tideCard', true);\n  $('tideWhere').textContent = t.station.name + ' · ' + Math.round(t.dist) + ' km';\n  var now = new Date(), cur = tideAt(now, t.events);\n  var nextE = t.events.filter(function(e){ return e.t > now; })[0];\n  $('tideNow').innerHTML = cur ? (cur.rising ? 'Rising ↑ ' : 'Falling ↓ ') + cur.h.toFixed(1) + ' m' + (nextE ? '<div class=\"sub\">' + (nextE.hw ? 'High' : 'Low') + ' water at ' + hm(nextE.t) + (nextE.h != null ? ', ' + nextE.h.toFixed(1) + ' m' : '') + '</div>' : '') :\n    (nextE ? (nextE.hw ? 'High' : 'Low') + ' water at ' + hm(nextE.t) : '');\n  var t0 = now.getTime() - 3 * 36e5, t1 = now.getTime() + 27 * 36e5, pts = [];\n  for(var x = t0; x <= t1; x += 15 * 60000){ var v = tideAt(new Date(x), t.events); if(v) pts.push([x, v.h]); }\n  drawLines($('tideChart'), [{ pts:pts, col:'var(--live)' }], { t0:t0, t1:t1, now:now.getTime(), marker: cur ? [now.getTime(), cur.h] : null, vstep:1, fmtV:function(v){ return v + 'm'; } });\n  var lastDay = '';\n  $('tideList').innerHTML = t.events.filter(function(e){ return e.t > now - 6 * 36e5; }).map(function(e){\n    var dn = dayName(e.t), head = dn !== lastDay ? '<div class=\"sub\" style=\"margin:10px 0 2px;font-weight:700\">' + dn + '</div>' : ''; lastDay = dn;\n    return head + '<div class=\"ev' + (e.t < now ? ' past' : '') + '\"><span class=\"ty ' + (e.hw ? 'hw' : 'lw') + '\">' + (e.hw ? 'High' : 'Low') + '</span><span class=\"tm\">' + hm(e.t) + (e.approx ? ' ≈' : '') + '</span><span class=\"ht\">' + (e.h != null ? e.h.toFixed(1) + ' m' : '') + '</span></div>';\n  }).join('');\n}\nfunction renderSpots(){\n  $('spotList').innerHTML = S.spots.length ? S.spots.map(function(s){\n    return '<div class=\"spotrow' + (S.cur && S.cur.id === s.id ? ' cur' : '') + '\"><div class=\"nm\"><b>' + esc(s.name) + '</b><span>Sea to the ' + compassName(s.facing) +\n      ' · ' + s.lat.toFixed(3) + ', ' + s.lon.toFixed(3) + '</span></div>' +\n      (s.wg ? '<a class=\"btn small\" href=\"' + esc(s.wg) + '\" target=\"_blank\" style=\"text-decoration:none\">Windguru</a>' : '') +\n      '<button class=\"btn small\" data-use=\"' + s.id + '\">' + (S.cur && S.cur.id === s.id ? 'Showing' : 'Show') + '</button>' +\n      '<button class=\"link\" data-edit=\"' + s.id + '\">Edit</button></div>';\n  }).join('') : '<p class=\"note\" style=\"margin:0\">No spots yet.</p>';\n  $('pMin').value = S.prefs.min; $('pMax').value = S.prefs.max; $('pWeight').value = S.prefs.weight; $('pUnit').value = S.prefs.unit;\n  $('keyState').textContent = S.tideKey ? 'Saved (ends …' + S.tideKey.slice(-4) + ')' : 'Not set: add it on the Tides tab';\n  $('keyClear').classList.toggle('hidden', !S.tideKey);\n}\n\n/* ---------- AI summary ---------- */\n$('aiBtn').addEventListener('click', function(){\n  var spot = S.cur; if(!D.fc || !spot) return;\n  var now = Date.now(), lines = [];\n  D.fc.hours.forEach(function(h){\n    if(h.t < now || h.t > now + 48 * 36e5 || h.step !== 1 || !daylight(h.t, spot)) return;\n    var r = relation(h.dir, spot.facing), td = D.tide && D.tide.events ? tideAt(h.t, D.tide.events) : null;\n    lines.push(h.t.toLocaleString([], { weekday:'short', hour:'2-digit' }) + ' ' + Math.round(h.kn) + 'kn ' + compassName(h.dir) + (r ? ' ' + r.t : '') + (td ? ' tide ' + (td.rising ? 'rising' : 'falling') : ''));\n  });\n  var prompt = 'You help a wingfoiler at ' + spot.name + ' (rides ' + S.prefs.min + '–' + S.prefs.max + ' knots, weighs ' + S.prefs.weight + ' kg). ' +\n    'Daylight hourly forecast, wind in knots with how it meets the beach:\\n' + lines.join('\\n') +\n    '\\nIn 3 short sentences, plain text: name the best session window(s), the wind and a wing size, and any safety point (offshore wind, gusts, light spells). If nothing is rideable, say so kindly.';\n  $('aiOut').textContent = '';\n  $('aiBtn').disabled = true;\n  Promise.resolve(window.myllmAsk(prompt)).then(function(t){ $('aiOut').textContent = String(t || '').trim(); }, function(e){ $('aiOut').textContent = 'The AI could not answer: ' + e.message; })\n    .then(function(){ $('aiBtn').disabled = false; });\n});\n\n/* ---------- spot editor ---------- */\nvar draft = null;\nfunction openSheet(spot){\n  draft = spot ? JSON.parse(JSON.stringify(spot)) : null;\n  $('sheetTitle').firstChild.textContent = spot ? 'Edit spot ' : 'Add a spot ';\n  show('stepFind', !spot); show('stepSet', !!spot); show('sDel', !!spot);\n  $('results').innerHTML = ''; $('findNote').textContent = ''; $('q').value = ''; $('ll').value = '';\n  if(spot) fillSet();\n  show('sheet', true);\n}\nfunction fillSet(){\n  $('sName').value = draft.name || ''; $('sWg').value = draft.wg || '';\n  if(draft.facing == null) draft.facing = 180;\n  drawDial(); show('stepFind', false); show('stepSet', true);\n}\nfunction pick(lat, lon, name){\n  draft = { id: 's' + Date.now().toString(36), lat: +lat, lon: +lon, name: name || 'My spot', facing: 180, wg:'' };\n  fillSet();\n}\nfunction drawDial(){\n  var f = draft.facing, h = '', r = 96;\n  var p = function(a){ return (r * Math.sin(a)).toFixed(1) + ',' + (-r * Math.cos(a)).toFixed(1); };\n  var a0 = (f - 90) * Math.PI / 180, a1 = (f + 90) * Math.PI / 180;\n  h += '<circle r=\"100\" fill=\"#d6b97a\" opacity=\".55\"/>';\n  h += '<path d=\"M0,0 L' + p(a0) + ' A' + r + ',' + r + ' 0 0 1 ' + p(a1) + ' Z\" fill=\"#38bdf8\" opacity=\".75\"/>';\n  h += '<circle r=\"100\" fill=\"none\" stroke=\"var(--line)\" stroke-width=\"2\"/>';\n  PTS.forEach(function(t, i){ if(i % 2) return; var a = i * 22.5 * Math.PI / 180;\n    h += '<text x=\"' + (84*Math.sin(a)).toFixed(1) + '\" y=\"' + (-84*Math.cos(a) + 4).toFixed(1) + '\" text-anchor=\"middle\" font-size=\"' + (i % 4 ? 10 : 13) + '\" font-weight=\"800\" fill=\"#0b2530\">' + t + '</text>'; });\n  var fa = f * Math.PI / 180;\n  h += '<line x1=\"0\" y1=\"0\" x2=\"' + (60*Math.sin(fa)).toFixed(1) + '\" y2=\"' + (-60*Math.cos(fa)).toFixed(1) + '\" stroke=\"#0b2530\" stroke-width=\"4\" stroke-linecap=\"round\"/>';\n  h += '<circle r=\"7\" fill=\"#0b2530\"/>';\n  h += '<text x=\"' + (36*Math.sin(fa + Math.PI)).toFixed(1) + '\" y=\"' + (-36*Math.cos(fa + Math.PI) + 4).toFixed(1) + '\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"800\" fill=\"#5b4520\">beach</text>';\n  h += '<text x=\"' + (40*Math.sin(fa)).toFixed(1) + '\" y=\"' + (-40*Math.cos(fa) - 8).toFixed(1) + '\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"800\" fill=\"#0b2530\">sea</text>';\n  $('dial').innerHTML = h;\n  $('dialTxt').innerHTML = 'Sea to the <b>' + compassName(f) + '</b> (' + f + '°). Wind from the ' + compassName(f) + ' is onshore; from the ' + compassName(f + 180) + ' it is offshore.';\n}\nfunction dialAt(ev){\n  var b = $('dial').getBoundingClientRect(), x = ev.clientX - b.left - b.width / 2, y = ev.clientY - b.top - b.height / 2;\n  if(Math.hypot(x, y) < 8) return;\n  draft.facing = (Math.round((Math.atan2(x, -y) * 180 / Math.PI + 360) % 360 / 5) * 5) % 360;\n  drawDial();\n}\nvar dragging = false;\n$('dial').addEventListener('pointerdown', function(e){ dragging = true; try{ $('dial').setPointerCapture(e.pointerId); }catch(x){} dialAt(e); haptic('selection'); });\n$('dial').addEventListener('pointermove', function(e){ if(dragging) dialAt(e); });\n$('dial').addEventListener('pointerup', function(){ dragging = false; });\n$('dial').addEventListener('pointercancel', function(){ dragging = false; });\n\n$('useLoc').addEventListener('click', function(){\n  var L = window.myllmLocation;\n  if(!L || typeof L.current !== 'function'){ $('findNote').textContent = 'Location is not available here. Search or type coordinates instead.'; return; }\n  $('findNote').innerHTML = '<span class=\"spin\"></span> Finding you…';\n  Promise.resolve(L.current()).then(function(p){\n    var lat = p.latitude != null ? p.latitude : p.lat, lon = p.longitude != null ? p.longitude : p.lon;\n    if(lat == null) throw new Error('no position');\n    var nm = (p.address && (p.address.locality || p.address.name || p.address.subLocality)) || p.locality || p.name || 'My spot';\n    $('findNote').textContent = ''; pick(lat, lon, typeof nm === 'string' ? nm : 'My spot');\n  }).catch(function(e){ $('findNote').textContent = 'Could not get your location (' + e.message + '). Allow apps to use location in MyLLM settings, or search instead.'; });\n});\nfunction doSearch(){\n  var q = $('q').value.trim(); if(!q) return;\n  var L = window.myllmLocation;\n  if(!L || typeof L.search !== 'function'){ $('findNote').textContent = 'Search is not available in this version of MyLLM. Type coordinates instead.'; return; }\n  $('findNote').innerHTML = '<span class=\"spin\"></span> Searching…'; $('results').innerHTML = '';\n  Promise.resolve(L.search(q, { limit: 8 })).then(function(list){\n    list = list || [];\n    $('findNote').textContent = list.length ? '' : 'Nothing found. Try a nearby town.';\n    $('results').innerHTML = list.map(function(r, i){ return '<button data-i=\"' + i + '\">' + esc(r.name) + '<span>' + esc(r.address || '') + '</span></button>'; }).join('');\n    Array.prototype.forEach.call($('results').querySelectorAll('button'), function(b){\n      b.addEventListener('click', function(){ var r = list[+b.dataset.i]; pick(r.latitude, r.longitude, r.name); });\n    });\n  }).catch(function(e){ $('findNote').textContent = 'Search failed (' + e.message + ').'; });\n}\n$('qGo').addEventListener('click', doSearch);\n$('q').addEventListener('keydown', function(e){ if(e.key === 'Enter') doSearch(); });\n$('llGo').addEventListener('click', function(){\n  var m = /(-?\\d+(?:\\.\\d+)?)\\s*[,\\s]\\s*(-?\\d+(?:\\.\\d+)?)/.exec($('ll').value);\n  if(!m || Math.abs(+m[1]) > 90 || Math.abs(+m[2]) > 180){ $('findNote').textContent = 'Type latitude, longitude, for example 50.6936, -1.9459.'; return; }\n  pick(+m[1], +m[2], 'My spot');\n});\n$('sSave').addEventListener('click', function(){\n  draft.name = $('sName').value.trim() || 'My spot';\n  var wg = $('sWg').value.trim(); draft.wg = /^https?:\\/\\//.test(wg) ? wg : '';\n  var i = S.spots.findIndex(function(s){ return s.id === draft.id; });\n  if(i >= 0) S.spots[i] = draft; else S.spots.push(draft);\n  S.cur = draft; save('spots', S.spots); save('cur', draft.id);\n  show('sheet', false); haptic('success'); loadedAt = 0; loadAll(true);\n});\n$('sDel').addEventListener('click', function(){\n  S.spots = S.spots.filter(function(s){ return s.id !== draft.id; });\n  if(S.cur && S.cur.id === draft.id){ S.cur = S.spots[0] || null; D = {}; }\n  save('spots', S.spots); save('cur', S.cur ? S.cur.id : null);\n  show('sheet', false); loadAll(true);\n});\n$('sheetClose').addEventListener('click', function(){ show('sheet', false); });\n$('spotBtn').addEventListener('click', function(){ if(S.spots.length) setTab('spots'); else openSheet(null); });\n$('welcomeAdd').addEventListener('click', function(){ openSheet(null); });\n$('addSpot').addEventListener('click', function(){ openSheet(null); });\n$('spotList').addEventListener('click', function(e){\n  var u = e.target.closest('[data-use]'), ed = e.target.closest('[data-edit]');\n  if(u){ S.cur = S.spots.find(function(s){ return s.id === u.dataset.use; }); save('cur', S.cur.id); D = {}; haptic(); setTab('now'); loadAll(true); }\n  if(ed) openSheet(S.spots.find(function(s){ return s.id === ed.dataset.edit; }));\n});\n\n/* ---------- settings ---------- */\n(function(){\n  var o = ''; for(var k = 6; k <= 25; k++) o += '<option value=\"' + k + '\">From ' + k + ' kn</option>'; $('pMin').innerHTML = o;\n  o = ''; for(k = 15; k <= 40; k++) o += '<option value=\"' + k + '\">Up to ' + k + ' kn</option>'; $('pMax').innerHTML = o;\n  o = ''; for(k = 40; k <= 130; k += 5) o += '<option value=\"' + k + '\">' + k + ' kg</option>'; $('pWeight').innerHTML = o;\n})();\nfunction prefChanged(){\n  S.prefs.min = +$('pMin').value; S.prefs.max = Math.max(+$('pMax').value, S.prefs.min + 2);\n  S.prefs.weight = +$('pWeight').value; S.prefs.unit = $('pUnit').value;\n  save('prefs', S.prefs); render();\n}\n['pMin','pMax','pWeight','pUnit'].forEach(function(id){ $(id).addEventListener('change', prefChanged); });\n$('tideKeySave').addEventListener('click', function(){\n  var k = $('tideKey').value.trim(); if(!/^[A-Za-z0-9]{16,64}$/.test(k)){ $('tideErr').textContent = 'That does not look like an Admiralty key (letters and numbers, usually 32 long).'; return; }\n  S.tideKey = k; save('tideKey', k); $('tideKey').value = ''; tideStations = null; haptic('success');\n  if(S.cur) tideFor(S.cur).then(function(t){ D.tide = t; D.tideErr = null; render(); }, function(e){ D.tideErr = e; render(); });\n  render();\n});\n$('keyClear').addEventListener('click', function(){ S.tideKey = ''; save('tideKey', ''); D.tide = null; D.tideErr = null; tideStations = null; render(); });\n$('refresh').addEventListener('click', function(){ haptic(); loadAll(true); });\n\n/* ---------- tabs ---------- */\nfunction setTab(t){\n  tab = t;\n  Array.prototype.forEach.call(document.querySelectorAll('.seg button'), function(b){ b.classList.toggle('on', b.dataset.tab === t); });\n  ['now','fc','tide','spots'].forEach(function(x){ show('tab-' + x, x === t); });\n  window.scrollTo(0, 0);\n}\nArray.prototype.forEach.call(document.querySelectorAll('.seg button'), function(b){ b.addEventListener('click', function(){ haptic('selection'); setTab(b.dataset.tab); }); });\ndocument.addEventListener('visibilitychange', function(){ if(!document.hidden) loadAll(false); });\n\n/* ---------- start ---------- */\nPromise.all([load('spots', []), load('cur', null), load('prefs', null), load('tideKey', '')]).then(function(r){\n  S.spots = r[0] || []; S.cur = S.spots.find(function(s){ return s.id === r[1]; }) || S.spots[0] || null;\n  if(r[2]) for(var k in r[2]) S.prefs[k] = r[2][k];\n  S.tideKey = r[3] || '';\n  render(); loadAll(true);\n});\n})();\n</script>\n</body>\n</html>\n"}