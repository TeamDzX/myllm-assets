{"name": "Class Timetable", "html": "<!doctype html>\n<!--\n  Class Timetable — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Class Timetable</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"e444e82878\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); --h:186; }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink); min-height:100dvh; font-size:15.5px; line-height:1.4; }\n  body.lock{ overflow:hidden; }\n  .home{ max-width:600px; margin:0 auto;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ .home{ max-width:760px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.96); }\n  [hidden]{ display:none !important; }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 28%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  .head .acts{ display:flex; gap:8px; flex-shrink:0; }\n  h2.sec{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:20px 2px 9px; }\n\n  .hero{ border-radius:20px; padding:16px 18px; color:#fff; margin-bottom:12px; display:flex; align-items:center; gap:16px;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 46%), hsl(calc(var(--h) + 40) 58% 24%)); box-shadow:0 10px 28px hsl(var(--h) 60% 30% / .25); }\n  .hero .n{ font-size:44px; font-weight:800; line-height:1; letter-spacing:-.03em; font-variant-numeric:tabular-nums; flex-shrink:0; }\n  .hero .k{ display:block; font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.78; }\n  .hero b{ display:block; font-size:17px; font-weight:750; line-height:1.25; overflow-wrap:anywhere; }\n  .hero span.s{ display:block; font-size:12.5px; line-height:1.4; opacity:.82; margin-top:3px; overflow-wrap:anywhere; }\n  .hero .grow{ flex:1; min-width:0; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  label{ display:block; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:14px 2px 7px; }\n  label:first-child{ margin-top:0; }\n  input, textarea, select{ width:100%; font:inherit; font-size:16px; padding:12px; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; }\n  input:focus, textarea:focus{ border-color:hsl(var(--h) 60% 55%); }\n  .go{ width:100%; min-height:50px; margin-top:14px; border:none; border-radius:14px; background:hsl(var(--h) 62% 52%); color:#fff; font-size:16px; font-weight:700;\n    display:flex; align-items:center; justify-content:center; gap:8px; box-shadow:0 8px 20px hsl(var(--h) 60% 40% / .25); }\n  .go.soft{ background:var(--fill); color:var(--ink); box-shadow:none; }\n  .go:disabled{ opacity:.55; }\n  .status{ font-size:13px; color:var(--muted); min-height:18px; margin-top:10px; text-align:center; line-height:1.45; }\n  .status.err{ color:#ff453a; }\n  .spin{ width:16px; height:16px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; display:inline-block; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n  .empty{ text-align:center; padding:24px 18px 14px; }\n  .empty .tile{ width:48px; height:48px; border-radius:14px; font-size:21px; margin:0 auto 10px; opacity:.9; }\n  .empty b{ display:block; font-size:16px; font-weight:750; }\n  .empty p{ font-size:13.5px; color:var(--muted); line-height:1.5; max-width:280px; margin:5px auto 0; }\n  @media (prefers-reduced-motion:reduce){ .spin{ animation-duration:2.4s; } button:active{ transform:none; } }\n\n  .days{ display:grid; grid-template-columns:repeat(7,1fr); gap:5px; background:var(--surface); border:1px solid var(--line); border-radius:14px; padding:4px; margin-bottom:12px; }\n  .days button{ position:relative; min-height:42px; border:none; background:none; border-radius:10px; font-size:13.5px; font-weight:700; color:var(--muted); }\n  .days button.on{ background:hsl(var(--h) 62% 44%); color:#fff; }\n  .days button.today::after{ content:\"\"; position:absolute; left:50%; bottom:5px; width:5px; height:5px; margin-left:-2.5px; border-radius:50%; background:hsl(var(--h) 70% 50%); }\n  .days button.on.today::after{ background:#fff; }\n  .slot{ display:flex; align-items:center; gap:12px; padding:10px 0; border-bottom:1px solid var(--line); cursor:pointer; }\n  .slot:first-child{ padding-top:2px; } .slot:last-child{ border-bottom:none; padding-bottom:2px; }\n  .slot .time{ width:48px; flex-shrink:0; font-size:13px; font-weight:700; color:var(--muted); font-variant-numeric:tabular-nums; }\n  .slot .bar{ width:4px; align-self:stretch; min-height:36px; border-radius:99px; background:var(--fill); flex-shrink:0; }\n  .slot .info{ flex:1; min-width:0; }\n  .slot .subj{ font-size:16px; font-weight:650; overflow-wrap:anywhere; }\n  .slot .subj.empty{ font-weight:500; color:var(--muted); }\n  .slot .room{ display:flex; align-items:center; gap:4px; font-size:12.5px; color:var(--muted); margin-top:2px; }\n  .slot .room svg{ font-size:11px; }\n  .now{ font-size:10px; font-weight:800; letter-spacing:.08em; color:#fff; background:hsl(var(--h) 62% 44%); border-radius:6px; padding:3px 7px; flex-shrink:0; }\n  .row2{ display:flex; gap:10px; }\n  .row2 .go{ margin-top:0; }\n  .hint{ font-size:12px; color:var(--muted); text-align:center; margin-top:12px; }\n\n  /* the whole week, where there's room for it */\n  .week{ display:none; }\n  @media (min-width:700px){\n    .daylist{ display:none; }\n    .week{ display:grid; grid-template-columns:56px repeat(7,minmax(0,1fr)); gap:4px; }\n    .week .dh{ text-align:center; font-size:12px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; color:var(--muted); padding:6px 0; border-radius:10px; }\n    .week .dh.today{ color:#fff; background:hsl(var(--h) 62% 44%); }\n    .week .tm{ font-size:12.5px; font-weight:700; color:var(--muted); font-variant-numeric:tabular-nums; padding-top:10px; }\n    .week .c{ min-height:58px; border-radius:12px; background:var(--surface); border:1px solid var(--line); padding:7px 8px; cursor:pointer; overflow:hidden; position:relative; }\n    .week .c.today{ background:hsl(var(--h) 70% 50% / .08); border-color:hsl(var(--h) 60% 50% / .35); }\n    .week .c.live{ box-shadow:0 0 0 2px hsl(var(--h) 62% 50%); }\n    .week .c b{ display:block; font-size:13px; font-weight:700; line-height:1.25; overflow-wrap:anywhere; padding-left:6px; }\n    .week .c span{ display:block; font-size:11px; color:var(--muted); margin-top:2px; padding-left:6px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n    .week .c i{ position:absolute; left:0; top:0; bottom:0; width:4px; }\n    .week .c.free b{ color:var(--muted); font-weight:500; }\n  }\n\n  /* in-page editor (the web view has no prompt/confirm) */\n  .overlay{ position:fixed; inset:0; z-index:50; background:rgba(0,0,0,.42); display:none; align-items:center; justify-content:center;\n    padding:calc(24px + env(safe-area-inset-top)) 20px calc(24px + env(safe-area-inset-bottom)); }\n  .overlay.show{ display:flex; }\n  .modal{ width:100%; max-width:360px; background:var(--surface); border:1px solid var(--line); border-radius:22px; padding:18px; box-shadow:0 20px 50px rgba(0,0,0,.35); }\n  .modal h3{ font-size:17px; font-weight:800; margin-bottom:12px; }\n  .modal input{ margin-bottom:10px; -webkit-user-select:text; user-select:text; }\n  .mbtns{ display:flex; gap:8px; margin-top:4px; }\n  .mbtns button{ flex:1; min-height:46px; border:none; border-radius:12px; font-size:15px; font-weight:700; background:hsl(var(--h) 62% 44%); color:#fff; }\n  .mbtns .msec{ background:var(--fill); color:var(--ink); }\n  .mbtns .mclr{ background:rgba(255,69,58,.14); color:#e0342a; }\n  @media (prefers-color-scheme:dark){ .mbtns .mclr{ color:#ff6b62; } }\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-cal\" viewBox=\"0 0 24 24\"><path d=\"M7 2.8a1 1 0 0 1 1 1V5h8V3.8a1 1 0 0 1 2 0V5h.5A2.5 2.5 0 0 1 21 7.5v11a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 18.5v-11A2.5 2.5 0 0 1 5.5 5H6V3.8a1 1 0 0 1 1-1zM5 10.2v8.3c0 .3.2.5.5.5h13c.3 0 .5-.2.5-.5v-8.3z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-pin\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5a7 7 0 0 1 7 7c0 4.8-5.4 10.4-6.3 11.3a1 1 0 0 1-1.4 0C10.4 19.9 5 14.3 5 9.5a7 7 0 0 1 7-7zm0 4.3a2.7 2.7 0 1 0 0 5.4 2.7 2.7 0 0 0 0-5.4z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-clock\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5a9.5 9.5 0 1 1 0 19 9.5 9.5 0 0 1 0-19zm0 2a7.5 7.5 0 1 0 0 15 7.5 7.5 0 0 0 0-15zm0 2.5a1 1 0 0 1 1 1v3.6l2.6 1.5a1 1 0 1 1-1 1.7l-3.1-1.8A1 1 0 0 1 11 12V8a1 1 0 0 1 1-1z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-trash\" viewBox=\"0 0 24 24\"><path d=\"M9.5 3h5a1 1 0 0 1 1 1v1H20a1 1 0 0 1 0 2h-1l-.9 12.2A2 2 0 0 1 16.1 21H7.9a2 2 0 0 1-2-1.8L5 7H4a1 1 0 0 1 0-2h4.5V4a1 1 0 0 1 1-1z\" fill=\"currentColor\"/></symbol>\n</defs></svg>\n<div class=\"home\">\n  <div class=\"imm-safe\"></div><div class=\"head\">\n    <div class=\"tile\"><svg class=\"i\"><use href=\"#i-cal\"/></svg></div>\n    <div class=\"ht\"><h1>Class Timetable</h1><p>Your week of lessons at a glance</p></div>\n  <div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Class Timetable\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n\n  <div class=\"hero\">\n    <div class=\"grow\"><span class=\"k\" id=\"hK\">Today</span><b id=\"hT\">Nothing on today</b><span class=\"s\" id=\"hS\"></span></div>\n  </div>\n\n  <div class=\"days\" id=\"tabs\"></div>\n  <div class=\"card daylist\" id=\"slots\"></div>\n  <div class=\"week\" id=\"week\"></div>\n\n  <div class=\"row2\" style=\"margin-top:12px\">\n    <button class=\"go soft\" type=\"button\" id=\"timesBtn\"><svg class=\"i\"><use href=\"#i-clock\"/></svg>Period times</button>\n    <button class=\"go soft\" type=\"button\" id=\"clearBtn\"><svg class=\"i\"><use href=\"#i-trash\"/></svg><span id=\"clearLbl\">Clear this day</span></button>\n  </div>\n  <div class=\"hint\">Tap a slot to add a lesson. Saved on-device, private to this app.</div>\n</div>\n\n<div class=\"overlay\" id=\"overlay\">\n  <div class=\"modal\">\n    <h3 id=\"m-title\"></h3>\n    <input id=\"m-f1\" autocapitalize=\"words\" autocomplete=\"off\">\n    <input id=\"m-f2\" autocomplete=\"off\">\n    <div class=\"mbtns\">\n      <button class=\"msec\" type=\"button\" id=\"m-cancel\">Cancel</button>\n      <button id=\"m-clear\" class=\"mclr\" type=\"button\">Clear</button>\n      <button type=\"button\" id=\"m-save\">Save</button>\n    </div>\n  </div>\n</div>\n\n<script>\nfunction el(i){return document.getElementById(i)}\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction store(){return window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}}}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nfunction icon(n){return '<svg class=\"i\"><use href=\"#i-'+n+'\"/></svg>'}\nfunction esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]})}\nvar DAYS=[\"Mon\",\"Tue\",\"Wed\",\"Thu\",\"Fri\",\"Sat\",\"Sun\"];\nvar COLORS=[\"#ff453a\",\"#ff9f0a\",\"#ffd60a\",\"#30d158\",\"#40c8e0\",\"#5e5ce6\",\"#bf5af2\",\"#ff375f\"];\nvar DEFTIMES=[\"09:00\",\"10:00\",\"11:00\",\"12:00\",\"14:00\",\"15:00\"];\nvar data={times:DEFTIMES.slice(),grid:{}};   // grid[day] = [{subj,room}]\nfunction todayIdx(){var g=new Date().getDay();return g===0?6:g-1}\nvar day=todayIdx();\nfunction save(){store().setItem('tt',JSON.stringify(data))}\nfunction colorFor(s){if(!s)return'';var h=0;for(var i=0;i<s.length;i++)h=(h*31+s.charCodeAt(i))>>>0;return COLORS[h%COLORS.length]}\nfunction cell(d,p){var row=data.grid[d]||[];return row[p]||{subj:'',room:''}}\nfunction startMins(t){var x=String(t).split(':');return(+x[0])*60+(+x[1])}\nfunction nowMins(){var n=new Date();return n.getHours()*60+n.getMinutes()}\n\n/* the period running right now on the selected day (periods are an hour, as before) */\nfunction nowSlot(d){\n  if((d==null?day:d)!==todayIdx())return -1;\n  var mins=nowMins();\n  for(var i=0;i<data.times.length;i++){var s=startMins(data.times[i]);if(mins>=s&&mins<s+60)return i}\n  return -1;\n}\nfunction endTime(t){var m=startMins(t)+60;return String(Math.floor(m/60)%24).padStart(2,'0')+':'+String(m%60).padStart(2,'0')}\n\nfunction renderHero(){\n  var t=todayIdx(),mins=nowMins(),live=nowSlot(t),k='Today · '+DAYS[t],title,sub='';\n  var lessons=data.times.map(function(tm,p){return{p:p,tm:tm,c:cell(DAYS[t],p)}}).filter(function(x){return x.c.subj});\n  if(live>=0&&cell(DAYS[t],live).subj){var c=cell(DAYS[t],live);k='Now · until '+endTime(data.times[live]);title=c.subj;sub=c.room?'Room '+c.room:''}\n  else{\n    var next=lessons.filter(function(x){return startMins(x.tm)>mins})[0];\n    if(next){k='Next · '+next.tm;title=next.c.subj;sub=next.c.room?'Room '+next.c.room:''}\n    else if(lessons.length){title='Done for today';sub=lessons.length+(lessons.length===1?' lesson':' lessons')+' today'}\n    else{title='Nothing on today';sub='Tap a slot below to add a lesson.'}\n  }\n  el('hK').textContent=k;el('hT').textContent=title;el('hS').textContent=sub;el('hS').hidden=!sub;\n}\nfunction renderTabs(){\n  var T=el('tabs');T.innerHTML='';\n  DAYS.forEach(function(d,i){\n    var b=document.createElement('button');b.type='button';b.className=(i===day?'on':'')+(i===todayIdx()?' today':'');b.textContent=d;\n    b.onclick=function(){day=i;render();haptic('selection')};T.appendChild(b);\n  });\n}\nfunction renderDay(){\n  var S=el('slots');S.innerHTML='';var live=nowSlot();\n  data.times.forEach(function(time,p){\n    var c=cell(DAYS[day],p);\n    var div=document.createElement('div');div.className='slot';\n    var tm=document.createElement('div');tm.className='time';tm.textContent=time;\n    var bar=document.createElement('div');bar.className='bar';if(c.subj)bar.style.background=colorFor(c.subj);\n    var info=document.createElement('div');info.className='info';\n    var sj=document.createElement('div');sj.className='subj'+(c.subj?'':' empty');sj.textContent=c.subj||'Free — tap to set';\n    info.appendChild(sj);\n    if(c.room){var rm=document.createElement('div');rm.className='room';rm.innerHTML=icon('pin')+'<span>'+esc(c.room)+'</span>';info.appendChild(rm)}\n    div.appendChild(tm);div.appendChild(bar);div.appendChild(info);\n    if(p===live){var n=document.createElement('span');n.className='now';n.textContent='NOW';div.appendChild(n)}\n    div.onclick=function(){editCell(p)};\n    S.appendChild(div);\n  });\n}\nfunction renderWeek(){\n  var W=el('week');W.innerHTML='';var t=todayIdx();\n  W.appendChild(document.createElement('div'));\n  DAYS.forEach(function(d,i){var h=document.createElement('div');h.className='dh'+(i===t?' today':'');h.textContent=d;W.appendChild(h)});\n  data.times.forEach(function(time,p){\n    var tm=document.createElement('div');tm.className='tm';tm.textContent=time;W.appendChild(tm);\n    DAYS.forEach(function(d,i){\n      var c=cell(d,p),x=document.createElement('div');\n      x.className='c'+(i===t?' today':'')+(c.subj?'':' free')+(i===t&&nowSlot(i)===p?' live':'');\n      x.innerHTML=(c.subj?'<i style=\"background:'+colorFor(c.subj)+'\"></i>':'')+'<b>'+esc(c.subj||'—')+'</b>'+(c.room?'<span>'+esc(c.room)+'</span>':'');\n      x.onclick=function(){day=i;renderTabs();editCell(p)};\n      W.appendChild(x);\n    });\n  });\n}\nfunction render(){renderHero();renderTabs();renderDay();renderWeek();el('clearLbl').textContent=clearArmed?'Tap again to clear':'Clear '+DAYS[day]}\n\n// In-app editor — the sandboxed web view has no prompt()/confirm() dialogs, so\n// we use a real in-page modal instead (this was why tapping a slot did nothing).\nvar modalMode=null,modalP=-1,clearArmed=false,clearT=null;\nfunction openModal(){el('overlay').classList.add('show');setTimeout(function(){el('m-f1').focus()},60)}\nfunction closeModal(){el('overlay').classList.remove('show');modalMode=null}\nfunction editCell(p){\n  modalMode='cell';modalP=p;var c=cell(DAYS[day],p);\n  el('m-title').textContent=DAYS[day]+' · '+data.times[p];\n  el('m-f1').placeholder='Subject (e.g. Maths)';el('m-f1').value=c.subj||'';\n  el('m-f2').style.display='';el('m-f2').placeholder='Room / location (optional)';el('m-f2').value=c.room||'';\n  el('m-clear').style.display='';\n  openModal();\n}\nfunction editTimes(){\n  modalMode='times';\n  el('m-title').textContent='Period start times';\n  el('m-f1').placeholder='e.g. 09:00, 10:00, 11:00';el('m-f1').value=data.times.join(', ');\n  el('m-f2').style.display='none';el('m-clear').style.display='none';\n  openModal();\n}\nfunction modalSave(){\n  if(modalMode==='cell'){\n    if(!data.grid[DAYS[day]])data.grid[DAYS[day]]=[];\n    data.grid[DAYS[day]][modalP]={subj:el('m-f1').value.trim(),room:el('m-f2').value.trim()};\n    save();render();\n  }else if(modalMode==='times'){\n    var arr=el('m-f1').value.split(',').map(function(x){return x.trim()}).filter(function(x){return/^\\d{1,2}:\\d{2}$/.test(x)});\n    if(arr.length){data.times=arr;save();render()}\n  }\n  closeModal();haptic('light');\n}\nfunction modalClear(){\n  if(modalMode==='cell'&&data.grid[DAYS[day]]){data.grid[DAYS[day]][modalP]={subj:'',room:''};save();render()}\n  closeModal();\n}\nfunction clearDay(){\n  if(!clearArmed){clearArmed=true;render();\n    clearT=setTimeout(function(){clearArmed=false;render()},2500);return}\n  clearArmed=false;clearTimeout(clearT);\n  data.grid[DAYS[day]]=[];save();render();haptic('warning');\n}\nel('timesBtn').onclick=editTimes;el('clearBtn').onclick=clearDay;\nel('m-cancel').onclick=closeModal;el('m-clear').onclick=modalClear;el('m-save').onclick=modalSave;\n['m-f1','m-f2'].forEach(function(id){el(id).addEventListener('keydown',function(e){if(e.key==='Enter')modalSave()})});\nel('overlay').addEventListener('click',function(e){if(e.target===el('overlay'))closeModal()});\nsetInterval(function(){if(!document.hidden)renderHero()},60000);\ndocument.addEventListener('visibilitychange',function(){if(!document.hidden)render()});\n\nrender();\nstore().getItem('tt').then(function(v){\n  if(v)try{var o=JSON.parse(v);if(o.times)data.times=o.times;if(o.grid)data.grid=o.grid}catch(e){}\n  render();\n});\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes.\n   The spacer keeps the header clear of the status bar / Dynamic Island. It is\n   live CSS — env(safe-area-inset-top) — not a measured number: the inset is\n   still 0 when the page loads and only grows once MyLLM's bar has gone (v1\n   measured once, so the title sat under the island). If the page's own styles\n   already pad the header down by the inset, the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  /* Does any rule that applies to the header or an ancestor already use the top inset? */\n  function pageHandlesInset(head){\n    var chain = [], n, found = false;\n    for (n = head; n && n.nodeType === 1; n = n.parentElement) chain.push(n);\n    function walk(rules){\n      for (var i = 0; i < rules.length && !found; i++){\n        var r = rules[i];\n        if (r.cssRules && !r.selectorText) { walk(r.cssRules); continue; }\n        if (!r.selectorText || !/safe-area-inset-top/.test(r.cssText) || !/(padding|margin|top)\\s*:/.test(r.cssText)) continue;\n        if (/\\.imm-safe/.test(r.selectorText)) continue;\n        for (var k = 0; k < chain.length; k++){\n          try { if (chain[k].matches(r.selectorText)) { found = true; break; } } catch(e){}\n        }\n      }\n    }\n    for (var s = 0; s < document.styleSheets.length && !found; s++){\n      try { walk(document.styleSheets[s].cssRules); } catch(e){}\n    }\n    for (n = head; n && n.nodeType === 1 && !found; n = n.parentElement){\n      if (/safe-area-inset-top/.test(n.getAttribute(\"style\") || \"\")) found = true;\n    }\n    return found;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = (document.body.classList.contains(\"imm\") && !pageHandlesInset(head)) ? \"env(safe-area-inset-top)\" : \"0px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script></body></html>\n", "kind": "html", "iconSymbol": "calendar", "iconColor": "teal"}