{"name": "Class Timetable", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>:root{color-scheme:light dark;--accent:#40c8e0}\n*{box-sizing:border-box}\nbody{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:18px;background:#f2f2f7;color:#111}\n@media(prefers-color-scheme:dark){body{background:#000;color:#eee}.slot{background:#1c1c1e}.tab{background:#1c1c1e;color:#aaa}}\nh1{font-size:22px;margin:0 0 4px}\n.sub{font-size:13px;opacity:.6;margin-bottom:14px}\n.tabs{display:flex;gap:6px;overflow-x:auto;padding-bottom:8px;margin-bottom:6px}\n.tab{flex:none;padding:8px 14px;border-radius:20px;background:#e5e5ea;color:#555;font-size:14px;font-weight:600;border:0;cursor:pointer}\n.tab.on{background:var(--accent);color:#fff}\n.slot{background:#fff;border-radius:12px;padding:11px 14px;margin-bottom:8px;display:flex;align-items:center;gap:12px;cursor:pointer;box-shadow:0 1px 3px rgba(0,0,0,.07);border-left:5px solid transparent}\n.time{font-size:13px;font-variant-numeric:tabular-nums;opacity:.6;width:48px;flex:none}\n.dot{width:10px;height:10px;border-radius:50%;flex:none;background:#c7c7cc}\n.info{flex:1;min-width:0}\n.subj{font-size:16px;font-weight:600}\n.subj.empty{font-weight:400;opacity:.4}\n.room{font-size:12px;opacity:.6}\n.now{background:var(--accent);color:#fff;font-size:9px;font-weight:700;padding:2px 6px;border-radius:6px;letter-spacing:.04em}\n.bar{display:flex;gap:8px;margin-top:14px}\n.bar button{flex:1;border:0;background:#e5e5ea;color:#111;border-radius:10px;padding:11px;font-size:14px;font-weight:600}\n@media(prefers-color-scheme:dark){.bar button{background:#2c2c2e;color:#eee}.tab{background:#1c1c1e}}\n.hint{font-size:11px;opacity:.4;text-align:center;margin-top:12px}\n.overlay{position:fixed;inset:0;background:rgba(0,0,0,.45);display:none;align-items:center;justify-content:center;padding:24px;z-index:50}\n.overlay.show{display:flex}\n.modal{background:#fff;border-radius:16px;padding:18px;width:100%;max-width:340px;box-shadow:0 12px 44px rgba(0,0,0,.35)}\n@media(prefers-color-scheme:dark){.modal{background:#1c1c1e}}\n.modal h3{margin:0 0 12px;font-size:17px}\n.modal input{width:100%;padding:12px;border:1px solid #d1d1d6;border-radius:10px;font-size:16px;margin-bottom:10px;background:#fff;color:#111;-webkit-user-select:text;user-select:text}\n@media(prefers-color-scheme:dark){.modal input{background:#2c2c2e;color:#eee;border-color:#3a3a3c}}\n.mbtns{display:flex;gap:8px;margin-top:2px}\n.mbtns button{flex:1;border:0;border-radius:10px;padding:12px;font-size:15px;font-weight:600;background:var(--accent);color:#fff}\n.mbtns .msec{background:#e5e5ea;color:#333}\n.mbtns .mclr{background:#ffe5e3;color:#ff3b30}\n@media(prefers-color-scheme:dark){.mbtns .msec{background:#2c2c2e;color:#eee}.mbtns .mclr{background:#3a1f1e;color:#ff6b60}}\n@media(min-width:768px){body{max-width:760px;margin-left:auto;margin-right:auto}}\n</style></head><body>\n<h1>🗓️ Class Timetable</h1>\n<div class=\"sub\">Tap any slot to set the subject and room.</div>\n<div class=\"tabs\" id=\"tabs\"></div>\n<div id=\"slots\"></div>\n<div class=\"bar\"><button onclick=\"editTimes()\">Edit period times</button><button id=\"clearBtn\" onclick=\"clearDay()\">Clear this day</button></div>\n<div class=\"hint\">Tap a slot to add a lesson. Saved on-device, private to this app.</div>\n<div class=\"overlay\" id=\"overlay\">\n  <div class=\"modal\">\n    <h3 id=\"m-title\"></h3>\n    <input id=\"m-f1\" autocapitalize=\"words\" autocomplete=\"off\">\n    <input id=\"m-f2\" autocomplete=\"off\">\n    <div class=\"mbtns\">\n      <button class=\"msec\" onclick=\"closeModal()\">Cancel</button>\n      <button id=\"m-clear\" class=\"mclr\" onclick=\"modalClear()\">Clear</button>\n      <button onclick=\"modalSave()\">Save</button>\n    </div>\n  </div>\n</div>\n<script>\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar DAYS=[\"Mon\",\"Tue\",\"Wed\",\"Thu\",\"Fri\",\"Sat\",\"Sun\"];\nvar COLORS=[\"#ff453a\",\"#ff9f0a\",\"#ffd60a\",\"#30d158\",\"#40c8e0\",\"#5e5ce6\",\"#bf5af2\",\"#ff375f\"];\nvar DEFTIMES=[\"09:00\",\"10:00\",\"11:00\",\"12:00\",\"14:00\",\"15:00\"];\nvar data={times:DEFTIMES.slice(),grid:{}};   // grid[day] = [{subj,room}]\nvar day=Math.min(new Date().getDay()===0?6:new Date().getDay()-1,6);\nfunction el(i){return document.getElementById(i)}\nfunction save(){store.setItem('tt',JSON.stringify(data))}\nfunction colorFor(s){if(!s)return'#c7c7cc';var h=0;for(var i=0;i<s.length;i++)h=(h*31+s.charCodeAt(i))>>>0;return COLORS[h%COLORS.length]}\nfunction cell(d,p){var row=data.grid[d]||[];return row[p]||{subj:'',room:''}}\n\nfunction nowSlot(){\n  var n=new Date();if((n.getDay()===0?6:n.getDay()-1)!==day)return -1;\n  var mins=n.getHours()*60+n.getMinutes();\n  for(var i=0;i<data.times.length;i++){\n    var t=data.times[i].split(':'),start=(+t[0])*60+(+t[1]);\n    if(mins>=start&&mins<start+60)return i;\n  }\n  return -1;\n}\n\nfunction renderTabs(){\n  var T=el('tabs');T.innerHTML='';\n  DAYS.forEach(function(d,i){\n    var b=document.createElement('button');b.className='tab'+(i===day?' on':'');b.textContent=d;\n    b.onclick=function(){day=i;render()};T.appendChild(b);\n  });\n}\nfunction render(){\n  renderTabs();\n  var S=el('slots');S.innerHTML='';var live=nowSlot();\n  data.times.forEach(function(time,p){\n    var c=cell(DAYS[day],p);\n    var div=document.createElement('div');div.className='slot';\n    div.style.borderLeftColor=c.subj?colorFor(c.subj):'transparent';\n    var tm=document.createElement('div');tm.className='time';tm.textContent=time;\n    var info=document.createElement('div');info.className='info';\n    var sj=document.createElement('div');sj.className='subj'+(c.subj?'':' empty');sj.textContent=c.subj||'Free / tap to set';\n    info.appendChild(sj);\n    if(c.room){var rm=document.createElement('div');rm.className='room';rm.textContent='📍 '+c.room;info.appendChild(rm)}\n    div.appendChild(tm);div.appendChild(info);\n    if(p===live){var n=document.createElement('span');n.className='now';n.textContent='NOW';div.appendChild(n)}\n    div.onclick=function(){editCell(p)};\n    S.appendChild(div);\n  });\n}\n\n// In-app editor — the sandboxed web view has no prompt()/confirm() dialogs, so\n// we use a real in-page modal instead (this was why tapping a slot did nothing).\nvar modalMode=null,modalP=-1,clearArmed=false;\nfunction openModal(){el('overlay').classList.add('show');setTimeout(function(){el('m-f1').focus()},60)}\nfunction closeModal(){el('overlay').classList.remove('show');modalMode=null}\nfunction editCell(p){\n  modalMode='cell';modalP=p;var c=cell(DAYS[day],p);\n  el('m-title').textContent=DAYS[day]+' · '+data.times[p];\n  el('m-f1').placeholder='Subject (e.g. Maths)';el('m-f1').value=c.subj||'';\n  el('m-f2').style.display='';el('m-f2').placeholder='Room / location (optional)';el('m-f2').value=c.room||'';\n  el('m-clear').style.display='';\n  openModal();\n}\nfunction editTimes(){\n  modalMode='times';\n  el('m-title').textContent='Period start times';\n  el('m-f1').placeholder='e.g. 09:00, 10:00, 11:00';el('m-f1').value=data.times.join(', ');\n  el('m-f2').style.display='none';el('m-clear').style.display='none';\n  openModal();\n}\nfunction modalSave(){\n  if(modalMode==='cell'){\n    if(!data.grid[DAYS[day]])data.grid[DAYS[day]]=[];\n    data.grid[DAYS[day]][modalP]={subj:el('m-f1').value.trim(),room:el('m-f2').value.trim()};\n    save();render();\n  }else if(modalMode==='times'){\n    var arr=el('m-f1').value.split(',').map(function(x){return x.trim()}).filter(function(x){return/^\\d{1,2}:\\d{2}$/.test(x)});\n    if(arr.length){data.times=arr;save();render()}\n  }\n  closeModal();if(window.myllmHaptic)myllmHaptic('light');\n}\nfunction modalClear(){\n  if(modalMode==='cell'&&data.grid[DAYS[day]]){data.grid[DAYS[day]][modalP]={subj:'',room:''};save();render()}\n  closeModal();\n}\nfunction clearDay(){\n  if(!clearArmed){clearArmed=true;el('clearBtn').textContent='Tap again to clear';\n    setTimeout(function(){clearArmed=false;el('clearBtn').textContent='Clear this day'},2500);return}\n  clearArmed=false;el('clearBtn').textContent='Clear this day';\n  data.grid[DAYS[day]]=[];save();render();\n}\n['m-f1','m-f2'].forEach(function(id){el(id).addEventListener('keydown',function(e){if(e.key==='Enter')modalSave()})});\nel('overlay').addEventListener('click',function(e){if(e.target===el('overlay'))closeModal()});\n\nstore.getItem('tt').then(function(v){\n  if(v)try{var o=JSON.parse(v);if(o.times)data.times=o.times;if(o.grid)data.grid=o.grid}catch(e){}\n  render();\n});\n</script></body></html>\n", "kind": "html", "iconSymbol": "calendar", "iconColor": "teal"}