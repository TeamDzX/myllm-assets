{"name": "Risk & Decision Log", "kind": "html", "iconSymbol": "shield.lefthalf.filled", "iconColor": "orange", "html": "<!doctype html>\n<!--\n  Risk & Decision Log — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Risk &amp; Decision Log</title>\n<style>:root{--build-id:\"8ca1da446f\";color-scheme:light dark;--ac:#ff9500}\n*{box-sizing:border-box}\nbody{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:18px 16px calc(28px + env(safe-area-inset-bottom));background:#f2f2f7;color:#111;-webkit-tap-highlight-color:transparent;max-width:820px;margin-left:auto;margin-right:auto}\n@media(prefers-color-scheme:dark){body{background:#000;color:#eee}.card,input,textarea,.seg{background:#1c1c1e}input,textarea{color:#eee;border-color:#3a3a3c}.seg{background:#1c1c1e}.seg button{color:#eee}}\nh1{font-size:22px;margin:0 0 12px}\n.seg{display:flex;background:#e4e4ea;border-radius:12px;padding:3px;margin-bottom:16px}\n.seg button{flex:1;border:0;background:none;padding:9px 0;font-size:14px;font-weight:600;border-radius:9px;color:#333}\n.seg button.on{background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.12)}\n@media(prefers-color-scheme:dark){.seg{background:#2c2c2e}.seg button.on{background:#48484a}}\ninput,textarea{width:100%;padding:12px;border:1px solid #d1d1d6;border-radius:12px;font-size:15px;background:#fff;font-family:inherit}\ntextarea{min-height:64px;resize:vertical;margin-top:8px}\nlabel{font-size:12px;text-transform:uppercase;letter-spacing:.03em;opacity:.55;display:block;margin:12px 2px 6px}\n.pills{display:flex;gap:6px}\n.pills button{flex:1;border:1px solid #d1d1d6;background:#fff;border-radius:9px;padding:9px 0;font-weight:700;font-size:15px;color:inherit}\n.pills button.on{background:var(--ac);color:#fff;border-color:transparent}\n.act{border:0;background:var(--ac);color:#fff;border-radius:12px;padding:13px 16px;width:100%;font-size:15px;font-weight:600;margin-top:14px}\n.card{background:#fff;border-radius:14px;padding:13px 14px;margin-bottom:9px;box-shadow:0 1px 2px rgba(0,0,0,.05)}\n.card .top{display:flex;align-items:center;gap:9px}\n.card .ti{flex:1;font-size:16px;font-weight:600;line-height:1.3}\n.score{flex:0 0 auto;min-width:34px;height:34px;padding:0 8px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-weight:700;color:#fff;font-size:15px}\n.score.lo{background:#34c759}.score.md{background:#ff9500}.score.hi{background:#ff3b30}\n.card .li{font-size:12px;opacity:.6;margin-top:5px}\n.card .rat{font-size:14px;line-height:1.5;margin-top:6px;white-space:pre-wrap}\n.card .dt{font-size:12px;opacity:.5;margin-top:6px}\n.del{background:none;color:#ff453a;font-size:16px;padding:2px 4px}\n.empty{opacity:.5;text-align:center;margin:26px 0;font-size:14px}\n.section{display:none}.section.on{display:block}\nh2{font-size:14px;text-transform:uppercase;letter-spacing:.02em;opacity:.55;margin:22px 2px 8px}\n</style></head><body>\n<h1>🛡️ Risk &amp; Decision Log</h1>\n<div class=\"seg\">\n  <button class=\"on\" id=\"tRisk\" onclick=\"tab('risk')\">Risks</button>\n  <button id=\"tDec\" onclick=\"tab('dec')\">Decisions</button>\n</div>\n\n<!-- RISKS -->\n<div class=\"section on\" id=\"s-risk\">\n  <input id=\"rTitle\" placeholder=\"Risk — e.g. Key vendor may slip the deadline\">\n  <label>Likelihood</label><div class=\"pills\" id=\"rLike\"></div>\n  <label>Impact</label><div class=\"pills\" id=\"rImp\"></div>\n  <textarea id=\"rMit\" placeholder=\"Mitigation / owner (optional)…\"></textarea>\n  <button class=\"act\" onclick=\"addRisk()\">Log risk</button>\n  <h2>Risk register</h2>\n  <div id=\"riskList\"></div>\n</div>\n\n<!-- DECISIONS -->\n<div class=\"section\" id=\"s-dec\">\n  <input id=\"dTitle\" placeholder=\"Decision — e.g. Go with Postgres over Mongo\">\n  <textarea id=\"dRat\" placeholder=\"Rationale / context / who decided…\"></textarea>\n  <button class=\"act\" onclick=\"addDecision()\">Log decision</button>\n  <h2>Decision record</h2>\n  <div id=\"decList\"></div>\n</div>\n\n<script>\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar risks=[], decisions=[], like=3, imp=3, seed=5551;\nfunction el(i){return document.getElementById(i)}\nfunction haptic(k){if(window.myllmHaptic)myllmHaptic(k||'light')}\nfunction uid(){seed=(seed*9301+49297)%233280;return 'r'+seed}\nfunction save(){store.setItem('rdlog',JSON.stringify({risks:risks,decisions:decisions}))}\nfunction esc(s){return (s+'').replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]})}\n\nfunction tab(t){\n  el('s-risk').classList.toggle('on',t==='risk');el('s-dec').classList.toggle('on',t==='dec');\n  el('tRisk').classList.toggle('on',t==='risk');el('tDec').classList.toggle('on',t==='dec');haptic('selection');\n}\nfunction pillRow(id,cur,setter){\n  var p=el(id);p.innerHTML='';\n  for(var v=1;v<=5;v++){(function(v){var b=document.createElement('button');b.className=v===cur()?'on':'';b.textContent=v;\n    b.onclick=function(){setter(v);haptic('selection')};p.appendChild(b)})(v)}\n}\nfunction refreshPills(){pillRow('rLike',function(){return like},function(v){like=v;refreshPills()});\n  pillRow('rImp',function(){return imp},function(v){imp=v;refreshPills()});}\n\nfunction band(s){return s<=6?'lo':(s<=12?'md':'hi')}\nfunction addRisk(){\n  var t=el('rTitle').value.trim();if(!t)return;\n  risks.push({id:uid(),title:t,like:like,imp:imp,mit:el('rMit').value.trim()});\n  el('rTitle').value='';el('rMit').value='';like=3;imp=3;refreshPills();save();render();haptic('success');\n}\nfunction addDecision(){\n  var t=el('dTitle').value.trim();if(!t)return;\n  var d=new Date();\n  var date=d.toLocaleDateString(undefined,{year:'numeric',month:'short',day:'numeric'});\n  decisions.unshift({id:uid(),title:t,rat:el('dRat').value.trim(),date:date});\n  el('dTitle').value='';el('dRat').value='';save();render();haptic('success');\n}\nfunction delRisk(id){risks=risks.filter(function(x){return x.id!==id});save();render();haptic('light')}\nfunction delDec(id){decisions=decisions.filter(function(x){return x.id!==id});save();render();haptic('light')}\n\nfunction render(){\n  var L=el('riskList');L.innerHTML='';\n  var sorted=risks.slice().sort(function(a,b){return (b.like*b.imp)-(a.like*a.imp)});\n  if(!sorted.length)L.innerHTML='<div class=\"empty\">No risks logged yet.</div>';\n  sorted.forEach(function(r){\n    var s=r.like*r.imp;var d=document.createElement('div');d.className='card';\n    d.innerHTML='<div class=\"top\"><div class=\"score '+band(s)+'\">'+s+'</div><div class=\"ti\">'+esc(r.title)+'</div><button class=\"del\">✕</button></div>'+\n      '<div class=\"li\">Likelihood '+r.like+' × Impact '+r.imp+'</div>'+\n      (r.mit?'<div class=\"rat\">'+esc(r.mit)+'</div>':'');\n    d.querySelector('.del').onclick=function(){delRisk(r.id)};L.appendChild(d);\n  });\n  var D=el('decList');D.innerHTML='';\n  if(!decisions.length)D.innerHTML='<div class=\"empty\">No decisions logged yet.</div>';\n  decisions.forEach(function(dc){\n    var d=document.createElement('div');d.className='card';\n    d.innerHTML='<div class=\"top\"><div class=\"ti\">'+esc(dc.title)+'</div><button class=\"del\">✕</button></div>'+\n      (dc.rat?'<div class=\"rat\">'+esc(dc.rat)+'</div>':'')+'<div class=\"dt\">📌 '+esc(dc.date)+'</div>';\n    d.querySelector('.del').onclick=function(){delDec(dc.id)};D.appendChild(d);\n  });\n}\nrefreshPills();\nstore.getItem('rdlog').then(function(v){if(v){try{var o=JSON.parse(v);risks=o.risks||[];decisions=o.decisions||[]}catch(e){}}render()});\n</script></body></html>\n"}