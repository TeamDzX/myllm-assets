{"name": "Currency", "kind": "html", "iconSymbol": "dollarsign.arrow.circlepath", "iconColor": "mint", "html": "<!doctype html>\n<!--\n  Currency — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Currency</title>\n<style>\n:root{--build-id:\"529fabcafd\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7);--surface:var(--myllm-surface,#fff);--text:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#6e6e73);--accent:var(--myllm-accent,#0a84ff);--border:var(--myllm-border,#e3e3e8);\n  --radius:var(--myllm-radius,18px);--good:#2fb56a;--warn:#e8a317}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nhtml,body{margin:0}\nbody{font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);background:var(--bg);color:var(--text);\n  padding:16px 16px calc(28px + env(safe-area-inset-bottom));max-width:820px;margin:0 auto;-webkit-font-smoothing:antialiased}\nh1{font-size:24px;margin:0;letter-spacing:-.3px}\n.sub{font-size:13px;color:var(--muted);margin:3px 0 14px}\n.top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}\n.btn{border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:12px;padding:9px 13px;font-size:14px;font-weight:600;white-space:nowrap}\n.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px}\n.row{display:flex;align-items:center;gap:10px}\n.cur{flex:1;display:flex;align-items:center;gap:10px;border:1px solid var(--border);background:var(--bg);border-radius:14px;padding:10px 12px;min-width:0}\n.cur .flag{font-size:26px;line-height:1}\n.cur .code{font-size:17px;font-weight:700}\n.cur .name{font-size:12px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.cur .txt{min-width:0;flex:1}\n.cur .chev{color:var(--muted);font-size:12px}\n.swap{width:44px;height:44px;border-radius:50%;border:1px solid var(--border);background:var(--surface);font-size:18px;color:var(--accent);flex:none;transition:transform .25s}\n.swap.spin{transform:rotate(180deg)}\n.amount{margin:14px 0 6px}\n.amount input{width:100%;border:0;background:transparent;color:var(--text);font-size:44px;font-weight:700;letter-spacing:-1px;outline:none;padding:0;font-variant-numeric:tabular-nums}\n.amount input::placeholder{color:var(--border)}\n.eq{font-size:13px;color:var(--muted);margin:2px 0 8px}\n.result{font-size:40px;font-weight:700;letter-spacing:-1px;color:var(--accent);font-variant-numeric:tabular-nums;word-break:break-all;line-height:1.1}\n.result small{font-size:18px;color:var(--muted);font-weight:600;margin-left:6px}\n.rate{font-size:13px;color:var(--muted);margin-top:10px;display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap}\n.rate b{color:var(--text);font-weight:600}\n.status{font-size:12px;color:var(--muted);min-height:16px;margin:8px 2px 0}\n.status.warn{color:var(--warn)}\n.sec{margin-top:16px}\n.sec h2{font-size:15px;margin:0 0 8px;display:flex;align-items:center;justify-content:space-between}\n.sec h2 button{border:0;background:transparent;color:var(--accent);font-size:14px;font-weight:600;padding:4px 0}\n.also{display:flex;flex-direction:column}\n.arow{display:flex;align-items:center;gap:10px;padding:10px 0;border-top:1px solid var(--border)}\n.arow:first-child{border-top:0}\n.arow .flag{font-size:22px}\n.arow .code{font-weight:700;min-width:44px}\n.arow .name{flex:1;color:var(--muted);font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.arow .val{font-weight:700;font-variant-numeric:tabular-nums}\n.chips{display:flex;gap:6px;overflow-x:auto;padding-bottom:4px}\n.chip{border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:999px;padding:7px 12px;font-size:13px;font-weight:600;white-space:nowrap}\n.note{font-size:12px;color:var(--muted);line-height:1.5;margin-top:14px}\n[hidden]{display:none!important}\n/* picker */\n.modal{position:fixed;inset:0;background:var(--bg);z-index:9;display:flex;flex-direction:column;padding-top:env(safe-area-inset-top)}\n.modal .bar{display:flex;gap:8px;align-items:center;padding:12px 14px;border-bottom:1px solid var(--border);background:var(--bg)}\n.modal input{flex:1;min-width:0;padding:11px 12px;border:1px solid var(--border);border-radius:12px;font-size:16px;background:var(--surface);color:var(--text)}\n.modal .list{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:0 14px calc(20px + env(safe-area-inset-bottom))}\n.modal h4{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin:14px 0 4px}\n.prow{display:flex;align-items:center;gap:12px;padding:11px 0;border-bottom:1px solid var(--border)}\n.prow .flag{font-size:26px;width:32px;text-align:center}\n.prow .code{font-weight:700;min-width:46px}\n.prow .name{flex:1;color:var(--muted);font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.prow .star{border:0;background:transparent;font-size:20px;color:var(--border);padding:4px 8px}\n.prow .star.on{color:#f5b301}\n.prow.sel .code{color:var(--accent)}\n.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(20px);\n  background:var(--text);color:var(--bg);padding:10px 16px;border-radius:14px;font-size:14px;font-weight:600;opacity:0;pointer-events:none;transition:.25s;z-index:10}\n.toast.on{opacity:1;transform:translateX(-50%) translateY(0)}\n</style></head><body>\n\n<div class=\"top\">\n  <div><h1>Currency</h1><div class=\"sub\">Live exchange rates, simply</div></div>\n  <button class=\"btn\" id=\"shareBtn\">Share</button>\n</div>\n\n<div class=\"card\">\n  <div class=\"row\">\n    <button class=\"cur\" id=\"fromBtn\"><span class=\"flag\" id=\"fromFlag\">🇬🇧</span><span class=\"txt\"><span class=\"code\" id=\"fromCode\">GBP</span><br><span class=\"name\" id=\"fromName\">British Pound</span></span><span class=\"chev\">▼</span></button>\n    <button class=\"swap\" id=\"swapBtn\" aria-label=\"Swap currencies\">⇅</button>\n    <button class=\"cur\" id=\"toBtn\"><span class=\"flag\" id=\"toFlag\">🇺🇸</span><span class=\"txt\"><span class=\"code\" id=\"toCode\">USD</span><br><span class=\"name\" id=\"toName\">US Dollar</span></span><span class=\"chev\">▼</span></button>\n  </div>\n  <div class=\"amount\"><input id=\"amount\" inputmode=\"decimal\" placeholder=\"0\" value=\"100\" autocomplete=\"off\"></div>\n  <div class=\"eq\" id=\"eq\">is</div>\n  <div class=\"result\" id=\"result\">—</div>\n  <div class=\"rate\"><span id=\"rateLine\">1 GBP = …</span><span id=\"updated\"></span></div>\n  <div class=\"status\" id=\"status\"></div>\n</div>\n\n<div class=\"sec\">\n  <div class=\"chips\" id=\"quick\"></div>\n</div>\n\n<div class=\"sec\" id=\"alsoSec\">\n  <h2>Also in <button id=\"editFavs\">Edit</button></h2>\n  <div class=\"card also\" id=\"also\"></div>\n</div>\n\n<p class=\"note\">Mid-market rates from the Open Exchange Rate API, refreshed daily and fetched through MyLLM's network bridge, with the European Central Bank as a fallback. Rates are indicative — a bank or card will apply its own spread. The last rates are kept on this device, so the converter still works offline and tells you how old they are.</p>\n\n<div class=\"modal\" id=\"picker\" hidden>\n  <div class=\"bar\"><input id=\"search\" placeholder=\"Search currency or country\" autocapitalize=\"characters\" autocorrect=\"off\"><button class=\"btn\" id=\"closePicker\">Done</button></div>\n  <div class=\"list\" id=\"plist\"></div>\n</div>\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\n(function(){\n'use strict';\nvar $=function(id){return document.getElementById(id);};\nfunction haptic(k){try{if(window.myllmHaptic)window.myllmHaptic(k||'light');}catch(e){}}\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null);},setItem:function(){return Promise.resolve();}};\nvar hasFetch=typeof window.myllmFetch==='function';\nvar KEY='currency.v1';\n\n/* Names for the currencies people actually convert; anything else from the\n   feed shows as its code. Flag = the ISO country from the code's first two\n   letters, which is right for national currencies; the few that are not get\n   a fixed emoji. */\nvar NAMES={USD:'US Dollar',EUR:'Euro',GBP:'British Pound',JPY:'Japanese Yen',CHF:'Swiss Franc',CAD:'Canadian Dollar',AUD:'Australian Dollar',NZD:'New Zealand Dollar',\nCNY:'Chinese Yuan',HKD:'Hong Kong Dollar',SGD:'Singapore Dollar',INR:'Indian Rupee',KRW:'South Korean Won',TWD:'Taiwan Dollar',THB:'Thai Baht',MYR:'Malaysian Ringgit',\nIDR:'Indonesian Rupiah',PHP:'Philippine Peso',VND:'Vietnamese Dong',PKR:'Pakistani Rupee',BDT:'Bangladeshi Taka',LKR:'Sri Lankan Rupee',\nSEK:'Swedish Krona',NOK:'Norwegian Krone',DKK:'Danish Krone',ISK:'Icelandic Króna',PLN:'Polish Złoty',CZK:'Czech Koruna',HUF:'Hungarian Forint',RON:'Romanian Leu',\nBGN:'Bulgarian Lev',HRK:'Croatian Kuna',RSD:'Serbian Dinar',UAH:'Ukrainian Hryvnia',RUB:'Russian Ruble',TRY:'Turkish Lira',ILS:'Israeli Shekel',AED:'UAE Dirham',\nSAR:'Saudi Riyal',QAR:'Qatari Riyal',KWD:'Kuwaiti Dinar',BHD:'Bahraini Dinar',OMR:'Omani Rial',JOD:'Jordanian Dinar',EGP:'Egyptian Pound',MAD:'Moroccan Dirham',\nTND:'Tunisian Dinar',NGN:'Nigerian Naira',KES:'Kenyan Shilling',GHS:'Ghanaian Cedi',ZAR:'South African Rand',TZS:'Tanzanian Shilling',UGX:'Ugandan Shilling',\nMXN:'Mexican Peso',BRL:'Brazilian Real',ARS:'Argentine Peso',CLP:'Chilean Peso',COP:'Colombian Peso',PEN:'Peruvian Sol',UYU:'Uruguayan Peso',\nDOP:'Dominican Peso',JMD:'Jamaican Dollar',TTD:'Trinidad Dollar',BBD:'Barbados Dollar',XCD:'East Caribbean Dollar',BSD:'Bahamian Dollar',\nXOF:'West African CFA Franc',XAF:'Central African CFA Franc',XPF:'CFP Franc',MUR:'Mauritian Rupee',MVR:'Maldivian Rufiyaa',FJD:'Fijian Dollar',\nGEL:'Georgian Lari',AMD:'Armenian Dram',AZN:'Azerbaijani Manat',KZT:'Kazakhstani Tenge',UZS:'Uzbekistani Som',MNT:'Mongolian Tögrög',NPR:'Nepalese Rupee',\nMOP:'Macanese Pataca',BND:'Brunei Dollar',KHR:'Cambodian Riel',LAK:'Lao Kip',MMK:'Myanmar Kyat',CUP:'Cuban Peso',GTQ:'Guatemalan Quetzal',CRC:'Costa Rican Colón',\nPAB:'Panamanian Balboa',BOB:'Bolivian Boliviano',PYG:'Paraguayan Guaraní',HNL:'Honduran Lempira',NIO:'Nicaraguan Córdoba',ALL:'Albanian Lek',MKD:'Macedonian Denar',\nBAM:'Bosnian Mark',MDL:'Moldovan Leu',BYN:'Belarusian Ruble',GIP:'Gibraltar Pound',JEP:'Jersey Pound',IMP:'Manx Pound',GGP:'Guernsey Pound',FKP:'Falkland Pound',\nXDR:'IMF Special Drawing Rights'};\nvar POPULAR=['USD','EUR','GBP','JPY','CHF','CAD','AUD','CNY','INR','AED','HKD','SGD','NZD','SEK','NOK','DKK','PLN','TRY','ZAR','MXN','BRL','THB','KRW'];\nvar FLAG_FIX={EUR:'🇪🇺',XOF:'🌍',XAF:'🌍',XPF:'🌏',XCD:'🏝️',XDR:'🌐',ANG:'🇨🇼',AWG:'🇦🇼'};\nvar COUNTRIES='AD AE AF AG AL AM AO AR AT AU AW AZ BA BB BD BE BF BG BH BI BJ BM BN BO BR BS BT BW BY BZ CA CD CF CG CH CI CK CL CM CN CO CR CU CV CW CY CZ DE DJ DK DM DO DZ EC EE EG ER ES ET FI FJ FK FM FO FR GA GB GD GE GG GH GI GM GN GQ GR GT GW GY HK HN HR HT HU ID IE IL IM IN IQ IR IS IT JE JM JO JP KE KG KH KI KM KN KP KR KW KY KZ LA LB LC LI LK LR LS LT LU LV LY MA MC MD ME MG MH MK ML MM MN MO MR MT MU MV MW MX MY MZ NA NE NG NI NL NO NP NR NZ OM PA PE PG PH PK PL PT PW PY QA RO RS RU RW SA SB SC SD SE SG SH SI SK SL SM SN SO SR SS ST SV SY SZ TD TG TH TJ TL TM TN TO TR TT TV TW TZ UA UG US UY UZ VA VC VE VN VU WS YE ZA ZM ZW'.split(' ');\nfunction flag(code){\n  if(FLAG_FIX[code])return FLAG_FIX[code];\n  var cc=code.slice(0,2);\n  if(COUNTRIES.indexOf(cc)<0)return '🌐';\n  return String.fromCodePoint(0x1F1E6+cc.charCodeAt(0)-65,0x1F1E6+cc.charCodeAt(1)-65);\n}\nfunction nameOf(code){return NAMES[code]||code;}\n\n/* ---------- state ---------- */\nvar state={from:'GBP',to:'USD',amount:'100',favs:['EUR','USD','JPY','CHF'],recent:[],rates:null,base:'USD',updated:0,source:''};\nvar pickerTarget=null,editingFavs=false;\nfunction save(){var s={from:state.from,to:state.to,amount:state.amount,favs:state.favs,recent:state.recent,rates:state.rates,base:state.base,updated:state.updated,source:state.source};return store.setItem(KEY,JSON.stringify(s)).catch(function(){});}\nfunction load(){return store.getItem(KEY).then(function(s){try{var d=JSON.parse(s||'{}');if(d&&d.from){for(var k in d)state[k]=d[k];}}catch(e){}}).catch(function(){});}\nfunction esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\nfunction toast(t){var e=$('toast');e.textContent=t;e.classList.add('on');clearTimeout(toast._t);toast._t=setTimeout(function(){e.classList.remove('on');},1800);}\n\n/* ---------- rates ---------- */\nfunction rate(from,to){var r=state.rates;if(!r)return null;var a=from===state.base?1:r[from],b=to===state.base?1:r[to];if(!a||!b)return null;return b/a;}\nfunction fmt(n,code){\n  if(!isFinite(n))return '—';\n  var abs=Math.abs(n),dp=abs>=1000?0:abs>=1?2:abs>=0.01?4:6;\n  if(['JPY','KRW','VND','IDR','HUF','CLP','PYG','UGX','TZS','LAK','KHR','MMK'].indexOf(code)>=0&&abs>=1)dp=0;\n  return n.toLocaleString(undefined,{minimumFractionDigits:dp,maximumFractionDigits:dp});\n}\nfunction fmtRate(n){if(!isFinite(n))return '…';var abs=Math.abs(n);return n.toLocaleString(undefined,{maximumFractionDigits:abs>=100?2:abs>=1?4:6});}\nfunction ageText(){\n  if(!state.updated)return '';\n  var h=(Date.now()-state.updated)/36e5;\n  if(h<1)return 'updated just now';if(h<24)return 'updated '+Math.round(h)+'h ago';\n  return 'rates from '+new Date(state.updated).toLocaleDateString([],{day:'numeric',month:'short'});\n}\nfunction fetchRates(){\n  if(!hasFetch)return Promise.reject(new Error('This app needs MyLLM\\'s network bridge — open it inside the MyLLM app.'));\n  return window.myllmFetch('https://open.er-api.com/v6/latest/USD').then(function(res){\n    var d=JSON.parse(res.body||'{}');\n    if(d.result!=='success'||!d.rates)throw new Error('bad primary');\n    state.rates=d.rates;state.base='USD';state.updated=Date.now();state.source='Open Exchange Rate API';\n  }).catch(function(){\n    return window.myllmFetch('https://api.frankfurter.dev/v1/latest?base=USD').then(function(res){\n      var d=JSON.parse(res.body||'{}');\n      if(!d.rates)throw new Error('bad fallback');\n      d.rates.USD=1;state.rates=d.rates;state.base='USD';state.updated=Date.now();state.source='European Central Bank';\n    });\n  });\n}\nfunction refresh(force){\n  var fresh=state.rates&&(Date.now()-state.updated)<6*36e5;\n  if(fresh&&!force){render();return Promise.resolve();}\n  $('status').textContent=state.rates?'Refreshing rates…':'Fetching rates…';$('status').className='status';\n  return fetchRates().then(function(){$('status').textContent='';save();render();haptic('selection');})\n    .catch(function(e){\n      var m=(e&&e.message)||'';\n      $('status').className='status warn';\n      if(/turned off/i.test(m))$('status').textContent='Network access for apps is turned off in MyLLM Settings — showing saved rates.';\n      else if(!hasFetch)$('status').textContent=m;\n      else $('status').textContent=(state.rates?'Couldn\\'t refresh — showing saved rates ('+ageText()+').':'Couldn\\'t fetch rates. Check your connection and tap to retry.');\n      render();\n    });\n}\n\n/* ---------- render ---------- */\nfunction setCur(which,code){$(which+'Flag').textContent=flag(code);$(which+'Code').textContent=code;$(which+'Name').textContent=nameOf(code);}\nfunction amountValue(){var v=parseFloat(String(state.amount).replace(/[^0-9.]/g,''));return isFinite(v)?v:0;}\nfunction render(){\n  setCur('from',state.from);setCur('to',state.to);\n  var r=rate(state.from,state.to),a=amountValue();\n  $('result').innerHTML=r==null?'—':esc(fmt(a*r,state.to))+'<small>'+esc(state.to)+'</small>';\n  $('eq').textContent=fmt(a,state.from)+' '+state.from+' is';\n  $('rateLine').innerHTML=r==null?'1 '+esc(state.from)+' = …':'1 '+esc(state.from)+' = <b>'+esc(fmtRate(r))+' '+esc(state.to)+'</b> · 1 '+esc(state.to)+' = <b>'+esc(fmtRate(1/r))+' '+esc(state.from)+'</b>';\n  $('updated').textContent=ageText();\n  // quick amounts\n  var quick=[1,10,50,100,500,1000];\n  $('quick').innerHTML=quick.map(function(q){return '<button class=\"chip\" data-q=\"'+q+'\">'+q.toLocaleString()+' '+esc(state.from)+'</button>';}).join('')+\n    (state.recent.length?state.recent.map(function(p){return '<button class=\"chip\" data-pair=\"'+esc(p)+'\">'+esc(p.replace('/',' → '))+'</button>';}).join(''):'');\n  // also in\n  var rows=state.favs.filter(function(c){return c!==state.to&&c!==state.from;}).map(function(c){\n    var rr=rate(state.from,c);\n    return '<div class=\"arow\" data-code=\"'+esc(c)+'\"><span class=\"flag\">'+flag(c)+'</span><span class=\"code\">'+esc(c)+'</span><span class=\"name\">'+esc(nameOf(c))+'</span><span class=\"val\">'+(rr==null?'—':esc(fmt(a*rr,c)))+'</span>'+(editingFavs?'<button class=\"btn\" data-unfav=\"'+esc(c)+'\">Remove</button>':'')+'</div>';\n  });\n  $('also').innerHTML=rows.length?rows.join(''):'<div class=\"arow\" style=\"color:var(--muted);font-size:13px\">Star currencies in the picker to see the amount in them here.</div>';\n  $('editFavs').textContent=editingFavs?'Done':'Edit';\n}\n\n/* ---------- picker ---------- */\nfunction openPicker(which){\n  pickerTarget=which;$('picker').hidden=false;$('search').value='';renderPicker('');\n  document.body.style.overflow='hidden';setTimeout(function(){$('search').focus();},50);haptic('light');\n}\nfunction closePicker(){$('picker').hidden=true;document.body.style.overflow='';pickerTarget=null;render();save();}\nfunction allCodes(){var codes=state.rates?Object.keys(state.rates):Object.keys(NAMES);if(codes.indexOf('USD')<0)codes.push('USD');return codes.sort();}\nfunction renderPicker(q){\n  q=q.trim().toUpperCase();\n  var codes=allCodes().filter(function(c){return !q||c.indexOf(q)>=0||nameOf(c).toUpperCase().indexOf(q)>=0;});\n  var current=state[pickerTarget];\n  function row(c){return '<div class=\"prow'+(c===current?' sel':'')+'\" data-code=\"'+esc(c)+'\"><span class=\"flag\">'+flag(c)+'</span><span class=\"code\">'+esc(c)+'</span><span class=\"name\">'+esc(nameOf(c))+'</span><button class=\"star'+(state.favs.indexOf(c)>=0?' on':'')+'\" data-star=\"'+esc(c)+'\" aria-label=\"Favourite\">★</button></div>';}\n  var html='';\n  if(!q){\n    var favs=state.favs.filter(function(c){return codes.indexOf(c)>=0;});\n    if(favs.length)html+='<h4>Favourites</h4>'+favs.map(row).join('');\n    var pop=POPULAR.filter(function(c){return codes.indexOf(c)>=0;});\n    html+='<h4>Popular</h4>'+pop.map(row).join('');\n    html+='<h4>All currencies</h4>';\n  }\n  html+=codes.map(row).join('');\n  $('plist').innerHTML=html||'<div class=\"prow\" style=\"color:var(--muted)\">No match</div>';\n}\n$('plist').addEventListener('click',function(e){\n  var star=e.target.closest('button[data-star]');\n  if(star){var c=star.dataset.star;var i=state.favs.indexOf(c);if(i>=0)state.favs.splice(i,1);else state.favs.push(c);haptic('selection');renderPicker($('search').value);return;}\n  var row=e.target.closest('.prow[data-code]');if(!row)return;\n  state[pickerTarget]=row.dataset.code;haptic('selection');closePicker();\n});\n$('search').addEventListener('input',function(){renderPicker($('search').value);});\n$('closePicker').addEventListener('click',closePicker);\n\n/* ---------- wiring ---------- */\n$('fromBtn').addEventListener('click',function(){openPicker('from');});\n$('toBtn').addEventListener('click',function(){openPicker('to');});\n$('swapBtn').addEventListener('click',function(){\n  var t=state.from;state.from=state.to;state.to=t;\n  $('swapBtn').classList.toggle('spin');haptic('selection');noteRecent();render();save();\n});\n$('amount').addEventListener('input',function(){state.amount=$('amount').value;render();save();});\n$('amount').addEventListener('focus',function(){$('amount').select();});\n$('quick').addEventListener('click',function(e){\n  var q=e.target.closest('[data-q]');if(q){state.amount=q.dataset.q;$('amount').value=q.dataset.q;render();save();haptic('selection');return;}\n  var p=e.target.closest('[data-pair]');if(p){var parts=p.dataset.pair.split('/');state.from=parts[0];state.to=parts[1];render();save();haptic('selection');}\n});\n$('also').addEventListener('click',function(e){\n  var un=e.target.closest('[data-unfav]');if(un){state.favs=state.favs.filter(function(c){return c!==un.dataset.unfav;});render();save();return;}\n  var r=e.target.closest('.arow[data-code]');if(r&&!editingFavs){state.to=r.dataset.code;noteRecent();render();save();haptic('selection');}\n});\n$('editFavs').addEventListener('click',function(){editingFavs=!editingFavs;render();});\n$('status').addEventListener('click',function(){refresh(true);});\n$('updated').addEventListener('click',function(){refresh(true);});\n$('shareBtn').addEventListener('click',function(){\n  var r=rate(state.from,state.to);if(r==null)return;var a=amountValue();\n  var text=fmt(a,state.from)+' '+state.from+' = '+fmt(a*r,state.to)+' '+state.to+'\\n1 '+state.from+' = '+fmtRate(r)+' '+state.to+' ('+ageText()+')\\nvia MyLLM';\n  haptic('light');\n  if(window.myllmShare){try{window.myllmShare({text:text});}catch(e){toast('Sharing unavailable');}}\n  else if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(text).then(function(){toast('Copied');},function(){toast('Copy failed');});}\n  else toast('Sharing unavailable');\n});\nfunction noteRecent(){var p=state.from+'/'+state.to;state.recent=[p].concat(state.recent.filter(function(x){return x!==p;})).slice(0,4);}\n\nload().then(function(){\n  $('amount').value=state.amount||'100';\n  render();\n  if(!hasFetch){$('status').className='status warn';$('status').textContent='Open this app inside MyLLM to fetch live rates.';return;}\n  refresh(false);\n});\ndocument.addEventListener('visibilitychange',function(){if(!document.hidden&&hasFetch)refresh(false);});\n})();\n</script>\n</body></html>\n"}