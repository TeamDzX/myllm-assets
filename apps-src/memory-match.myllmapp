{"name": "Memory Match", "html": "<!doctype html>\n<!--\n  Memory Match — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,user-scalable=no,viewport-fit=cover\">\n<title>Memory Match</title>\n<style>:root{--build-id:\"d93fa440ac\";color-scheme:light dark}\n  @property --h{ syntax:'<number>'; inherits:true; initial-value:286; }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  html,body{ height:100%; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:#0b0b10; color:#fff; overflow:hidden;\n    touch-action:none; overscroll-behavior:none; -webkit-user-select:none; user-select:none; }\n  button{ font:inherit; color:inherit; }\n\n  /* The stage: a hue-tinted backdrop in two layers, dark and light, so the\n     change between them can fade. */\n  .stage{ position:fixed; inset:0; --h:286; transition:--h 1.4s ease; color:#fff; }\n  .bg{ position:absolute; inset:0; transition:opacity .6s ease; }\n  .bg.d{ background:radial-gradient(120% 90% at 20% 10%, hsl(var(--h) 70% 34%), transparent 60%),\n      radial-gradient(120% 90% at 85% 95%, hsl(calc(var(--h) + 60) 65% 26%), transparent 62%), #0b0b10; }\n  .bg.l{ opacity:0; background:radial-gradient(120% 90% at 20% 0%, hsl(var(--h) 80% 84%), transparent 60%),\n      radial-gradient(120% 90% at 85% 100%, hsl(calc(var(--h) + 60) 78% 86%), transparent 62%), #f4f4f8; }\n  .lite{ color:#15151a; } .lite .bg.l{ opacity:1; } .lite .bg.d{ opacity:0; }\n\n  .col{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center;\n    padding:calc(12px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(14px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  .top{ width:100%; max-width:560px; height:44px; display:flex; align-items:center; justify-content:space-between; flex-shrink:0; }\n  .lbl{ font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; opacity:.62; white-space:nowrap; }\n  .glass{ border:1px solid rgba(255,255,255,.16); background:rgba(255,255,255,.12); color:inherit;\n    -webkit-backdrop-filter:blur(18px); backdrop-filter:blur(18px); }\n  .lite .glass{ border-color:rgba(0,0,0,.09); background:rgba(255,255,255,.62); }\n  svg{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  .rnd{ width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:15px; flex-shrink:0; }\n  .pill{ min-width:44px; height:44px; border-radius:99px; padding:0 16px; display:flex; align-items:center; justify-content:center; gap:6px;\n    font-size:19px; font-weight:800; font-variant-numeric:tabular-nums; flex-shrink:0; }\n  .pill small{ font-size:10px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; opacity:.6; }\n  .pill.bump{ animation:bump .28s ease; }\n  @keyframes bump{ 40%{ transform:scale(1.18); } }\n  .top .hide{ visibility:hidden; }\n\n  .wrap{ flex:1; width:100%; min-height:0; position:relative; display:flex; align-items:center; justify-content:center; margin:10px 0 34px; }\n  .foot{ position:absolute; left:0; right:0; top:calc(50% + var(--bh,320px) / 2 + 12px); text-align:center; font-size:12px; font-weight:600;\n    letter-spacing:.02em; opacity:.55; font-variant-numeric:tabular-nums; white-space:nowrap; }\n\n  /* One glass card over the board: title, paused, finished. */\n  .sheet{ position:absolute; left:50%; top:50%; width:max(232px, min(300px, calc(var(--b,320px) - 44px))); transform:translate(-50%,-50%) scale(.96);\n    opacity:0; pointer-events:none; border-radius:26px; padding:22px 20px 18px; text-align:center; box-shadow:0 24px 60px rgba(0,0,0,.35); z-index:5;\n    transition:opacity .28s ease, transform .28s cubic-bezier(.2,.8,.2,1); }\n  .sheet.on{ opacity:1; transform:translate(-50%,-50%); pointer-events:auto; }\n  /* whatever sits under an open card steps back, so the card reads */\n  .under{ transition:opacity .3s, filter .3s; } .veil .under{ opacity:.28; filter:blur(2px); }\n  .lite .sheet{ box-shadow:0 22px 50px rgba(20,20,40,.18); }\n  .sheet h1{ font-size:30px; font-weight:800; letter-spacing:-.02em; }\n  .sheet p{ font-size:13.5px; line-height:1.4; opacity:.72; margin-top:6px; }\n  .kick{ font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; opacity:.62; }\n  .big{ font-size:64px; font-weight:800; line-height:1.05; letter-spacing:-.03em; font-variant-numeric:tabular-nums; margin-top:4px; }\n  .big small{ display:block; font-size:12px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.6; margin-top:2px; }\n  .best{ display:inline-block; margin-top:10px; font-size:11.5px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; opacity:.7; }\n  .best.new{ opacity:1; color:#0b0b10; background:#ffd60a; border-radius:99px; padding:5px 11px; }\n  .sheet .act{ width:100%; height:50px; border-radius:99px; margin-top:10px; font-size:16px; font-weight:750;\n    display:flex; align-items:center; justify-content:center; gap:8px; }\n  .sheet .act:first-of-type{ margin-top:18px; }\n  .sheet .act:active, .rnd:active{ transform:scale(.96); }\n  .pri{ border:none; background:#fff; color:#0b0b10; box-shadow:0 10px 30px rgba(0,0,0,.3); }\n  .lite .pri{ background:#15151a; color:#fff; box-shadow:0 10px 26px rgba(20,20,40,.22); }\n\n  @media (max-height:430px){\n    .sheet{ padding:14px 18px 14px; } .sheet h1{ font-size:24px; } .big{ font-size:42px; }\n    .sheet .act{ height:44px; margin-top:8px; } .sheet .act:first-of-type{ margin-top:12px; } .sheet p{ display:none; }\n    .wrap{ margin:6px 0 26px; }\n  }\n  @media (prefers-reduced-motion:reduce){ .pill.bump{ animation:none; } .stage{ transition:none; } }\n\n  .grid{ position:relative; z-index:1; width:var(--b,320px); height:var(--b,320px); display:grid; grid-template-columns:repeat(4,1fr); gap:calc(var(--b,320px) * .03); flex-shrink:0; perspective:900px; }\n  /* A <button> can't hold a 3D scene in WebKit, so the flip lives on an inner div. */\n  .card{ position:relative; border:none; background:none; border-radius:18%; cursor:pointer; padding:0; }\n  .card .in{ position:absolute; inset:0; border-radius:inherit; transform-style:preserve-3d; -webkit-transform-style:preserve-3d;\n    transition:transform .42s cubic-bezier(.2,.8,.2,1); }\n  .card.up .in, .card.got .in{ transform:rotateY(180deg); }\n  .card i{ position:absolute; inset:0; border-radius:inherit; display:flex; align-items:center; justify-content:center; font-style:normal;\n    backface-visibility:hidden; -webkit-backface-visibility:hidden; }\n  /* back: glass with a small hue lozenge */\n  .card .bk{ border:1px solid rgba(255,255,255,.16); background:rgba(255,255,255,.1); box-shadow:0 8px 22px rgba(0,0,0,.28); }\n  .card .bk::after{ content:\"\"; width:26%; height:26%; border-radius:30%; transform:rotate(45deg);\n    background:linear-gradient(145deg, hsl(var(--h) 85% 72%), hsl(calc(var(--h) + 40) 80% 52%)); opacity:.85; }\n  .lite .card .bk{ border-color:rgba(0,0,0,.07); background:rgba(255,255,255,.66); box-shadow:0 8px 20px rgba(20,20,40,.12); }\n  .card .ft{ transform:rotateY(180deg); background:#fff; font-size:calc(var(--b,320px) * .115); box-shadow:0 8px 22px rgba(0,0,0,.3); }\n  .lite .card .ft{ box-shadow:0 8px 20px rgba(20,20,40,.14), 0 0 0 1px rgba(0,0,0,.05); }\n  .card.got .ft{ background:linear-gradient(145deg, hsl(var(--h) 90% 88%), hsl(calc(var(--h) + 40) 85% 78%));\n    box-shadow:0 0 0 2px hsl(var(--h) 85% 70%), 0 0 26px hsl(var(--h) 90% 62% / .55); }\n  .card.cheer .in{ animation:cheer .5s ease; }\n  @keyframes cheer{ 0%,100%{ transform:rotateY(180deg) scale(1); } 45%{ transform:rotateY(180deg) scale(1.1); } }\n  .card:active{ filter:brightness(1.12); }\n  @media (prefers-reduced-motion:reduce){ .card .in{ transition:none; } .card.cheer .in{ animation:none; } }\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-play\" viewBox=\"0 0 24 24\"><path d=\"M8 5.5v13a1 1 0 0 0 1.52.85l10.4-6.5a1 1 0 0 0 0-1.7L9.52 4.65A1 1 0 0 0 8 5.5z\"/></symbol>\n  <symbol id=\"i-pause\" viewBox=\"0 0 24 24\"><rect x=\"6\" y=\"5\" width=\"4.2\" height=\"14\" rx=\"1.4\"/><rect x=\"13.8\" y=\"5\" width=\"4.2\" height=\"14\" rx=\"1.4\"/></symbol>\n  <symbol id=\"i-again\" viewBox=\"0 0 24 24\"><path d=\"M12 5V2.6a.6.6 0 0 0-1-.45L7.2 5.55a.6.6 0 0 0 0 .9L11 9.85a.6.6 0 0 0 1-.45V7a5.5 5.5 0 1 1-5.5 5.5 1 1 0 0 0-2 0A7.5 7.5 0 1 0 12 5z\"/></symbol>\n  <symbol id=\"i-close\" viewBox=\"0 0 24 24\"><path d=\"M6.4 5a1 1 0 0 0-1.4 1.4L10.6 12 5 17.6A1 1 0 0 0 6.4 19l5.6-5.6 5.6 5.6a1 1 0 0 0 1.4-1.4L13.4 12 19 6.4A1 1 0 0 0 17.6 5L12 10.6z\"/></symbol>\n</defs></svg>\n<div class=\"stage\" id=\"stage\">\n  <div class=\"bg d\"></div><div class=\"bg l\"></div>\n  <div class=\"col\">\n    <div class=\"top\">\n      <button class=\"glass rnd hide\" id=\"bHome\" aria-label=\"Close\"><svg><use href=\"#i-close\"/></svg></button>\n      <div class=\"lbl\">Memory Match</div>\n      <div class=\"glass pill hide\" id=\"pill\" aria-label=\"Moves\"><span id=\"mv\">0</span><small>moves</small></div>\n    </div>\n    <div class=\"wrap\" id=\"wrap\">\n      <div class=\"grid under\" id=\"grid\"></div>\n      <div class=\"sheet glass\" id=\"sheet\"></div>\n      <div class=\"foot\" id=\"foot\"></div>\n    </div>\n  </div>\n</div>\n<script>\nfunction el(i){ return document.getElementById(i); }\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction haptic(s){ if (window.myllmHaptic) try { myllmHaptic(s); } catch(_){} }\nfunction load(k){ var s = window.myllmStorage; return s ? s.getItem(k).catch(function(){ return null; }) : Promise.resolve(null); }\nfunction keep(k, v){ var s = window.myllmStorage; if (s) try { s.setItem(k, v).catch(function(){}); } catch(_){} }\nvar calm = window.matchMedia && matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n\n/* ---------- look ---------- */\nfunction isLight(){ return !(window.matchMedia && matchMedia(\"(prefers-color-scheme: dark)\").matches); }\n/* A game in progress takes the whole display and goes dark. Where MyLLM can't\n   hide its own title bar, a dark stage under a white bar looks cut in half —\n   so in light mode, without myllmImmersive, the stage stays light. */\nfunction syncLook(){\n  el(\"stage\").classList.toggle(\"lite\", isLight() && !(state !== \"home\" && window.myllmImmersive));\n  if (typeof onLook === \"function\") onLook();\n}\nfunction syncChrome(){\n  if (!window.myllmImmersive) return;\n  try { myllmImmersive(state !== \"home\", {keepAwake:false}).catch(function(){}); } catch(_){}\n}\nfunction setHue(h){ el(\"stage\").style.setProperty(\"--h\", String(h)); }\nfunction showSheet(html, acts){\n  var s = el(\"sheet\"); s.innerHTML = html;\n  Object.keys(acts).forEach(function(id){ var b = el(id); if (b) b.onclick = acts[id]; });\n  s.classList.add(\"on\"); el(\"stage\").classList.add(\"veil\");\n}\nfunction hideSheet(){ el(\"sheet\").classList.remove(\"on\"); el(\"stage\").classList.remove(\"veil\"); }\nfunction bump(id){ var p = el(id); p.classList.remove(\"bump\"); void p.offsetWidth; p.classList.add(\"bump\"); }\ndocument.addEventListener(\"visibilitychange\", function(){\n  if (document.hidden){ if (typeof onHide === \"function\") onHide(); return; }\n  if (state !== \"home\") syncChrome();          /* MyLLM puts its bars back when the app is left */\n});\nif (window.matchMedia){\n  var mq = matchMedia(\"(prefers-color-scheme: dark)\");\n  if (mq.addEventListener) mq.addEventListener(\"change\", syncLook); else if (mq.addListener) mq.addListener(syncLook);\n}\n\nvar state = \"home\";                 /* home · play · done */\nvar EMOJI = ['🍎','🚀','🐙','🌵','🎲','🔑','🐝','🌙'];\nvar deck = [], up = [], moves = 0, found = 0, best = null, newBest = false, lock = false, live = false;\nvar t0 = 0, held = 0, ticker = 0;   /* the clock is for show: the record is still fewest moves */\n\nfunction clock(ms){ var s = Math.floor(ms / 1000), m = Math.floor(s / 60); s %= 60; return m + \":\" + (s < 10 ? \"0\" : \"\") + s; }\nfunction elapsed(){ return held + (state === \"play\" ? performance.now() - t0 : 0); }\n\n/* ---------- the glass card ---------- */\nfunction bestLine(){\n  if (newBest) return '<div class=\"best new\">New best</div>';\n  return best ? '<div class=\"best\">Best ' + best + ' moves</div>' : \"\";\n}\nfunction card(kind){\n  var h;\n  if (kind === \"home\") h = '<h1>Memory Match</h1><p>Flip two tiles at a time and find all eight pairs in as few moves as you can.</p>' + bestLine() +\n    (live ? '<button class=\"act pri\" id=\"sA\"><svg><use href=\"#i-play\"/></svg>Resume</button><button class=\"act glass\" id=\"sB\">New game</button>'\n          : '<button class=\"act pri\" id=\"sB\"><svg><use href=\"#i-play\"/></svg>Play</button>');\n  else h = '<div class=\"kick\">Solved in ' + clock(held) + '</div><div class=\"big\">' + moves + '<small>moves</small></div>' + bestLine() +\n    '<button class=\"act pri\" id=\"sB\"><svg><use href=\"#i-again\"/></svg>Play again</button><button class=\"act glass\" id=\"sC\">Done</button>';\n  showSheet(h, {sA:resume, sB:begin, sC:goHome});\n}\nfunction hud(){\n  el(\"bHome\").classList.toggle(\"hide\", state !== \"play\");\n  el(\"pill\").classList.toggle(\"hide\", state === \"home\");\n  el(\"mv\").textContent = moves;\n  el(\"foot\").textContent = state === \"home\" ? \"\" : clock(elapsed()) + \" · \" + found + \" of 8 pairs\" + (best ? \" · best \" + best : \"\");\n}\n\n/* ---------- game (rules unchanged) ---------- */\nfunction deal(){\n  deck = EMOJI.concat(EMOJI).sort(function(){ return Math.random() - .5; });\n  up = []; moves = 0; found = 0; lock = false;\n  var g = el(\"grid\"); g.innerHTML = \"\";\n  deck.forEach(function(e, i){\n    var b = document.createElement(\"button\"); b.className = \"card\"; b.setAttribute(\"aria-label\", \"Tile \" + (i + 1));\n    b.innerHTML = '<span class=\"in\"><i class=\"bk\"></i><i class=\"ft\">' + e + '</i></span>';\n    b.onclick = function(){ flip(i, b); }; g.appendChild(b);\n  });\n}\nfunction flip(i, b){\n  if (state !== \"play\" || lock || b.classList.contains(\"up\") || b.classList.contains(\"got\")) return;\n  b.classList.add(\"up\"); up.push({i:i, b:b}); haptic(\"selection\");\n  if (up.length === 2){\n    moves++; hud(); bump(\"pill\"); lock = true;\n    setTimeout(function(){\n      var a = up[0], c = up[1];\n      if (deck[a.i] === deck[c.i]){\n        a.b.classList.add(\"got\"); c.b.classList.add(\"got\"); found++; haptic(\"light\");\n        if (!calm){ a.b.classList.add(\"cheer\"); c.b.classList.add(\"cheer\"); }\n        setHue(286 + found * 9);\n        if (found === 8) solved();\n      }\n      a.b.classList.remove(\"up\"); c.b.classList.remove(\"up\"); up = []; lock = false; hud();\n    }, 650);\n  }\n}\nfunction solved(){\n  held = elapsed(); state = \"done\"; live = false; clearInterval(ticker);\n  if (!best || moves < best){ best = moves; newBest = true; keep(\"best\", String(best)); }\n  haptic(\"success\");\n  setTimeout(function(){ if (state === \"done\"){ card(\"done\"); hud(); } }, 700);\n}\nfunction begin(){\n  haptic(\"medium\");\n  deal(); newBest = false; live = true; state = \"play\"; held = 0; t0 = performance.now(); setHue(286);\n  clearInterval(ticker); ticker = setInterval(hud, 1000);\n  hideSheet(); hud(); syncLook(); syncChrome();\n}\nfunction resume(){\n  haptic(\"light\"); state = \"play\"; t0 = performance.now();\n  clearInterval(ticker); ticker = setInterval(hud, 1000);\n  hideSheet(); hud(); syncLook(); syncChrome();\n}\nfunction goHome(){\n  haptic(\"light\");\n  if (state === \"play\") held = elapsed();\n  clearInterval(ticker); state = \"home\";\n  if (!live){ newBest = false; deal(); setHue(286); }\n  card(\"home\"); hud(); syncLook(); syncChrome();\n}\nfunction onHide(){ if (state === \"play\") goHome(); }     /* the clock doesn't run while you're away */\n\nfunction fit(){\n  var w = el(\"wrap\"), B = Math.max(180, Math.floor(Math.min(w.clientWidth, w.clientHeight, 520)));\n  var st = el(\"stage\").style; st.setProperty(\"--b\", B + \"px\"); st.setProperty(\"--bh\", B + \"px\");\n}\nel(\"bHome\").onclick = goHome;\ndocument.addEventListener(\"keydown\", function(e){\n  if (e.key === \"Escape\" && state === \"play\") goHome();\n  else if (e.key === \"Enter\" && state !== \"play\") (live ? resume : begin)();\n});\nwindow.addEventListener(\"resize\", fit);\n\n/* ---------- boot ---------- */\nfit(); deal(); syncLook(); card(\"home\"); hud();\nload(\"best\").then(function(v){\n  if (v){ best = parseInt(v, 10) || null; if (state === \"home\") card(\"home\"); hud(); }\n});\n</script></body></html>\n", "kind": "html", "iconSymbol": "gamecontroller", "iconColor": "purple"}