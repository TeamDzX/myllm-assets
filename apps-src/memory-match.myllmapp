{"name": "Memory Match", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>:root{color-scheme:light dark}\nbody{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:18px;background:#f2f2f7;color:#111;text-align:center}\n@media(prefers-color-scheme:dark){body{background:#000;color:#eee}.tile{background:#1c1c1e}}\nh1{font-size:22px;margin:4px 0 2px}\n#stats{font-size:14px;opacity:.65;margin-bottom:14px;min-height:18px}\n#grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;max-width:340px;margin:0 auto}\n.tile{aspect-ratio:1;border-radius:12px;background:#fff;border:0;font-size:30px;box-shadow:0 1px 3px rgba(0,0,0,.12)}\n.tile span{opacity:0}\n.tile.up span,.tile.got span{opacity:1}\n.tile.got{background:#bf5af2;box-shadow:none}\nbutton.new{margin-top:16px;border:0;border-radius:10px;padding:11px 26px;font-size:15px;font-weight:600;background:#bf5af2;color:#fff}\n@media(min-width:768px){#grid{max-width:480px;gap:12px}.tile{font-size:42px}h1{font-size:28px}}\n</style></head><body>\n<h1>🃏 Memory Match</h1>\n<div id=\"stats\"></div>\n<div id=\"grid\"></div>\n<button class=\"new\" onclick=\"deal()\">New game</button>\n<script>\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar EMOJI=['🍎','🚀','🐙','🌵','🎲','🔑','🐝','🌙'];\nvar deck=[],up=[],moves=0,found=0,best=null,lock=false;\nfunction deal(){deck=EMOJI.concat(EMOJI).sort(function(){return Math.random()-.5});\nup=[];moves=0;found=0;lock=false;var g=document.getElementById('grid');g.innerHTML='';\ndeck.forEach(function(e,i){var b=document.createElement('button');b.className='tile';\nb.innerHTML='<span>'+e+'</span>';b.onclick=function(){flip(i,b)};g.appendChild(b)});stats()}\nfunction stats(){document.getElementById('stats').textContent='Moves: '+moves+(best?' · Best: '+best:'')}\nfunction flip(i,b){if(lock||b.classList.contains('up')||b.classList.contains('got'))return;\nb.classList.add('up');up.push({i:i,b:b});\nif(up.length===2){moves++;stats();lock=true;\nsetTimeout(function(){var a=up[0],c=up[1];\nif(deck[a.i]===deck[c.i]){a.b.classList.add('got');c.b.classList.add('got');found++;\nif(found===8){if(!best||moves<best){best=moves;store.setItem('best',String(best))}\ndocument.getElementById('stats').textContent='🎉 Solved in '+moves+' moves'+(best===moves?' — new best!':' · Best: '+best)}}\na.b.classList.remove('up');c.b.classList.remove('up');up=[];lock=false},650)}}\nstore.getItem('best').then(function(v){if(v)best=parseInt(v,10)||null;deal()});\n</script></body></html>", "kind": "html", "iconSymbol": "gamecontroller", "iconColor": "purple"}