{"name": "Space Range", "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover\">\n<title>Space Range</title>\n<style>\n*{box-sizing:border-box;margin:0;-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none}\nhtml,body{height:100%;overflow:hidden;background:#05060d;font-family:-apple-system,system-ui,\"Segoe UI\",sans-serif;color:#eaf2ff}\n#v{position:fixed;inset:0;width:100%;height:100%;display:block;touch-action:none}\n.hud{position:fixed;inset:0;pointer-events:none;z-index:5}\n.hud .tl{position:absolute;top:calc(12px + env(safe-area-inset-top));left:16px}\n.hud .tr{position:absolute;top:calc(12px + env(safe-area-inset-top));right:16px;text-align:right}\n.score{font-size:30px;font-weight:800;letter-spacing:.02em;text-shadow:0 0 14px rgba(80,200,255,.7)}\n.slabel{font-size:10px;letter-spacing:.22em;color:#7fb6ff;text-transform:uppercase;opacity:.8}\n.wave{font-size:15px;font-weight:700;color:#9fe0ff}\n.combo{position:absolute;top:calc(56px + env(safe-area-inset-top));left:16px;font-size:15px;font-weight:800;color:#ffd23f;text-shadow:0 0 12px rgba(255,210,63,.7);opacity:0;transition:opacity .2s}\n.combo.on{opacity:1}\n.hpwrap{position:absolute;left:16px;right:16px;bottom:calc(14px + env(safe-area-inset-bottom));height:9px;border-radius:6px;background:rgba(255,255,255,.1);overflow:hidden;border:1px solid rgba(120,180,255,.25)}\n.hp{height:100%;width:100%;background:linear-gradient(90deg,#ff3b6b,#ff8a3d);transition:width .18s}\n.wbadge{position:absolute;left:50%;top:calc(12px + env(safe-area-inset-top));transform:translateX(-50%);display:flex;align-items:center;gap:9px;background:rgba(10,16,30,.74);border:1px solid rgba(120,220,255,.32);border-radius:14px;padding:5px 15px 5px 8px;box-shadow:0 0 20px rgba(80,200,255,.22)}\n#wimg{width:60px;height:30px;object-fit:contain;display:block;filter:drop-shadow(0 0 6px rgba(120,220,255,.85))}\n.wname{font-size:12.5px;font-weight:800;letter-spacing:.1em;color:#8affdc;text-transform:uppercase;text-shadow:0 0 12px rgba(80,255,200,.6)}\n.rage{position:absolute;left:50%;bottom:calc(28px + env(safe-area-inset-bottom));transform:translateX(-50%);width:170px;height:6px;border-radius:5px;background:rgba(255,255,255,.1);overflow:hidden;border:1px solid rgba(255,90,160,.3)}\n.ragef{height:100%;width:0;background:linear-gradient(90deg,#ff3b6b,#ffd23f)}\n.rage.full .ragef{animation:ragepulse .6s infinite}\n@keyframes ragepulse{50%{filter:brightness(1.6)}}\n.mute{position:absolute;top:calc(52px + env(safe-area-inset-top));right:16px;pointer-events:auto;font-size:18px;opacity:.6;background:none;border:0;color:#cfe4ff;cursor:pointer}\n.banner{position:absolute;top:34%;left:0;right:0;text-align:center;font-size:26px;font-weight:900;letter-spacing:.08em;color:#fff;text-shadow:0 0 22px rgba(120,220,255,.9);opacity:0;transform:scale(.8)}\n.banner.show{animation:bann 1.3s ease}\n@keyframes bann{10%{opacity:1;transform:scale(1.06)}80%{opacity:1;transform:scale(1)}100%{opacity:0}}\n.overlay{position:fixed;inset:0;z-index:10;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;\n  background:radial-gradient(120% 90% at 50% 20%,rgba(20,26,54,.6),rgba(5,6,13,.94));padding:24px}\n.overlay.hide{display:none}\n.title{font-size:44px;font-weight:900;letter-spacing:.04em;line-height:1;\n  background:linear-gradient(180deg,#8affdc,#4aa3ff);-webkit-background-clip:text;background-clip:text;color:transparent;\n  filter:drop-shadow(0 0 24px rgba(74,163,255,.6))}\n.subtitle{color:#9fb8e6;font-size:14px;margin-top:12px;max-width:300px;line-height:1.55}\n.big{margin-top:26px;pointer-events:auto;border:0;border-radius:16px;padding:16px 40px;font-size:18px;font-weight:800;letter-spacing:.04em;color:#04121a;\n  background:linear-gradient(135deg,#8affdc,#4aa3ff);box-shadow:0 10px 30px -6px rgba(74,163,255,.6);cursor:pointer}\n.big:active{transform:scale(.97)}\n.best{margin-top:18px;color:#ffd23f;font-weight:700;font-size:15px}\n.gover .title{background:linear-gradient(180deg,#ff8a3d,#ff3b6b);-webkit-background-clip:text;background-clip:text}\n.tiny{color:#6f86b8;font-size:11.5px;margin-top:22px;letter-spacing:.03em}\n</style></head><body>\n<canvas id=\"v\"></canvas>\n<div class=\"hud\">\n  <div class=\"tl\"><div class=\"slabel\">Score</div><div class=\"score\" id=\"score\">0</div></div>\n  <div class=\"tr\"><div class=\"slabel\">Wave</div><div class=\"wave\" id=\"wave\">1</div></div>\n  <div class=\"combo\" id=\"combo\"></div>\n  <button class=\"mute\" id=\"mute\" aria-label=\"Sound\">🔊</button>\n  <div class=\"rage\" id=\"rage\"><div class=\"ragef\" id=\"ragef\"></div></div>\n  <div class=\"wbadge\"><img id=\"wimg\" alt=\"\"><span class=\"wname\" id=\"wpn\">Blaster</span></div>\n  <div class=\"hpwrap\"><div class=\"hp\" id=\"hp\"></div></div>\n  <div class=\"banner\" id=\"banner\"></div>\n</div>\n\n<div class=\"overlay\" id=\"start\">\n  <div class=\"title\">SPACE<br>RANGE</div>\n  <div class=\"subtitle\">Bots are storming the training basement. <b>Tap them to blast them.</b> Chain hits to build rage — and unlock ludicrous guns.</div>\n  <button class=\"big\" id=\"startBtn\">Enter the range</button>\n  <div class=\"best\" id=\"startBest\"></div>\n  <div class=\"tiny\">A MyLLMos mini-game · everything runs on your device</div>\n</div>\n\n<div class=\"overlay gover hide\" id=\"over\">\n  <div class=\"title\">SCRAPPED</div>\n  <div class=\"subtitle\" id=\"overStats\"></div>\n  <button class=\"big\" id=\"againBtn\">Run it back</button>\n  <div class=\"best\" id=\"overBest\"></div>\n</div>\n\n<script>\n\"use strict\";\n/* ============================== setup ============================== */\nvar cv=document.getElementById('v'),ctx=cv.getContext('2d');\nvar CW=0,CH=0,DPR=1,aspect=1;\nfunction resize(){\n  DPR=Math.min(window.devicePixelRatio||1,2);\n  CW=Math.floor(innerWidth*DPR);CH=Math.floor(innerHeight*DPR);\n  cv.width=CW;cv.height=CH;cv.style.width=innerWidth+'px';cv.style.height=innerHeight+'px';\n  aspect=CW/CH;\n}\nresize();addEventListener('resize',resize);\nfunction el(i){return document.getElementById(i)}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\n\n/* ============================== math ============================== */\nvar FOV=70*Math.PI/180;\nvar cam={x:0,y:1.55,z:0,yaw:0,pitch:-0.06,shx:0,shy:0,shz:0,recoil:0};\nfunction toView(px,py,pz){\n  var dx=px-cam.x,dy=py-cam.y,dz=pz-cam.z;\n  var y=(-cam.yaw)-0; // yaw\n  var cy=Math.cos(cam.yaw),sy=Math.sin(cam.yaw);\n  var x1=dx*cy - dz*sy;\n  var z1=dx*sy + dz*cy;\n  var y1=dy;\n  var cp=Math.cos(cam.pitch),sp=Math.sin(cam.pitch);\n  var y2=y1*cp - z1*sp;\n  var z2=y1*sp + z1*cp;\n  return [x1,y2,z2];\n}\nfunction proj(vx,vy,vz){\n  if(vz<=0.12)return null;\n  var f=1/Math.tan(FOV/2);\n  var ndx=(vx*f/aspect)/vz, ndy=(vy*f)/vz;\n  return [(ndx*0.5+0.5)*CW,(0.5-ndy*0.5)*CH,vz];\n}\nfunction projPt(p){var v=toView(p[0],p[1],p[2]);return proj(v[0],v[1],v[2])}\n\n/* ============================== room grid ============================== */\nvar ROOMZ=42,ROOMX=8,ROOMY=4.4;\nfunction line3(a,b,col,w,glow){\n  var pa=projPt(a),pb=projPt(b);if(!pa||!pb)return;\n  ctx.strokeStyle=col;ctx.lineWidth=w||1;\n  if(glow){ctx.shadowColor=col;ctx.shadowBlur=glow}\n  ctx.beginPath();ctx.moveTo(pa[0],pa[1]);ctx.lineTo(pb[0],pb[1]);ctx.stroke();\n  ctx.shadowBlur=0;\n}\n// ---- wall/floor textures (ComfyUI) ----\nvar texBG=new Image();texBG.src=\"data:image/jpeg;base64,\";\nfunction texReady(){return texBG.complete&&texBG.naturalWidth>0;}\n// map a texture triangle onto a screen triangle (affine); clip so it stays inside\nfunction texTri(img,x0,y0,x1,y1,x2,y2,u0,v0,u1,v1,u2,v2){\n  ctx.save();\n  ctx.beginPath();ctx.moveTo(x0,y0);ctx.lineTo(x1,y1);ctx.lineTo(x2,y2);ctx.closePath();ctx.clip();\n  var du1=u1-u0,dv1=v1-v0,du2=u2-u0,dv2=v2-v0,dx1=x1-x0,dy1=y1-y0,dx2=x2-x0,dy2=y2-y0;\n  var det=du1*dv2-du2*dv1;\n  if(Math.abs(det)>1e-6){\n    var a=(dx1*dv2-dx2*dv1)/det,c=(du1*dx2-du2*dx1)/det,b=(dy1*dv2-dy2*dv1)/det,d=(du1*dy2-du2*dy1)/det;\n    var e=x0-a*u0-c*v0+cam.shx, f=y0-b*u0-d*v0+cam.shy;\n    ctx.setTransform(a,b,c,d,e,f);ctx.drawImage(img,0,0);\n  }\n  ctx.restore();\n}\n// textured quad (world corners c0..c3 wound consistently) with a depth-shade overlay\nfunction texQuad(img,c0,c1,c2,c3,rx,ry,shade){\n  var p0=projPt(c0),p1=projPt(c1),p2=projPt(c2),p3=projPt(c3);\n  if(!p0||!p1||!p2||!p3)return;\n  var U=img.naturalWidth*rx, V=img.naturalHeight*ry;\n  texTri(img,p0[0],p0[1],p1[0],p1[1],p2[0],p2[1], 0,V,U,V,U,0);\n  texTri(img,p0[0],p0[1],p2[0],p2[1],p3[0],p3[1], 0,V,U,0,0,0);\n  if(shade>0){ctx.fillStyle='rgba(3,7,17,'+shade+')';ctx.beginPath();ctx.moveTo(p0[0],p0[1]);ctx.lineTo(p1[0],p1[1]);ctx.lineTo(p2[0],p2[1]);ctx.lineTo(p3[0],p3[1]);ctx.closePath();ctx.fill();}\n}\nfunction drawRoom(){\n  // background gradient\n  var g=ctx.createLinearGradient(0,0,0,CH);\n  g.addColorStop(0,'#0a1024');g.addColorStop(.5,'#070a16');g.addColorStop(1,'#03040b');\n  ctx.fillStyle=g;ctx.fillRect(-40,-40,CW+80,CH+80);\n  // textured walls (far bands first so nearer ones overdraw), depth-shaded\n  if(texReady()){\n    // baked-perspective corridor backdrop, anchored to the scene's vanishing point\n    var vp=projPt([0,cam.y,100000])||[CW*0.5,CH*0.42];\n    var iw=texBG.naturalWidth,ih=texBG.naturalHeight;\n    var sc=Math.max(CW/iw,CH/ih)*1.14, dw=iw*sc, dh=ih*sc;\n    ctx.drawImage(texBG, vp[0]-dw*0.5, vp[1]-dh*0.5, dw, dh);\n    // ground it: darken toward the bottom so the grid and bots pop\n    var fg=ctx.createLinearGradient(0,vp[1],0,CH);\n    fg.addColorStop(0,'rgba(3,6,14,0)');fg.addColorStop(1,'rgba(3,6,14,0.72)');\n    ctx.fillStyle=fg;ctx.fillRect(-40,vp[1],CW+80,CH-vp[1]+40);\n  }\n  // floor infill: translucent gradient + alternating depth bands (cheap fills,\n  // no texture transforms) so the mesh reads as panels without costing frames\n  var f0=projPt([-ROOMX,0,2]),f1=projPt([ROOMX,0,2]),f2p=projPt([ROOMX,0,ROOMZ]),f3=projPt([-ROOMX,0,ROOMZ]);\n  if(f0&&f1&&f2p&&f3){\n    var gg=ctx.createLinearGradient(0,f2p[1],0,f0[1]);\n    gg.addColorStop(0,'rgb(10,24,52)');gg.addColorStop(0.55,'rgb(22,56,108)');gg.addColorStop(1,'rgb(50,118,208)');\n    ctx.fillStyle=gg;ctx.beginPath();ctx.moveTo(f0[0],f0[1]);ctx.lineTo(f1[0],f1[1]);ctx.lineTo(f2p[0],f2p[1]);ctx.lineTo(f3[0],f3[1]);ctx.closePath();ctx.fill();\n    for(var zb2=2;zb2<ROOMZ;zb2+=4){\n      var a0=projPt([-ROOMX,0,zb2]),a1=projPt([ROOMX,0,zb2]),b1=projPt([ROOMX,0,Math.min(ROOMZ,zb2+2)]),b0=projPt([-ROOMX,0,Math.min(ROOMZ,zb2+2)]);\n      if(!a0||!a1||!b0||!b1)continue;\n      ctx.fillStyle='rgba(120,200,255,'+(0.10*(1-zb2/ROOMZ)+0.02).toFixed(3)+')';\n      ctx.beginPath();ctx.moveTo(a0[0],a0[1]);ctx.lineTo(a1[0],a1[1]);ctx.lineTo(b1[0],b1[1]);ctx.lineTo(b0[0],b0[1]);ctx.closePath();ctx.fill();\n    }\n  }\n  var fz=Math.floor(cam.z/2)*2;\n  // floor grid\n  for(var z=2;z<=ROOMZ;z+=2){line3([-ROOMX,0,z],[ROOMX,0,z],'rgba(60,150,255,'+(0.44*(1-z/ROOMZ)+0.10).toFixed(3)+')',1*DPR, z<10?7:0);}\n  for(var x=-ROOMX;x<=ROOMX;x+=2){line3([x,0,2],[x,0,ROOMZ],'rgba(60,150,255,0.26)',1*DPR,0);}\n  // ceiling faint\n  var ccol='rgba(90,120,220,0.18)';\n  for(var z2=6;z2<=ROOMZ;z2+=4){line3([-ROOMX,ROOMY,z2],[ROOMX,ROOMY,z2],ccol,1*DPR,0);}\n  // side wall verticals + trim\n  var wcol='rgba(80,200,255,0.32)';\n  for(var z3=2;z3<=ROOMZ;z3+=4){\n    line3([-ROOMX,0,z3],[-ROOMX,ROOMY,z3],wcol,1*DPR,0);\n    line3([ROOMX,0,z3],[ROOMX,ROOMY,z3],wcol,1*DPR,0);\n  }\n  line3([-ROOMX,0.05,2],[-ROOMX,0.05,ROOMZ],'rgba(120,230,255,0.6)',1.5*DPR,6);\n  line3([ROOMX,0.05,2],[ROOMX,0.05,ROOMZ],'rgba(120,230,255,0.6)',1.5*DPR,6);\n  // back wall frame\n  var bcol='rgba(90,210,255,0.4)';\n  line3([-ROOMX,0,ROOMZ],[ROOMX,0,ROOMZ],bcol,2*DPR,8);\n  line3([-ROOMX,ROOMY,ROOMZ],[ROOMX,ROOMY,ROOMZ],bcol,1.5*DPR,4);\n  line3([-ROOMX,0,ROOMZ],[-ROOMX,ROOMY,ROOMZ],bcol,1.5*DPR,4);\n  line3([ROOMX,0,ROOMZ],[ROOMX,ROOMY,ROOMZ],bcol,1.5*DPR,4);\n}\n\n/* ============================== robot mesh ============================== */\n// a box: cx,cy,cz center, w,h,d half? we use full sizes; returns 6 quads (world verts)\nfunction boxFaces(x,y,z,w,h,d){ // x,y,z = min corner; w,h,d sizes\n  var x2=x+w,y2=y+h,z2=z+d;\n  var p=[[x,y,z],[x2,y,z],[x2,y2,z],[x,y2,z],[x,y,z2],[x2,y,z2],[x2,y2,z2],[x,y2,z2]];\n  return [\n    [p[0],p[1],p[2],p[3],[0,0,-1]], // front (-z, toward player)\n    [p[5],p[4],p[7],p[6],[0,0,1]],  // back\n    [p[4],p[0],p[3],p[7],[-1,0,0]], // left\n    [p[1],p[5],p[6],p[2],[1,0,0]],  // right\n    [p[3],p[2],p[6],p[7],[0,1,0]],  // top\n    [p[4],p[5],p[1],p[0],[0,-1,0]]  // bottom\n  ];\n}\nvar LIGHT=(function(){var l=[-0.4,0.8,-0.45],m=Math.hypot(l[0],l[1],l[2]);return[l[0]/m,l[1]/m,l[2]/m]})();\nfunction shade(base,n){\n  var d=Math.max(0,n[0]*LIGHT[0]+n[1]*LIGHT[1]+n[2]*LIGHT[2]);\n  var b=0.34+0.66*d;\n  return 'rgb('+Math.round(base[0]*b)+','+Math.round(base[1]*b)+','+Math.round(base[2]*b)+')';\n}\n\nvar ROBOCOLS=[[120,150,190],[150,120,200],[120,190,160],[200,150,120]];\nfunction buildRobotFaces(r){\n  if(r.kind==='crawler')return buildCrawler(r);\n  if(r.kind==='drone')return buildDrone(r);\n  return buildHumanoid(r);\n}\n// low, wide, many-legged creepy crawler that scuttles along the floor\nfunction buildCrawler(r){\n  var s=r.scale,ox=r.x,oz=r.z,faces=[],body=r.body,ac=r.hurt>0?[255,90,90]:r.accent;\n  function add(bx){for(var i=0;i<bx.length;i++){var f=bx[i];faces.push({v:[f[0],f[1],f[2],f[3]],n:f[4],c:body,glow:0})}}\n  add(boxFaces(ox-0.56*s,0.16*s,oz-0.44*s,1.12*s,0.34*s,0.88*s)); // carapace\n  add(boxFaces(ox-0.28*s,0.30*s,oz-0.64*s,0.56*s,0.26*s,0.28*s)); // head\n  var lb=Math.sin(r.bob)*0.06*s;\n  for(var i=0;i<3;i++){var lz=oz-0.32*s+i*0.32*s,ly=(i%2?lb:-lb);\n    add(boxFaces(ox-0.76*s,0.0,lz+ly,0.2*s,0.36*s,0.09*s));\n    add(boxFaces(ox+0.56*s,0.0,lz-ly,0.2*s,0.36*s,0.09*s));\n  }\n  var ez=oz-0.64*s-0.01,ey=0.40*s;\n  faces.push({v:[[ox-0.17*s,ey,ez],[ox-0.04*s,ey,ez],[ox-0.04*s,ey+0.1*s,ez],[ox-0.17*s,ey+0.1*s,ez]],n:[0,0,-1],c:ac,glow:12,flat:1});\n  faces.push({v:[[ox+0.04*s,ey,ez],[ox+0.17*s,ey,ez],[ox+0.17*s,ey+0.1*s,ez],[ox+0.04*s,ey+0.1*s,ez]],n:[0,0,-1],c:ac,glow:12,flat:1});\n  faces.push({v:[[ox-0.14*s,0.5*s,oz-0.12*s],[ox+0.14*s,0.5*s,oz-0.12*s],[ox+0.14*s,0.5*s,oz+0.16*s],[ox-0.14*s,0.5*s,oz+0.16*s]],n:[0,1,0],c:r.accent,glow:14,flat:1,core:1});\n  return faces;\n}\n// floating single-eye drone\nfunction buildDrone(r){\n  var s=r.scale,ox=r.x,oz=r.z,faces=[],body=r.body,ac=r.hurt>0?[255,90,90]:r.accent;\n  function add(bx){for(var i=0;i<bx.length;i++){var f=bx[i];faces.push({v:[f[0],f[1],f[2],f[3]],n:f[4],c:body,glow:0})}}\n  var cy=1.5*s+Math.sin(r.bob)*0.05;\n  add(boxFaces(ox-0.32*s,cy,oz-0.3*s,0.64*s,0.42*s,0.6*s));\n  // wing fins\n  add(boxFaces(ox-0.6*s,cy+0.12*s,oz-0.08*s,0.28*s,0.08*s,0.16*s));\n  add(boxFaces(ox+0.32*s,cy+0.12*s,oz-0.08*s,0.28*s,0.08*s,0.16*s));\n  var fz=oz-0.3*s-0.01;\n  faces.push({v:[[ox-0.18*s,cy+0.09*s,fz],[ox+0.18*s,cy+0.09*s,fz],[ox+0.18*s,cy+0.3*s,fz],[ox-0.18*s,cy+0.3*s,fz]],n:[0,0,-1],c:r.accent,glow:16,flat:1,core:1});\n  return faces;\n}\nfunction buildHumanoid(r){\n  // local origin at feet; sizes scaled by r.scale; positioned at r.x,0,r.z\n  var s=r.scale, ox=r.x, oz=r.z;\n  var faces=[];\n  var body=r.body; // [rr,gg,bb]\n  function add(bx){for(var i=0;i<bx.length;i++){var f=bx[i];faces.push({v:[f[0],f[1],f[2],f[3]],n:f[4],c:body,glow:0})}}\n  // legs (one block)\n  add(boxFaces(ox-0.34*s,0.0,oz-0.22*s,0.68*s,0.86*s,0.44*s));\n  // torso\n  add(boxFaces(ox-0.5*s,0.86*s,oz-0.3*s,1.0*s,0.72*s,0.6*s));\n  // head\n  add(boxFaces(ox-0.32*s,1.58*s,oz-0.24*s,0.64*s,0.5*s,0.48*s));\n  // accent eyes (front face, glowing) — small quads slightly in front\n  var ez=oz-0.3*s-0.01, ey=1.72*s;\n  var ac=r.hurt>0?[255,90,90]:r.accent;\n  faces.push({v:[[ox-0.2*s,ey,ez],[ox-0.05*s,ey,ez],[ox-0.05*s,ey+0.12*s,ez],[ox-0.2*s,ey+0.12*s,ez]],n:[0,0,-1],c:ac,glow:12,flat:1});\n  faces.push({v:[[ox+0.05*s,ey,ez],[ox+0.2*s,ey,ez],[ox+0.2*s,ey+0.12*s,ez],[ox+0.05*s,ey+0.12*s,ez]],n:[0,0,-1],c:ac,glow:12,flat:1});\n  // core (weak point) on torso front\n  var cz=oz-0.3*s-0.01,cy=1.16*s;\n  faces.push({v:[[ox-0.16*s,cy,cz],[ox+0.16*s,cy,cz],[ox+0.16*s,cy+0.3*s,cz],[ox-0.16*s,cy+0.3*s,cz]],n:[0,0,-1],c:r.accent,glow:14,flat:1,core:1});\n  return faces;\n}\n\n/* ============================== game state ============================== */\nvar robots=[],shards=[],tracers=[],flashes=[],dmgnums=[],running=false,paused=false;\nvar pods=[],podT=8;   // supply pods drifting in — shoot to collect\nvar score=0,best=0,wave=0,hp=100,combo=0,comboTimer=0,rage=0,rageActive=0,spawnT=0,toSpawn=0,waveGap=0;\nvar lastPointer={x:innerWidth/2,y:innerHeight/2,active:false};\n\nvar WEAPONS=[\n  {name:'Blaster',fire:220,dmg:34,col:'#8affdc',shake:5,pierce:0,spread:0,aoe:0,unlock:0},\n  {name:'Auto-SMG',fire:90,dmg:20,col:'#7fdfff',shake:4,pierce:0,spread:0,aoe:0,unlock:900},\n  {name:'Scatter',fire:340,dmg:26,col:'#ffd23f',shake:9,pierce:0,spread:3,aoe:0,unlock:2600},\n  {name:'Rail-Lance',fire:520,dmg:120,col:'#ff6bff',shake:12,pierce:9,spread:0,aoe:0,unlock:5200},\n  {name:'Boom-Cannon',fire:600,dmg:70,col:'#ff8a3d',shake:16,pierce:0,spread:0,aoe:3.2,unlock:9000},\n  {name:'Arc-Storm',fire:420,dmg:55,col:'#a67bff',shake:11,chain:5,unlock:14000},\n  {name:'Hive Swarm',fire:680,dmg:34,col:'#8dff7b',shake:12,swarm:6,unlock:21000},\n  {name:'Singularity',fire:950,dmg:95,col:'#d36bff',shake:20,singul:4.6,unlock:30000}\n];\nvar weaponIdx=0,fireCool=0;\nvar GUNSRC=[\"data:image/jpeg;base64,\",\"data:image/jpeg;base64,\",\"data:image/jpeg;base64,\",\"data:image/jpeg;base64,\",\"data:image/jpeg;base64,\",\"data:image/jpeg;base64,\",\"data:image/jpeg;base64,\",\"data:image/jpeg;base64,\"];\n// GUNSRC (side profile) drives the HUD badge icon; GUNSRCFP (first-person\n// viewmodels, barrel pointing away) is the held weapon shown at the bottom.\nvar GUNSRCFP=[\"data:image/webp;base64,\",\"data:image/webp;base64,\",\"data:image/webp;base64,\",\"data:image/webp;base64,\",\"data:image/webp;base64,\",\"data:image/webp;base64,\",\"data:image/webp;base64,\",\"data:image/webp;base64,\"];\nvar gunImgs=GUNSRCFP.map(function(s){var im=new Image();im.src=s;return im;});\nvar muzzleT=0,gunPitch=0;\n// FPV guns all point away → muzzle is at top-centre of the drawn gun.\nvar GUNMUZZLE=[[0.5,0.07],[0.5,0.07],[0.5,0.07],[0.5,0.07],[0.5,0.07]];\nfunction gunGeom(){\n  var im=gunImgs[weaponIdx];if(!(im&&im.complete&&im.naturalWidth))return null;\n  var rec=cam.recoil*220*DPR;\n  // pitch (z-axis): aim far/high -> gun recedes (smaller + lifts into the distance);\n  // aim near/low -> gun advances (bigger + drops toward the viewer).\n  var ps=1-gunPitch*0.52;\n  var gh=CH*0.44*ps, gw=gh*(im.naturalWidth/im.naturalHeight);\n  if(gw>CW*0.95){gw=CW*0.95;gh=gw*(im.naturalHeight/im.naturalWidth);}\n  var bottomY=CH+CH*0.05-rec-gunPitch*0.26*CH;\n  return {im:im,gw:gw,gh:gh,left:CW*0.5-gw/2,top:bottomY-gh};\n}\n// the gun swivels around a pivot near its grip to point at the aim\nvar aim={x:innerWidth/2,y:innerHeight*0.34,set:false};\nvar gunAng=0;\nfunction gunPivotY(g){return g.top+g.gh*0.92;}\nfunction targetGunAngle(){\n  var g=gunGeom();if(!g)return 0;\n  var px=CW*0.5, py=gunPivotY(g);\n  var tx=(aim.set?aim.x:innerWidth/2)*DPR, ty=(aim.set?aim.y:innerHeight*0.34)*DPR;\n  var a=Math.atan2(tx-px, py-ty);\n  return Math.max(-0.64,Math.min(0.64,a));\n}\nfunction targetGunPitch(){\n  // aim near the top (far targets) -> positive pitch (recede); low -> negative (advance)\n  var v=(aim.set?aim.y:innerHeight*0.34)/innerHeight;\n  return Math.max(-0.55,Math.min(0.95,(0.44-v)*2.1));\n}\nfunction gunMuzzle(){\n  var g=gunGeom();if(!g)return {x:CW*0.5,y:CH-46*DPR};\n  var m=GUNMUZZLE[weaponIdx]||[0.5,0.05];\n  var mx=g.left+m[0]*g.gw, my=g.top+m[1]*g.gh;\n  var px=CW*0.5, py=gunPivotY(g), c=Math.cos(gunAng), s=Math.sin(gunAng), dx=mx-px, dy=my-py;\n  return {x:px+dx*c-dy*s, y:py+dx*s+dy*c};\n}\n\nfunction reset(){\n  robots=[];shards=[];tracers=[];flashes=[];dmgnums=[];pods=[];podT=8;\n  score=0;wave=0;hp=100;combo=0;comboTimer=0;rage=0;rageActive=0;spawnT=0;toSpawn=0;waveGap=1.2;\n  weaponIdx=0;fireCool=0;cam.shx=cam.shy=cam.recoil=0;\n  updHUD();\n}\n\n/* ============================== spawning / waves ============================== */\nfunction startWave(){\n  wave++;\n  toSpawn=5+Math.floor(wave*2.3);\n  spawnT=0;\n  el('wave').textContent=wave;\n  if(wave>1)banner('WAVE '+wave);\n}\n// kind spec: scale, base speed, hp, accent, aimY-height, ext, attack range, attack dmg\nvar KINDS={\n  walker:{scale:1.05,speed:2.4,hp:60, acc:[120,200,255],aim:1.15,ext:0.8,tz:7.0,dmg:9},\n  fast:  {scale:0.8, speed:3.9,hp:26, acc:[120,255,180],aim:1.05,ext:0.7,tz:7.0,dmg:7},\n  tank:  {scale:1.5, speed:1.45,hp:180,acc:[255,120,80], aim:1.15,ext:0.9,tz:7.5,dmg:17},\n  crawler:{scale:1.0,speed:4.2,hp:34, acc:[150,255,120],aim:0.4, ext:0.5,tz:8.2,dmg:8},\n  drone: {scale:0.9, speed:3.1,hp:40, acc:[90,220,255], aim:1.7, ext:0.5,tz:8.4,dmg:8}\n};\nfunction pickKind(){\n  var r=Math.random();\n  if(r<0.20)return 'crawler';\n  if(r<0.32)return 'drone';\n  if(r<0.44+wave*0.008)return 'tank';\n  if(r<0.68)return 'fast';\n  return 'walker';\n}\nfunction spawnRobot(){\n  var kind=pickKind(),K=KINDS[kind];\n  // varied entry: back-spread, or in from a side wall, or a back corner\n  var e=Math.random(),sx,sz;\n  if(kind==='drone'){ sx=(Math.random()*2-1)*ROOMX*0.7; sz=ROOMZ-1-Math.random()*4; }\n  else if(e<0.5){ sx=(Math.random()*2-1)*4; sz=ROOMZ-2-Math.random()*4; }        // from the back, spread\n  else if(e<0.75){ sx=-ROOMX+1.2; sz=24+Math.random()*14; }                       // in from left wall (far, so it's seen)\n  else { sx=ROOMX-1.2; sz=24+Math.random()*14; }                                  // in from right wall\n  var r={\n    x:sx, z:sz, kind:kind,\n    tx:(1.1+Math.random()*1.2)*(Math.random()<0.5?-1:1), tz:K.tz,                 // funnel toward centre so they stay in view\n    scale:K.scale, speed:K.speed*(1+wave*0.06),\n    hp:K.hp, maxhp:K.hp, dmg:K.dmg,\n    aimY:K.aim*K.scale, ext:K.ext*K.scale,\n    body:ROBOCOLS[(Math.random()*ROBOCOLS.length)|0],\n    accent:K.acc, bob:Math.random()*6, hurt:0, attackT:0, alive:true\n  };\n  robots.push(r);\n}\n// supply pods: glowing crates that drift toward you — SHOOT them to collect\nfunction spawnPod(){\n  var type=Math.random()<0.62?'health':'rage';\n  pods.push({type:type,x:(Math.random()*2-1)*1.5,y:1.7,z:ROOMZ-3,spd:2.1+Math.random()*0.8,bob:Math.random()*6,alive:true});\n}\nfunction podInfo(p){\n  var pr=projPt([p.x,p.y,p.z]);if(!pr)return null;\n  var top=projPt([p.x,p.y+0.65,p.z]);\n  var rad=top?Math.max(16*DPR,Math.abs(pr[1]-top[1])*1.6):36*DPR;\n  return {sx:pr[0],sy:pr[1],rad:rad};\n}\nfunction collectPod(p,si){\n  p.alive=false;\n  if(p.type==='health'){hp=Math.min(100,hp+25);dmgnums.push({x:p.x,y:p.y+0.5,z:p.z,t:0.9,val:'+25 ❤',crit:false});}\n  else{rage=Math.min(100,rage+45);dmgnums.push({x:p.x,y:p.y+0.5,z:p.z,t:0.9,val:'+RAGE ⚡',crit:true});\n       if(rage>=100&&rageActive<=0)startRage();}\n  flashes.push({x:si.sx,y:si.sy,t:0.24,r:90*DPR,col:p.type==='health'?'#5dff8a':'#ffd23f'});\n  sfx('unlock');haptic('success');updHUD();\n}\n\n/* ============================== shooting ============================== */\nfunction screenInfo(r){\n  // project robot centre to screen; radius from its on-screen height\n  var p=projPt([r.x,r.aimY,r.z]);if(!p)return null;\n  var top=projPt([r.x,r.aimY+r.ext+0.4,r.z]);\n  var rad=top?Math.max(16*DPR,Math.abs(p[1]-top[1])*1.5):40*DPR;\n  return {sx:p[0],sy:p[1],rad:rad,z:p[2]};\n}\nfunction tryShoot(scrX,scrY){\n  if(!running||paused)return;\n  var W=WEAPONS[weaponIdx];\n  var now=performance.now?performance.now():Date.now();\n  var px=scrX*DPR, py=scrY*DPR;\n  // supply pods first: shooting one collects it (never breaks combo)\n  for(var p0=0;p0<pods.length;p0++){\n    var si0=podInfo(pods[p0]);\n    if(si0&&Math.hypot(si0.sx-px,si0.sy-py)<si0.rad*1.9){\n      fireFx(px,py,W);\n      cam.recoil=Math.min(0.05,cam.recoil+0.015);\n      sfx('shoot',W);\n      collectPod(pods[p0],si0);\n      pods=pods.filter(function(p){return p.alive});\n      return;\n    }\n  }\n  // find nearest robot to tap within assist radius\n  var best=null,bestD=1e9,infos=[];\n  for(var i=0;i<robots.length;i++){var r=robots[i];if(!r.alive)continue;var s=screenInfo(r);if(!s)continue;s.r=r;infos.push(s);\n    var d=Math.hypot(s.sx-px,s.sy-py);var reach=s.rad*(rageActive>0?2.4:1.7);\n    if(d<reach && d<bestD){bestD=d;best=s}}\n  // muzzle + tracer + recoil regardless of hit\n  fireFx(px,py,W);\n  cam.recoil=Math.min(0.05,cam.recoil+0.015);\n  cam.shx+=(Math.random()-0.5)*W.shake*DPR;cam.shy+=(Math.random()-0.5)*W.shake*DPR*0.6;\n  sfx('shoot',W);\n  if(!best){ // miss — break combo\n    combo=0;comboTimer=0;el('combo').classList.remove('on');\n    haptic('light');return;\n  }\n  haptic(rageActive>0?'heavy':'medium');\n  var dmg=W.dmg*(rageActive>0?3:1);\n  var hits=[best.r];\n  if(W.spread){ // scatter: also nearest others\n    infos.sort(function(a,b){return Math.hypot(a.sx-best.sx,a.sy-best.sy)-Math.hypot(b.sx-best.sx,b.sy-best.sy)});\n    for(var k=0;k<infos.length&&hits.length<1+W.spread;k++){if(infos[k].r!==best.r&&Math.hypot(infos[k].sx-best.sx,infos[k].sy-best.sy)<160*DPR){hits.push(infos[k].r);tracers.push({x1:best.sx,y1:best.sy,x2:infos[k].sx,y2:infos[k].sy,t:0.1,col:W.col,w:2.5*DPR});}}\n  }\n  if(W.pierce){ // rail: everything roughly behind the target along screen-x\n    for(var k2=0;k2<infos.length&&hits.length<1+W.pierce;k2++){if(infos[k2].r!==best.r&&Math.abs(infos[k2].sx-best.sx)<70*DPR&&infos[k2].z>best.z)hits.push(infos[k2].r)}\n    railFx(best.sx,best.sy,W);\n  }\n  if(W.aoe){ // boom: everything within world radius of target\n    for(var k3=0;k3<robots.length;k3++){var rr=robots[k3];if(rr.alive&&rr!==best.r&&Math.hypot(rr.x-best.r.x,rr.z-best.r.z)<W.aoe)hits.push(rr)}\n    boomFx(best.sx,best.sy,W);\n  }\n  if(W.chain){ // arc-storm: lightning jumps to the nearest bots, hop by hop\n    var from=best, seen=[best.r];\n    for(var c=0;c<W.chain;c++){\n      var nxt=null,nd=1e9;\n      for(var ci=0;ci<infos.length;ci++){var s2=infos[ci];if(seen.indexOf(s2.r)>=0)continue;\n        var dd2=Math.hypot(s2.sx-from.sx,s2.sy-from.sy);if(dd2<nd){nd=dd2;nxt=s2}}\n      if(!nxt||nd>320*DPR)break;\n      arcFx(from.sx,from.sy,nxt.sx,nxt.sy,W.col);\n      seen.push(nxt.r);hits.push(nxt.r);from=nxt;\n    }\n  }\n  if(W.swarm){ // hive swarm: micro-missiles streak to up to N bots at once\n    infos.sort(function(a,b){return a.z-b.z});\n    var m0=gunMuzzle();\n    for(var w0=0;w0<infos.length&&hits.length<W.swarm;w0++){\n      if(infos[w0].r===best.r)continue;\n      hits.push(infos[w0].r);\n    }\n    for(var w1=0;w1<hits.length;w1++){var si=null;\n      for(var w2=0;w2<infos.length;w2++)if(infos[w2].r===hits[w1]){si=infos[w2];break}\n      if(si){var bend=(Math.random()-0.5)*180*DPR;\n        tracers.push({x1:m0.x,y1:m0.y,x2:(m0.x+si.sx)/2+bend,y2:(m0.y+si.sy)/2,t:0.1,col:W.col,w:2.5*DPR});\n        tracers.push({x1:(m0.x+si.sx)/2+bend,y1:(m0.y+si.sy)/2,x2:si.sx,y2:si.sy,t:0.12,col:W.col,w:2.5*DPR});\n        flashes.push({x:si.sx,y:si.sy,t:0.14,r:40*DPR,col:W.col});}\n    }\n  }\n  if(W.singul){ // singularity: implode — drag every bot in radius toward the point, then crush\n    var bx=best.r.x,bz=best.r.z;\n    for(var g0=0;g0<robots.length;g0++){var rg=robots[g0];\n      if(!rg.alive||rg===best.r)continue;\n      if(Math.hypot(rg.x-bx,rg.z-bz)<W.singul){\n        rg.x+=(bx-rg.x)*0.6; rg.z+=(bz-rg.z)*0.6;   // gravity yank\n        hits.push(rg);\n      }\n    }\n    flashes.push({x:best.sx,y:best.sy,t:0.34,r:150*DPR,col:'#2a0642'});\n    flashes.push({x:best.sx,y:best.sy,t:0.26,r:90*DPR,col:W.col});\n    cam.shx+=(Math.random()-0.5)*26*DPR;cam.shy+=(Math.random()-0.5)*18*DPR;\n  }\n  for(var h=0;h<hits.length;h++)damageRobot(hits[h],dmg,best);\n}\n// jagged lightning bolt between two screen points\nfunction arcFx(x1,y1,x2,y2,col){\n  var SEG=4,lx=x1,ly=y1;\n  for(var i=1;i<=SEG;i++){\n    var t=i/SEG,nx=x1+(x2-x1)*t,ny=y1+(y2-y1)*t;\n    if(i<SEG){nx+=(Math.random()-0.5)*46*DPR;ny+=(Math.random()-0.5)*46*DPR;}\n    tracers.push({x1:lx,y1:ly,x2:nx,y2:ny,t:0.13,col:col,w:3*DPR});\n    lx=nx;ly=ny;\n  }\n}\nfunction damageRobot(r,dmg,src){\n  if(!r.alive)return;\n  var siF=screenInfo(r);\n  if(siF)flashes.push({x:siF.sx,y:siF.sy,t:0.13,r:(16+dmg*0.55)*DPR,col:WEAPONS[weaponIdx].col});\n  // core hit bonus if tap was near chest handled implicitly; give crit if rage\n  r.hp-=dmg;r.hurt=0.14;\n  dmgnums.push({x:r.x,y:r.aimY+0.6,z:r.z,t:0.7,val:Math.round(dmg),crit:rageActive>0});\n  if(r.hp<=0){killRobot(r)}\n}\nfunction killRobot(r){\n  r.alive=false;\n  var mult=Math.max(1,Math.floor(combo/5)+1);\n  var gain=(r.kind==='tank'?120:(r.kind==='fast'?60:40))*mult;\n  score+=gain;\n  combo++;comboTimer=2.2;rage=Math.min(100,rage+ (r.kind==='tank'?18:9));\n  explode(r);\n  sfx('kill');\n  if(combo>=3){el('combo').textContent='x'+combo+'   COMBO';el('combo').classList.add('on')}\n  if(rage>=100&&rageActive<=0){startRage()}\n  checkWeapon();\n  updHUD();\n}\nfunction startRage(){rageActive=6;banner('⚡ RAMPAGE ⚡');el('rage').classList.add('full');sfx('rage')}\nfunction checkWeapon(){\n  for(var i=WEAPONS.length-1;i>0;i--){if(score>=WEAPONS[i].unlock&&weaponIdx<i){weaponIdx=i;banner('▲ '+WEAPONS[i].name.toUpperCase());el('wpn').textContent=WEAPONS[i].name;sfx('unlock');break}}\n}\n\n/* ============================== effects ============================== */\nfunction fireFx(px,py,W){\n  muzzleT=0.12;\n  var m=gunMuzzle();                    // shots emit from the gun's barrel (FPV)\n  tracers.push({x1:m.x,y1:m.y,x2:px,y2:py,t:0.09,col:W.col,w:(2.2+W.dmg*0.055)*DPR});\n  flashes.push({x:m.x,y:m.y,t:0.09,r:24*DPR,col:W.col});\n}\nfunction railFx(sx,sy,W){var m=gunMuzzle();tracers.push({x1:m.x,y1:m.y,x2:sx,y2:sy-CH,t:0.16,col:W.col,w:6*DPR});}\nfunction boomFx(sx,sy,W){flashes.push({x:sx,y:sy,t:0.3,r:120*DPR,col:W.col});flashes.push({x:sx,y:sy,t:0.42,r:200*DPR,col:'rgba(255,170,80,0.5)'});}\nfunction explode(r){\n  var n=r.kind==='tank'?26:16, base=r.body, acc=r.accent;\n  for(var i=0;i<n;i++){\n    var a=Math.random()*Math.PI*2, up=Math.random()*2.6+0.6, sp=Math.random()*3+1;\n    shards.push({x:r.x+(Math.random()-.5)*0.6,y:Math.max(0.12,r.aimY+(Math.random()-0.4)*1.0),z:r.z+(Math.random()-.5)*0.4,\n      vx:Math.cos(a)*sp,vy:up,vz:Math.sin(a)*sp,t:0.9+Math.random()*0.5,\n      col:Math.random()<0.4?acc:base,sz:(0.05+Math.random()*0.1)*r.scale});\n  }\n  flashes.push({x:0,y:0,t:0.001,r:0,col:'#fff',robotZ:r.z,robotX:r.x});\n  cam.shx+=(Math.random()-0.5)*10*DPR;cam.shy+=(Math.random()-0.5)*6*DPR;\n}\nfunction banner(txt){var b=el('banner');b.textContent=txt;b.classList.remove('show');void b.offsetWidth;b.classList.add('show')}\n\n/* ============================== update ============================== */\nfunction update(dt){\n  // spawn logic\n  if(toSpawn<=0 && robots.length===0){waveGap-=dt;if(waveGap<=0){waveGap=1.4;startWave()}}\n  if(toSpawn>0){spawnT-=dt;if(spawnT<=0){spawnT=Math.max(0.16,0.6-wave*0.03);spawnRobot();toSpawn--}}\n  // combo timeout\n  if(comboTimer>0){comboTimer-=dt;if(comboTimer<=0){combo=0;el('combo').classList.remove('on')}}\n  if(rageActive>0){rageActive-=dt;if(rageActive<=0){rage=0;el('rage').classList.remove('full')}}\n  // robots\n  for(var i=0;i<robots.length;i++){\n    var r=robots[i];if(!r.alive)continue;\n    r.bob+=dt*(r.kind==='crawler'?16:8);\n    if(r.hurt>0)r.hurt-=dt;\n    var dx=r.tx-r.x,dz=r.tz-r.z,dd=Math.hypot(dx,dz);\n    if(dd>0.3){r.attacking=false;var mv=r.speed*dt;r.x+=dx/dd*mv;r.z+=dz/dd*mv;}\n    else{ // reached the player — attack\n      r.attacking=true;\n      r.attackT-=dt;\n      if(r.attackT<=0){r.attackT=1.2;hp-=r.dmg;r.hurt=0.25;flashHurt();updHUD();if(hp<=0){gameOver();return}}\n    }\n  }\n  robots=robots.filter(function(r){return r.alive});\n  // supply pods drift in; missed ones slip past\n  podT-=dt;\n  if(podT<=0&&pods.length<2){podT=10+Math.random()*9;spawnPod();}\n  for(var pi=0;pi<pods.length;pi++){var pp=pods[pi];pp.bob+=dt*5;pp.z-=pp.spd*dt;pp.y=1.7+Math.sin(pp.bob)*0.16;if(pp.z<3.6)pp.alive=false;}\n  pods=pods.filter(function(p){return p.alive});\n  // shards\n  for(var s=0;s<shards.length;s++){var p=shards[s];p.t-=dt;p.vy-=6*dt;p.x+=p.vx*dt;p.y+=p.vy*dt;p.z+=p.vz*dt;if(p.y<0.05){p.y=0.05;p.vy*=-0.35;p.vx*=0.6;p.vz*=0.6}}\n  shards=shards.filter(function(p){return p.t>0});\n  for(var t=0;t<tracers.length;t++)tracers[t].t-=dt;tracers=tracers.filter(function(x){return x.t>0});\n  for(var f=0;f<flashes.length;f++)flashes[f].t-=dt;flashes=flashes.filter(function(x){return x.t>0});\n  for(var d=0;d<dmgnums.length;d++){dmgnums[d].t-=dt;dmgnums[d].y+=dt*0.9}dmgnums=dmgnums.filter(function(x){return x.t>0});\n  // camera shake decay + recoil\n  cam.shx*=Math.pow(0.001,dt);cam.shy*=Math.pow(0.001,dt);\n  cam.recoil*=Math.pow(0.0005,dt);\n  if(muzzleT>0)muzzleT-=dt;\n  gunAng+=(targetGunAngle()-gunAng)*Math.min(1,dt*13);     // yaw: swing left/right to aim\n  gunPitch+=(targetGunPitch()-gunPitch)*Math.min(1,dt*10); // pitch (z): recede/advance by depth\n  cam.pitch=-0.06+cam.recoil;\n}\nfunction flashHurt(){document.body.style.background='#3a0812';setTimeout(function(){document.body.style.background='#05060d'},70);haptic('warning')}\n\n/* ============================== render ============================== */\nfunction draw(){\n  ctx.setTransform(1,0,0,1,0,0);\n  // apply shake by offsetting cam via translate\n  ctx.save();ctx.translate(cam.shx,cam.shy);\n  drawRoom();\n  // collect faces from robots\n  var faces=[];\n  for(var i=0;i<robots.length;i++){var r=robots[i];var yb=Math.sin(r.bob)*0.05;\n    var fs=buildRobotFaces({x:r.x,z:r.z,scale:r.scale,body:r.body,accent:r.accent,hurt:r.hurt,kind:r.kind});\n    for(var j=0;j<fs.length;j++){var f=fs[j];\n      // shift by bob (y) — add to each vert\n      var vv=f.v, sum=0, vp=[];\n      for(var k=0;k<4;k++){var w=toView(vv[k][0],vv[k][1]+yb,vv[k][2]);vp.push(w);sum+=w[2]}\n      f._vp=vp;f._z=sum/4;faces.push(f);\n    }\n  }\n  // supply pods: small glowing crates with an emissive icon face\n  for(var pd=0;pd<pods.length;pd++){\n    var pp2=pods[pd],hcol=pp2.type==='health';\n    var body=hcol?[205,220,232]:[64,54,26], acc=hcol?[70,255,130]:[255,210,63];\n    var bx=boxFaces(pp2.x-0.26,pp2.y-0.26,pp2.z-0.26,0.52,0.52,0.52);\n    for(var bf=0;bf<bx.length;bf++){var f2=bx[bf],vpv=[],sm2=0;\n      for(var bv=0;bv<4;bv++){var wv=toView(f2[bv][0],f2[bv][1],f2[bv][2]);vpv.push(wv);sm2+=wv[2]}\n      faces.push({_vp:vpv,_z:sm2/4,c:body,n:f2[4]});\n    }\n    var fz2=pp2.z-0.26-0.01;\n    var iconVerts=hcol\n      ? [[pp2.x-0.05,pp2.y-0.16,fz2],[pp2.x+0.05,pp2.y-0.16,fz2],[pp2.x+0.05,pp2.y+0.16,fz2],[pp2.x-0.05,pp2.y+0.16,fz2]]\n      : [[pp2.x-0.14,pp2.y-0.14,fz2],[pp2.x+0.14,pp2.y-0.14,fz2],[pp2.x+0.14,pp2.y+0.14,fz2],[pp2.x-0.14,pp2.y+0.14,fz2]];\n    var vpv2=[],sm3=0;for(var iv=0;iv<4;iv++){var wv2=toView(iconVerts[iv][0],iconVerts[iv][1],iconVerts[iv][2]);vpv2.push(wv2);sm3+=wv2[2]}\n    faces.push({_vp:vpv2,_z:sm3/4,c:acc,flat:1,glow:16});\n    if(hcol){ // horizontal bar of the cross\n      var hverts=[[pp2.x-0.16,pp2.y-0.05,fz2],[pp2.x+0.16,pp2.y-0.05,fz2],[pp2.x+0.16,pp2.y+0.05,fz2],[pp2.x-0.16,pp2.y+0.05,fz2]];\n      var vpv3=[],sm4=0;for(var iv2=0;iv2<4;iv2++){var wv3=toView(hverts[iv2][0],hverts[iv2][1],hverts[iv2][2]);vpv3.push(wv3);sm4+=wv3[2]}\n      faces.push({_vp:vpv3,_z:sm4/4,c:acc,flat:1,glow:16});\n    }\n  }\n  // shards as tiny quads\n  for(var s=0;s<shards.length;s++){var p=shards[s];var w0=toView(p.x,p.y,p.z);var half=p.sz;\n    var q=[[p.x-half,p.y+half,p.z],[p.x+half,p.y+half,p.z],[p.x+half,p.y-half,p.z],[p.x-half,p.y-half,p.z]];\n    var vp2=[],sm=0;for(var k2=0;k2<4;k2++){var ww=toView(q[k2][0],q[k2][1],q[k2][2]);vp2.push(ww);sm+=ww[2]}\n    faces.push({_vp:vp2,_z:sm/4,c:p.col,flat:1,glow:0,alpha:Math.min(1,p.t*1.4)});\n  }\n  faces.sort(function(a,b){return b._z-a._z});\n  for(var fi=0;fi<faces.length;fi++)drawFace(faces[fi]);\n  // effects on top\n  drawShardGlow();\n  drawTracers();\n  drawFlashes();\n  drawDmg();\n  drawGun();\n  // danger markers: attacking bots are flagged on top of EVERYTHING (incl. the gun)\n  for(var dgi=0;dgi<robots.length;dgi++){var dr=robots[dgi];\n    if(!dr.alive||!dr.attacking)continue;\n    var dp=projPt([dr.x,dr.aimY+dr.ext+0.45,dr.z]);if(!dp)continue;\n    var pulse=0.6+0.4*Math.sin(performance.now()*0.014);\n    ctx.save();ctx.globalAlpha=pulse;ctx.fillStyle='#ff4545';ctx.shadowColor='#ff4545';ctx.shadowBlur=12*DPR;\n    ctx.beginPath();ctx.moveTo(dp[0],dp[1]+12*DPR);ctx.lineTo(dp[0]-9*DPR,dp[1]-4*DPR);ctx.lineTo(dp[0]+9*DPR,dp[1]-4*DPR);ctx.closePath();ctx.fill();\n    ctx.font='bold '+(15*DPR)+'px -apple-system,sans-serif';ctx.textAlign='center';ctx.fillText('!',dp[0],dp[1]-9*DPR);\n    ctx.restore();\n  }\n  ctx.restore();\n}\nfunction drawFace(f){\n  var vp=f._vp,pts=[];\n  for(var k=0;k<vp.length;k++){var pr=proj(vp[k][0],vp[k][1],vp[k][2]);if(!pr)return;pts.push(pr)}\n  // backface cull (screen winding) unless flat/emissive\n  if(!f.flat){\n    var ar=(pts[1][0]-pts[0][0])*(pts[2][1]-pts[0][1])-(pts[1][1]-pts[0][1])*(pts[2][0]-pts[0][0]);\n    if(ar>=0)return;\n  }\n  ctx.beginPath();ctx.moveTo(pts[0][0],pts[0][1]);for(var k2=1;k2<pts.length;k2++)ctx.lineTo(pts[k2][0],pts[k2][1]);ctx.closePath();\n  if(f.alpha!=null)ctx.globalAlpha=f.alpha;\n  if(f.flat){ctx.fillStyle='rgb('+f.c[0]+','+f.c[1]+','+f.c[2]+')';if(f.glow){ctx.shadowColor=ctx.fillStyle;ctx.shadowBlur=f.glow*DPR}ctx.fill();ctx.shadowBlur=0;}\n  else{ctx.fillStyle=shade(f.c,f.n);ctx.fill();ctx.lineWidth=1*DPR;ctx.strokeStyle='rgba(150,220,255,0.25)';ctx.stroke();}\n  ctx.globalAlpha=1;\n}\nfunction drawShardGlow(){}\nfunction drawTracers(){for(var i=0;i<tracers.length;i++){var t=tracers[i];ctx.globalAlpha=Math.min(1,t.t*11);ctx.strokeStyle=t.col;ctx.lineWidth=t.w;ctx.shadowColor=t.col;ctx.shadowBlur=14*DPR;ctx.beginPath();ctx.moveTo(t.x1,t.y1);ctx.lineTo(t.x2,t.y2);ctx.stroke();ctx.shadowBlur=0;ctx.globalAlpha=1}}\nfunction drawFlashes(){for(var i=0;i<flashes.length;i++){var f=flashes[i];if(f.r<=0)continue;ctx.globalAlpha=Math.min(1,f.t*4);var g=ctx.createRadialGradient(f.x,f.y,0,f.x,f.y,f.r);g.addColorStop(0,f.col);g.addColorStop(1,'rgba(0,0,0,0)');ctx.fillStyle=g;ctx.beginPath();ctx.arc(f.x,f.y,f.r,0,7);ctx.fill();ctx.globalAlpha=1}}\nfunction drawDmg(){ctx.textAlign='center';ctx.font=(20*DPR)+'px -apple-system,sans-serif';for(var i=0;i<dmgnums.length;i++){var d=dmgnums[i];var p=projPt([d.x,d.y,d.z]);if(!p)continue;ctx.globalAlpha=Math.min(1,d.t*2);ctx.fillStyle=d.crit?'#ffd23f':'#fff';ctx.shadowColor=d.crit?'#ffd23f':'#3af';ctx.shadowBlur=8*DPR;ctx.fillText((d.crit?'':'')+d.val,p[0],p[1]);ctx.shadowBlur=0;ctx.globalAlpha=1}}\nfunction drawGun(){\n  var W=WEAPONS[weaponIdx],g=gunGeom();\n  if(g){\n    var px=CW*0.5,py=gunPivotY(g);\n    ctx.save();ctx.translate(px,py);ctx.rotate(gunAng);ctx.translate(-px,-py);\n    ctx.globalAlpha=0.88;ctx.shadowColor=W.col;ctx.shadowBlur=16*DPR;ctx.drawImage(g.im,g.left,g.top,g.gw,g.gh);ctx.globalAlpha=1;ctx.restore();  // gun swivels to aim\n    if(muzzleT>0){var m=gunMuzzle(),rr=74*DPR*Math.min(1,muzzleT*11);ctx.save();ctx.globalCompositeOperation='lighter';var mg=ctx.createRadialGradient(m.x,m.y,0,m.x,m.y,rr);mg.addColorStop(0,'#ffffff');mg.addColorStop(.35,W.col);mg.addColorStop(1,'rgba(0,0,0,0)');ctx.fillStyle=mg;ctx.beginPath();ctx.arc(m.x,m.y,rr,0,7);ctx.fill();ctx.restore();}\n  }else{\n    var cx=CW*0.5,rec=cam.recoil*300*DPR,by=CH+18*DPR-rec*0.9,s=DPR;\n    ctx.save();ctx.translate(cx,by);ctx.fillStyle='rgba(18,26,44,0.96)';ctx.strokeStyle=W.col;ctx.lineWidth=2*DPR;ctx.shadowColor=W.col;ctx.shadowBlur=10*DPR;\n    ctx.beginPath();ctx.moveTo(-70*s,60*s);ctx.lineTo(-16*s,-42*s);ctx.lineTo(16*s,-42*s);ctx.lineTo(70*s,60*s);ctx.closePath();ctx.fill();ctx.stroke();\n    ctx.restore();ctx.shadowBlur=0;\n  }\n}\n\n/* ============================== HUD / audio ============================== */\nfunction updHUD(){el('score').textContent=score;el('hp').style.width=Math.max(0,hp)+'%';el('ragef').style.width=rage+'%';\n  el('wpn').textContent=WEAPONS[weaponIdx].name;\n  var im=el('wimg');if(im&&im.getAttribute('data-i')!==String(weaponIdx)){im.src=GUNSRC[weaponIdx];im.setAttribute('data-i',String(weaponIdx));}\n}\nvar AC=null,muted=false;\nfunction audio(){if(AC)return AC;try{AC=new (window.AudioContext||window.webkitAudioContext)()}catch(e){AC=null}return AC}\nfunction sfx(kind,W){\n  if(muted)return;var ac=audio();if(!ac)return;if(ac.state==='suspended')ac.resume();\n  var t=ac.currentTime;\n  function tone(type,f0,f1,dur,vol){var o=ac.createOscillator(),g=ac.createGain();o.type=type;o.frequency.setValueAtTime(f0,t);o.frequency.exponentialRampToValueAtTime(Math.max(1,f1),t+dur);g.gain.setValueAtTime(vol,t);g.gain.exponentialRampToValueAtTime(0.001,t+dur);o.connect(g);g.connect(ac.destination);o.start(t);o.stop(t+dur)}\n  function noise(dur,vol,filt){var b=ac.createBuffer(1,ac.sampleRate*dur,ac.sampleRate),d=b.getChannelData(0);for(var i=0;i<d.length;i++)d[i]=(Math.random()*2-1)*Math.pow(1-i/d.length,2);var src=ac.createBufferSource();src.buffer=b;var g=ac.createGain();g.gain.value=vol;var f=ac.createBiquadFilter();f.type='lowpass';f.frequency.value=filt;src.connect(f);f.connect(g);g.connect(ac.destination);src.start(t)}\n  if(kind==='shoot'){tone('square',680,120,0.12,0.06);noise(0.08,0.05,2200)}\n  else if(kind==='kill'){tone('triangle',300,60,0.28,0.09);noise(0.22,0.09,900)}\n  else if(kind==='unlock'){tone('sawtooth',300,900,0.3,0.08)}\n  else if(kind==='rage'){tone('sawtooth',120,600,0.6,0.1)}\n}\nel('mute').onclick=function(){muted=!muted;this.textContent=muted?'🔇':'🔊'};\n\n/* ============================== input ============================== */\nfunction tapAt(e){\n  var r=cv.getBoundingClientRect();\n  var x=(e.touches?e.touches[0].clientX:e.clientX)-r.left;\n  var y=(e.touches?e.touches[0].clientY:e.clientY)-r.top;\n  tryShoot(x,y);\n}\nfunction setAim(e){var r=cv.getBoundingClientRect();aim.x=e.clientX-r.left;aim.y=e.clientY-r.top;aim.set=true;}\ncv.addEventListener('pointerdown',function(e){e.preventDefault();if(!running)return;setAim(e);tapAt(e);\n  // auto-weapon hold: for fast guns, keep firing while held\n  lastPointer.active=true;lastPointer.x=e.clientX;lastPointer.y=e.clientY;\n});\ncv.addEventListener('pointermove',function(e){setAim(e);if(lastPointer.active){lastPointer.x=e.clientX;lastPointer.y=e.clientY}});\naddEventListener('pointerup',function(){lastPointer.active=false});\n\n/* ============================== loop ============================== */\nvar last=0;\nfunction frame(ts){\n  if(!last)last=ts;var dt=Math.min(0.05,(ts-last)/1000);last=ts;\n  if(running&&!paused){\n    // held autofire for rapid weapons\n    var W=WEAPONS[weaponIdx];fireCool-=dt*1000;\n    if(lastPointer.active&&W.fire<=140&&fireCool<=0){fireCool=W.fire;var r=cv.getBoundingClientRect();tryShoot(lastPointer.x-r.left,lastPointer.y-r.top)}\n    update(dt);\n  }\n  draw();\n  requestAnimationFrame(frame);\n}\nrequestAnimationFrame(frame);\n\n/* ============================== flow ============================== */\nfunction startGame(){reset();running=true;paused=false;el('start').classList.add('hide');el('over').classList.add('hide');audio();startWave();haptic('success')}\nfunction gameOver(){\n  running=false;\n  el('overStats').innerHTML='You scored <b style=\"color:#8affdc;font-size:22px\">'+score+'</b><br>Reached wave '+wave;\n  if(score>best){best=score;store.setItem('spacerange.best',String(best));el('overBest').textContent='★ New best!';}\n  else el('overBest').textContent=best?('Best  '+best):'';\n  el('over').classList.remove('hide');haptic('error');\n}\nel('startBtn').onclick=startGame;el('againBtn').onclick=startGame;\n\nstore.getItem('spacerange.best').then(function(v){best=parseInt(v||'0',10)||0;el('startBest').textContent=best?('Best  '+best):''});\nupdHUD();\n</script></body></html>\n"}