{"name": "Date Calculator", "html": "<!doctype html>\n<!--\n  Date Calculator — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Date Calculator</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>\n:root{--build-id:\"cbff539a7d\";\n  color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --h:28;\n}\n@media(prefers-color-scheme:dark){:root{--bg:var(--myllm-bg,#000);--surface:var(--myllm-surface,#1c1c1e);--ink:var(--myllm-text,#f2f2f7);--muted:var(--myllm-muted,#8e8e93);--line:var(--myllm-border,#2c2c2e)}}\n*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nbody{font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);background:var(--bg);color:var(--ink);font-size:15.5px;\n  max-width:600px;margin:0 auto;min-height:100dvh;\n  padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left))}\nsvg.i{width:1.25em;height:1.25em;fill:currentColor;flex-shrink:0}\nbutton{font:inherit;color:inherit;cursor:pointer} button:active{transform:scale(.96)}\n\n.head{display:flex;align-items:center;gap:12px;margin:2px 2px 14px}\n.tile{width:44px;height:44px;border-radius:13px;font-size:19px;display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0;\n  background:linear-gradient(145deg,hsl(var(--h) 80% 54%),hsl(calc(var(--h) - 22) 72% 36%))}\nh1{font-size:22px;font-weight:800;letter-spacing:-.01em}\n.head p{font-size:13px;color:var(--muted);margin-top:1px}\n\n.seg{display:flex;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:3px;margin-bottom:12px}\n.seg button{flex:1;border:0;background:none;color:var(--muted);font-weight:700;font-size:14px;min-height:40px;border-radius:11px}\n.seg button.on{background:var(--acc);color:#fff}\n\n/* The answer leads: it sits above the inputs so the keyboard never hides it. */\n.result{border-radius:20px;padding:18px;color:#fff;text-align:center;margin-bottom:12px;min-height:132px;display:flex;flex-direction:column;align-items:center;justify-content:center;\n  background:linear-gradient(145deg,hsl(var(--h) 78% 50%),hsl(calc(var(--h) - 22) 72% 32%));box-shadow:0 10px 28px hsl(var(--h) 70% 34% / .25)}\n.result .kick{font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;opacity:.75;min-height:14px}\n.result .big{font-size:29px;font-weight:800;line-height:1.15;letter-spacing:-.02em;font-variant-numeric:tabular-nums;margin-top:5px;overflow-wrap:anywhere}\n.result .sub{font-size:14px;font-weight:600;opacity:.85;margin-top:6px;font-variant-numeric:tabular-nums}\n.result .sub:empty{display:none}\n.result .pill{display:inline-block;margin-top:11px;font-size:12.5px;font-weight:650;border:1px solid rgba(255,255,255,.2);background:rgba(255,255,255,.16);border-radius:99px;padding:6px 13px;font-variant-numeric:tabular-nums}\n.result .pill:empty{display:none}\n.result .pill b{font-weight:800}\n\n.card{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:14px;margin-bottom:12px}\nlabel{display:block;font-size:12px;font-weight:800;color:var(--muted);text-transform:uppercase;letter-spacing:.07em;margin:0 2px 7px}\n.lrow{display:flex;align-items:center;justify-content:space-between}\n.field+.field,.field+.opseg{margin-top:14px}\ninput[type=date]{width:100%;min-height:46px;padding:11px 12px;border:1px solid var(--line);border-radius:12px;font:inherit;font-size:16px;background:var(--bg);color:var(--ink);-webkit-appearance:none;appearance:none}\n.today{border:1px solid var(--line);background:var(--bg);color:var(--acc);font-weight:700;font-size:12px;border-radius:99px;padding:5px 11px;margin:-3px 0 6px}\n.opseg{display:flex;gap:8px;margin-bottom:14px}\n.opseg button{flex:1;border:1px solid var(--line);background:var(--bg);border-radius:12px;min-height:46px;font-weight:700;font-size:15.5px;display:flex;align-items:center;justify-content:center;gap:7px}\n.opseg button.on{background:var(--acc);color:#fff;border-color:var(--acc)}\n.amts{display:grid;grid-template-columns:1fr 1fr;gap:12px 10px}\n.step{display:flex;align-items:stretch;border:1px solid var(--line);border-radius:12px;background:var(--bg);overflow:hidden}\n.step button{width:40px;min-height:46px;border:0;background:none;color:var(--acc);font-size:15px;display:flex;align-items:center;justify-content:center;flex-shrink:0}\n.step input{flex:1;min-width:0;width:100%;border:0;background:none;color:var(--ink);font:inherit;font-size:17px;font-weight:700;text-align:center;font-variant-numeric:tabular-nums;outline:none;-moz-appearance:textfield;appearance:textfield}\n.step input::-webkit-outer-spin-button,.step input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}\n.rowdates{display:grid;grid-template-columns:1fr 1fr;gap:10px}\n.rowdates .field+.field{margin-top:0}\n.hint{color:var(--muted);font-size:12.5px;line-height:1.5;padding:4px 6px 0}\n\n@media(max-width:350px){.rowdates{grid-template-columns:1fr}.rowdates .field+.field{margin-top:14px}.result .big{font-size:25px}}\n@media(min-width:768px){body{max-width:760px}.amts{grid-template-columns:repeat(4,1fr)}}\n@media(max-height:520px) and (min-width:600px){ /* phone on its side: answer left, inputs right */\n  .split{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);gap:12px;align-items:start}\n  .split .result{position:sticky;top:12px;margin-bottom:0}\n  body{max-width:none}\n}\n@media(prefers-reduced-motion:reduce){button:active{transform:none}}\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-cal\" viewBox=\"0 0 24 24\"><path d=\"M7 2a1 1 0 0 0-1 1v1H5a3 3 0 0 0-3 3v12a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3h-1V3a1 1 0 0 0-2 0v1H8V3a1 1 0 0 0-1-1zM4 10h16v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z\"/></symbol>\n  <symbol id=\"i-plus\" viewBox=\"0 0 24 24\"><path d=\"M12 4a1 1 0 0 0-1 1v6H5a1 1 0 0 0 0 2h6v6a1 1 0 0 0 2 0v-6h6a1 1 0 0 0 0-2h-6V5a1 1 0 0 0-1-1z\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><rect x=\"4\" y=\"11\" width=\"16\" height=\"2\" rx=\"1\"/></symbol>\n</defs></svg>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-cal\"/></svg></div>\n  <div><h1>Date Calculator</h1><p>Add, subtract &amp; compare dates</p></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Date Calculator\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n\n<div class=\"seg\"><button id=\"tabAdd\" class=\"on\">Add / Subtract</button><button id=\"tabDiff\">Difference</button></div>\n\n<div id=\"addView\" class=\"split\">\n  <div class=\"result\" id=\"addResult\"><div class=\"kick\"></div><div class=\"big\">—</div><div class=\"sub\"></div></div>\n  <div class=\"card\">\n    <div class=\"field\"><div class=\"lrow\"><label for=\"start\">Start date</label><button class=\"today\" data-for=\"start\">Today</button></div><input type=\"date\" id=\"start\"></div>\n    <div class=\"opseg\"><button id=\"opAdd\" class=\"on\"><svg class=\"i\"><use href=\"#i-plus\"/></svg>Add</button><button id=\"opSub\"><svg class=\"i\"><use href=\"#i-minus\"/></svg>Subtract</button></div>\n    <div class=\"amts\">\n      <div class=\"amt\"><label for=\"y\">Years</label><div class=\"step\"><button data-step=\"-1\" data-for=\"y\" aria-label=\"Fewer years\"><svg class=\"i\"><use href=\"#i-minus\"/></svg></button><input type=\"number\" id=\"y\" inputmode=\"numeric\" min=\"0\" value=\"0\"><button data-step=\"1\" data-for=\"y\" aria-label=\"More years\"><svg class=\"i\"><use href=\"#i-plus\"/></svg></button></div></div>\n      <div class=\"amt\"><label for=\"mo\">Months</label><div class=\"step\"><button data-step=\"-1\" data-for=\"mo\" aria-label=\"Fewer months\"><svg class=\"i\"><use href=\"#i-minus\"/></svg></button><input type=\"number\" id=\"mo\" inputmode=\"numeric\" min=\"0\" value=\"0\"><button data-step=\"1\" data-for=\"mo\" aria-label=\"More months\"><svg class=\"i\"><use href=\"#i-plus\"/></svg></button></div></div>\n      <div class=\"amt\"><label for=\"w\">Weeks</label><div class=\"step\"><button data-step=\"-1\" data-for=\"w\" aria-label=\"Fewer weeks\"><svg class=\"i\"><use href=\"#i-minus\"/></svg></button><input type=\"number\" id=\"w\" inputmode=\"numeric\" min=\"0\" value=\"0\"><button data-step=\"1\" data-for=\"w\" aria-label=\"More weeks\"><svg class=\"i\"><use href=\"#i-plus\"/></svg></button></div></div>\n      <div class=\"amt\"><label for=\"da\">Days</label><div class=\"step\"><button data-step=\"-1\" data-for=\"da\" aria-label=\"Fewer days\"><svg class=\"i\"><use href=\"#i-minus\"/></svg></button><input type=\"number\" id=\"da\" inputmode=\"numeric\" min=\"0\" value=\"0\"><button data-step=\"1\" data-for=\"da\" aria-label=\"More days\"><svg class=\"i\"><use href=\"#i-plus\"/></svg></button></div></div>\n    </div>\n  </div>\n</div>\n\n<div id=\"diffView\" class=\"split\" style=\"display:none\">\n  <div class=\"result\" id=\"diffResult\"><div class=\"kick\">Between</div><div class=\"big\">—</div><div class=\"sub\"></div><div class=\"pill\" id=\"diffTotals\"></div></div>\n  <div class=\"card\">\n    <div class=\"rowdates\">\n      <div class=\"field\"><div class=\"lrow\"><label for=\"from\">From</label><button class=\"today\" data-for=\"from\">Today</button></div><input type=\"date\" id=\"from\"></div>\n      <div class=\"field\"><div class=\"lrow\"><label for=\"to\">To</label><button class=\"today\" data-for=\"to\">Today</button></div><input type=\"date\" id=\"to\"></div>\n    </div>\n  </div>\n</div>\n\n<p class=\"hint\">Months and years are calendar-aware: adding a month lands on the same day next month (clamped to the last day for short months). Difference shows the gap in calendar years, months and days.</p>\n\n<script>\nvar op=1; // +1 add, -1 subtract\nfunction $(i){return document.getElementById(i)}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nfunction todayStr(){var d=new Date();return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())}\nfunction pad(n){return (n<10?'0':'')+n}\nfunction parse(v){if(!v)return null;var p=v.split('-');return new Date(+p[0],+p[1]-1,+p[2],12,0,0)}\nfunction fmtDay(d){return new Intl.DateTimeFormat([],{weekday:'long'}).format(d)}\nfunction fmtDate(d){return new Intl.DateTimeFormat([],{day:'numeric',month:'long',year:'numeric'}).format(d)}\nfunction num(id){var n=parseInt($(id).value);return isNaN(n)||n<0?0:n}\nfunction show(R,kick,big,sub){R.querySelector('.kick').textContent=kick;R.querySelector('.big').textContent=big;R.querySelector('.sub').textContent=sub}\n\nfunction calcAdd(){\n  var s=parse($('start').value);if(!s){show($('addResult'),'','Pick a start date','');return}\n  var y=num('y'),mo=num('mo'),w=num('w'),da=num('da');\n  var Y=s.getFullYear()+op*y, M=s.getMonth()+op*mo;\n  var d=new Date(Y,M,1,12);\n  var last=new Date(d.getFullYear(),d.getMonth()+1,0).getDate();\n  d.setDate(Math.min(s.getDate(),last));\n  d.setDate(d.getDate()+op*(w*7+da));\n  var totalDays=Math.round((d-s)/86400000);\n  var rel=totalDays===0?'same day':(Math.abs(totalDays).toLocaleString()+' day'+(Math.abs(totalDays)===1?'':'s')+(totalDays>0?' later':' earlier'));\n  show($('addResult'),fmtDay(d),fmtDate(d),rel);\n}\n\nfunction calcDiff(){\n  var a=parse($('from').value),b=parse($('to').value);\n  var R=$('diffResult'),T=$('diffTotals');\n  if(!a||!b){show(R,'Between','Pick both dates','');T.textContent='';return}\n  var sign=a<=b?1:-1, A=sign>0?a:b, B=sign>0?b:a;\n  var y=B.getFullYear()-A.getFullYear(), m=B.getMonth()-A.getMonth(), d=B.getDate()-A.getDate();\n  if(d<0){m--;d+=new Date(B.getFullYear(),B.getMonth(),0).getDate()}\n  if(m<0){y--;m+=12}\n  var parts=[];if(y)parts.push(y+' year'+(y===1?'':'s'));if(m)parts.push(m+' month'+(m===1?'':'s'));if(d)parts.push(d+' day'+(d===1?'':'s'));\n  var total=Math.round((B-A)/86400000);\n  show(R,'Between', total===0?'Same day':parts.join(', '), total===0?'':(sign<0?'(From is after To)':''));\n  var wk=Math.floor(total/7),rem=total%7;\n  T.innerHTML='<b>'+total.toLocaleString()+'</b> total days &nbsp;·&nbsp; '+wk.toLocaleString()+' week'+(wk===1?'':'s')+(rem?(' '+rem+'d'):'');\n}\n\n$('tabAdd').onclick=function(){sw(true)};\n$('tabDiff').onclick=function(){sw(false)};\nfunction sw(add){\n  $('tabAdd').classList.toggle('on',add);$('tabDiff').classList.toggle('on',!add);\n  $('addView').style.display=add?'':'none';$('diffView').style.display=add?'none':'';haptic('selection');\n}\n$('opAdd').onclick=function(){op=1;$('opAdd').classList.add('on');$('opSub').classList.remove('on');calcAdd();haptic('selection')};\n$('opSub').onclick=function(){op=-1;$('opSub').classList.add('on');$('opAdd').classList.remove('on');calcAdd();haptic('selection')};\n\n['start','y','mo','w','da'].forEach(function(id){$(id).addEventListener('input',calcAdd)});\n['from','to'].forEach(function(id){$(id).addEventListener('input',calcDiff)});\nArray.prototype.forEach.call(document.querySelectorAll('.today'),function(b){b.onclick=function(){$(b.getAttribute('data-for')).value=todayStr();haptic('selection');calcAdd();calcDiff()}});\n// Steppers: the same numbers, without raising the keyboard.\nArray.prototype.forEach.call(document.querySelectorAll('.step button'),function(b){b.onclick=function(){\n  var id=b.getAttribute('data-for');$(id).value=Math.max(0,num(id)+(+b.getAttribute('data-step')));haptic('selection');calcAdd()}});\n\n// init\n$('start').value=todayStr();$('from').value=todayStr();$('to').value=todayStr();\ncalcAdd();calcDiff();\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes.\n   The spacer keeps the header clear of the status bar / Dynamic Island. It is\n   live CSS — env(safe-area-inset-top) — not a measured number: the inset is\n   still 0 when the page loads and only grows once MyLLM's bar has gone (v1\n   measured once, so the title sat under the island). If the page's own styles\n   already pad the header down by the inset, the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  /* Does any rule that applies to the header or an ancestor already use the top inset? */\n  function pageHandlesInset(head){\n    var chain = [], n, found = false;\n    for (n = head; n && n.nodeType === 1; n = n.parentElement) chain.push(n);\n    function walk(rules){\n      for (var i = 0; i < rules.length && !found; i++){\n        var r = rules[i];\n        if (r.cssRules && !r.selectorText) { walk(r.cssRules); continue; }\n        if (!r.selectorText || !/safe-area-inset-top/.test(r.cssText) || !/(padding|margin|top)\\s*:/.test(r.cssText)) continue;\n        if (/\\.imm-safe/.test(r.selectorText)) continue;\n        for (var k = 0; k < chain.length; k++){\n          try { if (chain[k].matches(r.selectorText)) { found = true; break; } } catch(e){}\n        }\n      }\n    }\n    for (var s = 0; s < document.styleSheets.length && !found; s++){\n      try { walk(document.styleSheets[s].cssRules); } catch(e){}\n    }\n    for (n = head; n && n.nodeType === 1 && !found; n = n.parentElement){\n      if (/safe-area-inset-top/.test(n.getAttribute(\"style\") || \"\")) found = true;\n    }\n    return found;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = (document.body.classList.contains(\"imm\") && !pageHandlesInset(head)) ? \"env(safe-area-inset-top)\" : \"0px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script>\n</body>\n</html>\n", "kind": "html", "iconSymbol": "calendar.badge.plus", "iconColor": "orange"}