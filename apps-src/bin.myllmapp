{"name": "Bin", "kind": "html", "iconSymbol": "trash.fill", "iconColor": "mint", "html": "<!doctype html>\n<!--\n  Bin — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Bin</title>\n<style>\n:root{--build-id:\"61b52aa067\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7);--surface:var(--myllm-surface,#fff);--text:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#6e6e73);--accent:var(--myllm-accent,#0a84ff);--border:var(--myllm-border,#e3e3e8);\n  --radius:var(--myllm-radius,18px);--bad:#e5484d;--good:#2fb56a}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nhtml,body{margin:0}\nbody{font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);background:var(--bg);color:var(--text);\n  padding:16px 16px calc(28px + env(safe-area-inset-bottom));max-width:820px;margin:0 auto;-webkit-font-smoothing:antialiased}\nh1{font-size:24px;margin:0;letter-spacing:-.3px}\n.sub{font-size:13px;color:var(--muted);margin:3px 0 12px}\n.top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}\n.btn{border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:12px;padding:9px 13px;font-size:14px;font-weight:600;white-space:nowrap}\n.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}\n.btn.danger{background:var(--bad);border-color:var(--bad);color:#fff}\n.btn.quiet{color:var(--accent)}\n.btn[disabled]{opacity:.45}\n.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:4px 14px}\n.bar{display:flex;gap:8px;margin-bottom:10px;align-items:center}\n.bar .spacer{flex:1}\n.count{font-size:13px;color:var(--muted);white-space:nowrap}\n.row{display:flex;align-items:center;gap:12px;padding:12px 0;border-top:1px solid var(--border)}\n.row:first-child{border-top:0}\n.row .ico{width:38px;height:38px;border-radius:10px;background:var(--bg);display:flex;align-items:center;justify-content:center;font-size:18px;flex:none}\n.row .txt{flex:1;min-width:0}\n.row b{display:block;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.row span{display:block;font-size:12px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.row .chk{width:22px;height:22px;border-radius:50%;border:2px solid var(--border);flex:none}\n.row.sel .chk{background:var(--accent);border-color:var(--accent)}\n.row .chk[hidden]{display:none}\n.acts{display:flex;gap:8px;padding:0 0 12px 50px}\n.acts button{border:0;border-radius:10px;padding:8px 12px;font-size:13px;font-weight:600}\n.acts .restore{background:var(--accent);color:#fff}\n.acts .kill{background:var(--bg);color:var(--bad)}\n.acts .peek{background:var(--bg);color:var(--text)}\n.empty{color:var(--muted);font-size:14px;text-align:center;padding:36px 12px;line-height:1.55}\n.empty .big{font-size:44px;margin-bottom:8px}\n.modal{position:fixed;inset:0;background:rgba(0,0,0,.45);display:flex;align-items:flex-end;justify-content:center;z-index:9;padding:0 12px calc(12px + env(safe-area-inset-bottom))}\n.sheet{background:var(--surface);border-radius:var(--radius);padding:18px;width:100%;max-width:520px}\n.sheet h3{margin:0 0 6px;font-size:17px}\n.sheet p{margin:0 0 14px;font-size:14px;color:var(--muted);line-height:1.5}\n.sheet .opts{display:flex;flex-direction:column;gap:8px}\n.sheet button{border:0;border-radius:12px;padding:12px;font-size:15px;font-weight:600;background:var(--bg);color:var(--text)}\n.sheet button.primary{background:var(--accent);color:#fff}\n.sheet button.danger{background:var(--bad);color:#fff}\n.preview{white-space:pre-wrap;font:13px ui-monospace,Menlo,monospace;background:var(--bg);border-radius:10px;padding:10px;max-height:40vh;overflow:auto;margin-bottom:12px}\n.note{font-size:12px;color:var(--muted);line-height:1.5;margin-top:14px}\n.status{font-size:13px;color:var(--muted);min-height:18px;text-align:center;margin:8px 0}\n[hidden]{display:none!important}\n.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(20px);\n  background:var(--text);color:var(--bg);padding:10px 16px;border-radius:14px;font-size:14px;font-weight:600;opacity:0;pointer-events:none;transition:.25s;z-index:10}\n.toast.on{opacity:1;transform:translateX(-50%) translateY(0)}\n</style></head><body>\n\n<div class=\"top\">\n  <div><h1>Bin</h1><div class=\"sub\" id=\"sub\">Things you deleted, until you empty it</div></div>\n  <button class=\"btn danger\" id=\"emptyBtn\" hidden>Empty Bin</button>\n</div>\n\n<div class=\"bar\">\n  <span class=\"count\" id=\"count\"></span>\n  <span class=\"spacer\"></span>\n  <button class=\"btn\" id=\"selectBtn\" hidden>Select</button>\n  <button class=\"btn primary\" id=\"restoreSelBtn\" hidden>Restore</button>\n  <button class=\"btn danger\" id=\"deleteSelBtn\" hidden>Delete</button>\n</div>\n\n<div class=\"status\" id=\"status\"></div>\n<div class=\"card\" id=\"list\"></div>\n\n<p class=\"note\">The Bin is the hidden <code>.trash</code> folder in your shared workspace. The Shell app's rm and rmdir put things here instead of deleting them. Restore puts a file back where it came from; Delete and Empty Bin are final.</p>\n\n<div class=\"modal\" id=\"modal\" hidden><div class=\"sheet\" id=\"sheet\"></div></div>\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\n(function(){\n'use strict';\nvar $=function(id){return document.getElementById(id);};\nfunction haptic(k){try{if(window.myllmHaptic)window.myllmHaptic(k||'light');}catch(e){}}\nvar files=window.myllmFiles||null;\nvar TRASH='.trash';\nvar items=[],selecting=false,selected={},open=null;\n\nfunction esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\nfunction toast(t){var e=$('toast');e.textContent=t;e.classList.add('on');clearTimeout(toast._t);toast._t=setTimeout(function(){e.classList.remove('on');},1800);}\nfunction status(t){$('status').textContent=t||'';}\nfunction bytes(n){return n<1024?n+' B':n<1048576?(n/1024).toFixed(1)+' KB':(n/1048576).toFixed(1)+' MB';}\nfunction when(sec){var d=new Date(sec*1000);if(!(d.getTime()>0))return '';var now=new Date();var same=d.toDateString()===now.toDateString();return (same?'Today ':d.toLocaleDateString([],{day:'numeric',month:'short'})+' ')+d.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});}\nfunction inTrash(p){return p===TRASH||p.indexOf(TRASH+'/')===0;}\n/* .trash/notes/todo~20260904084617.md -> notes/todo.md */\nfunction homeOf(trashPath){return trashPath.slice(TRASH.length+1).replace(/~\\d{14}(?=\\.[^.\\/]+$|$)/,'');}\nfunction iconFor(name){var e=(name.split('.').pop()||'').toLowerCase();\n  return {md:'📝',txt:'📝',json:'🧩',csv:'📊',html:'🌐',js:'🧩',py:'🐍',log:'📜',sh:'⌨️',jpg:'🖼️',jpeg:'🖼️',png:'🖼️',pdf:'📕'}[e]||'📄';}\n\nfunction load(){\n  if(!files){$('list').innerHTML='<div class=\"empty\"><div class=\"big\">🗑️</div>Shared files are off.<br>Turn on \"Shared files\" in MyLLMos settings to use the Bin.</div>';return Promise.resolve();}\n  return files.list().then(function(list){\n    items=list.filter(function(f){return inTrash(f.path);}).map(function(f){return {path:f.path,home:homeOf(f.path),size:f.size||0,modified:f.modified||0};})\n      .sort(function(a,b){return b.modified-a.modified;});\n    for(var k in selected)if(!items.some(function(i){return i.path===k;}))delete selected[k];\n    render();\n  }).catch(function(e){status('Could not read the workspace: '+(e&&e.message||e));});\n}\nfunction render(){\n  var list=$('list'),total=items.reduce(function(a,b){return a+b.size;},0),nSel=Object.keys(selected).length;\n  $('emptyBtn').hidden=!items.length;\n  $('selectBtn').hidden=!items.length;$('selectBtn').textContent=selecting?'Done':'Select';\n  $('restoreSelBtn').hidden=!selecting;$('deleteSelBtn').hidden=!selecting;\n  $('restoreSelBtn').disabled=!nSel;$('deleteSelBtn').disabled=!nSel;\n  $('restoreSelBtn').textContent=nSel?'Restore ('+nSel+')':'Restore';$('deleteSelBtn').textContent=nSel?'Delete ('+nSel+')':'Delete';\n  $('count').hidden=selecting;\n  $('count').textContent=items.length?items.length+(items.length===1?' item':' items')+' · '+bytes(total):'';\n  if(!items.length){list.innerHTML='<div class=\"empty\"><div class=\"big\">🗑️</div>The Bin is empty.<br>Files removed with rm in the Shell app land here.</div>';return;}\n  list.innerHTML=items.map(function(it){\n    var name=it.home.split('/').pop(),dir=it.home.indexOf('/')>=0?it.home.slice(0,it.home.lastIndexOf('/'))+'/':'workspace root';\n    var isOpen=open===it.path;\n    return '<div class=\"row'+(selected[it.path]?' sel':'')+'\" data-path=\"'+esc(it.path)+'\"><i class=\"chk\"'+(selecting?'':' hidden')+'></i><div class=\"ico\">'+iconFor(name)+'</div>'+\n      '<div class=\"txt\"><b>'+esc(name)+'</b><span>from '+esc(dir)+' · '+bytes(it.size)+(it.modified?' · '+esc(when(it.modified)):'')+'</span></div></div>'+\n      (isOpen&&!selecting?'<div class=\"acts\"><button class=\"restore\" data-act=\"restore\">Restore</button><button class=\"peek\" data-act=\"peek\">Look inside</button><button class=\"kill\" data-act=\"kill\">Delete forever</button></div>':'');\n  }).join('');\n}\n\n/* ---------- actions ---------- */\nfunction sheet(title,text,opts,extraHTML){\n  $('sheet').innerHTML='<h3>'+esc(title)+'</h3>'+(text?'<p>'+esc(text)+'</p>':'')+(extraHTML||'')+'<div class=\"opts\">'+opts.map(function(o,i){return '<button class=\"'+(o.cls||'')+'\" data-i=\"'+i+'\">'+esc(o.label)+'</button>';}).join('')+'</div>';\n  $('modal').hidden=false;\n  return new Promise(function(res){\n    $('sheet').onclick=function(e){var b=e.target.closest('button[data-i]');if(!b)return;$('modal').hidden=true;res(opts[+b.dataset.i].value);};\n    $('modal').onclick=function(e){if(e.target===$('modal')){$('modal').hidden=true;res(null);}};\n  });\n}\nfunction exists(path){return files.list().then(function(l){return l.some(function(f){return f.path===path;});});}\nfunction pruneEmptyFolders(){\n  if(!files.folders)return Promise.resolve();\n  return files.list().then(function(list){return files.folders().then(function(folders){\n    var dirs=folders.filter(function(d){return inTrash(d)&&d!==TRASH;}).sort(function(a,b){return b.length-a.length;});\n    var gone={};\n    return dirs.reduce(function(p,d){return p.then(function(){\n      var busy=list.some(function(f){return f.path.indexOf(d+'/')===0;})||folders.some(function(x){return x!==d&&!gone[x]&&x.indexOf(d+'/')===0;});\n      if(busy)return;return files.removeFolder(d,false).then(function(){gone[d]=1;}).catch(function(){});\n    });},Promise.resolve()).then(function(){\n      var anyLeft=list.some(function(f){return inTrash(f.path);})||folders.some(function(d){return d!==TRASH&&inTrash(d)&&!gone[d];});\n      if(!anyLeft&&folders.indexOf(TRASH)>=0)return files.removeFolder(TRASH,false).catch(function(){});\n    });\n  });}).catch(function(){});\n}\nfunction restoreOne(it,policy){\n  return exists(it.home).then(function(clash){\n    var dest=it.home;\n    if(clash){\n      if(policy==='replace'){/* fall through: the store overwrites */}\n      else if(policy==='both'){var dot=dest.lastIndexOf('.'),slash=dest.lastIndexOf('/');dest=dot>slash?dest.slice(0,dot)+' (restored)'+dest.slice(dot):dest+' (restored)';}\n      else return sheet('A file is already there',it.home+' exists in the workspace. What should happen?',[\n        {label:'Keep both (restore as \"… (restored)\")',value:'both',cls:'primary'},{label:'Replace the existing file',value:'replace',cls:'danger'},{label:'Cancel',value:null}]).then(function(v){if(!v)return false;return restoreOne(it,v);});\n    }\n    return files.move(it.path,dest).then(function(){return true;});\n  });\n}\nfunction restore(list){\n  var done=0;\n  return list.reduce(function(p,it){return p.then(function(){return restoreOne(it).then(function(ok){if(ok)done++;});});},Promise.resolve())\n    .then(function(){return pruneEmptyFolders();}).then(function(){haptic('success');toast(done===1?'Restored '+list[0].home.split('/').pop():'Restored '+done);selected={};open=null;return load();})\n    .catch(function(e){status('Restore failed: '+(e&&e.message||e));return load();});\n}\nfunction destroy(list){\n  return sheet(list.length===1?'Delete forever?':'Delete '+list.length+' items forever?',(list.length===1?list[0].home:'')+' There is no way back from this.',\n    [{label:'Delete forever',value:'yes',cls:'danger'},{label:'Cancel',value:null}]).then(function(v){\n    if(!v)return;\n    return list.reduce(function(p,it){return p.then(function(){return files.remove(it.path);});},Promise.resolve())\n      .then(function(){return pruneEmptyFolders();}).then(function(){haptic('warning');toast('Deleted');selected={};open=null;return load();})\n      .catch(function(e){status('Delete failed: '+(e&&e.message||e));return load();});\n  });\n}\nfunction emptyBin(){\n  var n=items.length;\n  sheet('Empty the Bin?',n+(n===1?' item':' items')+' will be deleted for good. There is no undo.',[{label:'Empty Bin',value:'yes',cls:'danger'},{label:'Cancel',value:null}]).then(function(v){\n    if(!v)return;\n    return files.removeFolder(TRASH,true).then(function(){haptic('warning');toast('Bin emptied');selected={};open=null;return load();})\n      .catch(function(e){status('Could not empty: '+(e&&e.message||e));return load();});\n  });\n}\nfunction peek(it){\n  files.read(it.path).then(function(t){\n    var body=t==null?'(could not read)':String(t);\n    sheet(it.home.split('/').pop(),null,[{label:'Restore',value:'restore',cls:'primary'},{label:'Close',value:null}],\n      '<div class=\"preview\">'+esc(body.length>4000?body.slice(0,4000)+'\\n…':body)+'</div>').then(function(v){if(v==='restore')restore([it]);});\n  });\n}\n\n/* ---------- wiring ---------- */\n$('list').addEventListener('click',function(e){\n  var act=e.target.closest('button[data-act]');\n  if(act){var row=act.closest('.acts').previousElementSibling;var it=items.filter(function(i){return i.path===row.dataset.path;})[0];if(!it)return;\n    if(act.dataset.act==='restore')restore([it]);else if(act.dataset.act==='kill')destroy([it]);else peek(it);return;}\n  var r=e.target.closest('.row');if(!r)return;\n  if(selecting){if(selected[r.dataset.path])delete selected[r.dataset.path];else selected[r.dataset.path]=1;haptic('selection');render();return;}\n  open=open===r.dataset.path?null:r.dataset.path;haptic('selection');render();\n});\n$('selectBtn').addEventListener('click',function(){selecting=!selecting;selected={};open=null;haptic('light');render();});\n$('restoreSelBtn').addEventListener('click',function(){var l=items.filter(function(i){return selected[i.path];});if(l.length)restore(l);});\n$('deleteSelBtn').addEventListener('click',function(){var l=items.filter(function(i){return selected[i.path];});if(l.length)destroy(l);});\n$('emptyBtn').addEventListener('click',emptyBin);\ndocument.addEventListener('visibilitychange',function(){if(!document.hidden)load();});\nload();\n})();\n</script>\n</body></html>\n"}