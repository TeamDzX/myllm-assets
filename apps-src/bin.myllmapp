{"name": "Bin", "kind": "html", "iconSymbol": "trash.fill", "iconColor": "mint", "html": "<!doctype html>\n<!--\n  Bin — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Bin</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>\n:root{--h:165;--build-id:\"61b52aa067\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7);--surface:var(--myllm-surface,#fff);--text:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#6e6e73);--accent:var(--myllm-accent,#0a84ff);--border:var(--myllm-border,#e3e3e8);\n  --radius:var(--myllm-radius,18px);--bad:#e5484d;--good:#2fb56a}\n@media(prefers-color-scheme:dark){:root{--bg:var(--myllm-bg,#000);--surface:var(--myllm-surface,#1c1c1e);--text:var(--myllm-text,#f2f2f7);--muted:var(--myllm-muted,#98989f);--border:var(--myllm-border,#2c2c2e)}}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nhtml,body{margin:0}\nbody{font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);background:var(--bg);color:var(--text);\n  padding:16px 16px calc(28px + env(safe-area-inset-bottom));max-width:820px;margin:0 auto;-webkit-font-smoothing:antialiased}\n/* phone on its side: keep clear of the notch and the rounded corners */\nbody{padding-left:max(16px,env(safe-area-inset-left));padding-right:max(16px,env(safe-area-inset-right))}\nh1{font-size:24px;margin:0;letter-spacing:-.3px}\n.sub{font-size:13px;color:var(--muted);margin:3px 0 12px}\n.top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}\n.btn{border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:12px;padding:9px 13px;font-size:14px;font-weight:600;white-space:nowrap}\n.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}\n.btn.danger{background:var(--bad);border-color:var(--bad);color:#fff}\n.btn.quiet{color:var(--accent)}\n.btn[disabled]{opacity:.45}\n.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:4px 14px}\n.bar{display:flex;gap:8px;margin-bottom:10px;align-items:center}\n.bar .spacer{flex:1}\n.count{font-size:13px;color:var(--muted);white-space:nowrap}\n.row{display:flex;align-items:center;gap:12px;padding:12px 0;border-top:1px solid var(--border)}\n.row:first-child{border-top:0}\n.row .ico{width:38px;height:38px;border-radius:10px;background:var(--bg);display:flex;align-items:center;justify-content:center;font-size:18px;flex:none}\n.row .txt{flex:1;min-width:0}\n.row b{display:block;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.row span{display:block;font-size:12px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.row .chk{width:22px;height:22px;border-radius:50%;border:2px solid var(--border);flex:none}\n.row.sel .chk{background:var(--accent);border-color:var(--accent)}\n.row .chk[hidden]{display:none}\n.acts{display:flex;gap:8px;padding:0 0 12px 50px}\n.acts button{border:0;border-radius:10px;padding:8px 12px;font-size:13px;font-weight:600}\n.acts .restore{background:var(--accent);color:#fff}\n.acts .kill{background:var(--bg);color:var(--bad)}\n.acts .peek{background:var(--bg);color:var(--text)}\n.empty{color:var(--muted);font-size:14px;text-align:center;padding:36px 12px;line-height:1.55}\n.empty .big{font-size:44px;margin-bottom:8px}\n.modal{position:fixed;inset:0;background:rgba(0,0,0,.45);display:flex;align-items:flex-end;justify-content:center;z-index:9;padding:0 12px calc(12px + env(safe-area-inset-bottom))}\n.sheet{background:var(--surface);border-radius:var(--radius);padding:18px;width:100%;max-width:520px}\n.sheet h3{margin:0 0 6px;font-size:17px}\n.sheet p{margin:0 0 14px;font-size:14px;color:var(--muted);line-height:1.5}\n.sheet .opts{display:flex;flex-direction:column;gap:8px}\n.sheet button{border:0;border-radius:12px;padding:12px;font-size:15px;font-weight:600;background:var(--bg);color:var(--text)}\n.sheet button.primary{background:var(--accent);color:#fff}\n.sheet button.danger{background:var(--bad);color:#fff}\n.preview{white-space:pre-wrap;font:13px ui-monospace,Menlo,monospace;background:var(--bg);border-radius:10px;padding:10px;max-height:40vh;overflow:auto;margin-bottom:12px}\n.note{font-size:12px;color:var(--muted);line-height:1.5;margin-top:14px}\n.status{font-size:13px;color:var(--muted);min-height:18px;text-align:center;margin:8px 0}\n.seg{display:flex;background:var(--border);border-radius:12px;padding:3px;margin-bottom:12px}\n.seg button{flex:1;border:0;background:transparent;color:var(--muted);font-weight:600;font-size:14px;padding:8px;border-radius:10px}\n.seg button.on{background:var(--surface);color:var(--text);box-shadow:0 1px 3px rgba(0,0,0,.12)}\n.vrow{display:flex;align-items:center;gap:10px;padding:8px 0 8px 50px;font-size:13px;border-top:1px dashed var(--border)}\n.vrow .when{flex:1;color:var(--muted)}\n.vrow button{border:0;border-radius:9px;padding:6px 10px;font-size:12px;font-weight:600;background:var(--bg);color:var(--text)}\n.vrow button.primary{background:var(--accent);color:#fff}\n[hidden]{display:none!important}\n.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(20px);\n  background:var(--text);color:var(--bg);padding:10px 16px;border-radius:14px;font-size:14px;font-weight:600;opacity:0;pointer-events:none;transition:.25s;z-index:10}\n.toast.on{opacity:1;transform:translateX(-50%) translateY(0)}\n/* The header every gallery home screen shares: hue tile, name, one line, actions. */\n.head{display:flex;align-items:center;gap:12px;margin:2px 2px 14px}\n.head .tile{display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0;width:44px;height:44px;border-radius:13px;background:linear-gradient(145deg,hsl(var(--h) 62% 50%),hsl(calc(var(--h) + 40) 58% 28%))}\n.head .tile svg{width:24px;height:24px}\n.head .ht{flex:1;min-width:0}\n.head h1{font-size:22px;font-weight:800;letter-spacing:-.01em;line-height:1.2;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.head p{font-size:13px;color:var(--muted);margin:1px 0 0;line-height:1.35}\n.head .acts{display:flex;gap:8px;flex-shrink:0;align-items:center;padding:0}\n.head .acts>button{min-width:40px;height:40px;display:inline-flex;align-items:center;justify-content:center;gap:6px;flex:none}\n.head .acts svg{width:19px;height:19px}\n.head .acts>button[hidden]{display:none}\n.head .acts .btn{border-width:1px;border-style:solid;border-radius:12px;padding:0 13px;font-size:14px;font-weight:600}\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style></head><body>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M9.2 3.2h5.6l.8 1.6H20a1 1 0 0 1 0 2h-1l-.9 12.3A2 2 0 0 1 16.1 21H7.9a2 2 0 0 1-2-1.9L5 6.8H4a1 1 0 0 1 0-2h4.4z\"/></svg></div>\n  <div class=\"ht\"><h1>Bin</h1><p id=\"sub\">Things you deleted, until you empty it</p></div>\n  <div class=\"acts\"><button class=\"btn danger\" id=\"emptyBtn\" hidden>Empty Bin</button></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Bin\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n\n<div class=\"seg\"><button class=\"on\" data-tab=\"deleted\">Deleted</button><button data-tab=\"rewind\">Rewind</button></div>\n\n<div class=\"bar\">\n  <span class=\"count\" id=\"count\"></span>\n  <span class=\"spacer\"></span>\n  <button class=\"btn\" id=\"selectBtn\" hidden>Select</button>\n  <button class=\"btn primary\" id=\"restoreSelBtn\" hidden>Restore</button>\n  <button class=\"btn danger\" id=\"deleteSelBtn\" hidden>Delete</button>\n</div>\n\n<div class=\"status\" id=\"status\"></div>\n<div class=\"card\" id=\"list\"></div>\n\n<p class=\"note\" id=\"noteRewind\" hidden>Rewind lists files that have been overwritten or deleted by an app, the Shell or the assistant. The workspace keeps the last few versions of each file in a hidden <code>.history</code> folder; Restore puts one back, and the current version is kept too, so a restore can itself be undone.</p>\n<p class=\"note\" id=\"noteDeleted\">The Bin is the hidden <code>.trash</code> folder in your shared workspace. The Shell app's rm and rmdir put things here instead of deleting them. Restore puts a file back where it came from; Delete and Empty Bin are final.</p>\n\n<div class=\"modal\" id=\"modal\" hidden><div class=\"sheet\" id=\"sheet\"></div></div>\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\n(function(){\n'use strict';\nvar $=function(id){return document.getElementById(id);};\nfunction haptic(k){try{if(window.myllmHaptic)window.myllmHaptic(k||'light');}catch(e){}}\n/* Looked up on each use, never kept: MyLLM can add its bridges after this script has run. */\nObject.defineProperty(window, \"files\", { configurable:true, get:function(){ return window.myllmFiles || null; } });\nvar TRASH='.trash';\nvar items=[],selecting=false,selected={},open=null;\nvar tab='deleted',rewindItems=[],openRewind=null;\n\nfunction esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\nfunction toast(t){var e=$('toast');e.textContent=t;e.classList.add('on');clearTimeout(toast._t);toast._t=setTimeout(function(){e.classList.remove('on');},1800);}\nfunction status(t){$('status').textContent=t||'';}\nfunction bytes(n){return n<1024?n+' B':n<1048576?(n/1024).toFixed(1)+' KB':(n/1048576).toFixed(1)+' MB';}\nfunction when(sec){var d=new Date(sec*1000);if(!(d.getTime()>0))return '';var now=new Date();var same=d.toDateString()===now.toDateString();return (same?'Today ':d.toLocaleDateString([],{day:'numeric',month:'short'})+' ')+d.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});}\nfunction inTrash(p){return p===TRASH||p.indexOf(TRASH+'/')===0;}\n/* .trash/notes/todo~20260904084617.md -> notes/todo.md */\nfunction homeOf(trashPath){return trashPath.slice(TRASH.length+1).replace(/~\\d{14}(?=\\.[^.\\/]+$|$)/,'');}\nfunction iconFor(name){var e=(name.split('.').pop()||'').toLowerCase();\n  return {md:'📝',txt:'📝',json:'🧩',csv:'📊',html:'🌐',js:'🧩',py:'🐍',log:'📜',sh:'⌨️',jpg:'🖼️',jpeg:'🖼️',png:'🖼️',pdf:'📕'}[e]||'📄';}\n\nfunction load(){\n  if(!files){$('list').innerHTML='<div class=\"empty\"><div class=\"big\">🗑️</div>Shared files are off.<br>Turn on \"Shared files\" in MyLLMos settings to use the Bin.</div>';return Promise.resolve();}\n  return files.list().then(function(list){\n    items=list.filter(function(f){return inTrash(f.path);}).map(function(f){return {path:f.path,home:homeOf(f.path),size:f.size||0,modified:f.modified||0};})\n      .sort(function(a,b){return b.modified-a.modified;});\n    for(var k in selected)if(!items.some(function(i){return i.path===k;}))delete selected[k];\n    render();\n  }).catch(function(e){status('Could not read the workspace: '+(e&&e.message||e));});\n}\nfunction render(){\n  $('noteRewind').hidden=tab!=='rewind';$('noteDeleted').hidden=tab==='rewind';\n  if(tab==='rewind'){renderRewind();return;}\n  var list=$('list'),total=items.reduce(function(a,b){return a+b.size;},0),nSel=Object.keys(selected).length;\n  $('emptyBtn').hidden=!items.length;\n  $('selectBtn').hidden=!items.length;$('selectBtn').textContent=selecting?'Done':'Select';\n  $('restoreSelBtn').hidden=!selecting;$('deleteSelBtn').hidden=!selecting;\n  $('restoreSelBtn').disabled=!nSel;$('deleteSelBtn').disabled=!nSel;\n  $('restoreSelBtn').textContent=nSel?'Restore ('+nSel+')':'Restore';$('deleteSelBtn').textContent=nSel?'Delete ('+nSel+')':'Delete';\n  $('count').hidden=selecting;\n  $('count').textContent=items.length?items.length+(items.length===1?' item':' items')+' · '+bytes(total):'';\n  if(!items.length){list.innerHTML='<div class=\"empty\"><div class=\"big\">🗑️</div>The Bin is empty.<br>Files removed with rm in the Shell app land here.</div>';return;}\n  list.innerHTML=items.map(function(it){\n    var name=it.home.split('/').pop(),dir=it.home.indexOf('/')>=0?it.home.slice(0,it.home.lastIndexOf('/'))+'/':'workspace root';\n    var isOpen=open===it.path;\n    return '<div class=\"row'+(selected[it.path]?' sel':'')+'\" data-path=\"'+esc(it.path)+'\"><i class=\"chk\"'+(selecting?'':' hidden')+'></i><div class=\"ico\">'+iconFor(name)+'</div>'+\n      '<div class=\"txt\"><b>'+esc(name)+'</b><span>from '+esc(dir)+' · '+bytes(it.size)+(it.modified?' · '+esc(when(it.modified)):'')+'</span></div></div>'+\n      (isOpen&&!selecting?'<div class=\"acts\"><button class=\"restore\" data-act=\"restore\">Restore</button><button class=\"peek\" data-act=\"peek\">Look inside</button><button class=\"kill\" data-act=\"kill\">Delete forever</button></div>':'');\n  }).join('');\n}\n\n/* ---------- rewind: previous versions of live files ---------- */\nfunction loadRewind(){\n  if(!files||!files.versions){rewindItems=[];render();return Promise.resolve();}\n  return files.list().then(function(list){\n    var live=list.filter(function(f){return !inTrash(f.path);});\n    return Promise.all(live.map(function(f){return files.versions(f.path).then(function(v){return {path:f.path,versions:v||[]};}).catch(function(){return {path:f.path,versions:[]};});}));\n  }).then(function(rows){\n    rewindItems=rows.filter(function(r){return r.versions.length;}).sort(function(a,b){return b.versions[0].stamp-a.versions[0].stamp;});\n    render();\n  }).catch(function(e){status('Could not read history: '+(e&&e.message||e));});\n}\nfunction renderRewind(){\n  var list=$('list');\n  $('emptyBtn').hidden=true;$('selectBtn').hidden=true;$('restoreSelBtn').hidden=true;$('deleteSelBtn').hidden=true;\n  $('count').hidden=false;\n  $('count').textContent=rewindItems.length?rewindItems.length+(rewindItems.length===1?' file with history':' files with history'):'';\n  if(!files||!files.versions){list.innerHTML='<div class=\"empty\"><div class=\"big\">⏪</div>Rewind needs the latest MyLLM build.</div>';return;}\n  if(!rewindItems.length){list.innerHTML='<div class=\"empty\"><div class=\"big\">⏪</div>No previous versions yet.<br>They appear the first time a file is overwritten or deleted.</div>';return;}\n  list.innerHTML=rewindItems.map(function(it){\n    var name=it.path.split('/').pop(),dir=it.path.indexOf('/')>=0?it.path.slice(0,it.path.lastIndexOf('/'))+'/':'workspace root';\n    var isOpen=openRewind===it.path,n=it.versions.length;\n    return '<div class=\"row\" data-rpath=\"'+esc(it.path)+'\"><div class=\"ico\">'+iconFor(name)+'</div><div class=\"txt\"><b>'+esc(name)+'</b><span>'+esc(dir)+' · '+n+(n===1?' version':' versions')+' · latest '+esc(when(it.versions[0].stamp/1000))+'</span></div></div>'+\n      (isOpen?it.versions.map(function(v,i){return '<div class=\"vrow\"><span class=\"when\">#'+(i+1)+' · '+esc(when(v.stamp/1000))+' · '+bytes(v.size)+'</span><button data-vact=\"peek\" data-stamp=\"'+v.stamp+'\">Look</button><button class=\"primary\" data-vact=\"restore\" data-stamp=\"'+v.stamp+'\">Restore</button></div>';}).join(''):'');\n  }).join('');\n}\nfunction restoreVersion(path,stamp){\n  files.restoreVersion(path,stamp).then(function(){haptic('success');toast('Restored '+path.split('/').pop());return loadRewind();})\n    .catch(function(e){status('Restore failed: '+(e&&e.message||e));});\n}\nfunction peekVersion(path,stamp){\n  files.readVersion(path,stamp).then(function(t){\n    var body=t==null?'(could not read)':String(t);\n    sheet(path.split('/').pop()+' · '+when(stamp/1000),null,[{label:'Restore this version',value:'restore',cls:'primary'},{label:'Close',value:null}],\n      '<div class=\"preview\">'+esc(body.length>4000?body.slice(0,4000)+'\\n…':body)+'</div>').then(function(v){if(v==='restore')restoreVersion(path,stamp);});\n  });\n}\n\n/* ---------- actions ---------- */\nfunction sheet(title,text,opts,extraHTML){\n  $('sheet').innerHTML='<h3>'+esc(title)+'</h3>'+(text?'<p>'+esc(text)+'</p>':'')+(extraHTML||'')+'<div class=\"opts\">'+opts.map(function(o,i){return '<button class=\"'+(o.cls||'')+'\" data-i=\"'+i+'\">'+esc(o.label)+'</button>';}).join('')+'</div>';\n  $('modal').hidden=false;\n  return new Promise(function(res){\n    $('sheet').onclick=function(e){var b=e.target.closest('button[data-i]');if(!b)return;$('modal').hidden=true;res(opts[+b.dataset.i].value);};\n    $('modal').onclick=function(e){if(e.target===$('modal')){$('modal').hidden=true;res(null);}};\n  });\n}\nfunction exists(path){return files.list().then(function(l){return l.some(function(f){return f.path===path;});});}\nfunction pruneEmptyFolders(){\n  if(!files.folders)return Promise.resolve();\n  return files.list().then(function(list){return files.folders().then(function(folders){\n    var dirs=folders.filter(function(d){return inTrash(d)&&d!==TRASH;}).sort(function(a,b){return b.length-a.length;});\n    var gone={};\n    return dirs.reduce(function(p,d){return p.then(function(){\n      var busy=list.some(function(f){return f.path.indexOf(d+'/')===0;})||folders.some(function(x){return x!==d&&!gone[x]&&x.indexOf(d+'/')===0;});\n      if(busy)return;return files.removeFolder(d,false).then(function(){gone[d]=1;}).catch(function(){});\n    });},Promise.resolve()).then(function(){\n      var anyLeft=list.some(function(f){return inTrash(f.path);})||folders.some(function(d){return d!==TRASH&&inTrash(d)&&!gone[d];});\n      if(!anyLeft&&folders.indexOf(TRASH)>=0)return files.removeFolder(TRASH,false).catch(function(){});\n    });\n  });}).catch(function(){});\n}\nfunction restoreOne(it,policy){\n  return exists(it.home).then(function(clash){\n    var dest=it.home;\n    if(clash){\n      if(policy==='replace'){/* fall through: the store overwrites */}\n      else if(policy==='both'){var dot=dest.lastIndexOf('.'),slash=dest.lastIndexOf('/');dest=dot>slash?dest.slice(0,dot)+' (restored)'+dest.slice(dot):dest+' (restored)';}\n      else return sheet('A file is already there',it.home+' exists in the workspace. What should happen?',[\n        {label:'Keep both (restore as \"… (restored)\")',value:'both',cls:'primary'},{label:'Replace the existing file',value:'replace',cls:'danger'},{label:'Cancel',value:null}]).then(function(v){if(!v)return false;return restoreOne(it,v);});\n    }\n    return files.move(it.path,dest).then(function(){return true;});\n  });\n}\nfunction restore(list){\n  var done=0;\n  return list.reduce(function(p,it){return p.then(function(){return restoreOne(it).then(function(ok){if(ok)done++;});});},Promise.resolve())\n    .then(function(){return pruneEmptyFolders();}).then(function(){haptic('success');toast(done===1?'Restored '+list[0].home.split('/').pop():'Restored '+done);selected={};open=null;return load();})\n    .catch(function(e){status('Restore failed: '+(e&&e.message||e));return load();});\n}\nfunction destroy(list){\n  return sheet(list.length===1?'Delete forever?':'Delete '+list.length+' items forever?',(list.length===1?list[0].home:'')+' There is no way back from this.',\n    [{label:'Delete forever',value:'yes',cls:'danger'},{label:'Cancel',value:null}]).then(function(v){\n    if(!v)return;\n    return list.reduce(function(p,it){return p.then(function(){return files.remove(it.path);});},Promise.resolve())\n      .then(function(){return pruneEmptyFolders();}).then(function(){haptic('warning');toast('Deleted');selected={};open=null;return load();})\n      .catch(function(e){status('Delete failed: '+(e&&e.message||e));return load();});\n  });\n}\nfunction emptyBin(){\n  var n=items.length;\n  sheet('Empty the Bin?',n+(n===1?' item':' items')+' will be deleted for good. There is no undo.',[{label:'Empty Bin',value:'yes',cls:'danger'},{label:'Cancel',value:null}]).then(function(v){\n    if(!v)return;\n    return files.removeFolder(TRASH,true).then(function(){haptic('warning');toast('Bin emptied');selected={};open=null;return load();})\n      .catch(function(e){status('Could not empty: '+(e&&e.message||e));return load();});\n  });\n}\nfunction peek(it){\n  files.read(it.path).then(function(t){\n    var body=t==null?'(could not read)':String(t);\n    sheet(it.home.split('/').pop(),null,[{label:'Restore',value:'restore',cls:'primary'},{label:'Close',value:null}],\n      '<div class=\"preview\">'+esc(body.length>4000?body.slice(0,4000)+'\\n…':body)+'</div>').then(function(v){if(v==='restore')restore([it]);});\n  });\n}\n\n/* ---------- wiring ---------- */\ndocument.querySelector('.seg').addEventListener('click',function(e){\n  var b=e.target.closest('button[data-tab]');if(!b)return;\n  tab=b.dataset.tab;document.querySelectorAll('.seg button').forEach(function(x){x.classList.toggle('on',x===b);});\n  selecting=false;selected={};open=null;openRewind=null;haptic('selection');\n  if(tab==='rewind')loadRewind();else load();\n});\n$('list').addEventListener('click',function(e){\n  if(tab==='rewind'){\n    var vb=e.target.closest('button[data-vact]');\n    if(vb){var row=vb.closest('.vrow');var holder=row;while(holder&&!holder.dataset.rpath)holder=holder.previousElementSibling;var rp=holder?holder.dataset.rpath:null;if(!rp)return;\n      if(vb.dataset.vact==='restore')restoreVersion(rp,+vb.dataset.stamp);else peekVersion(rp,+vb.dataset.stamp);return;}\n    var rr=e.target.closest('.row');if(!rr)return;openRewind=openRewind===rr.dataset.rpath?null:rr.dataset.rpath;haptic('selection');render();return;\n  }\n  var act=e.target.closest('button[data-act]');\n  if(act){var row=act.closest('.acts').previousElementSibling;var it=items.filter(function(i){return i.path===row.dataset.path;})[0];if(!it)return;\n    if(act.dataset.act==='restore')restore([it]);else if(act.dataset.act==='kill')destroy([it]);else peek(it);return;}\n  var r=e.target.closest('.row');if(!r)return;\n  if(selecting){if(selected[r.dataset.path])delete selected[r.dataset.path];else selected[r.dataset.path]=1;haptic('selection');render();return;}\n  open=open===r.dataset.path?null:r.dataset.path;haptic('selection');render();\n});\n$('selectBtn').addEventListener('click',function(){selecting=!selecting;selected={};open=null;haptic('light');render();});\n$('restoreSelBtn').addEventListener('click',function(){var l=items.filter(function(i){return selected[i.path];});if(l.length)restore(l);});\n$('deleteSelBtn').addEventListener('click',function(){var l=items.filter(function(i){return selected[i.path];});if(l.length)destroy(l);});\n$('emptyBtn').addEventListener('click',emptyBin);\ndocument.addEventListener('visibilitychange',function(){if(!document.hidden){if(tab==='rewind')loadRewind();else load();}});\nload();\n})();\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes.\n   The spacer keeps the header clear of the status bar / Dynamic Island. It is\n   live CSS — env(safe-area-inset-top) — not a measured number: the inset is\n   still 0 when the page loads and only grows once MyLLM's bar has gone (v1\n   measured once, so the title sat under the island). If the page's own styles\n   already pad the header down by the inset, the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  /* Does any rule that applies to the header or an ancestor already use the top inset? */\n  function pageHandlesInset(head){\n    var chain = [], n, found = false;\n    for (n = head; n && n.nodeType === 1; n = n.parentElement) chain.push(n);\n    function walk(rules){\n      for (var i = 0; i < rules.length && !found; i++){\n        var r = rules[i];\n        if (r.cssRules && !r.selectorText) { walk(r.cssRules); continue; }\n        if (!r.selectorText || !/safe-area-inset-top/.test(r.cssText) || !/(padding|margin|top)\\s*:/.test(r.cssText)) continue;\n        if (/\\.imm-safe/.test(r.selectorText)) continue;\n        for (var k = 0; k < chain.length; k++){\n          try { if (chain[k].matches(r.selectorText)) { found = true; break; } } catch(e){}\n        }\n      }\n    }\n    for (var s = 0; s < document.styleSheets.length && !found; s++){\n      try { walk(document.styleSheets[s].cssRules); } catch(e){}\n    }\n    for (n = head; n && n.nodeType === 1 && !found; n = n.parentElement){\n      if (/safe-area-inset-top/.test(n.getAttribute(\"style\") || \"\")) found = true;\n    }\n    return found;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = (document.body.classList.contains(\"imm\") && !pageHandlesInset(head)) ? \"env(safe-area-inset-top)\" : \"0px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script>\n</body></html>\n"}