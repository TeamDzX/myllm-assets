{"name": "Pop-It", "html": "<!doctype html>\n<!--\n  Pop-It — MyLLMos App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\">\n<style>:root{--build-id:\"de23f27ef9\";color-scheme:light dark;--bg:#f2f2f7;--fg:#111}\n@media(prefers-color-scheme:dark){:root{--bg:#000;--fg:#eee}}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none}\nhtml,body{margin:0;height:100%;overflow:hidden}\nbody{font-family:-apple-system,system-ui,sans-serif;background:var(--bg);color:var(--fg);display:flex;flex-direction:column;align-items:center;padding:calc(12px + env(safe-area-inset-top)) 12px calc(12px + env(safe-area-inset-bottom));touch-action:manipulation}\nh1{font-size:19px;margin:0 0 2px;font-weight:700}\n.sub{font-size:12px;opacity:.55;margin-bottom:8px}\n.grid{flex:1;display:grid;gap:9px;width:100%;max-width:460px;align-content:center}\n.b{aspect-ratio:1;border-radius:50%;border:none;position:relative;transition:transform .07s,box-shadow .07s,filter .07s;\n  box-shadow:inset 0 -6px 10px rgba(0,0,0,.28),inset 0 4px 8px rgba(255,255,255,.55),0 2px 4px rgba(0,0,0,.15)}\n.b.popped{transform:scale(.9);filter:brightness(.82);\n  box-shadow:inset 0 6px 12px rgba(0,0,0,.45),inset 0 -3px 6px rgba(255,255,255,.18)}\n.bar{display:flex;gap:10px;margin-top:10px}\n.bar button{border:0;background:rgba(127,127,127,.16);color:var(--fg);border-radius:15px;padding:11px 20px;font-size:15px;font-weight:600}\n.bar button:active{background:rgba(127,127,127,.32)}\n.count{font-size:12px;opacity:.5;margin-top:6px;min-height:14px}\n</style></head><body>\n<h1>🟣 Pop-It</h1>\n<div class=\"sub\">Tap the bubbles to pop them — pop, pop, pop!</div>\n<div class=\"grid\" id=\"grid\"></div>\n<div class=\"count\" id=\"count\"></div>\n<div class=\"bar\"><button onclick=\"flip()\">Flip / Reset</button></div>\n<script>\nfunction haptic(s){if(window.myllmHaptic)try{myllmHaptic(s)}catch(e){}}\nvar COLS=6,ROWS=8,N=COLS*ROWS,state=new Array(N).fill(false);\nvar HUES=[0,30,55,120,200,260,300];\nvar grid=document.getElementById('grid'),countEl=document.getElementById('count');\ngrid.style.gridTemplateColumns='repeat('+COLS+',1fr)';\nvar actx=null;\nfunction pop(rising){\n  try{\n    if(!actx){var AC=window.AudioContext||window.webkitAudioContext;actx=new AC()}\n    if(actx.state==='suspended')actx.resume();\n    var o=actx.createOscillator(),g=actx.createGain(),t=actx.currentTime;\n    o.type='triangle';\n    var f=rising?420:260;o.frequency.setValueAtTime(f,t);o.frequency.exponentialRampToValueAtTime(f*(rising?2.4:0.6),t+0.07);\n    g.gain.setValueAtTime(0.0001,t);g.gain.exponentialRampToValueAtTime(0.28,t+0.005);g.gain.exponentialRampToValueAtTime(0.0001,t+0.13);\n    o.connect(g);g.connect(actx.destination);o.start(t);o.stop(t+0.15);\n  }catch(e){}\n}\nfunction build(){\n  grid.innerHTML='';\n  for(var i=0;i<N;i++){\n    (function(i){\n      var b=document.createElement('button');b.className='b'+(state[i]?' popped':'');\n      var hue=HUES[Math.floor(i/COLS)%HUES.length];\n      b.style.background='radial-gradient(circle at 38% 32%,hsl('+hue+',90%,72%),hsl('+hue+',75%,52%))';\n      b.addEventListener('touchstart',function(e){e.preventDefault();tap(i,b)},{passive:false});\n      b.addEventListener('mousedown',function(e){e.preventDefault();tap(i,b)});\n      grid.appendChild(b);\n    })(i);\n  }\n}\nfunction tap(i,b){\n  state[i]=!state[i];\n  b.classList.toggle('popped',state[i]);\n  pop(!state[i]);\n  haptic(state[i]?'medium':'light');\n  var done=state.filter(Boolean).length;\n  countEl.textContent=done+' / '+N+' popped';\n  if(done===N){haptic('success');countEl.textContent='All popped! 🎉  Tap Flip to play again';}\n}\nfunction flip(){\n  for(var i=0;i<N;i++)state[i]=false;\n  build();countEl.textContent='';haptic('selection');\n}\nbuild();\n</script></body></html>\n", "kind": "html", "iconSymbol": "circle.grid.3x3.fill", "iconColor": "pink"}