{"name": "Pop-It", "html": "<!doctype html>\n<!--\n  Pop-It — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover\">\n<title>Pop-It</title>\n<style>:root{--build-id:\"de23f27ef9\";color-scheme:light dark}\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; -webkit-user-select:none; user-select:none; }\n  html,body{ height:100%; overflow:hidden; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:#0b0b10; color:#fff; touch-action:manipulation; overscroll-behavior:none; }\n\n  /* The stage: a soft pink backdrop, kept quiet so the rainbow board is the\n     only bright thing on screen. Two layers, dark and light, cross-faded slowly. */\n  .stage{ position:fixed; inset:0; --h:330; color:#fff; }\n  .bg{ position:absolute; inset:0; transition:opacity 1.4s ease; }\n  .bg.d{ background:radial-gradient(120% 90% at 20% 10%, hsl(var(--h) 46% 26%), transparent 60%),\n      radial-gradient(120% 90% at 85% 95%, hsl(calc(var(--h) - 60) 42% 22%), transparent 62%), #0b0b10; }\n  .bg.l{ opacity:0; background:radial-gradient(120% 90% at 20% 0%, hsl(var(--h) 78% 90%), transparent 60%),\n      radial-gradient(120% 90% at 85% 100%, hsl(calc(var(--h) - 60) 70% 91%), transparent 62%), #f6f4f8; }\n  .lite{ color:#15151a; } .lite .bg.l{ opacity:1; } .lite .bg.d{ opacity:0; }\n\n  .col{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center;\n    padding:calc(12px + env(safe-area-inset-top)) calc(14px + env(safe-area-inset-right)) calc(16px + env(safe-area-inset-bottom)) calc(14px + env(safe-area-inset-left)); }\n  .top{ width:100%; max-width:560px; height:58px; display:flex; align-items:center; justify-content:space-between; flex-shrink:0; }\n  .top .side{ width:112px; display:flex; }\n  .lbl{ font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; opacity:.62; }\n  .glass{ border:1px solid rgba(255,255,255,.16); background:rgba(255,255,255,.12); color:inherit;\n    -webkit-backdrop-filter:blur(18px); backdrop-filter:blur(18px); }\n  .lite .glass{ border-color:rgba(0,0,0,.09); background:rgba(255,255,255,.66); }\n  svg{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; }\n  .big{ height:58px; min-width:58px; border-radius:99px; padding:0 24px; font-size:16.5px; font-weight:750;\n    display:inline-flex; align-items:center; justify-content:center; gap:9px; }\n  .big:active{ transform:scale(.96); }\n  #bDone{ opacity:0; pointer-events:none; transition:opacity .8s ease; }\n  .open #bDone{ opacity:1; pointer-events:auto; }\n\n  /* The board sits in a glass tray, like the real toy. */\n  .mid{ flex:1; min-height:0; width:100%; display:flex; align-items:center; justify-content:center; margin:6px 0; }\n  .tray{ border-radius:calc(var(--cell,48px) * .62); padding:var(--pad,14px); box-shadow:0 24px 60px rgba(0,0,0,.35); transition:box-shadow 1.4s ease; }\n  .lite .tray{ box-shadow:0 22px 50px rgba(20,20,40,.14); }\n  .grid{ display:grid; gap:var(--gap,9px); grid-template-columns:repeat(6, var(--cell,48px)); grid-auto-rows:var(--cell,48px); }\n  .wide .grid{ grid-auto-flow:column; grid-template-columns:none; grid-template-rows:repeat(6, var(--cell,48px)); grid-auto-columns:var(--cell,48px); }  /* the same board on its side: nothing is lost on rotation */\n  .b{ border-radius:50%; border:none; position:relative; transition:transform .07s, box-shadow .07s, filter .07s;\n    box-shadow:inset 0 -6px 10px rgba(0,0,0,.28), inset 0 4px 8px rgba(255,255,255,.55), 0 2px 4px rgba(0,0,0,.15); }\n  .b.popped{ transform:scale(.9); filter:brightness(.82);\n    box-shadow:inset 0 6px 12px rgba(0,0,0,.45), inset 0 -3px 6px rgba(255,255,255,.18); }\n  .b.squish{ animation:squish .2s ease; }\n  @keyframes squish{ 0%{ transform:scale(1); } 45%{ transform:scale(.8); } 100%{ transform:scale(.9); } }\n  .b.spring{ animation:spring .24s ease; }\n  @keyframes spring{ 0%{ transform:scale(.9); } 55%{ transform:scale(1.05); } 100%{ transform:scale(1); } }\n\n  .foot{ width:100%; max-width:560px; flex-shrink:0; display:flex; flex-direction:column; align-items:center; gap:10px; }\n  .count{ font-size:14px; font-weight:650; opacity:.66; min-height:20px; text-align:center; font-variant-numeric:tabular-nums; }\n\n  @media (max-height:520px){                       /* phone on its side: Done left, board middle, Flip right */\n    .col{ flex-direction:row; align-items:stretch; padding-top:calc(10px + env(safe-area-inset-top)); padding-bottom:calc(10px + env(safe-area-inset-bottom)); }\n    .top{ width:118px; height:auto; flex-direction:column; align-items:flex-start; justify-content:flex-start; gap:12px; }\n    .top .side:last-child{ display:none; } .top .side{ order:2; } .lbl{ order:1; margin-top:6px; }\n    .mid{ margin:0 8px; } .foot{ width:140px; justify-content:center; } .big{ padding:0 18px; font-size:15.5px; }\n  }\n  @media (prefers-reduced-motion:reduce){ .b.squish, .b.spring{ animation:none; } }\n  @media (max-width:340px){ .top .side{ width:60px; } #bDone{ padding:0; width:56px; } #bDone span{ display:none; } }\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-close\" viewBox=\"0 0 24 24\"><path d=\"M6.4 5a1 1 0 0 0-1.4 1.4L10.6 12 5 17.6A1 1 0 0 0 6.4 19l5.6-5.6 5.6 5.6a1 1 0 0 0 1.4-1.4L13.4 12 19 6.4A1 1 0 0 0 17.6 5L12 10.6z\"/></symbol>\n  <symbol id=\"i-flip\" viewBox=\"0 0 24 24\"><path d=\"M12 5V2.6a.6.6 0 0 0-1-.45L7.2 5.55a.6.6 0 0 0 0 .9L11 9.85a.6.6 0 0 0 1-.45V7a5.5 5.5 0 1 1-5.5 5.5 1 1 0 0 0-2 0A7.5 7.5 0 1 0 12 5z\"/></symbol>\n</defs></svg>\n\n<div class=\"stage\" id=\"stage\">\n  <div class=\"bg d\"></div><div class=\"bg l\"></div>\n  <div class=\"col\">\n    <div class=\"top\">\n      <div class=\"side\"><button class=\"glass big\" id=\"bDone\" aria-label=\"Close full screen\"><svg><use href=\"#i-close\"/></svg><span>Done</span></button></div>\n      <div class=\"lbl\">Pop-It</div>\n      <div class=\"side\"></div>\n    </div>\n    <div class=\"mid\" id=\"mid\"><div class=\"tray glass\"><div class=\"grid\" id=\"grid\"></div></div></div>\n    <div class=\"foot\">\n      <div class=\"count\" id=\"count\">Tap the bubbles to pop them — pop, pop, pop!</div>\n      <button class=\"glass big\" id=\"bFlip\"><svg><use href=\"#i-flip\"/></svg>Flip / Reset</button>\n    </div>\n  </div>\n</div>\n\n<script>\nfunction el(i){ return document.getElementById(i); }\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction haptic(s){ if (window.myllmHaptic) try { myllmHaptic(s); } catch(e){} }\n\nvar COLS = 6, ROWS = 8, N = COLS * ROWS, state = new Array(N).fill(false);\nvar HUES = [0,30,55,120,200,260,300];\nvar INTRO = \"Tap the bubbles to pop them — pop, pop, pop!\";\nvar grid = el(\"grid\"), countEl = el(\"count\"), cells = [], boardOpen = false;\n\n/* ---------- look ---------- */\nfunction isLight(){ return !(window.matchMedia && matchMedia(\"(prefers-color-scheme: dark)\").matches); }\n/* Once you start popping, the board takes the whole display. Where MyLLM can't\n   hide its own title bar, a dark stage under a white bar looks cut in half —\n   so in light mode, without myllmImmersive, the stage stays light. */\nfunction syncLook(){\n  var s = el(\"stage\");\n  s.classList.toggle(\"lite\", isLight() && !(boardOpen && window.myllmImmersive));\n  s.classList.toggle(\"open\", boardOpen);\n}\nfunction syncChrome(){\n  if (!window.myllmImmersive) return;\n  try { myllmImmersive(boardOpen, {keepAwake:false}).catch(function(){}); } catch(_){}   /* busy hands keep the screen awake by themselves */\n}\nfunction openBoard(){ if (boardOpen) return; boardOpen = true; syncLook(); syncChrome(); }\nfunction closeBoard(){ if (!boardOpen) return; haptic(\"light\"); boardOpen = false; syncLook(); syncChrome(); }\n\n/* The bubbles are sized from the room there is: six across and eight down on\n   a phone held upright, the same board turned on its side when it's wider. */\nfunction fit(){\n  var m = el(\"mid\"), w = m.clientWidth, h = m.clientHeight, wide = w > h * 1.1;\n  var cols = wide ? ROWS : COLS, rows = wide ? COLS : ROWS;\n  var cell = Math.min(w / (cols + (cols - 1) * .19 + .6), h / (rows + (rows - 1) * .19 + .6), 92);\n  cell = Math.max(28, Math.floor(cell));\n  var s = el(\"stage\").style;\n  s.setProperty(\"--cell\", cell + \"px\"); s.setProperty(\"--gap\", Math.round(cell * .19) + \"px\"); s.setProperty(\"--pad\", Math.round(cell * .3) + \"px\");\n  el(\"stage\").classList.toggle(\"wide\", wide);\n}\n\n/* ---------- sound ---------- */\nvar actx = null;\nfunction pop(rising){\n  try {\n    if (!actx){ var AC = window.AudioContext || window.webkitAudioContext; actx = new AC(); }\n    if (actx.state === \"suspended\") actx.resume();\n    var o = actx.createOscillator(), g = actx.createGain(), t = actx.currentTime;\n    o.type = \"triangle\";\n    var f = rising ? 420 : 260; o.frequency.setValueAtTime(f, t); o.frequency.exponentialRampToValueAtTime(f * (rising ? 2.4 : 0.6), t + 0.07);\n    g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.28, t + 0.005); g.gain.exponentialRampToValueAtTime(0.0001, t + 0.13);\n    o.connect(g); g.connect(actx.destination); o.start(t); o.stop(t + 0.15);\n  } catch(e){}\n}\n\n/* ---------- board ---------- */\nfunction build(){\n  grid.innerHTML = \"\"; cells = [];\n  for (var i = 0; i < N; i++){\n    (function(i){\n      var b = document.createElement(\"button\"); b.className = \"b\" + (state[i] ? \" popped\" : \"\");\n      b.setAttribute(\"aria-label\", \"Bubble\"); b.setAttribute(\"aria-pressed\", state[i]);\n      var hue = HUES[Math.floor(i / COLS) % HUES.length];\n      b.style.background = \"radial-gradient(circle at 38% 32%,hsl(\" + hue + \",90%,72%),hsl(\" + hue + \",75%,52%))\";\n      b.addEventListener(\"touchstart\", function(e){ e.preventDefault(); tap(i, b); }, {passive:false});\n      b.addEventListener(\"mousedown\", function(e){ e.preventDefault(); tap(i, b); });\n      grid.appendChild(b); cells.push(b);\n    })(i);\n  }\n}\nfunction tap(i, b){\n  openBoard();\n  state[i] = !state[i];\n  b.classList.remove(\"squish\", \"spring\"); void b.offsetWidth;\n  b.classList.toggle(\"popped\", state[i]); b.classList.add(state[i] ? \"squish\" : \"spring\");\n  b.setAttribute(\"aria-pressed\", state[i]);\n  pop(!state[i]);\n  haptic(state[i] ? \"medium\" : \"light\");\n  var done = state.filter(Boolean).length;\n  countEl.textContent = done + \" / \" + N + \" popped\";\n  if (done === N){ haptic(\"success\"); countEl.textContent = \"All popped! Tap Flip to play again\"; }\n}\nfunction flip(){\n  haptic(\"selection\");\n  for (var i = 0; i < N; i++){\n    if (!state[i]) continue;\n    state[i] = false;\n    (function(i){                                  /* the bubbles come back row by row, not all at once */\n      setTimeout(function(){\n        if (state[i]) return;                      /* popped again in the meantime */\n        cells[i].classList.remove(\"popped\", \"squish\", \"spring\"); cells[i].setAttribute(\"aria-pressed\", false);\n      }, Math.floor(i / COLS) * 40);\n    })(i);\n  }\n  countEl.textContent = \"\";\n}\nel(\"bFlip\").onclick = flip;\nel(\"bDone\").onclick = closeBoard;\n\nwindow.addEventListener(\"resize\", fit);\ndocument.addEventListener(\"visibilitychange\", function(){\n  if (!document.hidden && boardOpen) syncChrome();     /* MyLLM puts its bars back when the app is left */\n});\nif (window.matchMedia){\n  var mq = matchMedia(\"(prefers-color-scheme: dark)\");\n  if (mq.addEventListener) mq.addEventListener(\"change\", syncLook); else if (mq.addListener) mq.addListener(syncLook);\n}\n\n/* ---------- boot ---------- */\nsyncLook(); fit(); build();\n</script></body></html>\n", "kind": "html", "iconSymbol": "circle.grid.3x3.fill", "iconColor": "pink"}