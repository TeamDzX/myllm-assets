{"name": "Plant Doctor", "html": "<!doctype html>\n<!--\n  Plant Doctor — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>:root{--build-id:\"5ebac3aa46\";color-scheme:light dark}\n*{box-sizing:border-box}\nbody{font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);margin:0;padding:16px;background:var(--myllm-bg,#f2f2f7);color:var(--myllm-text,#111)}\nh1{font-size:22px;margin:0 0 2px}\n.sub{font-size:13px;color:var(--myllm-muted,#8a8a8e);margin:0 0 16px}\n.tile{width:100%;border:0;border-radius:16px;padding:18px;font-size:17px;font-weight:700;color:#fff;margin-bottom:12px;text-align:left}\n.tile span{font-size:26px;margin-right:10px;vertical-align:middle}\n.id{background:linear-gradient(135deg,#34c759,#248a3d)}\n.dx{background:linear-gradient(135deg,#0a84ff,#0060df)}\n.answer{background:var(--myllm-surface,#fff);border-radius:16px;padding:16px;margin-top:8px}\n.answer h2{font-size:17px;margin:0 0 8px}\n.answer p{font-size:16px;line-height:1.55;white-space:pre-wrap;margin:0}\n.answer button{margin-top:14px;width:100%;border:0;border-radius:10px;padding:11px;font-size:14px;font-weight:600;background:rgba(52,199,89,.16);color:#248a3d}\n.note{color:var(--myllm-muted,#8a8a8e);font-size:14px;text-align:center;margin-top:18px;line-height:1.5;padding:0 6px}\n@media(min-width:768px){body{max-width:680px;margin-left:auto;margin-right:auto}}\n</style></head><body>\n<h1>🌿 Plant Doctor</h1>\n<p class=\"sub\">Point your camera at a plant — get an ID or a diagnosis.</p>\n<div id=\"home\">\n  <button class=\"tile id\" onclick=\"ask('identify')\"><span>🔍</span>Identify a plant</button>\n  <button class=\"tile dx\" onclick=\"ask('diagnose')\"><span>🩺</span>What's wrong with my plant?</button>\n  <p class=\"note\" id=\"hint\">Uses your camera and your AI, privately on your device. Needs the latest MyLLM with “Allow apps to use the AI” on.</p>\n</div>\n<div id=\"out\"></div>\n\n<script>\nvar VISION = window.myllmVision || null;\nvar haptic = window.myllmHaptic || function(){};\n\nvar PROMPTS = {\n  identify: 'You are an expert botanist. Identify the plant in this photo. Reply concisely with: common name, scientific name, and 3 short care tips (light, water, one thing to watch for). If the image is not a plant, say so politely.',\n  diagnose: 'You are a plant-care expert. Examine this plant photo and diagnose likely problems (pests, over/under-watering, light, nutrients, disease). Give the 2-3 most likely causes, each with a short fix. Be concise and practical.'\n};\n\nfunction el(id){return document.getElementById(id)}\n\nfunction ask(mode){\n  if(!VISION){ el('hint').textContent='This needs the latest MyLLM with “Allow apps to use the AI” enabled in Settings.'; return; }\n  haptic('light');\n  VISION(PROMPTS[mode]).then(function(answer){\n    if(answer == null) return; // cancelled\n    show(mode === 'identify' ? 'Plant ID' : 'Diagnosis', answer);\n  }).catch(function(e){\n    show('Hmm', (e && e.message) ? e.message : 'Something went wrong.');\n  });\n}\n\nfunction show(title, text){\n  el('home').style.display='none';\n  var d = document.createElement('div'); d.className='answer';\n  d.innerHTML='<h2></h2><p></p><button>← Check another plant</button>';\n  d.querySelector('h2').textContent = '🌿 ' + title;\n  d.querySelector('p').textContent = text;\n  d.querySelector('button').onclick = function(){ el('out').innerHTML=''; el('home').style.display='block'; };\n  el('out').innerHTML=''; el('out').appendChild(d);\n  window.scrollTo(0,0);\n}\n</script></body></html>\n"}