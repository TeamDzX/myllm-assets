Xe]6s2 4f14 5d10 6p4~2~197~8.417~1.9~+4, +2~S~527~1235~9.32~4~1898~2,8,18,32,18,6~|At~Astatine~209.98715~754F45~[Xe]6s2 4f14 5d10 6p5~2.2~202~9.5~2.8~7, 5, 3, 1, -1~S~575~~7~6~1940~2,8,18,32,18,7~|Rn~Radon~222.01758~428296~[Xe]6s2 4f14 5d10 6p6~~220~10.745~~0~G~202~211.45~0.00973~7~1900~2,8,18,32,18,8~|Fr~Francium~223.01973~420066~[Rn]7s1~0.7~348~3.9~0.47~+1~S~300~~~0~1939~2,8,18,32,18,8,1~|Ra~Radium~226.02541~007D00~[Rn]7s2~0.9~283~5.279~~+2~S~973~1413~5~1~1898~2,8,18,32,18,8,2~|Ac~Actinium~227.02775~70ABFA~[Rn]7s2 6d1~1.1~260~5.17~~+3~S~1324~3471~10.07~9~1899~2,8,18,32,18,9,2~|Th~Thorium~232.038~00BAFF~[Rn]7s2 6d2~1.3~237~6.08~~+4~S~2023~5061~11.72~9~1828~2,8,18,32,18,10,2~|Pa~Protactinium~231.03588~00A1FF~[Rn]7s2 5f2 6d1~1.5~243~5.89~~+5, +4~S~1845~~15.37~9~1913~2,8,18,32,20,9,2~|U~Uranium~238.0289~008FFF~[Rn]7s2 5f3 6d1~1.38~240~6.194~~+6, +5, +4, +3~S~1408~4404~18.95~9~1789~2,8,18,32,21,9,2~|Np~Neptunium~237.048172~0080FF~[Rn]7s2 5f4 6d1~1.36~221~6.266~~+6, +5, +4, +3~S~917~4175~20.25~9~1940~2,8,18,32,22,9,2~|Pu~Plutonium~244.06420~006BFF~[Rn]7s2 5f6~1.28~243~6.06~~+6, +5, +4, +3~S~913~3501~19.84~9~1940~2,8,18,32,24,8,2~|Am~Americium~243.061380~545CF2~[Rn]7s2 5f7~1.3~244~5.993~~+6, +5, +4, +3~S~1449~2284~13.69~9~1944~2,8,18,32,25,8,2~|Cm~Curium~247.07035~785CE3~[Rn]7s2 5f7 6d1~1.3~245~6.02~~+3~S~1618~3400~13.51~9~1944~2,8,18,32,25,9,2~|Bk~Berkelium~247.07031~8A4FE3~[Rn]7s2 5f9~1.3~244~6.23~~+4, +3~S~1323~~14~9~1949~2,8,18,32,27,8,2~|Cf~Californium~251.07959~A136D4~[Rn]7s2 5f10~1.3~245~6.30~~+3~S~1173~~~9~1950~2,8,18,32,28,8,2~|Es~Einsteinium~252.0830~B31FD4~[Rn]7s2 5f11~1.3~245~6.42~~+3~S~1133~~~9~1952~2,8,18,32,29,8,2~|Fm~Fermium~257.09511~B31FBA~[Rn] 5f12 7s2~1.3~~6.50~~+3~S~1800~~~9~1952~2,8,18,32,30,8,2~|Md~Mendelevium~258.09843~B30DA6~[Rn]7s2 5f13~1.3~~6.58~~+3, +2~S~1100~~~9~1955~2,8,18,32,31,8,2~|No~Nobelium~259.10100~BD0D87~[Rn]7s2 5f14~1.3~~6.65~~+3, +2~S~1100~~~9~1957~2,8,18,32,32,8,2~|Lr~Lawrencium~266.120~C70066~[Rn]7s2 5f14 6d1~1.3~~~~+3~S~1900~~~9~1961~2,8,18,32,32,9,2~|Rf~Rutherfordium~267.122~CC0059~[Rn]7s2 5f14 6d2~~~~~+4~S~~~~2~1964~2,8,18,32,32,10,2~|Db~Dubnium~268.126~D1004F~[Rn]7s2 5f14 6d3~~~~~5, 4, 3~S~~~~2~1967~2,8,18,32,32,11,2~|Sg~Seaborgium~269.128~D90045~[Rn]7s2 5f14 6d4~~~~~6, 5, 4, 3, 0~S~~~~2~1974~2,8,18,32,32,12,2~|Bh~Bohrium~270.133~E00038~[Rn]7s2 5f14 6d5~~~~~7, 5, 4, 3~S~~~~2~1976~2,8,18,32,32,13,2~|Hs~Hassium~269.1336~E6002E~[Rn]7s2 5f14 6d6~~~~~8, 6, 5, 4, 3, 2~S~~~~2~1984~2,8,18,32,32,14,2~|Mt~Meitnerium~277.154~EB0026~[Rn]7s2 5f14 6d7 (calculated)~~~~~9, 8, 6, 4, 3, 1~S~~~~2~1982~2,8,18,32,32,15,2~|Ds~Darmstadtium~282.166~~[Rn]7s2 5f14 6d8~~~~~8, 6, 4, 2, 0~s~~~~2~1994~2,8,18,32,32,16,2~1|Rg~Roentgenium~282.169~~[Rn]7s2 5f14 6d9~~~~~5, 3, 1, -1~s~~~~2~1994~2,8,18,32,32,17,2~1|Cn~Copernicium~286.179~~[Rn]7s2 5f14 6d10~~~~~2, 1, 0~s~~~~2~1996~2,8,18,32,32,18,2~1|Nh~Nihonium~286.182~~[Rn]5f14 6d10 7s2 7p1~~~~~~s~~~~3~2004~2,8,18,32,32,18,3~1|Fl~Flerovium~290.192~~[Rn]7s2 7p2 5f14 6d10~~~~~6, 4,2, 1, 0~s~~~~3~1998~2,8,18,32,32,18,4~1|Mc~Moscovium~290.196~~[Rn]7s2 7p3 5f14 6d10~~~~~3, 1~s~~~~3~2003~2,8,18,32,32,18,5~1|Lv~Livermorium~293.205~~[Rn]7s2 7p4 5f14 6d10~~~~~+4, +2, -2~s~~~~3~2000~2,8,18,32,32,18,6~1|Ts~Tennessine~294.211~~[Rn]7s2 7p5 5f14 6d10~~~~~+5, +3, +1, -1~s~~~~6~2010~2,8,18,32,32,18,7~1|Og~Oganesson~295.216~~[Rn]7s2 7p6 5f14 6d10~~~~~+6, +4, +2, +1, 0, -1~g~~~~7~2006~2,8,18,32,32,18,8~1\";\n/*PT_DATA_END*/\n\nvar $=function(id){return document.getElementById(id)};\nvar CATS=['Alkali metal','Alkaline earth metal','Transition metal','Post-transition metal','Metalloid','Nonmetal','Halogen','Noble gas','Lanthanide','Actinide'];\nvar CAT_HUE=[4,28,214,172,78,48,318,262,190,142];\nvar STATE_NAME={S:'Solid',L:'Liquid',G:'Gas',s:'Solid (expected)',g:'Gas (expected)',l:'Liquid (expected)'};\n\n/* ---------- Data ---------- */\nfunction num(s){ if(s===''||s==null)return null; var v=parseFloat(s); return isFinite(v)?v:null; }\nvar ELS=PT_RAW.split('|').map(function(r,i){\n  var f=r.split('~');\n  return {z:i+1,sym:f[0],nm:f[1],mass:num(f[2]),massTxt:f[2],cpk:f[3],cfg:f[4],en:num(f[5]),rad:num(f[6]),ie:num(f[7]),ea:num(f[8]),\n    ox:f[9],st:f[10],mp:num(f[11]),bp:num(f[12]),den:num(f[13]),cat:+f[14],year:f[15]==='A'?0:num(f[15]),yearTxt:f[15]==='A'?'Ancient':f[15],\n    shells:f[16].split(',').map(Number),predicted:f[17]==='1'};\n});\n/* Position in the 18-column layout; La–Lu and Ac–Lr sit in the two f-rows (rows 9 and 10). */\nfunction place(z){\n  if(z===1)return [1,1]; if(z===2)return [18,1];\n  var starts=[[3,2],[11,3],[19,4],[37,5],[55,6],[87,7]];\n  var p=1,s=0; for(var i=0;i<starts.length;i++) if(z>=starts[i][0]){ s=starts[i][0]; p=starts[i][1]; }\n  var k=z-s;\n  if(p<=3) return [k<2?k+1:k+11,p];\n  if(p<=5) return [k+1,p];\n  if(k<2) return [k+1,p];\n  if(k<17) return [3+(k-2),p===6?9:10];      // f-row\n  return [k-13,p];\n}\nELS.forEach(function(e){ var pg=place(e.z); e.g=pg[0]; e.row=pg[1]; e.period=pg[1]>7?(pg[1]===9?6:7):pg[1]; e.group=pg[1]>7?null:pg[0]; });\n\n/* ---------- State ---------- */\nvar S={mode:'cat',off:{},favs:{},favOnly:false,tempK:298,unitC:false,t:null,best:0,last:26};\nvar STORE='ptable.v1';\nfunction save(){\n  var d=JSON.stringify({mode:S.mode,favs:Object.keys(S.favs).map(Number),tempK:S.tempK,unitC:S.unitC,t:S.t,best:S.best,last:S.last});\n  try{ if(window.myllmStorage){ myllmStorage.setItem(STORE,d); return; } }catch(e){}\n  try{ localStorage.setItem(STORE,d); }catch(e){}\n}\nfunction load(done){\n  function apply(v){ if(v){ try{ var d=JSON.parse(v);\n    if(MODES.some(function(m){return m[0]===d.mode}))S.mode=d.mode;\n    (d.favs||[]).forEach(function(z){ if(z>=1&&z<=118)S.favs[z]=1; });\n    if(typeof d.tempK==='number')S.tempK=Math.max(0,Math.min(6000,d.tempK)); S.unitC=!!d.unitC;\n    if(typeof d.t==='number')S.t=d.t; if(typeof d.best==='number')S.best=d.best; if(d.last>=1&&d.last<=118)S.last=d.last; }catch(e){} }\n    done(); }\n  try{ if(window.myllmStorage){ myllmStorage.getItem(STORE).then(apply,function(){apply(null)}); return; } }catch(e){}\n  var v=null; try{ v=localStorage.getItem(STORE); }catch(e){} apply(v);\n}\nfunction haptic(s){ try{ if(window.myllmHaptic)window.myllmHaptic(s||'light'); }catch(e){} }\n\n/* ---------- Modes + colour ---------- */\nvar MODES=[\n  ['cat','Category'],\n  ['en','Electronegativity',function(e){return e.en},'Pauling',false],\n  ['rad','Atomic radius',function(e){return e.rad},'pm',false],\n  ['mp','Melting point',function(e){return e.mp},'K',false],\n  ['den','Density',function(e){return e.den},'g/cm³',true],\n  ['year','Discovered',function(e){return e.year},'',false],\n  ['state','State']\n];\nvar RAMP=[[49,46,129],[37,99,235],[14,165,164],[132,204,22],[250,204,21],[249,115,22]];\nfunction ramp(t){\n  t=Math.max(0,Math.min(1,t)); var x=t*(RAMP.length-1), i=Math.min(RAMP.length-2,Math.floor(x)), f=x-i, a=RAMP[i], b=RAMP[i+1];\n  var c=[0,1,2].map(function(k){return Math.round(a[k]+(b[k]-a[k])*f)});\n  var lum=(0.299*c[0]+0.587*c[1]+0.114*c[2])/255;\n  return {bg:'rgb('+c.join(',')+')',fg:lum>.6?'#15171f':'#ffffff'};\n}\nfunction rampCSS(){ return 'linear-gradient(90deg,'+RAMP.map(function(c,i){return 'rgb('+c.join(',')+') '+Math.round(i*100/(RAMP.length-1))+'%'}).join(',')+')'; }\nvar STATE_COL={solid:{bg:'#64748b',fg:'#fff'},liquid:{bg:'#0ea5e9',fg:'#fff'},gas:{bg:'#f59e0b',fg:'#1b1400'}};\n/* Solid, liquid or gas at T kelvin, from the melting and boiling points. */\nfunction stateAt(e,T){\n  if(e.mp==null&&e.bp==null)return null;\n  if(e.mp!=null&&T<e.mp)return 'solid';\n  if(e.bp!=null&&T>=e.bp)return 'gas';\n  if(e.mp==null&&e.bp!=null)return 'liquid';\n  if(e.bp==null)return 'liquid';\n  return 'liquid';\n}\nfunction modeDef(){ for(var i=0;i<MODES.length;i++)if(MODES[i][0]===S.mode)return MODES[i]; return MODES[0]; }\nfunction range(def){\n  var vs=ELS.map(def[2]).filter(function(v){return v!=null&&(S.mode!=='year'||v>0)});\n  var lo=Math.min.apply(null,vs), hi=Math.max.apply(null,vs);\n  return {lo:lo,hi:hi,log:def[4]};\n}\nfunction heatT(v,r){ if(r.log){ return (Math.log(v)-Math.log(r.lo))/(Math.log(r.hi)-Math.log(r.lo)); } return (v-r.lo)/(r.hi-r.lo); }\n\n/* ---------- Formatting ---------- */\nfunction toC(k){ return k-273.15; }\nfunction tempTxt(k){ if(k==null)return '—'; return S.unitC? fmtN(toC(k),1)+' °C' : fmtN(k,2)+' K'; }\nfunction fmtN(v,d){ var r=Math.round(v*Math.pow(10,d))/Math.pow(10,d); return String(r).replace('-','−'); }\nfunction cfgHTML(c){ return esc(c).replace(/([spdf])(\\d+)/g,'$1<sup>$2</sup>'); }\nfunction esc(s){ return String(s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]}); }\n\n/* ---------- Build the table ---------- */\nvar tableEl=$('table'), scroller=$('scroller');\nfunction build(){\n  var h='';\n  ELS.forEach(function(e){\n    h+='<button class=\"el\" data-z=\"'+e.z+'\" style=\"grid-column:'+e.g+';grid-row:'+(e.row===9?9:e.row===10?10:e.row)+';--h:'+CAT_HUE[e.cat]+'\" aria-label=\"'+e.nm+', '+e.z+'\">'\n      +'<span class=\"z\">'+e.z+'</span><span class=\"s\">'+e.sym+'</span><span class=\"n\">'+e.nm+'</span></button>';\n  });\n  h+='<div class=\"ph\" style=\"grid-column:3;grid-row:6;--h:190\">57–71</div><div class=\"ph\" style=\"grid-column:3;grid-row:7\">89–103</div>';\n  h+='<div class=\"gapcard\" id=\"gapcard\"></div>';\n  tableEl.innerHTML=h;\n}\nfunction tiles(){ return tableEl.querySelectorAll('.el'); }\n\n/* ---------- Render ---------- */\nfunction renderModes(){\n  $('modes').innerHTML=MODES.map(function(m){return '<button data-m=\"'+m[0]+'\" class=\"'+(m[0]===S.mode?'on':'')+'\">'+m[1]+'</button>'}).join('');\n}\nfunction renderLegend(){\n  var L=$('legend'), def=modeDef();\n  if(S.mode==='cat'){\n    var any=Object.keys(S.off).length>0;\n    L.innerHTML='<div class=\"cats\">'+CATS.map(function(c,i){\n      return '<button data-cat=\"'+i+'\" class=\"'+(S.off[i]?'off':'')+'\"><i style=\"background:hsl('+CAT_HUE[i]+' 70% 55%)\"></i>'+c+'</button>';\n    }).join('')+'<button data-cat=\"fav\" class=\"'+(S.favOnly?'':'off')+'\"><i style=\"background:#f5a623;border-radius:50%\"></i>Favourites</button></div>';\n    return;\n  }\n  if(S.mode==='state'){\n    L.innerHTML='<div class=\"temp\"><input type=\"range\" id=\"temp\" min=\"0\" max=\"6000\" step=\"1\" value=\"'+S.tempK+'\" aria-label=\"Temperature\">'\n      +'<span class=\"tv\" id=\"tv\">'+tempTxt(S.tempK)+'</span><button class=\"unit\" id=\"unit\">'+(S.unitC?'°C':'K')+'</button></div>'\n      +'<div class=\"states\"><span><i style=\"background:'+STATE_COL.solid.bg+'\"></i>Solid</span><span><i style=\"background:'+STATE_COL.liquid.bg+'\"></i>Liquid</span><span><i style=\"background:'+STATE_COL.gas.bg+'\"></i>Gas</span><span><i style=\"background:repeating-linear-gradient(135deg,var(--faint) 0 3px,transparent 3px 6px)\"></i>Unknown</span></div>';\n    var t=$('temp');\n    t.addEventListener('input',function(){ S.tempK=+t.value; $('tv').textContent=tempTxt(S.tempK); paint(); renderGap(); syncSheetTemp(); });\n    t.addEventListener('change',save);\n    $('unit').addEventListener('click',function(){ S.unitC=!S.unitC; haptic(); save(); renderLegend(); renderGap(); syncSheetTemp(); });\n    return;\n  }\n  var r=range(def), lo=S.mode==='year'?'Ancient':fmtVal(r.lo), hi=fmtVal(r.hi);\n  L.innerHTML='<div class=\"grad\"><b>'+lo+'</b><div class=\"bar\" style=\"background:'+rampCSS()+'\"></div><b>'+hi+'</b></div>'\n    +'<div class=\"states\" style=\"margin-top:5px\"><span>'+(def[4]?'Log scale · ':'')+(def[3]?def[3]:'Year')+'</span><span><i style=\"background:repeating-linear-gradient(135deg,var(--faint) 0 3px,transparent 3px 6px)\"></i>No data</span></div>';\n}\nfunction fmtVal(v){\n  if(S.mode==='mp')return S.unitC?fmtN(toC(v),0)+' °C':fmtN(v,0)+' K';\n  if(S.mode==='den')return (v<0.01?String(+v.toPrecision(2)):fmtN(v,2))+' g/cm³';\n  if(S.mode==='rad')return fmtN(v,0)+' pm';\n  if(S.mode==='year')return String(Math.round(v));\n  return fmtN(v,2);\n}\nfunction matches(e){\n  if(S.mode!=='cat')return true;\n  if(S.off[e.cat])return false;\n  if(S.favOnly&&!S.favs[e.z])return false;\n  return true;\n}\nfunction paint(){\n  var def=modeDef(), r=(def[2]?range(def):null), q=searchHits;\n  tiles().forEach(function(t){\n    var e=ELS[+t.getAttribute('data-z')-1];\n    t.classList.remove('heat','nodata');\n    t.style.removeProperty('--hc'); t.style.removeProperty('--ht');\n    if(S.mode==='state'){\n      var st=stateAt(e,S.tempK);\n      if(!st)t.classList.add('nodata'); else { t.classList.add('heat'); t.style.setProperty('--hc',STATE_COL[st].bg); t.style.setProperty('--ht',STATE_COL[st].fg); }\n      t.setAttribute('data-state',st||'unknown');\n    } else if(r){\n      var v=def[2](e);\n      if(v==null)t.classList.add('nodata');\n      else { var c=S.mode==='year'&&v===0?ramp(0):ramp(heatT(v,r)); t.classList.add('heat'); t.style.setProperty('--hc',c.bg); t.style.setProperty('--ht',c.fg); }\n    }\n    var dim=!matches(e)||(q&&!q[e.z]);\n    t.classList.toggle('dim',!!dim);\n    t.classList.toggle('hit',!!(q&&q[e.z]));\n    var fav=t.querySelector('.fav');\n    if(S.favs[e.z]&&!fav){ fav=document.createElement('span'); fav.className='fav'; fav.textContent='★'; t.appendChild(fav); }\n    else if(!S.favs[e.z]&&fav)fav.remove();\n  });\n}\nfunction renderGap(){\n  var e=ELS[S.last-1], g=$('gapcard'), line='';\n  if(S.mode==='cat')line='<b>'+CATS[e.cat]+'</b> · period '+e.period+(e.group?' · group '+e.group:'');\n  else if(S.mode==='state'){ var st=stateAt(e,S.tempK); line='At <b>'+tempTxt(S.tempK)+'</b>: <b>'+(st?st[0].toUpperCase()+st.slice(1):'unknown')+'</b>'; }\n  else { var def=modeDef(), v=def[2](e); line=def[1]+': <b>'+(v==null?'no data':(S.mode==='year'&&v===0?'Ancient':fmtVal(v)))+'</b>'; }\n  g.style.setProperty('--h',CAT_HUE[e.cat]);\n  g.innerHTML='<div class=\"big\" data-z=\"'+e.z+'\"><span class=\"z\">'+e.z+'</span><span class=\"s\">'+e.sym+'</span></div>'\n    +'<div class=\"info\"><h2>'+e.nm+'</h2><p>'+line+'</p><p class=\"more\">'+(e.mass!=null?e.massTxt+' u · ':'')+cfgHTML(e.cfg)+'</p></div>';\n}\nfunction renderAll(){ renderModes(); renderLegend(); paint(); renderGap(); }\n\n/* ---------- Zoom (buttons + pinch) ---------- */\nfunction fitT(){\n  var w=scroller.clientWidth-28, g=4;\n  return Math.max(18,Math.floor((w-17*g)/18));\n}\nfunction setT(t,anchor){\n  t=Math.max(18,Math.min(110,t));\n  var old=parseFloat(getComputedStyle(tableEl).getPropertyValue('--t'))||52;\n  var ax=anchor?anchor.x:scroller.clientWidth/2, ay=anchor?anchor.y:scroller.clientHeight/2;\n  var cx=(scroller.scrollLeft+ax-14)/(old+4), cy=(scroller.scrollTop+ay-8)/(old+4);\n  tableEl.style.setProperty('--t',t+'px');\n  tableEl.style.setProperty('--g',(t<34?2:t<48?3:4)+'px');\n  tableEl.classList.toggle('small',t<40);\n  scroller.scrollLeft=cx*(t+4)-ax+14; scroller.scrollTop=cy*(t+4)-ay+8;\n  S.t=t;\n}\n$('zIn').addEventListener('click',function(){ haptic(); setT((S.t||52)*1.25); save(); });\n$('zOut').addEventListener('click',function(){ haptic(); setT((S.t||52)/1.25); save(); });\n$('zFit').addEventListener('click',function(){ haptic(); setT(fitT()); scroller.scrollLeft=0; scroller.scrollTop=0; save(); });\nvar pinch=null;\nfunction dist(ts){ var dx=ts[0].clientX-ts[1].clientX, dy=ts[0].clientY-ts[1].clientY; return Math.sqrt(dx*dx+dy*dy); }\nscroller.addEventListener('touchstart',function(e){\n  if(e.touches.length===2){ var r=scroller.getBoundingClientRect();\n    pinch={d:dist(e.touches),t:S.t||52,x:(e.touches[0].clientX+e.touches[1].clientX)/2-r.left,y:(e.touches[0].clientY+e.touches[1].clientY)/2-r.top}; }\n},{passive:true});\nscroller.addEventListener('touchmove',function(e){\n  if(pinch&&e.touches.length===2){ e.preventDefault(); setT(pinch.t*dist(e.touches)/pinch.d,{x:pinch.x,y:pinch.y}); }\n},{passive:false});\nscroller.addEventListener('touchend',function(e){ if(pinch&&e.touches.length<2){ pinch=null; save(); } });\n['gesturestart','gesturechange'].forEach(function(n){ document.addEventListener(n,function(e){ e.preventDefault(); }); });\n\n/* ---------- Tap an element ---------- */\ntableEl.addEventListener('click',function(ev){\n  var t=ev.target.closest('.el,.big'); if(!t)return;\n  openElement(+t.getAttribute('data-z'));\n});\n\n/* ---------- Sheets ---------- */\nvar sheet=$('sheet'), sbody=$('sbody'), sheetKind=null, askToken=0;\nfunction openSheet(kind,html){\n  sheetKind=kind; sbody.innerHTML=html; sbody.scrollTop=0;\n  $('scrim').classList.add('open'); sheet.classList.add('open');\n}\nfunction closeSheet(){ $('scrim').classList.remove('open'); sheet.classList.remove('open'); sheetKind=null; askToken++; }\n$('scrim').addEventListener('click',closeSheet);\n$('sclose').addEventListener('click',closeSheet);\n\nfunction bohrSVG(e){\n  var sh=e.shells, n=sh.length, R=74, r0=24, step=n>1?(R-r0)/(n-1):0, h='';\n  var dark=matchMedia('(prefers-color-scheme:dark)').matches;\n  var nuc='hsl('+CAT_HUE[e.cat]+' 70% '+(dark?'58%':'52%')+')';\n  for(var i=0;i<n;i++){\n    var rr=r0+i*step;\n    h+='<circle cx=\"80\" cy=\"80\" r=\"'+rr.toFixed(1)+'\" fill=\"none\" stroke=\"currentColor\" stroke-opacity=\".16\" stroke-width=\"1.2\"/>';\n    var dots='';\n    for(var k=0;k<sh[i];k++){ var a=2*Math.PI*k/sh[i]; dots+='<circle cx=\"'+(80+rr*Math.cos(a)).toFixed(2)+'\" cy=\"'+(80+rr*Math.sin(a)).toFixed(2)+'\" r=\"'+(sh[i]>18?2.1:2.8)+'\" fill=\"'+nuc+'\"/>'; }\n    h+='<g class=\"orb\" style=\"animation-duration:'+(8+i*5)+'s;'+(i%2?'animation-direction:reverse':'')+'\">'+dots+'</g>';\n  }\n  h+='<circle cx=\"80\" cy=\"80\" r=\"14\" fill=\"'+nuc+'\"/><text x=\"80\" y=\"84.5\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"700\" fill=\"#fff\" font-family=\"-apple-system,system-ui\">'+esc(e.sym)+'</text>';\n  return '<svg viewBox=\"0 0 160 160\" role=\"img\" aria-label=\"Electron shells '+sh.join(', ')+'\">'+h+'</svg>';\n}\nfunction tempPropInner(e){ var st=stateAt(e,S.tempK);\n  return '<div class=\"k\">At '+tempTxt(S.tempK)+'</div><div class=\"v\">'+(st?st[0].toUpperCase()+st.slice(1):'<small>Unknown</small>')+'</div>'; }\n/* The open element's \"At <temperature>\" row follows the slider and the K/°C switch. */\nfunction syncSheetTemp(){ var d=$('dTemp'); if(d&&sheetKind==='el')d.innerHTML=tempPropInner(ELS[+d.getAttribute('data-z')-1]); }\nfunction prop(k,v,wide){ return '<div class=\"prop'+(wide?' wide':'')+'\"><div class=\"k\">'+k+'</div><div class=\"v\">'+v+'</div></div>'; }\nfunction nv(v,unit,d){ return v==null?'<small>Unknown</small>':fmtN(v,d==null?3:d)+(unit?' <small>'+unit+'</small>':''); }\nfunction openElement(z){\n  var e=ELS[z-1]; S.last=z; renderGap(); save(); haptic();\n  var h='<div class=\"hero\" style=\"--h:'+CAT_HUE[e.cat]+'\"><div class=\"card\"><span class=\"z\">'+e.z+'</span><span class=\"m\">'+(e.mass!=null?e.massTxt:'')+'</span>'\n    +'<span class=\"s\">'+e.sym+'</span><span class=\"n\">'+e.nm+'</span></div><div class=\"bohr\">'+bohrSVG(e)+'</div></div>'\n    +'<div class=\"dname\">'+e.nm+'</div><div class=\"dsub\">'+CATS[e.cat]+' · period '+e.period+(e.group?' · group '+e.group:' · f-block')+'</div>'\n    +'<div class=\"drow\"><button id=\"dPrev\" aria-label=\"Previous element\"><svg viewBox=\"0 0 24 24\"><path d=\"M15 6l-6 6 6 6\"/></svg></button>'\n    +'<button class=\"star'+(S.favs[z]?' on':'')+'\" id=\"dFav\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z\"/></svg>'+(S.favs[z]?'Saved':'Save')+'</button>'\n    +(askAvailable()?'<button class=\"ask\" id=\"dAsk\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3l1.8 4.6L18.5 9l-4.7 1.6L12 15l-1.8-4.4L5.5 9l4.7-1.4z\"/></svg>Ask</button>':'')\n    +'<button id=\"dNext\" aria-label=\"Next element\"><svg viewBox=\"0 0 24 24\"><path d=\"M9 6l6 6-6 6\"/></svg></button></div>'\n    +'<div class=\"aiout\" id=\"aiout\"></div>'\n    +'<div class=\"props\">'\n    +prop('Atomic mass',e.mass!=null?esc(e.massTxt)+' <small>u</small>':'<small>Unknown</small>')\n    +prop('Standard state',STATE_NAME[e.st]||'—')\n    +prop('Electron configuration',cfgHTML(e.cfg)+(e.predicted?' <small>(predicted)</small>':''),true)\n    +prop('Electrons per shell',e.shells.join(' · '),true)\n    +prop('Electronegativity',nv(e.en,'Pauling',2))\n    +prop('Atomic radius',nv(e.rad,'pm',0))\n    +prop('Ionisation energy',nv(e.ie,'eV',3))\n    +prop('Electron affinity',nv(e.ea,'eV',3))\n    +prop('Melting point',tempTxt(e.mp))\n    +prop('Boiling point',tempTxt(e.bp))\n    +prop('Density',e.den==null?'<small>Unknown</small>':(e.den<0.01?e.den.toExponential(3).replace('-','−'):fmtN(e.den,3))+' <small>g/cm³</small>')\n    +prop('Discovered',esc(e.yearTxt||'—'))\n    +prop('Oxidation states',esc(e.ox||'—').replace(/-/g,'−'),true)\n    +'<div class=\"prop\" id=\"dTemp\" data-z=\"'+z+'\">'+tempPropInner(e)+'</div>'\n    +prop('CPK colour',e.cpk?'<span style=\"display:inline-block;width:14px;height:14px;border-radius:4px;vertical-align:-2px;margin-right:6px;background:#'+e.cpk+';box-shadow:0 0 0 1px var(--line)\"></span>#'+e.cpk:'<small>None</small>')\n    +'</div>';\n  openSheet('el',h);\n  $('dPrev').onclick=function(){ openElement(z===1?118:z-1); };\n  $('dNext').onclick=function(){ openElement(z===118?1:z+1); };\n  $('dFav').onclick=function(){ if(S.favs[z])delete S.favs[z]; else S.favs[z]=1; save(); paint(); haptic('medium');\n    var b=$('dFav'); b.classList.toggle('on',!!S.favs[z]); b.lastChild.textContent=S.favs[z]?'Saved':'Save'; };\n  if($('dAsk'))$('dAsk').onclick=function(){ askAbout(e); };\n}\nfunction askAvailable(){ return typeof window.myllmAsk==='function'; }\nfunction askAbout(e){\n  var out=$('aiout'), my=++askToken; out.classList.add('show');\n  out.innerHTML='<h3>Your AI on '+esc(e.nm)+'</h3><div class=\"txt\"><span class=\"dots\"><span></span><span></span><span></span></span></div>';\n  var p='Explain the chemical element '+e.nm+' ('+e.sym+', atomic number '+e.z+') to a curious student in four short paragraphs: what it is like, where it is found, what it is used for, and one surprising fact. Plain text, no headings, no markdown.';\n  window.myllmAsk(p).then(function(r){\n    if(my!==askToken)return;\n    out.querySelector('.txt').textContent=String(r||'').replace(/\\*\\*/g,'').trim()||'No answer came back.';\n    out.insertAdjacentHTML('beforeend','<div class=\"note\">Written by your AI. The figures above come from PubChem.</div>');\n  },function(){ if(my!==askToken)return; out.querySelector('.txt').textContent=\"Couldn't reach your AI just now.\"; });\n}\n\n/* ---------- Search ---------- */\nvar searchHits=null;\nfunction doSearch(){\n  var q=$('q').value.trim().toLowerCase(), R=$('results');\n  if(!q){ searchHits=null; R.classList.remove('show'); paint(); return; }\n  var list=ELS.filter(function(e){\n    return e.nm.toLowerCase().indexOf(q)===0||e.sym.toLowerCase()===q||(q.length>1&&e.sym.toLowerCase().indexOf(q)===0)||String(e.z)===q||(q.length>2&&e.nm.toLowerCase().indexOf(q)>0);\n  });\n  list.sort(function(a,b){ var as=a.sym.toLowerCase()===q?0:1, bs=b.sym.toLowerCase()===q?0:1; return as-bs||a.z-b.z; });\n  searchHits={}; list.forEach(function(e){searchHits[e.z]=1});\n  R.innerHTML=list.length?list.slice(0,8).map(function(e){\n    return '<button data-z=\"'+e.z+'\"><span class=\"rs\" style=\"background:hsl('+CAT_HUE[e.cat]+' var(--S) var(--L));color:hsl('+CAT_HUE[e.cat]+' var(--St) var(--Lt))\">'+e.sym+'</span><span><div class=\"rn\">'+e.nm+'</div><div class=\"rz\">'+e.z+' · '+CATS[e.cat]+'</div></span></button>';\n  }).join(''):'<div class=\"none\">No element matches “'+esc(q)+'”.</div>';\n  R.classList.add('show'); paint();\n}\n$('q').addEventListener('input',doSearch);\n$('q').addEventListener('keydown',function(e){ if(e.key==='Enter'){ var b=$('results').querySelector('button'); if(b)b.click(); } });\n$('results').addEventListener('click',function(ev){\n  var b=ev.target.closest('button[data-z]'); if(!b)return;\n  $('results').classList.remove('show'); $('q').blur(); openElement(+b.getAttribute('data-z'));\n});\n$('searchBtn').addEventListener('click',function(){\n  var on=!document.body.classList.contains('searching'); haptic();\n  document.body.classList.toggle('searching',on); $('searchBtn').classList.toggle('on',on);\n  if(on)setTimeout(function(){$('q').focus()},50); else { $('q').value=''; doSearch(); }\n});\n\n/* ---------- Mode + legend input ---------- */\n$('modes').addEventListener('click',function(ev){\n  var b=ev.target.closest('button[data-m]'); if(!b)return;\n  S.mode=b.getAttribute('data-m'); haptic(); save(); renderAll();\n  b.scrollIntoView({inline:'nearest',block:'nearest'});\n});\n$('legend').addEventListener('click',function(ev){\n  var b=ev.target.closest('button[data-cat]'); if(!b)return; haptic();\n  var c=b.getAttribute('data-cat');\n  if(c==='fav'){ S.favOnly=!S.favOnly; if(S.favOnly&&!Object.keys(S.favs).length)toast('Save elements with ☆ to see them here'); }\n  else {\n    var i=+c, allOn=!Object.keys(S.off).length;\n    // First tap focuses one category; tapping it again brings everything back.\n    if(allOn){ CATS.forEach(function(_,k){ if(k!==i)S.off[k]=1; }); }\n    else if(!S.off[i]&&Object.keys(S.off).length===CATS.length-1){ S.off={}; }\n    else { if(S.off[i])delete S.off[i]; else S.off[i]=1; }\n  }\n  renderLegend(); paint();\n});\n\n/* ---------- Quiz ---------- */\nvar QZ=null;\nfunction shuffle(a){ for(var i=a.length-1;i>0;i--){ var j=Math.floor(Math.random()*(i+1)), t=a[i]; a[i]=a[j]; a[j]=t; } return a; }\nfunction pool(){ return ELS.filter(function(e){return e.z<=86||[88,90,92,94].indexOf(e.z)>=0}); }\nfunction newQuiz(){\n  var p=shuffle(pool().slice()).slice(0,10);\n  QZ={i:0,score:0,qs:p.map(function(e,k){\n    var type=k%3, others=shuffle(pool().filter(function(o){return o.z!==e.z})).slice(0,3), opts=shuffle([e].concat(others));\n    return {e:e,type:type,opts:opts};\n  })};\n  showQ();\n}\nfunction showQ(){\n  var q=QZ.qs[QZ.i], e=q.e, h='<div class=\"qh\">Element quiz</div><div class=\"qp\">Question '+(QZ.i+1)+' of 10 · score '+QZ.score+'</div>'\n    +'<div class=\"qbar\"><i style=\"width:'+(QZ.i*10)+'%\"></i></div>';\n  if(q.type===0){ h+='<div class=\"qbig\" style=\"--h:'+CAT_HUE[e.cat]+'\">'+e.sym+'</div><div class=\"qq\">Which element is this?</div>'; }\n  else if(q.type===1){ h+='<div class=\"qq\">What is the symbol for<br><b>'+e.nm+'</b>?</div>'; }\n  else { h+='<div class=\"qq\">Which element has atomic number <b>'+e.z+'</b>?</div>'; }\n  h+='<div class=\"qopts\">'+q.opts.map(function(o){ return '<button data-z=\"'+o.z+'\">'+(q.type===1?o.sym:o.nm)+'</button>'; }).join('')+'</div>';\n  openSheet('quiz',h);\n  sbody.querySelectorAll('.qopts button').forEach(function(b){\n    b.onclick=function(){\n      if(QZ.locked)return; QZ.locked=true;\n      var right=+b.getAttribute('data-z')===e.z;\n      if(right){ QZ.score++; b.classList.add('right'); haptic('success'); }\n      else { b.classList.add('wrong'); haptic('error'); sbody.querySelector('.qopts button[data-z=\"'+e.z+'\"]').classList.add('right'); }\n      setTimeout(function(){ QZ.locked=false; QZ.i++; if(QZ.i<10)showQ(); else endQuiz(); },right?650:1300);\n    };\n  });\n}\nfunction endQuiz(){\n  if(QZ.score>S.best){ S.best=QZ.score; save(); }\n  var msg=QZ.score===10?'Perfect. You know your table.':QZ.score>=7?'Great work.':QZ.score>=4?'Good going. Try again to beat it.':'Every chemist starts somewhere.';\n  openSheet('quiz','<div class=\"qh\">Element quiz</div><div class=\"qend\"><div class=\"score\">'+QZ.score+'/10</div><p>'+msg+'</p><p>Best so far: '+S.best+'/10</p></div><button class=\"bigbtn\" id=\"again\">Play again</button>');\n  $('again').onclick=newQuiz;\n}\n$('quizBtn').addEventListener('click',function(){ haptic(); newQuiz(); });\n\n/* ---------- About ---------- */\n$('aboutBtn').addEventListener('click',function(){\n  openSheet('about','<div class=\"about\"><h2>About the data</h2>'\n    +'<p>Every figure in this table comes from the PubChem periodic table, published by the US National Library of Medicine (NIH). It is a US government work and in the public domain.</p>'\n    +'<p class=\"m\">Data: PubChem (NIH), public domain. pubchem.ncbi.nlm.nih.gov/periodic-table</p>'\n    +'<p>Temperatures are in kelvin (switch to °C in the State view). Density is in g/cm³, atomic radius in picometres, energies in electronvolts, electronegativity on the Pauling scale.</p>'\n    +'<p class=\"m\">The state view compares each element\\'s melting and boiling points at normal pressure with the temperature you choose. Values for the heaviest elements are predictions, and some have never been measured.</p>'\n    +'<p class=\"m\">The “Ask” explanations are written by your AI, not PubChem.</p></div>');\n});\n\nvar tt; function toast(m){ var t=$('toast'); t.textContent=m; t.classList.add('show'); clearTimeout(tt); tt=setTimeout(function(){t.classList.remove('show')},1600); }\n\n/* ---------- Boot ---------- */\nbuild();\nfunction firstZoom(){\n  var land=innerWidth>innerHeight;\n  if(S.t)setT(S.t); else setT(land?Math.max(34,fitT()):52);\n}\nvar booted=false;\nfunction boot(){ if(booted)return; booted=true; renderAll(); firstZoom(); }\nload(boot);\naddEventListener('resize',function(){ if(!S.t||innerWidth>innerHeight&&S.t<fitT())setT(Math.max(fitT(),18)); });\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes. This page\n   pads its own top by env(safe-area-inset-top), so the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    var sp = document.querySelector(\".imm-safe\"); if (sp) sp.style.height = \"0px\";\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script></body></html>\n", "kind": "html", "iconSymbol": "atom", "iconColor": "blue"}