{"name": "White Noise", "html": "<!doctype html>\n<!--\n  White Noise — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover\">\n<title>White Noise</title>\n<style>:root{--build-id:\"2202dcf9b0\";color-scheme:light dark;--accent:var(--myllm-accent,#5e5ce6)}\n  /* MyLLM's own theme where it supplies one, else the phone's appearance. */\n  :root{ --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111); --mut:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --ring:#c7c7cc; }\n  @media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e); --ink:var(--myllm-text,#f2f2f7); --mut:var(--myllm-muted,#98989f); --line:var(--myllm-border,#2c2c2e); --ring:#48484a; } }\n  @property --h{ syntax:'<number>'; inherits:true; initial-value:245; }\n  @property --h2{ syntax:'<number>'; inherits:true; initial-value:305; }\n  @property --s{ syntax:'<percentage>'; inherits:true; initial-value:60%; }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh;\n    padding:16px 16px calc(206px + env(safe-area-inset-bottom));\n  }\n  body.lock{ overflow:hidden; }\n  h1{ font-size:22px; font-weight:800; margin:4px 2px 4px; }\n  .sub{ font-size:13px; color:var(--mut); margin:0 2px 14px; line-height:1.4; }\n  button{ font:inherit; color:inherit; }\n  svg{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n\n  /* Sound art: a hue-tinted tile carrying the sound's glyph. */\n  .tile{ display:flex; align-items:center; justify-content:center; color:rgba(255,255,255,.95);\n    background:linear-gradient(145deg, hsl(var(--th,215) var(--ts,62%) 50%), hsl(calc(var(--th,215) + 40) var(--ts,62%) 27%)); }\n\n  /* Sound cards */\n  .sound{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:11px 13px; margin-bottom:9px;\n    transition:border-color .2s, box-shadow .2s; }\n  .sound.on{ border-color:var(--accent); box-shadow:0 0 0 1px var(--accent), 0 6px 20px rgba(0,0,0,.07); }\n  .head{ display:flex; align-items:center; gap:12px; cursor:pointer; }\n  .head .tile{ width:42px; height:42px; border-radius:12px; font-size:18px; flex-shrink:0; }\n  .head .nm{ flex:1; min-width:0; font-size:15.5px; font-weight:700; }\n  .head .nm small{ display:block; font-size:12px; font-weight:400; color:var(--mut); margin-top:1px; }\n  .dot{ width:24px; height:24px; border-radius:50%; border:2px solid var(--ring); flex:none; display:flex; align-items:center; justify-content:center; color:transparent; font-size:12px; }\n  .sound.on .dot{ background:var(--accent); border-color:var(--accent); color:#fff; }\n  .vol{ width:100%; margin-top:12px; accent-color:var(--accent); display:none; }\n  .sound.on .vol{ display:block; }\n\n  /* Bottom bar */\n  .bar{ position:fixed; left:0; right:0; bottom:0; z-index:5; background:var(--surface); border-top:1px solid var(--line);\n    box-shadow:0 -6px 24px rgba(0,0,0,.08); padding:12px 16px calc(12px + env(safe-area-inset-bottom)); }\n  .bar > div{ max-width:568px; margin-left:auto; margin-right:auto; }\n  .barrow{ display:flex; align-items:center; gap:12px; }\n  .play{ border:0; background:var(--accent); color:#fff; border-radius:50%; width:48px; height:48px; font-size:18px; flex:none; display:flex; align-items:center; justify-content:center; }\n  .play:active, .open:active{ transform:scale(.95); }\n  .mixinfo{ flex:1; min-width:0; cursor:pointer; }\n  .mixname{ font-size:15px; font-weight:750; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .mixsub{ font-size:12px; color:var(--mut); margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-variant-numeric:tabular-nums; }\n  .open{ width:40px; height:40px; border-radius:50%; flex:none; border:1px solid var(--line); background:var(--bg); display:flex; align-items:center; justify-content:center; font-size:15px; }\n  .volrow{ display:flex; align-items:center; gap:10px; margin-top:12px; color:var(--mut); font-size:15px; }\n  .mvol{ flex:1; min-width:0; accent-color:var(--accent); }\n  .timer{ display:flex; gap:6px; margin-top:10px; justify-content:center; }\n  .timer button{ border:1px solid var(--line); background:var(--bg); border-radius:99px; padding:6px 14px; font-size:13px; font-weight:650; }\n  .timer button.on{ background:var(--accent); border-color:var(--accent); color:#fff; }\n\n  /* EQ animation */\n  .eq{ display:inline-flex; align-items:flex-end; gap:2px; height:11px; margin-right:6px; vertical-align:-1px; }\n  .eq i{ width:3px; border-radius:2px; background:#30d158; animation:eq 1s ease-in-out infinite; }\n  .eq i:nth-child(2){ animation-delay:.25s; } .eq i:nth-child(3){ animation-delay:.5s; }\n  @keyframes eq{ 0%,100%{ height:4px; } 50%{ height:11px; } }\n\n  /* Night view: the whole display, tinted by the mix. Two backdrop layers,\n     dark and light, so the look can follow the phone's appearance. */\n  .full{ display:none; position:fixed; inset:0; z-index:50; color:#fff; overflow:hidden; --h:245; --h2:305; --s:60%;\n    transition:--h 2.2s ease, --h2 2.2s ease, --s 2.2s ease; }\n  .full.on{ display:block; }\n  .bg{ position:absolute; inset:0; }\n  .bg.d{ background:radial-gradient(120% 90% at 20% 10%, hsl(var(--h) var(--s) 30%), transparent 60%),\n      radial-gradient(120% 90% at 85% 95%, hsl(var(--h2) var(--s) 24%), transparent 62%), #08080d; }\n  .bg.l{ display:none; background:radial-gradient(120% 90% at 20% 0%, hsl(var(--h) var(--s) 85%), transparent 60%),\n      radial-gradient(120% 90% at 85% 100%, hsl(var(--h2) var(--s) 87%), transparent 62%), #f4f4f8; }\n  .blob{ position:absolute; width:74vmax; height:74vmax; border-radius:50%; filter:blur(70px); opacity:.34; pointer-events:none;\n    background:hsl(var(--h) var(--s) 42%); left:-30vmax; top:-24vmax; animation:drift 46s ease-in-out infinite alternate; }\n  .blob.b{ background:hsl(var(--h2) var(--s) 38%); left:auto; top:auto; right:-32vmax; bottom:-26vmax; animation-name:driftB; animation-duration:58s; }\n  @keyframes drift{ from{ transform:translate(0,0) scale(1); } to{ transform:translate(22vmax,16vmax) scale(1.18); } }\n  @keyframes driftB{ from{ transform:translate(0,0) scale(1.1); } to{ transform:translate(-20vmax,-18vmax) scale(.95); } }\n  .scrim{ position:absolute; inset:0; background:linear-gradient(180deg, rgba(8,8,12,.18) 0%, rgba(8,8,12,.34) 50%, rgba(8,8,12,.62) 100%); }\n  .inner{ position:absolute; inset:0; overflow-y:auto; -webkit-overflow-scrolling:touch; display:flex; flex-direction:column; align-items:center; text-align:center;\n    padding:calc(12px + env(safe-area-inset-top)) calc(22px + env(safe-area-inset-right)) calc(22px + env(safe-area-inset-bottom)) calc(22px + env(safe-area-inset-left)); }\n  .ftop{ width:100%; max-width:520px; display:flex; justify-content:space-between; align-items:center; flex-shrink:0; }\n  .lbl{ font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; opacity:.62; }\n  .glass{ border:1px solid rgba(255,255,255,.16); background:rgba(255,255,255,.12); color:inherit;\n    -webkit-backdrop-filter:blur(18px); backdrop-filter:blur(18px); }\n  .ftop button{ height:40px; min-width:40px; border-radius:99px; padding:0 14px; font-size:13.5px; font-weight:700; display:inline-flex; align-items:center; justify-content:center; gap:7px; }\n  .ftop button.rnd{ padding:0; }\n  .fbody{ width:100%; max-width:520px; margin:auto 0; display:flex; flex-direction:column; align-items:center; padding:16px 0 4px; }\n  .pads{ width:100%; max-width:400px; display:grid; grid-template-columns:repeat(4,1fr); gap:10px; flex-shrink:0; }\n  .pad{ aspect-ratio:1; border-radius:20px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px; font-size:22px;\n    transition:transform .15s, background .3s, border-color .3s; }\n  .pad span{ font-size:10.5px; font-weight:700; letter-spacing:.01em; opacity:.75; white-space:nowrap; }\n  .pad:active{ transform:scale(.94); }\n  .full .pad.glass.on{ color:#fff; border-color:rgba(255,255,255,.4); box-shadow:0 10px 26px hsl(var(--th) var(--ts) 30% / .45);\n    background:linear-gradient(145deg, hsl(var(--th) var(--ts) 54%), hsl(calc(var(--th) + 40) var(--ts) 30%)); }\n  .pad.on span{ opacity:.95; }\n  .fside{ width:100%; display:flex; flex-direction:column; align-items:center; }\n  .fstate{ display:inline-flex; align-items:center; font-size:11.5px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.7; min-height:16px; margin-top:24px; }\n  .fstate .eq{ display:none; } .fstate.live{ color:#4be07d; opacity:1; } .fstate.live .eq{ display:inline-flex; } .fstate .eq i{ background:#4be07d; }\n  .ftitle{ font-size:24px; font-weight:800; line-height:1.2; letter-spacing:-.01em; margin-top:8px; max-width:100%;\n    display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }\n  .fbtn{ width:84px; height:84px; border-radius:50%; border:none; background:#fff; color:#0b0b10; font-size:28px; margin-top:20px; flex-shrink:0;\n    display:flex; align-items:center; justify-content:center; box-shadow:0 10px 30px rgba(0,0,0,.35); }\n  .fbtn:active{ transform:scale(.94); }\n  .fbtn:disabled{ opacity:.35; }\n  .fvol{ width:100%; max-width:340px; display:flex; align-items:center; gap:12px; margin-top:22px; font-size:16px; opacity:.9; }\n  .fvol input{ flex:1; min-width:0; -webkit-appearance:none; appearance:none; height:6px; border-radius:99px; background:rgba(255,255,255,.24); outline:none; }\n  .fvol input::-webkit-slider-thumb{ -webkit-appearance:none; appearance:none; width:24px; height:24px; border-radius:50%; background:#fff; border:none; box-shadow:0 3px 10px rgba(0,0,0,.35); }\n  .fvol input::-moz-range-thumb{ width:24px; height:24px; border-radius:50%; background:#fff; border:none; }\n  .ftimer{ display:flex; gap:7px; margin-top:20px; justify-content:center; }\n  .ftimer button{ border-radius:99px; padding:8px 15px; font-size:13px; font-weight:700; }\n  .ftimer button.on{ background:#fff; border-color:#fff; color:#0b0b10; }\n  .fnote{ font-size:12.5px; opacity:.6; margin-top:10px; min-height:16px; font-variant-numeric:tabular-nums; }\n\n  /* Light variant: on a MyLLM build that can't hide its title bar, a dark\n     night view under a white bar looks cut in half — so in light mode,\n     without myllmImmersive, it stays light and runs on from the bar. */\n  .full.lite{ color:#15151a; }\n  .full.lite .bg.d{ display:none; } .full.lite .bg.l{ display:block; }\n  .full.lite .blob{ opacity:.55; background:hsl(var(--h) var(--s) 80%); } .full.lite .blob.b{ background:hsl(var(--h2) var(--s) 82%); }\n  .full.lite .scrim{ background:linear-gradient(180deg, rgba(255,255,255,.35) 0%, rgba(255,255,255,.15) 45%, rgba(255,255,255,.5) 100%); }\n  .full.lite .glass{ border-color:rgba(0,0,0,.09); background:rgba(255,255,255,.62); }\n  .full.lite .pad.glass.on{ border-color:rgba(255,255,255,.6); box-shadow:0 10px 24px hsl(var(--th) var(--ts) 40% / .3); }\n  .full.lite .fstate.live{ color:#1c9a4a; } .full.lite .fstate .eq i{ background:#1c9a4a; }\n  .full.lite .fbtn{ background:#15151a; color:#fff; box-shadow:0 10px 26px rgba(20,20,40,.25); }\n  .full.lite .fvol input{ background:rgba(0,0,0,.14); }\n  .full.lite .fvol input::-webkit-slider-thumb{ background:#15151a; box-shadow:0 3px 10px rgba(20,20,40,.25); }\n  .full.lite .ftimer button.on{ background:#15151a; border-color:#15151a; color:#fff; }\n\n  /* Bedside dock: true black, a dim clock, everything drifting a little so\n     nothing burns in. */\n  .dock{ display:none; position:fixed; inset:0; z-index:60; background:#000; color:#fff; overflow:hidden; }\n  .dock.on{ display:block; }\n  .dock .drift{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px; padding:0 24px; text-align:center;\n    transition:transform 20s ease-in-out; }\n  .dock .dclock{ font-size:min(27vw,150px); font-weight:200; letter-spacing:.01em; line-height:1; color:#c9c9cf; font-variant-numeric:tabular-nums; }\n  .dock .ddate{ font-size:14px; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:#5d5d66; margin-bottom:14px; }\n  .dock .dmix{ font-size:16px; font-weight:650; color:#a9a9b2; max-width:min(86vw,520px); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .dock .dmix .eq{ height:9px; opacity:.8; } .dock .dmix .eq i{ width:2.5px; background:#3fae63; }\n  .dock .dnote{ font-size:13.5px; font-weight:600; color:#6a6a74; min-height:17px; font-variant-numeric:tabular-nums; }\n  .dock .ctl{ position:absolute; left:0; right:0; bottom:calc(30px + env(safe-area-inset-bottom)); display:flex; justify-content:center; gap:12px;\n    opacity:0; transition:opacity .3s; pointer-events:none; }\n  .dock .ctl.on{ opacity:1; pointer-events:auto; }\n  .dock .ctl button{ border:1px solid #2c2c33; background:#121216; color:#eee; border-radius:99px; padding:12px 22px; font-size:15px; font-weight:700; display:inline-flex; align-items:center; gap:8px; }\n  .dock .hint{ position:absolute; bottom:calc(34px + env(safe-area-inset-bottom)); left:0; right:0; text-align:center; font-size:12px; color:#4a4a52; transition:opacity .6s; }\n\n  @media (orientation:landscape) and (max-height:560px){\n    .dock .dclock{ font-size:min(30vh,170px); }\n    .fbody{ flex-direction:row; align-items:center; gap:34px; max-width:760px; padding:6px 0 0; }\n    .pads{ flex:1 1 0; max-width:340px; gap:8px; } .pad{ border-radius:16px; font-size:19px; gap:4px; }\n    .fside{ flex:1 1 0; min-width:0; }\n    .fstate{ margin-top:0; } .ftitle{ font-size:20px; margin-top:4px; -webkit-line-clamp:1; }\n    .fbtn{ width:64px; height:64px; font-size:22px; margin-top:12px; } .fvol{ margin-top:14px; } .ftimer{ margin-top:12px; } .fnote{ margin-top:6px; }\n  }\n  @media (max-height:700px) and (orientation:portrait){\n    .fstate{ margin-top:16px; } .fbtn{ width:72px; height:72px; margin-top:14px; } .fvol{ margin-top:16px; } .ftimer{ margin-top:14px; }\n  }\n  @media (prefers-reduced-motion:reduce){ .blob, .eq i{ animation:none; } .full{ transition:none; } .dock .drift{ transition:none; } }\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-play\" viewBox=\"0 0 24 24\"><path d=\"M8 5.5v13a1 1 0 0 0 1.52.85l10.4-6.5a1 1 0 0 0 0-1.7L9.52 4.65A1 1 0 0 0 8 5.5z\"/></symbol>\n  <symbol id=\"i-pause\" viewBox=\"0 0 24 24\"><rect x=\"6\" y=\"5\" width=\"4.2\" height=\"14\" rx=\"1.4\"/><rect x=\"13.8\" y=\"5\" width=\"4.2\" height=\"14\" rx=\"1.4\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M5.5 12.5l4.2 4.2 8.8-9.4\"/></symbol>\n  <symbol id=\"i-up\" viewBox=\"0 0 24 24\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 14.5l6-6 6 6\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 9.5l6 6 6-6\"/></symbol>\n  <symbol id=\"i-moon\" viewBox=\"0 0 24 24\"><path d=\"M20.3 14.9A8.5 8.5 0 0 1 9.1 3.7a.7.7 0 0 0-.9-.9 9.9 9.9 0 1 0 13 13 .7.7 0 0 0-.9-.9z\"/></symbol>\n  <symbol id=\"i-vlo\" viewBox=\"0 0 24 24\"><path d=\"M4 9.6v4.8a1 1 0 0 0 1 1h2.7l4 3.3a.8.8 0 0 0 1.3-.62V5.92a.8.8 0 0 0-1.3-.62l-4 3.3H5a1 1 0 0 0-1 1z\"/><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" d=\"M16.2 9.6a3.4 3.4 0 0 1 0 4.8\"/></symbol>\n  <symbol id=\"i-vhi\" viewBox=\"0 0 24 24\"><path d=\"M3 9.6v4.8a1 1 0 0 0 1 1h2.7l4 3.3a.8.8 0 0 0 1.3-.62V5.92a.8.8 0 0 0-1.3-.62l-4 3.3H4a1 1 0 0 0-1 1z\"/><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" d=\"M15.2 9.6a3.4 3.4 0 0 1 0 4.8M18 7a7 7 0 0 1 0 10\"/></symbol>\n  <symbol id=\"s-rain\" viewBox=\"0 0 24 24\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M7.2 14.5a4 4 0 0 1 .5-7.97 5.4 5.4 0 0 1 10.4 1.4 3.35 3.35 0 0 1-.6 6.57zM8.6 17.6l-.9 2.4M12.5 17.6l-.9 2.4M16.4 17.6l-.9 2.4\"/></symbol>\n  <symbol id=\"s-ocean\" viewBox=\"0 0 24 24\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3 8c2-2.2 4-2.2 6 0s4 2.2 6 0 4-2.2 6 0M3 13c2-2.2 4-2.2 6 0s4 2.2 6 0 4-2.2 6 0M3 18c2-2.2 4-2.2 6 0s4 2.2 6 0 4-2.2 6 0\"/></symbol>\n  <symbol id=\"s-fire\" viewBox=\"0 0 24 24\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 3c.8 3.6 5.2 5.4 5.2 10.2a5.2 5.2 0 0 1-10.4 0c0-2.1 1-3.4 2.1-4.4.2 1.7.9 2.5 1.8 2.6C11.3 9 10.6 6 12 3z\"/></symbol>\n  <symbol id=\"s-stream\" viewBox=\"0 0 24 24\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 3.5c3 3.8 5.6 6.8 5.6 10.1a5.6 5.6 0 0 1-11.2 0c0-3.3 2.6-6.3 5.6-10.1zM9.3 14.2a2.7 2.7 0 0 0 2.7 2.7\"/></symbol>\n  <symbol id=\"s-wind\" viewBox=\"0 0 24 24\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3 9h10.5a2.5 2.5 0 1 0-2.5-2.5M3 13h15a2.5 2.5 0 1 1-2.5 2.5M3 17h6.5\"/></symbol>\n  <symbol id=\"s-white\" viewBox=\"0 0 24 24\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" d=\"M4 7.5v9M8 7.5v9M12 7.5v9M16 7.5v9M20 7.5v9\"/></symbol>\n  <symbol id=\"s-pink\" viewBox=\"0 0 24 24\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" d=\"M4 5v14M8 7v10M12 8.8v6.4M16 10.2v3.6M20 11.2v1.6\"/></symbol>\n  <symbol id=\"s-brown\" viewBox=\"0 0 24 24\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3 12c3-8.5 6-8.5 9 0s6 8.5 9 0\"/></symbol>\n</defs></svg>\n\n<!-- Night view -->\n<div class=\"full\" id=\"full\">\n  <div class=\"bg d\"></div><div class=\"bg l\"></div>\n  <div class=\"blob\"></div><div class=\"blob b\"></div>\n  <div class=\"scrim\"></div>\n  <div class=\"inner\">\n    <div class=\"ftop\">\n      <button class=\"glass rnd\" onclick=\"closeFull()\" aria-label=\"Close\"><svg><use href=\"#i-down\"/></svg></button>\n      <div class=\"lbl\">White Noise</div>\n      <button class=\"glass\" onclick=\"openDock()\" aria-label=\"Bedside dock\"><svg><use href=\"#i-moon\"/></svg>Dock</button>\n    </div>\n    <div class=\"fbody\">\n      <div class=\"pads\" id=\"pads\"></div>\n      <div class=\"fside\">\n        <div class=\"fstate\" id=\"fState\"><span class=\"eq\"><i></i><i></i><i></i></span><span id=\"fStateT\"></span></div>\n        <div class=\"ftitle\" id=\"fTitle\"></div>\n        <button class=\"fbtn\" id=\"fBtn\" onclick=\"toggleAll()\" aria-label=\"Play or pause\"></button>\n        <div class=\"fvol\"><svg><use href=\"#i-vlo\"/></svg><input id=\"fvol\" type=\"range\" min=\"0\" max=\"1\" step=\"0.01\" value=\"0.8\" aria-label=\"Volume\"><svg><use href=\"#i-vhi\"/></svg></div>\n        <div class=\"ftimer\" id=\"fTimer\"></div>\n        <div class=\"fnote\" id=\"fNote\"></div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- Bedside dock -->\n<div class=\"dock\" id=\"dock\" onclick=\"dockTap()\">\n  <div class=\"drift\" id=\"dDrift\">\n    <div class=\"dclock\" id=\"dClock\">--:--</div>\n    <div class=\"ddate\" id=\"dDate\"></div>\n    <div class=\"dmix\"><span class=\"eq\" id=\"dEq\"><i></i><i></i><i></i></span><span id=\"dMix\"></span></div>\n    <div class=\"dnote\" id=\"dNote\"></div>\n  </div>\n  <div class=\"hint\" id=\"dHint\">Tap for controls</div>\n  <div class=\"ctl\" id=\"dCtl\">\n    <button onclick=\"toggleAll();event.stopPropagation()\" id=\"dBtn\"></button>\n    <button onclick=\"closeDock();event.stopPropagation()\">Exit dock</button>\n  </div>\n</div>\n\n<h1>White Noise</h1>\n<div class=\"sub\">Tap sounds to mix your own — rain, fire, ocean and more. All made on-device, works offline.</div>\n<div id=\"list\"></div>\n<div class=\"bar\">\n  <div class=\"barrow\">\n    <button class=\"play\" id=\"play\" onclick=\"toggleAll()\" aria-label=\"Play or pause\"></button>\n    <div class=\"mixinfo\" onclick=\"openFull()\">\n      <div class=\"mixname\" id=\"mixName\"></div>\n      <div class=\"mixsub\" id=\"mixSub\"></div>\n    </div>\n    <button class=\"open\" onclick=\"openFull()\" aria-label=\"Open night view\"><svg><use href=\"#i-up\"/></svg></button>\n  </div>\n  <div class=\"volrow\">\n    <svg><use href=\"#i-vlo\"/></svg>\n    <input class=\"mvol\" id=\"mvol\" type=\"range\" min=\"0\" max=\"1\" step=\"0.01\" value=\"0.8\" aria-label=\"Volume\">\n    <svg><use href=\"#i-vhi\"/></svg>\n  </div>\n  <div class=\"timer\" id=\"timer\"></div>\n</div>\n<script>\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction haptic(s){ if (window.myllmHaptic) try { myllmHaptic(s); } catch(_){} }\nfunction load(k){ var s = window.myllmStorage; return s ? s.getItem(k).catch(function(){ return null; }) : Promise.resolve(null); }\nfunction keep(k, v){ var s = window.myllmStorage; if (s) try { s.setItem(k, v).catch(function(){}); } catch(_){} }\n\nvar DEFS=[\n {id:'rain',n:'Rain',d:'steady rainfall',h:212,s:66},\n {id:'ocean',n:'Ocean',d:'rolling waves',h:195,s:70},\n {id:'fire',n:'Fireplace',d:'crackling fire',h:18,s:78},\n {id:'stream',n:'Stream',d:'bubbling water',h:172,s:62},\n {id:'wind',n:'Wind',d:'gentle gusts',h:140,s:48},\n {id:'white',n:'White noise',d:'pure static',h:230,s:12},\n {id:'pink',n:'Pink noise',d:'softer hiss',h:330,s:62},\n {id:'brown',n:'Brown noise',d:'deep rumble',h:28,s:48}];\nvar TIMERS=[['Off',0],['15m',15],['30m',30],['60m',60]];\nvar ctx=null,master=null,built={},active={},vol={},masterVol=0.8,playing=false,sleepMin=0,sleepHandle=null,sleepEnd=0,sleepTick=null,sleepDone=false;\nfunction el(i){return document.getElementById(i)}\nfunction ico(id){return '<svg><use href=\"#'+id+'\"/></svg>'}\nDEFS.forEach(function(s){vol[s.id]=0.6});\n\n// ---- audio synthesis (no files) ----\nfunction ensureCtx(){if(!ctx){var AC=window.AudioContext||window.webkitAudioContext;ctx=new AC();master=ctx.createGain();master.gain.value=masterVol;master.connect(ctx.destination)}if(ctx.state==='suspended')ctx.resume()}\nfunction noiseBuffer(type,secs){\n  var len=Math.floor(ctx.sampleRate*(secs||2)),buf=ctx.createBuffer(1,len,ctx.sampleRate),d=buf.getChannelData(0),i;\n  if(type==='brown'){var last=0;for(i=0;i<len;i++){var w=Math.random()*2-1;last=(last+0.02*w)/1.02;d[i]=last*3.5}}\n  else if(type==='pink'){var b0=0,b1=0,b2=0,b3=0,b4=0,b5=0,b6=0;for(i=0;i<len;i++){var w=Math.random()*2-1;b0=0.99886*b0+w*0.0555179;b1=0.99332*b1+w*0.0750759;b2=0.96900*b2+w*0.1538520;b3=0.86650*b3+w*0.3104856;b4=0.55000*b4+w*0.5329522;b5=-0.7616*b5-w*0.0168980;d[i]=(b0+b1+b2+b3+b4+b5+b6+w*0.5362)*0.11;b6=w*0.115926}}\n  else{for(i=0;i<len;i++)d[i]=Math.random()*2-1}\n  return buf;\n}\nfunction src(type){var s=ctx.createBufferSource();s.buffer=noiseBuffer(type);s.loop=true;return s}\nfunction filt(type,freq,q){var f=ctx.createBiquadFilter();f.type=type;f.frequency.value=freq;if(q!=null)f.Q.value=q;return f}\nfunction lfoTo(param,rate,depth,base){var o=ctx.createOscillator();o.type='sine';o.frequency.value=rate;var g=ctx.createGain();g.gain.value=depth;o.connect(g);g.connect(param);if(base!=null)param.value=base;o.start();return o}\n\nfunction buildSound(id){\n  var g=ctx.createGain();g.gain.value=vol[id];g.connect(master);\n  var s,extra=[],crackle=null;\n  if(id==='white'){s=src('white');s.connect(g)}\n  else if(id==='pink'){s=src('pink');s.connect(g)}\n  else if(id==='brown'){s=src('brown');s.connect(g)}\n  else if(id==='rain'){s=src('pink');var hp=filt('highpass',600),lp=filt('lowpass',9000);s.connect(hp);hp.connect(lp);lp.connect(g)}\n  else if(id==='stream'){s=src('white');var hp=filt('highpass',1600),lp=filt('lowpass',7000);s.connect(hp);hp.connect(lp);lp.connect(g);extra.push(lfoTo(lp.frequency,0.9,1400,5000))}\n  else if(id==='wind'){s=src('pink');var bp=filt('bandpass',500,0.7);s.connect(bp);bp.connect(g);extra.push(lfoTo(bp.frequency,0.08,380,520))}\n  else if(id==='ocean'){s=src('brown');var lp=filt('lowpass',700);var wave=ctx.createGain();wave.gain.value=0.6;s.connect(lp);lp.connect(wave);wave.connect(g);extra.push(lfoTo(wave.gain,0.11,0.45,0.55))}\n  else if(id==='fire'){s=src('brown');var lp=filt('lowpass',1100);s.connect(lp);lp.connect(g);crackle=startCrackle(g)}\n  s.start();\n  return {g:g,s:s,extra:extra,crackle:crackle};\n}\nvar crackleBuf=null;\nfunction startCrackle(dest){\n  var stopped=false;\n  function pop(){\n    if(stopped||!ctx)return;\n    if(!crackleBuf)crackleBuf=noiseBuffer('white',0.2);\n    var b=ctx.createBufferSource();b.buffer=crackleBuf;\n    var f=filt('bandpass',1000+Math.random()*2500,1.2);\n    var cg=ctx.createGain();var t=ctx.currentTime;\n    cg.gain.setValueAtTime(0.0001,t);\n    cg.gain.exponentialRampToValueAtTime(0.25+Math.random()*0.5,t+0.004);\n    cg.gain.exponentialRampToValueAtTime(0.0001,t+0.04+Math.random()*0.09);\n    b.connect(f);f.connect(cg);cg.connect(dest);b.start(t);b.stop(t+0.2);\n    setTimeout(pop,90+Math.random()*420);\n  }\n  pop();\n  return {cancel:function(){stopped=true}};\n}\nfunction killSound(o){try{o.s.stop()}catch(e){}o.extra.forEach(function(x){try{x.stop()}catch(e){}});if(o.crackle)o.crackle.cancel();try{o.g.disconnect()}catch(e){}}\n\n// ---- control ----\nfunction anyActive(){return Object.keys(active).some(function(k){return active[k]})}\nfunction startId(id){if(!built[id]){ensureCtx();built[id]=buildSound(id)}}\nfunction stopId(id){if(built[id]){killSound(built[id]);delete built[id]}}\nfunction toggle(id){\n  if(active[id]){active[id]=false;stopId(id)}\n  else{active[id]=true;playing=true;\n    Object.keys(active).forEach(function(k){if(active[k])startId(k)})}   // a paused mix comes back whole, not just the new sound\n  if(!anyActive())playing=false;\n  haptic('selection');\n  save();render();\n}\nfunction setVol(id,v){vol[id]=v;if(built[id])built[id].g.gain.value=v;save();paintHue()}\nfunction setMaster(v){masterVol=v;if(master)master.gain.value=v;el('mvol').value=v;el('fvol').value=v;save()}\nfunction toggleAll(){\n  if(!anyActive())return;\n  haptic('light');\n  if(playing){playing=false;Object.keys(built).forEach(stopId)}\n  else{playing=true;ensureCtx();Object.keys(active).forEach(function(k){if(active[k])startId(k)})}\n  render();\n}\n\n// ---- sleep timer ----\n/* The end time is kept, not just a timeout: a phone that dozes stretches\n   timers, so every tick checks the clock. */\nfunction setTimer(min){\n  haptic('selection');\n  sleepMin=min;sleepDone=false;\n  if(sleepHandle){clearTimeout(sleepHandle);sleepHandle=null}\n  if(sleepTick){clearInterval(sleepTick);sleepTick=null}\n  sleepEnd=min>0?Date.now()+min*60000:0;\n  if(min>0){sleepHandle=setTimeout(checkSleep,min*60000);sleepTick=setInterval(checkSleep,1000)}\n  renderTimer();\n}\nfunction checkSleep(){\n  if(!sleepEnd)return;\n  if(Date.now()<sleepEnd){paintNotes();return}\n  if(sleepHandle){clearTimeout(sleepHandle);sleepHandle=null}\n  if(sleepTick){clearInterval(sleepTick);sleepTick=null}\n  sleepEnd=0;sleepMin=0;sleepDone=true;\n  playing=false;Object.keys(built).forEach(stopId);\n  /* Leave the dock and the night view: that hands the screen back to the\n     phone's own auto-lock, so it can sleep too. */\n  if(dockOn){if(fullOn)closeFull(true);closeDock()}\n  render();renderTimer();\n}\nfunction fmtLeft(){\n  var s=Math.max(0,Math.ceil((sleepEnd-Date.now())/1000)),m=Math.floor(s/60);s=s%60;\n  return m+':'+(s<10?'0':'')+s;\n}\n\n// ---- look ----\nfunction mixName(){\n  var on=DEFS.filter(function(s){return active[s.id]}).map(function(s){return s.n});\n  return on.length?on.join(' · '):'';\n}\nvar hueNow=245,hue2Now=305;\nfunction near(from,to){return from+((((to-from)%360)+540)%360)-180}\nfunction paintHue(){\n  var on=DEFS.filter(function(s){return active[s.id]}).map(function(s){return {d:s,w:Math.max(0.05,vol[s.id])}})\n    .sort(function(a,b){return b.w-a.w});\n  var h=245,h2=305,sat=60;\n  if(on.length){\n    var x=0,y=0,sw=0,ss=0;\n    on.forEach(function(o){var r=o.d.h*Math.PI/180;x+=Math.cos(r)*o.w;y+=Math.sin(r)*o.w;ss+=o.d.s*o.w;sw+=o.w});\n    h=(Math.abs(x)+Math.abs(y)<0.001)?on[0].d.h:Math.atan2(y,x)*180/Math.PI;\n    h2=on[1]?on[1].d.h:h+60;\n    sat=ss/sw;\n  }\n  hueNow=near(hueNow,h);hue2Now=near(hue2Now,h2);\n  var f=el('full').style;\n  f.setProperty('--h',String(Math.round(hueNow)));f.setProperty('--h2',String(Math.round(hue2Now)));f.setProperty('--s',Math.round(sat)+'%');\n}\nfunction paintNotes(){\n  var left=sleepEnd?('Stops in '+fmtLeft()):'';\n  var name=mixName(),any=!!name;\n  el('mixName').textContent=any?name:'Pick a sound';\n  el('mixSub').textContent=left||(sleepDone?'Sleep timer finished':(any?(playing?'Playing · tap for night view':'Paused · tap for night view'):'Tap sounds to build your mix'));\n  el('fTitle').textContent=any?name:'Pick a sound';\n  el('fStateT').textContent=any?(playing?'Playing':'Paused'):'Nothing playing';\n  el('fState').classList.toggle('live',playing);\n  el('fNote').textContent=left||(sleepDone?'Sleep timer finished':'');\n  el('dMix').textContent=any?name:'Nothing playing';\n  el('dEq').style.display=playing?'':'none';\n  el('dNote').textContent=left||(playing?'':'Paused');\n}\n\n// ---- render ----\nfunction render(){\n  var L=el('list');L.innerHTML='';\n  DEFS.forEach(function(s){\n    var on=!!active[s.id];\n    var d=document.createElement('div');d.className='sound'+(on?' on':'');\n    d.innerHTML='<div class=\"head\"><div class=\"tile\" style=\"--th:'+s.h+';--ts:'+s.s+'%\">'+ico('s-'+s.id)+'</div><div class=\"nm\">'+s.n+'<small>'+s.d+'</small></div><div class=\"dot\">'+ico('i-check')+'</div></div>'+\n      '<input class=\"vol\" type=\"range\" min=\"0\" max=\"1\" step=\"0.01\" value=\"'+vol[s.id]+'\" aria-label=\"'+s.n+' volume\">';\n    d.querySelector('.head').onclick=function(){toggle(s.id)};\n    var sl=d.querySelector('.vol');sl.oninput=function(){setVol(s.id,parseFloat(sl.value))};\n    L.appendChild(d);\n    var p=el('pad-'+s.id);if(p)p.classList.toggle('on',on);\n  });\n  var any=anyActive(),pi=playing?ico('i-pause'):ico('i-play');\n  el('play').innerHTML=pi;el('fBtn').innerHTML=pi;\n  el('play').style.opacity=any?'':'.4';el('fBtn').disabled=!any;\n  el('dBtn').innerHTML=playing?ico('i-pause')+'Pause':ico('i-play')+'Play';\n  paintHue();paintNotes();\n}\nfunction buildPads(){\n  var P=el('pads');\n  DEFS.forEach(function(s){\n    var b=document.createElement('button');b.className='pad glass';b.id='pad-'+s.id;\n    b.style.setProperty('--th',s.h);b.style.setProperty('--ts',s.s+'%');\n    b.innerHTML=ico('s-'+s.id)+'<span>'+s.n.replace(' noise','')+'</span>';\n    b.onclick=function(){toggle(s.id)};\n    P.appendChild(b);\n  });\n}\nfunction renderTimer(){\n  ['timer','fTimer'].forEach(function(id){\n    var T=el(id);T.innerHTML='';\n    TIMERS.forEach(function(t){var b=document.createElement('button');b.textContent=t[0];b.className=(id==='fTimer'?'glass':'')+(sleepMin===t[1]?' on':'');b.onclick=function(){setTimer(t[1])};T.appendChild(b)});\n  });\n  paintNotes();\n}\nfunction save(){keep('wn',JSON.stringify({active:active,vol:vol,master:masterVol}))}\n\n// ---- night view and dock ----\n/* Both want the whole display. myllmImmersive hides MyLLM's own title bar and\n   the status bar; only the dock asks for the screen to stay awake. On a build\n   without it both views still work — they just sit under the title bar. */\nvar fullOn=false,dockOn=false,dockClock=null,dockDrift=null,dockCtlTimer=null,wakeLock=null;\nfunction syncChrome(){\n  if(!window.myllmImmersive)return;\n  try{myllmImmersive(fullOn||dockOn,{keepAwake:dockOn}).catch(function(){})}catch(_){}\n}\nfunction syncLook(){\n  el('full').classList.toggle('lite',!window.myllmImmersive&&!(window.matchMedia&&matchMedia('(prefers-color-scheme: dark)').matches));\n}\nfunction openFull(){\n  haptic('light');\n  fullOn=true;syncLook();paintHue();paintNotes();\n  el('full').classList.add('on');document.body.classList.add('lock');\n  syncChrome();\n}\nfunction closeFull(quiet){\n  if(quiet!==true)haptic('light');\n  fullOn=false;\n  el('full').classList.remove('on');document.body.classList.remove('lock');\n  syncChrome();\n}\nvar DAYS=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];\nvar MONTHS=['January','February','March','April','May','June','July','August','September','October','November','December'];\nfunction dockTime(){\n  var d=new Date(),h=d.getHours(),m=d.getMinutes();\n  el('dClock').textContent=(h<10?'0':'')+h+':'+(m<10?'0':'')+m;\n  el('dDate').textContent=DAYS[d.getDay()]+' '+d.getDate()+' '+MONTHS[d.getMonth()];\n}\nfunction driftOnce(){\n  var x=Math.round((Math.random()-0.5)*44),y=Math.round((Math.random()-0.5)*44);\n  el('dDrift').style.transform='translate('+x+'px,'+y+'px)';\n}\nfunction requestWake(){\n  if(!('wakeLock' in navigator))return;\n  navigator.wakeLock.request('screen').then(function(l){wakeLock=l}).catch(function(){wakeLock=null});\n}\nfunction releaseWake(){if(wakeLock){try{wakeLock.release()}catch(_){}wakeLock=null}}\nfunction openDock(){\n  haptic('medium');\n  dockOn=true;\n  dockTime();driftOnce();paintNotes();\n  el('dock').classList.add('on');document.body.classList.add('lock');\n  el('dCtl').classList.remove('on');\n  el('dHint').style.opacity='1';\n  setTimeout(function(){el('dHint').style.opacity='0'},4000);\n  dockClock=setInterval(dockTime,15000);\n  dockDrift=setInterval(driftOnce,60000);\n  requestWake();syncChrome();\n}\nfunction closeDock(){\n  dockOn=false;\n  el('dock').classList.remove('on');\n  if(!fullOn)document.body.classList.remove('lock');\n  clearInterval(dockClock);clearInterval(dockDrift);clearTimeout(dockCtlTimer);\n  dockClock=dockDrift=dockCtlTimer=null;\n  releaseWake();syncChrome();\n}\nfunction dockTap(){\n  if(!dockOn)return;\n  el('dHint').style.opacity='0';\n  el('dCtl').classList.add('on');\n  clearTimeout(dockCtlTimer);\n  dockCtlTimer=setTimeout(function(){el('dCtl').classList.remove('on')},5000);\n}\ndocument.addEventListener('visibilitychange',function(){\n  if(document.hidden){releaseWake();return}\n  checkSleep();\n  if(dockOn){dockTime();requestWake()}\n  if(fullOn||dockOn)syncChrome();          // MyLLM puts its bars back when the app is left\n});\nif(window.matchMedia){\n  var mq=matchMedia('(prefers-color-scheme: dark)');\n  if(mq.addEventListener)mq.addEventListener('change',syncLook);else if(mq.addListener)mq.addListener(syncLook);\n}\n\n// ---- boot ----\nel('mvol').addEventListener('input',function(){setMaster(parseFloat(el('mvol').value))});\nel('fvol').addEventListener('input',function(){setMaster(parseFloat(el('fvol').value))});\nbuildPads();render();renderTimer();\nload('wn').then(function(v){\n  if(v)try{var o=JSON.parse(v);active=o.active||{};if(o.vol)DEFS.forEach(function(s){if(typeof o.vol[s.id]==='number')vol[s.id]=o.vol[s.id]});\n    if(typeof o.master==='number'){masterVol=o.master;el('mvol').value=masterVol;el('fvol').value=masterVol}}catch(e){}\n  // restore selection visually; audio waits for a tap (browsers require a gesture)\n  playing=false;\n  render();renderTimer();\n});\n</script></body></html>\n", "kind": "html", "iconSymbol": "speaker.wave.3.fill", "iconColor": "indigo"}