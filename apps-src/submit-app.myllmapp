{"name": "Submit Your App", "kind": "html", "iconSymbol": "paperplane.fill", "iconColor": "blue", "html": "<!doctype html>\n<!--\n  Submit Your App — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Submit Your App</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>\n  :root{ color-scheme:light dark;\n    --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n    --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n    --fill:rgba(120,120,128,.12); --h:222; }\n  @media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n    --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:640px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:760px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.97); }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 12px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 28%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  p.sub{ font-size:14px; color:var(--muted); margin:0 2px 14px; line-height:1.5; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  label{ display:block; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:14px 2px 7px; }\n  label:first-child{ margin-top:0; }\n  input, textarea{ width:100%; font:inherit; font-size:16px; padding:12px; border-radius:12px;\n    border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; }\n  input:focus, textarea:focus{ border-color:var(--acc); }\n  textarea#code{ min-height:150px; font-family:ui-monospace,Menlo,monospace; font-size:16px; line-height:1.4; resize:vertical; }\n  .go{ width:100%; min-height:50px; border:none; border-radius:14px; margin-top:14px; font-size:16px; font-weight:700;\n    background:var(--acc); color:#fff; display:flex; align-items:center; justify-content:center; gap:8px; }\n  .go.ghost{ background:var(--bg); color:var(--ink); border:1px solid var(--line); margin-top:10px; }\n\n  .how{ display:flex; gap:12px; align-items:flex-start; }\n  .how .tile{ width:36px; height:36px; border-radius:10px; font-size:16px; }\n  .how b{ display:block; font-size:15px; font-weight:750; margin-bottom:3px; }\n  .how span{ font-size:14px; line-height:1.55; color:var(--ink); }\n  .how span em{ font-style:normal; font-weight:700; }\n\n  #checks:not(:empty){ margin-top:12px; }\n  .check{ display:flex; gap:10px; padding:9px 0; border-bottom:1px solid var(--line); font-size:14.5px; font-weight:600; align-items:flex-start; }\n  .check:first-child{ padding-top:0; } .check:last-child{ border-bottom:none; padding-bottom:0; }\n  .check .ic{ flex-shrink:0; width:22px; height:22px; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#fff; margin-top:-1px; }\n  .check .ic svg{ width:13px; height:13px; }\n  .check .ic.ok{ background:#1f9d55; } .check .ic.bad{ background:#e5342f; } .check .ic.info{ background:var(--muted); }\n  .check small{ display:block; color:var(--muted); font-size:12.5px; font-weight:500; margin-top:2px; line-height:1.4; overflow-wrap:anywhere; }\n  .note{ font-size:12.5px; color:var(--muted); line-height:1.55; margin-top:12px; }\n  .note b{ color:var(--ink); }\n  #out{ display:none; }\n  #pkg{ min-height:110px; font-family:ui-monospace,Menlo,monospace; font-size:13px; }\n  @media (prefers-reduced-motion:reduce){ button:active{ transform:none; } }\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style>\n<style>:root{--build-id:\"c24a549174\";}</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-plane\" viewBox=\"0 0 24 24\"><path d=\"M21.4 2.6a1 1 0 0 1 .2 1.1l-7.2 17a1 1 0 0 1-1.9-.1l-1.9-7.2-7.2-1.9a1 1 0 0 1-.1-1.9l17-7.2a1 1 0 0 1 1.1.2zM12.6 12.8l1.1 4.2 4.4-10.4z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-code\" viewBox=\"0 0 24 24\"><path d=\"M8.7 6.3a1 1 0 0 1 0 1.4L4.4 12l4.3 4.3a1 1 0 1 1-1.4 1.4l-5-5a1 1 0 0 1 0-1.4l5-5a1 1 0 0 1 1.4 0zm6.6 0a1 1 0 0 1 1.4 0l5 5a1 1 0 0 1 0 1.4l-5 5a1 1 0 1 1-1.4-1.4l4.3-4.3-4.3-4.3a1 1 0 0 1 0-1.4z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-box\" viewBox=\"0 0 24 24\"><path d=\"M11.5 2.2a1 1 0 0 1 1 0l8 4.4a1 1 0 0 1 .5.9v9a1 1 0 0 1-.5.9l-8 4.4a1 1 0 0 1-1 0l-8-4.4a1 1 0 0 1-.5-.9v-9a1 1 0 0 1 .5-.9zM5 9.2v7.7l6 3.3v-7.7zm14 0l-6 3.3v7.7l6-3.3zM12 4.2L6.1 7.5 12 10.8l5.9-3.3z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-share\" viewBox=\"0 0 24 24\"><path d=\"M12 2.6a1 1 0 0 1 .7.3l3.5 3.5a1 1 0 1 1-1.4 1.4L13 6v8.5a1 1 0 0 1-2 0V6L9.2 7.8a1 1 0 0 1-1.4-1.4l3.5-3.5a1 1 0 0 1 .7-.3zM6.5 10h1a1 1 0 0 1 0 2h-1a.5.5 0 0 0-.5.5v7c0 .3.2.5.5.5h11c.3 0 .5-.2.5-.5v-7a.5.5 0 0 0-.5-.5h-1a1 1 0 0 1 0-2h1a2.5 2.5 0 0 1 2.5 2.5v7a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 19.5v-7A2.5 2.5 0 0 1 6.5 10z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-ext\" viewBox=\"0 0 24 24\"><path d=\"M14 3h6a1 1 0 0 1 1 1v6a1 1 0 0 1-2 0V6.4l-7.3 7.3a1 1 0 0 1-1.4-1.4L17.6 5H14a1 1 0 0 1 0-2zM6.5 6H10a1 1 0 0 1 0 2H6.5a.5.5 0 0 0-.5.5v11c0 .3.2.5.5.5h11c.3 0 .5-.2.5-.5V14a1 1 0 0 1 2 0v3.5A2.5 2.5 0 0 1 17.5 20h-11A2.5 2.5 0 0 1 4 17.5v-9A2.5 2.5 0 0 1 6.5 6z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M5 12.6l4.6 4.6L19.2 7.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3.2\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><path d=\"M12 10.2a1.4 1.4 0 0 1 1.4 1.4v6a1.4 1.4 0 0 1-2.8 0v-6a1.4 1.4 0 0 1 1.4-1.4zm0-5.2a1.7 1.7 0 1 1 0 3.4 1.7 1.7 0 0 1 0-3.4z\" fill=\"currentColor\"/></symbol>\n</defs></svg>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-plane\"/></svg></div>\n  <div class=\"ht\"><h1>Submit Your App</h1><p>Put your creation in this gallery</p></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Submit Your App\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n<p class=\"sub\">Built something good in MyLLM? Put it in this gallery, on iOS and Android, credited to you. This wizard checks the house rules and packages your submission — a human reviews every app before it goes live.</p>\n\n<div class=\"card how\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-code\"/></svg></div>\n  <div><b>How to get your app's code:</b><span>springboard → long-press your app → <em>View Code</em> → select all → copy. Then paste it below.</span></div>\n</div>\n\n<div class=\"card\">\n  <label for=\"code\">Your app's code</label>\n  <textarea id=\"code\" placeholder=\"<!doctype html>…\" oninput=\"onCode()\" autocapitalize=\"off\" autocorrect=\"off\" spellcheck=\"false\"></textarea>\n  <div id=\"checks\"></div>\n</div>\n\n<div class=\"card\">\n  <label for=\"name\">App name</label>\n  <input id=\"name\" placeholder=\"My Brilliant App\">\n  <label for=\"pitch\">One-line pitch</label>\n  <input id=\"pitch\" placeholder=\"What does it do, in a sentence?\">\n  <label for=\"author\">Credit you as</label>\n  <input id=\"author\" placeholder=\"Your name or handle\">\n  <button class=\"go\" onclick=\"buildPackage()\"><svg class=\"i\"><use href=\"#i-box\"/></svg><span>Package my submission</span></button>\n</div>\n\n<div class=\"card\" id=\"out\">\n  <label>Your submission package</label>\n  <textarea id=\"pkg\" readonly onclick=\"this.select()\"></textarea>\n  <button class=\"go\" id=\"shareBtn\" onclick=\"sharePkg()\"><svg class=\"i\"><use href=\"#i-share\"/></svg><span>Share it (email, AirDrop…)</span></button>\n  <button class=\"go ghost\" onclick=\"openIssue()\"><svg class=\"i\"><use href=\"#i-ext\"/></svg><span>Open the GitHub submission form</span></button>\n  <p class=\"note\">Send the package to <b>MyLLM@opticell-limited.com</b> or paste it into a GitHub issue at <b>github.com/TeamDzX/myllm-assets</b>. You'll hear back on the issue or by reply — most reviews take a few days. Submissions are covered by the <b>Gallery Terms</b> (github.com/TeamDzX/myllm-assets → GALLERY-TERMS.md) — in short: the code is yours to publish, you keep ownership, and you licence us to host and distribute it.</p>\n</div>\n\n<script>\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\"); }\n\n/* The same rules a reviewer applies first — catching them here saves everyone\n   a round-trip. The remote-script rule is the load-bearing one: a reviewed\n   app must not be able to change after review. */\nfunction runChecks(code){\n  var out = [];\n  var kb = Math.round(code.length / 1024);\n  out.push({ok:code.length > 400 && /<html|<body|<!doctype/i.test(code),\n            t:\"Looks like a complete HTML app\", s:kb + \" KB\"});\n  out.push({ok:kb <= 600, t:\"Under the 600 KB size limit\",\n            s:kb > 600 ? \"Trim embedded images or assets\" : \"\"});\n  var remoteScript = /<script[^>]+src\\s*=/i.test(code);\n  out.push({ok:!remoteScript, t:\"No remote scripts\",\n            s:remoteScript ? \"Inline all JavaScript — apps that load code from a URL can change after review, so they can't be accepted\" : \"All code is inline — good\"});\n  var remoteFrame = /<iframe[^>]+src\\s*=\\s*[\"']https?:/i.test(code);\n  out.push({ok:!remoteFrame, t:\"No remote iframes\",\n            s:remoteFrame ? \"Embedded external pages can't be reviewed — remove them\" : \"\"});\n  var usesLS = /localStorage|sessionStorage/.test(code);\n  out.push({ok:!usesLS, t:\"Uses myllmStorage, not localStorage\",\n            s:usesLS ? \"localStorage doesn't persist in the sandbox — switch to myllmStorage (it's async)\" : \"\"});\n  var usesDialogs = /\\b(alert|confirm|prompt)\\s*\\(/.test(code);\n  out.push({ok:!usesDialogs, t:\"No alert / confirm / prompt\",\n            s:usesDialogs ? \"These silently do nothing in MyLLMos — use in-page messages\" : \"\"});\n  /* informational: which bridges it touches (reviewers verify these are honest) */\n  var bridges = (code.match(/myllm[A-Z][a-zA-Z]+/g) || []).filter(function(v,i,a){ return a.indexOf(v) === i; });\n  out.push({ok:true, info:true, t:\"Bridges used\", s:bridges.length ? bridges.join(\", \") : \"none — fully self-contained\"});\n  var usesFetchRaw = /\\bfetch\\s*\\(/.test(code) && !/myllmFetch/.test(code);\n  if (usesFetchRaw) out.push({ok:false, t:\"Uses browser fetch()\",\n            s:\"Plain fetch is blocked in the sandbox — use myllmFetch\"});\n  return out;\n}\n\nvar lastChecks = [];\nfunction onCode(){\n  var code = el(\"code\").value;\n  if (!code.trim()){ el(\"checks\").innerHTML = \"\"; return; }\n  lastChecks = runChecks(code);\n  el(\"checks\").innerHTML = lastChecks.map(function(c){\n    var kind = c.info ? \"info\" : (c.ok ? \"ok\" : \"bad\");\n    var ic = '<span class=\"ic ' + kind + '\"><svg><use href=\"#i-' + (c.info ? \"info\" : (c.ok ? \"check\" : \"x\")) + '\"/></svg></span>';\n    return '<div class=\"check\">' + ic + '<div>' + esc(c.t) +\n      (c.s ? '<small>' + esc(c.s) + '</small>' : '') + '</div></div>';\n  }).join(\"\");\n  /* try to prefill the name from <title> */\n  if (!el(\"name\").value){\n    var m = code.match(/<title>([^<]+)<\\/title>/i);\n    if (m) el(\"name\").value = m[1].trim();\n  }\n}\n\nfunction buildPackage(){\n  var code = el(\"code\").value;\n  var name = el(\"name\").value.trim();\n  var pitch = el(\"pitch\").value.trim();\n  var author = el(\"author\").value.trim();\n  if (!code.trim() || !name || !author){\n    haptic(\"light\");\n    el(\"out\").style.display = \"block\";\n    el(\"pkg\").value = \"Fill in the code, app name and your credit first.\";\n    return;\n  }\n  var failed = lastChecks.filter(function(c){ return !c.ok; });\n  var bridges = (code.match(/myllm[A-Z][a-zA-Z]+/g) || []).filter(function(v,i,a){ return a.indexOf(v) === i; });\n  var pkg = {\n    myllmosSubmission: 1,\n    name: name,\n    pitch: pitch,\n    author: author,\n    bridges: bridges,\n    sizeKB: Math.round(code.length / 1024),\n    checksFailed: failed.map(function(c){ return c.t; }),\n    html: code\n  };\n  el(\"out\").style.display = \"block\";\n  el(\"pkg\").value = JSON.stringify(pkg);\n  haptic(\"success\");\n  if (failed.length){\n    el(\"pkg\").value = \"NOTE: \" + failed.length + \" check(s) failing — fix them first or explain in your submission why they should pass.\\n\\n\" + el(\"pkg\").value;\n  }\n  el(\"shareBtn\").style.display = window.myllmShare ? \"flex\" : \"none\";\n}\nfunction sharePkg(){\n  if (window.myllmShare){ try{ myllmShare({text:el(\"pkg\").value}); }catch(_){} }\n  haptic(\"light\");\n}\nfunction openIssue(){\n  haptic(\"light\");\n  var name = encodeURIComponent(\"[App] \" + (el(\"name\").value.trim() || \"My app\"));\n  window.open(\"https://github.com/TeamDzX/myllm-assets/issues/new?template=app-submission.md&title=\" + name);\n}\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes.\n   The spacer keeps the header clear of the status bar / Dynamic Island. It is\n   live CSS — env(safe-area-inset-top) — not a measured number: the inset is\n   still 0 when the page loads and only grows once MyLLM's bar has gone (v1\n   measured once, so the title sat under the island). If the page's own styles\n   already pad the header down by the inset, the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  /* Does any rule that applies to the header or an ancestor already use the top inset? */\n  function pageHandlesInset(head){\n    var chain = [], n, found = false;\n    for (n = head; n && n.nodeType === 1; n = n.parentElement) chain.push(n);\n    function walk(rules){\n      for (var i = 0; i < rules.length && !found; i++){\n        var r = rules[i];\n        if (r.cssRules && !r.selectorText) { walk(r.cssRules); continue; }\n        if (!r.selectorText || !/safe-area-inset-top/.test(r.cssText) || !/(padding|margin|top)\\s*:/.test(r.cssText)) continue;\n        if (/\\.imm-safe/.test(r.selectorText)) continue;\n        for (var k = 0; k < chain.length; k++){\n          try { if (chain[k].matches(r.selectorText)) { found = true; break; } } catch(e){}\n        }\n      }\n    }\n    for (var s = 0; s < document.styleSheets.length && !found; s++){\n      try { walk(document.styleSheets[s].cssRules); } catch(e){}\n    }\n    for (n = head; n && n.nodeType === 1 && !found; n = n.parentElement){\n      if (/safe-area-inset-top/.test(n.getAttribute(\"style\") || \"\")) found = true;\n    }\n    return found;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = (document.body.classList.contains(\"imm\") && !pageHandlesInset(head)) ? \"env(safe-area-inset-top)\" : \"0px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script>\n</body>\n</html>\n"}