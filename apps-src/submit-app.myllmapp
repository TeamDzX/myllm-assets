{"name": "Submit Your App", "kind": "html", "iconSymbol": "paperplane.fill", "iconColor": "blue", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Submit Your App</title>\n<style>\n  :root { color-scheme: light dark; }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111);\n    max-width:640px; margin:0 auto; min-height:100dvh;\n    padding:16px 16px calc(30px + env(safe-area-inset-bottom));\n  }\n  h1{ font-size:22px; font-weight:800; margin:6px 2px 4px; }\n  p.sub{ font-size:13.5px; color:var(--myllm-muted,#8a8a8e); margin:0 2px 14px; line-height:1.5; }\n  .card{\n    background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8);\n    border-radius:16px; padding:14px; margin-bottom:12px;\n  }\n  label{ display:block; font-size:11.5px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:var(--myllm-muted,#8a8a8e); margin:12px 0 6px; }\n  label:first-child{ margin-top:0; }\n  input, textarea{\n    width:100%; font-size:15px; padding:11px 12px; border-radius:12px;\n    border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111);\n    font-family:inherit;\n  }\n  textarea#code{ min-height:150px; font-family:ui-monospace,Menlo,monospace; font-size:12px; resize:vertical; }\n  .go{\n    width:100%; border:none; border-radius:13px; padding:14px; margin-top:12px;\n    font-size:15.5px; font-weight:750; background:var(--myllm-accent,#0a84ff); color:#fff;\n  }\n  .go.ghost{ background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111); border:1px solid var(--myllm-border,#e3e3e8); }\n  .check{ display:flex; gap:10px; padding:8px 0; border-bottom:1px solid var(--myllm-border,#e3e3e8); font-size:14px; align-items:flex-start; }\n  .check:last-child{ border-bottom:none; }\n  .check .ic{ flex-shrink:0; font-size:15px; }\n  .check small{ display:block; color:var(--myllm-muted,#8a8a8e); font-size:12px; margin-top:2px; line-height:1.4; }\n  .steps{ font-size:14px; line-height:1.6; }\n  .steps b{ font-weight:750; }\n  .note{ font-size:12.5px; color:var(--myllm-muted,#8a8a8e); line-height:1.5; margin-top:10px; }\n  .note a{ color:var(--myllm-accent,#0a84ff); }\n  #out{ display:none; }\n  #pkg{ min-height:110px; font-family:ui-monospace,Menlo,monospace; font-size:11px; }\n</style>\n</head>\n<body>\n\n<h1>🚀 Submit Your App</h1>\n<p class=\"sub\">Built something good in MyLLM? Put it in this gallery, on iOS and Android, credited to you. This wizard checks the house rules and packages your submission — a human reviews every app before it goes live.</p>\n\n<div class=\"card steps\">\n  <b>How to get your app's code:</b> springboard → long-press your app → <b>View Code</b> → select all → copy. Then paste it below.\n</div>\n\n<div class=\"card\">\n  <label>Your app's code</label>\n  <textarea id=\"code\" placeholder=\"<!doctype html>…\" oninput=\"onCode()\"></textarea>\n  <div id=\"checks\"></div>\n</div>\n\n<div class=\"card\">\n  <label>App name</label>\n  <input id=\"name\" placeholder=\"My Brilliant App\">\n  <label>One-line pitch</label>\n  <input id=\"pitch\" placeholder=\"What does it do, in a sentence?\">\n  <label>Credit you as</label>\n  <input id=\"author\" placeholder=\"Your name or handle\">\n  <button class=\"go\" onclick=\"buildPackage()\">Package my submission</button>\n</div>\n\n<div class=\"card\" id=\"out\">\n  <label>Your submission package</label>\n  <textarea id=\"pkg\" readonly onclick=\"this.select()\"></textarea>\n  <button class=\"go\" id=\"shareBtn\" onclick=\"sharePkg()\">Share it (email, AirDrop…)</button>\n  <button class=\"go ghost\" onclick=\"openIssue()\">Open the GitHub submission form</button>\n  <p class=\"note\">Send the package to <b>MyLLM@opticell-limited.com</b> or paste it into a GitHub issue at <b>github.com/TeamDzX/myllm-assets</b>. You'll hear back on the issue or by reply — most reviews take a few days. Submissions are covered by the <b>Gallery Terms</b> (github.com/TeamDzX/myllm-assets → GALLERY-TERMS.md) — in short: the code is yours to publish, you keep ownership, and you licence us to host and distribute it.</p>\n</div>\n\n<script>\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\"); }\n\n/* The same rules a reviewer applies first — catching them here saves everyone\n   a round-trip. The remote-script rule is the load-bearing one: a reviewed\n   app must not be able to change after review. */\nfunction runChecks(code){\n  var out = [];\n  var kb = Math.round(code.length / 1024);\n  out.push({ok:code.length > 400 && /<html|<body|<!doctype/i.test(code),\n            t:\"Looks like a complete HTML app\", s:kb + \" KB\"});\n  out.push({ok:kb <= 600, t:\"Under the 600 KB size limit\",\n            s:kb > 600 ? \"Trim embedded images or assets\" : \"\"});\n  var remoteScript = /<script[^>]+src\\s*=/i.test(code);\n  out.push({ok:!remoteScript, t:\"No remote scripts\",\n            s:remoteScript ? \"Inline all JavaScript — apps that load code from a URL can change after review, so they can't be accepted\" : \"All code is inline — good\"});\n  var remoteFrame = /<iframe[^>]+src\\s*=\\s*[\"']https?:/i.test(code);\n  out.push({ok:!remoteFrame, t:\"No remote iframes\",\n            s:remoteFrame ? \"Embedded external pages can't be reviewed — remove them\" : \"\"});\n  var usesLS = /localStorage|sessionStorage/.test(code);\n  out.push({ok:!usesLS, t:\"Uses myllmStorage, not localStorage\",\n            s:usesLS ? \"localStorage doesn't persist in the sandbox — switch to myllmStorage (it's async)\" : \"\"});\n  var usesDialogs = /\\b(alert|confirm|prompt)\\s*\\(/.test(code);\n  out.push({ok:!usesDialogs, t:\"No alert / confirm / prompt\",\n            s:usesDialogs ? \"These silently do nothing in MyLLMos — use in-page messages\" : \"\"});\n  /* informational: which bridges it touches (reviewers verify these are honest) */\n  var bridges = (code.match(/myllm[A-Z][a-zA-Z]+/g) || []).filter(function(v,i,a){ return a.indexOf(v) === i; });\n  out.push({ok:true, info:true, t:\"Bridges used\", s:bridges.length ? bridges.join(\", \") : \"none — fully self-contained\"});\n  var usesFetchRaw = /\\bfetch\\s*\\(/.test(code) && !/myllmFetch/.test(code);\n  if (usesFetchRaw) out.push({ok:false, t:\"Uses browser fetch()\",\n            s:\"Plain fetch is blocked in the sandbox — use myllmFetch\"});\n  return out;\n}\n\nvar lastChecks = [];\nfunction onCode(){\n  var code = el(\"code\").value;\n  if (!code.trim()){ el(\"checks\").innerHTML = \"\"; return; }\n  lastChecks = runChecks(code);\n  el(\"checks\").innerHTML = lastChecks.map(function(c){\n    var ic = c.info ? \"ℹ️\" : (c.ok ? \"✅\" : \"❌\");\n    return '<div class=\"check\"><span class=\"ic\">' + ic + '</span><div>' + esc(c.t) +\n      (c.s ? '<small>' + esc(c.s) + '</small>' : '') + '</div></div>';\n  }).join(\"\");\n  /* try to prefill the name from <title> */\n  if (!el(\"name\").value){\n    var m = code.match(/<title>([^<]+)<\\/title>/i);\n    if (m) el(\"name\").value = m[1].trim();\n  }\n}\n\nfunction buildPackage(){\n  var code = el(\"code\").value;\n  var name = el(\"name\").value.trim();\n  var pitch = el(\"pitch\").value.trim();\n  var author = el(\"author\").value.trim();\n  if (!code.trim() || !name || !author){\n    haptic(\"light\");\n    el(\"out\").style.display = \"block\";\n    el(\"pkg\").value = \"Fill in the code, app name and your credit first.\";\n    return;\n  }\n  var failed = lastChecks.filter(function(c){ return !c.ok; });\n  var bridges = (code.match(/myllm[A-Z][a-zA-Z]+/g) || []).filter(function(v,i,a){ return a.indexOf(v) === i; });\n  var pkg = {\n    myllmosSubmission: 1,\n    name: name,\n    pitch: pitch,\n    author: author,\n    bridges: bridges,\n    sizeKB: Math.round(code.length / 1024),\n    checksFailed: failed.map(function(c){ return c.t; }),\n    html: code\n  };\n  el(\"out\").style.display = \"block\";\n  el(\"pkg\").value = JSON.stringify(pkg);\n  haptic(\"success\");\n  if (failed.length){\n    el(\"pkg\").value = \"NOTE: \" + failed.length + \" check(s) failing — fix them first or explain in your submission why they should pass.\\n\\n\" + el(\"pkg\").value;\n  }\n  el(\"shareBtn\").style.display = window.myllmShare ? \"block\" : \"none\";\n}\nfunction sharePkg(){\n  if (window.myllmShare){ try{ myllmShare({text:el(\"pkg\").value}); }catch(_){} }\n  haptic(\"light\");\n}\nfunction openIssue(){\n  haptic(\"light\");\n  var name = encodeURIComponent(\"[App] \" + (el(\"name\").value.trim() || \"My app\"));\n  window.open(\"https://github.com/TeamDzX/myllm-assets/issues/new?template=app-submission.md&title=\" + name);\n}\n</script>\n</body>\n</html>\n"}