{"name": "Daily Horoscope", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>:root{color-scheme:light dark;--accent:#5e5ce6}\n*{box-sizing:border-box}\nbody{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:18px;background:#f2f2f7;color:#111}\n@media(prefers-color-scheme:dark){body{background:#000;color:#eee}.sign{background:#1c1c1e}.reading{background:#15152a}}\nh1{font-size:22px;margin:0 0 4px}\n.sub{font-size:13px;opacity:.6;margin-bottom:14px}\n.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:14px}\n.sign{background:#fff;border:2px solid transparent;border-radius:13px;padding:9px 4px;text-align:center;cursor:pointer;box-shadow:0 1px 2px rgba(0,0,0,.07)}\n.sign.on{border-color:var(--accent)}\n.sign .sym{font-size:24px;line-height:1.1}\n.sign .nm{font-size:11px;opacity:.7;margin-top:2px}\n.sign .dt{font-size:9px;opacity:.45}\nbutton.go{width:100%;border:0;background:var(--accent);color:#fff;border-radius:11px;padding:13px;font-size:15px;font-weight:600}\nbutton:disabled{opacity:.5}\n#status{font-size:13px;opacity:.7;min-height:16px;margin:10px 0}\n.reading{background:#eef;border-radius:14px;padding:16px;margin-top:8px;font-size:15px;line-height:1.6;display:none}\n.reading h2{margin:0 0 4px;font-size:17px}\n.reading .when{font-size:12px;opacity:.6;margin-bottom:10px}\n@media(min-width:768px){body{max-width:760px;margin-left:auto;margin-right:auto}}\n</style></head><body>\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-family:-apple-system,system-ui,sans-serif;font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;line-height:1;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n<script>\n(function(){\n  if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;\n  window.__myllmAiWrap=true;\n  var orig=window.myllmAsk,depth=0,node=null;\n  function ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\n    node.innerHTML='<span class=\"myllm-ai-cog\">\\u2699\\uFE0F</span><span>AI is thinking\\u2026 <small>privately, on your device</small></span>';\n    (document.body||document.documentElement).appendChild(node);}\n  function show(){ensure();depth++;node.classList.add('on');}\n  function hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\n  window.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\n    return Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};\n})();\n</script>\n\n<h1>🔮 Daily Horoscope</h1>\n<div class=\"sub\">Pick your star sign for today's reading. For fun ✨</div>\n<div class=\"grid\" id=\"grid\"></div>\n<button class=\"go\" id=\"go\" onclick=\"reveal()\">Today's horoscope</button>\n<div id=\"status\"></div>\n<div class=\"reading\" id=\"reading\"></div>\n<script>\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar SIGNS=[\n {n:'Aries',s:'♈',d:'Mar 21–Apr 19'},{n:'Taurus',s:'♉',d:'Apr 20–May 20'},\n {n:'Gemini',s:'♊',d:'May 21–Jun 20'},{n:'Cancer',s:'♋',d:'Jun 21–Jul 22'},\n {n:'Leo',s:'♌',d:'Jul 23–Aug 22'},{n:'Virgo',s:'♍',d:'Aug 23–Sep 22'},\n {n:'Libra',s:'♎',d:'Sep 23–Oct 22'},{n:'Scorpio',s:'♏',d:'Oct 23–Nov 21'},\n {n:'Sagittarius',s:'♐',d:'Nov 22–Dec 21'},{n:'Capricorn',s:'♑',d:'Dec 22–Jan 19'},\n {n:'Aquarius',s:'♒',d:'Jan 20–Feb 18'},{n:'Pisces',s:'♓',d:'Feb 19–Mar 20'}];\nvar chosen=null,cache={};\nfunction el(i){return document.getElementById(i)}\nfunction setStatus(t){el('status').textContent=t||''}\nfunction todayKey(){return new Date().toDateString()}\nfunction todayLabel(){return new Date().toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'})}\n\nfunction renderGrid(){\n  var G=el('grid');G.innerHTML='';\n  SIGNS.forEach(function(sg){\n    var d=document.createElement('div');d.className='sign'+(chosen===sg.n?' on':'');\n    d.innerHTML='<div class=\"sym\">'+sg.s+'</div><div class=\"nm\">'+sg.n+'</div><div class=\"dt\">'+sg.d+'</div>';\n    d.onclick=function(){chosen=sg.n;store.setItem('sign',sg.n);renderGrid();showCached()};\n    G.appendChild(d);\n  });\n}\nfunction signObj(){return SIGNS.filter(function(s){return s.n===chosen})[0]}\nfunction showReading(text){\n  var sg=signObj();var r=el('reading');r.style.display='block';\n  r.innerHTML='<h2></h2><div class=\"when\"></div>';\n  r.querySelector('h2').textContent=sg.s+' '+sg.n;\n  r.querySelector('.when').textContent=todayLabel();\n  r.appendChild(document.createTextNode(text));\n}\nfunction showCached(){\n  el('reading').style.display='none';\n  if(chosen&&cache[chosen]&&cache[chosen].key===todayKey())showReading(cache[chosen].text);\n}\nfunction reveal(){\n  if(!chosen){setStatus('Tap your star sign first.');return}\n  if(cache[chosen]&&cache[chosen].key===todayKey()){showReading(cache[chosen].text);return}\n  if(!window.myllmAsk){setStatus('Horoscopes need AI — update MyLLM and enable “Allow apps to use the AI” in Settings.');return}\n  el('go').disabled=true;setStatus('Reading the stars for '+chosen+'…');\n  myllmAsk('Write a fun, upbeat daily horoscope for '+chosen+' for '+todayLabel()+'. 3–4 sentences covering mood, love and one piece of practical advice. Light and positive, no preamble.',\n           {system:'You are a playful astrologer writing short, entertaining daily horoscopes.'})\n  .then(function(reply){\n    cache[chosen]={key:todayKey(),text:reply.trim()};store.setItem('cache',JSON.stringify(cache));\n    showReading(reply.trim());setStatus('');if(window.myllmHaptic)myllmHaptic('success');\n  }).catch(function(err){setStatus('Could not read the stars: '+err.message)})\n  .then(function(){el('go').disabled=false});\n}\n\nPromise.all([store.getItem('sign'),store.getItem('cache')]).then(function(r){\n  if(r[0])chosen=r[0];\n  if(r[1])try{cache=JSON.parse(r[1])}catch(e){}\n  renderGrid();showCached();\n});\n</script></body></html>\n", "kind": "html", "iconSymbol": "moon.stars.fill", "iconColor": "indigo"}