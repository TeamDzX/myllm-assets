{"name": "Substack Reader", "kind": "html", "iconSymbol": "envelope.open.fill", "iconColor": "orange", "html": "<!doctype html>\n<!--\n  Substack Reader — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Substack Reader</title>\n<style>\n:root{--build-id:\"dfdb310f3c\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7);--surface:var(--myllm-surface,#fff);--text:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#6e6e73);--accent:var(--myllm-accent,#0a84ff);--border:var(--myllm-border,#e3e3e8);\n  --radius:var(--myllm-radius,18px);--brand:#ff6719;--good:#2fb56a;--bad:#e5484d}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nhtml,body{margin:0}\nbody{font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);background:var(--bg);color:var(--text);\n  padding:14px 16px calc(28px + env(safe-area-inset-bottom));max-width:820px;margin:0 auto;-webkit-font-smoothing:antialiased}\nh1{font-size:24px;margin:0;letter-spacing:-.3px}\n.sub{font-size:13px;color:var(--muted);margin:3px 0 12px}\n.top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}\n.btn{border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:12px;padding:9px 13px;font-size:14px;font-weight:600;white-space:nowrap}\n.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}\n.btn.brand{background:var(--brand);border-color:var(--brand);color:#fff}\n.btn.danger{color:var(--bad)}\n.btn[disabled]{opacity:.5}\n.seg{display:flex;background:var(--border);border-radius:12px;padding:3px;margin-bottom:12px}\n.seg button{flex:1;border:0;background:transparent;color:var(--muted);font-weight:600;font-size:14px;padding:8px;border-radius:10px}\n.seg button.on{background:var(--surface);color:var(--text);box-shadow:0 1px 3px rgba(0,0,0,.12)}\n.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:14px}\n.status{font-size:13px;color:var(--muted);min-height:18px;margin:0 0 8px;text-align:center}\n.pills{display:flex;gap:6px;overflow-x:auto;padding-bottom:8px;margin-bottom:4px;-webkit-overflow-scrolling:touch}\n.pill{border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:999px;padding:6px 12px;font-size:13px;font-weight:600;white-space:nowrap;display:flex;align-items:center;gap:6px}\n.pill.on{background:var(--text);color:var(--bg);border-color:var(--text)}\n.pill img{width:16px;height:16px;border-radius:4px;object-fit:cover}\n.post{display:flex;gap:12px;padding:13px 0;border-top:1px solid var(--border);cursor:pointer}\n.post:first-child{border-top:0}\n.post .txt{flex:1;min-width:0}\n.post .pub{font-size:12px;color:var(--muted);font-weight:600;display:flex;align-items:center;gap:6px;margin-bottom:3px}\n.post .pub img{width:16px;height:16px;border-radius:4px;object-fit:cover}\n.post .pub .new{width:7px;height:7px;border-radius:50%;background:var(--brand);flex:none}\n.post h3{font-size:16px;margin:0 0 3px;line-height:1.3;font-weight:700}\n.post.read h3{font-weight:600;color:var(--muted)}\n.post p{font-size:13px;color:var(--muted);margin:0 0 5px;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}\n.post .meta{font-size:12px;color:var(--muted);display:flex;gap:10px;flex-wrap:wrap}\n.post .cover{width:78px;height:78px;border-radius:12px;object-fit:cover;flex:none;background:var(--border)}\n.badge{font-size:11px;font-weight:700;padding:1px 6px;border-radius:6px;background:var(--border);color:var(--muted)}\n.badge.paid{background:#fff1e8;color:#c24e0d}\n@media(prefers-color-scheme:dark){.badge.paid{background:#3a2113;color:#ffb184}}\n.empty{color:var(--muted);font-size:14px;text-align:center;padding:24px 8px;line-height:1.5}\n.frow{display:flex;align-items:center;gap:12px;padding:12px 0;border-top:1px solid var(--border)}\n.frow:first-child{border-top:0}\n.frow img{width:44px;height:44px;border-radius:11px;object-fit:cover;background:var(--border);flex:none}\n.frow .txt{flex:1;min-width:0}\n.frow b{display:block;font-size:15px}\n.frow span{display:block;font-size:12px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.frow button{border:0;background:transparent;color:var(--muted);font-size:13px;font-weight:600;padding:6px}\n.frow button.confirm{color:var(--bad)}\n.starters h4{font-size:13px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin:16px 0 6px}\n.srow{display:flex;align-items:center;gap:10px;padding:9px 0;border-top:1px solid var(--border)}\n.srow:first-child{border-top:0}\n.srow .txt{flex:1;min-width:0}.srow b{display:block;font-size:14px}.srow span{display:block;font-size:12px;color:var(--muted)}\n.srow button{border:1px solid var(--accent);background:transparent;color:var(--accent);border-radius:999px;padding:5px 12px;font-size:13px;font-weight:600}\n.srow button.done{border-color:var(--border);color:var(--muted)}\n.addrow{display:flex;gap:8px;margin-bottom:8px}\n.addrow input{flex:1;min-width:0;padding:11px 12px;border:1px solid var(--border);border-radius:12px;font-size:16px;background:var(--bg);color:var(--text)}\n.hint{font-size:12px;color:var(--muted);line-height:1.45}\n/* article */\n#article{position:fixed;inset:0;background:var(--bg);overflow-y:auto;-webkit-overflow-scrolling:touch;z-index:5;padding:0 0 calc(28px + env(safe-area-inset-bottom))}\n#article .bar{position:sticky;top:0;background:var(--bg);display:flex;align-items:center;gap:8px;padding:calc(10px + env(safe-area-inset-top)) 14px 10px;border-bottom:1px solid var(--border);z-index:2}\n#article .bar .t{flex:1;min-width:0;font-size:13px;font-weight:600;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.wrap{max-width:720px;margin:0 auto;padding:16px 18px}\n.wrap h2.title{font-size:26px;line-height:1.2;margin:8px 0 6px;letter-spacing:-.4px}\n.wrap .subtitle{font-size:17px;color:var(--muted);margin:0 0 10px;line-height:1.4}\n.wrap .byline{font-size:13px;color:var(--muted);margin-bottom:14px;display:flex;align-items:center;gap:8px}\n.wrap .byline img{width:22px;height:22px;border-radius:6px;object-fit:cover}\n.handoff{display:flex;gap:8px;margin:12px 0 18px;flex-wrap:wrap}\n.handoff a{flex:1;min-width:90px;text-align:center;text-decoration:none;border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:12px;padding:10px 8px;font-size:14px;font-weight:600}\n.handoff a.brand{background:var(--brand);border-color:var(--brand);color:#fff}\n.paywall{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px;margin:12px 0;font-size:14px;line-height:1.5}\naudio{width:100%;margin:6px 0 14px}\n.body{font-size:17px;line-height:1.62;overflow-wrap:anywhere}\n.body img,.body video{max-width:100%;height:auto;border-radius:10px}\n.body picture{display:block}\n.body figure{margin:16px 0}\n.body figcaption{font-size:13px;color:var(--muted);text-align:center;margin-top:6px}\n.body blockquote{border-left:3px solid var(--border);margin:14px 0;padding:2px 14px;color:var(--muted)}\n.body pre{overflow-x:auto;background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:12px;font-size:13px}\n.body h1,.body h2,.body h3{line-height:1.25;margin:22px 0 8px}\n.body a{color:var(--accent)}\n.body table{max-width:100%;overflow-x:auto;display:block;font-size:14px}\n.body hr{border:0;border-top:1px solid var(--border);margin:20px 0}\n.body ul,.body ol{padding-left:22px}\n.body .footnote-anchor{font-size:.8em}\n.sec{margin-top:24px}\n.sec h3{font-size:16px;margin:0 0 10px}\n.comment{padding:10px 0;border-top:1px solid var(--border)}\n.comment:first-child{border-top:0}\n.comment .who{font-size:13px;font-weight:700;display:flex;gap:8px;align-items:baseline}\n.comment .who span{font-weight:400;color:var(--muted);font-size:12px}\n.comment .body-c{font-size:14px;line-height:1.5;margin-top:4px;white-space:pre-wrap;overflow-wrap:anywhere}\n.comment .reply{margin-left:16px;padding-left:12px;border-left:2px solid var(--border);margin-top:8px}\n.ask{margin-top:24px}\n.ask .row{display:flex;gap:8px}\n.ask input{flex:1;min-width:0;padding:11px 12px;border:1px solid var(--border);border-radius:12px;font-size:16px;background:var(--surface);color:var(--text)}\n.ask .ans{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:14px;margin-top:10px;font-size:15px;line-height:1.5;white-space:pre-wrap}\n.note{font-size:12px;color:var(--muted);line-height:1.5;margin-top:14px}\n[hidden]{display:none!important}\n.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(20px);\n  background:var(--text);color:var(--bg);padding:10px 16px;border-radius:14px;font-size:14px;font-weight:600;opacity:0;pointer-events:none;transition:.25s;z-index:9}\n.toast.on{opacity:1;transform:translateX(-50%) translateY(0)}\n</style></head><body>\n\n<div class=\"top\">\n  <div><h1>Substack Reader</h1><div class=\"sub\">Follow publications, read free posts, join in on Substack</div></div>\n  <button class=\"btn primary\" id=\"refreshBtn\">Refresh</button>\n</div>\n\n<div class=\"seg\"><button class=\"on\" data-tab=\"inbox\">Inbox</button><button data-tab=\"following\">Following</button></div>\n<div class=\"status\" id=\"status\"></div>\n\n<div id=\"tabInbox\">\n  <div class=\"pills\" id=\"pills\" hidden></div>\n  <div class=\"card\" id=\"inbox\"></div>\n</div>\n\n<div id=\"tabFollowing\" hidden>\n  <div class=\"card\">\n    <div class=\"addrow\"><input id=\"addInput\" type=\"url\" placeholder=\"Publication address, e.g. astralcodexten\" autocapitalize=\"none\" autocorrect=\"off\" spellcheck=\"false\" enterkeyhint=\"go\"><button class=\"btn primary\" id=\"addBtn\">Follow</button></div>\n    <div class=\"hint\">Paste a publication's web address, or just its name before \".substack.com\". Publications on their own domain work too.</div>\n    <div id=\"follows\" style=\"margin-top:12px\"></div>\n    <div class=\"starters\" id=\"starters\"></div>\n  </div>\n  <p class=\"note\">An unofficial reader. It talks directly to each publication's public site through MyLLM's network bridge, with no account and nothing stored anywhere but this device. Free posts open in full; paid posts show their preview. Liking, commenting and subscribing happen on Substack itself, where you are signed in.</p>\n</div>\n\n<div id=\"article\" hidden>\n  <div class=\"bar\"><button class=\"btn\" id=\"backBtn\">‹ Back</button><div class=\"t\" id=\"artPub\"></div><button class=\"btn\" id=\"shareBtn\">Share</button></div>\n  <div class=\"wrap\" id=\"artWrap\"></div>\n</div>\n\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\n(function(){\n'use strict';\nvar $=function(id){return document.getElementById(id);};\nfunction haptic(k){try{if(window.myllmHaptic)window.myllmHaptic(k||'light');}catch(e){}}\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null);},setItem:function(){return Promise.resolve();}};\nvar hasFetch=typeof window.myllmFetch==='function';\nvar KEY='substack-reader.v1';\nvar STARTERS=[\n  {host:'astralcodexten.substack.com',name:'Astral Codex Ten',blurb:'Essays on science, medicine and everything else'},\n  {host:'www.noahpinion.blog',name:'Noahpinion',blurb:'Economics and technology, explained'},\n  {host:'www.oneusefulthing.org',name:'One Useful Thing',blurb:'Ethan Mollick on working with AI'},\n  {host:'www.theintrinsicperspective.com',name:'The Intrinsic Perspective',blurb:'Science, culture and consciousness'},\n  {host:'www.experimental-history.com',name:'Experimental History',blurb:'Psychology, with jokes'},\n  {host:'bigthink.substack.com',name:'Big Think',blurb:'Ideas from science and philosophy'},\n  {host:'newsletter.pragmaticengineer.com',name:'The Pragmatic Engineer',blurb:'Inside big tech and startups'},\n  {host:'www.lennysnewsletter.com',name:\"Lenny's Newsletter\",blurb:'Product, growth and careers'}\n];\nvar state={follows:[],cache:{},read:{},followedAt:{}};\nvar filter=null,current=null;\n\n/* ---------- helpers ---------- */\nfunction esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\nfunction toast(t){var e=$('toast');e.textContent=t;e.classList.add('on');clearTimeout(toast._t);toast._t=setTimeout(function(){e.classList.remove('on');},1800);}\nfunction status(t){$('status').textContent=t||'';}\nfunction save(){return store.setItem(KEY,JSON.stringify(state)).catch(function(){});}\nfunction load(){return store.getItem(KEY).then(function(s){try{var d=JSON.parse(s||'{}');if(d&&Array.isArray(d.follows)){state.follows=d.follows;state.cache=d.cache||{};state.read=d.read||{};state.followedAt=d.followedAt||{};}}catch(e){}}).catch(function(){});}\nfunction when(iso){\n  var d=new Date(iso),now=Date.now(),diff=(now-d.getTime())/1000;\n  if(!(d.getTime()>0))return '';\n  if(diff<3600)return Math.max(1,Math.round(diff/60))+'m ago';\n  if(diff<86400)return Math.round(diff/3600)+'h ago';\n  if(diff<7*86400)return Math.round(diff/86400)+'d ago';\n  return d.toLocaleDateString([],{day:'numeric',month:'short',year:d.getFullYear()===new Date().getFullYear()?undefined:'numeric'});\n}\nfunction img(u,w){if(!u)return '';if(/^https:\\/\\/substackcdn\\.com\\/image\\/fetch\\//.test(u))return u;return 'https://substackcdn.com/image/fetch/w_'+w+',h_'+w+',c_fill,f_auto,q_auto:good/'+encodeURIComponent(u);}\nfunction cleanSub(t){t=String(t||'').trim();return /^[.…\\s]*$/.test(t)?'':t;}\nfunction hearts(p){var r=p.reactions||{};var n=0;for(var k in r)n+=r[k]||0;return n;}\nfunction normaliseHost(input){\n  var s=String(input||'').trim().toLowerCase();\n  if(!s)return null;\n  s=s.replace(/^https?:\\/\\//,'').replace(/^@/,'');\n  s=s.split(/[\\/?#]/)[0];\n  if(s.indexOf('.')<0)s=s+'.substack.com';\n  if(!/^[a-z0-9.-]+\\.[a-z]{2,}$/.test(s))return null;\n  return s;\n}\nfunction friendlyError(e){\n  var m=(e&&e.message)||String(e||'');\n  if(/turned off/i.test(m))return 'Network access for apps is turned off in MyLLM Settings → MyLLMos Apps.';\n  if(/offline|not connected|internet connection/i.test(m))return 'You appear to be offline.';\n  if(/timed out/i.test(m))return 'That took too long. Try again in a moment.';\n  return m.slice(0,120);\n}\nfunction apiJSON(url){\n  if(!hasFetch)return Promise.reject(new Error('This app needs MyLLM\\'s network bridge — open it inside the MyLLM app.'));\n  return window.myllmFetch(url,{headers:{'accept':'application/json'}}).then(function(res){\n    if(!res||!res.ok)throw new Error(res&&res.status===404?'Not a Substack publication (404).':'Server replied '+(res&&res.status));\n    var body=res.body||'';\n    if(body.charAt(0)!=='['&&body.charAt(0)!=='{')throw new Error('That address did not answer like a Substack publication.');\n    return JSON.parse(body);\n  });\n}\nfunction slim(host,p){\n  return {id:p.id,slug:p.slug,host:host,title:p.title||'',subtitle:cleanSub(p.subtitle||p.description||''),date:p.post_date,\n    audience:p.audience,cover:p.cover_image||'',hearts:hearts(p),comments:p.comment_count||0,url:p.canonical_url||('https://'+host+'/p/'+p.slug),\n    podcast:p.podcast_url||'',type:p.type||''};\n}\nfunction pubFromPosts(host,posts){\n  for(var i=0;i<posts.length;i++){var b=posts[i].publishedBylines||[];\n    for(var j=0;j<b.length;j++){var pu=b[j].publicationUsers||[];\n      for(var k=0;k<pu.length;k++){var pub=pu[k].publication;if(pub&&pub.name)return {name:pub.name,logo:pub.logo_url||'',tagline:pub.hero_text||''};}}}\n  return null;\n}\nfunction pubHost(pub){return pub.custom_domain||((pub.subdomain||'')+'.substack.com');}\nfunction fetchProfile(handle){\n  return apiJSON('https://substack.com/api/v1/user/'+encodeURIComponent(handle)+'/public_profile').then(function(d){\n    var pubs=(d.publicationUsers||[]).map(function(pu){return pu.publication;}).filter(function(x){return x&&x.name;});\n    return {name:d.name||'',photo:d.photo_url||'',pubs:pubs.map(function(x){return {host:pubHost(x),name:x.name,logo:x.logo_url||'',tagline:x.hero_text||''};})};\n  });\n}\nfunction fetchPub(host){\n  return apiJSON('https://'+host+'/api/v1/archive?sort=new&limit=12').then(function(posts){\n    if(!Array.isArray(posts))throw new Error('Unexpected reply from '+host);\n    return {meta:pubFromPosts(host,posts),posts:posts.map(function(p){return slim(host,p);})};\n  });\n}\n\n/* ---------- follow / unfollow ---------- */\nfunction isFollowed(host){return state.follows.some(function(f){return f.host===host;});}\nfunction follow(input,btn){\n  var host=normaliseHost(input);\n  if(!host){toast('Enter a publication address');return Promise.resolve();}\n  if(isFollowed(host)){toast('Already following');return Promise.resolve();}\n  if(btn){btn.disabled=true;}\n  status('Looking up '+host+'…');haptic('light');\n  var tries=[host];\n  if(host.indexOf('www.')===0)tries.push(host.slice(4));else if(host.split('.').length===2)tries.push('www.'+host);\n  var slug=/\\.substack\\.com$/.test(host)?host.replace(/\\.substack\\.com$/,''):null;\n  var notFound=new Error('No Substack publication found at '+host+'. Some newsletters have moved to other platforms.');\n  function attempt(i){\n    if(i>=tries.length){\n      // A bare name may be a writer's handle rather than a publication slug: ask their public profile.\n      if(!slug)return Promise.reject(notFound);\n      return fetchProfile(slug).then(function(prof){\n        var pub=prof.pubs[0];if(!pub||isFollowed(pub.host))throw notFound;\n        return fetchPub(pub.host).then(function(r){if(!r.meta)r.meta=pub;return {host:pub.host,r:r};});\n      }).catch(function(){throw notFound;});\n    }\n    return fetchPub(tries[i]).then(function(r){return {host:tries[i],r:r};}).catch(function(e){if(i+1<tries.length)return attempt(i+1);throw e;});\n  }\n  return attempt(0).then(function(x){\n    if(x.r.meta||!slug)return x;\n    // No bylines to learn the name from (typical of a brand-new publication): use the writer's profile.\n    return fetchProfile(slug).then(function(prof){\n      var pub=prof.pubs.filter(function(q){return q.host===x.host;})[0]||prof.pubs[0];\n      x.r.meta=pub?{name:pub.name,logo:pub.logo||prof.photo,tagline:pub.tagline}:(prof.name?{name:prof.name,logo:prof.photo,tagline:''}:null);\n      return x;\n    }).catch(function(){return x;});\n  }).then(function(x){\n    if(isFollowed(x.host)){toast('Already following');return;}\n    var meta=x.r.meta||{name:x.host.replace(/^www\\./,'').replace(/\\.substack\\.com$/,''),logo:'',tagline:''};\n    state.follows.push({host:x.host,name:meta.name,logo:meta.logo,tagline:meta.tagline});\n    state.followedAt[x.host]=Date.now();\n    state.cache[x.host]=x.r.posts;\n    save();renderFollows();renderInbox();\n    if(x.r.posts.length){status('');toast('Following '+meta.name);}\n    else{status('Following '+meta.name+', but it has not published any posts yet. They will appear in your inbox when it does.');toast('Following '+meta.name);}\n    haptic('success');\n    $('addInput').value='';\n  }).catch(function(e){status(friendlyError(e));haptic('error');}).then(function(){if(btn)btn.disabled=false;});\n}\nfunction unfollow(host){\n  state.follows=state.follows.filter(function(f){return f.host!==host;});\n  delete state.cache[host];delete state.followedAt[host];\n  if(filter===host)filter=null;\n  save();renderFollows();renderInbox();haptic('selection');\n}\n\n/* ---------- refresh ---------- */\nvar refreshing=false;\nfunction refreshAll(){\n  if(refreshing||!state.follows.length)return Promise.resolve();\n  refreshing=true;$('refreshBtn').disabled=true;status('Checking '+state.follows.length+' publication'+(state.follows.length>1?'s':'')+'…');haptic('light');\n  var failed=[];\n  return Promise.all(state.follows.map(function(f){\n    return fetchPub(f.host).then(function(r){\n      state.cache[f.host]=r.posts;\n      if(r.meta){f.name=r.meta.name||f.name;f.logo=r.meta.logo||f.logo;f.tagline=r.meta.tagline||f.tagline;}\n    }).catch(function(e){failed.push(f.name+': '+friendlyError(e));});\n  })).then(function(){\n    save();renderInbox();renderFollows();\n    status(failed.length?('Could not update '+failed.join(' · ')):'');\n    if(!failed.length)toast('Up to date');\n  }).then(function(){refreshing=false;$('refreshBtn').disabled=false;});\n}\n\n/* ---------- rendering ---------- */\nfunction allPosts(){\n  var out=[];\n  state.follows.forEach(function(f){(state.cache[f.host]||[]).forEach(function(p){out.push(p);});});\n  out.sort(function(a,b){return new Date(b.date)-new Date(a.date);});\n  return out;\n}\nfunction pubOf(host){for(var i=0;i<state.follows.length;i++)if(state.follows[i].host===host)return state.follows[i];return {name:host,logo:''};}\nfunction isNew(p){return !state.read[p.id]&&new Date(p.date).getTime()>(state.followedAt[p.host]||0)-86400000*7;}\nfunction renderInbox(){\n  var box=$('inbox'),pills=$('pills');\n  if(!state.follows.length){\n    pills.hidden=true;\n    box.innerHTML='<div class=\"empty\">Nothing here yet.<br>Go to <b>Following</b> and add a publication or pick a starter.</div>';\n    return;\n  }\n  pills.hidden=state.follows.length<2;\n  pills.innerHTML='<button class=\"pill'+(filter?'':' on')+'\" data-host=\"\">All</button>'+state.follows.map(function(f){\n    return '<button class=\"pill'+(filter===f.host?' on':'')+'\" data-host=\"'+esc(f.host)+'\">'+(f.logo?'<img src=\"'+esc(img(f.logo,64))+'\" alt=\"\">':'')+esc(f.name)+'</button>';}).join('');\n  var posts=allPosts().filter(function(p){return !filter||p.host===filter;});\n  if(!posts.length){\n    var quiet=state.follows.filter(function(f){return (!filter||f.host===filter)&&!(state.cache[f.host]||[]).length;});\n    box.innerHTML='<div class=\"empty\">'+(quiet.length?quiet.map(function(f){return '<b>'+esc(f.name)+'</b> has not published any posts yet.';}).join('<br>')+'<br><br>New posts will appear here when they are published.':'No posts loaded yet. Tap Refresh.')+'</div>';\n    return;\n  }\n  box.innerHTML=posts.map(function(p){\n    var pub=pubOf(p.host);\n    return '<div class=\"post'+(state.read[p.id]?' read':'')+'\" data-id=\"'+esc(p.id)+'\" data-host=\"'+esc(p.host)+'\">'+\n      '<div class=\"txt\"><div class=\"pub\">'+(isNew(p)?'<i class=\"new\"></i>':'')+(pub.logo?'<img src=\"'+esc(img(pub.logo,64))+'\" alt=\"\">':'')+esc(pub.name)+' · '+esc(when(p.date))+'</div>'+\n      '<h3>'+esc(p.title)+'</h3>'+(p.subtitle?'<p>'+esc(p.subtitle)+'</p>':'')+\n      '<div class=\"meta\">'+(p.audience&&p.audience!=='everyone'?'<span class=\"badge paid\">Paid</span>':'')+(p.podcast?'<span class=\"badge\">Audio</span>':'')+\n      '<span>♥ '+p.hearts+'</span><span>💬 '+p.comments+'</span></div></div>'+\n      (p.cover?'<img class=\"cover\" src=\"'+esc(img(p.cover,240))+'\" alt=\"\" loading=\"lazy\">':'')+'</div>';\n  }).join('');\n}\nfunction renderFollows(){\n  var el=$('follows');\n  if(!state.follows.length)el.innerHTML='<div class=\"empty\">You are not following anything yet.</div>';\n  else el.innerHTML=state.follows.map(function(f){\n    return '<div class=\"frow\" data-host=\"'+esc(f.host)+'\">'+(f.logo?'<img src=\"'+esc(img(f.logo,128))+'\" alt=\"\">':'<img alt=\"\">')+\n      '<div class=\"txt\"><b>'+esc(f.name)+'</b><span>'+esc((state.cache[f.host]||[]).length?(f.tagline||f.host):'No posts published yet · '+f.host)+'</span></div><button class=\"unf\">Unfollow</button></div>';\n  }).join('');\n  var st=$('starters');\n  st.innerHTML='<h4>Some places to start</h4>'+STARTERS.map(function(s){\n    var on=isFollowed(s.host);\n    return '<div class=\"srow\"><div class=\"txt\"><b>'+esc(s.name)+'</b><span>'+esc(s.blurb)+'</span></div><button data-host=\"'+esc(s.host)+'\" class=\"'+(on?'done':'')+'\"'+(on?' disabled':'')+'>'+(on?'Following':'Follow')+'</button></div>';\n  }).join('');\n}\n\n/* ---------- article ---------- */\nfunction sanitize(html){\n  var doc;\n  try{doc=new DOMParser().parseFromString('<body>'+html+'</body>','text/html');}catch(e){return document.createElement('div');}\n  var kill='script,style,iframe,object,embed,form,input,button,noscript,link,meta,svg.pencraft,.subscription-widget-wrap,.subscription-widget-wrap-editor,.subscribe-widget,.button-wrapper,.install-substack-app,.digest-post-embed,.pullquote-wrap .button,.captioned-button-wrap,.share-dialog,.subscribe-dialog,[data-component-name=\"SubscribeWidgetToDOM\"],[data-component-name=\"ButtonCreateButton\"],.tweet .tweet-header .tweet-external-link';\n  try{doc.querySelectorAll(kill).forEach(function(n){n.remove();});}catch(e){}\n  doc.querySelectorAll('*').forEach(function(n){\n    for(var i=n.attributes.length-1;i>=0;i--){var a=n.attributes[i];\n      if(/^on/i.test(a.name)||a.name==='style'&&/expression|url\\(/i.test(a.value))n.removeAttribute(a.name);\n      if((a.name==='href'||a.name==='src'||a.name==='srcset')&&/^\\s*javascript:/i.test(a.value))n.removeAttribute(a.name);}\n    if(n.tagName==='A'){n.setAttribute('target','_blank');n.setAttribute('rel','noopener');var cls=n.getAttribute('class')||'';if(/\\bbutton\\b/.test(cls)&&/subscribe|share/i.test(n.textContent))n.remove();}\n    if(n.tagName==='IMG'){n.removeAttribute('width');n.removeAttribute('height');n.setAttribute('loading','lazy');}\n  });\n  var div=document.createElement('div');\n  while(doc.body.firstChild)div.appendChild(doc.body.firstChild);\n  return div;\n}\nfunction openPost(id,host){\n  var list=state.cache[host]||[],p=null;\n  for(var i=0;i<list.length;i++)if(String(list[i].id)===String(id)){p=list[i];break;}\n  if(!p)return;\n  current=p;state.read[p.id]=true;save();\n  var pub=pubOf(host),w=$('artWrap');\n  $('artPub').textContent=pub.name;\n  w.innerHTML='<h2 class=\"title\">'+esc(p.title)+'</h2>'+(p.subtitle?'<p class=\"subtitle\">'+esc(p.subtitle)+'</p>':'')+\n    '<div class=\"byline\">'+(pub.logo?'<img src=\"'+esc(img(pub.logo,64))+'\" alt=\"\">':'')+'<span>'+esc(pub.name)+' · '+esc(new Date(p.date).toLocaleDateString([],{day:'numeric',month:'long',year:'numeric'}))+'</span></div>'+\n    handoffBar(p,host)+'<div class=\"status\" id=\"artStatus\">Loading…</div><div id=\"artBody\"></div>';\n  $('article').hidden=false;$('article').scrollTop=0;document.body.style.overflow='hidden';haptic('selection');\n  apiJSON('https://'+host+'/api/v1/posts/'+encodeURIComponent(p.slug)).then(function(full){\n    var body=$('artBody'),st=$('artStatus');st.textContent='';\n    var byl=(full.publishedBylines||[]).map(function(b){return b.name;}).filter(Boolean);\n    if(byl.length){var bl=w.querySelector('.byline span');bl.textContent='By '+byl.join(', ')+' · '+bl.textContent;}\n    var html=full.body_html||'';\n    var frag=document.createDocumentFragment();\n    if(full.podcast_url||p.podcast){var au=document.createElement('audio');au.controls=true;au.preload='none';au.src=full.podcast_url||p.podcast;frag.appendChild(au);}\n    if(!html){\n      var pw=document.createElement('div');pw.className='paywall';\n      pw.innerHTML='<b>'+(full.audience&&full.audience!=='everyone'?'This post is for paid subscribers.':'The full text is not available here.')+'</b><br>'+esc(full.description||full.truncated_body_text||p.subtitle||'')+'<br><br><a class=\"btn brand\" style=\"display:inline-block;text-decoration:none\" target=\"_blank\" rel=\"noopener\" href=\"'+esc(p.url)+'\">Read on Substack</a>';\n      frag.appendChild(pw);\n    }else{var b=sanitize(html);b.className='body';frag.appendChild(b);}\n    var c=document.createElement('div');c.className='sec';c.id='commentsSec';\n    c.innerHTML='<h3>Comments ('+(full.comment_count||p.comments||0)+')</h3><button class=\"btn\" id=\"loadComments\">Show comments</button> <a class=\"btn brand\" style=\"display:inline-block;text-decoration:none\" target=\"_blank\" rel=\"noopener\" href=\"'+esc(p.url)+'/comments\">Join the conversation</a><div id=\"comments\" style=\"margin-top:10px\"></div>';\n    frag.appendChild(c);\n    if(window.myllmAsk&&html){\n      var ask=document.createElement('div');ask.className='ask';\n      ask.innerHTML='<h3 style=\"font-size:16px;margin:0 0 8px\">Ask about this post</h3><div class=\"row\"><input id=\"askInput\" placeholder=\"What is the main argument?\" enterkeyhint=\"send\"><button class=\"btn primary\" id=\"askBtn\">Ask</button></div><div class=\"ans\" id=\"askAns\" hidden></div>';\n      frag.appendChild(ask);\n    }\n    body.appendChild(frag);\n    var lc=$('loadComments');if(lc)lc.addEventListener('click',function(){loadComments(host,full.id||p.id,lc);});\n    var ab=$('askBtn');if(ab){ab.addEventListener('click',askAI);$('askInput').addEventListener('keydown',function(e){if(e.key==='Enter')askAI();});}\n    renderInbox();\n  }).catch(function(e){$('artStatus').textContent=friendlyError(e);});\n}\nfunction handoffBar(p,host){\n  return '<div class=\"handoff\"><a class=\"brand\" target=\"_blank\" rel=\"noopener\" href=\"'+esc(p.url)+'\">♥ Like on Substack</a><a target=\"_blank\" rel=\"noopener\" href=\"'+esc(p.url)+'/comments\">💬 Comment</a><a target=\"_blank\" rel=\"noopener\" href=\"https://'+esc(host)+'/subscribe\">Subscribe</a></div>';\n}\nfunction loadComments(host,postId,btn){\n  btn.disabled=true;btn.textContent='Loading…';\n  apiJSON('https://'+host+'/api/v1/post/'+postId+'/comments?all_comments=true').then(function(d){\n    var list=(d&&d.comments)||[];btn.hidden=true;\n    var el=$('comments');\n    if(!list.length){el.innerHTML='<div class=\"empty\">No comments yet.</div>';return;}\n    function one(c,depth){\n      var kids=(c.children||[]).slice(0,depth?3:6);\n      return '<div class=\"comment'+(depth?' reply':'')+'\"><div class=\"who\">'+esc(c.name||'Anonymous')+'<span>'+esc(when(c.date))+(hearts(c)?' · ♥ '+hearts(c):'')+'</span></div><div class=\"body-c\">'+esc(c.body||'')+'</div>'+\n        (depth<2?kids.map(function(k){return one(k,depth+1);}).join(''):'')+\n        (depth<2&&(c.children||[]).length>kids.length?'<div class=\"hint\" style=\"margin:6px 0 0 16px\">'+((c.children||[]).length-kids.length)+' more replies on Substack</div>':'')+'</div>';\n    }\n    el.innerHTML=list.slice(0,40).map(function(c){return one(c,0);}).join('')+(list.length>40?'<div class=\"hint\" style=\"margin-top:8px\">Showing 40 of '+list.length+' threads.</div>':'');\n  }).catch(function(e){btn.disabled=false;btn.textContent='Show comments';toast(friendlyError(e));});\n}\nfunction askAI(){\n  var q=($('askInput').value||'').trim();if(!q)return;\n  var body=$('artBody').querySelector('.body');var ctx=(body?body.innerText:'').replace(/\\s+/g,' ').slice(0,6000);\n  var ans=$('askAns');ans.hidden=false;ans.textContent='Thinking…';haptic('light');\n  Promise.resolve().then(function(){return window.myllmAsk('Based ONLY on this post, answer the question. If the answer is not in the text, say so.\\n\\nPOST (\"'+current.title+'\"):\\n'+ctx+'\\n\\nQUESTION: '+q);})\n    .then(function(r){ans.textContent=String(r||'').trim()||'No answer came back.';})\n    .catch(function(e){ans.textContent='AI is unavailable right now ('+friendlyError(e)+').';});\n}\nfunction closeArticle(){$('article').hidden=true;document.body.style.overflow='';current=null;haptic('light');}\n\n/* ---------- wiring ---------- */\ndocument.querySelectorAll('.seg button').forEach(function(b){b.addEventListener('click',function(){\n  document.querySelectorAll('.seg button').forEach(function(x){x.classList.toggle('on',x===b);});\n  $('tabInbox').hidden=b.dataset.tab!=='inbox';$('tabFollowing').hidden=b.dataset.tab!=='following';status('');haptic('selection');\n});});\n$('refreshBtn').addEventListener('click',function(){if(!state.follows.length){toast('Follow something first');return;}refreshAll();});\n$('addBtn').addEventListener('click',function(){follow($('addInput').value,$('addBtn'));});\n$('addInput').addEventListener('keydown',function(e){if(e.key==='Enter')follow($('addInput').value,$('addBtn'));});\n$('starters').addEventListener('click',function(e){var b=e.target.closest('button[data-host]');if(b&&!b.disabled)follow(b.dataset.host,b);});\n$('follows').addEventListener('click',function(e){\n  var b=e.target.closest('button.unf');if(!b)return;\n  if(b.classList.contains('confirm')){unfollow(b.closest('.frow').dataset.host);}\n  else{b.classList.add('confirm');b.textContent='Tap again to unfollow';setTimeout(function(){b.classList.remove('confirm');b.textContent='Unfollow';},2500);}\n});\n$('pills').addEventListener('click',function(e){var b=e.target.closest('.pill');if(!b)return;filter=b.dataset.host||null;renderInbox();haptic('selection');});\n$('inbox').addEventListener('click',function(e){var p=e.target.closest('.post');if(p)openPost(p.dataset.id,p.dataset.host);});\n$('backBtn').addEventListener('click',closeArticle);\n$('shareBtn').addEventListener('click',function(){\n  if(!current)return;haptic('light');\n  var text=current.title+'\\n'+current.url;\n  if(window.myllmShare){try{window.myllmShare({text:text,url:current.url});}catch(e){toast('Sharing unavailable');}}\n  else if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(text).then(function(){toast('Link copied');},function(){toast('Copy failed');});}\n  else toast('Sharing unavailable');\n});\n\nload().then(function(){\n  renderFollows();renderInbox();\n  if(!hasFetch){status('Open this app inside MyLLM to load publications.');return;}\n  if(state.follows.length){\n    refreshAll();\n  }else{\n    document.querySelector('.seg button[data-tab=\"following\"]').click();\n  }\n});\n})();\n</script>\n</body></html>\n"}