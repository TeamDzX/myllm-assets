{"name": "Homework Tracker", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>:root{color-scheme:light dark;--accent:#5e5ce6}\n*{box-sizing:border-box}\nbody{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:18px;background:#f2f2f7;color:#111}\n@media(prefers-color-scheme:dark){body{background:#000;color:#eee}.item,input,select{background:#1c1c1e;color:#eee;border-color:#3a3a3c}.steps{background:#0e0e10}}\nh1{font-size:22px;margin:0 0 4px}\n.sub{font-size:13px;opacity:.6;margin-bottom:14px}\ninput,select{width:100%;padding:11px;border:1px solid #d1d1d6;border-radius:10px;font-size:15px;background:#fff;font-family:inherit;margin-bottom:8px}\n.grid{display:flex;gap:8px}.grid>*{flex:1}\nbutton{border:0;background:var(--accent);color:#fff;border-radius:10px;padding:11px 16px;font-size:15px;font-weight:600;width:100%}\nbutton:disabled{opacity:.5}\n.item{background:#fff;border-radius:13px;padding:12px 14px;margin-bottom:9px;box-shadow:0 1px 3px rgba(0,0,0,.08);border-left:4px solid var(--accent)}\n.item.done{opacity:.55}.item.overdue{border-left-color:#ff453a}\n.top{display:flex;align-items:flex-start;gap:10px}\n.chk{width:24px;height:24px;border-radius:7px;border:2px solid #c7c7cc;flex:none;margin-top:1px;display:flex;align-items:center;justify-content:center;font-size:15px;cursor:pointer}\n.chk.on{background:var(--accent);border-color:var(--accent);color:#fff}\n.body{flex:1;min-width:0}\n.title{font-size:16px;font-weight:600}.done .title{text-decoration:line-through}\n.meta{font-size:12px;opacity:.65;margin-top:2px}\n.due.soon{color:#ff9f0a;font-weight:600}.due.late{color:#ff453a;font-weight:600}\n.del{background:none;color:#ff453a;font-size:18px;width:auto;padding:0 2px;flex:none}\n.tools{display:flex;gap:14px;margin-top:8px}\n.tools a{font-size:13px;color:var(--accent);font-weight:600;cursor:pointer}\n.steps{background:#f2f2f7;border-radius:9px;padding:8px 10px;margin-top:8px;font-size:14px}\n.steps div{padding:3px 0;display:flex;gap:7px}\n.steps .s{cursor:pointer}.steps .s.on{opacity:.5;text-decoration:line-through}\n#status{font-size:13px;opacity:.7;min-height:16px;margin:6px 0}\n.empty{text-align:center;opacity:.5;font-size:14px;padding:30px 0}\nh2{font-size:13px;text-transform:uppercase;letter-spacing:.05em;opacity:.55;margin:18px 0 8px}\n</style></head><body>\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-family:-apple-system,system-ui,sans-serif;font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;line-height:1;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n@media(min-width:768px){body{max-width:760px;margin-left:auto;margin-right:auto}}\n</style>\n<script>\n(function(){\n  if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;\n  window.__myllmAiWrap=true;\n  var orig=window.myllmAsk,depth=0,node=null;\n  function ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\n    node.innerHTML='<span class=\"myllm-ai-cog\">\\u2699\\uFE0F</span><span>AI is thinking\\u2026 <small>privately, on your device</small></span>';\n    (document.body||document.documentElement).appendChild(node);}\n  function show(){ensure();depth++;node.classList.add('on');}\n  function hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\n  window.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\n    return Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};\n})();\n</script>\n\n<h1>📚 Homework Tracker</h1>\n<div class=\"sub\">Keep every assignment, deadline and study step in one place.</div>\n<input id=\"t\" placeholder=\"Assignment (e.g. History essay: the Tudors)\">\n<div class=\"grid\"><input id=\"subj\" placeholder=\"Subject\"><input id=\"due\" type=\"date\"></div>\n<button onclick=\"add()\">Add assignment</button>\n<div id=\"status\"></div>\n<div id=\"list\"></div>\n<script>\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar items=[];\nfunction el(i){return document.getElementById(i)}\nfunction save(){store.setItem('items',JSON.stringify(items))}\nfunction setStatus(t){el('status').textContent=t||''}\nfunction uid(){return'a'+items.reduce(function(m,i){return Math.max(m,+i.id.slice(1)||0)},0)+1}\nfunction todayStr(){var d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}\n\nfunction add(){\n  var t=el('t').value.trim();if(!t)return;\n  items.push({id:uid(),title:t,subj:el('subj').value.trim(),due:el('due').value,done:false,steps:null});\n  el('t').value='';el('subj').value='';el('due').value='';\n  save();render();if(window.myllmHaptic)myllmHaptic('light');\n}\nfunction toggle(id){var i=byId(id);i.done=!i.done;save();render();if(window.myllmHaptic)myllmHaptic(i.done?'success':'selection')}\nfunction del(id){items=items.filter(function(i){return i.id!==id});save();render()}\nfunction byId(id){return items.filter(function(i){return i.id===id})[0]}\n\nfunction dueInfo(due){\n  if(!due)return{txt:'',cls:''};\n  var today=todayStr();\n  var d=new Date(due+'T00:00'),n=new Date(today+'T00:00');\n  var days=Math.round((d-n)/86400000);\n  var label=d.toLocaleDateString(undefined,{weekday:'short',month:'short',day:'numeric'});\n  if(days<0)return{txt:'Overdue · '+label,cls:'late',over:true};\n  if(days===0)return{txt:'Due today',cls:'late'};\n  if(days===1)return{txt:'Due tomorrow',cls:'soon'};\n  if(days<=3)return{txt:'Due in '+days+' days · '+label,cls:'soon'};\n  return{txt:'Due '+label,cls:''};\n}\n\nfunction plan(id){\n  var i=byId(id);\n  if(!window.myllmAsk){setStatus('Step-by-step planning needs AI — enable “Allow apps to use the AI” in Settings.');return}\n  setStatus('Breaking “'+i.title+'” into steps…');\n  myllmAsk('Break this school assignment into 3-6 concrete, ordered steps a student can tick off. Assignment: \"'+i.title+'\"'+(i.subj?(' (subject: '+i.subj+')'):'')+'. Reply with ONLY a JSON array of short step strings, e.g. [\"...\",\"...\"] and nothing else.')\n  .then(function(reply){\n    var s=reply.indexOf('['),e=reply.lastIndexOf(']');\n    if(s<0||e<=s)throw new Error('no steps returned');\n    var arr=JSON.parse(reply.slice(s,e+1)).filter(function(x){return typeof x==='string'&&x.trim()});\n    i.steps=arr.map(function(x){return{t:x,done:false}});save();render();setStatus('');\n  }).catch(function(err){setStatus('Could not plan: '+err.message)});\n}\nfunction toggleStep(id,si){var i=byId(id);i.steps[si].done=!i.steps[si].done;save();render();if(window.myllmHaptic)myllmHaptic('selection')}\n\nfunction render(){\n  var L=el('list');L.innerHTML='';\n  if(!items.length){L.innerHTML='<div class=\"empty\">No assignments yet — add your first above.</div>';return}\n  var open=items.filter(function(i){return!i.done}),done=items.filter(function(i){return i.done});\n  var byDue=function(a,b){return(a.due||'9999')<(b.due||'9999')?-1:1};\n  open.sort(byDue);\n  function block(list,heading){\n    if(!list.length)return;\n    var h=document.createElement('h2');h.textContent=heading;L.appendChild(h);\n    list.forEach(function(i){\n      var di=dueInfo(i.due);\n      var card=document.createElement('div');card.className='item'+(i.done?' done':'')+(di.over&&!i.done?' overdue':'');\n      var top=document.createElement('div');top.className='top';\n      var chk=document.createElement('div');chk.className='chk'+(i.done?' on':'');chk.textContent=i.done?'✓':'';chk.onclick=function(){toggle(i.id)};\n      var body=document.createElement('div');body.className='body';\n      var tt=document.createElement('div');tt.className='title';tt.textContent=i.title;body.appendChild(tt);\n      var meta=[];if(i.subj)meta.push(i.subj);\n      var m=document.createElement('div');m.className='meta';\n      m.innerHTML=(i.subj?'<span>'+escapeHtml(i.subj)+'</span> · ':'')+'<span class=\"due '+di.cls+'\">'+escapeHtml(di.txt||'No date')+'</span>';\n      body.appendChild(m);\n      if(!i.done){\n        var tools=document.createElement('div');tools.className='tools';\n        var a=document.createElement('a');a.textContent=i.steps?'↻ Re-plan steps':'✨ Break into steps';a.onclick=function(){plan(i.id)};\n        tools.appendChild(a);body.appendChild(tools);\n      }\n      if(i.steps&&i.steps.length){\n        var st=document.createElement('div');st.className='steps';\n        i.steps.forEach(function(s,si){\n          var r=document.createElement('div');r.className='s'+(s.done?' on':'');r.textContent=(s.done?'☑ ':'☐ ')+s.t;\n          r.onclick=function(){toggleStep(i.id,si)};st.appendChild(r);\n        });\n        body.appendChild(st);\n      }\n      var x=document.createElement('button');x.className='del';x.textContent='✕';x.onclick=function(){del(i.id)};\n      top.appendChild(chk);top.appendChild(body);top.appendChild(x);\n      card.appendChild(top);L.appendChild(card);\n    });\n  }\n  block(open,'To do');block(done,'Done');\n}\nfunction escapeHtml(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;')}\n\n// Add on Return from the keyboard — the on-screen keyboard would otherwise eat\n// the first tap on the Add button (you'd have to tap it twice).\n['t','subj'].forEach(function(id){el(id).addEventListener('keydown',function(e){if(e.key==='Enter')add()})});\n\nstore.getItem('items').then(function(v){\n  if(v)try{items=JSON.parse(v)}catch(e){}\n  render();\n});\n</script></body></html>\n", "kind": "html", "iconSymbol": "books.vertical.fill", "iconColor": "indigo"}