{"name": "Homework Tracker", "html": "<!doctype html>\n<!--\n  Homework Tracker — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Homework Tracker</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"1731d0b893\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); --h:238; }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink); min-height:100dvh; font-size:15.5px; line-height:1.4; }\n  body.lock{ overflow:hidden; }\n  .home{ max-width:600px; margin:0 auto;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ .home{ max-width:760px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.96); }\n  [hidden]{ display:none !important; }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 28%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  .head .acts{ display:flex; gap:8px; flex-shrink:0; }\n  h2.sec{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:20px 2px 9px; }\n\n  .hero{ border-radius:20px; padding:16px 18px; color:#fff; margin-bottom:12px; display:flex; align-items:center; gap:16px;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 46%), hsl(calc(var(--h) + 40) 58% 24%)); box-shadow:0 10px 28px hsl(var(--h) 60% 30% / .25); }\n  .hero .n{ font-size:44px; font-weight:800; line-height:1; letter-spacing:-.03em; font-variant-numeric:tabular-nums; flex-shrink:0; }\n  .hero .k{ display:block; font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.78; }\n  .hero b{ display:block; font-size:17px; font-weight:750; line-height:1.25; overflow-wrap:anywhere; }\n  .hero span.s{ display:block; font-size:12.5px; line-height:1.4; opacity:.82; margin-top:3px; overflow-wrap:anywhere; }\n  .hero .grow{ flex:1; min-width:0; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  label{ display:block; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:14px 2px 7px; }\n  label:first-child{ margin-top:0; }\n  input, textarea, select{ width:100%; font:inherit; font-size:16px; padding:12px; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; }\n  input:focus, textarea:focus{ border-color:hsl(var(--h) 60% 55%); }\n  .go{ width:100%; min-height:50px; margin-top:14px; border:none; border-radius:14px; background:hsl(var(--h) 62% 52%); color:#fff; font-size:16px; font-weight:700;\n    display:flex; align-items:center; justify-content:center; gap:8px; box-shadow:0 8px 20px hsl(var(--h) 60% 40% / .25); }\n  .go.soft{ background:var(--fill); color:var(--ink); box-shadow:none; }\n  .go:disabled{ opacity:.55; }\n  .status{ font-size:13px; color:var(--muted); min-height:18px; margin-top:10px; text-align:center; line-height:1.45; }\n  .status.err{ color:#ff453a; }\n  .spin{ width:16px; height:16px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; display:inline-block; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n  .empty{ text-align:center; padding:24px 18px 14px; }\n  .empty .tile{ width:48px; height:48px; border-radius:14px; font-size:21px; margin:0 auto 10px; opacity:.9; }\n  .empty b{ display:block; font-size:16px; font-weight:750; }\n  .empty p{ font-size:13.5px; color:var(--muted); line-height:1.5; max-width:280px; margin:5px auto 0; }\n  @media (prefers-reduced-motion:reduce){ .spin{ animation-duration:2.4s; } button:active{ transform:none; } }\n  @keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n  .myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n  .myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n  .myllm-ai-cog{width:16px;height:16px;border-radius:50%;border:2.4px solid #a78bfa;border-right-color:transparent;animation:myllmAiSpin .9s linear infinite;flex-shrink:0}\n  .myllm-ai-busy small{font-weight:400;opacity:.6}\n\n  .grid2{ display:flex; gap:10px; } .grid2 > div{ flex:1; min-width:0; }\n  input[type=date]{ min-height:46px; -webkit-appearance:none; appearance:none; }\n  .item{ display:flex; align-items:flex-start; gap:10px; padding:11px 0; border-bottom:1px solid var(--line); }\n  .item:first-child{ padding-top:2px; } .item:last-child{ border-bottom:none; padding-bottom:2px; }\n  .chk{ width:44px; height:44px; margin:-8px -6px -8px -10px; border:none; background:none; display:flex; align-items:center; justify-content:center; flex-shrink:0; }\n  .chk span{ width:26px; height:26px; border-radius:8px; border:2px solid var(--line); display:flex; align-items:center; justify-content:center; color:#fff; font-size:14px; transition:background .2s, border-color .2s; }\n  .chk.on span{ background:hsl(var(--h) 62% 52%); border-color:hsl(var(--h) 62% 52%); }\n  .body{ flex:1; min-width:0; }\n  .title{ font-size:16px; font-weight:650; line-height:1.3; overflow-wrap:anywhere; }\n  .item.done .title{ text-decoration:line-through; color:var(--muted); }\n  .meta{ display:flex; flex-wrap:wrap; align-items:center; gap:6px; margin-top:5px; font-size:12px; }\n  .subj{ font-weight:700; color:hsl(var(--h) 60% 45%); background:hsl(var(--h) 70% 50% / .12); border-radius:99px; padding:2px 8px; }\n  @media (prefers-color-scheme:dark){ .subj{ color:hsl(var(--h) 80% 72%); } }\n  .due{ color:var(--muted); font-weight:600; }\n  .due.soon{ color:#c77700; } .due.late{ color:#e0342a; }\n  @media (prefers-color-scheme:dark){ .due.soon{ color:#ffb340; } .due.late{ color:#ff6b62; } }\n  .item.late{ box-shadow:inset 3px 0 0 #ff453a; padding-left:12px; }\n  .tool{ margin-top:8px; min-height:36px; border:none; border-radius:10px; padding:0 12px; background:var(--fill); color:hsl(var(--h) 62% 48%);\n    font-size:13.5px; font-weight:700; display:inline-flex; align-items:center; gap:6px; }\n  @media (prefers-color-scheme:dark){ .tool{ color:hsl(var(--h) 80% 74%); } }\n  .tool:disabled{ opacity:.7; }\n  .steps{ margin-top:9px; border-radius:12px; background:var(--bg); padding:4px 6px; }\n  .s{ width:100%; display:flex; align-items:flex-start; gap:9px; border:none; background:none; text-align:left; padding:8px 4px; font-size:14.5px; line-height:1.35; }\n  .s .box{ width:20px; height:20px; border-radius:6px; border:2px solid var(--line); flex-shrink:0; display:flex; align-items:center; justify-content:center; color:#fff; font-size:11px; margin-top:1px; }\n  .s.on{ color:var(--muted); text-decoration:line-through; }\n  .s.on .box{ background:hsl(var(--h) 62% 52%); border-color:hsl(var(--h) 62% 52%); }\n  .s:active{ transform:none; }\n  .del{ width:44px; height:44px; margin:-8px -10px -8px 0; border:none; background:none; color:var(--muted); font-size:14px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }\n  .del:active{ color:#ff453a; }\n\n/* myllm-fullscreen-v1 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-books\" viewBox=\"0 0 24 24\"><path d=\"M4 3.5h3.2a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-15a1 1 0 0 1 1-1zm5.8 0H13a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H9.8a1 1 0 0 1-1-1v-15a1 1 0 0 1 1-1zm6.1 1.1l3-.8a1 1 0 0 1 1.2.7l3.6 13.9a1 1 0 0 1-.7 1.2l-3 .8a1 1 0 0 1-1.2-.7L15.2 5.8a1 1 0 0 1 .7-1.2z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M5 12.6l4.6 4.6L19.2 7.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-plus\" viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-spark\" viewBox=\"0 0 24 24\"><path d=\"M10 2.5l1.9 5.6 5.6 1.9-5.6 1.9L10 17.5l-1.9-5.6L2.5 10l5.6-1.9zM18.5 14l.95 2.55L22 17.5l-2.55.95L18.5 21l-.95-2.55L15 17.5l2.55-.95z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-again\" viewBox=\"0 0 24 24\"><path d=\"M12 5V2.6a.6.6 0 0 0-1-.45L7.2 5.55a.6.6 0 0 0 0 .9L11 9.85a.6.6 0 0 0 1-.45V7a5.5 5.5 0 1 1-5.5 5.5 1 1 0 0 0-2 0A7.5 7.5 0 1 0 12 5z\" fill=\"currentColor\"/></symbol>\n</defs></svg>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\"></span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n<div class=\"home\">\n  <div class=\"imm-safe\"></div><div class=\"head\">\n    <div class=\"tile\"><svg class=\"i\"><use href=\"#i-books\"/></svg></div>\n    <div class=\"ht\"><h1>Homework Tracker</h1><p>Every assignment and deadline, sorted</p></div>\n  <div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Homework Tracker\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n\n  <div class=\"hero\" id=\"hero\">\n    <div class=\"n\" id=\"hN\">0</div>\n    <div class=\"grow\"><b id=\"hT\">Nothing to do</b><span class=\"s\" id=\"hS\">Add your first assignment below.</span></div>\n  </div>\n\n  <div class=\"card\">\n    <label for=\"t\">Assignment</label>\n    <input id=\"t\" placeholder=\"e.g. History essay: the Tudors\" autocomplete=\"off\" enterkeyhint=\"done\">\n    <div class=\"grid2\">\n      <div><label for=\"subj\">Subject</label><input id=\"subj\" placeholder=\"e.g. History\" autocomplete=\"off\" enterkeyhint=\"done\"></div>\n      <div><label for=\"due\">Due</label><input id=\"due\" type=\"date\"></div>\n    </div>\n    <button class=\"go\" id=\"addBtn\" type=\"button\"><svg class=\"i\"><use href=\"#i-plus\"/></svg>Add assignment</button>\n    <div id=\"status\" class=\"status\"></div>\n  </div>\n\n  <div id=\"list\"></div>\n</div>\n\n<script>\nfunction el(i){return document.getElementById(i)}\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction store(){return window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}}}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nfunction icon(n){return '<svg class=\"i\"><use href=\"#i-'+n+'\"/></svg>'}\nfunction esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]})}\nvar items=[],planning=null;\nfunction save(){store().setItem('items',JSON.stringify(items))}\nfunction setStatus(t,err){var s=el('status');s.textContent=t||'';s.classList.toggle('err',!!err)}\nfunction uid(){return'a'+items.reduce(function(m,i){return Math.max(m,+i.id.slice(1)||0)},0)+1}\nfunction todayStr(){var d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}\n\nfunction add(){\n  var t=el('t').value.trim();if(!t){el('t').focus();return}\n  items.push({id:uid(),title:t,subj:el('subj').value.trim(),due:el('due').value,done:false,steps:null});\n  el('t').value='';el('subj').value='';el('due').value='';\n  save();render();haptic('light');\n}\nfunction toggle(id){var i=byId(id);i.done=!i.done;save();render();haptic(i.done?'success':'selection')}\nfunction del(id){items=items.filter(function(i){return i.id!==id});save();render()}\nfunction byId(id){return items.filter(function(i){return i.id===id})[0]}\n\nfunction dueInfo(due){\n  if(!due)return{txt:'',cls:''};\n  var today=todayStr();\n  var d=new Date(due+'T00:00'),n=new Date(today+'T00:00');\n  var days=Math.round((d-n)/86400000);\n  var label=d.toLocaleDateString(undefined,{weekday:'short',month:'short',day:'numeric'});\n  if(days<0)return{txt:'Overdue · '+label,cls:'late',over:true,days:days};\n  if(days===0)return{txt:'Due today',cls:'late',days:0};\n  if(days===1)return{txt:'Due tomorrow',cls:'soon',days:1};\n  if(days<=3)return{txt:'Due in '+days+' days · '+label,cls:'soon',days:days};\n  return{txt:'Due '+label,cls:'',days:days};\n}\n\n/* Labelled lines, not JSON — small models (Apple Intelligence) echo JSON\n   templates back verbatim. Echoed instructions are rejected and retried. */\nvar ECHO=/one short, concrete step|repeat this line|labelled line|the student can do/i;\nfunction parseSteps(reply){\n  var steps=[],got=false;\n  String(reply||'').split(/\\r?\\n/).forEach(function(raw){\n    var ln=raw.replace(/\\*\\*/g,'').trim();\n    var m=ln.match(/^[-*#>\\s]*(STEPS?)\\s*\\d*\\s*[::]\\s*(.*)$/i);\n    if(!m)return;\n    got=true;var v=m[2].trim();\n    if(v)steps.push(v);\n  });\n  if(!got){ // model answered in the old JSON-array shape — accept it\n    var s=reply.indexOf('['),e=reply.lastIndexOf(']');\n    if(s>=0&&e>s)try{\n      var arr=JSON.parse(reply.slice(s,e+1));\n      if(Array.isArray(arr))steps=arr.filter(function(x){return typeof x==='string'&&x.trim()}).map(function(x){return x.trim()});\n    }catch(e2){}\n  }\n  steps=steps.filter(function(x){return x&&!ECHO.test(x)});\n  if(steps.length<2)throw new Error('no steps returned');\n  return steps;\n}\nfunction plan(id){\n  var i=byId(id);\n  if(!window.myllmAsk){setStatus('Step-by-step planning needs AI — enable “Allow apps to use the AI” in Settings.',true);return}\n  planning=id;render();\n  setStatus('Breaking “'+i.title+'” into steps…');\n  var p='Break this school assignment into 3-6 concrete, ordered steps a student can tick off. Assignment: \"'+i.title+'\"'+(i.subj?(' (subject: '+i.subj+')'):'')+'. Reply with EXACTLY these labelled lines and nothing else:\\n'+\n    'STEP: one short, concrete step the student can do (repeat this line for every step, in order)';\n  myllmAsk(p).then(function(r){return parseSteps(r||'')})\n  .catch(function(){return myllmAsk(p+'\\nIMPORTANT: fill each labelled line with real content — never repeat the instruction text.')\n    .then(function(r){return parseSteps(r||'')})})\n  .then(function(arr){\n    i.steps=arr.map(function(x){return{t:x,done:false}});save();setStatus('');\n  }).catch(function(err){setStatus('Could not plan: '+err.message,true)})\n  .then(function(){planning=null;render()});\n}\nfunction toggleStep(id,si){var i=byId(id);i.steps[si].done=!i.steps[si].done;save();render();haptic('selection')}\n\nfunction renderHero(){\n  var open=items.filter(function(i){return!i.done});\n  var over=open.filter(function(i){return dueInfo(i.due).over});\n  var dated=open.filter(function(i){return i.due&&!dueInfo(i.due).over}).sort(function(a,b){return a.due<b.due?-1:1});\n  el('hN').textContent=open.length;\n  el('hT').textContent=!items.length?'Nothing to do yet':open.length===1?'assignment to do':open.length?'assignments to do':'All done';\n  var s;\n  if(!items.length)s='Add your first assignment below.';\n  else if(!open.length)s='Every assignment is ticked off. Nice work.';\n  else if(over.length)s=over.length+' overdue'+(dated[0]?' · next: '+dated[0].title+', '+dueInfo(dated[0].due).txt.toLowerCase():'');\n  else if(dated[0])s='Next: '+dated[0].title+' — '+dueInfo(dated[0].due).txt.toLowerCase();\n  else s='No due dates set.';\n  el('hS').textContent=s;\n}\nfunction render(){\n  renderHero();\n  var L=el('list');L.innerHTML='';\n  if(!items.length){\n    L.innerHTML='<div class=\"card empty\"><div class=\"tile\">'+icon('books')+'</div><b>No assignments yet</b><p>Add one above — you can break any of them into small steps with AI.</p></div>';\n    return;\n  }\n  var open=items.filter(function(i){return!i.done}),done=items.filter(function(i){return i.done});\n  var byDue=function(a,b){return(a.due||'9999')<(b.due||'9999')?-1:1};\n  open.sort(byDue);\n  function block(list,heading){\n    if(!list.length)return;\n    var h=document.createElement('h2');h.className='sec';h.textContent=heading;L.appendChild(h);\n    var card=document.createElement('div');card.className='card';\n    list.forEach(function(i){\n      var di=dueInfo(i.due);\n      var row=document.createElement('div');row.className='item'+(i.done?' done':'')+(di.over&&!i.done?' late':'');\n      var chk=document.createElement('button');chk.type='button';chk.className='chk'+(i.done?' on':'');chk.setAttribute('aria-label',i.done?'Mark not done':'Mark done');\n      chk.innerHTML='<span>'+(i.done?icon('check'):'')+'</span>';chk.onclick=function(){toggle(i.id)};\n      var body=document.createElement('div');body.className='body';\n      var tt=document.createElement('div');tt.className='title';tt.textContent=i.title;body.appendChild(tt);\n      var m=document.createElement('div');m.className='meta';\n      m.innerHTML=(i.subj?'<span class=\"subj\">'+esc(i.subj)+'</span>':'')+'<span class=\"due '+di.cls+'\">'+esc(di.txt||'No date')+'</span>';\n      body.appendChild(m);\n      if(!i.done){\n        var b=document.createElement('button');b.type='button';b.className='tool';\n        if(planning===i.id){b.disabled=true;b.innerHTML='<i class=\"spin\"></i>Breaking into steps…'}\n        else{b.innerHTML=i.steps?icon('again')+'Re-plan steps':icon('spark')+'Break into steps';b.disabled=!!planning}\n        b.onclick=function(){plan(i.id)};\n        body.appendChild(b);\n      }\n      if(i.steps&&i.steps.length){\n        var st=document.createElement('div');st.className='steps';\n        i.steps.forEach(function(s,si){\n          var r=document.createElement('button');r.type='button';r.className='s'+(s.done?' on':'');\n          r.innerHTML='<span class=\"box\">'+(s.done?icon('check'):'')+'</span><span>'+esc(s.t)+'</span>';\n          r.onclick=function(){toggleStep(i.id,si)};st.appendChild(r);\n        });\n        body.appendChild(st);\n      }\n      var x=document.createElement('button');x.type='button';x.className='del';x.innerHTML=icon('x');x.setAttribute('aria-label','Delete assignment');x.onclick=function(){del(i.id)};\n      row.appendChild(chk);row.appendChild(body);row.appendChild(x);\n      card.appendChild(row);\n    });\n    L.appendChild(card);\n  }\n  block(open,'To do');block(done,'Done');\n}\n\nel('addBtn').onclick=add;\n// Add on Return from the keyboard — the on-screen keyboard would otherwise eat\n// the first tap on the Add button (you'd have to tap it twice).\n['t','subj'].forEach(function(id){el(id).addEventListener('keydown',function(e){if(e.key==='Enter')add()})});\n\nrender();\nstore().getItem('items').then(function(v){\n  if(v)try{items=JSON.parse(v)||[]}catch(e){}\n  render();\n});\n\n/* myllm-fullscreen-v1 — full screen where MyLLM can also close the app for us (myllmClose,\n   5.6.2+): full screen hides MyLLM's Done, and a page with no way out is\n   worse than a repeated title, so elsewhere nothing changes. The spacer keeps\n   the header clear of the status bar only if the page doesn't already. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  function inset(){\n    var p = document.createElement(\"div\");\n    p.style.cssText = \"position:fixed;top:0;left:0;width:1px;visibility:hidden;height:env(safe-area-inset-top)\";\n    document.body.appendChild(p); var h = p.offsetHeight; p.parentNode.removeChild(p); return h;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = \"0px\";\n    if (!document.body.classList.contains(\"imm\")) return;\n    var need = inset() + 6 - (head.getBoundingClientRect().top + window.scrollY);\n    sp.style.height = Math.max(0, Math.round(need)) + \"px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  window.addEventListener(\"resize\", fit);\n  sync();\n})();\n</script></body></html>\n", "kind": "html", "iconSymbol": "books.vertical.fill", "iconColor": "indigo"}