{"name": "Speed Check", "kind": "html", "iconSymbol": "gauge.with.dots.needle.67percent", "iconColor": "orange", "html": "<!doctype html>\n<!--\n  Speed Check — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Speed Check</title>\n<style>\n:root{--build-id:\"06afd97ecf\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7);--surface:var(--myllm-surface,#fff);--text:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#6e6e73);--accent:var(--myllm-accent,#0a84ff);--border:var(--myllm-border,#e3e3e8);\n  --radius:var(--myllm-radius,18px);--down:#12a594;--up:#ff8a3d;--ping:#7c5cff;--good:#2fb56a;--warn:#e8a317;--bad:#e5484d}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nhtml,body{margin:0}\nbody{font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);background:var(--bg);color:var(--text);\n  padding:18px 16px calc(28px + env(safe-area-inset-bottom));max-width:820px;margin:0 auto;-webkit-font-smoothing:antialiased}\nh1{font-size:24px;margin:0;letter-spacing:-.3px}\n.sub{font-size:13px;color:var(--muted);margin:3px 0 14px}\n.top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}\n.iconbtn{border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:12px;padding:8px 12px;font-size:14px;font-weight:600}\n.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px}\n.gauge{position:relative;text-align:center;padding:8px 8px 0}\n.gauge svg{width:min(100%,360px);height:auto;display:block;margin:0 auto}\n.gauge .phase{font-size:13px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;margin-top:4px;min-height:16px}\n.phase.down{color:var(--down)}.phase.up{color:var(--up)}.phase.ping{color:var(--ping)}\n.needle{transition:transform .35s cubic-bezier(.2,.8,.2,1);transform-origin:180px 150px}\n.arc{fill:none;stroke-width:16;stroke-linecap:round}\n.status{font-size:14px;color:var(--muted);text-align:center;min-height:20px;margin:10px 0 4px;line-height:1.45}\n.status b{color:var(--text)}\n.big{display:block;width:100%;border:0;border-radius:16px;padding:16px;font-size:18px;font-weight:700;color:#fff;\n  background:var(--accent);margin-top:12px;transition:transform .12s,opacity .2s}\n.big:active{transform:scale(.985)}\n.big.stop{background:var(--bad)}\n.big[disabled]{opacity:.55}\n.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:12px}\n@media(min-width:560px){.grid{grid-template-columns:repeat(4,1fr)}}\n.stat{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:12px 14px}\n.stat .k{font-size:12px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.5px}\n.stat .v{font-size:26px;font-weight:700;letter-spacing:-.5px;margin-top:4px;font-variant-numeric:tabular-nums}\n.stat .v small{font-size:13px;font-weight:600;color:var(--muted);margin-left:3px}\n.stat.down .v{color:var(--down)}.stat.up .v{color:var(--up)}.stat.ping .v{color:var(--ping)}\n.sec{margin-top:16px}\n.sec h2{font-size:15px;margin:0 0 8px;display:flex;align-items:center;justify-content:space-between}\n.sec h2 button{border:0;background:transparent;color:var(--accent);font-size:14px;font-weight:600;padding:4px 0}\n.verdict{display:flex;flex-direction:column;gap:9px}\n.vrow{display:flex;align-items:center;gap:10px;font-size:15px}\n.dot{width:10px;height:10px;border-radius:50%;flex:none}\n.dot.good{background:var(--good)}.dot.warn{background:var(--warn)}.dot.bad{background:var(--bad)}\n.vrow span{flex:1;white-space:nowrap}.vrow em{font-style:normal;color:var(--muted);font-size:12.5px;text-align:right;max-width:52%;line-height:1.3}\n.kv{display:grid;grid-template-columns:auto 1fr;gap:7px 14px;font-size:14px}\n.kv .k{color:var(--muted)}.kv .v{font-weight:600;word-break:break-all;text-align:right}\n.hist{display:flex;flex-direction:column;gap:6px}\n.hrow{display:flex;align-items:center;gap:8px;font-size:14px;padding:9px 0;border-top:1px solid var(--border)}\n.hrow:first-child{border-top:0}\n.hrow .d{flex:1;color:var(--muted);font-size:13px}\n.hrow b{font-variant-numeric:tabular-nums;min-width:58px;text-align:right}\n.hrow b.dn{color:var(--down)}.hrow b.upv{color:var(--up)}.hrow b.pg{color:var(--ping)}\n.bar{height:6px;border-radius:3px;background:var(--border);overflow:hidden;flex:0 0 64px}\n.bar i{display:block;height:100%;background:var(--down)}\n.note{font-size:12px;color:var(--muted);line-height:1.5;margin-top:14px}\n.empty{color:var(--muted);font-size:14px;text-align:center;padding:14px 0}\n.confirm{display:flex;gap:8px;align-items:center;font-size:14px}\n.confirm button{border:0;border-radius:10px;padding:8px 12px;font-weight:600;font-size:14px}\n.confirm .yes{background:var(--bad);color:#fff}.confirm .no{background:var(--border);color:var(--text)}\n[hidden]{display:none!important}\n.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(20px);\n  background:var(--text);color:var(--bg);padding:10px 16px;border-radius:14px;font-size:14px;font-weight:600;opacity:0;pointer-events:none;transition:.25s;z-index:9}\n.toast.on{opacity:1;transform:translateX(-50%) translateY(0)}\n</style></head><body>\n\n<div class=\"top\">\n  <div><h1>Speed Check</h1><div class=\"sub\">Download, upload and ping for this connection</div></div>\n  <button class=\"iconbtn\" id=\"shareBtn\" hidden>Share</button>\n</div>\n\n<div class=\"card\">\n  <div class=\"gauge\">\n    <svg viewBox=\"0 0 360 252\" aria-hidden=\"true\">\n      <path class=\"arc\" id=\"track\" stroke=\"var(--border)\" d=\"\"/>\n      <path class=\"arc\" id=\"fill\" stroke=\"var(--accent)\" d=\"\" stroke-dasharray=\"0 1000\"/>\n      <g id=\"ticks\" fill=\"var(--muted)\" font-size=\"11\" font-weight=\"600\" text-anchor=\"middle\"></g>\n      <g class=\"needle\" id=\"needle\">\n        <line x1=\"180\" y1=\"150\" x2=\"180\" y2=\"66\" stroke=\"var(--text)\" stroke-width=\"3.5\" stroke-linecap=\"round\"/>\n        <circle cx=\"180\" cy=\"150\" r=\"7\" fill=\"var(--text)\"/>\n      </g>\n      <text id=\"liveNum\" x=\"180\" y=\"220\" text-anchor=\"middle\" font-size=\"56\" font-weight=\"700\" fill=\"var(--text)\" style=\"font-variant-numeric:tabular-nums;letter-spacing:-1.5px\">—</text>\n      <text id=\"liveUnit\" x=\"180\" y=\"242\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"600\" fill=\"var(--muted)\">Mbps</text>\n    </svg>\n    <div class=\"phase\" id=\"phase\"></div>\n  </div>\n  <div class=\"status\" id=\"status\">Tap Start to measure your connection.</div>\n  <button class=\"big\" id=\"startBtn\">Start test</button>\n</div>\n\n<div class=\"grid\">\n  <div class=\"stat down\"><div class=\"k\">Download</div><div class=\"v\" id=\"rDown\">—<small>Mbps</small></div></div>\n  <div class=\"stat up\"><div class=\"k\">Upload</div><div class=\"v\" id=\"rUp\">—<small>Mbps</small></div></div>\n  <div class=\"stat ping\"><div class=\"k\">Ping</div><div class=\"v\" id=\"rPing\">—<small>ms</small></div></div>\n  <div class=\"stat ping\"><div class=\"k\">Jitter</div><div class=\"v\" id=\"rJit\">—<small>ms</small></div></div>\n</div>\n\n<div class=\"sec\" id=\"verdictSec\" hidden>\n  <h2>What this connection can do</h2>\n  <div class=\"card verdict\" id=\"verdict\"></div>\n</div>\n\n<div class=\"sec\" id=\"connSec\" hidden>\n  <h2>Your connection</h2>\n  <div class=\"card kv\" id=\"conn\"></div>\n</div>\n\n<div class=\"sec\" id=\"histSec\">\n  <h2>History <button id=\"clearBtn\" hidden>Clear</button></h2>\n  <div class=\"card\">\n    <div class=\"confirm\" id=\"confirmClear\" hidden><span style=\"flex:1\">Delete all saved results?</span><button class=\"yes\" id=\"clearYes\">Delete</button><button class=\"no\" id=\"clearNo\">Keep</button></div>\n    <div class=\"hist\" id=\"hist\"><div class=\"empty\">No tests yet. Results are saved on this device.</div></div>\n  </div>\n</div>\n\n<p class=\"note\">Measures against Cloudflare's public speed-test service (speed.cloudflare.com) through MyLLM's network bridge, so the only thing sent is test data. On very fast connections the bridge itself becomes the bottleneck, so treat high results as a floor rather than a ceiling. A full test moves up to about 160 MB of data (less on slower connections), so bear that in mind on a metered plan.</p>\n\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\n(function(){\n'use strict';\nvar $=function(id){return document.getElementById(id);};\nfunction haptic(k){try{if(window.myllmHaptic)window.myllmHaptic(k||'light');}catch(e){}}\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null);},setItem:function(){return Promise.resolve();}};\nvar hasFetch=typeof window.myllmFetch==='function';\nvar HOST='https://speed.cloudflare.com';\nvar KEY='speedcheck.v1';\nvar MAXCHUNK=4*1024*1024; // bridge caps a response at 5 MB\n\n/* ---------- gauge (non-linear like a real speed dial) ---------- */\nvar STOPS=[0,1,5,10,25,50,100,250,500,1000];\nvar CX=180,CY=150,R=130,A0=-200,A1=20; // sweep 220 degrees, symmetric about the top\nfunction polar(a,r){var t=a*Math.PI/180;return [CX+r*Math.cos(t),CY+r*Math.sin(t)];}\nfunction arcPath(a,b){var p=polar(a,R),q=polar(b,R);var large=(b-a)>180?1:0;return 'M'+p[0].toFixed(1)+' '+p[1].toFixed(1)+' A'+R+' '+R+' 0 '+large+' 1 '+q[0].toFixed(1)+' '+q[1].toFixed(1);}\nfunction frac(mbps){ // piecewise-linear across STOPS -> 0..1\n  if(mbps<=0)return 0;if(mbps>=1000)return 1;\n  for(var i=1;i<STOPS.length;i++){if(mbps<=STOPS[i]){var lo=STOPS[i-1],hi=STOPS[i];return ((i-1)+(mbps-lo)/(hi-lo))/(STOPS.length-1);}}\n  return 1;\n}\nvar trackLen=Math.PI*R*(A1-A0)/180;\nfunction drawGauge(){\n  $('track').setAttribute('d',arcPath(A0,A1));\n  $('fill').setAttribute('d',arcPath(A0,A1));\n  var g=$('ticks'),html='';\n  for(var i=0;i<STOPS.length;i++){var a=A0+(A1-A0)*i/(STOPS.length-1);var p=polar(a,R-26);html+='<text x=\"'+p[0].toFixed(1)+'\" y=\"'+(p[1]+4).toFixed(1)+'\">'+STOPS[i]+'</text>';}\n  g.innerHTML=html;\n  setGauge(0,null);\n}\nfunction setGauge(mbps,kind){\n  var f=frac(mbps);\n  $('needle').style.transform='rotate('+((A0+90)+(A1-A0)*f)+'deg)';\n  $('fill').setAttribute('stroke-dasharray',(trackLen*f).toFixed(1)+' 1000');\n  $('fill').setAttribute('stroke',kind==='down'?'var(--down)':kind==='up'?'var(--up)':kind==='ping'?'var(--ping)':'var(--accent)');\n}\nfunction fmt(mbps){return mbps>=100?Math.round(mbps).toString():mbps>=10?mbps.toFixed(1):mbps.toFixed(2);}\nfunction setLive(mbps,unit){$('liveNum').textContent=mbps==null?'—':(unit==='ms'?Math.round(mbps).toString():fmt(mbps));$('liveUnit').textContent=unit||'Mbps';}\nfunction setPhase(text,kind){var p=$('phase');p.textContent=text;p.className='phase'+(kind?' '+kind:'');}\nfunction status(html){$('status').innerHTML=html;}\nfunction toast(t){var e=$('toast');e.textContent=t;e.classList.add('on');clearTimeout(toast._t);toast._t=setTimeout(function(){e.classList.remove('on');},1800);}\n\n/* ---------- bridge helpers ---------- */\nfunction bust(u){return u+(u.indexOf('?')<0?'?':'&')+'r='+Math.random().toString(36).slice(2);}\nfunction get(url,opts){return window.myllmFetch(bust(url),opts||{});}\nfunction bytesOf(res){var cl=res&&res.headers&&parseInt(res.headers['content-length'],10);if(cl>0)return cl;if(res&&typeof res.body==='string')return res.body.length;return 0;}\nfunction serverTime(res){ // cloudflare exposes its own processing time; subtract it like their tester does\n  var st=res&&res.headers&&res.headers['server-timing'];if(!st)return 0;var t=0,m,re=/cfSpeed\\w*;dur=([\\d.]+)/g;\n  while((m=re.exec(st)))t+=parseFloat(m[1])||0;return t;\n}\nfunction friendlyError(e){\n  var m=(e&&e.message)||String(e||'');\n  if(/turned off/i.test(m))return 'Network access for apps is turned off in MyLLM Settings → MyLLMos Apps.';\n  if(/offline|not connected|internet connection/i.test(m))return 'You appear to be offline.';\n  if(/timed out/i.test(m))return 'The connection timed out. Try again in a moment.';\n  return 'Could not reach the speed-test server ('+m.slice(0,80)+').';\n}\n\n/* ---------- the test ---------- */\nvar running=false,abort=false,last=null;\nfunction median(a){var s=a.slice().sort(function(x,y){return x-y;});var n=s.length;return n?(n%2?s[(n-1)/2]:(s[n/2-1]+s[n/2])/2):0;}\nfunction sleep(ms){return new Promise(function(r){setTimeout(r,ms);});}\n\nfunction measurePing(){\n  var N=9,samples=[];\n  setPhase('Ping','ping');setLive(null,'ms');\n  function one(i){\n    if(abort||i>=N)return Promise.resolve();\n    var t0=performance.now();\n    return get(HOST+'/__down?bytes=0').then(function(res){\n      var rtt=Math.max(0,(performance.now()-t0)-serverTime(res));\n      if(i>0)samples.push(rtt); // first hit pays for the TLS handshake — not latency\n      setLive(median(samples.length?samples:[rtt]),'ms');\n      setGauge(0,'ping');\n      status('Measuring latency… <b>'+(i+1)+'/'+N+'</b>');\n      return sleep(80).then(function(){return one(i+1);});\n    });\n  }\n  return one(0).then(function(){\n    var ping=median(samples),jit=0;\n    for(var i=1;i<samples.length;i++)jit+=Math.abs(samples[i]-samples[i-1]);\n    jit=samples.length>1?jit/(samples.length-1):0;\n    return {ping:ping,jitter:jit};\n  });\n}\n\n/* Time-boxed, parallel, adaptively-sized transfer. Throughput is taken over the\n   steady part of the window (after a 1 s ramp) so the TCP slow-start and the first\n   bridge round-trip don't drag the number down. */\nfunction measureThroughput(kind,opts){\n  var streams=opts.streams,duration=opts.duration,chunk=opts.start,maxBytes=opts.maxBytes||Infinity;\n  var t0=performance.now(),done=0,doneAtRamp=null,tRamp=null,active=0,finished=false;\n  var RAMP=1000;\n  setPhase(kind==='down'?'Download':'Upload',kind);setLive(0,'Mbps');setGauge(0,kind);\n  function report(){\n    var now=performance.now(),el=(now-t0)/1000;\n    var mbps=doneAtRamp!=null&&now-tRamp>250?((done-doneAtRamp)*8/1e6)/((now-tRamp)/1000):el>0.25?(done*8/1e6)/el:0;\n    setLive(mbps,'Mbps');setGauge(mbps,kind);\n    status((kind==='down'?'Downloading':'Uploading')+'… <b>'+(done/1e6).toFixed(1)+' MB</b> · '+Math.min(duration/1000,el).toFixed(0)+'s');\n    return mbps;\n  }\n  function tick(){\n    var now=performance.now();\n    if(doneAtRamp==null&&now-t0>=RAMP){doneAtRamp=done;tRamp=now;}\n  }\n  return new Promise(function(resolve){\n    function finish(){\n      if(finished)return;finished=true;clearInterval(iv);\n      var now=performance.now();\n      var mbps=doneAtRamp!=null&&now-tRamp>500?((done-doneAtRamp)*8/1e6)/((now-tRamp)/1000):(done*8/1e6)/((now-t0)/1000);\n      resolve({mbps:isFinite(mbps)?mbps:0,bytes:done});\n    }\n    var iv=setInterval(function(){tick();report();},150);\n    function worker(){\n      if(abort||performance.now()-t0>=duration||done>=maxBytes){ if(active===0)finish(); return; }\n      active++;\n      var size=chunk,ts=performance.now(),p;\n      if(kind==='down'){p=get(HOST+'/__down?bytes='+size);}\n      else{p=get(HOST+'/__up',{method:'POST',headers:{'content-type':'text/plain'},body:zeros(size)});}\n      p.then(function(res){\n        var got=kind==='down'?bytesOf(res):size;\n        if(!(res&&res.ok))got=0;\n        done+=got;tick();\n        var took=performance.now()-ts;\n        if(took<450&&chunk<opts.max)chunk=Math.min(opts.max,chunk*2); // fast? ask for more per round trip\n        else if(took>2500&&chunk>opts.start)chunk=Math.max(opts.start,chunk/2);\n      }).catch(function(e){ workerError=e; }).then(function(){ active--; worker(); });\n    }\n    for(var i=0;i<streams;i++)worker();\n  });\n}\nvar workerError=null;\nvar zeroCache={};\nfunction zeros(n){if(!zeroCache[n]){zeroCache[n]=new Array(n+1).join('0');}return zeroCache[n];}\n\nfunction connectionInfo(){\n  return get(HOST+'/cdn-cgi/trace').then(function(res){\n    var info={};(res.body||'').split('\\n').forEach(function(l){var i=l.indexOf('=');if(i>0)info[l.slice(0,i)]=l.slice(i+1);});\n    return info;\n  }).catch(function(){return {};});\n}\n\nfunction runTest(){\n  if(running){abort=true;status('Stopping…');return;}\n  if(!hasFetch){status('This app needs MyLLM\\'s network bridge — open it inside the MyLLM app to run a test.');return;}\n  running=true;abort=false;workerError=null;last=null;\n  haptic('light');\n  var btn=$('startBtn');btn.textContent='Stop';btn.classList.add('stop');\n  ['rDown','rUp','rPing','rJit'].forEach(function(id){$(id).firstChild.nodeValue='—';});\n  $('verdictSec').hidden=true;$('shareBtn').hidden=true;\n  var result={t:Date.now()};\n  connectionInfo().then(function(info){\n    result.ip=info.ip||'';result.colo=info.colo||'';result.loc=info.loc||'';result.http=info.http||'';result.tls=info.tls||'';\n    showConn(result);\n    if(abort)throw new Error('cancelled');\n    return measurePing();\n  }).then(function(p){\n    result.ping=p.ping;result.jitter=p.jitter;\n    $('rPing').firstChild.nodeValue=Math.round(p.ping);$('rJit').firstChild.nodeValue=Math.round(p.jitter);\n    if(abort)throw new Error('cancelled');\n    haptic('selection');\n    return measureThroughput('down',{streams:3,duration:8000,start:256*1024,max:MAXCHUNK,maxBytes:120*1e6});\n  }).then(function(d){\n    result.down=d.mbps;result.downBytes=d.bytes;\n    $('rDown').firstChild.nodeValue=fmt(d.mbps);\n    if(abort)throw new Error('cancelled');\n    if(d.bytes===0&&workerError)throw workerError;\n    haptic('selection');\n    return measureThroughput('up',{streams:2,duration:6000,start:128*1024,max:2*1024*1024,maxBytes:40*1e6});\n  }).then(function(u){\n    result.up=u.mbps;result.upBytes=u.bytes;\n    $('rUp').firstChild.nodeValue=fmt(u.mbps);\n    if(abort)throw new Error('cancelled');\n    last=result;\n    setPhase('Done','');setLive(result.down,'Mbps');setGauge(result.down,'down');\n    status('Download <b>'+fmt(result.down)+' Mbps</b> · Upload <b>'+fmt(result.up)+' Mbps</b> · Ping <b>'+Math.round(result.ping)+' ms</b>');\n    showVerdict(result);$('shareBtn').hidden=false;\n    haptic('success');\n    return saveRun(result);\n  }).catch(function(e){\n    if(e&&e.message==='cancelled'){status('Test stopped.');setPhase('','');}\n    else{status(friendlyError(e));setPhase('','');haptic('error');}\n    setGauge(0,null);\n  }).then(function(){\n    running=false;abort=false;btn.textContent='Test again';btn.classList.remove('stop');\n  });\n}\n\n/* ---------- presentation ---------- */\nfunction showConn(r){\n  var rows=[];\n  if(r.ip)rows.push(['Public IP',r.ip]);\n  if(r.loc)rows.push(['Country',regionName(r.loc)]);\n  if(r.colo)rows.push(['Test server',r.colo+' (Cloudflare edge)']);\n  if(r.http)rows.push(['Protocol',r.http.toUpperCase()]);\n  if(r.tls)rows.push(['Encryption',r.tls]);\n  $('conn').innerHTML=rows.map(function(x){return '<div class=\"k\">'+x[0]+'</div><div class=\"v\">'+esc(x[1])+'</div>';}).join('');\n  $('connSec').hidden=rows.length===0;\n}\nfunction regionName(cc){try{if(window.Intl&&Intl.DisplayNames){return new Intl.DisplayNames([navigator.language||'en'],{type:'region'}).of(cc)||cc;}}catch(e){}return cc;}\nfunction esc(s){return String(s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\nfunction grade(v,good,ok,invert){ // invert: lower is better\n  if(invert)return v<=good?'good':v<=ok?'warn':'bad';\n  return v>=good?'good':v>=ok?'warn':'bad';\n}\nfunction showVerdict(r){\n  var items=[\n    ['Web browsing & email',grade(r.down,3,1),'~1 Mbps'],\n    ['Music & podcasts',grade(r.down,2,0.5),'~0.5 Mbps'],\n    ['HD video streaming',grade(r.down,8,5),'~5 Mbps per stream'],\n    ['4K video streaming',grade(r.down,35,25),'~25 Mbps per stream'],\n    ['Video calls',grade(Math.min(r.down,r.up),4,1.5),'~1.5 Mbps each way'],\n    ['Online gaming (ping)',grade(r.ping,30,80,true),'under 50 ms feels instant'],\n    ['Call quality (jitter)',grade(r.jitter,10,30,true),'under 30 ms is smooth'],\n    ['Whole household at once',grade(r.down,80,40),'40–100 Mbps for many devices']\n  ];\n  $('verdict').innerHTML=items.map(function(x){return '<div class=\"vrow\"><i class=\"dot '+x[1]+'\"></i><span>'+x[0]+'</span><em>'+esc(x[2])+'</em></div>';}).join('');\n  $('verdictSec').hidden=false;\n}\n\n/* ---------- history ---------- */\nvar runs=[];\nfunction loadRuns(){\n  return store.getItem(KEY).then(function(s){try{var d=JSON.parse(s||'{}');runs=Array.isArray(d.runs)?d.runs:[];}catch(e){runs=[];}renderHist();}).catch(function(){renderHist();});\n}\nfunction saveRun(r){\n  runs.unshift({t:r.t,down:+r.down.toFixed(2),up:+r.up.toFixed(2),ping:Math.round(r.ping),jitter:Math.round(r.jitter),colo:r.colo,loc:r.loc});\n  runs=runs.slice(0,30);renderHist();\n  return store.setItem(KEY,JSON.stringify({runs:runs})).catch(function(){});\n}\nfunction when(t){\n  var d=new Date(t),now=new Date();\n  var sameDay=d.toDateString()===now.toDateString();\n  var time=d.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});\n  return sameDay?'Today '+time:d.toLocaleDateString([],{day:'numeric',month:'short'})+' '+time;\n}\nfunction renderHist(){\n  var h=$('hist');$('clearBtn').hidden=runs.length===0;\n  if(!runs.length){h.innerHTML='<div class=\"empty\">No tests yet. Results are saved on this device.</div>';return;}\n  var max=Math.max.apply(null,runs.map(function(r){return r.down;}))||1;\n  h.innerHTML=runs.map(function(r){\n    return '<div class=\"hrow\"><div class=\"d\">'+esc(when(r.t))+'</div><div class=\"bar\"><i style=\"width:'+Math.max(3,Math.round(100*r.down/max))+'%\"></i></div>'+\n      '<b class=\"dn\">↓'+fmt(r.down)+'</b><b class=\"upv\">↑'+fmt(r.up)+'</b><b class=\"pg\">'+r.ping+'ms</b></div>';\n  }).join('');\n}\n$('clearBtn').addEventListener('click',function(){$('confirmClear').hidden=false;haptic('light');});\n$('clearNo').addEventListener('click',function(){$('confirmClear').hidden=true;});\n$('clearYes').addEventListener('click',function(){runs=[];$('confirmClear').hidden=true;renderHist();store.setItem(KEY,JSON.stringify({runs:[]})).catch(function(){});haptic('success');toast('History cleared');});\n\n/* ---------- share ---------- */\n$('shareBtn').addEventListener('click',function(){\n  if(!last)return;haptic('light');\n  var text='Speed Check — '+new Date(last.t).toLocaleString()+'\\n↓ '+fmt(last.down)+' Mbps download\\n↑ '+fmt(last.up)+' Mbps upload\\nPing '+Math.round(last.ping)+' ms · Jitter '+Math.round(last.jitter)+' ms'+(last.colo?'\\nvia Cloudflare '+last.colo:'')+'\\n\\nMeasured with MyLLM';\n  if(window.myllmShare){try{window.myllmShare({text:text});}catch(e){toast('Sharing unavailable');}}\n  else if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(text).then(function(){toast('Copied');},function(){toast('Copy failed');});}\n  else toast('Sharing unavailable');\n});\n\n$('startBtn').addEventListener('click',runTest);\ndrawGauge();\nloadRuns();\nif(!hasFetch){status('Open this app inside MyLLM to run a test — it uses the app\\'s network bridge.');}\n})();\n</script>\n</body></html>\n"}