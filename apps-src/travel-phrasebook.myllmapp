īshēng\",pharmacy:\"yàodiàn zài nǎlǐ?\",police:\"qǐng jiào jǐngchá\",toilet:\"cèsuǒ zài nǎlǐ?\",station:\"huǒchēzhàn zài nǎlǐ?\",ticket:\"qǐng gěi wǒ yì zhāng piào\",left:\"zuǒ\",right:\"yòu\",straight:\"zhí zǒu\",menu:\"qǐng gěi wǒ càidān\",water:\"qǐng gěi wǒ shuǐ\",coffee:\"qǐng gěi wǒ kāfēi\",beer:\"qǐng gěi wǒ píjiǔ\",veggie:\"wǒ chī sù\",nuts:\"wǒ duì jiānguǒ guòmǐn\",bill:\"mǎidān\",delicious:\"hǎochī!\",reservation:\"wǒ yǒu yùdìng\",room:\"yǒu kòngfáng ma?\",howmuch:\"duōshao qián?\",expensive:\"tài guì le\",takeit:\"wǒ yào zhège\",wifi:\"Wi-Fi mìmǎ shì shénme?\"},\nko:{hello:\"annyeonghaseyo\",bye:\"annyeonghi gaseyo\",yes:\"ne\",no:\"aniyo\",please:\"butakhamnida\",thanks:\"gamsahamnida\",excuse:\"sillyehamnida\",sorry:\"joesonghamnida\",english:\"yeongeo hal jul aseyo?\",dontunderstand:\"ihaega an dwaeyo\",slowly:\"cheoncheonhi malhae juseyo\",helpme:\"dowajuseyo!\",lost:\"gireul ireosseoyo\",doctor:\"uisaga piryohaeyo\",pharmacy:\"yakgugi eodiyeyo?\",police:\"gyeongchareul bulleo juseyo\",toilet:\"hwajangsiri eodiyeyo?\",station:\"gichayeogi eodiyeyo?\",ticket:\"pyo han jang juseyo\",left:\"oenjjok\",right:\"oreunjjok\",straight:\"jikjin\",menu:\"menyu juseyo\",water:\"mul juseyo\",coffee:\"keopi juseyo\",beer:\"maekju juseyo\",veggie:\"jeoneun chaesikjuuijayeyo\",nuts:\"gyeongwaryu allereugiga isseoyo\",bill:\"gyesanseo juseyo\",delicious:\"masisseoyo!\",reservation:\"yeyakhaesseoyo\",room:\"bin bang isseoyo?\",howmuch:\"eolmayeyo?\",expensive:\"neomu bissayo\",takeit:\"igeollo halgeyo\",wifi:\"waipai bimilbeonhoga mwoyeyo?\"},\nel:{hello:\"yia sas\",bye:\"andío\",yes:\"ne\",no:\"óchi\",please:\"parakaló\",thanks:\"efharistó\",excuse:\"me synchoríte\",sorry:\"signómi\",english:\"miláte angliká?\",dontunderstand:\"den katalavéno\",slowly:\"pio argá, parakaló\",helpme:\"voíthia!\",lost:\"háthika\",doctor:\"hriázome yiatró\",pharmacy:\"pou íne to farmakío?\",police:\"kaléste tin astynomía\",toilet:\"pou íne i toualéta?\",station:\"pou íne o stathmós?\",ticket:\"éna isitírio, parakaló\",left:\"aristerá\",right:\"dexiá\",straight:\"efthía\",menu:\"ton katálogo, parakaló\",water:\"neró, parakaló\",coffee:\"énan kafé, parakaló\",beer:\"mia bíra, parakaló\",veggie:\"íme hortofágos\",nuts:\"íme allergikós stous xiroús karpoús\",bill:\"ton logariazmó, parakaló\",delicious:\"polí nóstimo!\",reservation:\"ého krátisi\",room:\"éhete eléfthero domátio?\",howmuch:\"póso káni?\",expensive:\"polí akrivó\",takeit:\"tha to páro\",wifi:\"pios íne o kodikós tou Wi-Fi?\"}\n};\n\nvar lang = LANGS[0];\nvar favs = {};       /* \"es|hello\" -> true */\n\n/* ---------- voice ----------\n   Prefer a native myllmSpeak bridge if one ever ships; today the web view's\n   built-in speechSynthesis does the job (same iOS voices underneath). As in\n   Language Lab: pick the language's voice explicitly, cancel only when\n   something is actually speaking, and say so when no voice played. */\nfunction hasSynth(){ return !!(window.speechSynthesis && window.SpeechSynthesisUtterance); }\nfunction canSpeak(){ return !!(window.myllmSpeak || hasSynth()); }\nvar voiceCache = {}, speakToken = 0, speakBtns = [];\nif (hasSynth()) try{ speechSynthesis.onvoiceschanged = function(){ voiceCache = {}; }; }catch(_){}\nfunction pickVoice(code){\n  if (voiceCache[code] !== undefined) return voiceCache[code];\n  var all = []; try{ all = speechSynthesis.getVoices() || []; }catch(_){}\n  function norm(v){ return String(v.lang || \"\").replace(\"_\", \"-\").toLowerCase(); }\n  var want = code.toLowerCase(), base = want.slice(0, 2);\n  var inLang = all.filter(function(v){ return norm(v).slice(0, 2) === base; });\n  var better = function(list){ return list.filter(function(v){ return /enhanced|premium/i.test(v.name); })[0] || list[0]; };\n  var exact = inLang.filter(function(v){ return norm(v) === want; });\n  voiceCache[code] = better(exact) || better(inLang) || null;\n  return voiceCache[code];\n}\nfunction markSpeaking(btns, on){\n  speakBtns.forEach(function(b){ b.classList.remove(\"on\"); });\n  speakBtns = on ? btns : [];\n  speakBtns.forEach(function(b){ b.classList.add(\"on\"); });\n}\nfunction noVoice(){\n  var t = \"Couldn't play \" + lang.name + \" out loud. Check the volume, or add a voice in iPhone Settings → Accessibility → Spoken Content → Voices.\";\n  el(\"voiceNoteText\").textContent = t; el(\"voiceNote\").hidden = false;\n  el(\"bigNote\").textContent = t; el(\"bigNote\").hidden = el(\"bigveil\").hidden;\n}\nfunction speak(text, btns){\n  btns = (btns || []).filter(Boolean);\n  haptic(\"selection\");\n  if (window.myllmSpeak){\n    try{ myllmSpeak(text, {lang:lang.tts}); return; }catch(_){}\n  }\n  if (!hasSynth() || !text) return;\n  var ss = window.speechSynthesis, token = ++speakToken, started = false;\n  var u = new SpeechSynthesisUtterance(text);\n  u.lang = lang.tts; var v = pickVoice(lang.tts); if (v) u.voice = v;\n  u.rate = 0.9; u.volume = 1;\n  u.onstart = function(){ started = true; if (token === speakToken){ markSpeaking(btns, true); el(\"voiceNote\").hidden = true; el(\"bigNote\").hidden = true; } };\n  u.onend = function(){ if (token === speakToken) markSpeaking(btns, false); };\n  u.onerror = function(e){\n    if (token !== speakToken) return;\n    markSpeaking(btns, false);\n    var why = e && e.error;\n    if (!started && why !== \"interrupted\" && why !== \"canceled\") noVoice();\n  };\n  function go(){ try{ if (ss.paused) ss.resume(); ss.speak(u); }catch(_){ noVoice(); } }\n  try{\n    if (ss.speaking || ss.pending){ ss.cancel(); setTimeout(go, 80); }\n    else go();                                    /* first line stays inside the tap, which iOS requires */\n  }catch(_){ noVoice(); return; }\n  setTimeout(function(){\n    if (token === speakToken && !started && !ss.speaking){ markSpeaking(btns, false); noVoice(); }\n  }, 2500);\n}\nfunction stopSpeaking(){ speakToken++; markSpeaking([], false); if (hasSynth()) try{ speechSynthesis.cancel(); }catch(_){} }\n\nfunction renderLangs(){\n  el(\"langs\").innerHTML = LANGS.map(function(l){\n    return '<button type=\"button\" class=\"chip' + (l.id === lang.id ? ' hot' : '') + '\" data-lang=\"' + l.id + '\">' + l.flag + ' ' + esc(l.name) + '</button>';\n  }).join(\"\");\n}\nfunction setLang(id){\n  var l = LANGS.filter(function(x){ return x.id === id; })[0]; if (!l) return;\n  lang = l;\n  haptic(\"selection\");\n  stopSpeaking();\n  store().setItem(\"pb_lang\", id);\n  el(\"aiout\").hidden = true; el(\"voiceNote\").hidden = true;\n  renderLangs(); render();\n}\n\nfunction phraseRow(p){\n  var tr = T[lang.id][p.k] || \"\";\n  var rom = R[lang.id] ? (R[lang.id][p.k] || \"\") : \"\";\n  var fk = lang.id + \"|\" + p.k, on = !!favs[fk];\n  return '<div class=\"ph\" data-k=\"' + p.k + '\">' +\n    '<div class=\"tx\" data-act=\"big\">' +\n      '<div class=\"en\">' + esc(p.en) + '</div>' +\n      '<div class=\"tr\">' + esc(tr) + '</div>' +\n      (rom ? '<div class=\"rom\">' + esc(rom) + '</div>' : '') +\n    '</div>' +\n    (canSpeak() ? '<button type=\"button\" class=\"ib\" data-act=\"say\" aria-label=\"Hear it\">' + icon(\"speaker\") + '</button>' : '') +\n    '<button type=\"button\" class=\"ib fav' + (on ? ' on' : '') + '\" data-act=\"fav\" aria-label=\"' + (on ? 'Remove from your phrases' : 'Keep in your phrases') + '\" aria-pressed=\"' + on + '\">' + icon(on ? \"star\" : \"staro\") + '</button>' +\n  '</div>';\n}\n\nfunction render(){\n  var q = (el(\"q\").value || \"\").toLowerCase().trim();\n  var html = \"\";\n  var favList = P.filter(function(p){ return favs[lang.id + \"|\" + p.k]; });\n  if (favList.length && !q){\n    html += '<h2><svg class=\"i\" style=\"color:#ffb400\"><use href=\"#i-star\"/></svg>Your phrases</h2>' + favList.map(phraseRow).join(\"\");\n  }\n  CATS.forEach(function(c){\n    var rows = P.filter(function(p){\n      if (p.c !== c.id) return false;\n      if (!q) return true;\n      var tr = (T[lang.id][p.k] || \"\").toLowerCase();\n      return p.en.toLowerCase().indexOf(q) >= 0 || tr.indexOf(q) >= 0;\n    });\n    if (rows.length) html += '<h2>' + esc(c.name) + '</h2>' + rows.map(phraseRow).join(\"\");\n  });\n  el(\"list\").innerHTML = html || '<p class=\"empty\">No phrases match — try the translator above.</p>';\n}\n\nfunction toggleFav(fk){\n  favs[fk] = !favs[fk];\n  if (!favs[fk]) delete favs[fk];\n  store().setItem(\"pb_favs\", JSON.stringify(favs));\n  haptic(favs[fk] ? \"success\" : \"light\");\n  render();\n}\n\nel(\"langs\").addEventListener(\"click\", function(e){\n  var b = e.target.closest(\"[data-lang]\"); if (b) setLang(b.dataset.lang);\n});\nel(\"list\").addEventListener(\"click\", function(e){\n  var act = e.target.closest(\"[data-act]\"); if (!act) return;\n  var row = act.closest(\".ph\"), k = row && row.dataset.k;\n  var p = P.filter(function(x){ return x.k === k; })[0]; if (!p) return;\n  var tr = T[lang.id][p.k] || \"\", rom = R[lang.id] ? (R[lang.id][p.k] || \"\") : \"\";\n  if (act.dataset.act === \"say\") speak(tr, [act]);\n  else if (act.dataset.act === \"fav\") toggleFav(lang.id + \"|\" + p.k);\n  else openBig({tr:tr, rom:rom, en:p.en});\n});\n\n/* ---------- show a local: the stage ---------- */\nvar bigText = \"\", bigOn = false;\nfunction isLight(){ return !(window.matchMedia && matchMedia(\"(prefers-color-scheme: dark)\").matches); }\n/* A dark stage under MyLLM's white title bar looks cut in half, so without\n   myllmImmersive the stage stays light in light mode. */\nfunction syncLook(){ el(\"bigveil\").classList.toggle(\"lite\", isLight() && !window.myllmImmersive); }\nfunction syncChrome(){\n  if (!window.myllmImmersive) return;\n  try{ myllmImmersive(bigOn, {keepAwake:bigOn}).catch(function(){}); }catch(_){}   /* the screen stays on while a local reads it */\n}\nfunction openBig(o){\n  bigText = o.tr;\n  el(\"bigtr\").textContent = o.tr;\n  el(\"bigtr\").lang = lang.tts;\n  el(\"bigtr\").style.fontSize = \"\";\n  el(\"bigrom\").textContent = o.rom || \"\";\n  el(\"bigen\").textContent = o.en || \"\";\n  el(\"biglbl\").textContent = lang.name;\n  var talk = canSpeak();\n  el(\"bigspeak\").hidden = !talk; el(\"biglabel\").hidden = !talk; el(\"bigNote\").hidden = true;\n  bigOn = true; syncLook();\n  el(\"bigveil\").hidden = false;\n  fitBig();\n  document.body.style.overflow = \"hidden\";\n  syncChrome();\n  haptic(\"light\");\n}\n/* A short phrase reads best on one line: shrink it (not below 26px) until it\n   fits. A long one keeps the full size and wraps. */\nfunction fitBig(){\n  var t = el(\"bigtr\"); t.style.fontSize = \"\";\n  var max = parseFloat(getComputedStyle(t).fontSize) || 48, lh = 1.18;\n  for (var s = max; s >= 26; s -= 2){\n    t.style.fontSize = s + \"px\";\n    if (t.scrollHeight <= s * lh * 1.25) return;\n  }\n  t.style.fontSize = \"\";\n}\nwindow.addEventListener(\"resize\", function(){ if (bigOn) fitBig(); });\nfunction closeBig(){\n  if (!bigOn) return;\n  bigOn = false; stopSpeaking();\n  el(\"bigveil\").hidden = true;\n  document.body.style.overflow = \"\";\n  syncChrome();\n  haptic(\"light\");\n}\nel(\"bigspeak\").onclick = function(e){ e.stopPropagation(); speak(bigText, [el(\"bigspeak\")]); };\nel(\"bigclose\").onclick = function(e){ e.stopPropagation(); closeBig(); };\n/* as before: a tap anywhere else on the screen closes it */\nel(\"bigveil\").addEventListener(\"click\", function(e){ if (!e.target.closest(\"button\")) closeBig(); });\ndocument.addEventListener(\"keydown\", function(e){ if (e.key === \"Escape\") closeBig(); });\ndocument.addEventListener(\"visibilitychange\", function(){\n  if (document.hidden){ stopSpeaking(); return; }\n  if (bigOn) syncChrome();                        /* MyLLM puts its bars back when the app is left */\n});\nif (window.matchMedia){\n  var mq = matchMedia(\"(prefers-color-scheme: dark)\");\n  if (mq.addEventListener) mq.addEventListener(\"change\", syncLook); else if (mq.addListener) mq.addListener(syncLook);\n}\n\n/* ---------- AI translation ---------- */\n/* Labelled lines with instruction-phrased fields, never example placeholders —\n   small models (Apple Intelligence) echo format templates back verbatim, and\n   the old \"<the translation>\" placeholder rendered as real content. Echoed\n   instructions are rejected and retried once. */\nvar ECHO = /translated phrase|latin letters|polite traveller|traveller would pronounce|repeat this line|labelled line|nothing else|instruction text/i;\nfunction parseTranslation(reply, wantRom){\n  var r = String(reply || \"\").trim();\n  var tr = \"\", rom = \"\", got = false;\n  r.split(/\\r?\\n/).forEach(function(raw){\n    var ln = raw.replace(/\\*\\*/g, \"\").trim();\n    var m = ln.match(/^[-*#>\\s]*(TRANSLATIONS?|ROMAN(?:IZATION|ISATION)?S?)\\s*\\d*\\s*[:：]\\s*(.*)$/i);\n    if (!m) return;\n    got = true;\n    var k = m[1].toUpperCase(), v = m[2].trim();\n    if (k.indexOf(\"TRANSLATION\") === 0){ if (!tr) tr = v; }\n    else if (k.indexOf(\"ROMAN\") === 0){ if (!rom) rom = v; }\n  });\n  if (!got){\n    /* legacy shapes: JSON from big cloud models, or a bare translation line */\n    var s = r.indexOf(\"{\"), e = r.lastIndexOf(\"}\");\n    if (s >= 0 && e > s){\n      try{\n        var j = JSON.parse(r.slice(s, e + 1));\n        tr = String(j.translation || j.tr || \"\").trim();\n        rom = String(j.roman || j.romanization || j.romanisation || j.rom || \"\").trim();\n      }catch(e2){}\n    }\n    if (!tr) tr = r.split(\"\\n\")[0].trim();\n  }\n  tr = tr.replace(/^[\"'«]|[\"'»]$/g, \"\").trim();\n  rom = rom.replace(/^[\"'«]|[\"'»]$/g, \"\").trim();\n  if (!wantRom) rom = \"\";\n  if (!tr || ECHO.test(tr) || ECHO.test(rom))\n    throw new Error(\"the translator didn't return a real translation\");\n  return {tr: tr, rom: rom};\n}\nfunction aiBtn(on){ var b = el(\"aigo\"); b.disabled = !!on; b.innerHTML = on ? '<i class=\"spin\"></i>' : icon(\"arrow\"); }\nfunction aiTranslate(){\n  var q = el(\"aiq\").value.trim();\n  if (!q){ haptic(\"light\"); return; }\n  var ask = ASK();\n  if (!ask){\n    el(\"ainote\").textContent = \"Freeform translation needs AI — enable it in Settings. The phrases below always work.\";\n    haptic(\"light\"); return;\n  }\n  haptic(\"light\");\n  aiBtn(true);\n  el(\"ainote\").textContent = \"Translating into \" + lang.name + \"…\";\n  var wantRom = !!R[lang.id];\n  var p = \"Translate this into \" + lang.name + \" for a polite traveller: \\\"\" + q + \"\\\"\\n\" +\n      (wantRom ? \"Reply with EXACTLY these labelled lines and nothing else:\\nTRANSLATION: the translated phrase in \" + lang.name + \"\\nROMAN: how a traveller would pronounce it, written in latin letters\"\n               : \"Reply with EXACTLY this labelled line and nothing else:\\nTRANSLATION: the translated phrase in \" + lang.name);\n  var sys = {system:\"You are a precise translator. No commentary, no alternatives, no quotes.\"};\n  ask(p, sys)\n  .then(function(r){ return parseTranslation(r || \"\", wantRom); })\n  .catch(function(){\n    return ask(p + \"\\nIMPORTANT: fill each labelled line with real content — never repeat the instruction text.\", sys)\n      .then(function(r){ return parseTranslation(r || \"\", wantRom); });\n  })\n  .then(function(o){\n    el(\"aitr\").textContent = o.tr;\n    el(\"airom\").textContent = o.rom;\n    el(\"airom\").hidden = !o.rom;\n    el(\"aiout\").hidden = false;\n    el(\"ainote\").textContent = \"\";\n    aiBtn(false);\n    haptic(\"success\");\n  })\n  .catch(function(){\n    el(\"ainote\").textContent = \"Translation didn't run — try again.\";\n    aiBtn(false);\n  });\n}\nel(\"aigo\").onclick = aiTranslate;\nel(\"aiq\").addEventListener(\"keydown\", function(e){ if (e.key === \"Enter\") aiTranslate(); });\nel(\"aiout\").onclick = function(){ openBig({tr:el(\"aitr\").textContent, rom:el(\"airom\").textContent, en:el(\"aiq\").value}); };\nel(\"q\").addEventListener(\"input\", render);\n\n/* ---------- boot ---------- */\naiBtn(false);\nPromise.all([store().getItem(\"pb_lang\"), store().getItem(\"pb_favs\")]).then(function(v){\n  if (v[0]){ var l = LANGS.filter(function(x){ return x.id === v[0]; })[0]; if (l) lang = l; }\n  if (v[1]){ try{ favs = JSON.parse(v[1]) || {}; }catch(e){} }\n  if (!ASK()) el(\"ainote\").textContent = \"Tip: enable AI in Settings and this box translates anything — even with no signal.\";\n  renderLangs(); render();\n});\n</script>\n</body>\n</html>\n"}