{"name": "Travel Phrasebook", "kind": "html", "iconSymbol": "globe.europe.africa.fill", "iconColor": "teal", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Travel Phrasebook</title>\n<style>\n  :root { color-scheme: light dark; }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111);\n    max-width:640px; margin:0 auto; min-height:100dvh;\n    padding:14px 14px calc(30px + env(safe-area-inset-bottom));\n  }\n  h1{ font-size:22px; font-weight:800; margin:4px 2px 10px; }\n  .langs{ display:flex; gap:7px; overflow-x:auto; padding-bottom:10px; scrollbar-width:none; -webkit-overflow-scrolling:touch; }\n  .langs::-webkit-scrollbar{ display:none; }\n  .lang{\n    flex:none; border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-surface,#fff);\n    color:var(--myllm-text,#111); border-radius:999px; padding:8px 14px; font-size:14px; font-weight:650;\n  }\n  .lang.on{ background:var(--myllm-accent,#0a84ff); border-color:transparent; color:#fff; }\n\n  .card{\n    background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8);\n    border-radius:16px; padding:13px 14px; margin-bottom:12px;\n  }\n  label{ display:block; font-size:11.5px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:var(--myllm-muted,#8a8a8e); margin-bottom:7px; }\n  .airow{ display:flex; gap:8px; }\n  .airow input{\n    flex:1; font-size:15px; padding:11px 12px; border-radius:12px;\n    border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111);\n  }\n  .airow button{\n    border:none; border-radius:12px; padding:0 16px; font-size:15px; font-weight:700;\n    background:var(--myllm-accent,#0a84ff); color:#fff;\n  }\n  .airow button:disabled{ opacity:.5; }\n  .aiout{ margin-top:10px; display:none; }\n  .aiout .big{ font-size:21px; font-weight:750; line-height:1.35; }\n  .aiout .rom{ font-size:13.5px; color:var(--myllm-muted,#8a8a8e); margin-top:3px; }\n  .ainote{ font-size:12px; color:var(--myllm-muted,#8a8a8e); margin-top:8px; line-height:1.45; }\n\n  input#q{\n    width:100%; font-size:15px; padding:11px 12px; border-radius:12px; margin-bottom:12px;\n    border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-surface,#fff); color:var(--myllm-text,#111);\n  }\n  .cat{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--myllm-muted,#8a8a8e); margin:16px 2px 8px; }\n  .ph{\n    display:flex; align-items:center; gap:10px;\n    background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8);\n    border-radius:14px; padding:11px 12px; margin-bottom:8px;\n  }\n  .ph .tx{ flex:1; min-width:0; }\n  .ph .en{ font-size:12.5px; color:var(--myllm-muted,#8a8a8e); }\n  .ph .tr{ font-size:17px; font-weight:750; line-height:1.3; margin-top:1px; }\n  .ph .rom{ font-size:12.5px; color:var(--myllm-muted,#8a8a8e); margin-top:1px; }\n  .ph button{\n    flex:none; border:none; background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111);\n    width:38px; height:38px; border-radius:50%; font-size:16px;\n  }\n  .ph button.fav.on{ background:#ffd60a22; }\n  .empty{ text-align:center; color:var(--myllm-muted,#8a8a8e); font-size:13.5px; padding:20px; }\n\n  /* full-screen \"show a local\" */\n  #bigveil{\n    position:fixed; inset:0; z-index:300; display:none;\n    background:var(--myllm-surface,#fff);\n    flex-direction:column; align-items:center; justify-content:center; gap:14px;\n    padding:30px; text-align:center;\n  }\n  #bigveil.on{ display:flex; }\n  #bigtr{ font-size:min(11vw, 54px); font-weight:800; line-height:1.25; }\n  #bigrom{ font-size:18px; color:var(--myllm-muted,#8a8a8e); }\n  #bigen{ font-size:15px; color:var(--myllm-muted,#8a8a8e); }\n  #bigveil .close{ position:absolute; top:calc(14px + env(safe-area-inset-top)); right:16px; border:none; background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111); width:40px; height:40px; border-radius:50%; font-size:17px; }\n  #bigveil .speakbig{ border:none; border-radius:999px; padding:13px 26px; font-size:16px; font-weight:700; background:var(--myllm-accent,#0a84ff); color:#fff; }\n</style>\n</head>\n<body>\n\n<h1>🗺️ Travel Phrasebook</h1>\n<div class=\"langs\" id=\"langs\"></div>\n\n<div class=\"card\" id=\"aicard\">\n  <label>Say anything — translated on this phone, even offline</label>\n  <div class=\"airow\">\n    <input id=\"aiq\" placeholder=\"e.g. Is this train going to the airport?\" onkeydown=\"if(event.key==='Enter')aiTranslate()\">\n    <button id=\"aigo\" onclick=\"aiTranslate()\">→</button>\n  </div>\n  <div class=\"aiout\" id=\"aiout\">\n    <div class=\"big\" id=\"aitr\" onclick=\"openBig({tr:this.textContent,rom:el('airom').textContent,en:el('aiq').value})\"></div>\n    <div class=\"rom\" id=\"airom\"></div>\n  </div>\n  <p class=\"ainote\" id=\"ainote\"></p>\n</div>\n\n<input id=\"q\" placeholder=\"Search phrases…\" oninput=\"render()\">\n<div id=\"list\"></div>\n\n<div id=\"bigveil\" onclick=\"closeBig(event)\">\n  <button class=\"close\" onclick=\"closeBig()\">✕</button>\n  <div id=\"bigtr\"></div>\n  <div id=\"bigrom\"></div>\n  <div id=\"bigen\"></div>\n  <button class=\"speakbig\" id=\"bigspeak\" onclick=\"event.stopPropagation()\">🔊 Say it</button>\n</div>\n\n<!-- AI thinking pill (house convention) -->\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\">⚙️</span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n\n<script>\nvar store = window.myllmStorage || {getItem:function(){return Promise.resolve(null)}, setItem:function(){return Promise.resolve()}};\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nvar ASK = window.myllmAsk || null;\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\"); }\n\nvar LANGS = [\n  {id:\"es\", name:\"Spanish\",    flag:\"🇪🇸\", tts:\"es-ES\"},\n  {id:\"fr\", name:\"French\",     flag:\"🇫🇷\", tts:\"fr-FR\"},\n  {id:\"de\", name:\"German\",     flag:\"🇩🇪\", tts:\"de-DE\"},\n  {id:\"it\", name:\"Italian\",    flag:\"🇮🇹\", tts:\"it-IT\"},\n  {id:\"pt\", name:\"Portuguese\", flag:\"🇵🇹\", tts:\"pt-PT\"},\n  {id:\"ja\", name:\"Japanese\",   flag:\"🇯🇵\", tts:\"ja-JP\"},\n  {id:\"zh\", name:\"Mandarin\",   flag:\"🇨🇳\", tts:\"zh-CN\"},\n  {id:\"ko\", name:\"Korean\",     flag:\"🇰🇷\", tts:\"ko-KR\"},\n  {id:\"tr\", name:\"Turkish\",    flag:\"🇹🇷\", tts:\"tr-TR\"},\n  {id:\"el\", name:\"Greek\",      flag:\"🇬🇷\", tts:\"el-GR\"}\n];\nvar CATS = [\n  {id:\"basics\", name:\"Basics\"},\n  {id:\"talk\",   name:\"Being understood\"},\n  {id:\"help\",   name:\"Help & emergencies\"},\n  {id:\"move\",   name:\"Getting around\"},\n  {id:\"food\",   name:\"Eating & drinking\"},\n  {id:\"stay\",   name:\"Somewhere to sleep\"},\n  {id:\"shop\",   name:\"Shopping & Wi-Fi\"}\n];\nvar P = [\n  {k:\"hello\",c:\"basics\",en:\"Hello\"},\n  {k:\"bye\",c:\"basics\",en:\"Goodbye\"},\n  {k:\"yes\",c:\"basics\",en:\"Yes\"},\n  {k:\"no\",c:\"basics\",en:\"No\"},\n  {k:\"please\",c:\"basics\",en:\"Please\"},\n  {k:\"thanks\",c:\"basics\",en:\"Thank you\"},\n  {k:\"excuse\",c:\"basics\",en:\"Excuse me\"},\n  {k:\"sorry\",c:\"basics\",en:\"Sorry\"},\n  {k:\"english\",c:\"talk\",en:\"Do you speak English?\"},\n  {k:\"dontunderstand\",c:\"talk\",en:\"I don't understand\"},\n  {k:\"slowly\",c:\"talk\",en:\"Please speak more slowly\"},\n  {k:\"helpme\",c:\"help\",en:\"Help!\"},\n  {k:\"lost\",c:\"help\",en:\"I'm lost\"},\n  {k:\"doctor\",c:\"help\",en:\"I need a doctor\"},\n  {k:\"pharmacy\",c:\"help\",en:\"Where is the pharmacy?\"},\n  {k:\"police\",c:\"help\",en:\"Call the police\"},\n  {k:\"toilet\",c:\"move\",en:\"Where is the toilet?\"},\n  {k:\"station\",c:\"move\",en:\"Where is the train station?\"},\n  {k:\"ticket\",c:\"move\",en:\"One ticket, please\"},\n  {k:\"left\",c:\"move\",en:\"Left\"},\n  {k:\"right\",c:\"move\",en:\"Right\"},\n  {k:\"straight\",c:\"move\",en:\"Straight ahead\"},\n  {k:\"menu\",c:\"food\",en:\"The menu, please\"},\n  {k:\"water\",c:\"food\",en:\"Water, please\"},\n  {k:\"coffee\",c:\"food\",en:\"A coffee, please\"},\n  {k:\"beer\",c:\"food\",en:\"A beer, please\"},\n  {k:\"veggie\",c:\"food\",en:\"I'm vegetarian\"},\n  {k:\"nuts\",c:\"food\",en:\"I have a nut allergy\"},\n  {k:\"bill\",c:\"food\",en:\"The bill, please\"},\n  {k:\"delicious\",c:\"food\",en:\"Delicious!\"},\n  {k:\"reservation\",c:\"stay\",en:\"I have a reservation\"},\n  {k:\"room\",c:\"stay\",en:\"Do you have a free room?\"},\n  {k:\"howmuch\",c:\"shop\",en:\"How much does it cost?\"},\n  {k:\"expensive\",c:\"shop\",en:\"Too expensive!\"},\n  {k:\"takeit\",c:\"shop\",en:\"I'll take it\"},\n  {k:\"wifi\",c:\"shop\",en:\"What's the Wi-Fi password?\"}\n];\nvar T = {\nes:{hello:\"Hola\",bye:\"Adiós\",yes:\"Sí\",no:\"No\",please:\"Por favor\",thanks:\"Gracias\",excuse:\"Perdone\",sorry:\"Lo siento\",english:\"¿Habla inglés?\",dontunderstand:\"No entiendo\",slowly:\"¿Puede hablar más despacio?\",helpme:\"¡Ayuda!\",lost:\"Estoy perdido\",doctor:\"Necesito un médico\",pharmacy:\"¿Dónde está la farmacia?\",police:\"Llame a la policía\",toilet:\"¿Dónde está el baño?\",station:\"¿Dónde está la estación de tren?\",ticket:\"Un billete, por favor\",left:\"Izquierda\",right:\"Derecha\",straight:\"Todo recto\",menu:\"El menú, por favor\",water:\"Agua, por favor\",coffee:\"Un café, por favor\",beer:\"Una cerveza, por favor\",veggie:\"Soy vegetariano\",nuts:\"Soy alérgico a los frutos secos\",bill:\"La cuenta, por favor\",delicious:\"¡Delicioso!\",reservation:\"Tengo una reserva\",room:\"¿Tiene una habitación libre?\",howmuch:\"¿Cuánto cuesta?\",expensive:\"Demasiado caro\",takeit:\"Me lo llevo\",wifi:\"¿Cuál es la contraseña del wifi?\"},\nfr:{hello:\"Bonjour\",bye:\"Au revoir\",yes:\"Oui\",no:\"Non\",please:\"S'il vous plaît\",thanks:\"Merci\",excuse:\"Excusez-moi\",sorry:\"Désolé\",english:\"Parlez-vous anglais ?\",dontunderstand:\"Je ne comprends pas\",slowly:\"Pouvez-vous parler plus lentement ?\",helpme:\"Au secours !\",lost:\"Je suis perdu\",doctor:\"J'ai besoin d'un médecin\",pharmacy:\"Où est la pharmacie ?\",police:\"Appelez la police\",toilet:\"Où sont les toilettes ?\",station:\"Où est la gare ?\",ticket:\"Un billet, s'il vous plaît\",left:\"À gauche\",right:\"À droite\",straight:\"Tout droit\",menu:\"Le menu, s'il vous plaît\",water:\"De l'eau, s'il vous plaît\",coffee:\"Un café, s'il vous plaît\",beer:\"Une bière, s'il vous plaît\",veggie:\"Je suis végétarien\",nuts:\"Je suis allergique aux fruits à coque\",bill:\"L'addition, s'il vous plaît\",delicious:\"Délicieux !\",reservation:\"J'ai une réservation\",room:\"Avez-vous une chambre libre ?\",howmuch:\"Combien ça coûte ?\",expensive:\"Trop cher\",takeit:\"Je le prends\",wifi:\"Quel est le mot de passe du wifi ?\"},\nde:{hello:\"Hallo\",bye:\"Auf Wiedersehen\",yes:\"Ja\",no:\"Nein\",please:\"Bitte\",thanks:\"Danke\",excuse:\"Entschuldigung\",sorry:\"Es tut mir leid\",english:\"Sprechen Sie Englisch?\",dontunderstand:\"Ich verstehe nicht\",slowly:\"Können Sie langsamer sprechen?\",helpme:\"Hilfe!\",lost:\"Ich habe mich verlaufen\",doctor:\"Ich brauche einen Arzt\",pharmacy:\"Wo ist die Apotheke?\",police:\"Rufen Sie die Polizei\",toilet:\"Wo ist die Toilette?\",station:\"Wo ist der Bahnhof?\",ticket:\"Eine Fahrkarte, bitte\",left:\"Links\",right:\"Rechts\",straight:\"Geradeaus\",menu:\"Die Speisekarte, bitte\",water:\"Wasser, bitte\",coffee:\"Einen Kaffee, bitte\",beer:\"Ein Bier, bitte\",veggie:\"Ich bin Vegetarier\",nuts:\"Ich habe eine Nussallergie\",bill:\"Die Rechnung, bitte\",delicious:\"Lecker!\",reservation:\"Ich habe eine Reservierung\",room:\"Haben Sie ein Zimmer frei?\",howmuch:\"Wie viel kostet das?\",expensive:\"Zu teuer\",takeit:\"Ich nehme es\",wifi:\"Wie lautet das WLAN-Passwort?\"},\nit:{hello:\"Ciao\",bye:\"Arrivederci\",yes:\"Sì\",no:\"No\",please:\"Per favore\",thanks:\"Grazie\",excuse:\"Mi scusi\",sorry:\"Mi dispiace\",english:\"Parla inglese?\",dontunderstand:\"Non capisco\",slowly:\"Può parlare più lentamente?\",helpme:\"Aiuto!\",lost:\"Mi sono perso\",doctor:\"Ho bisogno di un medico\",pharmacy:\"Dov'è la farmacia?\",police:\"Chiami la polizia\",toilet:\"Dov'è il bagno?\",station:\"Dov'è la stazione?\",ticket:\"Un biglietto, per favore\",left:\"Sinistra\",right:\"Destra\",straight:\"Sempre dritto\",menu:\"Il menù, per favore\",water:\"Acqua, per favore\",coffee:\"Un caffè, per favore\",beer:\"Una birra, per favore\",veggie:\"Sono vegetariano\",nuts:\"Sono allergico alla frutta a guscio\",bill:\"Il conto, per favore\",delicious:\"Delizioso!\",reservation:\"Ho una prenotazione\",room:\"Avete una camera libera?\",howmuch:\"Quanto costa?\",expensive:\"Troppo caro\",takeit:\"Lo prendo\",wifi:\"Qual è la password del wifi?\"},\npt:{hello:\"Olá\",bye:\"Adeus\",yes:\"Sim\",no:\"Não\",please:\"Por favor\",thanks:\"Obrigado\",excuse:\"Com licença\",sorry:\"Desculpe\",english:\"Fala inglês?\",dontunderstand:\"Não entendo\",slowly:\"Pode falar mais devagar?\",helpme:\"Socorro!\",lost:\"Estou perdido\",doctor:\"Preciso de um médico\",pharmacy:\"Onde é a farmácia?\",police:\"Chame a polícia\",toilet:\"Onde é a casa de banho?\",station:\"Onde é a estação de comboios?\",ticket:\"Um bilhete, por favor\",left:\"Esquerda\",right:\"Direita\",straight:\"Em frente\",menu:\"O menu, por favor\",water:\"Água, por favor\",coffee:\"Um café, por favor\",beer:\"Uma cerveja, por favor\",veggie:\"Sou vegetariano\",nuts:\"Sou alérgico a frutos secos\",bill:\"A conta, por favor\",delicious:\"Delicioso!\",reservation:\"Tenho uma reserva\",room:\"Tem um quarto livre?\",howmuch:\"Quanto custa?\",expensive:\"Muito caro\",takeit:\"Vou levar\",wifi:\"Qual é a senha do wi-fi?\"},\nja:{hello:\"こんにちは\",bye:\"さようなら\",yes:\"はい\",no:\"いいえ\",please:\"お願いします\",thanks:\"ありがとうございます\",excuse:\"すみません\",sorry:\"ごめんなさい\",english:\"英語を話せますか？\",dontunderstand:\"わかりません\",slowly:\"もっとゆっくり話してください\",helpme:\"助けて！\",lost:\"道に迷いました\",doctor:\"医者が必要です\",pharmacy:\"薬局はどこですか？\",police:\"警察を呼んでください\",toilet:\"トイレはどこですか？\",station:\"駅はどこですか？\",ticket:\"切符を一枚ください\",left:\"左\",right:\"右\",straight:\"まっすぐ\",menu:\"メニューをください\",water:\"水をください\",coffee:\"コーヒーをください\",beer:\"ビールをください\",veggie:\"私はベジタリアンです\",nuts:\"ナッツアレルギーがあります\",bill:\"お会計をお願いします\",delicious:\"おいしい！\",reservation:\"予約しています\",room:\"空室はありますか？\",howmuch:\"いくらですか？\",expensive:\"高すぎます\",takeit:\"これをください\",wifi:\"Wi-Fiのパスワードは何ですか？\"},\nzh:{hello:\"你好\",bye:\"再见\",yes:\"是\",no:\"不是\",please:\"请\",thanks:\"谢谢\",excuse:\"不好意思\",sorry:\"对不起\",english:\"你会说英语吗？\",dontunderstand:\"我不明白\",slowly:\"请说慢一点\",helpme:\"救命！\",lost:\"我迷路了\",doctor:\"我需要医生\",pharmacy:\"药店在哪里？\",police:\"请叫警察\",toilet:\"厕所在哪里？\",station:\"火车站在哪里？\",ticket:\"请给我一张票\",left:\"左\",right:\"右\",straight:\"直走\",menu:\"请给我菜单\",water:\"请给我水\",coffee:\"请给我咖啡\",beer:\"请给我啤酒\",veggie:\"我吃素\",nuts:\"我对坚果过敏\",bill:\"买单\",delicious:\"好吃！\",reservation:\"我有预订\",room:\"有空房吗？\",howmuch:\"多少钱？\",expensive:\"太贵了\",takeit:\"我要这个\",wifi:\"Wi-Fi密码是什么？\"},\nko:{hello:\"안녕하세요\",bye:\"안녕히 가세요\",yes:\"네\",no:\"아니요\",please:\"부탁합니다\",thanks:\"감사합니다\",excuse:\"실례합니다\",sorry:\"죄송합니다\",english:\"영어 할 줄 아세요?\",dontunderstand:\"이해가 안 돼요\",slowly:\"천천히 말해 주세요\",helpme:\"도와주세요!\",lost:\"길을 잃었어요\",doctor:\"의사가 필요해요\",pharmacy:\"약국이 어디예요?\",police:\"경찰을 불러 주세요\",toilet:\"화장실이 어디예요?\",station:\"기차역이 어디예요?\",ticket:\"표 한 장 주세요\",left:\"왼쪽\",right:\"오른쪽\",straight:\"직진\",menu:\"메뉴 주세요\",water:\"물 주세요\",coffee:\"커피 주세요\",beer:\"맥주 주세요\",veggie:\"저는 채식주의자예요\",nuts:\"견과류 알레르기가 있어요\",bill:\"계산서 주세요\",delicious:\"맛있어요!\",reservation:\"예약했어요\",room:\"빈 방 있어요?\",howmuch:\"얼마예요?\",expensive:\"너무 비싸요\",takeit:\"이걸로 할게요\",wifi:\"와이파이 비밀번호가 뭐예요?\"},\ntr:{hello:\"Merhaba\",bye:\"Hoşça kalın\",yes:\"Evet\",no:\"Hayır\",please:\"Lütfen\",thanks:\"Teşekkür ederim\",excuse:\"Affedersiniz\",sorry:\"Özür dilerim\",english:\"İngilizce biliyor musunuz?\",dontunderstand:\"Anlamıyorum\",slowly:\"Daha yavaş konuşur musunuz?\",helpme:\"İmdat!\",lost:\"Kayboldum\",doctor:\"Doktora ihtiyacım var\",pharmacy:\"Eczane nerede?\",police:\"Polisi arayın\",toilet:\"Tuvalet nerede?\",station:\"Tren istasyonu nerede?\",ticket:\"Bir bilet, lütfen\",left:\"Sol\",right:\"Sağ\",straight:\"Düz gidin\",menu:\"Menü, lütfen\",water:\"Su, lütfen\",coffee:\"Bir kahve, lütfen\",beer:\"Bir bira, lütfen\",veggie:\"Vejetaryenim\",nuts:\"Fındık alerjim var\",bill:\"Hesap, lütfen\",delicious:\"Çok lezzetli!\",reservation:\"Rezervasyonum var\",room:\"Boş odanız var mı?\",howmuch:\"Ne kadar?\",expensive:\"Çok pahalı\",takeit:\"Alıyorum\",wifi:\"Wi-Fi şifresi nedir?\"},\nel:{hello:\"Γεια σας\",bye:\"Αντίο\",yes:\"Ναι\",no:\"Όχι\",please:\"Παρακαλώ\",thanks:\"Ευχαριστώ\",excuse:\"Με συγχωρείτε\",sorry:\"Συγγνώμη\",english:\"Μιλάτε αγγλικά;\",dontunderstand:\"Δεν καταλαβαίνω\",slowly:\"Πιο αργά, παρακαλώ\",helpme:\"Βοήθεια!\",lost:\"Χάθηκα\",doctor:\"Χρειάζομαι γιατρό\",pharmacy:\"Πού είναι το φαρμακείο;\",police:\"Καλέστε την αστυνομία\",toilet:\"Πού είναι η τουαλέτα;\",station:\"Πού είναι ο σταθμός;\",ticket:\"Ένα εισιτήριο, παρακαλώ\",left:\"Αριστερά\",right:\"Δεξιά\",straight:\"Ευθεία\",menu:\"Τον κατάλογο, παρακαλώ\",water:\"Νερό, παρακαλώ\",coffee:\"Έναν καφέ, παρακαλώ\",beer:\"Μια μπύρα, παρακαλώ\",veggie:\"Είμαι χορτοφάγος\",nuts:\"Είμαι αλλεργικός στους ξηρούς καρπούς\",bill:\"Τον λογαριασμό, παρακαλώ\",delicious:\"Πολύ νόστιμο!\",reservation:\"Έχω κράτηση\",room:\"Έχετε ελεύθερο δωμάτιο;\",howmuch:\"Πόσο κάνει;\",expensive:\"Πολύ ακριβό\",takeit:\"Θα το πάρω\",wifi:\"Ποιος είναι ο κωδικός του Wi-Fi;\"}\n};\nvar R = {\nja:{hello:\"konnichiwa\",bye:\"sayōnara\",yes:\"hai\",no:\"iie\",please:\"onegai shimasu\",thanks:\"arigatō gozaimasu\",excuse:\"sumimasen\",sorry:\"gomen nasai\",english:\"eigo o hanasemasu ka?\",dontunderstand:\"wakarimasen\",slowly:\"motto yukkuri hanashite kudasai\",helpme:\"tasukete!\",lost:\"michi ni mayoimashita\",doctor:\"isha ga hitsuyō desu\",pharmacy:\"yakkyoku wa doko desu ka?\",police:\"keisatsu o yonde kudasai\",toilet:\"toire wa doko desu ka?\",station:\"eki wa doko desu ka?\",ticket:\"kippu o ichimai kudasai\",left:\"hidari\",right:\"migi\",straight:\"massugu\",menu:\"menyū o kudasai\",water:\"mizu o kudasai\",coffee:\"kōhī o kudasai\",beer:\"bīru o kudasai\",veggie:\"watashi wa bejitarian desu\",nuts:\"nattsu arerugī ga arimasu\",bill:\"okaikei o onegai shimasu\",delicious:\"oishii!\",reservation:\"yoyaku shite imasu\",room:\"kūshitsu wa arimasu ka?\",howmuch:\"ikura desu ka?\",expensive:\"takasugimasu\",takeit:\"kore o kudasai\",wifi:\"waifai no pasuwādo wa nan desu ka?\"},\nzh:{hello:\"nǐ hǎo\",bye:\"zàijiàn\",yes:\"shì\",no:\"bú shì\",please:\"qǐng\",thanks:\"xièxie\",excuse:\"bù hǎoyìsi\",sorry:\"duìbuqǐ\",english:\"nǐ huì shuō yīngyǔ ma?\",dontunderstand:\"wǒ bù míngbai\",slowly:\"qǐng shuō màn yìdiǎn\",helpme:\"jiùmìng!\",lost:\"wǒ mílù le\",doctor:\"wǒ xūyào yīshēng\",pharmacy:\"yàodiàn zài nǎlǐ?\",police:\"qǐng jiào jǐngchá\",toilet:\"cèsuǒ zài nǎlǐ?\",station:\"huǒchēzhàn zài nǎlǐ?\",ticket:\"qǐng gěi wǒ yì zhāng piào\",left:\"zuǒ\",right:\"yòu\",straight:\"zhí zǒu\",menu:\"qǐng gěi wǒ càidān\",water:\"qǐng gěi wǒ shuǐ\",coffee:\"qǐng gěi wǒ kāfēi\",beer:\"qǐng gěi wǒ píjiǔ\",veggie:\"wǒ chī sù\",nuts:\"wǒ duì jiānguǒ guòmǐn\",bill:\"mǎidān\",delicious:\"hǎochī!\",reservation:\"wǒ yǒu yùdìng\",room:\"yǒu kòngfáng ma?\",howmuch:\"duōshao qián?\",expensive:\"tài guì le\",takeit:\"wǒ yào zhège\",wifi:\"Wi-Fi mìmǎ shì shénme?\"},\nko:{hello:\"annyeonghaseyo\",bye:\"annyeonghi gaseyo\",yes:\"ne\",no:\"aniyo\",please:\"butakhamnida\",thanks:\"gamsahamnida\",excuse:\"sillyehamnida\",sorry:\"joesonghamnida\",english:\"yeongeo hal jul aseyo?\",dontunderstand:\"ihaega an dwaeyo\",slowly:\"cheoncheonhi malhae juseyo\",helpme:\"dowajuseyo!\",lost:\"gireul ireosseoyo\",doctor:\"uisaga piryohaeyo\",pharmacy:\"yakgugi eodiyeyo?\",police:\"gyeongchareul bulleo juseyo\",toilet:\"hwajangsiri eodiyeyo?\",station:\"gichayeogi eodiyeyo?\",ticket:\"pyo han jang juseyo\",left:\"oenjjok\",right:\"oreunjjok\",straight:\"jikjin\",menu:\"menyu juseyo\",water:\"mul juseyo\",coffee:\"keopi juseyo\",beer:\"maekju juseyo\",veggie:\"jeoneun chaesikjuuijayeyo\",nuts:\"gyeongwaryu allereugiga isseoyo\",bill:\"gyesanseo juseyo\",delicious:\"masisseoyo!\",reservation:\"yeyakhaesseoyo\",room:\"bin bang isseoyo?\",howmuch:\"eolmayeyo?\",expensive:\"neomu bissayo\",takeit:\"igeollo halgeyo\",wifi:\"waipai bimilbeonhoga mwoyeyo?\"},\nel:{hello:\"yia sas\",bye:\"andío\",yes:\"ne\",no:\"óchi\",please:\"parakaló\",thanks:\"efharistó\",excuse:\"me synchoríte\",sorry:\"signómi\",english:\"miláte angliká?\",dontunderstand:\"den katalavéno\",slowly:\"pio argá, parakaló\",helpme:\"voíthia!\",lost:\"háthika\",doctor:\"hriázome yiatró\",pharmacy:\"pou íne to farmakío?\",police:\"kaléste tin astynomía\",toilet:\"pou íne i toualéta?\",station:\"pou íne o stathmós?\",ticket:\"éna isitírio, parakaló\",left:\"aristerá\",right:\"dexiá\",straight:\"efthía\",menu:\"ton katálogo, parakaló\",water:\"neró, parakaló\",coffee:\"énan kafé, parakaló\",beer:\"mia bíra, parakaló\",veggie:\"íme hortofágos\",nuts:\"íme allergikós stous xiroús karpoús\",bill:\"ton logariazmó, parakaló\",delicious:\"polí nóstimo!\",reservation:\"ého krátisi\",room:\"éhete eléfthero domátio?\",howmuch:\"póso káni?\",expensive:\"polí akrivó\",takeit:\"tha to páro\",wifi:\"pios íne o kodikós tou Wi-Fi?\"}\n};\n\nvar lang = LANGS[0];\nvar favs = {};       /* \"es|hello\" -> true */\n\n/* Voice: prefer a native myllmSpeak bridge if one ever ships; today WKWebView's\n   built-in speechSynthesis does the job (same iOS voices underneath). Triggered\n   from a tap, which satisfies the user-gesture requirement. */\nvar CAN_SPEAK = !!(window.myllmSpeak || (window.speechSynthesis && window.SpeechSynthesisUtterance));\nfunction speak(text){\n  haptic(\"selection\");\n  if (window.myllmSpeak){\n    try{ myllmSpeak(text, {lang:lang.tts}); return; }catch(_){}\n  }\n  if (window.speechSynthesis){\n    try{\n      speechSynthesis.cancel();\n      var u = new SpeechSynthesisUtterance(text);\n      u.lang = lang.tts;\n      u.rate = 0.9;\n      speechSynthesis.speak(u);\n    }catch(_){}\n  }\n}\n\nfunction renderLangs(){\n  el(\"langs\").innerHTML = LANGS.map(function(l){\n    return '<button class=\"lang' + (l.id === lang.id ? ' on' : '') + '\" onclick=\"setLang(\\'' + l.id + '\\')\">' + l.flag + ' ' + l.name + '</button>';\n  }).join(\"\");\n}\nfunction setLang(id){\n  lang = LANGS.filter(function(l){ return l.id === id; })[0];\n  haptic(\"selection\");\n  store.setItem(\"pb_lang\", id);\n  el(\"aiout\").style.display = \"none\";\n  renderLangs(); render();\n}\n\nfunction phraseRow(p){\n  var tr = T[lang.id][p.k] || \"\";\n  var rom = R[lang.id] ? (R[lang.id][p.k] || \"\") : \"\";\n  var fk = lang.id + \"|\" + p.k;\n  return '<div class=\"ph\">' +\n    '<div class=\"tx\" onclick=\\'openBig({tr:\"' + esc(tr).replace(/'/g,\"\\\\'\") + '\",rom:\"' + esc(rom) + '\",en:\"' + esc(p.en) + '\"})\\'>' +\n      '<div class=\"en\">' + esc(p.en) + '</div>' +\n      '<div class=\"tr\">' + esc(tr) + '</div>' +\n      (rom ? '<div class=\"rom\">' + esc(rom) + '</div>' : '') +\n    '</div>' +\n    (CAN_SPEAK ? '<button onclick=\"speak(' + JSON.stringify(tr).replace(/\"/g,\"&quot;\") + ')\">🔊</button>' : '') +\n    '<button class=\"fav' + (favs[fk] ? ' on' : '') + '\" onclick=\"toggleFav(\\'' + fk + '\\')\">' + (favs[fk] ? '⭐' : '☆') + '</button>' +\n  '</div>';\n}\n\nfunction render(){\n  var q = (el(\"q\").value || \"\").toLowerCase().trim();\n  var html = \"\";\n  var favList = P.filter(function(p){ return favs[lang.id + \"|\" + p.k]; });\n  if (favList.length && !q){\n    html += '<div class=\"cat\">⭐ Your phrases</div>' + favList.map(phraseRow).join(\"\");\n  }\n  CATS.forEach(function(c){\n    var rows = P.filter(function(p){\n      if (p.c !== c.id) return false;\n      if (!q) return true;\n      var tr = (T[lang.id][p.k] || \"\").toLowerCase();\n      return p.en.toLowerCase().indexOf(q) >= 0 || tr.indexOf(q) >= 0;\n    });\n    if (rows.length) html += '<div class=\"cat\">' + c.name + '</div>' + rows.map(phraseRow).join(\"\");\n  });\n  el(\"list\").innerHTML = html || '<p class=\"empty\">No phrases match — try the translator above.</p>';\n}\n\nfunction toggleFav(fk){\n  favs[fk] = !favs[fk];\n  if (!favs[fk]) delete favs[fk];\n  store.setItem(\"pb_favs\", JSON.stringify(favs));\n  haptic(favs[fk] ? \"success\" : \"light\");\n  render();\n}\n\n/* ---------- big screen ---------- */\nvar bigText = \"\";\nfunction openBig(o){\n  bigText = o.tr;\n  el(\"bigtr\").textContent = o.tr;\n  el(\"bigrom\").textContent = o.rom || \"\";\n  el(\"bigen\").textContent = o.en || \"\";\n  el(\"bigspeak\").style.display = CAN_SPEAK ? \"inline-block\" : \"none\";\n  el(\"bigspeak\").onclick = function(e){ e.stopPropagation(); speak(bigText); };\n  el(\"bigveil\").classList.add(\"on\");\n  haptic(\"light\");\n}\nfunction closeBig(e){\n  if (e && e.target && e.target.id === \"bigspeak\") return;\n  el(\"bigveil\").classList.remove(\"on\");\n}\n\n/* ---------- AI translation ---------- */\n/* Labelled lines with instruction-phrased fields, never example placeholders —\n   small models (Apple Intelligence) echo format templates back verbatim, and\n   the old \"<the translation>\" placeholder rendered as real content. Echoed\n   instructions are rejected and retried once. */\nvar ECHO = /translated phrase|latin letters|polite traveller|traveller would pronounce|repeat this line|labelled line|nothing else|instruction text/i;\nfunction parseTranslation(reply, wantRom){\n  var r = String(reply || \"\").trim();\n  var tr = \"\", rom = \"\", got = false;\n  r.split(/\\r?\\n/).forEach(function(raw){\n    var ln = raw.replace(/\\*\\*/g, \"\").trim();\n    var m = ln.match(/^[-*#>\\s]*(TRANSLATIONS?|ROMAN(?:IZATION|ISATION)?S?)\\s*\\d*\\s*[:：]\\s*(.*)$/i);\n    if (!m) return;\n    got = true;\n    var k = m[1].toUpperCase(), v = m[2].trim();\n    if (k.indexOf(\"TRANSLATION\") === 0){ if (!tr) tr = v; }\n    else if (k.indexOf(\"ROMAN\") === 0){ if (!rom) rom = v; }\n  });\n  if (!got){\n    /* legacy shapes: JSON from big cloud models, or a bare translation line */\n    var s = r.indexOf(\"{\"), e = r.lastIndexOf(\"}\");\n    if (s >= 0 && e > s){\n      try{\n        var j = JSON.parse(r.slice(s, e + 1));\n        tr = String(j.translation || j.tr || \"\").trim();\n        rom = String(j.roman || j.romanization || j.romanisation || j.rom || \"\").trim();\n      }catch(e2){}\n    }\n    if (!tr) tr = r.split(\"\\n\")[0].trim();\n  }\n  tr = tr.replace(/^[\"'«]|[\"'»]$/g, \"\").trim();\n  rom = rom.replace(/^[\"'«]|[\"'»]$/g, \"\").trim();\n  if (!wantRom) rom = \"\";\n  if (!tr || ECHO.test(tr) || ECHO.test(rom))\n    throw new Error(\"the translator didn't return a real translation\");\n  return {tr: tr, rom: rom};\n}\nfunction aiTranslate(){\n  var q = el(\"aiq\").value.trim();\n  if (!q){ haptic(\"light\"); return; }\n  if (!ASK){\n    el(\"ainote\").textContent = \"Freeform translation needs AI — enable it in Settings. The phrases below always work.\";\n    haptic(\"light\"); return;\n  }\n  haptic(\"light\");\n  el(\"aigo\").disabled = true;\n  var wantRom = !!R[lang.id];\n  var p = \"Translate this into \" + lang.name + \" for a polite traveller: \\\"\" + q + \"\\\"\\n\" +\n      (wantRom ? \"Reply with EXACTLY these labelled lines and nothing else:\\nTRANSLATION: the translated phrase in \" + lang.name + \"\\nROMAN: how a traveller would pronounce it, written in latin letters\"\n               : \"Reply with EXACTLY this labelled line and nothing else:\\nTRANSLATION: the translated phrase in \" + lang.name);\n  var sys = {system:\"You are a precise translator. No commentary, no alternatives, no quotes.\"};\n  ASK(p, sys)\n  .then(function(r){ return parseTranslation(r || \"\", wantRom); })\n  .catch(function(){\n    return ASK(p + \"\\nIMPORTANT: fill each labelled line with real content — never repeat the instruction text.\", sys)\n      .then(function(r){ return parseTranslation(r || \"\", wantRom); });\n  })\n  .then(function(o){\n    el(\"aitr\").textContent = o.tr;\n    el(\"airom\").textContent = o.rom;\n    el(\"aiout\").style.display = \"block\";\n    el(\"ainote\").textContent = \"Tap the translation to show it full-screen.\";\n    el(\"aigo\").disabled = false;\n    haptic(\"success\");\n  })\n  .catch(function(){\n    el(\"ainote\").textContent = \"Translation didn't run — try again.\";\n    el(\"aigo\").disabled = false;\n  });\n}\n\n/* ---------- boot ---------- */\nPromise.all([store.getItem(\"pb_lang\"), store.getItem(\"pb_favs\")]).then(function(v){\n  if (v[0]){ var l = LANGS.filter(function(x){ return x.id === v[0]; })[0]; if (l) lang = l; }\n  if (v[1]){ try{ favs = JSON.parse(v[1]) || {}; }catch(e){} }\n  if (!ASK) el(\"ainote\").textContent = \"Tip: enable AI in Settings and this box translates anything — even with no signal.\";\n  renderLangs(); render();\n});\n</script>\n</body>\n</html>\n"}