{"name": "Travel Phrasebook", "kind": "html", "iconSymbol": "globe.europe.africa.fill", "iconColor": "teal", "html": "<!doctype html>\n<!--\n  Travel Phrasebook — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Travel Phrasebook</title>\n<style>:root{--build-id:\"13358ecba2\";color-scheme:light dark; --h:176;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:760px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.96); }\n  a{ color:inherit; }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 28%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  .head .acts{ display:flex; gap:8px; flex-shrink:0; }\n  .head .acts button{ min-width:40px; height:40px; border-radius:12px; border:1px solid var(--line); background:var(--surface);\n    display:flex; align-items:center; justify-content:center; gap:6px; padding:0 10px; font-size:13.5px; font-weight:650; }\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:20px 2px 10px; display:flex; align-items:center; gap:6px; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  label{ display:block; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:14px 2px 7px; }\n  label:first-child{ margin-top:0; }\n  input{ width:100%; font:inherit; font-size:16px; padding:12px; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; }\n  input:focus{ border-color:var(--acc); }\n  .field{ position:relative; } .field svg.i{ position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--muted); font-size:15px; pointer-events:none; }\n  .field input{ padding-left:38px; }\n  .inrow{ display:flex; gap:8px; } .inrow input{ flex:1; min-width:0; }\n  .chips{ display:flex; gap:7px; overflow-x:auto; -webkit-overflow-scrolling:touch; scrollbar-width:none; margin:10px -14px 0; padding:0 14px 2px; }\n  .chips::-webkit-scrollbar{ display:none; }\n  .chip{ flex:0 0 auto; min-height:36px; border:1px solid var(--line); background:var(--bg); border-radius:99px; padding:0 14px; font-size:13.5px; font-weight:650; white-space:nowrap; }\n  .chip.hot{ background:var(--acc); border-color:var(--acc); color:#fff; }\n  .go{ min-height:48px; border:none; border-radius:14px; background:var(--acc); color:#fff; font-size:16px; font-weight:700;\n    display:flex; align-items:center; justify-content:center; gap:8px; padding:0 18px; }\n  .go.wide{ width:100%; margin-top:14px; }\n  .go.soft{ background:var(--fill); color:var(--acc); }\n  .go:disabled{ opacity:.55; }\n  .pillbtn{ display:inline-flex; align-items:center; gap:6px; min-height:36px; border:none; border-radius:10px; padding:0 12px;\n    background:hsl(var(--h) 70% 50% / .13); color:hsl(var(--h) 70% 38%); font-size:13.5px; font-weight:700; text-decoration:none; }\n  @media (prefers-color-scheme:dark){ .pillbtn{ color:hsl(var(--h) 80% 70%); } }\n  .spin{ width:16px; height:16px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n  .skel{ border-radius:16px; margin-bottom:10px; background:var(--fill); animation:shimmer 1.4s ease-in-out infinite; }\n  @keyframes shimmer{ 50%{ opacity:.45; } }\n\n  .notice{ display:flex; gap:12px; align-items:flex-start; background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  .notice .tile{ width:36px; height:36px; border-radius:10px; font-size:16px; }\n  .notice.warn .tile{ background:linear-gradient(145deg,#ff9f0a,#c25e00); }\n  .notice b{ display:block; font-size:15px; font-weight:750; }\n  .notice p{ font-size:13.5px; color:var(--muted); line-height:1.45; margin-top:2px; }\n  .notice p b{ display:inline; font-size:inherit; font-weight:700; color:var(--ink); }\n  .notice .go{ margin-top:10px; min-height:40px; font-size:14.5px; border-radius:12px; }\n  .hint{ text-align:center; font-size:13px; color:var(--muted); line-height:1.5; padding:18px 12px 6px; }\n\n  [hidden]{ display:none !important; }\n  @media (prefers-reduced-motion:reduce){ .spin{ animation-duration:2.4s; } .skel{ animation:none; } button:active{ transform:none; } }\n\n  .langbar{ display:flex; gap:7px; overflow-x:auto; -webkit-overflow-scrolling:touch; scrollbar-width:none;\n    margin:0 calc(-16px - env(safe-area-inset-right)) 12px calc(-16px - env(safe-area-inset-left)); padding:0 calc(16px + env(safe-area-inset-right)) 2px calc(16px + env(safe-area-inset-left)); }\n  .langbar::-webkit-scrollbar{ display:none; }\n  .langbar .chip{ background:var(--surface); }\n\n  .aigo{ width:48px; height:48px; flex-shrink:0; border:none; border-radius:13px; background:var(--acc); color:#fff; display:flex; align-items:center; justify-content:center; font-size:19px; }\n  .aigo:disabled{ opacity:.55; }\n  .aiout{ margin-top:12px; border-radius:14px; padding:12px 13px; background:hsl(var(--h) 70% 45% / .1); cursor:pointer; }\n  .aiout .big{ font-size:21px; font-weight:750; line-height:1.35; overflow-wrap:anywhere; }\n  .aiout .rom{ font-size:14px; font-weight:550; color:hsl(var(--h) 70% 32%); margin-top:3px; }\n  @media (prefers-color-scheme:dark){ .aiout .rom{ color:hsl(var(--h) 75% 66%); } }\n  .aiout .pillbtn{ margin-top:10px; }\n  .ainote{ font-size:12.5px; color:var(--muted); margin-top:9px; line-height:1.45; }\n\n  .ph{ display:flex; align-items:center; gap:8px; background:var(--surface); border:1px solid var(--line); border-radius:15px; padding:9px 8px 9px 13px; margin-bottom:8px; }\n  .ph .tx{ flex:1; min-width:0; cursor:pointer; }\n  .ph .en{ font-size:12.5px; color:var(--muted); }\n  .ph .tr{ font-size:17px; font-weight:750; line-height:1.3; margin-top:1px; overflow-wrap:anywhere; }\n  .ph .rom{ font-size:13px; font-weight:550; color:hsl(var(--h) 70% 32%); margin-top:1px; }\n  @media (prefers-color-scheme:dark){ .ph .rom{ color:hsl(var(--h) 75% 66%); } }\n  .ib{ flex-shrink:0; width:44px; height:44px; border:none; border-radius:12px; background:var(--fill); display:flex; align-items:center; justify-content:center; font-size:17px; color:hsl(var(--h) 70% 36%); }\n  @media (prefers-color-scheme:dark){ .ib{ color:hsl(var(--h) 75% 66%); } }\n  .ib.on{ background:hsl(var(--h) 65% 40%); color:#fff; }\n  .ib.on svg{ animation:pulse 1s ease-in-out infinite; }\n  @keyframes pulse{ 50%{ opacity:.45; } }\n  .ib.fav{ color:var(--muted); background:none; width:40px; }\n  .ib.fav.on{ color:#ffb400; background:none; }\n  .ib.fav.on svg{ animation:none; }\n  .empty{ text-align:center; color:var(--muted); font-size:13.5px; padding:22px; }\n  #voiceNote{ margin-top:4px; }\n\n  /* ---------- show a local: a full-screen stage ---------- */\n  .stage{ position:fixed; inset:0; z-index:300; color:#fff; overflow:hidden; }\n  .stage .bg{ position:absolute; inset:0; transition:opacity .6s ease; }\n  .stage .bg.d{ background:radial-gradient(120% 90% at 20% 10%, hsl(var(--h) 70% 30%), transparent 60%),\n      radial-gradient(120% 90% at 85% 95%, hsl(calc(var(--h) + 50) 60% 26%), transparent 62%), #0b0b10; }\n  .stage .bg.l{ opacity:0; background:radial-gradient(120% 90% at 20% 0%, hsl(var(--h) 80% 84%), transparent 60%),\n      radial-gradient(120% 90% at 85% 100%, hsl(calc(var(--h) + 50) 76% 87%), transparent 62%), #f4f4f8; }\n  .stage.lite{ color:#15151a; } .stage.lite .bg.l{ opacity:1; } .stage.lite .bg.d{ opacity:0; }\n  .stage .col{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; text-align:center;\n    padding:calc(12px + env(safe-area-inset-top)) calc(20px + env(safe-area-inset-right)) calc(22px + env(safe-area-inset-bottom)) calc(20px + env(safe-area-inset-left)); }\n  .stage .top{ width:100%; max-width:640px; height:48px; display:flex; align-items:center; justify-content:space-between; flex-shrink:0; }\n  .stage .lbl{ font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; opacity:.62; }\n  .glass{ border:1px solid rgba(255,255,255,.16); background:rgba(255,255,255,.12); color:inherit;\n    -webkit-backdrop-filter:blur(18px); backdrop-filter:blur(18px); }\n  .stage.lite .glass{ border-color:rgba(0,0,0,.09); background:rgba(255,255,255,.62); }\n  .stage .close{ height:48px; border-radius:99px; padding:0 18px; display:flex; align-items:center; gap:8px; font-size:15px; font-weight:750; }\n  .stage .mid{ flex:1; min-height:0; width:100%; max-width:760px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:12px; overflow-y:auto; }\n  #bigtr{ font-size:clamp(34px, 11vw, 76px); font-weight:800; line-height:1.18; letter-spacing:-.01em; overflow-wrap:anywhere; }\n  #bigrom{ font-size:clamp(18px, 5vw, 26px); font-weight:600; color:hsl(var(--h) 80% 72%); }\n  .stage.lite #bigrom{ color:hsl(var(--h) 70% 30%); }\n  #bigen{ font-size:16px; opacity:.62; }\n  .stage .foot{ display:flex; flex-direction:column; align-items:center; gap:10px; flex-shrink:0; }\n  .stage .say{ width:84px; height:84px; border-radius:50%; border:none; background:#fff; color:#0b0b10; font-size:30px; display:flex; align-items:center; justify-content:center; box-shadow:0 10px 30px rgba(0,0,0,.35); }\n  .stage.lite .say{ background:#15151a; color:#fff; box-shadow:0 10px 26px rgba(20,20,40,.22); }\n  .stage .say.on svg{ animation:pulse 1s ease-in-out infinite; }\n  .stage .saylbl{ font-size:13px; font-weight:700; opacity:.7; }\n  #bigNote{ max-width:420px; font-size:13px; line-height:1.45; opacity:.85; }\n  @media (max-height:520px){                       /* phone on its side: phrase left, speaker right */\n    .stage .col{ display:grid; grid-template-columns:minmax(0,1fr) auto; grid-template-rows:48px minmax(0,1fr); column-gap:24px; }\n    .stage .top{ grid-column:1 / -1; max-width:none; }\n    .stage .mid{ grid-column:1; grid-row:2; max-width:none; }\n    .stage .foot{ grid-column:2; grid-row:2; align-self:center; width:min(220px,30vw); }\n  }\n  @media (prefers-reduced-motion:reduce){ .ib.on svg, .stage .say.on svg{ animation:none; } .stage .bg{ transition:none; } }\n\n  @keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n  .myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n  .myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n  .myllm-ai-cog{width:16px;height:16px;border-radius:50%;border:2.4px solid #a78bfa;border-right-color:transparent;animation:myllmAiSpin .9s linear infinite;flex-shrink:0}\n  .myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-globe\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5a9.5 9.5 0 1 0 0 19 9.5 9.5 0 0 0 0-19zm6.9 8.5h-3.1a15.4 15.4 0 0 0-1.4-5.9A7.5 7.5 0 0 1 18.9 11zM12 4.6c.8 1 1.9 3.2 2.1 6.4H9.9C10.1 7.8 11.2 5.6 12 4.6zM9.6 5.1A15.4 15.4 0 0 0 8.2 11H5.1a7.5 7.5 0 0 1 4.5-5.9zM5.1 13h3.1c.1 2.2.6 4.2 1.4 5.9A7.5 7.5 0 0 1 5.1 13zm6.9 6.4c-.8-1-1.9-3.2-2.1-6.4h4.2c-.2 3.2-1.3 5.4-2.1 6.4zm2.4-.5c.8-1.7 1.3-3.7 1.4-5.9h3.1a7.5 7.5 0 0 1-4.5 5.9z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-speaker\" viewBox=\"0 0 24 24\"><path d=\"M11 4.6a.9.9 0 0 1 1.5.7v13.4a.9.9 0 0 1-1.5.7L6.6 15.6H4a1 1 0 0 1-1-1V9.4a1 1 0 0 1 1-1h2.6z\" fill=\"currentColor\"/><path d=\"M15.6 8.6a4.6 4.6 0 0 1 0 6.8M18.4 5.9a8.6 8.6 0 0 1 0 12.2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.8l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 16.8l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-staro\" viewBox=\"0 0 24 24\"><path d=\"M12 3.8l2.4 4.9 5.3.8-3.8 3.7.9 5.3L12 16l-4.8 2.5.9-5.3-3.8-3.7 5.3-.8z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-arrow\" viewBox=\"0 0 24 24\"><path d=\"M5 12h13M13 6.5l5.5 5.5-5.5 5.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-expand\" viewBox=\"0 0 24 24\"><path d=\"M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-search\" viewBox=\"0 0 24 24\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"/><path d=\"M15.5 15.5L20 20\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-warn\" viewBox=\"0 0 24 24\"><path d=\"M10.3 3.9a2 2 0 0 1 3.4 0l8 13.6a2 2 0 0 1-1.7 3H4a2 2 0 0 1-1.7-3zM12 9a1 1 0 0 0-1 1v4a1 1 0 0 0 2 0v-4a1 1 0 0 0-1-1zm0 7.2a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z\" fill=\"currentColor\"/></symbol>\n</defs></svg>\n\n<!-- AI thinking pill (house convention) -->\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\"></span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n\n<div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-globe\"/></svg></div>\n  <div class=\"ht\"><h1>Travel Phrasebook</h1><p>Speak the language — even offline</p></div>\n</div>\n<div class=\"langbar\" id=\"langs\"></div>\n\n<div class=\"card\" id=\"aicard\">\n  <label for=\"aiq\">Say anything — translated on this phone, even offline</label>\n  <div class=\"inrow\">\n    <input id=\"aiq\" placeholder=\"e.g. Is this train going to the airport?\" autocomplete=\"off\" enterkeyhint=\"go\">\n    <button class=\"aigo\" id=\"aigo\" type=\"button\" aria-label=\"Translate\"><svg class=\"i\"><use href=\"#i-arrow\"/></svg></button>\n  </div>\n  <div class=\"aiout\" id=\"aiout\" hidden>\n    <div class=\"big\" id=\"aitr\"></div>\n    <div class=\"rom\" id=\"airom\"></div>\n    <span class=\"pillbtn\"><svg class=\"i\"><use href=\"#i-expand\"/></svg>Show it full screen</span>\n  </div>\n  <p class=\"ainote\" id=\"ainote\"></p>\n</div>\n\n<div class=\"notice warn\" id=\"voiceNote\" hidden><div class=\"tile\"><svg class=\"i\"><use href=\"#i-warn\"/></svg></div><div style=\"flex:1;min-width:0\"><b>No voice played</b><p id=\"voiceNoteText\"></p></div></div>\n<div class=\"field\"><svg class=\"i\"><use href=\"#i-search\"/></svg><input id=\"q\" placeholder=\"Search phrases…\" autocomplete=\"off\" enterkeyhint=\"search\"></div>\n<div id=\"list\"></div>\n\n<div class=\"stage\" id=\"bigveil\" hidden>\n  <div class=\"bg d\"></div><div class=\"bg l\"></div>\n  <div class=\"col\">\n    <div class=\"top\">\n      <button class=\"glass close\" id=\"bigclose\" type=\"button\"><svg class=\"i\"><use href=\"#i-x\"/></svg>Done</button>\n      <div class=\"lbl\" id=\"biglbl\"></div>\n      <div style=\"width:48px\"></div>\n    </div>\n    <div class=\"mid\">\n      <div id=\"bigtr\"></div>\n      <div id=\"bigrom\"></div>\n      <div id=\"bigen\"></div>\n    </div>\n    <div class=\"foot\">\n      <button class=\"say\" id=\"bigspeak\" type=\"button\" aria-label=\"Say it\"><svg class=\"i\"><use href=\"#i-speaker\"/></svg></button>\n      <div class=\"saylbl\" id=\"biglabel\">Say it</div>\n      <div id=\"bigNote\" hidden></div>\n    </div>\n  </div>\n</div>\n\n<script>\nfunction el(id){ return document.getElementById(id); }\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction store(){ return window.myllmStorage || {getItem:function(){return Promise.resolve(null)}, setItem:function(){return Promise.resolve()}}; }\nfunction ASK(){ return window.myllmAsk || null; }\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction esc(s){ return String(s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\"); }\nfunction icon(n){ return '<svg class=\"i\"><use href=\"#i-' + n + '\"/></svg>'; }\n\nvar LANGS = [\n  {id:\"es\", name:\"Spanish\",    flag:\"🇪🇸\", tts:\"es-ES\"},\n  {id:\"fr\", name:\"French\",     flag:\"🇫🇷\", tts:\"fr-FR\"},\n  {id:\"de\", name:\"German\",     flag:\"🇩🇪\", tts:\"de-DE\"},\n  {id:\"it\", name:\"Italian\",    flag:\"🇮🇹\", tts:\"it-IT\"},\n  {id:\"pt\", name:\"Portuguese\", flag:\"🇵🇹\", tts:\"pt-PT\"},\n  {id:\"ja\", name:\"Japanese\",   flag:\"🇯🇵\", tts:\"ja-JP\"},\n  {id:\"zh\", name:\"Mandarin\",   flag:\"🇨🇳\", tts:\"zh-CN\"},\n  {id:\"ko\", name:\"Korean\",     flag:\"🇰🇷\", tts:\"ko-KR\"},\n  {id:\"tr\", name:\"Turkish\",    flag:\"🇹🇷\", tts:\"tr-TR\"},\n  {id:\"el\", name:\"Greek\",      flag:\"🇬🇷\", tts:\"el-GR\"}\n];\nvar CATS = [\n  {id:\"basics\", name:\"Basics\"},\n  {id:\"talk\",   name:\"Being understood\"},\n  {id:\"help\",   name:\"Help & emergencies\"},\n  {id:\"move\",   name:\"Getting around\"},\n  {id:\"food\",   name:\"Eating & drinking\"},\n  {id:\"stay\",   name:\"Somewhere to sleep\"},\n  {id:\"shop\",   name:\"Shopping & Wi-Fi\"}\n];\nvar P = [\n  {k:\"hello\",c:\"basics\",en:\"Hello\"},\n  {k:\"bye\",c:\"basics\",en:\"Goodbye\"},\n  {k:\"yes\",c:\"basics\",en:\"Yes\"},\n  {k:\"no\",c:\"basics\",en:\"No\"},\n  {k:\"please\",c:\"basics\",en:\"Please\"},\n  {k:\"thanks\",c:\"basics\",en:\"Thank you\"},\n  {k:\"excuse\",c:\"basics\",en:\"Excuse me\"},\n  {k:\"sorry\",c:\"basics\",en:\"Sorry\"},\n  {k:\"english\",c:\"talk\",en:\"Do you speak English?\"},\n  {k:\"dontunderstand\",c:\"talk\",en:\"I don't understand\"},\n  {k:\"slowly\",c:\"talk\",en:\"Please speak more slowly\"},\n  {k:\"helpme\",c:\"help\",en:\"Help!\"},\n  {k:\"lost\",c:\"help\",en:\"I'm lost\"},\n  {k:\"doctor\",c:\"help\",en:\"I need a doctor\"},\n  {k:\"pharmacy\",c:\"help\",en:\"Where is the pharmacy?\"},\n  {k:\"police\",c:\"help\",en:\"Call the police\"},\n  {k:\"toilet\",c:\"move\",en:\"Where is the toilet?\"},\n  {k:\"station\",c:\"move\",en:\"Where is the train station?\"},\n  {k:\"ticket\",c:\"move\",en:\"One ticket, please\"},\n  {k:\"left\",c:\"move\",en:\"Left\"},\n  {k:\"right\",c:\"move\",en:\"Right\"},\n  {k:\"straight\",c:\"move\",en:\"Straight ahead\"},\n  {k:\"menu\",c:\"food\",en:\"The menu, please\"},\n  {k:\"water\",c:\"food\",en:\"Water, please\"},\n  {k:\"coffee\",c:\"food\",en:\"A coffee, please\"},\n  {k:\"beer\",c:\"food\",en:\"A beer, please\"},\n  {k:\"veggie\",c:\"food\",en:\"I'm vegetarian\"},\n  {k:\"nuts\",c:\"food\",en:\"I have a nut allergy\"},\n  {k:\"bill\",c:\"food\",en:\"The bill, please\"},\n  {k:\"delicious\",c:\"food\",en:\"Delicious!\"},\n  {k:\"reservation\",c:\"stay\",en:\"I have a reservation\"},\n  {k:\"room\",c:\"stay\",en:\"Do you have a free room?\"},\n  {k:\"howmuch\",c:\"shop\",en:\"How much does it cost?\"},\n  {k:\"expensive\",c:\"shop\",en:\"Too expensive!\"},\n  {k:\"takeit\",c:\"shop\",en:\"I'll take it\"},\n  {k:\"wifi\",c:\"shop\",en:\"What's the Wi-Fi password?\"}\n];\nvar T = {\nes:{hello:\"Hola\",bye:\"Adiós\",yes:\"Sí\",no:\"No\",please:\"Por favor