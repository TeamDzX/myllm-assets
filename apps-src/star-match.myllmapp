{"name": "Star Match", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>:root{color-scheme:light dark;--accent:#ff375f}\n*{box-sizing:border-box}\nbody{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:18px;background:#f2f2f7;color:#111}\n@media(prefers-color-scheme:dark){body{background:#000;color:#eee}select,.result{background:#1c1c1e;color:#eee;border-color:#3a3a3c}}\nh1{font-size:22px;margin:0 0 4px}\n.sub{font-size:13px;opacity:.6;margin-bottom:14px}\n.pick{display:flex;gap:10px;align-items:center;margin-bottom:10px}\n.pick label{font-size:12px;opacity:.6;width:64px;flex:none}\nselect{flex:1;padding:11px;border:1px solid #d1d1d6;border-radius:10px;font-size:16px;background:#fff;color:#111}\nbutton.go{width:100%;border:0;background:var(--accent);color:#fff;border-radius:11px;padding:13px;font-size:15px;font-weight:600;margin-top:4px}\nbutton:disabled{opacity:.5}\n#status{font-size:13px;opacity:.7;min-height:16px;margin:10px 0}\n.result{background:#fff;border-radius:16px;padding:20px;margin-top:8px;box-shadow:0 1px 4px rgba(0,0,0,.1);display:none;text-align:center}\n.result .pair{font-size:30px}\n.score{font-size:46px;font-weight:800;color:var(--accent);margin:6px 0 2px}\n.bar{height:10px;border-radius:6px;background:rgba(127,127,127,.2);overflow:hidden;margin:8px 0 14px}\n.bar i{display:block;height:100%;background:linear-gradient(90deg,#ff9f0a,var(--accent));border-radius:6px}\n.reading{font-size:15px;line-height:1.6;text-align:left}\n</style></head><body>\n<h1>💞 Star Match</h1>\n<div class=\"sub\">See how two star signs get along — just for fun ✨</div>\n<div class=\"pick\"><label>You</label><select id=\"a\"></select></div>\n<div class=\"pick\"><label>Them</label><select id=\"b\"></select></div>\n<button class=\"go\" id=\"go\" onclick=\"match()\">Reveal our match</button>\n<div id=\"status\"></div>\n<div class=\"result\" id=\"result\"></div>\n<script>\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar SIGNS=[['Aries','♈','Fire'],['Taurus','♉','Earth'],['Gemini','♊','Air'],['Cancer','♋','Water'],\n ['Leo','♌','Fire'],['Virgo','♍','Earth'],['Libra','♎','Air'],['Scorpio','♏','Water'],\n ['Sagittarius','♐','Fire'],['Capricorn','♑','Earth'],['Aquarius','♒','Air'],['Pisces','♓','Water']];\nfunction el(i){return document.getElementById(i)}\nfunction setStatus(t){el('status').textContent=t||''}\nfunction sym(n){for(var i=0;i<SIGNS.length;i++)if(SIGNS[i][0]===n)return SIGNS[i][1];return''}\nfunction elem(n){for(var i=0;i<SIGNS.length;i++)if(SIGNS[i][0]===n)return SIGNS[i][2];return''}\nfunction fill(sel){SIGNS.forEach(function(s){var o=document.createElement('option');o.value=s[0];o.textContent=s[1]+' '+s[0];sel.appendChild(o)})}\nfill(el('a'));fill(el('b'));el('b').selectedIndex=4;\n\nfunction hash(s){var h=0;for(var i=0;i<s.length;i++)h=(h*31+s.charCodeAt(i))>>>0;return h}\nfunction pairScore(a,b){\n  var e1=elem(a),e2=elem(b),base;\n  var key=[e1,e2].sort().join('+');\n  if(e1===e2)base=92;\n  else if(key==='Air+Fire')base=88;else if(key==='Earth+Water')base=88;\n  else if(key==='Earth+Fire')base=70;else if(key==='Air+Water')base=70;\n  else if(key==='Fire+Water')base=62;else base=64; // Air+Earth\n  var j=(hash(a+'·'+b)%9)-4;\n  return Math.max(55,Math.min(98,base+j));\n}\nfunction tier(n){\n  if(n>=85)return'A natural match — your elements spark and flow together beautifully.';\n  if(n>=72)return'Strong potential — a little give and take and you’ll really click.';\n  if(n>=64)return'Opposites that intrigue — different energies that can balance each other out.';\n  return'A slow burn — it takes effort, but the contrast keeps things interesting.';\n}\n\nfunction show(a,b,score,reading){\n  var r=el('result');r.style.display='block';\n  r.innerHTML='<div class=\"pair\">'+sym(a)+' &nbsp;💖&nbsp; '+sym(b)+'</div>'+\n    '<div class=\"score\">'+score+'%</div>'+\n    '<div class=\"bar\"><i style=\"width:'+score+'%\"></i></div>'+\n    '<div class=\"reading\"></div>';\n  r.querySelector('.reading').textContent=reading;\n  if(window.myllmHaptic)myllmHaptic('success');\n  r.scrollIntoView({behavior:'smooth',block:'nearest'});\n}\n\nfunction match(){\n  var a=el('a').value,b=el('b').value;\n  var score=pairScore(a,b);\n  store.setItem('last',a+'|'+b);\n  if(!window.myllmAsk){show(a,b,score,tier(score)+'\\n\\n(Turn on “Allow apps to use the AI” in Settings for a full personalised reading.)');return}\n  el('go').disabled=true;setStatus('Consulting the stars for '+a+' & '+b+'…');\n  myllmAsk('Write a fun, playful zodiac compatibility reading for '+a+' ('+elem(a)+') and '+b+' ('+elem(b)+') as a pair. 3–4 sentences, positive and entertaining. No preamble, no score, no headings.',\n           {system:'You are a witty astrologer writing short, light-hearted compatibility readings.'})\n  .then(function(reply){show(a,b,score,reply.trim());setStatus('')})\n  .catch(function(err){setStatus('');show(a,b,score,tier(score))})\n  .then(function(){el('go').disabled=false});\n}\n\nstore.getItem('last').then(function(v){\n  if(v){var p=v.split('|');if(p.length===2){el('a').value=p[0];el('b').value=p[1]}}\n});\n</script></body></html>\n", "kind": "html", "iconSymbol": "heart.fill", "iconColor": "pink"}