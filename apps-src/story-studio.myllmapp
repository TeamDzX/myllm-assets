{"name": "Story Studio", "html": "<!doctype html>\n<!--\n  Story Studio — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Story Studio</title>\n<style>\n:root{--build-id:\"1ee9b8844e\";\n  color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7);--surface:var(--myllm-surface,#fff);\n  --text:var(--myllm-text,#111);--muted:var(--myllm-muted,#6b6b72);\n  --accent:var(--myllm-accent,#0b5ed7);--border:var(--myllm-border,rgba(120,120,128,.25));\n  --radius:var(--myllm-radius,14px);--font:var(--myllm-font,-apple-system,system-ui,sans-serif);\n}\n@media(prefers-color-scheme:dark){:root{--bg:var(--myllm-bg,#000);--surface:var(--myllm-surface,#1c1c1e);--text:var(--myllm-text,#eee);--muted:var(--myllm-muted,#98989f)}}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nhtml,body{height:100%}\nbody{margin:0;font-family:var(--font);background:var(--bg);color:var(--text);display:flex;flex-direction:column}\n.head{padding:12px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px}\n.head h1{margin:0;font-size:19px;font-weight:700;flex:1}\n.head button{border:0;background:none;color:var(--accent);font:inherit;font-weight:600;font-size:14px;cursor:pointer;padding:6px}\n#story{flex:1;width:100%;border:0;outline:0;resize:none;padding:18px 16px;font-family:Georgia,serif;font-size:17px;line-height:1.6;background:var(--bg);color:var(--text)}\n.start{padding:24px 16px;max-width:520px;margin:0 auto;width:100%}\n.start h2{font-size:18px;margin:0 0 4px}.start p{color:var(--muted);margin:0 0 16px;font-size:14px}\n.genres{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:14px}\n.gchip{border:1px solid var(--border);background:var(--surface);color:var(--muted);border-radius:999px;padding:7px 13px;font:inherit;font-size:13px;font-weight:600;cursor:pointer}\n.gchip.on{background:var(--accent);color:#fff;border-color:transparent}\ninput[type=text]{width:100%;padding:13px;border:1px solid var(--border);border-radius:11px;font:inherit;font-size:16px;background:var(--surface);color:var(--text)}\n.bar{border-top:1px solid var(--border);background:var(--surface);padding:10px;display:flex;gap:8px;overflow-x:auto;scrollbar-width:none}.bar::-webkit-scrollbar{display:none}\n.bar button{flex:none;border:0;border-radius:10px;padding:11px 15px;font:inherit;font-weight:600;font-size:14px;cursor:pointer;background:var(--bg);border:1px solid var(--border);color:var(--text)}\n.bar button.primary{background:var(--accent);color:#fff;border-color:transparent}\n.bar button:disabled{opacity:.4}\n.foot{display:flex;justify-content:space-between;padding:6px 16px;font-size:12px;color:var(--muted)}\n#err{color:#e04848;font-size:13px;padding:0 16px 8px;display:none}\n.dots:after{content:'';animation:d 1.2s steps(4,end) infinite}\n@keyframes d{0%{content:''}25%{content:'.'}50%{content:'..'}75%{content:'...'}}\n</style>\n</head>\n<body>\n<div class=\"head\">\n  <h1>✍️ Story Studio</h1>\n  <button id=\"shareBtn\">Share</button>\n  <button id=\"newBtn\">New</button>\n</div>\n\n<div class=\"start\" id=\"startView\">\n  <h2>Start a story</h2>\n  <p>Pick a vibe and give it a spark — your on-device AI writes the opening, then you steer.</p>\n  <div class=\"genres\" id=\"genres\"></div>\n  <input type=\"text\" id=\"seed\" placeholder=\"e.g. a lighthouse keeper finds a door in the sea\">\n  <button class=\"gchip primary\" id=\"startBtn\" style=\"margin-top:14px;width:100%;padding:13px;font-size:15px;background:var(--accent);color:#fff;border:0\">Begin ✨</button>\n  <div id=\"err\"></div>\n</div>\n\n<textarea id=\"story\" placeholder=\"Your story will appear here…\" style=\"display:none\"></textarea>\n<div class=\"foot\" id=\"foot\" style=\"display:none\"><span id=\"wc\">0 words</span><span id=\"status\"></span></div>\n<div class=\"bar\" id=\"bar\" style=\"display:none\">\n  <button class=\"primary\" data-a=\"continue\">Continue</button>\n  <button data-a=\"twist\">Plot twist</button>\n  <button data-a=\"character\">New character</button>\n  <button data-a=\"scene\">New scene</button>\n  <button data-a=\"describe\">Describe</button>\n</div>\n\n<script>\nvar GENRES=[\"Any\",\"Fantasy\",\"Sci-fi\",\"Mystery\",\"Romance\",\"Horror\",\"Adventure\",\"Fairy tale\"];\nvar genre=\"Any\",busy=false,confirmNew=false;\nvar SYS=\"You are a talented fiction co-writer. Write immersive, vivid prose in the same tense, point of view, voice and style as the existing text. Continue seamlessly from where it leaves off. Output ONLY the new prose — no titles, no notes, no commentary, no surrounding quotation marks.\";\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nfunction $(i){return document.getElementById(i)}\nfunction showErr(t){var e=$('err');e.style.display=t?'block':'none';e.textContent=t||''}\n\nfunction buildGenres(){\n  var g=$('genres');g.innerHTML='';\n  GENRES.forEach(function(x){var b=document.createElement('button');b.className='gchip'+(x===genre?' on':'');b.textContent=x;\n    b.onclick=function(){genre=x;haptic('selection');buildGenres()};g.appendChild(b)});\n}\nfunction wc(){var t=$('story').value.trim();var n=t?t.split(/\\s+/).length:0;$('wc').textContent=n+(n===1?' word':' words')}\n\nfunction showEditor(){\n  $('startView').style.display='none';\n  $('story').style.display='block';$('bar').style.display='flex';$('foot').style.display='flex';\n  wc();\n}\nfunction ask(prompt){\n  if(!window.myllmAsk){showErr('Story Studio needs the on-device AI. Update MyLLM and turn on “Allow apps to use the AI” in Settings → MyLLMos Apps.');return Promise.reject()}\n  return myllmAsk(prompt,{system:SYS});\n}\nfunction setBusy(b,label){\n  busy=b;\n  document.querySelectorAll('#bar button,#startBtn').forEach(function(e){e.disabled=b});\n  $('status').innerHTML=b?('<span class=\"dots\">'+(label||'Writing')+'</span>'):'';\n}\n\n$('startBtn').onclick=function(){\n  if(busy)return;var spark=$('seed').value.trim();showErr('');\n  var g=genre==='Any'?'':(' '+genre.toLowerCase());\n  var p='Write the opening paragraph (4-6 sentences) of an engaging'+g+' story'+(spark?(' about: '+spark):'')+'. Make it vivid and end on a moment of momentum that invites continuation.';\n  setBusy(true,'Writing the opening');\n  ask(p).then(function(r){\n    showEditor();$('story').value=(r||'').trim();wc();save();haptic('success');\n  }).catch(function(e){if(e)showErr('The AI didn’t respond. Try again.')}).then(function(){setBusy(false)});\n};\n\nvar PROMPTS={\n  continue:\"Continue the story with one short paragraph (3-5 sentences). Just write what happens next.\",\n  twist:\"Continue the story with one short paragraph that introduces a surprising but believable plot twist.\",\n  character:\"Continue the story by bringing in a new, vivid character right now — one short paragraph.\",\n  scene:\"Begin a new scene in a different time or place, picking up the thread — one short paragraph.\",\n  describe:\"Add one short paragraph of rich, sensory description of the current setting or mood, without advancing the plot much.\"\n};\ndocument.querySelectorAll('#bar button').forEach(function(btn){\n  btn.onclick=function(){\n    if(busy)return;showErr('');\n    var a=btn.getAttribute('data-a');\n    var story=$('story').value.trim();\n    var ctx=story.length>1800?story.slice(-1800):story;\n    var p='Here is the story so far:\\n\\n'+ctx+'\\n\\n'+PROMPTS[a];\n    setBusy(true,'Writing');haptic('light');\n    ask(p).then(function(r){\n      var add=(r||'').trim();if(!add)return;\n      var s=$('story');s.value=(s.value.replace(/\\s+$/,''))+'\\n\\n'+add;wc();save();\n      s.scrollTop=s.scrollHeight;haptic('success');\n    }).catch(function(e){if(e)showErr('The AI didn’t respond. Try again.')}).then(function(){setBusy(false)});\n  };\n});\n\n$('story').oninput=function(){wc();save()};\n$('shareBtn').onclick=function(){var t=$('story').value.trim();if(t&&window.myllmShare){haptic('light');myllmShare(t)}};\n$('newBtn').onclick=function(){\n  if(busy)return;\n  if(!confirmNew){confirmNew=true;$('newBtn').textContent='Clear?';setTimeout(function(){confirmNew=false;$('newBtn').textContent='New'},2500);return}\n  confirmNew=false;$('newBtn').textContent='New';\n  $('story').value='';save();\n  $('startView').style.display='block';$('story').style.display='none';$('bar').style.display='none';$('foot').style.display='none';\n  $('seed').value='';haptic('warning');\n};\n\nfunction save(){if(window.myllmStorage)myllmStorage.setItem('story',$('story').value)}\nfunction load(){\n  buildGenres();\n  if(!window.myllmStorage)return;\n  myllmStorage.getItem('story').then(function(v){\n    if(v&&v.trim()){$('story').value=v;showEditor()}\n  });\n}\nload();\n</script>\n</body>\n</html>\n", "kind": "html", "iconSymbol": "books.vertical.fill", "iconColor": "indigo"}