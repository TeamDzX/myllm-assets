{"name": "Guitar Tuner", "kind": "html", "iconSymbol": "tuningfork", "iconColor": "teal", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Guitar Tuner</title>\n<style>\n  :root { color-scheme: light dark; }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111);\n    max-width:820px; margin:0 auto;\n    padding:16px 16px calc(40px + env(safe-area-inset-bottom));\n  }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-0.02em; margin:6px 2px 14px; }\n\n  .seg{ display:flex; background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8); border-radius:14px; padding:3px; margin-bottom:14px; }\n  .seg button{\n    flex:1; border:none; background:none; color:var(--myllm-muted,#8a8a8e);\n    border-radius:11px; padding:10px; font-size:15px; font-weight:700;\n  }\n  .seg button.on{ background:var(--myllm-accent,#0a84ff); color:#fff; }\n\n  .card{\n    background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8);\n    border-radius:16px; padding:14px; margin-bottom:12px;\n  }\n\n  /* ---- tuner dial ---- */\n  .dial{ position:relative; height:170px; overflow:hidden; margin-bottom:4px; }\n  .arc{\n    position:absolute; left:50%; bottom:0; transform:translateX(-50%);\n    width:280px; height:140px;\n    border-radius:280px 280px 0 0;\n    border:2px solid var(--myllm-border,#e3e3e8); border-bottom:none;\n  }\n  .tick{ position:absolute; left:50%; bottom:0; width:2px; height:140px; transform-origin:50% 100%; }\n  .tick i{ position:absolute; top:0; left:0; width:2px; height:10px; background:var(--myllm-border,#c9c9cf); }\n  .tick.mid i{ height:16px; background:#30d158; width:3px; }\n  .needle{\n    position:absolute; left:50%; bottom:0; width:4px; height:126px; margin-left:-2px;\n    transform-origin:50% 100%; border-radius:4px;\n    background:var(--myllm-accent,#0a84ff);\n    transition:transform .12s ease-out, background .12s;\n  }\n  .needle.good{ background:#30d158; }\n  .hub{ position:absolute; left:50%; bottom:-9px; width:18px; height:18px; margin-left:-9px; border-radius:50%; background:var(--myllm-accent,#0a84ff); }\n  /* Input level, shown once the mic is live. Without it a mic delivering\n     too-quiet audio looked identical to a working one: no needle, no warning.\n     The notch marks the level the pitch detector needs to see. */\n  .levelwrap{ display:none; position:relative; height:6px; border-radius:3px; background:var(--myllm-border,#e3e3e8); overflow:hidden; margin:10px 2px 8px; }\n  .levelwrap.on{ display:block; }\n  .levelbar{ height:100%; width:0%; border-radius:3px; background:var(--myllm-accent,#0a84ff); transition:width .08s linear; }\n  .levelbar.faint{ background:#ff9f0a; }\n  .levelgate{ position:absolute; top:0; bottom:0; left:22%; width:2px; background:var(--myllm-muted,#8a8a8e); opacity:.55; }\n  .hub.good{ background:#30d158; }\n\n  .readout{ text-align:center; margin-bottom:6px; }\n  .note{ font-size:56px; font-weight:800; letter-spacing:-0.02em; line-height:1.05; }\n  .note sup{ font-size:24px; }\n  .cents{ font-size:15px; font-weight:650; color:var(--myllm-muted,#8a8a8e); min-height:22px; }\n  .cents.good{ color:#30d158; }\n  .freq{ font-size:12.5px; color:var(--myllm-muted,#8a8a8e); min-height:18px; }\n  .listenmsg{ text-align:center; font-size:13.5px; color:var(--myllm-muted,#8a8a8e); line-height:1.5; padding:6px 8px 2px; }\n  .micbtn{\n    display:block; margin:8px auto 2px; border:none; border-radius:99px; padding:12px 22px;\n    font-size:15px; font-weight:700; background:var(--myllm-accent,#0a84ff); color:#fff;\n  }\n\n  /* ---- strings ---- */\n  .strings{ display:flex; gap:8px; justify-content:center; margin-top:10px; }\n  .str{\n    flex:1; max-width:64px; aspect-ratio:0.86; border-radius:14px;\n    border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111);\n    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:1px;\n  }\n  .str b{ font-size:19px; font-weight:800; }\n  .str small{ font-size:10px; color:var(--myllm-muted,#8a8a8e); }\n  .str.near{ border-color:var(--myllm-accent,#0a84ff); background:rgba(10,132,255,.1); }\n  .str.good{ border-color:#30d158; background:rgba(48,209,88,.12); }\n  .str.playing{ border-color:#ff9500; background:rgba(255,149,0,.12); }\n  .strhint{ text-align:center; font-size:12px; color:var(--myllm-muted,#8a8a8e); margin-top:8px; }\n\n  /* wraps on narrow phones: a long tuning name used to hold the select at its\n     content width and shove the + button off the card edge, because flex items\n     don't shrink below min-content unless told to (min-width:0) */\n  .optrow{ display:flex; gap:10px; align-items:center; flex-wrap:wrap; }\n  .optrow label{ flex:0 0 auto; font-size:11.5px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:var(--myllm-muted,#8a8a8e); }\n  .optrow select{\n    flex:1 1 130px; min-width:0; max-width:100%;\n    font-size:15px; padding:9px 10px; border-radius:11px;\n    border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111);\n  }\n  .stepper{ display:flex; align-items:center; gap:2px; flex:0 0 auto; margin-left:auto; }\n  .stepper button{\n    width:34px; height:34px; border-radius:10px; border:1px solid var(--myllm-border,#e3e3e8);\n    background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111); font-size:17px; font-weight:700;\n  }\n  .stepper b{ min-width:64px; text-align:center; font-size:14px; }\n\n  /* ---- metronome ---- */\n  .bpmwrap{ text-align:center; }\n  .bpm{ font-size:64px; font-weight:800; letter-spacing:-0.03em; line-height:1; }\n  .bpm small{ font-size:16px; font-weight:650; color:var(--myllm-muted,#8a8a8e); }\n  input[type=range]{ width:100%; margin:16px 0 6px; accent-color:var(--myllm-accent,#0a84ff); }\n  .beats{ display:flex; gap:8px; justify-content:center; margin:12px 0 4px; }\n  .beat{ width:16px; height:16px; border-radius:50%; background:var(--myllm-border,#d4d4da); transition:transform .08s, background .08s; }\n  .beat.hit{ background:var(--myllm-accent,#0a84ff); transform:scale(1.45); }\n  .beat.hit.acc{ background:#ff9500; }\n  .mrow{ display:flex; gap:10px; margin-top:14px; }\n  .mrow button{\n    flex:1; border:none; border-radius:14px; padding:15px; font-size:16px; font-weight:750;\n  }\n  .playbtn{ background:var(--myllm-accent,#0a84ff); color:#fff; }\n  .playbtn.on{ background:#ff3b30; }\n  .tapbtn{ background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111); border:1px solid var(--myllm-border,#e3e3e8) !important; }\n  .sig{ display:flex; gap:7px; justify-content:center; margin-top:12px; }\n  .sig button{\n    width:42px; height:36px; border-radius:10px; border:1px solid var(--myllm-border,#e3e3e8);\n    background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111); font-size:14px; font-weight:700;\n  }\n  .sig button.on{ background:var(--myllm-accent,#0a84ff); border-color:var(--myllm-accent,#0a84ff); color:#fff; }\n</style>\n</head>\n<body>\n\n<h1>🎸 Guitar Tuner</h1>\n\n<div class=\"seg\">\n  <button id=\"tabTune\" class=\"on\" onclick=\"showTab('tune')\">Tuner</button>\n  <button id=\"tabMetro\" onclick=\"showTab('metro')\">Metronome</button>\n</div>\n\n<div id=\"paneTune\">\n  <div class=\"card\">\n    <div class=\"dial\" id=\"dial\">\n      <div class=\"arc\"></div>\n      <div class=\"needle\" id=\"needle\" style=\"transform:rotate(0deg)\"></div>\n      <div class=\"hub\" id=\"hub\"></div>\n    </div>\n    <div class=\"readout\">\n      <div class=\"note\" id=\"note\">—</div>\n      <div class=\"cents\" id=\"cents\"></div>\n      <div class=\"freq\" id=\"freq\"></div>\n    </div>\n    <div class=\"levelwrap\" id=\"levelwrap\"><div class=\"levelbar\" id=\"levelbar\"></div><div class=\"levelgate\"></div></div>\n    <div class=\"listenmsg\" id=\"micmsg\">The tuner listens through your microphone.</div>\n    <button class=\"micbtn\" id=\"micbtn\" onclick=\"startMic()\">Start tuning</button>\n  </div>\n\n  <div class=\"card\">\n    <div class=\"strings\" id=\"strings\"></div>\n    <div class=\"strhint\">Tap a string to hear its reference tone.</div>\n  </div>\n\n  <div class=\"card\">\n    <div class=\"optrow\">\n      <label>Tuning</label>\n      <select id=\"preset\" onchange=\"setPreset()\"></select>\n      <div class=\"stepper\">\n        <button onclick=\"calib(-1)\">−</button>\n        <b id=\"a4\">A4 440 Hz</b>\n        <button onclick=\"calib(1)\">+</button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<div id=\"paneMetro\" style=\"display:none\">\n  <div class=\"card bpmwrap\">\n    <div class=\"bpm\"><span id=\"bpmval\">100</span> <small>BPM</small></div>\n    <input type=\"range\" id=\"bpmslider\" min=\"30\" max=\"240\" value=\"100\" oninput=\"setBpm(parseInt(this.value,10))\">\n    <div class=\"beats\" id=\"beats\"></div>\n    <div class=\"sig\" id=\"sig\"></div>\n    <div class=\"mrow\">\n      <button class=\"tapbtn\" onclick=\"tapTempo()\">Tap tempo</button>\n      <button class=\"playbtn\" id=\"playbtn\" onclick=\"toggleMetro()\">Start</button>\n    </div>\n  </div>\n</div>\n\n<script>\nvar store = window.myllmStorage || {getItem:function(){return Promise.resolve(null)}, setItem:function(){return Promise.resolve()}};\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction el(id){ return document.getElementById(id); }\n\nvar NOTE_NAMES = [\"C\",\"C#\",\"D\",\"D#\",\"E\",\"F\",\"F#\",\"G\",\"G#\",\"A\",\"A#\",\"B\"];\nvar a4 = 440;\n\nvar PRESETS = [\n  {id:\"standard\", name:\"Standard (E A D G B E)\", midi:[40,45,50,55,59,64]},\n  {id:\"dropd\",    name:\"Drop D (D A D G B E)\",   midi:[38,45,50,55,59,64]},\n  {id:\"halfdown\", name:\"Half step down\",          midi:[39,44,49,54,58,63]},\n  {id:\"dadgad\",   name:\"DADGAD\",                  midi:[38,45,50,55,57,62]},\n  {id:\"openg\",    name:\"Open G (D G D G B D)\",    midi:[38,43,50,55,59,62]}\n];\nvar preset = PRESETS[0];\n\nfunction midiFreq(m){ return a4 * Math.pow(2, (m - 69) / 12); }\nfunction noteName(m){ return NOTE_NAMES[((m % 12) + 12) % 12]; }\nfunction octaveOf(m){ return Math.floor(m / 12) - 1; }\n\n/* ================= TUNER ================= */\nvar actx = null, analyser = null, micStream = null, rafId = null;\nvar buf = null;\nvar micGain = null;\nvar recent = [];          /* recent detected freqs for median smoothing */\nvar lockGood = false;\n\nfunction ensureCtx(){\n  if (!actx){\n    var AC = window.AudioContext || window.webkitAudioContext;\n    actx = new AC();\n  }\n  if (actx.state === \"suspended\") actx.resume();\n  return actx;\n}\n\nfunction startMic(){\n  haptic(\"light\");\n  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){\n    el(\"micmsg\").textContent = \"Mic isn't available on this version of MyLLM — tune by ear with the reference tones below.\";\n    el(\"micbtn\").style.display = \"none\";\n    return;\n  }\n  el(\"micmsg\").textContent = \"Starting…\";\n  /* plain constraints (the shape that's proven in this sandbox); the tuning-\n     hostile processing flags are relaxed afterwards, best-effort */\n  navigator.mediaDevices.getUserMedia({audio:true})\n  .then(function(s){\n    micStream = s;\n    var tr = s.getAudioTracks()[0];\n    if (tr && tr.applyConstraints){\n      tr.applyConstraints({echoCancellation:false, noiseSuppression:false, autoGainControl:false}).catch(function(){});\n    }\n    var ctx = ensureCtx();\n    var src = ctx.createMediaStreamSource(s);\n    analyser = ctx.createAnalyser();\n    analyser.fftSize = 4096;   /* ~93ms window: low-E needs the longer view for cent accuracy */\n    /* Makeup gain between source and analyser. iOS hands us a very quiet stream\n       when autoGainControl is off (which we want off — AGC pumps the level and\n       ruins cent accuracy), quiet enough that the detector's gate never opened\n       and nothing moved. This restores level for ANALYSIS only; it is never\n       routed to the speakers, so it cannot feed back. */\n    micGain = ctx.createGain();\n    micGain.gain.value = 1;\n    src.connect(micGain);\n    micGain.connect(analyser);\n    buf = new Float32Array(analyser.fftSize);\n    el(\"micbtn\").style.display = \"none\";\n    el(\"micmsg\").textContent = \"Play a string…\";\n    el(\"levelwrap\").className = \"levelwrap on\";\n    deadFrames = 0; faintFrames = 0; liveSeen = false; autoGain = 1;\n    loop();\n  })\n  .catch(function(err){\n    var name = err && err.name ? \" (\" + err.name + \")\" : \"\";\n    el(\"micmsg\").textContent = \"Couldn't open the microphone\" + name + \". Check “Allow apps to use the microphone” in Settings → MyLLMos Apps, then reopen — or tune by ear with the reference tones below.\";\n  });\n}\n\n/* Three states, not two. The old code only distinguished \"pure silence\" from\n   \"fine\", so a stream that was audible-but-too-quiet fell between them: the\n   detector's gate (rms 0.008) never opened and the silence warning (1e-4) never\n   fired, leaving \"Play a string…\" on screen forever with a dead needle. That\n   band is now its own state, with makeup gain applied to try to rescue it. */\nvar deadFrames = 0, faintFrames = 0, liveSeen = false, autoGain = 1;\nvar GATE = 0.0015;            /* detector floor, post-gain (was 0.008) */\nvar MAX_GAIN = 24;\n\nfunction watchSignal(maxAbs, rms){\n  /* adapt gain toward putting a normal playing level near 0.15 rms */\n  if (rms > 1e-5 && rms < 0.05 && autoGain < MAX_GAIN){\n    autoGain = Math.min(MAX_GAIN, autoGain * 1.06);\n    if (micGain) micGain.gain.value = autoGain;\n  } else if (rms > 0.35 && autoGain > 1){\n    autoGain = Math.max(1, autoGain * 0.9);\n    if (micGain) micGain.gain.value = autoGain;\n  }\n\n  /* level meter: log scale, gate notch sits at 22% (see .levelgate) */\n  var bar = el(\"levelbar\");\n  if (bar){\n    var pct = maxAbs <= 0 ? 0 : Math.max(0, Math.min(100, (20*Math.log(maxAbs)/Math.LN10 + 60) / 60 * 100));\n    bar.style.width = pct.toFixed(1) + \"%\";\n    bar.className = \"levelbar\" + (rms < GATE ? \" faint\" : \"\");\n  }\n\n  if (liveSeen) return;\n  if (maxAbs < 1e-4){\n    faintFrames = 0;\n    deadFrames++;\n    if (deadFrames === 180){   /* ~6s of true zero signal */\n      el(\"micmsg\").textContent = \"The mic connected but no sound is reaching it at all. Check Microphone under the springboard's gear menu → “Allow apps to use”, then reopen — or tune by ear with the reference tones below.\";\n    }\n  } else if (rms < GATE){\n    deadFrames = 0;\n    faintFrames++;\n    if (faintFrames === 240){  /* ~8s of audible-but-unusable input */\n      el(\"micmsg\").textContent = \"I can hear something, but it's far too quiet to read a pitch from. Move the phone closer to the strings and play a single note firmly.\";\n    }\n  } else {\n    liveSeen = true;\n    if (deadFrames >= 180 || faintFrames >= 240) el(\"micmsg\").textContent = \"Play a string…\";\n    deadFrames = 0; faintFrames = 0;\n  }\n}\n\n/* autocorrelation pitch detector (ACF2+, after Chris Wilson's pitch-detect) */\nfunction autoCorrelate(b, sampleRate){\n  var SIZE = b.length, rms = 0, i, j;\n  for (i = 0; i < SIZE; i++) rms += b[i]*b[i];\n  rms = Math.sqrt(rms / SIZE);\n  if (rms < GATE) return -1;\n\n  var r1 = 0, r2 = SIZE - 1, thres = 0.2;\n  for (i = 0; i < SIZE/2; i++) if (Math.abs(b[i]) < thres){ r1 = i; break; }\n  for (i = 1; i < SIZE/2; i++) if (Math.abs(b[SIZE-i]) < thres){ r2 = SIZE - i; break; }\n  b = b.slice(r1, r2);\n  SIZE = b.length;\n  if (SIZE < 400) return -1;\n\n  /* only correlate lags in the guitar's range (55–1600 Hz) — keeps 4096-sample\n     windows cheap enough for realtime */\n  var maxLag = Math.min(SIZE - 1, Math.ceil(sampleRate / 55));\n  var c = new Float32Array(maxLag + 1);\n  for (i = 0; i <= maxLag; i++)\n    for (j = 0; j < SIZE - i; j++)\n      c[i] += b[j] * b[j+i];\n\n  var d = 0; while (d < maxLag && c[d] > c[d+1]) d++;\n  var maxval = -1, maxpos = -1;\n  for (i = d; i <= maxLag; i++){\n    if (c[i] > maxval){ maxval = c[i]; maxpos = i; }\n  }\n  if (maxpos <= 0) return -1;\n  var T0 = maxpos;\n  var x1 = c[T0-1], x2 = c[T0], x3 = c[T0+1] || x2;\n  var a = (x1 + x3 - 2*x2) / 2, bb = (x3 - x1) / 2;\n  if (a) T0 = T0 - bb / (2*a);\n  return sampleRate / T0;\n}\n\nfunction median(arr){\n  var s = arr.slice().sort(function(a,b){ return a-b; });\n  return s[Math.floor(s.length/2)];\n}\n\nvar frameFlip = false;\nfunction loop(){\n  rafId = requestAnimationFrame(loop);\n  if (!analyser) return;\n  frameFlip = !frameFlip;\n  if (!frameFlip) return;   /* detect at ~30fps — plenty for a needle, half the CPU */\n  analyser.getFloatTimeDomainData(buf);\n  var maxAbs = 0, sq = 0, n = 0;\n  for (var k = 0; k < buf.length; k += 8){ var av = Math.abs(buf[k]); if (av > maxAbs) maxAbs = av; sq += buf[k]*buf[k]; n++; }\n  var rms = Math.sqrt(sq / (n || 1));\n  watchSignal(maxAbs, rms);\n  var f = autoCorrelate(buf, actx.sampleRate);\n  if (f > 55 && f < 1600){\n    recent.push(f);\n    if (recent.length > 7) recent.shift();\n    if (recent.length >= 3) showPitch(median(recent));\n  } else {\n    if (recent.length) recent.shift();\n    if (!recent.length) showSilence();\n  }\n}\n\nfunction showPitch(f){\n  var midiF = 69 + 12 * Math.log(f / a4) / Math.LN2;\n  var nearest = Math.round(midiF);\n  var cents = (midiF - nearest) * 100;\n  el(\"note\").innerHTML = noteName(nearest).replace(\"#\",\"<sup>♯</sup>\") + \"<sup>\" + octaveOf(nearest) + \"</sup>\";\n  var good = Math.abs(cents) < 5;\n  el(\"cents\").textContent = good ? \"in tune\" : (cents > 0 ? \"+\" : \"\") + Math.round(cents) + \" cents — tune \" + (cents > 0 ? \"down\" : \"up\");\n  el(\"cents\").className = \"cents\" + (good ? \" good\" : \"\");\n  el(\"freq\").textContent = f.toFixed(1) + \" Hz\";\n  var deg = Math.max(-45, Math.min(45, cents * 0.9));\n  el(\"needle\").style.transform = \"rotate(\" + deg + \"deg)\";\n  el(\"needle\").className = \"needle\" + (good ? \" good\" : \"\");\n  el(\"hub\").className = \"hub\" + (good ? \" good\" : \"\");\n  if (good && !lockGood){ lockGood = true; haptic(\"success\"); }\n  if (!good) lockGood = false;\n\n  /* highlight nearest target string */\n  var bestI = -1, bestD = 1e9;\n  preset.midi.forEach(function(m, i){\n    var d = Math.abs(Math.log(f / midiFreq(m)));\n    if (d < bestD){ bestD = d; bestI = i; }\n  });\n  renderStrings(bestI, good);\n}\nfunction showSilence(){\n  el(\"note\").textContent = \"—\";\n  el(\"cents\").textContent = \"\";\n  el(\"cents\").className = \"cents\";\n  el(\"freq\").textContent = \"\";\n  el(\"needle\").style.transform = \"rotate(0deg)\";\n  el(\"needle\").className = \"needle\";\n  el(\"hub\").className = \"hub\";\n  lockGood = false;\n  renderStrings(-1, false);\n}\n\n/* ---- strings + reference tones ---- */\nvar playingI = -1, toneNodes = null;\n\nfunction renderStrings(nearI, good){\n  el(\"strings\").innerHTML = preset.midi.map(function(m, i){\n    var cls = i === playingI ? \" playing\" : (i === nearI ? (good ? \" good\" : \" near\") : \"\");\n    return '<button class=\"str' + cls + '\" onclick=\"playRef(' + i + ')\"><b>' + noteName(m) + '</b><small>' +\n      midiFreq(m).toFixed(1) + '</small></button>';\n  }).join(\"\");\n}\n\nfunction playRef(i){\n  haptic(\"selection\");\n  stopTone();\n  var ctx = ensureCtx();\n  var f = midiFreq(preset.midi[i]);\n  var o1 = ctx.createOscillator(), o2 = ctx.createOscillator(), g = ctx.createGain();\n  o1.type = \"triangle\"; o1.frequency.value = f;\n  o2.type = \"sine\"; o2.frequency.value = f * 2;   /* faint octave for a pluckier voice */\n  var g2 = ctx.createGain(); g2.gain.value = 0.18;\n  o1.connect(g); o2.connect(g2); g2.connect(g);\n  g.connect(ctx.destination);\n  var t = ctx.currentTime;\n  g.gain.setValueAtTime(0.0001, t);\n  g.gain.exponentialRampToValueAtTime(0.5, t + 0.02);\n  g.gain.exponentialRampToValueAtTime(0.0001, t + 2.4);\n  o1.start(t); o2.start(t);\n  o1.stop(t + 2.5); o2.stop(t + 2.5);\n  toneNodes = {o1:o1, o2:o2, g:g};\n  playingI = i;\n  renderStrings(-1, false);\n  o1.onended = function(){ if (playingI === i){ playingI = -1; renderStrings(-1, false); } };\n}\nfunction stopTone(){\n  if (toneNodes){ try{ toneNodes.o1.stop(); toneNodes.o2.stop(); }catch(_){} toneNodes = null; }\n  playingI = -1;\n}\n\n/* ---- options ---- */\nfunction renderPreset(){\n  el(\"preset\").innerHTML = PRESETS.map(function(p){\n    return '<option value=\"' + p.id + '\"' + (p.id === preset.id ? \" selected\" : \"\") + '>' + p.name + '</option>';\n  }).join(\"\");\n  el(\"a4\").textContent = \"A4 \" + a4 + \" Hz\";\n  renderStrings(-1, false);\n}\nfunction setPreset(){\n  var id = el(\"preset\").value;\n  preset = PRESETS.filter(function(p){ return p.id === id; })[0] || PRESETS[0];\n  haptic(\"selection\");\n  store.setItem(\"tuner\", JSON.stringify({preset:preset.id, a4:a4}));\n  renderStrings(-1, false);\n}\nfunction calib(dir){\n  a4 = Math.max(430, Math.min(450, a4 + dir));\n  el(\"a4\").textContent = \"A4 \" + a4 + \" Hz\";\n  haptic(\"selection\");\n  store.setItem(\"tuner\", JSON.stringify({preset:preset.id, a4:a4}));\n  renderStrings(-1, false);\n}\n\n/* ================= METRONOME =================\n   Web Audio lookahead scheduler (25ms timer, 0.12s horizon) */\nvar mOn = false, bpm = 100, beatsPerBar = 4, beatIdx = 0, nextT = 0, mTimer = null;\nvar taps = [];\n\nfunction setBpm(v){\n  bpm = Math.max(30, Math.min(240, v));\n  el(\"bpmval\").textContent = bpm;\n  el(\"bpmslider\").value = bpm;\n  store.setItem(\"metro\", JSON.stringify({bpm:bpm, beats:beatsPerBar}));\n}\nfunction renderSig(){\n  var opts = [1,2,3,4,5,6,7];\n  el(\"sig\").innerHTML = opts.map(function(n){\n    return '<button class=\"' + (n === beatsPerBar ? \"on\" : \"\") + '\" onclick=\"setSig(' + n + ')\">' + n + '</button>';\n  }).join(\"\");\n  el(\"beats\").innerHTML = Array.apply(null, Array(beatsPerBar)).map(function(){\n    return '<div class=\"beat\"></div>';\n  }).join(\"\");\n}\nfunction setSig(n){\n  beatsPerBar = n; beatIdx = 0;\n  haptic(\"selection\"); renderSig();\n  store.setItem(\"metro\", JSON.stringify({bpm:bpm, beats:beatsPerBar}));\n}\nfunction click(t, accent){\n  var ctx = ensureCtx();\n  var o = ctx.createOscillator(), g = ctx.createGain();\n  o.type = \"square\";\n  o.frequency.value = accent ? 1400 : 900;\n  o.connect(g); g.connect(ctx.destination);\n  g.gain.setValueAtTime(0.0001, t);\n  g.gain.exponentialRampToValueAtTime(accent ? 0.6 : 0.4, t + 0.002);\n  g.gain.exponentialRampToValueAtTime(0.0001, t + 0.05);\n  o.start(t); o.stop(t + 0.06);\n}\nfunction scheduler(){\n  var ctx = ensureCtx();\n  while (nextT < ctx.currentTime + 0.12){\n    var accent = (beatIdx % beatsPerBar) === 0;\n    click(nextT, accent);\n    flashBeat(beatIdx % beatsPerBar, accent, (nextT - ctx.currentTime) * 1000);\n    nextT += 60 / bpm;\n    beatIdx++;\n  }\n}\nfunction flashBeat(i, accent, delayMs){\n  setTimeout(function(){\n    var dots = el(\"beats\").children;\n    for (var k = 0; k < dots.length; k++) dots[k].className = \"beat\";\n    if (dots[i]) dots[i].className = \"beat hit\" + (accent ? \" acc\" : \"\");\n  }, Math.max(0, delayMs));\n}\nfunction toggleMetro(){\n  haptic(\"light\");\n  if (mOn){\n    mOn = false;\n    clearInterval(mTimer); mTimer = null;\n    el(\"playbtn\").textContent = \"Start\"; el(\"playbtn\").className = \"playbtn\";\n  } else {\n    var ctx = ensureCtx();\n    mOn = true; beatIdx = 0; nextT = ctx.currentTime + 0.08;\n    mTimer = setInterval(scheduler, 25);\n    el(\"playbtn\").textContent = \"Stop\"; el(\"playbtn\").className = \"playbtn on\";\n  }\n}\nfunction tapTempo(){\n  haptic(\"selection\");\n  var now = Date.now();\n  if (taps.length && now - taps[taps.length-1] > 2200) taps = [];\n  taps.push(now);\n  if (taps.length > 5) taps.shift();\n  if (taps.length >= 2){\n    var iv = 0;\n    for (var i = 1; i < taps.length; i++) iv += taps[i] - taps[i-1];\n    iv /= (taps.length - 1);\n    setBpm(Math.round(60000 / iv));\n  }\n}\n\n/* ================= tabs + boot ================= */\nfunction showTab(which){\n  haptic(\"selection\");\n  el(\"paneTune\").style.display = which === \"tune\" ? \"block\" : \"none\";\n  el(\"paneMetro\").style.display = which === \"metro\" ? \"block\" : \"none\";\n  el(\"tabTune\").className = which === \"tune\" ? \"on\" : \"\";\n  el(\"tabMetro\").className = which === \"metro\" ? \"on\" : \"\";\n  if (which === \"metro\" && rafId){ /* keep tuner running; it's cheap and users flip back */ }\n}\n\nPromise.all([store.getItem(\"tuner\"), store.getItem(\"metro\")]).then(function(vals){\n  if (vals[0]){ try{\n    var t = JSON.parse(vals[0]);\n    if (t.a4) a4 = t.a4;\n    var p = PRESETS.filter(function(x){ return x.id === t.preset; })[0];\n    if (p) preset = p;\n  }catch(e){} }\n  if (vals[1]){ try{\n    var m = JSON.parse(vals[1]);\n    if (m.bpm) bpm = m.bpm;\n    if (m.beats) beatsPerBar = m.beats;\n  }catch(e){} }\n  setBpm(bpm);\n  renderPreset();\n  renderSig();\n});\n\n/* draw dial ticks */\n(function(){\n  var dial = el(\"dial\");\n  for (var c = -50; c <= 50; c += 10){\n    var t = document.createElement(\"div\");\n    t.className = \"tick\" + (c === 0 ? \" mid\" : \"\");\n    t.style.transform = \"rotate(\" + (c * 0.9) + \"deg)\";\n    t.innerHTML = \"<i></i>\";\n    dial.insertBefore(t, el(\"needle\"));\n  }\n})();\n</script>\n</body>\n</html>\n"}