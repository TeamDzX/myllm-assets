{"name": "Mac Shortcuts", "kind": "html", "iconSymbol": "keyboard", "iconColor": "gray", "html": "<!DOCTYPE html>\n<!--\n  Mac Shortcuts — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>Mac Shortcuts</title>\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<style>\n*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}\n:root{--build-id:\"3cffa8697c\";--bg:#f3f1ec;--panel:#fff;--panel2:#ece9e2;--line:#dcd8cf;--ink:#1c1b19;--dim:#6b675f;--acc:#c2410c;--accbg:#ffedd5;--key1:#fff;--key2:#e9e6df;--keyb:#bdb8ad;--code:#1f2328;--codeink:#e6edf3;--ok:#15803d;--bad:#b91c1c;--sat:env(safe-area-inset-top);--sab:env(safe-area-inset-bottom);--ui:system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;--mono:ui-monospace,\"SF Mono\",Menlo,Consolas,monospace;--grain:0.547710419366}\n@media (prefers-color-scheme:dark){:root{--bg:#141415;--panel:#1e1e20;--panel2:#28282b;--line:#343438;--ink:#f1efea;--dim:#a19d94;--acc:#fb923c;--accbg:#3a2412;--key1:#3a3a3e;--key2:#2a2a2d;--keyb:#0c0c0d;--code:#0d0f12;--codeink:#e6edf3;--ok:#4ade80;--bad:#f87171}}\nhtml,body{height:100%;background:var(--bg);color:var(--ink);font-family:var(--ui);font-size:15px;line-height:1.42;overflow:hidden;-webkit-text-size-adjust:100%}\nbutton,input{font:inherit;color:inherit}\nbutton{cursor:pointer;-webkit-user-select:none;user-select:none}\n#app{display:flex;flex-direction:column;height:100%;max-width:680px;margin:0 auto}\nheader{flex:none;padding:calc(10px + var(--sat)) 14px 8px}\n.top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:8px}\n.top h1{font-size:19px;font-weight:800;letter-spacing:-.01em}\n.top h1 span{color:var(--acc)}\n.hb{display:flex;gap:8px}\n.ib{min-width:40px;height:40px;border-radius:12px;border:1px solid var(--line);background:var(--panel);font-weight:700;color:var(--dim);padding:0 10px;font-size:14px}\n.ib.on{background:var(--accbg);border-color:var(--acc);color:var(--acc)}\n#q{width:100%;height:44px;border-radius:12px;border:1px solid var(--line);background:var(--panel);padding:0 14px;font-size:16px;outline:none}\n#q:focus{border-color:var(--acc)}\n#chips{display:flex;gap:7px;overflow-x:auto;padding:9px 0 1px;scrollbar-width:none}\n#chips::-webkit-scrollbar{display:none}\n.chip{flex:none;min-height:34px;padding:4px 12px;border-radius:17px;border:1px solid var(--line);background:var(--panel);font-size:13px;font-weight:600;color:var(--dim);white-space:nowrap}\n.chip.on{background:var(--ink);border-color:var(--ink);color:var(--bg)}\nmain{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:4px 14px 24px;overscroll-behavior:contain}\nnav{flex:none;display:flex;border-top:1px solid var(--line);background:var(--panel);padding:5px 6px calc(5px + var(--sab))}\nnav button{flex:1;background:none;border:0;padding:7px 2px 5px;font-size:10.5px;font-weight:700;letter-spacing:.04em;color:var(--dim);min-height:50px;border-radius:10px}\nnav button svg{display:block;margin:0 auto 3px;width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}\nnav button.on{color:var(--acc)}\nh2.g{font-size:11.5px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--dim);margin:18px 2px 8px}\n.grp{background:var(--panel);border:1px solid var(--line);border-radius:14px;overflow:hidden}\n.it{display:grid;grid-template-columns:1fr auto;gap:4px 8px;padding:11px 6px 11px 13px;border-bottom:1px solid var(--line);align-items:start}\n.it:last-child{border-bottom:0}\n.it .tx{min-width:0}\n.it b.t{display:block;font-size:15px;font-weight:650}\n.it p{font-size:13.5px;color:var(--dim);margin-top:3px}\n.keys{display:flex;flex-wrap:wrap;gap:4px;align-items:center;margin-top:7px}\nkbd{display:inline-flex;align-items:center;justify-content:center;min-width:30px;height:30px;padding:0 8px;border-radius:7px;background:linear-gradient(var(--key1),var(--key2));border:1px solid var(--keyb);border-bottom-width:3px;font-family:var(--ui);font-size:15px;font-weight:600;color:var(--ink);white-space:nowrap}\nkbd.w{font-size:12.5px}\n.keys i{font-style:normal;font-size:12.5px;color:var(--dim);padding:0 2px}\n.star{width:40px;height:40px;border:0;background:none;font-size:19px;color:var(--line);line-height:1}\n.star.on{color:var(--acc)}\n.how{cursor:pointer}\n.how .more{display:none;grid-column:1/-1;padding-right:8px}\n.how.open .more{display:block}\n.how b.t:after{content:\"\\203A\";display:inline-block;margin-left:7px;color:var(--dim);transition:transform .15s}\n.how.open b.t:after{transform:rotate(90deg)}\n.more h4{font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--acc);margin:12px 0 5px}\n.more ol{padding-left:20px;font-size:14px}\n.more ol li{margin-bottom:5px}\n.more p.n{color:var(--ink);font-size:14px}\npre{position:relative;background:var(--code);color:var(--codeink);font-family:var(--mono);font-size:12.5px;line-height:1.45;border-radius:9px;padding:10px 12px;margin:8px 0 4px;white-space:pre-wrap;word-break:break-word;-webkit-user-select:all;user-select:all}\n.cp{display:inline-block;margin:2px 0 4px;min-height:34px;padding:4px 12px;border-radius:9px;border:1px solid var(--line);background:var(--panel2);font-size:12.5px;font-weight:700}\n.path{display:inline-block;font-size:12.5px;font-weight:650;color:var(--acc);background:var(--accbg);border-radius:6px;padding:2px 7px;margin-top:6px}\n.empty{text-align:center;color:var(--dim);padding:44px 20px;font-size:14.5px}\n.card{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:16px;margin-top:12px}\n#quiz .qq{font-size:19px;font-weight:750;margin:6px 0 4px;line-height:1.25}\n#quiz .sub{font-size:13px;color:var(--dim)}\n.opt{display:flex;align-items:center;gap:6px;flex-wrap:wrap;width:100%;min-height:54px;margin-top:10px;padding:9px 12px;border-radius:12px;border:1px solid var(--line);background:var(--panel2);text-align:left}\n.opt.ok{border-color:var(--ok);box-shadow:inset 0 0 0 1px var(--ok)}\n.opt.no{border-color:var(--bad);box-shadow:inset 0 0 0 1px var(--bad)}\n.score{display:flex;gap:8px;margin-top:4px}\n.score div{flex:1;background:var(--panel2);border-radius:10px;padding:8px;text-align:center}\n.score b{display:block;font-size:20px;font-family:var(--mono)}\n.score span{font-size:11px;color:var(--dim)}\n.pbtn{display:block;width:100%;min-height:48px;margin-top:12px;border-radius:12px;border:0;background:var(--acc);color:#fff;font-weight:750;font-size:15px}\n@media (prefers-color-scheme:dark){.pbtn{color:#1a0e04}}\n.sheet{position:fixed;inset:0;z-index:20;background:rgba(0,0,0,.55);display:flex;align-items:flex-end;justify-content:center}\n.sheet .in{width:100%;max-width:680px;max-height:86%;overflow-y:auto;background:var(--bg);border-radius:18px 18px 0 0;padding:18px 16px calc(18px + var(--sab))}\n.sheet h3{font-size:18px;margin-bottom:10px}\n.leg{display:grid;grid-template-columns:auto 1fr;gap:9px 12px;align-items:center;font-size:14.5px}\n.sheet p{font-size:13.5px;color:var(--dim);margin-top:12px}\n/* wide screens (Mac window, iPad): sidebar nav, search bar across the top, entries in columns */\n@media (min-width:900px){\n#app{max-width:none;display:grid;grid-template-columns:212px minmax(0,1fr);grid-template-rows:auto minmax(0,1fr)}\nheader{grid-column:2;grid-row:1;display:flex;flex-wrap:wrap;align-items:center;gap:10px 14px;padding:calc(16px + var(--sat)) 28px 10px}\n.top{display:contents}\n.top h1{display:none}\n#q{order:1;flex:1 1 320px;max-width:560px}\n.hb{order:2;margin-left:auto}\n#chips{order:3;flex:1 0 100%;flex-wrap:wrap;overflow:visible;padding:2px 0 0}\nmain{grid-column:2;grid-row:2;padding:4px 28px 32px}\nnav{grid-column:1;grid-row:1/3;flex-direction:column;gap:3px;overflow-y:auto;border-top:0;border-right:1px solid var(--line);padding:calc(16px + var(--sat)) 10px calc(16px + var(--sab))}\nnav:before{content:\"Mac Shortcuts\";flex:none;font-size:19px;font-weight:800;letter-spacing:-.01em;padding:6px 10px 16px}\nnav button{flex:none;display:flex;align-items:center;gap:11px;min-height:42px;padding:8px 10px;font-size:14px;font-weight:650;letter-spacing:0;text-align:left}\nnav button svg{margin:0;flex:none;width:20px;height:20px}\nnav button.on{background:var(--accbg)}\n.grp{display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));grid-auto-flow:dense}\n.it,.it:last-child{border-bottom:0;box-shadow:1px 0 0 var(--line),0 1px 0 var(--line)}\n.how.open{grid-column:1/-1}\n.how .more{max-width:760px}\n#quiz{max-width:760px;margin:0 auto}\n#opts{display:grid;grid-template-columns:1fr 1fr;gap:0 12px}\n.sheet{align-items:center}\n.sheet .in{max-width:560px;max-height:80%;border-radius:18px;padding-bottom:18px}\n}\n@media (hover:hover){nav button:hover,.chip:hover,.ib:hover{border-color:var(--acc)}nav button:hover{background:var(--panel2)}nav button.on:hover{background:var(--accbg)}}\n.hidden{display:none!important}\n</style>\n</head>\n<body>\n<div id=\"app\">\n<header>\n  <div class=\"top\"><h1>Mac <span>Shortcuts</span></h1><div class=\"hb\"><button class=\"ib\" id=\"bSaved\" type=\"button\" aria-label=\"Show saved\">&#9733; Saved</button><button class=\"ib\" id=\"bLeg\" type=\"button\" aria-label=\"Key symbols\">&#8984;?</button></div></div>\n  <input id=\"q\" type=\"search\" placeholder=\"Search: screenshot, hidden files, rename...\" autocomplete=\"off\" autocorrect=\"off\" autocapitalize=\"off\" spellcheck=\"false\" aria-label=\"Search\">\n  <div id=\"chips\"></div>\n</header>\n<main id=\"main\"><div id=\"list\"></div>\n<div id=\"quiz\" class=\"hidden\">\n  <div class=\"card\">\n    <div class=\"score\"><div><b id=\"sNow\">0</b><span>in a row</span></div><div><b id=\"sBest\">0</b><span>best run</span></div><div><b id=\"sTot\">0</b><span>answered</span></div></div>\n  </div>\n  <div class=\"card\"><div class=\"sub\">Which keys do this?</div><div class=\"qq\" id=\"qq\"></div><div id=\"opts\"></div><button class=\"pbtn hidden\" id=\"qNext\" type=\"button\">Next</button></div>\n</div>\n</main>\n<nav id=\"nav\">\n  <button data-t=\"keys\" class=\"on\" type=\"button\"><svg viewBox=\"0 0 24 24\"><rect x=\"2.5\" y=\"6\" width=\"19\" height=\"12\" rx=\"2.5\"/><path d=\"M6.5 10h.01M10 10h.01M13.5 10h.01M17 10h.01M7 14h10\"/></svg>Keys</button>\n  <button data-t=\"finder\" type=\"button\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 7.5A2.5 2.5 0 0 1 5.5 5H10l2 2.5h6.5A2.5 2.5 0 0 1 21 10v6.5a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 16.5z\"/></svg>Finder</button>\n  <button data-t=\"how\" type=\"button\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 4.5h10l4 4V19.5H5z\"/><path d=\"M8.5 12h7M8.5 15.5h5\"/></svg>How to</button>\n  <button data-t=\"gems\" type=\"button\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3l2.2 5.6L20 9.3l-4.4 3.9 1.3 5.8-4.9-3-4.9 3 1.3-5.8L4 9.3l5.8-.7z\"/></svg>Gems</button>\n  <button data-t=\"quiz\" type=\"button\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M9.5 9.5a2.5 2.5 0 1 1 3.6 2.2c-.7.4-1.1 1-1.1 1.8M12 17h.01\"/></svg>Practise</button>\n</nav>\n</div>\n\n<div class=\"sheet hidden\" id=\"legSheet\"><div class=\"in\">\n  <h3>Key symbols</h3>\n  <div class=\"leg\" id=\"legGrid\"></div>\n  <p>On a Windows-style keyboard, Option is the Alt key and Command is the Windows key. Some keyboards have a Globe key in place of fn; they do the same job.</p>\n  <p>Written for macOS 15 Sequoia and macOS 26 Tahoe. Nearly everything also works on older versions; items that need a recent version say so. Symbol shortcuts are for US and British keyboard layouts.</p>\n  <button class=\"pbtn\" id=\"legClose\" type=\"button\">Done</button>\n</div></div>\n\n<script>\n(function(){\n'use strict';\nvar $=function(id){return document.getElementById(id);};\nfunction el(tag,cls,txt){var e=document.createElement(tag);if(cls)e.className=cls;if(txt!=null)e.textContent=txt;return e;}\n\n/* ---------------- content ----------------\n   K: [group, keys, title, note]   keys: tokens separated by spaces; lower-case joining words stay as text */\nvar K=[\n['Essentials','⌘ C','Copy'],\n['Essentials','⌘ X','Cut','For text. To move files, see Finder.'],\n['Essentials','⌘ V','Paste'],\n['Essentials','⌥ ⇧ ⌘ V','Paste and match style','Pastes plain text without the font, size and colour it was copied with.'],\n['Essentials','⌘ Z','Undo'],\n['Essentials','⇧ ⌘ Z','Redo'],\n['Essentials','⌘ A','Select all'],\n['Essentials','⌘ F','Find'],\n['Essentials','⌘ G','Find the next match','Add Shift for the previous one.'],\n['Essentials','⌘ S','Save'],\n['Essentials','⌥ ⇧ ⌘ S','Save As','In apps that normally only offer Duplicate.'],\n['Essentials','⌘ P','Print'],\n['Essentials','⌘ ,','Open the current app’s settings'],\n['Essentials','⌘ Space','Spotlight search','Also a calculator and a unit and currency converter: type 12*7 or 30 miles in km.'],\n['Essentials','⌃ ⌘ Space','Emoji and symbols'],\n['Essentials','⇧ ⌘ /','Search every menu command','Opens the Help menu search. Type a command name and press Return to run it.'],\n['Windows and apps','⌘ Tab','Switch between apps','Keep ⌘ held and press Q to quit or H to hide the highlighted app.'],\n['Windows and apps','⌘ `','Switch between windows of the same app'],\n['Windows and apps','⌘ W','Close the window or tab'],\n['Windows and apps','⌥ ⌘ W','Close all windows of the app'],\n['Windows and apps','⌘ Q','Quit the app'],\n['Windows and apps','⌘ H','Hide the app'],\n['Windows and apps','⌥ ⌘ H','Hide every other app'],\n['Windows and apps','⌘ M','Minimise the window to the Dock'],\n['Windows and apps','⌃ ⌘ F','Full screen on or off'],\n['Windows and apps','⌥ ⌘ Esc','Force quit a frozen app'],\n['Windows and apps','⌥ ⌘ D','Show or hide the Dock'],\n['Windows and apps','⌃ ↑','Mission Control: see every open window'],\n['Windows and apps','⌃ ↓','Show all windows of the current app'],\n['Windows and apps','⌃ ← or ⌃ →','Move between desktops (Spaces)'],\n['Windows and apps','fn F11','Show the desktop','Press again to bring the windows back. fn H does the same.'],\n['Windows and apps','fn ⌃ ←','Tile the window to the left half','Use the other arrows for right, top and bottom. macOS 15 or later.'],\n['Windows and apps','fn ⌃ F','Make the window fill the screen','Not full screen: the menu bar and Dock stay. macOS 15 or later.'],\n['Windows and apps','fn ⌃ C','Centre the window','macOS 15 or later.'],\n['Windows and apps','fn ⌃ R','Return the window to its previous size','macOS 15 or later.'],\n['Windows and apps','fn Q','Quick Note','Start a note from anywhere.'],\n['Windows and apps','fn C','Control Centre'],\n['Windows and apps','fn N','Notification Centre'],\n['Text','⌘ ← or ⌘ →','Jump to the start or end of the line','Add Shift to select as you go. This works with every movement key below.'],\n['Text','⌘ ↑ or ⌘ ↓','Jump to the top or bottom of the document'],\n['Text','⌥ ← or ⌥ →','Move one word at a time'],\n['Text','⌥ Delete','Delete the word to the left'],\n['Text','⌘ Delete','Delete back to the start of the line'],\n['Text','fn Delete','Delete forwards','For keyboards without a forward delete key.'],\n['Text','⌃ K','Delete from the cursor to the end of the line'],\n['Text','⌃ A or ⌃ E','Start or end of the paragraph'],\n['Text','⌃ T','Swap the two letters either side of the cursor'],\n['Text','⌘ B','Bold','⌘ I for italic, ⌘ U for underline.'],\n['Text','⌘ K','Add a link','In most writing apps.'],\n['Text','⌃ ⌘ D','Look up the word under the pointer','Dictionary, Wikipedia and translation.'],\n['Text','⌘ ;','Find the next misspelled word'],\n['Text','fn D','Start dictation','Or the microphone key. Set under System Settings > Keyboard.'],\n['Screenshots','⇧ ⌘ 3','Capture the whole screen'],\n['Screenshots','⇧ ⌘ 4','Capture an area you drag','While dragging, hold Space to move the box, or Option to resize it from the centre.'],\n['Screenshots','⇧ ⌘ 4 then Space','Capture one window','Hold Option as you click to leave out the window shadow.'],\n['Screenshots','⇧ ⌘ 5','Screenshot and screen recording toolbar','Options sets where files are saved, a timer and the microphone.'],\n['Screenshots','⌃ ⇧ ⌘ 4','Capture an area to the clipboard','Adding Control to any screenshot shortcut copies it and saves no file.'],\n['Symbols','⌥ 2','€ on a British keyboard, ™ on a US one'],\n['Symbols','⌥ ⇧ 2','€ on a US keyboard'],\n['Symbols','⌥ 3','# on a British keyboard, £ on a US one'],\n['Symbols','⌥ ;','… ellipsis'],\n['Symbols','⌥ -','– en dash','Add Shift for the long em dash.'],\n['Symbols','⌥ 8','• bullet'],\n['Symbols','⌥ ⇧ 8','° degree sign'],\n['Symbols','⌥ G','© copyright','⌥ R gives ®.'],\n['Symbols','⌥ E then E','é acute accent','⌥ E, then the letter. ⌥ ` for grave, ⌥ U for umlaut, ⌥ I for circumflex, ⌥ N for tilde.'],\n['Symbols','⌥ C','ç cedilla'],\n['Symbols','⌥ P','π pi','⌥ V gives √, ⌥ = gives ≠, ⌥ 5 gives ∞, ⌥ / gives ÷.'],\n['Symbols','⌥ ⇧ =','± plus or minus'],\n['Safari','⌘ L','Jump to the address bar'],\n['Safari','⌘ T','New tab'],\n['Safari','⇧ ⌘ T','Reopen the tab you just closed'],\n['Safari','⇧ ⌘ N','New private window'],\n['Safari','⌃ Tab','Next tab','Add Shift to go back.'],\n['Safari','⌘ 1','Go to the first tab','⌘ 2 to ⌘ 8 for the others, ⌘ 9 for the last.'],\n['Safari','⌘ R','Reload the page'],\n['Safari','⇧ ⌘ R','Reader view','Strips a page down to its text.'],\n['Safari','⇧ ⌘ D','Add the page to Reading List'],\n['Safari','Space','Scroll down one screen','Shift Space scrolls back up.'],\n['Safari','⌘ +','Zoom in','⌘ - zooms out, ⌘ 0 resets.'],\n['Lock, sleep and start-up','⌃ ⌘ Q','Lock the screen'],\n['Lock, sleep and start-up','⇧ ⌘ Q','Log out'],\n['Lock, sleep and start-up','⌃ ⌘ Power','Force a restart','When the Mac is completely frozen. On a laptop with Touch ID, hold the Touch ID button for 10 seconds instead. Unsaved work is lost.'],\n['Accessibility','⌥ ⌘ F5','Accessibility shortcuts panel','Or press Touch ID three times.'],\n['Accessibility','⌘ F5','VoiceOver on or off'],\n['Accessibility','⌥ ⌘ 8','Zoom the screen on or off','Turn on first under System Settings > Accessibility > Zoom.'],\n['Accessibility','⌃ F2','Move the keyboard focus to the menu bar','Then use the arrow keys. You may need to hold fn as well.']\n];\nvar F=[\n['Files','⇧ ⌘ N','New folder'],\n['Files','⌃ ⌘ N','New folder containing the selected items'],\n['Files','Return','Rename the selected item'],\n['Files','Space','Quick Look: preview without opening','Works on almost anything. Arrow keys move to the next file.'],\n['Files','⌘ D','Duplicate'],\n['Files','⌘ I','Get Info','⌥ ⌘ I opens one panel that follows your selection.'],\n['Files','⌘ C then ⌥ ⌘ V','Move a file (cut and paste)','Copy as usual, then paste with Option held to move instead of copy.'],\n['Files','⌥ ⌘ C','Copy the file’s full path'],\n['Files','⌘ Delete','Move to the Trash'],\n['Files','⌥ ⌘ Delete','Delete immediately, skipping the Trash'],\n['Files','⇧ ⌘ Delete','Empty the Trash'],\n['Files','⌘ ↓','Open the selected item','⌘ ↑ goes up to the folder that contains this one.'],\n['Files','⌘ [','Back','⌘ ] goes forward.'],\n['Files','⌘ E','Eject the selected disk'],\n['Files','⌃ ⌘ T','Add the selected folder to the sidebar'],\n['Files','⌥ drag','Copy instead of move','⌘ drag moves instead of copying between disks. ⌥ ⌘ drag makes an alias.'],\n['Go to','⇧ ⌘ G','Go to Folder: type any path','Type ~ for your home folder or / for the top of the disk. Tab completes names.'],\n['Go to','⇧ ⌘ H','Home folder'],\n['Go to','⇧ ⌘ D','Desktop'],\n['Go to','⇧ ⌘ O','Documents'],\n['Go to','⌥ ⌘ L','Downloads'],\n['Go to','⇧ ⌘ A','Applications'],\n['Go to','⇧ ⌘ U','Utilities'],\n['Go to','⇧ ⌘ I','iCloud Drive'],\n['Go to','⇧ ⌘ R','AirDrop'],\n['Go to','⌘ K','Connect to a server or shared computer'],\n['View','⇧ ⌘ .','Show or hide hidden files','Also works inside Open and Save windows.'],\n['View','⌘ 1','Icon view','⌘ 2 list, ⌘ 3 columns, ⌘ 4 gallery.'],\n['View','⌘ J','View options for this folder'],\n['View','⌥ ⌘ P','Show the path bar','The trail of folders along the bottom. Double-click any folder in it to go there.'],\n['View','⌘ /','Show the status bar','Item count and free disk space.'],\n['View','⇧ ⌘ P','Show the preview pane'],\n['View','⌥ ⌘ S','Show or hide the sidebar'],\n['View','⌘ T','New tab','⇧ ⌘ T shows the tab bar.'],\n['View','⌃ ⌘ 0','Tidy the desktop into stacks']\n];\n/* Finder settings: [group, where, title, note] */\nvar FS=[\n['Finder settings worth changing','Finder > Settings > Advanced','Show all filename extensions','See .jpg, .pdf, .txt on every file, so you always know what a file is.'],\n['Finder settings worth changing','Finder > Settings > Advanced','Search the current folder','Set “When performing a search” to Search the Current Folder. By default Finder searches the whole Mac.'],\n['Finder settings worth changing','Finder > Settings > Advanced','Keep folders on top','Folders first, then files, when sorting by name.'],\n['Finder settings worth changing','Finder > Settings > Advanced','Remove items from the Trash after 30 days','The Trash empties itself.'],\n['Finder settings worth changing','Finder > Settings > General','Choose what new windows show','Set “New Finder windows show” to your home folder or Documents instead of Recents.'],\n['Finder settings worth changing','Finder > Settings > General','Show disks on the desktop','Tick hard disks, external disks and connected servers.'],\n['Finder settings worth changing','Finder > Settings > Sidebar','Choose what is in the sidebar','Tick your home folder and Pictures. You can also drag any folder into the sidebar.'],\n['Finder settings worth changing','View menu','Show Path Bar and Show Status Bar','Two thin bars along the bottom: where you are, and how much space is free.'],\n['Finder settings worth changing','View > Show View Options (⌘ J)','Make one layout the default','Set the icon size, sort order and columns you like, then press Use as Defaults.'],\n['Finder settings worth changing','View > Show View Options (⌘ J)','Calculate all sizes','In list view, shows the size of folders as well as files.'],\n['Finder settings worth changing','Home folder, then ⌘ J','Show Library Folder','The Library folder is hidden by default. This tick box only appears in your home folder.'],\n['Finder settings worth changing','View > Customise Toolbar','Add buttons to the toolbar','Path, Get Info, New Folder, Delete. Hold ⌘ and drag any app or folder onto the toolbar for one-click access.'],\n['Finder settings worth changing','System Settings > Desktop & Dock','Click wallpaper to reveal desktop','Set to Only in Stage Manager if windows keep flying away when you click the desktop.']\n];\n/* Terminal tweaks: [title, note, command, undo] */\nvar TT=[\n['Always show hidden files','Same as pressing ⇧ ⌘ . but permanent.','defaults write com.apple.finder AppleShowAllFiles -bool true; killall Finder','defaults write com.apple.finder AppleShowAllFiles -bool false; killall Finder'],\n['Show the full path in the window title','','defaults write com.apple.finder _FXShowPosixPathInTitle -bool true; killall Finder','defaults delete com.apple.finder _FXShowPosixPathInTitle; killall Finder'],\n['Save screenshots as JPG instead of PNG','Much smaller files.','defaults write com.apple.screencapture type jpg; killall SystemUIServer','defaults delete com.apple.screencapture type; killall SystemUIServer'],\n['Remove the shadow from window screenshots','','defaults write com.apple.screencapture disable-shadow -bool true; killall SystemUIServer','defaults delete com.apple.screencapture disable-shadow; killall SystemUIServer'],\n['Stop .DS_Store files on network drives','Keeps shared folders clean for Windows users.','defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true','defaults delete com.apple.desktopservices DSDontWriteNetworkStores'],\n['Make the hidden Dock appear instantly','Removes the delay when the Dock is set to hide.','defaults write com.apple.dock autohide-delay -float 0; killall Dock','defaults delete com.apple.dock autohide-delay; killall Dock'],\n['Save new documents to the Mac, not iCloud','Changes where the Save window starts.','defaults write NSGlobalDomain NSDocumentSaveNewDocumentsToCloud -bool false','defaults delete NSGlobalDomain NSDocumentSaveNewDocumentsToCloud'],\n['Show your Library folder permanently','','chflags nohidden ~/Library','chflags hidden ~/Library']\n];\n/* How-tos: [title, summary, [ [heading, [steps], code?] ... ]] */\nvar H=[\n['Create a text file','Finder has no “New text file” command. Three ways round it.',[\n ['With TextEdit',['Open TextEdit and start a new document.','Choose Format > Make Plain Text (⇧ ⌘ T).','Save with ⌘ S. The file ends in .txt.','To make this the default: TextEdit > Settings > New Document > Plain text.']],\n ['With Terminal',['Open Terminal (⌘ Space, type Terminal).','Run the first command to create an empty file on the desktop.','Run the second to open it in TextEdit.'],'touch ~/Desktop/notes.txt\\nopen -e ~/Desktop/notes.txt'],\n ['Add “New Text File” to the right-click menu',['Open Automator and choose New Document > Quick Action.','Set “Workflow receives current” to folders, in Finder.','Add the action Run Shell Script and set “Pass input” to as arguments.','Replace the script with the line below.','Save it as New Text File.','Now right-click any folder and choose Quick Actions > New Text File.'],'touch \"$1/Untitled.txt\"']]],\n['Show hidden files and the Library folder','',[\n ['Hidden files',['In any Finder window press ⇧ ⌘ . (full stop).','Hidden items appear dimmed. Press again to hide them.']],\n ['The Library folder',['In Finder, open the Go menu.','Hold Option: Library appears in the list.']]]],\n['Move a file with cut and paste','⌘ X does not work on files.',[\n ['',['Select the file and press ⌘ C.','Go to the destination folder.','Press ⌥ ⌘ V. The file moves instead of being copied.']]]],\n['Copy a file’s path','',[\n ['',['Select the file and press ⌥ ⌘ C.','Or right-click it, hold Option, and choose Copy as Pathname.','In Terminal, simply drag the file into the window to type its path.']]]],\n['Rename many files at once','',[\n ['',['Select the files in Finder.','Right-click and choose Rename.','Pick Replace Text, Add Text or Format (name plus a number or date).','Press Rename. ⌘ Z undoes it.']]]],\n['Take screenshots and record the screen','',[\n ['',['Press ⇧ ⌘ 5 for the toolbar.','Choose whole screen, a window or an area; or one of the two record buttons.','Open Options to choose where files are saved, set a timer, or turn on the microphone.','Click the thumbnail that appears to crop or draw on it, or drag it straight into an email.']]]],\n['Put two windows side by side','',[\n ['macOS 15 or later',['Drag a window to the left or right edge of the screen until an outline appears, then let go.','Or hover over the green button and pick a layout.','Or press fn ⌃ ← and fn ⌃ →.']],\n ['Any version',['Hold the pointer on the green button of a window.','Choose Tile Window to Left of Screen, then click the second window.']]]],\n['Force quit a frozen app','',[\n ['',['Press ⌥ ⌘ Esc, select the app and click Force Quit.','Or hold Option and right-click its Dock icon: Quit becomes Force Quit.','If the whole Mac is frozen, hold the power button for 10 seconds.']]]],\n['Type accents, emoji and special characters','',[\n ['',['Hold a letter key (e, a, u, c, n) and pick the accented version by number.','Press ⌃ ⌘ Space for emoji and symbols. Type to search, for example “arrow”.','See Keys > Symbols for direct shortcuts such as €, #, ° and –.']]]],\n['Paste without the formatting','',[\n ['',['Press ⌥ ⇧ ⌘ V instead of ⌘ V.','In some apps it is under Edit > Paste and Match Style.']]]],\n['Sign a PDF','',[\n ['',['Open the PDF in Preview.','Click the Markup (pen tip) button, then the Sign button.','Create a signature by writing on the trackpad, holding a signed paper up to the camera, or on your iPhone.','Click the signature to place it, then drag and resize.']]]],\n['Combine files into one PDF','',[\n ['',['Select the PDFs or images in Finder, in the order you want.','Right-click and choose Quick Actions > Create PDF.','To reorder pages afterwards, open it in Preview, show thumbnails and drag them.']]]],\n['Convert or shrink images without an app','',[\n ['',['Select the images in Finder.','Right-click and choose Quick Actions > Convert Image.','Choose JPEG, PNG or HEIF and a size.','Quick Actions > Remove Background cuts out the subject.']]]],\n['Change which app opens a type of file','',[\n ['',['Select a file of that type and press ⌘ I.','Under Open with, choose the app.','Click Change All.']]]],\n['Zip files, with a password if needed','',[\n ['Plain zip',['Select the files, right-click, choose Compress.']],\n ['With a password',['Open Terminal and go to the folder that holds the item.','Run the command below. You are asked for a password twice.'],'zip -er archive.zip FolderName']]],\n['Open an app macOS has blocked','For apps from outside the App Store that you trust.',[\n ['',['Try to open the app once and dismiss the warning.','Open System Settings > Privacy & Security.','Scroll to Security and click Open Anyway.']]]],\n['See what is filling the disk','',[\n ['',['Open System Settings > General > Storage.','Click the i button next to a category to see the largest files.','In Finder, press ⌘ J in list view and tick Calculate all sizes to see folder sizes.']]]],\n['Make your own keyboard shortcut','For any menu command in any app.',[\n ['',['Open System Settings > Keyboard > Keyboard Shortcuts > App Shortcuts.','Click + and choose the app.','Type the menu command exactly as it appears in the menu.','Press the keys you want and click Done.']]]],\n['Type less with text replacements','',[\n ['',['Open System Settings > Keyboard > Text Replacements.','Click + and add a short code, such as @@, and the text it should become, such as your email address.','They sync to your iPhone and iPad through iCloud.']]]],\n['Use the screen corners','',[\n ['',['Open System Settings > Desktop & Dock and scroll to Hot Corners.','Give each corner a job: Mission Control, Desktop, Lock Screen, Quick Note.','Hold ⌘ or Option while choosing to require that key, which stops accidental triggers.']]]],\n['Drag with three fingers','Move windows and select text without clicking.',[\n ['',['Open System Settings > Accessibility > Pointer Control > Trackpad Options.','Turn on Use trackpad for dragging and choose Three-Finger Drag.']]]],\n['Scan a document or take a photo with your iPhone','',[\n ['',['Right-click the desktop or inside a Finder window.','Choose Import from iPhone > Scan Documents or Take Photo.','The iPhone camera opens; the result lands on the Mac.']]]],\n['Start in Safe Mode or Recovery','',[\n ['Apple silicon Macs',['Shut down.','Hold the power button until “Loading startup options” appears.','For Recovery, choose Options.','For Safe Mode, select your disk, hold Shift and click Continue in Safe Mode.']],\n ['Intel Macs',['Restart and immediately hold ⌘ R for Recovery, or Shift for Safe Mode.','Hold Option to choose a start-up disk.','Hold ⌥ ⌘ P R to reset NVRAM.']]]]\n];\n/* Hidden gems: [group, title, note, keys?] */\nvar G=[\n['The Option key','Hold Option in any menu','Menus change while Option is held: Save As appears in File, Library in Finder’s Go menu, System Information in the Apple menu.'],\n['The Option key','Option-click the Wi-Fi icon','Shows signal strength, channel, router address and your IP address.'],\n['The Option key','Fine volume and brightness steps','Quarter steps instead of full ones.','⌥ ⇧ Volume'],\n['The Option key','Option with a volume or brightness key','Opens Sound or Displays settings directly.'],\n['The Option key','Option-click the green button','Makes the window as large as it needs to be instead of going full screen.'],\n['The Option key','Option-click a triangle in list view','Opens that folder and every folder inside it.'],\n['The Option key','Option-click another app','Switches to it and hides the app you were in.'],\n['Windows','Move a background window without bringing it forward','Hold ⌘ and drag its title bar.'],\n['Windows','Double-click a window edge','The window grows to that side of the screen. Double-click a corner for two sides.'],\n['Windows','Tidy the menu bar','Hold ⌘ and drag menu bar icons to reorder them.'],\n['Windows','Find where an app lives','Hold ⌘ and click its Dock icon to reveal it in Finder.'],\n['Windows','Slow-motion minimise','Hold Shift while minimising. Not useful, but fun.'],\n['Finder','Drag the little icon in a window’s title','Hover over a document’s title and a small icon appears. Drag it to email, move or upload the file without finding it in Finder.'],\n['Finder','See where a folder is','Right-click the title of a Finder window to see every folder above it.'],\n['Finder','Drop a file onto an Open or Save window','The window jumps to that file’s folder. In these windows ⇧ ⌘ G, ⌘ D (Desktop) and ⇧ ⌘ . also work.'],\n['Finder','Spring-loaded folders','While dragging a file, hover over a folder and press Space to open it without letting go.'],\n['Finder','Fit a column to its names','In column view, double-click the divider. Hold Option to fit every column.'],\n['Finder','Type to select','Type the first letters of a file name to jump to it. Tab moves to the next item alphabetically.'],\n['Finder','Save a search as a folder','File > New Smart Folder keeps a live list, for example every PDF opened this week.'],\n['Finder','Save a piece of text as a clipping','Select text in any app and drag it to the desktop. Drag the clipping into any document later.'],\n['Quick Look','Do things without opening the app','Press Space on a file, then rotate, mark up, or trim a video from the preview.'],\n['Quick Look','Compare several files','Select several, press Space, then ⌘ Return for a grid.'],\n['Quick Look','Copy text out of a picture','Open an image in Quick Look or Preview and select the text in it as if it were typed.'],\n['Spotlight','Reveal instead of open','Hold ⌘ and press Return on a result to show it in Finder.','⌘ Return'],\n['Spotlight','Clipboard history','In Spotlight, press ⌘ 4 to see things you copied earlier. macOS 26 or later.','⌘ Space then ⌘ 4'],\n['Spotlight','Search by kind','Type kind:pdf or kind:image before your words to narrow the results.'],\n['Across devices','Copy on iPhone, paste on Mac','With the same Apple Account, Wi-Fi and Bluetooth on, copy on one device and paste on the other within a couple of minutes.'],\n['Across devices','Use your iPhone from the Mac','The iPhone Mirroring app shows and controls your iPhone on screen. macOS 15 or later.'],\n['Across devices','One mouse for Mac and iPad','Push the pointer past the edge of the Mac screen towards a nearby iPad to control it.'],\n['Screenshots','Drag the thumbnail','After a screenshot, drag the floating thumbnail straight into an email, message or document. No file is left on the desktop.'],\n['Screenshots','Lost pointer?','Shake the mouse or wiggle a finger on the trackpad and the pointer grows for a moment.'],\n['Terminal','Open the current folder in Finder','','','open .'],\n['Terminal','Keep the Mac awake','Stops sleep until you press Control C.','','caffeinate -d'],\n['Terminal','Copy a command’s output','pbcopy sends text to the clipboard; pbpaste types it back out.','','ls -la | pbcopy'],\n['Terminal','Resize a folder of photos','Makes the longest side 1600 pixels. It overwrites the files, so work on copies.','','sips -Z 1600 *.jpg'],\n['Terminal','Convert a Word file to plain text','','','textutil -convert txt report.docx'],\n['Terminal','Find files by name, instantly','Uses the Spotlight index.','','mdfind -name invoice'],\n['Terminal','Make the Mac speak','','','say \"Your download has finished\"']\n];\nvar LEG=[['⌘','Command (cmd)'],['⌥','Option (alt)'],['⌃','Control (ctrl)'],['⇧','Shift'],['fn','Function, or the Globe key'],['Esc','Escape'],['Return','Return or Enter'],['Delete','Backspace'],['← ↑ → ↓','Arrow keys'],['Power','Power or Touch ID button']];\n\n/* ---------------- model ---------------- */\nvar WORDS={then:1,or:1,drag:1,click:1};\nvar NAMES={'⌘':'command cmd','⌥':'option alt','⌃':'control ctrl','⇧':'shift','↑':'up arrow','↓':'down arrow','←':'left arrow','→':'right arrow'};\nvar ITEMS=[];\nfunction norm(s){ return String(s||'').toLowerCase().replace(/[‘’]/g,\"'\"); }\nfunction add(o){ o.id=o.tab+':'+o.title; var k=(o.keys||'').split(' ').map(function(t){return NAMES[t]||t;}).join(' ');\n  o.hay=norm([o.title,o.note,o.group,k,o.keys,o.where,o.code,(o.parts||[]).map(function(p){return p[0]+' '+p[1].join(' ')+' '+(p[2]||'');}).join(' ')].join(' ')); ITEMS.push(o); }\nK.forEach(function(r){ add({tab:'keys',group:r[0],keys:r[1],title:r[2],note:r[3]}); });\nF.forEach(function(r){ add({tab:'finder',group:r[0],keys:r[1],title:r[2],note:r[3]}); });\nFS.forEach(function(r){ add({tab:'finder',group:r[0],where:r[1],title:r[2],note:r[3]}); });\nTT.forEach(function(r){ add({tab:'finder',group:'Terminal tweaks',title:r[0],note:r[1],code:r[2],undo:r[3]}); });\nH.forEach(function(r){ add({tab:'how',group:'How to',title:r[0],note:r[1],parts:r[2]}); });\nG.forEach(function(r){ add({tab:'gems',group:r[0],title:r[1],note:r[2],keys:r[3]||'',code:r[4]}); });\n\nvar TABNAME={keys:'Keys',finder:'Finder',how:'How to',gems:'Hidden gems'};\nvar S={tab:'keys',grp:'',q:'',saved:false,fav:{},open:{},best:0};\nvar KEY='macshortcuts.v1',mem=null;\nfunction save(){ mem=JSON.stringify({fav:Object.keys(S.fav),best:S.best}); try{ if(window.myllmStorage) window.myllmStorage.setItem(KEY,mem); }catch(e){} }\nfunction hap(){ try{ if(window.myllmHaptic) window.myllmHaptic('light'); }catch(e){} }\n\n/* ---------------- rendering ---------------- */\nfunction keysEl(str){ var d=el('div','keys'); str.split(' ').forEach(function(t){ if(!t) return; if(WORDS[t]) d.appendChild(el('i','',t)); else d.appendChild(el('kbd',t.length>1?'w':'',t)); }); return d; }\nfunction copyBtn(text){ var b=el('button','cp','Copy'); b.type='button';\n  b.onclick=function(e){ e.stopPropagation(); var done=function(ok){ b.textContent=ok?'Copied':'Press and hold the text to copy'; setTimeout(function(){b.textContent='Copy';},1800); };\n    try{ navigator.clipboard.writeText(text).then(function(){done(true);},function(){done(false);}); }catch(x){ done(false); } }; return b; }\nfunction codeEl(parent,code){ parent.appendChild(el('pre','',code)); parent.appendChild(copyBtn(code)); }\nfunction row(o,showTab){\n  var how=!!o.parts, r=el('div','it'+(how?' how':'')+(how&&S.open[o.id]?' open':'')), tx=el('div','tx');\n  tx.appendChild(el('b','t',o.title));\n  if(showTab) tx.appendChild(el('p','',TABNAME[o.tab]+' · '+o.group));\n  if(o.note) tx.appendChild(el('p','',o.note));\n  if(o.where) tx.appendChild(el('span','path',o.where));\n  if(o.keys) tx.appendChild(keysEl(o.keys));\n  if(o.code&&!how){ codeEl(tx,o.code); if(o.undo){ var u=el('p','','To undo:'); tx.appendChild(u); codeEl(tx,o.undo); } }\n  r.appendChild(tx);\n  var st=el('button','star'+(S.fav[o.id]?' on':''),'★'); st.type='button'; st.setAttribute('aria-label',S.fav[o.id]?'Remove from saved':'Save'); st.setAttribute('aria-pressed',S.fav[o.id]?'true':'false');\n  st.onclick=function(e){ e.stopPropagation(); if(S.fav[o.id]) delete S.fav[o.id]; else S.fav[o.id]=1; hap(); save(); if(S.saved) render(); else { st.classList.toggle('on',!!S.fav[o.id]); st.setAttribute('aria-pressed',S.fav[o.id]?'true':'false'); } };\n  r.appendChild(st);\n  if(how){ var m=el('div','more');\n    o.parts.forEach(function(p){ if(p[0]) m.appendChild(el('h4','',p[0])); var ol=el('ol'); p[1].forEach(function(s){ ol.appendChild(el('li','',s)); }); m.appendChild(ol); if(p[2]) codeEl(m,p[2]); });\n    r.appendChild(m); r.onclick=function(e){ if(e.target.closest&&e.target.closest('pre,.cp')) return; S.open[o.id]=!S.open[o.id]; r.classList.toggle('open',!!S.open[o.id]); }; }\n  return r;\n}\nfunction current(){\n  var q=norm(S.q).trim(), words=q?q.split(/\\s+/):[];\n  return ITEMS.filter(function(o){\n    if(S.saved&&!S.fav[o.id]) return false;\n    if(words.length){ for(var i=0;i<words.length;i++){ if(o.hay.indexOf(words[i])<0) return false; } return true; }\n    if(S.saved) return true;\n    return o.tab===S.tab&&(!S.grp||o.group===S.grp);\n  });\n}\nfunction render(){\n  var quiz=S.tab==='quiz'&&!S.q&&!S.saved;\n  $('quiz').classList.toggle('hidden',!quiz); $('list').classList.toggle('hidden',quiz);\n  [].forEach.call($('nav').children,function(b){ b.classList.toggle('on',b.dataset.t===S.tab&&!S.saved&&!S.q); });\n  $('bSaved').classList.toggle('on',S.saved);\n  var ch=$('chips'); ch.textContent=''; var cross=!!S.q||S.saved;\n  if(!cross&&!quiz){ var gs=[]; ITEMS.forEach(function(o){ if(o.tab===S.tab&&gs.indexOf(o.group)<0) gs.push(o.group); });\n    if(gs.length>1){ [''].concat(gs).forEach(function(g){ var c=el('button','chip'+(S.grp===g?' on':''),g||'All'); c.type='button'; c.onclick=function(){ S.grp=g; render(); $('main').scrollTop=0; }; ch.appendChild(c); }); } }\n  ch.classList.toggle('hidden',!ch.children.length);\n  if(quiz){ if(!QZ.cur) nextQ(); return; }\n  var L=$('list'); L.textContent=''; var items=current();\n  if(!items.length){ L.appendChild(el('div','empty',S.saved&&!S.q?'Nothing saved yet. Tap the star on anything you want to keep handy.':'Nothing matches “'+S.q+'”. Try a simpler word, such as screenshot, rename or hidden.')); return; }\n  var last=null,box=null;\n  items.forEach(function(o){ var head=cross?TABNAME[o.tab]:o.group;\n    if(head!==last){ last=head; L.appendChild(el('h2','g',head)); box=el('div','grp'); L.appendChild(box); }\n    box.appendChild(row(o,cross&&o.tab!=='how')); });\n}\n\n/* ---------------- practise ---------------- */\nvar POOL=ITEMS.filter(function(o){ return (o.tab==='keys'||o.tab==='finder')&&o.keys&&o.group!=='Symbols'&&!/ (then|or|drag) /.test(' '+o.keys+' ')&&o.keys!=='Space'&&o.keys!=='Return'; });\nvar QZ={cur:null,now:0,tot:0,done:false,lastId:''};\nfunction pick(a){ return a[Math.floor(Math.random()*a.length)]; }\nfunction nextQ(){\n  var q; do{ q=pick(POOL); }while(q.id===QZ.lastId); QZ.lastId=q.id;\n  var opts=[q],tries=0; while(opts.length<4&&tries++<400){ var c=pick(POOL); if(opts.some(function(x){return x.keys===c.keys;})) continue; opts.push(c); }\n  opts.sort(function(){return Math.random()-0.5;}); QZ.cur={q:q,opts:opts}; QZ.done=false; drawQ();\n}\nfunction drawQ(){\n  var c=QZ.cur; $('qq').textContent=c.q.title; $('sNow').textContent=QZ.now; $('sBest').textContent=S.best; $('sTot').textContent=QZ.tot;\n  var box=$('opts'); box.textContent=''; $('qNext').classList.add('hidden');\n  c.opts.forEach(function(o){ var b=el('button','opt'); b.type='button'; b.appendChild(keysEl(o.keys)); b.firstChild.style.marginTop='0';\n    b.onclick=function(){ if(QZ.done) return; QZ.done=true; QZ.tot++; var right=o===c.q;\n      if(right){ QZ.now++; if(QZ.now>S.best){ S.best=QZ.now; save(); } } else QZ.now=0;\n      [].forEach.call(box.children,function(x,i){ if(c.opts[i]===c.q) x.classList.add('ok'); else if(x===b) x.classList.add('no'); });\n      $('sNow').textContent=QZ.now; $('sBest').textContent=S.best; $('sTot').textContent=QZ.tot; $('qNext').classList.remove('hidden'); hap(); };\n    box.appendChild(b); });\n}\n\n/* ---------------- wiring ---------------- */\n[].forEach.call($('nav').children,function(b){ b.onclick=function(){ S.tab=b.dataset.t; S.grp=''; S.saved=false; S.q=''; $('q').value=''; render(); $('main').scrollTop=0; }; });\n$('q').oninput=function(){ S.q=this.value; render(); $('main').scrollTop=0; };\n$('bSaved').onclick=function(){ S.saved=!S.saved; render(); $('main').scrollTop=0; };\n$('qNext').onclick=function(){ nextQ(); };\nLEG.forEach(function(l){ var k=el('div','keys'); k.style.marginTop='0'; l[0].split(' ').forEach(function(t){ k.appendChild(el('kbd',t.length>1?'w':'',t)); }); $('legGrid').appendChild(k); $('legGrid').appendChild(el('div','',l[1])); });\n$('bLeg').onclick=function(){ $('legSheet').classList.remove('hidden'); };\n$('legClose').onclick=function(){ $('legSheet').classList.add('hidden'); };\n$('legSheet').onclick=function(e){ if(e.target===this) this.classList.add('hidden'); };\nfunction boot(v){ try{ var o=v?JSON.parse(v):null; if(o){ (o.fav||[]).forEach(function(id){ S.fav[id]=1; }); S.best=Math.max(0,Math.round(+o.best||0)); } }catch(e){} render(); }\nvar p=null; try{ if(window.myllmStorage) p=window.myllmStorage.getItem(KEY); }catch(e){}\nPromise.resolve(p).then(boot,function(){boot(null);});\nwindow.__ms={S:S,ITEMS:ITEMS,POOL:POOL,render:render,QZ:QZ};\n})();\n</script>\n</body>\n</html>\n"}