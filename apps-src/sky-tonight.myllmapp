{"name": "Sky Tonight", "kind": "html", "iconSymbol": "moon.stars.fill", "iconColor": "cyan", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Sky Tonight</title>\n<style>\n  :root { color-scheme: dark; }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  /* deliberately always-dark: it's a night-sky app */\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:#070b1a;\n    color:#eef1fb;\n    max-width:820px; margin:0 auto; min-height:100dvh;\n    padding:16px 16px calc(40px + env(safe-area-inset-bottom));\n    position:relative;\n  }\n  .stars, .stars2{\n    position:fixed; inset:0; pointer-events:none; z-index:0;\n  }\n  .stars{ background:\n    radial-gradient(1px 1px at 12% 22%, #fff 50%, transparent 51%),\n    radial-gradient(1px 1px at 78% 12%, #fff 50%, transparent 51%),\n    radial-gradient(1.5px 1.5px at 55% 34%, #dfe6ff 50%, transparent 51%),\n    radial-gradient(1px 1px at 31% 64%, #fff 50%, transparent 51%),\n    radial-gradient(1px 1px at 88% 52%, #cfd8ff 50%, transparent 51%),\n    radial-gradient(1.5px 1.5px at 67% 78%, #fff 50%, transparent 51%),\n    radial-gradient(1px 1px at 8% 86%, #dfe6ff 50%, transparent 51%),\n    radial-gradient(1px 1px at 42% 8%, #fff 50%, transparent 51%),\n    radial-gradient(1px 1px at 94% 88%, #fff 50%, transparent 51%),\n    linear-gradient(180deg, #0b1230 0%, #070b1a 55%, #0a0d20 100%);\n  }\n  .stars2{ opacity:.7; animation: twinkle 4.2s ease-in-out infinite alternate; background:\n    radial-gradient(1px 1px at 22% 42%, #fff 50%, transparent 51%),\n    radial-gradient(1px 1px at 62% 18%, #fff 50%, transparent 51%),\n    radial-gradient(1px 1px at 82% 68%, #fff 50%, transparent 51%),\n    radial-gradient(1px 1px at 18% 12%, #fff 50%, transparent 51%),\n    radial-gradient(1.5px 1.5px at 48% 88%, #fff 50%, transparent 51%);\n  }\n  @keyframes twinkle{ from{opacity:.25} to{opacity:.85} }\n  @media (prefers-reduced-motion: reduce){ .stars2{ animation:none; } }\n  body > *:not(.stars):not(.stars2){ position:relative; z-index:1; }\n\n  h1{ font-size:22px; font-weight:800; letter-spacing:-0.02em; margin:6px 2px 4px; }\n  .where{ font-size:13px; color:#9aa5c9; margin:0 2px 14px; display:flex; align-items:center; gap:8px; flex-wrap:wrap; }\n  .where button{ border:1px solid rgba(255,255,255,.18); background:rgba(255,255,255,.07); color:#cdd6f5; border-radius:99px; padding:4px 11px; font-size:12px; font-weight:650; }\n\n  .card{\n    background:rgba(255,255,255,.06);\n    border:1px solid rgba(255,255,255,.11);\n    -webkit-backdrop-filter:blur(10px); backdrop-filter:blur(10px);\n    border-radius:18px; padding:14px 15px; margin-bottom:12px;\n  }\n  .card h2{ font-size:12px; font-weight:800; letter-spacing:.09em; text-transform:uppercase; color:#8fa0d6; margin-bottom:10px; }\n  .bigrow{ display:flex; align-items:center; gap:14px; }\n  .bigrow .glyph{ font-size:44px; line-height:1; }\n  .bigrow b{ display:block; font-size:18px; font-weight:800; }\n  .bigrow small{ font-size:13px; color:#9aa5c9; line-height:1.45; display:block; }\n  .kv{ display:flex; justify-content:space-between; padding:7px 0; border-bottom:1px solid rgba(255,255,255,.08); font-size:14.5px; }\n  .kv:last-child{ border-bottom:none; }\n  .kv span{ color:#9aa5c9; }\n  .kv b{ font-weight:700; }\n\n  .planet{ display:flex; align-items:center; gap:12px; padding:9px 0; border-bottom:1px solid rgba(255,255,255,.08); }\n  .planet:last-child{ border-bottom:none; }\n  .planet .p{ font-size:24px; width:32px; text-align:center; }\n  .planet b{ display:block; font-size:15px; font-weight:750; }\n  .planet small{ font-size:12.5px; color:#9aa5c9; line-height:1.4; display:block; }\n  .dirchip{ margin-left:auto; flex-shrink:0; background:rgba(120,160,255,.16); border:1px solid rgba(120,160,255,.3); color:#b9caff; font-size:12px; font-weight:750; border-radius:99px; padding:4px 10px; }\n  .nope{ font-size:14px; color:#9aa5c9; line-height:1.5; }\n\n  .iss{ display:flex; align-items:center; gap:12px; }\n  .iss .sat{ font-size:34px; }\n  .iss b{ display:block; font-size:15px; font-weight:750; }\n  .iss small{ font-size:13px; color:#9aa5c9; line-height:1.45; display:block; }\n  .pulse{ display:inline-block; width:8px; height:8px; border-radius:50%; background:#30d158; margin-right:6px; animation:pulse 1.6s ease-in-out infinite; }\n  @keyframes pulse{ 0%,100%{opacity:.4} 50%{opacity:1} }\n\n  .aibtn{\n    width:100%; border:1px solid rgba(150,130,255,.4); background:rgba(140,110,255,.14);\n    color:#d4c9ff; border-radius:14px; padding:13px; font-size:15px; font-weight:700; margin-bottom:12px;\n  }\n  .aiout{ font-size:14.5px; line-height:1.55; white-space:pre-wrap; }\n\n  .setup label{ display:block; font-size:11.5px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:#8fa0d6; margin:4px 0 6px; }\n  .setup .row{ display:flex; gap:8px; }\n  .setup input{\n    flex:1; font-size:16px; padding:11px 12px; border-radius:12px;\n    border:1px solid rgba(255,255,255,.18); background:rgba(255,255,255,.08); color:#eef1fb;\n  }\n  .setup input::placeholder{ color:#7a86ad; }\n  .setup button{\n    border:none; border-radius:12px; padding:0 16px; font-size:15px; font-weight:700;\n    background:var(--myllm-accent,#0a84ff); color:#fff;\n  }\n  .setup .note{ font-size:12.5px; color:#9aa5c9; margin-top:8px; line-height:1.45; }\n</style>\n</head>\n<body>\n<div class=\"stars\"></div><div class=\"stars2\"></div>\n\n<h1>🌌 Sky Tonight</h1>\n<div class=\"where\" id=\"where\"></div>\n\n<div id=\"app\"></div>\n\n<!-- AI thinking pill (house convention) -->\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\">⚙️</span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n\n<script>\n/* ============================================================\n   Ephemeris: low-precision Keplerian elements (Paul Schlyter,\n   \"How to compute planetary positions\") — good to a fraction of\n   a degree for the planets, ~1-2° for the Moon. Plenty for\n   \"what's up tonight and which way do I look\".\n   All angles in degrees internally; helpers wrap trig.\n   ============================================================ */\nvar D2R = Math.PI/180, R2D = 180/Math.PI;\nfunction sind(x){ return Math.sin(x*D2R); }\nfunction cosd(x){ return Math.cos(x*D2R); }\nfunction tand(x){ return Math.tan(x*D2R); }\nfunction asind(x){ return R2D*Math.asin(Math.max(-1,Math.min(1,x))); }\nfunction atan2d(y,x){ return R2D*Math.atan2(y,x); }\nfunction rev(x){ x = x % 360; return x < 0 ? x + 360 : x; }\n\n/* day number: d = 0.0 at 1999-12-31 00:00 UT (Schlyter's epoch, \"2000 Jan 0.0\") */\nfunction dayNum(date){\n  return date.getTime()/86400000 - 10956.0;\n}\n\nfunction kepler(M, e){\n  var E = M + e*R2D*sind(M)*(1 + e*cosd(M));\n  for (var i=0;i<8;i++){\n    var dE = (E - e*R2D*sind(E) - M) / (1 - e*cosd(E));\n    E -= dE;\n    if (Math.abs(dE) < 1e-6) break;\n  }\n  return E;\n}\n\n/* orbital elements at day d — [N,i,w,a,e,M] */\nvar ELEMENTS = {\n  sun:     function(d){ return [0, 0, 282.9404+4.70935e-5*d, 1.000000, 0.016709-1.151e-9*d, 356.0470+0.9856002585*d]; },\n  moon:    function(d){ return [125.1228-0.0529538083*d, 5.1454, 318.0634+0.1643573223*d, 60.2666, 0.054900, 115.3654+13.0649929509*d]; },\n  mercury: function(d){ return [48.3313+3.24587e-5*d, 7.0047+5.00e-8*d, 29.1241+1.01444e-5*d, 0.387098, 0.205635+5.59e-10*d, 168.6562+4.0923344368*d]; },\n  venus:   function(d){ return [76.6799+2.46590e-5*d, 3.3946+2.75e-8*d, 54.8910+1.38374e-5*d, 0.723330, 0.006773-1.302e-9*d, 48.0052+1.6021302244*d]; },\n  mars:    function(d){ return [49.5574+2.11081e-5*d, 1.8497-1.78e-8*d, 286.5016+2.92961e-5*d, 1.523688, 0.093405+2.516e-9*d, 18.6021+0.5240207766*d]; },\n  jupiter: function(d){ return [100.4542+2.76854e-5*d, 1.3030-1.557e-7*d, 273.8777+1.64505e-5*d, 5.20256, 0.048498+4.469e-9*d, 19.8950+0.0830853001*d]; },\n  saturn:  function(d){ return [113.6634+2.38980e-5*d, 2.4886-1.081e-7*d, 339.3939+2.97661e-5*d, 9.55475, 0.055546-9.499e-9*d, 316.9670+0.0334442282*d]; }\n};\n\n/* heliocentric ecliptic rectangular coords (AU) of a planet (or the\n   Moon's GEOcentric coords in Earth radii — same math, different centre) */\nfunction bodyEcl(which, d){\n  var el = ELEMENTS[which](d);\n  var N=rev(el[0]), inc=el[1], w=rev(el[2]), a=el[3], e=el[4], M=rev(el[5]);\n  var E = kepler(M, e);\n  var xv = a*(cosd(E)-e), yv = a*Math.sqrt(1-e*e)*sind(E);\n  var v = rev(atan2d(yv,xv)), r = Math.sqrt(xv*xv+yv*yv);\n  return {\n    x: r*(cosd(N)*cosd(v+w) - sind(N)*sind(v+w)*cosd(inc)),\n    y: r*(sind(N)*cosd(v+w) + cosd(N)*sind(v+w)*cosd(inc)),\n    z: r*sind(v+w)*sind(inc),\n    r: r, v: v, w: w, N: N, M: M\n  };\n}\n\n/* Sun geocentric ecliptic longitude + rectangular coords */\nfunction sunPos(d){\n  var el = ELEMENTS.sun(d);\n  var w=rev(el[2]), e=el[4], M=rev(el[5]);\n  var E = kepler(M, e);\n  var xv = cosd(E)-e, yv = Math.sqrt(1-e*e)*sind(E);\n  var v = rev(atan2d(yv,xv)), r = Math.sqrt(xv*xv+yv*yv);\n  var lon = rev(v + w);\n  return {lon:lon, r:r, x:r*cosd(lon), y:r*sind(lon), M:M, w:w};\n}\n\n/* Moon geocentric ecliptic lon/lat with the main perturbation terms */\nfunction moonPos(d){\n  var m = bodyEcl(\"moon\", d);\n  var s = sunPos(d);\n  var lon = rev(atan2d(m.y, m.x));\n  var lat = atan2d(m.z, Math.sqrt(m.x*m.x + m.y*m.y));\n  var Ms = s.M, Mm = rev(ELEMENTS.moon(d)[5]);\n  var Nm = rev(ELEMENTS.moon(d)[0]);\n  var ws = s.w, wm = rev(ELEMENTS.moon(d)[2]);\n  var Ls = rev(Ms + ws), Lm = rev(Mm + wm + Nm);\n  var D = rev(Lm - Ls), F = rev(Lm - Nm);\n  lon += -1.274*sind(Mm - 2*D)   /* evection */\n       + 0.658*sind(2*D)         /* variation */\n       - 0.186*sind(Ms)          /* yearly equation */\n       - 0.059*sind(2*Mm - 2*D)\n       - 0.057*sind(Mm - 2*D + Ms)\n       + 0.053*sind(Mm + 2*D);\n  lat += -0.173*sind(F - 2*D)\n       - 0.055*sind(Mm - F - 2*D);\n  return {lon:rev(lon), lat:lat, dist:m.r};\n}\n\n/* geocentric RA/Dec of a planet */\nfunction planetRaDec(which, d){\n  var p = bodyEcl(which, d);\n  var s = sunPos(d);\n  var xg = p.x + s.x, yg = p.y + s.y, zg = p.z;\n  var ecl = 23.4393 - 3.563e-7*d;\n  var xe = xg, ye = yg*cosd(ecl) - zg*sind(ecl), ze = yg*sind(ecl) + zg*cosd(ecl);\n  return {ra: rev(atan2d(ye,xe)), dec: atan2d(ze, Math.sqrt(xe*xe+ye*ye)),\n          dist: Math.sqrt(xg*xg+yg*yg+zg*zg)};\n}\nfunction eclToRaDec(lon, lat, d){\n  var ecl = 23.4393 - 3.563e-7*d;\n  var x = cosd(lon)*cosd(lat), y = sind(lon)*cosd(lat), z = sind(lat);\n  var xe = x, ye = y*cosd(ecl) - z*sind(ecl), ze = y*sind(ecl) + z*cosd(ecl);\n  return {ra: rev(atan2d(ye,xe)), dec: atan2d(ze, Math.sqrt(xe*xe+ye*ye))};\n}\n\n/* local sidereal time (deg) at date + observer longitude */\nfunction lst(date, lonDeg){\n  var d = dayNum(date);\n  var s = sunPos(d);\n  var gmst0 = rev(s.M + s.w + 180);\n  var utH = (d - Math.floor(d)) * 24;   /* hours since 0h UT (d's epoch is a 0h UT boundary) */\n  return rev(gmst0 + utH*15 + lonDeg);\n}\n\n/* alt/az (deg; az 0=N, 90=E) of an RA/Dec for observer at date */\nfunction altAz(ra, dec, date, latDeg, lonDeg){\n  var ha = rev(lst(date, lonDeg) - ra);\n  var alt = asind(sind(latDeg)*sind(dec) + cosd(latDeg)*cosd(dec)*cosd(ha));\n  var az = rev(atan2d(sind(ha), cosd(ha)*sind(latDeg) - tand(dec)*cosd(latDeg)) + 180);\n  return {alt:alt, az:az};\n}\nfunction compass(az){\n  var pts = [\"N\",\"NNE\",\"NE\",\"ENE\",\"E\",\"ESE\",\"SE\",\"SSE\",\"S\",\"SSW\",\"SW\",\"WSW\",\"W\",\"WNW\",\"NW\",\"NNW\"];\n  return pts[Math.round(az/22.5) % 16];\n}\n\n/* sun event (rise/set/dusk) — h = altitude threshold (-0.833 set, -6 civil, -18 astro).\n   Returns a Date or null (never rises/sets). dir=+1 evening, -1 morning. */\nfunction sunEvent(dateLocalMidday, latDeg, lonDeg, h, dir){\n  var d = dayNum(dateLocalMidday);\n  var s = sunPos(d);\n  var rd = eclToRaDec(s.lon, 0, d);\n  var gmst0 = rev(s.M + s.w + 180);\n  var transitUT = rev(rd.ra - gmst0 - lonDeg) / 15;   /* hours UT */\n  var cosLHA = (sind(h) - sind(latDeg)*sind(rd.dec)) / (cosd(latDeg)*cosd(rd.dec));\n  if (cosLHA > 1 || cosLHA < -1) return null;\n  var lha = R2D*Math.acos(cosLHA) / 15;               /* hours */\n  var ut = transitUT + dir*lha;\n  var base = new Date(dateLocalMidday);\n  base.setUTCHours(0,0,0,0);\n  return new Date(base.getTime() + ut*3600000);\n}\n\n/* moon phase from sun-moon elongation */\nfunction moonPhase(d){\n  var s = sunPos(d), m = moonPos(d);\n  var elong = rev(m.lon - s.lon);\n  var illum = (1 - cosd(elong)) / 2;\n  var names = [[\"New Moon\",\"🌑\"],[\"Waxing Crescent\",\"🌒\"],[\"First Quarter\",\"🌓\"],[\"Waxing Gibbous\",\"🌔\"],\n               [\"Full Moon\",\"🌕\"],[\"Waning Gibbous\",\"🌖\"],[\"Last Quarter\",\"🌗\"],[\"Waning Crescent\",\"🌘\"]];\n  var idx;\n  if (elong < 22.5 || elong >= 337.5) idx = 0;\n  else idx = Math.floor((elong + 22.5) / 45);\n  return {elong:elong, illum:illum, name:names[idx][0], emoji:names[idx][1], lon:m.lon, lat:m.lat};\n}\n/* next date (from today) when elongation crosses target (0=new,180=full) */\nfunction nextPhase(dateFrom, target){\n  var d0 = dayNum(dateFrom);\n  function delta(d){ return rev(rev(moonPos(d).lon - sunPos(d).lon) - target + 180) - 180; }\n  var prev = delta(d0);\n  for (var i = 1; i <= 31; i++){\n    var cur = delta(d0 + i);\n    if (prev < 0 && cur >= 0){\n      var lo = d0 + i - 1, hi = d0 + i;\n      for (var k = 0; k < 20; k++){\n        var mid = (lo + hi) / 2;\n        if (delta(mid) < 0) lo = mid; else hi = mid;\n      }\n      return new Date((lo + 10957.5) * 86400000);\n    }\n    prev = cur;\n  }\n  return null;\n}\n\n/* ============================================================ UI */\nvar store = window.myllmStorage || {getItem:function(){return Promise.resolve(null)}, setItem:function(){return Promise.resolve()}};\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nvar NET = window.myllmFetch || null;\nvar LOC = window.myllmLocation || null;\nvar ASK = window.myllmAsk || null;\n\nvar obs = null;   /* {lat, lon, label} */\nvar issTimer = null;\nvar facts = \"\";   /* plain-text summary for the AI */\n\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\"); }\nfunction fmtTime(dt){\n  return dt ? dt.toLocaleTimeString([], {hour:\"2-digit\", minute:\"2-digit\"}) : \"—\";\n}\nfunction fmtDate(dt){\n  return dt ? dt.toLocaleDateString([], {weekday:\"short\", day:\"numeric\", month:\"short\"}) : \"—\";\n}\n\nvar PLANETS = [\n  {id:\"mercury\", name:\"Mercury\", glyph:\"🪐\", note:\"small and shy — needs a clear horizon\"},\n  {id:\"venus\",   name:\"Venus\",   glyph:\"✨\", note:\"unmissably brilliant\"},\n  {id:\"mars\",    name:\"Mars\",    glyph:\"🔴\", note:\"a steady reddish point\"},\n  {id:\"jupiter\", name:\"Jupiter\", glyph:\"🟠\", note:\"very bright — outshines every star\"},\n  {id:\"saturn\",  name:\"Saturn\",  glyph:\"🪐\", note:\"calm golden glow; rings need a telescope\"}\n];\n\nfunction renderSky(){\n  var now = new Date();\n  var midday = new Date(now); midday.setHours(12,0,0,0);\n  var sunset  = sunEvent(midday, obs.lat, obs.lon, -0.833, +1);\n  var sunrise = sunEvent(midday, obs.lat, obs.lon, -0.833, -1);\n  var dusk    = sunEvent(midday, obs.lat, obs.lon, -6, +1);\n  var dark    = sunEvent(midday, obs.lat, obs.lon, -18, +1);\n\n  /* observation moment: 75 min after sunset (or now, if later) */\n  var evening = sunset ? new Date(sunset.getTime() + 75*60000) : new Date(midday.getTime() + 10*3600000);\n  if (now > evening && now.getHours() >= 18) evening = now;\n  var dEve = dayNum(evening);\n\n  var ph = moonPhase(dEve);\n  var moonRd = eclToRaDec(ph.lon, ph.lat, dEve);\n  var moonAA = altAz(moonRd.ra, moonRd.dec, evening, obs.lat, obs.lon);\n  var nextFull = nextPhase(now, 180), nextNew = nextPhase(now, 0);\n\n  var evenersHtml = \"\", morningHtml = \"\", evenNames = [], mornNames = [];\n  PLANETS.forEach(function(p){\n    var rd = planetRaDec(p.id, dEve);\n    var aa = altAz(rd.ra, rd.dec, evening, obs.lat, obs.lon);\n    if (aa.alt > 3){\n      var howHigh = aa.alt < 10 ? \"very low — needs a flat horizon\" : Math.round(aa.alt) + \"° up\";\n      evenNames.push(p.name + (aa.alt < 10 ? \" low in the \" : \" in the \") + compass(aa.az));\n      evenersHtml += '<div class=\"planet\"><div class=\"p\">' + p.glyph + '</div><div><b>' + p.name + '</b>' +\n        '<small>' + p.note + ' · ' + howHigh + '</small></div>' +\n        '<span class=\"dirchip\">' + compass(aa.az) + '</span></div>';\n    }\n  });\n  if (sunrise){\n    var predawn = new Date(sunrise.getTime() - 75*60000);\n    /* tomorrow's pre-dawn */\n    predawn = new Date(predawn.getTime() + 86400000);\n    var dMorn = dayNum(predawn);\n    PLANETS.forEach(function(p){\n      var rd = planetRaDec(p.id, dMorn);\n      var aa = altAz(rd.ra, rd.dec, predawn, obs.lat, obs.lon);\n      if (aa.alt > 5){\n        mornNames.push(p.name + \" in the \" + compass(aa.az));\n        morningHtml += '<div class=\"planet\"><div class=\"p\">' + p.glyph + '</div><div><b>' + p.name + '</b>' +\n          '<small>' + p.note + ' · ' + Math.round(aa.alt) + '° up before dawn</small></div>' +\n          '<span class=\"dirchip\">' + compass(aa.az) + '</span></div>';\n      }\n    });\n  }\n\n  var moonLine = moonAA.alt > 0\n    ? \"Up now-ish after sunset — look \" + compass(moonAA.az) + \".\"\n    : \"Below the horizon in the early evening.\";\n\n  facts = \"Location: \" + obs.label + \". Sunset \" + fmtTime(sunset) + \", civil dusk \" + fmtTime(dusk) +\n    (dark ? \", fully dark by \" + fmtTime(dark) : \", never fully dark tonight\") + \". \" +\n    \"Moon: \" + ph.name + \", \" + Math.round(ph.illum*100) + \"% lit. \" +\n    (evenNames.length ? \"Evening planets: \" + evenNames.join(\", \") + \". \" : \"No bright planets in the evening sky. \") +\n    (mornNames.length ? \"Pre-dawn planets: \" + mornNames.join(\", \") + \".\" : \"\");\n\n  var h = \"\";\n  h += '<div class=\"card\"><h2>The Sun · tonight</h2>' +\n    '<div class=\"kv\"><span>Sunset</span><b>' + fmtTime(sunset) + '</b></div>' +\n    '<div class=\"kv\"><span>Civil dusk</span><b>' + fmtTime(dusk) + '</b></div>' +\n    '<div class=\"kv\"><span>Properly dark</span><b>' + (dark ? fmtTime(dark) : \"not tonight — bright summer nights\") + '</b></div>' +\n    '<div class=\"kv\"><span>Sunrise</span><b>' + fmtTime(sunrise) + '</b></div></div>';\n\n  h += '<div class=\"card\"><h2>The Moon</h2><div class=\"bigrow\"><div class=\"glyph\">' + ph.emoji + '</div>' +\n    '<div><b>' + ph.name + ' · ' + Math.round(ph.illum*100) + '% lit</b>' +\n    '<small>' + moonLine + '</small>' +\n    '<small>Full: ' + fmtDate(nextFull) + ' · New: ' + fmtDate(nextNew) + '</small></div></div></div>';\n\n  h += '<div class=\"card\"><h2>Planets this evening</h2>' +\n    (evenersHtml || '<p class=\"nope\">No bright planets above the horizon in the early evening — check the pre-dawn sky below.</p>') + '</div>';\n\n  if (morningHtml) h += '<div class=\"card\"><h2>Before sunrise</h2>' + morningHtml + '</div>';\n\n  h += '<div class=\"card\"><h2>ISS · live</h2><div class=\"iss\" id=\"issbox\"><div class=\"sat\">🛰️</div>' +\n    '<div><b id=\"issline\">' + (NET ? \"Finding the Space Station…\" : \"Needs network access\") + '</b>' +\n    '<small id=\"isssub\">' + (NET ? \"\" : \"Turn on app network access in Settings to track it.\") + '</small></div></div></div>';\n\n  if (ASK) h += '<button class=\"aibtn\" id=\"aibtn\" onclick=\"skyStory()\">✨ Tonight at a glance</button>' +\n    '<div class=\"card\" id=\"aicard\" style=\"display:none\"><h2>Your guide</h2><div class=\"aiout\" id=\"aiout\"></div></div>';\n\n  el(\"app\").innerHTML = h;\n  el(\"where\").innerHTML = '📍 ' + esc(obs.label) +\n    ' <button onclick=\"changeLoc()\">Change</button>';\n\n  if (NET){ pollIss(); if (!issTimer) issTimer = setInterval(pollIss, 12000); }\n}\n\n/* ---------- ISS ---------- */\nfunction gcDist(lat1, lon1, lat2, lon2){\n  var a = sind((lat2-lat1)/2), b = sind((lon2-lon1)/2);\n  var s = a*a + cosd(lat1)*cosd(lat2)*b*b;\n  return 2 * 6371 * Math.asin(Math.sqrt(s));\n}\nfunction pollIss(){\n  if (!NET || !obs) return;\n  NET(\"https://api.wheretheiss.at/v1/satellites/25544\").then(function(r){\n    var j = JSON.parse(r.body);\n    var line = el(\"issline\"), sub = el(\"isssub\");\n    if (!line) return;\n    var km = Math.round(gcDist(obs.lat, obs.lon, j.latitude, j.longitude));\n    var ns = j.latitude >= 0 ? \"N\" : \"S\", ew = j.longitude >= 0 ? \"E\" : \"W\";\n    line.innerHTML = '<span class=\"pulse\"></span>' + km.toLocaleString() + \" km from you\";\n    var vis = j.visibility === \"daylight\" ? \"in daylight (not visible)\" :\n              j.visibility === \"eclipsed\" ? \"in Earth's shadow\" : \"potentially visible\";\n    sub.textContent = \"Now over \" + Math.abs(j.latitude).toFixed(0) + \"°\" + ns + \" \" +\n      Math.abs(j.longitude).toFixed(0) + \"°\" + ew + \" at 27,500 km/h — currently \" + vis +\n      \". It laps the Earth every 92 minutes.\";\n  }).catch(function(){\n    var line = el(\"issline\");\n    if (line) line.textContent = \"Couldn't reach the ISS tracker\";\n  });\n}\n\n/* ---------- AI ---------- */\nfunction skyStory(){\n  if (!ASK) return;\n  haptic(\"light\");\n  var btn = el(\"aibtn\"); if (btn) btn.disabled = true;\n  ASK(\"Facts about tonight's sky at my location: \" + facts +\n    \" Write a warm, friendly 3-4 sentence stargazing guide for a beginner stepping outside tonight: what to look for first, where to look, and one delightful detail. Plain text, no markdown, no invented facts.\",\n    {system:\"You are a friendly astronomy guide. Use ONLY the provided facts; do not invent sky events. Plain text.\"})\n  .then(function(r){\n    el(\"aiout\").textContent = String(r).trim();\n    el(\"aicard\").style.display = \"block\";\n    if (btn) btn.disabled = false;\n    haptic(\"success\");\n  }).catch(function(){\n    if (btn) btn.disabled = false;\n  });\n}\n\n/* ---------- location ---------- */\nfunction setupUI(msg){\n  if (issTimer){ clearInterval(issTimer); issTimer = null; }\n  el(\"where\").innerHTML = \"\";\n  el(\"app\").innerHTML =\n    '<div class=\"card setup\"><h2>Where are you watching from?</h2>' +\n    '<label>City or place</label>' +\n    '<div class=\"row\"><input id=\"q\" placeholder=\"e.g. Bristol\" onkeydown=\"if(event.key===\\'Enter\\')findPlace()\">' +\n    '<button onclick=\"findPlace()\">Go</button></div>' +\n    (LOC ? '<div style=\"margin-top:10px\"><button style=\"width:100%;border-radius:12px;padding:12px;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.08);color:#eef1fb;font-size:15px;font-weight:650\" onclick=\"useGps()\">📍 Use my location</button></div>' : \"\") +\n    '<p class=\"note\" id=\"setupnote\">' + (msg || \"Your location is only used on this device, to point you at the right bit of sky.\") + '</p></div>';\n}\nfunction useGps(){\n  haptic(\"light\");\n  el(\"setupnote\").textContent = \"Locating…\";\n  LOC.current().then(function(p){\n    obs = {lat:p.latitude, lon:p.longitude, label:(p.address || \"Your location\")};\n    store.setItem(\"obs\", JSON.stringify(obs));\n    renderSky(); haptic(\"success\");\n  }).catch(function(e){\n    el(\"setupnote\").textContent = (e && e.message ? e.message + \" — \" : \"\") + \"Try typing a place instead.\";\n  });\n}\nfunction findPlace(){\n  var q = (el(\"q\").value || \"\").trim();\n  if (!q) return;\n  haptic(\"light\");\n  /* accept a raw \"lat, lon\" pair */\n  var m = q.match(/^\\s*(-?\\d+(?:\\.\\d+)?)\\s*,\\s*(-?\\d+(?:\\.\\d+)?)\\s*$/);\n  if (m){\n    obs = {lat:parseFloat(m[1]), lon:parseFloat(m[2]), label:\"Lat \" + m[1] + \", Lon \" + m[2]};\n    store.setItem(\"obs\", JSON.stringify(obs));\n    renderSky(); return;\n  }\n  el(\"setupnote\").textContent = \"Searching…\";\n  var done = function(lat, lon, label){\n    obs = {lat:lat, lon:lon, label:label};\n    store.setItem(\"obs\", JSON.stringify(obs));\n    renderSky(); haptic(\"success\");\n  };\n  if (LOC && LOC.search){\n    LOC.search(q, {limit:1}).then(function(res){\n      if (res && res.length) done(res[0].latitude, res[0].longitude, res[0].name || q);\n      else throw new Error(\"none\");\n    }).catch(function(){ geoFallback(q, done); });\n  } else geoFallback(q, done);\n}\nfunction geoFallback(q, done){\n  if (!NET){ el(\"setupnote\").textContent = \"Couldn't find that — try \\\"lat, lon\\\" (e.g. 51.45, -2.59).\"; return; }\n  NET(\"https://geocoding-api.open-meteo.com/v1/search?count=1&name=\" + encodeURIComponent(q)).then(function(r){\n    var j = JSON.parse(r.body);\n    if (j.results && j.results.length){\n      var p = j.results[0];\n      done(p.latitude, p.longitude, p.name + (p.country_code ? \", \" + p.country_code : \"\"));\n    } else el(\"setupnote\").textContent = \"Couldn't find that place — try another spelling.\";\n  }).catch(function(){\n    el(\"setupnote\").textContent = \"Couldn't search just now — try \\\"lat, lon\\\" instead.\";\n  });\n}\nfunction changeLoc(){ haptic(\"light\"); setupUI(); }\n\n/* ---------- boot ---------- */\nstore.getItem(\"obs\").then(function(v){\n  if (v){ try{ obs = JSON.parse(v); }catch(e){} }\n  if (obs && typeof obs.lat === \"number\") renderSky();\n  else if (LOC){\n    LOC.current().then(function(p){\n      obs = {lat:p.latitude, lon:p.longitude, label:(p.address || \"Your location\")};\n      store.setItem(\"obs\", JSON.stringify(obs));\n      renderSky();\n    }).catch(function(){ setupUI(); });\n  } else setupUI();\n});\n</script>\n</body>\n</html>\n"}