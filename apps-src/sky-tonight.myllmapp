{"name": "Sky Tonight", "kind": "html", "iconSymbol": "moon.stars.fill", "iconColor": "cyan", "html": "<!doctype html>\n<!--\n  Sky Tonight — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Sky Tonight</title>\n<style>\n:root{color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); --h:200; }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:760px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  svg.z{ width:1.5em; height:1.5em; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.96); }\n  [hidden]{ display:none !important; }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 28%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  @media (max-width:360px){ h1{ font-size:20px; } }\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:18px 2px 10px; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  label{ display:block; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:0 2px 7px; }\n  input, select{ width:100%; font:inherit; font-size:16px; padding:12px; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; }\n  input:focus, select:focus{ border-color:var(--acc); }\n  select{ -webkit-appearance:none; appearance:none; padding-right:36px;\n    background-image:linear-gradient(45deg, transparent 50%, var(--muted) 50%), linear-gradient(135deg, var(--muted) 50%, transparent 50%);\n    background-position:calc(100% - 18px) 55%, calc(100% - 13px) 55%; background-size:5px 5px; background-repeat:no-repeat; }\n  .go{ min-height:50px; border:none; border-radius:14px; background:var(--acc); color:#fff; font-size:16px; font-weight:700;\n    display:flex; align-items:center; justify-content:center; gap:8px; padding:0 18px; }\n  .go.wide{ width:100%; margin-top:12px; }\n  .go:disabled{ opacity:.55; }\n  .status{ font-size:13px; color:var(--muted); min-height:18px; margin:8px 2px 0; text-align:center; }\n  .status.err{ color:#ff453a; }\n  .spin{ width:16px; height:16px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n\n  /* the night-sky hero: the app's hue over deep space, a scatter of fixed\n     stars, and a second, fainter layer that breathes very slowly */\n  .sky{ position:relative; overflow:hidden; border-radius:20px; padding:18px; color:#fff; margin-bottom:12px; isolation:isolate;\n    background:radial-gradient(120% 90% at 12% 0%, hsl(var(--h) 62% 34%), transparent 62%),\n      radial-gradient(110% 90% at 100% 100%, hsl(calc(var(--h) + 45) 55% 26%), transparent 60%),\n      linear-gradient(160deg, #0e1133, #070918 70%);\n    box-shadow:0 12px 30px hsl(var(--h) 50% 18% / .3); }\n  .sky::before, .sky::after{ content:\"\"; position:absolute; inset:0; pointer-events:none; z-index:-1; }\n  .sky::before{ background:radial-gradient(1px 1px at 22% 54%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 12% 72%, #fff 50%, transparent 51%),radial-gradient(1.5px 1.5px at 77% 11%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 30% 8%, #fff 50%, transparent 51%),radial-gradient(1.5px 1.5px at 56% 12%, #fff 50%, transparent 51%),radial-gradient(1.5px 1.5px at 73% 58%, #fff 50%, transparent 51%),radial-gradient(1.5px 1.5px at 75% 19%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 83% 84%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 10% 77%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 9% 32%, #fff 50%, transparent 51%),radial-gradient(1.5px 1.5px at 20% 41%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 72% 19%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 74% 91%, #fff 50%, transparent 51%),radial-gradient(1.5px 1.5px at 77% 77%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 50% 16%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 11% 76%, #fff 50%, transparent 51%); opacity:.85; }\n  .sky::after{ background:radial-gradient(1px 1px at 69% 19%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 53% 48%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 40% 78%, #fff 50%, transparent 51%),radial-gradient(1.5px 1.5px at 36% 17%, #fff 50%, transparent 51%),radial-gradient(1.5px 1.5px at 44% 38%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 44% 43%, #fff 50%, transparent 51%),radial-gradient(1.5px 1.5px at 82% 29%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 28% 18%, #fff 50%, transparent 51%); opacity:.5; animation:twinkle 7s ease-in-out infinite alternate; }\n  @keyframes twinkle{ from{ opacity:.18; } to{ opacity:.75; } }\n  .sky .k{ font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.72; }\n  .glass{ border:1px solid rgba(255,255,255,.2); background:rgba(255,255,255,.14); color:#fff;\n    -webkit-backdrop-filter:blur(14px); backdrop-filter:blur(14px); }\n  .gbtn{ min-height:48px; border-radius:14px; padding:0 16px; font-size:15.5px; font-weight:750; display:flex; align-items:center; justify-content:center; gap:8px; width:100%; }\n  .gbtn.solid{ border:none; background:#fff; color:#0d1030; box-shadow:0 8px 22px rgba(0,0,0,.28); }\n  .gbtn:disabled{ opacity:.6; }\n\n  /* zodiac tiles: stroke glyphs, never the emoji-prone Unicode symbols */\n  .zt{ display:flex; align-items:center; justify-content:center; flex-shrink:0; border-radius:13px; width:44px; height:44px; font-size:17px; color:#fff;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 52%), hsl(calc(var(--h) + 40) 58% 30%)); }\n  .sky .zt{ background:rgba(255,255,255,.14); border:1px solid rgba(255,255,255,.22); }\n  .zt.big{ width:68px; height:68px; border-radius:20px; font-size:27px; }\n\n  @media (prefers-reduced-motion:reduce){ .sky::after{ animation:none; } .spin{ animation-duration:2.4s; } button:active{ transform:none; } }\n\n  @keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n  .myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n  .myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n  .myllm-ai-cog{width:16px;height:16px;border-radius:50%;border:2.4px solid #a78bfa;border-right-color:transparent;animation:myllmAiSpin .9s linear infinite;flex-shrink:0}\n  .myllm-ai-busy small{font-weight:400;opacity:.6}\n\n  /* dark mode keeps the old always-dark page's star field behind everything */\n  .field{ display:none; }\n  @media (prefers-color-scheme:dark){\n    .field{ display:block; position:fixed; inset:0; pointer-events:none; z-index:0; opacity:.55;\n      background:radial-gradient(1px 1px at 12% 22%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 78% 12%, #fff 50%, transparent 51%),radial-gradient(1.5px 1.5px at 55% 34%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 31% 64%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 88% 52%, #fff 50%, transparent 51%),radial-gradient(1.5px 1.5px at 67% 78%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 8% 86%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 42% 8%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 94% 88%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 22% 42%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 62% 18%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 82% 68%, #fff 50%, transparent 51%),radial-gradient(1px 1px at 18% 12%, #fff 50%, transparent 51%),radial-gradient(1.5px 1.5px at 48% 88%, #fff 50%, transparent 51%), linear-gradient(180deg, #0b1230 0%, #05070f 55%, #000 100%); }\n    body > *:not(.field){ position:relative; z-index:1; }\n    .card{ background:rgba(28,28,34,.72); -webkit-backdrop-filter:blur(12px); backdrop-filter:blur(12px); }\n  }\n  .where{ display:flex; align-items:center; gap:8px; margin:-4px 2px 14px; font-size:13.5px; color:var(--muted); flex-wrap:wrap; }\n  .where svg{ color:hsl(var(--h) 70% 55%); }\n  .where span{ font-weight:650; color:var(--ink); }\n  .where button{ min-height:32px; border:1px solid var(--line); background:var(--surface); border-radius:99px; padding:0 12px; font-size:12.5px; font-weight:700; color:var(--acc); }\n  .card h2{ margin:0 0 10px; }\n  .sky h2{ color:rgba(255,255,255,.72); margin:0 0 12px; }\n  .moonrow{ display:flex; align-items:center; gap:16px; }\n  .moonrow svg.moon{ width:78px; height:78px; flex-shrink:0; filter:drop-shadow(0 0 16px rgba(255,248,220,.28)); }\n  .moonrow b{ display:block; font-size:20px; font-weight:800; line-height:1.2; }\n  .moonrow small{ display:block; font-size:13px; opacity:.78; line-height:1.45; margin-top:3px; }\n  .kv{ display:flex; justify-content:space-between; gap:10px; padding:9px 0; border-bottom:1px solid var(--line); font-size:15px; }\n  .kv:last-child{ border-bottom:none; padding-bottom:2px; } .kv:first-of-type{ padding-top:2px; }\n  .kv span{ color:var(--muted); } .kv b{ font-weight:700; text-align:right; font-variant-numeric:tabular-nums; }\n  .planet{ display:flex; align-items:center; gap:12px; padding:9px 0; border-bottom:1px solid var(--line); }\n  .planet:last-child{ border-bottom:none; padding-bottom:2px; }\n  .planet .p{ width:32px; height:32px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }\n  .planet .p svg{ width:30px; height:30px; }\n  .planet b{ display:block; font-size:15px; font-weight:750; }\n  .planet small{ font-size:12.5px; color:var(--muted); line-height:1.4; display:block; }\n  .dirchip{ margin-left:auto; flex-shrink:0; background:hsl(var(--h) 80% 55% / .14); color:hsl(var(--h) 70% 40%); font-size:12.5px; font-weight:800; border-radius:99px; padding:5px 10px; font-variant-numeric:tabular-nums; }\n  @media (prefers-color-scheme:dark){ .dirchip{ color:hsl(var(--h) 90% 76%); } }\n  .nope{ font-size:14px; color:var(--muted); line-height:1.5; }\n  .iss{ display:flex; align-items:center; gap:12px; }\n  .iss .sat{ width:40px; height:40px; border-radius:12px; font-size:18px; }\n  .iss b{ display:block; font-size:15px; font-weight:750; }\n  .iss small{ font-size:13px; color:var(--muted); line-height:1.45; display:block; }\n  .pulse{ display:inline-block; width:8px; height:8px; border-radius:50%; background:#30d158; margin-right:6px; animation:pulse 1.6s ease-in-out infinite; }\n  @keyframes pulse{ 0%,100%{opacity:.4} 50%{opacity:1} }\n  @media (prefers-reduced-motion:reduce){ .pulse{ animation:none; } }\n  .aibtn{ width:100%; min-height:50px; border:none; border-radius:14px; background:linear-gradient(135deg, hsl(var(--h) 62% 46%), hsl(calc(var(--h) + 45) 55% 40%)); color:#fff;\n    font-size:15.5px; font-weight:750; display:flex; align-items:center; justify-content:center; gap:8px; margin-bottom:12px; }\n  .aibtn:disabled{ opacity:.6; }\n  .aiout{ font-size:15px; line-height:1.55; white-space:pre-wrap; }\n  .setup .row{ display:flex; gap:8px; }\n  .setup .row input{ flex:1; min-width:0; }\n  .gps{ width:100%; min-height:48px; margin-top:10px; border:1px solid var(--line); background:var(--bg); border-radius:12px; font-size:15px; font-weight:700; display:flex; align-items:center; justify-content:center; gap:8px; color:var(--ink); }\n  .gps svg{ color:hsl(var(--h) 70% 55%); }\n  .note{ font-size:12.5px; color:var(--muted); margin-top:9px; line-height:1.45; }\n  @media (min-width:700px){ .cols{ display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); column-gap:12px; align-items:start; } }\n</style>\n<style>:root{--build-id:\"0b3eb44628\";}</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-moonstars\" viewBox=\"0 0 24 24\"><path d=\"M13.5 3.2a8.8 8.8 0 1 0 7.3 12.3A7 7 0 0 1 13.5 3.2z\" fill=\"currentColor\"/><path d=\"M18 3l.7 1.8 1.8.7-1.8.7L18 8l-.7-1.8-1.8-.7 1.8-.7zM21 9.5l.45 1.05 1.05.45-1.05.45L21 12.5l-.45-1.05-1.05-.45 1.05-.45z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-spark\" viewBox=\"0 0 24 24\"><path d=\"M10 2.5l1.9 5.6 5.6 1.9-5.6 1.9L10 17.5l-1.9-5.6L2.5 10l5.6-1.9zM18.5 14l.95 2.55L22 17.5l-2.55.95L18.5 21l-.95-2.55L15 17.5l2.55-.95z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-pin\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5a7 7 0 0 0-7 7c0 5 7 12 7 12s7-7 7-12a7 7 0 0 0-7-7zm0 9.6a2.6 2.6 0 1 1 0-5.2 2.6 2.6 0 0 1 0 5.2z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-sat\" viewBox=\"0 0 24 24\"><path d=\"M13.2 7.3l3.5 3.5-3.9 3.9-3.5-3.5zM4.6 2.9l4.2 4.2-2.1 2.1-4.2-4.2zM17.4 15.7l4.2 4.2-2.1 2.1-4.2-4.2zM8.8 7.1l1.4 1.4M13.8 14.2l1.4 1.4\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"1.2\" stroke-linejoin=\"round\"/><path d=\"M6.5 15.5a4 4 0 0 0 2 2M4.5 15.5a6 6 0 0 0 4 4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></symbol>\n</defs></svg>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\"></span><span>AI is thinking\\u2026 <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n\n<div class=\"field\"></div>\n<div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-moonstars\"/></svg></div>\n  <div class=\"ht\"><h1>Sky Tonight</h1><p>What's up there tonight</p></div>\n</div>\n<div class=\"where\" id=\"where\"></div>\n\n<div id=\"app\"></div>\n<script>\n/* ============================================================\n   Ephemeris: low-precision Keplerian elements (Paul Schlyter,\n   \"How to compute planetary positions\") — good to a fraction of\n   a degree for the planets, ~1-2° for the Moon. Plenty for\n   \"what's up tonight and which way do I look\".\n   All angles in degrees internally; helpers wrap trig.\n   ============================================================ */\nvar D2R = Math.PI/180, R2D = 180/Math.PI;\nfunction sind(x){ return Math.sin(x*D2R); }\nfunction cosd(x){ return Math.cos(x*D2R); }\nfunction tand(x){ return Math.tan(x*D2R); }\nfunction asind(x){ return R2D*Math.asin(Math.max(-1,Math.min(1,x))); }\nfunction atan2d(y,x){ return R2D*Math.atan2(y,x); }\nfunction rev(x){ x = x % 360; return x < 0 ? x + 360 : x; }\n\n/* day number: d = 0.0 at 1999-12-31 00:00 UT (Schlyter's epoch, \"2000 Jan 0.0\") */\nfunction dayNum(date){\n  return date.getTime()/86400000 - 10956.0;\n}\n\nfunction kepler(M, e){\n  var E = M + e*R2D*sind(M)*(1 + e*cosd(M));\n  for (var i=0;i<8;i++){\n    var dE = (E - e*R2D*sind(E) - M) / (1 - e*cosd(E));\n    E -= dE;\n    if (Math.abs(dE) < 1e-6) break;\n  }\n  return E;\n}\n\n/* orbital elements at day d — [N,i,w,a,e,M] */\nvar ELEMENTS = {\n  sun:     function(d){ return [0, 0, 282.9404+4.70935e-5*d, 1.000000, 0.016709-1.151e-9*d, 356.0470+0.9856002585*d]; },\n  moon:    function(d){ return [125.1228-0.0529538083*d, 5.1454, 318.0634+0.1643573223*d, 60.2666, 0.054900, 115.3654+13.0649929509*d]; },\n  mercury: function(d){ return [48.3313+3.24587e-5*d, 7.0047+5.00e-8*d, 29.1241+1.01444e-5*d, 0.387098, 0.205635+5.59e-10*d, 168.6562+4.0923344368*d]; },\n  venus:   function(d){ return [76.6799+2.46590e-5*d, 3.3946+2.75e-8*d, 54.8910+1.38374e-5*d, 0.723330, 0.006773-1.302e-9*d, 48.0052+1.6021302244*d]; },\n  mars:    function(d){ return [49.5574+2.11081e-5*d, 1.8497-1.78e-8*d, 286.5016+2.92961e-5*d, 1.523688, 0.093405+2.516e-9*d, 18.6021+0.5240207766*d]; },\n  jupiter: function(d){ return [100.4542+2.76854e-5*d, 1.3030-1.557e-7*d, 273.8777+1.64505e-5*d, 5.20256, 0.048498+4.469e-9*d, 19.8950+0.0830853001*d]; },\n  saturn:  function(d){ return [113.6634+2.38980e-5*d, 2.4886-1.081e-7*d, 339.3939+2.97661e-5*d, 9.55475, 0.055546-9.499e-9*d, 316.9670+0.0334442282*d]; }\n};\n\n/* heliocentric ecliptic rectangular coords (AU) of a planet (or the\n   Moon's GEOcentric coords in Earth radii — same math, different centre) */\nfunction bodyEcl(which, d){\n  var el = ELEMENTS[which](d);\n  var N=rev(el[0]), inc=el[1], w=rev(el[2]), a=el[3], e=el[4], M=rev(el[5]);\n  var E = kepler(M, e);\n  var xv = a*(cosd(E)-e), yv = a*Math.sqrt(1-e*e)*sind(E);\n  var v = rev(atan2d(yv,xv)), r = Math.sqrt(xv*xv+yv*yv);\n  return {\n    x: r*(cosd(N)*cosd(v+w) - sind(N)*sind(v+w)*cosd(inc)),\n    y: r*(sind(N)*cosd(v+w) + cosd(N)*sind(v+w)*cosd(inc)),\n    z: r*sind(v+w)*sind(inc),\n    r: r, v: v, w: w, N: N, M: M\n  };\n}\n\n/* Sun geocentric ecliptic longitude + rectangular coords */\nfunction sunPos(d){\n  var el = ELEMENTS.sun(d);\n  var w=rev(el[2]), e=el[4], M=rev(el[5]);\n  var E = kepler(M, e);\n  var xv = cosd(E)-e, yv = Math.sqrt(1-e*e)*sind(E);\n  var v = rev(atan2d(yv,xv)), r = Math.sqrt(xv*xv+yv*yv);\n  var lon = rev(v + w);\n  return {lon:lon, r:r, x:r*cosd(lon), y:r*sind(lon), M:M, w:w};\n}\n\n/* Moon geocentric ecliptic lon/lat with the main perturbation terms */\nfunction moonPos(d){\n  var m = bodyEcl(\"moon\", d);\n  var s = sunPos(d);\n  var lon = rev(atan2d(m.y, m.x));\n  var lat = atan2d(m.z, Math.sqrt(m.x*m.x + m.y*m.y));\n  var Ms = s.M, Mm = rev(ELEMENTS.moon(d)[5]);\n  var Nm = rev(ELEMENTS.moon(d)[0]);\n  var ws = s.w, wm = rev(ELEMENTS.moon(d)[2]);\n  var Ls = rev(Ms + ws), Lm = rev(Mm + wm + Nm);\n  var D = rev(Lm - Ls), F = rev(Lm - Nm);\n  lon += -1.274*sind(Mm - 2*D)   /* evection */\n       + 0.658*sind(2*D)         /* variation */\n       - 0.186*sind(Ms)          /* yearly equation */\n       - 0.059*sind(2*Mm - 2*D)\n       - 0.057*sind(Mm - 2*D + Ms)\n       + 0.053*sind(Mm + 2*D);\n  lat += -0.173*sind(F - 2*D)\n       - 0.055*sind(Mm - F - 2*D);\n  return {lon:rev(lon), lat:lat, dist:m.r};\n}\n\n/* geocentric RA/Dec of a planet */\nfunction planetRaDec(which, d){\n  var p = bodyEcl(which, d);\n  var s = sunPos(d);\n  var xg = p.x + s.x, yg = p.y + s.y, zg = p.z;\n  var ecl = 23.4393 - 3.563e-7*d;\n  var xe = xg, ye = yg*cosd(ecl) - zg*sind(ecl), ze = yg*sind(ecl) + zg*cosd(ecl);\n  return {ra: rev(atan2d(ye,xe)), dec: atan2d(ze, Math.sqrt(xe*xe+ye*ye)),\n          dist: Math.sqrt(xg*xg+yg*yg+zg*zg)};\n}\nfunction eclToRaDec(lon, lat, d){\n  var ecl = 23.4393 - 3.563e-7*d;\n  var x = cosd(lon)*cosd(lat), y = sind(lon)*cosd(lat), z = sind(lat);\n  var xe = x, ye = y*cosd(ecl) - z*sind(ecl), ze = y*sind(ecl) + z*cosd(ecl);\n  return {ra: rev(atan2d(ye,xe)), dec: atan2d(ze, Math.sqrt(xe*xe+ye*ye))};\n}\n\n/* local sidereal time (deg) at date + observer longitude */\nfunction lst(date, lonDeg){\n  var d = dayNum(date);\n  var s = sunPos(d);\n  var gmst0 = rev(s.M + s.w + 180);\n  var utH = (d - Math.floor(d)) * 24;   /* hours since 0h UT (d's epoch is a 0h UT boundary) */\n  return rev(gmst0 + utH*15 + lonDeg);\n}\n\n/* alt/az (deg; az 0=N, 90=E) of an RA/Dec for observer at date */\nfunction altAz(ra, dec, date, latDeg, lonDeg){\n  var ha = rev(lst(date, lonDeg) - ra);\n  var alt = asind(sind(latDeg)*sind(dec) + cosd(latDeg)*cosd(dec)*cosd(ha));\n  var az = rev(atan2d(sind(ha), cosd(ha)*sind(latDeg) - tand(dec)*cosd(latDeg)) + 180);\n  return {alt:alt, az:az};\n}\nfunction compass(az){\n  var pts = [\"N\",\"NNE\",\"NE\",\"ENE\",\"E\",\"ESE\",\"SE\",\"SSE\",\"S\",\"SSW\",\"SW\",\"WSW\",\"W\",\"WNW\",\"NW\",\"NNW\"];\n  return pts[Math.round(az/22.5) % 16];\n}\n\n/* sun event (rise/set/dusk) — h = altitude threshold (-0.833 set, -6 civil, -18 astro).\n   Returns a Date or null (never rises/sets). dir=+1 evening, -1 morning. */\nfunction sunEvent(dateLocalMidday, latDeg, lonDeg, h, dir){\n  var d = dayNum(dateLocalMidday);\n  var s = sunPos(d);\n  var rd = eclToRaDec(s.lon, 0, d);\n  var gmst0 = rev(s.M + s.w + 180);\n  var transitUT = rev(rd.ra - gmst0 - lonDeg) / 15;   /* hours UT */\n  var cosLHA = (sind(h) - sind(latDeg)*sind(rd.dec)) / (cosd(latDeg)*cosd(rd.dec));\n  if (cosLHA > 1 || cosLHA < -1) return null;\n  var lha = R2D*Math.acos(cosLHA) / 15;               /* hours */\n  var ut = transitUT + dir*lha;\n  var base = new Date(dateLocalMidday);\n  base.setUTCHours(0,0,0,0);\n  return new Date(base.getTime() + ut*3600000);\n}\n\n/* moon phase from sun-moon elongation */\nfunction moonPhase(d){\n  var s = sunPos(d), m = moonPos(d);\n  var elong = rev(m.lon - s.lon);\n  var illum = (1 - cosd(elong)) / 2;\n  var names = [[\"New Moon\",\"🌑\"],[\"Waxing Crescent\",\"🌒\"],[\"First Quarter\",\"🌓\"],[\"Waxing Gibbous\",\"🌔\"],\n               [\"Full Moon\",\"🌕\"],[\"Waning Gibbous\",\"🌖\"],[\"Last Quarter\",\"🌗\"],[\"Waning Crescent\",\"🌘\"]];\n  var idx;\n  if (elong < 22.5 || elong >= 337.5) idx = 0;\n  else idx = Math.floor((elong + 22.5) / 45);\n  return {elong:elong, illum:illum, name:names[idx][0], emoji:names[idx][1], lon:m.lon, lat:m.lat};\n}\n/* next date (from today) when elongation crosses target (0=new,180=full) */\nfunction nextPhase(dateFrom, target){\n  var d0 = dayNum(dateFrom);\n  function delta(d){ return rev(rev(moonPos(d).lon - sunPos(d).lon) - target + 180) - 180; }\n  var prev = delta(d0);\n  for (var i = 1; i <= 31; i++){\n    var cur = delta(d0 + i);\n    if (prev < 0 && cur >= 0){\n      var lo = d0 + i - 1, hi = d0 + i;\n      for (var k = 0; k < 20; k++){\n        var mid = (lo + hi) / 2;\n        if (delta(mid) < 0) lo = mid; else hi = mid;\n      }\n      return new Date((lo + 10957.5) * 86400000);\n    }\n    prev = cur;\n  }\n  return null;\n}\n\n/* ============================================================ UI */\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction store(){ return window.myllmStorage || {getItem:function(){return Promise.resolve(null)}, setItem:function(){return Promise.resolve()}}; }\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction net(){ return window.myllmFetch || null; }\nfunction loc(){ return window.myllmLocation || null; }\nfunction ask(){ return window.myllmAsk || null; }\nfunction icon(n){ return '<svg class=\"i\"><use href=\"#i-' + n + '\"/></svg>'; }\n\nvar obs = null;   /* {lat, lon, label} */\nvar issTimer = null;\nvar facts = \"\";   /* plain-text summary for the AI */\n\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\"); }\nfunction fmtTime(dt){\n  return dt ? dt.toLocaleTimeString([], {hour:\"2-digit\", minute:\"2-digit\"}) : \"—\";\n}\nfunction fmtDate(dt){\n  return dt ? dt.toLocaleDateString([], {weekday:\"short\", day:\"numeric\", month:\"short\"}) : \"—\";\n}\n\nvar PLANETS = [\n  {id:\"mercury\", name:\"Mercury\", glyph:\"🪐\", note:\"small and shy — needs a clear horizon\"},\n  {id:\"venus\",   name:\"Venus\",   glyph:\"✨\", note:\"unmissably brilliant\"},\n  {id:\"mars\",    name:\"Mars\",    glyph:\"🔴\", note:\"a steady reddish point\"},\n  {id:\"jupiter\", name:\"Jupiter\", glyph:\"🟠\", note:\"very bright — outshines every star\"},\n  {id:\"saturn\",  name:\"Saturn\",  glyph:\"🪐\", note:\"calm golden glow; rings need a telescope\"}\n];\n/* drawn planets instead of emoji: a shaded disc in each one's colour, Saturn with its ring */\nvar PCOL = {mercury:[\"#d8d2c8\",\"#8f887c\"], venus:[\"#fff4cf\",\"#d9b86a\"], mars:[\"#ff9a73\",\"#b8432a\"], jupiter:[\"#f6d3a4\",\"#b87d44\"], saturn:[\"#f5e2a8\",\"#b89a52\"]};\nfunction planetSvg(id){\n  var c = PCOL[id], g = \"pg-\" + id;\n  var ring = id === \"saturn\" ? '<ellipse cx=\"15\" cy=\"15\" rx=\"13.5\" ry=\"4.2\" fill=\"none\" stroke=\"' + c[0] + '\" stroke-width=\"1.6\" opacity=\".85\" transform=\"rotate(-18 15 15)\"/>' : \"\";\n  var r = id === \"jupiter\" ? 9.5 : id === \"saturn\" ? 7.5 : id === \"venus\" ? 8 : 6.5;\n  return '<svg viewBox=\"0 0 30 30\"><defs><radialGradient id=\"' + g + '\" cx=\"35%\" cy=\"32%\" r=\"75%\"><stop offset=\"0\" stop-color=\"' + c[0] + '\"/><stop offset=\"1\" stop-color=\"' + c[1] + '\"/></radialGradient></defs>' +\n    '<circle cx=\"15\" cy=\"15\" r=\"' + r + '\" fill=\"url(#' + g + ')\"/>' + ring + '</svg>';\n}\n/* the Moon as it looks: lit limb plus an elliptical terminator (lit on the\n   right while waxing, the northern-hemisphere view) */\nfunction moonSvg(illum, elong){\n  var R = 36, cx = 40, cy = 40, rx = Math.abs(1 - 2*illum) * R;\n  var waxing = elong < 180, gib = illum > 0.5;\n  var outer = waxing ? 1 : 0, inner = waxing ? (gib ? 1 : 0) : (gib ? 0 : 1);\n  var lit = 'M' + cx + ' ' + (cy - R) + ' A' + R + ' ' + R + ' 0 0 ' + outer + ' ' + cx + ' ' + (cy + R) +\n            ' A' + rx.toFixed(2) + ' ' + R + ' 0 0 ' + inner + ' ' + cx + ' ' + (cy - R) + 'Z';\n  return '<svg class=\"moon\" viewBox=\"0 0 80 80\"><defs><radialGradient id=\"mg\" cx=\"40%\" cy=\"38%\" r=\"70%\"><stop offset=\"0\" stop-color=\"#fffaf0\"/><stop offset=\"1\" stop-color=\"#e6dcc2\"/></radialGradient></defs>' +\n    '<circle cx=\"40\" cy=\"40\" r=\"36\" fill=\"#262a40\"/>' + (illum > 0.005 ? '<path d=\"' + lit + '\" fill=\"url(#mg)\"/>' : '') +\n    '<circle cx=\"40\" cy=\"40\" r=\"36\" fill=\"none\" stroke=\"rgba(255,255,255,.18)\"/></svg>';\n}\n\nfunction renderSky(){\n  var now = new Date();\n  var midday = new Date(now); midday.setHours(12,0,0,0);\n  var sunset  = sunEvent(midday, obs.lat, obs.lon, -0.833, +1);\n  var sunrise = sunEvent(midday, obs.lat, obs.lon, -0.833, -1);\n  var dusk    = sunEvent(midday, obs.lat, obs.lon, -6, +1);\n  var dark    = sunEvent(midday, obs.lat, obs.lon, -18, +1);\n\n  /* observation moment: 75 min after sunset (or now, if later) */\n  var evening = sunset ? new Date(sunset.getTime() + 75*60000) : new Date(midday.getTime() + 10*3600000);\n  if (now > evening && now.getHours() >= 18) evening = now;\n  var dEve = dayNum(evening);\n\n  var ph = moonPhase(dEve);\n  var moonRd = eclToRaDec(ph.lon, ph.lat, dEve);\n  var moonAA = altAz(moonRd.ra, moonRd.dec, evening, obs.lat, obs.lon);\n  var nextFull = nextPhase(now, 180), nextNew = nextPhase(now, 0);\n\n  var evenersHtml = \"\", morningHtml = \"\", evenNames = [], mornNames = [];\n  PLANETS.forEach(function(p){\n    var rd = planetRaDec(p.id, dEve);\n    var aa = altAz(rd.ra, rd.dec, evening, obs.lat, obs.lon);\n    if (aa.alt > 3){\n      var howHigh = aa.alt < 10 ? \"very low — needs a flat horizon\" : Math.round(aa.alt) + \"° up\";\n      evenNames.push(p.name + (aa.alt < 10 ? \" low in the \" : \" in the \") + compass(aa.az));\n      evenersHtml += '<div class=\"planet\"><div class=\"p\">' + planetSvg(p.id) + '</div><div><b>' + p.name + '</b>' +\n        '<small>' + p.note + ' · ' + howHigh + '</small></div>' +\n        '<span class=\"dirchip\">' + compass(aa.az) + '</span></div>';\n    }\n  });\n  if (sunrise){\n    var predawn = new Date(sunrise.getTime() - 75*60000);\n    /* tomorrow's pre-dawn */\n    predawn = new Date(predawn.getTime() + 86400000);\n    var dMorn = dayNum(predawn);\n    PLANETS.forEach(function(p){\n      var rd = planetRaDec(p.id, dMorn);\n      var aa = altAz(rd.ra, rd.dec, predawn, obs.lat, obs.lon);\n      if (aa.alt > 5){\n        mornNames.push(p.name + \" in the \" + compass(aa.az));\n        morningHtml += '<div class=\"planet\"><div class=\"p\">' + planetSvg(p.id) + '</div><div><b>' + p.name + '</b>' +\n          '<small>' + p.note + ' · ' + Math.round(aa.alt) + '° up before dawn</small></div>' +\n          '<span class=\"dirchip\">' + compass(aa.az) + '</span></div>';\n      }\n    });\n  }\n\n  var moonLine = moonAA.alt > 0\n    ? \"Up now-ish after sunset — look \" + compass(moonAA.az) + \".\"\n    : \"Below the horizon in the early evening.\";\n\n  facts = \"Location: \" + obs.label + \". Sunset \" + fmtTime(sunset) + \", civil dusk \" + fmtTime(dusk) +\n    (dark ? \", fully dark by \" + fmtTime(dark) : \", never fully dark tonight\") + \". \" +\n    \"Moon: \" + ph.name + \", \" + Math.round(ph.illum*100) + \"% lit. \" +\n    (evenNames.length ? \"Evening planets: \" + evenNames.join(\", \") + \". \" : \"No bright planets in the evening sky. \") +\n    (mornNames.length ? \"Pre-dawn planets: \" + mornNames.join(\", \") + \".\" : \"\");\n\n  var h = \"\";\n  h += '<div class=\"sky\"><h2>The Moon</h2><div class=\"moonrow\">' + moonSvg(ph.illum, ph.elong) +\n    '<div><b>' + ph.name + ' · ' + Math.round(ph.illum*100) + '% lit</b>' +\n    '<small>' + moonLine + '</small>' +\n    '<small>Full: ' + fmtDate(nextFull) + ' · New: ' + fmtDate(nextNew) + '</small></div></div></div>';\n\n  h += '<div class=\"cols\"><div>';\n  h += '<div class=\"card\"><h2>The Sun · tonight</h2>' +\n    '<div class=\"kv\"><span>Sunset</span><b>' + fmtTime(sunset) + '</b></div>' +\n    '<div class=\"kv\"><span>Civil dusk</span><b>' + fmtTime(dusk) + '</b></div>' +\n    '<div class=\"kv\"><span>Properly dark</span><b>' + (dark ? fmtTime(dark) : \"not tonight — bright summer nights\") + '</b></div>' +\n    '<div class=\"kv\"><span>Sunrise</span><b>' + fmtTime(sunrise) + '</b></div></div>';\n\n  h += '<div class=\"card\"><h2>ISS · live</h2><div class=\"iss\" id=\"issbox\"><div class=\"tile sat\">' + icon(\"sat\") + '</div>' +\n    '<div><b id=\"issline\">' + (net() ? \"Finding the Space Station…\" : \"Needs network access\") + '</b>' +\n    '<small id=\"isssub\">' + (net() ? \"\" : \"Turn on app network access in Settings to track it.\") + '</small></div></div></div>';\n  h += '</div><div>';\n\n  h += '<div class=\"card\"><h2>Planets this evening</h2>' +\n    (evenersHtml || '<p class=\"nope\">No bright planets above the horizon in the early evening — check the pre-dawn sky below.</p>') + '</div>';\n\n  if (morningHtml) h += '<div class=\"card\"><h2>Before sunrise</h2>' + morningHtml + '</div>';\n  h += '</div></div>';\n\n  if (ask()) h += '<button class=\"aibtn\" id=\"aibtn\" onclick=\"skyStory()\">' + icon(\"spark\") + '<span>Tonight at a glance</span></button>' +\n    '<div class=\"card\" id=\"aicard\" style=\"display:none\"><h2>Your guide</h2><div class=\"aiout\" id=\"aiout\"></div></div>';\n\n  el(\"app\").innerHTML = h;\n  el(\"where\").innerHTML = icon(\"pin\") + '<span>' + esc(obs.label) + '</span>' +\n    ' <button onclick=\"changeLoc()\">Change</button>';\n\n  if (net()){ pollIss(); if (!issTimer) issTimer = setInterval(pollIss, 12000); }\n}\n\n/* ---------- ISS ---------- */\nfunction gcDist(lat1, lon1, lat2, lon2){\n  var a = sind((lat2-lat1)/2), b = sind((lon2-lon1)/2);\n  var s = a*a + cosd(lat1)*cosd(lat2)*b*b;\n  return 2 * 6371 * Math.asin(Math.sqrt(s));\n}\nfunction pollIss(){\n  if (!net() || !obs) return;\n  net()(\"https://api.wheretheiss.at/v1/satellites/25544\").then(function(r){\n    var j = JSON.parse(r.body);\n    var line = el(\"issline\"), sub = el(\"isssub\");\n    if (!line) return;\n    var km = Math.round(gcDist(obs.lat, obs.lon, j.latitude, j.longitude));\n    var ns = j.latitude >= 0 ? \"N\" : \"S\", ew = j.longitude >= 0 ? \"E\" : \"W\";\n    line.innerHTML = '<span class=\"pulse\"></span>' + km.toLocaleString() + \" km from you\";\n    var vis = j.visibility === \"daylight\" ? \"in daylight (not visible)\" :\n              j.visibility === \"eclipsed\" ? \"in Earth's shadow\" : \"potentially visible\";\n    sub.textContent = \"Now over \" + Math.abs(j.latitude).toFixed(0) + \"°\" + ns + \" \" +\n      Math.abs(j.longitude).toFixed(0) + \"°\" + ew + \" at 27,500 km/h — currently \" + vis +\n      \". It laps the Earth every 92 minutes.\";\n  }).catch(function(){\n    var line = el(\"issline\");\n    if (line) line.textContent = \"Couldn't reach the ISS tracker\";\n  });\n}\n\n/* ---------- AI ---------- */\nfunction aiBtn(busy){\n  var btn = el(\"aibtn\"); if (!btn) return;\n  btn.disabled = !!busy;\n  btn.innerHTML = busy ? '<i class=\"spin\"></i><span>Reading tonight\\u2019s sky…</span>' : icon(\"spark\") + '<span>Tonight at a glance</span>';\n}\nfunction skyStory(){\n  if (!ask()) return;\n  haptic(\"light\");\n  aiBtn(true);\n  ask()(\"Facts about tonight's sky at my location: \" + facts +\n    \" Write a warm, friendly 3-4 sentence stargazing guide for a beginner stepping outside tonight: what to look for first, where to look, and one delightful detail. Plain text, no markdown, no invented facts.\",\n    {system:\"You are a friendly astronomy guide. Use ONLY the provided facts; do not invent sky events. Plain text.\"})\n  .then(function(r){\n    el(\"aiout\").textContent = String(r).trim();\n    el(\"aicard\").style.display = \"block\";\n    aiBtn(false);\n    haptic(\"success\");\n  }).catch(function(){\n    aiBtn(false);\n  });\n}\n\n/* ---------- location ---------- */\nfunction setupUI(msg){\n  if (issTimer){ clearInterval(issTimer); issTimer = null; }\n  el(\"where\").innerHTML = \"\";\n  el(\"app\").innerHTML =\n    '<div class=\"card setup\"><h2>Where are you watching from?</h2>' +\n    '<label for=\"q\">City or place</label>' +\n    '<div class=\"row\"><input id=\"q\" placeholder=\"e.g. Bristol\" enterkeyhint=\"go\" onkeydown=\"if(event.key===\\'Enter\\')findPlace()\">' +\n    '<button class=\"go\" onclick=\"findPlace()\">Go</button></div>' +\n    (loc() ? '<button class=\"gps\" onclick=\"useGps()\">' + icon(\"pin\") + 'Use my location</button>' : \"\") +\n    '<p class=\"note\" id=\"setupnote\">' + (msg || \"Your location is only used on this device, to point you at the right bit of sky.\") + '</p></div>';\n}\nfunction useGps(){\n  haptic(\"light\");\n  el(\"setupnote\").textContent = \"Locating…\";\n  loc().current().then(function(p){\n    obs = {lat:p.latitude, lon:p.longitude, label:(p.address || \"Your location\")};\n    store().setItem(\"obs\", JSON.stringify(obs));\n    renderSky(); haptic(\"success\");\n  }).catch(function(e){\n    el(\"setupnote\").textContent = (e && e.message ? e.message + \" — \" : \"\") + \"Try typing a place instead.\";\n  });\n}\nfunction findPlace(){\n  var q = (el(\"q\").value || \"\").trim();\n  if (!q) return;\n  haptic(\"light\");\n  /* accept a raw \"lat, lon\" pair */\n  var m = q.match(/^\\s*(-?\\d+(?:\\.\\d+)?)\\s*,\\s*(-?\\d+(?:\\.\\d+)?)\\s*$/);\n  if (m){\n    obs = {lat:parseFloat(m[1]), lon:parseFloat(m[2]), label:\"Lat \" + m[1] + \", Lon \" + m[2]};\n    store().setItem(\"obs\", JSON.stringify(obs));\n    renderSky(); return;\n  }\n  el(\"setupnote\").textContent = \"Searching…\";\n  var done = function(lat, lon, label){\n    obs = {lat:lat, lon:lon, label:label};\n    store().setItem(\"obs\", JSON.stringify(obs));\n    renderSky(); haptic(\"success\");\n  };\n  if (loc() && loc().search){\n    loc().search(q, {limit:1}).then(function(res){\n      if (res && res.length) done(res[0].latitude, res[0].longitude, res[0].name || q);\n      else throw new Error(\"none\");\n    }).catch(function(){ geoFallback(q, done); });\n  } else geoFallback(q, done);\n}\nfunction geoFallback(q, done){\n  if (!net()){ el(\"setupnote\").textContent = \"Couldn't find that — try \\\"lat, lon\\\" (e.g. 51.45, -2.59).\"; return; }\n  net()(\"https://geocoding-api.open-meteo.com/v1/search?count=1&name=\" + encodeURIComponent(q)).then(function(r){\n    var j = JSON.parse(r.body);\n    if (j.results && j.results.length){\n      var p = j.results[0];\n      done(p.latitude, p.longitude, p.name + (p.country_code ? \", \" + p.country_code : \"\"));\n    } else el(\"setupnote\").textContent = \"Couldn't find that place — try another spelling.\";\n  }).catch(function(){\n    el(\"setupnote\").textContent = \"Couldn't search just now — try \\\"lat, lon\\\" instead.\";\n  });\n}\nfunction changeLoc(){ haptic(\"light\"); setupUI(); }\n\n/* ---------- boot ---------- */\nstore().getItem(\"obs\").then(function(v){\n  if (v){ try{ obs = JSON.parse(v); }catch(e){} }\n  if (obs && typeof obs.lat === \"number\") renderSky();\n  else if (loc()){\n    loc().current().then(function(p){\n      obs = {lat:p.latitude, lon:p.longitude, label:(p.address || \"Your location\")};\n      store().setItem(\"obs\", JSON.stringify(obs));\n      renderSky();\n    }).catch(function(){ setupUI(); });\n  } else setupUI();\n});\n</script>\n</body>\n</html>\n"}