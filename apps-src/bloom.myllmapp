{"name": "Bloom", "kind": "html", "iconSymbol": "camera.macro", "iconColor": "pink", "html": "<!doctype html>\n<!--\n  Bloom — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Bloom</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>\n:root{--build-id:\"91f3dcf1ae\";\n  --bg:#fff6f7; --bg2:#fdeef3; --surface:#ffffff; --ink:#3a2a35; --muted:#8f7a88; --line:#f1dfe6;\n  --rose:#ee8fa6; --rose-2:#f7c1ce; --rose-3:#fde3ea; --rose-ink:#b8506c;\n  --lav:#b7a6ec; --lav-2:#dcd2fa; --lav-3:#efeafd; --lav-ink:#6e58c4;\n  --mint:#9ed9c8; --mint-3:#e4f6f0; --peach:#ffcfae; --peach-3:#fff0e4;\n  --shadow:0 6px 24px rgba(184,80,108,.10); --r:22px;\n  --font:ui-rounded,\"SF Pro Rounded\",-apple-system,system-ui,sans-serif;\n}\n@media (prefers-color-scheme:dark){ :root{\n  --bg:#1c1420; --bg2:#241a29; --surface:#2b2030; --ink:#f6e9f0; --muted:#b39fb0; --line:#3d2f43;\n  --rose:#f39ab0; --rose-2:#8c4a5e; --rose-3:#4a2b38; --rose-ink:#ffb3c6;\n  --lav:#b9a8f2; --lav-2:#5a4c8c; --lav-3:#352d52; --lav-ink:#d6cbff;\n  --mint:#7cc9b3; --mint-3:#21363a; --peach:#f0b48d; --peach-3:#3d2c26;\n  --shadow:0 6px 24px rgba(0,0,0,.35);\n} }\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nhtml,body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font);-webkit-font-smoothing:antialiased}\nbody{min-height:100vh;padding-bottom:calc(28px + env(safe-area-inset-bottom))}\nbutton{font:inherit;color:inherit;cursor:pointer}\n.wrap{max-width:560px;margin:0 auto;padding:0 16px}\n\n/* header */\n.head{display:flex;align-items:center;gap:12px;padding:14px 16px 6px;max-width:560px;margin:0 auto}\n.tile{width:44px;height:44px;border-radius:14px;display:grid;place-items:center;flex-shrink:0;\n  background:linear-gradient(140deg,var(--rose-2),var(--lav-2));color:#fff}\n.tile svg{width:26px;height:26px}\n.ht{flex:1;min-width:0}\n.ht h1{margin:0;font-size:22px;font-weight:700;letter-spacing:-.2px}\n.ht p{margin:1px 0 0;font-size:13px;color:var(--muted)}\n.hbtn{width:40px;height:40px;border-radius:12px;border:1px solid var(--line);background:var(--surface);display:grid;place-items:center;flex-shrink:0}\n.hbtn svg{width:19px;height:19px}\n.acts{display:flex;gap:8px}\n\n/* tabs */\n.tabs{display:flex;gap:4px;background:var(--bg2);border-radius:14px;padding:4px;margin:10px 0 14px}\n.tabs button{flex:1;border:0;background:transparent;padding:9px 0;border-radius:11px;font-size:15px;font-weight:600;color:var(--muted)}\n.tabs button.on{background:var(--surface);color:var(--rose-ink);box-shadow:0 1px 6px rgba(0,0,0,.06)}\n.view{display:none}.view.on{display:block}\n\n.card{background:var(--surface);border-radius:var(--r);box-shadow:var(--shadow);padding:18px;margin-bottom:14px}\n.card h2{margin:0 0 10px;font-size:17px}\n.sub{font-size:13px;color:var(--muted)}\n\n/* today ring */\n.ringbox{position:relative;width:min(300px,78vw);aspect-ratio:1;margin:4px auto 6px}\n.ringbox svg{width:100%;height:100%;overflow:visible}\n.ringc{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:0 22%}\n.ringc .k{font-size:13px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.6px}\n.ringc .n{font-size:52px;font-weight:700;line-height:1.05;letter-spacing:-1px}\n.ringc .p{font-size:15px;font-weight:600;margin-top:4px}\n.ringc .rs{font-size:13px;color:var(--muted);margin-top:3px}\n.status{text-align:center;font-size:15px;line-height:1.4;margin:4px 6px 14px}\n.status b{color:var(--rose-ink)}\n.status.fert b{color:var(--lav-ink)}\n.btnrow{display:flex;gap:10px}\n.btn{flex:1;border:0;border-radius:16px;padding:14px 10px;font-size:16px;font-weight:700;display:flex;align-items:center;justify-content:center;gap:8px}\n.btn svg{width:18px;height:18px}\n.btn span{white-space:nowrap}\n.btn.pri{background:var(--rose);color:#fff}\n.btn.alt{background:var(--lav-3);color:var(--lav-ink)}\n.btn.ghost{background:var(--bg2);color:var(--ink)}\n.btn.danger{background:#fde2e2;color:#b3261e}\n@media (prefers-color-scheme:dark){ .btn.danger{background:#4a2121;color:#ffb4ab} .btn.pri{color:#2b1420} }\n.btn:active,.chip:active,.day:active,.wk button:active{transform:scale(.97)}\n\n/* week strip */\n.wk{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;margin-top:4px}\n.wk button{border:0;background:transparent;padding:6px 0;border-radius:14px;display:flex;flex-direction:column;align-items:center;gap:5px}\n.wk .dn{font-size:11px;color:var(--muted);font-weight:600}\n.wk .dd{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;font-size:15px;font-weight:600;position:relative}\n.wk button.today .dn{color:var(--rose-ink)}\n.wk button.today .dd{outline:2px solid var(--ink);outline-offset:2px}\n\n.up{display:grid;grid-template-columns:1fr 1fr;gap:10px}\n.upc{border-radius:18px;padding:14px}\n.upc .t{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;opacity:.85}\n.upc .v{font-size:18px;font-weight:700;margin-top:4px}\n.upc .s{font-size:13px;margin-top:2px;opacity:.85}\n.upc.r{background:var(--rose-3);color:var(--rose-ink)}\n.upc.l{background:var(--lav-3);color:var(--lav-ink)}\n.upc.wide{grid-column:1/-1}\n.tip{display:flex;gap:12px;align-items:flex-start}\n.tip .ic{width:34px;height:34px;border-radius:11px;display:grid;place-items:center;flex-shrink:0;background:var(--peach-3);color:#c46f3a}\n.tip .ic svg{width:18px;height:18px}\n.tip p{margin:0;font-size:14px;line-height:1.45}\n.tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}\n.tag{font-size:13px;padding:5px 10px;border-radius:999px;background:var(--bg2)}\n\n/* calendar */\n.calhead{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}\n.calhead h2{margin:0;font-size:19px}\n.nav{display:flex;gap:6px}\n.nav button{width:36px;height:36px;border-radius:11px;border:1px solid var(--line);background:var(--surface);display:grid;place-items:center}\n.nav button svg{width:16px;height:16px}\n.dow,.grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}\n.dow div{text-align:center;font-size:11px;font-weight:700;color:var(--muted);padding-bottom:4px}\n.day{border:0;background:transparent;aspect-ratio:1;border-radius:50%;font-size:15px;font-weight:600;display:grid;place-items:center;position:relative;padding:0}\n.day.out{opacity:.3}\n.day.today{outline:2px solid var(--ink);outline-offset:1px}\n/* shared day marks (week, calendar, legend) — after .day so their fills win */\n.m-period{background:var(--rose);color:#fff}\n.m-pred{background:transparent;box-shadow:inset 0 0 0 2px var(--rose);color:var(--rose-ink)}\n.m-fert{background:var(--lav-2);color:var(--lav-ink)}\n.m-ov{background:var(--lav);color:#fff}\n.m-spot{box-shadow:inset 0 0 0 2px var(--rose-2)}\n@media (prefers-color-scheme:dark){ .m-period,.m-ov{color:#1c1420} }\n.logdot{position:absolute;bottom:3px;left:50%;width:5px;height:5px;margin-left:-2.5px;border-radius:50%;background:var(--muted)}\n.m-period .logdot,.m-ov .logdot{background:#fff}\n\n.legend{display:flex;flex-wrap:wrap;gap:12px;margin-top:14px;font-size:12px;color:var(--muted)}\n.legend span{display:flex;align-items:center;gap:6px}\n.legend i{width:14px;height:14px;border-radius:50%;display:inline-block}\n\n/* insights */\n.stats{display:grid;grid-template-columns:1fr 1fr;gap:10px}\n.stat{background:var(--bg2);border-radius:16px;padding:12px 14px}\n.stat .v{font-size:24px;font-weight:700}\n.stat .v small{font-size:14px;font-weight:600;color:var(--muted)}\n.stat .t{font-size:12px;color:var(--muted);font-weight:600}\n.bars{display:flex;flex-direction:column;gap:8px}\n.bar{display:grid;grid-template-columns:62px 1fr 34px;align-items:center;gap:8px;font-size:12px}\n.bar .lbl{color:var(--muted)}\n.bar .track{height:14px;border-radius:7px;background:var(--lav-3);position:relative;overflow:hidden}\n.bar .per{position:absolute;left:0;top:0;bottom:0;background:var(--rose);border-radius:7px}\n.bar .len{font-weight:700;text-align:right}\n.freq{display:flex;flex-direction:column;gap:8px}\n.fr{display:flex;align-items:center;gap:10px;font-size:14px}\n.fr .nm{flex:1}\n.fr .ph{font-size:12px;color:var(--muted)}\n.fr .ct{font-weight:700;min-width:22px;text-align:right}\n.note{font-size:13px;line-height:1.45;color:var(--muted);margin:10px 0 0}\n.note.warn{color:var(--rose-ink)}\n#tchart{width:100%;height:150px;display:block}\n\n/* sheets */\n.scrim{position:fixed;inset:0;background:rgba(40,20,32,.35);opacity:0;pointer-events:none;transition:opacity .2s;z-index:20}\n.scrim.on{opacity:1;pointer-events:auto}\n.sheet{position:fixed;left:0;right:0;bottom:0;max-height:92vh;max-height:92dvh;overflow-y:auto;background:var(--bg);border-radius:26px 26px 0 0;\n  transform:translateY(105%);visibility:hidden;transition:transform .28s cubic-bezier(.2,.8,.2,1),visibility 0s linear .28s;z-index:21;padding:8px 16px calc(24px + env(safe-area-inset-bottom));\n  max-width:600px;margin:0 auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain}\n.sheet.on{transform:none;visibility:visible;transition:transform .28s cubic-bezier(.2,.8,.2,1)}\n/* While a sheet or overlay is up the page behind stays put: a scroll that ran\n   past the sheet's end used to drag the page instead, and on iOS that left\n   neither of them scrolling (v1's \"freeze\"). */\nhtml.modal,html.modal body{overflow:hidden}\n.grab{width:40px;height:5px;border-radius:3px;background:var(--line);margin:4px auto 10px}\n.shead{display:flex;align-items:flex-start;gap:10px;margin-bottom:6px}\n.shead h3{margin:0;font-size:20px;flex:1}\n.shead .sub{margin-top:2px}\n.sec{margin-top:16px}\n.sec .lab{font-size:13px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px}\n.chips{display:flex;flex-wrap:wrap;gap:8px}\n.chip{border:1.5px solid var(--line);background:var(--surface);border-radius:999px;padding:8px 13px;font-size:14px;font-weight:600}\n.chip.on{border-color:var(--rose);background:var(--rose-3);color:var(--rose-ink)}\n.chips.lav .chip.on{border-color:var(--lav);background:var(--lav-3);color:var(--lav-ink)}\n.chips.mint .chip.on{border-color:var(--mint);background:var(--mint-3)}\n.flow{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}\n.flow .chip{border-radius:16px;padding:10px 2px;display:flex;flex-direction:column;align-items:center;gap:4px;font-size:12px}\n.drops{display:flex;gap:1px;height:16px;align-items:flex-end}\n.drops svg{width:11px;height:14px}\n.field{display:flex;align-items:center;gap:10px}\n.field input[type=number],.field input[type=date],textarea{font:inherit;font-size:16px;color:var(--ink);background:var(--surface);border:1.5px solid var(--line);border-radius:14px;padding:11px 12px}\n.field input[type=number]{width:120px}\ntextarea{width:100%;min-height:72px;resize:vertical}\n.err{color:#c0392b;font-size:13px;margin-top:6px}\n.row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid var(--line)}\n.row:last-child{border-bottom:0}\n.row .rl{flex:1;font-size:15px}\n.row .rl small{display:block;color:var(--muted);font-size:12.5px;margin-top:2px;line-height:1.35}\n.step{display:flex;align-items:center;gap:8px}\n.step button{width:34px;height:34px;border-radius:10px;border:1px solid var(--line);background:var(--surface);font-size:18px;font-weight:700}\n.step span{min-width:52px;text-align:center;font-weight:700}\n.seg{display:flex;background:var(--bg2);border-radius:12px;padding:3px}\n.seg button{border:0;background:transparent;padding:7px 12px;border-radius:9px;font-size:14px;font-weight:600;color:var(--muted)}\n.seg button.on{background:var(--surface);color:var(--ink)}\n.privacy{display:flex;gap:12px;align-items:flex-start;background:var(--mint-3);border-radius:18px;padding:14px;font-size:14px;line-height:1.45}\n.privacy svg{width:22px;height:22px;flex-shrink:0;color:#2f8f74}\n@media (prefers-color-scheme:dark){ .privacy svg{color:var(--mint)} }\n.disc{font-size:12.5px;color:var(--muted);line-height:1.45;text-align:center;margin:18px 8px 0}\n\n/* full-screen overlays: welcome + lock */\n.over{position:fixed;inset:0;z-index:30;background:linear-gradient(170deg,var(--rose-3),var(--bg) 45%,var(--lav-3));overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;\n  padding:calc(24px + env(safe-area-inset-top)) 20px calc(28px + env(safe-area-inset-bottom))}\n.over[hidden]{display:none}\n.over .in{max-width:460px;margin:0 auto}\n/* The welcome and lock screens cover the header, so they carry their own way out. */\n.over-x{display:none;position:fixed;z-index:31;top:calc(12px + env(safe-area-inset-top));right:14px;width:40px;height:40px;border-radius:12px;padding:0;place-items:center;\n  border:1px solid var(--myllm-border,rgba(128,128,128,.28));background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--ink)}\nbody.imm .over-x{display:grid}\n.over-x svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.over-x:active{transform:scale(.94)}\n.hero{text-align:center;margin:10px 0 18px}\n.hero .tile{width:76px;height:76px;border-radius:24px;margin:0 auto 14px}\n.hero .tile svg{width:44px;height:44px}\n.hero h2{margin:0;font-size:28px}\n.hero p{margin:6px 0 0;color:var(--muted);font-size:15px;line-height:1.45}\n.q{background:var(--surface);border-radius:20px;padding:16px;margin-bottom:12px;box-shadow:var(--shadow)}\n.q .ql{font-weight:700;margin-bottom:10px}\n.pin{display:flex;justify-content:center;gap:14px;margin:22px 0}\n.pin i{width:16px;height:16px;border-radius:50%;border:2px solid var(--rose)}\n.pin i.f{background:var(--rose)}\n.pad{display:grid;grid-template-columns:repeat(3,76px);gap:14px;justify-content:center}\n.pad button{width:76px;height:76px;border-radius:50%;border:0;background:var(--surface);box-shadow:var(--shadow);font-size:28px;font-weight:600}\n.pad button.blank{visibility:hidden}\n.pad button.sm{font-size:15px;background:transparent;box-shadow:none;color:var(--muted)}\n.pad button:active{background:var(--rose-3)}\n.lockmsg{text-align:center;min-height:22px;font-size:14px;color:var(--rose-ink);margin-top:14px}\n.shake{animation:sh .35s}\n@keyframes sh{20%,60%{transform:translateX(-8px)}40%,80%{transform:translateX(8px)}}\n@media (prefers-reduced-motion:reduce){ .sheet,.scrim{transition:none} .shake{animation:none} .btn:active,.chip:active,.day:active{transform:none} }\n.hidden{display:none!important}\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\n.topbar{position:sticky;top:0;z-index:10;background:var(--bg)}\nbody.imm .imm-safe{display:block}\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-bloom\" viewBox=\"0 0 24 24\"><g fill=\"currentColor\"><ellipse cx=\"12\" cy=\"6.4\" rx=\"3.3\" ry=\"4.4\"/><ellipse cx=\"12\" cy=\"17.6\" rx=\"3.3\" ry=\"4.4\"/><ellipse cx=\"6.4\" cy=\"12\" rx=\"4.4\" ry=\"3.3\"/><ellipse cx=\"17.6\" cy=\"12\" rx=\"4.4\" ry=\"3.3\"/></g><circle cx=\"12\" cy=\"12\" r=\"2.8\" fill=\"#fff\" opacity=\".9\"/></symbol>\n  <symbol id=\"i-gear\" viewBox=\"0 0 24 24\"><path d=\"M12 15.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M19.4 13.5l1.6 1.2-1.8 3.1-1.9-.7a7.4 7.4 0 0 1-2 1.2l-.3 2h-3.6l-.3-2a7.4 7.4 0 0 1-2-1.2l-1.9.7-1.8-3.1 1.6-1.2a7.6 7.6 0 0 1 0-3l-1.6-1.2 1.8-3.1 1.9.7a7.4 7.4 0 0 1 2-1.2l.3-2h3.6l.3 2a7.4 7.4 0 0 1 2 1.2l1.9-.7 1.8 3.1-1.6 1.2a7.6 7.6 0 0 1 0 3z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-drop\" viewBox=\"0 0 12 16\"><path d=\"M6 1C6 1 1 7.2 1 10.4A5 5 0 0 0 11 10.4C11 7.2 6 1 6 1z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-plus\" viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-l\" viewBox=\"0 0 24 24\"><path d=\"M15 5l-7 7 7 7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-r\" viewBox=\"0 0 24 24\"><path d=\"M9 5l7 7-7 7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-lock\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"10.5\" width=\"14\" height=\"10\" rx=\"3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M8 10.5V8a4 4 0 0 1 8 0v2.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></symbol>\n  <symbol id=\"i-shield\" viewBox=\"0 0 24 24\"><path d=\"M12 3l7.5 3v5.5c0 4.6-3.2 8.3-7.5 9.5-4.3-1.2-7.5-4.9-7.5-9.5V6L12 3z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\"/><path d=\"M8.6 12.2l2.4 2.4 4.6-4.8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-moon\" viewBox=\"0 0 24 24\"><path d=\"M19.5 14.6A8 8 0 0 1 9.4 4.5a8 8 0 1 0 10.1 10.1z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\"/></symbol>\n</defs></svg>\n\n<div class=\"topbar\"><div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg><use href=\"#i-bloom\"/></svg></div>\n  <div class=\"ht\"><h1>Bloom</h1><p>Your cycle, privately</p></div>\n  <div class=\"acts\"><button type=\"button\" class=\"hbtn\" id=\"gear\" aria-label=\"Settings\"><svg><use href=\"#i-gear\"/></svg></button></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Bloom\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div></div>\n\n<main class=\"wrap\" id=\"app\">\n  <div class=\"tabs\" role=\"tablist\">\n    <button type=\"button\" class=\"on\" data-tab=\"today\" role=\"tab\">Today</button>\n    <button type=\"button\" data-tab=\"cal\" role=\"tab\">Calendar</button>\n    <button type=\"button\" data-tab=\"ins\" role=\"tab\">Insights</button>\n  </div>\n\n  <section class=\"view on\" id=\"v-today\">\n    <div class=\"card\">\n      <div class=\"ringbox\"><svg id=\"ring\" viewBox=\"0 0 300 300\" aria-hidden=\"true\"></svg>\n        <div class=\"ringc\"><div class=\"k\" id=\"rk\">Cycle day</div><div class=\"n\" id=\"rn\">–</div><div class=\"p\" id=\"rp\"></div><div class=\"rs\" id=\"rq\"></div></div></div>\n      <div class=\"status\" id=\"status\"></div>\n      <div class=\"btnrow\">\n        <button type=\"button\" class=\"btn pri\" id=\"periodBtn\"><svg><use href=\"#i-drop\" /></svg><span id=\"periodTxt\">Period started</span></button>\n        <button type=\"button\" class=\"btn alt\" id=\"logBtn\"><svg><use href=\"#i-plus\"/></svg>Log today</button>\n      </div>\n      <div class=\"wk\" id=\"week\"></div>\n    </div>\n    <div class=\"up\" id=\"upcoming\"></div>\n    <div class=\"card\" id=\"todayLog\" style=\"margin-top:14px\"></div>\n    <div class=\"card\"><div class=\"tip\"><div class=\"ic\"><svg><use href=\"#i-moon\"/></svg></div><p id=\"phaseTip\"></p></div></div>\n    <p class=\"disc\">Bloom estimates from what you log. It isn't contraception and isn't medical advice.</p>\n  </section>\n\n  <section class=\"view\" id=\"v-cal\">\n    <div class=\"card\">\n      <div class=\"calhead\"><h2 id=\"mTitle\"></h2><div class=\"nav\"><button type=\"button\" id=\"prevM\" aria-label=\"Previous month\"><svg><use href=\"#i-l\"/></svg></button><button type=\"button\" id=\"nextM\" aria-label=\"Next month\"><svg><use href=\"#i-r\"/></svg></button></div></div>\n      <div class=\"dow\"><div>M</div><div>T</div><div>W</div><div>T</div><div>F</div><div>S</div><div>S</div></div>\n      <div class=\"grid\" id=\"grid\"></div>\n      <div class=\"legend\">\n        <span><i class=\"m-period\"></i>Period</span><span><i class=\"m-pred\"></i>Predicted</span>\n        <span><i class=\"m-fert\"></i>Fertile</span><span><i class=\"m-ov\"></i>Ovulation</span>\n      </div>\n    </div>\n    <p class=\"disc\">Tap any day up to today to log it. Future days show predictions.</p>\n  </section>\n\n  <section class=\"view\" id=\"v-ins\">\n    <div class=\"card\"><h2>Your averages</h2><div class=\"stats\" id=\"stats\"></div><p class=\"note\" id=\"statNote\"></p></div>\n    <div class=\"card\"><h2>Recent cycles</h2><div class=\"bars\" id=\"bars\"></div><p class=\"note\" id=\"barNote\"></p></div>\n    <div class=\"card\" id=\"tempCard\"><h2>Temperature this cycle</h2><svg id=\"tchart\" viewBox=\"0 0 320 150\" preserveAspectRatio=\"none\"></svg><p class=\"note\" id=\"tempNote\"></p></div>\n    <div class=\"card\"><h2>Symptoms &amp; moods</h2><div class=\"sub\">The last 90 days, and the phase they mostly come in</div><div class=\"freq\" id=\"freq\" style=\"margin-top:12px\"></div></div>\n  </section>\n</main>\n\n<div class=\"scrim\" id=\"scrim\"></div>\n\n<!-- log a day -->\n<div class=\"sheet\" id=\"daySheet\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"dTitle\">\n  <div class=\"grab\"></div>\n  <div class=\"shead\"><div style=\"flex:1\"><h3 id=\"dTitle\"></h3><div class=\"sub\" id=\"dSub\"></div></div><button type=\"button\" class=\"hbtn\" id=\"dDone\" aria-label=\"Done\" style=\"width:auto;padding:0 14px;font-weight:700;color:var(--rose-ink)\">Done</button></div>\n  <div class=\"sec\"><div class=\"lab\">Period</div><div class=\"flow\" id=\"fFlow\"></div></div>\n  <div class=\"sec\"><div class=\"lab\">Symptoms</div><div class=\"chips\" id=\"fSym\"></div></div>\n  <div class=\"sec\"><div class=\"lab\">Mood</div><div class=\"chips lav\" id=\"fMood\"></div></div>\n  <div class=\"sec\"><div class=\"lab\">Discharge</div><div class=\"chips mint\" id=\"fCm\"></div></div>\n  <div class=\"sec\"><div class=\"lab\">Ovulation test (LH)</div><div class=\"chips lav\" id=\"fLh\"></div></div>\n  <div class=\"sec\"><div class=\"lab\">Temperature on waking</div>\n    <div class=\"field\"><input type=\"number\" inputmode=\"decimal\" step=\"0.01\" id=\"fTemp\" placeholder=\"36.45\"><span id=\"fUnit\">°C</span></div><div class=\"err hidden\" id=\"tempErr\"></div></div>\n  <div class=\"sec\"><div class=\"lab\">Sex</div><div class=\"chips\" id=\"fSex\"></div></div>\n  <div class=\"sec\"><div class=\"lab\">Note</div><textarea id=\"fNote\" placeholder=\"Anything else about today\" maxlength=\"500\"></textarea></div>\n  <div class=\"sec\"><button type=\"button\" class=\"btn ghost\" id=\"dClear\" style=\"width:100%\">Clear this day</button></div>\n</div>\n\n<!-- settings -->\n<div class=\"sheet\" id=\"setSheet\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Settings\">\n  <div class=\"grab\"></div>\n  <div class=\"shead\"><h3>Settings</h3><button type=\"button\" class=\"hbtn\" id=\"sDone\" style=\"width:auto;padding:0 14px;font-weight:700;color:var(--rose-ink)\">Done</button></div>\n  <div class=\"card\" style=\"padding:4px 16px\">\n    <div class=\"row\"><div class=\"rl\">I'm using Bloom to<small id=\"goalNote\"></small></div><div class=\"seg\" id=\"sGoal\"><button type=\"button\" data-v=\"track\">Track</button><button type=\"button\" data-v=\"ttc\">Conceive</button></div></div>\n    <div class=\"row\"><div class=\"rl\">Usual cycle length<small id=\"cycNote\"></small></div><div class=\"step\"><button type=\"button\" data-k=\"cycle\" data-d=\"-1\">−</button><span id=\"sCycle\"></span><button type=\"button\" data-k=\"cycle\" data-d=\"1\">+</button></div></div>\n    <div class=\"row\"><div class=\"rl\">Usual period length<small id=\"perNote\"></small></div><div class=\"step\"><button type=\"button\" data-k=\"period\" data-d=\"-1\">−</button><span id=\"sPeriod\"></span><button type=\"button\" data-k=\"period\" data-d=\"1\">+</button></div></div>\n    <div class=\"row\"><div class=\"rl\">Days from ovulation to period<small>Usually 14. Change it only if a doctor or your own temperature charts say otherwise.</small></div><div class=\"step\"><button type=\"button\" data-k=\"luteal\" data-d=\"-1\">−</button><span id=\"sLuteal\"></span><button type=\"button\" data-k=\"luteal\" data-d=\"1\">+</button></div></div>\n    <div class=\"row\"><div class=\"rl\">Temperature</div><div class=\"seg\" id=\"sUnit\"><button type=\"button\" data-v=\"C\">°C</button><button type=\"button\" data-v=\"F\">°F</button></div></div>\n  </div>\n  <div class=\"card\" style=\"padding:4px 16px\">\n    <div class=\"row\"><div class=\"rl\"><b>Passcode</b><small id=\"pcNote\"></small></div><button type=\"button\" class=\"btn alt\" id=\"pcBtn\" style=\"flex:0 0 auto;padding:10px 14px;font-size:14px\"></button></div>\n    <div class=\"row hidden\" id=\"pcOffRow\"><div class=\"rl\">Turn passcode off<small>Your log is kept unencrypted again.</small></div><button type=\"button\" class=\"btn ghost\" id=\"pcOff\" style=\"flex:0 0 auto;padding:10px 14px;font-size:14px\">Turn off</button></div>\n  </div>\n  <div class=\"privacy\"><svg><use href=\"#i-shield\"/></svg><div><b>Your data stays on this phone.</b> Bloom makes no internet requests, uses no AI, and shares nothing with other apps or with MyLLM's assistant. Your log is saved only inside MyLLM on this iPhone, and travels only in your phone's own backup, like your photos.</div></div>\n  <div class=\"card\" style=\"padding:4px 16px;margin-top:14px\">\n    <div class=\"row\"><div class=\"rl\">Export my log<small>A spreadsheet (CSV) you send where you choose — for a doctor, say. Once it leaves Bloom, it's out of Bloom's hands.</small></div><button type=\"button\" class=\"btn ghost\" id=\"exportBtn\" style=\"flex:0 0 auto;padding:10px 14px;font-size:14px\">Export</button></div>\n    <div class=\"row\"><div class=\"rl\">Erase everything<small>Deletes your whole log and settings from this phone. This can't be undone.</small></div><button type=\"button\" class=\"btn danger\" id=\"eraseBtn\" style=\"flex:0 0 auto;padding:10px 14px;font-size:14px\">Erase</button></div>\n  </div>\n  <p class=\"disc\">Bloom predicts from averages and from what you log. Predictions can be wrong, especially when cycles vary. Bloom isn't a method of contraception and isn't medical advice — talk to a doctor, nurse or pharmacist about anything that worries you.</p>\n</div>\n\n<!-- first run -->\n<div class=\"over\" id=\"welcome\" hidden>\n  <button type=\"button\" class=\"over-x\" aria-label=\"Close Bloom\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button>\n  <div class=\"in\">\n    <div class=\"hero\"><div class=\"tile\"><svg><use href=\"#i-bloom\"/></svg></div><h2>Welcome to Bloom</h2><p>A calm, private way to follow your cycle — your period, fertile days, ovulation and how you feel.</p></div>\n    <div class=\"privacy\" style=\"margin-bottom:12px\"><svg><use href=\"#i-shield\"/></svg><div><b>Private by design.</b> Everything stays on this phone. No account, no internet, no AI, no sharing. Add a passcode any time to encrypt it.</div></div>\n    <div class=\"q\"><div class=\"ql\">When did your last period start?</div><div class=\"field\"><input type=\"date\" id=\"wStart\"></div><div class=\"sub\" style=\"margin-top:8px\">Not sure? Leave it empty and log your next period when it comes.</div></div>\n    <div class=\"q\"><div class=\"ql\">How long is your cycle, usually?</div><div class=\"step\"><button type=\"button\" data-w=\"cycle\" data-d=\"-1\">−</button><span id=\"wCycle\">28 days</span><button type=\"button\" data-w=\"cycle\" data-d=\"1\">+</button></div><div class=\"sub\" style=\"margin-top:8px\">From the first day of one period to the first day of the next. 28 is a fine guess; Bloom learns yours.</div></div>\n    <div class=\"q\"><div class=\"ql\">And your period?</div><div class=\"step\"><button type=\"button\" data-w=\"period\" data-d=\"-1\">−</button><span id=\"wPeriod\">5 days</span><button type=\"button\" data-w=\"period\" data-d=\"1\">+</button></div></div>\n    <div class=\"q\"><div class=\"ql\">What would you like Bloom to help with?</div><div class=\"seg\" id=\"wGoal\"><button type=\"button\" data-v=\"track\" class=\"on\">Track my cycle</button><button type=\"button\" data-v=\"ttc\">Trying to conceive</button></div></div>\n    <button type=\"button\" class=\"btn pri\" id=\"wGo\" style=\"width:100%;margin-top:6px\">Start</button>\n    <p class=\"disc\">Bloom isn't contraception and isn't medical advice.</p>\n  </div>\n</div>\n\n<!-- passcode (unlock, or set) -->\n<div class=\"over\" id=\"lock\" hidden>\n  <button type=\"button\" class=\"over-x\" aria-label=\"Close Bloom\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button>\n  <div class=\"in\">\n    <div class=\"hero\"><div class=\"tile\"><svg><use href=\"#i-lock\"/></svg></div><h2 id=\"lockTitle\">Bloom is locked</h2><p id=\"lockSub\">Enter your passcode</p></div>\n    <div class=\"pin\" id=\"pinDots\"></div>\n    <div class=\"pad\" id=\"pad\"></div>\n    <div class=\"lockmsg\" id=\"lockMsg\"></div>\n    <div style=\"text-align:center;margin-top:18px\"><button type=\"button\" class=\"btn ghost hidden\" id=\"lockCancel\" style=\"display:inline-flex;flex:0;padding:10px 18px\">Cancel</button>\n      <button type=\"button\" class=\"btn ghost\" id=\"forgot\" style=\"display:inline-flex;flex:0;padding:10px 18px;font-size:14px\">Forgot passcode?</button></div>\n  </div>\n</div>\n\n<script>\n\"use strict\";\n/* ---------- storage: MyLLM's private per-app store (never the shared files) ---------- */\n/* Outside MyLLM there is nowhere private to keep it, so nothing is kept. */\nvar mem = {};\nvar store = window.myllmStorage || {\n  getItem: function(k){ return Promise.resolve(k in mem ? mem[k] : null); },\n  setItem: function(k, v){ mem[k] = String(v); return Promise.resolve(); },\n  removeItem: function(k){ delete mem[k]; return Promise.resolve(); }\n};\nvar KEY = \"bloom.v1\", EKEY = \"bloom.v1.enc\";\nfunction fresh(){ return { v:1, settings:{ cycle:28, period:5, luteal:14, goal:\"track\", unit:\"C\", setup:false, seed:null }, days:{} }; }\nvar S = null;            // the whole log, in memory only while unlocked\nvar cryptoKey = null;    // AES key while a passcode is on and the app is unlocked\nvar salt = null;\nvar hasCrypto = !!(window.crypto && crypto.subtle && window.isSecureContext !== false);\n\nfunction haptic(s){ try { if (window.myllmHaptic) window.myllmHaptic(s); } catch(e){} }\n\n/* ---------- dates (local days, never UTC) ---------- */\nfunction pad2(n){ return (n < 10 ? \"0\" : \"\") + n; }\nfunction dk(d){ return d.getFullYear() + \"-\" + pad2(d.getMonth() + 1) + \"-\" + pad2(d.getDate()); }\nfunction pd(k){ var p = k.split(\"-\"); return new Date(+p[0], +p[1] - 1, +p[2]); }\nfunction add(k, n){ var d = pd(k); d.setDate(d.getDate() + n); return dk(d); }\nfunction diff(a, b){ return Math.round((pd(b) - pd(a)) / 864e5); }   // b - a, in days\nfunction todayK(){ return dk(new Date()); }\nvar MON = [\"January\",\"February\",\"March\",\"April\",\"May\",\"June\",\"July\",\"August\",\"September\",\"October\",\"November\",\"December\"];\nvar WD = [\"Sunday\",\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\"];\nfunction nice(k){ var d = pd(k); return d.getDate() + \" \" + MON[d.getMonth()].slice(0,3); }\nfunction longDay(k){ var d = pd(k); return WD[d.getDay()] + \" \" + d.getDate() + \" \" + MON[d.getMonth()]; }\nfunction inDays(n){ return n === 0 ? \"today\" : n === 1 ? \"tomorrow\" : n === -1 ? \"yesterday\" : n > 0 ? \"in \" + n + \" days\" : -n + \" days ago\"; }\nfunction esc(s){ return String(s).replace(/[&<>\"']/g, function(c){ return {\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",\"\\\"\":\"&quot;\",\"'\":\"&#39;\"}[c]; }); }\n\n/* ---------- what can be logged ---------- */\nvar FLOW = [[\"none\",\"None\",0],[\"spot\",\"Spotting\",0],[\"light\",\"Light\",1],[\"medium\",\"Medium\",2],[\"heavy\",\"Heavy\",3]];\nvar SYM = [\"Cramps\",\"Headache\",\"Bloating\",\"Tender breasts\",\"Backache\",\"Acne\",\"Fatigue\",\"Cravings\",\"Nausea\",\"Trouble sleeping\",\"Low libido\",\"High libido\"];\nvar MOOD = [\"Happy\",\"Calm\",\"Energetic\",\"Sensitive\",\"Irritable\",\"Anxious\",\"Low\",\"Mood swings\"];\nvar CM = [[\"dry\",\"Dry\"],[\"sticky\",\"Sticky\"],[\"creamy\",\"Creamy\"],[\"watery\",\"Watery\"],[\"eggwhite\",\"Egg white\"]];\nvar LH = [[\"neg\",\"Negative\"],[\"pos\",\"Positive\"]];\nvar SEX = [[\"yes\",\"Had sex\"],[\"protected\",\"Protected\"]];\nfunction isBleed(f){ return f === \"light\" || f === \"medium\" || f === \"heavy\"; }\n\n/* ---------- the model: periods, averages, predictions ---------- */\n/* A period starts on a day of light-or-heavier bleeding with none in the two\n   days before it (spotting never starts one). Averages come from the last six\n   cycles of 15–60 days; until two are logged, the usual lengths from settings. */\nfunction periods(){\n  var keys = Object.keys(S.days).filter(function(k){ return isBleed(S.days[k].flow); }).sort();\n  var out = [];\n  keys.forEach(function(k){\n    var last = out[out.length - 1];\n    if (last && diff(last.end, k) <= 2) last.end = k; else out.push({ start:k, end:k, logged:true });\n  });\n  var seed = S.settings.seed;\n  if (seed && !out.some(function(p){ return Math.abs(diff(p.start, seed)) <= 10; })) {\n    out.push({ start:seed, end:add(seed, S.settings.period - 1), logged:false });\n    out.sort(function(a, b){ return a.start < b.start ? -1 : 1; });\n  }\n  return out;\n}\nfunction model(){\n  var t = todayK(), set = S.settings, ps = periods().filter(function(p){ return p.start <= t; });\n  var lens = [];\n  for (var i = 1; i < ps.length; i++){ var L = diff(ps[i-1].start, ps[i].start); if (L >= 15 && L <= 60) lens.push({ start:ps[i-1].start, len:L, per:diff(ps[i-1].start, ps[i-1].end) + 1, logged:ps[i-1].logged }); }\n  var recent = lens.slice(-6);\n  var avgCycle = recent.length >= 2 ? Math.round(recent.reduce(function(s, c){ return s + c.len; }, 0) / recent.length) : set.cycle;\n  var loggedPer = ps.filter(function(p){ return p.logged; }).slice(-6).map(function(p){ return diff(p.start, p.end) + 1; });\n  var avgPeriod = loggedPer.length ? Math.round(loggedPer.reduce(function(a, b){ return a + b; }, 0) / loggedPer.length) : set.period;\n  var spread = recent.length >= 3 ? Math.max.apply(null, recent.map(function(c){ return c.len; })) - Math.min.apply(null, recent.map(function(c){ return c.len; })) : 0;\n  var m = { today:t, periods:ps, cycles:lens, avgCycle:avgCycle, avgPeriod:avgPeriod, spread:spread, luteal:set.luteal };\n  var last = ps[ps.length - 1];\n  if (!last) return m;\n  m.start = last.start;\n  m.inPeriod = last.end >= t && last.logged || (!last.logged && last.end >= t);\n  m.periodEnd = last.end;\n  m.day = diff(last.start, t) + 1;\n  m.next = add(last.start, avgCycle);\n  m.late = Math.max(0, diff(m.next, t));\n  /* Ovulation this cycle: a temperature shift confirms it; a positive LH\n     test predicts it the next day; otherwise count back from the next period. */\n  var ov = null, how = \"estimate\";\n  var shift = tempShift(last.start, t);\n  if (shift) { ov = add(shift, -1); how = \"temperature\"; }\n  else {\n    var lh = Object.keys(S.days).filter(function(k){ return k >= last.start && k <= t && S.days[k].lh === \"pos\"; }).sort()[0];\n    if (lh) { ov = add(lh, 1); how = \"lh\"; }\n  }\n  if (!ov) ov = add(m.next, -set.luteal);\n  if (ov <= last.end) ov = add(last.end, 1);\n  m.ov = ov; m.ovHow = how;\n  m.fertStart = add(ov, -5); m.fertEnd = ov;\n  return m;\n}\n/* The \"three over six\" rule: the first of three temperatures each at least\n   0.2 °C above the highest of the six before them marks the shift after\n   ovulation. Returns that day's key, or null. */\nfunction tempShift(from, to){\n  var ks = Object.keys(S.days).filter(function(k){ return k >= from && k <= to && typeof S.days[k].temp === \"number\"; }).sort();\n  var c = ks.map(function(k){ return toC(S.days[k].temp); });\n  for (var i = 6; i + 2 < c.length; i++){\n    var cover = Math.max.apply(null, c.slice(i - 6, i));\n    if (c[i] >= cover + 0.2 && c[i+1] >= cover + 0.2 && c[i+2] >= cover + 0.2) return ks[i];\n  }\n  return null;\n}\nfunction toC(v){ return v > 50 ? (v - 32) * 5 / 9 : v; }   // stored as entered; °F values are > 50\n/* What a day is: logged bleeding, or for this cycle and the next three, predicted. */\nfunction dayKind(k, m){\n  var e = S.days[k];\n  if (e && isBleed(e.flow)) return \"period\";\n  if (!m.start) return e && e.flow === \"spot\" ? \"spot\" : \"\";\n  var t = m.today;\n  if (k <= t) {\n    if (k >= m.start) { if (k === m.ov) return \"ov\"; if (k >= m.fertStart && k <= m.fertEnd) return \"fert\"; }\n    if (!m.periods[m.periods.length - 1].logged && k >= m.start && k <= m.periodEnd) return \"pred\";\n    return e && e.flow === \"spot\" ? \"spot\" : \"\";\n  }\n  if (k <= m.fertEnd && k >= m.fertStart) return k === m.ov ? \"ov\" : \"fert\";\n  // A late period is expected from tomorrow, and the cycles after it follow on from there.\n  var base = m.late ? add(t, 1) : m.next;\n  for (var c = 0; c < 4; c++){\n    var s = add(base, m.avgCycle * c);\n    if (k >= s && k <= add(s, m.avgPeriod - 1)) return \"pred\";\n    var ov = add(s, m.avgCycle - m.luteal);\n    if (c < 3 && k >= add(ov, -5) && k <= ov) return k === ov ? \"ov\" : \"fert\";\n  }\n  return \"\";\n}\nfunction phaseOf(k, m){\n  var ps = m.periods, i;\n  for (i = ps.length - 1; i >= 0 && ps[i].start > k; i--);\n  if (i < 0) return null;\n  var start = ps[i].start, end = ps[i].end, next = ps[i+1] ? ps[i+1].start : add(start, m.avgCycle);\n  var ov = i === ps.length - 1 && m.ov ? m.ov : add(next, -m.luteal);\n  if (k <= end) return \"period\";\n  if (Math.abs(diff(ov, k)) <= 1) return \"ovulation\";\n  return k < ov ? \"follicular\" : \"luteal\";\n}\nvar PHASE = { period:\"Period\", follicular:\"Follicular phase\", ovulation:\"Ovulation\", luteal:\"Luteal phase\" };\n\n/* ---------- render: Today ---------- */\nvar $ = function(id){ return document.getElementById(id); };\nfunction render(){\n  if (!S) return;\n  var m = model();\n  renderToday(m); renderCal(m); renderIns(m);\n}\nfunction renderToday(m){\n  var ring = $(\"ring\"), t = m.today;\n  if (!m.start) {\n    $(\"rk\").textContent = \"Welcome\"; $(\"rn\").textContent = \"🌸\"; $(\"rp\").textContent = \"Log your period\"; $(\"rq\").textContent = \"to see predictions\";\n    ring.innerHTML = '<circle cx=\"150\" cy=\"150\" r=\"128\" fill=\"none\" stroke=\"var(--rose-3)\" stroke-width=\"18\"/>';\n    $(\"status\").innerHTML = \"When your period comes, tap <b>Period started</b>. Bloom learns your cycle from there.\";\n    $(\"upcoming\").innerHTML = \"\"; $(\"periodTxt\").textContent = \"Period started\";\n  } else {\n    var n = Math.max(m.avgCycle, m.day), segs = \"\", R = 128, C = 150, gap = n > 40 ? 0.6 : 1.2;\n    for (var i = 0; i < n; i++){\n      var k = add(m.start, i), kind = dayKind(k, m), col = \"var(--line)\";\n      if (i < m.avgPeriod && (kind === \"period\" || kind === \"pred\" || k <= m.periodEnd)) col = kind === \"period\" ? \"var(--rose)\" : \"var(--rose-2)\";\n      else if (kind === \"ov\") col = \"var(--lav)\";\n      else if (kind === \"fert\") col = \"var(--lav-2)\";\n      else if (kind === \"period\") col = \"var(--rose)\";\n      var a0 = (i / n) * 360 + gap / 2, a1 = ((i + 1) / n) * 360 - gap / 2;\n      segs += arc(C, C, R, a0, a1, col);\n    }\n    var ad = ((m.day - 0.5) / n) * 360, rad = (ad - 90) * Math.PI / 180;\n    var mx = C + R * Math.cos(rad), my = C + R * Math.sin(rad);\n    segs += '<circle cx=\"' + mx.toFixed(1) + '\" cy=\"' + my.toFixed(1) + '\" r=\"15\" fill=\"var(--surface)\" stroke=\"var(--ink)\" stroke-width=\"3\"/>';\n    ring.innerHTML = segs;\n    $(\"rk\").textContent = \"Cycle day\"; $(\"rn\").textContent = m.day;\n    var ph = phaseOf(t, m);\n    $(\"rp\").textContent = m.late ? \"Period late\" : PHASE[ph] || \"\";\n    $(\"rq\").textContent = m.inPeriod ? \"Day \" + (diff(m.start, t) + 1) + \" of your period\" : m.late ? m.late + (m.late === 1 ? \" day\" : \" days\") + \" after expected\" : \"Period \" + inDays(diff(t, m.next));\n    var st = $(\"status\"); st.className = \"status\";\n    var ttc = S.settings.goal === \"ttc\";\n    if (m.late) {\n      st.innerHTML = \"Your period is <b>\" + m.late + (m.late === 1 ? \" day\" : \" days\") + \" late</b>. Cycles vary; stress, illness and travel can all shift one.\" + (m.late >= 3 ? \" If you might be pregnant, a test is reliable from now.\" : \"\");\n    } else if (m.inPeriod) {\n      st.innerHTML = \"You're on your period. <b>Tap Log today</b> to note flow and how you feel.\";\n    } else if (t === m.ov) {\n      st.className = \"status fert\"; st.innerHTML = \"<b>Ovulation day</b> (\" + ovWord(m) + \") — \" + (ttc ? \"your most fertile time.\" : \"your fertile window's peak.\");\n    } else if (t >= m.fertStart && t <= m.fertEnd) {\n      st.className = \"status fert\"; var hi = diff(t, m.ov) <= 2;\n      st.innerHTML = \"<b>Fertile window</b> · \" + (hi ? \"high\" : \"medium\") + \" chance of pregnancy\" + (ttc ? \". A good time to try.\" : \".\");\n    } else if (t < m.fertStart) {\n      st.innerHTML = \"Fertile window starts <b>\" + inDays(diff(t, m.fertStart)) + \"</b> (\" + nice(m.fertStart) + \").\";\n    } else {\n      st.innerHTML = \"Next period expected <b>\" + inDays(diff(t, m.next)) + \"</b>, around \" + nice(m.next) + \".\";\n    }\n    $(\"periodTxt\").textContent = m.inPeriod && S.days[t] && isBleed(S.days[t].flow) ? \"Period ended\" : \"Period started\";\n    var up = \"\";\n    up += '<div class=\"upc r\"><div class=\"t\">Next period</div><div class=\"v\">' + (m.late ? \"Late\" : nice(m.next)) + '</div><div class=\"s\">' + (m.late ? \"expected \" + nice(m.next) : inDays(diff(t, m.next))) + '</div></div>';\n    var futureOv = m.ov >= t ? m.ov : add(add(m.next, m.late ? diff(m.next, t) + 1 : 0), m.avgCycle - m.luteal);\n    var fs = add(futureOv, -5);\n    up += '<div class=\"upc l\"><div class=\"t\">Ovulation</div><div class=\"v\">' + nice(futureOv) + '</div><div class=\"s\">' + (futureOv === m.ov && m.ovHow !== \"estimate\" ? ovWord(m) : \"estimated · \" + inDays(diff(t, futureOv))) + '</div></div>';\n    up += '<div class=\"upc l wide\"><div class=\"t\">Fertile window</div><div class=\"v\">' + (t >= m.fertStart && t <= m.fertEnd ? \"Now, until \" + nice(m.fertEnd) : nice(fs) + \" – \" + nice(futureOv)) + '</div><div class=\"s\">The five days before ovulation and the day itself' + (m.spread > 7 ? \". Your cycles vary, so give it a few days either side.\" : \".\") + '</div></div>';\n    $(\"upcoming\").innerHTML = up;\n  }\n  // week strip\n  var wk = \"\", ws = add(t, -3);\n  for (var j = 0; j < 7; j++){\n    var k2 = add(ws, j), kd = m.start ? dayKind(k2, m) : (S.days[k2] && isBleed(S.days[k2].flow) ? \"period\" : \"\");\n    wk += '<button type=\"button\" data-day=\"' + k2 + '\" class=\"' + (k2 === t ? \"today\" : \"\") + '\"><span class=\"dn\">' + WD[pd(k2).getDay()].slice(0,1) + '</span><span class=\"dd ' + markClass(kd) + '\">' + pd(k2).getDate() + (hasLog(k2) ? '<i class=\"logdot\"></i>' : '') + '</span></button>';\n  }\n  $(\"week\").innerHTML = wk;\n  // what's logged today\n  var e = S.days[t], bits = [];\n  if (e) {\n    if (e.flow && e.flow !== \"none\") bits.push(label(FLOW, e.flow) + (e.flow === \"spot\" ? \"\" : \" flow\"));\n    (e.sym || []).forEach(function(s){ bits.push(s); });\n    (e.mood || []).forEach(function(s){ bits.push(s); });\n    if (e.cm) bits.push(label(CM, e.cm) + \" discharge\");\n    if (e.lh) bits.push(\"LH \" + label(LH, e.lh).toLowerCase());\n    if (typeof e.temp === \"number\") bits.push(e.temp.toFixed(2) + \"°\" + S.settings.unit);\n    if (e.sex) bits.push(label(SEX, e.sex));\n  }\n  $(\"todayLog\").innerHTML = '<h2>Today</h2>' + (bits.length || (e && e.note) ? (bits.length ? '<div class=\"tags\">' + bits.map(function(b){ return '<span class=\"tag\">' + esc(b) + '</span>'; }).join(\"\") + '</div>' : '') + (e.note ? '<p class=\"note\">' + esc(e.note) + '</p>' : '')\n    : '<div class=\"sub\">Nothing logged yet. How are you feeling?</div>');\n  $(\"phaseTip\").textContent = tipFor(m);\n}\nfunction ovWord(m){ return m.ovHow === \"temperature\" ? \"confirmed by your temperature\" : m.ovHow === \"lh\" ? \"from your positive LH test\" : \"estimated\"; }\nfunction label(list, v){ for (var i = 0; i < list.length; i++) if (list[i][0] === v) return list[i][1]; return v; }\nfunction markClass(kind){ return kind ? \"m-\" + kind : \"\"; }\nfunction hasLog(k){ var e = S.days[k]; if (!e) return false; return !!((e.sym && e.sym.length) || (e.mood && e.mood.length) || e.cm || e.lh || typeof e.temp === \"number\" || e.sex || e.note); }\nfunction arc(cx, cy, r, a0, a1, col){\n  function pt(a){ var t = (a - 90) * Math.PI / 180; return (cx + r * Math.cos(t)).toFixed(2) + \" \" + (cy + r * Math.sin(t)).toFixed(2); }\n  return '<path d=\"M ' + pt(a0) + ' A ' + r + ' ' + r + ' 0 ' + (a1 - a0 > 180 ? 1 : 0) + ' 1 ' + pt(a1) + '\" fill=\"none\" stroke=\"' + col + '\" stroke-width=\"18\" stroke-linecap=\"butt\"/>';\n}\nfunction tipFor(m){\n  if (!m.start) return \"Bloom works best when you log each period's first day. Symptoms and moods are optional, but over a few months they show your own patterns.\";\n  var ph = m.late ? \"late\" : phaseOf(m.today, m);\n  return {\n    period: \"During your period, warmth, gentle movement and staying hydrated help many people with cramps. Log your flow each day — it makes predictions sharper.\",\n    follicular: \"After your period, oestrogen rises. Many people feel more energy and a lift in mood in these days.\",\n    ovulation: \"Around ovulation, discharge often turns clear and stretchy, like egg white — a natural sign of your most fertile days.\",\n    luteal: \"In the luteal phase progesterone rises. Some notice bloating, tender breasts or lower mood in the last days before a period — logging them shows your pattern.\",\n    late: \"A late period isn't unusual now and then. If periods often come more than a week late or stop for three months, it's worth talking to a doctor or nurse.\"\n  }[ph] || \"\";\n}\n\n/* ---------- render: Calendar ---------- */\nvar calMonth = null;\nfunction renderCal(m){\n  if (!calMonth) { var d = new Date(); calMonth = new Date(d.getFullYear(), d.getMonth(), 1); }\n  $(\"mTitle\").textContent = MON[calMonth.getMonth()] + \" \" + calMonth.getFullYear();\n  var first = new Date(calMonth), lead = (first.getDay() + 6) % 7;\n  var start = new Date(first); start.setDate(1 - lead);\n  var html = \"\", t = m.today;\n  for (var i = 0; i < 42; i++){\n    var d = new Date(start); d.setDate(start.getDate() + i);\n    if (i >= 35 && d.getMonth() !== calMonth.getMonth()) break;\n    var k = dk(d), kind = dayKind(k, m), out = d.getMonth() !== calMonth.getMonth();\n    html += '<button type=\"button\" class=\"day ' + markClass(kind) + (out ? \" out\" : \"\") + (k === t ? \" today\" : \"\") + '\" data-day=\"' + k + '\" aria-label=\"' + longDay(k) + (kind ? \", \" + ({period:\"period\",pred:\"predicted period\",fert:\"fertile\",ov:\"ovulation\",spot:\"spotting\"})[kind] : \"\") + '\">' + d.getDate() + (hasLog(k) ? '<i class=\"logdot\"></i>' : '') + '</button>';\n  }\n  $(\"grid\").innerHTML = html;\n}\n\n/* ---------- render: Insights ---------- */\nfunction renderIns(m){\n  var cyc = m.cycles, n = cyc.length;\n  var lens = cyc.map(function(c){ return c.len; });\n  $(\"stats\").innerHTML =\n    stat(m.avgCycle, \"days\", n >= 2 ? \"Average cycle\" : \"Usual cycle (from settings)\") +\n    stat(m.avgPeriod, \"days\", \"Average period\") +\n    stat(n ? Math.min.apply(null, lens) + \"–\" + Math.max.apply(null, lens) : \"–\", n ? \"days\" : \"\", \"Shortest – longest\") +\n    stat(n, n === 1 ? \"cycle\" : \"cycles\", \"Logged so far\");\n  var notes = [];\n  if (n < 2) notes.push(\"Log two or more periods and Bloom switches from your usual lengths to your real averages.\");\n  if (m.spread > 7) notes.push(\"Your cycle length varies by \" + m.spread + \" days, so predictions are less certain — that's common.\");\n  var warn = n >= 3 && (m.avgCycle < 21 || m.avgCycle > 35 || m.spread > 20);\n  if (warn) notes.push(\"Cycles regularly shorter than 21 days, longer than 35, or very irregular are worth mentioning to a doctor or nurse.\");\n  if (m.start && diff(m.start, m.today) > 90) notes.push(\"It's been over three months since your last logged period. If that's right, a doctor or nurse can help find out why.\");\n  $(\"statNote\").innerHTML = notes.map(esc).join(\"<br>\"); $(\"statNote\").className = \"note\" + (warn ? \" warn\" : \"\");\n  var last8 = cyc.slice(-8).reverse(), maxL = Math.max.apply(null, [m.avgCycle].concat(lens));\n  $(\"bars\").innerHTML = last8.length ? last8.map(function(c){\n    return '<div class=\"bar\"><span class=\"lbl\">' + nice(c.start) + '</span><span class=\"track\" style=\"width:' + (c.len / maxL * 100).toFixed(1) + '%\"><span class=\"per\" style=\"width:' + (Math.min(c.per, c.len) / c.len * 100).toFixed(1) + '%\"></span></span><span class=\"len\">' + c.len + '</span></div>';\n  }).join(\"\") : '<div class=\"sub\">Your cycles appear here once you have logged two periods.</div>';\n  $(\"barNote\").textContent = last8.length ? \"Pink is your period, lilac the rest of the cycle, newest first.\" : \"\";\n  // temperature this cycle\n  var tc = $(\"tempCard\");\n  var tks = m.start ? Object.keys(S.days).filter(function(k){ return k >= m.start && typeof S.days[k].temp === \"number\"; }).sort() : [];\n  if (tks.length < 3) { tc.classList.add(\"hidden\"); }\n  else {\n    tc.classList.remove(\"hidden\");\n    var vals = tks.map(function(k){ return S.days[k].temp; }), lo = Math.min.apply(null, vals) - 0.1, hi = Math.max.apply(null, vals) + 0.1;\n    var span = Math.max(m.day, m.avgCycle), W = 320, H = 150, P = 14;\n    function x(k){ return P + diff(m.start, k) / Math.max(1, span - 1) * (W - 2 * P); }\n    function y(v){ return H - P - (v - lo) / (hi - lo) * (H - 2 * P); }\n    var g = \"\";\n    if (m.fertStart) g += '<rect x=\"' + x(m.fertStart).toFixed(1) + '\" y=\"0\" width=\"' + Math.max(4, x(m.fertEnd) - x(m.fertStart)).toFixed(1) + '\" height=\"' + H + '\" fill=\"var(--lav-3)\"/>';\n    var shift = tempShift(m.start, m.today);\n    if (shift) {\n      var i0 = tks.indexOf(shift), cover = Math.max.apply(null, vals.slice(Math.max(0, i0 - 6), i0));\n      g += '<line x1=\"0\" x2=\"' + W + '\" y1=\"' + y(cover).toFixed(1) + '\" y2=\"' + y(cover).toFixed(1) + '\" stroke=\"var(--lav)\" stroke-dasharray=\"4 4\" stroke-width=\"1.5\"/>';\n    }\n    g += '<polyline fill=\"none\" stroke=\"var(--rose)\" stroke-width=\"2.5\" stroke-linejoin=\"round\" points=\"' + tks.map(function(k){ return x(k).toFixed(1) + \",\" + y(S.days[k].temp).toFixed(1); }).join(\" \") + '\"/>';\n    g += tks.map(function(k){ return '<circle cx=\"' + x(k).toFixed(1) + '\" cy=\"' + y(S.days[k].temp).toFixed(1) + '\" r=\"3.5\" fill=\"var(--surface)\" stroke=\"var(--rose)\" stroke-width=\"2\"/>'; }).join(\"\");\n    $(\"tchart\").innerHTML = g;\n    $(\"tempNote\").textContent = shift ? \"Your temperature rose and stayed up from \" + nice(shift) + \" — a sign ovulation happened around \" + nice(add(shift, -1)) + \". The dashed line is the level it rose above.\" : \"Take it at the same time each morning, before getting up. After ovulation it usually rises by 0.2–0.5 °C and stays up until your period.\";\n  }\n  // symptoms & moods over 90 days, with the phase they mostly fall in\n  var since = add(m.today, -90), counts = {};\n  Object.keys(S.days).forEach(function(k){\n    if (k < since || k > m.today) return;\n    var e = S.days[k], ph = m.start ? phaseOf(k, m) : null;\n    (e.sym || []).concat(e.mood || []).forEach(function(s){\n      var c = counts[s] || (counts[s] = { n:0, ph:{} }); c.n++; if (ph) c.ph[ph] = (c.ph[ph] || 0) + 1;\n    });\n  });\n  var top = Object.keys(counts).sort(function(a, b){ return counts[b].n - counts[a].n; }).slice(0, 8);\n  $(\"freq\").innerHTML = top.length ? top.map(function(s){\n    var c = counts[s], best = Object.keys(c.ph).sort(function(a, b){ return c.ph[b] - c.ph[a]; })[0];\n    var where = best && c.n >= 3 && c.ph[best] / c.n >= 0.6 ? \"mostly in your \" + (best === \"period\" ? \"period\" : PHASE[best].toLowerCase()) : \"\";\n    return '<div class=\"fr\"><span class=\"nm\">' + esc(s) + (where ? ' <span class=\"ph\">· ' + where + '</span>' : '') + '</span><span class=\"ct\">' + c.n + '</span></div>';\n  }).join(\"\") : '<div class=\"sub\">Log symptoms and moods to see your patterns here.</div>';\n}\nfunction stat(v, unit, t){ return '<div class=\"stat\"><div class=\"v\">' + v + (unit ? ' <small>' + unit + '</small>' : '') + '</div><div class=\"t\">' + t + '</div></div>'; }\n\n/* ---------- the day sheet ---------- */\nvar editing = null;\nfunction openDay(k){\n  if (k > todayK()) { openFuture(k); return; }\n  editing = k;\n  var m = model(), ph = m.start ? phaseOf(k, m) : null;\n  $(\"dTitle\").textContent = k === todayK() ? \"Today\" : longDay(k);\n  $(\"dSub\").textContent = (k === todayK() ? longDay(k) : \"\") + (m.start && k >= m.start ? (k === todayK() ? \" · \" : \"\") + \"Cycle day \" + (diff(m.start, k) + 1) + (ph ? \" · \" + PHASE[ph] : \"\") : \"\");\n  fillDay(); open(\"daySheet\");\n}\nfunction openFuture(k){\n  var m = model(), kind = m.start ? dayKind(k, m) : \"\";\n  var what = { pred:\"Your period is expected around now.\", fert:\"Predicted fertile day.\", ov:\"Predicted ovulation day.\", period:\"\" }[kind] || \"No prediction for this day.\";\n  $(\"dTitle\").textContent = longDay(k); $(\"dSub\").textContent = what + \" You can log it when the day comes.\";\n  editing = null;\n  [\"fFlow\",\"fSym\",\"fMood\",\"fCm\",\"fLh\",\"fSex\"].forEach(function(id){ $(id).innerHTML = \"\"; });\n  document.querySelectorAll(\"#daySheet .sec\").forEach(function(s){ s.classList.add(\"hidden\"); });\n  open(\"daySheet\");\n}\nfunction entry(){ return S.days[editing] || (S.days[editing] = {}); }\nfunction fillDay(){\n  document.querySelectorAll(\"#daySheet .sec\").forEach(function(s){ s.classList.remove(\"hidden\"); });\n  var e = S.days[editing] || {};\n  $(\"fFlow\").innerHTML = FLOW.map(function(f){\n    var drops = \"\"; for (var i = 0; i < f[2]; i++) drops += '<svg><use href=\"#i-drop\"/></svg>';\n    if (f[0] === \"spot\") drops = '<svg style=\"width:7px;height:9px\"><use href=\"#i-drop\"/></svg>';\n    return '<button type=\"button\" class=\"chip' + ((e.flow || \"none\") === f[0] ? \" on\" : \"\") + '\" data-flow=\"' + f[0] + '\"><span class=\"drops\" style=\"color:var(--rose)\">' + drops + '</span>' + f[1] + '</button>';\n  }).join(\"\");\n  $(\"fSym\").innerHTML = SYM.map(function(s){ return chip(s, (e.sym || []).indexOf(s) >= 0, \"sym\"); }).join(\"\");\n  $(\"fMood\").innerHTML = MOOD.map(function(s){ return chip(s, (e.mood || []).indexOf(s) >= 0, \"mood\"); }).join(\"\");\n  $(\"fCm\").innerHTML = CM.map(function(c){ return chip(c[1], e.cm === c[0], \"cm\", c[0]); }).join(\"\");\n  $(\"fLh\").innerHTML = LH.map(function(c){ return chip(c[1], e.lh === c[0], \"lh\", c[0]); }).join(\"\");\n  $(\"fSex\").innerHTML = SEX.map(function(c){ return chip(c[1], e.sex === c[0], \"sex\", c[0]); }).join(\"\");\n  $(\"fTemp\").value = typeof e.temp === \"number\" ? e.temp : \"\";\n  $(\"fTemp\").placeholder = S.settings.unit === \"F\" ? \"97.70\" : \"36.45\";\n  $(\"fUnit\").textContent = \"°\" + S.settings.unit; $(\"tempErr\").classList.add(\"hidden\");\n  $(\"fNote\").value = e.note || \"\";\n}\nfunction chip(text, on, kind, val){ return '<button type=\"button\" class=\"chip' + (on ? \" on\" : \"\") + '\" data-' + kind + '=\"' + esc(val || text) + '\">' + esc(text) + '</button>'; }\nfunction tidy(k){\n  var e = S.days[k]; if (!e) return;\n  if (e.flow === \"none\") delete e.flow;\n  [\"sym\",\"mood\"].forEach(function(f){ if (e[f] && !e[f].length) delete e[f]; });\n  [\"cm\",\"lh\",\"sex\",\"note\"].forEach(function(f){ if (!e[f]) delete e[f]; });\n  if (typeof e.temp !== \"number\") delete e.temp;\n  if (!Object.keys(e).length) delete S.days[k];\n}\n$(\"daySheet\").addEventListener(\"click\", function(ev){\n  var b = ev.target.closest(\"button\"); if (!b || !editing) return;\n  var e = entry(), d = b.dataset;\n  if (d.flow) e.flow = d.flow;\n  else if (d.sym || d.mood) { var f = d.sym ? \"sym\" : \"mood\", v = d.sym || d.mood, a = e[f] || (e[f] = []), i = a.indexOf(v); if (i >= 0) a.splice(i, 1); else a.push(v); }\n  else if (d.cm || d.lh || d.sex) { var key = d.cm ? \"cm\" : d.lh ? \"lh\" : \"sex\", val = d.cm || d.lh || d.sex; e[key] = e[key] === val ? \"\" : val; }\n  else return;\n  haptic(\"selection\"); tidy(editing); fillDay(); changed();\n});\n$(\"fTemp\").addEventListener(\"change\", function(){\n  if (!editing) return;\n  var raw = $(\"fTemp\").value.replace(\",\", \".\"), v = parseFloat(raw), e = entry(), F = S.settings.unit === \"F\";\n  var ok = raw === \"\" || (isFinite(v) && (F ? v >= 95 && v <= 101.5 : v >= 35 && v <= 38.6));\n  $(\"tempErr\").classList.toggle(\"hidden\", ok);\n  if (!ok) { $(\"tempErr\").textContent = F ? \"That looks off — waking temperatures are usually 96–99.5 °F.\" : \"That looks off — waking temperatures are usually 35.5–37.5 °C.\"; return; }\n  if (raw === \"\") delete e.temp; else e.temp = Math.round(v * 100) / 100;\n  tidy(editing); changed();\n});\n$(\"fNote\").addEventListener(\"input\", function(){ if (!editing) return; entry().note = $(\"fNote\").value.slice(0, 500); tidy(editing); changed(); });\n$(\"dClear\").addEventListener(\"click\", function(){ if (!editing) return; delete S.days[editing]; haptic(\"light\"); fillDay(); changed(); });\n$(\"dDone\").addEventListener(\"click\", closeSheets);\n\n/* ---------- sheets ---------- */\nfunction open(id){ $(\"scrim\").classList.add(\"on\"); $(id).classList.add(\"on\"); $(id).scrollTop = 0; }\nfunction closeSheets(){ $(\"scrim\").classList.remove(\"on\"); document.querySelectorAll(\".sheet.on\").forEach(function(s){ s.classList.remove(\"on\"); }); editing = null; render(); }\n$(\"scrim\").addEventListener(\"click\", closeSheets);\n/* Pin the page behind whenever a sheet or the welcome/lock screen is up. */\nfunction syncModal(){\n  var up = !!document.querySelector(\".sheet.on\") || !$(\"welcome\").hidden || !$(\"lock\").hidden;\n  document.documentElement.classList.toggle(\"modal\", up);\n}\nnew MutationObserver(syncModal).observe(document.body, { subtree:true, attributes:true, attributeFilter:[\"class\",\"hidden\"] });\n\n/* ---------- Today buttons ---------- */\n$(\"logBtn\").addEventListener(\"click\", function(){ openDay(todayK()); });\n$(\"periodBtn\").addEventListener(\"click\", function(){\n  var t = todayK(), e = S.days[t] || (S.days[t] = {}), m = model();\n  if ($(\"periodTxt\").textContent === \"Period ended\") {\n    // today is the last day: bleeding logged today stays; nothing after it is assumed\n    haptic(\"success\"); toast(\"Noted. Your period lasted \" + (diff(m.start, t) + 1) + \" days.\"); return;\n  }\n  if (!isBleed(e.flow)) e.flow = \"medium\";\n  haptic(\"success\"); changed(); openDay(t);\n});\ndocument.addEventListener(\"click\", function(ev){\n  var b = ev.target.closest(\"[data-day]\"); if (b && !ev.target.closest(\".sheet\")) openDay(b.dataset.day);\n  var tab = ev.target.closest(\"[data-tab]\");\n  if (tab) {\n    document.querySelectorAll(\"[data-tab]\").forEach(function(x){ x.classList.toggle(\"on\", x === tab); });\n    document.querySelectorAll(\".view\").forEach(function(v){ v.classList.toggle(\"on\", v.id === \"v-\" + tab.dataset.tab); });\n    haptic(\"selection\"); window.scrollTo(0, 0);\n  }\n});\n$(\"prevM\").addEventListener(\"click\", function(){ calMonth.setMonth(calMonth.getMonth() - 1); renderCal(model()); });\n$(\"nextM\").addEventListener(\"click\", function(){ calMonth.setMonth(calMonth.getMonth() + 1); renderCal(model()); });\nfunction toast(msg){ $(\"status\").innerHTML = esc(msg); }\n\n/* ---------- settings ---------- */\n$(\"gear\").addEventListener(\"click\", function(){ fillSettings(); open(\"setSheet\"); });\n$(\"sDone\").addEventListener(\"click\", closeSheets);\nvar LIM = { cycle:[18, 60], period:[1, 12], luteal:[9, 17] };\nfunction fillSettings(){\n  var s = S.settings, m = model();\n  $(\"sCycle\").textContent = s.cycle + \" days\"; $(\"sPeriod\").textContent = s.period + \" days\"; $(\"sLuteal\").textContent = s.luteal + \" days\";\n  $(\"cycNote\").textContent = m.cycles.length >= 2 ? \"Bloom now uses your average of \" + m.avgCycle + \" days from your logged cycles.\" : \"Used until you've logged two periods.\";\n  $(\"perNote\").textContent = m.periods.some(function(p){ return p.logged; }) ? \"Bloom now uses your logged periods.\" : \"Used until you've logged a period.\";\n  $(\"goalNote\").textContent = s.goal === \"ttc\" ? \"Today's screen points out your best days to try.\" : \"Periods, symptoms and moods, with fertile days shown too.\";\n  seg(\"sGoal\", s.goal); seg(\"sUnit\", s.unit);\n  $(\"pcBtn\").textContent = cryptoKey ? \"Change\" : \"Set passcode\";\n  $(\"pcOffRow\").classList.toggle(\"hidden\", !cryptoKey);\n  $(\"pcNote\").textContent = !hasCrypto ? \"Not available on this version of MyLLM.\" : cryptoKey ? \"On. Your log is encrypted on this phone and Bloom locks whenever you leave it.\" : \"Locks Bloom and encrypts your log on this phone. If you forget it, the only way back in is to erase everything.\";\n  $(\"pcBtn\").disabled = !hasCrypto;\n}\nfunction seg(id, v){ document.querySelectorAll(\"#\" + id + \" button\").forEach(function(b){ b.classList.toggle(\"on\", b.dataset.v === v); }); }\n$(\"setSheet\").addEventListener(\"click\", function(ev){\n  var b = ev.target.closest(\"button\"); if (!b) return;\n  var s = S.settings;\n  if (b.dataset.k) { var k = b.dataset.k, lim = LIM[k]; s[k] = Math.min(lim[1], Math.max(lim[0], s[k] + +b.dataset.d)); }\n  else if (b.closest(\"#sGoal\")) s.goal = b.dataset.v;\n  else if (b.closest(\"#sUnit\")) {\n    if (s.unit !== b.dataset.v) {   // convert what's logged so the chart stays right\n      var toF = b.dataset.v === \"F\";\n      Object.keys(S.days).forEach(function(d){ var e = S.days[d]; if (typeof e.temp === \"number\") e.temp = Math.round((toF ? e.temp * 9 / 5 + 32 : (e.temp - 32) * 5 / 9) * 100) / 100; });\n      s.unit = b.dataset.v;\n    }\n  }\n  else return;\n  haptic(\"selection\"); fillSettings(); changed();\n});\n$(\"exportBtn\").addEventListener(\"click\", function(){\n  var rows = [[\"date\",\"period\",\"symptoms\",\"mood\",\"discharge\",\"lh_test\",\"temperature_\" + S.settings.unit,\"sex\",\"note\"]];\n  Object.keys(S.days).sort().forEach(function(k){\n    var e = S.days[k];\n    rows.push([k, e.flow ? label(FLOW, e.flow) : \"\", (e.sym || []).join(\"; \"), (e.mood || []).join(\"; \"), e.cm ? label(CM, e.cm) : \"\", e.lh ? label(LH, e.lh) : \"\", typeof e.temp === \"number\" ? e.temp : \"\", e.sex ? label(SEX, e.sex) : \"\", e.note || \"\"]);\n  });\n  var csv = rows.map(function(r){ return r.map(function(c){ c = String(c); return /[\",\\n]/.test(c) ? '\"' + c.replace(/\"/g, '\"\"') + '\"' : c; }).join(\",\"); }).join(\"\\n\");\n  var b64 = btoa(unescape(encodeURIComponent(csv)));\n  if (window.myllmShareFile) window.myllmShareFile(\"data:text/csv;base64,\" + b64, { filename:\"Bloom cycle log.csv\", mime:\"text/csv\" }).catch(function(){});\n});\nvar eraseArmed = 0;\n$(\"eraseBtn\").addEventListener(\"click\", function(){\n  if (Date.now() - eraseArmed > 4000) { eraseArmed = Date.now(); $(\"eraseBtn\").textContent = \"Tap again to erase\"; haptic(\"warning\"); setTimeout(function(){ $(\"eraseBtn\").textContent = \"Erase\"; }, 4000); return; }\n  eraseAll();\n});\nfunction eraseAll(){\n  cryptoKey = null; salt = null; S = fresh();\n  Promise.all([store.removeItem(KEY), store.removeItem(EKEY)]).then(function(){\n    haptic(\"success\"); closeSheets(); $(\"lock\").hidden = true; showWelcome();\n  });\n}\n\n/* ---------- saving (encrypted when a passcode is on) ---------- */\nvar saveTimer = null;\nfunction changed(){ render(); clearTimeout(saveTimer); saveTimer = setTimeout(save, 250); }\nfunction save(){\n  if (!S) return Promise.resolve();\n  var json = JSON.stringify(S);\n  if (!cryptoKey) return store.setItem(KEY, json);\n  var iv = crypto.getRandomValues(new Uint8Array(12));\n  return crypto.subtle.encrypt({ name:\"AES-GCM\", iv:iv }, cryptoKey, new TextEncoder().encode(json)).then(function(ct){\n    return store.setItem(EKEY, JSON.stringify({ v:1, salt:b64(salt), iv:b64(iv), ct:b64(new Uint8Array(ct)) }));\n  }).then(function(){ return store.removeItem(KEY); });\n}\nfunction b64(u8){ var s = \"\"; for (var i = 0; i < u8.length; i++) s += String.fromCharCode(u8[i]); return btoa(s); }\nfunction unb64(s){ var b = atob(s), u = new Uint8Array(b.length); for (var i = 0; i < b.length; i++) u[i] = b.charCodeAt(i); return u; }\nfunction derive(pin, saltBytes){\n  return crypto.subtle.importKey(\"raw\", new TextEncoder().encode(pin), \"PBKDF2\", false, [\"deriveKey\"]).then(function(base){\n    return crypto.subtle.deriveKey({ name:\"PBKDF2\", salt:saltBytes, iterations:210000, hash:\"SHA-256\" }, base, { name:\"AES-GCM\", length:256 }, false, [\"encrypt\",\"decrypt\"]);\n  });\n}\n\n/* ---------- passcode screen ---------- */\nvar pinMode = \"unlock\", pinBuf = \"\", pinFirst = \"\", fails = 0, waitUntil = 0;\nfunction drawPad(){\n  var keys = [\"1\",\"2\",\"3\",\"4\",\"5\",\"6\",\"7\",\"8\",\"9\",\"\",\"0\",\"⌫\"];\n  $(\"pad\").innerHTML = keys.map(function(k){ return k === \"\" ? '<button type=\"button\" class=\"blank\" tabindex=\"-1\"></button>' : '<button type=\"button\" ' + (k === \"⌫\" ? 'class=\"sm\" aria-label=\"Delete\"' : '') + ' data-pin=\"' + k + '\">' + k + '</button>'; }).join(\"\");\n  dots();\n}\nfunction dots(){ var h = \"\"; for (var i = 0; i < 6; i++) h += '<i class=\"' + (i < pinBuf.length ? \"f\" : \"\") + '\"></i>'; $(\"pinDots\").innerHTML = h; }\nfunction showLock(mode){\n  pinMode = mode; pinBuf = \"\"; pinFirst = \"\";\n  $(\"lockTitle\").textContent = mode === \"unlock\" ? \"Bloom is locked\" : \"Choose a passcode\";\n  $(\"lockSub\").textContent = mode === \"unlock\" ? \"Enter your passcode\" : \"Six digits. Bloom will ask for it each time you open it.\";\n  $(\"lockMsg\").textContent = \"\"; $(\"forgot\").classList.toggle(\"hidden\", mode !== \"unlock\");\n  $(\"lockCancel\").classList.toggle(\"hidden\", mode === \"unlock\");\n  $(\"lock\").hidden = false; drawPad();\n}\n$(\"pad\").addEventListener(\"click\", function(ev){\n  var b = ev.target.closest(\"[data-pin]\"); if (!b) return;\n  if (Date.now() < waitUntil) { $(\"lockMsg\").textContent = \"Try again in \" + Math.ceil((waitUntil - Date.now()) / 1000) + \" s\"; return; }\n  haptic(\"light\");\n  if (b.dataset.pin === \"⌫\") pinBuf = pinBuf.slice(0, -1); else if (pinBuf.length < 6) pinBuf += b.dataset.pin;\n  dots();\n  if (pinBuf.length === 6) setTimeout(pinDone, 120);\n});\nfunction pinDone(){\n  var pin = pinBuf; pinBuf = \"\";\n  if (pinMode === \"unlock\") {\n    $(\"lockMsg\").textContent = \"Unlocking…\";\n    unlock(pin).then(function(ok){\n      if (ok) { fails = 0; $(\"lock\").hidden = true; haptic(\"success\"); render(); return; }\n      fails++; if (fails >= 5) waitUntil = Date.now() + 30000;\n      bad(fails >= 5 ? \"Wrong passcode. Wait 30 seconds.\" : \"Wrong passcode\");\n    });\n  } else if (!pinFirst) { pinFirst = pin; $(\"lockSub\").textContent = \"Enter it once more to confirm\"; dots(); }\n  else if (pin !== pinFirst) { pinFirst = \"\"; $(\"lockSub\").textContent = \"Six digits. Bloom will ask for it each time you open it.\"; bad(\"They didn't match — try again\"); }\n  else {\n    $(\"lockMsg\").textContent = \"Encrypting…\";\n    salt = crypto.getRandomValues(new Uint8Array(16));\n    derive(pin, salt).then(function(k){ cryptoKey = k; return save(); }).then(function(){\n      $(\"lock\").hidden = true; haptic(\"success\"); fillSettings();\n    });\n  }\n}\nfunction bad(msg){ haptic(\"error\"); $(\"lockMsg\").textContent = msg; var p = $(\"pinDots\"); p.classList.remove(\"shake\"); void p.offsetWidth; p.classList.add(\"shake\"); dots(); }\nfunction unlock(pin){\n  return store.getItem(EKEY).then(function(raw){\n    var blob = JSON.parse(raw), sb = unb64(blob.salt);\n    return derive(pin, sb).then(function(k){\n      return crypto.subtle.decrypt({ name:\"AES-GCM\", iv:unb64(blob.iv) }, k, unb64(blob.ct)).then(function(pt){\n        S = JSON.parse(new TextDecoder().decode(pt)); cryptoKey = k; salt = sb; return true;\n      });\n    });\n  }).catch(function(){ return false; });\n}\n$(\"pcBtn\").addEventListener(\"click\", function(){ if (hasCrypto) { closeSheets(); showLock(\"set\"); } });\n$(\"pcOff\").addEventListener(\"click\", function(){ cryptoKey = null; salt = null; store.setItem(KEY, JSON.stringify(S)).then(function(){ return store.removeItem(EKEY); }).then(function(){ haptic(\"success\"); fillSettings(); }); });\n$(\"lockCancel\").addEventListener(\"click\", function(){ $(\"lock\").hidden = true; });\nvar forgotArmed = 0;\n$(\"forgot\").addEventListener(\"click\", function(){\n  if (Date.now() - forgotArmed > 5000) { forgotArmed = Date.now(); $(\"lockMsg\").textContent = \"Your log is encrypted with the passcode, so it can't be recovered. Tap again to erase everything and start over.\"; return; }\n  eraseAll();\n});\n/* Leaving Bloom locks it: the decrypted log is dropped from memory and wiped\n   off the page, so nothing shows behind the lock or in the app switcher. */\nfunction wipe(){\n  [\"week\",\"upcoming\",\"todayLog\",\"grid\",\"stats\",\"bars\",\"freq\",\"tchart\",\"status\",\"statNote\",\"barNote\",\"tempNote\",\"ring\"].forEach(function(id){ $(id).innerHTML = \"\"; });\n  $(\"rn\").textContent = \"\"; $(\"rp\").textContent = \"\"; $(\"rq\").textContent = \"\"; $(\"phaseTip\").textContent = \"\";\n  document.querySelectorAll(\".sheet.on\").forEach(function(x){ x.classList.remove(\"on\"); }); $(\"scrim\").classList.remove(\"on\"); editing = null;\n}\ndocument.addEventListener(\"visibilitychange\", function(){\n  if (document.hidden && cryptoKey) { clearTimeout(saveTimer); save(); S = null; cryptoKey = null; wipe(); showLock(\"unlock\"); }\n  else if (!document.hidden && S) render();\n});\n\n/* ---------- first run ---------- */\nvar W = { cycle:28, period:5, goal:\"track\" };\nfunction showWelcome(){\n  $(\"welcome\").hidden = false;\n  var mx = todayK(); $(\"wStart\").max = mx; $(\"wStart\").min = add(mx, -90); $(\"wStart\").value = \"\";\n}\n$(\"welcome\").addEventListener(\"click\", function(ev){\n  var b = ev.target.closest(\"button\"); if (!b) return;\n  if (b.dataset.w) { var k = b.dataset.w, lim = LIM[k]; W[k] = Math.min(lim[1], Math.max(lim[0], W[k] + +b.dataset.d)); $(\"w\" + k[0].toUpperCase() + k.slice(1)).textContent = W[k] + \" days\"; haptic(\"selection\"); }\n  else if (b.closest(\"#wGoal\")) { W.goal = b.dataset.v; seg(\"wGoal\", W.goal); haptic(\"selection\"); }\n});\n$(\"wGo\").addEventListener(\"click\", function(){\n  var s = S.settings, v = $(\"wStart\").value;\n  s.cycle = W.cycle; s.period = W.period; s.goal = W.goal; s.setup = true;\n  if (v && v <= todayK()) s.seed = v;\n  $(\"welcome\").hidden = true; haptic(\"success\"); changed();\n});\n\n/* ---------- start ---------- */\nstore.getItem(EKEY).then(function(enc){\n  if (enc) { wipe(); showLock(\"unlock\"); return; }\n  return store.getItem(KEY).then(function(raw){\n    try { S = raw ? JSON.parse(raw) : fresh(); } catch(e){ S = fresh(); }\n    if (!S.settings || !S.days) S = fresh();\n    render();\n    if (!S.settings.setup) showWelcome();\n  });\n});\n</script>\n<script>\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes.\n   The spacer keeps the header clear of the status bar / Dynamic Island. It is\n   live CSS — env(safe-area-inset-top) — not a measured number: the inset is\n   still 0 when the page loads and only grows once MyLLM's bar has gone (v1\n   measured once, so the title sat under the island). If the page's own styles\n   already pad the header down by the inset, the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  /* Does any rule that applies to the header or an ancestor already use the top inset? */\n  function pageHandlesInset(head){\n    var chain = [], n, found = false;\n    for (n = head; n && n.nodeType === 1; n = n.parentElement) chain.push(n);\n    function walk(rules){\n      for (var i = 0; i < rules.length && !found; i++){\n        var r = rules[i];\n        if (r.cssRules && !r.selectorText) { walk(r.cssRules); continue; }\n        if (!r.selectorText || !/safe-area-inset-top/.test(r.cssText) || !/(padding|margin|top)\\s*:/.test(r.cssText)) continue;\n        if (/\\.imm-safe/.test(r.selectorText)) continue;\n        for (var k = 0; k < chain.length; k++){\n          try { if (chain[k].matches(r.selectorText)) { found = true; break; } } catch(e){}\n        }\n      }\n    }\n    for (var s = 0; s < document.styleSheets.length && !found; s++){\n      try { walk(document.styleSheets[s].cssRules); } catch(e){}\n    }\n    for (n = head; n && n.nodeType === 1 && !found; n = n.parentElement){\n      if (/safe-area-inset-top/.test(n.getAttribute(\"style\") || \"\")) found = true;\n    }\n    return found;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = (document.body.classList.contains(\"imm\") && !pageHandlesInset(head)) ? \"env(safe-area-inset-top)\" : \"0px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n  /* If MyLLM's bridges land after this runs, look again so the ✕ still appears. */\n  if (!full()) { window.addEventListener(\"load\", sync); setTimeout(sync, 400); setTimeout(sync, 1500); }\n})();\n</script>\n</body></html>\n"}