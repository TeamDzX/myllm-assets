{"name": "Focus Timer", "html": "<!doctype html>\n<!--\n  Focus Timer — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover\">\n<title>Focus Timer</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"93ddf507fd\";color-scheme:light dark;\n    --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --text:var(--myllm-text,#111); --muted:var(--myllm-muted,#8a8a8e); --border:var(--myllm-border,#e3e3e8); }\n  @media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e); --text:var(--myllm-text,#eee); --muted:var(--myllm-muted,#98989f); --border:var(--myllm-border,#2c2c2e); } }\n  @property --h{ syntax:'<number>'; inherits:true; initial-value:228; }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; -webkit-user-select:none; user-select:none; }\n  body{ --h:228; transition:--h 1.2s ease; --acc:hsl(var(--h) 72% 54%);\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--text);\n    min-height:100dvh; text-align:center; padding:18px 16px calc(28px + env(safe-area-inset-bottom)); }\n  body.lock{ overflow:hidden; }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; }\n\n  /* ---------- setup ---------- */\n  .head{ display:flex; align-items:center; gap:12px; margin:2px auto 14px; max-width:600px; text-align:left; }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 28%)); }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  .tabs{ display:inline-flex; background:var(--surface); border:1px solid var(--border); border-radius:99px; padding:3px; margin-bottom:18px; }\n  .tab{ border:0; background:transparent; color:var(--muted); border-radius:99px; padding:8px 15px; font-size:13.5px; font-weight:650; }\n  .tab.on{ background:var(--acc); color:#fff; }\n  .tab{ white-space:nowrap; }\n  @media (max-width:360px){ .tab{ padding:8px 11px; font-size:13px; } }\n  .ringwrap{ position:relative; width:min(250px,66vw); aspect-ratio:1; margin:0 auto 10px; }\n  .ring{ width:100%; height:100%; transform:rotate(-90deg); display:block; overflow:visible; }\n  .ring circle{ fill:none; stroke-width:9; stroke-linecap:round; }\n  .ring .trk{ stroke:var(--border); }\n  .ring .arc{ stroke:var(--acc); stroke-dasharray:565.49; transition:stroke-dashoffset .25s linear; }\n  .center{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; }\n  .time{ font-size:54px; font-weight:200; font-variant-numeric:tabular-nums; letter-spacing:-.01em; line-height:1; }\n  .phase{ font-size:11px; font-weight:800; text-transform:uppercase; letter-spacing:.14em; color:var(--muted); margin-top:8px; }\n  .pom{ display:flex; align-items:center; justify-content:center; gap:6px; min-height:20px; margin:4px 0 16px; font-size:12px; font-weight:700; color:var(--muted); }\n  .pom i{ width:8px; height:8px; border-radius:50%; background:var(--acc); display:block; }\n  .ctrl{ display:flex; gap:10px; justify-content:center; }\n  .ctrl button{ border:0; border-radius:99px; height:50px; padding:0 30px; font-size:16px; font-weight:750; background:var(--acc); color:#fff;\n    display:inline-flex; align-items:center; gap:8px; box-shadow:0 8px 22px hsl(var(--h) 72% 54% / .3); }\n  .ctrl .sec{ background:var(--surface); color:var(--text); border:1px solid var(--border); padding:0 22px; box-shadow:none; }\n  .ctrl button:active{ transform:scale(.96); }\n  .set{ margin-top:24px; background:var(--surface); border:1px solid var(--border); border-radius:18px; padding:13px 16px; display:inline-flex; gap:16px; }\n  .set label{ font-size:10.5px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); display:block; margin-bottom:6px; }\n  .set input{ width:58px; padding:8px 4px; border:1px solid var(--border); border-radius:10px; font:inherit; font-size:16px; text-align:center;\n    background:var(--bg); color:var(--text); -webkit-user-select:text; user-select:text; }\n  .set input::-webkit-inner-spin-button, .set input::-webkit-outer-spin-button{ -webkit-appearance:none; margin:0; }\n  .set small{ display:block; font-size:10.5px; color:var(--muted); margin-top:4px; }\n\n  /* ---------- the stage: a session in progress takes the whole display ---------- */\n  .stage{ display:none; position:fixed; inset:0; z-index:40; color:#fff; overflow:hidden; }\n  .stage.on{ display:block; }\n  .bg{ position:absolute; inset:0; }\n  .bg.d{ background:radial-gradient(120% 90% at 20% 10%, hsl(var(--h) 66% 36%), transparent 60%),\n      radial-gradient(120% 90% at 85% 95%, hsl(calc(var(--h) + 50) 60% 26%), transparent 62%), #0b0b10; }\n  .bg.l{ display:none; background:radial-gradient(120% 90% at 20% 0%, hsl(var(--h) 85% 86%), transparent 60%),\n      radial-gradient(120% 90% at 85% 100%, hsl(calc(var(--h) + 50) 80% 88%), transparent 62%), #f4f4f8; }\n  /* Where MyLLM can't hide its own title bar, a dark stage under a white bar\n     looks cut in half — so in light mode, without myllmImmersive, it stays light. */\n  .stage.lite{ color:#15151a; } .stage.lite .bg.l{ display:block; } .stage.lite .bg.d{ display:none; }\n  .col{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center;\n    padding:calc(12px + env(safe-area-inset-top)) calc(20px + env(safe-area-inset-right)) calc(26px + env(safe-area-inset-bottom)) calc(20px + env(safe-area-inset-left)); }\n  .top{ width:100%; max-width:560px; height:44px; display:flex; align-items:center; justify-content:space-between; flex-shrink:0; }\n  .lbl{ font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; opacity:.62; }\n  .glass{ border:1px solid rgba(255,255,255,.16); background:rgba(255,255,255,.12); color:inherit;\n    -webkit-backdrop-filter:blur(18px); backdrop-filter:blur(18px); }\n  .lite .glass{ border-color:rgba(0,0,0,.09); background:rgba(255,255,255,.62); }\n  .rnd{ width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:15px; }\n  .ghost{ visibility:hidden; }\n  .body{ flex:1; min-height:0; width:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:30px; }\n  .big{ --r:min(78vw,340px,46vh); position:relative; width:var(--r); height:var(--r); flex-shrink:0; }\n  .big .ring circle{ stroke-width:6; }\n  .big .ring .trk{ stroke:rgba(255,255,255,.13); }\n  .big .ring .arc{ stroke:hsl(var(--h) 95% 76%); filter:drop-shadow(0 0 10px hsl(var(--h) 95% 62% / .55)); }\n  .lite .big .ring .trk{ stroke:rgba(20,20,40,.09); }\n  .lite .big .ring .arc{ stroke:hsl(var(--h) 72% 48%); filter:none; }\n  .big .phase{ color:inherit; opacity:.66; margin:0 0 10px; }\n  .big .time{ font-size:calc(var(--r) * .255); }\n  .big .note{ font-size:12.5px; font-weight:650; opacity:.55; margin-top:10px; min-height:16px; }\n  .big .pom{ position:absolute; left:0; right:0; bottom:17%; margin:0; min-height:0; color:inherit; }\n  .big .pom i{ width:6px; height:6px; background:currentColor; opacity:.7; }\n  .ctl{ display:flex; align-items:center; justify-content:center; gap:26px; flex-shrink:0; }\n  .ctl button{ border-radius:50%; display:flex; align-items:center; justify-content:center; flex-direction:column; }\n  .ctl .side{ width:56px; height:56px; font-size:19px; }\n  .ctl .main{ width:84px; height:84px; border:none; background:#fff; color:#0b0b10; font-size:28px; box-shadow:0 10px 30px rgba(0,0,0,.35); }\n  .lite .ctl .main{ background:#15151a; color:#fff; box-shadow:0 10px 26px rgba(20,20,40,.25); }\n  .ctl button:active, .rnd:active{ transform:scale(.94); }\n  .cap{ display:flex; justify-content:center; gap:26px; margin-top:-22px; font-size:10.5px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; opacity:.5; flex-shrink:0; }\n  .cap span{ width:56px; } .cap span:nth-child(2){ width:84px; }\n  .side-col{ display:flex; flex-direction:column; gap:30px; align-items:center; }\n\n  /* Dock: true black, only the time and the phase, drifting against burn-in. */\n  .dk{ display:none; position:absolute; inset:0; z-index:5; background:#000; color:#fff; }\n  .stage.dock .dk{ display:block; }\n  .dk .drift{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px; transition:transform 2.5s ease-in-out; }\n  .dk .dtime{ font-size:min(30vw,52vh,220px); font-weight:200; line-height:1; color:#c9c9cf; font-variant-numeric:tabular-nums; }\n  .dk .dphase{ font-size:14px; font-weight:600; letter-spacing:.12em; text-transform:uppercase; color:#5d5d66; }\n  .dk .hint{ position:absolute; left:0; right:0; bottom:calc(34px + env(safe-area-inset-bottom)); text-align:center; font-size:12px; color:#4a4a52; transition:opacity .6s; }\n\n  @media (orientation:landscape) and (max-height:560px){\n    .body{ flex-direction:row; gap:9vw; }\n    .big{ --r:min(40vw,68vh); }\n  }\n  @media (prefers-reduced-motion:reduce){ body{ transition:none; } .ring .arc{ transition:none; } .dk .drift{ transition:none; } }\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-timer\" viewBox=\"0 0 24 24\"><path fill-rule=\"evenodd\" d=\"M9.5 1.8h5a1 1 0 0 1 0 2h-1.5v1.3a8.5 8.5 0 1 1-2 0V3.8H9.5a1 1 0 0 1 0-2zM12 7a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13zm0 1.8a1 1 0 0 1 1 1v3.3l2.1 2.1a1 1 0 0 1-1.4 1.4l-2.4-2.4a1 1 0 0 1-.3-.7V9.8a1 1 0 0 1 1-1zM18.6 4.3a1 1 0 0 1 1.4 0l1.2 1.2a1 1 0 0 1-1.4 1.4l-1.2-1.2a1 1 0 0 1 0-1.4z\"/></symbol>\n  <symbol id=\"i-play\" viewBox=\"0 0 24 24\"><path d=\"M8 5.5v13a1 1 0 0 0 1.52.85l10.4-6.5a1 1 0 0 0 0-1.7L9.52 4.65A1 1 0 0 0 8 5.5z\"/></symbol>\n  <symbol id=\"i-pause\" viewBox=\"0 0 24 24\"><rect x=\"6\" y=\"5\" width=\"4.2\" height=\"14\" rx=\"1.4\"/><rect x=\"13.8\" y=\"5\" width=\"4.2\" height=\"14\" rx=\"1.4\"/></symbol>\n  <symbol id=\"i-reset\" viewBox=\"0 0 24 24\"><path d=\"M12 5V2.6a.6.6 0 0 0-1-.45L7.2 5.55a.6.6 0 0 0 0 .9L11 9.85a.6.6 0 0 0 1-.45V7a5.5 5.5 0 1 1-5.5 5.5 1 1 0 0 0-2 0A7.5 7.5 0 1 0 12 5z\"/></symbol>\n  <symbol id=\"i-stop\" viewBox=\"0 0 24 24\"><rect x=\"6\" y=\"6\" width=\"12\" height=\"12\" rx=\"2.6\"/></symbol>\n  <symbol id=\"i-moon\" viewBox=\"0 0 24 24\"><path d=\"M20.3 14.6a1 1 0 0 0-1.2-.6 7.3 7.3 0 0 1-9.1-9.1 1 1 0 0 0-1.3-1.2 9.3 9.3 0 1 0 12.2 12.2 1 1 0 0 0-.6-1.3z\"/></symbol>\n</defs></svg>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-timer\"/></svg></div>\n  <div class=\"ht\"><h1>Focus Timer</h1><p>Pomodoro focus &amp; breaks</p></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Focus Timer\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n<div class=\"tabs\" id=\"tabs\"></div>\n<div class=\"ringwrap\">\n  <svg class=\"ring\" viewBox=\"0 0 200 200\"><circle class=\"trk\" cx=\"100\" cy=\"100\" r=\"90\"/><circle class=\"arc\" id=\"arcA\" cx=\"100\" cy=\"100\" r=\"90\"/></svg>\n  <div class=\"center\"><div class=\"time\" id=\"time\">25:00</div><div class=\"phase\" id=\"phase\">Focus</div></div>\n</div>\n<div class=\"pom\" id=\"pom\"></div>\n<div class=\"ctrl\"><button id=\"go\"></button><button class=\"sec\" id=\"rs\">Reset</button></div>\n<div class=\"set\">\n  <div><label>Focus</label><input id=\"dFocus\" type=\"number\" min=\"1\" max=\"90\" value=\"25\"><small>min</small></div>\n  <div><label>Short break</label><input id=\"dShort\" type=\"number\" min=\"1\" max=\"30\" value=\"5\"><small>min</small></div>\n  <div><label>Long break</label><input id=\"dLong\" type=\"number\" min=\"1\" max=\"60\" value=\"15\"><small>min</small></div>\n</div>\n\n<div class=\"stage\" id=\"stage\">\n  <div class=\"bg d\"></div><div class=\"bg l\"></div>\n  <div class=\"col\">\n    <div class=\"top\">\n      <span class=\"rnd ghost\"></span>\n      <div class=\"lbl\">Focus Timer</div>\n      <button class=\"glass rnd\" id=\"sDock\" aria-label=\"Dim the screen\"><svg class=\"i\"><use href=\"#i-moon\"/></svg></button>\n    </div>\n    <div class=\"body\">\n      <div class=\"big\">\n        <svg class=\"ring\" viewBox=\"0 0 200 200\"><circle class=\"trk\" cx=\"100\" cy=\"100\" r=\"90\"/><circle class=\"arc\" id=\"arcB\" cx=\"100\" cy=\"100\" r=\"90\"/></svg>\n        <div class=\"center\"><div class=\"phase\" id=\"sPhase\">Focus</div><div class=\"time\" id=\"sTime\">25:00</div><div class=\"note\" id=\"sNote\"></div></div>\n        <div class=\"pom\" id=\"sPom\"></div>\n      </div>\n      <div class=\"side-col\">\n        <div class=\"ctl\">\n          <button class=\"glass side\" id=\"sReset\" aria-label=\"Reset\"><svg class=\"i\"><use href=\"#i-reset\"/></svg></button>\n          <button class=\"main\" id=\"sGo\" aria-label=\"Pause\"></button>\n          <button class=\"glass side\" id=\"sEnd\" aria-label=\"End\"><svg class=\"i\"><use href=\"#i-stop\"/></svg></button>\n        </div>\n        <div class=\"cap\"><span>Reset</span><span id=\"sGoCap\">Pause</span><span>End</span></div>\n      </div>\n    </div>\n  </div>\n  <div class=\"dk\" id=\"dk\"><div class=\"drift\" id=\"dDrift\"><div class=\"dtime\" id=\"dTime\">25:00</div><div class=\"dphase\" id=\"dPhase\">Focus</div></div><div class=\"hint\" id=\"dHint\">Tap to bring it back</div></div>\n</div>\n\n<script>\nfunction el(i){ return document.getElementById(i); }\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction haptic(s){ if (window.myllmHaptic) try { myllmHaptic(s); } catch(_){} }\nfunction load(k){ var s = window.myllmStorage; return s ? s.getItem(k).catch(function(){ return null; }) : Promise.resolve(null); }\nfunction keep(k, v){ var s = window.myllmStorage; if (s) try { s.setItem(k, v).catch(function(){}); } catch(_){} }\n\nvar MODES = [['focus','Focus','dFocus'],['short','Short break','dShort'],['long','Long break','dLong']];\nvar HUE = {focus:228, short:158, long:188};\nvar C = 565.49;\nvar dur = {focus:25, short:5, long:15};\nvar mode = 'focus', running = false, endTime = 0, remaining = 25*60, cycle = 0, pom = 0, actx = null, loop = null;\nvar stageOn = false, dockOn = false, dockDrift = null, wakeLock = null;\nvar ICON = { play:'<svg class=\"i\"><use href=\"#i-play\"/></svg>', pause:'<svg class=\"i\"><use href=\"#i-pause\"/></svg>' };\n\nfunction mmss(s){ s = Math.max(0, Math.ceil(s - 0.05)); return String(Math.floor(s/60)).padStart(2,'0') + ':' + String(s%60).padStart(2,'0'); }\nfunction total(){ return dur[mode]*60; }\nfunction label(){ return MODES.filter(function(m){ return m[0] === mode; })[0][1]; }\nfunction fresh(){ return remaining >= total() - 0.5; }\n\n/* ---------- painting ---------- */\nfunction draw(){\n  var frac = Math.max(0, Math.min(1, remaining/total())), off = String(C*(1 - frac)), t = mmss(remaining);\n  el('arcA').style.strokeDashoffset = off; el('arcB').style.strokeDashoffset = off;\n  el('time').textContent = t; el('sTime').textContent = t; el('dTime').textContent = t;\n}\nfunction pomHTML(){\n  if (pom <= 0) return '';\n  var h = ''; for (var i = 0; i < Math.min(pom, 8); i++) h += '<i></i>';\n  return h + (pom > 8 ? '<span>+' + (pom - 8) + '</span>' : '');\n}\nfunction paint(){\n  document.body.style.setProperty('--h', String(HUE[mode]));\n  var T = el('tabs'); T.innerHTML = '';\n  MODES.forEach(function(m){ var b = document.createElement('button'); b.className = 'tab' + (mode === m[0] ? ' on' : ''); b.textContent = m[1]; b.onclick = function(){ haptic('selection'); setMode(m[0]); }; T.appendChild(b); });\n  el('phase').textContent = el('sPhase').textContent = label();\n  el('dPhase').textContent = label() + (running ? '' : ' · paused');\n  el('pom').innerHTML = el('sPom').innerHTML = pomHTML();\n  el('go').innerHTML = ICON.play + (fresh() ? 'Start' : 'Resume');\n  el('sGo').innerHTML = running ? ICON.pause : ICON.play;\n  el('sGo').setAttribute('aria-label', running ? 'Pause' : 'Start');\n  el('sGoCap').textContent = running ? 'Pause' : (fresh() ? 'Start' : 'Resume');\n  el('sNote').textContent = running ? '' : (fresh() ? 'Ready when you are' : 'Paused');\n  draw();\n}\n\n/* ---------- timer ----------\n   The time left always comes from the end timestamp, never from counting\n   ticks, so it is right however long the app spent in the background. */\nfunction stopLoop(){ if (loop){ clearInterval(loop); loop = null; } }\nfunction setMode(m){ mode = m; running = false; stopLoop(); remaining = total(); paint(); save(); syncChrome(); }\nfunction startRun(){\n  ensureAudio();\n  running = true; endTime = Date.now() + remaining*1000;\n  stopLoop(); loop = setInterval(tick, 250);\n  haptic('light');\n}\nfunction pauseRun(){ running = false; remaining = Math.max(0, (endTime - Date.now())/1000); stopLoop(); }\nfunction toggle(){\n  if (running) pauseRun(); else startRun();\n  if (running && !stageOn) openStage();\n  paint(); save(); syncChrome();\n}\nfunction reset(){ running = false; stopLoop(); remaining = total(); paint(); save(); syncChrome(); }\nfunction tick(){\n  if (!running) return;\n  remaining = (endTime - Date.now())/1000;\n  if (remaining <= 0){ remaining = 0; draw(); complete(); return; }\n  draw();\n}\nfunction complete(){\n  running = false; stopLoop(); chime(); haptic('success');\n  if (dockOn) closeDock();\n  if (mode === 'focus'){ pom++; cycle++; setMode(cycle % 4 === 0 ? 'long' : 'short'); }\n  else setMode('focus');\n}\nfunction ensureAudio(){ if (!actx){ try { actx = new (window.AudioContext || window.webkitAudioContext)(); } catch(e){} } if (actx && actx.state === 'suspended') actx.resume(); }\nfunction chime(){\n  if (!actx) return; var t = actx.currentTime; [0,0.18,0.36].forEach(function(off,i){\n    var o = actx.createOscillator(), g = actx.createGain(); o.type = 'sine'; o.frequency.value = [660,880,990][i];\n    g.gain.setValueAtTime(0.0001,t+off); g.gain.exponentialRampToValueAtTime(0.3,t+off+0.02); g.gain.exponentialRampToValueAtTime(0.0001,t+off+0.4);\n    o.connect(g); g.connect(actx.destination); o.start(t+off); o.stop(t+off+0.42); });\n}\nfunction readDur(){ MODES.forEach(function(m){ var v = parseInt(el(m[2]).value,10); if (v > 0) dur[m[0]] = v; }); if (!running) remaining = total(); paint(); save(); }\nfunction save(){ keep('focus', JSON.stringify({dur:dur, pom:pom, cycle:cycle, mode:mode, running:running, endTime:running ? endTime : 0, remaining:remaining})); }\n\n/* ---------- stage, dock, chrome ---------- */\nfunction isLight(){ return !(window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches); }\nfunction syncLook(){ el('stage').classList.toggle('lite', isLight() && !window.myllmImmersive); }\n/* A session takes the whole display (myllmImmersive hides MyLLM's own title\n   bar). The screen is held awake only while the clock is actually running:\n   by MyLLM where it can, else by the Wake Lock API where the web view has it. */\nfunction syncChrome(){\n  var awake = stageOn && running;\n  if (awake) requestWake(); else releaseWake();\n  if (!window.myllmImmersive) return;\n  try { myllmImmersive((window.myllmClose ? true : (stageOn)), {keepAwake:awake}).catch(function(){}); } catch(_){}\n}\nfunction requestWake(){\n  if (wakeLock || !('wakeLock' in navigator)) return;\n  try { navigator.wakeLock.request('screen').then(function(l){ wakeLock = l; }).catch(function(){ wakeLock = null; }); } catch(_){}\n}\nfunction releaseWake(){ if (wakeLock){ try { wakeLock.release(); } catch(_){} wakeLock = null; } }\nfunction openStage(){\n  stageOn = true; syncLook();\n  el('stage').classList.add('on'); document.body.classList.add('lock');\n  if (document.activeElement && document.activeElement.blur) document.activeElement.blur();\n}\nfunction endStage(){\n  haptic('light');\n  if (running) pauseRun();\n  if (dockOn) closeDock();\n  stageOn = false;\n  el('stage').classList.remove('on'); document.body.classList.remove('lock');\n  paint(); save(); syncChrome();\n}\nfunction driftOnce(){\n  var x = Math.round((Math.random() - 0.5)*44), y = Math.round((Math.random() - 0.5)*44);\n  el('dDrift').style.transform = 'translate(' + x + 'px,' + y + 'px)';\n}\nfunction openDock(){\n  haptic('medium');\n  dockOn = true; driftOnce(); paint();\n  el('stage').classList.add('dock');\n  el('dHint').style.opacity = '1'; setTimeout(function(){ el('dHint').style.opacity = '0'; }, 4000);\n  dockDrift = setInterval(driftOnce, 60000);\n}\nfunction closeDock(){\n  dockOn = false; el('stage').classList.remove('dock');\n  clearInterval(dockDrift); dockDrift = null;\n}\n\nel('go').onclick = toggle;\nel('rs').onclick = function(){ haptic('light'); reset(); };\nel('sGo').onclick = toggle;\nel('sReset').onclick = function(){ haptic('light'); reset(); };\nel('sEnd').onclick = endStage;\nel('sDock').onclick = openDock;\nel('dk').onclick = function(){ haptic('light'); closeDock(); };\nMODES.forEach(function(m){ el(m[2]).addEventListener('change', readDur); });\n\ndocument.addEventListener('visibilitychange', function(){\n  if (document.hidden){ releaseWake(); return; }\n  if (running) tick();                          /* catches a phase that ended while away */\n  if (stageOn) syncChrome();                    /* MyLLM puts its bars back when the app is left */\n});\nif (window.matchMedia){\n  var mq = matchMedia('(prefers-color-scheme: dark)');\n  if (mq.addEventListener) mq.addEventListener('change', syncLook); else if (mq.addListener) mq.addListener(syncLook);\n}\n\n/* ---------- boot ---------- */\npaint();\nload('focus').then(function(v){\n  var o = null; if (v) try { o = JSON.parse(v); } catch(e){}\n  if (o){\n    if (o.dur) dur = o.dur; pom = o.pom || 0; cycle = o.cycle || 0;\n    el('dFocus').value = dur.focus; el('dShort').value = dur.short; el('dLong').value = dur.long;\n    if (o.mode && HUE[o.mode] != null) mode = o.mode;\n  }\n  remaining = total();\n  if (o && o.running && o.endTime){             /* the app was closed mid-session */\n    if (o.endTime > Date.now()){\n      running = true; endTime = o.endTime; remaining = (endTime - Date.now())/1000;\n      loop = setInterval(tick, 250); openStage(); paint(); syncChrome(); return;\n    }\n    remaining = 0; running = true; endTime = o.endTime; tick(); return;\n  }\n  if (o && typeof o.remaining === 'number' && o.remaining > 0 && o.remaining < total()) remaining = o.remaining;\n  paint();\n});\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes.\n   The spacer keeps the header clear of the status bar / Dynamic Island. It is\n   live CSS — env(safe-area-inset-top) — not a measured number: the inset is\n   still 0 when the page loads and only grows once MyLLM's bar has gone (v1\n   measured once, so the title sat under the island). If the page's own styles\n   already pad the header down by the inset, the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  /* Does any rule that applies to the header or an ancestor already use the top inset? */\n  function pageHandlesInset(head){\n    var chain = [], n, found = false;\n    for (n = head; n && n.nodeType === 1; n = n.parentElement) chain.push(n);\n    function walk(rules){\n      for (var i = 0; i < rules.length && !found; i++){\n        var r = rules[i];\n        if (r.cssRules && !r.selectorText) { walk(r.cssRules); continue; }\n        if (!r.selectorText || !/safe-area-inset-top/.test(r.cssText) || !/(padding|margin|top)\\s*:/.test(r.cssText)) continue;\n        if (/\\.imm-safe/.test(r.selectorText)) continue;\n        for (var k = 0; k < chain.length; k++){\n          try { if (chain[k].matches(r.selectorText)) { found = true; break; } } catch(e){}\n        }\n      }\n    }\n    for (var s = 0; s < document.styleSheets.length && !found; s++){\n      try { walk(document.styleSheets[s].cssRules); } catch(e){}\n    }\n    for (n = head; n && n.nodeType === 1 && !found; n = n.parentElement){\n      if (/safe-area-inset-top/.test(n.getAttribute(\"style\") || \"\")) found = true;\n    }\n    return found;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = (document.body.classList.contains(\"imm\") && !pageHandlesInset(head)) ? \"env(safe-area-inset-top)\" : \"0px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script></body></html>\n", "kind": "html", "iconSymbol": "timer", "iconColor": "red"}