{"name": "Focus Timer", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\">\n<style>:root{color-scheme:light dark;--accent:#ff453a}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none}\nbody{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:20px 16px;background:#f2f2f7;color:#111;text-align:center}\n@media(prefers-color-scheme:dark){body{background:#000;color:#eee}.tab,input{background:#1c1c1e;color:#eee}.set{background:#1c1c1e}}\nh1{font-size:21px;margin:0 0 12px}\n.tabs{display:inline-flex;background:#e5e5ea;border-radius:11px;padding:3px;margin-bottom:14px}\n.tab{border:0;background:transparent;color:#555;border-radius:9px;padding:8px 16px;font-size:14px;font-weight:600}\n.tab.on{background:#fff;color:#111;box-shadow:0 1px 2px rgba(0,0,0,.12)}\n@media(prefers-color-scheme:dark){.tabs{background:#1c1c1e}.tab.on{background:#3a3a3c;color:#fff}}\n.ringwrap{position:relative;width:260px;height:260px;margin:6px auto 8px}\ncanvas{width:260px;height:260px}\n.center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}\n.time{font-size:56px;font-weight:200;font-variant-numeric:tabular-nums}\n.phase{font-size:13px;text-transform:uppercase;letter-spacing:.1em;opacity:.55;margin-top:2px}\n.pom{font-size:15px;min-height:20px;margin:4px 0 14px;letter-spacing:2px}\n.ctrl{display:flex;gap:10px;justify-content:center}\n.ctrl button{border:0;border-radius:13px;padding:14px 26px;font-size:16px;font-weight:600;background:var(--accent);color:#fff}\n.ctrl .sec{background:#e5e5ea;color:#333;padding:14px 18px}\n@media(prefers-color-scheme:dark){.ctrl .sec{background:#2c2c2e;color:#eee}}\n.set{margin-top:20px;background:#fff;border-radius:14px;padding:12px 14px;display:inline-flex;gap:16px;box-shadow:0 1px 3px rgba(0,0,0,.07)}\n.set label{font-size:11px;opacity:.6;display:block}\n.set input{width:54px;padding:7px;border:1px solid #d1d1d6;border-radius:8px;font-size:16px;text-align:center;background:#fff;color:#111;-webkit-user-select:text;user-select:text}\n</style></head><body>\n<h1>🍅 Focus Timer</h1>\n<div class=\"tabs\" id=\"tabs\"></div>\n<div class=\"ringwrap\"><canvas id=\"ring\"></canvas><div class=\"center\"><div class=\"time\" id=\"time\">25:00</div><div class=\"phase\" id=\"phase\">Focus</div></div></div>\n<div class=\"pom\" id=\"pom\"></div>\n<div class=\"ctrl\"><button id=\"go\" onclick=\"toggle()\">Start</button><button class=\"sec\" onclick=\"reset()\">Reset</button></div>\n<div class=\"set\">\n  <div><label>Focus</label><input id=\"dFocus\" type=\"number\" min=\"1\" max=\"90\" value=\"25\"></div>\n  <div><label>Short break</label><input id=\"dShort\" type=\"number\" min=\"1\" max=\"30\" value=\"5\"></div>\n  <div><label>Long break</label><input id=\"dLong\" type=\"number\" min=\"1\" max=\"60\" value=\"15\"></div>\n</div>\n<script>\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar MODES=[['focus','Focus','dFocus'],['short','Short break','dShort'],['long','Long break','dLong']];\nvar COLOR={focus:'#ff453a',short:'#30d158',long:'#0a84ff'};\nvar dur={focus:25,short:5,long:15};\nvar mode='focus',running=false,endTime=0,remaining=25*60,cycle=0,pom=0,actx=null,loop=null;\nvar cv=document.getElementById('ring'),ctx2=cv.getContext('2d'),DPR=Math.min(window.devicePixelRatio||1,3);\ncv.width=260*DPR;cv.height=260*DPR;ctx2.scale(DPR,DPR);\nfunction el(i){return document.getElementById(i)}\nfunction mmss(s){s=Math.max(0,Math.round(s));return String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0')}\nfunction total(){return dur[mode]*60}\n\nfunction draw(){\n  var frac=Math.max(0,Math.min(1,remaining/total()));\n  ctx2.clearRect(0,0,260,260);\n  ctx2.lineWidth=14;ctx2.lineCap='round';\n  ctx2.strokeStyle='rgba(127,127,127,.18)';ctx2.beginPath();ctx2.arc(130,130,112,0,Math.PI*2);ctx2.stroke();\n  ctx2.strokeStyle=COLOR[mode];ctx2.beginPath();ctx2.arc(130,130,112,-Math.PI/2,-Math.PI/2+frac*Math.PI*2);ctx2.stroke();\n  el('time').textContent=mmss(remaining);\n  document.documentElement.style.setProperty('--accent',COLOR[mode]);\n}\nfunction renderTabs(){var T=el('tabs');T.innerHTML='';MODES.forEach(function(m){var b=document.createElement('button');b.className='tab'+(mode===m[0]?' on':'');b.textContent=m[1];b.onclick=function(){setMode(m[0])};T.appendChild(b)});el('phase').textContent=MODES.filter(function(m){return m[0]===mode})[0][1]}\nfunction renderPom(){el('pom').textContent=pom>0?('🍅'.repeat(Math.min(pom,8))+(pom>8?' +'+(pom-8):'')):''}\n\nfunction setMode(m){mode=m;running=false;remaining=total();el('go').textContent='Start';renderTabs();draw();save()}\nfunction toggle(){\n  if(running){running=false;remaining=(endTime-Date.now())/1000;el('go').textContent='Start';if(loop){clearInterval(loop);loop=null}}\n  else{ensureAudio();running=true;endTime=Date.now()+remaining*1000;el('go').textContent='Pause';loop=setInterval(tick,250);if(window.myllmHaptic)myllmHaptic('light')}\n  save();\n}\nfunction reset(){running=false;if(loop){clearInterval(loop);loop=null}remaining=total();el('go').textContent='Start';draw();save()}\nfunction tick(){\n  remaining=(endTime-Date.now())/1000;\n  if(remaining<=0){remaining=0;draw();complete();return}\n  draw();\n}\nfunction complete(){\n  running=false;if(loop){clearInterval(loop);loop=null}chime();if(window.myllmHaptic)myllmHaptic('success');\n  if(mode==='focus'){pom++;cycle++;renderPom();setMode(cycle%4===0?'long':'short')}\n  else setMode('focus');\n  el('go').textContent='Start';save();\n}\nfunction ensureAudio(){if(!actx){try{actx=new(window.AudioContext||window.webkitAudioContext)()}catch(e){}}if(actx&&actx.state==='suspended')actx.resume()}\nfunction chime(){\n  if(!actx)return;var t=actx.currentTime;[0,0.18,0.36].forEach(function(off,i){\n    var o=actx.createOscillator(),g=actx.createGain();o.type='sine';o.frequency.value=[660,880,990][i];\n    g.gain.setValueAtTime(0.0001,t+off);g.gain.exponentialRampToValueAtTime(0.3,t+off+0.02);g.gain.exponentialRampToValueAtTime(0.0001,t+off+0.4);\n    o.connect(g);g.connect(actx.destination);o.start(t+off);o.stop(t+off+0.42)});\n}\nfunction readDur(){MODES.forEach(function(m){var v=parseInt(el(m[2]).value,10);if(v>0)dur[m[0]]=v});if(!running)remaining=total();draw();save()}\nfunction save(){store.setItem('focus',JSON.stringify({dur:dur,pom:pom,cycle:cycle}))}\n\nMODES.forEach(function(m){el(m[2]).addEventListener('change',readDur)});\nstore.getItem('focus').then(function(v){\n  if(v)try{var o=JSON.parse(v);if(o.dur)dur=o.dur;pom=o.pom||0;cycle=o.cycle||0;el('dFocus').value=dur.focus;el('dShort').value=dur.short;el('dLong').value=dur.long}catch(e){}\n  remaining=total();renderTabs();renderPom();draw();\n});\n</script></body></html>\n", "kind": "html", "iconSymbol": "timer", "iconColor": "red"}