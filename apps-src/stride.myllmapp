{"name": "Stride", "html": "<!DOCTYPE html>\n<!--\n  Stride — MyLLMos App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Stride</title>\n<style>\n:root{--build-id:\"6980d325e7\";\n  --bg:var(--myllm-bg,#f4f1ee);--surface:var(--myllm-surface,#fff);\n  --text:var(--myllm-text,#181513);--muted:var(--myllm-muted,#6d6560);\n  --border:var(--myllm-border,rgba(120,110,100,.22));\n  --radius:var(--myllm-radius,20px);\n  --font:var(--myllm-font,-apple-system,system-ui,sans-serif);\n  /* Stride's own identity: a sunrise arc. Deliberately not Apple's ring trio. */\n  --warm:#ff6b4a;--glow:#ffb347;--deep:#0f7d7d;--track:rgba(120,110,100,.16);\n  --scale:1;\n}\n@media(prefers-color-scheme:dark){:root{\n  --bg:var(--myllm-bg,#0e0d0c);--surface:var(--myllm-surface,#1b1917);\n  --text:var(--myllm-text,#f2ede8);--muted:var(--myllm-muted,#a49b94);\n  --border:var(--myllm-border,rgba(255,240,225,.16));--track:rgba(255,240,225,.12);\n}}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nhtml{font-size:calc(17px * var(--scale))}\nbody{margin:0;background:var(--bg);color:var(--text);font-family:var(--font);\n  line-height:1.45;padding:0 0 max(28px,env(safe-area-inset-bottom));\n  -webkit-text-size-adjust:100%}\n.wrap{max-width:560px;margin:0 auto;padding:0 16px}\n\n/* ---------- header ---------- */\nheader{position:relative;overflow:hidden;padding:max(18px,env(safe-area-inset-top)) 0 14px;\n  margin-bottom:6px}\nheader .sky{position:absolute;inset:0;background-size:cover;background-position:center;\n  opacity:.5;filter:saturate(1.05)}\n@media(prefers-color-scheme:dark){header .sky{opacity:.34}}\nheader .veil{position:absolute;inset:0;\n  background:linear-gradient(180deg,transparent 0%,var(--bg) 96%)}\nheader .inner{position:relative}\nh1{margin:0;font-size:1.5rem;font-weight:800;letter-spacing:-.02em}\n.date{margin:2px 0 0;color:var(--muted);font-size:.95rem;font-weight:600}\n\n/* ---------- hero ring ---------- */\n.hero{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);\n  padding:22px 18px 20px;text-align:center;box-shadow:0 1px 3px rgba(0,0,0,.05)}\n.ringbox{position:relative;width:min(74vw,290px);margin:0 auto}\nsvg.ring{display:block;width:100%;height:auto;transform:rotate(-90deg)}\nsvg.ring circle{fill:none;stroke-linecap:round}\n.readout{position:absolute;inset:0;display:flex;flex-direction:column;\n  align-items:center;justify-content:center;gap:1px}\n/* The number is the app. Everything else is support. */\n.count{font-size:clamp(2.9rem,17vw,4.1rem);font-weight:850;letter-spacing:-.045em;\n  line-height:1;font-variant-numeric:tabular-nums}\n.count-label{font-size:.92rem;font-weight:700;color:var(--muted);letter-spacing:.06em;\n  text-transform:uppercase}\n.goalline{margin-top:6px;font-size:.92rem;font-weight:650;color:var(--muted)}\n.plain{margin:14px 4px 0;font-size:1.02rem;font-weight:600;color:var(--text)}\n.pct{display:inline-block;margin-top:10px;padding:5px 13px;border-radius:999px;\n  font-size:.9rem;font-weight:750;background:var(--track);color:var(--text)}\n.pct.done{background:linear-gradient(100deg,var(--warm),var(--glow));color:#2a1206}\n\n/* ---------- stats ---------- */\n.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(96px,1fr));gap:10px;margin-top:12px}\n.stat{background:var(--surface);border:1px solid var(--border);border-radius:16px;\n  padding:13px 10px;text-align:center}\n.stat b{display:block;font-size:1.3rem;font-weight:800;letter-spacing:-.02em;\n  font-variant-numeric:tabular-nums}\n.stat span{display:block;margin-top:2px;font-size:.8rem;font-weight:650;color:var(--muted)}\n\n/* ---------- section ---------- */\nsection{margin-top:20px}\nh2{margin:0 0 10px;font-size:1.06rem;font-weight:800;letter-spacing:-.01em}\n.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px}\n\n/* ---------- week ---------- */\n.week{display:flex;align-items:flex-end;gap:6px;height:150px;position:relative}\n.goalmark{position:absolute;left:0;right:0;border-top:2px dashed var(--border);pointer-events:none}\n.goalmark i{position:absolute;right:0;top:-.95rem;font-size:.7rem;font-style:normal;\n  font-weight:700;color:var(--muted);background:var(--surface);padding:0 4px}\n.day{flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;\n  height:100%;gap:5px;background:none;border:0;padding:0;cursor:pointer;font-family:inherit;\n  color:inherit;border-radius:10px;min-width:0}\n.day .bar{width:100%;max-width:34px;border-radius:8px 8px 5px 5px;background:var(--track);\n  transition:height .45s cubic-bezier(.22,1,.36,1);min-height:5px}\n.day.hit .bar{background:linear-gradient(180deg,var(--glow),var(--warm))}\n.day.sel .bar{outline:2.5px solid var(--deep);outline-offset:2px}\n.day .dl{font-size:.76rem;font-weight:750;color:var(--muted)}\n.day .dv{font-size:.72rem;font-weight:650;color:var(--muted);font-variant-numeric:tabular-nums}\n.day.sel .dl{color:var(--text)}\n\n/* ---------- goal ---------- */\n.goalrow{display:flex;align-items:center;justify-content:space-between;gap:12px}\n.step{width:52px;height:52px;flex:none;border-radius:16px;border:1px solid var(--border);\n  background:var(--bg);color:var(--text);font-size:1.5rem;font-weight:700;cursor:pointer;\n  font-family:inherit;line-height:1}\n.step:active{transform:scale(.94)}\n.goalval{font-size:1.65rem;font-weight:850;font-variant-numeric:tabular-nums;letter-spacing:-.03em}\n.goalval small{display:block;font-size:.78rem;font-weight:650;color:var(--muted);letter-spacing:0}\n.presets{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:14px}\n.preset{text-align:left;padding:11px 13px;border-radius:14px;border:1px solid var(--border);\n  background:var(--bg);color:var(--text);cursor:pointer;font-family:inherit;min-height:44px}\n.preset.on{border-color:var(--warm);background:linear-gradient(100deg,rgba(255,107,74,.14),rgba(255,179,71,.12))}\n.preset b{display:block;font-size:.95rem;font-weight:800}\n.preset span{display:block;font-size:.78rem;color:var(--muted);font-weight:600}\n\n/* ---------- milestone ---------- */\n.milestone{margin-top:12px;border-radius:var(--radius);overflow:hidden;border:1px solid var(--border);\n  background:var(--surface);display:none}\n/* A slim band, not a poster — the number is still the point of the screen. */\n.milestone img{display:block;width:100%;height:112px;object-fit:cover;object-position:center 42%}\n@media(prefers-color-scheme:dark){.milestone img{filter:brightness(.86) saturate(.95)}}\n.milestone .m-txt{padding:13px 16px}\n.milestone b{display:block;font-size:1.02rem;font-weight:800}\n.milestone span{font-size:.9rem;color:var(--muted);font-weight:600}\n\n/* ---------- settings row ---------- */\n.opts{display:flex;flex-wrap:wrap;gap:8px}\n.opt{padding:9px 14px;border-radius:999px;border:1px solid var(--border);background:var(--bg);\n  color:var(--text);font-family:inherit;font-size:.9rem;font-weight:700;cursor:pointer;min-height:44px}\n.opt.on{border-color:var(--deep);background:rgba(15,125,125,.13);color:var(--text)}\n.lbl{font-size:.82rem;font-weight:750;color:var(--muted);margin:0 0 7px;\n  text-transform:uppercase;letter-spacing:.06em}\n\n/* ---------- notice ---------- */\n.notice{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);\n  padding:20px;text-align:center}\n.notice .ico{font-size:2.4rem;line-height:1}\n.notice b{display:block;margin:10px 0 6px;font-size:1.1rem;font-weight:800}\n.notice p{margin:0 0 4px;color:var(--muted);font-size:.96rem;font-weight:600}\n.btn{margin-top:14px;padding:13px 20px;border-radius:14px;border:0;cursor:pointer;\n  font-family:inherit;font-size:1rem;font-weight:750;min-height:48px;\n  background:linear-gradient(100deg,var(--warm),var(--glow));color:#2a1206}\n.btn.ghost{background:var(--bg);color:var(--text);border:1px solid var(--border)}\n.foot{margin:22px 4px 0;font-size:.8rem;color:var(--muted);font-weight:600;text-align:center}\n.hide{display:none!important}\n@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}\n</style>\n</head>\n<body>\n\n<header>\n  <div class=\"sky\" id=\"sky\" aria-hidden=\"true\"></div>\n  <div class=\"veil\" aria-hidden=\"true\"></div>\n  <div class=\"inner wrap\">\n    <h1 id=\"greet\">Stride</h1>\n    <p class=\"date\" id=\"today-label\">&nbsp;</p>\n  </div>\n</header>\n\n<div class=\"wrap\">\n\n  <!-- states other than \"working\" -->\n  <div id=\"notice\" class=\"notice hide\"></div>\n\n  <!-- main -->\n  <div id=\"main\" class=\"hide\">\n\n    <div class=\"hero\">\n      <div class=\"ringbox\">\n        <svg class=\"ring\" viewBox=\"0 0 200 200\" aria-hidden=\"true\">\n          <circle cx=\"100\" cy=\"100\" r=\"86\" stroke=\"var(--track)\" stroke-width=\"19\"></circle>\n          <circle id=\"arc\" cx=\"100\" cy=\"100\" r=\"86\" stroke=\"url(#g)\" stroke-width=\"19\"\n                  stroke-dasharray=\"540.35\" stroke-dashoffset=\"540.35\"></circle>\n          <circle id=\"arc2\" cx=\"100\" cy=\"100\" r=\"63\" stroke=\"var(--deep)\" stroke-width=\"7\"\n                  stroke-dasharray=\"395.84\" stroke-dashoffset=\"395.84\" opacity=\"0\"></circle>\n          <defs>\n            <linearGradient id=\"g\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n              <stop offset=\"0%\" stop-color=\"#ffb347\"></stop>\n              <stop offset=\"100%\" stop-color=\"#ff6b4a\"></stop>\n            </linearGradient>\n          </defs>\n        </svg>\n        <div class=\"readout\">\n          <div class=\"count\" id=\"count\" role=\"status\" aria-live=\"polite\">0</div>\n          <div class=\"count-label\" id=\"count-label\">steps</div>\n          <div class=\"goalline\" id=\"goalline\">&nbsp;</div>\n        </div>\n      </div>\n      <p class=\"plain\" id=\"plain\">&nbsp;</p>\n      <div class=\"pct\" id=\"pct\">&nbsp;</div>\n    </div>\n\n    <div class=\"stats\">\n      <div class=\"stat\"><b id=\"s-dist\">—</b><span id=\"s-dist-l\">Distance</span></div>\n      <div class=\"stat\"><b id=\"s-time\">—</b><span>Walking time</span></div>\n      <div class=\"stat\" id=\"s-extra-box\"><b id=\"s-extra\">—</b><span id=\"s-extra-l\">Streak</span></div>\n    </div>\n\n    <div class=\"milestone\" id=\"milestone\">\n      <img id=\"m-img\" alt=\"\" src=\"\">\n      <div class=\"m-txt\"><b id=\"m-title\"></b><span id=\"m-sub\"></span></div>\n    </div>\n\n    <section>\n      <h2>Your last 7 days</h2>\n      <div class=\"card\">\n        <div class=\"week\" id=\"week\" role=\"group\" aria-label=\"Steps for each of the last seven days\"></div>\n        <p class=\"foot\" id=\"week-note\" style=\"margin-top:14px\">Tap a day to see it.</p>\n      </div>\n    </section>\n\n    <section>\n      <h2>Daily goal</h2>\n      <div class=\"card\">\n        <div class=\"goalrow\">\n          <button class=\"step\" id=\"g-down\" aria-label=\"Lower goal by 500 steps\">−</button>\n          <div class=\"goalval\" id=\"g-val\">8,000<small>steps a day</small></div>\n          <button class=\"step\" id=\"g-up\" aria-label=\"Raise goal by 500 steps\">+</button>\n        </div>\n        <div class=\"presets\" id=\"presets\"></div>\n      </div>\n    </section>\n\n    <section>\n      <h2>Make it easier to read</h2>\n      <div class=\"card\">\n        <p class=\"lbl\">Text size</p>\n        <div class=\"opts\" id=\"sizes\"></div>\n        <p class=\"lbl\" style=\"margin-top:16px\">Distance in</p>\n        <div class=\"opts\" id=\"units\"></div>\n      </div>\n    </section>\n\n    <p class=\"foot\" id=\"src-note\">Steps come from your iPhone's motion chip. Nothing leaves your device.</p>\n  </div>\n</div>\n\n<script>\n\"use strict\";\n/* NOTE: never name a global `history` here — that's window.history and the\n   assignment silently fails. Week data lives in `week` / `archive`. */\n\nvar store = window.myllmStorage || {\n  getItem: function(){ return Promise.resolve(null); },\n  setItem: function(){ return Promise.resolve(); }\n};\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(e){} } }\nfunction el(id){ return document.getElementById(id); }\nfunction fmt(n){ return Math.round(n).toLocaleString(); }\n\nvar IMG = \"https://raw.githubusercontent.com/TeamDzX/myllm-assets/main/apps/stride/\";\n\nvar PRESETS = [\n  { v:3000,  b:\"Gentle\",    s:\"a short daily walk\" },\n  { v:6000,  b:\"Steady\",    s:\"moving most days\" },\n  { v:8000,  b:\"Active\",    s:\"a walk plus errands\" },\n  { v:10000, b:\"Ambitious\", s:\"the classic target\" }\n];\nvar SIZES = [ {k:\"1\",b:\"Normal\"}, {k:\"1.15\",b:\"Large\"}, {k:\"1.32\",b:\"Huge\"} ];\n\nvar state = {\n  goal: 8000,\n  unit: \"km\",         // \"km\" | \"mi\"\n  scale: \"1\",\n  week: [],           // [{date, steps, distance, unavailable}]\n  archive: {},        // date -> steps, kept past CoreMotion's 7-day window\n  selected: null,     // date string, or null = today\n  demo: false\n};\n\n/* ---------------- rendering ---------------- */\n\nfunction dayName(iso, short){\n  // Parse as local noon so a timezone shift can't roll the date back a day.\n  var p = iso.split(\"-\");\n  var d = new Date(+p[0], +p[1]-1, +p[2], 12);\n  return d.toLocaleDateString(undefined, short ? {weekday:\"narrow\"} : {weekday:\"long\", day:\"numeric\", month:\"long\"});\n}\nfunction isToday(iso){ return iso === todayISO(); }\nfunction todayISO(){\n  var d = new Date();\n  return d.getFullYear() + \"-\" + String(d.getMonth()+1).padStart(2,\"0\") + \"-\" + String(d.getDate()).padStart(2,\"0\");\n}\n\nfunction current(){\n  var iso = state.selected || todayISO();\n  for (var i=0;i<state.week.length;i++){ if(state.week[i].date === iso) return state.week[i]; }\n  return { date: iso, steps: 0 };\n}\n\nfunction distanceText(metres, steps){\n  // CoreMotion omits distance on some devices — fall back to a stride estimate\n  // so the card never just reads \"—\".\n  var m = (metres != null && metres > 0) ? metres : steps * 0.72;\n  if (state.unit === \"mi\"){\n    var mi = m / 1609.34;\n    return (mi < 10 ? mi.toFixed(1) : Math.round(mi)) + \" mi\";\n  }\n  var km = m / 1000;\n  return (km < 10 ? km.toFixed(1) : Math.round(km)) + \" km\";\n}\n\nfunction render(){\n  var d = current();\n  var steps = d.steps || 0;\n  var goal = state.goal;\n  var pct = goal > 0 ? steps / goal : 0;\n\n  el(\"count\").textContent = fmt(steps);\n  el(\"count-label\").textContent = steps === 1 ? \"step\" : \"steps\";\n  el(\"goalline\").textContent = \"of \" + fmt(goal) + \" goal\";\n\n  // Ring: full circle at goal, inner ring tracks anything beyond it.\n  var C = 540.35, C2 = 395.84;\n  var p1 = Math.max(0, Math.min(1, pct));\n  el(\"arc\").setAttribute(\"stroke-dashoffset\", String(C - C * p1));\n  var over = Math.max(0, Math.min(1, pct - 1));\n  el(\"arc2\").setAttribute(\"opacity\", over > 0 ? \"1\" : \"0\");\n  el(\"arc2\").setAttribute(\"stroke-dashoffset\", String(C2 - C2 * over));\n\n  var pctEl = el(\"pct\");\n  var whole = Math.round(pct * 100);\n  if (pct >= 1){\n    pctEl.textContent = pct >= 2 ? \"Goal smashed — \" + whole + \"%\" : \"Goal reached — \" + whole + \"%\";\n    pctEl.className = \"pct done\";\n  } else {\n    pctEl.textContent = whole + \"% of your goal\";\n    pctEl.className = \"pct\";\n  }\n\n  // Plain-language line — the accessible reading of the ring.\n  var left = Math.max(0, goal - steps);\n  var who = isToday(d.date) ? \"You've walked\" : dayName(d.date) + \" —\";\n  var line = who + \" \" + fmt(steps) + (steps === 1 ? \" step\" : \" steps\") +\n             \", about \" + distanceText(d.distance, steps) + \".\";\n  if (left > 0 && isToday(d.date)) line += \" \" + fmt(left) + \" to go — roughly \" + Math.max(1, Math.round(left/100)) + \" min of walking.\";\n  else if (left > 0) line += \" That was \" + fmt(left) + \" short of goal.\";\n  else line += \" Goal reached.\";\n  el(\"plain\").textContent = line;\n\n  el(\"s-dist\").textContent = distanceText(d.distance, steps);\n  el(\"s-dist-l\").textContent = \"Distance\" + (d.distance == null || d.distance <= 0 ? \" (est.)\" : \"\");\n  el(\"s-time\").textContent = Math.round(steps/100) + \" min\";\n\n  var st = streak();\n  el(\"s-extra\").textContent = st > 0 ? st + (st === 1 ? \" day\" : \" days\") : \"—\";\n  el(\"s-extra-l\").textContent = st > 0 ? \"Goal streak\" : \"Streak\";\n\n  el(\"today-label\").textContent = isToday(d.date)\n    ? dayName(todayISO()) : dayName(d.date) + \" · tap today to go back\";\n\n  renderWeek();\n  renderMilestone(pct, st);\n}\n\nfunction renderWeek(){\n  var box = el(\"week\");\n  var max = Math.max(state.goal, 1);\n  for (var i=0;i<state.week.length;i++) max = Math.max(max, state.week[i].steps || 0);\n\n  box.innerHTML = \"\";\n  var mark = document.createElement(\"div\");\n  mark.className = \"goalmark\";\n  mark.style.bottom = \"calc(\" + (state.goal / max * 100) + \"% * 0.82 + 30px)\";\n  mark.innerHTML = \"<i>goal</i>\";\n  box.appendChild(mark);\n\n  var selIso = state.selected || todayISO();\n  state.week.forEach(function(d){\n    var steps = d.steps || 0;\n    var b = document.createElement(\"button\");\n    b.className = \"day\" + (steps >= state.goal ? \" hit\" : \"\") + (d.date === selIso ? \" sel\" : \"\");\n    b.setAttribute(\"aria-label\", dayName(d.date) + \": \" + fmt(steps) + \" steps\" +\n      (steps >= state.goal ? \", goal reached\" : \"\"));\n    b.setAttribute(\"aria-pressed\", d.date === selIso ? \"true\" : \"false\");\n\n    var bar = document.createElement(\"div\");\n    bar.className = \"bar\";\n    bar.style.height = \"calc(\" + Math.max(2, steps / max * 100) + \"% * 0.82)\";\n    var lbl = document.createElement(\"div\"); lbl.className = \"dl\";\n    lbl.textContent = isToday(d.date) ? \"Today\" : dayName(d.date, true);\n    var val = document.createElement(\"div\"); val.className = \"dv\";\n    val.textContent = steps >= 1000 ? (steps/1000).toFixed(1).replace(/\\.0$/,\"\") + \"k\" : String(steps);\n\n    b.appendChild(bar); b.appendChild(lbl); b.appendChild(val);\n    b.addEventListener(\"click\", function(){\n      state.selected = (state.selected === d.date) ? null : d.date;\n      haptic(\"light\"); render();\n    });\n    box.appendChild(b);\n  });\n}\n\n/* Consecutive days up to today that met goal. Uses the archive so it survives\n   past CoreMotion's 7-day window. */\nfunction streak(){\n  var n = 0, d = new Date();\n  for (var i=0;i<400;i++){\n    var iso = d.getFullYear() + \"-\" + String(d.getMonth()+1).padStart(2,\"0\") + \"-\" + String(d.getDate()).padStart(2,\"0\");\n    var steps = state.archive[iso];\n    if (steps == null){\n      for (var j=0;j<state.week.length;j++) if (state.week[j].date === iso) steps = state.week[j].steps;\n    }\n    if (steps == null) break;\n    if (steps >= state.goal) n++;\n    // Today not yet at goal isn't a broken streak — you've still got the day.\n    else if (i > 0) break;\n    d.setDate(d.getDate() - 1);\n  }\n  return n;\n}\n\nvar MILESTONES = [\n  { at:2, img:\"double.jpg\", t:\"Double goal!\", s:\"Twice your target in one day. That's a proper hike.\" },\n  { at:1, img:\"goal.jpg\",   t:\"Goal reached\", s:\"Nice work — you hit your daily target.\" }\n];\nfunction renderMilestone(pct, st){\n  var box = el(\"milestone\"), m = null;\n  for (var i=0;i<MILESTONES.length;i++){ if (pct >= MILESTONES[i].at){ m = MILESTONES[i]; break; } }\n  if (!m && st >= 3) m = { img:\"streak.jpg\", t:st + \"-day streak\", s:\"You've hit your goal \" + st + \" days running.\" };\n  if (!m){ box.style.display = \"none\"; return; }\n  var img = el(\"m-img\");\n  // Offline (or a slow first load) must not leave a broken-image icon sitting\n  // above the text — drop the picture and keep the message.\n  img.onerror = function(){ img.style.display = \"none\"; };\n  img.onload = function(){ img.style.display = \"block\"; };\n  img.style.display = \"none\";\n  img.src = IMG + m.img;\n  img.alt = \"\";\n  el(\"m-title\").textContent = m.t;\n  el(\"m-sub\").textContent = m.s;\n  box.style.display = \"block\";\n}\n\n/* ---------------- controls ---------------- */\n\nfunction buildControls(){\n  var p = el(\"presets\");\n  p.innerHTML = \"\";\n  PRESETS.forEach(function(x){\n    var b = document.createElement(\"button\");\n    b.className = \"preset\" + (state.goal === x.v ? \" on\" : \"\");\n    // Name on its own line — \"Ambitious · 10,000\" wraps mid-title on a narrow phone.\n    b.innerHTML = \"<b>\" + x.b + \"</b><span>\" + fmt(x.v) + \" · \" + x.s + \"</span>\";\n    b.addEventListener(\"click\", function(){ setGoal(x.v); });\n    p.appendChild(b);\n  });\n\n  var s = el(\"sizes\"); s.innerHTML = \"\";\n  SIZES.forEach(function(x){\n    var b = document.createElement(\"button\");\n    b.className = \"opt\" + (state.scale === x.k ? \" on\" : \"\");\n    b.textContent = x.b;\n    b.addEventListener(\"click\", function(){\n      state.scale = x.k;\n      document.documentElement.style.setProperty(\"--scale\", x.k);\n      store.setItem(\"scale\", x.k); haptic(\"light\"); buildControls();\n    });\n    s.appendChild(b);\n  });\n\n  var u = el(\"units\"); u.innerHTML = \"\";\n  [{k:\"km\",b:\"Kilometres\"},{k:\"mi\",b:\"Miles\"}].forEach(function(x){\n    var b = document.createElement(\"button\");\n    b.className = \"opt\" + (state.unit === x.k ? \" on\" : \"\");\n    b.textContent = x.b;\n    b.addEventListener(\"click\", function(){\n      state.unit = x.k; store.setItem(\"unit\", x.k); haptic(\"light\"); buildControls(); render();\n    });\n    u.appendChild(b);\n  });\n}\n\nfunction setGoal(v){\n  state.goal = Math.max(500, Math.min(40000, Math.round(v/500)*500));\n  el(\"g-val\").innerHTML = fmt(state.goal) + \"<small>steps a day</small>\";\n  store.setItem(\"goal\", String(state.goal));\n  haptic(\"light\"); buildControls(); render();\n}\n\n/* ---------------- data ---------------- */\n\nfunction mergeArchive(week){\n  var changed = false;\n  week.forEach(function(d){\n    if (d.unavailable) return;\n    if (state.archive[d.date] !== d.steps){ state.archive[d.date] = d.steps; changed = true; }\n  });\n  // Keep it small: a rolling year is plenty for streaks and bests.\n  var keys = Object.keys(state.archive).sort();\n  while (keys.length > 400){ delete state.archive[keys.shift()]; changed = true; }\n  if (changed) store.setItem(\"archive\", JSON.stringify(state.archive));\n}\n\nfunction showNotice(icon, title, body, actionLabel, action){\n  var n = el(\"notice\");\n  n.innerHTML = \"\";\n  var i = document.createElement(\"div\"); i.className = \"ico\"; i.textContent = icon;\n  var b = document.createElement(\"b\"); b.textContent = title;\n  var p = document.createElement(\"p\"); p.textContent = body;\n  n.appendChild(i); n.appendChild(b); n.appendChild(p);\n  if (actionLabel){\n    var btn = document.createElement(\"button\");\n    btn.className = \"btn ghost\"; btn.textContent = actionLabel;\n    btn.addEventListener(\"click\", action);\n    n.appendChild(btn);\n  }\n  n.classList.remove(\"hide\");\n  el(\"main\").classList.add(\"hide\");\n}\n\nfunction sampleWeek(){\n  // Deterministic, plausible-looking numbers for previewing the design.\n  var base = [6200, 9400, 4100, 11200, 7300, 8600, 5200], out = [];\n  var d = new Date(); d.setDate(d.getDate() - 6);\n  for (var i=0;i<7;i++){\n    out.push({\n      date: d.getFullYear() + \"-\" + String(d.getMonth()+1).padStart(2,\"0\") + \"-\" + String(d.getDate()).padStart(2,\"0\"),\n      steps: base[i], distance: base[i] * 0.72\n    });\n    d.setDate(d.getDate() + 1);\n  }\n  return out;\n}\n\nfunction startDemo(){\n  state.demo = true;\n  state.week = sampleWeek();\n  el(\"notice\").classList.add(\"hide\");\n  el(\"main\").classList.remove(\"hide\");\n  el(\"src-note\").textContent = \"Sample data — a preview of the design, not your real steps.\";\n  buildControls(); render();\n}\n\nfunction go(){\n  el(\"main\").classList.remove(\"hide\");\n  el(\"notice\").classList.add(\"hide\");\n  buildControls();\n  render();\n\n  myllmSteps.history(7).then(function(week){\n    state.week = week || [];\n    mergeArchive(state.week);\n    render();\n    // Live ticking while you walk with the app open.\n    return myllmSteps.watch(function(sample){\n      var iso = todayISO();\n      for (var i=0;i<state.week.length;i++){\n        if (state.week[i].date === iso){\n          state.week[i].steps = sample.steps;\n          if (sample.distance != null) state.week[i].distance = sample.distance;\n          state.archive[iso] = sample.steps;\n          render();\n          return;\n        }\n      }\n    });\n  }).catch(function(e){\n    showNotice(\"🚶\", \"Can't read your steps\", e && e.message ? e.message : String(e),\n               \"Preview with sample data\", startDemo);\n  });\n}\n\nfunction boot(){\n  var hour = new Date().getHours();\n  el(\"greet\").textContent = hour < 12 ? \"Good morning\" : (hour < 18 ? \"Good afternoon\" : \"Good evening\");\n  el(\"today-label\").textContent = dayName(todayISO());\n  el(\"sky\").style.backgroundImage = \"url('\" + IMG + \"sky.jpg')\";\n\n  el(\"g-up\").addEventListener(\"click\", function(){ setGoal(state.goal + 500); });\n  el(\"g-down\").addEventListener(\"click\", function(){ setGoal(state.goal - 500); });\n\n  Promise.all([\n    store.getItem(\"goal\"), store.getItem(\"unit\"), store.getItem(\"scale\"), store.getItem(\"archive\")\n  ]).then(function(v){\n    if (v[0]) state.goal = parseInt(v[0], 10) || 8000;\n    if (v[1]) state.unit = v[1];\n    if (v[2]){ state.scale = v[2]; document.documentElement.style.setProperty(\"--scale\", v[2]); }\n    if (v[3]){ try { state.archive = JSON.parse(v[3]) || {}; } catch(e){ state.archive = {}; } }\n    el(\"g-val\").innerHTML = fmt(state.goal) + \"<small>steps a day</small>\";\n\n    if (!window.myllmSteps){\n      // Store-neutral wording: apps.json is shared with the Android client.\n      showNotice(\"⏳\", \"Steps need a newer MyLLM\",\n        \"This app reads your step count through MyLLM. Update MyLLM to the latest version and it'll light up.\",\n        \"Preview with sample data\", startDemo);\n      return;\n    }\n    myllmSteps.available().then(function(a){\n      if (!a.steps){\n        showNotice(\"📵\", \"No step counter\",\n          \"This device doesn't have the motion chip that counts steps.\",\n          \"Preview with sample data\", startDemo);\n      } else if (!a.allowed){\n        showNotice(\"🔒\", \"Steps are switched off\",\n          \"Turn on “Allow apps to read your steps” in MyLLM Settings → MyLLMos Apps, then reopen Stride.\",\n          \"Preview with sample data\", startDemo);\n      } else {\n        go();\n      }\n    }).catch(function(){ go(); });\n  });\n}\n\nboot();\n</script>\n</body>\n</html>\n", "kind": "html", "iconSymbol": "figure.walk", "iconColor": "orange"}