{"name": "Shopping List", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover\">\n<title>Shopping List</title>\n\n<!-- #1 intent bus: this app can RECEIVE an \"add-item\" hand-off from another app. -->\n<meta name=\"myllm:intents\" content=\"add-item\">\n\n<!-- #2 app actions: the assistant can run this from chat (\"add milk to my list\"). -->\n<script type=\"application/myllm-actions\">\n[\n  { \"name\": \"add-item\",\n    \"description\": \"Add an item to the shopping list\",\n    \"parameters\": { \"text\": \"the item(s) to add (one per line for several)\" } }\n]\n</script>\n\n<style>\n  :root{\n    --bg: var(--myllm-bg, #f6f7f9);\n    --surface: var(--myllm-surface, #ffffff);\n    --text: var(--myllm-text, #11131a);\n    --muted: var(--myllm-muted, #6b7280);\n    --accent: var(--myllm-accent, #4f7cff);\n    --border: var(--myllm-border, rgba(0,0,0,.10));\n    --radius: var(--myllm-radius, 14px);\n  }\n  @media (prefers-color-scheme: dark){\n    :root{ --bg: var(--myllm-bg,#0e0f13); --surface: var(--myllm-surface,#1a1c22); --text: var(--myllm-text,#f3f4f7); --muted: var(--myllm-muted,#a4abba); --border: var(--myllm-border,rgba(255,255,255,.14)); }\n  }\n  *{ box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  html,body{ margin:0; height:100%; }\n  body{\n    background:var(--bg); color:var(--text);\n    font-family:var(--myllm-font, -apple-system,system-ui,'Segoe UI',Roboto,sans-serif);\n    display:flex; flex-direction:column; padding:max(16px,env(safe-area-inset-top)) 16px 16px;\n    user-select:none; -webkit-user-select:none;\n  }\n  header{ margin-bottom:14px; }\n  h1{ font-size:24px; margin:0 0 2px; display:flex; align-items:center; gap:8px; }\n  .sub{ color:var(--muted); font-size:13px; }\n  .add{ display:flex; gap:8px; margin-bottom:14px; }\n  input[type=text]{\n    flex:1; min-width:0; font:inherit; font-size:16px; color:var(--text);\n    background:var(--surface); border:1px solid var(--border); border-radius:var(--radius);\n    padding:12px 14px; outline:none; user-select:text; -webkit-user-select:text;\n  }\n  input[type=text]:focus{ border-color:var(--accent); }\n  button{ font:inherit; cursor:pointer; border:0; }\n  .btn{\n    background:var(--accent); color:#fff; font-weight:700; font-size:16px;\n    border-radius:var(--radius); padding:12px 16px;\n  }\n  ul{ list-style:none; margin:0; padding:0; flex:1; overflow:auto; }\n  li{\n    display:flex; align-items:center; gap:12px; background:var(--surface);\n    border:1px solid var(--border); border-radius:var(--radius); padding:13px 14px; margin-bottom:9px;\n  }\n  li .check{\n    width:24px; height:24px; border-radius:50%; border:2px solid var(--accent);\n    flex:none; display:flex; align-items:center; justify-content:center; color:#fff; font-size:14px;\n  }\n  li.done .check{ background:var(--accent); }\n  li.done .label{ text-decoration:line-through; color:var(--muted); }\n  .label{ flex:1; min-width:0; font-size:17px; word-break:break-word; }\n  .del{ background:transparent; color:var(--muted); font-size:20px; padding:4px 6px; }\n  .empty{ color:var(--muted); text-align:center; padding:40px 16px; font-size:15px; }\n  footer{ display:flex; justify-content:space-between; align-items:center; padding-top:8px; color:var(--muted); font-size:13px; }\n  .clear{ background:transparent; color:var(--accent); font-weight:600; font-size:13px; }\n  .toast{\n    position:fixed; left:50%; bottom:22px; transform:translateX(-50%) translateY(20px);\n    background:var(--text); color:var(--bg); padding:10px 16px; border-radius:999px; font-size:14px;\n    opacity:0; transition:opacity .2s, transform .2s; pointer-events:none; max-width:80%;\n  }\n  .toast.show{ opacity:1; transform:translateX(-50%); }\n\n  /* iPad / large screens: a centred, comfortable column instead of full-width\n     rows (which look stretched) or a tiny stamp. Scales type up a touch. */\n  @media (min-width: 768px){\n    body{ max-width: 740px; margin-inline: auto; padding-left:24px; padding-right:24px; }\n    h1{ font-size:30px; }\n    .label{ font-size:19px; }\n    input[type=text]{ font-size:18px; padding:14px 16px; }\n    .btn{ font-size:18px; }\n  }\n</style>\n</head>\n<body>\n<header>\n  <h1>🛒 Shopping List</h1>\n  <div class=\"sub\">Saved to your shared files — other apps and the assistant can add to it.</div>\n</header>\n\n<form class=\"add\" id=\"addForm\">\n  <input type=\"text\" id=\"text\" placeholder=\"Add an item…\" autocomplete=\"off\" enterkeyhint=\"done\">\n  <button class=\"btn\" type=\"submit\">Add</button>\n</form>\n\n<ul id=\"list\"></ul>\n\n<footer>\n  <span id=\"count\">0 items</span>\n  <button class=\"clear\" id=\"clearDone\" type=\"button\">Clear ticked</button>\n</footer>\n\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\n(function(){\n  var FILE = 'lists/shopping.json';\n  var items = [];\n\n  function toast(msg){\n    var t = document.getElementById('toast');\n    t.textContent = msg; t.classList.add('show');\n    clearTimeout(t._t); t._t = setTimeout(function(){ t.classList.remove('show'); }, 1800);\n  }\n  function haptic(s){ try{ if(window.myllmHaptic) myllmHaptic(s); }catch(e){} }\n\n  // Persist to the SHARED file store (#3) so the Files app + other apps see it;\n  // fall back to per-app storage, then localStorage (for the web preview).\n  async function load(){\n    try{ if(window.myllmFiles){ var t = await myllmFiles.read(FILE); return t ? JSON.parse(t) : []; } }catch(e){}\n    try{ if(window.myllmStorage){ var v = await myllmStorage.getItem('shopping'); return v ? JSON.parse(v) : []; } }catch(e){}\n    try{ var l = localStorage.getItem('shopping'); return l ? JSON.parse(l) : []; }catch(e){}\n    return [];\n  }\n  async function save(){\n    var s = JSON.stringify(items);\n    try{ if(window.myllmFiles){ await myllmFiles.write(FILE, s); return; } }catch(e){}\n    try{ if(window.myllmStorage){ await myllmStorage.setItem('shopping', s); return; } }catch(e){}\n    try{ localStorage.setItem('shopping', s); }catch(e){}\n  }\n\n  function render(){\n    var ul = document.getElementById('list');\n    ul.innerHTML = '';\n    if(!items.length){\n      ul.innerHTML = '<div class=\"empty\">Nothing on the list yet.<br>Add an item, ask the assistant, or send one from Quick Capture.</div>';\n    }\n    items.forEach(function(it, i){\n      var li = document.createElement('li');\n      if(it.done) li.className = 'done';\n      li.innerHTML = '<div class=\"check\">'+(it.done?'✓':'')+'</div><div class=\"label\"></div><button class=\"del\" aria-label=\"Delete\">×</button>';\n      li.querySelector('.label').textContent = it.text;\n      li.querySelector('.check').onclick = function(){ items[i].done = !items[i].done; haptic('selection'); save(); render(); };\n      li.querySelector('.del').onclick = function(){ items.splice(i,1); haptic('light'); save(); render(); };\n      ul.appendChild(li);\n    });\n    var n = items.length;\n    document.getElementById('count').textContent = n + (n===1?' item':' items');\n  }\n\n  function addItem(text, opts){\n    opts = opts || {};\n    String(text).split('\\n').forEach(function(line){\n      var t = line.trim();\n      if(t) items.unshift({ text: t, done: false });\n    });\n    haptic('success'); save(); render();\n    if(opts.toast) toast(opts.toast);\n  }\n\n  document.getElementById('addForm').addEventListener('submit', function(e){\n    e.preventDefault();\n    var inp = document.getElementById('text');\n    if(inp.value.trim()){ addItem(inp.value); inp.value = ''; }\n    inp.focus();\n  });\n  document.getElementById('clearDone').addEventListener('click', function(){\n    items = items.filter(function(it){ return !it.done; });\n    haptic('light'); save(); render();\n  });\n\n  // #1/#2 — handle a hand-off (from Quick Capture) or an assistant action.\n  if(window.myllmIntent && myllmIntent.receive){\n    myllmIntent.receive(function(intent){\n      if(intent && intent.action === 'add-item' && intent.data){\n        var text = intent.data.text || intent.data.item || intent.data.value || '';\n        if(text) addItem(text, { toast: 'Added ✓' });\n      }\n    });\n  }\n\n  load().then(function(saved){ items = saved || []; render(); });\n})();\n</script>\n</body>\n</html>\n", "kind": "html", "iconSymbol": "cart.fill", "iconColor": "green"}