{"name": "Shopping List", "html": "<!doctype html>\n<!--\n  Shopping List — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover\">\n<title>Shopping List</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n\n<!-- #1 intent bus: this app can RECEIVE an \"add-item\" hand-off from another app. -->\n<meta name=\"myllm:intents\" content=\"add-item\">\n\n<!-- #2 app actions: the assistant can run this from chat (\"add milk to my list\"). -->\n<script type=\"application/myllm-actions\">\n[\n  { \"name\": \"add-item\",\n    \"description\": \"Add an item to the shopping list\",\n    \"parameters\": { \"text\": \"the item(s) to add (one per line for several)\" } }\n]\n</script>\n\n<style>\n  :root{--build-id:\"ce49e3f95d\";color-scheme:light dark;\n    --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n    --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n    --fill:rgba(120,120,128,.12); --h:140; }\n  @media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n    --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4; user-select:none; -webkit-user-select:none;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:760px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; border:none; background:none; } button:active{ transform:scale(.96); }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 28%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  h2{ display:flex; align-items:center; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:20px 2px 10px; }\n  h2 .sp{ flex:1; }\n  .clear{ min-height:32px; padding:0 4px; font-size:13px; font-weight:700; letter-spacing:0; text-transform:none; color:var(--acc); }\n  .clear:disabled{ opacity:.4; }\n\n  .hero{ border-radius:20px; padding:16px 18px; color:#fff; margin-bottom:12px;\n    background:linear-gradient(145deg, hsl(var(--h) 55% 40%), hsl(calc(var(--h) + 40) 55% 24%)); box-shadow:0 10px 28px hsl(var(--h) 60% 24% / .25); }\n  .hero .k{ font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.8; }\n  .hero .n{ font-size:44px; font-weight:800; line-height:1.05; letter-spacing:-.03em; font-variant-numeric:tabular-nums; }\n  .hero .l{ font-size:13px; opacity:.82; margin-top:1px; }\n  .hero .bar{ height:6px; border-radius:99px; background:rgba(255,255,255,.25); margin-top:10px; overflow:hidden; }\n  .hero .bar i{ display:block; height:100%; border-radius:99px; background:#fff; transition:width .35s cubic-bezier(.2,.8,.2,1); }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  .add{ display:flex; gap:8px; }\n  input[type=text]{ flex:1; min-width:0; font:inherit; font-size:16px; padding:12px; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; user-select:text; -webkit-user-select:text; }\n  input[type=text]:focus{ border-color:var(--acc); }\n  .btn{ flex-shrink:0; min-height:46px; border-radius:12px; background:var(--acc); color:#fff; font-weight:700; padding:0 16px; display:flex; align-items:center; gap:6px; }\n\n  ul{ list-style:none; display:grid; gap:8px; }\n  ul{ grid-template-columns:minmax(0,1fr); }\n  @media (min-width:768px){ ul{ grid-template-columns:repeat(2,minmax(0,1fr)); } }\n  li{ display:flex; align-items:center; gap:12px; background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:8px 6px 8px 8px; }\n  li .check{ width:44px; height:44px; border-radius:50%; flex-shrink:0; display:flex; align-items:center; justify-content:center; }\n  li .check i{ width:26px; height:26px; border-radius:50%; border:2.4px solid var(--line); display:flex; align-items:center; justify-content:center; color:transparent; font-size:14px; transition:background .2s, border-color .2s; }\n  li.done .check i{ background:hsl(var(--h) 60% 42%); border-color:hsl(var(--h) 60% 42%); color:#fff; }\n  li.done .label{ text-decoration:line-through; color:var(--muted); }\n  .label{ flex:1; min-width:0; font-size:17px; overflow-wrap:anywhere; }\n  .del{ width:44px; height:44px; flex-shrink:0; color:var(--muted); display:flex; align-items:center; justify-content:center; font-size:14px; }\n\n  .empty{ grid-column:1/-1; text-align:center; padding:26px 20px 14px; background:var(--surface); border:1px solid var(--line); border-radius:18px; }\n  .empty .tile{ width:48px; height:48px; border-radius:14px; font-size:21px; margin:0 auto 10px; opacity:.9; }\n  .empty b{ display:block; font-size:16px; font-weight:750; }\n  .empty p{ font-size:13.5px; color:var(--muted); line-height:1.5; max-width:290px; margin:5px auto 0; }\n\n  .toast{ position:fixed; left:50%; bottom:calc(22px + env(safe-area-inset-bottom)); transform:translateX(-50%) translateY(20px);\n    background:var(--ink); color:var(--bg); padding:10px 16px; border-radius:999px; font-size:14px; font-weight:600;\n    opacity:0; transition:opacity .2s, transform .2s; pointer-events:none; max-width:80%; }\n  .toast.show{ opacity:1; transform:translateX(-50%); }\n  @media (prefers-reduced-motion:reduce){ .hero .bar i, li .check i{ transition:none; } button:active{ transform:none; } }\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style>\n\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-cart\" viewBox=\"0 0 24 24\"><path d=\"M2.5 3.5a1 1 0 0 1 1-1h1.6a1.5 1.5 0 0 1 1.46 1.16L6.8 5H20a1 1 0 0 1 .97 1.24l-1.6 6.5A1.5 1.5 0 0 1 17.92 14H8.4l.3 1.5H18a1 1 0 0 1 0 2H8.3a1.5 1.5 0 0 1-1.47-1.2L4.86 4.5H3.5a1 1 0 0 1-1-1zM9 21.5a1.6 1.6 0 1 1 0-3.2 1.6 1.6 0 0 1 0 3.2zm8 0a1.6 1.6 0 1 1 0-3.2 1.6 1.6 0 0 1 0 3.2z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M5 12.6l4.6 4.6L19.2 7.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-plus\" viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n</defs></svg>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-cart\"/></svg></div>\n  <div class=\"ht\"><h1>Shopping List</h1><p>Saved to your shared files — other apps and the assistant can add to it</p></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Shopping List\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n\n<div class=\"hero\">\n  <div class=\"k\">Left to get</div>\n  <div class=\"n\" id=\"left\">0</div>\n  <div class=\"l\" id=\"count\">0 items</div>\n  <div class=\"bar\"><i id=\"prog\" style=\"width:0\"></i></div>\n</div>\n\n<form class=\"card add\" id=\"addForm\">\n  <input type=\"text\" id=\"text\" placeholder=\"Add an item…\" autocomplete=\"off\" enterkeyhint=\"done\">\n  <button class=\"btn\" type=\"submit\"><svg class=\"i\"><use href=\"#i-plus\"/></svg>Add</button>\n</form>\n\n<h2><span>On the list</span><span class=\"sp\"></span><button class=\"clear\" id=\"clearDone\" type=\"button\">Clear ticked</button></h2>\n<ul id=\"list\"></ul>\n\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\n(function(){\n  var FILE = 'lists/shopping.json';\n  var items = [];\n\n  function toast(msg){\n    var t = document.getElementById('toast');\n    t.textContent = msg; t.classList.add('show');\n    clearTimeout(t._t); t._t = setTimeout(function(){ t.classList.remove('show'); }, 1800);\n  }\n  function haptic(s){ try{ if(window.myllmHaptic) myllmHaptic(s); }catch(e){} }\n\n  // Persist to the SHARED file store (#3) so the Files app + other apps see it;\n  // fall back to per-app storage, then localStorage (for the web preview).\n  async function load(){\n    try{ if(window.myllmFiles){ var t = await myllmFiles.read(FILE); return t ? JSON.parse(t) : []; } }catch(e){}\n    try{ if(window.myllmStorage){ var v = await myllmStorage.getItem('shopping'); return v ? JSON.parse(v) : []; } }catch(e){}\n    try{ var l = localStorage.getItem('shopping'); return l ? JSON.parse(l) : []; }catch(e){}\n    return [];\n  }\n  async function save(){\n    var s = JSON.stringify(items);\n    try{ if(window.myllmFiles){ await myllmFiles.write(FILE, s); return; } }catch(e){}\n    try{ if(window.myllmStorage){ await myllmStorage.setItem('shopping', s); return; } }catch(e){}\n    try{ localStorage.setItem('shopping', s); }catch(e){}\n  }\n\n  function render(){\n    var ul = document.getElementById('list');\n    ul.innerHTML = '';\n    if(!items.length){\n      ul.innerHTML = '<li class=\"empty\"><div class=\"tile\"><svg class=\"i\"><use href=\"#i-cart\"/></svg></div><b>Nothing on the list yet</b><p>Add an item, ask the assistant, or send one from Quick Capture.</p></li>';\n    }\n    items.forEach(function(it, i){\n      var li = document.createElement('li');\n      if(it.done) li.className = 'done';\n      li.innerHTML = '<button class=\"check\" type=\"button\" aria-label=\"'+(it.done?'Untick':'Tick')+'\"><i><svg class=\"i\"><use href=\"#i-check\"/></svg></i></button><div class=\"label\"></div><button class=\"del\" type=\"button\" aria-label=\"Delete\"><svg class=\"i\"><use href=\"#i-x\"/></svg></button>';\n      li.querySelector('.label').textContent = it.text;\n      li.querySelector('.check').onclick = function(){ items[i].done = !items[i].done; haptic('selection'); save(); render(); };\n      li.querySelector('.del').onclick = function(){ items.splice(i,1); haptic('light'); save(); render(); };\n      ul.appendChild(li);\n    });\n    var n = items.length, ticked = items.filter(function(it){ return it.done; }).length;\n    document.getElementById('count').textContent = n + (n===1?' item':' items') + (ticked ? ' · ' + ticked + ' ticked' : '');\n    document.getElementById('left').textContent = n - ticked;\n    document.getElementById('prog').style.width = (n ? ticked / n * 100 : 0) + '%';\n    document.getElementById('clearDone').disabled = !ticked;\n  }\n\n  function addItem(text, opts){\n    opts = opts || {};\n    String(text).split('\\n').forEach(function(line){\n      var t = line.trim();\n      if(t) items.unshift({ text: t, done: false });\n    });\n    haptic('success'); save(); render();\n    if(opts.toast) toast(opts.toast);\n  }\n\n  document.getElementById('addForm').addEventListener('submit', function(e){\n    e.preventDefault();\n    var inp = document.getElementById('text');\n    if(inp.value.trim()){ addItem(inp.value); inp.value = ''; }\n    inp.focus();\n  });\n  document.getElementById('clearDone').addEventListener('click', function(){\n    items = items.filter(function(it){ return !it.done; });\n    haptic('light'); save(); render();\n  });\n\n  // #1/#2 — handle a hand-off (from Quick Capture) or an assistant action.\n  if(window.myllmIntent && myllmIntent.receive){\n    myllmIntent.receive(function(intent){\n      if(intent && intent.action === 'add-item' && intent.data){\n        var text = intent.data.text || intent.data.item || intent.data.value || '';\n        if(text) addItem(text, { toast: 'Added ✓' });\n      }\n    });\n  }\n\n  load().then(function(saved){ items = saved || []; render(); });\n})();\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes.\n   The spacer keeps the header clear of the status bar / Dynamic Island. It is\n   live CSS — env(safe-area-inset-top) — not a measured number: the inset is\n   still 0 when the page loads and only grows once MyLLM's bar has gone (v1\n   measured once, so the title sat under the island). If the page's own styles\n   already pad the header down by the inset, the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  /* Does any rule that applies to the header or an ancestor already use the top inset? */\n  function pageHandlesInset(head){\n    var chain = [], n, found = false;\n    for (n = head; n && n.nodeType === 1; n = n.parentElement) chain.push(n);\n    function walk(rules){\n      for (var i = 0; i < rules.length && !found; i++){\n        var r = rules[i];\n        if (r.cssRules && !r.selectorText) { walk(r.cssRules); continue; }\n        if (!r.selectorText || !/safe-area-inset-top/.test(r.cssText) || !/(padding|margin|top)\\s*:/.test(r.cssText)) continue;\n        if (/\\.imm-safe/.test(r.selectorText)) continue;\n        for (var k = 0; k < chain.length; k++){\n          try { if (chain[k].matches(r.selectorText)) { found = true; break; } } catch(e){}\n        }\n      }\n    }\n    for (var s = 0; s < document.styleSheets.length && !found; s++){\n      try { walk(document.styleSheets[s].cssRules); } catch(e){}\n    }\n    for (n = head; n && n.nodeType === 1 && !found; n = n.parentElement){\n      if (/safe-area-inset-top/.test(n.getAttribute(\"style\") || \"\")) found = true;\n    }\n    return found;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = (document.body.classList.contains(\"imm\") && !pageHandlesInset(head)) ? \"env(safe-area-inset-top)\" : \"0px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script>\n</body>\n</html>\n", "kind": "html", "iconSymbol": "cart.fill", "iconColor": "green"}