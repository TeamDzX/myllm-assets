{"name": "Shopping List", "html": "<!doctype html>\n<!--\n  Shopping List — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover\">\n<title>Shopping List</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n\n<!-- #1 intent bus: this app can RECEIVE an \"add-item\" hand-off from another app. -->\n<meta name=\"myllm:intents\" content=\"add-item\">\n\n<!-- #2 app actions: the assistant can run this from chat (\"add milk to my list\"). -->\n<script type=\"application/myllm-actions\">\n[\n  { \"name\": \"add-item\",\n    \"description\": \"Add an item to the shopping list\",\n    \"parameters\": { \"text\": \"the item(s) to add (one per line for several)\",\n                    \"list\": \"optional: the name of one of the user's lists (e.g. Party); the open list if left out\" } }\n]\n</script>\n\n<style>\n  :root{--build-id:\"ce49e3f95d\";color-scheme:light dark;\n    --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n    --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n    --fill:rgba(120,120,128,.12); --h:140;--grain:0.721498142178;}\n  @media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n    --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4; user-select:none; -webkit-user-select:none;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:760px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; border:none; background:none; } button:active{ transform:scale(.96); }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 28%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  h2{ display:flex; align-items:center; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:20px 2px 10px; }\n  h2 .sp{ flex:1; }\n  .clear{ min-height:32px; padding:0 4px; font-size:13px; font-weight:700; letter-spacing:0; text-transform:none; color:var(--acc); }\n  .clear:disabled{ opacity:.4; }\n\n  .hero{ border-radius:20px; padding:16px 18px; color:#fff; margin-bottom:12px;\n    background:linear-gradient(145deg, hsl(var(--h) 55% 40%), hsl(calc(var(--h) + 40) 55% 24%)); box-shadow:0 10px 28px hsl(var(--h) 60% 24% / .25); }\n  .hero .k{ font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.8; }\n  .hero .n{ font-size:44px; font-weight:800; line-height:1.05; letter-spacing:-.03em; font-variant-numeric:tabular-nums; }\n  .hero .l{ font-size:13px; opacity:.82; margin-top:1px; }\n  .hero .bar{ height:6px; border-radius:99px; background:rgba(255,255,255,.25); margin-top:10px; overflow:hidden; }\n  .hero .bar i{ display:block; height:100%; border-radius:99px; background:#fff; transition:width .35s cubic-bezier(.2,.8,.2,1); }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  .add{ display:flex; gap:8px; }\n  input[type=text]{ flex:1; min-width:0; font:inherit; font-size:16px; padding:12px; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; user-select:text; -webkit-user-select:text; }\n  input[type=text]:focus{ border-color:var(--acc); }\n  .btn{ flex-shrink:0; min-height:46px; border-radius:12px; background:var(--acc); color:#fff; font-weight:700; padding:0 16px; display:flex; align-items:center; gap:6px; }\n\n  ul{ list-style:none; display:grid; gap:8px; }\n  ul{ grid-template-columns:minmax(0,1fr); }\n  @media (min-width:768px){ ul{ grid-template-columns:repeat(2,minmax(0,1fr)); } }\n  li{ display:flex; align-items:center; gap:12px; background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:8px 6px 8px 8px; }\n  li .check{ width:44px; height:44px; border-radius:50%; flex-shrink:0; display:flex; align-items:center; justify-content:center; }\n  li .check i{ width:26px; height:26px; border-radius:50%; border:2.4px solid var(--line); display:flex; align-items:center; justify-content:center; color:transparent; font-size:14px; transition:background .2s, border-color .2s; }\n  li.done .check i{ background:hsl(var(--h) 60% 42%); border-color:hsl(var(--h) 60% 42%); color:#fff; }\n  li.done .label{ text-decoration:line-through; color:var(--muted); }\n  .label{ flex:1; min-width:0; font-size:17px; overflow-wrap:anywhere; }\n  .del{ width:44px; height:44px; flex-shrink:0; color:var(--muted); display:flex; align-items:center; justify-content:center; font-size:14px; }\n\n  .empty{ grid-column:1/-1; text-align:center; padding:26px 20px 14px; background:var(--surface); border:1px solid var(--line); border-radius:18px; }\n  .empty .tile{ width:48px; height:48px; border-radius:14px; font-size:21px; margin:0 auto 10px; opacity:.9; }\n  .empty b{ display:block; font-size:16px; font-weight:750; }\n  .empty p{ font-size:13.5px; color:var(--muted); line-height:1.5; max-width:290px; margin:5px auto 0; }\n\n  .toast{ position:fixed; left:50%; bottom:calc(22px + env(safe-area-inset-bottom)); transform:translateX(-50%) translateY(20px);\n    background:var(--ink); color:var(--bg); padding:10px 16px; border-radius:999px; font-size:14px; font-weight:600;\n    opacity:0; transition:opacity .2s, transform .2s; pointer-events:none; max-width:80%; }\n  .toast.show{ opacity:1; transform:translateX(-50%); }\n  @media (prefers-reduced-motion:reduce){ .hero .bar i, li .check i{ transition:none; } button:active{ transform:none; } }\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n/* lists-kit:css */\n/* lists-kit v1 — list bar + sheet (uses the app's --bg/--surface/--ink/--muted/--line/--acc/--fill) */\n.lk-bar{ display:flex; align-items:center; gap:8px; margin:0 0 12px; }\n.lk-chips{ flex:1; min-width:0; display:flex; gap:6px; overflow-x:auto; scrollbar-width:none; -webkit-overflow-scrolling:touch; padding:2px 1px; }\n.lk-chips::-webkit-scrollbar{ display:none; }\n.lk-chip{ flex-shrink:0; display:inline-flex; align-items:center; gap:6px; height:34px; padding:0 13px; border-radius:99px; font-size:13.5px; font-weight:700;\n  background:var(--surface); border:1px solid var(--line); color:var(--ink); max-width:62vw; }\n.lk-chip span{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n.lk-chip.on{ background:var(--acc); border-color:var(--acc); color:#fff; }\n.lk-chip.lk-new{ color:var(--acc); border-style:dashed; }\n.lk-i{ width:15px; height:15px; flex-shrink:0; }\n.lk-dot{ width:7px; height:7px; border-radius:50%; background:#ff9f0a; flex-shrink:0; }\n.lk-share{ flex-shrink:0; display:inline-flex; align-items:center; gap:6px; height:34px; padding:0 12px; border-radius:99px; font-size:13px; font-weight:700;\n  color:var(--acc); background:var(--fill); }\n.lk-line{ font-size:12.5px; color:var(--muted); margin:-6px 4px 10px; min-height:0; }\n.lk-line:empty{ display:none; }\n.lk-line.bad{ color:#e8890c; }\n.lk-wrap{ position:fixed; inset:0; z-index:50; background:rgba(0,0,0,0); display:flex; align-items:flex-end; justify-content:center; transition:background .2s; }\n.lk-wrap.show{ background:rgba(0,0,0,.38); }\n.lk-sheet{ width:100%; max-width:520px; background:var(--surface); color:var(--ink); border-radius:22px 22px 0 0; display:flex; flex-direction:column; gap:10px;\n  padding:18px 16px calc(18px + env(safe-area-inset-bottom)); transform:translateY(100%); transition:transform .25s cubic-bezier(.2,.8,.2,1); max-height:88dvh; overflow:auto; }\n.lk-wrap.show .lk-sheet{ transform:none; }\n.lk-sheet h3{ font-size:19px; font-weight:800; overflow-wrap:anywhere; }\n.lk-sub{ font-size:13.5px; color:var(--muted); margin-top:-6px; }\n.lk-sheet input{ width:100%; font:inherit; font-size:16px; color:var(--ink); background:var(--bg); border:1px solid var(--line); border-radius:12px; padding:11px 12px; outline:none; -webkit-appearance:none; }\n.lk-sheet input:focus{ border-color:var(--acc); }\n.lk-sheet input:disabled{ opacity:.6; }\n.lk-field{ display:flex; gap:8px; } .lk-field input{ flex:1; min-width:0; }\n.lk-row{ display:flex; gap:8px; } .lk-row .lk-btn{ flex:1; }\n.lk-btn{ min-height:44px; padding:0 14px; border-radius:13px; font-size:15px; font-weight:700; background:var(--fill); color:var(--ink);\n  display:inline-flex; align-items:center; justify-content:center; gap:8px; flex-shrink:0; }\n.lk-btn.wide{ width:100%; }\n.lk-btn.pri{ background:var(--acc); color:#fff; }\n.lk-btn.danger{ color:#ff453a; }\n.lk-btn:disabled{ opacity:.45; }\n.lk-note{ font-size:12.5px; color:var(--muted); line-height:1.4; }\n.lk-err{ color:#ff453a; }\n.lk-toast{ position:fixed; left:50%; bottom:calc(24px + env(safe-area-inset-bottom)); transform:translate(-50%, 20px); opacity:0; pointer-events:none; z-index:60;\n  background:rgba(30,30,32,.94); color:#fff; font-size:14px; font-weight:600; padding:10px 16px; border-radius:99px; max-width:86vw; text-align:center; transition:all .25s; }\n.lk-toast.show{ opacity:1; transform:translate(-50%, 0); }\n@media (prefers-reduced-motion:reduce){ .lk-wrap,.lk-sheet,.lk-toast{ transition:none; } }\n/* /lists-kit:css */\n</style>\n\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-cart\" viewBox=\"0 0 24 24\"><path d=\"M2.5 3.5a1 1 0 0 1 1-1h1.6a1.5 1.5 0 0 1 1.46 1.16L6.8 5H20a1 1 0 0 1 .97 1.24l-1.6 6.5A1.5 1.5 0 0 1 17.92 14H8.4l.3 1.5H18a1 1 0 0 1 0 2H8.3a1.5 1.5 0 0 1-1.47-1.2L4.86 4.5H3.5a1 1 0 0 1-1-1zM9 21.5a1.6 1.6 0 1 1 0-3.2 1.6 1.6 0 0 1 0 3.2zm8 0a1.6 1.6 0 1 1 0-3.2 1.6 1.6 0 0 1 0 3.2z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M5 12.6l4.6 4.6L19.2 7.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-plus\" viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n</defs></svg>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-cart\"/></svg></div>\n  <div class=\"ht\"><h1>Shopping List</h1><p>Several lists, and share any of them through iCloud</p></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Shopping List\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n<!-- lists-kit:bar --><div class=\"lk-bar\" id=\"lkBar\"></div><p class=\"lk-line\" id=\"lkLine\"></p><!-- /lists-kit:bar -->\n<div class=\"hero\">\n  <div class=\"k\">Left to get</div>\n  <div class=\"n\" id=\"left\">0</div>\n  <div class=\"l\" id=\"count\">0 items</div>\n  <div class=\"bar\"><i id=\"prog\" style=\"width:0\"></i></div>\n</div>\n\n<form class=\"card add\" id=\"addForm\">\n  <input type=\"text\" id=\"text\" placeholder=\"Add an item…\" autocomplete=\"off\" enterkeyhint=\"done\">\n  <button class=\"btn\" type=\"submit\"><svg class=\"i\"><use href=\"#i-plus\"/></svg>Add</button>\n</form>\n\n<h2><span>On the list</span><span class=\"sp\"></span><button class=\"clear\" id=\"clearDone\" type=\"button\">Clear ticked</button></h2>\n<ul id=\"list\"></ul>\n\n<div class=\"toast\" id=\"toast\"></div>\n\n<script id=\"lists-kit\">\n/* lists-kit v1 — several lists in one app; any of them can move to iCloud and\n   be shared with other iCloud users, who edit the same list from their own\n   MyLLM (myllmLists, MyLLM 6.1+). Without iCloud everything stays on this\n   device, as before.\n   The app keeps its own item code and calls:\n     ListsKit.start({kind, storeKey, defaultName, noun, fix, legacy, render, main, changed, ready})\n     main(items): the first list changed · changed(list): any list changed\n     ListsKit.items()  → the open list's items (the app may mutate it)\n     ListsKit.set(arr[, list]) → after any change (saves, mirrors, syncs)\n     ListsKit.byName(name) / ListsKit.current() / ListsKit.all() */\n(function(){\n  var K = window.ListsKit = {};\n  var o = null, st = { current: null, lists: [] };\n  var cloud = null, why = \"\";           // null = not asked yet\n  var pushing = {}, timers = {}, polling = null;\n\n  function el(id){ return document.getElementById(id); }\n  function esc(s){ return String(s).replace(/[&<>\"]/g, function(c){ return {\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\"}[c]; }); }\n  function haptic(k){ try { if (window.myllmHaptic) myllmHaptic(k || \"light\"); } catch(e){} }\n  function uid(){ return \"l_\" + Date.now().toString(36) + Math.random().toString(36).slice(2, 6); }\n  function find(id){ for (var i = 0; i < st.lists.length; i++) if (st.lists[i].id === id) return st.lists[i]; return null; }\n  function cur(){ return find(st.current) || st.lists[0]; }\n  function fixAll(a){ return (Array.isArray(a) ? a : []).filter(function(x){ return x && typeof x === \"object\"; }).map(o.fix); }\n  function same(a, b){ return JSON.stringify(a) === JSON.stringify(b); }\n\n  /* ---- this device ---- */\n  /* myllmStorage only: MyLLM always has it, and outside MyLLM the lists just\n     last while the page is open. */\n  function persist(){\n    var S = window.myllmStorage;\n    try { if (S) S.setItem(o.storeKey, JSON.stringify(st)).catch(function(){}); } catch(e){}\n  }\n  function restore(){\n    var S = window.myllmStorage;\n    if (!S) return Promise.resolve(null);\n    return Promise.resolve().then(function(){ return S.getItem(o.storeKey); }).catch(function(){ return null; })\n      .then(function(v){ try { return v ? JSON.parse(v) : null; } catch(e){ return null; } });\n  }\n  function afterChange(list){\n    persist();\n    if (list === st.lists[0] && o.main) try { o.main(list.items); } catch(e){}\n    if (o.changed) try { o.changed(list); } catch(e){}\n  }\n\n  /* ---- merge: what changed here since `base` wins, the rest follows `remote`\n     (the same rules MyLLM uses in iCloud) ---- */\n  function merge(base, local, remote){\n    function idx(a){ var m = {}; a.forEach(function(x){ m[x.id] = x; }); return m; }\n    var b = idx(base), r = idx(remote), out = [], placed = {};\n    local.forEach(function(x){\n      if (placed[x.id]) return;\n      var mine = !same(x, b[x.id]);\n      if (r[x.id]) out.push(mine ? x : r[x.id]);\n      else if (!b[x.id] || mine) out.push(x);\n      else return;\n      placed[x.id] = 1;\n    });\n    var prev = null;\n    remote.forEach(function(x){\n      var p = prev; prev = x.id;\n      if (placed[x.id] || b[x.id]) return;\n      var at = 0;\n      if (p != null) for (var i = 0; i < out.length; i++) if (out[i].id === p) { at = i + 1; break; }\n      out.splice(at, 0, x); placed[x.id] = 1;\n    });\n    return out;\n  }\n  K._merge = merge;\n\n  /* ---- iCloud ---- */\n  function check(){\n    if (!window.myllmLists) { cloud = false; why = \"Sharing needs MyLLM 6.1 or later on iPhone, iPad or Mac.\"; return Promise.resolve(); }\n    return myllmLists.available().then(function(a){ cloud = !!(a && a.available); why = (a && a.reason) || \"\"; })\n      .catch(function(e){ cloud = false; why = e.message || \"iCloud couldn't be reached.\"; });\n  }\n  function meta(l, r){\n    l.name = r.name || l.name;\n    l.cloud = { shared: !!r.shared, owner: !!r.owner, ownerName: r.ownerName || \"\", people: r.people || [] };\n  }\n  function pull(){\n    if (!cloud) return Promise.resolve();\n    return myllmLists.all(o.kind).then(function(remote){\n      var seen = {}, gone = [];\n      remote.forEach(function(r){\n        seen[r.id] = 1;\n        var l = find(r.id);\n        if (!l) { l = { id: r.id, items: fixAll(r.items) }; meta(l, r); st.lists.push(l); return; }\n        l.err = null;\n        if (l.dirty || pushing[l.id]) { meta(l, r); return; }    // our change is on its way\n        l.items = fixAll(r.items); meta(l, r);\n      });\n      st.lists = st.lists.filter(function(l){ if (l.cloud && !seen[l.id]) { gone.push(l.name); return false; } return true; });\n      if (!st.lists.length) st.lists.push({ id: uid(), name: o.defaultName, items: [] });\n      if (!find(st.current)) st.current = st.lists[0].id;\n      if (gone.length) toast(\"“\" + gone[0] + \"” was deleted or is no longer shared with you\");\n      afterChange(st.lists[0]); paint(); o.render();\n    }).catch(function(e){\n      st.lists.forEach(function(l){ if (l.cloud) l.err = e.message; }); paint();\n    });\n  }\n  function schedule(l){\n    clearTimeout(timers[l.id]);\n    timers[l.id] = setTimeout(function(){ push(l.id); }, 450);\n  }\n  function push(id){\n    var l = find(id);\n    if (!l || !l.cloud || !l.dirty || !cloud) return Promise.resolve();\n    if (pushing[id]) return pushing[id];\n    var sent = JSON.parse(JSON.stringify(l.items));\n    l.dirty = false;\n    pushing[id] = myllmLists.save(id, sent).then(function(r){\n      var now = find(id); if (!now) return;\n      var merged = fixAll(r.items);\n      if (same(now.items, sent)) now.items = merged;\n      else { now.items = merge(sent, now.items, merged); now.dirty = true; }   // edited while saving\n      meta(now, r); now.err = null;\n    }).catch(function(e){\n      var now = find(id); if (now) { now.dirty = true; now.err = e.message || \"Not synced\"; }\n    }).then(function(){\n      delete pushing[id];\n      var now = find(id);\n      if (now) { afterChange(now); if (now === cur()) o.render(); paint(); if (now.dirty && !now.err) schedule(now); }\n    });\n    return pushing[id];\n  }\n  function accepted(){\n    if (!cloud || !myllmLists.takeAccepted) return Promise.resolve();\n    return myllmLists.takeAccepted(o.kind).then(function(id){\n      if (!id) return;\n      return pull().then(function(){\n        var l = find(id); if (!l) return;\n        st.current = id; persist(); paint(); o.render();\n        toast(\"You've joined “\" + l.name + \"”\");\n      });\n    }).catch(function(){});\n  }\n  function tick(){\n    if (document.hidden) return;\n    var errs = st.lists.filter(function(l){ return l.cloud && l.dirty && l.err; });\n    errs.forEach(function(l){ l.err = null; push(l.id); });\n    pull();\n  }\n\n  /* ---- the list bar ---- */\n  function people(l){\n    if (!l.cloud) return \"\";\n    if (!l.cloud.owner) return \"Shared by \" + (l.cloud.ownerName || \"someone\");\n    if (l.cloud.people.length) return \"Shared with \" + l.cloud.people.join(\", \");\n    return \"In your iCloud\";\n  }\n  function paint(){\n    var bar = el(\"lkBar\"); if (!bar) return;\n    var c = cur(), h = '<div class=\"lk-chips\" role=\"tablist\">';\n    st.lists.forEach(function(l){\n      h += '<button class=\"lk-chip' + (l === c ? \" on\" : \"\") + '\" role=\"tab\" aria-selected=\"' + (l === c) + '\" data-lk=\"' + esc(l.id) + '\">' +\n        (l.cloud && (l.cloud.shared || !l.cloud.owner) ? '<svg class=\"lk-i\" viewBox=\"0 0 24 24\" aria-label=\"Shared\"><use href=\"#lk-people\"/></svg>' : \"\") +\n        '<span>' + esc(l.name) + '</span>' + (l.cloud && l.err ? '<i class=\"lk-dot\" title=\"Not synced\"></i>' : \"\") + '</button>';\n    });\n    h += '<button class=\"lk-chip lk-new\" data-lk-new aria-label=\"New ' + o.noun + '\"><svg class=\"lk-i\" viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></svg><span>New</span></button></div>';\n    h += '<button class=\"lk-share\" data-lk-menu aria-label=\"Share or edit this ' + o.noun + '\"><svg class=\"lk-i\" viewBox=\"0 0 24 24\"><use href=\"#lk-people\"/></svg><span>' + (c.cloud && (c.cloud.shared || !c.cloud.owner) ? \"Shared\" : \"Share\") + '</span></button>';\n    bar.innerHTML = h;\n    var line = el(\"lkLine\");\n    if (line) {\n      var t = people(c);\n      if (c.cloud && c.err) t = (t ? t + \" · \" : \"\") + \"Not synced: \" + c.err;\n      line.textContent = t; line.classList.toggle(\"bad\", !!(c.cloud && c.err));\n    }\n    var on = bar.querySelector(\".lk-chip.on\");\n    if (on && on.scrollIntoView) try { on.scrollIntoView({ block: \"nearest\", inline: \"nearest\" }); } catch(e){}\n  }\n\n  /* ---- sheet ---- */\n  function sheet(html, wire){\n    close();\n    var w = document.createElement(\"div\");\n    w.className = \"lk-wrap\"; w.id = \"lkWrap\";\n    w.innerHTML = '<div class=\"lk-sheet\" role=\"dialog\" aria-modal=\"true\">' + html + '</div>';\n    w.addEventListener(\"click\", function(e){ if (e.target === w) close(); });\n    document.body.appendChild(w);\n    requestAnimationFrame(function(){ w.classList.add(\"show\"); });\n    wire(w);\n  }\n  function close(){ var w = el(\"lkWrap\"); if (w) w.remove(); }\n  function busy(btn, on, label){ if (!btn) return; btn.disabled = on; if (label) btn.textContent = label; }\n\n  function newSheet(){\n    sheet('<h3>New ' + o.noun + '</h3><input id=\"lkName\" maxlength=\"60\" placeholder=\"Name, e.g. ' + esc(o.example) + '\" enterkeyhint=\"done\" autocomplete=\"off\">' +\n      '<div class=\"lk-row\"><button class=\"lk-btn\" data-x>Cancel</button><button class=\"lk-btn pri\" id=\"lkMake\">Create</button></div>' +\n      '<p class=\"lk-note\">' + (cloud ? \"Kept on this device until you share it.\" : \"Kept on this device.\") + '</p>', function(w){\n      var inp = w.querySelector(\"#lkName\"), go = w.querySelector(\"#lkMake\");\n      w.querySelector(\"[data-x]\").onclick = close;\n      function make(){\n        var name = inp.value.trim(); if (!name) { inp.focus(); return; }\n        var l = { id: uid(), name: name.slice(0, 60), items: [] };\n        st.lists.push(l); st.current = l.id; persist(); close(); haptic(\"success\"); paint(); o.render();\n      }\n      go.onclick = make;\n      inp.addEventListener(\"keydown\", function(e){ if (e.key === \"Enter\") make(); });\n      setTimeout(function(){ inp.focus(); }, 60);\n    });\n  }\n\n  function menuSheet(){\n    var l = cur(), isCloud = !!l.cloud, owner = !isCloud || l.cloud.owner, only = st.lists.length < 2;\n    var status = isCloud ? people(l) : \"On this device only\";\n    var shareLabel = !isCloud ? \"Share with people…\" : owner ? \"Manage sharing…\" : \"See who's sharing…\";\n    var del = !owner ? \"Leave this \" + o.noun : isCloud && l.cloud.shared ? \"Delete for everyone\" : \"Delete \" + o.noun;\n    sheet('<h3>' + esc(l.name) + '</h3><p class=\"lk-sub\">' + esc(status) + '</p>' +\n      '<button class=\"lk-btn pri wide\" id=\"lkShare\"><svg class=\"lk-i\" viewBox=\"0 0 24 24\"><use href=\"#lk-people\"/></svg>' + shareLabel + '</button>' +\n      (cloud === false ? '<p class=\"lk-note\">' + esc(why) + '</p>' : !isCloud ? '<p class=\"lk-note\">Sharing moves this ' + o.noun + ' to your iCloud. People you invite need MyLLM 6.1 or later and edit it from their own app.</p>' : \"\") +\n      '<div class=\"lk-field\"><input id=\"lkRename\" maxlength=\"60\" value=\"' + esc(l.name) + '\" aria-label=\"Name\" enterkeyhint=\"done\" autocomplete=\"off\"' + (owner ? \"\" : \" disabled\") + '>' +\n      (owner ? '<button class=\"lk-btn\" id=\"lkSave\">Rename</button>' : \"\") + '</div>' +\n      '<button class=\"lk-btn danger wide\" id=\"lkDel\"' + (only && owner ? \" disabled\" : \"\") + '>' + del + '</button>' +\n      (only && owner ? '<p class=\"lk-note\">This is your only ' + o.noun + '. Make another first to delete it.</p>' : \"\") +\n      '<button class=\"lk-btn wide\" data-x>Done</button>', function(w){\n      w.querySelector(\"[data-x]\").onclick = close;\n      var share = w.querySelector(\"#lkShare\"), msg = function(t){ var n = w.querySelector(\".lk-err\") || w.querySelector(\".lk-sheet\").appendChild(Object.assign(document.createElement(\"p\"), { className: \"lk-note lk-err\" })); n.textContent = t; };\n      share.disabled = cloud === false;\n      share.onclick = function(){ busy(share, true); shareList(l).then(close, function(e){ busy(share, false); msg(e.message || String(e)); }); };\n      var ren = w.querySelector(\"#lkSave\");\n      if (ren) ren.onclick = function(){\n        var name = w.querySelector(\"#lkRename\").value.trim().slice(0, 60); if (!name || name === l.name) return;\n        busy(ren, true);\n        (l.cloud ? myllmLists.rename(l.id, name).then(function(r){ meta(l, r); }) : Promise.resolve(l.name = name))\n          .then(function(){ persist(); paint(); close(); haptic(\"success\"); }, function(e){ busy(ren, false); msg(e.message); });\n      };\n      var d = w.querySelector(\"#lkDel\"), armed = false;\n      d.onclick = function(){\n        if (!armed) { armed = true; d.textContent = \"Tap again to \" + del.charAt(0).toLowerCase() + del.slice(1); haptic(\"warning\"); return; }\n        busy(d, true);\n        (l.cloud ? myllmLists.remove(l.id) : Promise.resolve()).then(function(){\n          st.lists = st.lists.filter(function(x){ return x !== l; });\n          if (!st.lists.length) st.lists.push({ id: uid(), name: o.defaultName, items: [] });\n          st.current = st.lists[0].id; afterChange(st.lists[0]); close(); paint(); o.render(); haptic(\"light\");\n        }, function(e){ busy(d, false); msg(e.message); });\n      };\n    });\n  }\n\n  /* Moving a list to iCloud the first time it's shared: create it there, put\n     the items in, swap it into place, then open Apple's sharing sheet. */\n  function shareList(l){\n    var go = cloud === null ? check() : Promise.resolve();\n    return go.then(function(){\n      if (!cloud) throw new Error(why || \"iCloud isn't available.\");\n      if (l.cloud) return myllmLists.share(l.id);\n      return myllmLists.create(o.kind, l.name).then(function(c){\n        return myllmLists.save(c.id, l.items).then(function(r){\n          var at = st.lists.indexOf(l), moved = { id: r.id, items: fixAll(r.items) };\n          meta(moved, r);\n          if (at >= 0) st.lists[at] = moved; else st.lists.push(moved);\n          if (st.current === l.id) st.current = moved.id;\n          afterChange(moved); paint(); o.render();\n          return myllmLists.share(moved.id);\n        });\n      });\n    });\n  }\n\n  var toastT = null;\n  function toast(t){\n    var n = el(\"lkToast\");\n    if (!n) { n = document.createElement(\"div\"); n.id = \"lkToast\"; n.className = \"lk-toast\"; document.body.appendChild(n); }\n    n.textContent = t; n.classList.add(\"show\");\n    clearTimeout(toastT); toastT = setTimeout(function(){ n.classList.remove(\"show\"); }, 2600);\n  }\n\n  /* ---- public ---- */\n  K.items = function(){ return cur().items; };\n  K.current = function(){ return cur(); };\n  K.all = function(){ return st.lists; };\n  K.byName = function(name){\n    var n = String(name || \"\").trim().toLowerCase(); if (!n) return null;\n    for (var i = 0; i < st.lists.length; i++) if (st.lists[i].name.toLowerCase() === n) return st.lists[i];\n    return null;\n  };\n  K.set = function(arr, list){\n    var l = list || cur(); l.items = arr;\n    afterChange(l); paint();\n    if (l.cloud) { l.dirty = true; schedule(l); }\n  };\n  K.start = function(opts){\n    o = opts; o.noun = o.noun || \"list\"; o.example = o.example || \"Weekend\";\n    var defs = document.createElement(\"div\");\n    defs.innerHTML = '<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><symbol id=\"lk-people\" viewBox=\"0 0 24 24\">' +\n      '<circle cx=\"9\" cy=\"8\" r=\"3.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"/><path d=\"M2.8 19.5c.6-3.3 3.1-5.2 6.2-5.2s5.6 1.9 6.2 5.2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"/>' +\n      '<path d=\"M15.6 4.9a3.2 3.2 0 0 1 0 6.2M18 14.6c1.7.7 2.9 2.4 3.2 4.9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"/></symbol></svg>';\n    document.body.appendChild(defs.firstChild);\n    document.addEventListener(\"click\", function(e){\n      var t = e.target.closest ? e.target : null; if (!t) return;\n      var chip = t.closest(\"[data-lk]\"), add = t.closest(\"[data-lk-new]\"), menu = t.closest(\"[data-lk-menu]\");\n      if (chip) { var id = chip.getAttribute(\"data-lk\"); if (id !== st.current) { st.current = id; persist(); haptic(\"selection\"); paint(); o.render(); } else menuSheet(); }\n      else if (add) newSheet();\n      else if (menu) menuSheet();\n    });\n    return restore().then(function(saved){\n      if (saved && Array.isArray(saved.lists) && saved.lists.length) {\n        st = saved;\n        st.lists.forEach(function(l){ l.items = fixAll(l.items); l.err = null; });\n        return null;\n      }\n      return Promise.resolve(o.legacy ? o.legacy() : []).catch(function(){ return []; }).then(function(items){\n        st = { current: null, lists: [{ id: uid(), name: o.defaultName, items: fixAll(items) }] };\n        st.current = st.lists[0].id; persist();\n      });\n    }).then(function(){\n      if (!find(st.current)) st.current = st.lists[0].id;\n      paint(); o.render();\n      if (o.ready) try { o.ready(); } catch(e){}     // lists are usable now; iCloud follows\n      return check();\n    }).then(function(){\n      paint();\n      if (!cloud) return;\n      return pull().then(function(){\n        st.lists.forEach(function(l){ if (l.cloud && l.dirty) push(l.id); });\n        return accepted();\n      }).then(function(){\n        polling = setInterval(tick, 12000);\n        document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) { tick(); accepted(); } });\n      });\n    });\n  };\n})();\n</script>\n<script>\n(function(){\n  var FILE = 'lists/shopping.json';\n  var items = [];\n  function fix(it){ return { id: String(it.id || ('s_' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7))), text: String(it.text || ''), done: !!it.done }; }\n\n  function toast(msg){\n    var t = document.getElementById('toast');\n    t.textContent = msg; t.classList.add('show');\n    clearTimeout(t._t); t._t = setTimeout(function(){ t.classList.remove('show'); }, 1800);\n  }\n  function haptic(s){ try{ if(window.myllmHaptic) myllmHaptic(s); }catch(e){} }\n\n  // v7: the lists live in ListsKit (this app's storage, or iCloud once shared).\n  // The FIRST list is still mirrored to the shared file store (#3), so the\n  // Files app, other apps and the assistant see it as before.\n  async function load(){\n    try{ if(window.myllmFiles){ var t = await myllmFiles.read(FILE); return t ? JSON.parse(t) : []; } }catch(e){}\n    try{ if(window.myllmStorage){ var v = await myllmStorage.getItem('shopping'); return v ? JSON.parse(v) : []; } }catch(e){}\n    try{ var l = localStorage.getItem('shopping'); return l ? JSON.parse(l) : []; }catch(e){}\n    return [];\n  }\n  function mirror(first){\n    var s = JSON.stringify(first.map(function(it){ return { text: it.text, done: it.done }; }));\n    try{ if(window.myllmFiles) myllmFiles.write(FILE, s).catch(function(){}); }catch(e){}\n  }\n  function save(list){ if(list) ListsKit.set(list.items, list); else ListsKit.set(items); }\n\n  function render(){\n    items = ListsKit.items();\n    var ul = document.getElementById('list');\n    ul.innerHTML = '';\n    if(!items.length){\n      ul.innerHTML = '<li class=\"empty\"><div class=\"tile\"><svg class=\"i\"><use href=\"#i-cart\"/></svg></div><b>Nothing on the list yet</b><p>Add an item, ask the assistant, or send one from Quick Capture.</p></li>';\n    }\n    items.forEach(function(it, i){\n      var li = document.createElement('li');\n      if(it.done) li.className = 'done';\n      li.innerHTML = '<button class=\"check\" type=\"button\" aria-label=\"'+(it.done?'Untick':'Tick')+'\"><i><svg class=\"i\"><use href=\"#i-check\"/></svg></i></button><div class=\"label\"></div><button class=\"del\" type=\"button\" aria-label=\"Delete\"><svg class=\"i\"><use href=\"#i-x\"/></svg></button>';\n      li.querySelector('.label').textContent = it.text;\n      li.querySelector('.check').onclick = function(){ items[i].done = !items[i].done; haptic('selection'); save(); render(); };\n      li.querySelector('.del').onclick = function(){ items.splice(i,1); haptic('light'); save(); render(); };\n      ul.appendChild(li);\n    });\n    var n = items.length, ticked = items.filter(function(it){ return it.done; }).length;\n    document.getElementById('count').textContent = n + (n===1?' item':' items') + (ticked ? ' · ' + ticked + ' ticked' : '');\n    document.getElementById('left').textContent = n - ticked;\n    document.getElementById('prog').style.width = (n ? ticked / n * 100 : 0) + '%';\n    document.getElementById('clearDone').disabled = !ticked;\n  }\n\n  function addItem(text, opts){\n    opts = opts || {};\n    var list = opts.list || ListsKit.current();\n    String(text).split('\\n').forEach(function(line){\n      var t = line.trim();\n      if(t) list.items.unshift(fix({ text: t, done: false }));\n    });\n    haptic('success'); save(list); render();\n    if(opts.toast) toast(opts.toast);\n  }\n\n  document.getElementById('addForm').addEventListener('submit', function(e){\n    e.preventDefault();\n    var inp = document.getElementById('text');\n    if(inp.value.trim()){ addItem(inp.value); inp.value = ''; }\n    inp.focus();\n  });\n  document.getElementById('clearDone').addEventListener('click', function(){\n    items = items.filter(function(it){ return !it.done; });\n    haptic('light'); save(); render();\n  });\n\n  ListsKit.start({ kind: 'shopping', storeKey: 'lists', defaultName: 'Shopping', example: 'Party, Weekly shop',\n    fix: fix, legacy: load, render: render, main: mirror, ready: listen });\n  // #1/#2 — handle a hand-off (from Quick Capture) or an assistant action.\n  // Registered once the lists have loaded, so the load can't overwrite it.\n  function listen(){ if(window.myllmIntent && myllmIntent.receive){\n    myllmIntent.receive(function(intent){\n      if(intent && intent.action === 'add-item' && intent.data){\n        var text = intent.data.text || intent.data.item || intent.data.value || '';\n        if(!text) return 'Nothing added: no item text was given.';\n        var lines = String(text).split('\\n').map(function(l){ return l.trim(); }).filter(Boolean);\n        var asked = String(intent.data.list || '').trim(), list = ListsKit.byName(asked) || ListsKit.current();\n        addItem(text, { toast: 'Added to ' + list.name + ' ✓', list: list });\n        var left = list.items.filter(function(i){ return !i.done; }).length;\n        /* Goes back to the assistant (MyLLM 5.9.2+). */\n        return 'Added '+lines.join(', ')+' to the “'+list.name+'” list ('+left+' still to buy).' +\n          (asked && list.name.toLowerCase() !== asked.toLowerCase() ? ' There is no list called “'+asked+'”; the user\\'s lists are: '+ListsKit.all().map(function(l){ return l.name; }).join(', ')+'.' : '');\n      }\n    });\n  } }\n\n})();\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes.\n   The spacer keeps the header clear of the status bar / Dynamic Island. It is\n   live CSS — env(safe-area-inset-top) — not a measured number: the inset is\n   still 0 when the page loads and only grows once MyLLM's bar has gone (v1\n   measured once, so the title sat under the island). If the page's own styles\n   already pad the header down by the inset, the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  /* Does any rule that applies to the header or an ancestor already use the top inset? */\n  function pageHandlesInset(head){\n    var chain = [], n, found = false;\n    for (n = head; n && n.nodeType === 1; n = n.parentElement) chain.push(n);\n    function walk(rules){\n      for (var i = 0; i < rules.length && !found; i++){\n        var r = rules[i];\n        if (r.cssRules && !r.selectorText) { walk(r.cssRules); continue; }\n        if (!r.selectorText || !/safe-area-inset-top/.test(r.cssText) || !/(padding|margin|top)\\s*:/.test(r.cssText)) continue;\n        if (/\\.imm-safe/.test(r.selectorText)) continue;\n        for (var k = 0; k < chain.length; k++){\n          try { if (chain[k].matches(r.selectorText)) { found = true; break; } } catch(e){}\n        }\n      }\n    }\n    for (var s = 0; s < document.styleSheets.length && !found; s++){\n      try { walk(document.styleSheets[s].cssRules); } catch(e){}\n    }\n    for (n = head; n && n.nodeType === 1 && !found; n = n.parentElement){\n      if (/safe-area-inset-top/.test(n.getAttribute(\"style\") || \"\")) found = true;\n    }\n    return found;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = (document.body.classList.contains(\"imm\") && !pageHandlesInset(head)) ? \"env(safe-area-inset-top)\" : \"0px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script>\n</body>\n</html>\n", "kind": "html", "iconSymbol": "cart.fill", "iconColor": "green"}