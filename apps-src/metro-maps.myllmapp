B6007A\",\"FFFFFF\",[[198,199,200,201,202,203,204,205,24,206,207,26,208,209,15,48,133,210,156,211,212,213,119,74,126,191,214,160,215,216,37,166,70,217,218,219,145,220,207]]]],\"r\":[]}];/*DATA:END*/\n\nvar $=function(id){return document.getElementById(id)};\nfunction esc(s){return String(s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]})}\nfunction haptic(s){ try{ if(window.myllmHaptic)window.myllmHaptic(s||'light'); }catch(e){} }\nvar DARK=matchMedia('(prefers-color-scheme: dark)');\nfunction fold(s){ return s.normalize('NFD').replace(/[̀-ͯ]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,' ').trim(); }\n\n/* ---------- Cities ---------- */\nfunction lum(hex){ var n=parseInt(hex,16),r=(n>>16&255)/255,g=(n>>8&255)/255,b=(n&255)/255;\n  function c(v){return v<=.03928?v/12.92:Math.pow((v+.055)/1.055,2.4)} return .2126*c(r)+.7152*c(g)+.0722*c(b); }\nfunction mixWhite(hex,t){ var n=parseInt(hex,16),r=n>>16&255,g=n>>8&255,b=n&255;\n  return '#'+[r,g,b].map(function(v){return Math.round(v+(255-v)*t).toString(16).padStart(2,'0')}).join(''); }\nfunction prepCity(raw){\n  var c={id:raw.id,name:raw.name,st:[],lines:[],rivers:raw.r||[]};\n  for(var i=0;i<raw.n.length;i++)c.st.push({i:i,name:raw.n[i],x:raw.xy[2*i],y:raw.xy[2*i+1],lines:[],key:fold(raw.n[i]),ja:raw.ja?raw.ja[i]:null});\n  raw.l.forEach(function(l,li){\n    var chip=raw.id==='london'?l[1]:(raw.id==='nyc'?l[0].split('·')[0]:(raw.id==='barcelona'?l[0].replace(/^(L\\d+)([NS])$/,'$1 $2'):l[0]));\n    var L={i:li,id:l[0],name:l[1],color:'#'+l[2],text:'#'+l[3],pats:l[4],chip:chip,adj:{}};\n    L.dark=lum(l[2])<.05?'#dadde3':(lum(l[2])<.1?mixWhite(l[2],.35):'#'+l[2]);\n    L.pats.forEach(function(p){ for(var k=0;k<p.length;k++){ var s=p[k];\n      if(c.st[s].lines.indexOf(li)<0)c.st[s].lines.push(li);\n      if(k){ var a=p[k-1]; (L.adj[a]=L.adj[a]||{})[s]=1; (L.adj[s]=L.adj[s]||{})[a]=1; } } });\n    c.lines.push(L);\n  });\n  // edges shared by several lines, for side-by-side drawing\n  c.edges={};\n  c.lines.forEach(function(L){ Object.keys(L.adj).forEach(function(a){ Object.keys(L.adj[a]).forEach(function(b){\n    a=+a;b=+b; if(a<b){ var k=a+'-'+b; (c.edges[k]=c.edges[k]||[]).push(L.i); } }); }); });\n  // bounds: the whole network, and the busy middle the map opens on\n  var xs=c.st.map(function(s){return s.x}).sort(function(a,b){return a-b}), ys=c.st.map(function(s){return s.y}).sort(function(a,b){return a-b});\n  var q=function(a,f){return a[Math.floor((a.length-1)*f)]};\n  c.all=[xs[0],ys[0],xs[xs.length-1],ys[ys.length-1]];\n  c.core=[q(xs,.2),q(ys,.2),q(xs,.8),q(ys,.8)];\n  // a change of line means a change of colour: New York's 1/2/3 share a trunk\n  c.st.forEach(function(s){ var cols={}; s.lines.forEach(function(li){ cols[c.lines[li].color]=1; }); s.ix=Object.keys(cols).length; });\n  c.maxLines=Math.max.apply(null,c.st.map(function(s){return s.ix}));\n  // where the map opens: the centre of things, about this many metres across\n  var home={london:{x:0,y:40,w:1300},paris:{x:0,y:30,w:720},nyc:{x:40,y:360,w:1300},berlin:{x:-380,y:40,w:1200},madrid:{x:0,y:-150,w:1000},barcelona:{x:0,y:-50,w:900},tokyo:{x:-150,y:-50,w:1400}}[c.id]||{x:0,y:0,w:1200};\n  c.home=[home.x-home.w/2,home.y-home.w/2,home.x+home.w/2,home.y+home.w/2];\n  c.st.forEach(function(s){ s.gx=s.x; s.gy=s.y; });\n  c.geo={all:c.all,home:c.home};\n  if(raw.s)prepSchematic(c,raw);\n  return c;\n}\n/* Schematic view: coordinates computed offline by metro_build.py from the\n   station positions (an octilinear layout search, not a traced diagram). */\nfunction prepSchematic(c,raw){\n  var S0=raw.s, k=100;\n  c.st.forEach(function(s,i){ s.sx=S0.xy[2*i]/k; s.sy=S0.xy[2*i+1]/k; s.inc=[]; });\n  c.sEdges={};\n  S0.e.forEach(function(e){\n    var mid=[]; for(var j=0;j<e[2].length;j+=2)mid.push([e[2][j]/k,e[2][j+1]/k]);\n    var E={a:e[0],b:e[1],mid:mid,lines:e[3]};\n    c.sEdges[e[0]+'-'+e[1]]=E; c.st[e[0]].inc.push(E); c.st[e[1]].inc.push(E);\n  });\n  var pass={};\n  S0.p.forEach(function(q){ pass[q[0]+'-'+q[1]]=q.slice(2); pass[q[1]+'-'+q[0]]=q.slice(2).reverse(); });\n  c.pass=pass;\n  // each line's stops with the stations it runs through without stopping\n  c.lines.forEach(function(L){ L.dpats=L.pats.map(function(p){ return expandStops(c,p); }); });\n  c.sm=raw.sm;\n  // bounds: all, and where the geographic 'home' stations land\n  var xs=c.st.map(function(s){return s.sx}), ys=c.st.map(function(s){return s.sy});\n  var hs=c.st.filter(function(s){ return s.gx>=c.home[0]&&s.gx<=c.home[2]&&s.gy>=c.home[1]&&s.gy<=c.home[3]; });\n  var hx=hs.map(function(s){return s.sx}).sort(function(a,b){return a-b}), hy=hs.map(function(s){return s.sy}).sort(function(a,b){return a-b});\n  var q=function(a,f){return a[Math.floor((a.length-1)*f)]};\n  c.sch={all:[Math.min.apply(null,xs),Math.min.apply(null,ys),Math.max.apply(null,xs),Math.max.apply(null,ys)],\n         home:[q(hx,.08),q(hy,.08),q(hx,.92),q(hy,.92)]};\n}\nfunction expandStops(c,p){\n  var out=[p[0]];\n  for(var i=1;i<p.length;i++){ var mid=c.pass&&c.pass[p[i-1]+'-'+p[i]]; if(mid)out=out.concat(mid); out.push(p[i]); }\n  return out;\n}\nfunction schEdge(c,a,b){ var E=c.sEdges[a+'-'+b]; if(E)return {E:E,rev:false}; E=c.sEdges[b+'-'+a]; return E?{E:E,rev:true}:null; }\nvar CITY_LIST=CITIES.map(prepCity), city=CITY_LIST[0];\nfunction viewMode(){ return city.sEdges?(S.viewMode&&S.viewMode[city.id])||'sch':'geo'; }\nfunction applyMode(){\n  var m=viewMode(), sch=m==='sch';\n  city.st.forEach(function(s){ s.x=sch?s.sx:s.gx; s.y=sch?s.sy:s.gy; });\n  var b=sch?city.sch:city.geo; city.all=b.all; city.home=b.home;\n  document.querySelectorAll('#vseg button').forEach(function(x){ var on=x.dataset.v===m; x.classList.toggle('on',on); x.setAttribute('aria-selected',on); });\n  document.body.classList.toggle('hasv',!!city.sEdges);\n  $('vseg').style.display=city.sEdges?'':'none';\n}\n\n/* ---------- State + storage ---------- */\nvar STORE='metromaps.v1';\nvar S={city:'london',recents:[],favs:[],views:{},mode:'fast',viewMode:{},landmarks:true};\nfunction save(){\n  var d=JSON.stringify({city:S.city,recents:S.recents.slice(0,12),favs:S.favs.slice(0,30),views:S.views,mode:S.mode,viewMode:S.viewMode,landmarks:S.landmarks});\n  try{ if(window.myllmStorage){ myllmStorage.setItem(STORE,d); return; } }catch(e){}\n  try{ localStorage.setItem(STORE,d); }catch(e){}\n}\nfunction load(done){\n  function apply(v){ if(v){ try{ var d=JSON.parse(v);\n    if(d.city&&CITY_LIST.some(function(c){return c.id===d.city}))S.city=d.city;\n    if(Array.isArray(d.recents))S.recents=d.recents; if(Array.isArray(d.favs))S.favs=d.favs;\n    if(d.views&&typeof d.views==='object')S.views=d.views; if(d.viewMode&&typeof d.viewMode==='object')S.viewMode=d.viewMode; if(d.landmarks===false)S.landmarks=false; if(d.mode==='few'||d.mode==='fast')S.mode=d.mode; }catch(e){} }\n    done(); }\n  try{ if(window.myllmStorage){ myllmStorage.getItem(STORE).then(apply,function(){apply(null)}); return; } }catch(e){}\n  var v=null; try{ v=localStorage.getItem(STORE); }catch(e){} apply(v);\n}\n\n/* ---------- Map view ---------- */\nvar cv=$('map'), ctx=cv.getContext('2d'), stage=$('stage');\nvar W=0,H=0,DPR=1, view={s:.1,tx:0,ty:0}, baseS=.1;\nvar route=null, focusSt=null, drawQueued=false;\nfunction toScreen(x,y){ return [x*view.s+view.tx, y*view.s+view.ty]; }\nfunction resize(){\n  var r=stage.getBoundingClientRect(); DPR=Math.min(3,window.devicePixelRatio||1);\n  var nw=Math.max(1,Math.round(r.width)), nh=Math.max(1,Math.round(r.height));\n  if(nw===W&&nh===H&&cv.width===Math.round(nw*DPR))return;\n  var cx=W?(W/2-view.tx)/view.s:null, cy=H?(H/2-view.ty)/view.s:null;\n  W=nw;H=nh; cv.width=Math.round(W*DPR); cv.height=Math.round(H*DPR);\n  if(cx!==null){ view.tx=W/2-cx*view.s; view.ty=H/2-cy*view.s; }\n  draw();\n}\nfunction fitBox(b,pad,anim){\n  var bw=Math.max(60,b[2]-b[0]), bh=Math.max(60,b[3]-b[1]);\n  var top=pad+(route?60:0), bottom=pad+sheetCover();\n  var s=Math.min((W-2*pad)/bw,(H-top-bottom)/bh);\n  var t={s:s,tx:(W-bw*s)/2-b[0]*s,ty:top+((H-top-bottom)-bh*s)/2-b[1]*s};\n  if(anim)animateTo(t); else { view=t; draw(); }\n}\nfunction sheetCover(){ var sh=$('sheet'); if(!sh.classList.contains('open')||isLand())return 0; return Math.min(sh.offsetHeight,H*.74); }\nfunction isLand(){ return matchMedia('(orientation:landscape) and (max-height:560px)').matches; }\nvar anim=null;\nfunction animateTo(t,ms){\n  if(matchMedia('(prefers-reduced-motion: reduce)').matches){ view=t; draw(); return; }\n  var from={s:view.s,tx:view.tx,ty:view.ty}, t0=performance.now(), d=ms||380;\n  cancelAnimationFrame(anim);\n  (function step(now){ var k=Math.min(1,(now-t0)/d), e=1-Math.pow(1-k,3);\n    // interpolate in log-scale so zooms feel even\n    var s=Math.exp(Math.log(from.s)+(Math.log(t.s)-Math.log(from.s))*e);\n    var cxF=(W/2-from.tx)/from.s, cyF=(H/2-from.ty)/from.s, cxT=(W/2-t.tx)/t.s, cyT=(H/2-t.ty)/t.s;\n    var cx=cxF+(cxT-cxF)*e, cy=cyF+(cyT-cyF)*e;\n    view={s:s,tx:W/2-cx*s,ty:H/2-cy*s}; draw(true);\n    if(k<1)anim=requestAnimationFrame(step); else { view=t; draw(); saveView(); }\n  })(t0);\n}\nfunction zoomAt(f,px,py,animate){\n  var s=Math.max(baseS*.35,Math.min(baseS*40,view.s*f)); f=s/view.s;\n  var t={s:s,tx:px-(px-view.tx)*f,ty:py-(py-view.ty)*f};\n  if(animate)animateTo(t,260); else { view=t; draw(true); }\n}\nvar svT;\nfunction saveView(){ clearTimeout(svT); svT=setTimeout(function(){ S.views[city.id+':'+viewMode()]={cx:(W/2-view.tx)/view.s,cy:(H/2-view.ty)/view.s,z:view.s/baseS}; save(); },500); }\n\n/* ---------- Drawing ---------- */\nvar COL={};\nfunction readColors(){ var cs=getComputedStyle(document.documentElement);\n  ['--map','--ink','--muted','--surface','--water','--acc','--bad','--faint'].forEach(function(k){ COL[k]=cs.getPropertyValue(k).trim(); }); }\nfunction lineColor(L){ return DARK.matches?L.dark:L.color; }\nfunction lineW(){ return Math.max(2.2,Math.min(7,2.6*Math.pow(view.s/baseS,.45))); }\nvar labelBox=[];\nfunction draw(fast){\n  if(!W)return;\n  if(viewMode()==='sch')return drawSch();\n  ctx.setTransform(DPR,0,0,DPR,0,0);\n  ctx.fillStyle=COL['--map']; ctx.fillRect(0,0,W,H);\n  var lw=lineW(), gap=lw*1.05, z=view.s/baseS;\n  // rivers\n  ctx.lineJoin='round'; ctx.lineCap='round';\n  ctx.strokeStyle=COL['--water']; ctx.lineWidth=Math.max(5,Math.min(60,22*view.s));\n  city.rivers.forEach(function(r){ ctx.beginPath(); for(var i=0;i<r.length;i++){ var p=toScreen(r[i][0],r[i][1]); if(i)ctx.lineTo(p[0],p[1]); else ctx.moveTo(p[0],p[1]); } ctx.stroke(); });\n  drawLandmarks();\n  // lines\n  var onRoute=route?route.lineSet:null;\n  city.lines.forEach(function(L){\n    ctx.globalAlpha=onRoute?.18:1;\n    ctx.strokeStyle=lineColor(L); ctx.lineWidth=lw;\n    L.pats.forEach(function(p){ strokePattern(L,p,gap); });\n  });\n  ctx.globalAlpha=1;\n  // route on top, thicker\n  if(route){\n    route.legs.forEach(function(g){\n      var L=city.lines[g.line];\n      ctx.strokeStyle=DARK.matches?'rgba(0,0,0,.55)':'rgba(255,255,255,.9)'; ctx.lineWidth=lw*2.6+3; strokePattern(L,g.stops,0,true);\n      ctx.strokeStyle=lineColor(L); ctx.lineWidth=lw*2.2; strokePattern(L,g.stops,0,true);\n    });\n  }\n  // stations\n  var r0=Math.max(2,lw*.62);\n  var vis=[];\n  city.st.forEach(function(s){\n    var p=toScreen(s.x,s.y); if(p[0]<-40||p[1]<-40||p[0]>W+40||p[1]>H+40)return;\n    var ix=s.ix>1, onR=route&&route.stSet[s.i];\n    if(route&&!onR&&!ix&&z<2.5)return;\n    vis.push([s,p,ix,onR]);\n  });\n  vis.forEach(function(v){\n    var s=v[0],p=v[1],ix=v[2],onR=v[3];\n    ctx.globalAlpha=route&&!onR?.35:1;\n    if(ix){ var r=r0*1.55+(s.ix>3?1:0);\n      ctx.beginPath(); ctx.arc(p[0],p[1],r,0,7); ctx.fillStyle=COL['--surface']; ctx.fill(); ctx.lineWidth=Math.max(1.6,lw*.5); ctx.strokeStyle=COL['--ink']; ctx.stroke();\n    } else if(z>.95||onR){\n      ctx.beginPath(); ctx.arc(p[0],p[1],r0*(z>1.6?.95:.7),0,7); ctx.fillStyle=COL['--surface']; ctx.fill();\n      ctx.lineWidth=Math.max(1.2,lw*.42); ctx.strokeStyle=lineColor(city.lines[s.lines[0]]); ctx.stroke();\n    }\n  });\n  ctx.globalAlpha=1;\n  // route ends\n  if(route){ pin(route.from,COL['--acc'],false); pin(route.to,COL['--bad'],true); }\n  if(focusSt!==null){ var fs=city.st[focusSt], fp=toScreen(fs.x,fs.y); ctx.beginPath(); ctx.arc(fp[0],fp[1],r0*3.2,0,7); ctx.lineWidth=3; ctx.strokeStyle=COL['--acc']; ctx.stroke(); }\n  drawLabels(vis,r0,z);\n}\n/* ---------- Schematic drawing ----------\n   Lines on shared track sit side by side in a fixed order (the build orders\n   each corridor so a line keeps its side from one corridor to the next);\n   corners are rounded with one radius; stations are ticks, interchanges\n   white pills across the lines that stop there. */\nfunction schDims(){ var u=view.s; var lw=Math.max(2.2,Math.min(9,u*.2)); return {u:u,lw:lw,gap:lw*1.22,R:Math.max(5,u*.7)}; }\nfunction edgeScreen(E){\n  var A=city.st[E.a],B=city.st[E.b], pts=[[A.sx,A.sy]].concat(E.mid,[[B.sx,B.sy]]);\n  return pts.map(function(p){ return toScreen(p[0],p[1]); });\n}\n/* A polyline moved sideways by `off` px (right-hand side of its direction),\n   mitred at the bends. */\nfunction offsetPts(sp,off){\n  if(!off)return sp.map(function(p){return [p[0],p[1]];});\n  var out=[], n=sp.length;\n  function nrm(a,b){ var dx=b[0]-a[0],dy=b[1]-a[1],l=Math.hypot(dx,dy)||1; return [-dy/l,dx/l]; }\n  for(var i=0;i<n;i++){\n    var n1=i>0?nrm(sp[i-1],sp[i]):null, n2=i<n-1?nrm(sp[i],sp[i+1]):null, v;\n    if(n1&&n2){ var mx=n1[0]+n2[0], my=n1[1]+n2[1], ml=Math.hypot(mx,my)||1; mx/=ml; my/=ml; var cs=mx*n1[0]+my*n1[1]; v=[mx/Math.max(.5,cs),my/Math.max(.5,cs)]; }\n    else v=n1||n2;\n    out.push([sp[i][0]+v[0]*off,sp[i][1]+v[1]*off]);\n  }\n  return out;\n}\nfunction slotOf(E,li){ return E.lines.indexOf(li)-(E.lines.length-1)/2; }\n/* The screen polyline of line li through stop list p. */\nfunction linePath(li,p,gap){\n  var pts=[];\n  for(var i=1;i<p.length;i++){\n    var r=schEdge(city,p[i-1],p[i]); if(!r)continue;\n    var q=offsetPts(edgeScreen(r.E),slotOf(r.E,li)*gap); if(r.rev)q.reverse();\n    if(pts.length){ var l=pts[pts.length-1]; if(Math.abs(l[0]-q[0][0])<.6&&Math.abs(l[1]-q[0][1])<.6)q.shift(); }\n    pts=pts.concat(q);\n  }\n  return pts;\n}\nfunction strokeRounded(pts,R){\n  if(pts.length<2)return;\n  ctx.beginPath(); ctx.moveTo(pts[0][0],pts[0][1]);\n  for(var i=1;i<pts.length-1;i++){\n    var a=pts[i-1],b=pts[i],c=pts[i+1];\n    var l1=Math.hypot(b[0]-a[0],b[1]-a[1]), l2=Math.hypot(c[0]-b[0],c[1]-b[1]);\n    // a hairpin (or a zero-length step) would send arcTo's tangent point\n    // off to infinity: just meet at the corner\n    var dot=l1&&l2?((b[0]-a[0])*(c[0]-b[0])+(b[1]-a[1])*(c[1]-b[1]))/(l1*l2):1;\n    if(!l1||!l2||dot<-.72){ ctx.lineTo(b[0],b[1]); continue; }\n    ctx.arcTo(b[0],b[1],c[0],c[1],Math.min(R,l1/2,l2/2));\n  }\n  ctx.lineTo(pts[pts.length-1][0],pts[pts.length-1][1]); ctx.stroke();\n}\nvar lastSch=null;\nfunction drawSch(){\n  ctx.setTransform(DPR,0,0,DPR,0,0);\n  ctx.fillStyle=COL['--map']; ctx.fillRect(0,0,W,H);\n  var D=schDims(), z=view.s/baseS;\n  drawLandmarks();\n  ctx.lineJoin='round'; ctx.lineCap='round';\n  var onRoute=route?route.lineSet:null;\n  city.lines.forEach(function(L){\n    ctx.globalAlpha=onRoute?.16:1;\n    ctx.strokeStyle=lineColor(L); ctx.lineWidth=D.lw;\n    L.dpats.forEach(function(p){ strokeRounded(linePath(L.i,p,D.gap),D.R); });\n  });\n  ctx.globalAlpha=1;\n  var drawn=[];\n  if(route){\n    route.legs.forEach(function(g){\n      var L=city.lines[g.line], p=expandStops(city,g.stops), pts=linePath(g.line,p,D.gap);\n      ctx.strokeStyle=DARK.matches?'rgba(0,0,0,.6)':'rgba(255,255,255,.95)'; ctx.lineWidth=D.lw*2.3+3; strokeRounded(pts,D.R);\n      ctx.strokeStyle=lineColor(L); ctx.lineWidth=D.lw*1.9; strokeRounded(pts,D.R);\n      drawn.push(pts.length);\n    });\n  }\n  // stations\n  var vis=[];\n  city.st.forEach(function(s){\n    var p=toScreen(s.sx,s.sy); if(p[0]<-60||p[1]<-60||p[0]>W+60||p[1]>H+60)return;\n    var onR=route&&route.stSet[s.i];\n    var E=s.inc[0]; if(!E)return;\n    var sp=edgeScreen(E), at=(E.a===s.i)?0:sp.length-1, nb=(at===0)?sp[1]:sp[sp.length-2];\n    var dx=nb[0]-sp[at][0], dy=nb[1]-sp[at][1], l=Math.hypot(dx,dy)||1;\n    if(at!==0){ dx=-dx; dy=-dy; }            // along E's direction\n    var nx=-dy/l, ny=dx/l;\n    var offs=s.lines.map(function(li){ var k=E.lines.indexOf(li); return k<0?0:(k-(E.lines.length-1)/2)*D.gap; });\n    var all=E.lines.map(function(li,k){return (k-(E.lines.length-1)/2)*D.gap;});\n    var hw=Math.max(Math.abs(Math.min.apply(null,all)),Math.abs(Math.max.apply(null,all)))+D.lw;\n    var junction=s.inc.length>2||(s.inc.length===2&&!collinear(s,s.inc[0],s.inc[1]));\n    ctx.globalAlpha=route&&!onR?.3:1;\n    // lines that simply share a corridor through a station (Circle and\n    // Hammersmith & City, New York's locals) get one tick, not a pill:\n    // a pill means you can change to something going elsewhere\n    var through=!junction&&s.inc.length===2&&s.inc[0].lines.join()===s.inc[1].lines.join()&&s.lines.length===E.lines.length;\n    if(s.lines.length>1&&through){\n      var mx2=Math.max.apply(null,all), t2a=mx2+D.lw*.45, t2b=mx2+D.lw*1.5;\n      if(z>.75||onR){\n        ctx.strokeStyle=lineColor(city.lines[E.lines[E.lines.length-1]]); ctx.lineWidth=Math.max(1.4,D.lw*.8); ctx.lineCap='butt';\n        ctx.beginPath(); ctx.moveTo(p[0]+nx*t2a,p[1]+ny*t2a); ctx.lineTo(p[0]+nx*t2b,p[1]+ny*t2b); ctx.stroke(); ctx.lineCap='round';\n      }\n    } else if(s.lines.length>1){\n      var lo=Math.min.apply(null,offs), hi=Math.max.apply(null,offs);\n      if(junction){ lo=Math.min(lo,Math.min.apply(null,all)); hi=Math.max(hi,Math.max.apply(null,all)); }\n      var ax=p[0]+nx*lo, ay=p[1]+ny*lo, bx=p[0]+nx*hi, by=p[1]+ny*hi;\n      var outline=s.ix>1?COL['--ink']:lineColor(city.lines[s.lines[0]]);\n      ctx.lineCap='round';\n      ctx.strokeStyle=outline; ctx.lineWidth=D.lw*1.55+2.6;\n      ctx.beginPath(); ctx.moveTo(ax,ay); ctx.lineTo(bx+.01,by); ctx.stroke();\n      ctx.strokeStyle=COL['--surface']; ctx.lineWidth=D.lw*1.55;\n      ctx.beginPath(); ctx.moveTo(ax,ay); ctx.lineTo(bx+.01,by); ctx.stroke();\n    } else if(z>.75||onR){\n      var o=offs[0], mx=Math.max.apply(null,all), mn=Math.min.apply(null,all);\n      var sg=(o>=mx-1e-6)?1:((o<=mn+1e-6)?-1:1), t0=o+sg*D.lw*.45, t1=o+sg*(D.lw*.45+D.lw*1.05);\n      var term=s.inc.length===1;\n      if(term){ t0=o-D.lw*1.2; t1=o+D.lw*1.2; }\n      ctx.strokeStyle=lineColor(city.lines[s.lines[0]]); ctx.lineWidth=Math.max(1.4,D.lw*.8); ctx.lineCap='butt';\n      ctx.beginPath(); ctx.moveTo(p[0]+nx*t0,p[1]+ny*t0); ctx.lineTo(p[0]+nx*t1,p[1]+ny*t1); ctx.stroke();\n      ctx.lineCap='round';\n    }\n    vis.push([s,[p[0]+nx*(offs.reduce(function(a,b){return a+b},0)/offs.length),p[1]+ny*(offs.reduce(function(a,b){return a+b},0)/offs.length)],s.ix>1,onR,false,hw]);\n  });\n  ctx.globalAlpha=1;\n  if(route){ pin(route.from,COL['--acc'],false); pin(route.to,COL['--bad'],true); }\n  if(focusSt!==null){ var fs=city.st[focusSt], fp=toScreen(fs.sx,fs.sy); ctx.beginPath(); ctx.arc(fp[0],fp[1],D.lw*3.2+4,0,7); ctx.lineWidth=3; ctx.strokeStyle=COL['--acc']; ctx.stroke(); }\n  drawLabels(vis,D.lw*.6,z);\n  lastSch={routeLegs:drawn.length,routePts:drawn,stations:vis.length};\n}\nfunction collinear(s,E1,E2){\n  function dirAt(E){ var pts=[[city.st[E.a].sx,city.st[E.a].sy]].concat(E.mid,[[city.st[E.b].sx,city.st[E.b].sy]]);\n    var i=E.a===s.i?0:pts.length-1, j=E.a===s.i?1:pts.length-2; return Math.atan2(pts[j][1]-pts[i][1],pts[j][0]-pts[i][0]); }\n  var d=Math.abs(dirAt(E1)-dirAt(E2))%(2*Math.PI); return Math.abs(d-Math.PI)<.05;\n}\nfunction pin(si,col,square){\n  var s=city.st[si], p=toScreen(s.x,s.y), r=9;\n  ctx.beginPath(); if(square){ roundRect(p[0]-r,p[1]-r,2*r,2*r,4); } else ctx.arc(p[0],p[1],r,0,7);\n  ctx.fillStyle=COL['--surface']; ctx.fill(); ctx.lineWidth=4; ctx.strokeStyle=col; ctx.stroke();\n}\nfunction roundRect(x,y,w,h,r){ ctx.moveTo(x+r,y); ctx.arcTo(x+w,y,x+w,y+h,r); ctx.arcTo(x+w,y+h,x,y+h,r); ctx.arcTo(x,y+h,x,y,r); ctx.arcTo(x,y,x+w,y,r); ctx.closePath(); }\n/* One stop pattern of a line: offset sideways where lines share track, then\n   rounded at the corners. */\nfunction strokePattern(L,p,gap,solo){\n  if(p.length<2)return;\n  var pts=[],i;\n  for(i=0;i<p.length;i++){\n    var s=city.st[p[i]], q=toScreen(s.x,s.y), ox=0, oy=0, n=0;\n    if(!solo){\n      for(var e=-1;e<=0;e++){ var a=p[i+e], b=p[i+e+1]; if(a===undefined||b===undefined)continue;\n        var k=a<b?a+'-'+b:b+'-'+a, list=city.edges[k]; if(!list||list.length<2)continue;\n        var sa=city.st[a], sb=city.st[b], dx=sb.x-sa.x, dy=sb.y-sa.y, len=Math.hypot(dx,dy)||1;\n        if(a>b){ dx=-dx; dy=-dy; } // normal of the edge in its canonical direction, so every line agrees\n        var off=(list.indexOf(L.i)-(list.length-1)/2)*gap;\n        ox+=-dy/len*off; oy+=dx/len*off; n++; }\n      if(n){ ox/=n; oy/=n; }\n    }\n    pts.push([q[0]+ox,q[1]+oy]);\n  }\n  ctx.beginPath(); ctx.moveTo(pts[0][0],pts[0][1]);\n  var R=Math.max(6,lineW()*4);\n  for(i=1;i<pts.length-1;i++){\n    var a1=pts[i-1],b1=pts[i],c1=pts[i+1];\n    var r=Math.min(R,Math.hypot(b1[0]-a1[0],b1[1]-a1[1])/2,Math.hypot(c1[0]-b1[0],c1[1]-b1[1])/2);\n    ctx.arcTo(b1[0],b1[1],c1[0],c1[1],r);\n  }\n  ctx.lineTo(pts[pts.length-1][0],pts[pts.length-1][1]); ctx.stroke();\n}\n/* Greedy labels: busiest stations first, each tries four spots and keeps the\n   first that overlaps nothing already placed. */\nfunction drawLabels(vis,r0,z){\n  var fs=z<1.4?11:(z<3?12:13);\n  ctx.font='600 '+fs+'px '+getComputedStyle(document.body).fontFamily;\n  ctx.textBaseline='middle';\n  var placed=[], minLines=z<.9?Math.max(3,Math.ceil(city.maxLines*.6)):(z<1.5?3:(z<2.4?2:1));\n  var cand=vis.filter(function(v){ return v[3]||v[0].ix>=minLines||v[0].i===focusSt; });\n  cand.sort(function(a,b){ return (b[3]?9:0)+b[0].ix-((a[3]?9:0)+a[0].ix)||b[0].lines.length-a[0].lines.length; });\n  if(route){ [route.from,route.to].forEach(function(si){ var s=city.st[si]; cand.unshift([s,toScreen(s.x,s.y),true,true,true]); }); }\n  var count=0, seen={};\n  for(var i=0;i<cand.length&&count<260;i++){\n    var s=cand[i][0], p=cand[i][1]; if(seen[s.i])continue;\n    var w=ctx.measureText(s.name).width, h=fs*1.35, d=Math.max(r0*2+4,(cand[i][5]||0)+5);\n    var spots=[[p[0]+d,p[1]-h/2],[p[0]-d-w,p[1]-h/2],[p[0]-w/2,p[1]-d-h],[p[0]-w/2,p[1]+d]];\n    for(var k=0;k<4;k++){\n      var x=spots[k][0], y=spots[k][1];\n      if(x<2||y<2||x+w>W-2||y+h>H-2)continue;\n      var hit=false;\n      for(var j=0;j<placed.length;j++){ var b=placed[j]; if(x<b[2]&&x+w>b[0]&&y<b[3]&&y+h>b[1]){hit=true;break;} }\n      if(hit)continue;\n      placed.push([x-3,y-1,x+w+3,y+h+1]); seen[s.i]=1; count++;\n      ctx.lineWidth=3.5; ctx.strokeStyle=COL['--map']; ctx.lineJoin='round'; ctx.strokeText(s.name,x,y+h/2);\n      ctx.fillStyle=cand[i][4]||s.i===focusSt?COL['--ink']:(cand[i][2]?COL['--ink']:COL['--muted']); ctx.fillText(s.name,x,y+h/2);\n      break;\n    }\n  }\n}\nfunction queueDraw(){ if(drawQueued)return; drawQueued=true; requestAnimationFrame(function(){ drawQueued=false; draw(true); }); }\n\n/* ---------- Ghost landmarks ----------\n   Faint line sketches of each city's famous sites, drawn under the lines\n   like a watermark. Hosted, not embedded; if they don't load (offline)\n   they are simply not drawn. */\nvar LM_BASE='https://raw.githubusercontent.com/TeamDzX/myllm-assets/main/apps/metro/landmarks/';\nvar PROJ={london:[51.5074,-0.1278],paris:[48.8566,2.3522],nyc:[40.7580,-73.9855],berlin:[52.5200,13.4050],madrid:[40.4168,-3.7038],barcelona:[41.3874,2.1686],tokyo:[35.6812,139.7671]};\nvar LANDMARKS={\n  london:[['lon-elizabeth-tower','Elizabeth Tower (Big Ben)',51.5007,-0.1246,'Westminster'],['lon-london-eye','London Eye',51.5033,-0.1196,'Waterloo'],\n    ['lon-tower-bridge','Tower Bridge',51.5055,-0.0754,'Tower Hill'],['lon-st-pauls',\"St Paul's Cathedral\",51.5138,-0.0984,\"St. Paul's\"],\n    ['lon-shard','The Shard',51.5045,-0.0865,'London Bridge'],['lon-buckingham','Buckingham Palace',51.5014,-0.1419,'Green Park']],\n  paris:[['par-eiffel','Eiffel Tower',48.8584,2.2945,'Bir-Hakeim'],['par-arc','Arc de Triomphe',48.8738,2.2950,'Charles de Gaulle'],\n    ['par-notre-dame','Notre-Dame',48.8530,2.3499,'Cité'],['par-sacre-coeur','Sacré-Cœur',48.8867,2.3431,'Anvers'],\n    ['par-louvre','The Louvre',48.8611,2.3358,'Palais Royal'],['par-pantheon','Panthéon',48.8462,2.3464,'Cardinal Lemoine']],\n  berlin:[['ber-brandenburg','Brandenburg Gate',52.5163,13.3777,'Brandenburger Tor'],['ber-tv-tower','TV Tower',52.5208,13.4094,'Alexanderplatz'],\n    ['ber-reichstag','Reichstag',52.5186,13.3762,'Bundestag'],['ber-cathedral','Berlin Cathedral',52.5191,13.4010,'Museumsinsel'],\n    ['ber-oberbaum','Oberbaum Bridge',52.5019,13.4459,'Schlesisches Tor'],['ber-victory-column','Victory Column',52.5145,13.3501,'Hansaplatz']],\n  madrid:[['mad-royal-palace','Royal Palace',40.4180,-3.7143,'Ópera'],['mad-alcala','Puerta de Alcalá',40.4200,-3.6887,'Retiro'],\n    ['mad-cibeles','Cibeles Fountain',40.4193,-3.6931,'Banco de España'],['mad-metropolis','Metropolis Building',40.4186,-3.6972,'Sevilla'],\n    ['mad-kio','Puerta de Europa',40.4666,-3.6892,'Plaza de Castilla'],['mad-bernabeu','Santiago Bernabéu',40.4531,-3.6883,'Santiago Bernabéu']],\n  barcelona:[['bcn-sagrada','Sagrada Família',41.4036,2.1744,'Sagrada Família'],['bcn-casa-batllo','Casa Batlló',41.3917,2.1649,'Passeig de Gràcia'],\n    ['bcn-pedrera','La Pedrera',41.3954,2.1619,'Diagonal'],['bcn-arc','Arc de Triomf',41.3910,2.1806,'Arc de Triomf'],\n    ['bcn-agbar','Torre Glòries',41.4034,2.1896,'Glòries'],['bcn-columbus','Columbus Monument',41.3758,2.1778,'Drassanes']],\n  tokyo:[['tyo-skytree','Tokyo Skytree',35.7101,139.8107,'Oshiage'],['tyo-tower','Tokyo Tower',35.6586,139.7454,'Akabanebashi'],\n    ['tyo-sensoji','Sensō-ji',35.7148,139.7967,'Asakusa'],['tyo-shibuya','Shibuya Crossing',35.6595,139.7005,'Shibuya'],\n    ['tyo-imperial','Imperial Palace',35.6803,139.7536,'Nijubashimae'],['tyo-meiji','Meiji Shrine',35.6764,139.6993,'Meiji-jingumae']],\n  nyc:[['nyc-liberty','Statue of Liberty',40.6892,-74.0445,'South Ferry'],['nyc-empire','Empire State Building',40.7484,-73.9857,'34 St-Herald'],\n    ['nyc-chrysler','Chrysler Building',40.7516,-73.9755,'Grand Central'],['nyc-flatiron','Flatiron Building',40.7411,-73.9897,'23 St'],\n    ['nyc-one-wtc','One World Trade Center',40.7127,-74.0134,'World Trade Center'],['nyc-brooklyn-bridge','Brooklyn Bridge',40.7061,-73.9969,'Brooklyn Bridge']]\n};\nvar lmImgs={}, lmTint={}, lmHits=[];\nfunction lmFor(c){\n  if(c.lm)return c.lm;\n  var p0=PROJ[c.id], k=Math.cos(p0[0]*Math.PI/180);\n  c.lm=(LANDMARKS[c.id]||[]).map(function(d){\n    var gx=(d[3]-p0[1])*k*11132, gy=(p0[0]-d[2])*11057.4, q=fold(d[4]);\n    // the named station; several share a name in New York, so the nearest\n    var cand=c.st.filter(function(s){return s.key.indexOf(q)>=0;});\n    var st=cand.sort(function(a,b){return Math.hypot(a.gx-gx,a.gy-gy)-Math.hypot(b.gx-gx,b.gy-gy);})[0]||null;\n    return {id:d[0],name:d[1],gx:gx,gy:gy,st:st?st.i:null};\n  });\n  if(c.sEdges)placeSchematic(c);\n  return c.lm;\n}\n/* Schematic: beside its station, towards the emptiest of eight directions. */\nfunction placeSchematic(c){\n  var pts=[];\n  c.st.forEach(function(s){ pts.push([s.sx,s.sy,2]); });\n  Object.values(c.sEdges).forEach(function(E){\n    var a=c.st[E.a],b=c.st[E.b], q=[[a.sx,a.sy]].concat(E.mid,[[b.sx,b.sy]]);\n    for(var i=1;i<q.length;i++){ var L=Math.hypot(q[i][0]-q[i-1][0],q[i][1]-q[i-1][1]), n=Math.ceil(L/.5);\n      for(var j=1;j<n;j++)pts.push([q[i-1][0]+(q[i][0]-q[i-1][0])*j/n,q[i-1][1]+(q[i][1]-q[i-1][1])*j/n,1]); }\n  });\n  var used=[];\n  c.lm.forEach(function(m){\n    if(m.st===null)return;\n    var s=c.st[m.st], best=null;\n    for(var d=0;d<8;d++){\n      var a=d*Math.PI/4, cx=s.sx+Math.cos(a)*3.2, cy=s.sy+Math.sin(a)*3.2, cost=0;\n      pts.forEach(function(p){ var r=Math.hypot(p[0]-cx,p[1]-cy); if(r<2.6)cost+=p[2]*(2.6-r); });\n      used.forEach(function(u){ var r=Math.hypot(u[0]-cx,u[1]-cy); if(r<5)cost+=40*(5-r); });\n      // prefer the side the landmark is really on\n      var ga=Math.atan2(m.gy-s.gy,m.gx-s.gx), da=Math.abs(((a-ga+3*Math.PI)%(2*Math.PI))-Math.PI);\n      cost+=da*1.2;\n      if(!best||cost<best[0])best=[cost,cx,cy];\n    }\n    m.sx=best[1]; m.sy=best[2]; used.push([m.sx,m.sy]);\n  });\n}\nfunction lmImage(id){\n  var r=lmImgs[id];\n  if(r)return r.ok?r.img:null;\n  r=lmImgs[id]={ok:false,img:new Image()};\n  r.img.onload=function(){ r.ok=true; queueDraw(); };\n  r.img.onerror=function(){ r.failed=true; };\n  r.img.src=LM_BASE+id+'.png';\n  return null;\n}\nfunction lmTinted(id,img){\n  var col=DARK.matches?'#e8ecf4':'#1b2130', k=id+col;\n  if(lmTint[k])return lmTint[k];\n  var cv2=document.createElement('canvas'); cv2.width=img.naturalWidth; cv2.height=img.naturalHeight;\n  var g=cv2.getContext('2d'); g.drawImage(img,0,0); g.globalCompositeOperation='source-in'; g.fillStyle=col; g.fillRect(0,0,cv2.width,cv2.height);\n  return (lmTint[k]=cv2);\n}\n/* Fully there at the overview and the central fit, gone past ~2.5× it. */\nfunction lmAlpha(){ var z=view.s/baseS; return (DARK.matches?.2:.16)*Math.max(0,Math.min(1,(2.5-z)/1.1)); }\nvar lmLast={drawn:0,alpha:0};\nfunction drawLandmarks(){\n  lmHits=[]; lmLast={drawn:0,alpha:0};\n  if(!S.landmarks)return;\n  var a=lmAlpha(); lmLast.alpha=a; if(a<=.005)return;\n  var sch=viewMode()==='sch';\n  lmFor(city).forEach(function(m){\n    var img=lmImage(m.id); if(!img)return;\n    var x=sch?m.sx:m.gx, y=sch?m.sy:m.gy; if(x===undefined)return;\n    var p=toScreen(x,y);\n    var h=Math.max(46,Math.min(120,(sch?5.2:75)*view.s)), w=h*img.naturalWidth/img.naturalHeight;\n    if(p[0]+w<0||p[0]-w>W||p[1]+h<0||p[1]-h>H)return;\n    ctx.globalAlpha=a; ctx.drawImage(lmTinted(m.id,img),p[0]-w/2,p[1]-h/2,w,h); ctx.globalAlpha=1;\n    lmHits.push({m:m,x0:p[0]-w/2,y0:p[1]-h/2,x1:p[0]+w/2,y1:p[1]+h/2});\n    lmLast.drawn++;\n  });\n}\nfunction openLandmark(m){\n  var st=m.st!==null?city.st[m.st]:null;\n  openSheet(m.name,'<p class=\"note\" style=\"margin-top:2px\">'+(st?'Nearest station: <b style=\"color:var(--ink)\">'+esc(st.name)+'</b>':'')+'</p>'+\n    (st?'<div class=\"chips\" style=\"margin:10px 0 2px\">'+st.lines.map(function(li){return chip(city.lines[li])}).join('')+'</div><div class=\"acts2\"><button class=\"btn pri\" id=\"lmRoute\">Route to here</button><button class=\"btn\" id=\"lmSt\">Station</button></div>':''));\n  if(st){\n    $('lmRoute').onclick=function(){ haptic('light'); R.cityId=city.id; R.to=st.i; if(R.from===st.i)R.from=null; openTab('route'); };\n    $('lmSt').onclick=function(){ haptic('light'); openStation(st.i); };\n  }\n}\n$('lmBtn').onclick=function(){ S.landmarks=!S.landmarks; save(); haptic('light'); syncLmBtn(); draw(); };\nfunction syncLmBtn(){ $('lmBtn').setAttribute('aria-pressed',S.landmarks?'true':'false'); $('lmBtn').setAttribute('aria-label',S.landmarks?'Hide landmarks':'Show landmarks'); }\n\n/* ---------- Gestures ---------- */\nvar ptrs={}, gest=null, lastTap=0, vel=null;\ncv.addEventListener('pointerdown',function(e){\n  $('legend').style.opacity='0';\n  cv.setPointerCapture(e.pointerId); cancelAnimationFrame(anim); vel=null;\n  ptrs[e.pointerId]={x:e.offsetX,y:e.offsetY,t:performance.now(),x0:e.offsetX,y0:e.offsetY};\n  var ids=Object.keys(ptrs);\n  if(ids.length===1)gest={type:'pan',moved:false,t0:performance.now()};\n  else if(ids.length===2){ var a=ptrs[ids[0]],b=ptrs[ids[1]]; gest={type:'pinch',d:Math.hypot(a.x-b.x,a.y-b.y),moved:true}; }\n});\ncv.addEventListener('pointermove',function(e){\n  var p=ptrs[e.pointerId]; if(!p||!gest)return;\n  var dx=e.offsetX-p.x, dy=e.offsetY-p.y, now=performance.now();\n  if(gest.type==='pan'){\n    if(Math.hypot(e.offsetX-p.x0,e.offsetY-p.y0)>6)gest.moved=true;\n    if(gest.moved){ view.tx+=dx; view.ty+=dy; var dt=Math.max(1,now-p.t); vel={x:dx/dt,y:dy/dt,t:now}; queueDraw(); }\n  } else if(gest.type==='pinch'){\n    var ids=Object.keys(ptrs); p.x=e.offsetX; p.y=e.offsetY;\n    var a=ptrs[ids[0]],b=ptrs[ids[1]], d=Math.hypot(a.x-b.x,a.y-b.y);\n    var mx=(a.x+b.x)/2, my=(a.y+b.y)/2;\n    if(gest.mx!==undefined){ view.tx+=mx-gest.mx; view.ty+=my-gest.my; }\n    if(gest.d>0)zoomAt(d/gest.d,mx,my,false);\n    gest.d=d; gest.mx=mx; gest.my=my; return;\n  }\n  p.x=e.offsetX; p.y=e.offsetY; p.t=now;\n});\nfunction endPtr(e){\n  var p=ptrs[e.pointerId]; delete ptrs[e.pointerId];\n  if(!gest)return;\n  if(gest.type==='pan'&&!gest.moved&&p&&performance.now()-gest.t0<450){\n    var now=performance.now();\n    if(now-lastTap<300){ lastTap=0; zoomAt(2,e.offsetX,e.offsetY,true); haptic('light'); }\n    else { lastTap=now; tapAt(e.offsetX,e.offsetY); }\n  } else if(gest.type==='pan'&&vel&&performance.now()-vel.t<60&&!matchMedia('(prefers-reduced-motion: reduce)').matches){\n    var vx=vel.x*16, vy=vel.y*16;\n    (function glide(){ vx*=.92; vy*=.92; view.tx+=vx; view.ty+=vy; draw(true); if(Math.abs(vx)+Math.abs(vy)>.4)anim=requestAnimationFrame(glide); else { draw(); saveView(); } })();\n  }\n  if(Object.keys(ptrs).length===0){ if(gest.type!=='pan'||gest.moved){ draw(); saveView(); } gest=null; }\n  else if(gest.type==='pinch'){ var k=Object.keys(ptrs)[0]; ptrs[k].x0=ptrs[k].x; ptrs[k].y0=ptrs[k].y; gest={type:'pan',moved:true,t0:0}; }\n}\ncv.addEventListener('pointerup',endPtr); cv.addEventListener('pointercancel',endPtr);\ncv.addEventListener('wheel',function(e){ e.preventDefault(); zoomAt(Math.exp(-e.deltaY*.0022),e.offsetX,e.offsetY,false); saveView(); },{passive:false});\ndocument.addEventListener('gesturestart',function(e){ e.preventDefault(); });\nfunction nearest(px,py,maxD){\n  var best=null,bd=maxD*maxD;\n  city.st.forEach(function(s){ var p=toScreen(s.x,s.y), d=(p[0]-px)*(p[0]-px)+(p[1]-py)*(p[1]-py); if(d<bd){bd=d;best=s.i;} });\n  return best;\n}\nfunction tapAt(px,py){\n  var si=nearest(px,py,24);\n  if(si!==null){ haptic('light'); openStation(si); return; }\n  if(lmLast.alpha>=.06){ var h=lmHits.filter(function(r){return px>=r.x0&&px<=r.x1&&py>=r.y0&&py<=r.y1;})[0];\n    if(h){ haptic('light'); openLandmark(h.m); return; } }\n  if(focusSt!==null){ focusSt=null; draw(); }\n}\n$('zin').onclick=function(){ zoomAt(1.8,W/2,H/2,true); haptic('light'); };\n$('zout').onclick=function(){ zoomAt(1/1.8,W/2,H/2,true); haptic('light'); };\n/* Fit: the central area first (readable at once); tap again for the whole network. */\nvar fitStep=0;\n$('zfit').onclick=function(){\n  haptic('light');\n  if(route){ fitBox(route.box,24,true); return; }\n  fitStep=(fitStep+1)%2;\n  fitBox(fitStep?city.home:city.all,24,true);\n};\n\n/* ---------- City switch ---------- */\nfunction renderCities(){\n  $('cities').innerHTML=CITY_LIST.map(function(c){ return '<button role=\"tab\" data-c=\"'+c.id+'\" class=\"'+(c.id===city.id?'on':'')+'\" aria-selected=\"'+(c.id===city.id)+'\">'+esc(c.name)+'</button>'; }).join('');\n  var on=$('cities').querySelector('.on'), row=$('cities');\n  if(on){ var l=on.offsetLeft-14, r=on.offsetLeft+on.offsetWidth+14; if(l<row.scrollLeft||r>row.scrollLeft+row.clientWidth)row.scrollLeft=Math.max(0,l-(row.clientWidth-on.offsetWidth)/2); }\n  $('citySub').textContent=city.name+' · '+city.st.length+' stations · '+city.lines.length+' lines';\n}\n$('cities').addEventListener('click',function(e){ var b=e.target.closest('button'); if(!b||b.dataset.c===city.id)return; haptic('light'); setCity(b.dataset.c); });\nfunction setCity(id,keepSheet){\n  city=CITY_LIST.find(function(c){return c.id===id})||CITY_LIST[0]; S.city=city.id; save();\n  route=null; focusSt=null; fitStep=0; showRouteCard(); renderCities(); applyMode(); setLegend();\n  homeView();\n  if(!keepSheet&&curTab!=='map')openTab(curTab);\n}\nfunction homeView(){\n  // base scale: the busy middle fills the screen\n  var b=city.home, bw=b[2]-b[0], bh=b[3]-b[1];\n  baseS=Math.min((W-24)/bw,(H-24)/Math.max(1,bh)*1.4);\n  if(viewMode()==='geo')baseS=(W-24)/bw;\n  var v=S.views[city.id+':'+viewMode()];\n  if(v&&v.z){ view.s=baseS*v.z; view.tx=W/2-v.cx*view.s; view.ty=H/2-v.cy*view.s; draw(); }\n  else { view.s=baseS; view.tx=W/2-(b[0]+b[2])/2*baseS; view.ty=H/2-(b[1]+b[3])/2*baseS; draw(); }\n}\n$('vseg').addEventListener('click',function(e){\n  var b=e.target.closest('button'); if(!b||b.dataset.v===viewMode())return;\n  haptic('light');\n  // keep the same station in the middle of the screen\n  var mid=nearest(W/2,H/2,1e5);\n  S.viewMode[city.id]=b.dataset.v; save(); applyMode(); setLegend();\n  if(route)route.box=routeBox(route);\n  var v=S.views[city.id+':'+viewMode()];\n  homeView();\n  if(mid!==null&&!v){ var s=city.st[mid]; view.tx=W/2-s.x*view.s; view.ty=H/2-s.y*view.s; draw(); }\n  if(route)fitBox(route.box,28,false);\n  if(focusSt!==null){ var f=city.st[focusSt]; view.tx=W/2-f.x*view.s; view.ty=(H-sheetCover())/2-f.y*view.s; draw(); }\n});\nfunction routeBox(r){\n  var xs=[],ys=[]; Object.keys(r.stSet).forEach(function(k){ var s=city.st[k]; xs.push(s.x); ys.push(s.y); });\n  return [Math.min.apply(null,xs),Math.min.apply(null,ys),Math.max.apply(null,xs),Math.max.apply(null,ys)];\n}\nfunction setLegend(){\n  var t={london:'Tube, Elizabeth line and DLR',paris:'Métro lines 1–14',nyc:'Subway and Staten Island Railway',berlin:'U-Bahn lines U1–U9',madrid:'Metro lines 1–12 and Ramal',barcelona:'Metro lines L1–L11',tokyo:'Tokyo Metro and Toei lines'}[city.id];\n  $('legend').textContent=t+(viewMode()==='sch'?' · schematic computed by MyLLM from station positions':' · our own map from open data');\n}\n\n/* ---------- Sheets ---------- */\nvar curTab='map', sheetStack=[];\nfunction openSheet(title,html,opts){\n  opts=opts||{};\n  $('shTitle').textContent=title; $('shBody').innerHTML=html; $('shBody').scrollTop=0;\n  $('shBack').hidden=!opts.back; if(opts.back)$('shBack').textContent='‹ '+opts.back;\n  $('sheet').classList.add('open'); placeFab();\n  sheetStack.onBack=opts.onBack||null;\n}\nfunction closeSheet(){\n  $('sheet').classList.remove('open'); placeFab();\n  document.querySelectorAll('.tabs button').forEach(function(b){ b.classList.toggle('on',b.dataset.tab==='map'); }); curTab='map';\n}\nfunction placeFab(){ requestAnimationFrame(function(){ var c=sheetCover(); $('fab').style.bottom=(c+12)+'px'; $('fab').style.visibility=c?'hidden':''; $('legend').style.display=c?'none':''; }); }\n$('shX').onclick=function(){ haptic('light'); closeSheet(); };\n$('shBack').onclick=function(){ if(sheetStack.onBack)sheetStack.onBack(); };\n// drag the handle down to close\n(function(){ var y0=null, sh=$('sheet');\n  $('grab').addEventListener('pointerdown',function(e){ y0=e.clientY; sh.style.transition='none'; $('grab').setPointerCapture(e.pointerId); });\n  $('grab').addEventListener('pointermove',function(e){ if(y0===null)return; var d=Math.max(0,e.clientY-y0); sh.style.transform='translateY('+d+'px)'; });\n  function up(e){ if(y0===null)return; var d=e.clientY-y0; y0=null; sh.style.transition=''; sh.style.transform=''; if(d>90)closeSheet(); }\n  $('grab').addEventListener('pointerup',up); $('grab').addEventListener('pointercancel',up);\n})();\n$('tabs').addEventListener('click',function(e){ var b=e.target.closest('button'); if(!b)return; haptic('light'); openTab(b.dataset.tab); });\nfunction openTab(t){\n  curTab=t;\n  document.querySelectorAll('.tabs button').forEach(function(b){ b.classList.toggle('on',b.dataset.tab===t); });\n  if(t==='map')return closeSheet();\n  if(t==='lines')return showLines();\n  if(t==='route')return showRoute();\n  if(t==='status')return showStatus();\n}\nfunction chip(L,lg){ return '<span class=\"chip'+(lg?' lg':'')+'\" style=\"background:'+L.color+';color:'+L.text+'\">'+esc(L.chip)+'</span>'; }\nfunction chipsFor(si,except){ return city.st[si].lines.filter(function(li){return li!==except}).map(function(li){return chip(city.lines[li])}).join(''); }\n\n/* ---------- Lines ---------- */\nfunction showLines(){\n  var h=city.lines.map(function(L){\n    var n={}; L.pats.forEach(function(p){p.forEach(function(s){n[s]=1})});\n    return '<div class=\"row\" data-l=\"'+L.i+'\">'+chip(L,true)+'<div class=\"t\"><b>'+esc(L.name)+'</b><span>'+Object.keys(n).length+' stations'+(L.pats.length>1?' · '+L.pats.length+' routes':'')+'</span></div><span class=\"chev\">›</span></div>';\n  }).join('');\n  openSheet(city.name+' lines',h);\n  $('shBody').onclick=function(e){ var r=e.target.closest('[data-l]'); if(r){ haptic('light'); showLine(+r.dataset.l,0); } };\n}\nfunction patName(L,pi){\n  var p=L.pats[pi], a=city.st[p[0]].name, b=city.st[p[p.length-1]].name;\n  var same=L.pats.filter(function(q){ var x=city.st[q[0]].name,y=city.st[q[q.length-1]].name; return (x===a&&y===b)||(x===b&&y===a); });\n  var via='';\n  if(same.length>1){ var others={}; same.forEach(function(q){ if(q!==p)q.forEach(function(s){others[s]=1}); });\n    var u=p.filter(function(s){return !others[s]}); if(u.length)via=' via '+city.st[u[Math.floor(u.length/2)]].name; }\n  return a+' – '+b+via;\n}\nfunction showLine(li,pi){\n  var L=city.lines[li], p=L.pats[pi];\n  var pats=L.pats.length>1?'<div class=\"pats\">'+L.pats.map(function(q,k){return '<button data-p=\"'+k+'\" class=\"'+(k===pi?'on':'')+'\">'+esc(patName(L,k))+'</button>'}).join('')+'</div>':'';\n  var col=lineColor(L);\n  var h=pats+'<div class=\"strip\" style=\"--lc:'+col+'\">'+p.map(function(si,k){\n    var s=city.st[si], ix=s.lines.length>1;\n    return '<div class=\"stop'+(ix?' ix':'')+(k===0||k===p.length-1?' term':'')+'\" data-s=\"'+si+'\"><span class=\"dot\"></span><span class=\"sn\">'+esc(s.name)+'</span>'+(ix?'<span class=\"chips\">'+chipsFor(si,li)+'</span>':'')+'</div>';\n  }).join('')+'</div>';\n  openSheet(L.name,h,{back:'Lines',onBack:showLines});\n  $('shBody').onclick=function(e){\n    var b=e.target.closest('[data-p]'); if(b){ haptic('light'); showLine(li,+b.dataset.p); return; }\n    var r=e.target.closest('[data-s]'); if(r){ haptic('light'); openStation(+r.dataset.s,{back:L.name,onBack:function(){showLine(li,pi)}}); }\n  };\n  // show the line on the map\n  var xs=p.map(function(s){return city.st[s].x}), ys=p.map(function(s){return city.st[s].y});\n  fitBox([Math.min.apply(null,xs),Math.min.apply(null,ys),Math.max.apply(null,xs),Math.max.apply(null,ys)],28,true);\n}\n\n/* ---------- Station ---------- */\nfunction openStation(si,opts){\n  var s=city.st[si]; focusSt=si;\n  var h=(s.ja&&s.ja!==s.name?'<div class=\"ja\" lang=\"ja\">'+esc(s.ja)+'</div>':'')+'<div class=\"chips\" style=\"margin:2px 0 10px\">'+s.lines.map(function(li){return chip(city.lines[li],true)}).join('')+'</div>'+\n    '<div class=\"note\">'+(s.lines.length>1?'Change here between '+s.lines.length+' lines.':'On the '+esc(city.lines[s.lines[0]].name)+(city.id==='london'?' line':'')+'.')+'</div>'+\n    '<div class=\"acts2\"><button class=\"btn pri\" id=\"rFrom\">Route from here</button><button class=\"btn\" id=\"rTo\">Route to here</button></div>'+\n    '<div class=\"sec\">Lines</div>'+s.lines.map(function(li){ var L=city.lines[li];\n      return '<div class=\"row\" data-l=\"'+li+'\">'+chip(L)+'<div class=\"t\"><b>'+esc(L.name)+'</b><span>'+esc(towards(L,si))+'</span></div><span class=\"chev\">›</span></div>'; }).join('');\n  openSheet(s.name,h,opts);\n  $('rFrom').onclick=function(){ haptic('light'); R.from=si; if(R.to===si)R.to=null; openTab('route'); };\n  $('rTo').onclick=function(){ haptic('light'); R.to=si; if(R.from===si)R.from=null; openTab('route'); };\n  $('shBody').onclick=function(e){ var r=e.target.closest('[data-l]'); if(r){ haptic('light'); var li=+r.dataset.l, L=city.lines[li];\n    var pi=Math.max(0,L.pats.findIndex(function(p){return p.indexOf(si)>=0})); showLine(li,pi); } };\n  var sheetH=Math.min(H*.74,$('sheet').offsetHeight||H*.5);\n  var t={s:Math.max(view.s,baseS*2.2)}; t.tx=W/2-s.x*t.s; t.ty=(H-sheetH)/2-s.y*t.s;\n  animateTo(t,320);\n}\nfunction towards(L,si){\n  var ends={};\n  L.pats.forEach(function(p){ var k=p.indexOf(si); if(k<0)return; if(k>0)ends[city.st[p[0]].name]=1; if(k<p.length-1)ends[city.st[p[p.length-1]].name]=1; });\n  var e=Object.keys(ends); return e.length?'Towards '+e.slice(0,3).join(', ')+(e.length>3?'…':''):'';\n}\n\n/* ---------- Route planner ---------- */\nvar R={from:null,to:null,cityId:null};\nvar SPEED_M_PER_MIN=550, DWELL=.5, CHANGE={fast:5,few:25};\nfunction edgeMin(a,b){ var A=city.st[a],B=city.st[b]; return Math.hypot(A.gx-B.gx,A.gy-B.gy)*10/SPEED_M_PER_MIN+DWELL; }\n/* Dijkstra over (station, line): riding costs minutes, changing line costs a\n   penalty — small for \"fastest\", large for \"fewest changes\". */\nfunction plan(from,to,mode){\n  var pen=CHANGE[mode], dist={}, prev={}, heap=[];\n  function push(k,d){ heap.push([d,k]); var i=heap.length-1; while(i>0){ var j=(i-1)>>1; if(heap[j][0]<=heap[i][0])break; var t=heap[i];heap[i]=heap[j];heap[j]=t;i=j; } }\n  function pop(){ var top=heap[0], last=heap.pop(); if(heap.length){ heap[0]=last; var i=0; for(;;){ var l=2*i+1,r=l+1,m=i;\n    if(l<heap.length&&heap[l][0]<heap[m][0])m=l; if(r<heap.length&&heap[r][0]<heap[m][0])m=r; if(m===i)break; var t=heap[i];heap[i]=heap[m];heap[m]=t;i=m; } } return top; }\n  city.st[from].lines.forEach(function(li){ var k=from+':'+li; dist[k]=0; push(k,0); });\n  var endKey=null;\n  while(heap.length){\n    var cur=pop(), d=cur[0], k=cur[1]; if(d>dist[k])continue;\n    var parts=k.split(':'), s=+parts[0], li=+parts[1];\n    if(s===to){ endKey=k; break; }\n    var nb=city.lines[li].adj[s]||{};\n    for(var n in nb){ n=+n; var nk=n+':'+li, nd=d+edgeMin(s,n); if(dist[nk]===undefined||nd<dist[nk]-1e-9){ dist[nk]=nd; prev[nk]=k; push(nk,nd); } }\n    city.st[s].lines.forEach(function(l2){ if(l2===li)return; var nk=s+':'+l2, nd=d+pen; if(dist[nk]===undefined||nd<dist[nk]-1e-9){ dist[nk]=nd; prev[nk]=k; push(nk,nd); } });\n  }\n  if(!endKey)return null;\n  var path=[], k2=endKey; while(k2){ var q=k2.split(':'); path.unshift([+q[0],+q[1]]); k2=prev[k2]; }\n  // legs: runs on one line (a change is a repeated station)\n  var legs=[], cur2=null;\n  path.forEach(function(p){ if(!cur2||cur2.line!==p[1]){ if(cur2&&cur2.stops.length<2)legs.pop(); cur2={line:p[1],stops:[p[0]]}; legs.push(cur2); } else cur2.stops.push(p[0]); });\n  legs=legs.filter(function(g){return g.stops.length>1});\n  var mins=0, stops=0; legs.forEach(function(g){ for(var i=1;i<g.stops.length;i++){ mins+=edgeMin(g.stops[i-1],g.stops[i]); stops++; } });\n  mins+=Math.max(0,legs.length-1)*4;\n  var stSet={}, lineSet={}, xs=[], ys=[];\n  legs.forEach(function(g){ lineSet[g.line]=1; g.stops.forEach(function(s){ stSet[s]=1; xs.push(city.st[s].x); ys.push(city.st[s].y); }); });\n  return {from:from,to:to,legs:legs,mins:Math.round(mins),stops:stops,changes:legs.length-1,stSet:stSet,lineSet:lineSet,\n    box:[Math.min.apply(null,xs),Math.min.apply(null,ys),Math.max.apply(null,xs),Math.max.apply(null,ys)],mode:mode};\n}\nfunction legTowards(g){\n  var L=city.lines[g.line], a=g.stops[0], b=g.stops[1];\n  for(var i=0;i<L.pats.length;i++){ var p=L.pats[i], ia=p.indexOf(a), ib=p.indexOf(b);\n    if(ia>=0&&ib>=0&&Math.abs(ia-ib)===1)return city.st[ib>ia?p[p.length-1]:p[0]].name; }\n  return city.st[g.stops[g.stops.length-1]].name;\n}\nfunction fieldHTML(cls,si,ph){ return '<button class=\"field '+cls+'\" data-f=\"'+cls+'\"><i></i><span class=\"'+(si===null?'ph':'')+'\">'+esc(si===null?ph:city.st[si].name)+'</span></button>'; }\nfunction showRoute(){\n  if(R.cityId!==city.id){ if(R.cityId!==null){R.from=R.to=null;} R.cityId=city.id; }\n  var h='<div class=\"pick\">'+fieldHTML('from',R.from,'From')+fieldHTML('to',R.to,'To')+'<button class=\"swap\" id=\"swap\" aria-label=\"Swap\"><svg viewBox=\"0 0 24 24\"><path d=\"M7 4v16M7 20l-3-3M7 20l3-3M17 20V4M17 4l-3 3M17 4l3 3\"/></svg></button></div>'+\n    '<div class=\"seg\" id=\"mode\"><button data-m=\"fast\" class=\"'+(S.mode==='fast'?'on':'')+'\">Fastest</button><button data-m=\"few\" class=\"'+(S.mode==='few'?'on':'')+'\">Fewest changes</button></div><div id=\"rOut\"></div>';\n  openSheet('Plan a route',h);\n  $('shBody').onclick=function(e){\n    var f=e.target.closest('[data-f]'); if(f){ openSearch(f.dataset.f); return; }\n    var m=e.target.closest('[data-m]'); if(m){ S.mode=m.dataset.m; save(); haptic('light'); showRoute(); return; }\n    var rr=e.target.closest('[data-rr]'); if(rr){ var it=(rr.dataset.rr==='f'?S.favs:S.recents)[+rr.dataset.i]; if(it){ R.from=idxOf(it.a); R.to=idxOf(it.b); haptic('light'); showRoute(); } return; }\n    if(e.target.closest('#swap')){ var t=R.from; R.from=R.to; R.to=t; haptic('light'); showRoute(); return; }\n    if(e.target.closest('#rFav')){ toggleFav(); return; }\n    if(e.target.closest('#rShow')){ closeSheet(); fitBox(route.box,30,true); return; }\n  };\n  renderRouteOut();\n}\nfunction idxOf(name){ var s=city.st.find(function(x){return x.name===name}); return s?s.i:null; }\nfunction renderRouteOut(){\n  var out=$('rOut'); if(!out)return;\n  if(R.from===null||R.to===null||R.from===R.to){\n    route=null; showRouteCard(); draw();\n    var mine=function(list,tag){ return list.map(function(it,i){ return it.c===city.id?'<div class=\"row\" data-rr=\"'+tag+'\" data-i=\"'+i+'\"><div class=\"t\"><b>'+esc(it.a)+' → '+esc(it.b)+'</b></div><span class=\"chev\">›</span></div>':''; }).join(''); };\n    var f=mine(S.favs,'f'), r=mine(S.recents,'r');\n    out.innerHTML=(R.from!==null&&R.from===R.to?'<p class=\"note\" style=\"margin-top:12px\">Pick two different stations.</p>':'<p class=\"note\" style=\"margin-top:12px\">Choose where you are and where you’re going. Tap any station on the map to start from there.</p>')+\n      (f?'<div class=\"sec\">Saved</div>'+f:'')+(r?'<div class=\"sec\">Recent</div>'+r:'');\n    return;\n  }\n  var r1=plan(R.from,R.to,S.mode);\n  if(!r1){ out.innerHTML='<p class=\"note\" style=\"margin-top:12px\">No route found between these stations.</p>'; route=null; draw(); return; }\n  route=r1; showRouteCard(); remember();\n  var fav=S.favs.some(function(it){return it.c===city.id&&it.a===city.st[R.from].name&&it.b===city.st[R.to].name});\n  var h='<div class=\"sum\"><b>≈ '+r1.mins+' min</b><span>'+r1.stops+' stop'+(r1.stops===1?'':'s')+' · '+(r1.changes?r1.changes+' change'+(r1.changes>1?'s':''):'no changes')+'</span></div>'+\n    '<p class=\"note\">Time is an estimate from distance, not a timetable.</p><div class=\"legs\">';\n  r1.legs.forEach(function(g,gi){\n    var L=city.lines[g.line], col=lineColor(L), a=city.st[g.stops[0]], n=g.stops.length-1;\n    h+='<div class=\"leg\" style=\"--lc:'+col+'\"><span class=\"pin\"></span><div class=\"lt\">'+esc(a.name)+'</div>'+\n      '<div class=\"ld\">'+chip(L)+'<span>'+esc(L.name)+(city.id==='london'&&L.id!=='dlr'&&L.id!=='elizabeth'?' line':(L.id==='elizabeth'?' line':''))+' towards '+esc(legTowards(g))+'</span></div>'+\n      '<details><summary>'+n+' stop'+(n>1?'s':'')+'</summary><ol>'+g.stops.slice(1).map(function(s){return '<li>'+esc(city.st[s].name)+'</li>'}).join('')+'</ol></details></div>';\n    if(gi<r1.legs.length-1)h+='<div class=\"chg\">Change at '+esc(city.st[g.stops[n]].name)+'</div>';\n  });\n  var last=city.st[R.to];\n  h+='<div class=\"leg end\" style=\"--lc:'+COL['--bad']+'\"><span class=\"pin\" style=\"border-radius:4px\"></span><div class=\"lt\">'+esc(last.name)+'</div></div></div>'+\n    '<div class=\"acts2\"><button class=\"btn pri\" id=\"rShow\">Show on map</button><button class=\"btn star'+(fav?' on':'')+'\" id=\"rFav\">'+(fav?'★ Saved':'☆ Save')+'</button></div>';\n  out.innerHTML=h;\n  fitBox(r1.box,28,true);\n}\nfunction remember(){\n  var it={c:city.id,a:city.st[R.from].name,b:city.st[R.to].name};\n  S.recents=S.recents.filter(function(x){return !(x.c===it.c&&x.a===it.a&&x.b===it.b)}); S.recents.unshift(it); save();\n}\nfunction toggleFav(){\n  var it={c:city.id,a:city.st[R.from].name,b:city.st[R.to].name};\n  var i=S.favs.findIndex(function(x){return x.c===it.c&&x.a===it.a&&x.b===it.b});\n  if(i>=0)S.favs.splice(i,1); else S.favs.unshift(it);\n  save(); haptic('success'); toast(i>=0?'Removed from saved':'Saved'); renderRouteOut();\n}\nfunction showRouteCard(){\n  var c=$('rcard');\n  if(!route){ c.classList.remove('show'); return; }\n  $('rcT').textContent=city.st[route.from].name+' → '+city.st[route.to].name;\n  $('rcS').textContent='≈ '+route.mins+' min · '+(route.changes?route.changes+' change'+(route.changes>1?'s':''):'direct');\n  c.classList.add('show');\n}\n$('rcOpen').onclick=function(){ haptic('light'); openTab('route'); };\n$('rcClear').onclick=function(){ haptic('light'); route=null; R.from=R.to=null; showRouteCard(); draw(); if(curTab==='route')showRoute(); };\n\n/* ---------- Search ---------- */\nvar searchFor=null;\nfunction openSearch(forWhat){\n  searchFor=forWhat; $('q').value=''; $('search').classList.add('open');\n  $('q').placeholder=forWhat==='from'?'Where from?':(forWhat==='to'?'Where to?':'Find a station in '+city.name);\n  renderResults(''); setTimeout(function(){ $('q').focus(); },60);\n}\nfunction closeSearch(){ $('search').classList.remove('open'); $('q').blur(); }\nfunction renderResults(q){\n  var k=fold(q), list, jq=q.trim();\n  if(!k&&!jq){ list=city.st.slice().sort(function(a,b){return b.lines.length-a.lines.length||a.name.localeCompare(b.name)}).slice(0,24); }\n  else {\n    list=city.st.filter(function(s){ return (k&&s.key.indexOf(k)>=0)||(s.ja&&jq&&s.ja.indexOf(jq)>=0); })\n      .sort(function(a,b){ var sa=a.key.indexOf(k)===0?0:(a.key.indexOf(' '+k)>=0?1:2), sb=b.key.indexOf(k)===0?0:(b.key.indexOf(' '+k)>=0?1:2); return sa-sb||b.lines.length-a.lines.length||a.name.localeCompare(b.name); }).slice(0,40);\n  }\n  $('qRes').innerHTML=(k||jq?'':'<div class=\"stitle\">Busiest stations</div>')+(list.length?list.map(function(s){\n    return '<div class=\"row\" data-s=\"'+s.i+'\"><div class=\"t\"><b>'+esc(s.name)+'</b>'+(s.ja&&s.ja!==s.name?'<span lang=\"ja\">'+esc(s.ja)+'</span>':'')+'</div><span class=\"chips\">'+s.lines.slice(0,6).map(function(li){return chip(city.lines[li])}).join('')+(s.lines.length>6?'<span class=\"chip\" style=\"background:var(--chip)\">+'+(s.lines.length-6)+'</span>':'')+'</span></div>';\n  }).join(''):'<p class=\"note\" style=\"margin-top:16px\">No station called “'+esc(q)+'” in '+esc(city.name)+'.</p>');\n}\n$('q').addEventListener('input',function(){ renderResults($('q').value); });\n$('q').addEventListener('keydown',function(e){ if(e.key==='Enter'){ var f=$('qRes').querySelector('[data-s]'); if(f)f.click(); } if(e.key==='Escape')closeSearch(); });\n$('qCancel').onclick=closeSearch;\n$('qRes').addEventListener('click',function(e){\n  var r=e.target.closest('[data-s]'); if(!r)return; var si=+r.dataset.s; haptic('light'); closeSearch();\n  if(searchFor==='from'){ R.from=si; showRoute(); }\n  else if(searchFor==='to'){ R.to=si; showRoute(); }\n  else openStation(si);\n});\n$('findBtn').onclick=function(){ haptic('light'); openSearch('find'); };\n\n/* ---------- Live status ---------- */\nvar statusCache={};\nfunction getJSON(url){\n  if(window.myllmFetch)return window.myllmFetch(url,{headers:{accept:'application/json'}}).then(function(r){ if(!r||!r.ok)throw new Error('HTTP '+(r&&r.status)); return JSON.parse(r.body); });\n  return Promise.reject(new Error('Live status needs MyLLM'));\n}\nfunction showStatus(){\n  var cid=city.id;\n  if(cid!=='london'&&cid!=='nyc'){ openSheet(city.name+' status','<p class=\"note\" style=\"margin-top:4px\">Live line status isn’t available here for '+esc(city.name)+'. The map and route planner work fully offline.</p>'+aboutLink()); bindAbout(); return; }\n  openSheet(city.name+' status','<div class=\"skel\"></div><div class=\"skel\" style=\"width:70%\"></div><div class=\"skel\" style=\"width:85%\"></div>');\n  var c=statusCache[cid];\n  if(c&&Date.now()-c.t<120000){ renderStatus(cid,c.d); return; }\n  var url=cid==='london'?'https://api.tfl.gov.uk/Line/Mode/tube,elizabeth-line,dlr/Status':'https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/camsys%2Fsubway-alerts.json';\n  getJSON(url).then(function(d){ statusCache[cid]={t:Date.now(),d:d}; if(city.id===cid&&curTab==='status')renderStatus(cid,d); })\n  .catch(function(){ if(city.id!==cid||curTab!=='status')return;\n    $('shBody').innerHTML='<p class=\"note\" style=\"margin-top:4px\">Couldn’t get live status just now — you may be offline. The map and route planner work without a connection.</p><div class=\"acts2\"><button class=\"btn\" id=\"stRetry\">Try again</button></div>'+aboutLink();\n    $('stRetry').onclick=function(){ haptic('light'); showStatus(); }; bindAbout(); });\n}\nfunction sev(t){ t=(t||'').toLowerCase(); if(/good service|no issues/.test(t))return 'good'; if(/suspend|closed|closure|not running|no service/.test(t))return 'bad'; return 'warn'; }\nfunction renderStatus(cid,d){\n  var h='';\n  if(cid==='london'){\n    var byId={}; (d||[]).forEach(function(x){ byId[x.id]=x; });\n    var bad=0;\n    h=city.lines.map(function(L){\n      var x=byId[L.id==='elizabeth'?'elizabeth':L.id]; if(!x)return '';\n      var sts=(x.lineStatuses||[]), main=sts[0]||{}, t=main.statusSeverityDescription||'Unknown', c=sev(t);\n      if(c!=='good')bad++;\n      var why=sts.map(function(s){return s.reason}).filter(Boolean)[0]||'';\n      return '<div class=\"st-row\">'+chip(L)+'<div class=\"t\"><b class=\"'+c+'\">'+esc(t)+'</b>'+(why?'<p class=\"clamp\">'+esc(why)+'</p>':'')+'</div></div>';\n    }).join('');\n    h='<p class=\"note\">'+(bad?bad+' line'+(bad>1?'s':'')+' with problems.':'Good service on every line.')+' Updated '+new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})+'.</p>'+h;\n  } else {\n    var now=Date.now()/1000, per={};\n    (d&&d.entity||[]).forEach(function(en){ var a=en.alert; if(!a)return;\n      var act=(a.active_period||[]).some(function(p){ return (!p.start||p.start<=now)&&(!p.end||p.end>=now); }); if(!act&&(a.active_period||[]).length)return;\n      var hd=((a.header_text||{}).translation||[]).find(function(t){return t.language==='en'})||((a.header_text||{}).translation||[])[0];\n      var type=(a['transit_realtime.mercury_alert']||{}).alert_type||'';\n      (a.informed_entity||[]).forEach(function(ie){ if(!ie.route_id)return; (per[ie.route_id]=per[ie.route_id]||[]).push({t:type,h:hd?hd.text:''}); }); });\n    var bad=0;\n    h=city.lines.map(function(L){\n      var rid=L.id.indexOf('·')>0?L.id.split('·')[1]:(L.id==='S'?'GS':(L.id==='SIR'?'SI':L.id));\n      var list=per[rid]||[]; var uniq=[]; list.forEach(function(x){ if(uniq.every(function(u){return u.h!==x.h}))uniq.push(x); });\n      if(uniq.length)bad++;\n      var head=uniq.length?(uniq[0].t||'Service change'):'Good service', c=uniq.length?sev(head):'good';\n      return '<div class=\"st-row\">'+chip(L)+'<div class=\"t\"><b class=\"'+c+'\">'+esc(head)+(uniq.length>1?' · '+uniq.length+' alerts':'')+'</b>'+(uniq.length?'<p class=\"clamp\">'+esc(uniq[0].h.replace(/\\[[^\\]]+\\]/g,function(m){return m.slice(1,-1)}))+'</p>':'')+'</div></div>';\n    }).join('');\n    h='<p class=\"note\">'+(bad?bad+' line'+(bad>1?'s':'')+' with alerts right now.':'No alerts right now.')+' Updated '+new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})+'.</p>'+h;\n  }\n  $('shBody').innerHTML=h+aboutLink(); bindAbout();\n}\nfunction aboutLink(){ return '<div class=\"sec\">About</div><div class=\"row\" id=\"aboutRow\"><div class=\"t\"><b>Data sources and licences</b><span>Our own map, not an official diagram</span></div><span class=\"chev\">›</span></div>'; }\nfunction bindAbout(){ var a=$('aboutRow'); if(a)a.onclick=function(){ haptic('light'); showAbout(); }; }\nfunction showAbout(){\n  var h='<p class=\"note\">Metro Maps draws its own maps from open data. Geographic: real station positions, joined in stop order. Schematic computed from station positions by MyLLM; not the official map. It is found by a layout search for 45° lines, even spacing and room in the centre, never traced from any official diagram. It is not an official map and is not affiliated with or endorsed by Transport for London, RATP or Île-de-France Mobilités, or the Metropolitan Transportation Authority.</p>'+\n    '<div class=\"sec\">London</div><p class=\"note\">Powered by TfL Open Data. Contains OS data © Crown copyright and database rights 2026. Stations and routes for the Tube, Elizabeth line and DLR; live status from the TfL Unified API.</p>'+\n    '<div class=\"sec\">Paris</div><p class=\"note\">© OpenStreetMap contributors. Métro stations and lines from OpenStreetMap, available under the Open Database License (ODbL 1.0); the Paris data in this app is ODbL.</p>'+\n    '<div class=\"sec\">New York</div><p class=\"note\">Subway and Staten Island Railway stations and routes from the MTA New York City Transit GTFS feed; live alerts from the MTA’s public GTFS alerts feed. Data provided by the MTA under its data feed terms.</p>'+\n    '<div class=\"sec\">Berlin, Madrid, Barcelona, Tokyo</div><p class=\"note\">© OpenStreetMap contributors. U-Bahn, Metro and subway stations and lines from OpenStreetMap, available under the Open Database License (ODbL 1.0); the data for these cities in this app is ODbL. Not affiliated with or endorsed by BVG, Metro de Madrid, TMB, Tokyo Metro or Toei.</p>'+\n    '<div class=\"sec\">Rivers</div><p class=\"note\">© OpenStreetMap contributors, ODbL.</p>'+\n    '<div class=\"sec\">Landmarks</div><p class=\"note\">Landmark sketches: MyLLM.</p>'+\n    '<div class=\"sec\">Good to know</div><p class=\"note\">Journey times are estimates from distance. Service patterns change; check live status and station signs before you travel. Everything except live status works offline.</p>';\n  openSheet('About Metro Maps',h);\n}\n$('aboutBtn').onclick=function(){ haptic('light'); showAbout(); };\n\n/* ---------- Toast ---------- */\nvar tt; function toast(m){ var t=$('toast'); t.textContent=m; t.classList.add('show'); clearTimeout(tt); tt=setTimeout(function(){t.classList.remove('show')},1500); }\n\n/* ---------- Boot ---------- */\nreadColors();\nDARK.addEventListener&&DARK.addEventListener('change',function(){ readColors(); draw(); });\nif(window.ResizeObserver)new ResizeObserver(function(){ resize(); placeFab(); }).observe(stage);\naddEventListener('resize',function(){ resize(); placeFab(); });\nresize(); renderCities();\nload(function(){ syncLmBtn(); setCity(S.city,true); });\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes. This page\n   pads its own top by env(safe-area-inset-top), so the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    var sp = document.querySelector(\".imm-safe\"); if (sp) sp.style.height = \"0px\";\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script></body></html>\n", "kind": "html", "iconSymbol": "tram.fill", "iconColor": "red"}