0,246,247,401,402,248,403,404,405,249,406,407,250,408,251,252,49,253,114,96,255,13,387,98,409,410,411]],\"Q\"],[\"R\",\"R train\",\"F6BC26\",\"000000\",[[412,413,414,415,381,395,396,279,281,282,283,284,49,253,181,52,397,398,56,399,114,382,383,96,384,385,255,13,386,387,388,98,228,236,237,238,239,240,161,241,242,243,244,245,229]],\"R\"],[\"W\",\"W train\",\"F6BC26\",\"000000\",[[397,398,56,399,114,382,383,96,384,385,255,13,386,387,388,98,156,389,390,391,392,393,394]],\"W\"],[\"S\",\"42 St Shuttle\",\"7C858C\",\"FFFFFF\",[[97,13]],\"GS\"],[\"S·FS\",\"Franklin Av Shuttle\",\"7C858C\",\"FFFFFF\",[[251,45,416,210]],\"FS\"],[\"S·H\",\"Rockaway Park Shuttle\",\"7C858C\",\"FFFFFF\",[[417,418,419,420,200,201,202,203,172]],\"H\"],[\"SIR\",\"Staten Island Railway\",\"08179C\",\"FFFFFF\",[[421,422,423,424,425,426,427,428,429,430,431,432,433,434,435,436,437,438,439,440,441]],\"SI\"]],\"r\":[[[812,-3156],[805,-2926],[743,-2432],[439,-1364],[86,-570],[-237,-5],[-367,642]],[[637,-1266],[628,-1207],[487,-983],[433,-852],[440,-565],[486,-482],[480,-407],[400,-300],[430,-242]]]}];/*DATA:END*/\n\nvar $=function(id){return document.getElementById(id)};\nfunction esc(s){return String(s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]})}\nfunction haptic(s){ try{ if(window.myllmHaptic)window.myllmHaptic(s||'light'); }catch(e){} }\nvar DARK=matchMedia('(prefers-color-scheme: dark)');\nfunction fold(s){ return s.normalize('NFD').replace(/[̀-ͯ]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,' ').trim(); }\n\n/* ---------- Cities ---------- */\nfunction lum(hex){ var n=parseInt(hex,16),r=(n>>16&255)/255,g=(n>>8&255)/255,b=(n&255)/255;\n  function c(v){return v<=.03928?v/12.92:Math.pow((v+.055)/1.055,2.4)} return .2126*c(r)+.7152*c(g)+.0722*c(b); }\nfunction mixWhite(hex,t){ var n=parseInt(hex,16),r=n>>16&255,g=n>>8&255,b=n&255;\n  return '#'+[r,g,b].map(function(v){return Math.round(v+(255-v)*t).toString(16).padStart(2,'0')}).join(''); }\nfunction prepCity(raw){\n  var c={id:raw.id,name:raw.name,st:[],lines:[],rivers:raw.r||[]};\n  for(var i=0;i<raw.n.length;i++)c.st.push({i:i,name:raw.n[i],x:raw.xy[2*i],y:raw.xy[2*i+1],lines:[],key:fold(raw.n[i])});\n  raw.l.forEach(function(l,li){\n    var chip=raw.id==='london'?l[1]:(raw.id==='nyc'?l[0].split('·')[0]:l[0]);\n    var L={i:li,id:l[0],name:l[1],color:'#'+l[2],text:'#'+l[3],pats:l[4],chip:chip,adj:{}};\n    L.dark=lum(l[2])<.05?'#dadde3':(lum(l[2])<.1?mixWhite(l[2],.35):'#'+l[2]);\n    L.pats.forEach(function(p){ for(var k=0;k<p.length;k++){ var s=p[k];\n      if(c.st[s].lines.indexOf(li)<0)c.st[s].lines.push(li);\n      if(k){ var a=p[k-1]; (L.adj[a]=L.adj[a]||{})[s]=1; (L.adj[s]=L.adj[s]||{})[a]=1; } } });\n    c.lines.push(L);\n  });\n  // edges shared by several lines, for side-by-side drawing\n  c.edges={};\n  c.lines.forEach(function(L){ Object.keys(L.adj).forEach(function(a){ Object.keys(L.adj[a]).forEach(function(b){\n    a=+a;b=+b; if(a<b){ var k=a+'-'+b; (c.edges[k]=c.edges[k]||[]).push(L.i); } }); }); });\n  // bounds: the whole network, and the busy middle the map opens on\n  var xs=c.st.map(function(s){return s.x}).sort(function(a,b){return a-b}), ys=c.st.map(function(s){return s.y}).sort(function(a,b){return a-b});\n  var q=function(a,f){return a[Math.floor((a.length-1)*f)]};\n  c.all=[xs[0],ys[0],xs[xs.length-1],ys[ys.length-1]];\n  c.core=[q(xs,.2),q(ys,.2),q(xs,.8),q(ys,.8)];\n  // a change of line means a change of colour: New York's 1/2/3 share a trunk\n  c.st.forEach(function(s){ var cols={}; s.lines.forEach(function(li){ cols[c.lines[li].color]=1; }); s.ix=Object.keys(cols).length; });\n  c.maxLines=Math.max.apply(null,c.st.map(function(s){return s.ix}));\n  // where the map opens: the centre of things, about this many metres across\n  var home={london:{x:0,y:40,w:1300},paris:{x:0,y:30,w:720},nyc:{x:40,y:360,w:1300}}[c.id]||{x:0,y:0,w:1200};\n  c.home=[home.x-home.w/2,home.y-home.w/2,home.x+home.w/2,home.y+home.w/2];\n  return c;\n}\nvar CITY_LIST=CITIES.map(prepCity), city=CITY_LIST[0];\n\n/* ---------- State + storage ---------- */\nvar STORE='metromaps.v1';\nvar S={city:'london',recents:[],favs:[],views:{},mode:'fast'};\nfunction save(){\n  var d=JSON.stringify({city:S.city,recents:S.recents.slice(0,12),favs:S.favs.slice(0,30),views:S.views,mode:S.mode});\n  try{ if(window.myllmStorage){ myllmStorage.setItem(STORE,d); return; } }catch(e){}\n  try{ localStorage.setItem(STORE,d); }catch(e){}\n}\nfunction load(done){\n  function apply(v){ if(v){ try{ var d=JSON.parse(v);\n    if(d.city&&CITY_LIST.some(function(c){return c.id===d.city}))S.city=d.city;\n    if(Array.isArray(d.recents))S.recents=d.recents; if(Array.isArray(d.favs))S.favs=d.favs;\n    if(d.views&&typeof d.views==='object')S.views=d.views; if(d.mode==='few'||d.mode==='fast')S.mode=d.mode; }catch(e){} }\n    done(); }\n  try{ if(window.myllmStorage){ myllmStorage.getItem(STORE).then(apply,function(){apply(null)}); return; } }catch(e){}\n  var v=null; try{ v=localStorage.getItem(STORE); }catch(e){} apply(v);\n}\n\n/* ---------- Map view ---------- */\nvar cv=$('map'), ctx=cv.getContext('2d'), stage=$('stage');\nvar W=0,H=0,DPR=1, view={s:.1,tx:0,ty:0}, baseS=.1;\nvar route=null, focusSt=null, drawQueued=false;\nfunction toScreen(x,y){ return [x*view.s+view.tx, y*view.s+view.ty]; }\nfunction resize(){\n  var r=stage.getBoundingClientRect(); DPR=Math.min(3,window.devicePixelRatio||1);\n  var nw=Math.max(1,Math.round(r.width)), nh=Math.max(1,Math.round(r.height));\n  if(nw===W&&nh===H&&cv.width===Math.round(nw*DPR))return;\n  var cx=W?(W/2-view.tx)/view.s:null, cy=H?(H/2-view.ty)/view.s:null;\n  W=nw;H=nh; cv.width=Math.round(W*DPR); cv.height=Math.round(H*DPR);\n  if(cx!==null){ view.tx=W/2-cx*view.s; view.ty=H/2-cy*view.s; }\n  draw();\n}\nfunction fitBox(b,pad,anim){\n  var bw=Math.max(60,b[2]-b[0]), bh=Math.max(60,b[3]-b[1]);\n  var top=pad+(route?60:0), bottom=pad+sheetCover();\n  var s=Math.min((W-2*pad)/bw,(H-top-bottom)/bh);\n  var t={s:s,tx:(W-bw*s)/2-b[0]*s,ty:top+((H-top-bottom)-bh*s)/2-b[1]*s};\n  if(anim)animateTo(t); else { view=t; draw(); }\n}\nfunction sheetCover(){ var sh=$('sheet'); if(!sh.classList.contains('open')||isLand())return 0; return Math.min(sh.offsetHeight,H*.74); }\nfunction isLand(){ return matchMedia('(orientation:landscape) and (max-height:560px)').matches; }\nvar anim=null;\nfunction animateTo(t,ms){\n  if(matchMedia('(prefers-reduced-motion: reduce)').matches){ view=t; draw(); return; }\n  var from={s:view.s,tx:view.tx,ty:view.ty}, t0=performance.now(), d=ms||380;\n  cancelAnimationFrame(anim);\n  (function step(now){ var k=Math.min(1,(now-t0)/d), e=1-Math.pow(1-k,3);\n    // interpolate in log-scale so zooms feel even\n    var s=Math.exp(Math.log(from.s)+(Math.log(t.s)-Math.log(from.s))*e);\n    var cxF=(W/2-from.tx)/from.s, cyF=(H/2-from.ty)/from.s, cxT=(W/2-t.tx)/t.s, cyT=(H/2-t.ty)/t.s;\n    var cx=cxF+(cxT-cxF)*e, cy=cyF+(cyT-cyF)*e;\n    view={s:s,tx:W/2-cx*s,ty:H/2-cy*s}; draw(true);\n    if(k<1)anim=requestAnimationFrame(step); else { view=t; draw(); saveView(); }\n  })(t0);\n}\nfunction zoomAt(f,px,py,animate){\n  var s=Math.max(baseS*.35,Math.min(baseS*40,view.s*f)); f=s/view.s;\n  var t={s:s,tx:px-(px-view.tx)*f,ty:py-(py-view.ty)*f};\n  if(animate)animateTo(t,260); else { view=t; draw(true); }\n}\nvar svT;\nfunction saveView(){ clearTimeout(svT); svT=setTimeout(function(){ S.views[city.id]={cx:(W/2-view.tx)/view.s,cy:(H/2-view.ty)/view.s,z:view.s/baseS}; save(); },500); }\n\n/* ---------- Drawing ---------- */\nvar COL={};\nfunction readColors(){ var cs=getComputedStyle(document.documentElement);\n  ['--map','--ink','--muted','--surface','--water','--acc','--bad','--faint'].forEach(function(k){ COL[k]=cs.getPropertyValue(k).trim(); }); }\nfunction lineColor(L){ return DARK.matches?L.dark:L.color; }\nfunction lineW(){ return Math.max(2.2,Math.min(7,2.6*Math.pow(view.s/baseS,.45))); }\nvar labelBox=[];\nfunction draw(fast){\n  if(!W)return;\n  ctx.setTransform(DPR,0,0,DPR,0,0);\n  ctx.fillStyle=COL['--map']; ctx.fillRect(0,0,W,H);\n  var lw=lineW(), gap=lw*1.05, z=view.s/baseS;\n  // rivers\n  ctx.lineJoin='round'; ctx.lineCap='round';\n  ctx.strokeStyle=COL['--water']; ctx.lineWidth=Math.max(5,Math.min(60,22*view.s));\n  city.rivers.forEach(function(r){ ctx.beginPath(); for(var i=0;i<r.length;i++){ var p=toScreen(r[i][0],r[i][1]); if(i)ctx.lineTo(p[0],p[1]); else ctx.moveTo(p[0],p[1]); } ctx.stroke(); });\n  // lines\n  var onRoute=route?route.lineSet:null;\n  city.lines.forEach(function(L){\n    ctx.globalAlpha=onRoute?.18:1;\n    ctx.strokeStyle=lineColor(L); ctx.lineWidth=lw;\n    L.pats.forEach(function(p){ strokePattern(L,p,gap); });\n  });\n  ctx.globalAlpha=1;\n  // route on top, thicker\n  if(route){\n    route.legs.forEach(function(g){\n      var L=city.lines[g.line];\n      ctx.strokeStyle=DARK.matches?'rgba(0,0,0,.55)':'rgba(255,255,255,.9)'; ctx.lineWidth=lw*2.6+3; strokePattern(L,g.stops,0,true);\n      ctx.strokeStyle=lineColor(L); ctx.lineWidth=lw*2.2; strokePattern(L,g.stops,0,true);\n    });\n  }\n  // stations\n  var r0=Math.max(2,lw*.62);\n  var vis=[];\n  city.st.forEach(function(s){\n    var p=toScreen(s.x,s.y); if(p[0]<-40||p[1]<-40||p[0]>W+40||p[1]>H+40)return;\n    var ix=s.ix>1, onR=route&&route.stSet[s.i];\n    if(route&&!onR&&!ix&&z<2.5)return;\n    vis.push([s,p,ix,onR]);\n  });\n  vis.forEach(function(v){\n    var s=v[0],p=v[1],ix=v[2],onR=v[3];\n    ctx.globalAlpha=route&&!onR?.35:1;\n    if(ix){ var r=r0*1.55+(s.ix>3?1:0);\n      ctx.beginPath(); ctx.arc(p[0],p[1],r,0,7); ctx.fillStyle=COL['--surface']; ctx.fill(); ctx.lineWidth=Math.max(1.6,lw*.5); ctx.strokeStyle=COL['--ink']; ctx.stroke();\n    } else if(z>.95||onR){\n      ctx.beginPath(); ctx.arc(p[0],p[1],r0*(z>1.6?.95:.7),0,7); ctx.fillStyle=COL['--surface']; ctx.fill();\n      ctx.lineWidth=Math.max(1.2,lw*.42); ctx.strokeStyle=lineColor(city.lines[s.lines[0]]); ctx.stroke();\n    }\n  });\n  ctx.globalAlpha=1;\n  // route ends\n  if(route){ pin(route.from,COL['--acc'],false); pin(route.to,COL['--bad'],true); }\n  if(focusSt!==null){ var fs=city.st[focusSt], fp=toScreen(fs.x,fs.y); ctx.beginPath(); ctx.arc(fp[0],fp[1],r0*3.2,0,7); ctx.lineWidth=3; ctx.strokeStyle=COL['--acc']; ctx.stroke(); }\n  drawLabels(vis,r0,z);\n}\nfunction pin(si,col,square){\n  var s=city.st[si], p=toScreen(s.x,s.y), r=9;\n  ctx.beginPath(); if(square){ roundRect(p[0]-r,p[1]-r,2*r,2*r,4); } else ctx.arc(p[0],p[1],r,0,7);\n  ctx.fillStyle=COL['--surface']; ctx.fill(); ctx.lineWidth=4; ctx.strokeStyle=col; ctx.stroke();\n}\nfunction roundRect(x,y,w,h,r){ ctx.moveTo(x+r,y); ctx.arcTo(x+w,y,x+w,y+h,r); ctx.arcTo(x+w,y+h,x,y+h,r); ctx.arcTo(x,y+h,x,y,r); ctx.arcTo(x,y,x+w,y,r); ctx.closePath(); }\n/* One stop pattern of a line: offset sideways where lines share track, then\n   rounded at the corners. */\nfunction strokePattern(L,p,gap,solo){\n  if(p.length<2)return;\n  var pts=[],i;\n  for(i=0;i<p.length;i++){\n    var s=city.st[p[i]], q=toScreen(s.x,s.y), ox=0, oy=0, n=0;\n    if(!solo){\n      for(var e=-1;e<=0;e++){ var a=p[i+e], b=p[i+e+1]; if(a===undefined||b===undefined)continue;\n        var k=a<b?a+'-'+b:b+'-'+a, list=city.edges[k]; if(!list||list.length<2)continue;\n        var sa=city.st[a], sb=city.st[b], dx=sb.x-sa.x, dy=sb.y-sa.y, len=Math.hypot(dx,dy)||1;\n        if(a>b){ dx=-dx; dy=-dy; } // normal of the edge in its canonical direction, so every line agrees\n        var off=(list.indexOf(L.i)-(list.length-1)/2)*gap;\n        ox+=-dy/len*off; oy+=dx/len*off; n++; }\n      if(n){ ox/=n; oy/=n; }\n    }\n    pts.push([q[0]+ox,q[1]+oy]);\n  }\n  ctx.beginPath(); ctx.moveTo(pts[0][0],pts[0][1]);\n  var R=Math.max(6,lineW()*4);\n  for(i=1;i<pts.length-1;i++){\n    var a1=pts[i-1],b1=pts[i],c1=pts[i+1];\n    var r=Math.min(R,Math.hypot(b1[0]-a1[0],b1[1]-a1[1])/2,Math.hypot(c1[0]-b1[0],c1[1]-b1[1])/2);\n    ctx.arcTo(b1[0],b1[1],c1[0],c1[1],r);\n  }\n  ctx.lineTo(pts[pts.length-1][0],pts[pts.length-1][1]); ctx.stroke();\n}\n/* Greedy labels: busiest stations first, each tries four spots and keeps the\n   first that overlaps nothing already placed. */\nfunction drawLabels(vis,r0,z){\n  var fs=z<1.4?11:(z<3?12:13);\n  ctx.font='600 '+fs+'px '+getComputedStyle(document.body).fontFamily;\n  ctx.textBaseline='middle';\n  var placed=[], minLines=z<.9?Math.max(3,Math.ceil(city.maxLines*.6)):(z<1.5?3:(z<2.4?2:1));\n  var cand=vis.filter(function(v){ return v[3]||v[0].ix>=minLines||v[0].i===focusSt; });\n  cand.sort(function(a,b){ return (b[3]?9:0)+b[0].ix-((a[3]?9:0)+a[0].ix)||b[0].lines.length-a[0].lines.length; });\n  if(route){ [route.from,route.to].forEach(function(si){ var s=city.st[si]; cand.unshift([s,toScreen(s.x,s.y),true,true,true]); }); }\n  var count=0, seen={};\n  for(var i=0;i<cand.length&&count<260;i++){\n    var s=cand[i][0], p=cand[i][1]; if(seen[s.i])continue;\n    var w=ctx.measureText(s.name).width, h=fs*1.35, d=r0*2+4;\n    var spots=[[p[0]+d,p[1]-h/2],[p[0]-d-w,p[1]-h/2],[p[0]-w/2,p[1]-d-h],[p[0]-w/2,p[1]+d]];\n    for(var k=0;k<4;k++){\n      var x=spots[k][0], y=spots[k][1];\n      if(x<2||y<2||x+w>W-2||y+h>H-2)continue;\n      var hit=false;\n      for(var j=0;j<placed.length;j++){ var b=placed[j]; if(x<b[2]&&x+w>b[0]&&y<b[3]&&y+h>b[1]){hit=true;break;} }\n      if(hit)continue;\n      placed.push([x-3,y-1,x+w+3,y+h+1]); seen[s.i]=1; count++;\n      ctx.lineWidth=3.5; ctx.strokeStyle=COL['--map']; ctx.lineJoin='round'; ctx.strokeText(s.name,x,y+h/2);\n      ctx.fillStyle=cand[i][4]||s.i===focusSt?COL['--ink']:(cand[i][2]?COL['--ink']:COL['--muted']); ctx.fillText(s.name,x,y+h/2);\n      break;\n    }\n  }\n}\nfunction queueDraw(){ if(drawQueued)return; drawQueued=true; requestAnimationFrame(function(){ drawQueued=false; draw(true); }); }\n\n/* ---------- Gestures ---------- */\nvar ptrs={}, gest=null, lastTap=0, vel=null;\ncv.addEventListener('pointerdown',function(e){\n  $('legend').style.opacity='0';\n  cv.setPointerCapture(e.pointerId); cancelAnimationFrame(anim); vel=null;\n  ptrs[e.pointerId]={x:e.offsetX,y:e.offsetY,t:performance.now(),x0:e.offsetX,y0:e.offsetY};\n  var ids=Object.keys(ptrs);\n  if(ids.length===1)gest={type:'pan',moved:false,t0:performance.now()};\n  else if(ids.length===2){ var a=ptrs[ids[0]],b=ptrs[ids[1]]; gest={type:'pinch',d:Math.hypot(a.x-b.x,a.y-b.y),moved:true}; }\n});\ncv.addEventListener('pointermove',function(e){\n  var p=ptrs[e.pointerId]; if(!p||!gest)return;\n  var dx=e.offsetX-p.x, dy=e.offsetY-p.y, now=performance.now();\n  if(gest.type==='pan'){\n    if(Math.hypot(e.offsetX-p.x0,e.offsetY-p.y0)>6)gest.moved=true;\n    if(gest.moved){ view.tx+=dx; view.ty+=dy; var dt=Math.max(1,now-p.t); vel={x:dx/dt,y:dy/dt,t:now}; queueDraw(); }\n  } else if(gest.type==='pinch'){\n    var ids=Object.keys(ptrs); p.x=e.offsetX; p.y=e.offsetY;\n    var a=ptrs[ids[0]],b=ptrs[ids[1]], d=Math.hypot(a.x-b.x,a.y-b.y);\n    var mx=(a.x+b.x)/2, my=(a.y+b.y)/2;\n    if(gest.mx!==undefined){ view.tx+=mx-gest.mx; view.ty+=my-gest.my; }\n    if(gest.d>0)zoomAt(d/gest.d,mx,my,false);\n    gest.d=d; gest.mx=mx; gest.my=my; return;\n  }\n  p.x=e.offsetX; p.y=e.offsetY; p.t=now;\n});\nfunction endPtr(e){\n  var p=ptrs[e.pointerId]; delete ptrs[e.pointerId];\n  if(!gest)return;\n  if(gest.type==='pan'&&!gest.moved&&p&&performance.now()-gest.t0<450){\n    var now=performance.now();\n    if(now-lastTap<300){ lastTap=0; zoomAt(2,e.offsetX,e.offsetY,true); haptic('light'); }\n    else { lastTap=now; tapAt(e.offsetX,e.offsetY); }\n  } else if(gest.type==='pan'&&vel&&performance.now()-vel.t<60&&!matchMedia('(prefers-reduced-motion: reduce)').matches){\n    var vx=vel.x*16, vy=vel.y*16;\n    (function glide(){ vx*=.92; vy*=.92; view.tx+=vx; view.ty+=vy; draw(true); if(Math.abs(vx)+Math.abs(vy)>.4)anim=requestAnimationFrame(glide); else { draw(); saveView(); } })();\n  }\n  if(Object.keys(ptrs).length===0){ if(gest.type!=='pan'||gest.moved){ draw(); saveView(); } gest=null; }\n  else if(gest.type==='pinch'){ var k=Object.keys(ptrs)[0]; ptrs[k].x0=ptrs[k].x; ptrs[k].y0=ptrs[k].y; gest={type:'pan',moved:true,t0:0}; }\n}\ncv.addEventListener('pointerup',endPtr); cv.addEventListener('pointercancel',endPtr);\ncv.addEventListener('wheel',function(e){ e.preventDefault(); zoomAt(Math.exp(-e.deltaY*.0022),e.offsetX,e.offsetY,false); saveView(); },{passive:false});\ndocument.addEventListener('gesturestart',function(e){ e.preventDefault(); });\nfunction nearest(px,py,maxD){\n  var best=null,bd=maxD*maxD;\n  city.st.forEach(function(s){ var p=toScreen(s.x,s.y), d=(p[0]-px)*(p[0]-px)+(p[1]-py)*(p[1]-py); if(d<bd){bd=d;best=s.i;} });\n  return best;\n}\nfunction tapAt(px,py){\n  var si=nearest(px,py,24);\n  if(si!==null){ haptic('light'); openStation(si); }\n  else if(focusSt!==null){ focusSt=null; draw(); }\n}\n$('zin').onclick=function(){ zoomAt(1.8,W/2,H/2,true); haptic('light'); };\n$('zout').onclick=function(){ zoomAt(1/1.8,W/2,H/2,true); haptic('light'); };\n$('zfit').onclick=function(){ haptic('light'); fitBox(route?route.box:city.all,24,true); };\n\n/* ---------- City switch ---------- */\nfunction renderCities(){\n  $('cities').innerHTML=CITY_LIST.map(function(c){ return '<button role=\"tab\" data-c=\"'+c.id+'\" class=\"'+(c.id===city.id?'on':'')+'\" aria-selected=\"'+(c.id===city.id)+'\">'+esc(c.name)+'</button>'; }).join('');\n}\n$('cities').addEventListener('click',function(e){ var b=e.target.closest('button'); if(!b||b.dataset.c===city.id)return; haptic('light'); setCity(b.dataset.c); });\nfunction setCity(id,keepSheet){\n  city=CITY_LIST.find(function(c){return c.id===id})||CITY_LIST[0]; S.city=city.id; save();\n  route=null; focusSt=null; showRouteCard(); renderCities(); setLegend();\n  // base scale: the busy middle fills the screen\n  var b=city.home, bw=b[2]-b[0];\n  baseS=(W-24)/bw;\n  var v=S.views[city.id];\n  if(v&&v.z){ view.s=baseS*v.z; view.tx=W/2-v.cx*view.s; view.ty=H/2-v.cy*view.s; draw(); }\n  else { view.s=baseS; view.tx=W/2-(b[0]+b[2])/2*baseS; view.ty=H/2-(b[1]+b[3])/2*baseS; draw(); }\n  if(!keepSheet&&curTab!=='map')openTab(curTab);\n}\nfunction setLegend(){\n  var t={london:'Tube, Elizabeth line and DLR',paris:'Métro lines 1–14',nyc:'Subway and Staten Island Railway'}[city.id];\n  $('legend').textContent=t+' · our own map from open data';\n}\n\n/* ---------- Sheets ---------- */\nvar curTab='map', sheetStack=[];\nfunction openSheet(title,html,opts){\n  opts=opts||{};\n  $('shTitle').textContent=title; $('shBody').innerHTML=html; $('shBody').scrollTop=0;\n  $('shBack').hidden=!opts.back; if(opts.back)$('shBack').textContent='‹ '+opts.back;\n  $('sheet').classList.add('open'); placeFab();\n  sheetStack.onBack=opts.onBack||null;\n}\nfunction closeSheet(){\n  $('sheet').classList.remove('open'); placeFab();\n  document.querySelectorAll('.tabs button').forEach(function(b){ b.classList.toggle('on',b.dataset.tab==='map'); }); curTab='map';\n}\nfunction placeFab(){ requestAnimationFrame(function(){ var c=sheetCover(); $('fab').style.bottom=(c+12)+'px'; $('fab').style.visibility=c?'hidden':''; $('legend').style.display=c?'none':''; }); }\n$('shX').onclick=function(){ haptic('light'); closeSheet(); };\n$('shBack').onclick=function(){ if(sheetStack.onBack)sheetStack.onBack(); };\n// drag the handle down to close\n(function(){ var y0=null, sh=$('sheet');\n  $('grab').addEventListener('pointerdown',function(e){ y0=e.clientY; sh.style.transition='none'; $('grab').setPointerCapture(e.pointerId); });\n  $('grab').addEventListener('pointermove',function(e){ if(y0===null)return; var d=Math.max(0,e.clientY-y0); sh.style.transform='translateY('+d+'px)'; });\n  function up(e){ if(y0===null)return; var d=e.clientY-y0; y0=null; sh.style.transition=''; sh.style.transform=''; if(d>90)closeSheet(); }\n  $('grab').addEventListener('pointerup',up); $('grab').addEventListener('pointercancel',up);\n})();\n$('tabs').addEventListener('click',function(e){ var b=e.target.closest('button'); if(!b)return; haptic('light'); openTab(b.dataset.tab); });\nfunction openTab(t){\n  curTab=t;\n  document.querySelectorAll('.tabs button').forEach(function(b){ b.classList.toggle('on',b.dataset.tab===t); });\n  if(t==='map')return closeSheet();\n  if(t==='lines')return showLines();\n  if(t==='route')return showRoute();\n  if(t==='status')return showStatus();\n}\nfunction chip(L,lg){ return '<span class=\"chip'+(lg?' lg':'')+'\" style=\"background:'+L.color+';color:'+L.text+'\">'+esc(L.chip)+'</span>'; }\nfunction chipsFor(si,except){ return city.st[si].lines.filter(function(li){return li!==except}).map(function(li){return chip(city.lines[li])}).join(''); }\n\n/* ---------- Lines ---------- */\nfunction showLines(){\n  var h=city.lines.map(function(L){\n    var n={}; L.pats.forEach(function(p){p.forEach(function(s){n[s]=1})});\n    return '<div class=\"row\" data-l=\"'+L.i+'\">'+chip(L,true)+'<div class=\"t\"><b>'+esc(L.name)+'</b><span>'+Object.keys(n).length+' stations'+(L.pats.length>1?' · '+L.pats.length+' routes':'')+'</span></div><span class=\"chev\">›</span></div>';\n  }).join('');\n  openSheet(city.name+' lines',h);\n  $('shBody').onclick=function(e){ var r=e.target.closest('[data-l]'); if(r){ haptic('light'); showLine(+r.dataset.l,0); } };\n}\nfunction patName(L,pi){\n  var p=L.pats[pi], a=city.st[p[0]].name, b=city.st[p[p.length-1]].name;\n  var same=L.pats.filter(function(q){ var x=city.st[q[0]].name,y=city.st[q[q.length-1]].name; return (x===a&&y===b)||(x===b&&y===a); });\n  var via='';\n  if(same.length>1){ var others={}; same.forEach(function(q){ if(q!==p)q.forEach(function(s){others[s]=1}); });\n    var u=p.filter(function(s){return !others[s]}); if(u.length)via=' via '+city.st[u[Math.floor(u.length/2)]].name; }\n  return a+' – '+b+via;\n}\nfunction showLine(li,pi){\n  var L=city.lines[li], p=L.pats[pi];\n  var pats=L.pats.length>1?'<div class=\"pats\">'+L.pats.map(function(q,k){return '<button data-p=\"'+k+'\" class=\"'+(k===pi?'on':'')+'\">'+esc(patName(L,k))+'</button>'}).join('')+'</div>':'';\n  var col=lineColor(L);\n  var h=pats+'<div class=\"strip\" style=\"--lc:'+col+'\">'+p.map(function(si,k){\n    var s=city.st[si], ix=s.lines.length>1;\n    return '<div class=\"stop'+(ix?' ix':'')+(k===0||k===p.length-1?' term':'')+'\" data-s=\"'+si+'\"><span class=\"dot\"></span><span class=\"sn\">'+esc(s.name)+'</span>'+(ix?'<span class=\"chips\">'+chipsFor(si,li)+'</span>':'')+'</div>';\n  }).join('')+'</div>';\n  openSheet(L.name,h,{back:'Lines',onBack:showLines});\n  $('shBody').onclick=function(e){\n    var b=e.target.closest('[data-p]'); if(b){ haptic('light'); showLine(li,+b.dataset.p); return; }\n    var r=e.target.closest('[data-s]'); if(r){ haptic('light'); openStation(+r.dataset.s,{back:L.name,onBack:function(){showLine(li,pi)}}); }\n  };\n  // show the line on the map\n  var xs=p.map(function(s){return city.st[s].x}), ys=p.map(function(s){return city.st[s].y});\n  fitBox([Math.min.apply(null,xs),Math.min.apply(null,ys),Math.max.apply(null,xs),Math.max.apply(null,ys)],28,true);\n}\n\n/* ---------- Station ---------- */\nfunction openStation(si,opts){\n  var s=city.st[si]; focusSt=si;\n  var h='<div class=\"chips\" style=\"margin:2px 0 10px\">'+s.lines.map(function(li){return chip(city.lines[li],true)}).join('')+'</div>'+\n    '<div class=\"note\">'+(s.lines.length>1?'Change here between '+s.lines.length+' lines.':'On the '+esc(city.lines[s.lines[0]].name)+(city.id==='london'?' line':'')+'.')+'</div>'+\n    '<div class=\"acts2\"><button class=\"btn pri\" id=\"rFrom\">Route from here</button><button class=\"btn\" id=\"rTo\">Route to here</button></div>'+\n    '<div class=\"sec\">Lines</div>'+s.lines.map(function(li){ var L=city.lines[li];\n      return '<div class=\"row\" data-l=\"'+li+'\">'+chip(L)+'<div class=\"t\"><b>'+esc(L.name)+'</b><span>'+esc(towards(L,si))+'</span></div><span class=\"chev\">›</span></div>'; }).join('');\n  openSheet(s.name,h,opts);\n  $('rFrom').onclick=function(){ haptic('light'); R.from=si; if(R.to===si)R.to=null; openTab('route'); };\n  $('rTo').onclick=function(){ haptic('light'); R.to=si; if(R.from===si)R.from=null; openTab('route'); };\n  $('shBody').onclick=function(e){ var r=e.target.closest('[data-l]'); if(r){ haptic('light'); var li=+r.dataset.l, L=city.lines[li];\n    var pi=Math.max(0,L.pats.findIndex(function(p){return p.indexOf(si)>=0})); showLine(li,pi); } };\n  var sheetH=Math.min(H*.74,$('sheet').offsetHeight||H*.5);\n  var t={s:Math.max(view.s,baseS*2.2)}; t.tx=W/2-s.x*t.s; t.ty=(H-sheetH)/2-s.y*t.s;\n  animateTo(t,320);\n}\nfunction towards(L,si){\n  var ends={};\n  L.pats.forEach(function(p){ var k=p.indexOf(si); if(k<0)return; if(k>0)ends[city.st[p[0]].name]=1; if(k<p.length-1)ends[city.st[p[p.length-1]].name]=1; });\n  var e=Object.keys(ends); return e.length?'Towards '+e.slice(0,3).join(', ')+(e.length>3?'…':''):'';\n}\n\n/* ---------- Route planner ---------- */\nvar R={from:null,to:null,cityId:null};\nvar SPEED_M_PER_MIN=550, DWELL=.5, CHANGE={fast:5,few:25};\nfunction edgeMin(a,b){ var A=city.st[a],B=city.st[b]; return Math.hypot(A.x-B.x,A.y-B.y)*10/SPEED_M_PER_MIN+DWELL; }\n/* Dijkstra over (station, line): riding costs minutes, changing line costs a\n   penalty — small for \"fastest\", large for \"fewest changes\". */\nfunction plan(from,to,mode){\n  var pen=CHANGE[mode], dist={}, prev={}, heap=[];\n  function push(k,d){ heap.push([d,k]); var i=heap.length-1; while(i>0){ var j=(i-1)>>1; if(heap[j][0]<=heap[i][0])break; var t=heap[i];heap[i]=heap[j];heap[j]=t;i=j; } }\n  function pop(){ var top=heap[0], last=heap.pop(); if(heap.length){ heap[0]=last; var i=0; for(;;){ var l=2*i+1,r=l+1,m=i;\n    if(l<heap.length&&heap[l][0]<heap[m][0])m=l; if(r<heap.length&&heap[r][0]<heap[m][0])m=r; if(m===i)break; var t=heap[i];heap[i]=heap[m];heap[m]=t;i=m; } } return top; }\n  city.st[from].lines.forEach(function(li){ var k=from+':'+li; dist[k]=0; push(k,0); });\n  var endKey=null;\n  while(heap.length){\n    var cur=pop(), d=cur[0], k=cur[1]; if(d>dist[k])continue;\n    var parts=k.split(':'), s=+parts[0], li=+parts[1];\n    if(s===to){ endKey=k; break; }\n    var nb=city.lines[li].adj[s]||{};\n    for(var n in nb){ n=+n; var nk=n+':'+li, nd=d+edgeMin(s,n); if(dist[nk]===undefined||nd<dist[nk]-1e-9){ dist[nk]=nd; prev[nk]=k; push(nk,nd); } }\n    city.st[s].lines.forEach(function(l2){ if(l2===li)return; var nk=s+':'+l2, nd=d+pen; if(dist[nk]===undefined||nd<dist[nk]-1e-9){ dist[nk]=nd; prev[nk]=k; push(nk,nd); } });\n  }\n  if(!endKey)return null;\n  var path=[], k2=endKey; while(k2){ var q=k2.split(':'); path.unshift([+q[0],+q[1]]); k2=prev[k2]; }\n  // legs: runs on one line (a change is a repeated station)\n  var legs=[], cur2=null;\n  path.forEach(function(p){ if(!cur2||cur2.line!==p[1]){ if(cur2&&cur2.stops.length<2)legs.pop(); cur2={line:p[1],stops:[p[0]]}; legs.push(cur2); } else cur2.stops.push(p[0]); });\n  legs=legs.filter(function(g){return g.stops.length>1});\n  var mins=0, stops=0; legs.forEach(function(g){ for(var i=1;i<g.stops.length;i++){ mins+=edgeMin(g.stops[i-1],g.stops[i]); stops++; } });\n  mins+=Math.max(0,legs.length-1)*4;\n  var stSet={}, lineSet={}, xs=[], ys=[];\n  legs.forEach(function(g){ lineSet[g.line]=1; g.stops.forEach(function(s){ stSet[s]=1; xs.push(city.st[s].x); ys.push(city.st[s].y); }); });\n  return {from:from,to:to,legs:legs,mins:Math.round(mins),stops:stops,changes:legs.length-1,stSet:stSet,lineSet:lineSet,\n    box:[Math.min.apply(null,xs),Math.min.apply(null,ys),Math.max.apply(null,xs),Math.max.apply(null,ys)],mode:mode};\n}\nfunction legTowards(g){\n  var L=city.lines[g.line], a=g.stops[0], b=g.stops[1];\n  for(var i=0;i<L.pats.length;i++){ var p=L.pats[i], ia=p.indexOf(a), ib=p.indexOf(b);\n    if(ia>=0&&ib>=0&&Math.abs(ia-ib)===1)return city.st[ib>ia?p[p.length-1]:p[0]].name; }\n  return city.st[g.stops[g.stops.length-1]].name;\n}\nfunction fieldHTML(cls,si,ph){ return '<button class=\"field '+cls+'\" data-f=\"'+cls+'\"><i></i><span class=\"'+(si===null?'ph':'')+'\">'+esc(si===null?ph:city.st[si].name)+'</span></button>'; }\nfunction showRoute(){\n  if(R.cityId!==city.id){ if(R.cityId!==null){R.from=R.to=null;} R.cityId=city.id; }\n  var h='<div class=\"pick\">'+fieldHTML('from',R.from,'From')+fieldHTML('to',R.to,'To')+'<button class=\"swap\" id=\"swap\" aria-label=\"Swap\"><svg viewBox=\"0 0 24 24\"><path d=\"M7 4v16M7 20l-3-3M7 20l3-3M17 20V4M17 4l-3 3M17 4l3 3\"/></svg></button></div>'+\n    '<div class=\"seg\" id=\"mode\"><button data-m=\"fast\" class=\"'+(S.mode==='fast'?'on':'')+'\">Fastest</button><button data-m=\"few\" class=\"'+(S.mode==='few'?'on':'')+'\">Fewest changes</button></div><div id=\"rOut\"></div>';\n  openSheet('Plan a route',h);\n  $('shBody').onclick=function(e){\n    var f=e.target.closest('[data-f]'); if(f){ openSearch(f.dataset.f); return; }\n    var m=e.target.closest('[data-m]'); if(m){ S.mode=m.dataset.m; save(); haptic('light'); showRoute(); return; }\n    var rr=e.target.closest('[data-rr]'); if(rr){ var it=(rr.dataset.rr==='f'?S.favs:S.recents)[+rr.dataset.i]; if(it){ R.from=idxOf(it.a); R.to=idxOf(it.b); haptic('light'); showRoute(); } return; }\n    if(e.target.closest('#swap')){ var t=R.from; R.from=R.to; R.to=t; haptic('light'); showRoute(); return; }\n    if(e.target.closest('#rFav')){ toggleFav(); return; }\n    if(e.target.closest('#rShow')){ closeSheet(); fitBox(route.box,30,true); return; }\n  };\n  renderRouteOut();\n}\nfunction idxOf(name){ var s=city.st.find(function(x){return x.name===name}); return s?s.i:null; }\nfunction renderRouteOut(){\n  var out=$('rOut'); if(!out)return;\n  if(R.from===null||R.to===null||R.from===R.to){\n    route=null; showRouteCard(); draw();\n    var mine=function(list,tag){ return list.map(function(it,i){ return it.c===city.id?'<div class=\"row\" data-rr=\"'+tag+'\" data-i=\"'+i+'\"><div class=\"t\"><b>'+esc(it.a)+' → '+esc(it.b)+'</b></div><span class=\"chev\">›</span></div>':''; }).join(''); };\n    var f=mine(S.favs,'f'), r=mine(S.recents,'r');\n    out.innerHTML=(R.from!==null&&R.from===R.to?'<p class=\"note\" style=\"margin-top:12px\">Pick two different stations.</p>':'<p class=\"note\" style=\"margin-top:12px\">Choose where you are and where you’re going. Tap any station on the map to start from there.</p>')+\n      (f?'<div class=\"sec\">Saved</div>'+f:'')+(r?'<div class=\"sec\">Recent</div>'+r:'');\n    return;\n  }\n  var r1=plan(R.from,R.to,S.mode);\n  if(!r1){ out.innerHTML='<p class=\"note\" style=\"margin-top:12px\">No route found between these stations.</p>'; route=null; draw(); return; }\n  route=r1; showRouteCard(); remember();\n  var fav=S.favs.some(function(it){return it.c===city.id&&it.a===city.st[R.from].name&&it.b===city.st[R.to].name});\n  var h='<div class=\"sum\"><b>≈ '+r1.mins+' min</b><span>'+r1.stops+' stop'+(r1.stops===1?'':'s')+' · '+(r1.changes?r1.changes+' change'+(r1.changes>1?'s':''):'no changes')+'</span></div>'+\n    '<p class=\"note\">Time is an estimate from distance, not a timetable.</p><div class=\"legs\">';\n  r1.legs.forEach(function(g,gi){\n    var L=city.lines[g.line], col=lineColor(L), a=city.st[g.stops[0]], n=g.stops.length-1;\n    h+='<div class=\"leg\" style=\"--lc:'+col+'\"><span class=\"pin\"></span><div class=\"lt\">'+esc(a.name)+'</div>'+\n      '<div class=\"ld\">'+chip(L)+'<span>'+esc(L.name)+(city.id==='london'&&L.id!=='dlr'&&L.id!=='elizabeth'?' line':(L.id==='elizabeth'?' line':''))+' towards '+esc(legTowards(g))+'</span></div>'+\n      '<details><summary>'+n+' stop'+(n>1?'s':'')+'</summary><ol>'+g.stops.slice(1).map(function(s){return '<li>'+esc(city.st[s].name)+'</li>'}).join('')+'</ol></details></div>';\n    if(gi<r1.legs.length-1)h+='<div class=\"chg\">Change at '+esc(city.st[g.stops[n]].name)+'</div>';\n  });\n  var last=city.st[R.to];\n  h+='<div class=\"leg end\" style=\"--lc:'+COL['--bad']+'\"><span class=\"pin\" style=\"border-radius:4px\"></span><div class=\"lt\">'+esc(last.name)+'</div></div></div>'+\n    '<div class=\"acts2\"><button class=\"btn pri\" id=\"rShow\">Show on map</button><button class=\"btn star'+(fav?' on':'')+'\" id=\"rFav\">'+(fav?'★ Saved':'☆ Save')+'</button></div>';\n  out.innerHTML=h;\n  fitBox(r1.box,28,true);\n}\nfunction remember(){\n  var it={c:city.id,a:city.st[R.from].name,b:city.st[R.to].name};\n  S.recents=S.recents.filter(function(x){return !(x.c===it.c&&x.a===it.a&&x.b===it.b)}); S.recents.unshift(it); save();\n}\nfunction toggleFav(){\n  var it={c:city.id,a:city.st[R.from].name,b:city.st[R.to].name};\n  var i=S.favs.findIndex(function(x){return x.c===it.c&&x.a===it.a&&x.b===it.b});\n  if(i>=0)S.favs.splice(i,1); else S.favs.unshift(it);\n  save(); haptic('success'); toast(i>=0?'Removed from saved':'Saved'); renderRouteOut();\n}\nfunction showRouteCard(){\n  var c=$('rcard');\n  if(!route){ c.classList.remove('show'); return; }\n  $('rcT').textContent=city.st[route.from].name+' → '+city.st[route.to].name;\n  $('rcS').textContent='≈ '+route.mins+' min · '+(route.changes?route.changes+' change'+(route.changes>1?'s':''):'direct');\n  c.classList.add('show');\n}\n$('rcOpen').onclick=function(){ haptic('light'); openTab('route'); };\n$('rcClear').onclick=function(){ haptic('light'); route=null; R.from=R.to=null; showRouteCard(); draw(); if(curTab==='route')showRoute(); };\n\n/* ---------- Search ---------- */\nvar searchFor=null;\nfunction openSearch(forWhat){\n  searchFor=forWhat; $('q').value=''; $('search').classList.add('open');\n  $('q').placeholder=forWhat==='from'?'Where from?':(forWhat==='to'?'Where to?':'Find a station in '+city.name);\n  renderResults(''); setTimeout(function(){ $('q').focus(); },60);\n}\nfunction closeSearch(){ $('search').classList.remove('open'); $('q').blur(); }\nfunction renderResults(q){\n  var k=fold(q), list;\n  if(!k){ list=city.st.slice().sort(function(a,b){return b.lines.length-a.lines.length||a.name.localeCompare(b.name)}).slice(0,24); }\n  else {\n    list=city.st.filter(function(s){ return s.key.indexOf(k)>=0; })\n      .sort(function(a,b){ var sa=a.key.indexOf(k)===0?0:(a.key.indexOf(' '+k)>=0?1:2), sb=b.key.indexOf(k)===0?0:(b.key.indexOf(' '+k)>=0?1:2); return sa-sb||b.lines.length-a.lines.length||a.name.localeCompare(b.name); }).slice(0,40);\n  }\n  $('qRes').innerHTML=(k?'':'<div class=\"stitle\">Busiest stations</div>')+(list.length?list.map(function(s){\n    return '<div class=\"row\" data-s=\"'+s.i+'\"><div class=\"t\"><b>'+esc(s.name)+'</b></div><span class=\"chips\">'+s.lines.slice(0,6).map(function(li){return chip(city.lines[li])}).join('')+(s.lines.length>6?'<span class=\"chip\" style=\"background:var(--chip)\">+'+(s.lines.length-6)+'</span>':'')+'</span></div>';\n  }).join(''):'<p class=\"note\" style=\"margin-top:16px\">No station called “'+esc(q)+'” in '+esc(city.name)+'.</p>');\n}\n$('q').addEventListener('input',function(){ renderResults($('q').value); });\n$('q').addEventListener('keydown',function(e){ if(e.key==='Enter'){ var f=$('qRes').querySelector('[data-s]'); if(f)f.click(); } if(e.key==='Escape')closeSearch(); });\n$('qCancel').onclick=closeSearch;\n$('qRes').addEventListener('click',function(e){\n  var r=e.target.closest('[data-s]'); if(!r)return; var si=+r.dataset.s; haptic('light'); closeSearch();\n  if(searchFor==='from'){ R.from=si; showRoute(); }\n  else if(searchFor==='to'){ R.to=si; showRoute(); }\n  else openStation(si);\n});\n$('findBtn').onclick=function(){ haptic('light'); openSearch('find'); };\n\n/* ---------- Live status ---------- */\nvar statusCache={};\nfunction getJSON(url){\n  if(window.myllmFetch)return window.myllmFetch(url,{headers:{accept:'application/json'}}).then(function(r){ if(!r||!r.ok)throw new Error('HTTP '+(r&&r.status)); return JSON.parse(r.body); });\n  return Promise.reject(new Error('Live status needs MyLLM'));\n}\nfunction showStatus(){\n  var cid=city.id;\n  if(cid==='paris'){ openSheet('Paris status','<p class=\"note\" style=\"margin-top:4px\">Live line status isn’t available here for Paris. The map and route planner work fully offline.</p>'+aboutLink()); bindAbout(); return; }\n  openSheet(city.name+' status','<div class=\"skel\"></div><div class=\"skel\" style=\"width:70%\"></div><div class=\"skel\" style=\"width:85%\"></div>');\n  var c=statusCache[cid];\n  if(c&&Date.now()-c.t<120000){ renderStatus(cid,c.d); return; }\n  var url=cid==='london'?'https://api.tfl.gov.uk/Line/Mode/tube,elizabeth-line,dlr/Status':'https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/camsys%2Fsubway-alerts.json';\n  getJSON(url).then(function(d){ statusCache[cid]={t:Date.now(),d:d}; if(city.id===cid&&curTab==='status')renderStatus(cid,d); })\n  .catch(function(){ if(city.id!==cid||curTab!=='status')return;\n    $('shBody').innerHTML='<p class=\"note\" style=\"margin-top:4px\">Couldn’t get live status just now — you may be offline. The map and route planner work without a connection.</p><div class=\"acts2\"><button class=\"btn\" id=\"stRetry\">Try again</button></div>'+aboutLink();\n    $('stRetry').onclick=function(){ haptic('light'); showStatus(); }; bindAbout(); });\n}\nfunction sev(t){ t=(t||'').toLowerCase(); if(/good service|no issues/.test(t))return 'good'; if(/suspend|closed|closure|not running|no service/.test(t))return 'bad'; return 'warn'; }\nfunction renderStatus(cid,d){\n  var h='';\n  if(cid==='london'){\n    var byId={}; (d||[]).forEach(function(x){ byId[x.id]=x; });\n    var bad=0;\n    h=city.lines.map(function(L){\n      var x=byId[L.id==='elizabeth'?'elizabeth':L.id]; if(!x)return '';\n      var sts=(x.lineStatuses||[]), main=sts[0]||{}, t=main.statusSeverityDescription||'Unknown', c=sev(t);\n      if(c!=='good')bad++;\n      var why=sts.map(function(s){return s.reason}).filter(Boolean)[0]||'';\n      return '<div class=\"st-row\">'+chip(L)+'<div class=\"t\"><b class=\"'+c+'\">'+esc(t)+'</b>'+(why?'<p class=\"clamp\">'+esc(why)+'</p>':'')+'</div></div>';\n    }).join('');\n    h='<p class=\"note\">'+(bad?bad+' line'+(bad>1?'s':'')+' with problems.':'Good service on every line.')+' Updated '+new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})+'.</p>'+h;\n  } else {\n    var now=Date.now()/1000, per={};\n    (d&&d.entity||[]).forEach(function(en){ var a=en.alert; if(!a)return;\n      var act=(a.active_period||[]).some(function(p){ return (!p.start||p.start<=now)&&(!p.end||p.end>=now); }); if(!act&&(a.active_period||[]).length)return;\n      var hd=((a.header_text||{}).translation||[]).find(function(t){return t.language==='en'})||((a.header_text||{}).translation||[])[0];\n      var type=(a['transit_realtime.mercury_alert']||{}).alert_type||'';\n      (a.informed_entity||[]).forEach(function(ie){ if(!ie.route_id)return; (per[ie.route_id]=per[ie.route_id]||[]).push({t:type,h:hd?hd.text:''}); }); });\n    var bad=0;\n    h=city.lines.map(function(L){\n      var rid=L.id.indexOf('·')>0?L.id.split('·')[1]:(L.id==='S'?'GS':(L.id==='SIR'?'SI':L.id));\n      var list=per[rid]||[]; var uniq=[]; list.forEach(function(x){ if(uniq.every(function(u){return u.h!==x.h}))uniq.push(x); });\n      if(uniq.length)bad++;\n      var head=uniq.length?(uniq[0].t||'Service change'):'Good service', c=uniq.length?sev(head):'good';\n      return '<div class=\"st-row\">'+chip(L)+'<div class=\"t\"><b class=\"'+c+'\">'+esc(head)+(uniq.length>1?' · '+uniq.length+' alerts':'')+'</b>'+(uniq.length?'<p class=\"clamp\">'+esc(uniq[0].h.replace(/\\[[^\\]]+\\]/g,function(m){return m.slice(1,-1)}))+'</p>':'')+'</div></div>';\n    }).join('');\n    h='<p class=\"note\">'+(bad?bad+' line'+(bad>1?'s':'')+' with alerts right now.':'No alerts right now.')+' Updated '+new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})+'.</p>'+h;\n  }\n  $('shBody').innerHTML=h+aboutLink(); bindAbout();\n}\nfunction aboutLink(){ return '<div class=\"sec\">About</div><div class=\"row\" id=\"aboutRow\"><div class=\"t\"><b>Data sources and licences</b><span>Our own map, not an official diagram</span></div><span class=\"chev\">›</span></div>'; }\nfunction bindAbout(){ var a=$('aboutRow'); if(a)a.onclick=function(){ haptic('light'); showAbout(); }; }\nfunction showAbout(){\n  var h='<p class=\"note\">Metro Maps draws its own geographic map from open data: real station positions, joined in stop order. It is not an official map and is not affiliated with or endorsed by Transport for London, RATP or Île-de-France Mobilités, or the Metropolitan Transportation Authority.</p>'+\n    '<div class=\"sec\">London</div><p class=\"note\">Powered by TfL Open Data. Contains OS data © Crown copyright and database rights 2026. Stations and routes for the Tube, Elizabeth line and DLR; live status from the TfL Unified API.</p>'+\n    '<div class=\"sec\">Paris</div><p class=\"note\">© OpenStreetMap contributors. Métro stations and lines from OpenStreetMap, available under the Open Database License (ODbL 1.0); the Paris data in this app is ODbL.</p>'+\n    '<div class=\"sec\">New York</div><p class=\"note\">Subway and Staten Island Railway stations and routes from the MTA New York City Transit GTFS feed; live alerts from the MTA’s public GTFS alerts feed. Data provided by the MTA under its data feed terms.</p>'+\n    '<div class=\"sec\">Rivers</div><p class=\"note\">© OpenStreetMap contributors, ODbL.</p>'+\n    '<div class=\"sec\">Good to know</div><p class=\"note\">Journey times are estimates from distance. Service patterns change; check live status and station signs before you travel. Everything except live status works offline.</p>';\n  openSheet('About Metro Maps',h);\n}\n$('aboutBtn').onclick=function(){ haptic('light'); showAbout(); };\n\n/* ---------- Toast ---------- */\nvar tt; function toast(m){ var t=$('toast'); t.textContent=m; t.classList.add('show'); clearTimeout(tt); tt=setTimeout(function(){t.classList.remove('show')},1500); }\n\n/* ---------- Boot ---------- */\nreadColors();\nDARK.addEventListener&&DARK.addEventListener('change',function(){ readColors(); draw(); });\nif(window.ResizeObserver)new ResizeObserver(function(){ resize(); placeFab(); }).observe(stage);\naddEventListener('resize',function(){ resize(); placeFab(); });\nresize(); renderCities();\nload(function(){ setCity(S.city,true); });\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes. This page\n   pads its own top by env(safe-area-inset-top), so the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    var sp = document.querySelector(\".imm-safe\"); if (sp) sp.style.height = \"0px\";\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script></body></html>\n", "kind": "html", "iconSymbol": "tram.fill", "iconColor": "red"}