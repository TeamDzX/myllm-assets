{"name": "Metro Maps", "html": "<!doctype html>\n<!--\n  Metro Maps — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no\">\n<title>Metro Maps</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"8ec18962f8\";color-scheme:light dark;\n  --bg:#f4f5f8; --map:#f7f7f4; --surface:#ffffff; --surface2:#f0f1f5; --ink:#15171c; --muted:#6c7280; --faint:#a3a8b3;\n  --line:rgba(20,24,32,.09); --chip:rgba(20,24,32,.06); --acc:#2f6bff; --acc2:#7a4dff; --good:#1f9d55; --warn:#d98200; --bad:#d6342c;\n  --water:#d3e6f5; --shadow:0 10px 30px rgba(20,24,40,.16); --font:-apple-system,system-ui,\"Segoe UI\",sans-serif; }\n@media (prefers-color-scheme:dark){ :root{\n  --bg:#0c0e13; --map:#10131a; --surface:#181b23; --surface2:#20242e; --ink:#eef0f4; --muted:#8f96a3; --faint:#5b6170;\n  --line:rgba(255,255,255,.08); --chip:rgba(255,255,255,.07); --acc:#5b8cff; --acc2:#9a7bff; --good:#3ecf7c; --warn:#ffb020; --bad:#ff6259;\n  --water:#15263a; --shadow:0 12px 34px rgba(0,0,0,.5); } }\n*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nhtml,body{height:100%;overflow:hidden;overscroll-behavior:none}\nbody{font-family:var(--font);color:var(--ink);background:var(--bg);height:100vh;height:100dvh;display:flex;flex-direction:column;\n  padding:env(safe-area-inset-top) env(safe-area-inset-right) 0 env(safe-area-inset-left);-webkit-user-select:none;user-select:none}\nbutton{font:inherit;color:inherit;border:0;background:none;cursor:pointer}\ninput{font:inherit;color:inherit}\n\n/* Header */\n.head{display:flex;align-items:center;gap:10px;padding:8px 14px 6px;flex-shrink:0}\n.tile{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;flex-shrink:0;\n  background:linear-gradient(145deg,var(--acc),var(--acc2));box-shadow:0 4px 12px rgba(60,90,255,.3)}\n.tile svg{width:20px;height:20px;color:#fff}\n.ht{min-width:0;flex:1}\n.ht h1{font-size:17px;line-height:1.3;font-weight:650;letter-spacing:-.2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.acts{display:flex;gap:8px;align-items:center}\n.hbtn{height:36px;min-width:36px;padding:0 9px;border-radius:11px;background:var(--chip);display:grid;place-items:center;transition:transform .12s}\n.hbtn:active{transform:scale(.93)}\n.hbtn svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}\n\n/* City switcher */\n.cities{display:flex;gap:4px;margin:2px 14px 8px;padding:3px;border-radius:12px;background:var(--chip);flex-shrink:0}\n.cities button{flex:1;height:32px;border-radius:9px;font-size:14px;line-height:1.3;font-weight:600;color:var(--muted);transition:background .2s,color .2s}\n.cities button.on{background:var(--surface);color:var(--ink);box-shadow:0 1px 4px rgba(0,0,0,.12)}\n\n/* Map stage */\n.stage{position:relative;flex:1 1 auto;min-height:0;overflow:hidden;background:var(--map);border-top:1px solid var(--line)}\ncanvas#map{position:absolute;inset:0;width:100%;height:100%;touch-action:none;display:block}\n.fab{position:absolute;right:12px;display:flex;flex-direction:column;gap:8px;z-index:2;transition:bottom .3s cubic-bezier(.2,.8,.2,1)}\n.fab button{width:42px;height:42px;border-radius:13px;background:var(--surface);box-shadow:var(--shadow);display:grid;place-items:center}\n.fab button:active{transform:scale(.93)}\n.fab svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}\n.legend{transition:opacity .4s;position:absolute;left:12px;bottom:12px;font-size:11px;line-height:1.35;color:var(--muted);background:color-mix(in srgb,var(--surface) 85%,transparent);\n  padding:5px 8px;border-radius:8px;z-index:1;pointer-events:none;max-width:60%}\n.rcard{position:absolute;left:12px;right:12px;top:10px;z-index:3;background:var(--surface);border-radius:16px;box-shadow:var(--shadow);\n  padding:10px 12px;display:none;align-items:center;gap:10px}\n.rcard.show{display:flex}\n.rcard .rt{flex:1;min-width:0}\n.rcard .rt b{display:block;font-size:14px;line-height:1.35;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.rcard .rt span{font-size:12.5px;line-height:1.35;color:var(--muted)}\n.rcard button{font-size:13px;font-weight:600;color:var(--acc);padding:6px 8px}\n\n/* Tab bar */\n.tabs{display:flex;flex-shrink:0;background:var(--surface);border-top:1px solid var(--line);padding:6px 6px calc(6px + env(safe-area-inset-bottom))}\n.tabs button{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;padding:4px 0;color:var(--muted);font-size:11px;line-height:1.3;font-weight:600;border-radius:10px}\n.tabs button svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}\n.tabs button.on{color:var(--acc)}\n\n/* Sheets */\n.sheet{position:absolute;left:0;right:0;bottom:0;z-index:5;background:var(--surface);border-radius:20px 20px 0 0;box-shadow:0 -8px 30px rgba(0,0,0,.18);\n  display:flex;flex-direction:column;max-height:74%;transform:translateY(105%);transition:transform .32s cubic-bezier(.2,.8,.2,1);visibility:hidden}\n.sheet.open{transform:none;visibility:visible}\n.grab{height:22px;flex-shrink:0;display:grid;place-items:center;cursor:grab}\n.grab::before{content:\"\";width:38px;height:5px;border-radius:3px;background:var(--faint);opacity:.6}\n.sh{display:flex;align-items:center;gap:10px;padding:0 16px 8px;flex-shrink:0}\n.sh h2{flex:1;font-size:19px;line-height:1.3;font-weight:700;letter-spacing:-.3px;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.sh .x{width:30px;height:30px;border-radius:50%;background:var(--chip);display:grid;place-items:center;flex-shrink:0}\n.sh .x svg{width:13px;height:13px;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.sh .back{font-size:15px;color:var(--acc);font-weight:600;padding:4px 2px;flex-shrink:0}\n.sb{overflow-y:auto;-webkit-overflow-scrolling:touch;padding:0 16px 18px;flex:1 1 auto;min-height:0;-webkit-user-select:text;user-select:text}\n.note{font-size:13px;line-height:1.45;color:var(--muted)}\n.sec{font-size:12px;line-height:1.4;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:var(--muted);margin:14px 0 6px}\n\n/* Chips */\n.chip{display:inline-flex;align-items:center;justify-content:center;min-width:24px;height:22px;padding:0 7px;border-radius:6px;font-size:12px;line-height:1;\n  font-weight:700;white-space:nowrap;flex-shrink:0}\n.chip.lg{height:30px;min-width:34px;font-size:14px;border-radius:8px;padding:0 10px}\n.chips{display:flex;flex-wrap:wrap;gap:5px}\n\n/* Rows */\n.row{display:flex;align-items:center;gap:12px;padding:11px 2px;border-bottom:1px solid var(--line);cursor:pointer;min-height:48px}\n.row:last-child{border-bottom:0}\n.row:active{background:var(--chip)}\n.row .t{flex:1;min-width:0}\n.row .t b{display:block;font-size:15.5px;line-height:1.35;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.row .t span{display:block;font-size:13px;line-height:1.4;color:var(--muted)}\n.row .chev{color:var(--faint);font-size:18px}\n\n/* Line strip */\n.pats{display:flex;gap:6px;overflow-x:auto;padding:2px 0 8px;scrollbar-width:none}\n.pats::-webkit-scrollbar{display:none}\n.pats button{flex-shrink:0;font-size:13px;line-height:1.3;padding:7px 11px;border-radius:999px;background:var(--chip);color:var(--muted);font-weight:600}\n.pats button.on{background:var(--ink);color:var(--surface)}\n.strip{position:relative;padding:4px 0 8px}\n.stop{position:relative;display:flex;align-items:center;gap:12px;min-height:44px;padding:4px 0 4px 44px;cursor:pointer}\n.stop::before{content:\"\";position:absolute;left:17px;top:0;bottom:0;width:8px;background:var(--lc)}\n.stop:first-child::before{top:50%}\n.stop:last-child::before{bottom:50%}\n.stop .dot{position:absolute;left:13px;top:50%;width:16px;height:16px;margin-top:-8px;border-radius:50%;background:var(--surface);border:3px solid var(--lc)}\n.stop.ix .dot{border-color:var(--ink);width:18px;height:18px;margin-top:-9px;left:12px}\n.stop .sn{flex:1;min-width:0;font-size:15px;line-height:1.35}\n.stop.term .sn{font-weight:700}\n.stop .chips{justify-content:flex-end;max-width:52%}\n\n/* Route */\n.pick{display:flex;flex-direction:column;gap:8px;position:relative}\n.field{display:flex;align-items:center;gap:10px;height:48px;border-radius:13px;background:var(--surface2);padding:0 12px;text-align:left;width:100%}\n.field i{width:12px;height:12px;border-radius:50%;flex-shrink:0;border:3px solid var(--acc)}\n.field.to i{border-radius:3px;border-color:var(--bad)}\n.field span{flex:1;min-width:0;font-size:15.5px;line-height:1.35;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.field span.ph{color:var(--faint)}\n.swap{position:absolute;right:10px;top:50%;margin-top:-17px;width:34px;height:34px;border-radius:50%;background:var(--surface);box-shadow:0 2px 8px rgba(0,0,0,.15);display:grid;place-items:center;z-index:1}\n.swap svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}\n.seg{display:flex;gap:4px;margin:10px 0 4px;padding:3px;border-radius:11px;background:var(--chip)}\n.seg button{flex:1;height:32px;border-radius:8px;font-size:13.5px;line-height:1.3;font-weight:600;color:var(--muted)}\n.seg button.on{background:var(--surface);color:var(--ink);box-shadow:0 1px 4px rgba(0,0,0,.12)}\n.sum{display:flex;align-items:baseline;gap:10px;margin:12px 0 4px}\n.sum b{font-size:28px;line-height:1.2;font-weight:700;letter-spacing:-.5px}\n.sum span{font-size:14px;line-height:1.4;color:var(--muted)}\n.legs{position:relative;margin-top:6px}\n.leg{position:relative;padding:8px 0 8px 40px}\n.leg::before{content:\"\";position:absolute;left:14px;top:22px;bottom:-8px;width:6px;border-radius:3px;background:var(--lc)}\n.leg.end::before{display:none}\n.leg .pin{position:absolute;left:8px;top:10px;width:18px;height:18px;border-radius:50%;background:var(--surface);border:4px solid var(--lc)}\n.leg .lt{font-size:15.5px;line-height:1.35;font-weight:650}\n.leg .ld{font-size:13.5px;line-height:1.45;color:var(--muted);margin-top:3px;display:flex;align-items:center;gap:6px;flex-wrap:wrap}\n.leg details{margin-top:4px}\n.leg summary{font-size:13px;line-height:1.4;color:var(--acc);cursor:pointer;list-style:none}\n.leg summary::-webkit-details-marker{display:none}\n.leg ol{list-style:none;margin:4px 0 0;font-size:13.5px;line-height:1.6;color:var(--muted)}\n.chg{font-size:13px;line-height:1.4;color:var(--muted);padding:2px 0 2px 40px}\n.acts2{display:flex;gap:8px;margin-top:14px}\n.btn{flex:1;height:44px;border-radius:12px;background:var(--chip);font-size:14.5px;line-height:1.3;font-weight:600}\n.btn.pri{background:linear-gradient(145deg,var(--acc),var(--acc2));color:#fff}\n.star.on{color:#f5b301}\n\n/* Status */\n.st-row{display:flex;align-items:flex-start;gap:12px;padding:10px 0;border-bottom:1px solid var(--line)}\n.st-row:last-child{border-bottom:0}\n.st-row .t{flex:1;min-width:0}\n.st-row .t b{display:block;font-size:14.5px;line-height:1.35;font-weight:650}\n.st-row .t b.good{color:var(--good)} .st-row .t b.warn{color:var(--warn)} .st-row .t b.bad{color:var(--bad)}\n.st-row .t p{font-size:13px;line-height:1.45;color:var(--muted);margin-top:2px}\n.st-row .t p.clamp{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}\n.skel{height:14px;border-radius:7px;background:var(--chip);margin:14px 0;animation:pulse 1.2s ease-in-out infinite}\n@keyframes pulse{50%{opacity:.45}}\n\n/* Search overlay */\n.search{position:absolute;inset:0;z-index:8;background:var(--surface);display:none;flex-direction:column}\n.search.open{display:flex}\n.sbar{display:flex;align-items:center;gap:10px;padding:10px 14px;flex-shrink:0;border-bottom:1px solid var(--line)}\n.sbar input{flex:1;min-width:0;height:42px;border-radius:12px;border:0;background:var(--surface2);padding:0 14px;font-size:16px;line-height:1.3;outline:none;-webkit-user-select:text;user-select:text}\n.sbar button{font-size:15px;color:var(--acc);font-weight:600}\n.sres{flex:1;min-height:0;overflow-y:auto;padding:0 16px 20px}\n.stitle{font-size:12px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:var(--muted);margin:12px 0 2px}\n\n.toast{position:absolute;left:50%;top:14px;transform:translate(-50%,-10px);opacity:0;pointer-events:none;z-index:9;background:var(--ink);color:var(--surface);\n  font-size:13px;line-height:1.35;font-weight:600;padding:8px 13px;border-radius:10px;transition:.25s;max-width:86%;text-align:center}\n.toast.show{opacity:1;transform:translate(-50%,0)}\n\n@media (orientation:landscape) and (max-height:560px){\n  .cities{margin-bottom:6px} .cities button{height:28px}\n  .sheet{left:auto;right:10px;bottom:10px;top:10px;width:min(400px,52%);max-height:none;border-radius:18px}\n  .tabs{padding-top:4px} .tabs button{flex-direction:row;justify-content:center;gap:6px;font-size:12px}\n  .tabs button svg{width:19px;height:19px}\n}\n@media (prefers-reduced-motion:reduce){ .sheet,.fab{transition:none} .skel{animation:none} }\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:36px;height:36px;border-radius:11px;border:1px solid var(--line);\n  background:var(--chip);color:var(--ink);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active{transform:scale(.94)}\n.imm-acts svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style></head><body>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 18c3-6 5-8 8-8s5-2 8-6\"/><circle cx=\"4\" cy=\"18\" r=\"2\" fill=\"currentColor\"/><circle cx=\"12\" cy=\"10\" r=\"2.4\" fill=\"#fff\"/><circle cx=\"20\" cy=\"4\" r=\"2\" fill=\"currentColor\"/></svg></div>\n  <div class=\"ht\"><h1>Metro Maps</h1></div>\n  <div class=\"acts\">\n    <button class=\"hbtn\" id=\"findBtn\" aria-label=\"Find a station\"><svg viewBox=\"0 0 24 24\"><circle cx=\"11\" cy=\"11\" r=\"6.5\"/><path d=\"M20 20l-4.2-4.2\"/></svg></button>\n    <button class=\"hbtn\" id=\"aboutBtn\" aria-label=\"About and data sources\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.01\"/></svg></button>\n  </div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Metro Maps\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n\n<div class=\"cities\" id=\"cities\" role=\"tablist\"></div>\n\n<div class=\"stage\" id=\"stage\">\n  <canvas id=\"map\" role=\"img\" aria-label=\"Metro map\"></canvas>\n  <div class=\"rcard\" id=\"rcard\"><div class=\"rt\"><b id=\"rcT\"></b><span id=\"rcS\"></span></div><button id=\"rcOpen\">Steps</button><button id=\"rcClear\" aria-label=\"Clear route\">Clear</button></div>\n  <div class=\"fab\" id=\"fab\">\n    <button id=\"zin\" aria-label=\"Zoom in\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 6v12M6 12h12\"/></svg></button>\n    <button id=\"zout\" aria-label=\"Zoom out\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></svg></button>\n    <button id=\"zfit\" aria-label=\"Show the whole city\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5\"/></svg></button>\n  </div>\n  <div class=\"legend\" id=\"legend\"></div>\n  <div class=\"toast\" id=\"toast\"></div>\n\n  <div class=\"sheet\" id=\"sheet\" role=\"dialog\" aria-modal=\"false\">\n    <div class=\"grab\" id=\"grab\"></div>\n    <div class=\"sh\"><button class=\"back\" id=\"shBack\" hidden>‹ Lines</button><h2 id=\"shTitle\"></h2><button class=\"x\" id=\"shX\" aria-label=\"Close\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div>\n    <div class=\"sb\" id=\"shBody\"></div>\n  </div>\n\n  <div class=\"search\" id=\"search\">\n    <div class=\"sbar\"><input id=\"q\" type=\"search\" placeholder=\"Station name\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" enterkeyhint=\"search\"><button id=\"qCancel\">Cancel</button></div>\n    <div class=\"sres\" id=\"qRes\"></div>\n  </div>\n</div>\n\n<div class=\"tabs\" id=\"tabs\">\n  <button data-tab=\"map\" class=\"on\"><svg viewBox=\"0 0 24 24\"><path d=\"M9 4L3 6.5v13.5l6-2.5 6 2.5 6-2.5V4l-6 2.5z\"/><path d=\"M9 4v13.5M15 6.5V20\"/></svg>Map</button>\n  <button data-tab=\"lines\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 3v18M12 3v18M18 3v18\"/><circle cx=\"6\" cy=\"8\" r=\"1.6\" fill=\"currentColor\"/><circle cx=\"12\" cy=\"14\" r=\"1.6\" fill=\"currentColor\"/><circle cx=\"18\" cy=\"10\" r=\"1.6\" fill=\"currentColor\"/></svg>Lines</button>\n  <button data-tab=\"route\"><svg viewBox=\"0 0 24 24\"><circle cx=\"6\" cy=\"18\" r=\"2.4\"/><circle cx=\"18\" cy=\"6\" r=\"2.4\"/><path d=\"M8.2 17h6.3a3.5 3.5 0 0 0 0-7h-5a3.5 3.5 0 0 1 0-7h6.3\" transform=\"translate(0 1)\"/></svg>Route</button>\n  <button data-tab=\"status\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 12h4l3-7 4 14 3-7h4\"/></svg>Status</button>\n</div>\n\n<script>\n'use strict';\n/* Data: built from open data by verify/_tmp/metro_build.py — TfL Open Data (London),\n   © OpenStreetMap contributors, ODbL (Paris), MTA NYCT GTFS (New York). */\n/*DATA:BEGIN*/var CITIES=[{\"id\":\"london\",\"name\":\"London\",\"n\":[\"Baker Street\",\"Embankment\",\"Edgware Road\",\"Kilburn Park\",\"Lambeth North\",\"Maida Vale\",\"Oxford Circus\",\"Piccadilly Circus\",\"Regent's Park\",\"Warwick Avenue\",\"Charing Cross\",\"Elephant & Castle\",\"Harlesden\",\"Harrow & Wealdstone\",\"Kensal Green\",\"Kenton\",\"Marylebone\",\"North Wembley\",\"Paddington\",\"Queen's Park\",\"Stonebridge Park\",\"South Kenton\",\"Waterloo\",\"Willesden Junction\",\"Wembley Central\",\"Barkingside\",\"Buckhurst Hill\",\"Bethnal Green\",\"Chancery Lane\",\"Chigwell\",\"Debden\",\"East Acton\",\"Epping\",\"Fairlop\",\"Grange Hill\",\"Gants Hill\",\"Holborn\",\"Hanger Lane\",\"Hainault\",\"Holland Park\",\"Loughton\",\"Lancaster Gate\",\"Leyton\",\"Leytonstone\",\"Marble Arch\",\"Mile End\",\"North Acton\",\"Newbury Park\",\"Notting Hill Gate\",\"Northolt\",\"Perivale\",\"Queensway\",\"Redbridge\",\"Ruislip Gardens\",\"Roding Valley\",\"Snaresbrook\",\"St. Paul's\",\"South Woodford\",\"Theydon Bois\",\"White City\",\"Woodford\",\"Wanstead\",\"West Acton\",\"Bank\",\"Bond Street\",\"Ealing Broadway\",\"Greenford\",\"Liverpool Street\",\"Shepherd's Bush\",\"Stratford\",\"South Ruislip\",\"Tottenham Court Road\",\"West Ruislip\",\"Aldgate\",\"Barbican\",\"Bayswater\",\"Edgware Road\",\"Euston Square\",\"Goldhawk Road\",\"Great Portland Street\",\"Gloucester Road\",\"High Street Kensington\",\"Ladbroke Grove\",\"Latimer Road\",\"Monument\",\"Mansion House\",\"Royal Oak\",\"Shepherd's Bush Market\",\"St. James's Park\",\"South Kensington\",\"Sloane Square\",\"Temple\",\"Tower Hill\",\"Wood Lane\",\"Westbourne Park\",\"Blackfriars\",\"Cannon Street\",\"Hammersmith\",\"King's Cross & St Pancras International\",\"Victoria\",\"Westminster\",\"Farringdon\",\"Moorgate\",\"Acton Town\",\"Aldgate East\",\"Bromley-by-Bow\",\"Becontree\",\"Barons Court\",\"Bow Road\",\"Chiswick Park\",\"Dagenham East\",\"Dagenham Heathway\",\"Ealing Common\",\"Earl's Court\",\"East Ham\",\"Elm Park\",\"East Putney\",\"Fulham Broadway\",\"Hornchurch\",\"Plaistow\",\"Par