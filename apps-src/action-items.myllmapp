{"name": "Action Items", "kind": "html", "iconSymbol": "checklist", "iconColor": "blue", "html": "<!doctype html>\n<!--\n  Action Items — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Action Items</title>\n<style>:root{--build-id:\"85633847a5\";color-scheme:light dark; --h:204;}\n\n  /* Shared surface — the same block sits in Quick Todo, Action Items, Sprint\n     Planner and Risk & Decision Log, so the four read as one family. Each app\n     only sets its own hue. MyLLM's theme where it supplies one; the fallbacks\n     carry a dark set too, because a token-only page renders light in dark mode\n     on a build (or a platform) that sends no --myllm-* variables. */\n  :root{\n    --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n    --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,hsl(var(--h) 85% 52%));\n    --fill:rgba(118,118,128,.12); --good:#2aa84f; --warn:#e8890c; --bad:#ff453a; --h2:calc(var(--h) + 40);\n  }\n  @media (prefers-color-scheme:dark){ :root{\n    --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e); --ink:var(--myllm-text,#f2f2f7);\n    --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(118,118,128,.24); --good:#30d158; --warn:#ff9f0a;\n  } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    font-size:15.5px; line-height:1.35; max-width:600px; margin:0 auto; min-height:100dvh; -webkit-text-size-adjust:100%;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  svg{ width:1.25em; height:1.25em; flex-shrink:0; }\n  button{ font:inherit; color:inherit; border:none; background:none; }\n  button:active{ transform:scale(.96); }\n\n  .head{ display:flex; align-items:center; gap:11px; margin:2px 2px 14px; }\n  .head h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 46%), hsl(var(--h2) 58% 24%)); }\n  .head .tile{ width:36px; height:36px; border-radius:11px; font-size:16px; }\n  .sub{ font-size:13px; color:var(--muted); margin:-8px 2px 14px; }\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:20px 2px 9px;\n    display:flex; align-items:center; justify-content:space-between; gap:10px; min-height:20px; }\n  h2 button{ font-size:12.5px; font-weight:700; letter-spacing:0; text-transform:none; color:var(--acc); padding:6px 2px; margin:-6px 0; }\n  h2 .pts{ color:var(--ink); letter-spacing:0; text-transform:none; font-size:13px; font-variant-numeric:tabular-nums; }\n\n  /* Hero: the app's headline number on its own hue. */\n  .hero{ position:relative; overflow:hidden; border-radius:22px; padding:16px 16px 15px; color:#fff; margin-bottom:14px;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 46%), hsl(var(--h2) 58% 24%)); box-shadow:0 10px 28px hsl(var(--h) 60% 30% / .26); }\n  .hero .k{ font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.78; }\n  .hero .n{ font-size:44px; font-weight:800; letter-spacing:-.02em; line-height:1.08; font-variant-numeric:tabular-nums; }\n  .hero .s{ font-size:13px; opacity:.82; margin-top:1px; font-variant-numeric:tabular-nums; }\n  .hero .bar{ height:6px; border-radius:99px; background:rgba(255,255,255,.22); margin-top:12px; overflow:hidden; }\n  .hero .bar i{ display:block; height:100%; width:0; border-radius:99px; background:#fff; transition:width .3s cubic-bezier(.2,.8,.2,1); }\n  .hero .cols{ display:flex; gap:8px; } .hero .cols > div{ flex:1; min-width:0; }\n  .hero .cols .n{ font-size:32px; }\n  .hero .hbtn{ position:absolute; z-index:2; top:12px; right:12px; height:34px; padding:0 13px; border-radius:99px; font-size:12.5px; font-weight:700; color:#fff;\n    display:inline-flex; align-items:center; gap:6px; border:1px solid rgba(255,255,255,.22); background:rgba(255,255,255,.16);\n    -webkit-backdrop-filter:blur(18px); backdrop-filter:blur(18px); }\n  .hero .hbtn:disabled{ opacity:.45; }\n  .hero .marks{ display:flex; gap:6px; flex-wrap:wrap; margin-top:10px; }\n  .hero .marks span{ font-size:12px; font-weight:700; padding:4px 10px; border-radius:99px; background:rgba(255,255,255,.16); display:inline-flex; align-items:center; gap:6px; }\n  .hero .marks i{ width:7px; height:7px; border-radius:50%; background:currentColor; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  .card.list{ padding:2px 14px; }\n  input,textarea{ width:100%; font:inherit; font-size:16px; color:var(--ink); background:var(--surface); border:1px solid var(--line);\n    border-radius:12px; padding:11px 12px; -webkit-appearance:none; appearance:none; outline:none; }\n  input:focus,textarea:focus{ border-color:var(--acc); }\n  input::placeholder,textarea::placeholder{ color:var(--muted); }\n  textarea{ min-height:92px; resize:vertical; display:block; }\n  .card input,.card textarea{ background:var(--bg); }\n  .addrow{ display:flex; gap:8px; } .addrow input{ flex:1; min-width:0; }\n  label{ display:block; font-size:11.5px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:13px 2px 7px; }\n\n  .btn{ min-height:46px; padding:0 16px; border-radius:13px; font-size:15px; font-weight:700; display:inline-flex; align-items:center; justify-content:center; gap:7px; flex-shrink:0; }\n  .btn.pri{ background:var(--acc); color:#fff; } .btn.sec{ background:var(--fill); color:var(--ink); }\n  .btn.wide{ width:100%; } .btn:disabled{ opacity:.5; }\n  .btnrow{ display:flex; gap:8px; margin-top:10px; } .btnrow .btn.pri{ flex:1; }\n  .pills{ display:flex; gap:6px; }\n  .pills button{ flex:1; min-width:0; height:42px; border-radius:12px; border:1px solid var(--line); background:var(--bg); font-size:15px; font-weight:750; font-variant-numeric:tabular-nums; }\n  .pills button.on{ background:var(--acc); border-color:var(--acc); color:#fff; }\n  .seg{ display:flex; gap:3px; padding:3px; border-radius:13px; background:var(--fill); margin-bottom:14px; }\n  .seg button{ flex:1; height:38px; border-radius:10px; font-size:14px; font-weight:700; color:var(--muted); }\n  .seg button.on{ background:var(--surface); color:var(--ink); box-shadow:0 1px 4px rgba(0,0,0,.14); }\n\n  /* Rows: a check on the left where the thing can be done, the text, then what you can do to it. */\n  .row{ display:flex; align-items:center; gap:11px; padding:10px 0; border-bottom:1px solid var(--line); min-height:52px; }\n  .row:last-child{ border-bottom:none; }\n  .row.top{ align-items:flex-start; }\n  .row .body{ flex:1; min-width:0; }\n  .row .tx{ font-size:15.5px; line-height:1.35; overflow-wrap:break-word; }\n  .row.done .tx{ color:var(--muted); text-decoration:line-through; }\n  .ck{ width:26px; height:26px; border-radius:50%; border:2px solid var(--muted); opacity:.9; flex-shrink:0; display:flex; align-items:center; justify-content:center;\n    color:transparent; font-size:12px; transition:background .2s, border-color .2s; }\n  .row.top .ck{ margin-top:1px; }\n  .row.done .ck{ background:var(--acc); border-color:var(--acc); color:#fff; opacity:1; }\n  .ck.good{ } .row.done .ck.good{ background:var(--good); border-color:var(--good); }\n  .x{ width:36px; height:36px; margin:-4px -8px -4px -2px; border-radius:50%; flex-shrink:0; display:flex; align-items:center; justify-content:center; color:var(--muted); font-size:13px; }\n  .x:active{ color:var(--bad); background:var(--fill); }\n  .tags{ display:flex; gap:6px; flex-wrap:wrap; margin-top:6px; }\n  .tag{ display:inline-flex; align-items:center; gap:5px; font-size:12px; font-weight:700; padding:3px 9px; border-radius:99px; background:var(--fill); color:var(--muted); max-width:100%; }\n  .tag span{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  .tag svg{ font-size:10.5px; }\n  .tag.who{ background:hsl(140 60% 45% / .16); color:var(--good); } .tag.when{ background:hsl(32 90% 50% / .16); color:var(--warn); }\n\n  .empty{ text-align:center; padding:26px 12px 22px; }\n  .empty .tile{ width:54px; height:54px; border-radius:16px; font-size:24px; margin:0 auto 12px; }\n  .empty p{ font-size:14px; color:var(--muted); max-width:280px; margin:0 auto; }\n  .empty .btn{ margin-top:14px; min-height:40px; font-size:14px; }\n\n  .note{ font-size:13px; color:var(--muted); margin:10px 2px 0; min-height:18px; }\n  .note:empty{ display:none; }\n  .alert{ display:flex; align-items:flex-start; gap:10px; border-radius:16px; padding:12px 13px; margin-top:10px; font-size:13.5px; line-height:1.4;\n    background:hsl(4 90% 58% / .12); border:1px solid hsl(4 90% 58% / .28); }\n  .alert svg{ color:var(--bad); margin-top:1px; } .alert div{ flex:1; min-width:0; }\n  .alert button{ font-weight:750; color:var(--acc); font-size:13.5px; padding:2px 0 0 8px; flex-shrink:0; }\n  .alert.info{ background:var(--fill); border-color:transparent; } .alert.info svg{ color:var(--muted); }\n  .spin{ width:16px; height:16px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n  .skel{ height:14px; border-radius:7px; background:var(--fill); animation:skel 1.1s ease-in-out infinite alternate; }\n  @keyframes skel{ from{ opacity:.45; } to{ opacity:1; } }\n\n  @media (max-width:340px){ .hero .cols .k{ font-size:9.5px; letter-spacing:.05em; } .btn{ font-size:14px; padding:0 12px; } .row{ gap:8px; }\n    body{ padding-left:calc(12px + env(safe-area-inset-left)); padding-right:calc(12px + env(safe-area-inset-right)); }\n    .hero .n{ font-size:38px; } .hero .cols .n{ font-size:26px; } .pills{ gap:4px; } }\n  @media (min-width:768px){ body{ max-width:760px; } }\n  @media (prefers-reduced-motion:reduce){ .spin{ animation-duration:2.4s; } .skel{ animation:none; } .hero .bar i{ transition:none; } button:active{ transform:none; } }\n\n  /* this app's own colours, after the shared defaults so they win */\n  :root{ --acc:var(--myllm-accent,#0a7fe0); }\n  .skelcard .row{ min-height:58px; } .skelcard .body{ display:flex; flex-direction:column; gap:8px; }\n  .skelcard .ck{ border-color:var(--fill); background:var(--fill); }\n  @keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n  .myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n  .myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n  .myllm-ai-cog{width:16px;height:16px;border-radius:50%;border:2.4px solid #a78bfa;border-right-color:transparent;animation:myllmAiSpin .9s linear infinite;flex-shrink:0}\n  .myllm-ai-busy small{font-weight:400;opacity:.6}\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M5 12.6l4.6 4.6L19.2 7.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-plus\" viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-person\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"8\" r=\"4.2\" fill=\"currentColor\"/><path d=\"M4 20.2c0-4.1 3.6-6.6 8-6.6s8 2.5 8 6.6a.8.8 0 0 1-.8.8H4.8a.8.8 0 0 1-.8-.8z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-cal\" viewBox=\"0 0 24 24\"><path d=\"M7 2.8a1 1 0 0 1 1 1V5h8V3.8a1 1 0 0 1 2 0V5h.5A2.5 2.5 0 0 1 21 7.5v11a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 18.5v-11A2.5 2.5 0 0 1 5.5 5H6V3.8a1 1 0 0 1 1-1zM5 10.2v8.3c0 .3.2.5.5.5h13c.3 0 .5-.2.5-.5v-8.3z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-spark\" viewBox=\"0 0 24 24\"><path d=\"M10 2.5l1.9 5.6 5.6 1.9-5.6 1.9L10 17.5l-1.9-5.6L2.5 10l5.6-1.9zM18.5 14l.95 2.55L22 17.5l-2.55.95L18.5 21l-.95-2.55L15 17.5l2.55-.95z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-list\" viewBox=\"0 0 24 24\"><path d=\"M4.5 7.2l1.7 1.7 3-3.4M4.5 15.2l1.7 1.7 3-3.4M13 7.5h7M13 15.5h7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n</defs></svg>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\"></span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n<div class=\"head\"><div class=\"tile\"><svg><use href=\"#i-list\"/></svg></div><h1>Action Items</h1></div>\n<p class=\"sub\">Paste meeting notes — your AI pulls out the actions, owners &amp; due dates.</p>\n<div class=\"hero\">\n  <button class=\"hbtn\" id=\"clearBtn\"><svg><use href=\"#i-check\"/></svg>Clear done</button>\n  <div class=\"k\">Open actions</div>\n  <div class=\"n\" id=\"hN\">0</div>\n  <div class=\"s\" id=\"hS\">Nothing yet</div>\n  <div class=\"bar\"><i id=\"hBar\"></i></div>\n</div>\n<div class=\"card\">\n  <textarea id=\"notes\" placeholder=\"Paste or type meeting notes here…\"></textarea>\n  <div class=\"btnrow\">\n    <button class=\"btn pri\" id=\"ext\"><svg><use href=\"#i-spark\"/></svg><span>Extract action items</span></button>\n    <button class=\"btn sec\" id=\"clearNotes\">Clear</button>\n  </div>\n  <div class=\"note\" id=\"status\"></div>\n  <div id=\"alert\"></div>\n</div>\n<h2>Action items</h2>\n<div class=\"addrow\"><input id=\"manual\" placeholder=\"Add an item manually…\" enterkeyhint=\"done\" autocomplete=\"off\"><button class=\"btn pri\" id=\"addBtn\"><svg><use href=\"#i-plus\"/></svg>Add</button></div>\n<div id=\"list\" style=\"margin-top:12px\"></div>\n<script>\nfunction el(i){ return document.getElementById(i); }\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction haptic(k){ if (window.myllmHaptic) try { myllmHaptic(k || \"light\"); } catch(_){} }\nfunction load(k){ var s = window.myllmStorage; if (!s) return Promise.resolve(null); try { return s.getItem(k).catch(function(){ return null; }); } catch(_){ return Promise.resolve(null); } }\nfunction keep(k, v){ var s = window.myllmStorage; if (s) try { s.setItem(k, v).catch(function(){}); } catch(_){} }\nfunction esc(s){ return (s + \"\").replace(/[&<>\"]/g, function(c){ return {\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\"}[c]; }); }\nfunction icon(n){ return '<svg><use href=\"#i-' + n + '\"/></svg>'; }\nfunction emptyState(glyph, text, action, target){\n  return '<div class=\"empty\"><div class=\"tile\">' + icon(glyph) + '</div><p>' + text + '</p>' +\n    (action ? '<button class=\"btn sec\" data-focus=\"' + target + '\">' + icon(\"plus\") + action + '</button>' : '') + '</div>';\n}\ndocument.addEventListener(\"click\", function(e){\n  var b = e.target.closest && e.target.closest(\"[data-focus]\");\n  if (b){ var f = el(b.getAttribute(\"data-focus\")); if (f){ f.focus(); f.scrollIntoView({block:\"center\", behavior:\"smooth\"}); } }\n});\nvar items = [], busy = false;\nfunction save(){ keep(\"items\", JSON.stringify(items)); }\nvar seed = 1234;\n/* Ids come from a generator that restarts with the app, so a new item could be\n   handed an id an older one already has — and deleting one then took both. */\nfunction uid(){ var id; do { seed = (seed * 9301 + 49297) % 233280; id = \"t\" + seed + (items.length); } while (items.some(function(x){ return x.id === id; })); return id; }\nfunction mendIds(){ var seen = {}; items.forEach(function(x, i){ if (!x.id || seen[x.id]) x.id = \"t\" + i + \"m\" + Math.floor(Math.random() * 1e6); seen[x.id] = 1; }); }\n\n/* Labelled lines, not JSON — small models (Apple Intelligence) echo JSON\n   templates back verbatim. Echoed instructions are rejected and retried. */\nvar ECHO=/what needs to be done|who is responsible|when it is due|repeat this line|labelled line|leave blank/i;\nfunction cleanField(v){v=(v==null?'':String(v)).trim();return /^(none|n\\/a|na|-|–|unknown|tbd)$/i.test(v)?'':v}\nfunction parseItems(reply){\n  var out=[],got=false;\n  String(reply||'').split(/\\r?\\n/).forEach(function(raw){\n    var ln=raw.replace(/\\*\\*/g,'').trim();\n    var m=ln.match(/^[-*#>\\s]*(ITEMS?|TASKS?|ACTIONS?)\\s*\\d*\\s*[:：]\\s*(.*)$/i);\n    if(!m)return;\n    got=true;\n    var parts=m[2].split('|').map(function(p){return p.trim()});\n    var task=parts[0]||'',owner=cleanField(parts[1]),due=cleanField(parts[2]);\n    if(!task||ECHO.test(task)||ECHO.test(owner)||ECHO.test(due))return;\n    out.push({task:task,owner:owner,due:due});\n  });\n  if(!got){ // model answered in the old JSON shape — accept it\n    var s=reply.indexOf('['),e=reply.lastIndexOf(']');\n    if(s>=0&&e>s)try{\n      JSON.parse(reply.slice(s,e+1)).forEach(function(x){\n        if(x&&x.task)out.push({task:String(x.task),owner:cleanField(x.owner),due:cleanField(x.due)});\n      });\n    }catch(e2){}\n  }\n  if(!out.length)throw new Error('no action items came back');\n  return out;\n}\nfunction say(t){ el(\"status\").textContent = t || \"\"; }\nfunction alertBox(kind, text, retry){\n  var a = el(\"alert\");\n  if (!text){ a.innerHTML = \"\"; return; }\n  a.innerHTML = '<div class=\"alert' + (kind === \"info\" ? \" info\" : \"\") + '\">' + icon(kind === \"info\" ? \"info\" : \"warn\") + '<div>' + esc(text) + '</div>' +\n    (retry ? '<button id=\"retry\">Try again</button>' : '') + '</div>';\n  if (retry) el(\"retry\").onclick = extract;\n}\nfunction setBusy(on){\n  busy = on; var b = el(\"ext\"); b.disabled = on;\n  b.innerHTML = on ? '<i class=\"spin\"></i><span>Reading the notes…</span>' : icon(\"spark\") + '<span>Extract action items</span>';\n  render();\n}\nfunction extract(){\n  var notes=el('notes').value.trim();\n  alertBox();\n  if(!notes){say('Paste some notes first.');return}\n  if(!window.myllmAsk){say('');alertBox('info','This needs the latest MyLLM with “Allow apps to use the AI” enabled in Settings.');return}\n  setBusy(true);say('Reading the notes…');\n  var p='From these meeting notes, extract every action item. Reply with EXACTLY these labelled lines and nothing else:\\n'+\n    'ITEM: what needs to be done | who is responsible (or leave blank) | when it is due (or leave blank) — repeat this line for each action item\\n'+\n    'Notes:\\n'+notes;\n  myllmAsk(p).then(function(r){return parseItems(r||'')})\n  .catch(function(){return myllmAsk(p+'\\nIMPORTANT: fill each labelled line with real content — never repeat the instruction text.')\n    .then(function(r){return parseItems(r||'')})})\n  .then(function(got){\n    got.forEach(function(g){items.unshift({id:uid(),task:g.task,owner:g.owner,due:g.due,done:false})});\n    save();busy=false;say('Added '+got.length+' item'+(got.length>1?'s':'')+'.');haptic('success');\n  }).catch(function(err){say('');alertBox('err','Could not extract: '+err.message,true)})\n  .then(function(){setBusy(false)});\n}\nfunction addManual(){\n  var v=el('manual').value.trim();if(!v)return;\n  items.unshift({id:uid(),task:v,owner:'',due:'',done:false});el('manual').value='';save();render();haptic('light');\n}\nfunction toggle(id){var it=items.filter(function(x){return x.id===id})[0];if(it){it.done=!it.done;save();render();haptic('selection')}}\nfunction del(id){items=items.filter(function(x){return x.id!==id});save();render();haptic('light')}\nfunction clearDone(){items=items.filter(function(x){return !x.done});save();render();haptic('light')}\nfunction render(){\n  var L = el(\"list\"), done = items.filter(function(x){ return x.done; }).length, open = items.length - done;\n  el(\"hN\").textContent = open;\n  el(\"hS\").textContent = !items.length ? \"Nothing yet\" : open ? done + \" of \" + items.length + \" done\" : \"All \" + items.length + \" done\";\n  el(\"hBar\").style.width = (items.length ? Math.round(done / items.length * 100) : 0) + \"%\";\n  el(\"clearBtn\").disabled = !done;\n  L.innerHTML = \"\";\n  if (busy){\n    var sk = document.createElement(\"div\"); sk.className = \"card list skelcard\";\n    sk.innerHTML = [72, 54, 64].map(function(w){ return '<div class=\"row\"><div class=\"ck\"></div><div class=\"body\"><div class=\"skel\" style=\"width:' + w + '%\"></div><div class=\"skel\" style=\"width:' + (w - 34) + '%;height:10px\"></div></div></div>'; }).join(\"\");\n    L.appendChild(sk);\n  }\n  if (!items.length){ if (!busy) L.innerHTML = '<div class=\"card\">' + emptyState(\"list\", \"No action items yet. Paste some notes above, or add one by hand.\", \"Add an item\", \"manual\") + '</div>'; return; }\n  var card = document.createElement(\"div\"); card.className = \"card list\";\n  items.forEach(function(it){\n    var d = document.createElement(\"div\"); d.className = \"row top\" + (it.done ? \" done\" : \"\");\n    var meta = \"\";\n    if (it.owner) meta += '<span class=\"tag who\">' + icon(\"person\") + '<span>' + esc(it.owner) + '</span></span>';\n    if (it.due) meta += '<span class=\"tag when\">' + icon(\"cal\") + '<span>' + esc(it.due) + '</span></span>';\n    d.innerHTML = '<div class=\"ck\">' + icon(\"check\") + '</div>' +\n      '<div class=\"body\"><div class=\"tx\">' + esc(it.task) + '</div>' + (meta ? '<div class=\"tags\">' + meta + '</div>' : '') + '</div>' +\n      '<button class=\"x\" aria-label=\"Delete\">' + icon(\"x\") + '</button>';\n    d.querySelector(\".ck\").onclick = function(){ toggle(it.id); };\n    d.querySelector(\".tx\").onclick = function(){ toggle(it.id); };\n    d.querySelector(\".x\").onclick = function(){ del(it.id); };\n    card.appendChild(d);\n  });\n  L.appendChild(card);\n}\nel(\"ext\").onclick = extract;\nel(\"clearNotes\").onclick = function(){ el(\"notes\").value = \"\"; };\nel(\"clearBtn\").onclick = clearDone;\nel(\"addBtn\").onclick = addManual;\nel('manual').addEventListener('keydown',function(e){if(e.key==='Enter')addManual()});\nrender();\nload(\"items\").then(function(v){ if (v){ try { var a = JSON.parse(v); if (Array.isArray(a)) items = a; } catch(e){} } mendIds(); render();\n  if (!window.myllmAsk) alertBox(\"info\", \"Tip: manual add works offline; note-extraction needs AI enabled.\"); });\n</script></body></html>\n"}