{"name": "Action Items", "kind": "html", "iconSymbol": "checklist", "iconColor": "blue", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Action Items</title>\n<style>:root{color-scheme:light dark;--ac:#0a84ff}\n*{box-sizing:border-box}\nbody{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:18px 16px calc(28px + env(safe-area-inset-bottom));background:#f2f2f7;color:#111;-webkit-tap-highlight-color:transparent;max-width:820px;margin-left:auto;margin-right:auto}\n@media(prefers-color-scheme:dark){body{background:#000;color:#eee}.item,textarea,input,.seg{background:#1c1c1e}textarea,input{color:#eee;border-color:#3a3a3c}.seg{border-color:#2c2c2e}}\nh1{font-size:22px;margin:0 0 3px}\n.sub{font-size:13px;opacity:.6;margin:0 0 14px}\ntextarea{width:100%;min-height:96px;padding:12px;border:1px solid #d1d1d6;border-radius:12px;font-size:15px;background:#fff;font-family:inherit;resize:vertical}\n.rowb{display:flex;gap:8px;margin-top:8px}\nbutton{border:0;border-radius:12px;font-size:15px;font-weight:600}\n.act{background:var(--ac);color:#fff;padding:12px 16px}\n.act:disabled{opacity:.45}\n.ghost{background:#e5e5ea;color:inherit;padding:12px 16px}\n@media(prefers-color-scheme:dark){.ghost{background:#2c2c2e}}\n#status{font-size:13px;opacity:.65;min-height:18px;margin:8px 2px}\nh2{font-size:14px;text-transform:uppercase;letter-spacing:.02em;opacity:.5;margin:20px 2px 8px;display:flex;justify-content:space-between;align-items:center}\nh2 button{background:none;color:var(--ac);font-size:13px;padding:2px}\n.item{background:#fff;border-radius:14px;padding:12px 14px;margin-bottom:8px;display:flex;gap:11px;align-items:flex-start;box-shadow:0 1px 2px rgba(0,0,0,.05)}\n.item .ck{flex:0 0 auto;width:24px;height:24px;border-radius:50%;border:2px solid #c7c7cc;margin-top:1px;display:flex;align-items:center;justify-content:center;font-size:15px;color:#fff}\n.item.done .ck{background:var(--ac);border-color:var(--ac)}\n.item.done .tx{opacity:.45;text-decoration:line-through}\n.item .body{flex:1;min-width:0}\n.item .tx{font-size:16px;line-height:1.35}\n.meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:5px}\n.tag{font-size:12px;font-weight:600;padding:3px 9px;border-radius:8px;background:rgba(10,132,255,.12);color:var(--ac)}\n.tag.due{background:rgba(255,149,0,.16);color:#c86800}\n.tag.owner{background:rgba(52,199,89,.16);color:#248a3d}\n.del{background:none;color:#ff453a;font-size:17px;padding:2px 4px;flex:0 0 auto}\n.add{display:flex;gap:8px;margin-top:6px}\n.add input{flex:1;min-width:0;padding:11px;border:1px solid #d1d1d6;border-radius:12px;font-size:15px;background:#fff}\n.empty{opacity:.5;text-align:center;margin:26px 0;font-size:14px}\n</style></head><body>\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\">⚙️</span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n\n<h1>✅ Action Items</h1>\n<p class=\"sub\">Paste meeting notes — your AI pulls out the actions, owners &amp; due dates.</p>\n<textarea id=\"notes\" placeholder=\"Paste or type meeting notes here…\"></textarea>\n<div class=\"rowb\">\n  <button class=\"act\" id=\"ext\" onclick=\"extract()\">Extract action items</button>\n  <button class=\"ghost\" onclick=\"document.getElementById('notes').value=''\">Clear</button>\n</div>\n<div id=\"status\"></div>\n\n<h2>Action items <button onclick=\"clearDone()\">Clear done</button></h2>\n<div class=\"add\">\n  <input id=\"manual\" placeholder=\"Add an item manually…\">\n  <button class=\"act\" onclick=\"addManual()\">Add</button>\n</div>\n<div id=\"list\"></div>\n\n<script>\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar items=[];\nfunction el(i){return document.getElementById(i)}\nfunction haptic(k){if(window.myllmHaptic)myllmHaptic(k||'light')}\nfunction save(){store.setItem('items',JSON.stringify(items))}\nfunction uid(){seed=(seed*9301+49297)%233280;return 't'+seed+(items.length)}\nvar seed=1234;\n\nfunction extract(){\n  var notes=el('notes').value.trim();\n  if(!notes){el('status').textContent='Paste some notes first.';return}\n  if(!window.myllmAsk){el('status').textContent='This needs the latest MyLLM with “Allow apps to use the AI” enabled in Settings.';return}\n  el('ext').disabled=true;el('status').textContent='Reading the notes…';\n  myllmAsk('From these meeting notes, extract every action item. Reply with ONLY a JSON array like '+\n    '[{\"task\":\"what to do\",\"owner\":\"person or empty string\",\"due\":\"due date/time or empty string\"}] and nothing else. Notes:\\n'+notes)\n  .then(function(reply){\n    var s=reply.indexOf('['),e=reply.lastIndexOf(']');\n    if(s<0||e<=s)throw new Error('no items came back');\n    var got=JSON.parse(reply.slice(s,e+1)).filter(function(x){return x&&x.task});\n    if(!got.length)throw new Error('no action items found');\n    got.forEach(function(g){items.unshift({id:uid(),task:g.task,owner:(g.owner||'').trim(),due:(g.due||'').trim(),done:false})});\n    save();render();el('status').textContent='Added '+got.length+' item'+(got.length>1?'s':'')+'.';haptic('success');\n  }).catch(function(err){el('status').textContent='Could not extract: '+err.message})\n  .then(function(){el('ext').disabled=false});\n}\nfunction addManual(){\n  var v=el('manual').value.trim();if(!v)return;\n  items.unshift({id:uid(),task:v,owner:'',due:'',done:false});el('manual').value='';save();render();haptic('light');\n}\nfunction toggle(id){var it=items.filter(function(x){return x.id===id})[0];if(it){it.done=!it.done;save();render();haptic('selection')}}\nfunction del(id){items=items.filter(function(x){return x.id!==id});save();render();haptic('light')}\nfunction clearDone(){items=items.filter(function(x){return !x.done});save();render();haptic('light')}\nfunction render(){\n  var L=el('list');L.innerHTML='';\n  if(!items.length){L.innerHTML='<div class=\"empty\">No action items yet.</div>';return}\n  items.forEach(function(it){\n    var d=document.createElement('div');d.className='item'+(it.done?' done':'');\n    var meta='';\n    if(it.owner)meta+='<span class=\"tag owner\">👤 '+esc(it.owner)+'</span>';\n    if(it.due)meta+='<span class=\"tag due\">📅 '+esc(it.due)+'</span>';\n    d.innerHTML='<div class=\"ck\">'+(it.done?'✓':'')+'</div>'+\n      '<div class=\"body\"><div class=\"tx\">'+esc(it.task)+'</div>'+(meta?'<div class=\"meta\">'+meta+'</div>':'')+'</div>'+\n      '<button class=\"del\">✕</button>';\n    d.querySelector('.ck').onclick=function(){toggle(it.id)};\n    d.querySelector('.tx').onclick=function(){toggle(it.id)};\n    d.querySelector('.del').onclick=function(){del(it.id)};\n    L.appendChild(d);\n  });\n}\nfunction esc(s){return (s+'').replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]})}\nel('manual').addEventListener('keydown',function(e){if(e.key==='Enter')addManual()});\nstore.getItem('items').then(function(v){if(v){try{items=JSON.parse(v)}catch(e){}}render();\n  if(!window.myllmAsk)el('status').textContent='Tip: manual add works offline; note-extraction needs AI enabled.';});\n</script></body></html>\n"}