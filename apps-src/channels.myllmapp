{"name": "Channels", "html": "<!doctype html>\n<!--\n  Channels — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Channels</title>\n<style>\n  :root { color-scheme: light dark; }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111);\n    max-width:640px; margin:0 auto; min-height:100dvh;\n    padding-bottom:calc(30px + env(safe-area-inset-bottom));\n  }\n  .hero{\n    height:104px; position:relative; display:flex; align-items:flex-end; padding:12px 16px;\n    background:linear-gradient(135deg,#3b1d5e 0%,#6d28d9 45%,#0ea5e9 100%);\n  }\n  .hero::after{\n    content:\"\"; position:absolute; inset:0; opacity:.5;\n    background:\n      radial-gradient(circle at 18% 30%, rgba(255,255,255,.28) 0 14px, transparent 15px),\n      radial-gradient(circle at 74% 62%, rgba(255,255,255,.20) 0 22px, transparent 23px),\n      radial-gradient(circle at 46% 18%, rgba(255,255,255,.14) 0 9px, transparent 10px);\n  }\n  .hero h1{ position:relative; z-index:1; color:#fff; font-size:23px; font-weight:800; letter-spacing:-.3px; text-shadow:0 2px 10px rgba(0,0,0,.45); }\n  .hero p{ position:relative; z-index:1; color:rgba(255,255,255,.82); font-size:12.5px; margin-left:10px; padding-bottom:3px; }\n  .wrap{ padding:12px 14px; }\n\n  .tabs{ display:flex; background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8); border-radius:13px; padding:3px; margin-bottom:12px; }\n  .tabs button{\n    flex:1; border:none; background:none; color:var(--myllm-muted,#8a8a8e);\n    border-radius:10px; padding:9px; font-size:14px; font-weight:700; font-family:inherit;\n  }\n  .tabs button.on{ background:var(--myllm-accent,#0a84ff); color:#fff; }\n\n  .card{\n    background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8);\n    border-radius:16px; padding:13px 14px; margin-bottom:10px;\n  }\n  .vid{ display:block; text-decoration:none; color:inherit; margin-bottom:10px; }\n  .vid .thumbwrap{ position:relative; border-radius:14px; overflow:hidden; background:#d9d9de; aspect-ratio:16/9; }\n  .vid img{ width:100%; height:100%; object-fit:cover; display:block; }\n  .vid .play{\n    position:absolute; right:9px; bottom:9px; background:rgba(0,0,0,.62); color:#fff;\n    font-size:11.5px; font-weight:700; padding:3px 8px; border-radius:999px; backdrop-filter:blur(6px);\n  }\n  .vid h3{ font-size:15px; font-weight:700; line-height:1.32; margin:8px 2px 2px; }\n  .vid .by{ font-size:12.5px; color:var(--myllm-muted,#8a8a8e); margin:0 2px; display:flex; align-items:center; gap:6px; }\n  .dot{ width:7px; height:7px; border-radius:50%; background:var(--myllm-accent,#0a84ff); flex-shrink:0; }\n\n  .chrow{ display:flex; align-items:center; gap:10px; padding:11px 2px; border-bottom:1px solid var(--myllm-border,#e3e3e8); }\n  .chrow:last-child{ border-bottom:none; }\n  .chrow .n{ flex:1; min-width:0; }\n  .chrow .n b{ font-size:15px; font-weight:700; display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  .chrow .n span{ font-size:12px; color:var(--myllm-muted,#8a8a8e); }\n  .x{ border:none; background:none; color:var(--myllm-muted,#8a8a8e); font-size:19px; padding:4px 8px; font-family:inherit; }\n  .undo{ border:none; background:none; color:var(--myllm-accent,#0a84ff); font-size:14px; font-weight:700; padding:4px 8px; font-family:inherit; }\n\n  label{ display:block; font-size:12.5px; font-weight:700; color:var(--myllm-muted,#8a8a8e); margin-bottom:6px; text-transform:uppercase; letter-spacing:.4px; }\n  input{\n    width:100%; font-size:16px; padding:11px 12px; border-radius:12px;\n    border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111); font-family:inherit;\n  }\n  .go{\n    border:none; border-radius:12px; padding:11px 18px; font-size:15px; font-weight:700;\n    background:var(--myllm-accent,#0a84ff); color:#fff; font-family:inherit;\n  }\n  .go[disabled]{ opacity:.5; }\n  .go.wide{ width:100%; margin-top:9px; }\n  .ghost{ background:none; color:var(--myllm-accent,#0a84ff); border:1px solid var(--myllm-border,#e3e3e8); }\n\n  .status{ text-align:center; color:var(--myllm-muted,#8a8a8e); font-size:14px; padding:22px 10px; line-height:1.5; }\n  .errline{ color:#d1345b; font-size:13.5px; margin-top:8px; line-height:1.45; }\n  .okline{ color:#1a9a5b; font-size:13.5px; margin-top:8px; }\n  .note{ font-size:12.5px; color:var(--myllm-muted,#8a8a8e); line-height:1.5; margin-top:9px; }\n  .note code{ font-size:12px; background:var(--myllm-bg,#f2f2f7); padding:1px 5px; border-radius:5px; }\n  .chips{ display:flex; flex-wrap:wrap; gap:7px; }\n  .chip{\n    border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111); border-radius:999px; padding:8px 13px;\n    font-size:13.5px; font-weight:650; font-family:inherit;\n  }\n  .chip[disabled]{ opacity:.45; }\n  .chip b{ color:var(--myllm-accent,#0a84ff); font-weight:800; margin-left:4px; }\n  .bar{ display:flex; align-items:center; gap:8px; margin-bottom:10px; }\n  .bar .sp{ flex:1; }\n  .small{ font-size:13px; font-weight:700; padding:8px 13px; }\n</style>\n<style>:root{--build-id:\"cec64feb0a\";}</style>\n</head>\n<body>\n\n<div class=\"hero\"><h1>Channels</h1><p>your creators, no account</p></div>\n\n<div class=\"wrap\">\n  <div class=\"tabs\">\n    <button id=\"tabL\" class=\"on\" onclick=\"showTab('l')\">Latest</button>\n    <button id=\"tabC\" onclick=\"showTab('c')\">Channels</button>\n  </div>\n\n  <div id=\"paneL\">\n    <div class=\"bar\">\n      <span class=\"sp\"></span>\n      <button class=\"go ghost small\" onclick=\"refresh(true)\">Refresh</button>\n    </div>\n    <div id=\"feed\"></div>\n  </div>\n\n  <div id=\"paneC\" style=\"display:none\">\n    <div class=\"card\">\n      <label>Follow a channel</label>\n      <input id=\"url\" placeholder=\"paste a channel link or @handle\" autocapitalize=\"none\" autocorrect=\"off\" spellcheck=\"false\">\n      <button class=\"go wide\" id=\"addBtn\" onclick=\"addChannel()\">Add channel</button>\n      <div id=\"addmsg\"></div>\n      <p class=\"note\">Paste a channel address — <code>@handle</code>, a <code>/channel/…</code> link,\n      or the address of any video feed. Channels are read from the site's own public feed, so there is\n      no account and no sign-in. Tapping a video opens it in the app it belongs to.</p>\n    </div>\n    <div class=\"card\" id=\"sugCard\">\n      <label>Start with a few</label>\n      <div id=\"suggest\"></div>\n      <p class=\"note\">Tap one to follow it. These are just well-known starting points — remove any of them whenever you like.</p>\n    </div>\n    <div class=\"card\">\n      <label>Following (<span id=\"count\">0</span>)</label>\n      <div id=\"chlist\"></div>\n    </div>\n  </div>\n</div>\n\n<script>\nvar store = window.myllmStorage || {getItem:function(){return Promise.resolve(null)}, setItem:function(){return Promise.resolve()}};\nvar NET = window.myllmFetch || null;\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s==null?\"\":s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\"); }\n\n/* A short, deliberately uncontroversial set of starting points, so a first run\n   isn't an empty box and a text field. Channel ids, not handles: an id needs no\n   lookup, and unlike a handle it doesn't change when a channel renames itself.\n   Every one was checked live before shipping. */\nvar SUGGESTED = [\n  { title: \"NASA\",             cid: \"UCLA_DiR1FfKNvjuUpBHmylQ\" },\n  { title: \"TED\",              cid: \"UCAuUUnT6oDeKwE6v1NGQxug\" },\n  { title: \"Kurzgesagt\",       cid: \"UCsXVk37bltHxD1rDPwtNM8Q\" },\n  { title: \"Veritasium\",       cid: \"UCHnyfMqiRRG1u-2MsSQLbXA\" },\n  { title: \"BBC Earth\",        cid: \"UCwmZiChSryoWQCZMIQezgTg\" },\n  { title: \"Marques Brownlee\", cid: \"UCBJycsmduvYEL83R_U4JriQ\" }\n];\n\nvar K_CH = \"channels_v1\";      /* the follow list */\nvar K_CACHE = \"cache_v1\";      /* last merged feed, so it opens instantly */\nvar K_SEEN = \"lastseen_v1\";    /* timestamp of the last look, for the new dot */\n\nvar channels = [];   /* [{cid, title, feed}] */\nvar items = [];      /* merged videos */\nvar lastSeen = 0;\nvar pendingRemove = null;\n\n/* ---------- small helpers ---------- */\n\nfunction timeAgo(iso){\n  var t = new Date(iso).getTime();\n  if (!t) return \"\";\n  var s = (Date.now() - t) / 1000;\n  if (s < 3600) return Math.max(1, Math.floor(s/60)) + \"m ago\";\n  if (s < 86400) return Math.floor(s/3600) + \"h ago\";\n  if (s < 2592000) return Math.floor(s/86400) + \"d ago\";\n  return new Date(iso).toLocaleDateString();\n}\n\n/* XML namespaces make querySelector unreliable across feed dialects, so match\n   on localName instead — media:thumbnail, itunes:image and friends all differ\n   only by prefix. */\nfunction pick(node, local){\n  var all = node.getElementsByTagName(\"*\");\n  for (var i = 0; i < all.length; i++) if (all[i].localName === local) return all[i];\n  return null;\n}\nfunction pickText(node, local){\n  var n = pick(node, local);\n  return n ? (n.textContent || \"\").trim() : \"\";\n}\n\nfunction netGuard(target){\n  if (!NET){\n    el(target).innerHTML = '<p class=\"status\">This app needs internet access for apps — turn it on in MyLLMos settings, then reopen.</p>';\n    return false;\n  }\n  return true;\n}\n\n/* ---------- resolving what someone pasted ---------- */\n\nvar YT_FEED = \"https://www.youtube.com/feeds/videos.xml?channel_id=\";\n\n/* Returns a Promise for a feed URL. Handles a channel id we can read straight\n   from the address, a handle or vanity address that needs one page fetch, and\n   any ordinary site that advertises a feed in its <head>. */\nfunction resolveFeed(raw){\n  var input = raw.trim();\n  if (!input) return Promise.reject(new Error(\"Paste a channel address first.\"));\n\n  /* A bare @handle, with no address around it. */\n  if (/^@[\\w.-]+$/.test(input)) input = \"https://www.youtube.com/\" + input;\n  if (!/^https?:\\/\\//i.test(input)) input = \"https://\" + input;\n\n  /* Already a feed. */\n  if (/[?&]channel_id=|\\.xml(\\?|$)|\\.rss(\\?|$)|\\/feed\\/?$/i.test(input)) {\n    return Promise.resolve(input);\n  }\n\n  /* A channel id sitting in the address needs no network at all. */\n  var direct = input.match(/\\/channel\\/(UC[\\w-]{20,})/);\n  if (direct) return Promise.resolve(YT_FEED + direct[1]);\n\n  /* Otherwise read the page once and look for the channel id, then for a\n     declared feed. Both are in the markup of the page as served. */\n  return NET(input).then(function(r){\n    var body = r && r.body ? r.body : \"\";\n    if (!r || r.status >= 400 || !body) throw new Error(\"That address didn't load — check it and try again.\");\n\n    var m = body.match(/\"externalId\":\"(UC[\\w-]{20,})\"/)\n         || body.match(/channel_id=(UC[\\w-]{20,})/)\n         || body.match(/\\/channel\\/(UC[\\w-]{20,})/);\n    if (m) return YT_FEED + m[1];\n\n    var f = body.match(/<link[^>]+type=[\"']application\\/(?:rss|atom)\\+xml[\"'][^>]*>/i);\n    if (f){\n      var href = f[0].match(/href=[\"']([^\"']+)[\"']/i);\n      if (href) return new URL(href[1], input).href;\n    }\n    throw new Error(\"Couldn't find a feed for that page. Try the channel's own address, or a direct feed address.\");\n  });\n}\n\n/* ---------- reading a feed ---------- */\n\nfunction parseFeed(xml, feedUrl){\n  var doc = new DOMParser().parseFromString(xml, \"application/xml\");\n  if (doc.getElementsByTagName(\"parsererror\").length) throw new Error(\"That feed didn't look like a feed.\");\n\n  var root = doc.documentElement;\n  var chTitle = \"\";\n  var head = pick(root, \"channel\") || root;\n  var t = head.getElementsByTagName(\"*\");\n  for (var k = 0; k < t.length; k++){\n    if (t[k].localName === \"title\" && t[k].parentNode === head){ chTitle = (t[k].textContent||\"\").trim(); break; }\n  }\n  if (!chTitle) chTitle = pickText(root, \"title\") || \"Channel\";\n\n  var nodes = root.getElementsByTagName(\"entry\");\n  if (!nodes.length) nodes = root.getElementsByTagName(\"item\");\n\n  var out = [];\n  for (var i = 0; i < nodes.length && i < 25; i++){\n    var e = nodes[i];\n    var title = pickText(e, \"title\");\n    if (!title) continue;\n\n    /* Atom puts the address on a rel=\"alternate\" link; RSS puts it in the text. */\n    var link = \"\";\n    var links = e.getElementsByTagName(\"*\");\n    for (var j = 0; j < links.length; j++){\n      if (links[j].localName !== \"link\") continue;\n      var rel = links[j].getAttribute(\"rel\");\n      if (!rel || rel === \"alternate\"){ link = links[j].getAttribute(\"href\") || (links[j].textContent||\"\").trim(); break; }\n    }\n    if (!link) continue;\n\n    var thumb = \"\";\n    var th = pick(e, \"thumbnail\");\n    if (th) thumb = th.getAttribute(\"url\") || \"\";\n    if (!thumb){\n      var mc = pick(e, \"content\");\n      if (mc && /^image\\//.test(mc.getAttribute(\"type\") || \"\")) thumb = mc.getAttribute(\"url\") || \"\";\n    }\n    if (!thumb){\n      var enc = pick(e, \"enclosure\");\n      if (enc && /^image\\//.test(enc.getAttribute(\"type\") || \"\")) thumb = enc.getAttribute(\"url\") || \"\";\n    }\n\n    var when = pickText(e, \"published\") || pickText(e, \"pubDate\") || pickText(e, \"updated\") || \"\";\n\n    out.push({\n      title: title,\n      link: link,\n      thumb: thumb,\n      when: when,\n      at: new Date(when).getTime() || 0,\n      by: chTitle,\n      feed: feedUrl\n    });\n  }\n  return { title: chTitle, items: out };\n}\n\nfunction fetchFeed(feedUrl){\n  return NET(feedUrl).then(function(r){\n    if (!r || r.status >= 400 || !r.body) throw new Error(\"Feed didn't load.\");\n    return parseFeed(r.body, feedUrl);\n  });\n}\n\n/* ---------- the follow list ---------- */\n\nfunction saveChannels(){ return store.setItem(K_CH, JSON.stringify(channels)); }\n\n/* Shared by the paste field and the suggestion chips: check for a duplicate,\n   read the feed once to learn the channel's real name, then save. */\nfunction commitChannel(feedUrl){\n  for (var i = 0; i < channels.length; i++){\n    if (channels[i].feed === feedUrl) return Promise.reject(new Error(\"You already follow that one.\"));\n  }\n  return fetchFeed(feedUrl).then(function(res){\n    channels.push({ feed: feedUrl, title: res.title });\n    return saveChannels().then(function(){\n      el(\"addmsg\").innerHTML = '<div class=\"okline\">Following ' + esc(res.title) + ' ✓</div>';\n      haptic(\"success\");\n      renderChannels();\n      refresh(false);\n    });\n  });\n}\n\nfunction followSuggested(i){\n  var s = SUGGESTED[i];\n  if (!s) return;\n  el(\"addmsg\").innerHTML = \"\";\n  if (!NET){ el(\"addmsg\").innerHTML = '<div class=\"errline\">Needs internet access for apps (MyLLMos settings).</div>'; return; }\n  haptic(\"light\");\n  var btn = el(\"sug\" + i);\n  if (btn){ btn.disabled = true; btn.textContent = \"Adding…\"; }\n  commitChannel(YT_FEED + s.cid).catch(function(e){\n    el(\"addmsg\").innerHTML = '<div class=\"errline\">' + esc(e && e.message ? e.message : \"Couldn't add that one.\") + '</div>';\n    renderSuggestions();\n  });\n}\n\nfunction addChannel(){\n  var raw = el(\"url\").value;\n  el(\"addmsg\").innerHTML = \"\";\n  if (!NET){ el(\"addmsg\").innerHTML = '<div class=\"errline\">Needs internet access for apps (MyLLMos settings).</div>'; return; }\n  haptic(\"light\");\n  el(\"addBtn\").disabled = true;\n  el(\"addBtn\").textContent = \"Looking…\";\n\n  resolveFeed(raw)\n    .then(function(feedUrl){\n      return commitChannel(feedUrl).then(function(){ el(\"url\").value = \"\"; });\n    })\n    .catch(function(e){\n      el(\"addmsg\").innerHTML = '<div class=\"errline\">' + esc(e && e.message ? e.message : \"That didn't work — try another address.\") + '</div>';\n    })\n    .then(function(){\n      el(\"addBtn\").disabled = false;\n      el(\"addBtn\").textContent = \"Add channel\";\n    });\n}\n\n/* Removal without a dialog: the row becomes its own undo. */\nfunction removeChannel(i){\n  haptic(\"light\");\n  pendingRemove = { at: i, ch: channels[i] };\n  channels.splice(i, 1);\n  saveChannels().then(function(){ renderChannels(); renderFeed(); });\n}\nfunction undoRemove(){\n  if (!pendingRemove) return;\n  channels.splice(pendingRemove.at, 0, pendingRemove.ch);\n  pendingRemove = null;\n  saveChannels().then(function(){ renderChannels(); refresh(false); });\n}\n\nfunction renderSuggestions(){\n  var followed = {};\n  for (var i = 0; i < channels.length; i++) followed[channels[i].feed] = true;\n  var left = [];\n  for (var j = 0; j < SUGGESTED.length; j++){\n    if (!followed[YT_FEED + SUGGESTED[j].cid]) left.push(j);\n  }\n  /* Once they are all followed the block has nothing to say — take it away\n     rather than leave an empty heading. */\n  el(\"sugCard\").style.display = left.length ? \"block\" : \"none\";\n  el(\"suggest\").innerHTML = '<div class=\"chips\">' + left.map(function(j){\n    return '<button class=\"chip\" id=\"sug' + j + '\" onclick=\"followSuggested(' + j + ')\">' +\n           esc(SUGGESTED[j].title) + '<b>+</b></button>';\n  }).join(\"\") + '</div>';\n}\n\nfunction renderChannels(){\n  renderSuggestions();\n  el(\"count\").textContent = channels.length;\n  var html = channels.map(function(c, i){\n    return '<div class=\"chrow\"><div class=\"n\"><b>' + esc(c.title) + '</b>' +\n           '<span>' + esc((c.feed.match(/channel_id=([\\w-]+)/) || [,\"feed\"])[1]) + '</span></div>' +\n           '<button class=\"x\" onclick=\"removeChannel(' + i + ')\" aria-label=\"Unfollow\">✕</button></div>';\n  }).join(\"\");\n  if (pendingRemove){\n    html += '<div class=\"chrow\"><div class=\"n\"><span>Unfollowed ' + esc(pendingRemove.ch.title) + '</span></div>' +\n            '<button class=\"undo\" onclick=\"undoRemove()\">Undo</button></div>';\n  }\n  el(\"chlist\").innerHTML = html || '<p class=\"status\">No channels yet — add one above.</p>';\n}\n\n/* ---------- the merged feed ---------- */\n\nfunction renderFeed(){\n  if (!channels.length){\n    el(\"feed\").innerHTML = '<p class=\"status\">Nothing here yet.<br>Add a channel on the Channels tab — there are a few suggestions there to start you off.</p>';\n    return;\n  }\n  if (!items.length){\n    el(\"feed\").innerHTML = '<p class=\"status\">No videos yet — tap Refresh.</p>';\n    return;\n  }\n  el(\"feed\").innerHTML = items.map(function(v){\n    var isNew = v.at > lastSeen;\n    return '<a class=\"vid\" href=\"' + esc(v.link) + '\" target=\"_blank\" rel=\"noopener\">' +\n      '<div class=\"thumbwrap\">' +\n        (v.thumb ? '<img src=\"' + esc(v.thumb) + '\" alt=\"\" loading=\"lazy\">' : '') +\n        '<span class=\"play\">Watch ↗</span>' +\n      '</div>' +\n      '<h3>' + esc(v.title) + '</h3>' +\n      '<div class=\"by\">' + (isNew ? '<span class=\"dot\"></span>' : '') +\n        esc(v.by) + (v.when ? ' · ' + esc(timeAgo(v.when)) : '') + '</div>' +\n    '</a>';\n  }).join(\"\");\n}\n\nfunction refresh(manual){\n  if (!channels.length){ renderFeed(); return; }\n  if (!netGuard(\"feed\")) return;\n  if (manual) haptic(\"light\");\n  if (!items.length) el(\"feed\").innerHTML = '<p class=\"status\">Fetching the latest…</p>';\n\n  var jobs = channels.map(function(c){\n    return fetchFeed(c.feed).then(function(res){\n      if (res.title && res.title !== c.title){ c.title = res.title; saveChannels(); }\n      return res.items;\n    }).catch(function(){ return []; });\n  });\n\n  Promise.all(jobs).then(function(lists){\n    var all = [];\n    for (var i = 0; i < lists.length; i++) all = all.concat(lists[i]);\n    all.sort(function(a, b){ return b.at - a.at; });\n    var fresh = all.slice(0, 60);\n\n    if (!fresh.length && !items.length){\n      el(\"feed\").innerHTML = '<p class=\"status\">Couldn\\'t reach those channels just now — tap Refresh to try again.</p>';\n      return;\n    }\n    items = fresh;\n    renderFeed();\n    renderChannels();\n    if (manual) haptic(\"success\");\n\n    /* Cache so the next open paints before the network answers, and move the\n       \"new\" line forward only once the person has actually seen this batch. */\n    store.setItem(K_CACHE, JSON.stringify(items.slice(0, 40)));\n    var newest = items.length ? items[0].at : 0;\n    if (newest > lastSeen){\n      lastSeen = newest;\n      store.setItem(K_SEEN, String(newest));\n    }\n  });\n}\n\n/* ---------- tabs ---------- */\n\nfunction showTab(t){\n  haptic(\"selection\");\n  el(\"paneL\").style.display = t === \"l\" ? \"block\" : \"none\";\n  el(\"paneC\").style.display = t === \"c\" ? \"block\" : \"none\";\n  el(\"tabL\").className = t === \"l\" ? \"on\" : \"\";\n  el(\"tabC\").className = t === \"c\" ? \"on\" : \"\";\n}\n\n/* ---------- boot ---------- */\n\nPromise.all([store.getItem(K_CH), store.getItem(K_CACHE), store.getItem(K_SEEN)])\n.then(function(v){\n  try { channels = v[0] ? JSON.parse(v[0]) : []; } catch(e){ channels = []; }\n  try { items = v[1] ? JSON.parse(v[1]) : []; } catch(e){ items = []; }\n  lastSeen = Number(v[2] || 0) || 0;\n  if (!channels.length) showTab(\"c\");\n  renderChannels();\n  renderFeed();\n  refresh(false);\n});\n</script>\n</body>\n</html>\n", "kind": "html", "iconSymbol": "play.square.stack.fill", "iconColor": "indigo"}