{"name": "Mastodon Feed", "kind": "html", "iconSymbol": "megaphone.fill", "iconColor": "purple", "html": "<!doctype html>\n<!--\n  Mastodon Feed — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Mastodon Feed</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>\n  :root{ color-scheme:light dark;\n    --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n    --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n    --fill:rgba(120,120,128,.12); --h:262; }\n  @media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n    --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:640px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.96); }\n  [hidden]{ display:none !important; }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 12px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 28%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  .head .acts{ display:flex; gap:8px; flex-shrink:0; }\n  .ib{ width:40px; height:40px; border-radius:12px; border:1px solid var(--line); background:var(--surface); display:flex; align-items:center; justify-content:center; font-size:17px; }\n  .ib.busy svg{ animation:spin .8s linear infinite; }\n  .ib.gone{ visibility:hidden; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n\n  /* the art from the old banner, now a quiet strip under the header */\n  .art{ height:84px; border-radius:18px; margin-bottom:4px; background:hsl(var(--h) 40% 30%) center/cover; box-shadow:inset 0 0 0 1px rgba(255,255,255,.06); }\n\n  .stick{ position:sticky; top:0; z-index:5; margin:0 calc(-16px - env(safe-area-inset-right)) 8px calc(-16px - env(safe-area-inset-left));\n    padding:8px calc(16px + env(safe-area-inset-right)) 10px calc(16px + env(safe-area-inset-left));\n    background:color-mix(in srgb, var(--bg) 90%, transparent); -webkit-backdrop-filter:saturate(180%) blur(12px); backdrop-filter:saturate(180%) blur(12px); }\n  .seg{ display:flex; background:var(--fill); border-radius:12px; padding:3px; }\n  .seg button{ flex:1; min-height:36px; border:0; background:none; border-radius:9px; font-size:14px; font-weight:700; color:var(--muted); }\n  .seg button.on{ background:var(--surface); color:var(--ink); box-shadow:0 1px 3px rgba(0,0,0,.14); }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:10px; }\n  .post{ display:flex; gap:11px; }\n  .av{ width:42px; height:42px; border-radius:50%; flex-shrink:0; object-fit:cover; background:var(--fill); }\n  .av.ini{ display:flex; align-items:center; justify-content:center; color:#fff; font-size:15px; font-weight:800; letter-spacing:.02em;\n    background:linear-gradient(145deg, hsl(var(--ah,210) 55% 52%), hsl(calc(var(--ah,210) + 35) 50% 32%)); }\n  .post .b{ flex:1; min-width:0; }\n  .post .who{ font-size:14.5px; line-height:1.3; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  .post .who b{ font-weight:750; }\n  .post .who span{ color:var(--muted); font-size:13px; }\n  .post .txt{ font-size:15.5px; line-height:1.45; margin-top:4px; white-space:pre-wrap; overflow-wrap:anywhere; }\n  .post .media{ display:grid; grid-template-columns:repeat(auto-fit,minmax(0,1fr)); gap:6px; margin-top:9px; }\n  .post .media img{ width:100%; height:100%; max-height:240px; aspect-ratio:4/3; object-fit:cover; border-radius:12px; background:var(--fill); }\n  .post .foot{ display:flex; align-items:center; gap:16px; margin-top:9px; font-size:13px; color:var(--muted); font-variant-numeric:tabular-nums; }\n  .post .foot span{ display:inline-flex; align-items:center; gap:5px; }\n  .post .foot svg.i{ width:1.1em; height:1.1em; }\n  .post .foot a{ margin-left:auto; min-height:32px; padding:0 11px; border-radius:99px; background:var(--fill); color:var(--ink); font-weight:650; text-decoration:none; display:inline-flex; align-items:center; gap:5px; }\n\n  label.k{ display:block; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:14px 2px 7px; }\n  label.k:first-child{ margin-top:0; }\n  .search{ display:flex; gap:8px; }\n  .field{ flex:1; min-width:0; display:flex; align-items:center; gap:8px; border:1px solid var(--line); background:var(--bg); border-radius:12px; padding:0 12px; }\n  .field svg{ color:var(--muted); }\n  .field input{ flex:1; min-width:0; border:0; background:none; outline:none; font:inherit; font-size:16px; padding:12px 0; color:var(--ink); }\n  .field:focus-within{ border-color:var(--acc); }\n  input.plain, textarea{ width:100%; font:inherit; font-size:16px; padding:12px; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; }\n  input.plain:focus, textarea:focus{ border-color:var(--acc); }\n  textarea{ min-height:120px; resize:vertical; line-height:1.45; }\n  .go{ flex-shrink:0; min-height:46px; border:0; border-radius:12px; padding:0 16px; background:var(--acc); color:#fff; font-size:15px; font-weight:700; display:flex; align-items:center; justify-content:center; gap:7px; }\n  .go.wide{ width:100%; min-height:50px; margin-top:12px; border-radius:14px; }\n  .go:disabled{ opacity:.55; }\n  .spin{ width:16px; height:16px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; }\n  .meta{ display:flex; justify-content:space-between; margin-top:7px; font-size:12.5px; color:var(--muted); font-variant-numeric:tabular-nums; }\n  .meta .over{ color:#ff453a; font-weight:800; }\n  .note{ font-size:12.5px; color:var(--muted); line-height:1.5; margin-top:10px; }\n  .note a{ color:var(--acc); }\n  .okline, .errline{ display:flex; align-items:flex-start; gap:7px; font-size:13.5px; line-height:1.45; margin-top:10px; border-radius:12px; padding:10px 12px; }\n  .okline{ color:#1c9a4a; background:rgba(52,199,89,.12); font-weight:650; }\n  .errline{ color:#e0352b; background:rgba(255,69,58,.1); }\n  @media (prefers-color-scheme:dark){ .okline{ color:#4be07d; } .errline{ color:#ff6b62; } }\n  .okline svg.i, .errline svg.i{ margin-top:1px; }\n\n  .sk{ display:flex; gap:11px; background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:10px; }\n  .sk b{ width:42px; height:42px; border-radius:50%; background:var(--fill); flex-shrink:0; animation:pulse 1.3s ease-in-out infinite; }\n  .sk div{ flex:1; }\n  .sk i{ display:block; height:12px; border-radius:6px; background:var(--fill); margin-bottom:9px; animation:pulse 1.3s ease-in-out infinite; }\n  .sk i:first-child{ width:45%; } .sk i:last-child{ width:65%; margin-bottom:0; }\n  @keyframes pulse{ 50%{ opacity:.45; } }\n\n  .notice{ display:flex; gap:12px; align-items:flex-start; background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:14px; margin:0 0 10px; }\n  .notice .tile{ width:36px; height:36px; border-radius:10px; font-size:15px; }\n  .notice.err .tile{ background:linear-gradient(145deg,#ff6b5f,#c0392b); }\n  .notice.off .tile{ background:linear-gradient(145deg,#8e8e93,#48484a); }\n  .notice b{ display:block; font-size:15px; font-weight:750; }\n  .notice p{ font-size:13.5px; color:var(--muted); margin-top:2px; line-height:1.45; }\n  .notice button{ margin-top:10px; min-height:36px; padding:0 14px; border-radius:10px; border:0; background:var(--acc); color:#fff; font-weight:700; font-size:13.5px; display:inline-flex; align-items:center; gap:6px; }\n\n  @media (max-width:350px){ .seg button{ font-size:13px; } .art{ height:64px; } }\n  @media (max-height:520px) and (min-width:600px){ .art{ display:none; } }\n  @media (prefers-reduced-motion:reduce){ .sk b, .sk i, .ib.busy svg{ animation:none; } .spin{ animation-duration:2.4s; } button:active{ transform:none; } }\n\n  .tagchips{ display:flex; flex-wrap:wrap; gap:7px; }\n  .tagchip{ min-height:36px; border:1px solid var(--line); background:var(--bg); border-radius:99px; padding:0 14px; font-size:14px; font-weight:650; display:inline-flex; align-items:center; gap:6px; }\n  .tagchip small{ color:var(--muted); font-weight:600; font-size:12px; font-variant-numeric:tabular-nums; }\n  .tagchip.hot{ background:var(--acc); border-color:var(--acc); color:#fff; }\n  .tagchip.hot small{ color:#fff; opacity:.8; }\n  .crumb{ display:flex; align-items:center; gap:8px; margin:2px 2px 10px; font-size:15px; font-weight:750; }\n  .crumb svg.i{ color:hsl(var(--h) 60% 55%); }\n  .crumb button{ margin-left:auto; min-height:32px; padding:0 12px; border-radius:99px; border:0; background:var(--fill); font-size:13px; font-weight:700; display:inline-flex; align-items:center; gap:5px; }\n  .cw{ display:inline-flex; align-items:center; gap:5px; font-size:12.5px; font-weight:750; color:#b25e00; background:rgba(255,159,10,.14); border-radius:8px; padding:3px 8px; margin:4px 0 2px; }\n  @media (prefers-color-scheme:dark){ .cw{ color:#ffb340; } }\n  .cw svg.i{ width:1em; height:1em; }\n  .empty{ text-align:center; padding:22px 16px; }\n  .empty .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; margin:0 auto 10px; }\n  .empty b{ display:block; font-size:15.5px; font-weight:750; }\n  .empty p{ font-size:13.5px; color:var(--muted); line-height:1.5; max-width:300px; margin:5px auto 0; }\n  .empty button{ margin-top:12px; min-height:40px; padding:0 16px; border-radius:12px; border:0; background:var(--acc); color:#fff; font-weight:700; }\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style>\n<style>:root{--build-id:\"9478d8d3cc\";}</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-refresh\" viewBox=\"0 0 24 24\"><path d=\"M20 12a8 8 0 1 1-2.6-5.9M20 4v5h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-chat\" viewBox=\"0 0 24 24\"><path d=\"M5 4h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-6.6L8 20.6a.6.6 0 0 1-1-.45V17H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z\"/></symbol>\n  <symbol id=\"i-repost\" viewBox=\"0 0 24 24\"><path d=\"M7 7h9.6l-1.8-1.8a1 1 0 1 1 1.4-1.4l3.5 3.5a1 1 0 0 1 0 1.4l-3.5 3.5a1 1 0 0 1-1.4-1.4L16.6 9H7a1 1 0 0 0-1 1v1.5a1 1 0 0 1-2 0V10a3 3 0 0 1 3-3zm13 5.5a1 1 0 0 1 1 1V14a3 3 0 0 1-3 3H8.4l1.8 1.8a1 1 0 0 1-1.4 1.4l-3.5-3.5a1 1 0 0 1 0-1.4l3.5-3.5a1 1 0 0 1 1.4 1.4L8.4 15H18a1 1 0 0 0 1-1v-.5a1 1 0 0 1 1-1z\"/></symbol>\n  <symbol id=\"i-heart\" viewBox=\"0 0 24 24\"><path d=\"M12 20.4c-.3 0-.6-.1-.8-.3C6 15.9 3 13 3 9.3A4.8 4.8 0 0 1 7.8 4.5c1.7 0 3.2.8 4.2 2.1a5.2 5.2 0 0 1 4.2-2.1A4.8 4.8 0 0 1 21 9.3c0 3.7-3 6.6-8.2 10.8-.2.2-.5.3-.8.3z\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.8l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 16.8l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z\"/></symbol>\n  <symbol id=\"i-ext\" viewBox=\"0 0 24 24\"><path d=\"M14 4h6v6M20 4l-9 9M18 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-at\" viewBox=\"0 0 24 24\"><path d=\"M12 3a9 9 0 0 1 9 9v1.2a3.3 3.3 0 0 1-6 1.9A4.5 4.5 0 1 1 16.5 12v1.2a1.3 1.3 0 0 0 2.5 0V12a7 7 0 1 0-3.4 6 1 1 0 1 1 1 1.7A9 9 0 1 1 12 3zm0 6.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M5 12.6l4.6 4.6L19.2 7.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-send\" viewBox=\"0 0 24 24\"><path d=\"M3.4 11.1L19.6 3.6a1 1 0 0 1 1.3 1.3l-7.5 16.2a1 1 0 0 1-1.8-.1L9.9 14.1 3.5 12.9a1 1 0 0 1-.1-1.8z\"/></symbol>\n  <symbol id=\"i-hash\" viewBox=\"0 0 24 24\"><path d=\"M9.5 4L7.5 20M16.5 4l-2 16M4.5 9h16M3.5 15h16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-cloud\" viewBox=\"0 0 24 24\"><path d=\"M7 19a4.5 4.5 0 0 1-.6-9 6 6 0 0 1 11.5 1.5A3.8 3.8 0 0 1 17.5 19z\"/></symbol>\n  <symbol id=\"i-mega\" viewBox=\"0 0 24 24\"><path d=\"M18.5 3.3a1 1 0 0 1 1.5.9v13.6a1 1 0 0 1-1.5.9L13 15.5H9.8l.9 4a1 1 0 0 1-1 1.2H8.2a1 1 0 0 1-1-.8L6.1 15.5H5.5A2.5 2.5 0 0 1 3 13V9a2.5 2.5 0 0 1 2.5-2.5H13z\"/></symbol>\n  <symbol id=\"i-off\" viewBox=\"0 0 24 24\"><path d=\"M3.3 3.3a1 1 0 0 1 1.4 0l16 16a1 1 0 0 1-1.4 1.4l-3.5-3.5a2 2 0 1 1-2.5-2.5L10.8 12a5 5 0 0 0-3.4 1.6 1 1 0 0 1-1.5-1.3 7 7 0 0 1 3.1-2L7 8.4a10 10 0 0 0-3.2 2.2 1 1 0 0 1-1.4-1.4A12 12 0 0 1 5.6 7L3.3 4.7a1 1 0 0 1 0-1.4zM12 6c3.5 0 6.8 1.4 9.2 3.8a1 1 0 0 1-1.4 1.4A11 11 0 0 0 12 8h-.6L9.6 6.2C10.4 6.1 11.2 6 12 6z\"/></symbol>\n  <symbol id=\"i-warn\" viewBox=\"0 0 24 24\"><path d=\"M10.3 3.9a2 2 0 0 1 3.4 0l8 13.6a2 2 0 0 1-1.7 3H4a2 2 0 0 1-1.7-3zM12 9a1 1 0 0 0-1 1v4a1 1 0 0 0 2 0v-4a1 1 0 0 0-1-1zm0 7.2a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z\"/></symbol>\n</defs></svg>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-mega\"/></svg></div>\n  <div class=\"ht\"><h1>Mastodon Feed</h1><p>The fediverse, no strings</p></div>\n  <div class=\"acts\"><button class=\"ib\" id=\"refresh\" type=\"button\" aria-label=\"Refresh\"><svg class=\"i\"><use href=\"#i-refresh\"/></svg></button></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Mastodon Feed\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n<div class=\"art\" id=\"hero\" aria-hidden=\"true\"></div>\n<div class=\"stick\">\n  <div class=\"seg\" role=\"tablist\">\n    <button id=\"tabT\" class=\"on\" type=\"button\" onclick=\"showTab('t')\">Trending</button>\n    <button id=\"tabH\" type=\"button\" onclick=\"showTab('h')\">Home</button>\n    <button id=\"tabW\" type=\"button\" onclick=\"showTab('w')\">Write</button>\n    <button id=\"tabS\" type=\"button\" onclick=\"showTab('s')\">Setup</button>\n  </div>\n</div>\n\n<div id=\"paneT\">\n  <div id=\"trendbox\" class=\"card\"></div>\n  <div id=\"feedT\"></div>\n</div>\n\n<div id=\"paneH\" hidden>\n  <div id=\"feedH\"></div>\n</div>\n\n<div id=\"paneW\" hidden>\n  <div class=\"card\">\n    <label class=\"k\" for=\"compose\">New post</label>\n    <textarea id=\"compose\" placeholder=\"What's on your mind?\" oninput=\"onCompose()\"></textarea>\n    <div class=\"meta\"><b id=\"ccount\">0</b><span>500 max</span></div>\n    <button class=\"go wide\" id=\"postBtn\" type=\"button\" onclick=\"doPost()\"><svg class=\"i\"><use href=\"#i-send\"/></svg><span>Post to Mastodon</span></button>\n    <div id=\"postmsg\"></div>\n  </div>\n</div>\n\n<div id=\"paneS\" hidden>\n  <div class=\"card\">\n    <label class=\"k\" for=\"inst\">Your instance</label>\n    <input class=\"plain\" id=\"inst\" placeholder=\"mastodon.social\" autocapitalize=\"none\" autocorrect=\"off\" spellcheck=\"false\">\n    <label class=\"k\" for=\"token\">Access token (for Home &amp; posting)</label>\n    <input class=\"plain\" id=\"token\" type=\"password\" placeholder=\"paste your access token\">\n    <button class=\"go wide\" type=\"button\" onclick=\"saveSetup()\">Save on this device</button>\n    <p class=\"note\">Trending and hashtag browsing need no account at all. For Home and posting: on the web, open your instance → <b>Preferences → Development → New application</b> (any name, default scopes) → copy the <b>access token</b>. It's stored only on this device and sent only to your instance.</p>\n    <div id=\"setupmsg\"></div>\n  </div>\n</div>\n\n<script>\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction store(){ return window.myllmStorage || {getItem:function(){return Promise.resolve(null)}, setItem:function(){return Promise.resolve()}}; }\nfunction NET(url, opts){ var f = window.myllmFetch; if (!f) return Promise.reject(new Error(\"no network bridge\")); return f(url, opts); }\nfunction hasNet(){ return !!window.myllmFetch; }\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\"); }\nfunction icon(n){ return '<svg class=\"i\"><use href=\"#i-' + n + '\"/></svg>'; }\nfunction okLine(t){ return '<div class=\"okline\">' + icon(\"check\") + '<span>' + t + '</span></div>'; }\nfunction errLine(t){ return '<div class=\"errline\">' + icon(\"warn\") + '<span>' + t + '</span></div>'; }\nfunction skeleton(target, n){ var h = \"\"; for (var i = 0; i < (n || 4); i++) h += '<div class=\"sk\"><b></b><div><i></i><i></i><i></i></div></div>'; el(target).innerHTML = h; }\nfunction notice(target, kind, title, text, retry){\n  var box = el(target);\n  box.innerHTML = '<div class=\"notice ' + kind + '\"><div class=\"tile\">' + icon(kind === \"off\" ? \"off\" : \"warn\") + '</div><div><b>' + esc(title) + '</b><p>' + esc(text) + '</p>' +\n    (retry ? '<button type=\"button\">' + icon(\"refresh\") + 'Try again</button>' : '') + '</div></div>';\n  if (retry) box.querySelector(\".notice button\").onclick = retry;\n}\n/* Round avatar; if there's no picture, or it fails to load, the person's initials on a hue of their own. */\nfunction hueOf(s){ var h = 0; s = String(s || \"\"); for (var i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) % 360; return h; }\nfunction initials(name){ var w = String(name || \"?\").replace(/[^\\p{L}\\p{N} ]/gu, \" \").trim().split(/\\s+/); return ((w[0] || \"?\")[0] + (w.length > 1 ? w[w.length - 1][0] : \"\")).toUpperCase(); }\nfunction avatarHtml(src, name, key){\n  var ini = '<div class=\"av ini\" style=\"--ah:' + hueOf(key || name) + '\" data-ini=\"1\">' + esc(initials(name)) + '</div>';\n  return src ? '<img class=\"av\" src=\"' + esc(src) + '\" alt=\"\" loading=\"lazy\" data-name=\"' + esc(name) + '\" data-key=\"' + esc(key || name) + '\">' : ini;\n}\nfunction wireAvatars(root){\n  Array.prototype.forEach.call(root.querySelectorAll(\"img.av\"), function(img){\n    img.onerror = function(){\n      if (!img.parentNode) return;\n      var d = document.createElement(\"div\");\n      d.className = \"av ini\"; d.style.setProperty(\"--ah\", hueOf(img.getAttribute(\"data-key\")));\n      d.textContent = initials(img.getAttribute(\"data-name\"));\n      img.parentNode.replaceChild(d, img);\n    };\n  });\n}\nfunction timeAgo(iso){\n  var s = (Date.now() - new Date(iso).getTime()) / 1000;\n  if (s < 60) return \"now\";\n  if (s < 3600) return Math.floor(s/60) + \"m\";\n  if (s < 86400) return Math.floor(s/3600) + \"h\";\n  return Math.floor(s/86400) + \"d\";\n}\n\nvar HERO = \"data:image/jpeg;base64,\";\nif (HERO.indexOf(\"data:\") === 0) el(\"hero\").style.backgroundImage = \"url(\" + HERO + \")\";\n\nvar inst = \"mastodon.social\";\nvar token = \"\";\nvar tab = \"t\", curTag = \"\";\n\nfunction base(){ return \"https://\" + inst + \"/api/v1/\"; }\nfunction showTab(t){\n  haptic(\"selection\");\n  tab = t;\n  [\"T\",\"H\",\"W\",\"S\"].forEach(function(k){\n    el(\"pane\" + k).hidden = true;\n    el(\"tab\" + k).className = \"\";\n  });\n  el(\"pane\" + t.toUpperCase()).hidden = false;\n  el(\"tab\" + t.toUpperCase()).className = \"on\";\n  el(\"refresh\").classList.toggle(\"gone\", t === \"w\" || t === \"s\");\n  if (t === \"h\") loadHome();\n}\n\n/* Mastodon content is HTML — reduce it to safe plain text with line breaks */\nfunction plain(html){\n  var withBreaks = String(html).replace(/<br\\s*\\/?>/gi, \"\\n\").replace(/<\\/p>\\s*<p[^>]*>/gi, \"\\n\\n\");\n  var doc = new DOMParser().parseFromString(withBreaks, \"text/html\");\n  return (doc.body.textContent || \"\").trim();\n}\n\nfunction statusCard(st){\n  var real = st.reblog || st;\n  var a = real.account || {};\n  var media = \"\";\n  var pics = (real.media_attachments || []).filter(function(m){ return m.type === \"image\" && m.preview_url; });\n  if (pics.length){\n    media = '<div class=\"media\">' + pics.slice(0,2).map(function(m){\n      return '<img src=\"' + esc(m.preview_url) + '\" alt=\"' + esc(m.description || \"\") + '\" loading=\"lazy\">';\n    }).join(\"\") + '</div>';\n  }\n  var cw = real.spoiler_text ? '<div class=\"cw\">' + icon(\"warn\") + esc(real.spoiler_text) + '</div>' : \"\";\n  var name = a.display_name || a.acct || \"?\";\n  return '<div class=\"card\"><div class=\"post\">' + avatarHtml(a.avatar, name, a.acct) +\n    '<div class=\"b\"><div class=\"who\"><b>' + esc(name) + '</b> ' +\n    '<span>@' + esc(a.acct || \"\") + ' · ' + timeAgo(real.created_at) + '</span></div>' + cw +\n    '<div class=\"txt\">' + esc(plain(real.content)) + '</div>' + media +\n    '<div class=\"foot\"><span aria-label=\"Replies\">' + icon(\"chat\") + (real.replies_count || 0) + '</span><span aria-label=\"Boosts\">' + icon(\"repost\") + (real.reblogs_count || 0) + '</span><span aria-label=\"Favourites\">' + icon(\"star\") + (real.favourites_count || 0) + '</span>' +\n    '<a href=\"' + esc(real.url || \"#\") + '\">Open' + icon(\"ext\") + '</a></div>' +\n    '</div></div></div>';\n}\nfunction showStatuses(target, sts, emptyTitle, emptyText){\n  if (!sts.length){ el(target).insertAdjacentHTML(\"beforeend\", '<div class=\"card empty\"><div class=\"tile\">' + icon(\"hash\") + '</div><b>' + esc(emptyTitle) + '</b><p>' + esc(emptyText) + '</p></div>'); return; }\n  el(target).insertAdjacentHTML(\"beforeend\", sts.map(statusCard).join(\"\"));\n  wireAvatars(el(target));\n}\n\nfunction netGuard(target, retry){\n  if (!hasNet()){\n    notice(target, \"off\", \"Network access is off\", \"Mastodon Feed needs “Allow apps to use the internet” in MyLLM’s Settings.\", retry);\n    return false;\n  }\n  return true;\n}\nfunction busy(on){ el(\"refresh\").classList.toggle(\"busy\", on); }\n\n/* ---------- trending ---------- */\nfunction loadTrends(){\n  if (!netGuard(\"trendbox\", loadTrends)) return;\n  el(\"trendbox\").innerHTML = '<label class=\"k\">Trending on ' + esc(inst) + '</label><div class=\"tagchips\">' +\n    '<span class=\"tagchip\" style=\"width:90px;opacity:.5\"></span><span class=\"tagchip\" style=\"width:120px;opacity:.5\"></span><span class=\"tagchip\" style=\"width:70px;opacity:.5\"></span></div>';\n  busy(true);\n  NET(base() + \"trends/tags?limit=10\")\n  .then(function(r){\n    var tags = JSON.parse(r.body);\n    if (!tags.length) throw new Error(\"empty\");\n    el(\"trendbox\").innerHTML = '<label class=\"k\">Trending on ' + esc(inst) + '</label><div class=\"tagchips\">' +\n      tags.map(function(t){\n        var uses = (t.history && t.history[0]) ? t.history[0].uses : \"\";\n        return '<button type=\"button\" class=\"tagchip' + (t.name === curTag ? ' hot' : '') + '\" data-tag=\"' + esc(t.name) + '\">#' + esc(t.name) +\n          (uses ? ' <small>' + esc(uses) + '</small>' : '') + '</button>';\n      }).join(\"\") + '</div>';\n    Array.prototype.forEach.call(el(\"trendbox\").querySelectorAll(\".tagchip\"), function(b){\n      b.onclick = function(){ loadTag(b.getAttribute(\"data-tag\")); };\n    });\n  })\n  .catch(function(){\n    el(\"trendbox\").innerHTML = '';\n    notice(\"trendbox\", \"err\", \"Couldn’t load trends from \" + inst, \"Check the instance name in Setup.\", loadTrends);\n  })\n  .then(function(){ busy(false); });\n}\nfunction markTag(){\n  Array.prototype.forEach.call(el(\"trendbox\").querySelectorAll(\".tagchip\"), function(b){ b.classList.toggle(\"hot\", b.getAttribute(\"data-tag\") === curTag); });\n}\nfunction clearTag(){ curTag = \"\"; el(\"feedT\").innerHTML = \"\"; markTag(); window.scrollTo(0,0); }\nfunction loadTag(tag){\n  haptic(\"light\");\n  curTag = tag; markTag();\n  if (!netGuard(\"feedT\", function(){ loadTag(tag); })) return;\n  skeleton(\"feedT\", 3);\n  NET(base() + \"timelines/tag/\" + encodeURIComponent(tag) + \"?limit=25\")\n  .then(function(r){\n    var sts = JSON.parse(r.body);\n    if (curTag !== tag) return;\n    el(\"feedT\").innerHTML = '<div class=\"crumb\">' + icon(\"hash\") + '<span>' + esc(tag) + '</span><button type=\"button\" id=\"clearTag\">' + icon(\"x\") + 'Clear</button></div>';\n    el(\"clearTag\").onclick = clearTag;\n    showStatuses(\"feedT\", sts, \"Nothing recent\", \"Nothing recent under #\" + tag + \".\");\n  })\n  .catch(function(){\n    notice(\"feedT\", \"err\", \"That tag wouldn’t load\", \"The instance may keep tag timelines private.\", function(){ loadTag(tag); });\n  });\n}\n\n/* ---------- home ---------- */\nfunction loadHome(){\n  if (!token){\n    el(\"feedH\").innerHTML = '<div class=\"card empty\"><div class=\"tile\">' + icon(\"mega\") + '</div><b>Your own timeline</b><p>Home shows the people you follow — add your access token in Setup.</p><button type=\"button\" onclick=\"showTab(\\'s\\')\">Open Setup</button></div>';\n    return;\n  }\n  if (!netGuard(\"feedH\", loadHome)) return;\n  skeleton(\"feedH\", 4); busy(true);\n  NET(base() + \"timelines/home?limit=25\", {headers:{\"Authorization\":\"Bearer \" + token}})\n  .then(function(r){\n    var sts = JSON.parse(r.body);\n    if (sts.error) throw new Error(sts.error);\n    el(\"feedH\").innerHTML = \"\";\n    showStatuses(\"feedH\", sts, \"Your timeline is quiet\", \"Follow a few people and their posts will show up here.\");\n  })\n  .catch(function(){\n    notice(\"feedH\", \"err\", \"Couldn’t load your timeline\", \"Check the token and instance in Setup.\", loadHome);\n  })\n  .then(function(){ busy(false); });\n}\n\n/* ---------- posting ---------- */\nfunction onCompose(){\n  var n = el(\"compose\").value.length;\n  el(\"ccount\").textContent = n;\n  el(\"ccount\").className = n > 500 ? \"over\" : \"\";\n}\nfunction postBtn(on){\n  var b = el(\"postBtn\"); b.disabled = on;\n  b.innerHTML = on ? '<i class=\"spin\"></i><span>Posting…</span>' : icon(\"send\") + '<span>Post to Mastodon</span>';\n}\nfunction doPost(){\n  var text = el(\"compose\").value.trim();\n  if (!text){ el(\"postmsg\").innerHTML = errLine(\"Write something first.\"); return; }\n  if (text.length > 500){ el(\"postmsg\").innerHTML = errLine(\"Too long — 500 characters max.\"); return; }\n  if (!token){ el(\"postmsg\").innerHTML = errLine(\"Add your access token in Setup first.\"); return; }\n  if (!hasNet()){ el(\"postmsg\").innerHTML = errLine(\"Needs internet access for apps (MyLLMos settings).\"); return; }\n  haptic(\"light\");\n  postBtn(true);\n  el(\"postmsg\").innerHTML = \"\";\n  NET(base() + \"statuses\", {\n    method:\"POST\",\n    headers:{\"Content-Type\":\"application/json\", \"Authorization\":\"Bearer \" + token},\n    body:JSON.stringify({status:text})\n  })\n  .then(function(r){\n    var j = JSON.parse(r.body);\n    if (!j.id) throw new Error(j.error || \"Posting failed.\");\n    el(\"compose\").value = \"\"; onCompose();\n    el(\"postmsg\").innerHTML = okLine(\"Posted — it's live on \" + esc(inst) + \".\");\n    postBtn(false);\n    haptic(\"success\");\n  })\n  .catch(function(e){\n    el(\"postmsg\").innerHTML = errLine(esc(e && e.message ? e.message : \"Something went wrong — try again.\"));\n    postBtn(false);\n  });\n}\n\n/* ---------- setup ---------- */\nfunction saveSetup(){\n  var i = el(\"inst\").value.trim().replace(/^https?:\\/\\//, \"\").replace(/\\/.*$/, \"\");\n  if (i) inst = i;\n  token = el(\"token\").value.trim();\n  store().setItem(\"masto_setup\", JSON.stringify({inst:inst, token:token}));\n  el(\"setupmsg\").innerHTML = okLine(\"Saved. \" + (token ? \"Home and posting are ready.\" : \"Browsing \" + esc(inst) + \" — add a token for Home and posting.\"));\n  haptic(\"success\");\n  loadTrends();\n}\n\nel(\"refresh\").onclick = function(){\n  if (el(\"refresh\").classList.contains(\"busy\")) return;\n  haptic(\"light\");\n  if (tab === \"h\") loadHome();\n  else { loadTrends(); if (curTag) loadTag(curTag); }\n};\n\n/* ---------- boot ---------- */\nstore().getItem(\"masto_setup\").then(function(v){\n  if (v){ try{\n    var s = JSON.parse(v);\n    if (s.inst) inst = s.inst;\n    if (s.token) token = s.token;\n  }catch(e){} }\n  el(\"inst\").value = inst;\n  loadTrends();\n});\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes.\n   The spacer keeps the header clear of the status bar / Dynamic Island. It is\n   live CSS — env(safe-area-inset-top) — not a measured number: the inset is\n   still 0 when the page loads and only grows once MyLLM's bar has gone (v1\n   measured once, so the title sat under the island). If the page's own styles\n   already pad the header down by the inset, the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  /* Does any rule that applies to the header or an ancestor already use the top inset? */\n  function pageHandlesInset(head){\n    var chain = [], n, found = false;\n    for (n = head; n && n.nodeType === 1; n = n.parentElement) chain.push(n);\n    function walk(rules){\n      for (var i = 0; i < rules.length && !found; i++){\n        var r = rules[i];\n        if (r.cssRules && !r.selectorText) { walk(r.cssRules); continue; }\n        if (!r.selectorText || !/safe-area-inset-top/.test(r.cssText) || !/(padding|margin|top)\\s*:/.test(r.cssText)) continue;\n        if (/\\.imm-safe/.test(r.selectorText)) continue;\n        for (var k = 0; k < chain.length; k++){\n          try { if (chain[k].matches(r.selectorText)) { found = true; break; } } catch(e){}\n        }\n      }\n    }\n    for (var s = 0; s < document.styleSheets.length && !found; s++){\n      try { walk(document.styleSheets[s].cssRules); } catch(e){}\n    }\n    for (n = head; n && n.nodeType === 1 && !found; n = n.parentElement){\n      if (/safe-area-inset-top/.test(n.getAttribute(\"style\") || \"\")) found = true;\n    }\n    return found;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = (document.body.classList.contains(\"imm\") && !pageHandlesInset(head)) ? \"env(safe-area-inset-top)\" : \"0px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script>\n</body>\n</html>\n"}