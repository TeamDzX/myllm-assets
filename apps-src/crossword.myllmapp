{"name": "Crossword", "html": "<!doctype html>\n<!--\n  Crossword — MyLLMos App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Crossword</title>\n<style>\n:root{--build-id:\"cd96ba932f\";\n  color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7);--surface:var(--myllm-surface,#fff);\n  --text:var(--myllm-text,#111);--muted:var(--myllm-muted,#6b6b72);\n  --accent:var(--myllm-accent,#0b5ed7);--border:var(--myllm-border,rgba(120,120,128,.3));\n  --radius:var(--myllm-radius,12px);--font:var(--myllm-font,-apple-system,system-ui,sans-serif);\n  --cell:#fff;--block:#2a2a30;--sel:#ffe08a;--word:#cfe6ff;--wrong:#ffd1d1;\n}\n@media(prefers-color-scheme:dark){:root{--bg:var(--myllm-bg,#000);--surface:var(--myllm-surface,#1c1c1e);--text:var(--myllm-text,#eee);--muted:var(--myllm-muted,#98989f);--cell:#26262b;--block:#000;--sel:#7a6420;--word:#1d3a57;--wrong:#5a2030}}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none}\nbody{margin:0;font-family:var(--font);background:var(--bg);color:var(--text)}\n.wrap{max-width:460px;margin:0 auto;padding:10px 12px 18px}\n.bar{display:flex;align-items:center;gap:8px;margin-bottom:8px}\n.bar .t{font-size:13px;color:var(--muted)}.bar .sp{flex:1}\n.bar button{border:0;background:var(--surface);border:1px solid var(--border);color:var(--accent);border-radius:9px;padding:7px 10px;font:inherit;font-weight:600;font-size:13px;cursor:pointer}\n.grid{display:grid;gap:2px;background:var(--border);border:2px solid var(--border);border-radius:6px;overflow:hidden;margin:0 auto;width:100%;aspect-ratio:1}\n.cell{position:relative;border:0;background:var(--cell);color:var(--text);font:inherit;font-weight:700;font-size:min(7vw,30px);display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0}\n.cell.block{background:var(--block);cursor:default}\n.cell.word{background:var(--word)}\n.cell.sel{background:var(--sel)}\n.cell.wrong{background:var(--wrong)}\n.cell .n{position:absolute;top:1px;left:2px;font-size:10px;font-weight:600;color:var(--muted)}\n.clue{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:11px 13px;margin:10px 0;font-size:15px;line-height:1.4;display:flex;align-items:center;gap:8px;min-height:46px}\n.clue .dir{flex:none;font-weight:700;color:var(--accent);font-size:13px}\n.clue .arr{flex:none;border:0;background:none;color:var(--accent);font-size:18px;cursor:pointer;padding:4px}\n.kb{display:flex;flex-direction:column;gap:6px}\n.kbrow{display:flex;gap:5px;justify-content:center}\n.key{flex:1;max-width:34px;height:46px;border:0;border-radius:7px;background:var(--surface);border:1px solid var(--border);color:var(--text);font:inherit;font-weight:600;font-size:17px;cursor:pointer}\n.key.wide{max-width:58px;font-size:14px}\n.key:active{background:var(--accent);color:#fff}\n.win{text-align:center;color:var(--accent);font-weight:700;font-size:16px;padding:8px;display:none}\n.sheet{position:fixed;inset:0;background:rgba(0,0,0,.5);display:none;align-items:flex-end;z-index:30}\n.sheet.show{display:flex}\n.sheetB{background:var(--bg);width:100%;border-radius:18px 18px 0 0;padding:16px;max-height:70%;overflow:auto}\n.sheetB h3{margin:0 0 12px}\n.pz{display:flex;justify-content:space-between;align-items:center;padding:13px;border:1px solid var(--border);border-radius:11px;margin-bottom:8px;background:var(--surface);cursor:pointer}\n.pz .dn{color:#2bb673;font-size:13px;font-weight:700}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <div class=\"bar\">\n    <span class=\"t\" id=\"pzName\">Mini 1</span><span class=\"t\" id=\"timer\">0:00</span>\n    <span class=\"sp\"></span>\n    <button id=\"checkBtn\">Check</button>\n    <button id=\"revealBtn\">Reveal</button>\n    <button id=\"puzBtn\">Puzzles</button>\n  </div>\n  <div class=\"grid\" id=\"grid\"></div>\n  <div class=\"win\" id=\"win\">Solved! 🎉</div>\n  <div class=\"clue\"><button class=\"arr\" id=\"prevClue\">‹</button><span class=\"dir\" id=\"clueDir\">1A</span><span id=\"clueText\">—</span><button class=\"arr\" id=\"nextClue\">›</button></div>\n  <div class=\"kb\" id=\"kb\"></div>\n</div>\n<div class=\"sheet\" id=\"sheet\"><div class=\"sheetB\"><h3>Puzzles</h3><div id=\"pzList\"></div></div></div>\n\n<script>\nvar PUZZLES=[\n {id:\"cw1\",name:\"Mini 1\",rows:[\"THAN\",\"HIRE\",\"IDEA\",\"SEAT\"],\n  clues:{A:{1:\"Comparison word: \\u201cbigger ___\\u201d\",5:\"Take on for a job\",6:\"A bright thought \\ud83d\\udca1\",7:\"Where you sit\"},\n         D:{1:\"Opposite of \\u201cthat\\u201d\",2:\"Conceal \\u2014 or an animal\\u2019s skin\",3:\"Region or zone\",4:\"Tidy\"}}},\n {id:\"cw2\",name:\"Mini 2\",rows:[\"SHOW\",\"LAME\",\"EVEN\",\"DENT\"],\n  clues:{A:{1:\"Put on display\",5:\"Feeble, as an excuse\",6:\"Flat and level; not odd\",7:\"Hollow left by a knock\"},\n         D:{1:\"Ride for snowy hills\",2:\"Possess\",3:\"A sign of things to come\",4:\"Travelled (past tense of \\u201cgo\\u201d)\"}}},\n {id:\"cw3\",name:\"Mini 3\",rows:[\"CHOP\",\"LIVE\",\"AREA\",\"PERK\"],\n  clues:{A:{1:\"Cut with an axe\",5:\"Broadcast in real time\",6:\"Region or space\",7:\"A job benefit\"},\n         D:{1:\"Applaud\",2:\"Employ; take on\",3:\"Above \\u2014 or finished\",4:\"Mountain top\"}}},\n {id:\"cw4\",name:\"Mini 4\",rows:[\"SURF\",\"ORAL\",\"OGRE\",\"NEED\"],\n  clues:{A:{1:\"Ride the waves \\ud83c\\udfc4\",5:\"Spoken, not written\",6:\"A fairy-tale monster\",7:\"Require\"},\n         D:{1:\"In a little while\",2:\"A strong impulse\",3:\"Uncommon\",4:\"Ran away (past tense)\"}}}\n];\n\nvar P=null, N=0, user=[], nums=[], entries=[], cur=null, dir='A', timer=0, tInt=null, solved=false;\nfunction $(i){return document.getElementById(i)}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nfunction isBlock(r,c){return P.rows[r][c]==='#'}\n\nfunction build(){\n  N=P.rows.length;\n  user=P.rows.map(function(row){return row.split('').map(function(ch){return ch==='#'?'#':''})});\n  // numbering + entries\n  nums=P.rows.map(function(row){return row.split('').map(function(){return 0})});\n  entries=[];var n=0;\n  for(var r=0;r<N;r++)for(var c=0;c<N;c++){\n    if(isBlock(r,c))continue;\n    var startA=(c===0||isBlock(r,c-1))&&c+1<N&&!isBlock(r,c+1);\n    var startD=(r===0||isBlock(r-1,c))&&r+1<N&&!isBlock(r+1,c);\n    if(startA||startD){n++;nums[r][c]=n;\n      if(startA){var cells=[];for(var cc=c;cc<N&&!isBlock(r,cc);cc++)cells.push([r,cc]);entries.push({num:n,dir:'A',cells:cells,clue:(P.clues.A[n]||'')})}\n      if(startD){var cd=[];for(var rr=r;rr<N&&!isBlock(rr,c);rr++)cd.push([rr,c]);entries.push({num:n,dir:'D',cells:cd,clue:(P.clues.D[n]||'')})}\n    }\n  }\n}\nfunction entryAt(r,c,d){return entries.find(function(e){return e.dir===d&&e.cells.some(function(x){return x[0]===r&&x[1]===c})})}\nfunction curEntry(){return cur?entryAt(cur[0],cur[1],dir):null}\n\nfunction render(){\n  var g=$('grid');g.style.gridTemplateColumns='repeat('+N+',1fr)';g.innerHTML='';\n  var ce=curEntry();\n  for(var r=0;r<N;r++)for(var c=0;c<N;c++){\n    var b=document.createElement('button');\n    if(isBlock(r,c)){b.className='cell block';g.appendChild(b);continue}\n    b.className='cell';\n    if(ce&&ce.cells.some(function(x){return x[0]===r&&x[1]===c}))b.className+=' word';\n    if(cur&&cur[0]===r&&cur[1]===c)b.className+=' sel';\n    if(nums[r][c]){var s=document.createElement('span');s.className='n';s.textContent=nums[r][c];b.appendChild(s)}\n    var t=document.createTextNode(user[r][c]||'');b.appendChild(t);\n    (function(rr,cc){b.onclick=function(){onCell(rr,cc)}})(r,c);\n    g.appendChild(b);\n  }\n  var e=curEntry();\n  $('clueDir').textContent=e?(e.num+(e.dir==='A'?'A':'D')):'';\n  $('clueText').textContent=e?e.clue:'';\n}\nfunction onCell(r,c){\n  if(isBlock(r,c))return;\n  if(cur&&cur[0]===r&&cur[1]===c){dir=dir==='A'?'D':'A';if(!entryAt(r,c,dir))dir=dir==='A'?'D':'A'}\n  else{cur=[r,c];if(!entryAt(r,c,dir))dir=dir==='A'?'D':'A'}\n  haptic('selection');render();\n}\nfunction type(ch){\n  if(!cur||solved)return;\n  user[cur[0]][cur[1]]=ch;haptic('light');\n  var e=curEntry();if(e){var i=e.cells.findIndex(function(x){return x[0]===cur[0]&&x[1]===cur[1]});\n    // advance to next empty cell in entry, else next cell\n    var j=i+1;while(j<e.cells.length&&user[e.cells[j][0]][e.cells[j][1]])j++;\n    if(j>=e.cells.length)j=i+1;\n    if(j<e.cells.length)cur=e.cells[j];\n  }\n  render();save();checkWin();\n}\nfunction backspace(){\n  if(!cur||solved)return;haptic('light');\n  if(user[cur[0]][cur[1]]){user[cur[0]][cur[1]]=''}\n  else{var e=curEntry();if(e){var i=e.cells.findIndex(function(x){return x[0]===cur[0]&&x[1]===cur[1]});if(i>0){cur=e.cells[i-1];user[cur[0]][cur[1]]=''}}}\n  render();save();\n}\nfunction moveClue(delta){\n  var e=curEntry(),idx=e?entries.indexOf(e):-1;\n  var ni=((idx+delta)%entries.length+entries.length)%entries.length;\n  var ne=entries[ni];dir=ne.dir;cur=ne.cells[0];haptic('selection');render();\n}\n\nfunction buildKeyboard(){\n  var rows=['QWERTYUIOP','ASDFGHJKL','ZXCVBNM'];var KB=$('kb');KB.innerHTML='';\n  rows.forEach(function(row,ri){\n    var d=document.createElement('div');d.className='kbrow';\n    if(ri===2){var del=document.createElement('button');del.className='key wide';del.textContent='⌫';del.onclick=backspace;d.appendChild(del)}\n    row.split('').forEach(function(ch){var k=document.createElement('button');k.className='key';k.textContent=ch;k.onclick=function(){type(ch)};d.appendChild(k)});\n    if(ri===2){var clr=document.createElement('button');clr.className='key wide';clr.textContent='Clear';clr.onclick=clearPuzzle;d.appendChild(clr)}\n    KB.appendChild(d);\n  });\n}\n\nfunction check(){\n  haptic('warning');\n  var els=$('grid').querySelectorAll('.cell');var k=0;\n  for(var r=0;r<N;r++)for(var c=0;c<N;c++){var b=els[k++];if(isBlock(r,c))continue;\n    if(user[r][c]&&user[r][c]!==P.rows[r][c])b.classList.add('wrong');\n  }\n  setTimeout(function(){$('grid').querySelectorAll('.wrong').forEach(function(x){x.classList.remove('wrong')})},1200);\n}\nfunction revealWord(){\n  var e=curEntry();if(!e)return;haptic('medium');\n  e.cells.forEach(function(x){user[x[0]][x[1]]=P.rows[x[0]][x[1]]});\n  render();save();checkWin();\n}\nfunction clearPuzzle(){\n  user=P.rows.map(function(row){return row.split('').map(function(ch){return ch==='#'?'#':''})});\n  solved=false;$('win').style.display='none';render();save();haptic('warning');\n}\nfunction checkWin(){\n  for(var r=0;r<N;r++)for(var c=0;c<N;c++){if(!isBlock(r,c)&&user[r][c]!==P.rows[r][c])return}\n  solved=true;$('win').style.display='block';stopTimer();haptic('success');save();\n}\n\nfunction startTimer(){stopTimer();tInt=setInterval(function(){if(!solved){timer++;$('timer').textContent=fmt(timer);save()}},1000)}\nfunction stopTimer(){if(tInt){clearInterval(tInt);tInt=null}}\nfunction fmt(s){return Math.floor(s/60)+':'+(s%60<10?'0':'')+(s%60)}\n\nfunction loadPuzzle(i,fresh){\n  P=PUZZLES[i];$('pzName').textContent=P.name;build();\n  if(fresh){timer=0;solved=false}\n  // restore saved progress\n  if(window.myllmStorage){\n    myllmStorage.getItem('cw_'+P.id).then(function(v){\n      if(v&&!fresh)try{var s=JSON.parse(v);if(s.user)user=s.user;if(s.timer)timer=s.timer;if(s.solved)solved=s.solved}catch(e){}\n      cur=entries[0].cells[0];dir=entries[0].dir;\n      $('win').style.display=solved?'block':'none';$('timer').textContent=fmt(timer);\n      render();startTimer();\n    });\n  }else{cur=entries[0].cells[0];dir=entries[0].dir;render();startTimer()}\n  curPuz=i;saveCur();\n}\nvar curPuz=0;\nfunction save(){if(window.myllmStorage&&P)myllmStorage.setItem('cw_'+P.id,JSON.stringify({user:user,timer:timer,solved:solved}))}\nfunction saveCur(){if(window.myllmStorage)myllmStorage.setItem('cw_last',String(curPuz))}\n\n$('checkBtn').onclick=check;\n$('revealBtn').onclick=revealWord;\n$('prevClue').onclick=function(){moveClue(-1)};\n$('nextClue').onclick=function(){moveClue(1)};\n$('puzBtn').onclick=function(){openPuz()};\n$('sheet').onclick=function(e){if(e.target===$('sheet'))$('sheet').classList.remove('show')};\nfunction openPuz(){\n  var L=$('pzList');L.innerHTML='';\n  PUZZLES.forEach(function(pz,i){\n    var d=document.createElement('div');d.className='pz';\n    d.innerHTML='<span>'+pz.name+'</span><span class=\"dn\" id=\"dn'+i+'\"></span>';\n    d.onclick=function(){$('sheet').classList.remove('show');stopTimer();loadPuzzle(i,false)};\n    L.appendChild(d);\n    if(window.myllmStorage)myllmStorage.getItem('cw_'+pz.id).then(function(v){try{if(v&&JSON.parse(v).solved){var e=$('dn'+i);if(e)e.textContent='Solved ✓'}}catch(e){}});\n  });\n  $('sheet').classList.add('show');haptic('selection');\n}\n\nbuildKeyboard();\nif(window.myllmStorage){myllmStorage.getItem('cw_last').then(function(v){loadPuzzle(v?(+v||0):0,false)})}\nelse loadPuzzle(0,false);\n</script>\n</body>\n</html>\n", "kind": "html", "iconSymbol": "square.grid.3x3.fill", "iconColor": "blue"}