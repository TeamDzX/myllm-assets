{"name": "Crossword", "html": "<!doctype html>\n<!--\n  Crossword — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,user-scalable=no,viewport-fit=cover\">\n<title>Crossword</title>\n<style>:root{--build-id:\"cd96ba932f\";color-scheme:light dark}\n  @property --h{ syntax:'<number>'; inherits:true; initial-value:214; }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  html,body{ height:100%; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:#0b0b10; color:#fff; overflow:hidden;\n    touch-action:none; overscroll-behavior:none; -webkit-user-select:none; user-select:none; }\n  button{ font:inherit; color:inherit; }\n\n  /* The stage: a hue-tinted backdrop in two layers, dark and light, so the\n     change between them can fade. */\n  .stage{ position:fixed; inset:0; --h:214; transition:--h 1.4s ease; color:#fff; }\n  .bg{ position:absolute; inset:0; transition:opacity .6s ease; }\n  .bg.d{ background:radial-gradient(120% 90% at 20% 10%, hsl(var(--h) 70% 34%), transparent 60%),\n      radial-gradient(120% 90% at 85% 95%, hsl(calc(var(--h) + 60) 65% 26%), transparent 62%), #0b0b10; }\n  .bg.l{ opacity:0; background:radial-gradient(120% 90% at 20% 0%, hsl(var(--h) 80% 84%), transparent 60%),\n      radial-gradient(120% 90% at 85% 100%, hsl(calc(var(--h) + 60) 78% 86%), transparent 62%), #f4f4f8; }\n  .lite{ color:#15151a; } .lite .bg.l{ opacity:1; } .lite .bg.d{ opacity:0; }\n\n  .col{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center;\n    padding:calc(12px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(14px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  .top{ width:100%; max-width:560px; height:44px; display:flex; align-items:center; justify-content:space-between; flex-shrink:0; }\n  .lbl{ font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; opacity:.62; white-space:nowrap; }\n  .glass{ border:1px solid rgba(255,255,255,.16); background:rgba(255,255,255,.12); color:inherit;\n    -webkit-backdrop-filter:blur(18px); backdrop-filter:blur(18px); }\n  .lite .glass{ border-color:rgba(0,0,0,.09); background:rgba(255,255,255,.62); }\n  svg{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  .rnd{ width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:15px; flex-shrink:0; }\n  .pill{ min-width:44px; height:44px; border-radius:99px; padding:0 16px; display:flex; align-items:center; justify-content:center; gap:6px;\n    font-size:19px; font-weight:800; font-variant-numeric:tabular-nums; flex-shrink:0; }\n  .pill small{ font-size:10px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; opacity:.6; }\n  .pill.bump{ animation:bump .28s ease; }\n  @keyframes bump{ 40%{ transform:scale(1.18); } }\n  .top .hide{ visibility:hidden; }\n\n  .wrap{ flex:1; width:100%; min-height:0; position:relative; display:flex; align-items:center; justify-content:center; margin:10px 0 34px; }\n  .foot{ position:absolute; left:0; right:0; top:calc(50% + var(--bh,320px) / 2 + 12px); text-align:center; font-size:12px; font-weight:600;\n    letter-spacing:.02em; opacity:.55; font-variant-numeric:tabular-nums; white-space:nowrap; }\n\n  /* One glass card over the board: title, paused, finished. */\n  .sheet{ position:absolute; left:50%; top:50%; width:max(232px, min(300px, calc(var(--b,320px) - 44px))); transform:translate(-50%,-50%) scale(.96);\n    opacity:0; pointer-events:none; border-radius:26px; padding:22px 20px 18px; text-align:center; box-shadow:0 24px 60px rgba(0,0,0,.35); z-index:5;\n    transition:opacity .28s ease, transform .28s cubic-bezier(.2,.8,.2,1); }\n  .sheet.on{ opacity:1; transform:translate(-50%,-50%); pointer-events:auto; }\n  /* whatever sits under an open card steps back, so the card reads */\n  .under{ transition:opacity .3s, filter .3s; } .veil .under{ opacity:.28; filter:blur(2px); }\n  .lite .sheet{ box-shadow:0 22px 50px rgba(20,20,40,.18); }\n  .sheet h1{ font-size:30px; font-weight:800; letter-spacing:-.02em; }\n  .sheet p{ font-size:13.5px; line-height:1.4; opacity:.72; margin-top:6px; }\n  .kick{ font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; opacity:.62; }\n  .big{ font-size:64px; font-weight:800; line-height:1.05; letter-spacing:-.03em; font-variant-numeric:tabular-nums; margin-top:4px; }\n  .big small{ display:block; font-size:12px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.6; margin-top:2px; }\n  .best{ display:inline-block; margin-top:10px; font-size:11.5px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; opacity:.7; }\n  .best.new{ opacity:1; color:#0b0b10; background:#ffd60a; border-radius:99px; padding:5px 11px; }\n  .sheet .act{ width:100%; height:50px; border-radius:99px; margin-top:10px; font-size:16px; font-weight:750;\n    display:flex; align-items:center; justify-content:center; gap:8px; }\n  .sheet .act:first-of-type{ margin-top:18px; }\n  .sheet .act:active, .rnd:active{ transform:scale(.96); }\n  .pri{ border:none; background:#fff; color:#0b0b10; box-shadow:0 10px 30px rgba(0,0,0,.3); }\n  .lite .pri{ background:#15151a; color:#fff; box-shadow:0 10px 26px rgba(20,20,40,.22); }\n\n  @media (max-height:430px){\n    .sheet{ padding:14px 18px 14px; } .sheet h1{ font-size:24px; } .big{ font-size:42px; }\n    .sheet .act{ height:44px; margin-top:8px; } .sheet .act:first-of-type{ margin-top:12px; } .sheet p{ display:none; }\n    .wrap{ margin:6px 0 26px; }\n  }\n  @media (prefers-reduced-motion:reduce){ .pill.bump{ animation:none; } .stage{ transition:none; } }\n\n  .main{ flex:1; width:100%; max-width:760px; min-height:0; display:flex; flex-direction:column; align-items:center; }\n  .wrap{ margin:8px 0 6px; }\n  .veil .under{ pointer-events:none; opacity:.3; filter:blur(7px) saturate(.8); }\n  .dock{ width:100%; max-width:560px; flex-shrink:0; display:flex; flex-direction:column; align-items:center; gap:10px; transition:opacity .3s; }\n  .veil .dock, .home .dock{ opacity:.0; pointer-events:none; }\n  .status{ min-height:24px; font-size:16px; font-weight:750; display:flex; align-items:center; gap:8px; text-align:center; }\n  .status.bad{ color:#ff6b62; } .lite .status.bad{ color:#d92d20; }\n  .sub{ min-height:16px; font-size:12.5px; font-weight:600; opacity:.6; margin-top:-6px; text-align:center; }\n  .ctl{ display:flex; gap:10px; justify-content:center; }\n  .ctl button{ min-width:104px; height:46px; border-radius:99px; padding:0 18px; font-size:15px; font-weight:700; display:flex; align-items:center; justify-content:center; gap:8px; }\n  .ctl button:active{ transform:scale(.96); }\n  .ctl button:disabled{ opacity:.45; }\n  .spin{ width:15px; height:15px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n  .seglbl{ font-size:10.5px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.6; margin:14px 0 6px; text-align:left; }\n  .seg{ display:flex; border-radius:14px; padding:3px; gap:3px; }\n  .seg button{ flex:1; height:36px; border:0; background:none; border-radius:11px; font-size:13.5px; font-weight:700; opacity:.72; }\n  .seg button.on{ background:#fff; color:#0b0b10; opacity:1; }\n  .lite .seg button.on{ background:#15151a; color:#fff; }\n  .sheet .act.glass{ font-weight:700; }\n  @media (max-height:520px){\n    .main{ flex-direction:row; align-items:stretch; gap:22px; }\n    .wrap{ margin:4px 0; }\n    .dock{ width:230px; justify-content:center; }\n    .ctl{ flex-direction:column; width:100%; } .ctl button{ width:100%; }\n    .seglbl{ margin:8px 0 4px; } .seg button{ height:32px; }\n  }\n  @media (max-height:640px) and (min-height:521px){ .sheet{ padding:16px 16px 14px; } .sheet h1{ font-size:24px; } .sheet p{ display:none; } .sheet .act{ height:44px; margin-top:8px; } .sheet .act:first-of-type{ margin-top:12px; } .seglbl{ margin:10px 0 5px; } .seg button{ height:32px; } }\n  @media (max-height:640px){ .home .lbl{ visibility:hidden; } }\n  @media (prefers-reduced-motion:reduce){ .spin{ animation-duration:2.4s; } }\n\n  .grid{ width:var(--b,300px); height:var(--b,300px); display:grid; gap:2px; padding:2px; border-radius:14px; overflow:hidden;\n    background:hsl(var(--h) 30% 16%); box-shadow:0 20px 50px rgba(0,0,0,.4); }\n  .lite .grid{ box-shadow:0 18px 40px rgba(20,20,40,.18); }\n  .cell{ position:relative; border:0; background:#fbfbfd; color:#15151a; font-weight:800; font-size:calc(var(--b,300px) / var(--n,4) * .5);\n    display:flex; align-items:center; justify-content:center; padding:0; border-radius:4px; cursor:pointer; }\n  .cell.block{ background:hsl(var(--h) 25% 12%); cursor:default; }\n  .cell.word{ background:hsl(var(--h) 95% 90%); }\n  .cell.sel{ background:hsl(46 100% 68%); }\n  .cell.wrong{ background:#ffc6c0; }\n  .cell .n{ position:absolute; top:3px; left:4px; font-size:calc(var(--b,300px) / var(--n,4) * .16); font-weight:700; color:#6a6f86; }\n  .dock{ gap:8px; }\n  .clue{ width:100%; min-height:52px; border-radius:16px; display:flex; align-items:center; gap:6px; padding:4px; font-size:15px; line-height:1.35; }\n  .clue .arr{ width:44px; height:44px; border:0; background:none; border-radius:12px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }\n  .clue .arr:active{ background:rgba(127,127,127,.2); }\n  .clue .dir{ font-size:12px; font-weight:800; letter-spacing:.06em; opacity:.7; flex-shrink:0; }\n  .clue .txt{ flex:1; min-width:0; font-weight:600; }\n  .tools{ display:flex; gap:8px; }\n  .tools button{ height:38px; border-radius:99px; padding:0 14px; font-size:13.5px; font-weight:700; display:flex; align-items:center; gap:6px; }\n  .tools button svg{ width:1.05em; height:1.05em; }\n  .kb{ width:100%; display:flex; flex-direction:column; gap:6px; }\n  .kbrow{ display:flex; gap:5px; justify-content:center; }\n  .key{ flex:1; max-width:40px; height:46px; border:0; border-radius:9px; font-size:18px; font-weight:700;\n    background:rgba(255,255,255,.16); border:1px solid rgba(255,255,255,.14); color:inherit; display:flex; align-items:center; justify-content:center; }\n  .lite .key{ background:rgba(255,255,255,.75); border-color:rgba(0,0,0,.07); box-shadow:0 1px 0 rgba(0,0,0,.08); }\n  .key.wide{ max-width:62px; font-size:14px; }\n  .key:active{ background:hsl(var(--h) 80% 55%); color:#fff; }\n  .pz{ display:flex; align-items:center; gap:10px; width:100%; min-height:48px; border-radius:14px; padding:0 14px; margin-top:8px; font-size:15px; font-weight:700; text-align:left; }\n  .pz span{ flex:1; }\n  .pz small{ font-size:12px; font-weight:700; opacity:.65; }\n  .pz.done small{ color:#34c759; opacity:1; }\n  .pz.cur{ box-shadow:inset 0 0 0 2px hsl(var(--h) 80% 60%); }\n  .pz svg{ width:1em; height:1em; }\n  @media (max-height:640px){ .pz{ min-height:40px; margin-top:6px; } }\n  @media (max-height:520px){ .dock{ width:min(360px, 46vw); } .key{ height:40px; } .clue{ min-height:46px; } .pz{ min-height:36px; } }\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-play\" viewBox=\"0 0 24 24\"><path d=\"M8 5.5v13a1 1 0 0 0 1.52.85l10.4-6.5a1 1 0 0 0 0-1.7L9.52 4.65A1 1 0 0 0 8 5.5z\"/></symbol>\n  <symbol id=\"i-pause\" viewBox=\"0 0 24 24\"><rect x=\"6\" y=\"5\" width=\"4.2\" height=\"14\" rx=\"1.4\"/><rect x=\"13.8\" y=\"5\" width=\"4.2\" height=\"14\" rx=\"1.4\"/></symbol>\n  <symbol id=\"i-again\" viewBox=\"0 0 24 24\"><path d=\"M12 5V2.6a.6.6 0 0 0-1-.45L7.2 5.55a.6.6 0 0 0 0 .9L11 9.85a.6.6 0 0 0 1-.45V7a5.5 5.5 0 1 1-5.5 5.5 1 1 0 0 0-2 0A7.5 7.5 0 1 0 12 5z\"/></symbol>\n  <symbol id=\"i-close\" viewBox=\"0 0 24 24\"><path d=\"M6.4 5a1 1 0 0 0-1.4 1.4L10.6 12 5 17.6A1 1 0 0 0 6.4 19l5.6-5.6 5.6 5.6a1 1 0 0 0 1.4-1.4L13.4 12 19 6.4A1 1 0 0 0 17.6 5L12 10.6z\"/></symbol>\n  <symbol id=\"i-menu\" viewBox=\"0 0 24 24\"><path d=\"M4 7h16M4 12h16M4 17h16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-undo\" viewBox=\"0 0 24 24\"><path d=\"M9 7.5 4.5 12 9 16.5M5 12h9.5a5 5 0 0 1 0 10H12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-flip\" viewBox=\"0 0 24 24\"><path d=\"M7 4v14m0 0-3.5-3.5M7 18l3.5-3.5M17 20V6m0 0-3.5 3.5M17 6l3.5 3.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-prev\" viewBox=\"0 0 24 24\"><path d=\"M14.5 5.5 8 12l6.5 6.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-next\" viewBox=\"0 0 24 24\"><path d=\"M9.5 5.5 16 12l-6.5 6.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-del\" viewBox=\"0 0 24 24\"><path d=\"M9 5h10.5A1.5 1.5 0 0 1 21 6.5v11a1.5 1.5 0 0 1-1.5 1.5H9l-6-7z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\"/><path d=\"M11.5 9.5l5 5M16.5 9.5l-5 5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M5 12.6l4.6 4.6L19.2 7.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-eye\" viewBox=\"0 0 24 24\"><path d=\"M12 5.5c4.6 0 8.2 3.4 9.5 6.5-1.3 3.1-4.9 6.5-9.5 6.5S3.8 15.1 2.5 12C3.8 8.9 7.4 5.5 12 5.5z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><circle cx=\"12\" cy=\"12\" r=\"3\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-grid\" viewBox=\"0 0 24 24\"><path d=\"M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\"/></symbol>\n</defs></svg>\n<div class=\"stage home\" id=\"stage\">\n  <div class=\"bg d\"></div><div class=\"bg l\"></div>\n  <div class=\"col\">\n    <div class=\"top\">\n      <button class=\"glass rnd hide\" id=\"bMenu\" aria-label=\"Puzzles\"><svg><use href=\"#i-grid\"/></svg></button>\n      <div class=\"lbl\" id=\"pzName\">Mini 1</div>\n      <div class=\"glass pill hide\" id=\"timerPill\"><span id=\"timer\">0:00</span></div>\n    </div>\n    <div class=\"main\">\n      <div class=\"wrap\" id=\"wrap\">\n        <div class=\"grid under\" id=\"grid\"></div>\n        <div class=\"sheet glass\" id=\"sheet\"></div>\n      </div>\n      <div class=\"dock under\" id=\"dock\">\n        <div class=\"clue glass\"><button class=\"arr\" id=\"prevClue\" aria-label=\"Previous clue\"><svg><use href=\"#i-prev\"/></svg></button><span class=\"dir\" id=\"clueDir\">1A</span><span class=\"txt\" id=\"clueText\">—</span><button class=\"arr\" id=\"nextClue\" aria-label=\"Next clue\"><svg><use href=\"#i-next\"/></svg></button></div>\n        <div class=\"tools\"><button class=\"glass\" id=\"checkBtn\"><svg><use href=\"#i-check\"/></svg>Check</button><button class=\"glass\" id=\"revealBtn\"><svg><use href=\"#i-eye\"/></svg>Reveal word</button></div>\n        <div class=\"kb\" id=\"kb\"></div>\n      </div>\n    </div>\n  </div>\n</div>\n<script>\nfunction el(i){ return document.getElementById(i); }\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction haptic(s){ if (window.myllmHaptic) try { myllmHaptic(s); } catch(_){} }\nfunction load(k){ var s = window.myllmStorage; return s ? s.getItem(k).catch(function(){ return null; }) : Promise.resolve(null); }\nfunction keep(k, v){ var s = window.myllmStorage; if (s) try { s.setItem(k, v).catch(function(){}); } catch(_){} }\nvar calm = window.matchMedia && matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n\n/* ---------- look ---------- */\nfunction isLight(){ return !(window.matchMedia && matchMedia(\"(prefers-color-scheme: dark)\").matches); }\n/* A game in progress takes the whole display and goes dark. Where MyLLM can't\n   hide its own title bar, a dark stage under a white bar looks cut in half —\n   so in light mode, without myllmImmersive, the stage stays light. */\nfunction syncLook(){\n  el(\"stage\").classList.toggle(\"lite\", isLight() && !(state !== \"home\" && window.myllmImmersive));\n  if (typeof onLook === \"function\") onLook();\n}\nfunction syncChrome(){\n  if (!window.myllmImmersive) return;\n  try { myllmImmersive(state !== \"home\", {keepAwake:false}).catch(function(){}); } catch(_){}\n}\nfunction setHue(h){ el(\"stage\").style.setProperty(\"--h\", String(h)); }\nfunction showSheet(html, acts){\n  var s = el(\"sheet\"); s.innerHTML = html;\n  Object.keys(acts).forEach(function(id){ var b = el(id); if (b) b.onclick = acts[id]; });\n  s.classList.add(\"on\"); el(\"stage\").classList.add(\"veil\");\n}\nfunction hideSheet(){ el(\"sheet\").classList.remove(\"on\"); el(\"stage\").classList.remove(\"veil\"); }\nfunction bump(id){ var p = el(id); p.classList.remove(\"bump\"); void p.offsetWidth; p.classList.add(\"bump\"); }\ndocument.addEventListener(\"visibilitychange\", function(){\n  if (document.hidden){ if (typeof onHide === \"function\") onHide(); return; }\n  if (state !== \"home\") syncChrome();          /* MyLLM puts its bars back when the app is left */\n});\nif (window.matchMedia){\n  var mq = matchMedia(\"(prefers-color-scheme: dark)\");\n  if (mq.addEventListener) mq.addEventListener(\"change\", syncLook); else if (mq.addListener) mq.addListener(syncLook);\n}\nvar PUZZLES=[\n {id:\"cw1\",name:\"Mini 1\",rows:[\"THAN\",\"HIRE\",\"IDEA\",\"SEAT\"],\n  clues:{A:{1:\"Comparison word: \\u201cbigger ___\\u201d\",5:\"Take on for a job\",6:\"A bright thought \\ud83d\\udca1\",7:\"Where you sit\"},\n         D:{1:\"Opposite of \\u201cthat\\u201d\",2:\"Conceal \\u2014 or an animal\\u2019s skin\",3:\"Region or zone\",4:\"Tidy\"}}},\n {id:\"cw2\",name:\"Mini 2\",rows:[\"SHOW\",\"LAME\",\"EVEN\",\"DENT\"],\n  clues:{A:{1:\"Put on display\",5:\"Feeble, as an excuse\",6:\"Flat and level; not odd\",7:\"Hollow left by a knock\"},\n         D:{1:\"Ride for snowy hills\",2:\"Possess\",3:\"A sign of things to come\",4:\"Travelled (past tense of \\u201cgo\\u201d)\"}}},\n {id:\"cw3\",name:\"Mini 3\",rows:[\"CHOP\",\"LIVE\",\"AREA\",\"PERK\"],\n  clues:{A:{1:\"Cut with an axe\",5:\"Broadcast in real time\",6:\"Region or space\",7:\"A job benefit\"},\n         D:{1:\"Applaud\",2:\"Employ; take on\",3:\"Above \\u2014 or finished\",4:\"Mountain top\"}}},\n {id:\"cw4\",name:\"Mini 4\",rows:[\"SURF\",\"ORAL\",\"OGRE\",\"NEED\"],\n  clues:{A:{1:\"Ride the waves \\ud83c\\udfc4\",5:\"Spoken, not written\",6:\"A fairy-tale monster\",7:\"Require\"},\n         D:{1:\"In a little while\",2:\"A strong impulse\",3:\"Uncommon\",4:\"Ran away (past tense)\"}}}\n];\n\nvar P = null, N = 0, user = [], nums = [], entries = [], cur = null, dir = 'A', timer = 0, tInt = null, solved = false;\nvar state = \"home\";\nfunction $(i){ return document.getElementById(i); }\nfunction isBlock(r,c){ return P.rows[r][c] === '#'; }\n\nfunction build(){\n  N = P.rows.length;\n  user = P.rows.map(function(row){ return row.split('').map(function(ch){ return ch === '#' ? '#' : ''; }); });\n  // numbering + entries\n  nums = P.rows.map(function(row){ return row.split('').map(function(){ return 0; }); });\n  entries = []; var n = 0;\n  for (var r = 0; r < N; r++) for (var c = 0; c < N; c++){\n    if (isBlock(r,c)) continue;\n    var startA = (c === 0 || isBlock(r,c-1)) && c + 1 < N && !isBlock(r,c+1);\n    var startD = (r === 0 || isBlock(r-1,c)) && r + 1 < N && !isBlock(r+1,c);\n    if (startA || startD){ n++; nums[r][c] = n;\n      if (startA){ var cells = []; for (var cc = c; cc < N && !isBlock(r,cc); cc++) cells.push([r,cc]); entries.push({num:n, dir:'A', cells:cells, clue:(P.clues.A[n] || '')}); }\n      if (startD){ var cd = []; for (var rr = r; rr < N && !isBlock(rr,c); rr++) cd.push([rr,c]); entries.push({num:n, dir:'D', cells:cd, clue:(P.clues.D[n] || '')}); }\n    }\n  }\n}\nfunction entryAt(r,c,d){ return entries.find(function(e){ return e.dir === d && e.cells.some(function(x){ return x[0] === r && x[1] === c; }); }); }\nfunction curEntry(){ return cur ? entryAt(cur[0], cur[1], dir) : null; }\n\nfunction render(){\n  var g = $('grid'); g.style.gridTemplateColumns = 'repeat(' + N + ',1fr)'; g.style.setProperty('--n', N); g.innerHTML = '';\n  var ce = curEntry();\n  for (var r = 0; r < N; r++) for (var c = 0; c < N; c++){\n    var b = document.createElement('button');\n    if (isBlock(r,c)){ b.className = 'cell block'; g.appendChild(b); continue; }\n    b.className = 'cell';\n    if (ce && !solved && ce.cells.some(function(x){ return x[0] === r && x[1] === c; })) b.className += ' word';\n    if (cur && !solved && cur[0] === r && cur[1] === c) b.className += ' sel';\n    if (nums[r][c]){ var s = document.createElement('span'); s.className = 'n'; s.textContent = nums[r][c]; b.appendChild(s); }\n    b.appendChild(document.createTextNode(user[r][c] || ''));\n    (function(rr,cc){ b.onclick = function(){ onCell(rr,cc); }; })(r,c);\n    g.appendChild(b);\n  }\n  var e = curEntry();\n  $('clueDir').textContent = solved ? '' : (e ? (e.num + (e.dir === 'A' ? ' ACROSS' : ' DOWN')) : '');\n  $('clueText').textContent = solved ? 'Solved in ' + fmt(timer) : (e ? e.clue : '');\n}\nfunction onCell(r,c){\n  if (isBlock(r,c) || state !== 'play') return;\n  if (cur && cur[0] === r && cur[1] === c){ dir = dir === 'A' ? 'D' : 'A'; if (!entryAt(r,c,dir)) dir = dir === 'A' ? 'D' : 'A'; }\n  else { cur = [r,c]; if (!entryAt(r,c,dir)) dir = dir === 'A' ? 'D' : 'A'; }\n  haptic('selection'); render();\n}\nfunction type(ch){\n  if (!cur || solved || state !== 'play') return;\n  user[cur[0]][cur[1]] = ch; haptic('light');\n  var e = curEntry(); if (e){ var i = e.cells.findIndex(function(x){ return x[0] === cur[0] && x[1] === cur[1]; });\n    // advance to next empty cell in entry, else next cell\n    var j = i + 1; while (j < e.cells.length && user[e.cells[j][0]][e.cells[j][1]]) j++;\n    if (j >= e.cells.length) j = i + 1;\n    if (j < e.cells.length) cur = e.cells[j];\n  }\n  render(); save(); checkWin();\n}\nfunction backspace(){\n  if (!cur || solved || state !== 'play') return; haptic('light');\n  if (user[cur[0]][cur[1]]){ user[cur[0]][cur[1]] = ''; }\n  else { var e = curEntry(); if (e){ var i = e.cells.findIndex(function(x){ return x[0] === cur[0] && x[1] === cur[1]; }); if (i > 0){ cur = e.cells[i-1]; user[cur[0]][cur[1]] = ''; } } }\n  render(); save();\n}\nfunction moveClue(delta){\n  if (solved) return;\n  var e = curEntry(), idx = e ? entries.indexOf(e) : -1;\n  var ni = ((idx + delta) % entries.length + entries.length) % entries.length;\n  var ne = entries[ni]; dir = ne.dir; cur = ne.cells[0]; haptic('selection'); render();\n}\n\nfunction buildKeyboard(){\n  var rows = ['QWERTYUIOP','ASDFGHJKL','ZXCVBNM']; var KB = $('kb'); KB.innerHTML = '';\n  rows.forEach(function(row,ri){\n    var d = document.createElement('div'); d.className = 'kbrow';\n    if (ri === 2){ var del = document.createElement('button'); del.className = 'key wide'; del.innerHTML = '<svg><use href=\"#i-del\"/></svg>'; del.setAttribute('aria-label','Delete'); del.onclick = backspace; d.appendChild(del); }\n    row.split('').forEach(function(ch){ var k = document.createElement('button'); k.className = 'key'; k.textContent = ch; k.onclick = function(){ type(ch); }; d.appendChild(k); });\n    if (ri === 2){ var clr = document.createElement('button'); clr.className = 'key wide'; clr.textContent = 'Clear'; clr.onclick = clearPuzzle; d.appendChild(clr); }\n    KB.appendChild(d);\n  });\n}\n\nfunction check(){\n  haptic('warning');\n  var els = $('grid').querySelectorAll('.cell'); var k = 0;\n  for (var r = 0; r < N; r++) for (var c = 0; c < N; c++){ var b = els[k++]; if (isBlock(r,c)) continue;\n    if (user[r][c] && user[r][c] !== P.rows[r][c]) b.classList.add('wrong');\n  }\n  setTimeout(function(){ $('grid').querySelectorAll('.wrong').forEach(function(x){ x.classList.remove('wrong'); }); }, 1200);\n}\nfunction revealWord(){\n  var e = curEntry(); if (!e || solved) return; haptic('medium');\n  e.cells.forEach(function(x){ user[x[0]][x[1]] = P.rows[x[0]][x[1]]; });\n  render(); save(); checkWin();\n}\nfunction clearPuzzle(){\n  user = P.rows.map(function(row){ return row.split('').map(function(ch){ return ch === '#' ? '#' : ''; }); });\n  solved = false; cur = entries[0].cells[0]; dir = entries[0].dir; render(); save(); haptic('warning'); startTimer(); syncTools();\n}\nfunction checkWin(){\n  for (var r = 0; r < N; r++) for (var c = 0; c < N; c++){ if (!isBlock(r,c) && user[r][c] !== P.rows[r][c]) return; }\n  solved = true; stopTimer(); haptic('success'); save(); render(); syncTools();\n  setTimeout(function(){ if (solved && state === 'play') showSolved(); }, 500);\n}\nfunction syncTools(){ $('checkBtn').disabled = solved; $('revealBtn').disabled = solved; }\n\n/* the clock only runs while you're actually solving */\nfunction startTimer(){ stopTimer(); if (state !== 'play' || solved || document.hidden) return; tInt = setInterval(function(){ if (!solved){ timer++; $('timer').textContent = fmt(timer); save(); } }, 1000); }\nfunction stopTimer(){ if (tInt){ clearInterval(tInt); tInt = null; } }\nfunction fmt(s){ return Math.floor(s / 60) + ':' + (s % 60 < 10 ? '0' : '') + (s % 60); }\n\nvar curPuz = 0;\nfunction loadPuzzle(i, then){\n  stopTimer();\n  P = PUZZLES[i]; syncLabel(); build(); timer = 0; solved = false;\n  curPuz = i; saveCur();\n  load('cw_' + P.id).then(function(v){\n    if (v) try { var s = JSON.parse(v); if (s.user) user = s.user; if (s.timer) timer = s.timer; if (s.solved) solved = s.solved; } catch(e){}\n    cur = entries[0].cells[0]; dir = entries[0].dir;\n    $('timer').textContent = fmt(timer); render(); syncTools();\n    if (then) then();\n  });\n}\nfunction save(){ if (P) keep('cw_' + P.id, JSON.stringify({user:user, timer:timer, solved:solved})); }\nfunction saveCur(){ keep('cw_last', String(curPuz)); }\n\n/* ---------- cards ---------- */\nfunction puzzleList(cb){\n  var out = [], left = PUZZLES.length;\n  PUZZLES.forEach(function(pz, i){\n    load('cw_' + pz.id).then(function(v){\n      var st = ''; try { var s = v && JSON.parse(v); if (s){ if (s.solved) st = 'done'; else if (s.user && s.user.some(function(row){ return row.some(function(ch){ return ch && ch !== '#'; }); })) st = 'going'; } } catch(e){}\n      out[i] = st; if (--left === 0) cb(out);\n    });\n  });\n}\nfunction listHTML(st){\n  return PUZZLES.map(function(pz, i){\n    var tag = st[i] === 'done' ? '<small><svg><use href=\"#i-check\"/></svg> Solved</small>' : st[i] === 'going' ? '<small>In progress</small>' : '<small>New</small>';\n    return '<button class=\"pz glass' + (st[i] === 'done' ? ' done' : '') + (i === curPuz ? ' cur' : '') + '\" data-i=\"' + i + '\"><span>' + pz.name + '</span>' + tag + '</button>';\n  }).join('');\n}\nfunction wireList(){\n  Array.prototype.forEach.call(document.querySelectorAll('#sheet .pz'), function(b){\n    b.onclick = function(){ haptic('selection'); var i = +b.dataset.i; if (i === curPuz && P) enterPlay(); else loadPuzzle(i, enterPlay); };\n  });\n}\nfunction showHome(){\n  puzzleList(function(st){\n    showSheet('<h1>Crossword</h1><p>Four minis. Tap a square twice to switch across and down.</p>' + listHTML(st) +\n      '<button class=\"act pri\" id=\"sA\"><svg><use href=\"#i-play\"/></svg>' + (st[curPuz] === 'going' ? 'Continue ' : 'Play ') + PUZZLES[curPuz].name + '</button>', {sA: function(){ haptic('medium'); enterPlay(); }});\n    wireList();\n  });\n}\nfunction showPicker(){\n  stopTimer();\n  puzzleList(function(st){\n    showSheet('<div class=\"kick\">Puzzles</div>' + listHTML(st) +\n      '<button class=\"act pri\" id=\"sA\"><svg><use href=\"#i-play\"/></svg>Back to ' + P.name + '</button><button class=\"act glass\" id=\"sB\">Leave</button>',\n      {sA: function(){ haptic('light'); hideSheet(); startTimer(); }, sB: goHome});\n    wireList();\n  });\n}\nfunction showSolved(){\n  var next = (curPuz + 1) % PUZZLES.length;\n  showSheet('<div class=\"kick\">' + P.name + ' · Solved</div><div class=\"big\">' + fmt(timer) + '<small>your time</small></div>' +\n    '<button class=\"act pri\" id=\"sA\"><svg><use href=\"#i-next\"/></svg>' + PUZZLES[next].name + '</button><button class=\"act glass\" id=\"sB\">See the grid</button>',\n    {sA: function(){ haptic('medium'); loadPuzzle(next, enterPlay); }, sB: function(){ haptic('light'); hideSheet(); }});\n}\n\n/* ---------- flow ---------- */\nfunction syncLabel(){ $('pzName').textContent = state === 'play' && P ? P.name : 'Crossword'; }\nfunction setState(s){\n  state = s; syncLabel(); $('stage').classList.toggle('home', s === 'home');\n  $('bMenu').classList.toggle('hide', s !== 'play'); $('timerPill').classList.toggle('hide', s !== 'play');\n  syncLook(); syncChrome();\n}\nfunction enterPlay(){ hideSheet(); setState('play'); render(); startTimer(); }\nfunction goHome(){ haptic('light'); stopTimer(); setState('home'); showHome(); }\nfunction onHide(){ stopTimer(); }\ndocument.addEventListener('visibilitychange', function(){ if (!document.hidden && state === 'play' && !el('sheet').classList.contains('on')) startTimer(); });\n\n$('checkBtn').onclick = check;\n$('revealBtn').onclick = revealWord;\n$('prevClue').onclick = function(){ moveClue(-1); };\n$('nextClue').onclick = function(){ moveClue(1); };\n$('bMenu').onclick = function(){ haptic('selection'); showPicker(); };\ndocument.addEventListener('keydown', function(e){\n  if (state !== 'play' || el('sheet').classList.contains('on')) return;\n  if (/^[a-z]$/i.test(e.key)){ type(e.key.toUpperCase()); e.preventDefault(); }\n  else if (e.key === 'Backspace'){ backspace(); e.preventDefault(); }\n});\n\nfunction fit(){\n  var w = $('wrap');\n  var b = Math.floor(Math.min(w.clientWidth, w.clientHeight, 520));\n  $('stage').style.setProperty('--b', Math.max(160, b) + 'px');\n}\nwindow.addEventListener('resize', fit);\n\n/* ---------- boot ---------- */\nbuildKeyboard(); fit(); syncLook();\nload('cw_last').then(function(v){ var i = v ? (+v || 0) : 0; if (!PUZZLES[i]) i = 0; loadPuzzle(i, showHome); });\n</script></body></html>\n", "kind": "html", "iconSymbol": "square.grid.3x3.fill", "iconColor": "blue"}