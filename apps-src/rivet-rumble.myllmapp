 : 'slamW';\n    }\n    if (id === 'wisp'){\n      var hits = [18, 30, 42, 54];\n      if (hits.indexOf(a) >= 0){ var side = (hits.indexOf(a) & 1) ? 1 : -1; f.x = clamp(o.x + side * 1.5, -STAGE_X, STAGE_X); f.y = o.y; f.face = o.x > f.x ? 1 : -1; spark(f.x, 1.8, [1, .4, 1, 1], 10); sfx('whoosh');\n        landHitRaw(f, [-.2, 2.0, .6, 2.6], { dmg: 6, hs: 26, bs: 10, kb: .5, chip: .25, meter: 0 }, true); }\n      if (a === 66){ landHitRaw(f, [-.2, 2.2, .3, 3.0], { dmg: 10, hs: 28, bs: 12, kb: 3, launch: 8, chip: .25, meter: 0 }, true); }\n      if (a > 92) endMove(f); return a % 12 < 6 ? 'dashH' : 'jabH';\n    }\n    if (id === 'mortar'){\n      if (a >= 16 && a <= 76 && (a - 16) % 12 === 0){ var tx = o.x + (rnd() - .5) * 2.2; spawnProj(f, { type: 'shell', x: tx, y: 14, vx: 0, vy: -16, g: 0, w: .6, h: .6, life: 2, splash: 1.8, H: { dmg: 7, hs: 22, bs: 10, kb: 2.5, chip: .25, meter: 0 } }); sfx('launch'); }\n      if (a > 100) endMove(f); return a < 16 ? 'lobW' : 'lobH';\n    }\n  }\n  return 'guard';\n}\nfunction landHitRaw(f, b, H, multi){\n  if (f.hitDone && !multi) return;\n  var o = opp(f), r = rect(f, b), hb = hurtbox(o);\n  if (!overlap(r, hb)) return;\n  var hx = (Math.max(r[0], hb[0]) + Math.min(r[1], hb[1])) / 2, hy = (Math.max(r[2], hb[2]) + Math.min(r[3], hb[3])) / 2;\n  var res = applyHit(f, o, H, hx, hy); if (res){ f.connected = res; if (!multi) f.hitDone = true; }\n}\nfunction endMove(f){ f.st = 'idle'; f.atk = null; f.special = null; f.af = 0; }\nfunction spawnProj(f, p){ p.owner = f.i; p.t = 0; projs.push(p); }\nfunction stepProjs(){\n  for (var i = projs.length - 1; i >= 0; i--){\n    var p = projs[i], o = F[1 - p.owner];\n    p.t += DT; p.x += p.vx * DT; p.y += p.vy * DT; if (p.g) p.vy -= p.g * DT;\n    if (p.type === 'fist' || p.type === 'shell') smoke(p.x - Math.sign(p.vx || .01) * .3, p.y, 1);\n    if (p.type === 'wave' && rnd() < .7) dust(p.x, 2);\n    var dead = p.t > p.life || Math.abs(p.x) > STAGE_X + 3 || p.y < -0.2;\n    // projectiles cancel each other\n    for (var j = 0; j < projs.length; j++){ var q = projs[j]; if (q !== p && q.owner !== p.owner && Math.abs(q.x - p.x) < .9 && Math.abs(q.y - p.y) < .9){ dead = true; q.t = 99; spark(p.x, p.y, [1, 1, 1, 1], 12); sfx('block'); } }\n    if (!dead){\n      var hb = hurtbox(o), pr = [p.x - p.w, p.x + p.w, p.y - p.h, p.y + p.h];\n      if (overlap(pr, hb) && o.inv <= 0 && o.st !== 'down'){ applyHit(F[p.owner], o, p.H, p.x, p.y); dead = true; if (p.splash) boomFx(p.x, p.y); }\n      else if (p.splash && p.y <= .3){ boomFx(p.x, .3); if (Math.abs(o.x - p.x) < p.splash && o.y < 1.5) applyHit(F[p.owner], o, p.H, p.x, .5); dead = true; }\n    }\n    if (dead) projs.splice(i, 1);\n  }\n}\n// ---------- per-fighter step ----------\nfunction stepFighter(f){\n  var o = opp(f), inp = IN[f.i], s = f.def.s;\n  f.t++; if (f.inv > 0) f.inv--;\n  var fwd = f.face > 0 ? inp.r : inp.l, back = f.face > 0 ? inp.l : inp.r, fwdP = f.face > 0 ? inp.pr : inp.pl;\n  // buffer attack presses\n  if (inp.pp){ f.buf = 'p'; f.bufT = 8; } if (inp.pk){ f.buf = 'k'; f.bufT = 8; } if (inp.ps){ f.buf = 's'; f.bufT = 8; } if (inp.px){ f.buf = 'x'; f.bufT = 8; }\n  if (f.bufT > 0) f.bufT--; else f.buf = null;\n  var target = 'guard';\n  if (phase !== 'fight'){\n    if (f.st !== 'down' && f.st !== 'air' && f.st !== 'win' && f.st !== 'lose'){ f.st = 'idle'; }\n  }\n  switch (f.st){\n    case 'idle': case 'walk': case 'crouch': case 'block': case 'dash':\n      if (f.st === 'block' && f.stun > 0){ f.stun--; f.vx *= .82; target = f.crouch ? 'cblock' : 'block'; break; }\n      if (f.st === 'dash'){ if (f.t > 14){ f.st = 'idle'; } else { f.vx *= .9; target = 'dashH'; break; } }\n      if (phase !== 'fight'){ f.vx = 0; target = 'guard'; break; }\n      f.crouch = !!inp.d; f.blocking = !!inp.b;\n      // actions\n      var a = f.buf;\n      if (a === 'x' && f.meter >= 100){ f.meter = 0; f.buf = null; f.st = 'super'; f.af = 0; f.hitDone = false; f.connected = false; f.vx = 0; superFx = { i: f.i, t: 0 }; freeze = 40; superCine(f); sfx('super'); haptic('success'); showBanner(f.def.su.toUpperCase(), 900, true); break; }\n      if (a === 's'){ f.buf = null; startSpecial(f, 'sp'); break; }\n      if (a === 'p'){ f.buf = null; startAttack(f, f.crouch ? 'cjab' : 'jab'); break; }\n      if (a === 'k'){ f.buf = null; startAttack(f, f.crouch ? 'sweep' : 'kick'); break; }\n      if (inp.pu){ f.st = 'jump'; f.vy = f.def.jump; f.y = .02; f.vx = (inp.r ? 1 : inp.l ? -1 : 0) * f.def.walk * 1.15; f.jumps = 1; sfx('jump'); dust(f.x, 5); break; }\n      if (fwdP){ if (f.t - f.lastFwd < 14 && f.st !== 'dash'){ f.st = 'dash'; f.t = 0; f.vx = 9.5 * f.face; dust(f.x, 6); sfx('whoosh'); f.lastFwd = -99; break; } f.lastFwd = f.t; }\n      if (f.blocking){ f.st = 'block'; f.vx = 0; target = f.crouch ? 'cblock' : 'block'; break; }\n      if (f.crouch){ f.st = 'crouch'; f.vx = 0; target = 'crouch'; break; }\n      if (inp.l || inp.r){ f.st = 'walk'; var dir = inp.r ? 1 : -1; f.vx = dir * f.def.walk * (dir === f.face ? 1 : .8); f.walkPh += DT * f.def.walk * 2.6 * dir * f.face; target = 'walk'; }\n      else { f.st = 'idle'; f.vx = 0; target = 'guard'; }\n      break;\n    case 'jump':\n      if (f.def.dbl && inp.pu && f.jumps < 2){ f.jumps = 2; f.vy = f.def.jump * .85; f.vx = (inp.r ? 1 : inp.l ? -1 : 0) * f.def.walk; sfx('jump'); spark(f.x, f.y + .3, [.6, 1, .9, 1], 6); }\n      if (f.buf === 'p' && phase === 'fight'){ f.buf = null; startAttack(f, 'jpunch'); break; }\n      if (f.buf === 'k' && phase === 'fight'){ f.buf = null; startAttack(f, 'jkick'); break; }\n      target = 'jump'; break;\n    case 'attack':\n      var A = f.atk; f.af++;\n      if (f.af > A.st && f.af <= A.st + A.ac && !f.hitDone) landHit(f, A);\n      target = f.af <= A.st ? A.w : A.h;\n      if (A.air && grounded(f) && f.af > 2){ endMove(f); dust(f.x, 4); break; }\n      // chain cancels\n      if (f.connected && f.af > A.st + A.ac && f.af < A.st + A.ac + 10 && f.buf){\n        var nx = f.buf === 'p' ? (IN[f.i].d && A.crouch ? 'cjab' : f.atkName === 'jab' ? 'cross' : f.atkName === 'cross' ? 'upper' : 'jab') : f.buf === 'k' ? (IN[f.i].d ? 'sweep' : f.atkName === 'kick' ? 'spin' : 'kick') : f.buf === 's' ? 'sp' : f.buf === 'x' ? 'x' : null;\n        if (nx === 'x' && f.meter >= 100){ f.buf = null; f.meter = 0; f.st = 'super'; f.af = 0; f.hitDone = false; f.connected = false; superFx = { i: f.i, t: 0 }; freeze = 40; superCine(f); sfx('super'); showBanner(f.def.su.toUpperCase(), 900, true); break; }\n        if (nx && (A.chain || []).indexOf(nx) >= 0){ f.buf = null; if (nx === 'sp') startSpecial(f, 'sp'); else startAttack(f, nx); break; }\n      }\n      if (f.af >= A.st + A.ac + A.rc){ endMove(f); }\n      if (!A.air) f.vx *= .7;\n      break;\n    case 'special': case 'super':\n      f.af++; target = specialStep(f); break;\n    case 'hit':\n      f.stun--; f.vx *= .86; target = 'hit'; if (f.stun <= 0){ f.st = 'idle'; f.combo = 0; } break;\n    case 'air':\n      target = 'air'; if (grounded(f) && f.t > 2){ f.st = 'down'; f.t = 0; f.vx = 0; shake = Math.max(shake, .25); dust(f.x, 12); sfx('thud'); }\n      break;\n    case 'down':\n      target = 'down'; f.vx *= .8;\n      if (f.hp <= 0) break;\n      if (f.t > 42){ f.st = 'idle'; f.inv = 24; f.combo = 0; }\n      break;\n    case 'win': target = f.t % 120 < 70 ? 'win' : 'taunt'; break;\n    case 'lose': target = 'down'; break;\n  }\n  if (f.st !== 'hit' && f.st !== 'air' && f.st !== 'down' && f.st !== 'block') { if (o.st !== 'hit' && o.st !== 'air' && o.st !== 'down') o.combo = o.combo; }\n  // physics\n  if (f.st !== 'special' || f.def.id !== 'wisp') {}\n  f.x += f.vx * DT;\n  if (!grounded(f) || f.vy > 0){ f.vy -= GRAV * DT; f.y += f.vy * DT; if (f.y <= 0){ f.y = 0; f.vy = 0; if (f.st === 'jump'){ f.st = 'idle'; dust(f.x, 4); sfx('land'); } } }\n  f.x = clamp(f.x, -STAGE_X, STAGE_X);\n  // face the opponent when free\n  if ((f.st === 'idle' || f.st === 'walk' || f.st === 'crouch') && grounded(f)) f.face = o.x >= f.x ? 1 : -1;\n  // pose\n  var tp = PO[target] || PO.guard;\n  if (target === 'walk'){ var ph = f.walkPh; tp = pose({ torso: -.14, hipA: .2 + Math.sin(ph) * .55, kneeA: -.5 - Math.max(0, -Math.cos(ph)) * .6, hipB: .2 - Math.sin(ph) * .55, kneeB: -.5 - Math.max(0, Math.cos(ph)) * .6, y: -.08 + Math.abs(Math.sin(ph)) * .05, shA: .5 - Math.sin(ph) * .12, shB: .25 + Math.sin(ph) * .12 }); }\n  if (target === 'guard'){ var br = Math.sin(f.t * .06 + f.i) * .03; tp = pose({ y: -.1 + br, torso: -.04 - br, shA: .5 + br }); }\n  // spring-damped blending: snappy strikes with a touch of overshoot, softer settling between moves\n  var fast = f.st === 'attack' || f.st === 'special' || f.st === 'super', K2 = fast ? 1500 : (f.st === 'hit' ? 900 : 420), D2 = 2 * Math.sqrt(K2) * (fast ? .62 : .8);\n  if (!f.pv) f.pv = {};\n  KEYS.forEach(function(k){ var v = f.pv[k] || 0, x = f.pose[k], t2 = tp[k] === undefined ? 0 : tp[k]; v += (K2 * (t2 - x) - D2 * v) * DT; f.pv[k] = v; f.pose[k] = x + v * DT; });\n  // secondary motion: the head steadies against the torso, a little breathing sway when idle\n  f.pose.head -= f.pose.torso * .25 * DT * 20 * 0;\n  if (f.st === 'idle') { f.pose.tw += Math.sin(f.t * .045 + f.i * 2) * .0025; }\n  // afterimage trails on fast active strikes\n  if (fast && f.af > 0 && (f.atk ? (f.af > f.atk.st - 2 && f.af <= f.atk.st + f.atk.ac + 2) : (f.af % 2 === 0)) && f.trail) spawnP(f.trail[0], f.trail[1], f.trail[2], 0, 0, 0, [f.def.glow[0] * .5, f.def.glow[1] * .5, f.def.glow[2] * .5, .55], .55 * f.def.s, .16, 0);\n  if (f.hp < f.def.hp * .3 && rnd() < .08) smoke(f.x - f.face * .3, f.y + 2.6 * s, 1);\n  if (f.lag > f.hp) f.lag = Math.max(f.hp, f.lag - .35); else f.lag = f.hp;\n}\nfunction separate(){\n  var a = F[0], b = F[1], s = (a.def.s + b.def.s) / 2, min = 1.15 * s, dx = b.x - a.x;\n  if (Math.abs(dx) < min && Math.abs(a.y - b.y) < 2.2 && !(a.st === 'super' && a.def.id === 'wisp') && !(b.st === 'super' && b.def.id === 'wisp')){\n    var push = (min - Math.abs(dx)) / 2, sg = dx >= 0 ? 1 : -1; a.x -= sg * push; b.x += sg * push;\n    if (Math.abs(a.x) >= STAGE_X) b.x = a.x + sg * min; if (Math.abs(b.x) >= STAGE_X) a.x = b.x - sg * min;\n  }\n  // keep both on camera\n  var sep = b.x - a.x, maxSep = 15;\n  if (Math.abs(sep) > maxSep){ var c = (a.x + b.x) / 2, sg2 = sep > 0 ? 1 : -1; a.x = c - sg2 * maxSep / 2; b.x = c + sg2 * maxSep / 2; }\n}\n\n// ===================================================================\n// CPU OPPONENT (drives the same inputs a player would)\n// ===================================================================\nfunction aiStep(f){\n  var o = opp(f), D = DIFF[SET.diff + (mode === 'arcade' ? Math.min(0, arcIdx - 2) : 0) < 0 ? 0 : SET.diff], inp = IN[f.i];\n  if (mode === 'arcade') D = DIFF[clamp(SET.diff - 1 + arcIdx, 0, 2)];\n  var held = { l: 0, r: 0, u: 0, d: 0, b: 0 }, press = {};\n  var d = Math.abs(o.x - f.x), toward = o.x > f.x ? 'r' : 'l', away = toward === 'r' ? 'l' : 'r';\n  f.aiT--;\n  // ongoing hold\n  if (f.aiHoldT > 0){ f.aiHoldT--; for (var k in f.aiHold) held[k] = f.aiHold[k]; }\n  var threat = (o.st === 'attack' && o.af <= o.atk.st + o.atk.ac && d < 3.4) || (o.st === 'special' && d < 6) || (o.st === 'super') || projs.some(function(p){ return p.owner === o.i && Math.abs(p.x - f.x) < 4.5 && Math.sign(f.x - p.x) === Math.sign(p.vx || (f.x - p.x)); });\n  if (f.aiT <= 0 && phase === 'fight'){\n    f.aiT = D.react + Math.floor(rnd() * 6);\n    f.aiHold = null; f.aiHoldT = 0; held = { l: 0, r: 0, u: 0, d: 0, b: 0 };\n    var r = rnd();\n    if (threat && r < D.block){ var low = o.atk && o.atk.low; f.aiHold = { b: 1, d: low ? 1 : 0 }; f.aiHoldT = 16; }\n    else if (f.meter >= 100 && d < 3.2 && r < .6){ press.x = 1; }\n    else if ((o.st === 'attack' && o.af > o.atk.st + o.atk.ac) || o.st === 'down' && o.t > 30 || (o.st === 'special' && o.af > 30)){ if (d < 2.6){ press.p = 1; f.aiCombo = 3; } else { f.aiHold = {}; f.aiHold[toward] = 1; f.aiHoldT = 10; } }\n    else if (!grounded(o) && d < 3.2 && o.vy < 2 && r < D.aggr){ press.k = 1; }\n    else if (d > 5.5){\n      if (r < .25 && (f.def.id === 'vanta' || f.def.id === 'mortar' || f.def.id === 'torque')) press.s = 1;\n      else if (r < .35){ press.u = 1; f.aiHold = {}; f.aiHold[toward] = 1; f.aiHoldT = 30; }\n      else { f.aiHold = {}; f.aiHold[toward] = 1; f.aiHoldT = 18 + Math.floor(rnd() * 20); }\n    } else if (d > 2.4){\n      if (r < D.aggr * .35) press.k = 1;\n      else if (r < D.aggr * .55) press.s = 1;\n      else if (r < D.aggr * .65){ press.u = 1; f.aiHold = {}; f.aiHold[toward] = 1; f.aiHoldT = 26; }\n      else if (r < .9){ f.aiHold = {}; f.aiHold[toward] = 1; f.aiHoldT = 12; }\n      else { f.aiHold = {}; f.aiHold[away] = 1; f.aiHoldT = 10; }\n    } else {\n      if (r < D.aggr * .45){ press.p = 1; f.aiCombo = rnd() < D.chain ? 3 : 0; }\n      else if (r < D.aggr * .65) press.k = 1;\n      else if (r < D.aggr * .8){ f.aiHold = { d: 1 }; f.aiHoldT = 6; press.k = 1; }\n      else if (r < .85){ f.aiHold = { b: 1 }; f.aiHoldT = 14; }\n      else { f.aiHold = {}; f.aiHold[away] = 1; f.aiHoldT = 14; }\n    }\n    if (f.aiHold) for (var k2 in f.aiHold) held[k2] = f.aiHold[k2];\n  }\n  // combo follow-ups\n  if (f.st === 'attack' && f.connected && f.aiCombo > 0 && f.af === f.atk.st + f.atk.ac + 2){ var rr2 = rnd(); if (f.atkName === 'jab') { if (rr2 < .6) press.p = 1; else press.k = 1; } else if (f.atkName === 'cross') { if (rr2 < .7) press.p = 1; else press.s = 1; } else if (f.atkName === 'kick') { if (rr2 < .6) press.k = 1; else press.s = 1; } else if (f.atkName === 'sweep') press.s = 1; f.aiCombo--; }\n  if (f.st === 'jump' && d < 2.8 && f.vy < 0 && rnd() < .15) press.k = 1;\n  inp.pu = press.u && !inp.u ? 1 : 0; inp.pp = press.p ? 1 : 0; inp.pk = press.k ? 1 : 0; inp.ps = press.s ? 1 : 0; inp.px = press.x ? 1 : 0; inp.pl = 0; inp.pr = 0;\n  inp.l = held.l; inp.r = held.r; inp.u = press.u ? 1 : 0; inp.d = held.d; inp.b = held.b;\n}\n\n// ===================================================================\n// WEBGL\n// ===================================================================\nvar canvas = document.getElementById('gl');\nvar gl = canvas.getContext('webgl', { antialias: true, alpha: true, premultipliedAlpha: true }) || canvas.getContext('experimental-webgl');\nif (!gl){ var er0 = document.createElement('div'); er0.id = 'err'; er0.textContent = 'Rivet Rumble needs 3D graphics (WebGL), and this device has it switched off.'; document.body.appendChild(er0); return; }\nvar VS = 'attribute vec3 aP;attribute vec3 aN;attribute vec3 aC;attribute float aM;uniform mat4 uVP,uM;varying vec3 vN,vC,vW,vO,vNo;varying float vM;' +\n  'void main(){vec4 w=uM*vec4(aP,1.);vW=w.xyz;vN=(uM*vec4(aN,0.)).xyz;vC=aC;vO=aP;vNo=aN;vM=aM;gl_Position=uVP*w;}';\nvar FS = 'precision highp float;varying vec3 vN,vC,vW,vO,vNo;varying float vM;uniform vec3 uCam,uSun,uSunCol,uAmb,uFog,uTint,uRim,uEnvA,uEnvB;uniform float uFogD,uFlash,uTwo;uniform sampler2D uT1,uT2,uArm,uFrm;uniform vec3 uArmMean,uFrmMean;' +\n  'void main(){vec3 N=normalize(vN);vec3 V=uCam-vW;float dist=length(V);V/=dist;if(uTwo>.5&&dot(N,V)<0.)N=-N;' +\n  'float d=max(dot(N,uSun),0.);vec3 c=vC*uTint*(uAmb+uSunCol*d+.1*N.y);' +\n  'if(vM>.5&&vM<1.5){vec3 an=abs(vNo);vec2 uv=(an.y>.7?vO.xz:(an.x>an.z?vO.zy:vO.xy));c*=.45+texture2D(uT2,uv*.22).r*1.1;}' +\n  'if(vM>4.5){vec3 an=abs(vNo);vec2 uv=(an.y>.7?vO.xz:(an.x>an.z?vO.zy:vO.xy));' +\n  'vec3 tc=vM<5.5?texture2D(uArm,uv*1.45).rgb/uArmMean:texture2D(uFrm,uv*1.8).rgb/uFrmMean;float lm=dot(tc,vec3(.3,.5,.2));tc=mix(vec3(lm),tc,.55);c*=clamp(mix(vec3(1.),tc,.9),.25,1.9);' +\n  'float gls=vM<5.5?.55:(vM<6.5?.4:.25);vec3 Rf=reflect(-V,N);vec3 env=mix(uEnvB,uEnvA,clamp(Rf.y*.6+.5,0.,1.));float fr=.06+.94*pow(1.-max(dot(N,V),0.),4.);' +\n  'c=mix(c,env,fr*gls*.55)+uSunCol*pow(max(dot(N,normalize(uSun+V)),0.),vM<5.5?70.:30.)*gls*1.1;}' +\n  'float rim=pow(1.-max(dot(N,V),0.),3.);c+=uRim*rim*.7;c=mix(c,vec3(1.),uFlash);' +\n  'float f=1.-exp(-dist*dist*uFogD*uFogD);c=mix(c,uFog,clamp(f,0.,.9));gl_FragColor=vec4(c,1.);}';\nvar BVS = 'attribute vec3 aP;attribute vec2 aT;uniform mat4 uVP;varying vec2 vT;void main(){vT=aT;gl_Position=uVP*vec4(aP,1.);}';\nvar BFS = 'precision mediump float;varying vec2 vT;uniform sampler2D uTex;uniform vec3 uTint;void main(){gl_FragColor=vec4(texture2D(uTex,vT).rgb*uTint,1.);}';\nvar PVS = 'attribute vec3 aP;attribute vec4 aC;attribute float aS;uniform mat4 uVP;uniform float uScale;varying vec4 vC;void main(){vec4 p=uVP*vec4(aP,1.);gl_Position=p;gl_PointSize=clamp(aS*uScale/max(p.w,.1),1.,256.);vC=aC;}';\nvar PFS = 'precision mediump float;varying vec4 vC;void main(){vec2 d=gl_PointCoord-.5;float a=smoothstep(.5,.12,length(d));gl_FragColor=vec4(vC.rgb,vC.a*a);}';\nvar R = {};\nfunction compile(vs, fs){\n  var mk = function(t, src){ var s = gl.createShader(t); gl.shaderSource(s, src); gl.compileShader(s); if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s)); return s; };\n  var p = gl.createProgram(); gl.attachShader(p, mk(gl.VERTEX_SHADER, vs)); gl.attachShader(p, mk(gl.FRAGMENT_SHADER, fs)); gl.linkProgram(p);\n  if (!gl.getProgramParameter(p, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(p));\n  var info = { p: p, a: {}, u: {} }, n, i;\n  n = gl.getProgramParameter(p, gl.ACTIVE_ATTRIBUTES); for (i = 0; i < n; i++){ var at = gl.getActiveAttrib(p, i); info.a[at.name] = gl.getAttribLocation(p, at.name); }\n  n = gl.getProgramParameter(p, gl.ACTIVE_UNIFORMS); for (i = 0; i < n; i++){ var un = gl.getActiveUniform(p, i); info.u[un.name] = gl.getUniformLocation(p, un.name); }\n  return info;\n}\nfunction vbo(data, stride){ var b = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, b); gl.bufferData(gl.ARRAY_BUFFER, data, gl.STATIC_DRAW); return { b: b, n: data.length / (stride || 10) }; }\nfunction texFrom(img, repeat, lum){\n  var t = gl.createTexture(); gl.bindTexture(gl.TEXTURE_2D, t);\n  gl.texImage2D(gl.TEXTURE_2D, 0, lum ? gl.LUMINANCE : gl.RGBA, lum ? gl.LUMINANCE : g