 initGL(); } catch (e) {} }, false);\n\n// ---------- arenas ----------\nvar STAGES = {\n  yard: { name: 'Scrapyard', sun: [-.4, .7, .6], sunCol: [1.1, .86, .66], amb: [.5, .42, .52], fog: [.86, .55, .5], rim: [.9, .55, .35], envA: [1.0, .7, .62], envB: [.32, .24, .22], ground: [.55, .5, .44], tint: [1, 1, 1] },\n  harbor: { name: 'Harbour', sun: [.35, .8, .45], sunCol: [.55, .6, .95], amb: [.38, .34, .55], fog: [.2, .16, .32], rim: [.4, .7, 1.2], envA: [.45, .4, .75], envB: [.08, .08, .14], ground: [.36, .36, .42], tint: [.95, .95, 1.05] }\n};\nvar STAGEDATA = {};\nfunction buildStages(){\n  var conc = [.62, .6, .57], rust = [.6, .33, .2], teal = [.18, .45, .5], dk = [.15, .15, .17], hz = [1, .65, .15], wood = [.45, .32, .22];\n  // scrapyard\n  seed = 7; var A = []; MATOF.clear(); MATOF.set(conc, 1);\n  box(A, -40, 40, -1, 0, -9, 6, conc);\n  for (var i = 0; i < 30; i++){ var x0 = -38 + i * 2.7; quad(A, [x0, .005, -1.6], [x0 + 1.4, .005, -1.6], [x0 + 1.4, .005, -1.4], [x0, .005, -1.4], [.48, .46, .43]); }\n  for (var oi = 0; oi < 9; oi++){ var ox = -20 + rnd() * 40, oz = -1 + rnd() * 4; quad(A, [ox, .006, oz], [ox + 1.6, .006, oz + .4], [ox + 1.3, .006, oz + 1.4], [ox - .2, .006, oz + 1], [.3, .28, .26]); }\n  var cont = function(x, y, z, l, c, rot){ box(A, x - l / 2, x + l / 2, y, y + 2.6, z - 1.25, z + 1.25, c); for (var r = 0; r < 8; r++){ var rx = x - l / 2 + .3 + r * (l - .6) / 7; box(A, rx - .06, rx + .06, y + .1, y + 2.5, z + 1.25, z + 1.3, shade(c, .8)); } };\n  cont(-15, 0, -12, 6, rust); cont(-15, 2.6, -12.2, 6, teal); cont(-8.5, 0, -13, 6, [.7, .6, .2]); cont(9, 0, -12.5, 6, teal); cont(15, 0, -12, 6, rust); cont(15.4, 2.6, -12.3, 6, [.45, .2, .2]); cont(22, 0, -11, 6, [.3, .4, .6]);\n  for (var sp = 0; sp < 40; sp++){ var px = -24 + rnd() * 48, pz = -16 + rnd() * 5, s = .5 + rnd() * 1.4; if (Math.abs(px) < 4) pz -= 3; box(A, px - s, px + s, 0, s * (.6 + rnd()), pz - s * .7, pz + s * .7, jit([[.5, .3, .2], [.4, .42, .46], [.55, .45, .35]][sp % 3], .3), s * .3); }\n  box(A, 3, 3.6, 0, 13, -17, -16.4, hz); box(A, 11, 11.6, 0, 13, -17, -16.4, hz); box(A, 2.6, 12, 12.6, 13.4, -17.2, -16.2, hz); box(A, 6, 7.2, 11.4, 12.6, -17.1, -16.3, dk); box(A, 6.5, 6.7, 7, 11.4, -16.8, -16.6, dk);\n  [-11, 0, 11].forEach(function(lx){ box(A, lx - .15, lx + .15, 0, 7, -8, -7.7, dk); box(A, lx - .8, lx + .8, 7, 7.3, -8.1, -7.6, dk); box(A, lx - .7, lx + .7, 6.85, 7.0, -8.05, -7.65, [2.6, 2.0, 1.3]); });\n  for (var f = 0; f < 18; f++){ var fx = -30 + f * 3.5; box(A, fx - .06, fx + .06, 0, 2.4, -9, -8.9, dk); box(A, fx, fx + 3.5, 2.2, 2.3, -9, -8.92, dk); box(A, fx, fx + 3.5, 1.1, 1.15, -9, -8.92, dk); }\n  [[-9, 3], [9.5, 3.3], [-5, 4.2]].forEach(function(c){ cylY(A, c[0], 0, c[1], .3, .8, 6, hz, .08); });\n  box(A, -14, -12, 0, 1, 2.5, 3.5, wood); box(A, 12.5, 14.5, 0, 1.2, 2.2, 3.4, wood);\n  STAGEDATA.yard = new Float32Array(A);\n  // harbour\n  seed = 13; A = []; MATOF.clear(); MATOF.set(conc, 1);\n  box(A, -40, 40, -1, 0, -8, 6, [.44, .44, .48]);\n  for (i = 0; i < 40; i++){ var wx = -40 + i * 2; box(A, wx, wx + 1.9, -1.2, -.05, -8.2, -8, [.3, .24, .2]); }\n  quad(A, [-80, -1.4, -9], [80, -1.4, -9], [80, -1.4, -60], [-80, -1.4, -60], [.06, .1, .2]);\n  [[-16, -14], [14, -16]].forEach(function(c){ box(A, c[0] - 3, c[0] - 2.4, -1.4, 16, c[1] - .3, c[1] + .3, [.8, .2, .15]); box(A, c[0] + 2.4, c[0] + 3, -1.4, 16, c[1] - .3, c[1] + .3, [.8, .2, .15]); box(A, c[0] - 6, c[0] + 9, 15.5, 16.6, c[1] - .5, c[1] + .5, [.8, .2, .15]); box(A, c[0] + 7, c[0] + 7.6, 16.6, 17.2, c[1] - .2, c[1] + .2, [2.8, .3, .2]); });\n  for (i = 0; i < 6; i++){ var cx = -26 + i * 9.5; cont(cx, 0, -11 - (i & 1), 6, [[.18, .45, .5], [.7, .3, .2], [.3, .3, .6], [.6, .55, .2]][i % 4]); if (i % 2 === 0) cont(cx + .3, 2.6, -11.2, 6, [[.45, .2, .2], [.2, .5, .4]][i % 2]); }\n  for (i = 0; i < 26; i++){ var bx = -26 + i * 2.1, by = 5.2 + Math.sin(i * .7) * .3; box(A, bx - .1, bx + .1, by - .1, by + .1, -8.6, -8.4, [[2.6, 2, 1.2], [2.6, .6, .5], [.6, 2, 2.6]][i % 3]); }\n  [-12, 0, 12].forEach(function(lx){ box(A, lx - .12, lx + .12, 0, 5.4, -8.6, -8.4, dk); });\n  for (i = 0; i < 6; i++){ var bo = -20 + i * 8; cylY(A, bo, 0, 4.6, .3, .9, 8, [.3, .3, .32], .32); }\n  STAGEDATA.harbor = new Float32Array(A);\n  MATOF.clear();\n}\n\n// ---------- particles ----------\nfunction spawnP(x, y, z, vx, vy, vz, c, s, l, g){ if (parts.length > 700) parts.shift(); parts.push({ x: x, y: y, z: z, vx: vx, vy: vy, vz: vz, c: c, s: s, l: l, l0: l, g: g === undefined ? -9 : g }); }\nvar RINGS = [], WORDS = ['BANG!', 'CRUNCH!', 'WHAM!', 'KRAK!', 'POW!', 'CLANG!', 'BOOM!'], zoomKick = 0;\nvar COMBO_NAMES = { vanta: ['STEEL RUSH', 'TURBINE HEEL'], torque: ['PISTON PUMMEL', 'WRECKING SPIN'], wisp: ['RAZOR WALTZ', 'CYCLONE EDGE'], mortar: ['SHRAPNEL STORM', 'BREACH KICK'] };\nfunction impact(x, y, dmg, att){\n  var big = dmg >= 10, n = big ? 34 : 18, gc = att ? att.def.glow : [1, .8, .4];\n  for (var i = 0; i < n; i++){ var a = rnd() * TAU, sp = 6 + rnd() * (big ? 16 : 10); spawnP(x, y, .4, Math.cos(a) * sp, Math.sin(a) * sp * .8 + 2, (rnd() - .5) * 4, i & 1 ? [1, .92, .55, 1] : [gc[0] * .8, gc[1] * .8, gc[2] * .8, 1], .26 + rnd() * .2, .26 + rnd() * .3, -14); }\n  for (i = 0; i < (big ? 8 : 3); i++) spawnP(x, y, .3, (rnd() - .5) * 9, 3 + rnd() * 5, (rnd() - .5) * 3, [.25, .24, .26, 1], .22 + rnd() * .15, .6 + rnd() * .4, -22);\n  spawnP(x, y, .6, 0, 0, 0, [1, 1, .9, 1], big ? 3.4 : 2.2, .14, 0); spawnP(x, y, .55, 0, 0, 0, [1, .7, .3, .8], big ? 5 : 3, .2, 0);\n  RINGS.push({ x: x, y: y, t: 0, big: big });\n}\nvar flashEl = null, flashV = 0;\nfunction flash(v){ flashV = Math.max(flashV, v); }\nfunction comic(x, y, big){\n  if (QUIET || !lastVP) return; var s = project(x, y + .6, 0); if (!s) return;\n  var d = document.createElement('div'); d.className = 'comic' + (big ? ' big' : ''); d.textContent = WORDS[Math.floor(rnd() * WORDS.length)];\n  d.style.left = s[0] + 'px'; d.style.top = s[1] + 'px'; d.style.setProperty('--r', ((rnd() - .5) * 24) + 'deg');\n  document.body.appendChild(d); setTimeout(function(){ d.remove(); }, 700);\n}\nvar lastVP = null;\nfunction project(x, y, z){ var v = lastVP, cx = v[0] * x + v[4] * y + v[8] * z + v[12], cy = v[1] * x + v[5] * y + v[9] * z + v[13], cw = v[3] * x + v[7] * y + v[11] * z + v[15]; if (cw <= 0) return null; return [(cx / cw * .5 + .5) * W, (1 - (cy / cw * .5 + .5)) * H]; }\nfunction spark(x, y, c, n){ for (var i = 0; i < n; i++) spawnP(x, y, .3, (rnd() - .5) * 12, (rnd() - .3) * 10, (rnd() - .5) * 4, c, .3 + rnd() * .2, .2 + rnd() * .25); }\nfunction dust(x, n){ for (var i = 0; i < n; i++) spawnP(x + (rnd() - .5) * 1.6, .15, (rnd() - .5) * 1.4, (rnd() - .5) * 3, rnd() * 1.6, (rnd() - .5) * 2, [.75, .68, .58, .5], 1.1 + rnd(), .8 + rnd() * .5, .3); }\nfunction smoke(x, y, n){ for (var i = 0; i < n; i++) spawnP(x, y, (rnd() - .5) * .4, (rnd() - .5) * .8, 1 + rnd(), (rnd() - .5) * .5, [.5, .48, .48, .45], .8 + rnd() * .6, 1 + rnd(), .5); }\nfunction boomFx(x, y){ for (var i = 0; i < 30; i++) spawnP(x, y, 0, (rnd() - .5) * 14, rnd() * 10, (rnd() - .5) * 6, [1, .5 + rnd() * .4, .15, 1], .6 + rnd() * .5, .35 + rnd() * .3); smoke(x, y + .5, 10); shake = Math.max(shake, .5); sfx('boom'); }\nfunction stepParts(dt){ for (var i = parts.length - 1; i >= 0; i--){ var p = parts[i]; p.l -= dt; if (p.l <= 0){ parts.splice(i, 1); continue; } p.x += p.vx * dt; p.y += p.vy * dt; p.z += p.vz * dt; p.vx *= .95; p.vz *= .95; p.vy += p.g * dt; if (p.y < 0){ p.y = 0; p.vy *= -.3; } } }\n\n// ===================================================================\n// RENDER\n// ===================================================================\nvar CAMO = null, cam = { x: 0, y: 2.2, d: 11 }, W = 1, H = 1, lastW = 0, lastH = 0, pData = new Float32Array(800 * 8);\nfunction resize(){ var dpr = Math.min(window.devicePixelRatio || 1, 2), w = Math.round(canvas.clientWidth * dpr), h = Math.round(canvas.clientHeight * dpr); if (w !== lastW || h !== lastH){ canvas.width = w; canvas.height = h; lastW = w; lastH = h; } W = canvas.clientWidth; H = canvas.clientHeight; }\nfunction bindMesh(prog, m){\n  gl.bindBuffer(gl.ARRAY_BUFFER, m.b);\n  gl.enableVertexAttribArray(prog.a.aP); gl.vertexAttribPointer(prog.a.aP, 3, gl.FLOAT, false, 40, 0);\n  gl.enableVertexAttribArray(prog.a.aN); gl.vertexAttribPointer(prog.a.aN, 3, gl.FLOAT, false, 40, 12);\n  gl.enableVertexAttribArray(prog.a.aC); gl.vertexAttribPointer(prog.a.aC, 3, gl.FLOAT, false, 40, 24);\n  gl.enableVertexAttribArray(prog.a.aM); gl.vertexAttribPointer(prog.a.aM, 1, gl.FLOAT, false, 40, 36);\n}\nfunction draw(m, M){ gl.uniformMatrix4fv(R.main.u.uM, false, M); bindMesh(R.main, m); gl.drawArrays(gl.TRIANGLES, 0, m.n); }\nfunction fighterMats(f){\n  var P = f.pose, s = f.def.s, id = f.def.id, out = [];\n  var rootM = mul(T(f.x, 0, 0), mul(Ry((f.face > 0 ? -.78 : PI + .78) + P.tw * f.face), mul(Sc(s), mul(T(0, SK.hip + P.y, 0), Rz(P.lean)))));\n  var torso = mul(rootM, mul(T(0, SK.waist, 0), Rz(P.torso))), head = mul(torso, mul(T(0, SK.neck, 0), Rz(P.head)));\n  var sz = shZ(f.def), hz2 = hipZ(f.def);\n  var shA = mul(torso, mul(T(0, SK.shY, sz), Rz(P.shA))), elA = mul(shA, mul(T(0, -SK.uarm, 0), Rz(P.elA)));\n  var shB = mul(torso, mul(T(0, SK.shY, -sz), Rz(P.shB))), elB = mul(shB, mul(T(0, -SK.uarm, 0), Rz(P.elB)));\n  var hpA = mul(rootM, mul(T(0, 0, hz2), Rz(P.hipA))), knA = mul(hpA, mul(T(0, -SK.thigh, 0), Rz(P.kneeA)));\n  var hpB = mul(rootM, mul(T(0, 0, -hz2), Rz(P.hipB))), knB = mul(hpB, mul(T(0, -SK.thigh, 0), Rz(P.kneeB)));\n  // drop the whole body so the lower foot touches the ground (when not lying down)\n  var fa = xfP(knA, .1, -SK.shin - .2, 0), fb = xfP(knB, .1, -SK.shin - .2, 0), low = Math.min(fa[1], fb[1]);\n  var lift = (f.st === 'down' || f.st === 'lose' || f.st === 'air') ? 0 : -low;\n  var Y = T(0, f.y + lift, 0);\n  var tAtk = f.atk && (f.atkName === 'kick' || f.atkName === 'sweep' || f.atkName === 'spin' || f.atkName === 'jkick');\n  f.trail = tAtk ? xfP(mul(Y, f.atkName === 'spin' ? knB : knA), .2, -SK.shin, 0) : xfP(mul(Y, f.atkName === 'cross' ? elB : elA), .1, -.72, 0);\n  out.push(['pelvis', mul(Y, rootM)], ['torso', mul(Y, torso)], ['head', mul(Y, head)], ['uarm', mul(Y, shB)], ['farm', mul(Y, elB)], ['thigh', mul(Y, hpB)], ['shin', mul(Y, knB)], ['thigh', mul(Y, hpA)], ['shin', mul(Y, knA)], ['uarm', mul(Y, shA)], ['farm', mul(Y, elA)]);\n  if ((f.st === 'down' || f.st === 'lose') && f.y <= .01){ var lowY = 1e9; out.forEach(function(o){ lowY = Math.min(lowY, o[1][13]); }); var fix = .32 * s - lowY; out.forEach(function(o){ o[1] = mul(T(0, fix, 0), o[1]); }); }\n  return out;\n}\nfunction render(dt){\n  if (R.lost) return;\n  resize();\n  var st = STAGES[stageId], a = F[0], b = F[1];\n  var midX = a && b ? (a.x + b.x) / 2 : 0, sep = a && b ? Math.abs(a.x - b.x) : 4;\n  var tgtD = clamp(sep * .55 + 6.6, 7.8, 15) * (W / H < 1.2 ? 1.55 : 1), tgtX = clamp(midX, -STAGE_X + 3.5, STAGE_X - 3.5), tgtY = 2.0 + (a && b ? Math.max(a.y, b.y) * .6 : 0); if (a && b) tgtD += Math.max(a.y, b.y) * .9;\n  if (superFx && freeze > 0){ var sf = F[superFx.i]; tgtX = sf.x; tgtD = 8.6; tgtY = 2.3; }\n  if (phase === 'menu' || phase === 'select'){ tgtX = Math.sin(performance.now() / 4000) * 3; tgtD = 13; }\n  if (CAMO){ tgtX = CAMO.x; tgtD = CAMO.d; tgtY = CAMO.y; cam.x = tgtX; cam.d = tgtD; cam.y = tgtY; }\n  cam.x += (tgtX - cam.x) * .1; cam.d += (tgtD - cam.d) * .08; cam.y += (tgtY - cam.y) * .1;\n  var sh = shake; shake = Math.max(0, shake - dt * 2.5);\n  var eye = [cam.x + (rnd() - .5) * sh * .6, cam.y + .9 + (rnd() - .5) * sh * .6, cam.d];\n  zoomKick = Math.max(0, zoomKick - dt * 4);\n  var P = perspective((38 - zoomKick * 6) * PI / 180, W / H, .3, 200), V = lookAt(eye, [cam.x, cam.y, 0], [0, 1, 0]), VP = mul(P, V); lastVP = VP;\n  gl.viewport(0, 0, canvas.width, canvas.height); gl.clearColor(st.fog[0], st.fog[1], st.fog[2], 1); gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);\n  // backdrop\n  var bp = R.bg; gl.useProgram(bp.p); gl.depthMask(false);\n  gl.bindBuffer(gl.ARRAY_BUFFER, R.bgq.b); gl.enableVertexAttribArray(bp.a.aP); gl.vertexAttribPointer(bp.a.aP, 3, gl.FLOAT, false, 20, 0); gl.enableVertexAttribArray(bp.a.aT); gl.vertexAttribPointer(bp.a.aT, 2, gl.FLOAT, false, 20, 12);\n  gl.uniformMatrix4fv(bp.u.uVP, false, VP); gl.activeTexture(gl.TEXTURE0); gl.bindTexture(gl.TEXTURE_2D, R.bgt[stageId] || R.steel); gl.uniform1i(bp.u.uTex, 0); gl.uniform3fv(bp.u.uTint, st.tint);\n  if (R.bgt[stageId]) gl.drawArrays(gl.TRIANGLES, 0, 6);\n  gl.disableVertexAttribArray(bp.a.aP); gl.disableVertexAttribArray(bp.a.aT); gl.depthMask(true);\n  // world\n  var m = R.main; gl.useProgram(m.p);\n  gl.uniformMatrix4fv(m.u.uVP, false, VP); gl.uniform3fv(m.u.uCam, eye); gl.uniform3fv(m.u.uSun, norm(st.sun)); gl.uniform3fv(m.u.uSunCol, st.sunCol); gl.uniform3fv(m.u.uAmb, st.amb); gl.uniform3fv(m.u.uFog, st.fog); gl.uniform1f(m.u.uFogD, 1 / 70);\n  gl.uniform3f(m.u.uTint, 1, 1, 1); gl.uniform3f(m.u.uRim, 0, 0, 0); gl.uniform1f(m.u.uFlash, 0);\n  gl.activeTexture(gl.TEXTURE1); gl.bindTexture(gl.TEXTURE_2D, R.steel); gl.uniform1i(m.u.uT1, 1); gl.activeTexture(gl.TEXTURE2); gl.bindTexture(gl.TEXTURE_2D, R.conc); gl.uniform1i(m.u.uT2, 2);\n  gl.activeTexture(gl.TEXTURE4); gl.bindTexture(gl.TEXTURE_2D, R.frm); gl.uniform1i(m.u.uFrm, 4); gl.uniform3fv(m.u.uFrmMean, TEXMEAN.frame || [.5, .5, .5]); gl.uniform1i(m.u.uArm, 3); gl.uniform3fv(m.u.uArmMean, [.5, .5, .5]);\n  gl.activeTexture(gl.TEXTURE0);\n  gl.uniform1f(m.u.uTwo, 1); gl.uniform3fv(m.u.uEnvA, st.envA); gl.uniform3fv(m.u.uEnvB, st.envB);\n  draw(R.stages[stageId], IDENT);\n  gl.uniform3fv(m.u.uRim, st.rim); gl.uniform1f(m.u.uTwo, 0);\n  F.forEach(function(f){\n    var mats = fighterMats(f), fl = (f.flashT > 0) ? .55 : 0; f.flashT = Math.max(0, (f.flashT || 0) - 1);\n    gl.uniform1f(m.u.uFlash, fl);\n    if (f.inv > 0 && (f.inv >> 2) & 1) gl.uniform3f(m.u.uTint, 1.4, 1.4, 1.4); else gl.uniform3f(m.u.uTint, 1, 1, 1);\n    bindArm(f.def.id);\n    mats.forEach(function(e){ draw(R.mesh[f.def.id + '_' + e[0]], e[1]); });\n    // ground shadow\n  });\n  gl.uniform1f(m.u.uFlash, 0); gl.uniform3f(m.u.uTint, 1, 1, 1);\n  // projectiles\n  projs.forEach(function(p){\n    var f = F[p.owner], M;\n    if (p.type === 'fist'){ bindArm(f.def.id); } if (p.type === 'fist') draw(R.mesh[f.def.id + '_farm'], mul(T(p.x + (p.vx > 0 ? -.6 : .6), p.y, .4), mul(Ry(p.vx > 0 ? 0 : PI), Rz(1.57))));\n    else if (p.type === 'shell'){ gl.uniform3f(m.u.uTint, 1.6, 1.2, 1.0); draw(R.mesh.shell, mul(T(p.x, p.y, .3), Rz(Math.atan2(p.vy, p.vx || .001) - PI / 2))); gl.uniform3f(m.u.uTint, 1, 1, 1); }\n    else if (p.type === 'wave'){ var k = p.big ? 1.6 : 1; gl.uniform3f(m.u.uTint, 1.8, 1.4, 1.0); draw(R.mesh.wave, mul(T(p.x, 0, 0), mul(Ry(p.vx > 0 ? 0 : PI), Sc(k * (1 + Math.sin(p.t * 30) * .08))))); gl.uniform3f(m.u.uTint, 1, 1, 1); }\n  });\n  gl.uniform1f(m.u.uTwo, 1);\n  gl.disableVertexAttribArray(m.a.aP); gl.disableVertexAttribArray(m.a.aN); gl.disableVertexAttribArray(m.a.aC); gl.disableVertexAttribArray(m.a.aM);\n  // particles + blob shadows\n  var n = 0, o = 0;\n  F.forEach(function(f){ pData[o++] = f.x; pData[o++] = .05; pData[o++] = 0; pData[o++] = 0; pData[o++] = 0; pData[o++] = 0; pData[o++] = .45 / (1 + f.y * .4); pData[o++] = 3.2 * f.def.s; n++; });\n  var total = Math.min(parts.length, 790);\n  for (var q = parts.length - total; q < parts.length; q++){ var p = parts[q], life = p.l / p.l0; pData[o++] = p.x; pData[o++] = p.y; pData[o++] = p.z; pData[o++] = p.c[0]; pData[o++] = p.c[1]; pData[o++] = p.c[2]; pData[o++] = p.c[3] * (p.s > .9 ? life : Math.min(1, life * 2)); pData[o++] = p.s * (p.s > .9 ? (2 - life) : 1); n++; }\n  var pp = R.pts; gl.useProgram(pp.p); gl.enable(gl.BLEND); gl.depthMask(false);\n  gl.bindBuffer(gl.ARRAY_BUFFER, R.pbuf); gl.bufferData(gl.ARRAY_BUFFER, pData.subarray(0, o), gl.DYNAMIC_DRAW);\n  gl.enableVertexAttribArray(pp.a.aP); gl.vertexAttribPointer(pp.a.aP, 3, gl.FLOAT, false, 32, 0); gl.enableVertexAttribArray(pp.a.aC); gl.vertexAttribPointer(pp.a.aC, 4, gl.FLOAT, false, 32, 12); gl.enableVertexAttribArray(pp.a.aS); gl.vertexAttribPointer(pp.a.aS, 1, gl.FLOAT, false, 32, 28);\n  gl.uniformMatrix4fv(pp.u.uVP, false, VP); gl.uniform1f(pp.u.uScale, canvas.height / 2 / Math.tan(19 * PI / 180));\n  gl.drawArrays(gl.POINTS, 0, n);\n  gl.disableVertexAttribArray(pp.a.aP); gl.disableVertexAttribArray(pp.a.aC); gl.disableVertexAttribArray(pp.a.aS); gl.disable(gl.BLEND); gl.depthMask(true);\n}\nfunction bindArm(id){ var m = R.main; gl.activeTexture(gl.TEXTURE3); gl.bindTexture(gl.TEXTURE_2D, R.arm[id]); gl.uniform3fv(m.u.uArmMean, TEXMEAN[id] || [.5, .5, .5]); gl.activeTexture(gl.TEXTURE0); }\nfunction drawFx(dt){\n  var c = document.getElementById('fxc'), dpr = Math.min(window.devicePixelRatio || 1, 2);\n  if (c.width !== Math.round(W * dpr)){ c.width = Math.round(W * dpr); c.height = Math.round(H * dpr); }\n  var x = c.getContext('2d'); x.setTransform(dpr, 0, 0, dpr, 0, 0); x.clearRect(0, 0, W, H);\n  RINGS = RINGS.filter(function(r){ r.t += dt; var k = r.t / (r.big ? .45 : .32); if (k >= 1 || !lastVP) return false; var s = project(r.x, r.y, .4); if (!s) return true;\n    var rad = (r.big ? 120 : 70) * (.25 + k); x.strokeStyle = 'rgba(255,240,200,' + (1 - k) + ')'; x.lineWidth = (r.big ? 7 : 4) * (1 - k) + 1; x.beginPath(); x.ellipse(s[0], s[1], rad, rad * .75, 0, 0, TAU); x.stroke();\n    if (r.big){ x.strokeStyle = 'rgba(255,170,80,' + (1 - k) * .8 + ')'; for (var i = 0; i < 10; i++){ var a = i / 10 * TAU + r.x; x.beginPath(); x.moveTo(s[0] + Math.cos(a) * rad * .5, s[1] + Math.sin(a) * rad * .4); x.lineTo(s[0] + Math.cos(a) * rad * 1.15, s[1] + Math.sin(a) * rad * .9); x.stroke(); } }\n    return true; });\n  flashV = Math.max(0, flashV - dt * 3.2); if (!flashEl) flashEl = document.getElementById('flash'); flashEl.style.opacity = flashV.toFixed(3);\n}\nfunction norm(v){ var l = Math.hypot(v[0], v[1], v[2]); return [v[0] / l, v[1] / l, v[2] / l]; }\nfunction buildFx(){\n  var s = []; cylY(s, 0, -.35, 0, .2, .55, 8, [.4, .42, .46], .2); cylY(s, 0, .2, 0, .2, .35, 8, [.95, .3, .2], 0); MESH.shell = new Float32Array(s);\n  var w = []; for (var i = 0; i < 6; i++){ var x0 = -.9 + i * .3, h = .4 + Math.sin(i / 5 * PI) * 1.1; box(w, x0, x0 + .32, 0, h, -.6, .6, [1, .62 + i * .04, .2], .08); } MESH.wave = new Float32Array(w);\n}\n\n// ===================================================================\n// HUD + FLOW\n// ===================================================================\nvar el = function(id){ return document.getElementById(id); };\nfunction show(id){ el(id).classList.remove('hidden'); } function hide(id){ el(id).classList.add('hidden'); }\nvar banT = 0;\nfunction showBanner(t, ms, small){ if (QUIET) return; var b = el('banner'); b.innerHTML = t; b.classList.add('on'); b.style.fontSize = small ? '40px' : ''; clearTimeout(banT); if (ms) banT = setTimeout(function(){ b.classList.remove('on'); }, ms); }\nvar comT = 0;\nfunction showCombo(i, n){ if (QUIET) return; var c = el('combo'); c.textContent = n + ' HIT COMBO'; c.style.left = i ? '' : '6%'; c.style.right = i ? '6%' : ''; c.classList.add('on'); clearTimeout(comT); comT = setTimeout(function(){ c.classList.remove('on'); }, 900); }\nfunction updateHUD(){\n  if (!F.length) return;\n  [0, 1].forEach(function(i){ var f = F[i]; el('h' + (i + 1)).style.width = (f.hp / f.def.hp * 100) + '%'; el('l' + (i + 1)).style.width = (f.lag / f.def.hp * 100) + '%';\n    el('mv' + (i + 1)).style.width = f.meter + '%'; el('m' + (i + 1)).classList.toggle('full', f.meter >= 100);\n    el('w' + (i + 1)).textContent = wins[i] ? '●'.repeat(wins[i]) : ''; });\n  el('timer').textContent = Math.ceil(Math.max(0, roundT));\n  el('superBtn').classList.toggle('hidden', !(F[0].meter >= 100 && phase === 'fight'));\n}\n// ---------- cinematics (Wan 2.2 clips, streamed; skipped when unavailable) ----------\nvar MEDIA = location.protocol === 'file:' ? 'rr-media/' : 'https://raw.githubusercontent.com/TeamDzX/myllm-assets-xl/main/apps/rivet-rumble/';\nvar VIDS = {}, cineDone = null, cineT = 0;\nfunction preloadCine(keys){ keys.forEach(function(k){ if (VIDS[k]) return; try { var v = document.createElement('video'); v.muted = true; v.playsInline = true; v.setAttribute('playsinline', ''); v.preload = 'auto'; v.src = MEDIA + k + '.mp4'; v.load(); VIDS[k] = v; } catch (e) {} }); }\nfunction playCine(key, text, rate, done){\n  var v = VIDS[key];\n  if (SET.cine === false || !v || v.readyState < 3 || v.error){ if (done) done(); return false; }\n  var box = el('cine'); box.querySelectorAll('video').forEach(function(o){ o.pause(); o.remove(); });\n  box.insertBefore(v, box.firstChild); el('cineTxt').innerHTML = text || ''; el('cineTxt').style.animation = 'none'; void el('cineTxt').offsetWidth; el('cineTxt').style.animation = '';\n  try { v.currentTime = 0; } catch (e) {} v.playbackRate = rate || 1;\n  cineDone = done || null; show('cine');\n  var finish = function(){ if (!cineDone && el('cine').classList.contains('hidden')) return; clearTimeout(cineT); v.pause(); hide('cine'); var d2 = cineDone; cineDone = null; if (d2) d2(); };\n  v.onended = finish; el('cineSkip').onclick = finish;\n  cineT = setTimeout(finish, ((v.duration || 2) / (rate || 1)) * 1000 + 600);\n  var pr = v.play(); if (pr && pr.catch) pr.catch(function(){ finish(); });\n  return true;\n}\nfunction superCine(f){ if (QUIET) return; if (playCine('su_' + f.def.id, f.def.su.toUpperCase(), 1.6, function(){ freeze = Math.min(freeze, 14); })) freeze = 9999; }\nfunction startMatch(){\n  F = [newFighter(0, MECHS[pick]), newFighter(1, MECHS[foe])];\n  wins = [0, 0]; round = 1;\n  el('n1').textContent = MECHS[pick].name; el('n2').textContent = MECHS[foe].name;\n  // VS splash\n  ['select', 'menu', 'endOv', 'pauseOv'].forEach(hide);\n  el('vsA').style.backgroundImage = PORTRAITS[MECHS[pick].id] ? 'url(' + PORTRAITS[MECHS[pick].id] + ')' : ''; el('vsAn').textContent = MECHS[pick].name;\n  el('vsB').style.backgroundImage = PORTRAITS[MECHS[foe].id] ? 'url(' + PORTRAITS[MECHS[foe].id] + ')' : ''; el('vsBn').textContent = MECHS[foe].name;\n  preloadCine(['su_' + MECHS[pick].id, 'su_' + MECHS[foe].id, 'ko_' + MECHS[pick].id, 'ko_' + MECHS[foe].id]);\n  show('vs'); sfx('super'); phase = 'vs'; phaseT = 0;\n  setTimeout(function(){ hide('vs'); startRound(); }, 1700);\n}\nfunction startRound(){\n  var a = F[0], b = F[1];\n  [a, b].forEach(function(f, i){ var nf = newFighter(i, f.def); nf.meter = f.meter; nf.maxCombo = f.maxCombo; nf.dmgTaken = 0; F[i] = nf; });\n  projs = []; parts = []; roundT = 60; hitstop = 0; freeze = 0; superFx = null; slowmo = 0;\n  show('hud'); show('pad'); immersive(true); clearInput();\n  phase = 'intro'; phaseT = 0;\n  showBanner('ROUND ' + round, 1100); speak('Round ' + round);\n  el('rot').classList.add('show'); setTimeout(function(){ el('rot').classList.remove('show'); }, 4000);\n}\nvar koWinner = -1;\nfunction flowTick(){\n  if (phase === 'intro'){ phaseT++; if (phaseT === 78){ showBanner('FIGHT!', 700); speak('Fight'); sfx('bell'); phase = 'fight'; } }\n  else if (phase === 'ko'){ phaseT++;\n    if (phaseT === 80){ var w = koWinner; if (w >= 0){ wins[w]++; F[w].st = 'win'; F[w].t = 0; if (F[1 - w].hp > 0) F[1 - w].st = 'lose'; } showBanner(w < 0 ? 'DRAW' : F[w].def.name + '<small>WINS THE ROUND</small>', 1600); }\n    if (phaseT === 80 + 125){ if (wins[0] >= 2 || wins[1] >= 2) endMatch(wins[0] >= 2); else { round++; startRound(); } } }\n}\nfunction endRound(winner){\n  if (phase !== 'fight') return;\n  phase = 'ko'; phaseT = 0; slowmo = 60;\n  var ko = F[0].hp <= 0 || F[1].hp <= 0;\n  showBanner(ko ? 'K.O.' : 'TIME', 1500); speak(ko ? 'K O' : 'Time'); sfx(ko ? 'ko' : 'bell'); shake = .8; haptic('success');\n  koWinner = winner; flash(.8); zoomKick = 2; if (winner >= 0){ var lz = F[1 - winner]; for (var kb = 0; kb < 3; kb++) impact(lz.x + (rnd() - .5), 1.6 + rnd(), 14, F[winner]); comic(lz.x, 2.2, true); }\n}\nfunction endMatch(won){\n  phase = 'over'; immersive(false); hide('pad');\n  if (won) REC.wins++; else REC.losses++;\n  var f = F[0], txt = '';\n  if (mode === 'arcade'){\n    if (won){ arcIdx++; if (arcIdx >= ladder.length){ REC.champ[f.def.id] = 1; el('endTag').textContent = 'Arcade cleared with ' + f.def.name; el('endTitle').textContent = 'Champion!'; el('eNext').classList.add('hidden'); }\n      else { el('endTag').textContent = 'Rival ' + arcIdx + ' of ' + ladder.length + ' defeated'; el('endTitle').textContent = 'You win'; el('eNext').classList.remove('hidden'); el('eNext').textContent = 'Next: ' + MECHS[ladder[arcIdx]].name; } }\n    else { el('endTag').textContent = 'Arcade run over'; el('endTitle').textContent = 'Defeat'; el('eNext').classList.add('hidden'); }\n  } else { el('endTag').textContent = 'Quick match'; el('endTitle').textContent = won ? 'You win' : 'Defeat'; el('eNext').classList.add('hidden'); }\n  el('endList').innerHTML = '<p><span>Rounds</span><span>' + wins[0] + ' – ' + wins[1] + '</span></p><p><span>Best combo</span><span>' + f.maxCombo + ' hits</span></p><p><span>Record</span><span>' + REC.wins + ' W · ' + REC.losses + ' L</span></p>';\n  store.setItem('rr.records', JSON.stringify(REC));\n  var showEnd = function(){ if (phase !== 'over') return; show('endOv'); hide('hud'); };\n  var wf = won ? F[0] : F[1], lf = won ? F[1] : F[0];\n  if (lf.hp <= 0) setTimeout(function(){ if (phase !== 'over') return; hide('hud'); hide('pad'); if (!playCine('ko_' + wf.def.id, wf.def.name + ' WINS', 1, showEnd)) showEnd(); }, 300);\n  else setTimeout(showEnd, 600);\n}\nfunction toMenu(){ AI0 = false; phase = 'menu'; immersive(false); ['hud', 'pad', 'select', 'endOv', 'pauseOv', 'vs'].forEach(hide); show('menu'); refreshMenu(); demoFighters(); }\nfunction demoFighters(){ F = [newFighter(0, MECHS[0]), newFighter(1, MECHS[1])]; F[0].ai = true; }\nfunction pause(){ if (phase !== 'fight' && phase !== 'intro') return; phase = 'paused'; show('pauseOv'); if (AU.ctx) AU.ctx.suspend(); immersive(false); }\nfunction resume(){ if (phase !== 'paused') return; phase = 'fight'; hide('pauseOv'); if (AU.ctx) AU.ctx.resume(); immersive(true); }\n// select screen\nvar selStage = 'yard';\nfunction openSelect(m){\n  mode = m; hide('menu'); show('select');\n  el('selTag').textContent = m === 'arcade' ? 'Arcade: choose your mech' : 'Quick match: tap your mech, then tap again to pick a rival';\n  el('quickOpts').classList.toggle('hidden', m !== 'quick');\n  if (foe === pick) foe = (pick + 1) % 4;\n  renderSelect();\n}\nfunction renderSelect(){\n  var g = el('grid'); g.innerHTML = '';\n  MECHS.forEach(function(M, i){\n    var d = document.createElement('div'); d.className = 'pc' + (i === pick ? ' sel' : '') + (mode === 'quick' && i === foe ? ' foe' : '');\n    if (PORTRAITS[M.id]) d.style.backgroundImage = 'url(' + PORTRAITS[M.id] + ')';\n    d.innerHTML = '<span>' + M.name + (REC.champ[M.id] ? ' ★' : '') + '</span>';\n    d.addEventListener('click', function(){ audioInit(); if (mode === 'quick' && i === pick){ foe = (foe + 1) % 4; if (foe === pick) foe = (foe + 1) % 4; } else if (mode === 'quick' && i !== pick && d.classList.contains('foe')) { } else { if (mode === 'quick' && i !== pick){ foe = i; } else pick = i; } sfx('click'); haptic('selection'); renderSelect(); });\n    g.appendChild(d);\n  });\n  var M = MECHS[pick];\n  el('selInfo').innerHTML = '<b>' + M.name + '</b>: ' + M.title + ' · Special: ' + M.sp + ' · Super: ' + M.su + '<br><span style=\"opacity:.8\">' + M.blurb + '</span>' + (mode === 'quick' ? '<br>Rival: <b>' + MECHS[foe].name + '</b>' : '');\n  var sr = el('stageRow'); sr.innerHTML = '';\n  Object.keys(STAGES).forEach(function(k){ var b = document.createElement('button'); b.className = 'tg' + (k === selStage ? ' on' : ''); b.textContent = STAGES[k].name; b.addEventListener('click', function(){ selStage = k; stageId = k; renderSelect(); }); sr.appendChild(b); });\n}\nel('selGo').addEventListener('click', function(){\n  audioInit();\n  if (mode === 'arcade'){ ladder = [0, 1, 2, 3].filter(function(i){ return i !== pick; }); arcIdx = 0; foe = ladder[0]; stageId = 'yard'; }\n  else stageId = selStage;\n  startMatch();\n});\nel('selBack').addEventListener('click', toMenu);\nel('goArcade').addEventListener('click', function(){ audioInit(); openSelect('arcade'); });\nel('goQuick').addEventListener('click', function(){ audioInit(); openSelect('quick'); });\nel('goHelp').addEventListener('click', function(){ el('helpBox').classList.toggle('hidden'); });\nel('tgCine').addEventListener('click', function(){ SET.cine = !SET.cine; saveSet(); refreshMenu(); });\nel('tgMusic').addEventListener('click', function(){ SET.music = !SET.music; audioInit(); saveSet(); refreshMenu(); });\nel('pauseBtn').addEventListener('click', pause); el('pResume').addEventListener('click', resume);\nel('pRestart').addEventListener('click', function(){ if (AU.ctx) AU.ctx.resume(); startMatch(); });\nel('pQuit').addEventListener('click', function(){ if (AU.ctx) AU.ctx.resume(); toMenu(); });\nel('eNext').addEventListener('click', function(){ foe = ladder[arcIdx]; stageId = arcIdx % 2 ? 'harbor' : 'yard'; startMatch(); });\nel('eAgain').addEventListener('click', function(){ if (mode === 'arcade' && arcIdx >= ladder.length){ arcIdx = 0; foe = ladder[0]; } startMatch(); });\nel('eMenu').addEventListener('click', toMenu);\nfunction saveSet(){ store.setItem('rr.settings', JSON.stringify(SET)); }\nfunction refreshMenu(){\n  var dr = el('diffRow'); dr.innerHTML = '';\n  DIFF.forEach(function(D, i){ var b = document.createElement('button'); b.className = 'tg' + (i === SET.diff ? ' on' : ''); b.textContent = D.name; b.addEventListener('click', function(){ SET.diff = i; saveSet(); refreshMenu(); haptic('selection'); }); dr.appendChild(b); });\n  el('tgMusic').classList.toggle('on', SET.music); el('tgCine').classList.toggle('on', SET.cine !== false);\n  var ch = Object.keys(REC.champ).map(function(k){ return k.toUpperCase(); });\n  el('recLine').textContent = (REC.wins || REC.losses) ? 'Record ' + REC.wins + ' W · ' + REC.losses + ' L' + (ch.length ? ' · Champion with ' + ch.join(', ') : '') : '';\n}\ndocument.addEventListener('visibilitychange', function(){ if (document.hidden) pause(); });\n\n// ===================================================================\n// INPUT\n// ===================================================================\nvar padKeys = {}, keyHeld = {}, ptrs = {}, edges = {};\nvar KEYMAP = { ArrowLeft: 'l', KeyA: 'l', ArrowRight: 'r', KeyD: 'r', ArrowUp: 'u', KeyW: 'u', ArrowDown: 'd', KeyS: 'd', KeyJ: 'p', KeyK: 'k', KeyL: 's', Space: 'b', ShiftLeft: 'b', KeyU: 'x' };\nfunction setKey(k, on){ var was = !!(padKeys[k] || keyHeld[k]); if (on && !was) edges[k] = 1; }\nfunction clearInput(){ padKeys = {}; keyHeld = {}; ptrs = {}; edges = {}; IN[0] = freshInput(); document.querySelectorAll('#pad button').forEach(function(b){ b.classList.remove('on'); }); }\nfunction padKeyAt(e){ var t = document.elementFromPoint(e.clientX, e.clientY); var b = t && t.closest ? t.closest('#pad button') : null; return b ? b.getAttribute('data-k') : null; }\nfunction padSync(){ document.querySelectorAll('#pad button').forEach(function(b){ var k = b.getAttribute('data-k'); b.classList.toggle('on', !!padKeys[k]); }); }\nvar padEl = el('pad');\npadEl.addEventListener('pointerdown', function(e){ var k = padKeyAt(e); if (!k) return; e.preventDefault(); audioInit(); setKey(k, true); padKeys[k] = (padKeys[k] || 0) + 1; ptrs[e.pointerId] = k; padSync(); try { padEl.setPointerCapture(e.pointerId); } catch (er) {} haptic('selection'); });\npadEl.addEventListener('pointermove', function(e){ if (!(e.pointerId in ptrs)) return; var k = padKeyAt(e), old = ptrs[e.pointerId]; if (k && k !== old && 'lrud'.indexOf(k) >= 0 && 'lrud'.indexOf(old) >= 0){ padKeys[old]--; setKey(k, true); padKeys[k] = (padKeys[k] || 0) + 1; ptrs[e.pointerId] = k; padSync(); } });\nfunction ptrUp(e){ if (!(e.pointerId in ptrs)) return; var k = ptrs[e.pointerId]; padKeys[k] = Math.max(0, (padKeys[k] || 0) - 1); delete ptrs[e.pointerId]; padSync(); }\npadEl.addEventListener('pointerup', ptrUp); padEl.addEventListener('pointercancel', ptrUp);\npadEl.addEventListener('touchstart', function(e){ e.preventDefault(); }, { passive: false });\nwindow.addEventListener('keydown', function(e){\n  if (e.code === 'Escape'){ if (phase === 'paused') resume(); else pause(); return; }\n  var k = KEYMAP[e.code]; if (!k) return; e.preventDefault(); audioInit(); if (!e.repeat) setKey(k, true); keyHeld[k] = true;\n});\nwindow.addEventListener('keyup', function(e){ var k = KEYMAP[e.code]; if (k) keyHeld[k] = false; });\nfunction readPlayer(){\n  var inp = IN[0], h = function(k){ return padKeys[k] || keyHeld[k] ? 1 : 0; };\n  inp.l = h('l'); inp.r = h('r'); inp.d = h('d'); inp.b = h('b'); inp.u = h('u');\n  inp.pu = edges.u ? 1 : 0; inp.pp = edges.p ? 1 : 0; inp.pk = edges.k ? 1 : 0; inp.ps = edges.s ? 1 : 0; inp.px = edges.x ? 1 : 0; inp.pl = edges.l ? 1 : 0; inp.pr = edges.r ? 1 : 0;\n  edges = {};\n}\n\n// ===================================================================\n// AUDIO\n// ===================================================================\nvar AU = { ctx: null };\nfunction audioInit(){\n  if (AU.ctx){ if (AU.ctx.state !== 'running') AU.ctx.resume(); return; }\n  var AC = window.AudioContext || window.webkitAudioContext; if (!AC) return;\n  try { AU.ctx = new AC(); } catch (e) { return; }\n  var c = AU.ctx; try { var b0 = c.createBuffer(1, 1, 22050), s0 = c.createBufferSource(); s0.buffer = b0; s0.connect(c.destination); s0.start(0); } catch (e) {}\n  AU.master = c.createGain(); AU.master.gain.value = .85; AU.master.connect(c.destination);\n  AU.sfx = c.createGain(); AU.sfx.gain.value = .9; AU.sfx.connect(AU.master); AU.music = c.createGain(); AU.music.gain.value = 0; AU.music.connect(AU.master);\n  var nb = c.createBuffer(1, c.sampleRate * 2, c.sampleRate), nd = nb.getChannelData(0); for (var i = 0; i < nd.length; i++) nd[i] = Math.random() * 2 - 1; AU.noise = nb;\n  AU.mNext = c.currentTime + .1; AU.mStep = 0;\n}\nfunction env(g, t, a, peak, d){ g.gain.setValueAtTime(.0001, t); g.gain.exponentialRampToValueAtTime(peak, t + a); g.gain.exponentialRampToValueAtTime(.0001, t + a + d); }\nfunction tone(type, f, t, dur, vol, dest, f2){ var c = AU.ctx, o = c.createOscillator(), g = c.createGain(); o.type = type; o.frequency.setValueAtTime(f, t); if (f2) o.frequency.exponentialRampToValueAtTime(f2, t + dur); o.connect(g); g.connect(dest || AU.sfx); env(g, t, .005, vol, dur); o.start(t); o.stop(t + dur + .05); }\nfunction noise(t, dur, vol, type, freq, dest){ var c = AU.ctx, s = c.createBufferSource(), f = c.createBiquadFilter(), g = c.createGain(); s.buffer = AU.noise; f.type = type; f.frequency.value = freq; s.connect(f); f.connect(g); g.connect(dest || AU.sfx); env(g, t, .003, vol, dur); s.start(t, Math.random()); s.stop(t + dur + .05); }\nvar QUIET = false;\nfunction sfx(k){\n  if (QUIET || !AU.ctx || AU.ctx.state !== 'running' || phase === 'menu') return; var t = AU.ctx.currentTime;\n  if (k === 'hit'){ noise(t, .12, .5, 'lowpass', 1400); tone('square', 180, t, .08, .12, null, 90); }\n  else if (k === 'heavy' || k === 'thud'){ noise(t, .22, .7, 'lowpass', 700); tone('sine', 110, t, .2, .5, null, 40); tone('square', 320, t, .05, .1, null, 120); }\n  else if (k === 'block'){ noise(t, .08, .35, 'highpass', 2500); tone('triangle', 900, t, .06, .12, null, 500); }\n  else if (k === 'whoosh'){ noise(t, .12, .18, 'bandpass', 1800); }\n  else if (k === 'light'){ noise(t, .08, .3, 'bandpass', 1500); }\n  else if (k === 'jump'){ tone('sine', 220, t, .12, .12, null, 380); noise(t, .1, .1, 'lowpass', 600); }\n  else if (k === 'land'){ noise(t, .1, .25, 'lowpass', 400); }\n  else if (k === 'slam'){ noise(t, .6, .8, 'lowpass', 300); tone('sine', 70, t, .5, .6, null, 30); }\n  else if (k === 'boom'){ noise(t, .5, .6, 'lowpass', 500); tone('sine', 90, t, .4, .4, null, 35); }\n  else if (k === 'launch'){ noise(t, .3, .3, 'bandpass', 900); tone('sawtooth', 300, t, .25, .06, null, 700); }\n  else if (k === 'super'){ tone('sawtooth', 110, t, .8, .14, null, 880); tone('square', 220, t + .1, .6, .06, null, 660); noise(t, .8, .2, 'highpass', 3000); }\n  else if (k === 'ko'){ tone('sawtooth', 400, t, 1.2, .2, null, 60); noise(t, 1, .4, 'lowpass', 900); }\n  else if (k === 'bell'){ tone('triangle', 1320, t, .9, .2); tone('triangle', 1980, t, .7, .1); }\n  else if (k === 'click') tone('triangle', 900, t, .05, .08);\n  else if (k === 'combo'){ tone('square', 523, t, .1, .1); tone('square', 659, t + .07, .1, .1); tone('square', 988, t + .14, .25, .12); noise(t, .3, .3, 'highpass', 2500); }\n}\nfunction speak(t){ try { if (!window.speechSynthesis) return; var u = new SpeechSynthesisUtterance(t); u.rate = .9; u.pitch = .7; u.volume = .9; speechSynthesis.cancel(); speechSynthesis.speak(u); } catch (e) {} }\nvar CH = [[40, 47, 52, 55], [36, 43, 48, 52], [38, 45, 50, 53], [35, 42, 47, 50]];\nfunction musicTick(){\n  var c = AU.ctx; if (!c || c.state !== 'running') return;\n  AU.music.gain.setTargetAtTime(SET.music ? (phase === 'menu' || phase === 'select' ? .26 : .17) : 0, c.currentTime, .3); if (!SET.music) return;\n  if (AU.mNext < c.currentTime) AU.mNext = c.currentTime + .05;\n  var M = function(m){ return 440 * Math.pow(2, (m - 69) / 12); };\n  while (AU.mNext < c.currentTime + .2){\n    var s = AU.mStep, bar = Math.floor(s / 16) % 4, st = s % 16, ch = CH[bar], t = AU.mNext, mm = AU.music;\n    if (st % 4 === 0 || st === 10) tone('sine', 120, t, .2, .55, mm, 40);\n    if (st === 4 || st === 12) noise(t, .14, .28, 'bandpass', 1800, mm);\n    if (st % 2 === 1) noise(t, .03, .07, 'highpass', 7000, mm);\n    tone('sawtooth', M(ch[0] - 12 + (st % 4 === 2 ? 12 : 0)), t, .12, .12, mm);\n    if (Math.floor(s / 64) % 2 && st % 2 === 0) tone('square', M(ch[(st / 2) % 4] + 12), t, .09, .035, mm);\n    AU.mStep = (s + 1) % 256; AU.mNext += 60 / 132 / 4;\n  }\n}\n\n// ===================================================================\n// LOOP\n// ===================================================================\nvar last = 0, acc = 0;\nfunction tick(){\n  if (phase === 'menu' || phase === 'select'){ demoTick(); return; }\n  if (phase === 'paused' || phase === 'over' || phase === 'vs') return;\n  flowTick(); if (phase === 'over' || phase === 'intro' && phaseT === 0) return;\n  if (freeze > 0){ freeze--; if (superFx) superFx.t++; if (freeze === 0) superFx = null; return; }\n  if (hitstop > 0){ hitstop--; return; }\n  if (slowmo > 0){ slowmo--; if (slowmo % 3) return; }\n  readPlayer();\n  if (F[1].ai) aiStep(F[1]);\n  if (F[0].ai) aiStep(F[0]);\n  if (phase === 'fight') roundT -= DT;\n  stepFighter(F[0]); stepFighter(F[1]); separate(); stepProjs();\n  if (phase === 'fight'){\n    if (F[0].hp <= 0 || F[1].hp <= 0) endRound(F[0].hp <= 0 && F[1].hp <= 0 ? -1 : F[0].hp <= 0 ? 1 : 0);\n    else if (roundT <= 0) endRound(F[0].hp === F[1].hp ? -1 : F[0].hp > F[1].hp ? 0 : 1);\n  }\n}\nfunction demoTick(){\n  if (!F.length) return;\n  var save = phase; phase = 'fight'; QUIET = true;\n  aiStep(F[0]); aiStep(F[1]); stepFighter(F[0]); stepFighter(F[1]); separate(); stepProjs();\n  QUIET = false; freeze = 0; superFx = null;\n  if (F[0].hp < 30 || F[1].hp < 30){ F[0].hp = F[0].def.hp; F[1].hp = F[1].def.hp; }\n  phase = save; hitstop = 0;\n}\nfunction frame(ts){\n  requestAnimationFrame(frame);\n  var dt = last ? Math.min(.1, (ts - last) / 1000) : 0; last = ts;\n  acc += dt; var g = 0; while (acc >= DT && g++ < 6){ tick(); acc -= DT; } if (g >= 6) acc = 0;\n  stepParts(dt);\n  if (MESH.shell){ render(dt); drawFx(dt); }\n  if (phase !== 'menu' && phase !== 'select') updateHUD();\n  musicTick();\n}\nfunction boot(){\n  MECHS.forEach(buildMech); buildFx(); buildStages();\n  var loads = [];\n  var add = function(key, uri){ if (!uri) return; loads.push(new Promise(function(res){ var im = new Image(); im.onload = function(){ IMG[key] = im; res(); }; im.onerror = function(){ res(); }; im.src = uri; })); };\n  MECHS.forEach(function(d){ add('arm_' + d.id, TEXDATA['arm_' + d.id]); }); add('frame', TEXDATA.frame);\n  add('steel', TEXDATA.steel); add('concrete', TEXDATA.concrete); for (var b in BACKDROPS) add('bg_' + b, BACKDROPS[b]);\n  Promise.all(loads).then(function(){\n    try { initGL(); } catch (e) { var er = document.createElement('div'); er.id = 'err'; er.textContent = 'Graphics error: ' + e.message; document.body.appendChild(er); return; }\n    if (TITLE_URI) el('menu').style.setProperty('--title', 'url(' + TITLE_URI + ')');\n    return Promise.all([store.getItem('rr.settings'), store.getItem('rr.records')]).then(function(v){ try { if (v[0]) Object.assign(SET, JSON.parse(v[0])); } catch (e) {} try { if (v[1]) Object.assign(REC, JSON.parse(v[1])); } catch (e) {} }).catch(function(){});\n  }).then(function(){ toMenu(); requestAnimationFrame(frame); });\n}\nwindow.__rrVerts = function(){ var o = {}; MECHS.forEach(function(d){ var n = 0; ['pelvis','torso','head','uarm','farm','thigh','shin'].forEach(function(k){ n += MESH[d.id + '_' + k].length / 10 * ((k === 'uarm' || k === 'farm' || k === 'thigh' || k === 'shin') ? 2 : 1); }); o[d.id] = n; }); return o; };\nwindow.__rr = { get phase(){ return phase; }, get F(){ return F; }, get projs(){ return projs; }, IN: IN, tick: function(n){ for (var i = 0; i < n; i++) tick(); }, quick: function(a, b, s){ mode = 'quick'; pick = a; foe = b; stageId = s || 'yard'; startMatch(); },\n  set camo(v){ CAMO = v; }, cine: function(k, t){ return playCine(k, t, 1, null); }, preload: function(k){ preloadCine(k); }, get vids(){ return Object.keys(VIDS).map(function(k){ return k + ':' + VIDS[k].readyState; }); }, fxTest: function(){ var f = F[0], o = F[1]; impact((f.x + o.x) / 2, 2, 14, f); comic((f.x + o.x) / 2, 2.2, true); flash(.4); showBanner('STEEL RUSH<small>3 HIT COMBO</small>', 1500, true); }, set pose(v){ F.forEach(function(f){ for (var k in PO[v]) f.pose[k] = PO[v][k]; }); }, place: function(i, x, face){ F[i].x = x; F[i].face = face; },\n  set ai0(v){ AI0 = !!v; if (F[0]) F[0].ai = !!v; }, set diff(v){ SET.diff = v; }, press: function(k){ edges[k] = 1; }, hold: function(k, v){ keyHeld[k] = !!v; } };\nboot();\n})();\n</script>\n</body></html>\n"}