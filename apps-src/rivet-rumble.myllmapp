 + 3; d.pv.shA = (d.pv.shA || 0) - 6;\n  impact(hx, hy, H.dmg, att); hitstop = Math.max(hitstop, H.dmg >= 10 ? 9 : 5); shake = Math.max(shake, H.dmg >= 10 ? .45 : .2);\n  if (H.dmg >= 10){ flash(.28); zoomKick = Math.max(zoomKick, .8); if (rnd() < .55) comic(hx, hy); } if (d.flashT !== undefined || true) d.flashT = 3;\n  sfx(H.dmg >= 10 ? 'heavy' : 'hit'); haptic('light');\n  if (d.combo >= 2) showCombo(att ? att.i : 0, d.combo);\n  if (att && H.fin && d.combo >= 3){ showBanner(COMBO_NAMES[att.def.id][att.atkName === 'spin' ? 1 : 0] + '<small>' + d.combo + ' HIT COMBO</small>', 1200, true); flash(.55); zoomKick = 1.6; slowmo = Math.max(slowmo, 18); sfx('combo'); comic(hx, hy, true); att.meter = Math.min(100, att.meter + 10); }\n  return 'hit';\n}\nfunction landHit(f, A){\n  var o = opp(f), r = rect(f, A.box), hb = hurtbox(o);\n  if (!overlap(r, hb)) return;\n  var hx = (Math.max(r[0], hb[0]) + Math.min(r[1], hb[1])) / 2, hy = (Math.max(r[2], hb[2]) + Math.min(r[3], hb[3])) / 2;\n  var res = applyHit(f, o, A, hx, hy);\n  if (res){ f.hitDone = true; f.connected = res; }\n}\n// ---------- specials + supers ----------\nfunction specialStep(f){\n  var o = opp(f), id = f.def.id, a = f.af, s = f.def.s;\n  if (f.st === 'special'){\n    if (id === 'vanta'){ if (a === 10) spawnProj(f, { type: 'fist', x: f.x + f.face * 1.4 * s, y: 2.0 * s, vx: 17 * f.face, vy: 0, w: .5, h: .5, life: 1.2, H: { dmg: 13, hs: 22, bs: 12, kb: 4, chip: .2, meter: 9 } }); if (a > 30) endMove(f); return a < 10 ? 'jabW' : 'jabH'; }\n    if (id === 'torque'){ if (a === 1){ f.vy = 6.5; f.y = .02; } if (a > 4 && grounded(f) && !f.hitDone){ f.hitDone = true; shake = .4; dust(f.x, 14); sfx('slam');\n        spawnProj(f, { type: 'wave', x: f.x + f.face * 1.4, y: .35, vx: 11 * f.face, vy: 0, w: .7, h: .7, life: .9, H: { dmg: 14, hs: 22, bs: 12, kb: 3, knock: 1, chip: .2, meter: 9 } });\n        landHitRaw(f, [-.6, 2.0, 0, 1.6], { dmg: 8, hs: 16, bs: 10, kb: 3, knock: 1, chip: .1, meter: 5 }); }\n      if (f.h