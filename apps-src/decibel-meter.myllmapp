{"name": "Decibel Meter", "kind": "html", "iconSymbol": "gauge.with.needle", "iconColor": "red", "html": "<!doctype html>\n<!--\n  Decibel Meter — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Decibel Meter</title>\n<style>\n  :root{ color-scheme:light dark;\n    --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n    --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff); }\n  @media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n    --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); } }\n  @property --h{ syntax:'<number>'; inherits:true; initial-value:140; }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; user-select:none; -webkit-user-select:none; }\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left));\n    text-align:center;\n  }\n  body.lock{ overflow:hidden; }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; } button:active{ transform:scale(.96); }\n  h1{ font-size:22px; font-weight:800; margin:4px 2px 14px; display:flex; align-items:center; gap:10px; text-align:left; }\n  .tile{ width:34px; height:34px; border-radius:10px; display:flex; align-items:center; justify-content:center; color:#fff; font-size:15px; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(4 72% 54%), hsl(340 62% 30%)); }\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:18px 2px 10px; text-align:left; }\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:18px 16px; margin-bottom:12px; }\n\n  /* Home: the scale at rest, and the way in. */\n  .rest{ position:relative; width:min(74vw,280px); margin:0 auto 4px; }\n  .rest svg{ display:block; width:100%; height:auto; overflow:visible; }\n  .rest .trk{ fill:none; stroke-width:14; stroke-linecap:round; }\n  .rest .mid{ position:absolute; left:0; right:0; top:44%; }\n  .db{ font-size:56px; font-weight:800; line-height:1; font-variant-numeric:tabular-nums; }\n  .db small{ font-size:18px; font-weight:650; color:var(--muted); }\n  .ctx{ font-size:15.5px; font-weight:700; margin-top:6px; min-height:22px; }\n  .approx{ font-size:11.5px; color:var(--muted); margin-top:6px; }\n\n  .row{ display:flex; gap:10px; }\n  .stat{ flex:1; background:var(--surface); border:1px solid var(--line); border-radius:14px; padding:12px; }\n  .stat small{ display:block; font-size:11px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:var(--muted); }\n  .stat b{ font-size:22px; font-variant-numeric:tabular-nums; }\n\n  .go{ width:100%; border:none; border-radius:14px; padding:14px; margin-top:12px; min-height:50px;\n    font-size:15.5px; font-weight:750; background:var(--acc); color:#fff; display:flex; align-items:center; justify-content:center; gap:8px; }\n  .go.ghost{ background:var(--surface); color:var(--ink); border:1px solid var(--line); }\n  .msg{ font-size:13px; color:var(--muted); line-height:1.55; margin-top:10px; }\n  .msg:empty{ display:none; }\n\n  .bands{ text-align:left; font-size:13px; padding:6px 16px; }\n  .bands div{ display:flex; align-items:center; gap:9px; padding:9px 0; border-bottom:1px solid var(--line); }\n  .bands div:last-child{ border-bottom:none; }\n  .bands i{ width:11px; height:11px; border-radius:50%; flex:none; font-style:normal; }\n  .bands span{ color:var(--muted); margin-left:auto; font-variant-numeric:tabular-nums; }\n\n  /* The stage: a live reading takes the whole display, and the room's colour\n     follows the level — green when it's calm, amber as it rises, red when it\n     hurts. The hue eases; it never flashes. */\n  .stage{ display:none; position:fixed; inset:0; z-index:50; --h:140; transition:--h .9s ease; color:#fff; overflow:hidden; text-align:center; }\n  .stage.on{ display:block; }\n  .bg{ position:absolute; inset:0; transition:opacity .6s ease; }\n  .bg.d{ background:radial-gradient(120% 90% at 20% 10%, hsl(var(--h) 70% 32%), transparent 60%),\n      radial-gradient(120% 90% at 85% 95%, hsl(calc(var(--h) - 40) 62% 24%), transparent 62%), #0b0b10; }\n  .bg.l{ opacity:0; background:radial-gradient(120% 90% at 20% 0%, hsl(var(--h) 80% 84%), transparent 60%),\n      radial-gradient(120% 90% at 85% 100%, hsl(calc(var(--h) - 40) 78% 87%), transparent 62%), #f4f4f8; }\n  .lite{ color:#15151a; } .lite .bg.l{ opacity:1; } .lite .bg.d{ opacity:0; }\n  .col{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center;\n    padding:calc(12px + env(safe-area-inset-top)) calc(20px + env(safe-area-inset-right)) calc(20px + env(safe-area-inset-bottom)) calc(20px + env(safe-area-inset-left)); }\n  .top{ width:100%; max-width:520px; height:44px; display:flex; align-items:center; justify-content:space-between; flex-shrink:0; }\n  .lbl{ font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; opacity:.62; }\n  .glass{ border:1px solid rgba(255,255,255,.16); background:rgba(255,255,255,.12); color:inherit;\n    -webkit-backdrop-filter:blur(18px); backdrop-filter:blur(18px); }\n  .lite .glass{ border-color:rgba(0,0,0,.09); background:rgba(255,255,255,.62); }\n  .rnd{ width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:15px; }\n\n  .body{ flex:1; min-height:0; width:100%; max-width:520px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:18px; }\n  .dial{ position:relative; width:var(--s,300px); flex-shrink:0; }\n  .dial svg{ display:block; width:100%; height:auto; overflow:visible; }\n  .dial .trk{ fill:none; stroke:currentColor; stroke-opacity:.14; stroke-width:12; stroke-linecap:round; }\n  .dial .lvl{ fill:none; stroke:hsl(var(--h) 88% 62%); stroke-width:12; stroke-linecap:round; transition:stroke-dasharray .16s linear, opacity .3s;\n    filter:drop-shadow(0 0 10px hsl(var(--h) 90% 58% / .55)); }\n  .lite .dial .lvl{ stroke:hsl(var(--h) 80% 42%); filter:none; }\n  .dial .pk{ fill:currentColor; opacity:.55; transition:opacity .3s; }\n  .dial .ends{ position:absolute; left:6%; right:6%; bottom:-2px; display:flex; justify-content:space-between; font-size:11px; font-weight:700; opacity:.45; font-variant-numeric:tabular-nums; }\n  .dial .mid{ position:absolute; left:0; right:0; top:30%; }\n  .num{ font-size:calc(var(--s,300px) * .34); font-weight:800; line-height:1; letter-spacing:-.03em; font-variant-numeric:tabular-nums; }\n  .unit{ font-size:13px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; opacity:.6; margin-top:4px; }\n  .sctx{ font-size:17px; font-weight:700; min-height:24px; flex-shrink:0; }\n  .smsg{ font-size:13px; line-height:1.5; opacity:.75; max-width:340px; flex-shrink:0; } .smsg:empty{ display:none; }\n  .side{ width:100%; display:flex; flex-direction:column; gap:12px; align-items:center; }\n  .hist{ width:100%; height:58px; border-radius:16px; display:block; }\n  .stats{ width:100%; display:flex; gap:10px; }\n  .stats div{ flex:1; border-radius:16px; padding:10px 6px; }\n  .stats small{ display:block; font-size:10.5px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; opacity:.6; }\n  .stats b{ font-size:23px; font-variant-numeric:tabular-nums; }\n  .note{ font-size:11.5px; opacity:.5; flex-shrink:0; margin-top:8px; }\n\n  @media (max-height:520px){                       /* phone on its side: dial left, history and stats right */\n    .body{ flex-direction:row; max-width:none; gap:5vw; } .sctx{ min-height:0; }\n    .lcol{ display:flex; flex-direction:column; align-items:center; gap:8px; }\n    .side{ width:min(340px,40vw); } .note{ display:none; }\n  }\n  @media (min-width:768px){ body{ max-width:760px; } }\n  @media (prefers-reduced-motion:reduce){ .stage{ transition:none; } .dial .lvl{ transition:none; } }\n</style>\n<style>:root{--build-id:\"5799516a6d\";}</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-meter\" viewBox=\"0 0 24 24\"><path d=\"M12 4.5A9.5 9.5 0 0 0 2.5 14a1 1 0 0 0 2 0 7.5 7.5 0 0 1 15 0 1 1 0 0 0 2 0A9.5 9.5 0 0 0 12 4.5zm4.3 4.2-4.9 4a1.9 1.9 0 1 0 1.3 1.5l4.8-4.1a1 1 0 0 0-1.2-1.4zM6 18a1 1 0 0 0 0 2h12a1 1 0 0 0 0-2z\"/></symbol>\n  <symbol id=\"i-mic\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5A3.5 3.5 0 0 0 8.5 6v5.5a3.5 3.5 0 0 0 7 0V6A3.5 3.5 0 0 0 12 2.5zM6 10.5a1 1 0 0 0-1 1 7 7 0 0 0 6 6.9V20H8.5a1 1 0 0 0 0 2h7a1 1 0 0 0 0-2H13v-1.6a7 7 0 0 0 6-6.9 1 1 0 0 0-2 0 5 5 0 0 1-10 0 1 1 0 0 0-1-1z\"/></symbol>\n  <symbol id=\"i-close\" viewBox=\"0 0 24 24\"><path d=\"M6.4 5a1 1 0 0 0-1.4 1.4L10.6 12 5 17.6A1 1 0 0 0 6.4 19l5.6-5.6 5.6 5.6a1 1 0 0 0 1.4-1.4L13.4 12 19 6.4A1 1 0 0 0 17.6 5L12 10.6z\"/></symbol>\n  <symbol id=\"i-reset\" viewBox=\"0 0 24 24\"><path d=\"M12 5V2.6a.6.6 0 0 0-1-.45L7.2 5.55a.6.6 0 0 0 0 .9L11 9.85a.6.6 0 0 0 1-.45V7a5.5 5.5 0 1 1-5.5 5.5 1 1 0 0 0-2 0A7.5 7.5 0 1 0 12 5z\"/></symbol>\n  <linearGradient id=\"g-scale\" x1=\"0\" x2=\"1\" y1=\"0\" y2=\"0\"><stop offset=\"0\" stop-color=\"#30d158\"/><stop offset=\".45\" stop-color=\"#ffd60a\"/><stop offset=\".72\" stop-color=\"#ff9500\"/><stop offset=\"1\" stop-color=\"#ff3b30\"/></linearGradient>\n</defs></svg>\n\n<h1><span class=\"tile\"><svg class=\"i\"><use href=\"#i-meter\"/></svg></span>Decibel Meter</h1>\n\n<div class=\"card\">\n  <div class=\"rest\">\n    <svg viewBox=\"0 -18 240 172\" aria-hidden=\"true\"><path class=\"trk\" stroke=\"url(#g-scale)\" d=\"M33.4 140A100 100 0 1 1 206.6 140\"/></svg>\n    <div class=\"mid\"><div class=\"db\"><span id=\"dbval\">–</span> <small>dB</small></div></div>\n  </div>\n  <div class=\"ctx\" id=\"ctx\"></div>\n  <p class=\"approx\">Approximate level — phone mics aren't calibrated instruments.</p>\n  <button class=\"go\" id=\"micbtn\" onclick=\"startMic()\"><svg class=\"i\"><use href=\"#i-mic\"/></svg>Start listening</button>\n  <p class=\"msg\" id=\"msg\"></p>\n</div>\n\n<div class=\"row\">\n  <div class=\"stat\"><small>Peak</small><b id=\"peak\">–</b></div>\n  <div class=\"stat\"><small>Average</small><b id=\"avg\">–</b></div>\n</div>\n<button class=\"go ghost\" onclick=\"resetStats()\"><svg class=\"i\"><use href=\"#i-reset\"/></svg>Reset peak &amp; average</button>\n\n<h2>What the numbers mean</h2>\n<div class=\"card bands\">\n  <div><i style=\"background:#30d158\"></i>Quiet library, whisper<span>30–40</span></div>\n  <div><i style=\"background:#a5d64a\"></i>Calm home, fridge hum<span>40–55</span></div>\n  <div><i style=\"background:#ffd60a\"></i>Normal conversation<span>55–65</span></div>\n  <div><i style=\"background:#ffd60a\"></i>Busy office, laughter<span>65–75</span></div>\n  <div><i style=\"background:#ff9500\"></i>Heavy traffic, vacuum<span>75–85</span></div>\n  <div><i style=\"background:#ff9500\"></i>Shouting — risky over hours<span>85–95</span></div>\n  <div><i style=\"background:#ff3b30\"></i>Concert, power tools<span>95–110</span></div>\n  <div><i style=\"background:#ff3b30\"></i>Painfully loud — protect your ears<span>110+</span></div>\n</div>\n\n<div class=\"stage\" id=\"stage\">\n  <div class=\"bg d\"></div><div class=\"bg l\"></div>\n  <div class=\"col\">\n    <div class=\"top\">\n      <button class=\"glass rnd\" id=\"sClose\" aria-label=\"Stop listening\"><svg class=\"i\"><use href=\"#i-close\"/></svg></button>\n      <div class=\"lbl\">Decibel Meter</div>\n      <button class=\"glass rnd\" id=\"sReset\" aria-label=\"Reset peak and average\"><svg class=\"i\"><use href=\"#i-reset\"/></svg></button>\n    </div>\n    <div class=\"body\">\n      <div class=\"lcol\">\n        <div class=\"dial\">\n          <svg viewBox=\"0 -18 240 172\" aria-hidden=\"true\">\n            <path class=\"trk\" d=\"M33.4 140A100 100 0 1 1 206.6 140\"/>\n            <path class=\"lvl\" id=\"sLvl\" pathLength=\"100\" stroke-dasharray=\"0 100\" d=\"M33.4 140A100 100 0 1 1 206.6 140\"/>\n            <circle class=\"pk\" id=\"sPk\" r=\"3.2\" cx=\"33.4\" cy=\"140\"/>\n          </svg>\n          <div class=\"mid\"><div class=\"num\" id=\"sNum\">–</div><div class=\"unit\">dB</div></div>\n          <div class=\"ends\"><span>30</span><span>120</span></div>\n        </div>\n        <div class=\"sctx\" id=\"sCtx\"></div>\n        <div class=\"smsg\" id=\"sMsg\"></div>\n      </div>\n      <div class=\"side\">\n        <canvas class=\"hist glass\" id=\"sHist\"></canvas>\n        <div class=\"stats\">\n          <div class=\"glass\"><small>Low</small><b id=\"sMin\">–</b></div>\n          <div class=\"glass\"><small>Average</small><b id=\"sAvg\">–</b></div>\n          <div class=\"glass\"><small>Peak</small><b id=\"sPeak\">–</b></div>\n        </div>\n      </div>\n    </div>\n    <div class=\"note\">Approximate level — phone mics aren't calibrated instruments.</div>\n  </div>\n</div>\n\n<script>\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction el(id){ return document.getElementById(id); }\n\nvar actx = null, analyser = null, buf = null, running = false;\nvar peak = 0, sum = 0, count = 0;\nvar deadFrames = 0, liveSeen = false;\n/* uncalibrated offset mapping dBFS → rough dB SPL; typical phone mics sit\n   near this; the UI is explicit that it's approximate */\nvar OFFSET = 96;\n\n/* the stage's own bookkeeping — display only, nothing here feeds the reading */\nvar stream = null, low = 0, shown = 0, lastPaint = 0, lastHist = 0, hist = [], ease = 0;\n\nfunction say(t){ el(\"msg\").textContent = t; el(\"sMsg\").textContent = t; }\n\nfunction startMic(){\n  haptic(\"light\");\n  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){\n    el(\"msg\").textContent = \"The microphone isn't available to apps on this version of MyLLM — it arrives with the next app update.\";\n    return;\n  }\n  el(\"msg\").textContent = \"Starting…\";\n  navigator.mediaDevices.getUserMedia({audio:true})\n  .then(function(s){\n    var tr = s.getAudioTracks()[0];\n    if (tr && tr.applyConstraints){\n      /* AGC would flatten the very levels we're measuring */\n      tr.applyConstraints({autoGainControl:false, noiseSuppression:false, echoCancellation:false}).catch(function(){});\n    }\n    var AC = window.AudioContext || window.webkitAudioContext;\n    actx = actx || new AC();\n    if (actx.state === \"suspended\") actx.resume();\n    var src = actx.createMediaStreamSource(s);\n    analyser = actx.createAnalyser();\n    analyser.fftSize = 2048;\n    src.connect(analyser);\n    buf = new Float32Array(analyser.fftSize);\n    running = true;\n    deadFrames = 0; liveSeen = false;\n    stream = s;\n    say(\"\");\n    openStage();            /* only once the mic is really open: a refusal never leaves the home screen */\n    loop();\n  })\n  .catch(function(err){\n    var name = err && err.name ? \" (\" + err.name + \")\" : \"\";\n    el(\"msg\").textContent = \"Couldn't open the microphone\" + name + \". Check “Allow apps to use the microphone” in Settings → MyLLMos Apps, then reopen.\";\n    closeStage();\n  });\n}\n\nfunction loop(){\n  if (!running) return;\n  requestAnimationFrame(loop);\n  analyser.getFloatTimeDomainData(buf);\n  var rms = 0, maxAbs = 0;\n  for (var i = 0; i < buf.length; i++){\n    var v = buf[i];\n    rms += v * v;\n    var a = v < 0 ? -v : v;\n    if (a > maxAbs) maxAbs = a;\n  }\n  rms = Math.sqrt(rms / buf.length);\n\n  /* silent-capture watchdog (pre-4.1 builds grant the mic but deliver zeros) */\n  if (!liveSeen){\n    if (maxAbs < 1e-4){\n      if (++deadFrames === 240){\n        say(\"The mic connected but no sound is reaching it — this is fixed in the next MyLLM update.\");\n      }\n    } else liveSeen = true;\n  }\n\n  var db = rms > 0 ? Math.max(0, Math.min(120, Math.round(20 * Math.log10(rms) + OFFSET))) : 0;\n  if (db > 0){\n    if (db > peak) peak = db;\n    sum += db; count++;\n    if (!low || db < low) low = db;\n  }\n  paint(db);\n}\n\nfunction context(db){\n  return db <= 0 ? \"\" :\n    db < 40 ? \"🤫 Library quiet\" :\n    db < 55 ? \"😌 Calm room\" :\n    db < 65 ? \"💬 Conversation level\" :\n    db < 75 ? \"🏢 Busy space\" :\n    db < 85 ? \"🚗 Heavy traffic\" :\n    db < 95 ? \"📣 Loud — tiring over hours\" :\n    db < 110 ? \"🎸 Concert loud\" : \"⚠️ Painfully loud\";\n}\n/* 30 dB sits at the left end of the dial, 120 dB at the right */\nfunction frac(db){ return Math.max(0, Math.min(1, (db - 30) / 90)); }\nfunction onArc(f){ var a = (150 + 240 * f) * Math.PI / 180; return {x:120 + 100 * Math.cos(a), y:90 + 100 * Math.sin(a)}; }\n\nfunction paint(db){\n  var now = performance.now();\n  /* the arc follows every frame; the numerals settle ten times a second so they can be read */\n  ease += (db - ease) * .3;\n  el(\"sLvl\").setAttribute(\"stroke-dasharray\", (frac(ease) * 100).toFixed(2) + \" 100\");\n  el(\"sLvl\").style.opacity = db > 0 ? 1 : 0;\n  if (now - lastPaint >= 100){\n    lastPaint = now; shown = db;\n    var t = db > 0 ? db : \"–\", c = context(db);\n    el(\"dbval\").textContent = t; el(\"sNum\").textContent = t;\n    el(\"ctx\").textContent = c; el(\"sCtx\").textContent = c;\n    stats();\n    var p = onArc(frac(peak)); el(\"sPk\").setAttribute(\"cx\", p.x.toFixed(1)); el(\"sPk\").setAttribute(\"cy\", p.y.toFixed(1));\n    el(\"sPk\").style.opacity = peak ? .55 : 0;\n    /* calm green → amber → red, eased by the stage's own transition */\n    if (db > 0) el(\"stage\").style.setProperty(\"--h\", String(Math.round(140 - 140 * Math.max(0, Math.min(1, (ease - 40) / 60)))));\n  }\n  if (now - lastHist >= 250){ lastHist = now; hist.push(db); if (hist.length > 240) hist.shift(); drawHist(); }\n}\nfunction stats(){\n  var a = count ? Math.round(sum / count) : \"–\";\n  el(\"peak\").textContent = peak || \"–\"; el(\"sPeak\").textContent = peak || \"–\";\n  el(\"avg\").textContent = a; el(\"sAvg\").textContent = a;\n  el(\"sMin\").textContent = low || \"–\";\n}\n\n/* the last minute, four readings a second */\nfunction drawHist(){\n  var cv = el(\"sHist\"), w = cv.clientWidth, h = cv.clientHeight; if (!w || !h) return;\n  var dpr = Math.min(window.devicePixelRatio || 1, 3);\n  if (cv.width !== Math.round(w * dpr) || cv.height !== Math.round(h * dpr)){ cv.width = Math.round(w * dpr); cv.height = Math.round(h * dpr); }\n  var cx = cv.getContext(\"2d\"); cx.setTransform(dpr, 0, 0, dpr, 0, 0); cx.clearRect(0, 0, w, h);\n  if (hist.length < 2) return;\n  var hue = getComputedStyle(el(\"stage\")).getPropertyValue(\"--h\").trim() || \"140\";\n  var lite = el(\"stage\").classList.contains(\"lite\"), step = w / 239, x0 = w - (hist.length - 1) * step, i;\n  cx.beginPath(); cx.moveTo(x0, h);\n  for (i = 0; i < hist.length; i++) cx.lineTo(x0 + i * step, h - 5 - frac(hist[i]) * (h - 12));\n  cx.lineTo(w, h); cx.closePath();\n  cx.fillStyle = \"hsla(\" + hue + \",85%,\" + (lite ? 42 : 62) + \"%,.22)\"; cx.fill();\n  cx.beginPath();\n  for (i = 0; i < hist.length; i++){ var y = h - 5 - frac(hist[i]) * (h - 12); if (i) cx.lineTo(x0 + i * step, y); else cx.moveTo(x0, y); }\n  cx.strokeStyle = \"hsl(\" + hue + \",85%,\" + (lite ? 40 : 66) + \"%)\"; cx.lineWidth = 2; cx.lineJoin = \"round\"; cx.stroke();\n}\n\nfunction resetStats(){\n  peak = 0; sum = 0; count = 0; low = 0;\n  haptic(\"selection\");\n  stats();\n  el(\"sPk\").style.opacity = 0;\n}\n\n/* ---------- the stage ---------- */\nvar stageOn = false;\nfunction isLight(){ return !(window.matchMedia && matchMedia(\"(prefers-color-scheme: dark)\").matches); }\n/* Where MyLLM can't hide its own title bar, a dark stage under a white bar\n   looks cut in half — so in light mode, without myllmImmersive, it stays light. */\nfunction syncLook(){ el(\"stage\").classList.toggle(\"lite\", isLight() && !window.myllmImmersive); }\nfunction syncChrome(){\n  if (!window.myllmImmersive) return;\n  try { myllmImmersive(stageOn, {keepAwake:stageOn}).catch(function(){}); } catch(_){}    /* a meter being watched shouldn't dim */\n}\nfunction fit(){\n  var b = document.querySelector(\".stage .body\"); if (!b || !b.clientWidth) return;\n  var wide = window.innerHeight <= 520;\n  var s = wide ? Math.min(b.clientWidth * .46, (b.clientHeight - 44) * 1.28, 380) : Math.min(b.clientWidth * .92, (b.clientHeight - 230) * 1.55, 380);\n  el(\"stage\").style.setProperty(\"--s\", Math.max(170, Math.floor(s)) + \"px\");\n  drawHist();\n}\nfunction openStage(){\n  stageOn = true; hist = []; ease = 0; lastPaint = lastHist = 0;\n  syncLook();\n  el(\"stage\").classList.add(\"on\"); document.body.classList.add(\"lock\");\n  fit(); syncChrome();\n}\nfunction closeStage(){\n  var was = stageOn;\n  stageOn = false; running = false;\n  if (stream){ try { stream.getTracks().forEach(function(t){ t.stop(); }); } catch(_){} stream = null; }\n  el(\"stage\").classList.remove(\"on\"); document.body.classList.remove(\"lock\");\n  if (was) syncChrome();\n}\nel(\"sClose\").onclick = function(){ haptic(\"light\"); closeStage(); };\nel(\"sReset\").onclick = resetStats;\n\ndocument.addEventListener(\"visibilitychange\", function(){\n  if (!document.hidden && stageOn) syncChrome();          /* MyLLM puts its bars back when the app is left */\n});\nif (window.matchMedia){\n  var mq = matchMedia(\"(prefers-color-scheme: dark)\");\n  if (mq.addEventListener) mq.addEventListener(\"change\", syncLook); else if (mq.addListener) mq.addListener(syncLook);\n}\nwindow.addEventListener(\"resize\", fit);\n</script>\n</body>\n</html>\n"}