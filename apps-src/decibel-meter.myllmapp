{"name": "Decibel Meter", "kind": "html", "iconSymbol": "gauge.with.needle", "iconColor": "red", "html": "<!doctype html>\n<!--\n  Decibel Meter — MyLLMos App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Decibel Meter</title>\n<style>\n  :root { color-scheme: light dark; }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; user-select:none; -webkit-user-select:none; }\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111);\n    max-width:560px; margin:0 auto; min-height:100dvh;\n    padding:16px 16px calc(30px + env(safe-area-inset-bottom));\n    text-align:center;\n  }\n  h1{ font-size:22px; font-weight:800; margin:4px 0 14px; }\n  .card{\n    background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8);\n    border-radius:18px; padding:18px 16px; margin-bottom:12px;\n  }\n  /* gauge */\n  #gauge{ position:relative; width:min(78vw,300px); height:min(42vw,160px); margin:0 auto 8px; overflow:hidden; }\n  #gauge .arc{\n    position:absolute; left:0; right:0; bottom:0; height:200%;\n    border-radius:50%;\n    background:conic-gradient(from 270deg,\n      #30d158 0deg 36deg, #a5d64a 36deg 72deg, #ffd60a 72deg 108deg,\n      #ff9500 108deg 144deg, #ff3b30 144deg 180deg, transparent 180deg 360deg);\n    -webkit-mask:radial-gradient(circle at 50% 50%, transparent 58%, #000 59%);\n    mask:radial-gradient(circle at 50% 50%, transparent 58%, #000 59%);\n  }\n  #needle{\n    position:absolute; left:50%; bottom:0; width:4px; height:88%;\n    margin-left:-2px; transform-origin:50% 100%;\n    background:var(--myllm-text,#111); border-radius:4px;\n    transform:rotate(-90deg); transition:transform .12s ease-out;\n  }\n  #hub{ position:absolute; left:50%; bottom:-9px; width:18px; height:18px; margin-left:-9px; border-radius:50%; background:var(--myllm-text,#111); }\n  .db{ font-size:56px; font-weight:800; line-height:1; font-variant-numeric:tabular-nums; }\n  .db small{ font-size:18px; font-weight:650; color:var(--myllm-muted,#8a8a8e); }\n  .ctx{ font-size:15.5px; font-weight:700; margin-top:6px; min-height:22px; }\n  .approx{ font-size:11.5px; color:var(--myllm-muted,#8a8a8e); margin-top:6px; }\n\n  .row{ display:flex; gap:10px; }\n  .stat{ flex:1; background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8); border-radius:14px; padding:12px; }\n  .stat small{ display:block; font-size:11px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:var(--myllm-muted,#8a8a8e); }\n  .stat b{ font-size:22px; font-variant-numeric:tabular-nums; }\n\n  .go{\n    width:100%; border:none; border-radius:13px; padding:14px; margin-top:12px;\n    font-size:15.5px; font-weight:750; background:var(--myllm-accent,#0a84ff); color:#fff;\n  }\n  .go.ghost{ background:var(--myllm-surface,#fff); color:var(--myllm-text,#111); border:1px solid var(--myllm-border,#e3e3e8); }\n  .msg{ font-size:13px; color:var(--myllm-muted,#8a8a8e); line-height:1.55; margin-top:10px; }\n\n  .bands{ text-align:left; font-size:13px; }\n  .bands div{ display:flex; align-items:center; gap:9px; padding:6px 0; border-bottom:1px solid var(--myllm-border,#e3e3e8); }\n  .bands div:last-child{ border-bottom:none; }\n  .bands i{ width:11px; height:11px; border-radius:50%; flex:none; font-style:normal; }\n  .bands span{ color:var(--myllm-muted,#8a8a8e); margin-left:auto; font-variant-numeric:tabular-nums; }\n</style>\n<style>:root{--build-id:\"5799516a6d\";}</style>\n</head>\n<body>\n\n<h1>📢 Decibel Meter</h1>\n\n<div class=\"card\">\n  <div id=\"gauge\"><div class=\"arc\"></div><div id=\"needle\"></div><div id=\"hub\"></div></div>\n  <div class=\"db\"><span id=\"dbval\">–</span> <small>dB</small></div>\n  <div class=\"ctx\" id=\"ctx\"></div>\n  <p class=\"approx\">Approximate level — phone mics aren't calibrated instruments.</p>\n  <button class=\"go\" id=\"micbtn\" onclick=\"startMic()\">Start listening</button>\n  <p class=\"msg\" id=\"msg\"></p>\n</div>\n\n<div class=\"row\">\n  <div class=\"stat\"><small>Peak</small><b id=\"peak\">–</b></div>\n  <div class=\"stat\"><small>Average</small><b id=\"avg\">–</b></div>\n</div>\n<button class=\"go ghost\" onclick=\"resetStats()\">Reset peak &amp; average</button>\n\n<div class=\"card bands\">\n  <div><i style=\"background:#30d158\"></i>Quiet library, whisper<span>30–40</span></div>\n  <div><i style=\"background:#a5d64a\"></i>Calm home, fridge hum<span>40–55</span></div>\n  <div><i style=\"background:#ffd60a\"></i>Normal conversation<span>55–65</span></div>\n  <div><i style=\"background:#ffd60a\"></i>Busy office, laughter<span>65–75</span></div>\n  <div><i style=\"background:#ff9500\"></i>Heavy traffic, vacuum<span>75–85</span></div>\n  <div><i style=\"background:#ff9500\"></i>Shouting — risky over hours<span>85–95</span></div>\n  <div><i style=\"background:#ff3b30\"></i>Concert, power tools<span>95–110</span></div>\n  <div><i style=\"background:#ff3b30\"></i>Painfully loud — protect your ears<span>110+</span></div>\n</div>\n\n<script>\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction el(id){ return document.getElementById(id); }\n\nvar actx = null, analyser = null, buf = null, running = false;\nvar peak = 0, sum = 0, count = 0;\nvar deadFrames = 0, liveSeen = false;\n/* uncalibrated offset mapping dBFS → rough dB SPL; typical phone mics sit\n   near this; the UI is explicit that it's approximate */\nvar OFFSET = 96;\n\nfunction startMic(){\n  haptic(\"light\");\n  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){\n    el(\"msg\").textContent = \"The microphone isn't available to apps on this version of MyLLM — it arrives with the next app update.\";\n    return;\n  }\n  el(\"msg\").textContent = \"Starting…\";\n  navigator.mediaDevices.getUserMedia({audio:true})\n  .then(function(s){\n    var tr = s.getAudioTracks()[0];\n    if (tr && tr.applyConstraints){\n      /* AGC would flatten the very levels we're measuring */\n      tr.applyConstraints({autoGainControl:false, noiseSuppression:false, echoCancellation:false}).catch(function(){});\n    }\n    var AC = window.AudioContext || window.webkitAudioContext;\n    actx = actx || new AC();\n    if (actx.state === \"suspended\") actx.resume();\n    var src = actx.createMediaStreamSource(s);\n    analyser = actx.createAnalyser();\n    analyser.fftSize = 2048;\n    src.connect(analyser);\n    buf = new Float32Array(analyser.fftSize);\n    running = true;\n    deadFrames = 0; liveSeen = false;\n    el(\"micbtn\").style.display = \"none\";\n    el(\"msg\").textContent = \"\";\n    loop();\n  })\n  .catch(function(err){\n    var name = err && err.name ? \" (\" + err.name + \")\" : \"\";\n    el(\"msg\").textContent = \"Couldn't open the microphone\" + name + \". Check “Allow apps to use the microphone” in Settings → MyLLMos Apps, then reopen.\";\n  });\n}\n\nfunction loop(){\n  if (!running) return;\n  requestAnimationFrame(loop);\n  analyser.getFloatTimeDomainData(buf);\n  var rms = 0, maxAbs = 0;\n  for (var i = 0; i < buf.length; i++){\n    var v = buf[i];\n    rms += v * v;\n    var a = v < 0 ? -v : v;\n    if (a > maxAbs) maxAbs = a;\n  }\n  rms = Math.sqrt(rms / buf.length);\n\n  /* silent-capture watchdog (pre-4.1 builds grant the mic but deliver zeros) */\n  if (!liveSeen){\n    if (maxAbs < 1e-4){\n      if (++deadFrames === 240){\n        el(\"msg\").textContent = \"The mic connected but no sound is reaching it — this is fixed in the next MyLLM update.\";\n      }\n    } else liveSeen = true;\n  }\n\n  var db = rms > 0 ? Math.max(0, Math.min(120, Math.round(20 * Math.log10(rms) + OFFSET))) : 0;\n  if (db > 0){\n    if (db > peak) peak = db;\n    sum += db; count++;\n  }\n  el(\"dbval\").textContent = db > 0 ? db : \"–\";\n  el(\"peak\").textContent = peak || \"–\";\n  el(\"avg\").textContent = count ? Math.round(sum / count) : \"–\";\n  /* needle: 30dB → -90deg, 120dB → +90deg */\n  var deg = -90 + Math.max(0, Math.min(180, (db - 30) * 2));\n  el(\"needle\").style.transform = \"rotate(\" + deg + \"deg)\";\n  el(\"ctx\").textContent =\n    db <= 0 ? \"\" :\n    db < 40 ? \"🤫 Library quiet\" :\n    db < 55 ? \"😌 Calm room\" :\n    db < 65 ? \"💬 Conversation level\" :\n    db < 75 ? \"🏢 Busy space\" :\n    db < 85 ? \"🚗 Heavy traffic\" :\n    db < 95 ? \"📣 Loud — tiring over hours\" :\n    db < 110 ? \"🎸 Concert loud\" : \"⚠️ Painfully loud\";\n}\n\nfunction resetStats(){\n  peak = 0; sum = 0; count = 0;\n  haptic(\"selection\");\n  el(\"peak\").textContent = \"–\"; el(\"avg\").textContent = \"–\";\n}\n</script>\n</body>\n</html>\n"}