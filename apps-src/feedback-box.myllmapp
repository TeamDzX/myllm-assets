{"name": "Feedback & Ideas", "kind": "html", "iconSymbol": "lightbulb.fill", "iconColor": "yellow", "html": "<!doctype html>\n<!--\n  Feedback & Ideas — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Feedback &amp; Ideas</title>\n<style>\n  :root{ color-scheme:light dark;\n    --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n    --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n    --fill:rgba(120,120,128,.12); --h:40; }\n  @media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n    --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:640px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:760px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.97); }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 12px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 90% 50%), hsl(calc(var(--h) - 22) 80% 40%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  p.sub{ font-size:14px; color:var(--muted); margin:0 2px 14px; line-height:1.5; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  label{ display:flex; align-items:baseline; gap:8px; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:16px 2px 7px; }\n  label:first-child{ margin-top:0; }\n  input, textarea{ width:100%; font:inherit; font-size:16px; padding:12px; border-radius:12px;\n    border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; }\n  input:focus, textarea:focus{ border-color:var(--acc); }\n  textarea{ min-height:120px; resize:vertical; line-height:1.45; }\n  .kinds{ display:grid; grid-template-columns:1fr 1fr; gap:8px; }\n  .kind{ min-height:52px; border:1px solid var(--line); background:var(--bg); border-radius:14px; padding:8px 10px; font-size:14px; font-weight:650;\n    display:flex; align-items:center; gap:9px; text-align:left; line-height:1.25; }\n  .kind .ki{ width:30px; height:30px; border-radius:9px; display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0; font-size:15px; }\n  .kind[aria-pressed=\"true\"]{ background:var(--acc); color:#fff; border-color:transparent; }\n  .kind[aria-pressed=\"true\"] .ki{ background:rgba(255,255,255,.22) !important; }\n  .go{ width:100%; min-height:50px; border:none; border-radius:14px; margin-top:14px; font-size:16px; font-weight:700;\n    background:var(--acc); color:#fff; display:flex; align-items:center; justify-content:center; gap:8px; }\n  .go.ghost{ background:var(--bg); color:var(--ink); border:1px solid var(--line); margin-top:10px; }\n  .go[disabled]{ opacity:.45; }\n  .note{ font-size:12.5px; color:var(--muted); line-height:1.55; margin-top:12px; }\n  .note b{ color:var(--ink); font-weight:700; }\n  .msg{ display:flex; align-items:flex-start; gap:7px; font-size:13.5px; margin-top:10px; line-height:1.45; }\n  .msg:empty{ display:none; }\n  .msg svg{ width:16px; height:16px; margin-top:1px; }\n  .msg.warn{ color:#d1342f; }\n  .msg.ok{ color:#1a8a3f; }\n  @media (prefers-color-scheme:dark){ .msg.warn{ color:#ff6b62; } .msg.ok{ color:#34c759; } }\n  #out{ display:none; }\n  #pkg{ min-height:150px; font-family:ui-monospace,Menlo,monospace; font-size:13px; }\n  .privacy{ display:flex; gap:12px; align-items:flex-start; }\n  .privacy .tile{ width:36px; height:36px; border-radius:10px; font-size:16px; background:linear-gradient(145deg,#34c759,#1f8a45); }\n  .privacy .note{ margin-top:0; }\n  .count{ margin-left:auto; font-size:11px; color:var(--muted); text-transform:none; letter-spacing:0; font-weight:600; font-variant-numeric:tabular-nums; }\n  @media (prefers-reduced-motion:reduce){ button:active{ transform:none; } }\n</style>\n<style>:root{--build-id:\"db136e85f3\";}</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-bulb\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5a7 7 0 0 1 4.2 12.6c-.7.5-1.2 1.3-1.2 2.1v.3a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1v-.3c0-.8-.5-1.6-1.2-2.1A7 7 0 0 1 12 2.5zM9.5 20h5a1 1 0 0 1 0 2h-5a1 1 0 0 1 0-2z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-bug\" viewBox=\"0 0 24 24\"><path d=\"M9 3.3a1 1 0 0 1 1.3.5l.5 1.1a5 5 0 0 1 2.4 0l.5-1.1a1 1 0 1 1 1.8.8l-.5 1.1A5 5 0 0 1 17 8h1.5a1 1 0 0 1 0 2H17v2h2.5a1 1 0 0 1 0 2H17v.5c0 .5-.1 1-.2 1.5h1.7a1 1 0 0 1 0 2h-2.7A5 5 0 0 1 12 20a5 5 0 0 1-3.8-2H5.5a1 1 0 0 1 0-2h1.7A6 6 0 0 1 7 14.5V14H4.5a1 1 0 0 1 0-2H7v-2H5.5a1 1 0 0 1 0-2H7a5 5 0 0 1 2-2.3l-.5-1.1A1 1 0 0 1 9 3.3zM11 10v7.9a1 1 0 0 0 2 0V10a1 1 0 0 0-2 0z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-box\" viewBox=\"0 0 24 24\"><path d=\"M11.5 2.2a1 1 0 0 1 1 0l8 4.4a1 1 0 0 1 .5.9v9a1 1 0 0 1-.5.9l-8 4.4a1 1 0 0 1-1 0l-8-4.4a1 1 0 0 1-.5-.9v-9a1 1 0 0 1 .5-.9zM5 9.2v7.7l6 3.3v-7.7zm14 0l-6 3.3v7.7l6-3.3zM12 4.2L6.1 7.5 12 10.8l5.9-3.3z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-heart\" viewBox=\"0 0 24 24\"><path d=\"M12 20.5l-1.3-1.2C5.9 15 3 12.3 3 8.9 3 6.2 5.1 4 7.8 4c1.6 0 3.1.8 4.2 2 1.1-1.2 2.6-2 4.2-2C18.9 4 21 6.2 21 8.9c0 3.4-2.9 6.1-7.7 10.4z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-send\" viewBox=\"0 0 24 24\"><path d=\"M21.4 2.6a1 1 0 0 1 .2 1.1l-7.2 17a1 1 0 0 1-1.9-.1l-1.9-7.2-7.2-1.9a1 1 0 0 1-.1-1.9l17-7.2a1 1 0 0 1 1.1.2zM12.6 12.8l1.1 4.2 4.4-10.4z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-doc\" viewBox=\"0 0 24 24\"><path d=\"M6.5 2.5h7.1c.7 0 1.3.3 1.8.7l4.4 4.4c.5.5.7 1.1.7 1.8v10.1a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4.5 19.5v-14A3 3 0 0 1 6.5 2.5zM8 12a1 1 0 0 0 0 2h8a1 1 0 0 0 0-2zm0 4a1 1 0 0 0 0 2h5a1 1 0 0 0 0-2z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-ext\" viewBox=\"0 0 24 24\"><path d=\"M14 3h6a1 1 0 0 1 1 1v6a1 1 0 0 1-2 0V6.4l-7.3 7.3a1 1 0 0 1-1.4-1.4L17.6 5H14a1 1 0 0 1 0-2zM6.5 6H10a1 1 0 0 1 0 2H6.5a.5.5 0 0 0-.5.5v11c0 .3.2.5.5.5h11c.3 0 .5-.2.5-.5V14a1 1 0 0 1 2 0v3.5A2.5 2.5 0 0 1 17.5 20h-11A2.5 2.5 0 0 1 4 17.5v-9A2.5 2.5 0 0 1 6.5 6z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-again\" viewBox=\"0 0 24 24\"><path d=\"M12 5V2.6a.6.6 0 0 0-1-.45L7.2 5.55a.6.6 0 0 0 0 .9L11 9.85a.6.6 0 0 0 1-.45V7a5.5 5.5 0 1 1-5.5 5.5 1 1 0 0 0-2 0A7.5 7.5 0 1 0 12 5z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-lock\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5a4.5 4.5 0 0 1 4.5 4.5v2h.5A2.5 2.5 0 0 1 19.5 11.5v7A2.5 2.5 0 0 1 17 21H7a2.5 2.5 0 0 1-2.5-2.5v-7A2.5 2.5 0 0 1 7 9h.5V7A4.5 4.5 0 0 1 12 2.5zm0 2A2.5 2.5 0 0 0 9.5 7v2h5V7A2.5 2.5 0 0 0 12 4.5z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M5 12.6l4.6 4.6L19.2 7.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-warn\" viewBox=\"0 0 24 24\"><path d=\"M10.3 3.9a2 2 0 0 1 3.4 0l8 13.6a2 2 0 0 1-1.7 3H4a2 2 0 0 1-1.7-3zM12 9a1 1 0 0 0-1 1v4a1 1 0 0 0 2 0v-4a1 1 0 0 0-1-1zm0 7.2a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z\" fill=\"currentColor\"/></symbol>\n</defs></svg>\n\n<div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-bulb\"/></svg></div>\n  <div class=\"ht\"><h1>Feedback &amp; Ideas</h1><p>Tell us what to build next</p></div>\n</div>\n<p class=\"sub\">Tell us what to build next, what's broken, or what you love. Write it here and send it whichever way suits you — nothing is uploaded on its own.</p>\n\n<div class=\"card\">\n  <label>What is this?</label>\n  <div class=\"kinds\">\n    <button class=\"kind\" id=\"k-idea\"  aria-pressed=\"true\"  onclick=\"setKind('idea')\"><span class=\"ki\" style=\"background:#e6a100\"><svg class=\"i\"><use href=\"#i-bulb\"/></svg></span>Idea</button>\n    <button class=\"kind\" id=\"k-bug\"   aria-pressed=\"false\" onclick=\"setKind('bug')\"><span class=\"ki\" style=\"background:#e5342f\"><svg class=\"i\"><use href=\"#i-bug\"/></svg></span>Something's broken</button>\n    <button class=\"kind\" id=\"k-app\"   aria-pressed=\"false\" onclick=\"setKind('app')\"><span class=\"ki\" style=\"background:#6e5ce6\"><svg class=\"i\"><use href=\"#i-box\"/></svg></span>App request</button>\n    <button class=\"kind\" id=\"k-love\"  aria-pressed=\"false\" onclick=\"setKind('love')\"><span class=\"ki\" style=\"background:#1f9d55\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></span>Something I like</button>\n  </div>\n\n  <label for=\"area\">Which app or part of MyLLM? <span class=\"count\">optional</span></label>\n  <input id=\"area\" placeholder=\"e.g. Chess, the springboard, voice mode\" oninput=\"draft()\">\n\n  <label id=\"bodyLabel\" for=\"body\">Your idea <span class=\"count\" id=\"len\">0</span></label>\n  <textarea id=\"body\" placeholder=\"The more specific, the more useful.\" oninput=\"draft()\"></textarea>\n\n  <div id=\"bugWrap\" style=\"display:none\">\n    <label for=\"expected\">What did you expect to happen instead?</label>\n    <textarea id=\"expected\" style=\"min-height:70px\" placeholder=\"Optional, but it helps a lot.\" oninput=\"draft()\"></textarea>\n  </div>\n\n  <label for=\"contact\">How should we reply? <span class=\"count\">optional</span></label>\n  <input id=\"contact\" placeholder=\"Email or handle — leave blank to stay anonymous\" oninput=\"draft()\">\n\n  <button class=\"go\" onclick=\"build()\"><svg class=\"i\"><use href=\"#i-doc\"/></svg><span>Prepare my feedback</span></button>\n  <div class=\"msg\" id=\"msg\"></div>\n</div>\n\n<div class=\"card\" id=\"out\">\n  <label>Ready to send</label>\n  <textarea id=\"pkg\" readonly onclick=\"this.select()\"></textarea>\n  <button class=\"go\" id=\"shareBtn\" onclick=\"share()\"><svg class=\"i\"><use href=\"#i-send\"/></svg><span>Send it (email, Messages…)</span></button>\n  <button class=\"go ghost\" onclick=\"openIssue()\"><svg class=\"i\"><use href=\"#i-ext\"/></svg><span>Post it on GitHub instead</span></button>\n  <button class=\"go ghost\" onclick=\"reset()\"><svg class=\"i\"><use href=\"#i-again\"/></svg><span>Clear and start again</span></button>\n  <p class=\"note\">Send to <b>MyLLM@opticell-limited.com</b>, or open an issue at <b>github.com/TeamDzX/myllm-assets</b>. Every message is read by a human — you may not get a reply to each one, but it all feeds the roadmap.</p>\n</div>\n\n<div class=\"card privacy\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-lock\"/></svg></div>\n  <p class=\"note\"><b>Nothing leaves your phone by itself.</b> This app has no internet access at all — it only builds the text above. It travels only when you tap send, and only to where you choose. Your draft is saved on-device so you don't lose it.</p>\n</div>\n\n<script>\n/* Deliberately network-free. A suggestion box that displays nobody else's words\n   needs no server, no account and no moderation — and it keeps the app clear of\n   the user-generated-content rules that a public board would trigger. Everything\n   here is composed locally and handed to the share sheet. */\n\nvar KINDS = {\n  idea: { label:\"Idea\",           body:\"Your idea\",              hint:\"The more specific, the more useful.\" },\n  bug:  { label:\"Bug report\",     body:\"What happened?\",         hint:\"What you did, and what went wrong.\" },\n  app:  { label:\"App request\",    body:\"What should it do?\",     hint:\"Describe the app you wish existed.\" },\n  love: { label:\"Positive note\",  body:\"What's working well?\",   hint:\"Tell us what you like — it guides us too.\" }\n};\nvar kind = \"idea\";\nvar KEY = \"feedbackDraft\";\n\nfunction el(id){ return document.getElementById(id); }\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction say(text, cls){\n  var m = el(\"msg\"); m.className = \"msg\" + (cls ? \" \" + cls : \"\");\n  m.innerHTML = \"\";\n  if (!text) return;\n  if (cls) m.innerHTML = '<svg><use href=\"#i-' + (cls === \"warn\" ? \"warn\" : \"check\") + '\"/></svg>';\n  var s = document.createElement(\"span\"); s.textContent = text; m.appendChild(s);\n}\n\nfunction setKind(k){\n  kind = k;\n  Object.keys(KINDS).forEach(function(key){\n    el(\"k-\" + key).setAttribute(\"aria-pressed\", String(key === k));\n  });\n  el(\"bodyLabel\").innerHTML = KINDS[k].body + ' <span class=\"count\" id=\"len\">' + el(\"body\").value.length + '</span>';\n  el(\"body\").placeholder = KINDS[k].hint;\n  el(\"bugWrap\").style.display = (k === \"bug\") ? \"block\" : \"none\";\n  haptic(\"light\");\n  draft();\n}\n\n/* ---- draft persistence (async storage, with a web-preview fallback) ---- */\nfunction snapshot(){\n  return { kind:kind, area:el(\"area\").value, body:el(\"body\").value,\n           expected:el(\"expected\").value, contact:el(\"contact\").value };\n}\nvar saveTimer = null;\nfunction draft(){\n  var n = el(\"len\"); if (n) n.textContent = el(\"body\").value.length;\n  clearTimeout(saveTimer);\n  saveTimer = setTimeout(function(){ persist(snapshot()); }, 400);\n}\nasync function persist(obj){\n  var s = JSON.stringify(obj);\n  try{ if(window.myllmStorage){ await myllmStorage.setItem(KEY, s); return; } }catch(e){}\n  try{ localStorage.setItem(KEY, s); }catch(e){}\n}\nasync function restore(){\n  var raw = null;\n  try{ if(window.myllmStorage){ raw = await myllmStorage.getItem(KEY); } }catch(e){}\n  if(!raw){ try{ raw = localStorage.getItem(KEY); }catch(e){} }\n  if(!raw) return;\n  var d; try{ d = JSON.parse(raw); }catch(e){ return; }\n  el(\"area\").value     = d.area     || \"\";\n  el(\"body\").value     = d.body     || \"\";\n  el(\"expected\").value = d.expected || \"\";\n  el(\"contact\").value  = d.contact  || \"\";\n  setKind(d.kind && KINDS[d.kind] ? d.kind : \"idea\");\n}\n\n/* ---- compose ---- */\nfunction build(){\n  var body = el(\"body\").value.trim();\n  if (body.length < 10){\n    haptic(\"light\");\n    say(\"Add a little more detail first — a sentence or two is plenty.\", \"warn\");\n    el(\"body\").focus();\n    return;\n  }\n  var lines = [];\n  lines.push(\"MyLLM feedback — \" + KINDS[kind].label);\n  lines.push(\"\");\n  if (el(\"area\").value.trim()) lines.push(\"About: \" + el(\"area\").value.trim());\n  lines.push(\"\");\n  lines.push(body);\n  if (kind === \"bug\" && el(\"expected\").value.trim()){\n    lines.push(\"\");\n    lines.push(\"Expected instead:\");\n    lines.push(el(\"expected\").value.trim());\n  }\n  lines.push(\"\");\n  lines.push(\"Reply to: \" + (el(\"contact\").value.trim() || \"(no reply needed)\"));\n  el(\"pkg\").value = lines.join(\"\\n\");\n  el(\"out\").style.display = \"block\";\n  el(\"shareBtn\").style.display = window.myllmShare ? \"flex\" : \"none\";\n  say(\"Ready — now choose how to send it.\", \"ok\");\n  haptic(\"success\");\n  el(\"out\").scrollIntoView({ behavior:\"smooth\", block:\"nearest\" });\n}\n\nfunction share(){\n  if (window.myllmShare){ try{ myllmShare({ text: el(\"pkg\").value }); }catch(_){} }\n  haptic(\"light\");\n}\n\nfunction openIssue(){\n  haptic(\"light\");\n  var title = encodeURIComponent(\"[\" + KINDS[kind].label + \"] \" + (el(\"area\").value.trim() || \"MyLLM\"));\n  window.open(\"https://github.com/TeamDzX/myllm-assets/issues/new?title=\" + title);\n}\n\nfunction reset(){\n  el(\"area\").value = \"\"; el(\"body\").value = \"\"; el(\"expected\").value = \"\"; el(\"contact\").value = \"\";\n  el(\"pkg\").value = \"\"; el(\"out\").style.display = \"none\";\n  setKind(\"idea\");\n  persist(snapshot());\n  say(\"Cleared.\", \"ok\");\n  haptic(\"light\");\n}\n\nrestore();\n</script>\n</body>\n</html>\n"}