{"name": "Feedback & Ideas", "kind": "html", "iconSymbol": "lightbulb.fill", "iconColor": "yellow", "html": "<!doctype html>\n<!--\n  Feedback & Ideas — MyLLMos App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Feedback &amp; Ideas</title>\n<style>\n  :root { color-scheme: light dark; }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111);\n    max-width:640px; margin:0 auto; min-height:100dvh;\n    padding:16px 16px calc(30px + env(safe-area-inset-bottom));\n  }\n  h1{ font-size:22px; font-weight:800; margin:6px 2px 4px; }\n  p.sub{ font-size:13.5px; color:var(--myllm-muted,#8a8a8e); margin:0 2px 14px; line-height:1.5; }\n  .card{\n    background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8);\n    border-radius:16px; padding:14px; margin-bottom:12px;\n  }\n  label{ display:block; font-size:11.5px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:var(--myllm-muted,#8a8a8e); margin:12px 0 6px; }\n  label:first-child{ margin-top:0; }\n  input, textarea{\n    width:100%; font-size:15px; padding:11px 12px; border-radius:12px;\n    border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111);\n    font-family:inherit;\n  }\n  textarea{ min-height:120px; resize:vertical; line-height:1.45; }\n  .kinds{ display:flex; flex-wrap:wrap; gap:8px; }\n  .kind{\n    flex:1 1 calc(50% - 4px); border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111); border-radius:12px; padding:11px 8px; font-size:14px; font-weight:650;\n    font-family:inherit; display:flex; align-items:center; justify-content:center; gap:6px;\n  }\n  .kind[aria-pressed=\"true\"]{ background:var(--myllm-accent,#0a84ff); color:#fff; border-color:transparent; }\n  .go{\n    width:100%; border:none; border-radius:13px; padding:14px; margin-top:12px;\n    font-size:15.5px; font-weight:750; background:var(--myllm-accent,#0a84ff); color:#fff; font-family:inherit;\n  }\n  .go.ghost{ background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111); border:1px solid var(--myllm-border,#e3e3e8); }\n  .go[disabled]{ opacity:.45; }\n  .note{ font-size:12.5px; color:var(--myllm-muted,#8a8a8e); line-height:1.5; margin-top:10px; }\n  .note b{ color:var(--myllm-text,#111); font-weight:700; }\n  .msg{ font-size:13.5px; margin-top:10px; line-height:1.5; min-height:19px; }\n  .msg.warn{ color:#d1342f; }\n  .msg.ok{ color:#1a8a3f; }\n  #out{ display:none; }\n  #pkg{ min-height:150px; font-family:ui-monospace,Menlo,monospace; font-size:11.5px; }\n  .privacy{ border-left:3px solid var(--myllm-accent,#0a84ff); padding-left:10px; }\n  .count{ float:right; font-size:11px; color:var(--myllm-muted,#8a8a8e); text-transform:none; letter-spacing:0; font-weight:600; }\n</style>\n<style>:root{--build-id:\"db136e85f3\";}</style>\n</head>\n<body>\n\n<h1>💡 Feedback &amp; Ideas</h1>\n<p class=\"sub\">Tell us what to build next, what's broken, or what you love. Write it here and send it whichever way suits you — nothing is uploaded on its own.</p>\n\n<div class=\"card\">\n  <label>What is this?</label>\n  <div class=\"kinds\">\n    <button class=\"kind\" id=\"k-idea\"  aria-pressed=\"true\"  onclick=\"setKind('idea')\">💡 Idea</button>\n    <button class=\"kind\" id=\"k-bug\"   aria-pressed=\"false\" onclick=\"setKind('bug')\">🐞 Something's broken</button>\n    <button class=\"kind\" id=\"k-app\"   aria-pressed=\"false\" onclick=\"setKind('app')\">📦 App request</button>\n    <button class=\"kind\" id=\"k-love\"  aria-pressed=\"false\" onclick=\"setKind('love')\">💚 Something I like</button>\n  </div>\n\n  <label>Which app or part of MyLLM? <span class=\"count\">optional</span></label>\n  <input id=\"area\" placeholder=\"e.g. Chess, the springboard, voice mode\" oninput=\"draft()\">\n\n  <label id=\"bodyLabel\">Your idea <span class=\"count\" id=\"len\">0</span></label>\n  <textarea id=\"body\" placeholder=\"The more specific, the more useful.\" oninput=\"draft()\"></textarea>\n\n  <div id=\"bugWrap\" style=\"display:none\">\n    <label>What did you expect to happen instead?</label>\n    <textarea id=\"expected\" style=\"min-height:70px\" placeholder=\"Optional, but it helps a lot.\" oninput=\"draft()\"></textarea>\n  </div>\n\n  <label>How should we reply? <span class=\"count\">optional</span></label>\n  <input id=\"contact\" placeholder=\"Email or handle — leave blank to stay anonymous\" oninput=\"draft()\">\n\n  <button class=\"go\" onclick=\"build()\">Prepare my feedback</button>\n  <div class=\"msg\" id=\"msg\"></div>\n</div>\n\n<div class=\"card\" id=\"out\">\n  <label>Ready to send</label>\n  <textarea id=\"pkg\" readonly onclick=\"this.select()\"></textarea>\n  <button class=\"go\" id=\"shareBtn\" onclick=\"share()\">Send it (email, Messages…)</button>\n  <button class=\"go ghost\" onclick=\"openIssue()\">Post it on GitHub instead</button>\n  <button class=\"go ghost\" onclick=\"reset()\">Clear and start again</button>\n  <p class=\"note\">Send to <b>MyLLM@opticell-limited.com</b>, or open an issue at <b>github.com/TeamDzX/myllm-assets</b>. Every message is read by a human — you may not get a reply to each one, but it all feeds the roadmap.</p>\n</div>\n\n<div class=\"card privacy\">\n  <p class=\"note\" style=\"margin-top:0\"><b>Nothing leaves your phone by itself.</b> This app has no internet access at all — it only builds the text above. It travels only when you tap send, and only to where you choose. Your draft is saved on-device so you don't lose it.</p>\n</div>\n\n<script>\n/* Deliberately network-free. A suggestion box that displays nobody else's words\n   needs no server, no account and no moderation — and it keeps the app clear of\n   the user-generated-content rules that a public board would trigger. Everything\n   here is composed locally and handed to the share sheet. */\n\nvar KINDS = {\n  idea: { label:\"Idea\",           body:\"Your idea\",              hint:\"The more specific, the more useful.\" },\n  bug:  { label:\"Bug report\",     body:\"What happened?\",         hint:\"What you did, and what went wrong.\" },\n  app:  { label:\"App request\",    body:\"What should it do?\",     hint:\"Describe the app you wish existed.\" },\n  love: { label:\"Positive note\",  body:\"What's working well?\",   hint:\"Tell us what you like — it guides us too.\" }\n};\nvar kind = \"idea\";\nvar KEY = \"feedbackDraft\";\n\nfunction el(id){ return document.getElementById(id); }\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction say(text, cls){ var m = el(\"msg\"); m.textContent = text || \"\"; m.className = \"msg\" + (cls ? \" \" + cls : \"\"); }\n\nfunction setKind(k){\n  kind = k;\n  Object.keys(KINDS).forEach(function(key){\n    el(\"k-\" + key).setAttribute(\"aria-pressed\", String(key === k));\n  });\n  el(\"bodyLabel\").innerHTML = KINDS[k].body + ' <span class=\"count\" id=\"len\">' + el(\"body\").value.length + '</span>';\n  el(\"body\").placeholder = KINDS[k].hint;\n  el(\"bugWrap\").style.display = (k === \"bug\") ? \"block\" : \"none\";\n  haptic(\"light\");\n  draft();\n}\n\n/* ---- draft persistence (async storage, with a web-preview fallback) ---- */\nfunction snapshot(){\n  return { kind:kind, area:el(\"area\").value, body:el(\"body\").value,\n           expected:el(\"expected\").value, contact:el(\"contact\").value };\n}\nvar saveTimer = null;\nfunction draft(){\n  var n = el(\"len\"); if (n) n.textContent = el(\"body\").value.length;\n  clearTimeout(saveTimer);\n  saveTimer = setTimeout(function(){ persist(snapshot()); }, 400);\n}\nasync function persist(obj){\n  var s = JSON.stringify(obj);\n  try{ if(window.myllmStorage){ await myllmStorage.setItem(KEY, s); return; } }catch(e){}\n  try{ localStorage.setItem(KEY, s); }catch(e){}\n}\nasync function restore(){\n  var raw = null;\n  try{ if(window.myllmStorage){ raw = await myllmStorage.getItem(KEY); } }catch(e){}\n  if(!raw){ try{ raw = localStorage.getItem(KEY); }catch(e){} }\n  if(!raw) return;\n  var d; try{ d = JSON.parse(raw); }catch(e){ return; }\n  el(\"area\").value     = d.area     || \"\";\n  el(\"body\").value     = d.body     || \"\";\n  el(\"expected\").value = d.expected || \"\";\n  el(\"contact\").value  = d.contact  || \"\";\n  setKind(d.kind && KINDS[d.kind] ? d.kind : \"idea\");\n}\n\n/* ---- compose ---- */\nfunction build(){\n  var body = el(\"body\").value.trim();\n  if (body.length < 10){\n    haptic(\"light\");\n    say(\"Add a little more detail first — a sentence or two is plenty.\", \"warn\");\n    el(\"body\").focus();\n    return;\n  }\n  var lines = [];\n  lines.push(\"MyLLM feedback — \" + KINDS[kind].label);\n  lines.push(\"\");\n  if (el(\"area\").value.trim()) lines.push(\"About: \" + el(\"area\").value.trim());\n  lines.push(\"\");\n  lines.push(body);\n  if (kind === \"bug\" && el(\"expected\").value.trim()){\n    lines.push(\"\");\n    lines.push(\"Expected instead:\");\n    lines.push(el(\"expected\").value.trim());\n  }\n  lines.push(\"\");\n  lines.push(\"Reply to: \" + (el(\"contact\").value.trim() || \"(no reply needed)\"));\n  el(\"pkg\").value = lines.join(\"\\n\");\n  el(\"out\").style.display = \"block\";\n  el(\"shareBtn\").style.display = window.myllmShare ? \"block\" : \"none\";\n  say(\"Ready — now choose how to send it.\", \"ok\");\n  haptic(\"success\");\n  el(\"out\").scrollIntoView({ behavior:\"smooth\", block:\"nearest\" });\n}\n\nfunction share(){\n  if (window.myllmShare){ try{ myllmShare({ text: el(\"pkg\").value }); }catch(_){} }\n  haptic(\"light\");\n}\n\nfunction openIssue(){\n  haptic(\"light\");\n  var title = encodeURIComponent(\"[\" + KINDS[kind].label + \"] \" + (el(\"area\").value.trim() || \"MyLLM\"));\n  window.open(\"https://github.com/TeamDzX/myllm-assets/issues/new?title=\" + title);\n}\n\nfunction reset(){\n  el(\"area\").value = \"\"; el(\"body\").value = \"\"; el(\"expected\").value = \"\"; el(\"contact\").value = \"\";\n  el(\"pkg\").value = \"\"; el(\"out\").style.display = \"none\";\n  setKind(\"idea\");\n  persist(snapshot());\n  say(\"Cleared.\", \"ok\");\n  haptic(\"light\");\n}\n\nrestore();\n</script>\n</body>\n</html>\n"}