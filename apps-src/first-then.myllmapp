{"name": "First–Then", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\">\n<style>:root{color-scheme:light dark;--bg:#f2f2f7;--fg:#111;--card:#fff;--accent:#34a853}\n@media(prefers-color-scheme:dark){:root{--bg:#000;--fg:#eee;--card:#1c1c1e}}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none}\nhtml,body{margin:0;min-height:100%}\nbody{font-family:-apple-system,system-ui,sans-serif;background:var(--bg);color:var(--fg);margin:0;padding:calc(14px + env(safe-area-inset-top)) 14px calc(20px + env(safe-area-inset-bottom));max-width:560px;margin:0 auto}\n.head{display:flex;align-items:center;justify-content:space-between;margin-bottom:4px}\nh1{font-size:20px;margin:0;font-weight:700}\n.sub{font-size:12px;opacity:.55;margin-bottom:12px}\n.editbtn{border:0;background:rgba(127,127,127,.16);color:var(--fg);border-radius:12px;padding:7px 13px;font-size:13px;font-weight:600}\n.editbtn.on{background:var(--accent);color:#fff}\n.prog{height:8px;border-radius:6px;background:rgba(127,127,127,.18);overflow:hidden;margin-bottom:14px}\n.prog>div{height:100%;background:var(--accent);width:0;transition:width .35s}\n.step{display:flex;align-items:center;gap:14px;background:var(--card);border-radius:16px;padding:14px;margin-bottom:10px;box-shadow:0 1px 3px rgba(0,0,0,.08);border:2px solid transparent;transition:opacity .25s}\n.step .em{font-size:38px;width:52px;text-align:center}\n.step .lb{flex:1;font-size:19px;font-weight:600}\n.step .ck{width:34px;height:34px;border-radius:50%;border:3px solid #c7c7cc;flex:none;display:flex;align-items:center;justify-content:center;color:#fff;font-size:18px}\n.step.done{opacity:.5}\n.step.done .ck{background:var(--accent);border-color:var(--accent)}\n.step.done .lb{text-decoration:line-through}\n.step .del{border:0;background:transparent;color:#f0584f;font-size:20px;width:34px}\n.celebrate{text-align:center;padding:22px 10px;font-size:18px;font-weight:700;color:var(--accent);display:none}\n.celebrate.show{display:block}\n.editor{background:var(--card);border-radius:16px;padding:12px;margin-bottom:12px;display:none}\n.editor.show{display:block}\n.emojis{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px}\n.emojis button{border:0;background:rgba(127,127,127,.14);border-radius:10px;font-size:24px;width:42px;height:42px}\n.emojis button.on{background:var(--accent)}\n.erow{display:flex;gap:8px}\n.erow input{flex:1;border:1px solid rgba(127,127,127,.3);background:var(--bg);color:var(--fg);border-radius:12px;padding:11px;font-size:16px;-webkit-user-select:text;user-select:text}\n.erow .add{border:0;background:var(--accent);color:#fff;border-radius:12px;padding:0 18px;font-size:15px;font-weight:700}\n.foot{display:flex;gap:10px;margin-top:6px}\n.foot button{flex:1;border:0;background:rgba(127,127,127,.16);color:var(--fg);border-radius:14px;padding:12px;font-size:15px;font-weight:600}\n@media(min-width:768px){body{max-width:720px}}\n</style></head><body>\n<div class=\"head\"><h1>✅ First–Then</h1><button class=\"editbtn\" id=\"editbtn\" onclick=\"toggleEdit()\">Edit</button></div>\n<div class=\"sub\">Tap each step when it's done. One thing at a time.</div>\n<div class=\"prog\"><div id=\"progfill\"></div></div>\n<div class=\"editor\" id=\"editor\">\n  <div class=\"emojis\" id=\"emojis\"></div>\n  <div class=\"erow\"><input id=\"newlabel\" placeholder=\"New step (e.g. Brush teeth)\"><button class=\"add\" onclick=\"addStep()\">Add</button></div>\n</div>\n<div id=\"list\"></div>\n<div class=\"celebrate\" id=\"celebrate\">🎉 All done — brilliant! 🎉</div>\n<div class=\"foot\"><button onclick=\"resetChecks()\">Start again</button></div>\n<script>\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nfunction haptic(s){if(window.myllmHaptic)try{myllmHaptic(s)}catch(e){}}\nvar DEFAULT=[['🛏️','Wake up'],['🚽','Toilet'],['🪥','Brush teeth'],['👕','Get dressed'],['🥣','Breakfast'],['🎒','Pack my bag']];\nvar PALETTE=['🛏️','🚽','🪥','👕','🥣','🍎','🎒','🚌','📚','✏️','🧼','🛁','🦷','🧦','👟','🧸','🎨','⚽','🎵','😴','💧','🍽️','🧹','📺'];\nvar steps=[],editing=false,pickEmoji='⭐';\nfunction el(i){return document.getElementById(i)}\nfunction render(){\n  var L=el('list');L.innerHTML='';\n  steps.forEach(function(s,i){\n    var d=document.createElement('div');d.className='step'+(s.done?' done':'');\n    d.innerHTML='<div class=\"em\">'+s.emoji+'</div><div class=\"lb\">'+esc(s.label)+'</div>'+\n      (editing?'<button class=\"del\">✕</button>':'<div class=\"ck\">'+(s.done?'✓':'')+'</div>');\n    if(editing){d.querySelector('.del').onclick=function(){steps.splice(i,1);save();render()}}\n    else{d.onclick=function(){s.done=!s.done;haptic(s.done?'success':'selection');save();render()}}\n    L.appendChild(d);\n  });\n  var done=steps.filter(function(s){return s.done}).length;\n  el('progfill').style.width=(steps.length?done/steps.length*100:0)+'%';\n  el('celebrate').classList.toggle('show',steps.length>0&&done===steps.length);\n}\nfunction esc(t){return String(t).replace(/[&<>]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;'}[c]})}\nfunction toggleEdit(){editing=!editing;el('editbtn').classList.toggle('on',editing);el('editor').classList.toggle('show',editing);el('editbtn').textContent=editing?'Done':'Edit';render()}\nfunction renderEmojis(){var E=el('emojis');E.innerHTML='';PALETTE.forEach(function(em){var b=document.createElement('button');b.textContent=em;if(em===pickEmoji)b.className='on';b.onclick=function(){pickEmoji=em;renderEmojis()};E.appendChild(b)})}\nfunction addStep(){var v=el('newlabel').value.trim();if(!v)return;steps.push({emoji:pickEmoji,label:v,done:false});el('newlabel').value='';haptic('light');save();render()}\nfunction resetChecks(){steps.forEach(function(s){s.done=false});haptic('medium');save();render()}\nfunction save(){store.setItem('ft_steps',JSON.stringify(steps))}\nel('newlabel').addEventListener('keydown',function(e){if(e.key==='Enter')addStep()});\nrenderEmojis();\nstore.getItem('ft_steps').then(function(v){\n  if(v){try{steps=JSON.parse(v)}catch(e){}}\n  if(!steps||!steps.length){steps=DEFAULT.map(function(p){return{emoji:p[0],label:p[1],done:false}})}\n  render();\n});\n</script></body></html>\n", "kind": "html", "iconSymbol": "checklist", "iconColor": "green"}