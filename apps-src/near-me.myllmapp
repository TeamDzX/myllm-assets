{"name": "Near Me", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<link rel=\"stylesheet\" href=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.css\"/>\n<style>:root{color-scheme:light dark}\n*{box-sizing:border-box}\nbody{font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);margin:0;padding:16px;background:var(--myllm-bg,#f2f2f7);color:var(--myllm-text,#111)}\nh1{font-size:22px;margin:0 0 2px;display:flex;align-items:center;gap:8px}\n.sub{font-size:13px;color:var(--myllm-muted,#8a8a8e);margin:0 0 14px}\n#map{height:190px;border-radius:var(--myllm-radius,14px);margin-bottom:14px;display:none;background:#dfe3e8}\n.row{display:flex;gap:8px;margin-bottom:10px}\ninput{flex:1;padding:12px;border:1px solid var(--myllm-border,#d1d1d6);border-radius:12px;font-size:16px;background:var(--myllm-surface,#fff);color:var(--myllm-text,#111)}\nbutton{border:0;background:var(--myllm-accent,#0a84ff);color:#fff;border-radius:12px;padding:0 16px;font-size:15px;font-weight:600}\n.chips{display:flex;gap:8px;overflow-x:auto;padding-bottom:6px;margin-bottom:8px;-webkit-overflow-scrolling:touch}\n.chip{flex:0 0 auto;background:var(--myllm-surface,#fff);border:1px solid var(--myllm-border,#d1d1d6);color:var(--myllm-text,#111);border-radius:999px;padding:8px 14px;font-size:14px;font-weight:600}\n.card{background:var(--myllm-surface,#fff);border-radius:14px;padding:12px 14px;margin-bottom:10px}\n.card .top{display:flex;align-items:baseline;gap:8px}\n.card .name{font-size:16px;font-weight:600;flex:1}\n.card .dist{font-size:13px;color:var(--myllm-accent,#0a84ff);font-weight:600;white-space:nowrap}\n.card .addr{font-size:13px;color:var(--myllm-muted,#8a8a8e);margin:4px 0 8px}\n.card .acts{display:flex;gap:8px}\n.card .acts a,.card .acts button{font-size:13px;font-weight:600;text-decoration:none;background:rgba(10,132,255,.12);color:var(--myllm-accent,#0a84ff);border-radius:9px;padding:7px 12px;display:inline-block}\n.note{text-align:center;color:var(--myllm-muted,#8a8a8e);font-size:14px;margin-top:26px;line-height:1.5;padding:0 10px}\n.spin{text-align:center;color:var(--myllm-muted,#8a8a8e);margin-top:24px}\n@media(min-width:768px){body{max-width:780px;margin-left:auto;margin-right:auto}#map{height:260px}}\n</style></head><body>\n<h1>📍 Near Me</h1>\n<p class=\"sub\" id=\"here\">Finding your location…</p>\n<div id=\"map\"></div>\n<div class=\"chips\" id=\"chips\"></div>\n<div class=\"row\"><input id=\"q\" placeholder=\"Search places…\"><button onclick=\"go()\">Go</button></div>\n<div id=\"results\"><p class=\"spin\">…</p></div>\n\n<script src=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.js\"></script>\n<script>\n// Defensive bridge access — degrade gracefully if the host is older or the\n// \"Allow apps to use your location\" setting is off.\nvar LOC = window.myllmLocation || null;\nvar haptic = window.myllmHaptic || function(){};\nvar here = null;           // {latitude, longitude, address}\nvar map = null, layer = null;\nvar CATS = [\n  {label:'☕ Coffee', q:'coffee'}, {label:'🍽 Food', q:'restaurant'},\n  {label:'🛒 Groceries', q:'supermarket'}, {label:'💊 Pharmacy', q:'pharmacy'},\n  {label:'🏧 ATM', q:'atm'}, {label:'⛽ Petrol', q:'petrol station'},\n  {label:'🅿️ Parking', q:'parking'}, {label:'🍺 Bars', q:'bar'},\n  {label:'🏨 Hotels', q:'hotel'}, {label:'🏞 Parks', q:'park'}\n];\n\nfunction el(id){return document.getElementById(id)}\n\nfunction dist(m){\n  if(m==null) return '';\n  if(m<1000) return Math.round(m)+' m';\n  return (m/1000).toFixed(m<10000?1:0)+' km';\n}\n\nfunction chips(){\n  var c=el('chips');\n  CATS.forEach(function(cat){\n    var b=document.createElement('button');b.className='chip';b.textContent=cat.label;\n    b.onclick=function(){haptic('selection');el('q').value=cat.q;go()};\n    c.appendChild(b);\n  });\n}\n\nfunction ensureMap(){\n  if(map||typeof L==='undefined'||!here) return;\n  el('map').style.display='block';\n  map=L.map('map',{attributionControl:false,zoomControl:false}).setView([here.latitude,here.longitude],14);\n  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19}).addTo(map);\n  L.circleMarker([here.latitude,here.longitude],{radius:7,color:'#fff',weight:2,fillColor:'#0a84ff',fillOpacity:1}).addTo(map);\n}\n\nfunction plot(places){\n  if(!map) return;\n  if(layer) map.removeLayer(layer);\n  layer=L.layerGroup().addTo(map);\n  var pts=[[here.latitude,here.longitude]];\n  places.forEach(function(p){\n    L.circleMarker([p.latitude,p.longitude],{radius:6,color:'#fff',weight:2,fillColor:'#ff3b30',fillOpacity:1})\n      .bindPopup(p.name).addTo(layer);\n    pts.push([p.latitude,p.longitude]);\n  });\n  if(pts.length>1) try{map.fitBounds(pts,{padding:[28,28],maxZoom:16})}catch(e){}\n}\n\nfunction render(places){\n  var R=el('results');R.innerHTML='';\n  if(!places.length){R.innerHTML='<p class=\"note\">No places found. Try another search.</p>';return}\n  places.forEach(function(p){\n    var d=document.createElement('div');d.className='card';\n    var dest=p.latitude+','+p.longitude;\n    d.innerHTML='<div class=\"top\"><div class=\"name\"></div><div class=\"dist\">'+dist(p.distance)+'</div></div>'+\n      '<div class=\"addr\"></div>'+\n      '<div class=\"acts\"><a href=\"https://maps.apple.com/?daddr='+dest+'&dirflg=w\">Directions</a>'+\n      '<button class=\"sh\">Share</button></div>';\n    d.querySelector('.name').textContent=(p.category?'':'')+p.name;\n    d.querySelector('.addr').textContent=p.address||'';\n    d.querySelector('.sh').onclick=function(){haptic('light');\n      if(window.myllmShare) myllmShare(p.name+(p.address?' — '+p.address:'')+'\\nhttps://maps.apple.com/?q='+dest)};\n    R.appendChild(d);\n  });\n}\n\nfunction go(){\n  var q=el('q').value.trim();\n  if(!q||!LOC) return;\n  haptic('light');\n  el('results').innerHTML='<p class=\"spin\">Searching…</p>';\n  var opts=here?{}:{near:el('q').dataset.near||''};\n  LOC.search(q,opts).then(function(list){\n    list=list||[];\n    list.sort(function(a,b){return (a.distance||1e12)-(b.distance||1e12)});\n    render(list);plot(list);\n  }).catch(function(e){\n    el('results').innerHTML='<p class=\"note\">'+(e&&e.message?e.message:'Search failed')+'</p>';\n  });\n}\n\nfunction start(){\n  chips();\n  if(!LOC){\n    el('here').textContent='Location unavailable';\n    el('results').innerHTML='<p class=\"note\">This needs the latest MyLLM with <b>Settings → Allow apps to use your location</b> turned on. You can still search by typing a place name and a category.</p>';\n    return;\n  }\n  LOC.current().then(function(p){\n    here=p;\n    el('here').textContent=p.address?('Near '+p.address):'Got your location';\n    ensureMap();\n    el('results').innerHTML='<p class=\"note\">Pick a category above or search to see what\\'s nearby.</p>';\n  }).catch(function(e){\n    el('here').textContent='Location off';\n    el('results').innerHTML='<p class=\"note\">'+(e&&e.message?e.message:'Couldn\\'t get your location')+'<br>Turn on <b>Settings → Allow apps to use your location</b>, then reopen.</p>';\n  });\n}\nstart();\n</script></body></html>\n"}