{"name": "Image Converter", "kind": "html", "iconSymbol": "arrow.triangle.2.circlepath", "iconColor": "teal", "html": "<!doctype html>\n<!--\n  Image Converter — MyLLMos App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Image Converter</title>\n<style>\n  :root { color-scheme: light dark; }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111);\n    max-width:600px; margin:0 auto; min-height:100dvh;\n    padding:16px 16px calc(30px + env(safe-area-inset-bottom));\n  }\n  h1{ font-size:22px; font-weight:800; margin:4px 2px 12px; }\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--myllm-muted,#8a8a8e); margin:18px 2px 10px; }\n\n  .card{\n    background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8);\n    border-radius:18px; padding:14px; margin-bottom:12px;\n  }\n\n  .drop{\n    border:2px dashed var(--myllm-border,#d5d5db); border-radius:18px;\n    padding:26px 16px; text-align:center; background:var(--myllm-surface,#fff); margin-bottom:12px;\n  }\n  .drop .big{ font-size:34px; }\n  .drop p{ font-size:14px; font-weight:650; margin-top:8px; }\n  .drop small{ display:block; font-size:12px; color:var(--myllm-muted,#8a8a8e); margin-top:5px; line-height:1.5; }\n  .drop input{ display:none; }\n\n  .optrow{ display:flex; align-items:center; justify-content:space-between; gap:10px; padding:9px 0; border-bottom:1px solid var(--myllm-border,#e3e3e8); }\n  .optrow:last-child{ border-bottom:none; }\n  .optrow label{ font-size:14px; font-weight:650; }\n  .seg{ display:flex; background:var(--myllm-bg,#f2f2f7); border-radius:10px; padding:3px; }\n  .seg button{\n    border:none; background:none; color:var(--myllm-text,#111);\n    border-radius:8px; padding:6px 13px; font-size:13px; font-weight:650;\n  }\n  .seg button.hot{ background:var(--myllm-surface,#fff); box-shadow:0 1px 4px rgba(0,0,0,.12); }\n  input[type=range]{ width:130px; accent-color:var(--myllm-accent,#0a84ff); }\n  .qv{ font-size:12.5px; color:var(--myllm-muted,#8a8a8e); min-width:34px; text-align:right; font-variant-numeric:tabular-nums; }\n\n  .go{\n    width:100%; border:none; border-radius:14px; padding:14px; margin-bottom:12px;\n    font-size:16px; font-weight:750; background:var(--myllm-accent,#0a84ff); color:#fff;\n  }\n  .go:disabled{ opacity:.45; }\n\n  .item{ display:flex; gap:11px; align-items:center; padding:10px 2px; border-bottom:1px solid var(--myllm-border,#e3e3e8); }\n  .item:last-child{ border-bottom:none; }\n  .thumb{ width:54px; height:54px; border-radius:10px; object-fit:cover; background:var(--myllm-bg,#f2f2f7); flex-shrink:0; }\n  .item .info{ flex:1; min-width:0; }\n  .item .nm{ font-size:13.5px; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .item .dt{ font-size:11.5px; color:var(--myllm-muted,#8a8a8e); margin-top:2px; line-height:1.45; }\n  .item .dt b.less{ color:#30d158; } .item .dt b.more{ color:#ff9f0a; }\n  .item .err{ font-size:11.5px; color:#ff453a; margin-top:2px; line-height:1.45; }\n  .save{\n    border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111);\n    border-radius:10px; padding:9px 13px; font-size:13px; font-weight:650; flex-shrink:0;\n  }\n  .save.done{ color:#30d158; border-color:#30d158; }\n\n  .status{ text-align:center; font-size:13.5px; color:var(--myllm-muted,#8a8a8e); padding:18px 12px; line-height:1.6; }\n  .note{ font-size:12.5px; color:var(--myllm-muted,#8a8a8e); margin:8px 2px; line-height:1.5; }\n  .toast{\n    position:fixed; left:50%; bottom:calc(24px + env(safe-area-inset-bottom)); transform:translateX(-50%) translateY(80px);\n    background:var(--myllm-text,#111); color:var(--myllm-bg,#fff); font-size:13.5px; font-weight:650;\n    padding:11px 18px; border-radius:99px; transition:transform .25s; z-index:9; white-space:nowrap;\n  }\n  .toast.show{ transform:translateX(-50%) translateY(0); }\n</style>\n<style>:root{--build-id:\"d3d46c3ef6\";}</style>\n</head>\n<body>\n\n<h1>🔄 Image Converter</h1>\n\n<label class=\"drop\" id=\"drop\">\n  <span class=\"big\">🖼️</span>\n  <p id=\"dropTitle\">Choose images to convert</p>\n  <small>HEIC, TIFF, WebP, GIF, BMP, PNG or JPG in — JPG or PNG out.<br>\n  Pick from Photos or browse the Files app. Converting also strips location &amp; EXIF metadata.</small>\n  <input id=\"file\" type=\"file\" accept=\"image/*,.heic,.heif,.tif,.tiff,.webp,.bmp\" multiple>\n</label>\n\n<div class=\"card\" id=\"opts\">\n  <div class=\"optrow\">\n    <label>Convert to</label>\n    <div class=\"seg\" id=\"fmtSeg\">\n      <button class=\"hot\" data-f=\"jpeg\" onclick=\"setFmt('jpeg')\">JPG</button>\n      <button data-f=\"png\" onclick=\"setFmt('png')\">PNG</button>\n    </div>\n  </div>\n  <div class=\"optrow\" id=\"qRow\">\n    <label>Quality</label>\n    <div style=\"display:flex;align-items:center;gap:8px\">\n      <input type=\"range\" id=\"q\" min=\"30\" max=\"100\" value=\"85\" oninput=\"qLabel()\">\n      <span class=\"qv\" id=\"qv\">85%</span>\n    </div>\n  </div>\n  <div class=\"optrow\">\n    <label>Max size</label>\n    <div class=\"seg\" id=\"szSeg\">\n      <button class=\"hot\" data-s=\"0\" onclick=\"setSize(0)\">Original</button>\n      <button data-s=\"2048\" onclick=\"setSize(2048)\">2048px</button>\n      <button data-s=\"1024\" onclick=\"setSize(1024)\">1024px</button>\n    </div>\n  </div>\n</div>\n\n<button class=\"go\" id=\"go\" onclick=\"convertAll()\" disabled>Convert</button>\n\n<div id=\"outWrap\" style=\"display:none\">\n  <h2 id=\"outTitle\">Converted</h2>\n  <div class=\"card\" id=\"out\"></div>\n  <p class=\"note\">Saved images land in Photos (and the MyLLMos photos folder). Re-encoding always removes EXIF data — including GPS location — which is handy before sharing.</p>\n</div>\n\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\nvar SAVE = window.myllmSaveImage || null;\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s==null?'':s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\"); }\nfunction toast(m){\n  var t = el(\"toast\"); t.textContent = m; t.classList.add(\"show\");\n  clearTimeout(t._t); t._t = setTimeout(function(){ t.classList.remove(\"show\"); }, 2000);\n}\n\nvar fmt = \"jpeg\";        /* 'jpeg' | 'png' */\nvar maxSide = 0;         /* 0 = keep original */\nvar files = [];          /* picked File objects */\nvar results = [];        /* {name,outName,blob,url,w,h,inBytes,outBytes,saved,error} */\n\n/* ---------- pure helpers (node-tested) ---------- */\n\nfunction fmtBytes(n){\n  if (n == null) return \"\";\n  if (n < 1024) return n + \" B\";\n  if (n < 1048576) return (n/1024).toFixed(n < 10240 ? 1 : 0) + \" KB\";\n  return (n/1048576).toFixed(1) + \" MB\";\n}\n\nfunction outName(name, format){\n  var base = String(name || \"image\").replace(/\\.[a-z0-9]+$/i, \"\");\n  return base + (format === \"png\" ? \".png\" : \".jpg\");\n}\n\nfunction fitSize(w, h, max){\n  if (!max || (w <= max && h <= max)) return {w:w, h:h};\n  var k = max / Math.max(w, h);\n  return {w: Math.max(1, Math.round(w*k)), h: Math.max(1, Math.round(h*k))};\n}\n\nfunction srcLabel(name, type){\n  var m = String(name||\"\").match(/\\.([a-z0-9]+)$/i);\n  var ext = m ? m[1].toUpperCase() : \"\";\n  if (ext === \"JPEG\") ext = \"JPG\";\n  if (ext) return ext;\n  var t = String(type||\"\").split(\"/\")[1] || \"\";\n  return t ? t.toUpperCase() : \"image\";\n}\n\nfunction deltaHtml(inB, outB){\n  if (!inB || !outB) return \"\";\n  var pct = Math.round((outB - inB) / inB * 100);\n  if (pct === 0) return \"\";\n  return pct < 0 ? ' · <b class=\"less\">' + (-pct) + '% smaller</b>'\n                 : ' · <b class=\"more\">' + pct + '% larger</b>';\n}\n\n/* ---------- UI state ---------- */\n\nfunction setFmt(f){\n  fmt = f; haptic(\"selection\");\n  var bs = el(\"fmtSeg\").getElementsByTagName(\"button\");\n  for (var i=0;i<bs.length;i++) bs[i].className = bs[i].getAttribute(\"data-f\") === f ? \"hot\" : \"\";\n  el(\"qRow\").style.display = f === \"jpeg\" ? \"flex\" : \"none\";\n}\n\nfunction setSize(s){\n  maxSide = s; haptic(\"selection\");\n  var bs = el(\"szSeg\").getElementsByTagName(\"button\");\n  for (var i=0;i<bs.length;i++) bs[i].className = +bs[i].getAttribute(\"data-s\") === s ? \"hot\" : \"\";\n}\n\nfunction qLabel(){ el(\"qv\").textContent = el(\"q\").value + \"%\"; }\n\nel(\"file\").addEventListener(\"change\", function(){\n  files = [];\n  for (var i = 0; i < this.files.length; i++) files.push(this.files[i]);\n  el(\"dropTitle\").textContent = files.length\n    ? files.length + (files.length === 1 ? \" image selected\" : \" images selected\")\n    : \"Choose images to convert\";\n  el(\"go\").disabled = !files.length;\n  if (files.length) haptic(\"light\");\n});\n\n/* ---------- conversion ---------- */\n\nfunction decode(file){\n  return new Promise(function(res, rej){\n    var url = URL.createObjectURL(file);\n    var img = new Image();\n    img.onload = function(){ res({img:img, url:url}); };\n    img.onerror = function(){\n      URL.revokeObjectURL(url);\n      rej(new Error(\"Couldn't decode this image — the format may need a newer iOS.\"));\n    };\n    img.src = url;\n  });\n}\n\nfunction encode(img, w, h, format, quality){\n  return new Promise(function(res, rej){\n    var c = document.createElement(\"canvas\");\n    c.width = w; c.height = h;\n    var ctx = c.getContext(\"2d\");\n    if (format === \"jpeg\"){ ctx.fillStyle = \"#fff\"; ctx.fillRect(0, 0, w, h); }  /* flatten alpha */\n    ctx.drawImage(img, 0, 0, w, h);\n    c.toBlob(function(b){\n      if (b) res(b); else rej(new Error(\"Encoding failed — the image may be too large.\"));\n    }, \"image/\" + format, quality);\n  });\n}\n\nfunction convertOne(file){\n  var q = (+el(\"q\").value) / 100;\n  return decode(file).then(function(d){\n    var natW = d.img.naturalWidth, natH = d.img.naturalHeight;\n    var sz = fitSize(natW, natH, maxSide);\n    return encode(d.img, sz.w, sz.h, fmt, q).then(function(blob){\n      URL.revokeObjectURL(d.url);\n      return {\n        name: file.name, outName: outName(file.name, fmt),\n        blob: blob, url: URL.createObjectURL(blob),\n        w: sz.w, h: sz.h, inBytes: file.size, outBytes: blob.size,\n        srcFmt: srcLabel(file.name, file.type), saved: false, error: null\n      };\n    });\n  }).catch(function(e){\n    return { name: file.name, error: e.message || \"Conversion failed.\", inBytes: file.size,\n             srcFmt: srcLabel(file.name, file.type) };\n  });\n}\n\nfunction convertAll(){\n  if (!files.length) return;\n  haptic(\"medium\");\n  el(\"go\").disabled = true;\n  el(\"outWrap\").style.display = \"block\";\n  el(\"out\").innerHTML = '<p class=\"status\">Converting…</p>';\n  results = [];\n  var chain = Promise.resolve();\n  files.forEach(function(f, i){\n    chain = chain.then(function(){\n      el(\"out\").innerHTML = '<p class=\"status\">Converting ' + (i+1) + ' of ' + files.length + '…</p>';\n      return convertOne(f).then(function(r){ results.push(r); });\n    });\n  });\n  chain.then(function(){\n    renderResults();\n    el(\"go\").disabled = false;\n    var ok = results.filter(function(r){ return !r.error; }).length;\n    haptic(ok ? \"success\" : \"error\");\n  });\n}\n\n/* ---------- results ---------- */\n\nfunction renderResults(){\n  var ok = results.filter(function(r){ return !r.error; }).length;\n  el(\"outTitle\").textContent = \"Converted (\" + ok + \"/\" + results.length + \")\";\n  var h = \"\";\n  for (var i = 0; i < results.length; i++){\n    var r = results[i];\n    if (r.error){\n      h += '<div class=\"item\"><div class=\"thumb\"></div><div class=\"info\">' +\n        '<div class=\"nm\">' + esc(r.name) + '</div>' +\n        '<div class=\"err\">' + esc(r.error) + '</div></div></div>';\n      continue;\n    }\n    h += '<div class=\"item\">' +\n      '<img class=\"thumb\" src=\"' + r.url + '\" alt=\"\">' +\n      '<div class=\"info\">' +\n        '<div class=\"nm\">' + esc(r.outName) + '</div>' +\n        '<div class=\"dt\">' + esc(r.srcFmt) + ' → ' + (fmt === \"png\" ? \"PNG\" : \"JPG\") +\n          ' · ' + r.w + '×' + r.h + ' · ' + fmtBytes(r.outBytes) + deltaHtml(r.inBytes, r.outBytes) + '</div>' +\n      '</div>' +\n      '<button class=\"save' + (r.saved ? ' done' : '') + '\" onclick=\"saveOne(' + i + ')\">' +\n        (r.saved ? \"✓ Saved\" : \"Save\") + '</button>' +\n    '</div>';\n  }\n  if (ok > 1)\n    h += '<div style=\"padding-top:11px\"><button class=\"go\" style=\"margin:0\" onclick=\"saveAll()\">Save all to Photos</button></div>';\n  el(\"out\").innerHTML = h;\n}\n\nfunction blobToDataUrl(blob){\n  return new Promise(function(res, rej){\n    var fr = new FileReader();\n    fr.onload = function(){ res(fr.result); };\n    fr.onerror = function(){ rej(new Error(\"read failed\")); };\n    fr.readAsDataURL(blob);\n  });\n}\n\nfunction saveOne(i){\n  var r = results[i];\n  if (!r || r.error || r.saved) return;\n  if (!SAVE){ toast(\"Saving needs the MyLLM app\"); return; }\n  if (r.outBytes > 10485760){ toast(\"Over the 10 MB save limit — lower quality or size\"); return; }\n  haptic(\"light\");\n  blobToDataUrl(r.blob).then(function(du){\n    return SAVE(du);\n  }).then(function(){\n    r.saved = true; renderResults(); toast(\"Saved \" + r.outName);\n  }).catch(function(e){\n    toast(String(e && e.message || e || \"Couldn't save\"));\n  });\n}\n\nfunction saveAll(){\n  var chain = Promise.resolve();\n  results.forEach(function(r, i){\n    if (!r.error && !r.saved) chain = chain.then(function(){ return saveOnePromise(i); });\n  });\n  chain.then(function(){ haptic(\"success\"); });\n}\n\nfunction saveOnePromise(i){\n  var r = results[i];\n  if (!SAVE || r.outBytes > 10485760) return Promise.resolve();\n  return blobToDataUrl(r.blob).then(function(du){ return SAVE(du); })\n    .then(function(){ r.saved = true; renderResults(); })\n    .catch(function(){});\n}\n\nif (!SAVE)\n  el(\"outWrap\").insertAdjacentHTML(\"beforebegin\",\n    '<p class=\"note\">Heads-up: outside MyLLM there\\'s no Photos bridge, so converted images can\\'t be saved from this preview.</p>');\n</script>\n</body>\n</html>\n"}