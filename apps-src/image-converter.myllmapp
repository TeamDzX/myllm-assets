{"name": "Image Converter", "kind": "html", "iconSymbol": "arrow.triangle.2.circlepath", "iconColor": "teal", "html": "<!doctype html>\n<!--\n  Image Converter — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Image Converter</title>\n<style>\n  :root{ color-scheme:light dark;\n    --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n    --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n    --fill:rgba(120,120,128,.12); --h:180; }\n  @media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n    --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:760px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.96); }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 42%), hsl(calc(var(--h) + 40) 58% 26%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:18px 2px 10px; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n\n  .drop{ display:block; border:2px dashed color-mix(in srgb, hsl(var(--h) 55% 45%) 45%, var(--line)); border-radius:20px;\n    padding:24px 16px; text-align:center; background:var(--surface); margin-bottom:12px; cursor:pointer; transition:border-color .2s, background .2s; }\n  .drop.has{ border-style:solid; border-color:hsl(var(--h) 55% 45%); background:color-mix(in srgb, hsl(var(--h) 60% 50%) 8%, var(--surface)); }\n  .drop .tile{ width:52px; height:52px; border-radius:16px; font-size:24px; margin:0 auto; }\n  .drop p{ font-size:16px; font-weight:750; margin-top:10px; }\n  .drop .pick{ display:inline-flex; align-items:center; gap:6px; margin-top:10px; min-height:40px; padding:0 16px; border-radius:99px;\n    background:var(--acc); color:#fff; font-size:14px; font-weight:700; }\n  .drop small{ display:block; font-size:12.5px; color:var(--muted); margin-top:10px; line-height:1.5; }\n  .drop input{ display:none; }\n\n  .optrow{ display:flex; align-items:center; justify-content:space-between; gap:10px; padding:10px 0; border-bottom:1px solid var(--line); min-height:56px; }\n  .optrow:first-child{ padding-top:0; } .optrow:last-child{ border-bottom:none; padding-bottom:0; }\n  .optrow label{ font-size:15px; font-weight:650; }\n  .seg{ display:flex; background:var(--fill); border-radius:11px; padding:3px; flex-shrink:0; }\n  .seg button{ border:none; background:none; border-radius:9px; min-height:34px; padding:0 12px; font-size:13.5px; font-weight:650; }\n  .seg button.hot{ background:var(--surface); box-shadow:0 1px 4px rgba(0,0,0,.14); }\n  input[type=range]{ -webkit-appearance:none; appearance:none; width:130px; height:28px; background:transparent; accent-color:hsl(var(--h) 55% 42%); }\n  input[type=range]::-webkit-slider-runnable-track{ height:5px; border-radius:99px; background:rgba(120,120,128,.28); }\n  input[type=range]::-webkit-slider-thumb{ -webkit-appearance:none; width:24px; height:24px; margin-top:-9.5px; border-radius:50%; background:#fff;\n    border:2px solid hsl(var(--h) 55% 42%); box-shadow:0 2px 6px rgba(0,0,0,.25); }\n  .qv{ font-size:13px; color:var(--muted); min-width:38px; text-align:right; font-variant-numeric:tabular-nums; }\n\n  .go{ width:100%; min-height:50px; border:none; border-radius:14px; margin-bottom:12px; font-size:16px; font-weight:700;\n    background:var(--acc); color:#fff; display:flex; align-items:center; justify-content:center; gap:8px; }\n  .go:disabled{ opacity:.45; }\n\n  .item{ display:flex; gap:11px; align-items:center; padding:10px 0; border-bottom:1px solid var(--line); }\n  .item:first-child{ padding-top:0; } .item:last-child{ border-bottom:none; padding-bottom:0; }\n  .thumb{ width:54px; height:54px; border-radius:12px; object-fit:cover; background:var(--fill); flex-shrink:0; display:flex; align-items:center; justify-content:center; color:#e5342f; }\n  .item .info{ flex:1; min-width:0; }\n  .item .nm{ font-size:14px; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .item .dt{ font-size:12px; color:var(--muted); margin-top:2px; line-height:1.45; }\n  .item .dt b.less{ color:#1f9d55; } .item .dt b.more{ color:#e08600; }\n  .item .err{ font-size:12px; color:#e5342f; margin-top:2px; line-height:1.45; }\n  .save{ min-height:40px; border:1px solid var(--line); background:var(--bg); border-radius:11px; padding:0 13px; font-size:13.5px; font-weight:700;\n    flex-shrink:0; display:inline-flex; align-items:center; gap:5px; }\n  .save svg{ width:16px; height:16px; }\n  .save.done{ color:#1f9d55; border-color:#1f9d55; }\n\n  .prog{ padding:4px 2px; }\n  .prog .t{ display:flex; align-items:center; gap:8px; font-size:14px; font-weight:650; }\n  .prog .bar{ height:6px; border-radius:99px; background:var(--fill); margin-top:10px; overflow:hidden; }\n  .prog .bar i{ display:block; height:100%; border-radius:99px; background:hsl(var(--h) 55% 45%); transition:width .3s ease; }\n  .spin{ width:16px; height:16px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n  .note{ font-size:12.5px; color:var(--muted); margin:8px 2px; line-height:1.5; }\n  .toast{ position:fixed; left:50%; bottom:calc(24px + env(safe-area-inset-bottom)); transform:translateX(-50%) translateY(90px);\n    background:var(--ink); color:var(--bg); font-size:13.5px; font-weight:650; padding:11px 18px; border-radius:99px; transition:transform .25s; z-index:9; white-space:nowrap; max-width:92vw; overflow:hidden; text-overflow:ellipsis; }\n  .toast.show{ transform:translateX(-50%) translateY(0); }\n  @media (max-width:360px){ .seg button{ padding:0 9px; font-size:12.5px; } input[type=range]{ width:100px; } }\n  @media (prefers-reduced-motion:reduce){ .spin{ animation-duration:2.4s; } button:active{ transform:none; } }\n</style>\n<style>:root{--build-id:\"d3d46c3ef6\";}</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-cycle\" viewBox=\"0 0 24 24\"><path d=\"M12 4a8 8 0 0 1 7.4 5H17a1 1 0 0 0 0 2h4.5a1 1 0 0 0 1-1V5.5a1 1 0 0 0-2 0v1.6A10 10 0 0 0 2.2 10.8a1 1 0 1 0 2 .4A8 8 0 0 1 12 4zm9 8.8a1 1 0 0 0-1.2.8A8 8 0 0 1 4.6 15H7a1 1 0 0 0 0-2H2.5a1 1 0 0 0-1 1v4.5a1 1 0 0 0 2 0v-1.6a10 10 0 0 0 18.3-3.7 1 1 0 0 0-.8-1.4z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-photo\" viewBox=\"0 0 24 24\"><path d=\"M5.5 4h13A2.5 2.5 0 0 1 21 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5v-11A2.5 2.5 0 0 1 5.5 4zm0 2a.5.5 0 0 0-.5.5v8.3l3.3-3.3a1.5 1.5 0 0 1 2.1 0l2.3 2.3 1.3-1.3a1.5 1.5 0 0 1 2.1 0L19 15.3V6.5a.5.5 0 0 0-.5-.5zM15 7.5a1.75 1.75 0 1 1 0 3.5 1.75 1.75 0 0 1 0-3.5z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-plus\" viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 3.5a1 1 0 0 1 1 1v9.1l3.3-3.3a1 1 0 1 1 1.4 1.4l-5 5a1 1 0 0 1-1.4 0l-5-5a1 1 0 1 1 1.4-1.4l3.3 3.3V4.5a1 1 0 0 1 1-1zM4.5 19a1 1 0 0 1 1-1h13a1 1 0 0 1 0 2h-13a1 1 0 0 1-1-1z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M5 12.6l4.6 4.6L19.2 7.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-warn\" viewBox=\"0 0 24 24\"><path d=\"M10.3 3.9a2 2 0 0 1 3.4 0l8 13.6a2 2 0 0 1-1.7 3H4a2 2 0 0 1-1.7-3zM12 9a1 1 0 0 0-1 1v4a1 1 0 0 0 2 0v-4a1 1 0 0 0-1-1zm0 7.2a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z\" fill=\"currentColor\"/></symbol>\n</defs></svg>\n\n<div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-cycle\"/></svg></div>\n  <div class=\"ht\"><h1>Image Converter</h1><p>HEIC to JPG, and friends</p></div>\n</div>\n\n<label class=\"drop\" id=\"drop\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-photo\"/></svg></div>\n  <p id=\"dropTitle\">Choose images to convert</p>\n  <span class=\"pick\" id=\"pickLbl\"><svg class=\"i\"><use href=\"#i-plus\"/></svg>Pick images</span>\n  <small>HEIC, TIFF, WebP, GIF, BMP, PNG or JPG in — JPG or PNG out.<br>\n  Pick from Photos or browse the Files app. Converting also strips location &amp; EXIF metadata.</small>\n  <input id=\"file\" type=\"file\" accept=\"image/*,.heic,.heif,.tif,.tiff,.webp,.bmp\" multiple>\n</label>\n\n<div class=\"card\" id=\"opts\">\n  <div class=\"optrow\">\n    <label>Convert to</label>\n    <div class=\"seg\" id=\"fmtSeg\">\n      <button class=\"hot\" data-f=\"jpeg\" onclick=\"setFmt('jpeg')\">JPG</button>\n      <button data-f=\"png\" onclick=\"setFmt('png')\">PNG</button>\n    </div>\n  </div>\n  <div class=\"optrow\" id=\"qRow\">\n    <label>Quality</label>\n    <div style=\"display:flex;align-items:center;gap:8px\">\n      <input type=\"range\" id=\"q\" min=\"30\" max=\"100\" value=\"85\" oninput=\"qLabel()\">\n      <span class=\"qv\" id=\"qv\">85%</span>\n    </div>\n  </div>\n  <div class=\"optrow\">\n    <label>Max size</label>\n    <div class=\"seg\" id=\"szSeg\">\n      <button class=\"hot\" data-s=\"0\" onclick=\"setSize(0)\">Original</button>\n      <button data-s=\"2048\" onclick=\"setSize(2048)\">2048px</button>\n      <button data-s=\"1024\" onclick=\"setSize(1024)\">1024px</button>\n    </div>\n  </div>\n</div>\n\n<button class=\"go\" id=\"go\" onclick=\"convertAll()\" disabled><svg class=\"i\"><use href=\"#i-cycle\"/></svg><span>Convert</span></button>\n\n<div id=\"outWrap\" style=\"display:none\">\n  <h2 id=\"outTitle\">Converted</h2>\n  <div class=\"card\" id=\"out\"></div>\n  <p class=\"note\">Saved images land in Photos (and the MyLLMos photos folder). Re-encoding always removes EXIF data — including GPS location — which is handy before sharing.</p>\n</div>\n\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\n/* The Photos bridge is looked up when used, never kept: MyLLM can add it after\n   this script has run. */\nfunction SAVE(du){ return window.myllmSaveImage(du); }\nfunction canSave(){ return !!window.myllmSaveImage; }\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s==null?'':s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\"); }\nfunction icon(n){ return '<svg class=\"i\"><use href=\"#i-'+n+'\"/></svg>'; }\nfunction toast(m){\n  var t = el(\"toast\"); t.textContent = m; t.classList.add(\"show\");\n  clearTimeout(t._t); t._t = setTimeout(function(){ t.classList.remove(\"show\"); }, 2000);\n}\n\nvar fmt = \"jpeg\";        /* 'jpeg' | 'png' */\nvar maxSide = 0;         /* 0 = keep original */\nvar files = [];          /* picked File objects */\nvar results = [];        /* {name,outName,blob,url,w,h,inBytes,outBytes,saved,error} */\n\n/* ---------- pure helpers (node-tested) ---------- */\n\nfunction fmtBytes(n){\n  if (n == null) return \"\";\n  if (n < 1024) return n + \" B\";\n  if (n < 1048576) return (n/1024).toFixed(n < 10240 ? 1 : 0) + \" KB\";\n  return (n/1048576).toFixed(1) + \" MB\";\n}\n\nfunction outName(name, format){\n  var base = String(name || \"image\").replace(/\\.[a-z0-9]+$/i, \"\");\n  return base + (format === \"png\" ? \".png\" : \".jpg\");\n}\n\nfunction fitSize(w, h, max){\n  if (!max || (w <= max && h <= max)) return {w:w, h:h};\n  var k = max / Math.max(w, h);\n  return {w: Math.max(1, Math.round(w*k)), h: Math.max(1, Math.round(h*k))};\n}\n\nfunction srcLabel(name, type){\n  var m = String(name||\"\").match(/\\.([a-z0-9]+)$/i);\n  var ext = m ? m[1].toUpperCase() : \"\";\n  if (ext === \"JPEG\") ext = \"JPG\";\n  if (ext) return ext;\n  var t = String(type||\"\").split(\"/\")[1] || \"\";\n  return t ? t.toUpperCase() : \"image\";\n}\n\nfunction deltaHtml(inB, outB){\n  if (!inB || !outB) return \"\";\n  var pct = Math.round((outB - inB) / inB * 100);\n  if (pct === 0) return \"\";\n  return pct < 0 ? ' · <b class=\"less\">' + (-pct) + '% smaller</b>'\n                 : ' · <b class=\"more\">' + pct + '% larger</b>';\n}\n\n/* ---------- UI state ---------- */\n\nfunction setFmt(f){\n  fmt = f; haptic(\"selection\");\n  var bs = el(\"fmtSeg\").getElementsByTagName(\"button\");\n  for (var i=0;i<bs.length;i++) bs[i].className = bs[i].getAttribute(\"data-f\") === f ? \"hot\" : \"\";\n  el(\"qRow\").style.display = f === \"jpeg\" ? \"flex\" : \"none\";\n}\n\nfunction setSize(s){\n  maxSide = s; haptic(\"selection\");\n  var bs = el(\"szSeg\").getElementsByTagName(\"button\");\n  for (var i=0;i<bs.length;i++) bs[i].className = +bs[i].getAttribute(\"data-s\") === s ? \"hot\" : \"\";\n}\n\nfunction qLabel(){ el(\"qv\").textContent = el(\"q\").value + \"%\"; }\n\nel(\"file\").addEventListener(\"change\", function(){\n  files = [];\n  for (var i = 0; i < this.files.length; i++) files.push(this.files[i]);\n  el(\"dropTitle\").textContent = files.length\n    ? files.length + (files.length === 1 ? \" image selected\" : \" images selected\")\n    : \"Choose images to convert\";\n  el(\"pickLbl\").innerHTML = icon(files.length ? \"cycle\" : \"plus\") + (files.length ? \"Choose again\" : \"Pick images\");\n  el(\"drop\").classList.toggle(\"has\", !!files.length);\n  el(\"go\").disabled = !files.length;\n  if (files.length) haptic(\"light\");\n});\n\n/* ---------- conversion ---------- */\n\nfunction decode(file){\n  return new Promise(function(res, rej){\n    var url = URL.createObjectURL(file);\n    var img = new Image();\n    img.onload = function(){ res({img:img, url:url}); };\n    img.onerror = function(){\n      URL.revokeObjectURL(url);\n      rej(new Error(\"Couldn't decode this image — the format may need a newer iOS.\"));\n    };\n    img.src = url;\n  });\n}\n\nfunction encode(img, w, h, format, quality){\n  return new Promise(function(res, rej){\n    var c = document.createElement(\"canvas\");\n    c.width = w; c.height = h;\n    var ctx = c.getContext(\"2d\");\n    if (format === \"jpeg\"){ ctx.fillStyle = \"#fff\"; ctx.fillRect(0, 0, w, h); }  /* flatten alpha */\n    ctx.drawImage(img, 0, 0, w, h);\n    c.toBlob(function(b){\n      if (b) res(b); else rej(new Error(\"Encoding failed — the image may be too large.\"));\n    }, \"image/\" + format, quality);\n  });\n}\n\nfunction convertOne(file){\n  var q = (+el(\"q\").value) / 100;\n  return decode(file).then(function(d){\n    var natW = d.img.naturalWidth, natH = d.img.naturalHeight;\n    var sz = fitSize(natW, natH, maxSide);\n    return encode(d.img, sz.w, sz.h, fmt, q).then(function(blob){\n      URL.revokeObjectURL(d.url);\n      return {\n        name: file.name, outName: outName(file.name, fmt),\n        blob: blob, url: URL.createObjectURL(blob),\n        w: sz.w, h: sz.h, inBytes: file.size, outBytes: blob.size,\n        srcFmt: srcLabel(file.name, file.type), saved: false, error: null\n      };\n    });\n  }).catch(function(e){\n    return { name: file.name, error: e.message || \"Conversion failed.\", inBytes: file.size,\n             srcFmt: srcLabel(file.name, file.type) };\n  });\n}\n\nfunction progress(i, n){\n  el(\"out\").innerHTML = '<div class=\"prog\"><div class=\"t\"><i class=\"spin\"></i>Converting ' + i + ' of ' + n + '…</div>' +\n    '<div class=\"bar\"><i style=\"width:' + Math.round((i - 1) / n * 100) + '%\"></i></div></div>';\n}\n\nfunction convertAll(){\n  if (!files.length) return;\n  haptic(\"medium\");\n  el(\"go\").disabled = true;\n  el(\"outWrap\").style.display = \"block\";\n  el(\"outTitle\").textContent = \"Converting\";\n  progress(1, files.length);\n  results = [];\n  var chain = Promise.resolve();\n  files.forEach(function(f, i){\n    chain = chain.then(function(){\n      progress(i + 1, files.length);\n      return convertOne(f).then(function(r){ results.push(r); });\n    });\n  });\n  chain.then(function(){\n    renderResults();\n    el(\"go\").disabled = false;\n    var ok = results.filter(function(r){ return !r.error; }).length;\n    haptic(ok ? \"success\" : \"error\");\n  });\n}\n\n/* ---------- results ---------- */\n\nfunction renderResults(){\n  var ok = results.filter(function(r){ return !r.error; }).length;\n  el(\"outTitle\").textContent = \"Converted (\" + ok + \"/\" + results.length + \")\";\n  var h = \"\";\n  for (var i = 0; i < results.length; i++){\n    var r = results[i];\n    if (r.error){\n      h += '<div class=\"item\"><div class=\"thumb\">' + icon(\"warn\") + '</div><div class=\"info\">' +\n        '<div class=\"nm\">' + esc(r.name) + '</div>' +\n        '<div class=\"err\">' + esc(r.error) + '</div></div></div>';\n      continue;\n    }\n    h += '<div class=\"item\">' +\n      '<img class=\"thumb\" src=\"' + r.url + '\" alt=\"\">' +\n      '<div class=\"info\">' +\n        '<div class=\"nm\">' + esc(r.outName) + '</div>' +\n        '<div class=\"dt\">' + esc(r.srcFmt) + ' → ' + (fmt === \"png\" ? \"PNG\" : \"JPG\") +\n          ' · ' + r.w + '×' + r.h + ' · ' + fmtBytes(r.outBytes) + deltaHtml(r.inBytes, r.outBytes) + '</div>' +\n      '</div>' +\n      '<button class=\"save' + (r.saved ? ' done' : '') + '\" onclick=\"saveOne(' + i + ')\">' +\n        (r.saved ? '<svg><use href=\"#i-check\"/></svg>Saved' : '<svg><use href=\"#i-down\"/></svg>Save') + '</button>' +\n    '</div>';\n  }\n  if (ok > 1)\n    h += '<div style=\"padding-top:12px\"><button class=\"go\" style=\"margin:0\" onclick=\"saveAll()\">' + icon(\"down\") + '<span>Save all to Photos</span></button></div>';\n  el(\"out\").innerHTML = h;\n}\n\nfunction blobToDataUrl(blob){\n  return new Promise(function(res, rej){\n    var fr = new FileReader();\n    fr.onload = function(){ res(fr.result); };\n    fr.onerror = function(){ rej(new Error(\"read failed\")); };\n    fr.readAsDataURL(blob);\n  });\n}\n\nfunction saveOne(i){\n  var r = results[i];\n  if (!r || r.error || r.saved) return;\n  if (!canSave()){ toast(\"Saving needs the MyLLM app\"); return; }\n  if (r.outBytes > 10485760){ toast(\"Over the 10 MB save limit — lower quality or size\"); return; }\n  haptic(\"light\");\n  blobToDataUrl(r.blob).then(function(du){\n    return SAVE(du);\n  }).then(function(){\n    r.saved = true; renderResults(); toast(\"Saved \" + r.outName);\n  }).catch(function(e){\n    toast(String(e && e.message || e || \"Couldn't save\"));\n  });\n}\n\nfunction saveAll(){\n  var chain = Promise.resolve();\n  results.forEach(function(r, i){\n    if (!r.error && !r.saved) chain = chain.then(function(){ return saveOnePromise(i); });\n  });\n  chain.then(function(){ haptic(\"success\"); });\n}\n\nfunction saveOnePromise(i){\n  var r = results[i];\n  if (!canSave() || r.outBytes > 10485760) return Promise.resolve();\n  return blobToDataUrl(r.blob).then(function(du){ return SAVE(du); })\n    .then(function(){ r.saved = true; renderResults(); })\n    .catch(function(){});\n}\n\n/* checked a moment after load, so a bridge that arrives late isn't reported missing */\nsetTimeout(function(){\n  if (!canSave())\n    el(\"outWrap\").insertAdjacentHTML(\"beforebegin\",\n      '<p class=\"note\">Heads-up: outside MyLLM there\\'s no Photos bridge, so converted images can\\'t be saved from this preview.</p>');\n}, 700);\n</script>\n</body>\n</html>\n"}