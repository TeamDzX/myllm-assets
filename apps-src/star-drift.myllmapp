{"name": "Star Drift", "kind": "html", "iconSymbol": "car.fill", "iconColor": "cyan", "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Star Drift</title>\n<style>\n:root{color-scheme:dark;--bg:#07090f;--ink:#e8ecf5;--mut:#7d879c;--cy:#39e6ff;--mg:#ff4fa3;--gold:#ffd23f;--danger:#ff5d5d}\n*{box-sizing:border-box;margin:0}\nhtml,body{height:100%}\nbody{font-family:-apple-system,system-ui,sans-serif;background:var(--bg);color:var(--ink);\n  position:fixed;inset:0;width:100%;height:100dvh;overflow:hidden;-webkit-tap-highlight-color:transparent;touch-action:none;user-select:none;-webkit-user-select:none}\ncanvas{position:absolute;inset:0;width:100%;height:100%}\n/* HUD */\n.hud{position:absolute;inset:0;pointer-events:none;z-index:5}\n.tl{position:absolute;top:calc(10px + env(safe-area-inset-top));left:14px}\n.tr{position:absolute;top:calc(10px + env(safe-area-inset-top));right:14px;text-align:right}\n.slabel{font-size:10px;letter-spacing:.16em;color:var(--mut);font-weight:800}\n.score{font-size:26px;font-weight:900;font-variant-numeric:tabular-nums}\n.time{font-size:26px;font-weight:900;font-variant-numeric:tabular-nums;color:var(--gold)}\n.time.low{color:var(--danger);animation:blink .5s steps(2) infinite}\n@keyframes blink{50%{opacity:.4}}\n.speedo{position:absolute;bottom:calc(18px + env(safe-area-inset-bottom));left:16px}\n.speedv{font-size:34px;font-weight:900;font-variant-numeric:tabular-nums;line-height:1}\n.speedu{font-size:10px;letter-spacing:.14em;color:var(--mut);font-weight:800}\n.nitroB{position:absolute;bottom:calc(16px + env(safe-area-inset-bottom));right:16px;width:74px;height:74px;border-radius:50%;\n  border:2px solid var(--cy);background:rgba(20,30,44,.55);color:var(--cy);font-weight:900;font-size:13px;letter-spacing:.06em;\n  pointer-events:auto;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:2px}\n.nitroB .bar{width:42px;height:5px;border-radius:3px;background:#1c2836;overflow:hidden}\n.nitroB .bar b{display:block;height:100%;background:var(--cy);width:0%}\n.nitroB.on{background:rgba(57,230,255,.25);box-shadow:0 0 24px rgba(57,230,255,.5)}\n.nitroB.empty{opacity:.45;border-color:#31404f;color:#31404f}\n.banner{position:absolute;top:26%;left:0;right:0;text-align:center;font-size:24px;font-weight:900;letter-spacing:.1em;\n  color:var(--gold);text-shadow:0 0 22px rgba(255,210,63,.6);opacity:0;transition:opacity .25s;pointer-events:none}\n.banner.on{opacity:1}\n.mute{position:absolute;top:calc(8px + env(safe-area-inset-top));left:50%;transform:translateX(-50%);\n  border:0;background:none;font-size:17px;opacity:.5;pointer-events:auto;padding:6px}\n/* overlays */\n.overlay{position:fixed;inset:0;z-index:10;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;\n  background:radial-gradient(120% 90% at 50% 18%,rgba(18,26,48,.72),rgba(5,7,12,.95));padding:26px}\n.overlay.hide{display:none}\n.title{font-size:46px;font-weight:900;letter-spacing:.05em;line-height:1;\n  background:linear-gradient(180deg,var(--cy),var(--mg));-webkit-background-clip:text;background-clip:text;color:transparent;\n  filter:drop-shadow(0 0 26px rgba(57,230,255,.35))}\n.subtitle{font-size:14.5px;color:var(--mut);line-height:1.6;margin:16px 0 22px;max-width:300px}\n.subtitle b{color:var(--ink)}\n.big{border:0;border-radius:15px;background:linear-gradient(135deg,var(--cy),#2f7bff);color:#04121c;font-weight:900;\n  font-size:16px;letter-spacing:.04em;padding:15px 34px;margin-top:10px;min-width:230px}\n.big.alt{background:none;border:1.5px solid #2b3a54;color:var(--mut);font-weight:700}\n.best{margin-top:16px;font-size:13px;color:var(--gold);font-weight:700}\n.tiny{position:absolute;bottom:calc(14px + env(safe-area-inset-bottom));left:0;right:0;font-size:11px;color:#3d4658;text-align:center}\n.gbnote{margin-top:10px;font-size:11px;color:#51617e;letter-spacing:.08em;font-weight:700}\n</style></head><body>\n<canvas id=\"v\"></canvas>\n<div class=\"hud\" id=\"hud\" style=\"display:none\">\n  <div class=\"tl\"><div class=\"slabel\">SCORE</div><div class=\"score\" id=\"score\">0</div></div>\n  <div class=\"tr\"><div class=\"slabel\">TIME</div><div class=\"time\" id=\"time\">60</div></div>\n  <div class=\"speedo\"><div class=\"speedv\" id=\"speed\">0</div><div class=\"speedu\">KM/H</div></div>\n  <button class=\"nitroB\" id=\"nitroB\"><span>NITRO</span><span class=\"bar\"><b id=\"nitrofill\"></b></span></button>\n  <div class=\"banner\" id=\"banner\"></div>\n  <button class=\"mute\" id=\"mute\" aria-label=\"Sound\">🔊</button>\n</div>\n\n<div class=\"overlay\" id=\"start\">\n  <div class=\"title\">STAR<br>DRIFT</div>\n  <div class=\"subtitle\"><b>Slide your thumb</b> to steer. Outrun the clock, thread the traffic — every gate buys you time, every near-miss feeds the nitro.</div>\n  <button class=\"big\" id=\"startBtn\">Hit the road</button>\n  <div class=\"best\" id=\"startBest\"></div>\n  <div class=\"gbnote\">GREY-BOX PROTOTYPE · art pass comes later</div>\n  <div class=\"tiny\">A MyLLMos mini-game · everything runs on your device</div>\n</div>\n\n<div class=\"overlay hide\" id=\"over\">\n  <div class=\"title\" style=\"font-size:34px\">OUT OF<br>TIME</div>\n  <div class=\"subtitle\" id=\"overStats\"></div>\n  <button class=\"big\" id=\"againBtn\">Run it back</button>\n  <div class=\"best\" id=\"overBest\"></div>\n</div>\n\n<script>\n\"use strict\";\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nfunction el(i){return document.getElementById(i)}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k||'light')}catch(e){}}\n\n/* ================== FEEL — every handling number lives here ================== */\nvar FEEL={\n  maxSpeed:230,          // km/h cap without nitro\n  nitroSpeed:300,        // km/h cap while boosting\n  accel:52,              // km/h gained per second\n  brakeOff:120,          // km/h lost per second off-road\n  steerRate:5.0,         // how fast playerX chases the thumb (per second)\n  steerRange:2.6,        // full thumb travel = this many half-road-widths\n  centrifugal:.34,       // how hard curves throw you outward at speed\n  crashSpeed:.22,        // fraction of speed kept after a crash\n  crashTime:2.5,         // seconds torn off the clock by a crash\n  crashInvuln:1.6,       // seconds of grace after a crash\n  nitroDrain:.5,         // nitro used per second of boost (0..1 tank)\n  nitroNearMiss:.22,     // nitro gained per near-miss\n  nitroCrashLoss:.5,     // nitro lost in a crash\n  startTime:55,          // seconds on the clock at launch\n  gateEvery:170,         // segments to the first time gate\n  gateRamp:12,           // extra segments added per gate — the difficulty curve\n  gateBonus:20,          // seconds per gate\n  trafficDensity:.5,     // cars per 100 segments (scales up over distance)\n  trafficSpeed:.52       // traffic speed as a fraction of maxSpeed\n};\n/* road geometry */\nvar SEG_LEN=210, ROAD_W=1050, CAM_H=950, CAM_D=.84, DRAW=64, LANES=3;\n\n/* ================== state ================== */\nvar G=null,best=0,muted=false;\nfunction newGame(){\n  return {\n    z:0, seg:0, playerX:0, steerTarget:0, speed:0,\n    time:FEEL.startTime, score:0, dist:0,\n    nitro:.5, boosting:false, invuln:0, shake:0,\n    nextGate:FEEL.gateEvery, gatesHit:0, nearMisses:0, crashes:0, steering:false,\n    cars:[], seed:1337, over:false, running:false\n  };\n}\n/* deterministic track: layered sines make endless flowing curves + hills */\nfunction curveAt(i){return Math.sin(i*.011)*2.2+Math.sin(i*.0043+1.7)*1.6}\nfunction hillAt(i){return Math.sin(i*.008)*900+Math.sin(i*.0027+.8)*1400}\nfunction rnd(g){g.seed=(g.seed*1664525+1013904223)>>>0;return g.seed/4294967296}\n\n/* ================== update (pure — the harness drives this directly) ================== */\nfunction spawnTraffic(g){\n  var ahead=g.seg+DRAW+30;\n  var want=12+Math.min(8,Math.floor(g.seg/450));   // roads get busier the deeper you run\n  while(g.cars.length<want){\n    var far=ahead+Math.floor(rnd(g)*220)+20;\n    var lane=Math.floor(rnd(g)*LANES);\n    var lx=(lane-(LANES-1)/2)*.62;\n    /* fairness: never let a cluster wall off all lanes — if the two other\n       lanes are already taken within ±14 segs, push this car further out */\n    var lanesNear={};lanesNear[lane]=true;\n    for(var i=0;i<g.cars.length;i++){\n      var o=g.cars[i];\n      if(Math.abs(o.seg-far)<14)lanesNear[Math.round(o.x/.62+(LANES-1)/2)]=true;\n    }\n    if(Object.keys(lanesNear).length>=LANES)far+=34;\n    g.cars.push({seg:far,x:lx,speed:FEEL.trafficSpeed*(0.82+rnd(g)*.36),passed:false});\n  }\n}\nfunction update(g,dt){\n  if(!g.running||g.over)return;\n  /* throttle */\n  var cap=(g.boosting&&g.nitro>0)?FEEL.nitroSpeed:FEEL.maxSpeed;\n  g.speed=Math.min(cap,g.speed+FEEL.accel*dt);\n  if(g.speed>cap)g.speed=Math.max(cap,g.speed-FEEL.accel*2*dt);\n  if(g.boosting&&g.nitro>0){g.nitro=Math.max(0,g.nitro-FEEL.nitroDrain*dt);if(g.nitro<=0)g.boosting=false;}\n  /* steering chases the thumb ONLY while a finger is down (or a key held) —\n     hands off and the curves carry you wide; holding the line is the skill */\n  if(g.steering){\n    var steer=(g.steerTarget-g.playerX);\n    g.playerX+=steer*Math.min(1,FEEL.steerRate*dt);\n  }\n  g.playerX-=curveAt(g.seg)*(g.speed/FEEL.maxSpeed)*FEEL.centrifugal*dt;\n  /* off-road: rumble + heavy drag */\n  if(Math.abs(g.playerX)>1){\n    g.speed=Math.max(40,g.speed-FEEL.brakeOff*dt);\n    g.shake=Math.max(g.shake,.35);\n    g.playerX=Math.max(-1.6,Math.min(1.6,g.playerX));\n  }\n  /* advance */\n  var move=g.speed*dt*(1000/3600)/ (SEG_LEN/38);   // tuned world scale\n  g.z+=move; g.dist+=g.speed*dt/3600;\n  while(g.z>=1){g.z-=1;g.seg++;}\n  g.score+=g.speed*dt*(g.boosting?2:1)*.55;   // float accumulator — floors only at display\n  /* traffic */\n  spawnTraffic(g);\n  for(var i=g.cars.length-1;i>=0;i--){\n    var c=g.cars[i];\n    c.seg+=c.speed*FEEL.maxSpeed*dt*(1000/3600)/(SEG_LEN/38);\n    if(c.seg<g.seg-8){g.cars.splice(i,1);continue;}\n    var dSeg=c.seg-(g.seg+g.z);\n    if(dSeg>-1.2&&dSeg<1.2){\n      var dx=Math.abs(c.x-g.playerX);\n      if(dx<.42&&g.invuln<=0){          // collision\n        g.speed*=FEEL.crashSpeed; g.invuln=FEEL.crashInvuln; g.shake=1;\n        g.time=Math.max(0,g.time-FEEL.crashTime);\n        g.nitro=Math.max(0,g.nitro-FEEL.nitroCrashLoss); g.crashes++; g.boosting=false;\n        blip('crash'); haptic('error');\n      } else if(dx>=.42&&dx<.85&&!c.passed&&dSeg<0){   // near-miss: close but clean\n        c.passed=true; g.nearMisses++; g.score+=180;\n        g.nitro=Math.min(1,g.nitro+FEEL.nitroNearMiss);\n        blip('pass'); haptic('light');\n      }\n    }\n  }\n  if(g.invuln>0)g.invuln-=dt;\n  if(g.shake>0)g.shake=Math.max(0,g.shake-dt*1.6);\n  /* time gates */\n  if(g.seg>=g.nextGate){\n    g.gatesHit++; g.nextGate+=FEEL.gateEvery+g.gatesHit*FEEL.gateRamp;\n    g.time+=FEEL.gateBonus; g.score+=500;\n    banner('⏱ GATE '+g.gatesHit+'  ·  +'+FEEL.gateBonus+'s');\n    blip('gate'); haptic('success');\n  }\n  /* clock */\n  g.time-=dt;\n  if(g.time<=0){g.time=0;g.over=true;g.running=false;endRun(g);}\n}\n\n/* ================== render (grey-box: flat neon vector look) ================== */\nvar cv=el('v'),ctx=cv.getContext('2d'),W=0,H=0,DPR=1;\nfunction resize(){DPR=Math.min(window.devicePixelRatio||1,2);W=cv.width=Math.round(innerWidth*DPR);H=cv.height=Math.round(innerHeight*DPR);}\nwindow.addEventListener('resize',function(){resize()});\nfunction project(worldX,worldY,worldZ,camX,camY){\n  var scale=CAM_D/Math.max(.01,worldZ);\n  return {x:W/2+scale*(worldX-camX)*W/2, y:H*.5-scale*(worldY-camY)*H/2, w:scale*ROAD_W*W/2, s:scale};\n}\nfunction render(g){\n  if(!W)resize();\n  var shx=(Math.random()-.5)*g.shake*22*DPR, shy=(Math.random()-.5)*g.shake*14*DPR;\n  /* sky placeholder: two-band gradient — the ComfyUI panorama slots in here */\n  var sky=ctx.createLinearGradient(0,0,0,H*.55);\n  sky.addColorStop(0,'#0a1026');sky.addColorStop(.7,'#182448');sky.addColorStop(1,'#3a2c55');\n  ctx.fillStyle=sky;ctx.fillRect(0,0,W,H*.55);\n  /* horizon glow strip */\n  ctx.fillStyle='rgba(57,230,255,.14)';ctx.fillRect(0,H*.53,W,H*.02);\n  ctx.fillStyle='#0b0e18';ctx.fillRect(0,H*.55,W,H*.45);\n  ctx.save();ctx.translate(shx,shy);\n  /* road: walk segments back-to-front accumulating curve */\n  var baseSeg=g.seg, camY=CAM_H+hillAt(baseSeg+g.z);\n  var x=0,dx=-curveAt(baseSeg)*g.z, prev=null, sprites=[];\n  var camX=g.playerX*ROAD_W*.9;\n  for(var n=0;n<DRAW;n++){\n    var i=baseSeg+n;\n    var p=project(x*ROAD_W, hillAt(i), (n-g.z)+.6, camX*(n===0?1:1), camY);\n    if(prev&&p.y<prev.y&&prev.y<H){\n      var light=((i>>2)%2===0);\n      /* grass / shoulder */\n      ctx.fillStyle=light?'#0d1220':'#0a0e19';\n      ctx.fillRect(0,p.y,W,prev.y-p.y);\n      /* rumble */\n      ctx.fillStyle=light?'#233754':'#1a2233';\n      quad(prev.x-prev.w*1.12,prev.y,prev.x+prev.w*1.12,p.x-p.w*1.12,p.y,p.x+p.w*1.12);\n      /* asphalt */\n      ctx.fillStyle=light?'#151a28':'#131722';\n      quad(prev.x-prev.w,prev.y,prev.x+prev.w,p.x-p.w,p.y,p.x+p.w);\n      /* neon edge lines */\n      ctx.fillStyle='rgba(57,230,255,'+(light?.5:.28)+')';\n      quad(prev.x-prev.w,prev.y,prev.x-prev.w*.97,p.x-p.w,p.y,p.x-p.w*.97);\n      quad(prev.x+prev.w*.97,prev.y,prev.x+prev.w,p.x+p.w*.97,p.y,p.x+p.w);\n      /* lane dashes */\n      if(light){\n        ctx.fillStyle='rgba(210,225,255,.16)';\n        for(var l=1;l<LANES;l++){\n          var lx=-1+2*l/LANES;\n          quad(prev.x+prev.w*lx-prev.w*.012,prev.y,prev.x+prev.w*lx+prev.w*.012,\n               p.x+p.w*lx-p.w*.012,p.y,p.x+p.w*lx+p.w*.012);\n        }\n      }\n      /* gate posts */\n      if(i===g.nextGate){\n        ctx.fillStyle='rgba(255,210,63,.85)';\n        ctx.fillRect(p.x-p.w*1.15,p.y-p.w*.5,p.w*.06,p.w*.5);\n        ctx.fillRect(p.x+p.w*1.09,p.y-p.w*.5,p.w*.06,p.w*.5);\n        ctx.fillStyle='rgba(255,210,63,.25)';\n        ctx.fillRect(p.x-p.w*1.15,p.y-p.w*.52,p.w*2.3,p.w*.05);\n      }\n      /* roadside posts every 8th segment — placeholder for ComfyUI sprites */\n      if(i%8===0){\n        ctx.fillStyle='rgba(255,79,163,.5)';\n        var pw=Math.max(2,p.w*.02);\n        ctx.fillRect(p.x-p.w*1.35,p.y-p.w*.16,pw,p.w*.16);\n        ctx.fillRect(p.x+p.w*1.35,p.y-p.w*.16,pw,p.w*.16);\n      }\n    }\n    if(prev)sprites.push({i:i,p:p});\n    prev=p;x+=dx;dx+=curveAt(i);\n  }\n  /* traffic: back to front */\n  for(var ci=g.cars.length-1;ci>=0;ci--){\n    var c=g.cars[ci],d=c.seg-(baseSeg+g.z);\n    if(d<0||d>DRAW-2)continue;\n    var x2=0,dx2=-curveAt(baseSeg)*g.z;\n    for(var m=0;m<d;m++){x2+=dx2;dx2+=curveAt(baseSeg+m);}\n    var cp=project((x2+c.x)*ROAD_W? (x2)*ROAD_W + c.x*ROAD_W*.5 : c.x*ROAD_W*.5, hillAt(Math.floor(c.seg)), d+.6, camX, camY);\n    drawCar(cp.x,cp.y,cp.w*.34,'#ff4fa3',false);\n  }\n  /* player car */\n  drawCar(W/2,H*.86,W*.09,'#39e6ff',g.boosting&&g.nitro>0);\n  ctx.restore();\n}\nfunction quad(x1,y1,x2,x3,y3,x4){ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2,y1);ctx.lineTo(x4,y3);ctx.lineTo(x3,y3);ctx.closePath();ctx.fill();}\nfunction drawCar(x,y,hw,color,boost){\n  /* grey-box vehicle: neon wedge — ComfyUI green-key sprite replaces this */\n  ctx.save();ctx.translate(x,y);\n  if(boost){ctx.fillStyle='rgba(57,230,255,.35)';ctx.beginPath();ctx.ellipse(0,hw*.62,hw*.5,hw*1.1,0,0,7);ctx.fill();}\n  ctx.fillStyle='#0d1420';ctx.strokeStyle=color;ctx.lineWidth=Math.max(2,hw*.09);\n  ctx.beginPath();ctx.moveTo(0,-hw*.78);ctx.lineTo(hw,hw*.5);ctx.lineTo(hw*.62,hw*.66);ctx.lineTo(-hw*.62,hw*.66);ctx.lineTo(-hw,hw*.5);ctx.closePath();\n  ctx.fill();ctx.stroke();\n  ctx.fillStyle=color;ctx.globalAlpha=.35;\n  ctx.beginPath();ctx.moveTo(0,-hw*.55);ctx.lineTo(hw*.45,hw*.1);ctx.lineTo(-hw*.45,hw*.1);ctx.closePath();ctx.fill();\n  ctx.globalAlpha=1;ctx.restore();\n}\n\n/* ================== audio (tiny synth; engine pitch follows speed) ================== */\nvar AC=null,eng=null,engGain=null;\nfunction audio(){\n  if(AC||muted)return;\n  try{\n    AC=new (window.AudioContext||window.webkitAudioContext)();\n    eng=AC.createOscillator();eng.type='sawtooth';\n    var f=AC.createBiquadFilter();f.type='lowpass';f.frequency.value=320;\n    engGain=AC.createGain();engGain.gain.value=0;\n    eng.connect(f);f.connect(engGain);engGain.connect(AC.destination);\n    eng.start();\n  }catch(e){AC=null}\n}\nfunction engineTick(g){\n  if(!AC||muted||!engGain)return;\n  engGain.gain.value=g.running?.045:.0;\n  if(eng)eng.frequency.value=42+(g.speed/FEEL.nitroSpeed)*118+(g.boosting?26:0);\n}\nfunction blip(kind){\n  if(!AC||muted)return;\n  try{\n    var o=AC.createOscillator(),gn=AC.createGain();\n    o.connect(gn);gn.connect(AC.destination);\n    var t=AC.currentTime;\n    if(kind==='gate'){o.type='sine';o.frequency.setValueAtTime(660,t);o.frequency.setValueAtTime(990,t+.09);gn.gain.setValueAtTime(.12,t);gn.gain.exponentialRampToValueAtTime(.001,t+.28);}\n    else if(kind==='pass'){o.type='triangle';o.frequency.setValueAtTime(520,t);gn.gain.setValueAtTime(.07,t);gn.gain.exponentialRampToValueAtTime(.001,t+.12);}\n    else {o.type='square';o.frequency.setValueAtTime(110,t);gn.gain.setValueAtTime(.16,t);gn.gain.exponentialRampToValueAtTime(.001,t+.4);}\n    o.start(t);o.stop(t+.45);\n  }catch(e){}\n}\n\n/* ================== input: thumb-slide steering, nitro hold ================== */\n(function(){\n  var steering=null;\n  function nx(e){return (e.clientX/innerWidth)*2-1}\n  cv.addEventListener('pointerdown',function(e){\n    audio();\n    if(!G||!G.running)return;\n    steering={x0:nx(e),p0:G.playerX,id:e.pointerId};\n    G.steerTarget=G.playerX;G.steering=true;\n    cv.setPointerCapture(e.pointerId);\n  });\n  cv.addEventListener('pointermove',function(e){\n    if(!steering||e.pointerId!==steering.id||!G)return;\n    G.steerTarget=Math.max(-1.35,Math.min(1.35,steering.p0+(nx(e)-steering.x0)*FEEL.steerRange));\n  });\n  ['pointerup','pointercancel'].forEach(function(ev){cv.addEventListener(ev,function(e){\n    if(steering&&e.pointerId===steering.id){steering=null;if(G)G.steering=false;}\n  })});\n  /* nitro: hold the button */\n  var nb=el('nitroB');\n  nb.addEventListener('pointerdown',function(e){e.stopPropagation();audio();if(G&&G.running&&G.nitro>0){G.boosting=true;nb.classList.add('on');haptic('medium');}});\n  ['pointerup','pointercancel','pointerleave'].forEach(function(ev){nb.addEventListener(ev,function(){if(G)G.boosting=false;nb.classList.remove('on');})});\n  /* keyboard for desktop feel-testing */\n  var keys={};\n  window.addEventListener('keydown',function(e){keys[e.key]=true;sync();if(e.key===' ')if(G&&G.running&&G.nitro>0)G.boosting=true;});\n  window.addEventListener('keyup',function(e){keys[e.key]=false;sync();if(e.key===' ')if(G)G.boosting=false;});\n  function sync(){if(!G)return;var s=(keys.ArrowLeft?-1:0)+(keys.ArrowRight?1:0);G.steering=s!==0;if(s)G.steerTarget=s*1.0;}\n})();\n\n/* ================== HUD / flow ================== */\nvar bannerT=null;\nfunction banner(t){var b=el('banner');b.textContent=t;b.classList.add('on');clearTimeout(bannerT);bannerT=setTimeout(function(){b.classList.remove('on')},1500);}\nfunction hud(g){\n  el('score').textContent=Math.floor(g.score);\n  el('speed').textContent=Math.round(g.speed);\n  var t=el('time');t.textContent=Math.ceil(g.time);t.classList.toggle('low',g.time<10);\n  el('nitrofill').style.width=Math.round(g.nitro*100)+'%';\n  el('nitroB').classList.toggle('empty',g.nitro<=0);\n}\nfunction startRun(){\n  G=newGame();G.running=true;\n  el('start').classList.add('hide');el('over').classList.add('hide');el('hud').style.display='block';\n  audio();haptic('success');\n}\nfunction endRun(g){\n  engineTick(g);\n  var kmDist=g.dist.toFixed(1);\n  el('overStats').innerHTML='Score <b style=\"color:var(--cy)\">'+Math.floor(g.score)+'</b> · '+kmDist+' km · '+\n    g.gatesHit+' gate'+(g.gatesHit===1?'':'s')+' · '+g.nearMisses+' near-miss'+(g.nearMisses===1?'':'es')+\n    (g.crashes?'<br>'+g.crashes+' crash'+(g.crashes===1?'':'es')+' — thread the needle!':'<br>Clean run — beautiful driving.');\n  if(Math.floor(g.score)>best){best=Math.floor(g.score);store.setItem('stardrift.best',String(best));el('overBest').textContent='★ New best!';}\n  else el('overBest').textContent=best?('Best  '+best):'';\n  el('hud').style.display='none';el('over').classList.remove('hide');\n  haptic('warning');\n}\nel('startBtn').onclick=startRun;\nel('againBtn').onclick=startRun;\nel('mute').onclick=function(){muted=!muted;el('mute').textContent=muted?'🔇':'🔊';if(engGain)engGain.gain.value=0;};\n\n/* main loop: fixed-step update, rAF render */\nvar last=0,acc=0;\nfunction frame(ts){\n  requestAnimationFrame(frame);\n  if(!last)last=ts;\n  var dt=Math.min(.1,(ts-last)/1000);last=ts;acc+=dt;\n  while(acc>1/120){if(G)update(G,1/120);acc-=1/120;}\n  if(G){render(G);hud(G);engineTick(G);}\n  else render(newGame());\n}\nresize();\nrequestAnimationFrame(frame);\nstore.getItem('stardrift.best').then(function(v){best=parseInt(v||'0',10)||0;\n  el('startBest').textContent=best?('Best  '+best):'';});\n</script>\n</body></html>\n"}