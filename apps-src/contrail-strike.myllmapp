 'center', P.dk.wire ? '#9fffe0' : AMB, '800 12px system-ui');\n      c.fillStyle = 'rgba(0,0,0,.45)'; c.fillRect(W / 2 - 90, H * .15 + 12, 180, 6); c.fillStyle = rem > .3 ? '#3fe6b6' : RED; c.fillRect(W / 2 - 90, H * .15 + 12, 180 * rem, 6); txt(c, 'DECK LEFT', W / 2, H * .15 + 28, 'center', GRD, '700 9px system-ui'); } }\n  // status block\n  var x0 = 14 + (window._sl || 0), y0 = 16; var lf = left();\n  txt(c, M.def.surv ? 'WAVE ' + (M.wave || 0) : M.carrier ? 'LAND ON NORTHWIND' : (M.def.id === 'm4' ? 'SHEPHERD ' + Math.round(M.tr.hp / M.tr.maxhp * 100) + '%' : 'TARGETS ' + lf), x0, y0, 'left', '#fff', '800 12px system-ui');\n  if (M.prog) txt(c, 'CONVOY ' + Math.round(M.prog * 100) + '% TO PORT', x0, y0 + 16, 'left', M.prog > .75 ? RED : AMB, '700 10px system-ui');\n  if (M.fuel != null){ var fu = Math.max(0, M.fuel); txt(c, 'FUEL ' + Math.floor(fu / 60) + ':' + (fu % 60 < 10 ? '0' : '') + Math.floor(fu % 60), x0, y0 + 16, 'left', fu < 45 ? RED : AMB, '700 10px system-ui'); }\n  var hy = y0 + (M.prog || M.fuel != null ? 32 : 18); c.fillStyle = 'rgba(0,0,0,.45)'; c.fillRect(x0, hy, 110, 7); var hf = P.hp / P.maxhp; c.fillStyle = hf > .5 ? '#3fe6b6' : (hf > .25 ? AMB : RED); c.fillRect(x0, hy, 110 * clamp(hf, 0, 1), 7);\n  txt(c, 'MSL ' + P.mslLeft, x0, hy + 20, 'left', P.mslLeft ? GRN : RED, '800 12px system-ui'); txt(c, 'FLR ' + P.flr, x0 + 62, hy + 20, 'left', P.flr ? GRN : RED, '800 12px system-ui'); if ((P.gear || 0) > .02) txt(c, 'GEAR', x0 + 122, hy + 20, 'left', P.gear > .9 ? '#9fffe0' : AMB, '800 12px system-ui');\n  c.fillStyle = P.railCd[0] <= 0 ? '#3fe6b6' : 'rgba(255,255,255,.25)'; c.fillRect(x0, hy + 30, 26, 4); c.fillStyle = P.railCd[1] <= 0 ? '#3fe6b6' : 'rgba(255,255,255,.25)'; c.fillRect(x0 + 30, hy + 30, 26, 4);\n  var mm = Math.floor(M.t / 60), ss = Math.floor(M.t % 60); txt(c, '' + score, W - 14, y0, 'right', '#fff', '800 14px system-ui'); txt(c, mm + ':' + (ss < 10 ? '0' : '') + ss, W - 14, y0 + 17, 'right', GRD, '700 11px system-ui');\n  // radar\n  var R = Math.round(46 * S + 6), rx = W < 560 ? R + 12 : W / 2, ry = H - R - 10, rng = 3200; var gTop = P.alive ? gauges(c, rx, ry, R, S, pd) : ry - R; c.textBaseline = 'middle'; c.strokeStyle = GRN; c.save(); c.beginPath(); c.arc(rx, ry, R, 0, TAU); c.clip(); c.globalAlpha = .7; c.fillStyle = '#04121a'; c.fillRect(rx - R, ry - R, R * 2, R * 2);\n  c.translate(rx, ry); c.rotate(hd); var sc = R / rng, ms = HALF * 2 * sc; c.globalAlpha = .55; c.drawImage(MAPC, (P.p[0] - HALF) * sc, (P.p[2] - HALF) * sc, ms, ms); c.globalAlpha = 1;\n  function blip(o, col, sq){ var bx = -(o.p[0] - P.p[0]) * sc, by = -(o.p[2] - P.p[2]) * sc, l = Math.hypot(bx, by); if (l > R - 3){ bx *= (R - 3) / l; by *= (R - 3) / l; } c.fillStyle = col; if (sq) c.fillRect(bx - 2, by - 2, 4, 4); else { c.beginPath(); c.arc(bx, by, 2.4, 0, TAU); c.fill(); } }\n  if (M.carrier) blip(M.carrier, '#6fd0ff', true); GND.forEach(function(o){ if (o.alive) blip(o, o.primary ? '#ff7a50' : '#c98a70', true); }); AIR.forEach(function(o){ if (o.alive && o !== P) blip(o, o.team ? '#ff4030' : '#6fd0ff'); }); MSL.forEach(function(o){ if (o.team === 1) blip(o, '#fff'); });\n  c.restore(); c.strokeStyle = GRD; c.beginPath(); c.arc(rx, ry, R, 0, TAU); c.stroke(); c.fillStyle = GRN; c.beginPath(); c.moveTo(rx, ry - 5); c.lineTo(rx - 4, ry + 4); c.lineTo(rx + 4, ry + 4); c.closePath(); c.fill();\n  for (i = 0; i < MSGS.length; i++){ var mg = MSGS[i]; c.globalAlpha = clamp(mg.t, 0, 1); var ms2 = mg.who + ': ' + mg.txt, fs = 12; c.font = '600 12px system-ui'; var mw = c.measureText(ms2).width, lim = W < 560 ? W - 16 : W - 2 * Math.min(W * .3, 250); if (mw > lim) fs = Math.max(8.5, 12 * lim / mw); txt(c, ms2, W / 2, gTop - 13 - (MSGS.length - 1 - i) * 15, 'center', mg.who === 'WARNING' ? AMB : '#dff', '600 ' + fs.toFixed(1) + 'px system-ui'); c.globalAlpha = 1; }\n  if (STICK){ c.strokeStyle = 'rgba(160,255,215,.5)'; c.lineWidth = 2; c.beginPath(); c.arc(STICK.bx, STICK.by, 56, 0, TAU); c.stroke(); c.fillStyle = 'rgba(6