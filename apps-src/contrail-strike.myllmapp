 system-ui');\n  c.fillStyle = P.railCd[0] <= 0 ? '#3fe6b6' : 'rgba(255,255,255,.25)'; c.fillRect(x0, hy + 30, 26, 4); c.fillStyle = P.railCd[1] <= 0 ? '#3fe6b6' : 'rgba(255,255,255,.25)'; c.fillRect(x0 + 30, hy + 30, 26, 4);\n  var mm = Math.floor(M.t / 60), ss = Math.floor(M.t % 60); txt(c, '' + score, W - 14, y0, 'right', '#fff', '800 14px system-ui'); txt(c, mm + ':' + (ss < 10 ? '0' : '') + ss, W - 14, y0 + 17, 'right', GRD, '700 11px system-ui');\n  // radar\n  var R = Math.round(46 * S + 6), rx = W < 560 ? R + 12 : W / 2, ry = H - R - 10, rng = 3200; var gTop = P.alive ? gauges(c, rx, ry, R, S, pd) : ry - R; c.textBaseline = 'middle'; c.strokeStyle = GRN; c.save(); c.beginPath(); c.arc(rx, ry, R, 0, TAU); c.clip(); c.globalAlpha = .7; c.fillStyle = '#04121a'; c.fillRect(rx - R, ry - R, R * 2, R * 2);\n  c.translate(rx, ry); c.rotate(hd); var sc = R / rng, ms = HALF * 2 * sc; c.globalAlpha = .55; c.drawImage(MAPC, (P.p[0] - HALF) * sc, (P.p[2] - HALF) * sc, ms, ms); c.globalAlpha = 1;\n  function blip(o, col, sq){ var bx = -(o.p[0] - P.p[0]) * sc, by = -(o.p[2] - P.p[2]) * sc, l = Math.hypot(bx, by); if (l > R - 3){ bx *= (R - 3) / l; by *= (R - 3) / l; } c.fillStyle = col; if (sq) c.fillRect(bx - 2, by - 2, 4, 4); else { c.beginPath(); c.arc(bx, by, 2.4, 0, TAU); c.fill(); } }\n  GND.forEach(function(o){ if (o.alive) blip(o, o.primary ? '#ff7a50' : '#c98a70', true); }); AIR.forEach(function(o){ if (o.alive && o !== P) blip(o, o.team ? '#ff4030' : '#6fd0ff'); }); MSL.forEach(function(o){ if (o.team === 1) blip(o, '#fff'); });\n  c.restore(); c.strokeStyle = GRD; c.beginPath(); c.arc(rx, ry, R, 0, TAU); c.stroke(); c.fillStyle = GRN; c.beginPath(); c.moveTo(rx, ry - 5); c.lineTo(rx - 4, ry + 4); c.lineTo(rx + 4, ry + 4); c.closePath(); c.fill();\n  for (i = 0; i < MSGS.length; i++){ var mg = MSGS[i]; c.globalAlpha = clamp(mg.t, 0, 1); var ms2 = mg.who + ': ' + mg.txt, fs = 12; c.font = '600 12px system-ui'; var mw = c.measureText(ms2).width, lim = W < 560 ? W - 16 : W - 2 * Math.min(W * .3, 250); if (mw > lim) fs = Math.max(8.5, 12 * lim / mw); txt(c, ms2, W / 2, gTop - 13 - (MSGS.length - 1 - i) * 15, 'center', mg.who === 'WARNING' ? AMB : '#dff', '600 ' + fs.toFixed(1) + 'px system-ui'); c.globalAlpha = 1; }\n  if (STICK){ c.strokeStyle = 'rgba(160,255,215,.5)'; c.lineWidth = 2; c.beginPath(); c.arc(STICK.bx, STICK.by, 56, 0, TAU); c.stroke(); c.fillStyle = 'rgba(63,230,182,.45)'; c.beginPath(); c.arc(STICK.bx + INP.x * 56, STICK.by - INP.y * 56 * (STICK.inv ? -1 : 1), 24, 0, TAU); c.fill(); }\n  else if (TOUCH && phase === 'play' && M.t < 6) txt(c, 'DRAG HERE TO FLY', W * .2, H * .72, 'center', GRD, '700 11px system-ui');\n  el('hurt').style.opacity = hurtA > 0 ? Math.min(1, hurtA) : 0; }\n// ===================================================================\n// AUDIO\n// ===================================================================\nvar AC = null, MG, NB, ENG = null, LKG = null, LKO = null, warnT = 0;\nfunction audioInit(){ try { if (!AC){ var C = window.AudioContext || window.webkitAudioContext; if (!C) return; AC = new C(); MG = AC.createGain(); MG.gain.value = SET.sound ? .8 : 0; MG.connect(AC.destination);\n      NB = AC.createBuffer(1, AC.sampleRate * 2, AC.sampleRate); var d = NB.getChannelData(0); for (var i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;\n      var ns = AC.createBufferSource(); ns.buffer = NB; ns.loop = true; var lp = AC.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 500; var g = AC.createGain(); g.gain.value = 0; ns.connect(lp); lp.connect(g); g.connect(MG);\n      var o = AC.createOscillator(); o.type = 'sawtooth'; o.frequency.value = 62; var ol = AC.createBiquadFilter(); ol.type = 'lowpass'; ol.frequency.value = 200; var og = AC.createGain(); og.gain.value = .3; o.connect(ol); ol.connect(og); og.connect(g); ns.start(); o.start(); ENG = { g: g, lp: lp, o: o };\n      LKO = AC.createOscillator(); LKO.type = 'square'; LKO.frequency.value = 900; var lf = AC.createBiquadFilter(); lf.type = 'lowpass'; lf.frequency.value = 2200; LKG = AC.createGain(); LKG.gain.value = 0; LKO.connect(lf); lf.connect(LKG); LKG.connect(MG); LKO.start(); }\n    if (AC.state === 'suspended') AC.resume(); } catch (e) {} }\nfunction nz(dur, f0, f1, vol, type, q){ if (!AC || !SET.sound) return; try { var t = AC.currentTime, s = AC.createBufferSource(); s.buffer = NB; var f = AC.createBiquadFilter(); f.type = type || 'lowpass'; f.frequency.setValueAtTime(f0, t); f.frequency.exponentialRampToValueAtTime(Math.max(30, f1), t + dur); if (q) f.Q.value = q;\n    var g = AC.createGain(); g.gain.setValueAtTime(vol, t); g.gain.exponentialRampToValueAtTime(.001, t + dur); s.connect(f); f.connect(g); g.connect(MG); s.start(t, Math.random() * 1.5); s.stop(t + dur + .05); } catch (e) {} }\nfunction tn(fr, dur, vol, type){ if (!AC || !SET.sound) return; try { var t = AC.currentTime, o = AC.createOscillator(), g = AC.createGain(); o.type = type || 'sine'; o.frequency.value = fr; g.gain.setValueAtTime(vol, t); g.gain.exponentialRampToValueAtTime(.001, t + dur); o.connect(g); g.connect(MG); o.start(t); o.stop(t + dur + .02); } catch (e) {} }\nfunction sfx(n, v){ v = v == null ? 1 : v; if (v < .03) return;\n  if (n === 'gun') nz(.07, 2600, 700, .2 * v, 'bandpass', 1.2); else if (n === 'msl'){ nz(.9, 1800, 300, .4 * v, 'bandpass', .8); nz(.25, 600, 120, .3 * v); } else if (n === 'boom'){ nz(1.4, 900, 40, .75 * v); nz(.35, 3000, 200, .22 * v, 'bandpass'); }\n  else if (n === 'hit') nz(.1, 3500, 900, .3 * v, 'bandpass'); else if (n === 'flare') nz(.3, 5000, 2000, .14 * v, 'highpass'); else if (n === 'ui') tn(880, .06, .08, 'triangle'); else if (n === 'warn') tn(1250, .09, .1, 'square'); else if (n === 'kill'){ tn(660, .08, .1); tn(990, .14, .08); } }\nfunction audioTick(dt){ if (!AC || !ENG) return; var t = AC.currentTime, on = (phase === 'play' || phase === 'end') && P && P.alive && SET.sound;\n  ENG.g.gain.setTargetAtTime(on ? .1 + (P.thr > .5 ? .16 : P.thr < 0 ? -.03 : .04) : 0, t, .12); if (on){ ENG.lp.frequency.setTargetAtTime(260 + P.spd * 2 + (P.thr > .5 ? 700 : 0), t, .15); ENG.o.frequency.setTargetAtTime(48 + P.spd * .14, t, .15); }\n  var lk = 0; if (on && phase === 'play'){ if (locked){ lk = .035; LKO.frequency.setTargetAtTime(1500, t, .01); } else if (lockT > 0 && ((simT * 7 | 0) & 1)){ lk = .03; LKO.frequency.setTargetAtTime(850, t, .01); } }\n  LKG.gain.setTargetAtTime(lk, t, .01); warnT -= dt; if (on && incoming(P) && warnT <= 0){ warnT = .22; sfx('warn'); } }\n\n// ===================================================================\n// INPUT\n// ===================================================================\nvar KEYS = {}, kx = 0, ky = 0;\nfunction keyInp(dt){ var tx = (KEYS.ArrowRight || KEYS.d ? 1 : 0) - (KEYS.ArrowLeft || KEYS.a ? 1 : 0), ty = (KEYS.ArrowUp || KEYS.w ? 1 : 0) - (KEYS.ArrowDown || KEYS.s ? 1 : 0), k = Math.min(1, dt * 7);\n  kx += (tx - kx) * k; ky += (ty - ky) * k; if (!STICK){ INP.x = kx; INP.y = ky; } INP.yaw = (KEYS.e ? 1 : 0) - (KEYS.q ? 1 : 0); INP.gun = KEYS[' '] ? 1 : (HELD.bGun ? 1 : 0); INP.boost = KEYS.Shift || HELD.bBst ? 1 : 0; INP.brake = KEYS.z || HELD.bBrk ? 1 : 0; }\nwindow.addEventListener('keydown', function(e){ var k = e.key.length === 1 ? e.key.toLowerCase() : e.key; if (phase === 'play' && (k === ' ' || k.indexOf('Arrow') === 0 || k === 'Tab')) e.preventDefault(); if (KEYS[k]) return; KEYS[k] = 1; audioInit();\n  if (phase === 'play'){ if (k === 'f' || k === 'Enter') playerMissile(); else if (k === 'x') playerFlare(); else if (k === 't' || k === 'Tab') nextTarget(true); else if (k === 'c') CAMMODE = 1 - CAMMODE; else if (k === 'p' || k === 'Escape') pause(); }\n  else if (phase === 'pause' && (k === 'p' || k === 'Escape')) resume(); });\nwindow.addEventListener('keyup', function(e){ var k = e.key.length === 1 ? e.key.toLowerCase() : e.key; KEYS[k] = 0; });\nvar HELD = {};\n['bGun', 'bMsl', 'bFlr', 'bTgt', 'bBst', 'bBrk'].forEach(function(id){ var b = el(id);\n  b.addEventListener('pointerdown', function(e){ e.preventDefault(); audioInit(); HELD[id] = 1; b.classList.add('dn'); try { b.setPointerCapture(e.pointerId); } catch (x) {} if (id === 'bMsl') playerMissile(); else if (id === 'bFlr') playerFlare(); else if (id === 'bTgt'){ nextTarget(true); haptic('light'); } });\n  ['pointerup', 'pointercancel'].forEach(function(n){ b.addEventListener(n, function(){ HELD[id] = 0; b.classList.remove('dn'); }); }); });\ncanvas.addEventListener('pointerdown', function(e){ if (phase !== 'play' || e.pointerType === 'mouse') return; audioInit(); if (e.clientX < W * .5 && !STICK){ STICK = { id: e.pointerId, bx: e.clientX, by: e.clientY }; try { canvas.setPointerCapture(e.pointerId); } catch (x) {} } });\ncanvas.addEventListener('pointermove', function(e){ if (!STICK || e.pointerId !== STICK.id) return; var dx = (e.clientX - STICK.bx) / 56, dy = (STICK.by - e.clientY) / 56, l = Math.hypot(dx, dy); if (l > 1){ dx /= l; dy /= l; } INP.x = dx; INP.y = dy; });\n['pointerup', 'pointercancel'].forEach(function(n){ canvas.addEventListener(n, function(e){ if (STICK && e.pointerId === STICK.id){ STICK = null; INP.x = INP.y = 0; kx = ky = 0; } }); });\ncanvas.addEventListener('contextmenu', function(e){ e.preventDefault(); });\n\n// ===================================================================\n// UI\n// ===================================================================\nfunction saveAll(){ try { store.setItem('cs.save', JSON.stringify({ SET: SET, SAVE: SAVE })); } catch (e) {} }\nvar SCR = ['menu', 'select', 'hangar', 'settings', 'brief', 'pause', 'debrief'], pending = null;\nfunction go(s){ SCR.forEach(hide); if (s && s !== 'play') show(s); var playing = s === 'play'; el('pad').classList.toggle('hidden', !(playing && TOUCH)); el('bPause').classList.toggle('hidden', !playing);\n  el('bg').style.backgroundImage = 'url(' + (s === 'menu' || s === 'select' || s === 'settings' ? KEY_URI : BRIEF_URI) + ')'; el('bg').classList.toggle('soft', s === 'hangar'); el('bg').style.display = (playing || s === 'pause' || s === 'debrief') ? 'none' : 'block';\n  if (s === 'menu' || s === 'select' || s === 'settings' || s === 'hangar' || s === 'brief'){ phase = s === 'brief' ? 'select' : s; immersive(false); }\n  if (s === 'menu') el('recLine').textContent = 'Missions cleared ' + Object.keys(SAVE.best).length + '/' + MIS.length + (SAVE.surv ? '  ·  Survival best ' + SAVE.surv : '') + '  ·  Flying the ' + PLANES[SET.jet].name;\n  if (s === 'select') buildSelect(); if (s === 'hangar') buildHangar(); if (s === 'settings') buildSet(); }\nfunction buildSelect(){ var g = el('misGrid'); g.innerHTML = ''; MIS.forEach(function(m, i){ var lock = i >= SAVE.unl, b = SAVE.best[m.id], d = document.createElement('div'); d.className = 'card' + (lock ? ' lock' : '');\n    d.innerHTML = '<i>MISSION ' + (i + 1) + '</i><b>' + m.name.toUpperCase() + '</b><p>' + (lock ? 'Locked. Clear the previous mission.' : m.short) + '</p>' + (b ? '<span class=\"rk\">' + b.rank + '</span>' : '');\n    if (!lock) d.addEventListener('click', function(){ sfx('ui'); openBrief(m); }); g.appendChild(d); }); }\nfunction openBrief(m){ pending = m; go('brief'); el('brNo').textContent = m.surv ? 'ENDLESS' : 'MISSION ' + (MIS.indexOf(m) + 1); el('brName').textContent = m.name; el('brText').textContent = m.text; el('brObj').innerHTML = m.obj.map(function(o){ return '<li>' + o + '</li>'; }).join('');\n  el('brJet').textContent = 'Aircraft: ' + PLANES[SET.jet].name; var c = el('mapC').getContext('2d'); c.drawImage(MAPC, 0, 0, 512, 512); c.strokeStyle = 'rgba(150,255,205,.25)'; c.lineWidth = 1; for (var i = 1; i < 8; i++){ c.beginPath(); c.moveTo(i * 64, 0); c.lineTo(i * 64, 512); c.moveTo(0, i * 64); c.lineTo(512, i * 64); c.stroke(); }\n  var px = (HALF - (m.id === 'm4' ? -500 : 0)) / (HALF * 2) * 512, pz = (HALF + 3300) / (HALF * 2) * 512; c.fillStyle = '#6fd0ff'; c.beginPath(); c.moveTo(px, pz - 9); c.lineTo(px - 7, pz + 7); c.lineTo(px + 7, pz + 7); c.closePath(); c.fill(); c.font = '700 12px system-ui'; c.fillText('YOU', px + 11, pz + 5); }\nfunction buildHangar(){ phase = 'hangar'; var L = el('jetList'); L.innerHTML = ''; PLANES.forEach(function(p, i){ var b = document.createElement('button'); b.className = 'btn' + (i === SET.jet ? ' on' : ''); b.textContent = p.name; b.addEventListener('click', function(){ SET.jet = i; saveAll(); sfx('ui'); buildHangar(); }); L.appendChild(b); });\n  var p = PLANES[SET.jet]; el('jetName').textContent = p.name; el('jetDesc').textContent = p.desc; el('jetStats').innerHTML = ['Speed', 'Agility', 'Armour', 'Missiles'].map(function(n, i){ return '<div class=\"stat\"><span>' + n + '</span><div class=\"bar\"><u style=\"width:' + Math.round(p.bars[i] * 100) + '%\"></u></div></div>'; }).join(''); }\nfunction buildSet(){ [['sAs', 'assist', 2], ['sPi', 'pitch', 2], ['sD', 'diff', 3], ['sQ', 'quality', 2]].forEach(function(r){ for (var i = 0; i < r[2]; i++) el(r[0] + i).classList.toggle('on', SET[r[1]] === i); });\n  el('sSnd').textContent = SET.sound ? 'On' : 'Off'; el('sSnd').classList.toggle('on', SET.sound); el('asNote').textContent = SET.assist ? 'Expert: the stick rolls and pitches the jet directly. Loops and rolls are all yours.' : 'Novice: push the stick sideways to turn. The jet banks and levels itself.'; }\n[['sAs', 'assist', 2], ['sPi', 'pitch', 2], ['sD', 'diff', 3], ['sQ', 'quality', 2]].forEach(function(r){ for (var i = 0; i < r[2]; i++) (function(i){ el(r[0] + i).addEventListener('click', function(){ SET[r[1]] = i; saveAll(); sfx('ui'); resize(); buildSet(); }); })(i); });\nel('sSnd').addEventListener('click', function(){ SET.sound = !SET.sound; audioInit(); if (MG) MG.gain.value = SET.sound ? .8 : 0; saveAll(); buildSet(); });\nfunction launch(m){ audioInit(); startMission(m); go('play'); immersive(true); }\nfunction pause(){ if (phase !== 'play') return; phase = 'pause'; go('pause'); }\nfunction resume(){ phase = 'play'; go('play'); last = 0; }\nfunction showDebrief(won, rank){ go('debrief'); immersive(false); var d = M.def; el('dbSub').textContent = d.surv ? 'SURVIVAL' : d.name.toUpperCase(); el('dbTitle').textContent = d.surv ? 'Shot down on wave ' + (M.wave || 1) : (won ? 'Mission complete' : 'Mission failed');\n  el('rank').textContent = (won || d.surv) ? rank : ''; var mm = Math.floor(M.t / 60), ss = Math.floor(M.t % 60), rows = [['Score', score], ['Kills', kills], ['Time', mm + ':' + (ss < 10 ? '0' : '') + ss], ['Hull', Math.max(0, Math.round(P.hp / P.maxhp * 100)) + '%']];\n  if (!won && M.why) rows.unshift(['', M.why]); el('dbStats').innerHTML = rows.map(function(r){ return '<span>' + r[0] + '</span><span>' + r[1] + '</span>'; }).join('');\n  var nx = MIS[MIS.indexOf(d) + 1]; el('dbNext').classList.toggle('hidden', !(won && !d.surv && nx)); }\nel('goCamp').addEventListener('click', function(){ audioInit(); sfx('ui'); go('select'); }); el('goSurv').addEventListener('click', function(){ audioInit(); sfx('ui'); openBrief(SURV); });\nel('goHangar').addEventListener('click', function(){ audioInit(); sfx('ui'); go('hangar'); }); el('goSet').addEventListener('click', function(){ audioInit(); sfx('ui'); go('settings'); });\nArray.prototype.forEach.call(document.querySelectorAll('[data-back]'), function(b){ b.addEventListener('click', function(){ sfx('ui'); go(b.closest('#brief') && pending && !pending.surv ? 'select' : 'menu'); }); });\nel('brGo').addEventListener('click', function(){ launch(pending); }); el('bPause').addEventListener('click', pause); el('pResume').addEventListener('click', resume);\nel('pRestart').addEventListener('click', function(){ launch(M.def); }); el('pQuit').addEventListener('click', function(){ P = null; go('menu'); });\nel('dbRetry').addEventListener('click', function(){ launch(M.def); }); el('dbMenu').addEventListener('click', function(){ P = null; go('menu'); }); el('dbNext').addEventListener('click', function(){ openBrief(MIS[MIS.indexOf(M.def) + 1]); });\ndocument.addEventListener('visibilitychange', function(){ if (document.hidden) pause(); });\n\n// ===================================================================\n// MAIN\n// ===================================================================\nvar last = 0, acc = 0;\nfunction frame(t){ requestAnimationFrame(frame); var dt = last ? Math.min(.1, (t - last) / 1000) : 0; last = t;\n  if (phase === 'play' || phase === 'dead' || phase === 'end'){ keyInp(dt); acc += dt; var n = 0; while (acc >= 1 / 60 && n++ < 5){ step(1 / 60); acc -= 1 / 60; } if (n >= 5) acc = 0; }\n  try { render(dt); drawHUD(); audioTick(dt); } catch (e) { if (!frame.err){ frame.err = 1; console.error(e); } } }\nTOUCH = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);\nstore.getItem('cs.save').then(function(v){ try { if (v){ var o = JSON.parse(v); if (o.SET) for (var k in o.SET) SET[k] = o.SET[k]; if (o.SAVE) for (var j in o.SAVE) SAVE[j] = o.SAVE[j]; } } catch (e) {} resize(); go('menu'); }, function(){ resize(); go('menu'); });\nresize(); go('menu'); requestAnimationFrame(frame);\nwindow.__cs = { get phase(){ return phase; }, get P(){ return P; }, get AIR(){ return AIR; }, get GND(){ return GND; }, get MSL(){ return MSL; }, get M(){ return M; }, get score(){ return score; }, get left(){ return M ? left() : -1; }, get parts(){ return PARTS.length; },\n  tick: function(n){ for (var i = 0; i < n && (phase === 'play' || phase === 'dead' || phase === 'end'); i++) step(1 / 60); }, start: function(i, jet){ if (jet != null) SET.jet = jet; launch(i < 0 ? SURV : MIS[i]); },\n  set ai(v){ AI0 = !!v; }, set quiet(v){ QUIET = !!v; }, set dbg(v){ DBG = v; }, set cam(v){ CAMMODE = v; }, set touch(v){ TOUCH = !!v; }, INP: INP, missile: playerMissile, flare: playerFlare, go: go, unlock: function(){ SAVE.unl = MIS.length; }, Hg: Hg, set god(v){ if (P){ P.maxhp = P.hp = v ? 1e6 : P.spec.hp; } } };\n})();\n</script></body></html>\n"}