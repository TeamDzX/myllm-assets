.5, .6], fog: [.8, .8, .79], zen: [.22, .42, .72], fogD: .0001, h0: -.02, h1: .52 };\nfunction setCommon(P, cam){ gl.useProgram(P.p); gl.uniform3fv(P.u('uCam'), cam); gl.uniform3fv(P.u('uSun'), SUN); gl.uniform3fv(P.u('uSunCol'), LIGHT.sunCol); gl.uniform3fv(P.u('uAmb'), LIGHT.amb);\n  gl.uniform3fv(P.u('uFog'), LIGHT.fog); gl.uniform3fv(P.u('uZen'), LIGHT.zen); gl.uniform1f(P.u('uFogD'), LIGHT.fogD); gl.uniform1f(P.u('uH0'), LIGHT.h0); gl.uniform1f(P.u('uH1'), LIGHT.h1); gl.uniform1i(P.u('uSky'), 0); }\n// textures\nfunction texFrom(src, repeat, mip){ var t = gl.createTexture(); gl.bindTexture(gl.TEXTURE_2D, t);\n  gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, 1, 1, 0, gl.RGBA, gl.UNSIGNED_BYTE, new Uint8Array([150, 170, 180, 255]));\n  function up(img){ gl.bindTexture(gl.TEXTURE_2D, t); gl.pixelStorei(gl.UNPACK_PREMULTIPLY_ALPHA_WEBGL, false); gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, img);\n    var w = repeat ? gl.REPEAT : gl.CLAMP_TO_EDGE; gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, w); gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, repeat === 2 ? gl.CLAMP_TO_EDGE : w);\n    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);\n    if (mip){ gl.generateMipmap(gl.TEXTURE_2D); gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR_MIPMAP_LINEAR); } else gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR); }\n  if (typeof src === 'string'){ var im = new Image(); im.onload = function(){ up(im); }; im.src = src; } else up(src);\n  return t; }\nvar TSKIN = {}; Object.keys(SKIN).forEach(function(k){ TSKIN[k] = { tex: texFrom(SKIN[k], 1, true), mean: SKMEAN[k] }; });\nvar TSKY = texFrom(SKY_URI, 2, false), TGRASS = texFrom(GRASS_URI, 1, true), TROCK = texFrom(ROCK_URI, 1, true);\n// sprite atlas: soft glow (left) + cloud puff (right)\nvar TSPR = (function(){ var c = document.createElement('canvas'); c.width = 256; c.height = 128; var x = c.getContext('2d');\n  var g = x.createRadialGradient(64, 64, 0,