0, locked = false, SHAKE = 0, hurtA = 0, endT = 0;\nvar MSGS = [], KMSG = [], INP = { x: 0, y: 0, yaw: 0, gun: 0, boost: 0, brake: 0 }, CAMMODE = 0;\nfunction radio(who, txt){ MSGS.push({ who: who, txt: txt, t: 5.5 }); if (MSGS.length > 3) MSGS.shift(); if (!QUIET) sfx('ui'); }\nfunction kmsg(txt, col){ KMSG.push({ txt: txt, t: 2.2, col: col || '#ffe08a' }); if (KMSG.length > 3) KMSG.shift(); }\n\nfunction makeAir(spec, team, p, yaw, extra){ var f = [Math.sin(yaw), 0, Math.cos(yaw)], u = [0, 1, 0];\n  p = [p[0], Math.max(p[1], Hg(p[0], p[2]) + 260), p[2]]; var e = { kind: 'air', spec: spec, type: spec.type || 'player', team: team, p: p.slice(), f: f, u: u, r: norm(cross(f, u)), v: scl(f, spec.cruise), spd: spec.cruise, hp: spec.hp, maxhp: spec.hp, rad: spec.rad,\n    alive: true, dead: false, gone: false, mesh: MESH[spec.mesh], scale: spec.scale || 1, flash: 0, thr: 0, pIn: 0, gunCd: 0, rail: 0, railCd: [0, 0], mslLeft: spec.msl || 0, flr: spec.flr || 0, flrCd: 0,\n    ai: { st: 'engage', t: 0, mcd: 5 + rnd() * 9, lk: 0, side: 1, wp: 0 }, tgtE: null, score: spec.score || 0 };\n  if (extra) for (var k in extra) e[k] = extra[k]; AIR.push(e); return e; }\nfunction makeGnd(type, p, yaw, extra){ var s = GUNITS[type];\n  var sc = type === 'ship' ? 1.5 : 2.2; var e = { kind: 'gnd', type: type, spec: s, team: 1, p: p.slice(), yaw: yaw || 0, v: [0, 0, 0], hp: s.hp, maxhp: s.hp, rad: s.rad * (type === 'ship' ? 1.4 : 1.6), scale: sc, alive: true, mesh: MESH[type], flash: 0, cd: 2 + rnd() * 4, burst: 0, ang: rnd() * 6, score: s.score, smokeT: 0 };\n  if (extra) for (var k in extra) e[k] = extra[k]; GND.push(e); return e; }\n\n// ---------- flight ----------\nfunction flyStep(e, pIn, rIn, yIn, thr, dt){ var s = e.spec, sf = clamp((e.spd - s.vmin * .6) / (s.cruise - s.vmin * .6), .4, 1.1), a;\n  if (rIn){ a = rIn * s.rr * dt; e.r = rot(e.r, e.f, a); e.u = rot(e.u, e.f, a); }\n  if (pIn){ a = pIn * s.pr * dt * sf; e.f = rot(e.f, e.r, a); e.u = rot(e.u, e.r, a); }\n  if (yIn){ a = -yIn * s.yr * dt; e.f = rot(e.f, e.u, a); e.r = rot(e.r, e.u, a); }\n  if (e.f[0] * e.f[0] + e.f[2] * e.f[2] > .05){ var bank = Math.atan2(-e.r[1], e.u[1]), w = -Math.sin(bank) * .34 * dt * sf * (e.u[1] > 0 ? 1 : .3), Y = [0, 1, 0]; e.f = rot(e.f, Y, w); e.r = rot(e.r, Y, w); e.u = rot(e.u, Y, w); }\n  var tg = thr >= 0 ? s.cruise + thr * (s.vmax - s.cruise) : s.cruise + thr * (s.cruise - s.vmin);\n  e.spd += (tg - e.spd) * (thr > 0 ? .9 : .7) * dt - e.f[1] * 36 * dt; e.spd = clamp(e.spd, s.vmin * .75, s.vmax * 1.18);\n  if (e.spd < s.vmin * 1.08){ var st = clamp((s.vmin * 1.08 - e.spd) / (s.vmin * .3), 0, 1) * 1.3 * dt; e.f = norm([e.f[0], e.f[1] - st, e.f[2]]); e.stall = true; } else e.stall = false;\n  e.f = norm(e.f); e.r = norm(cross(e.f, e.u)); e.u = cross(e.r, e.f); e.v = scl(e.f, e.spd); e.p = madd(e.p, e.v, dt); e.thr = thr; e.pIn = pIn; }\nfunction steerTo(e, T, agg){ var d = sub(T, e.p), D = len(d) || 1; d = scl(d, 1 / D);\n  var lx = dot(d, e.r), ly = dot(d, e.u), lz = dot(d, e.f), off = Math.acos(clamp(lz, -1, 1)), bank = Math.atan2(-e.r[1], e.u[1]), rIn, pIn;\n  if (off < .14){ rIn = clamp(-bank * 1.2 + lx * 5, -1, 1); pIn = clamp(ly * 7, -1, 1); }\n  else { var ra = Math.atan2(lx, ly); rIn = clamp(ra * 2.6, -1, 1); pIn = clamp(off * 2.2, 0, 1) * (Math.abs(ra) < 1.1 ? 1 : .15) * agg; }\n  var la = madd(e.p, e.f, e.spd * 2.4), gh = Math.max(Hg(la[0], la[2]), Hg(e.p[0], e.p[2])), clr = Math.min(e.p[1], la[1]) - gh;\n  if (clr < (e.lowOK ? 70 : 230)){ rIn = clamp(-bank * 2.4, -1, 1); pIn = e.u[1] > .2 ? 1 : 0; }\n  else if (e.p[1] > 2700 && e.f[1] > -.1){ rIn = clamp(-bank * 2, -1, 1); pIn = -.5; }\n  return [pIn, rIn, clamp(lx * 2, -1, 1) * .4]; }\nfunction incCount(e){ var n = 0; for (var i = 0; i < MSL.length; i++) if (MSL[i].target === e) n++; return n; }\nfunction incoming(e){ for (var i = 0; i < MSL.length; i++){ var m = MSL[i]; if (m.target === e && m.team !== e.team) return m; } return null; }\nfunction foeOf(e){ var best = null, bd = 1e9; for (var i = 0; i < AIR.length; i++){ var o = AIR[i]; if (!o.alive || o.team === e.team) continue; var d = dist(o.p, e.p) * (e.pref && o.type === e.pref ? .25 : 1); if (d < bd){ bd = d; best = o; } } return best; }\nfunction aiGun(e, T, dt, spread, dmg){ e.gunCd -= dt; if (e.gunCd > 0) return; e.gunCd = .09; var D = dist(T.p, e.p), aim = norm(sub(madd(T.p, T.v, D / 900), e.p));\n  aim = norm([aim[0] + rs() * spread, aim[1] + rs() * spread, aim[2] + rs() * spread]); BUL.push({ p: madd(e.p, aim, e.rad + 2), v: scl(aim, 900), life: 1.1, team: e.team, dmg: dmg, owner: e });\n  if (!QUIET && rnd() < .3) sfx('gun', dvol(e.p) * .6); }\nfunction aiAir(e, dt){ var A = e.ai, T, tp, thr = 0, c; A.t -= dt; A.mcd -= dt;\n  if (e.path){ var wp = e.path[A.wp]; if (dist([wp[0], e.p[1], wp[2]], e.p) < 260 && A.wp < e.path.length - 1) A.wp++; else if (A.wp === e.path.length - 1 && dist([wp[0], e.p[1], wp[2]], e.p) < 300) e.arrived = true;\n    e.lowOK = false; c = steerTo(e, wp, .6); flyStep(e, c[0], c[1], c[2], 0, dt);\n    if (e.spec.gun === 2 && P && P.alive && dist(P.p, e.p) < 750) aiGun(e, P, dt, DIFF.spread * 2.2, 2); return; }\n  if (e.type === 'drone'){ var an = Math.atan2(e.p[2] - e.orb[2], e.p[0] - e.orb[0]) + .5; c = steerTo(e, [e.orb[0] + Math.cos(an) * e.orbR, e.orb[1], e.orb[2] + Math.sin(an) * e.orbR], .7); flyStep(e, c[0], c[1], c[2], 0, dt); return; }\n  T = (e.tgtE && e.tgtE.alive) ? e.tgtE : (e.tgtE = foeOf(e));\n  if (!T){ c = steerTo(e, [0, 900, 0], .5); flyStep(e, c[0], c[1], c[2], 0, dt); return; }\n  if (A.st !== 'evade' && incoming(e)){ A.st = 'evade'; A.t = 1.5 + rnd(); A.side = rnd() < .5 ? -1 : 1; if (e.flr > 0 && rnd() < e.spec.flareP){ e.flr--; dropFlares(e); } }\n  if (A.st === 'evade'){ tp = madd(madd(e.p, e.r, 900 * A.side), e.u, 200); thr = 1; if (A.t <= 0) A.st = 'engage'; }\n  else if (A.st === 'extend'){ tp = madd(e.p, A.dir, 1200); thr = 1; if (A.t <= 0) A.st = 'engage'; }\n  else { var D = dist(T.p, e.p), to = norm(sub(T.p, e.p)), ang = Math.acos(clamp(dot(e.f, to), -1, 1)); tp = madd(T.p, T.v, clamp(D / 900, 0, 1.2));\n    if (D < 190 && ang > 1.2){ A.st = 'extend'; A.t = 2 + rnd() * 1.5; A.dir = norm([e.f[0] + rs() * .6, .12, e.f[2] + rs() * .6]); }\n    thr = D > 1300 ? 1 : (D < 380 ? -.5 : .3);\n    if (e.spec.gun && ang < .1 && D < 800) aiGun(e, T, dt, DIFF.spread, 1.5);\n    if (e.spec.msl && ang < .34 && D < 2100 && D > 380){ A.lk += dt; if (A.lk > 1.5 && A.mcd <= 0 && incCount(T) < DIFF.maxInc){ fireMissile(e, T); A.mcd = DIFF.mcd * (.8 + rnd() * .5) * (e.type === 'ace' ? .75 : 1); A.lk = 0; } } else A.lk = Math.max(0, A.lk - dt); }\n  c = steerTo(e, tp, 1); flyStep(e, c[0], c[1], c[2], thr, dt); }\n\n// ---------- weapons ----------\nfunction dvol(p){ return clamp(1 - dist(p, CP) / 2600, 0, 1); }\nfunction fireMissile(e, T, from){ var side = (e.rail = 1 - (e.rail || 0)) ? 1 : -1, p = from || madd(madd(e.p, e.r || [1, 0, 0], side * 2.6), e.u || [0, 1, 0], -1), mine = e.team === 0;\n  MSL.push({ p: p, d: (from ? norm([rs() * .2, 1, rs() * .2]) : e.f.slice()), spd: (e.spd || 60) + 20, vmax: mine ? 580 : 470, acc: mine ? 300 : 210, turn: mine ? 2.8 : DIFF.mturn, life: mine ? 8 : 7.5, team: e.team, owner: e, target: T, dmg: mine ? 40 : 34, tr: 0 });\n  if (!QUIET) sfx('msl', e === P ? 1 : dvol(p) * .7); if (T === P && !QUIET) sfx('warn'); }\nfunction dropFlares(e){ for (var i = 0; i < 6; i++) FLR.push({ p: e.p.slice(), v: add(scl(e.v, .45), [rs() * 40, -20 - rnd() * 30, rs() * 40]), life: 2.4 + rnd() * .6, team: e.team });\n  var fl = FLR[FLR.length - 1]; for (var k = 0; k < MSL.length; k++){ var m = MSL[k]; if (m.target === e && rnd() < (e === P ? .82 : e.spec.flareP)) m.target = fl; } if (!QUIET) sfx('flare', e === P ? 1 : dvol(e.p)); }\nfunction playerFire(dt){ var s = P.spec; P.gunCd -= dt; P.railCd[0] -= dt; P.railCd[1] -= dt; P.flrCd -= dt;\n  if (INP.gun && P.gunCd <= 0){ P.gunCd = 1 / 18; var dir = P.f, T = P.tgtE;\n    if (T && T.alive){ var D = dist(T.p, P.p), aim = norm(sub(madd(T.p, T.v, D / 1100), P.p)); if (D < 1100 && dot(aim, P.f) > .985) dir = norm(add(scl(P.f, .3), scl(aim, .7))); }\n    dir = norm([dir[0] + rs() * .006, dir[1] + rs() * .006, dir[2] + rs() * .006]);\n    BUL.push({ p: madd(madd(P.p, P.f, 9), P.r, (P.rail ? .8 : -.8)), v: scl(dir, P.spd + 1000), life: 1.1, team: 0, dmg: s.gun, owner: P }); P.muzzle = .05; shots++; if (!QUIET && (shots & 1)) sfx('gun'); if ((shots % 6) === 0) haptic('light'); } }\nfunction playerMissile(){ if (!P || !P.alive || phase !== 'play') return; var i = P.railCd[0] <= 0 ? 0 : (P.railCd[1] <= 0 ? 1 : -1); if (i < 0 || P.mslLeft <= 0) return;\n  P.railCd[i] = P.spec.rail; P.mslLeft--; fireMissile(P, locked ? P.tgtE : null); shots++; haptic('medium'); }\nfunction playerFlare(){ if (!P || !P.alive || phase !== 'play' || P.flr <= 0 || P.flrCd > 0) return; P.flr--; P.flrCd = 1; dropFlares(P); haptic('light'); }\nfunction targets(){ var a = []; AIR.forEach(function(e){ if (e.alive && e.team === 1) a.push(e); }); GND.forEach(function(e){ if (e.alive) a.push(e); }); return a; }\nfunction nextTarget(cycle){ if (!P) return; var L = targets().map(function(e){ var d = sub(e.p, P.p), D = len(d), ang = Math.acos(clamp(dot(d, P.f) / (D || 1), -1, 1)); return { e: e, s: ang * 1700 + D - (e.primary ? 600 : 0) }; }).sort(function(a, b){ return a.s - b.s; });\n  if (!L.length){ P.tgtE = null; return; } var i = 0; if (cycle && P.tgtE){ for (var k = 0; k < L.length; k++) if (L[k].e === P.tgtE){ i = (k + 1) % Math.min(L.length, 6); break; } } P.tgtE = L[i].e; lockT = 0; }\nfunction updLock(dt){ var T = P.tgtE; if (!T || !T.alive){ nextTarget(false); T = P.tgtE; } if (!T){ lockT = 0; locked = false; return; }\n  var d = sub(T.p, P.p), D = len(d), ang = Math.acos(clamp(dot(d, P.f) / (D || 1), -1, 1)); if (D < 2700 && ang < .4) lockT = Math.min(lockT + dt, .7); else lockT = Math.max(0, lockT - dt * 3);\n  var was = locked; locked = lockT >= .55; if (locked && !was) haptic('light'); }\n\n// ---------- damage / effects ----------\nfunction part(p, v, life, s0, s1, c, a, tex, drag, grav){ if (PARTS.length > 1700) return; PARTS.push({ p: p.slice(), v: v, t: 0, life: life, s0: s0, s1: s1, c: c, a: a, tex: tex, drag: drag || 0, grav: grav || 0 }); }\nfunction boom(p, k, quiet){ var i;\n  for (i = 0; i < 9 * k; i++) part(madd(p, [rs(), rs(), rs()], 3 * k), [rs() * 22 * k, rs() * 22 * k + 8, rs() * 22 * k], .45 + rnd() * .5, 5 * k, 17 * k, [1, .55 + rnd() * .2, .2], -1, 0, 1.5);\n  for (i = 0; i < 7 * k; i++) part(madd(p, [rs(), rs(), rs()], 4 * k), [rs() * 12 * k, rs() * 10 * k + 9, rs() * 12 * k], 2 + rnd() * 1.8, 7 * k, 26 * k, [.16, .15, .14], .75, 1, .8);\n  for (i = 0; i < 12 * k; i++) part(p, [rs() * 80, rs() * 80 + 20, rs() * 80], .5 + rnd() * .6, 1.3, .4, [1, .8, .4], -1, 0, .5, 60);\n  part(p, [0, 0, 0], .16, 30 * k, 46 * k, [1, .92, .75], -.9, 0);\n  if (!quiet && !QUIET) sfx('boom', dvol(p) * Math.min(1, .5 + k * .3)); var d = dist(p, CP); if (d < 500) SHAKE = Math.max(SHAKE, (1 - d / 500) * k * .8); }\nfunction damage(e, dmg, src){ if (!e.alive) return; if (e === P){ dmg *= DIFF.taken; taken += dmg; hurtA = Math.min(1, hurtA + .5 + dmg / 60); SHAKE = Math.max(SHAKE, .4 + dmg / 50); haptic(dmg > 10 ? 'heavy' : 'medium'); if (!QUIET) sfx('hit'); }\n  if (e.type === 'transport') dmg *= .5; e.hp -= dmg; e.flash = .14; if (src === P){ hitsN++; P.hitMark = .12; } if (e.hp <= 0) kill(e, src); }\nfunction kill(e, src){ e.alive = false; e.hp = 0;\n  if (e.kind === 'air'){ e.dead = true; e.spin = (rnd() < .5 ? -1 : 1) * (1.5 + rnd() * 2.5); boom(e.p, e.rad > 15 ? 2.4 : 1.2); }\n  else { boom(madd(e.p, [0, 4, 0], 1), e.type === 'ship' ? 3.2 : (e.type === 'fuel' ? 2.6 : 1.5)); e.smokeT = 30; }\n  if (e.team === 1){ if (src && src.team === 0){ score += e.score; kills++; } if (e.kind === 'air') kmsg(e.type === 'bomber' ? 'BOMBER DOWN' : (e.type === 'ace' ? 'ACE DOWN' : 'SPLASH!'), '#ffe08a'); else kmsg(e.spec.label + ' DESTROYED'); if (!QUIET) sfx('kill'); haptic('success'); }\n  if (e === P){ kmsg('AIRCRAFT LOST', '#ff6a5a'); haptic('error'); } }\nfunction hitSeg(p0, p1, c, r){ var d = sub(p1, p0), m = sub(c, p0), dd = dot(d, d) || 1, t = clamp(dot(m, d) / dd, 0, 1), q = madd(p0, d, t); return dist(q, c) < r ? q : null; }\n// ===================================================================\n// SIMULATION\n// ===================================================================\nfunction updMissiles(dt){ for (var i = MSL.length - 1; i >= 0; i--){ var m = MSL[i], T = m.target, hit = null; m.life -= dt;\n    if (T && (T.life !== undefined ? T.life > 0 : T.alive)){ var D = dist(T.p, m.p), aim = T.v ? madd(T.p, T.v, D / Math.max(m.spd, 1) * .9) : T.p, want = norm(sub(aim, m.p)), ang = Math.acos(clamp(dot(want, m.d), -1, 1));\n      if (ang > 1.7) m.target = null; else if (ang > 1e-4){ var ax = cross(m.d, want), l = len(ax); if (l > 1e-6) m.d = norm(rot(m.d, scl(ax, 1 / l), Math.min(ang, m.turn * dt))); }\n      if (D < (T.rad || 6) + 7 + m.spd * dt * .5) hit = T; } else m.target = null;\n    m.spd = Math.min(m.vmax, m.spd + m.acc * dt); var np = madd(m.p, m.d, m.spd * dt);\n    if (!hit){ var L = m.team === 0 ? targets() : AIR; for (var k = 0; k < L.length; k++){ var o = L[k]; if (o.alive && o.team !== m.team && hitSeg(m.p, np, o.p, o.rad + 3)){ hit = o; break; } } }\n    m.p = np; m.tr += dt; if (m.tr > .025){ m.tr = 0; part(madd(m.p, m.d, -2), [rs() * 2, rs() * 2, rs() * 2], 1.5 + rnd() * .7, 1.6, 6.5, [.92, .92, .9], .5, 1, .3); }\n    var gnd = m.p[1] < Hg(m.p[0], m.p[2]);\n    if (hit || gnd || m.life <= 0){ if (hit && hit.life === undefined) damage(hit, m.dmg, m.owner); if (hit && hit.life !== undefined) hit.life = 0;\n      if (gnd){ var G = m.team === 0 ? GND : []; for (var q = 0; q < G.length; q++) if (G[q].alive && dist(G[q].p, m.p) < G[q].rad + 16) damage(G[q], m.dmg * .7, m.owner); }\n      boom(m.p, hit ? .7 : .5, !hit && !gnd); MSL.splice(i, 1); } } }\nfunction updBullets(dt){ var foes0 = targets(), foes1 = AIR.filter(function(e){ return e.alive && e.team === 0; });\n  for (var i = BUL.length - 1; i >= 0; i--){ var b = BUL[i], np = madd(b.p, b.v, dt), L = b.team === 0 ? foes0 : foes1, done = false; b.life -= dt;\n    for (var k = 0; k < L.length; k++){ var o = L[k], q = hitSeg(b.p, np, o.p, o.rad + (b.team === 0 ? 3 : 0)); if (q){ damage(o, b.dmg, b.owner); part(q, [rs() * 20, rs() * 20, rs() * 20], .25, 2.5, .5, [1, .85, .5], -1, 0); done = true; break; } }\n    if (!done){ var h = Hq(np[0], np[2]); if (np[1] < Math.max(h, 0)){ part([np[0], Math.max(h, 0) + 1, np[2]], [0, 14, 0], .7, 2, 7, h > 0 ? [.55, .5, .4] : [.9, .95, 1], .5, 1, 1); done = true; } }\n    if (done || b.life <= 0) BUL.splice(i, 1); else b.p = np; } }\nfunction updFlares(dt){ for (var i = FLR.length - 1; i >= 0; i--){ var f = FLR[i]; f.life -= dt; f.v[1] -= 30 * dt; f.v = scl(f.v, 1 - dt * .8); f.p = madd(f.p, f.v, dt); f.rad = 4;\n    if (rnd() < .5) part(f.p, [rs() * 3, 4, rs() * 3], .9, 1.2, 4, [.85, .85, .85], .3, 1); if (f.life <= 0 || f.p[1] < Hg(f.p[0], f.p[2])){ f.life = 0; FLR.splice(i, 1); } } }\nfunction updParts(dt){ for (var i = PARTS.length - 1; i >= 0; i--){ var p = PARTS[i]; p.t += dt; if (p.t >= p.life){ PARTS[i] = PARTS[PARTS.length - 1]; PARTS.pop(); continue; }\n    if (p.drag){ var k = 1 - p.drag * dt; p.v[0] *= k; p.v[1] *= k; p.v[2] *= k; } if (p.grav) p.v[1] -= p.grav * dt; p.p[0] += p.v[0] * dt; p.p[1] += p.v[1] * dt; p.p[2] += p.v[2] * dt; } }\nfunction updGround(dt){ for (var i = 0; i < GND.length; i++){ var e = GND[i]; e.flash = Math.max(0, e.flash - dt);\n    if (!e.alive){ if (e.smokeT > 0){ e.smokeT -= dt; if (rnd() < .35) part(madd(e.p, [rs() * 3, 3, rs() * 3], 1), [rs() * 3 + 6, 14 + rnd() * 8, rs() * 3], 3 + rnd() * 2, 5, 22, [.12, .12, .12], .6, 1, .2); if (rnd() < .2) part(madd(e.p, [rs() * 2, 2, rs() * 2], 1), [rs() * 3, 8, rs() * 3], .5, 3, 7, [1, .5, .15], -.8, 0); }\n      if (e.type === 'ship' && e.p[1] > -9) e.p[1] -= dt * .5; continue; }\n    if (e.road){ e.s += e.speed * dt; var rp = roadAt(e.road, e.s); e.p = rp[0]; e.yaw = Math.atan2(rp[1][0], rp[1][2]); e.v = scl(rp[1], e.speed); }\n    if (e.type === 'radar') e.ang += dt * 1.6;\n    if (!P || !P.alive) continue; var D = dist(P.p, e.p);\n    if (e.type === 'sam' || (e.type === 'ship' && e.sam)){ e.cd -= dt; if (D < 2700 && P.p[1] - Hg(P.p[0], P.p[2]) > 70 && e.cd <= 0 && incCount(P) < DIFF.maxInc){ e.cd = DIFF.samCd * (.8 + rnd() * .5); fireMissile(e, P, madd(e.p, [0, 18, 0], 1)); radio('WARNING', 'SAM launch! Break and flare!'); } }\n    if (e.type === 'aaa' || e.type === 'flak' || e.type === 'ship'){ e.cd2 = (e.cd2 || 0) - dt; if (D < 1300){ if (e.burst > 0){ e.burst -= dt; e.gunCd = (e.gunCd || 0) - dt;\n          if (e.gunCd <= 0){ e.gunCd = .11; var aim = norm(sub(madd(P.p, P.v, D / 800), madd(e.p, [0, 5, 0], 1))); aim = norm([aim[0] + rs() * DIFF.spread * 3, aim[1] + rs() * DIFF.spread * 3, aim[2] + rs() * DIFF.spread * 3]);\n            BUL.push({ p: madd(madd(e.p, [0, 5, 0], 1), aim, 5), v: scl(aim, 800), life: 1.7, team: 1, dmg: 1.3, owner: e, red: 1 }); if (!QUIET && rnd() < .25) sfx('gun', dvol(e.p) * .5); } }\n        else if (e.cd2 <= 0){ e.burst = .8; e.cd2 = 3 + rnd() * 2.5; } } } } }\nfunction updAir(dt){ for (var i = AIR.length - 1; i >= 0; i--){ var e = AIR[i]; e.flash = Math.max(0, e.flash - dt);\n    if (e.dead){ e.r = rot(e.r, e.f, e.spin * dt); e.u = rot(e.u, e.f, e.spin * dt); e.f = norm([e.f[0], e.f[1] - dt * .55, e.f[2]]); e.p = madd(e.p, e.f, e.spd * dt);\n      part(e.p, [rs() * 4, rs() * 4, rs() * 4], 1.6 + rnd(), 3, 13, [.13, .13, .13], .65, 1, .3); if (rnd() < .5) part(e.p, [rs() * 5, rs() * 5, rs() * 5], .35, 4, 8, [1, .5, .15], -.9, 0);\n      if (e.p[1] < Hg(e.p[0], e.p[2])){ boom([e.p[0], Hg(e.p[0], e.p[2]) + 2, e.p[2]], 1.8); e.gone = true; e.dead = false; if (e !== P) AIR.splice(i, 1); } continue; }\n    if (!e.alive || e === P) continue; aiAir(e, dt);\n    if (e.hp < e.maxhp * .45 && rnd() < .4) part(e.p, [rs() * 3, rs() * 3, rs() * 3], 1.2, 2, 9, [.2, .2, .2], .5, 1, .3);\n    if (e.p[1] < Hg(e.p[0], e.p[2]) + 2) kill(e, null); } }\nfunction playerCtrl(dt){ var sx = INP.x * (.45 + .55 * Math.abs(INP.x)), sy = (SET.pitch ? -INP.y : INP.y) * (.45 + .55 * Math.abs(INP.y)), rIn, thr = INP.boost ? 1 : (INP.brake ? -1 : .15), yIn = INP.yaw, bank = Math.atan2(-P.r[1], P.u[1]);\n  if (AI0){ var T = P.tgtE, tp = T ? (T.kind === 'gnd' ? madd(T.p, [0, 1, 0], dist(T.p, P.p) > 900 ? 260 : 30) : madd(T.p, T.v, .5)) : [0, 900, 0]; P.lowOK = !!(T && T.kind === 'gnd');\n    P.ext = (P.ext || 0) - dt; if (T && T.kind === 'gnd' && dist(T.p, P.p) < 420 && P.ext <= 0){ P.ext = 7; P.extD = norm([P.f[0], 0, P.f[2]]); } if (P.ext > 2.5){ tp = madd(madd(P.p, P.extD, 900), [0, 1, 0], 420 - P.p[1] + Hg(P.p[0], P.p[2])); P.lowOK = false; }\n    var c = steerTo(P, tp, 1); if (incoming(P) && P.flr > 0 && P.flrCd <= 0) playerFlare(); if (locked && rnd() < .05) playerMissile(); INP.gun = T && dist(T.p, P.p) < 900 && dot(norm(sub(T.p, P.p)), P.f) > .99 ? 1 : 0;\n    flyStep(P, c[0], c[1], c[2], dist(tp, P.p) > 900 ? 1 : 0, dt); return; }\n  var out = Math.max(Math.abs(P.p[0]), Math.abs(P.p[2])) > HALF * 1.22;\n  if (out){ var c2 = steerTo(P, [0, P.p[1], 0], 1); P.outside = true; flyStep(P, c2[0], c2[1], c2[2], thr, dt); return; } P.outside = false;\n  if (SET.assist === 0 && Math.abs(P.f[1]) < .82) rIn = clamp((sx * 1.3 - bank) * 2.8, -1, 1); else rIn = sx;\n  flyStep(P, sy, rIn, yIn, thr, dt);\n  if (Math.abs(sy) > .6 && P.spd > 150){ part(madd(madd(P.p, P.r, 7.3), P.f, -5), scl(P.v, .1), .55, .5, 2.2, [1, 1, 1], .28, 1); part(madd(madd(P.p, P.r, -7.3), P.f, -5), scl(P.v, .1), .55, .5, 2.2, [1, 1, 1], .28, 1); } }\nfunction step(dt){ simT += dt; SHAKE = Math.max(0, SHAKE - dt * 2.2); hurtA = Math.max(0, hurtA - dt * 1.3);\n  for (var i = MSGS.length - 1; i >= 0; i--) if ((MSGS[i].t -= dt) <= 0) MSGS.splice(i, 1); for (i = KMSG.length - 1; i >= 0; i--) if ((KMSG[i].t -= dt) <= 0) KMSG.splice(i, 1);\n  if (phase === 'play' || phase === 'dead' || phase === 'end'){\n    if (P && P.alive){ playerCtrl(dt); playerFire(dt); updLock(dt); P.muzzle = Math.max(0, (P.muzzle || 0) - dt); P.hitMark = Math.max(0, (P.hitMark || 0) - dt);\n      if (P.hp < P.maxhp * .4 && rnd() < .5) part(madd(P.p, P.f, -6), [rs() * 3, rs() * 3, rs() * 3], 1.3, 2, 9, [.18, .18, .18], .5, 1, .3);\n      if (P.p[1] < Hg(P.p[0], P.p[2]) + 2.5){ P.hp = 0; kill(P, null); P.dead = false; P.gone = true; boom(P.p, 2); } if (P.p[1] > 3000) P.f = norm([P.f[0], P.f[1] - dt, P.f[2]]); }\n    updAir(dt); updGround(dt); updMissiles(dt); updBullets(dt); updFlares(dt);\n    if (phase === 'play'){ M.t += dt; missionTick(dt); if (!P.alive){ phase = 'dead'; endT = 2.8; M.result = 'lost'; M.why = 'Your aircraft was destroyed.'; } }\n    else if ((endT -= dt) <= 0) finish(); }\n  updParts(dt); }\n\n// ---------- roads ----------\nfunction makeRoad(a, b){ var pts = [a], n = 5, i; for (i = 1; i < n; i++){ var t = i / n, s = findSite(lerp(a[0], b[0], t) + rs() * 150, lerp(a[2], b[2], t) + rs() * 150, false, 30); pts.push(s); } pts.push(b);\n  var S = [], L = [0]; for (i = 0; i < pts.length - 1; i++){ var p0 = pts[Math.max(i - 1, 0)], p1 = pts[i], p2 = pts[i + 1], p3 = pts[Math.min(i + 2, pts.length - 1)];\n    for (var k = 0; k < 24; k++){ var u = k / 24, u2 = u * u, u3 = u2 * u, x = .5 * (2 * p1[0] + (p2[0] - p0[0]) * u + (2 * p0[0] - 5 * p1[0] + 4 * p2[0] - p3[0]) * u2 + (3 * p1[0] - p0[0] - 3 * p2[0] + p3[0]) * u3),\n        z = .5 * (2 * p1[2] + (p2[2] - p0[2]) * u + (2 * p0[2] - 5 * p1[2] + 4 * p2[2] - p3[2]) * u2 + (3 * p1[2] - p0[2] - 3 * p2[2] + p3[2]) * u3); S.push([x, Math.max(Hq(x, z), 2) + .7, z]); } }\n  S.push([b[0], Math.max(b[1], 2) + .7, b[2]]); for (i = 1; i < S.length; i++) L.push(L[i - 1] + dist(S[i], S[i - 1]));\n  var m = [], C = [.2, .2, .22]; for (i = 0; i < S.length - 1; i++){ var d0 = norm(sub(S[Math.min(i + 1, S.length - 1)], S[Math.max(i - 1, 0)])), d1 = norm(sub(S[Math.min(i + 2, S.length - 1)], S[i])), s0 = [d0[2] * 7, 0, -d0[0] * 7], s1 = [d1[2] * 7, 0, -d1[0] * 7];\n    quad(m, sub(S[i], s0), add(S[i], s0), add(S[i + 1], s1), sub(S[i + 1], s1), C); }\n  return { S: S, L: L, len: L[L.length - 1], mesh: upload(m) }; }\nfunction roadAt(R, s){ s = clamp(s, 0, R.len - .01); var lo = 0, hi = R.L.length - 1; while (hi - lo > 1){ var mid = (lo + hi) >> 1; if (R.L[mid] > s) hi = mid; else lo = mid; }\n  var t = (s - R.L[lo]) / ((R.L[hi] - R.L[lo]) || 1), a = R.S[lo], b = R.S[hi]; return [[lerp(a[0], b[0], t), lerp(a[1], b[1], t) - .6, lerp(a[2], b[2], t)], norm(sub(b, a))]; }\n// ===================================================================\n// MISSIONS\n// ===================================================================\nfunction spawnAir(type, p, yaw, x){ return makeAir(UNITS[type], 1, p, yaw, x); }\nfunction ring(c, r, alt, i, n){ var a = i / n * TAU + .4; return [c[0] + Math.cos(a) * r, alt, c[2] + Math.sin(a) * r]; }\nfunction fightersFrom(n, type, c, r, x){ for (var i = 0; i < n; i++){ var p = ring(c, r, 700 + rnd() * 500, i + rnd() * .3, Math.max(n, 5)); spawnAir(type, p, Math.atan2(c[0] - p[0], c[2] - p[2]), x); } }\nfunction base(cx, cz, list, prim){ var out = []; list.forEach(function(t, i){ var s = findSite(cx + Math.cos(i * 2.4) * 90 * (1 + i * .25), cz + Math.sin(i * 2.4) * 90 * (1 + i * .25), false); out.push(makeGnd(t, s, rnd() * TAU, { primary: prim.indexOf(t) >= 0 })); }); return out; }\nvar MIS = [\n  { id: 'm1', name: 'First Light', short: 'Shakedown flight. Target drones, then a surprise.', par: 150,\n    text: 'Shakedown flight over the Larkspur Isles. Control has put five target drones in the air over the central island. Lock on, fire, and get a feel for your jet before the real thing.',\n    obj: ['Destroy the 5 target drones', 'Deal with anything else that shows up'],\n    setup: function(){ var c = [0, 0, 300]; for (var i = 0; i < 5; i++){ var p = ring(c, 700 + i * 90, 520 + i * 60, i, 5); spawnAir('drone', p, rnd() * 6, { primary: true, orb: [c[0], Math.max(p[1], 620), c[2]], orbR: 700 + i * 90 }); }\n      radio('CONTROL', 'Drones are up. Point your nose at one until the box turns red, then fire a missile.'); },\n    tick: function(){ if (!M.w1 && left() === 0){ M.w1 = true; M.hold = false; fightersFrom(2, 'fighter', P.p, 2300, { primary: true }); radio('CONTROL', 'Contact! Two bandits inbound, this is not a drill. Weapons free.'); } }, hold: true },\n  { id: 'm2', name: 'Iron Coast', short: 'Blind the enemy: radar and missile sites.', par: 240,\n    text: 'An air-defence network guards the eastern shore. Knock out both radar stations and the three missile batteries around them. Stay low on the way in: the batteries cannot see you under 70 metres.',\n    obj: ['Destroy 2 radar stations', 'Destroy 3 SAM batteries'],\n    setup: function(){ base(1300, 1400, ['radar', 'sam', 'aaa', 'bunker', 'sam'], ['radar', 'sam']); base(-900, 2100, ['radar', 'sam', 'aaa', 'fuel', 'fuel'], ['radar', 'sam']); fightersFrom(2, 'fighter', [300, 0, 1800], 900);\n      radio('CONTROL', 'Two radar sites, three batteries. Expect a welcome party.'); },\n    tick: function(){ if (!M.w1 && left() <= 2){ M.w1 = true; fightersFrom(2, 'fighter', P.p, 2400); radio('CONTROL', 'More fighters scrambling from the north.'); } } },\n  { id: 'm3', name: 'Convoy Run', short: 'Stop an armoured column before it reaches port.', par: 230,\n    text: 'An armoured column is rolling across the main island toward the port. If it gets there, it ships out. Destroy every vehicle on the road before the lead truck reaches the docks.',\n    obj: ['Destroy all 6 convoy vehicles', 'Do not let the convoy reach port'],\n    setup: function(){ var a = findSite(-2300, -300, false), b = findSite(2300, 1500, false), R = makeRoad(a, b); M.road = R; var sp = R.len * .62 / 235;\n      ['tank', 'truck', 'flak', 'truck', 'truck', 'tank'].forEach(function(t, i){ makeGnd(t, a, 0, { primary: true, road: R, s: 300 - i * 52, speed: sp }); }); fightersFrom(2, 'fighter', a, 1400);\n      radio('CONTROL', 'Convoy is on the move. Follow the road east and you will find it.'); },\n    tick: function(){ var lead = 0; GND.forEach(function(e){ if (e.alive && e.road) lead = Math.max(lead, e.s / e.road.len); }); M.prog = lead; if (lead >= .995) fail('The convoy reached the port.');\n      if (!M.w1 && left() <= 3){ M.w1 = true; fightersFrom(2, 'fighter', P.p, 2400); radio('CONTROL', 'They have called for air cover. Bandits inbound.'); } } },\n  { id: 'm4', name: 'Shepherd', short: 'Escort a transport through hostile sky.', par: 150,\n    text: 'Transport Shepherd is carrying evacuees north across the strait. It is slow and unarmed. Stay close and shoot down anything that goes for it. The mission is over when Shepherd is safe, or lost.',\n    obj: ['Protect transport Shepherd until it clears the islands'],\n    setup: function(){ M.tr = makeAir(UNITS.transport, 0, [-500, 620, -3000], 0, { path: [[-1700, 620, -1200], [-200, 650, 400], [1700, 650, 1500], [700, 650, 3300]] }); M.hold = true; M.waves = [[6, 3, 'fighter'], [38, 3, 'fighter'], [72, 2, 'ace']];\n      radio('SHEPHERD', 'Shepherd is airborne. Glad to have you on our wing.'); },\n    tick: function(){ var T = M.tr; if (!T.alive) return fail('Shepherd was shot down.'); if (T.arrived){ M.hold = false; AIR.forEach(function(e){ if (e.team === 1 && e.alive) e.primary = false; }); return win(); }\n      while (M.waves.length && M.t > M.waves[0][0]){ var w = M.waves.shift(); fightersFrom(w[1] - 1, w[2], T.p, 2300, { pref: 'transport' }); fightersFrom(1, w[2], T.p, 2500); radio('SHEPHERD', w[2] === 'ace' ? 'Black jets closing fast! Keep them off us!' : 'Bandits on the scope, they are coming for us!'); }\n      if (T.hp < T.maxhp * .5 && !M.half){ M.half = true; radio('SHEPHERD', 'We are taking heavy fire! One engine out!'); } } },\n  { id: 'm5', name: 'Harbour Strike', short: 'Three warships and the guns that guard them.', par: 270,\n    text: 'Three warships are sheltering in the northern bay under the cover of shore batteries. Sink all three. Their decks carry anti-aircraft guns and one has missiles, so keep moving and use your flares.',\n    obj: ['Sink 3 warships', 'Destroy 2 shore SAM batteries'],\n    setup: function(){ var c = findSite(-300, 2300, true); for (var i = 0; i < 3; i++){ var s = i ? findSite(c[0] + (i === 1 ? 420 : -380), c[2] + 160 * i, true) : c; makeGnd('ship', s, rnd() * TAU, { primary: true, sam: i === 0 }); }\n      base(c[0] + 700, c[2] - 300, ['sam', 'fuel', 'fuel', 'aaa'], ['sam']); base(c[0] - 800, c[2] - 200, ['sam', 'bunker', 'fuel'], ['sam']); fightersFrom(3, 'fighter', c, 1100);\n      radio('CONTROL', 'Ships are in the bay. Hit them hard and get out.'); },\n    tick: function(){ if (!M.w1 && left() <= 2){ M.w1 = true; fightersFrom(1, 'ace', P.p, 2400); fightersFrom(1, 'fighter', P.p, 2600); radio('CONTROL', 'Careful, one of those is flying like an ace.'); } } },\n  { id: 'm6', name: 'Skybreaker', short: 'A heavy bomber and its ace escort.', par: 190,\n    text: 'A heavy bomber is inbound for the southern islands with four black-painted aces flying escort. If the bomber gets through, everything we defended is gone. Bring it down, and the aces with it.',\n    obj: ['Shoot down the bomber before it reaches the south', 'Shoot down all 4 aces'],\n    setup: function(){ var b = makeAir(UNITS.bomber, 1, [1500, 1150, 3500], PI, { primary: true, path: [[2400, 1150, 1200], [-600, 1150, 200], [-2400, 1150, -1000], [-800, 1150, -2600], [900, 1150, -3700]] }); M.bm = b;\n      for (var i = 0; i < 4; i++) spawnAir('ace', [1500 + (i - 1.5) * 150, 1250, 3300 - Math.abs(i - 1.5) * 90], PI, { primary: true }).ai.mcd = 11 + i * 5;\n      radio('CONTROL', 'This is the big one. Kill the bomber. Good hunting.'); },\n    tick: function(){ if (M.bm.alive && M.bm.arrived) fail('The bomber reached its target.'); if (!M.bmd && !M.bm.alive){ M.bmd = true; radio('CONTROL', 'Bomber is down! Clean up the escort.'); } } }\n];\nvar SURV = { id: 'sv', name: 'Survival', surv: true, par: 0, text: 'No objectives and no end. Waves of fighters keep coming, each one bigger than the last. Your hull is patched and missiles topped up a little between waves. See how long you last.', obj: ['Survive as many waves as you can'],\n  setup: function(){ M.wave = 0; M.hold = true; M.gap = 2; },\n  tick: function(dt){ var n = 0; AIR.forEach(function(e){ if (e.team === 1 && e.alive) n++; }); if (n) return; M.gap -= dt; if (M.gap > 0) return; M.gap = 4; M.wave++;\n    if (M.wave > 1){ P.hp = Math.min(P.maxhp, P.hp + P.maxhp * .3); P.mslLeft += 14; P.flr += 6; score += 500; }\n    fightersFrom(1 + Math.ceil(M.wave * .8), 'fighter', P.p, 2400); if (M.wave >= 3) fightersFrom(Math.floor(M.wave / 3), 'ace', P.p, 2700); kmsg('WAVE ' + M.wave, '#9fffe0'); } };\nfunction left(){ var n = 0; AIR.forEach(function(e){ if (e.primary && e.alive) n++; }); GND.forEach(function(e){ if (e.primary && e.alive) n++; }); return n; }\nfunction total(){ var n = 0; AIR.forEach(function(e){ if (e.primary) n++; }); GND.forEach(function(e){ if (e.primary) n++; }); return n + (M.downed || 0); }\nfunction fail(why){ if (phase !== 'play') return; phase = 'end'; endT = 2.2; M.result = 'lost'; M.why = why; kmsg('MISSION FAILED', '#ff6a5a'); }\nfunction win(){ if (phase !== 'play') return; phase = 'end'; endT = 3; M.result = 'won'; kmsg('MISSION COMPLETE', '#9fffe0'); radio('CONTROL', 'Outstanding work. Come on home.'); }\nfunction missionTick(dt){ M.def.tick(dt); if (phase !== 'play') return; if (!M.hold && left() === 0) win(); }\nfunction startMission(def){ AIR = []; GND = []; MSL = []; BUL = []; FLR = []; PARTS = []; MSGS = []; KMSG = []; USED = []; score = kills = shots = hitsN = taken = 0; lockT = 0; locked = false; SHAKE = hurtA = 0; DIFF = DIFFS[SET.diff];\n  M = { def: def, t: 0, hold: !!def.hold, result: null }; var pl = PLANES[SET.jet];\n  P = makeAir(pl, 0, def.id === 'm4' ? [-500, 660, -3250] : [0, 680, -3300], 0); INP.x = INP.y = INP.yaw = INP.gun = INP.boost = INP.brake = 0;\n  def.setup(); nextTarget(false); phase = 'play'; camSnap(); }\nfunction finish(){ var won = M.result === 'won', d = M.def, t = M.t, rank = '-';\n  if (d.surv){ score += 0; if (score > (SAVE.surv || 0)) SAVE.surv = score; rank = M.wave >= 8 ? 'S' : M.wave >= 6 ? 'A' : M.wave >= 4 ? 'B' : 'C'; won = true; }\n  else if (won){ var pts = clamp(P.hp / P.maxhp, 0, 1) * 55 + clamp((d.par * 1.6 - t) / d.par, 0, 1) * 45; rank = pts >= 80 ? 'S' : pts >= 60 ? 'A' : pts >= 38 ? 'B' : 'C';\n    score += Math.round(P.hp / P.maxhp * 1000) + Math.round(clamp((d.par * 1.6 - t) / d.par, 0, 1) * 1500); var i = MIS.indexOf(d), b = SAVE.best[d.id];\n    if (!b || score > b.score) SAVE.best[d.id] = { score: score, rank: (b && 'SABC'.indexOf(b.rank) < 'SABC'.indexOf(rank)) ? b.rank : rank }; if (i + 2 > SAVE.unl) SAVE.unl = Math.min(MIS.length, i + 2); }\n  saveAll(); phase = 'over'; showDebrief(won, rank); }\n// ===================================================================\n// RENDER\n// ===================================================================\nvar W = 1, H = 1, DPR = 1, PR = new Float32Array(16), VM = new Float32Array(16), VP = new Float32Array(16), TM = new Float32Array(16), FOV = 1.1, camP = [0, 700, -3340], camU = [0, 1, 0], DBG = null, hangA = 0;\nvar hudC = el('hud'), HX = hudC.getContext('2d');\nfunction resize(){ W = window.innerWidth; H = window.innerHeight; DPR = Math.min(window.devicePixelRatio || 1, SET.quality ? 2 : 1.25); canvas.width = Math.round(W * DPR); canvas.height = Math.round(H * DPR);\n  var hd = Math.min(window.devicePixelRatio || 1, 2); hudC.width = Math.round(W * hd); hudC.height = Math.round(H * hd); hudC._d = hd; }\nwindow.addEventListener('resize', resize);\nvar CLOUDS = (function(){ var a = [], s = 99; function r(){ s = (s * 16807) % 2147483647; return s / 2147483647; }\n  for (var i = 0; i < 46; i++){ var c = [(r() * 2 - 1) * HALF * 1.6, 1150 + r() * 900, (r() * 2 - 1) * HALF * 1.5], n = 5 + (r() * 5 | 0), sz = 240 + r() * 240;\n    for (var k = 0; k < n; k++){ var dy = (r() - .4) * sz * .35; a.push({ p: [c[0] + (r() * 2 - 1) * sz * 1.1, c[1] + dy, c[2] + (r() * 2 - 1) * sz * 1.1], s: sz * (.7 + r() * .6), sh: clamp(.86 + dy / sz * .5, .72, 1) }); } }\n  return a; })();\nfunction camSnap(){ if (!P) return; camP = madd(madd(P.p, P.f, -30), P.u, 8); camU = P.u.slice(); }\nfunction setCam(dt){ var f, u;\n  if (DBG){ camP = DBG.p; f = norm(sub(DBG.t, DBG.p)); u = [0, 1, 0]; FOV = DBG.fov || 1.0; }\n  else if (CAMMODE === 1 && P.alive){ camP = madd(madd(P.p, P.f, 5.2), P.u, 1.35); f = P.f; u = P.u; FOV = 1.2; }\n  else { var k = 1 - Math.exp(-dt * 7), want = madd(madd(P.p, P.f, -22 - (P.thr > .5 ? 4 : 0)), P.u, 5.5); if (!P.alive) want = camP;\n    camP = [lerp(camP[0], want[0], k), lerp(camP[1], want[1], k), lerp(camP[2], want[2], k)]; var d = sub(camP, P.p), L = len(d); if (L > 60 && P.alive) camP = madd(P.p, d, 60 / L);\n    camU = norm([lerp(camU[0], P.u[0], k * .7), lerp(camU[1], P.u[1] * .9 + .1, k * .7), lerp(camU[2], P.u[2], k * .7)]);\n    f = norm(sub(madd(P.p, P.f, 90), camP)); u = camU; FOV = lerp(FOV, 1.0 + clamp((P.spd - P.spec.cruise) / 300, -.1, .3), k * .5); }\n  var g = Hg(camP[0], camP[2]) + 3; if (camP[1] < g) camP[1] = g;\n  if (SHAKE > 0) camP = add(camP, [rs() * SHAKE, rs() * SHAKE, rs() * SHAKE]);\n  CF = f; CR = norm(cross(f, u)); CU = cross(CR, CF); CP = camP;\n  persp(PR, FOV, W / H, 2, 30000); viewM(VM, CP, CR, CU, CF); mul4(VP, PR, VM); }\nfunction modelM(p, r, u, f, s){ var m = TM; m[0] = r[0] * s; m[1] = r[1] * s; m[2] = r[2] * s; m[3] = 0; m[4] = u[0] * s; m[5] = u[1] * s; m[6] = u[2] * s; m[7] = 0; m[8] = f[0] * s; m[9] = f[1] * s; m[10] = f[2] * s; m[11] = 0; m[12] = p[0]; m[13] = p[1]; m[14] = p[2]; m[15] = 1; return m; }\nfunction drawMesh(mesh, M4, spec, panel, flash, tint){ gl.uniformMatrix4fv(PM.u('uM'), false, M4); gl.uniform1f(PM.u('uSpec'), spec); gl.uniform1f(PM.u('uPanel'), panel); gl.uniform1f(PM.u('uFlash'), flash); gl.uniform3fv(PM.u('uTint'), tint || [1, 1, 1]);\n  gl.bindBuffer(gl.ARRAY_BUFFER, mesh.buf); gl.vertexAttribPointer(0, 3, gl.FLOAT, false, 36, 0); gl.vertexAttribPointer(1, 3, gl.FLOAT, false, 36, 12); gl.vertexAttribPointer(2, 3, gl.FLOAT, false, 36, 24); gl.drawArrays(gl.TRIANGLES, 0, mesh.n); }\nfunction yawBasis(y){ var f = [Math.sin(y), 0, Math.cos(y)]; return [norm(cross(f, [0, 1, 0])), [0, 1, 0], f]; }\nfunction burner(e, noz, ny, nz, nr){ var k = e.thr > .5 ? 1 : (e.thr < 0 ? .25 : .5), i; for (var n = 0; n < noz.length; n++){ var b = madd(madd(madd(e.p, e.r, noz[n] * e.scale), e.u, ny * e.scale), e.f, nz * e.scale);\n    for (i = 0; i < 4; i++) sprite(madd(b, e.f, -i * 1.5 * k * e.scale), nr * (1.5 - i * .25) * e.scale * (.8 + k * .5), i < 2 ? [1, .8, .55] : [1, .45, .2], -(.75 - i * .14) * (.5 + k * .5), 0); } }\nfunction render(dt){ gl.viewport(0, 0, canvas.width, canvas.height);\n  if (phase === 'hangar'){ return renderHangar(dt); }\n  if (!P || phase === 'menu' || phase === 'select' || phase === 'settings'){ gl.clearColor(0, 0, 0, 0); gl.clear(gl.COLOR_BUFFER_BIT); return; }\n  setCam(dt); gl.clearColor(.5, .6, .7, 1); gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT); gl.disable(gl.BLEND); gl.disable(gl.CULL_FACE);\n  gl.activeTexture(gl.TEXTURE0); gl.bindTexture(gl.TEXTURE_2D, TSKY);\n  // sky\n  gl.disable(gl.DEPTH_TEST); gl.depthMask(false); setCommon(PS, CP); var tn = Math.tan(FOV / 2); gl.uniform3fv(PS.u('uRx'), CR); gl.uniform3fv(PS.u('uRy'), CU); gl.uniform3fv(PS.u('uRz'), CF); gl.uniform2f(PS.u('uTan'), tn * W / H, tn);\n  gl.bindBuffer(gl.ARRAY_BUFFER, QUADB); gl.enableVertexAttribArray(0); gl.disableVertexAttribArray(1); gl.disableVertexAttribArray(2); gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0); gl.drawArrays(gl.TRIANGLES, 0, 6);\n  gl.enable(gl.DEPTH_TEST); gl.depthMask(true);\n  // terrain\n  setCommon(PT, CP); gl.uniformMatrix4fv(PT.u('uVP'), false, VP); gl.activeTexture(gl.TEXTURE1); gl.bindTexture(gl.TEXTURE_2D, TGRASS); gl.uniform1i(PT.u('uG'), 1); gl.activeTexture(gl.TEXTURE2); gl.bindTexture(gl.TE