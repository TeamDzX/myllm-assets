{"name": "Contrail Strike", "kind": "html", "iconSymbol": "airplane", "iconColor": "teal", "html": "<!doctype html>\n<!--\n  Contrail Strike — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html lang=\"en\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover\">\n<title>Contrail Strike</title>\n<style>\n*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}\nhtml,body{height:100%;overflow:hidden;background:#0a1016;color:#eaf6ff;font-family:-apple-system,system-ui,\"Segoe UI\",sans-serif;color-scheme:dark}\n#bg{position:fixed;inset:0;z-index:0;background:#0a1016 center/cover no-repeat}\n#bg.soft{filter:brightness(.42) blur(7px);transform:scale(1.06)}\n#gl,#hud{position:fixed;inset:0;width:100%;height:100%;display:block}\n#gl{z-index:1;touch-action:none}\n#hud{z-index:3;pointer-events:none}\n.hidden{display:none!important}\n#err{position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;padding:30px;text-align:center;background:#0a1016}\n.scr{position:fixed;inset:0;z-index:10;display:flex;flex-direction:column;gap:12px;overflow:auto;-webkit-overflow-scrolling:touch;\n  padding:calc(16px + env(safe-area-inset-top)) calc(20px + env(safe-area-inset-right)) calc(16px + env(safe-area-inset-bottom)) calc(20px + env(safe-area-inset-left))}\n.shade{background:linear-gradient(90deg,rgba(5,12,18,.88) 0%,rgba(5,12,18,.55) 45%,rgba(5,12,18,.05) 100%)}\n.dim{background:rgba(5,11,16,.78)}\n.btn{appearance:none;-webkit-appearance:none;border:1px solid rgba(140,255,215,.32);background:rgba(8,22,30,.66);color:#e6fff5;font:inherit;font-weight:800;letter-spacing:.14em;text-transform:uppercase;\n  padding:12px 20px;border-radius:10px;font-size:13px;cursor:pointer;-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);text-align:left}\n.btn.pri{background:linear-gradient(180deg,#3fe6b6,#1c9c88);color:#03231c;border-color:transparent}\n.btn:active{transform:scale(.97)}\n.btn.sm{padding:8px 14px;font-size:11px}\n.btn.on{border-color:#3fe6b6;box-shadow:inset 0 0 0 1px #3fe6b6;color:#9fffe0}\nh1.title{font-size:clamp(34px,7.4vw,76px);font-weight:900;font-style:italic;letter-spacing:.03em;line-height:.92;text-shadow:0 4px 30px rgba(0,0,0,.7)}\nh1.title span{color:#3fe6b6}\n.sub{font-size:12px;letter-spacing:.34em;text-transform:uppercase;opacity:.8;font-weight:700}\nh2{font-size:22px;font-weight:900;font-style:italic;letter-spacing:.08em;text-transform:uppercase}\n.col{display:flex;flex-direction:column;gap:9px;width:min(280px,70vw)}\n.row{display:flex;gap:9px;flex-wrap:wrap;align-items:center}\n.grow{flex:1}\n.note{font-size:12px;opacity:.72;line-height:1.45}\n.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px}\n.card{border:1px solid rgba(140,255,215,.25);background:rgba(8,22,30,.72);border-radius:12px;padding:12px 14px;display:flex;flex-direction:column;gap:5px;cursor:pointer;-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);min-height:92px;position:relative}\n.card b{font-size:15px;letter-spacing:.1em;font-style:italic}\n.card i{font-style:normal;font-size:11px;letter-spacing:.2em;opacity:.6}\n.card p{font-size:12px;opacity:.75;line-height:1.35}\n.card.lock{opacity:.42;cursor:default}\n.card .rk{position:absolute;right:12px;top:8px;font-size:26px;font-weight:900;font-style:italic;color:#ffc857}\n#briefBox{display:flex;gap:18px;flex:1;min-height:0}\n#briefTxt{flex:1;display:flex;flex-direction:column;gap:10px;min-width:0;overflow:auto}\n#briefTxt p{font-size:14px;line-height:1.5;opacity:.9}\n#briefTxt li{font-size:13px;line-height:1.6;margin-left:18px;color:#9fffe0}\n#mapC{height:100%;max-height:62vh;aspect-ratio:1;border:1px solid rgba(140,255,215,.4);border-radius:10px;background:#04121a;align-self:center;max-width:44vw}\n.stat{display:grid;grid-template-columns:74px 1fr;gap:8px;align-items:center;font-size:11px;letter-spacing:.14em;text-transform:uppercase}\n.bar{height:7px;border-radius:4px;background:rgba(255,255,255,.14);overflow:hidden}.bar u{display:block;height:100%;background:#3fe6b6}\n.center{align-items:center;justify-content:center;text-align:center}\n.panel{border:1px solid rgba(140,255,215,.3);background:rgba(6,18,25,.86);border-radius:16px;padding:20px 26px;display:flex;flex-direction:column;gap:10px;min-width:min(340px,86vw);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}\n.panel .btn{text-align:center}\n#rank{font-size:72px;font-weight:900;font-style:italic;color:#ffc857;line-height:1}\n.kv{display:grid;grid-template-columns:1fr auto;gap:4px 26px;font-size:13px;text-align:left;font-variant-numeric:tabular-nums}\n.kv span:nth-child(odd){opacity:.7;letter-spacing:.12em;text-transform:uppercase;font-size:11px;align-self:center}\n/* touch pad */\n#pad{position:fixed;inset:0;z-index:5;pointer-events:none}\n#pad .tb{position:absolute;pointer-events:auto;border-radius:50%;border:1.5px solid rgba(160,255,215,.55);background:rgba(10,30,36,.34);color:#d6fff0;font-weight:800;font-size:11px;letter-spacing:.1em;display:flex;align-items:center;justify-content:center;touch-action:none}\n#pad .tb.dn{background:rgba(63,230,182,.42)}\n#bGun{width:84px;height:84px;right:calc(18px + env(safe-area-inset-right));bottom:calc(20px + env(safe-area-inset-bottom));border-color:rgba(255,200,90,.8)!important}\n#bMsl{width:74px;height:74px;right:calc(112px + env(safe-area-inset-right));bottom:calc(14px + env(safe-area-inset-bottom));border-color:rgba(255,110,90,.85)!important}\n#bFlr{width:54px;height:54px;right:calc(98px + env(safe-area-inset-right));bottom:calc(98px + env(safe-area-inset-bottom))}\n#bTgt{width:54px;height:54px;right:calc(26px + env(safe-area-inset-right));bottom:calc(114px + env(safe-area-inset-bottom))}\n#bBst{width:54px;height:54px;right:calc(20px + env(safe-area-inset-right));bottom:calc(180px + env(safe-area-inset-bottom))}\n#bBrk{width:54px;height:54px;right:calc(84px + env(safe-area-inset-right));bottom:calc(166px + env(safe-area-inset-bottom))}\n#bPause{position:fixed;z-index:6;top:calc(8px + env(safe-area-inset-top));left:50%;transform:translateX(-50%);width:40px;height:30px;border-radius:8px;border:1px solid rgba(160,255,215,.4);background:rgba(8,22,30,.5);color:#d6fff0;font-weight:900;font-size:12px}\n#hurt{position:fixed;inset:0;z-index:4;pointer-events:none;opacity:0;background:radial-gradient(ellipse at center,transparent 45%,rgba(255,40,30,.55) 100%)}\n@media (max-height:430px){.scr{gap:8px}h1.title{font-size:clamp(30px,6vw,54px)}.btn{padding:9px 16px}}\n</style><style>:root{--build-id:\"4c9025355e\";--grain:0.608412873207;}</style>\n</head><body>\n<div id=\"bg\"></div>\n<canvas id=\"gl\"></canvas>\n<canvas id=\"hud\"></canvas>\n<div id=\"hurt\"></div>\n<div id=\"pad\" class=\"hidden\">\n  <div class=\"tb\" id=\"bBrk\">BRAKE</div><div class=\"tb\" id=\"bBst\">BOOST</div>\n  <div class=\"tb\" id=\"bTgt\">TGT</div><div class=\"tb\" id=\"bFlr\">FLARE</div>\n  <div class=\"tb\" id=\"bMsl\">MSL</div><div class=\"tb\" id=\"bGun\">GUN</div>\n</div>\n<button id=\"bPause\" class=\"hidden\">II</button>\n\n<div id=\"menu\" class=\"scr shade\">\n  <div class=\"sub\">Arcade air combat</div>\n  <h1 class=\"title\">CONTRAIL<br><span>STRIKE</span></h1>\n  <div class=\"grow\"></div>\n  <div class=\"col\">\n    <button class=\"btn pri\" id=\"goCamp\">Campaign</button>\n    <button class=\"btn\" id=\"goSurv\">Survival</button>\n    <button class=\"btn\" id=\"goHangar\">Hangar</button>\n    <button class=\"btn\" id=\"goSet\">Settings</button>\n  </div>\n  <div class=\"note\" id=\"recLine\"></div>\n</div>\n\n<div id=\"select\" class=\"scr dim hidden\">\n  <div class=\"row\"><button class=\"btn sm\" data-back>‹ Back</button><h2>Campaign</h2></div>\n  <div class=\"grid\" id=\"misGrid\"></div>\n</div>\n\n<div id=\"hangar\" class=\"scr hidden\">\n  <div class=\"row\"><button class=\"btn sm\" data-back>‹ Back</button><h2>Hangar</h2></div>\n  <div class=\"grow\"></div>\n  <div class=\"row\" style=\"align-items:flex-end\">\n    <div class=\"col\" id=\"jetList\"></div>\n    <div class=\"grow\"></div>\n    <div class=\"panel\" style=\"min-width:min(300px,50vw)\"><b id=\"jetName\" style=\"font-size:18px;font-style:italic;letter-spacing:.1em\"></b><div class=\"note\" id=\"jetDesc\"></div><div id=\"jetStats\" style=\"display:flex;flex-direction:column;gap:6px\"></div></div>\n  </div>\n</div>\n\n<div id=\"settings\" class=\"scr dim hidden\">\n  <div class=\"row\"><button class=\"btn sm\" data-back>‹ Back</button><h2>Settings</h2></div>\n  <div class=\"col\" style=\"width:min(520px,92vw)\">\n    <div class=\"row\"><span class=\"note\" style=\"width:90px\">Controls</span><button class=\"btn sm\" id=\"sAs0\">Novice</button><button class=\"btn sm\" id=\"sAs1\">Expert</button></div>\n    <div class=\"note\" id=\"asNote\"></div>\n    <div class=\"row\"><span class=\"note\" style=\"width:90px\">Pitch</span><button class=\"btn sm\" id=\"sPi0\">Up = climb</button><button class=\"btn sm\" id=\"sPi1\">Flight stick</button></div>\n    <div class=\"row\"><span class=\"note\" style=\"width:90px\">Difficulty</span><button class=\"btn sm\" id=\"sD0\">Easy</button><button class=\"btn sm\" id=\"sD1\">Normal</button><button class=\"btn sm\" id=\"sD2\">Hard</button></div>\n    <div class=\"row\"><span class=\"note\" style=\"width:90px\">Graphics</span><button class=\"btn sm\" id=\"sQ0\">Smooth</button><button class=\"btn sm\" id=\"sQ1\">Sharp</button></div>\n    <div class=\"row\"><span class=\"note\" style=\"width:90px\">Sound</span><button class=\"btn sm\" id=\"sSnd\">On</button></div>\n    <div class=\"note\">Keyboard: arrows or WASD fly · Q/E rudder · Space guns · F or Enter missile · X flares · T next target · Shift boost · Z brake · C camera · P pause.</div>\n  </div>\n</div>\n\n<div id=\"brief\" class=\"scr dim hidden\">\n  <div class=\"row\"><button class=\"btn sm\" data-back>‹ Back</button><div class=\"sub\" id=\"brNo\"></div></div>\n  <div id=\"briefBox\">\n    <div id=\"briefTxt\"><h2 id=\"brName\"></h2><p id=\"brText\"></p><ul id=\"brObj\"></ul><div class=\"grow\"></div>\n      <div class=\"row\"><button class=\"btn pri\" id=\"brGo\">Launch</button><span class=\"note\" id=\"brJet\"></span></div></div>\n    <canvas id=\"mapC\" width=\"512\" height=\"512\"></canvas>\n  </div>\n</div>\n\n<div id=\"pause\" class=\"scr dim center hidden\">\n  <div class=\"panel\"><h2>Paused</h2><button class=\"btn pri\" id=\"pResume\">Resume</button><button class=\"btn\" id=\"pRestart\">Restart mission</button><button class=\"btn\" id=\"pQuit\">Quit to menu</button></div>\n</div>\n\n<div id=\"debrief\" class=\"scr dim center hidden\">\n  <div class=\"panel\"><div class=\"sub\" id=\"dbSub\"></div><h2 id=\"dbTitle\"></h2><div id=\"rank\"></div><div class=\"kv\" id=\"dbStats\"></div>\n    <div class=\"row\" style=\"justify-content:center\"><button class=\"btn pri\" id=\"dbNext\">Continue</button><button class=\"btn\" id=\"dbRetry\">Retry</button><button class=\"btn\" id=\"dbMenu\">Menu</button></div></div>\n</div>\n<script>\n(function(){\n'use strict';\nvar KEY_URI = 'data:image/jpeg;base64,', SKY_URI = 'data:image/jpeg;base64,', GRASS_URI = 'data:image/jpeg;base64,', ROCK_URI = 'data:image/jpeg;base64,', BRIEF_URI = 'data:image/jpeg;base64,';\nfunction el(id){ return document.getElementById(id); }\nfunction show(id){ el(id).classList.remove('hidden'); }\nfunction hide(id){ el(id).classList.add('hidden'); }\n// ---------- platform bridges (feature-detected) ----------\nvar store = (window.myllmStorage && typeof window.myllmStorage.getItem === 'function') ? window.myllmStorage\n  : (function(){ var m = {}; return { getItem: function(k){ return Promise.resolve(k in m ? m[k] : null); }, setItem: function(k, v){ m[k] = v; return Promise.resolve(); } }; })();\nfunction haptic(k){ try { if (typeof window.myllmHaptic === 'function') window.myllmHaptic(k || 'light'); } catch (e) {} }\nfunction immersive(on){ try { if (typeof window.myllmImmersive === 'function') window.myllmImmersive(on, { keepAwake: on }); } catch (e) {} }\n\n// ---------- math ----------\nvar PI = Math.PI, TAU = PI * 2;\nfunction clamp(v, a, b){ return v < a ? a : v > b ? b : v; }\nfunction lerp(a, b, t){ return a + (b - a) * t; }\nfunction smooth(e0, e1, x){ var t = clamp((x - e0) / (e1 - e0), 0, 1); return t * t * (3 - 2 * t); }\nfunction add(a, b){ return [a[0] + b[0], a[1] + b[1], a[2] + b[2]]; }\nfunction sub(a, b){ return [a[0] - b[0], a[1] - b[1], a[2] - b[2]]; }\nfunction scl(a, s){ return [a[0] * s, a[1] * s, a[2] * s]; }\nfunction madd(a, b, s){ return [a[0] + b[0] * s, a[1] + b[1] * s, a[2] + b[2] * s]; }\nfunction dot(a, b){ return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; }\nfunction cross(a, b){ return [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]]; }\nfunction len(a){ return Math.sqrt(a[0] * a[0] + a[1] * a[1] + a[2] * a[2]); }\nfunction norm(a){ var l = len(a) || 1; return [a[0] / l, a[1] / l, a[2] / l]; }\nfunction dist(a, b){ var x = a[0] - b[0], y = a[1] - b[1], z = a[2] - b[2]; return Math.sqrt(x * x + y * y + z * z); }\nfunction rot(v, k, a){ var c = Math.cos(a), s = Math.sin(a), kv = cross(k, v), kd = dot(k, v) * (1 - c);\n  return [v[0] * c + kv[0] * s + k[0] * kd, v[1] * c + kv[1] * s + k[1] * kd, v[2] * c + kv[2] * s + k[2] * kd]; }\nfunction rnd(){ return Math.random(); }\nfunction rs(){ return Math.random() * 2 - 1; }\nfunction persp(o, fy, asp, n, f){ var t = 1 / Math.tan(fy / 2); for (var i = 0; i < 16; i++) o[i] = 0; o[0] = t / asp; o[5] = t; o[10] = (f + n) / (n - f); o[11] = -1; o[14] = 2 * f * n / (n - f); }\nfunction viewM(o, c, r, u, f){ o[0] = r[0]; o[4] = r[1]; o[8] = r[2]; o[1] = u[0]; o[5] = u[1]; o[9] = u[2]; o[2] = -f[0]; o[6] = -f[1]; o[10] = -f[2];\n  o[3] = o[7] = o[11] = 0; o[12] = -dot(r, c); o[13] = -dot(u, c); o[14] = dot(f, c); o[15] = 1; }\nfunction mul4(o, a, b){ for (var j = 0; j < 4; j++) for (var i = 0; i < 4; i++){ var s = 0; for (var k = 0; k < 4; k++) s += a[k * 4 + i] * b[j * 4 + k]; o[j * 4 + i] = s; } }\n\n// ---------- noise + terrain ----------\nfunction h2(i, j){ var n = (Math.imul(i, 374761393) + Math.imul(j, 668265263)) | 0; n = Math.imul(n ^ (n >>> 13), 1274126177); n ^= n >>> 16; return (n >>> 0) / 4294967295; }\nfunction vn(x, z){ var i = Math.floor(x), j = Math.floor(z), fx = x - i, fz = z - j; fx = fx * fx * (3 - 2 * fx); fz = fz * fz * (3 - 2 * fz);\n  return lerp(lerp(h2(i, j), h2(i + 1, j), fx), lerp(h2(i, j + 1), h2(i + 1, j + 1), fx), fz) * 2 - 1; }\nfunction fbm(x, z, o){ var s = 0, a = .5, f = 1, n = 0; for (var k = 0; k < o; k++){ s += vn(x * f + k * 17.3, z * f - k * 9.1) * a; n += a; a *= .5; f *= 2.03; } return s / n; }\nvar HALF = 4000, GN = 160, CELL = HALF * 2 / GN, GW = GN + 1, HG = new Float32Array(GW * GW);\nfunction genH(x, z){\n  var n = fbm(x * .00042 + 3.1, z * .00042 - 1.7, 5) * 1.7 + .1;\n  var m = fbm(x * .0013 + 9.2, z * .0013 + 4.4, 4), ridge = clamp(1 - Math.abs(m * 1.7), 0, 1); ridge *= ridge;\n  var h = n * 300;\n  if (h > 0) h += ridge * 300 * smooth(40, 230, h) + fbm(x * .004, z * .004, 3) * 22 * smooth(0, 60, h);\n  var d = Math.max(Math.abs(x), Math.abs(z)) / HALF; h -= smooth(.6, .97, d) * 800;\n  return Math.max(h, -180);\n}\n(function(){ for (var j = 0; j < GW; j++) for (var i = 0; i < GW; i++) HG[j * GW + i] = genH(-HALF + i * CELL, -HALF + j * CELL); })();\nfunction Hq(x, z){ var gx = (x + HALF) / CELL, gz = (z + HALF) / CELL; if (gx < 0 || gz < 0 || gx >= GN || gz >= GN) return -200;\n  var i = gx | 0, j = gz | 0, fx = gx - i, fz = gz - j, k = j * GW + i; return lerp(lerp(HG[k], HG[k + 1], fx), lerp(HG[k + GW], HG[k + GW + 1], fx), fz); }\nfunction Hg(x, z){ var h = Hq(x, z); return h > 0 ? h : 0; }\nfunction slopeAt(x, z){ return Math.max(Math.abs(Hq(x + 20, z) - Hq(x - 20, z)), Math.abs(Hq(x, z + 20) - Hq(x, z - 20))) / 40; }\nvar USED = [];\nfunction findSite(x, z, water, gap){\n  gap = gap || (water ? 150 : 70);\n  for (var r = 0; r < 3600; r += 55){ var n = Math.max(1, Math.round(r * TAU / 80));\n    for (var k = 0; k < n; k++){ var a = k / n * TAU + r * .013, px = x + Math.cos(a) * r, pz = z + Math.sin(a) * r;\n      if (Math.abs(px) > HALF * .84 || Math.abs(pz) > HALF * .84) continue;\n      var h = Hq(px, pz), ok = water ? h < -38 : (h > 12 && h < 330 && slopeAt(px, pz) < .2); if (!ok) continue;\n      var clash = false; for (var u = 0; u < USED.length; u++) if (Math.abs(USED[u][0] - px) < gap && Math.abs(USED[u][1] - pz) < gap){ clash = true; break; }\n      if (clash) continue; USED.push([px, pz]); return [px, water ? 0 : h, pz]; } }\n  return [x, Hg(x, z), z];\n}\n// 2D map of the islands (briefing + radar)\nvar MAPC = document.createElement('canvas'); MAPC.width = MAPC.height = 384;\n(function(){ var c = MAPC.getContext('2d'), im = c.createImageData(384, 384), d = im.data;\n  for (var j = 0; j < 384; j++) for (var i = 0; i < 384; i++){ var x = HALF - (i + .5) / 384 * HALF * 2, z = HALF - (j + .5) / 384 * HALF * 2, h = Hq(x, z), o = (j * 384 + i) * 4, r, g, b;\n    if (h <= 0){ var t = clamp(-h / 120, 0, 1); r = lerp(40, 8, t); g = lerp(110, 34, t); b = lerp(128, 58, t); }\n    else { var sh = clamp(.75 + (Hq(x - 40, z) - Hq(x + 40, z)) / 160, .45, 1.2), t2 = clamp(h / 520, 0, 1);\n      r = lerp(96, 150, t2) * sh; g = lerp(140, 138, t2) * sh; b = lerp(84, 120, t2) * sh; if (h < 14){ r = 190 * sh; g = 176 * sh; b = 130 * sh; } }\n    d[o] = r; d[o + 1] = g; d[o + 2] = b; d[o + 3] = 255; }\n  c.putImageData(im, 0, 0); })();\n// ===================================================================\n// WEBGL\n// ===================================================================\nvar canvas = el('gl');\n// alpha:true on purpose: alpha:false loses the context at start-up in some WebKit builds; the blend below keeps the canvas opaque\nvar gl = canvas.getContext('webgl', { antialias: true, alpha: true, premultipliedAlpha: true, preserveDrawingBuffer: false }) || canvas.getContext('experimental-webgl');\nif (!gl){ var er = document.createElement('div'); er.id = 'err'; er.textContent = 'Contrail Strike needs 3D graphics (WebGL), and this device has it switched off.'; document.body.appendChild(er); return; }\nvar COMMON = 'precision highp float;uniform vec3 uCam,uSun,uSunCol,uAmb,uFog,uZen;uniform float uFogD,uH0,uH1;uniform sampler2D uSky;' +\n  'vec3 skyc(vec3 d){float yaw=atan(d.x,-d.z);float e=asin(clamp(d.y,-1.,1.));float v=(e-uH0)/(uH1-uH0);vec3 c=texture2D(uSky,vec2(fract(yaw/6.2831853+.5),1.-clamp(v,.004,.996))).rgb;c=mix(c,uZen,smoothstep(.85,1.9,v));c=mix(c,uFog,smoothstep(.04,-.3,v));return c;}' +\n  'vec3 fogc(vec3 dir){return uFog+uSunCol*.22*pow(max(dot(dir,uSun),0.),6.);}' +\n  'vec3 fogit(vec3 c,vec3 w){vec3 d=w-uCam;float L=length(d);float f=1.-exp(-L*uFogD);return mix(c,fogc(d/L),clamp(f,0.,1.));}';\nvar MVS = 'attribute vec3 aP,aN,aC;uniform mat4 uVP,uM;varying vec3 vW,vN,vC,vO;void main(){vec4 w=uM*vec4(aP,1.);vW=w.xyz;vN=(uM*vec4(aN,0.)).xyz;vC=aC;vO=aP;gl_Position=uVP*w;}';\nvar MFS = COMMON + 'varying vec3 vW,vN,vC,vO;uniform vec3 uTint;uniform float uSpec,uPanel,uFlash,uAlpha;' +\n  'void main(){vec3 N=normalize(vN);vec3 V=uCam-vW;float dd=length(V);V/=dd;if(dot(N,V)<0.)N=-N;vec3 b=vC*uTint;float em=step(1.01,max(vC.r,max(vC.g,vC.b)));' +\n  'if(uPanel>0.){vec2 g=abs(fract(vO.zx*vec2(.45,.6))-.5);float l=smoothstep(.465,.5,max(g.x,g.y));b*=1.-l*.3*uPanel;}' +\n  'float d=max(dot(N,uSun),0.);vec3 c=b*(uAmb*(.78+.22*N.y)+uSunCol*d);vec3 R=reflect(-V,N);float fr=.04+.96*pow(1.-max(dot(N,V),0.),5.);' +\n  'c+=skyc(R)*fr*uSpec+uSunCol*pow(max(dot(R,uSun),0.),70.)*uSpec*1.2;c=mix(c,min(b,vec3(1.6)),em);c=mix(c,vec3(1.,.85,.6),uFlash);gl_FragColor=vec4(fogit(c,vW),uAlpha);}';\nvar TVS = 'attribute