{"name": "Follow", "html": "<!doctype html>\n<!--\n  Follow — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Follow</title>\n<!-- MyLLM 5.6.2+: open full screen from the first frame. Those builds all\n     have myllmClose, which the ✕ uses. -->\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>\n  :root { color-scheme: light dark; }\n  /* Dark fallbacks for builds that do not supply the theme. :where() carries no\n     specificity, so MyLLM's own :root values always win where they exist. */\n  @media (prefers-color-scheme:dark){ :where(:root){ --myllm-bg:#000; --myllm-surface:#1c1c1e; --myllm-text:#f2f2f7; --myllm-muted:#98989f; --myllm-border:#2c2c2e; } }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111);\n    max-width:640px; margin:0 auto; min-height:100dvh;\n    padding-bottom:calc(30px + env(safe-area-inset-bottom));\n  }\n  body{padding-left:env(safe-area-inset-left);padding-right:env(safe-area-inset-right)}\n  :root{--build-id:\"5f46b38ac8\"; --h:24; }\n  .head{ display:flex; align-items:center; gap:12px; margin:4px 2px 14px; }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 78% 52%), hsl(calc(var(--h) + 330) 62% 32%)); }\n  .head .tile svg{ width:1.25em; height:1.25em; fill:none; stroke:currentColor; stroke-width:2.2; stroke-linecap:round; }\n  .head .ht{ flex:1; min-width:0; }\n  .head h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--myllm-muted,#8a8a8e); margin-top:1px; text-wrap:balance; }\n  .wrap{ padding:12px 14px; }\n  .head .acts{ display:none; flex-shrink:0; }\n  .head .acts button{ width:40px; height:40px; border-radius:12px; border:1px solid var(--myllm-border,#e3e3e8);\n    background:var(--myllm-surface,#fff); color:var(--myllm-text,#111); display:grid; place-items:center; padding:0; transition:transform .12s; }\n  .head .acts button:active{ transform:scale(.94); }\n  .head .acts svg{ width:16px; height:16px; fill:none; stroke:currentColor; stroke-width:2.6; stroke-linecap:round; }\n  body.imm .head .acts{ display:flex; }\n  body.imm .wrap{ padding-top:calc(12px + env(safe-area-inset-top)); }\n\n  .tabs{ display:flex; background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8); border-radius:13px; padding:3px; margin-bottom:12px; }\n  .tabs button{ flex:1; border:none; background:none; color:var(--myllm-muted,#8a8a8e);\n    border-radius:10px; padding:9px; font-size:14px; font-weight:700; font-family:inherit; }\n  .tabs button.on{ background:var(--myllm-accent,#0a84ff); color:#fff; }\n\n  .card{ background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8);\n    border-radius:16px; padding:13px 14px; margin-bottom:10px; }\n  .group{ background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8); border-radius:16px; overflow:hidden; margin-bottom:12px; }\n  .gh{ font-size:12.5px; font-weight:700; color:var(--myllm-muted,#8a8a8e); text-transform:uppercase; letter-spacing:.4px; margin:16px 4px 7px; }\n  .up{ display:block; text-decoration:none; color:inherit; padding:12px 14px; border-bottom:1px solid var(--myllm-border,#e3e3e8); }\n  .up:last-child{ border-bottom:none; }\n  .up .by{ font-size:12.5px; color:var(--myllm-muted,#8a8a8e); display:flex; align-items:center; gap:6px; }\n  .up .by .w{ margin-left:auto; flex-shrink:0; }\n  .up .by .src{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-weight:650; }\n  .up h3{ font-size:15px; font-weight:650; line-height:1.32; margin-top:3px; }\n  .up.new h3{ font-weight:800; }\n  .up .sum{ font-size:13px; color:var(--myllm-muted,#8a8a8e); line-height:1.4; margin-top:3px;\n    display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }\n  .dot{ width:7px; height:7px; border-radius:50%; background:var(--myllm-accent,#0a84ff); flex-shrink:0; }\n  .more{ display:block; width:100%; text-align:left; border:none; background:none; font-family:inherit;\n    color:var(--myllm-accent,#0a84ff); font-size:14px; font-weight:650; padding:11px 14px; border-bottom:1px solid var(--myllm-border,#e3e3e8); }\n  .more:last-child{ border-bottom:none; }\n  .caught{ display:flex; align-items:center; gap:10px; padding:14px; }\n  .caught .tick{ width:26px; height:26px; border-radius:50%; background:#1a9a5b; color:#fff; display:grid; place-items:center; flex-shrink:0; }\n  .caught .tick svg{ width:14px; height:14px; fill:none; stroke:currentColor; stroke-width:3; stroke-linecap:round; stroke-linejoin:round; }\n  .caught b{ font-size:15px; display:block; }\n  .caught span{ font-size:12.5px; color:var(--myllm-muted,#8a8a8e); }\n\n  .row{ display:flex; align-items:center; gap:10px; padding:11px 2px; border-bottom:1px solid var(--myllm-border,#e3e3e8); }\n  .row:last-child{ border-bottom:none; }\n  .row .n{ flex:1; min-width:0; }\n  .row .n b{ font-size:15px; font-weight:700; display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  .row .n span{ font-size:12px; color:var(--myllm-muted,#8a8a8e); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; display:block; }\n  .x{ border:none; background:none; color:var(--myllm-muted,#8a8a8e); font-size:19px; padding:4px 8px; font-family:inherit; }\n  .undo{ border:none; background:none; color:var(--myllm-accent,#0a84ff); font-size:14px; font-weight:700; padding:4px 8px; font-family:inherit; }\n\n  label{ display:block; font-size:12.5px; font-weight:700; color:var(--myllm-muted,#8a8a8e); margin-bottom:6px; text-transform:uppercase; letter-spacing:.4px; }\n  textarea{ width:100%; font-size:16px; padding:11px 12px; border-radius:12px; resize:none; min-height:46px;\n    border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111); font-family:inherit; line-height:1.35; }\n  .go{ border:none; border-radius:12px; padding:11px 18px; font-size:15px; font-weight:700;\n    background:var(--myllm-accent,#0a84ff); color:#fff; font-family:inherit; }\n  .go[disabled]{ opacity:.5; }\n  .go.wide{ width:100%; margin-top:9px; }\n  .ghost{ background:none; color:var(--myllm-accent,#0a84ff); border:1px solid var(--myllm-border,#e3e3e8); }\n  .small{ font-size:13px; font-weight:700; padding:8px 13px; }\n  .bar{ display:flex; align-items:center; gap:8px; margin-bottom:4px; }\n  .bar .sp{ flex:1; font-size:12.5px; color:var(--myllm-muted,#8a8a8e); }\n\n  .status{ text-align:center; color:var(--myllm-muted,#8a8a8e); font-size:14px; padding:22px 10px; line-height:1.5; }\n  .errline{ color:#d1345b; font-size:13.5px; margin-top:8px; line-height:1.45; }\n  .okline{ color:#1a9a5b; font-size:13.5px; margin-top:8px; line-height:1.45; }\n  .note{ font-size:12.5px; color:var(--myllm-muted,#8a8a8e); line-height:1.5; margin-top:9px; }\n  .chips{ display:flex; flex-wrap:wrap; gap:7px; }\n  .chip{ border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111); border-radius:999px; padding:8px 13px; font-size:13.5px; font-weight:650; font-family:inherit; }\n  .chip[disabled]{ opacity:.45; }\n  .chip b{ color:var(--myllm-accent,#0a84ff); font-weight:800; margin-left:4px; }\n\n  /* The LinkFindr card: the App Store app's real icon over a gradient tile,\n     which stays if the image can't load. */\n  .lf{ display:flex; gap:12px; align-items:center; text-decoration:none; color:inherit; }\n  .lf .ic{ width:52px; height:52px; border-radius:12px; flex-shrink:0; position:relative; overflow:hidden;\n    background:linear-gradient(145deg, hsl(24 78% 52%), hsl(354 62% 32%)); }\n  .lf .ic img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }\n  .lf b{ font-size:15px; display:block; }\n  .lf span{ font-size:13px; color:var(--myllm-muted,#8a8a8e); line-height:1.4; display:block; margin-top:2px; }\n  .lf .get{ margin-left:auto; flex-shrink:0; border-radius:999px; padding:6px 14px; font-size:13.5px; font-weight:800;\n    background:var(--myllm-bg,#f2f2f7); color:var(--myllm-accent,#0a84ff); }\n  .tail{ display:block; text-align:center; font-size:13px; color:var(--myllm-muted,#8a8a8e); text-decoration:none; padding:6px 10px 2px; line-height:1.5; }\n  .tail u{ color:var(--myllm-accent,#0a84ff); text-decoration:none; font-weight:650; }\n</style>\n</head>\n<body>\n\n<div class=\"wrap\">\n  <div class=\"head\">\n    <div class=\"tile\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 19.5a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1z\"/><path d=\"M4.5 12.5a7 7 0 0 1 7 7\"/><path d=\"M4.5 5.5a14 14 0 0 1 14 14\"/></svg></div>\n    <div class=\"ht\"><h1>Follow</h1><p>Projects you care about, newest first</p></div>\n    <div class=\"acts\"><button type=\"button\" id=\"closeBtn\" aria-label=\"Close Follow\" onclick=\"closeApp()\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div>\n  </div>\n  <div class=\"tabs\">\n    <button id=\"tabL\" class=\"on\" onclick=\"showTab('l')\">Latest</button>\n    <button id=\"tabF\" onclick=\"showTab('f')\">Following</button>\n  </div>\n\n  <div id=\"paneL\">\n    <div class=\"bar\">\n      <span class=\"sp\" id=\"checked\"></span>\n      <button class=\"go ghost small\" id=\"refBtn\" onclick=\"refresh(true)\">Refresh</button>\n    </div>\n    <div id=\"feed\"></div>\n  </div>\n\n  <div id=\"paneF\" style=\"display:none\">\n    <div class=\"card\">\n      <label>Follow a project</label>\n      <textarea id=\"addr\" rows=\"1\" placeholder=\"paste an address, or a list\" autocapitalize=\"none\" autocorrect=\"off\" spellcheck=\"false\"></textarea>\n      <button class=\"go wide\" id=\"addBtn\" onclick=\"addFromField()\">Follow</button>\n      <div id=\"addmsg\"></div>\n      <p class=\"note\">A GitHub project, a YouTube channel, a blog, a Substack, a Reddit community, a Mastodon or\n      Bluesky profile: anything that posts updates. Updates are read from the site's own public feed, so\n      there is no account. Instagram, Facebook, X and TikTok don't publish updates for other apps to read.</p>\n    </div>\n    <div class=\"card\" id=\"sugCard\">\n      <label>Start with a few</label>\n      <div id=\"suggest\"></div>\n    </div>\n    <div class=\"card\">\n      <label>Following (<span id=\"count\">0</span> of <span id=\"cap\"></span>)</label>\n      <div id=\"list\"></div>\n    </div>\n    <div class=\"card\">\n      <a class=\"lf\" id=\"lfCard\" href=\"#\" target=\"_blank\" rel=\"noopener\">\n        <div class=\"ic\"><img src=\"https://raw.githubusercontent.com/TeamDzX/myllm-assets-xl/main/apps/icons/follow.jpg\" alt=\"\" onerror=\"this.remove()\"></div>\n        <div><b>LinkFindr for iPhone</b><span>Follow as many projects as you like, synced through your iCloud. Save any update to read later, offline, and share your list with a friend.</span></div>\n        <span class=\"get\">View</span>\n      </a>\n    </div>\n  </div>\n</div>\n\n<script>\n/* Looked up on each use, never kept: MyLLM can add its bridges after this script has run. */\nvar store={getItem:function(k){var s=window.myllmStorage;return s?s.getItem(k):Promise.resolve(null)},setItem:function(k,v){var s=window.myllmStorage;return s?s.setItem(k,v):Promise.resolve()}};\nfunction NET(u, o){ return window.myllmFetch(u, o); }\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s==null?\"\":s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\"); }\n\nvar LINKFINDR_URL = \"https://apps.apple.com/app/linkfindr/id6760857542\";\n\n/* A pocket version: a handful of projects. LinkFindr has no limit. */\nvar MAX_FOLLOWS = 10;\n/* A busy project (several releases a day) would fill the list on its own.\n   Order stays strictly newest first; each project shows its newest few per\n   section, then one \"N more\" row. */\nvar PER_SOURCE = 3;\n\n/* Starting points: projects that post often and stay put. Each one's feed was\n   checked live before shipping (verify/follow.mjs --live). */\nvar SUGGESTED = [\n  { title: \"llama.cpp\",        feed: \"https://github.com/ggml-org/llama.cpp/releases.atom\", site: \"https://github.com/ggml-org/llama.cpp\" },\n  { title: \"Swift.org\",        feed: \"https://www.swift.org/atom.xml\",                      site: \"https://www.swift.org/blog/\" },\n  { title: \"NASA\",             feed: \"https://www.youtube.com/feeds/videos.xml?channel_id=UCLA_DiR1FfKNvjuUpBHmylQ\", site: \"https://www.youtube.com/@NASA\" },\n  { title: \"Simon Willison\",   feed: \"https://simonwillison.net/atom/everything/\",          site: \"https://simonwillison.net/\" },\n  { title: \"Kottke\",           feed: \"https://feeds.kottke.org/main\",                       site: \"https://kottke.org/\" }\n];\n\nvar K_F = \"follows_v1\";     /* [{feed, title, site}] */\nvar K_CACHE = \"cache_v1\";   /* last merged updates, so it opens instantly */\nvar K_SEEN = \"seen_v1\";     /* newest update already shown, for the new dot */\nvar K_CHECKED = \"checked_v1\";\n\nvar follows = [];\nvar items = [];\nvar lastSeen = 0;           /* updates newer than this are new on this visit */\nvar checkedAt = 0;\nvar expanded = {};\nvar pendingRemove = null;\nvar busy = false;\n\n/* ---------- small helpers ---------- */\n\nfunction timeAgo(at){\n  if (!at) return \"\";\n  var s = (Date.now() - at) / 1000;\n  if (s < 3600) return Math.max(1, Math.floor(s/60)) + \"m ago\";\n  if (s < 86400) return Math.floor(s/3600) + \"h ago\";\n  if (s < 2592000) return Math.floor(s/86400) + \"d ago\";\n  return new Date(at).toLocaleDateString();\n}\n\n/* Tags out, entities decoded, whitespace collapsed, cut on a word. */\nfunction plain(html, limit){\n  if (!html) return \"\";\n  var d = new DOMParser().parseFromString(\"<body>\" + html + \"</body>\", \"text/html\");\n  var t = (d.body.textContent || \"\");\n  /* A summary that was itself escaped HTML shows its tags after one decode. */\n  if (/<\\w+[^>]*>/.test(t)) t = (new DOMParser().parseFromString(\"<body>\" + t + \"</body>\", \"text/html\").body.textContent || \"\");\n  t = t.replace(/\\s+/g, \" \").trim();\n  if (t.length <= limit) return t;\n  var cut = t.slice(0, limit), sp = cut.lastIndexOf(\" \");\n  return (sp > limit / 2 ? cut.slice(0, sp) : cut) + \"…\";\n}\n\n/* XML namespaces make querySelector unreliable across feed dialects, so match\n   on localName — dc:date, content:encoded and friends differ only by prefix.\n   Direct children only, so an item's title never comes from a nested element. */\nfunction child(node, local){\n  for (var c = node.firstElementChild; c; c = c.nextElementSibling) if (c.localName === local) return c;\n  return null;\n}\nfunction childText(node, local){ var n = child(node, local); return n ? (n.textContent || \"\").trim() : \"\"; }\n\nfunction hostOf(u){ try { return new URL(u).host.replace(/^www\\./, \"\"); } catch(e){ return u; } }\n\n/* ---------- reading a feed ---------- */\n\n/* RSS 2.0, RSS 1.0 (RDF), Atom or JSON Feed. Null if the text is none of them. */\nfunction parseFeed(text, feedUrl){\n  var head = String(text || \"\").slice(0, 2048).trim();\n  if (head.charAt(0) === \"{\") return parseJSONFeed(text, feedUrl);\n  if (!/<(rss|feed|rdf:RDF)[\\s>]/i.test(head)) return null;\n  var doc = new DOMParser().parseFromString(text, \"application/xml\");\n  if (doc.getElementsByTagName(\"parsererror\").length) return null;\n  var root = doc.documentElement;\n  var chan = child(root, \"channel\") || root;\n  var title = niceTitle(childText(chan, \"title\")) || hostOf(feedUrl);\n\n  var nodes = [];\n  var all = root.getElementsByTagName(\"*\");\n  for (var i = 0; i < all.length; i++){\n    var ln = all[i].localName;\n    if (ln === \"item\" || ln === \"entry\") nodes.push(all[i]);\n  }\n  var out = [];\n  for (var j = 0; j < nodes.length && out.length < 30; j++){\n    var e = nodes[j];\n    var link = \"\";\n    for (var c = e.firstElementChild; c; c = c.nextElementSibling){\n      if (c.localName !== \"link\") continue;\n      var rel = c.getAttribute(\"rel\");\n      var href = c.getAttribute(\"href\") || (c.textContent || \"\").trim();\n      if (!href) continue;\n      if (!rel || rel === \"alternate\"){ link = href; if (rel === \"alternate\") break; }\n    }\n    if (!link){ var g = childText(e, \"guid\"); if (/^https?:/.test(g)) link = g; }\n    var body = childText(e, \"summary\") || childText(e, \"description\") || childText(e, \"content\") || childText(e, \"encoded\");\n    if (!body){ var grp = child(e, \"group\"); if (grp) body = childText(grp, \"description\"); }\n    var t = plain(childText(e, \"title\"), 200);\n    var sum = plain(body, 240);\n    if (!t && !sum) continue;\n    if (!/^https?:/i.test(link)) continue;\n    var when = childText(e, \"published\") || childText(e, \"pubDate\") || childText(e, \"date\") || childText(e, \"updated\");\n    var at = parseWhen(when);\n    out.push({ id: childText(e, \"id\") || childText(e, \"guid\") || link, title: t || sum.slice(0, 90),\n               summary: sum === t ? \"\" : sum, link: link, at: at, by: title, feed: feedUrl });\n  }\n  return { title: title, items: out };\n}\n\nfunction parseJSONFeed(text, feedUrl){\n  var o; try { o = JSON.parse(text); } catch(e){ return null; }\n  if (!o || !/jsonfeed\\.org/.test(String(o.version || \"\")) || !Array.isArray(o.items)) return null;\n  var title = o.title || hostOf(feedUrl);\n  var out = o.items.slice(0, 30).map(function(it){\n    var t = plain(it.title || \"\", 200), sum = plain(it.summary || it.content_text || it.content_html || \"\", 240);\n    return { id: String(it.id || it.url || \"\"), title: t || sum.slice(0, 90), summary: sum === t ? \"\" : sum,\n             link: it.url || it.external_url || \"\", at: parseWhen(it.date_published || it.date_modified), by: title, feed: feedUrl };\n  }).filter(function(x){ return /^https?:/i.test(x.link) && x.title; });\n  return { title: title, items: out };\n}\n\n/* GitHub calls a release feed \"Release notes from llama.cpp\". */\nfunction niceTitle(t){\n  var m = String(t || \"\").match(/^Release notes from (.+)$/);\n  return m ? m[1] + \" releases\" : String(t || \"\").trim();\n}\n\n/* Date.parse covers ISO and most RFC 822 dates. Bluesky writes \"09 Oct 2026\n   15:53 +0000\" (no weekday, no seconds), which it reads too. A date in the\n   future is clamped to now, or it would stay \"new\" for ever. */\nfunction parseWhen(s){\n  var t = Date.parse(String(s || \"\").trim());\n  if (!t) return 0;\n  return Math.min(t, Date.now());\n}\n\n/* ---------- finding a project's feed ---------- */\n\n/* Feeds well-known sites keep at a predictable address. GitHub repo pages\n   announce none; the others do, but this saves a page load. */\nfunction knownFeeds(u){\n  var url; try { url = new URL(u); } catch(e){ return []; }\n  var host = url.host.toLowerCase().replace(/^www\\./, \"\");\n  var p = url.pathname.split(\"/\").filter(Boolean);\n  var out = [];\n  if (host === \"github.com\"){\n    if (p.length >= 2) out.push(\"https://github.com/\" + p[0] + \"/\" + p[1] + \"/releases.atom\",\n                                \"https://github.com/\" + p[0] + \"/\" + p[1] + \"/tags.atom\",\n                                \"https://github.com/\" + p[0] + \"/\" + p[1] + \"/commits.atom\");\n    else if (p.length === 1) out.push(\"https://github.com/\" + p[0] + \".atom\");\n  } else if (host === \"youtube.com\" || host === \"m.youtube.com\"){\n    var list = url.searchParams.get(\"list\");\n    if (list) out.push(\"https://www.youtube.com/feeds/videos.xml?playlist_id=\" + list);\n    else if (p[0] === \"channel\" && p[1]) out.push(\"https://www.youtube.com/feeds/videos.xml?channel_id=\" + p[1]);\n  } else if (host === \"reddit.com\" || host === \"old.reddit.com\"){\n    if (p[0] === \"r\" && p[1]) out.push(\"https://www.reddit.com/r/\" + p[1] + \"/.rss\");\n    if ((p[0] === \"user\" || p[0] === \"u\") && p[1]) out.push(\"https://www.reddit.com/user/\" + p[1] + \"/.rss\");\n  } else if (host === \"bsky.app\"){\n    if (p[0] === \"profile\" && p[1]) out.push(\"https://bsky.app/profile/\" + p[1] + \"/rss\");\n  } else if (host === \"medium.com\"){\n    if (p[0]) out.push(\"https://medium.com/feed/\" + p[0]);\n  } else {\n    if (/\\.substack\\.com$/.test(host)) out.push(\"https://\" + host + \"/feed\");\n    if (/\\.itch\\.io$/.test(host) && p[0]) out.push(\"https://\" + host + \"/\" + p[0] + \"/devlog.rss\");\n    /* Mastodon and most fediverse servers: /@user → /@user.rss */\n    if (p.length === 1 && p[0].charAt(0) === \"@\") out.push(\"https://\" + url.host + \"/\" + p[0] + \".rss\");\n  }\n  return out;\n}\n\nfunction commonFeeds(u){\n  var url; try { url = new URL(u); } catch(e){ return []; }\n  return [\"/feed\", \"/rss\", \"/feed.xml\", \"/atom.xml\", \"/rss.xml\", \"/index.xml\"].map(function(x){ return url.origin + x; });\n}\n\n/* Feeds a page announces in its <head>. Comment feeds aren't the project's updates. */\nfunction announcedFeeds(html, base){\n  var out = [];\n  var tags = String(html).slice(0, 400000).match(/<link\\b[^>]*>/gi) || [];\n  tags.forEach(function(t){\n    if (!/\\brel\\s*=\\s*[\"']?[^\"'>]*alternate/i.test(t)) return;\n    if (!/type\\s*=\\s*[\"']?application\\/(rss|atom)\\+xml|type\\s*=\\s*[\"']?application\\/feed\\+json/i.test(t)) return;\n    var m = t.match(/href\\s*=\\s*(?:\"([^\"]*)\"|'([^']*)'|([^\\s>]+))/i);\n    if (!m) return;\n    var href = (m[1] || m[2] || m[3] || \"\").replace(/&amp;/g, \"&\");\n    try { href = new URL(href, base).href; } catch(e){ return; }\n    if (/\\/comments\\/feed/i.test(href)) return;\n    if (out.indexOf(href) < 0) out.push(href);\n  });\n  /* YouTube @handles: the page carries the channel id. */\n  var yt = String(html).match(/\"externalId\":\"(UC[\\w-]{20,})\"/) || String(html).match(/channel_id=(UC[\\w-]{20,})/);\n  if (yt){\n    var f = \"https://www.youtube.com/feeds/videos.xml?channel_id=\" + yt[1];\n    if (out.indexOf(f) < 0) out.push(f);\n  }\n  return out;\n}\n\nfunction get(u){\n  return NET(u).then(function(r){\n    if (!r || r.status >= 400 || !r.body) return null;\n    return r.body;\n  }).catch(function(){ return null; });\n}\n\nfunction tryFeed(u, tried){\n  if (tried[u]) return Promise.resolve(null);\n  tried[u] = true;\n  return get(u).then(function(body){\n    var f = body ? parseFeed(body, u) : null;\n    return f ? { feed: u, title: f.title, items: f.items } : null;\n  });\n}\n\nfunction firstOf(list, tried){\n  var i = 0;\n  function next(){\n    if (i >= list.length) return Promise.resolve(null);\n    return tryFeed(list[i++], tried).then(function(r){ return r || next(); });\n  }\n  return next();\n}\n\n/* The feed behind an address: a known address for the site, the address\n   itself, what its page announces, then the usual paths. */\nfunction discover(raw){\n  var input = String(raw || \"\").trim().replace(/[)\\].,;]+$/, \"\");\n  if (!input) return Promise.resolve(null);\n  if (!/^https?:\\/\\//i.test(input)) input = \"https://\" + input;\n  var tried = {};\n  return firstOf(knownFeeds(input), tried).then(function(r){\n    if (r) return r;\n    tried[input] = true;\n    return get(input).then(function(body){\n      if (!body) return null;\n      var f = parseFeed(body, input);\n      if (f) return { feed: input, title: f.title, items: f.items };\n      return firstOf(announcedFeeds(body, input), tried);\n    });\n  }).then(function(r){\n    return r || firstOf(commonFeeds(input), tried);\n  }).then(function(r){\n    if (r) r.site = input;\n    return r;\n  });\n}\n\n/* Every web address in a block of text (a shared list), once each. */\nfunction addresses(text){\n  var seen = {}, out = [];\n  (String(text).match(/https?:\\/\\/[^\\s<>\"']+/gi) || []).forEach(function(u){\n    u = u.replace(/[)\\].,;]+$/, \"\");\n    if (!seen[u]){ seen[u] = true; out.push(u); }\n  });\n  if (!out.length){\n    var t = String(text).trim();\n    if (t && !/\\s/.test(t) && /\\./.test(t)) out.push(t);\n  }\n  return out;\n}\n\n/* ---------- the follow list ---------- */\n\nfunction saveFollows(){ return store.setItem(K_F, JSON.stringify(follows)); }\nfunction isFollowed(feed){ for (var i = 0; i < follows.length; i++) if (follows[i].feed === feed) return true; return false; }\n\nfunction capNote(){\n  return 'This pocket version follows up to ' + MAX_FOLLOWS + ' projects. ' +\n    '<a href=\"' + LINKFINDR_URL + '\" target=\"_blank\" rel=\"noopener\" style=\"color:inherit;font-weight:700\">LinkFindr</a> follows as many as you like.';\n}\n\n/* Adds what discover() found, merging its updates straight in so the new\n   project shows without a second fetch. */\nfunction adopt(r){\n  follows.push({ feed: r.feed, title: r.title, site: r.site || \"\" });\n  /* Following starts caught up: what was already there isn't news. */\n  r.items.forEach(function(x){ x.old = true; });\n  mergeItems(r.items);\n}\n\nfunction addFromField(){\n  var list = addresses(el(\"addr\").value);\n  var msg = el(\"addmsg\");\n  msg.innerHTML = \"\";\n  if (!list.length){ msg.innerHTML = '<div class=\"errline\">Paste the address of a project first.</div>'; return; }\n  if (!window.myllmFetch){ msg.innerHTML = '<div class=\"errline\">Needs internet access for apps (MyLLMos settings).</div>'; return; }\n  if (follows.length >= MAX_FOLLOWS){ msg.innerHTML = '<div class=\"errline\">' + capNote() + '</div>'; return; }\n  haptic(\"light\");\n  var btn = el(\"addBtn\");\n  btn.disabled = true;\n  var added = [], missed = [], dup = [], full = false;\n  var i = 0;\n  function next(){\n    if (i >= list.length) return Promise.resolve();\n    var a = list[i++];\n    btn.textContent = list.length > 1 ? \"Looking… \" + i + \" of \" + list.length : \"Looking…\";\n    if (follows.length >= MAX_FOLLOWS){ full = true; return Promise.resolve(); }\n    return discover(a).then(function(r){\n      if (!r) missed.push(a);\n      else if (isFollowed(r.feed)) dup.push(r.title);\n      else { adopt(r); added.push(r.title); }\n    }).then(next);\n  }\n  next().then(function(){\n    var parts = [];\n    if (added.length) parts.push('<div class=\"okline\">Following ' + added.map(esc).join(\", \") + ' ✓</div>');\n    if (dup.length) parts.push('<div class=\"note\">Already following ' + dup.map(esc).join(\", \") + '.</div>');\n    if (missed.length) parts.push('<div class=\"errline\">No updates found at ' + missed.map(function(m){ return esc(hostOf(m)); }).join(\", \") +\n      '. Try the project\\'s own page, or its feed address.</div>');\n    if (full) parts.push('<div class=\"errline\">' + capNote() + '</div>');\n    msg.innerHTML = parts.join(\"\");\n    if (added.length){ haptic(\"success\"); el(\"addr\").value = \"\"; el(\"addr\").style.height = \"\"; }\n    return saveFollows();\n  }).then(function(){\n    btn.disabled = false;\n    btn.textContent = \"Follow\";\n    renderList(); renderFeed(); saveCache();\n  });\n}\n\nfunction followSuggested(i){\n  var s = SUGGESTED[i];\n  if (!s) return;\n  var msg = el(\"addmsg\");\n  msg.innerHTML = \"\";\n  if (!window.myllmFetch){ msg.innerHTML = '<div class=\"errline\">Needs internet access for apps (MyLLMos settings).</div>'; return; }\n  if (follows.length >= MAX_FOLLOWS){ msg.innerHTML = '<div class=\"errline\">' + capNote() + '</div>'; return; }\n  haptic(\"light\");\n  var b = el(\"sug\" + i);\n  if (b){ b.disabled = true; b.textContent = \"Adding…\"; }\n  tryFeed(s.feed, {}).then(function(r){\n    if (!r){ msg.innerHTML = '<div class=\"errline\">' + esc(s.title) + ' didn\\'t answer just now. Try again in a moment.</div>'; renderSuggestions(); return; }\n    r.site = s.site;\n    adopt(r);\n    return saveFollows().then(function(){\n      msg.innerHTML = '<div class=\"okline\">Following ' + esc(r.title) + ' ✓</div>';\n      haptic(\"success\");\n      renderList(); renderFeed(); saveCache();\n    });\n  });\n}\n\n/* Removal without a dialog: the row becomes its own undo. */\nfunction removeFollow(i){\n  haptic(\"light\");\n  pendingRemove = { at: i, f: follows[i] };\n  var feed = follows[i].feed;\n  follows.splice(i, 1);\n  items = items.filter(function(x){ return x.feed !== feed; });\n  saveFollows().then(function(){ renderList(); renderFeed(); saveCache(); });\n}\nfunction undoRemove(){\n  if (!pendingRemove) return;\n  follows.splice(pendingRemove.at, 0, pendingRemove.f);\n  pendingRemove = null;\n  saveFollows().then(function(){ renderList(); refresh(false); });\n}\n\nfunction renderSuggestions(){\n  var left = [];\n  for (var j = 0; j < SUGGESTED.length; j++) if (!isFollowed(SUGGESTED[j].feed)) left.push(j);\n  el(\"sugCard\").style.display = left.length && follows.length < MAX_FOLLOWS ? \"block\" : \"none\";\n  el(\"suggest\").innerHTML = '<div class=\"chips\">' + left.map(function(j){\n    return '<button class=\"chip\" id=\"sug' + j + '\" onclick=\"followSuggested(' + j + ')\">' + esc(SUGGESTED[j].title) + '<b>+</b></button>';\n  }).join(\"\") + '</div>';\n}\n\nfunction renderList(){\n  renderSuggestions();\n  el(\"count\").textContent = follows.length;\n  el(\"cap\").textContent = MAX_FOLLOWS;\n  var html = follows.map(function(f, i){\n    return '<div class=\"row\"><div class=\"n\"><b>' + esc(f.title) + '</b><span>' + esc(hostOf(f.site || f.feed)) + '</span></div>' +\n           '<button class=\"x\" onclick=\"removeFollow(' + i + ')\" aria-label=\"Unfollow ' + esc(f.title) + '\">✕</button></div>';\n  }).join(\"\");\n  if (pendingRemove){\n    html += '<div class=\"row\"><div class=\"n\"><span>Unfollowed ' + esc(pendingRemove.f.title) + '</span></div>' +\n            '<button class=\"undo\" onclick=\"undoRemove()\">Undo</button></div>';\n  }\n  el(\"list\").innerHTML = html || '<p class=\"status\">Nothing yet. Paste an address above, or tap a suggestion.</p>';\n}\n\n/* ---------- the updates ---------- */\n\nfunction mergeItems(fresh){\n  var byKey = {};\n  items.forEach(function(x){ byKey[x.feed + \"|\" + x.id] = x; });\n  fresh.forEach(function(x){\n    var k = x.feed + \"|\" + x.id;\n    var old = byKey[k];\n    /* An undated update keeps the time it was first seen. */\n    if (!x.at) x.at = old && old.at ? old.at : Date.now();\n    if (old && old.old) x.old = true;\n    byKey[k] = x;\n  });\n  var all = Object.keys(byKey).map(function(k){ return byKey[k]; });\n  var live = {};\n  follows.forEach(function(f){ live[f.feed] = true; });\n  all = all.filter(function(x){ return live[x.feed]; });\n  all.sort(function(a, b){ return b.at - a.at; });\n  /* Keep each project's newest 20; plenty for a pocket list. */\n  var per = {};\n  items = all.filter(function(x){ per[x.feed] = (per[x.feed] || 0) + 1; return per[x.feed] <= 20; });\n}\n\nfunction saveCache(){ return store.setItem(K_CACHE, JSON.stringify(items.slice(0, 200))); }\n\nfunction rows(list, section){\n  var counts = {}, shown = {}, out = [];\n  list.forEach(function(x){ counts[x.feed] = (counts[x.feed] || 0) + 1; });\n  list.forEach(function(x){\n    var n = shown[x.feed] || 0;\n    shown[x.feed] = n + 1;\n    if (expanded[section + \"|\" + x.feed] || n < PER_SOURCE) out.push(upRow(x, section === \"new\"));\n    else if (n === PER_SOURCE){\n      var more = counts[x.feed] - PER_SOURCE;\n      out.push('<button class=\"more\" onclick=\"expand(\\'' + section + '\\',' + JSON.stringify(x.feed).replace(/\"/g, \"&quot;\") + ')\">' +\n               more + ' more from ' + esc(x.by) + '</button>');\n    }\n  });\n  return out.join(\"\");\n}\n\nfunction expand(section, feed){\n  haptic(\"light\");\n  expanded[section + \"|\" + feed] = true;\n  renderFeed();\n}\n\nfunction upRow(x, isNew){\n  return '<a class=\"up' + (isNew ? ' new' : '') + '\" href=\"' + esc(x.link) + '\" target=\"_blank\" rel=\"noopener\">' +\n    '<div class=\"by\">' + (isNew ? '<span class=\"dot\"></span>' : '') + '<span class=\"src\">' + esc(x.by) + '</span>' +\n    '<span class=\"w\">' + esc(timeAgo(x.at)) + '</span></div>' +\n    '<h3>' + esc(x.title) + '</h3>' +\n    (x.summary ? '<div class=\"sum\">' + esc(x.summary) + '</div>' : '') +\n  '</a>';\n}\n\nfunction caught(after){\n  return '<div class=\"caught\"><span class=\"tick\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg></span>' +\n    '<div><b>' + (after ? \"That's everything new\" : \"You're all caught up\") + '</b>' +\n    '<span>' + (checkedAt ? 'Checked ' + esc(timeAgo(checkedAt)) : '') + '</span></div></div>';\n}\n\nfunction isNew(x){ return x.at > lastSeen && !x.old; }\n\nfunction renderFeed(){\n  el(\"checked\").textContent = busy ? \"Checking…\" : \"\";\n  if (!follows.length){\n    el(\"feed\").innerHTML = '<p class=\"status\">Nothing followed yet.<br>Add a project on the Following tab. There are a few suggestions there to start you off.</p>';\n    return;\n  }\n  if (!items.length){\n    el(\"feed\").innerHTML = '<p class=\"status\">' + (busy ? \"Fetching the latest…\" : \"No updates yet. Tap Refresh.\") + '</p>';\n    return;\n  }\n  var fresh = items.filter(isNew);\n  var earlier = items.filter(function(x){ return !isNew(x); }).slice(0, 80);\n  var html = \"\";\n  if (fresh.length){\n    html += '<div class=\"gh\">New</div><div class=\"group\">' + rows(fresh, \"new\") + caught(true) + '</div>';\n  } else {\n    html += '<div class=\"group\" style=\"margin-top:8px\">' + caught(false) + '</div>';\n  }\n  if (earlier.length) html += '<div class=\"gh\">Earlier</div><div class=\"group\">' + rows(earlier, \"earlier\") + '</div>';\n  html += '<a class=\"tail\" href=\"' + LINKFINDR_URL + '\" target=\"_blank\" rel=\"noopener\">Want to save these to read later, or follow more? <u>LinkFindr for iPhone</u></a>';\n  el(\"feed\").innerHTML = html;\n}\n\n/* Reads every followed feed. The \"new\" line moves forward only once the\n   updates have been on screen, so what was new stays marked for this visit. */\nfunction refresh(manual){\n  if (!follows.length){ renderFeed(); return; }\n  if (!window.myllmFetch){\n    el(\"feed\").innerHTML = '<p class=\"status\">This app needs internet access for apps. Turn it on in MyLLMos settings, then reopen.</p>';\n    return;\n  }\n  if (busy) return;\n  busy = true;\n  if (manual) haptic(\"light\");\n  el(\"refBtn\").disabled = true;\n  renderFeed();\n  var jobs = follows.map(function(f){\n    return get(f.feed).then(function(body){\n      var r = body ? parseFeed(body, f.feed) : null;\n      if (!r) return [];\n      if (r.title && r.title !== f.title){ f.title = r.title; }\n      return r.items;\n    });\n  });\n  Promise.all(jobs).then(function(lists){\n    var all = [];\n    lists.forEach(function(l){ all = all.concat(l); });\n    busy = false;\n    el(\"refBtn\").disabled = false;\n    if (!all.length && !items.length){\n      el(\"feed\").innerHTML = '<p class=\"status\">Couldn\\'t reach those projects just now. Tap Refresh to try again.</p>';\n      return;\n    }\n    mergeItems(all);\n    checkedAt = Date.now();\n    renderFeed();\n    renderList();\n    if (manual) haptic(\"success\");\n    saveFollows();\n    saveCache();\n    store.setItem(K_CHECKED, String(checkedAt));\n    var newest = items.length ? items[0].at : 0;\n    if (newest > lastSeenStored){ lastSeenStored = newest; store.setItem(K_SEEN, String(newest)); }\n  });\n}\nvar lastSeenStored = 0;\n\n/* ---------- tabs ---------- */\n\nfunction showTab(t){\n  haptic(\"selection\");\n  el(\"paneL\").style.display = t === \"l\" ? \"block\" : \"none\";\n  el(\"paneF\").style.display = t === \"f\" ? \"block\" : \"none\";\n  el(\"tabL\").className = t === \"l\" ? \"on\" : \"\";\n  el(\"tabF\").className = t === \"f\" ? \"on\" : \"\";\n}\n\n/* ---------- full screen ----------\n   Only where MyLLM can also close the app (myllmClose, 5.6.2+): full screen\n   hides the Done button, and a page with no way out is worse than a repeated\n   title. Looked up each time, never kept. */\nfunction canGoFull(){ return !!(window.myllmClose && window.myllmImmersive); }\nfunction syncChrome(){\n  var full = canGoFull();\n  document.body.classList.toggle(\"imm\", full);\n  if (!full) return;\n  try { myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n}\nfunction closeApp(){\n  haptic(\"light\");\n  try { myllmClose().catch(function(){}); } catch(e){}\n}\ndocument.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) syncChrome(); });\n\n/* The field grows with a pasted list. */\nel(\"addr\").addEventListener(\"input\", function(){\n  this.style.height = \"auto\";\n  this.style.height = Math.min(this.scrollHeight, 160) + \"px\";\n});\nel(\"lfCard\").href = LINKFINDR_URL;\n\n/* ---------- boot ---------- */\nsyncChrome();\n\nPromise.all([store.getItem(K_F), store.getItem(K_CACHE), store.getItem(K_SEEN), store.getItem(K_CHECKED)])\n.then(function(v){\n  try { follows = v[0] ? JSON.parse(v[0]) : []; } catch(e){ follows = []; }\n  try { items = v[1] ? JSON.parse(v[1]) : []; } catch(e){ items = []; }\n  lastSeen = lastSeenStored = Number(v[2] || 0) || 0;\n  checkedAt = Number(v[3] || 0) || 0;\n  if (!follows.length) showTab(\"f\");\n  renderList();\n  renderFeed();\n  refresh(false);\n});\n</script>\n</body>\n</html>\n", "kind": "html", "iconSymbol": "dot.radiowaves.up.forward", "iconColor": "orange"}