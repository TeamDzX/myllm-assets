{"name": "Essentials Finder", "html": "<!doctype html>\n<!--\n  Essentials Finder — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>:root{--build-id:\"dbceaeade6\";color-scheme:light dark}\n*{box-sizing:border-box}\nbody{font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);margin:0;padding:16px;background:var(--myllm-bg,#f2f2f7);color:var(--myllm-text,#111)}\nh1{font-size:22px;margin:0 0 2px}\n.sub{font-size:13px;color:var(--myllm-muted,#8a8a8e);margin:0 0 16px}\n.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:18px}\n.tile{background:var(--myllm-surface,#fff);border:1px solid var(--myllm-border,#e3e3e8);border-radius:16px;padding:18px 12px;text-align:center;font-size:15px;font-weight:600;color:var(--myllm-text,#111)}\n.tile .ic{font-size:30px;display:block;margin-bottom:6px}\n.tile.on{background:var(--myllm-accent,#0a84ff);color:#fff;border-color:transparent}\n.card{background:var(--myllm-surface,#fff);border-radius:14px;padding:12px 14px;margin-bottom:10px}\n.card.first{outline:2px solid var(--myllm-accent,#0a84ff)}\n.card .top{display:flex;align-items:baseline;gap:8px}\n.card .name{font-size:16px;font-weight:600;flex:1}\n.card .dist{font-size:13px;color:var(--myllm-accent,#0a84ff);font-weight:700;white-space:nowrap}\n.card .addr{font-size:13px;color:var(--myllm-muted,#8a8a8e);margin:4px 0 8px}\n.card a{font-size:13px;font-weight:600;text-decoration:none;background:rgba(10,132,255,.12);color:var(--myllm-accent,#0a84ff);border-radius:9px;padding:7px 12px;display:inline-block}\n.note{text-align:center;color:var(--myllm-muted,#8a8a8e);font-size:14px;margin-top:8px;line-height:1.5;padding:0 6px}\n@media(min-width:768px){body{max-width:780px;margin-left:auto;margin-right:auto}.grid{grid-template-columns:repeat(4,1fr)}}\n</style></head><body>\n<h1>🧭 Essentials Finder</h1>\n<p class=\"sub\" id=\"here\">Finding your location…</p>\n<div class=\"grid\" id=\"grid\"></div>\n<div id=\"results\"></div>\n\n<script>\nvar LOC = window.myllmLocation || null;\nvar haptic = window.myllmHaptic || function(){};\nvar here = null;\nvar KINDS = [\n  {ic:\"💊\", label:\"Pharmacy\", q:\"pharmacy\"},\n  {ic:\"🏧\", label:\"ATM\", q:\"atm\"},\n  {ic:\"🏥\", label:\"Hospital\", q:\"hospital\"},\n  {ic:\"⛽\", label:\"Petrol\", q:\"petrol station\"},\n  {ic:\"🔌\", label:\"EV Charger\", q:\"ev charging station\"},\n  {ic:\"🛒\", label:\"Supermarket\", q:\"supermarket\"},\n  {ic:\"🚓\", label:\"Police\", q:\"police station\"},\n  {ic:\"🚻\", label:\"Toilets\", q:\"public toilet\"},\n  {ic:\"🏨\", label:\"Hotel\", q:\"hotel\"}\n];\n\nfunction el(id){return document.getElementById(id)}\n\nfunction dist(m){\n  if(m==null) return \"\";\n  if(m<1000) return Math.round(m)+\" m\";\n  return (m/1000).toFixed(m<10000?1:0)+\" km\";\n}\n\nfunction tiles(){\n  var g=el(\"grid\");\n  KINDS.forEach(function(k){\n    var b=document.createElement(\"button\");b.className=\"tile\";\n    b.innerHTML='<span class=\"ic\">'+k.ic+'</span>'+k.label;\n    b.onclick=function(){\n      haptic(\"selection\");\n      [].forEach.call(g.children,function(c){c.classList.remove(\"on\")});\n      b.classList.add(\"on\");\n      find(k);\n    };\n    g.appendChild(b);\n  });\n}\n\nfunction find(k){\n  if(!LOC) return;\n  el(\"results\").innerHTML='<p class=\"note\">Finding the nearest '+k.label.toLowerCase()+'…</p>';\n  LOC.search(k.q,{limit:5}).then(function(list){\n    list=(list||[]).sort(function(a,b){return (a.distance||1e12)-(b.distance||1e12)});\n    if(!list.length){el(\"results\").innerHTML='<p class=\"note\">Nothing found nearby.</p>';return}\n    var R=el(\"results\");R.innerHTML=\"\";\n    list.forEach(function(p,i){\n      var d=document.createElement(\"div\");d.className=\"card\"+(i===0?\" first\":\"\");\n      var dest=p.latitude+\",\"+p.longitude;\n      d.innerHTML='<div class=\"top\"><div class=\"name\"></div><div class=\"dist\">'+dist(p.distance)+'</div></div>'+\n        '<div class=\"addr\"></div>'+\n        '<a href=\"https://maps.apple.com/?daddr='+dest+'\">Directions</a>';\n      d.querySelector(\".name\").textContent=p.name;\n      d.querySelector(\".addr\").textContent=p.address||\"\";\n      R.appendChild(d);\n    });\n  }).catch(function(e){\n    el(\"results\").innerHTML='<p class=\"note\">'+(e&&e.message?e.message:\"Search failed\")+'</p>';\n  });\n}\n\nfunction start(){\n  tiles();\n  if(!LOC){\n    el(\"here\").textContent=\"Location unavailable\";\n    el(\"results\").innerHTML='<p class=\"note\">This needs the latest MyLLM with <b>Settings → Allow apps to use your location</b> turned on.</p>';\n    return;\n  }\n  el(\"results\").innerHTML='<p class=\"note\">Tap what you need — it finds the nearest, with directions.</p>';\n  LOC.current().then(function(p){\n    here=p;\n    el(\"here\").textContent=p.address?(\"Near \"+p.address):\"Got your location\";\n  }).catch(function(e){\n    el(\"here\").textContent=\"Location off\";\n    el(\"results\").innerHTML='<p class=\"note\">'+(e&&e.message?e.message:\"Couldn’t get your location\")+'<br>Turn on <b>Settings → Allow apps to use your location</b>, then reopen.</p>';\n  });\n}\nstart();\n</script></body></html>\n"}