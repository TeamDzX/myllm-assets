{"name": "Plant Care", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>:root{color-scheme:light dark;--accent:#30d158}\n*{box-sizing:border-box}\nbody{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:18px;background:#f2f2f7;color:#111}\n@media(prefers-color-scheme:dark){body{background:#000;color:#eee}.item,input{background:#1c1c1e;color:#eee;border-color:#3a3a3c}.tips{background:#0e0e10}}\nh1{font-size:22px;margin:0 0 4px}\n.sub{font-size:13px;opacity:.6;margin-bottom:14px}\ninput{padding:11px;border:1px solid #d1d1d6;border-radius:10px;font-size:15px;background:#fff;font-family:inherit}\n.row{display:flex;gap:8px;margin-bottom:8px}\n#name{flex:1;min-width:0}#days{width:108px;flex:none}\nbutton{border:0;background:var(--accent);color:#fff;border-radius:10px;padding:11px 16px;font-size:15px;font-weight:600}\nbutton:disabled{opacity:.5}\n.add{width:100%}\n.item{background:#fff;border-radius:13px;padding:12px 14px;margin-bottom:9px;box-shadow:0 1px 3px rgba(0,0,0,.08);border-left:4px solid var(--accent)}\n.item.thirsty{border-left-color:#ff9f0a}.item.dry{border-left-color:#ff453a}\n.top{display:flex;align-items:flex-start;gap:10px}\n.leaf{font-size:26px;flex:none;line-height:1}\n.body{flex:1;min-width:0}\n.name{font-size:16px;font-weight:600}\n.meta{font-size:12px;opacity:.65;margin-top:2px}\n.meta .due.soon{color:#ff9f0a;font-weight:600}.meta .due.late{color:#ff453a;font-weight:600}\n.btns{display:flex;gap:8px;margin-top:9px}\n.btns .water{flex:1;background:#e8f7ee;color:#1a8a44;padding:9px;border-radius:9px;font-size:14px}\n.btns .tip{flex:none;background:#eef;color:#5e5ce6;padding:9px 12px;border-radius:9px;font-size:14px}\n@media(prefers-color-scheme:dark){.btns .water{background:#13351f;color:#5fd98a}.btns .tip{background:#15152a;color:#9a98ff}}\n.del{background:none;color:#ff453a;font-size:18px;padding:0 2px;flex:none}\n.tips{background:#f2f2f7;border-radius:9px;padding:9px 11px;margin-top:9px;font-size:13.5px;line-height:1.5;white-space:pre-wrap}\n#status{font-size:13px;opacity:.7;min-height:16px;margin:4px 0}\n.empty{text-align:center;opacity:.5;font-size:14px;padding:34px 0}\n</style></head><body>\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-family:-apple-system,system-ui,sans-serif;font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;line-height:1;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n<script>\n(function(){\n  if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;\n  window.__myllmAiWrap=true;\n  var orig=window.myllmAsk,depth=0,node=null;\n  function ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\n    node.innerHTML='<span class=\"myllm-ai-cog\">\\u2699\\uFE0F</span><span>AI is thinking\\u2026 <small>privately, on your device</small></span>';\n    (document.body||document.documentElement).appendChild(node);}\n  function show(){ensure();depth++;node.classList.add('on');}\n  function hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\n  window.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\n    return Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};\n})();\n</script>\n\n<h1>🪴 Plant Care</h1>\n<div class=\"sub\">Never forget to water again — track each plant and when it's next due.</div>\n<div class=\"row\"><input id=\"name\" placeholder=\"Plant (e.g. Monstera, tomatoes)\"><input id=\"days\" type=\"number\" inputmode=\"numeric\" min=\"1\" value=\"7\" aria-label=\"days between watering\"></div>\n<button class=\"add\" onclick=\"add()\">Add plant</button>\n<div id=\"status\"></div>\n<div id=\"list\"></div>\n<script>\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar plants=[];\nfunction el(i){return document.getElementById(i)}\nfunction save(){store.setItem('plants',JSON.stringify(plants))}\nfunction setStatus(t){el('status').textContent=t||''}\nfunction uid(){return 'p'+plants.reduce(function(m,p){return Math.max(m,+String(p.id).slice(1)||0)},0)+1}\nvar DAY=86400000;\n\nfunction add(){\n  var name=el('name').value.trim();if(!name)return;\n  var days=Math.max(1,parseInt(el('days').value,10)||7);\n  plants.push({id:uid(),name:name,interval:days,last:Date.now(),tips:null});\n  el('name').value='';el('days').value='7';\n  save();render();if(window.myllmHaptic)myllmHaptic('light');\n}\nfunction water(id){var p=byId(id);p.last=Date.now();save();render();if(window.myllmHaptic)myllmHaptic('success')}\nfunction del(id){plants=plants.filter(function(p){return p.id!==id});save();render()}\nfunction byId(id){return plants.filter(function(p){return p.id===id})[0]}\n\nfunction dueInfo(p){\n  var next=p.last+p.interval*DAY;\n  var days=Math.ceil((next-Date.now())/DAY);\n  if(days<0)return{txt:'Overdue by '+(-days)+'d',cls:'late',state:'dry'};\n  if(days===0)return{txt:'Water today',cls:'late',state:'thirsty'};\n  if(days===1)return{txt:'Water tomorrow',cls:'soon',state:'thirsty'};\n  return{txt:'Water in '+days+' days',cls:'',state:''};\n}\n\nfunction tips(id){\n  var p=byId(id);\n  if(!window.myllmAsk){setStatus('Care tips need AI — enable “Allow apps to use the AI” in Settings.');return}\n  setStatus('Getting care tips for '+p.name+'…');\n  myllmAsk('Give 3 short, practical care tips for growing \"'+p.name+'\" (watering, light, and one extra). Reply as exactly 3 lines starting with \"• \" and nothing else.')\n  .then(function(reply){\n    p.tips=reply.trim();save();render();setStatus('');\n  }).catch(function(err){setStatus('Could not get tips: '+err.message)});\n}\n\nfunction render(){\n  var L=el('list');L.innerHTML='';\n  if(!plants.length){L.innerHTML='<div class=\"empty\">No plants yet — add your first above. 🌱</div>';return}\n  plants.slice().sort(function(a,b){return(a.last+a.interval*DAY)-(b.last+b.interval*DAY)}).forEach(function(p){\n    var di=dueInfo(p);\n    var card=document.createElement('div');card.className='item'+(di.state?' '+di.state:'');\n    var top=document.createElement('div');top.className='top';\n    var leaf=document.createElement('div');leaf.className='leaf';leaf.textContent='🪴';\n    var body=document.createElement('div');body.className='body';\n    var nm=document.createElement('div');nm.className='name';nm.textContent=p.name;body.appendChild(nm);\n    var meta=document.createElement('div');meta.className='meta';\n    meta.innerHTML='💧 every '+p.interval+' day'+(p.interval===1?'':'s')+' · <span class=\"due '+di.cls+'\">'+di.txt+'</span>';\n    body.appendChild(meta);\n    var btns=document.createElement('div');btns.className='btns';\n    var w=document.createElement('button');w.className='water';w.textContent='💧 Watered';w.onclick=function(){water(p.id)};\n    var t=document.createElement('button');t.className='tip';t.textContent=p.tips?'🌱 Tips':'🌱 Care tips';t.onclick=function(){tips(p.id)};\n    btns.appendChild(w);btns.appendChild(t);body.appendChild(btns);\n    if(p.tips){var tp=document.createElement('div');tp.className='tips';tp.textContent=p.tips;body.appendChild(tp)}\n    var x=document.createElement('button');x.className='del';x.textContent='✕';x.onclick=function(){del(p.id)};\n    top.appendChild(leaf);top.appendChild(body);top.appendChild(x);\n    card.appendChild(top);L.appendChild(card);\n  });\n}\n\nel('name').addEventListener('keydown',function(e){if(e.key==='Enter')add()});\nel('days').addEventListener('keydown',function(e){if(e.key==='Enter')add()});\nstore.getItem('plants').then(function(v){\n  if(v)try{plants=JSON.parse(v)}catch(e){}\n  render();\n});\n</script></body></html>\n", "kind": "html", "iconSymbol": "leaf.fill", "iconColor": "green"}