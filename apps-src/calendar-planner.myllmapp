{"name": "Calendar Planner", "kind": "html", "iconSymbol": "calendar", "iconColor": "red", "html": "<!doctype html>\n<!--\n  Calendar Planner — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Calendar Planner</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"c367d4d1b9\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); --h:350; --bad:#ef4b4b; }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:760px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; border:none; background:none; } button:active{ transform:scale(.96); }\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 72% 52%), hsl(calc(var(--h) + 30) 62% 34%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:20px 2px 10px; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:12px; margin-bottom:12px; }\n  .mbar{ display:flex; align-items:center; justify-content:space-between; margin:0 2px 8px; }\n  .mbar b{ font-size:18px; font-weight:800; letter-spacing:-.01em; }\n  .mbar .nav{ display:flex; gap:6px; }\n  .mbar button{ height:36px; min-width:36px; padding:0 10px; border-radius:10px; background:var(--fill); display:grid; place-items:center; font-weight:700; font-size:13px; }\n  .dow, .grid{ display:grid; grid-template-columns:repeat(7, minmax(0,1fr)); }\n  .dow span{ text-align:center; font-size:11px; font-weight:750; color:var(--muted); padding:4px 0 6px; text-transform:uppercase; letter-spacing:.04em; }\n  .grid{ gap:3px; }\n  .day{ aspect-ratio:1/1.05; border-radius:12px; display:flex; flex-direction:column; align-items:center; justify-content:flex-start; padding-top:6px; gap:4px; position:relative; }\n  .day b{ font-size:15px; font-weight:650; font-variant-numeric:tabular-nums; width:30px; height:30px; display:grid; place-items:center; border-radius:50%; }\n  .day.out b{ color:var(--muted); opacity:.45; }\n  .day.today b{ background:hsl(var(--h) 72% 52%); color:#fff; font-weight:800; }\n  .day.sel{ background:var(--fill); }\n  .dots{ display:flex; gap:3px; height:6px; align-items:center; }\n  .dots i{ width:6px; height:6px; border-radius:50%; background:hsl(var(--h) 72% 52%); }\n  .dots i.done{ background:var(--muted); opacity:.5; }\n  .dots i.late{ background:var(--bad); }\n  .dots em{ font-style:normal; font-size:9.5px; font-weight:800; color:var(--muted); line-height:6px; }\n\n  .dayhead{ display:flex; align-items:baseline; gap:8px; margin:2px 2px 8px; }\n  .dayhead b{ font-size:16px; font-weight:750; }\n  .dayhead span{ font-size:13px; color:var(--muted); }\n  .item{ display:flex; align-items:center; gap:10px; padding:10px 4px; border-bottom:1px solid var(--line); }\n  .item:last-child{ border-bottom:none; }\n  .item .ck{ width:22px; height:22px; border-radius:50%; border:2px solid var(--line); flex-shrink:0; display:grid; place-items:center; color:#fff; }\n  .item.done .ck{ background:var(--muted); border-color:var(--muted); }\n  .item.done .tx{ color:var(--muted); text-decoration:line-through; }\n  .item .tx{ flex:1; min-width:0; overflow-wrap:anywhere; }\n  .item .when{ font-size:12.5px; font-weight:700; color:var(--muted); flex-shrink:0; }\n  .item.late .when{ color:var(--bad); }\n  .none{ color:var(--muted); font-size:14px; padding:8px 4px; }\n  .addrow{ display:flex; gap:8px; margin-top:10px; }\n  input{ flex:1; min-width:0; font:inherit; font-size:16px; padding:11px 12px; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; }\n  input:focus{ border-color:var(--acc); }\n  .go{ flex-shrink:0; min-height:44px; border-radius:12px; background:var(--acc); color:#fff; font-weight:700; padding:0 14px; }\n  .go[disabled]{ opacity:.5; }\n  .hint{ font-size:12.5px; color:var(--muted); margin:8px 4px 0; }\n  .notice{ background:var(--surface); border:1px solid var(--line); border-radius:14px; padding:12px 14px; font-size:13.5px; color:var(--muted); margin-bottom:12px; line-height:1.5; }\n  .notice b{ color:var(--ink); }\n  .empty{ text-align:center; padding:26px 18px 18px; }\n  .empty .tile{ width:52px; height:52px; border-radius:15px; font-size:22px; margin:0 auto 12px; }\n  .empty b{ display:block; font-size:16px; font-weight:750; }\n  .empty p{ font-size:13.5px; color:var(--muted); line-height:1.5; max-width:300px; margin:6px auto 0; }\n  [hidden]{ display:none !important; }\n  @media (prefers-reduced-motion:reduce){ button:active{ transform:none; } }\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-cal\" viewBox=\"0 0 24 24\"><rect x=\"3.5\" y=\"5\" width=\"17\" height=\"15.5\" rx=\"3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"/><path d=\"M3.5 10h17M8 3v4M16 3v4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"/><circle cx=\"8.5\" cy=\"14.5\" r=\"1.4\" fill=\"currentColor\"/><circle cx=\"12\" cy=\"14.5\" r=\"1.4\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-l\" viewBox=\"0 0 24 24\"><path d=\"M15 5l-7 7 7 7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-r\" viewBox=\"0 0 24 24\"><path d=\"M9 5l7 7-7 7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M5 12.6l4.6 4.6L19.2 7.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n</defs></svg>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-cal\"/></svg></div>\n  <div class=\"ht\"><h1>Calendar Planner</h1><p>Your tasks, on the days they're due</p></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Calendar Planner\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n\n<div id=\"notice\" class=\"notice\" hidden></div>\n\n<div id=\"main\">\n  <div class=\"card\">\n    <div class=\"mbar\"><b id=\"mLabel\">—</b><div class=\"nav\"><button id=\"prevM\" type=\"button\" aria-label=\"Previous month\"><svg class=\"i\"><use href=\"#i-l\"/></svg></button><button id=\"todayB\" type=\"button\">Today</button><button id=\"nextM\" type=\"button\" aria-label=\"Next month\"><svg class=\"i\"><use href=\"#i-r\"/></svg></button></div></div>\n    <div class=\"dow\" id=\"dow\"></div>\n    <div class=\"grid\" id=\"grid\"></div>\n  </div>\n\n  <div class=\"card\">\n    <div class=\"dayhead\"><b id=\"dTitle\">—</b><span id=\"dSub\"></span></div>\n    <div id=\"dList\"></div>\n    <div class=\"addrow\"><input id=\"dIn\" placeholder=\"Add a task for this day…\" autocomplete=\"off\" enterkeyhint=\"done\"><button class=\"go\" id=\"dAdd\" type=\"button\">Add</button></div>\n    <div class=\"hint\" id=\"dHint\">Adds it to Quick Todo with this date.</div>\n  </div>\n\n  <h2>Coming up</h2>\n  <div class=\"card\" id=\"agenda\"></div>\n</div>\n\n<script>\n/* Calendar Planner reads data/todos.json — written by Quick Todo in the shared\n   format of docs/SHARED_DATA.md (schema myllm.todos, version 1). It never\n   writes that file: a task added here is handed to Quick Todo (its add-todo\n   action), which stays the one owner of the list. */\nfunction el(i){ return document.getElementById(i); }\nfunction haptic(k){ try{ window.myllmHaptic && myllmHaptic(k); }catch(e){} }\nfunction esc(s){ return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;'); }\nfunction pad2(n){ return (n < 10 ? '0' : '') + n; }\nfunction dayOf(d){ return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate()); }\nfunction dateOf(day){ return new Date(+day.slice(0,4), +day.slice(5,7) - 1, +day.slice(8,10)); }\nfunction addDays(day, n){ var d = dateOf(day); d.setDate(d.getDate() + n); return dayOf(d); }\nfunction today(){ return dayOf(new Date()); }\n\nvar todos = [], view = null, sel = null, state = 'loading';\n\nfunction readTodos(){\n  var F = window.myllmFiles;\n  if (!F || !F.read) return Promise.resolve({ off: true });\n  return Promise.resolve().then(function(){ return F.read('data/todos.json'); }).then(function(text){\n    if (text == null) return { missing: true };\n    var j; try { j = JSON.parse(text); } catch(e){ return { bad: 'Quick Todo’s file couldn’t be read.' }; }\n    if (!j || j.schema !== 'myllm.todos') return { bad: 'data/todos.json isn’t a task list.' };\n    if (j.version !== 1) return { bad: 'Quick Todo saved a newer format (v' + j.version + '). Update Calendar Planner from the gallery.' };\n    return { items: Array.isArray(j.items) ? j.items.filter(function(x){ return x && typeof x.text === 'string'; }) : [] };\n  }).catch(function(e){ return /turned off|disabled|not allowed/i.test(String(e && e.message || e)) ? { off: true } : { missing: true }; });\n}\n\nfunction load(){\n  return readTodos().then(function(r){\n    todos = r.items || [];\n    var n = el('notice');\n    if (r.off){ n.innerHTML = '<b>Shared files are off.</b> Calendar Planner shows what Quick Todo saves to the shared workspace — turn on “Shared files” for apps in MyLLMos settings.'; n.hidden = false; }\n    else if (r.bad){ n.innerHTML = esc(r.bad); n.hidden = false; }\n    else if (r.missing){ n.innerHTML = 'Nothing from <b>Quick Todo</b> yet. Give tasks a date there (update it from the gallery if you have it), or add one below — it shows up here on its day.'; n.hidden = false; }\n    else {\n      var undated = todos.filter(function(t){ return !t.done && !t.due; }).length;\n      n.innerHTML = undated ? '<b>' + undated + '</b> open task' + (undated > 1 ? 's have' : ' has') + ' no date — give ' + (undated > 1 ? 'them one' : 'it one') + ' in Quick Todo to see ' + (undated > 1 ? 'them' : 'it') + ' here.' : '';\n      n.hidden = !undated;\n    }\n    if (!view){ view = today().slice(0, 7); sel = today(); }\n    render();\n  });\n}\n\nfunction onDay(day){ return todos.filter(function(t){ return t.due === day; }); }\n\nfunction render(){\n  var t = today();\n  var first = dateOf(view + '-01');\n  el('mLabel').textContent = first.toLocaleDateString(undefined, { month: 'long', year: 'numeric' });\n  /* Weeks start on Monday. */\n  var lead = (first.getDay() + 6) % 7, start = addDays(view + '-01', -lead);\n  var dowNames = []; for (var w = 0; w < 7; w++) dowNames.push(dateOf(addDays('2024-01-01', w)).toLocaleDateString(undefined, { weekday: 'narrow' }));\n  el('dow').innerHTML = dowNames.map(function(n){ return '<span>' + esc(n) + '</span>'; }).join('');\n  var cells = [];\n  var weeks = Math.ceil((lead + new Date(first.getFullYear(), first.getMonth() + 1, 0).getDate()) / 7);\n  for (var i = 0; i < weeks * 7; i++){\n    var day = addDays(start, i), items = onDay(day);\n    var dots = items.slice(0, 3).map(function(x){ return '<i class=\"' + (x.done ? 'done' : (day < t ? 'late' : '')) + '\"></i>'; }).join('') + (items.length > 3 ? '<em>+' + (items.length - 3) + '</em>' : '');\n    var label = dateOf(day).toLocaleDateString(undefined, { weekday: 'long', day: 'numeric', month: 'long' }) + (items.length ? ', ' + items.length + ' task' + (items.length > 1 ? 's' : '') : '');\n    cells.push('<button type=\"button\" class=\"day' + (day.slice(0, 7) !== view ? ' out' : '') + (day === t ? ' today' : '') + (day === sel ? ' sel' : '') + '\" data-day=\"' + day + '\" aria-label=\"' + esc(label) + '\"><b>' + (+day.slice(8)) + '</b><span class=\"dots\">' + dots + '</span></button>');\n  }\n  el('grid').innerHTML = cells.join('');\n  renderDay(); renderAgenda();\n}\n\nfunction itemRow(x, showWhen){\n  var late = !x.done && x.due && x.due < today();\n  var when = showWhen && x.due ? whenLabel(x.due) : '';\n  return '<div class=\"item' + (x.done ? ' done' : '') + (late ? ' late' : '') + '\"><span class=\"ck\">' + (x.done ? '<svg class=\"i\" style=\"width:12px;height:12px\"><use href=\"#i-check\"/></svg>' : '') + '</span><span class=\"tx\">' + esc(x.text) + '</span>' + (when ? '<span class=\"when\">' + esc(when) + '</span>' : '') + '</div>';\n}\nfunction whenLabel(day){\n  var t = today(); if (day === t) return 'Today'; if (day === addDays(t, 1)) return 'Tomorrow';\n  if (day < t) return 'Overdue · ' + dateOf(day).toLocaleDateString(undefined, { day: 'numeric', month: 'short' });\n  return dateOf(day).toLocaleDateString(undefined, day <= addDays(t, 6) ? { weekday: 'short' } : { weekday: 'short', day: 'numeric', month: 'short' });\n}\n\nfunction renderDay(){\n  var items = onDay(sel), t = today();\n  el('dTitle').textContent = sel === t ? 'Today' : dateOf(sel).toLocaleDateString(undefined, { weekday: 'long', day: 'numeric', month: 'long' });\n  var open = items.filter(function(x){ return !x.done; }).length;\n  el('dSub').textContent = items.length ? (open + ' to do' + (items.length - open ? ' · ' + (items.length - open) + ' done' : '')) : '';\n  el('dList').innerHTML = items.length ? items.map(function(x){ return itemRow(x, false); }).join('') : '<div class=\"none\">Nothing due ' + (sel === t ? 'today' : 'this day') + '.</div>';\n  var can = !!(window.myllmIntent && myllmIntent.send);\n  el('dAdd').disabled = !can; el('dIn').disabled = !can;\n  el('dHint').textContent = can ? 'Adds it to Quick Todo, due ' + (sel === t ? 'today' : whenLabel(sel).replace(/^Overdue · /, '')) + '.' : 'Adding tasks from here needs a newer MyLLM — add them in Quick Todo.';\n}\n\nfunction renderAgenda(){\n  var t = today(), end = addDays(t, 14);\n  var late = todos.filter(function(x){ return !x.done && x.due && x.due < t; }).sort(function(a, b){ return a.due < b.due ? -1 : 1; });\n  var soon = todos.filter(function(x){ return !x.done && x.due && x.due >= t && x.due <= end; }).sort(function(a, b){ return a.due < b.due ? -1 : a.due > b.due ? 1 : 0; });\n  var html = late.concat(soon).map(function(x){ return itemRow(x, true); }).join('');\n  el('agenda').innerHTML = html || '<div class=\"none\">Nothing due in the next two weeks.</div>';\n}\n\nel('grid').addEventListener('click', function(e){\n  var b = e.target.closest('.day'); if (!b) return;\n  sel = b.getAttribute('data-day'); if (sel.slice(0, 7) !== view) view = sel.slice(0, 7);\n  haptic('selection'); render();\n});\nfunction moveMonth(by){ var d = dateOf(view + '-01'); d.setMonth(d.getMonth() + by); view = dayOf(d).slice(0, 7); sel = view === today().slice(0, 7) ? today() : view + '-01'; haptic('selection'); render(); }\nel('prevM').onclick = function(){ moveMonth(-1); };\nel('nextM').onclick = function(){ moveMonth(1); };\nel('todayB').onclick = function(){ view = today().slice(0, 7); sel = today(); haptic('selection'); render(); };\n\n/* Hand the new task to Quick Todo; it owns the list and publishes it again.\n   We show it at once (marked as on its way) and read the file again later. */\nfunction addForDay(){\n  var text = el('dIn').value.trim(); if (!text || !window.myllmIntent) return;\n  var day = sel;\n  Promise.resolve().then(function(){ return myllmIntent.send('add-todo', { text: text, due: day }); }).then(function(){\n    el('dIn').value = ''; haptic('success');\n    todos.push({ id: 'pending_' + Date.now(), text: text, done: false, due: day });\n    render();\n  }).catch(function(){\n    el('dHint').textContent = 'Quick Todo isn’t installed (or is out of date) — get it from the gallery to add tasks from here.';\n  });\n}\nel('dAdd').onclick = addForDay;\nel('dIn').addEventListener('keydown', function(e){ if (e.key === 'Enter') addForDay(); });\n\ndocument.addEventListener('visibilitychange', function(){ if (!document.hidden) load(); });\nload();\n</script>\n<script>\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes.\n   The spacer keeps the header clear of the status bar / Dynamic Island. It is\n   live CSS — env(safe-area-inset-top) — not a measured number: the inset is\n   still 0 when the page loads and only grows once MyLLM's bar has gone (v1\n   measured once, so the title sat under the island). If the page's own styles\n   already pad the header down by the inset, the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  /* Does any rule that applies to the header or an ancestor already use the top inset? */\n  function pageHandlesInset(head){\n    var chain = [], n, found = false;\n    for (n = head; n && n.nodeType === 1; n = n.parentElement) chain.push(n);\n    function walk(rules){\n      for (var i = 0; i < rules.length && !found; i++){\n        var r = rules[i];\n        if (r.cssRules && !r.selectorText) { walk(r.cssRules); continue; }\n        if (!r.selectorText || !/safe-area-inset-top/.test(r.cssText) || !/(padding|margin|top)\\s*:/.test(r.cssText)) continue;\n        if (/\\.imm-safe/.test(r.selectorText)) continue;\n        for (var k = 0; k < chain.length; k++){\n          try { if (chain[k].matches(r.selectorText)) { found = true; break; } } catch(e){}\n        }\n      }\n    }\n    for (var s = 0; s < document.styleSheets.length && !found; s++){\n      try { walk(document.styleSheets[s].cssRules); } catch(e){}\n    }\n    for (n = head; n && n.nodeType === 1 && !found; n = n.parentElement){\n      if (/safe-area-inset-top/.test(n.getAttribute(\"style\") || \"\")) found = true;\n    }\n    return found;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = (document.body.classList.contains(\"imm\") && !pageHandlesInset(head)) ? \"env(safe-area-inset-top)\" : \"0px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n\n</script></body></html>\n"}