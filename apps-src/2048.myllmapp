{"name":"2048","html":"<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,user-scalable=no\">\n<title>2048</title>\n<style>:root{color-scheme:light dark}\nbody{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:18px;background:#faf8ef;color:#776e65;text-align:center;touch-action:none;overscroll-behavior:none}\n@media(prefers-color-scheme:dark){body{background:#161512;color:#e8e2d8}#board{background:#3a362f}.cell{background:#2a2722}}\nh1{font-size:24px;margin:4px 0 2px}\n#stats{font-size:13px;opacity:.65;margin-bottom:12px}\n#board{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;background:#bbada0;border-radius:12px;padding:8px;max-width:340px;margin:0 auto;aspect-ratio:1}\n.cell{display:flex;align-items:center;justify-content:center;border-radius:8px;background:#cdc1b4;font-weight:800;font-size:26px}\n#msg{min-height:20px;font-size:14px;margin-top:10px}\nbutton{border:0;background:#f2b179;color:#5b4632;border-radius:10px;padding:11px 26px;font-size:15px;font-weight:700;margin-top:14px}\n</style></head><body>\n<h1>🔢 2048</h1>\n<div id=\"stats\"></div>\n<div id=\"board\"></div>\n<div id=\"msg\">Swipe to merge tiles</div>\n<button onclick=\"start()\">New game</button>\n<script>\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar b=[],score=0,best=null,over=false,won=false;\nvar COLORS={2:'#eee4da',4:'#ede0c8',8:'#f2b179',16:'#f59563',32:'#f67c5f',64:'#f65e3b',128:'#edcf72',256:'#edcc61',512:'#edc850',1024:'#edc53f',2048:'#edc22e'};\nfunction el(i){return document.getElementById(i)}\nfunction start(){b=Array(16).fill(0);score=0;over=false;won=false;spawn();spawn();el('msg').textContent='Swipe to merge tiles';render()}\nfunction spawn(){var empty=[];b.forEach(function(v,i){if(!v)empty.push(i)});\nif(!empty.length)return;b[empty[Math.floor(Math.random()*empty.length)]]=Math.random()<0.9?2:4}\nfunction render(){var B=el('board');B.innerHTML='';\nb.forEach(function(v){var d=document.createElement('div');d.className='cell';\nif(v){d.textContent=v;d.style.background=COLORS[v]||'#3c3a32';d.style.color=v>4?'#fff':'#776e65';\nd.style.fontSize=v>=1024?'19px':v>=128?'22px':'26px'}\nB.appendChild(d)});\nel('stats').textContent='Score: '+score+(best!=null?' · Best: '+best:'')}\nfunction line(d,r){var idx=[];for(var c=0;c<4;c++){\nif(d===0)idx.push(r*4+c);else if(d===1)idx.push(r*4+3-c);\nelse if(d===2)idx.push(c*4+r);else idx.push((3-c)*4+r)}return idx}\nfunction move(d){if(over)return;var changed=false,mergedAny=false;\nfor(var r=0;r<4;r++){var idx=line(d,r);\nvar vals=idx.map(function(i){return b[i]}).filter(Boolean);\nfor(var i=0;i<vals.length-1;i++){if(vals[i]===vals[i+1]){vals[i]*=2;score+=vals[i];mergedAny=true;vals.splice(i+1,1)}}\nwhile(vals.length<4)vals.push(0);\nidx.forEach(function(bi,j){if(b[bi]!==vals[j])changed=true;b[bi]=vals[j]})}\nif(!changed)return;\nspawn();\nif(best==null||score>best){best=score;store.setItem('best',String(best))}\nrender();\nif(mergedAny&&window.myllmHaptic)myllmHaptic('light');\nif(!won&&b.indexOf(2048)>=0){won=true;el('msg').textContent='🎉 2048! Keep going?';\nif(window.myllmHaptic)myllmHaptic('success')}\nelse if(!canMove()){over=true;el('msg').textContent='💥 No moves left — '+score+' points';\nif(window.myllmHaptic)myllmHaptic('error')}}\nfunction canMove(){if(b.indexOf(0)>=0)return true;\nfor(var r=0;r<4;r++)for(var c=0;c<4;c++){var v=b[r*4+c];\nif(c<3&&b[r*4+c+1]===v)return true;if(r<3&&b[(r+1)*4+c]===v)return true}return false}\nvar tx=0,ty=0;\ndocument.addEventListener('touchstart',function(e){tx=e.touches[0].clientX;ty=e.touches[0].clientY},{passive:true});\ndocument.addEventListener('touchend',function(e){var dx=e.changedTouches[0].clientX-tx,dy=e.changedTouches[0].clientY-ty;\nif(Math.abs(dx)<24&&Math.abs(dy)<24)return;\nmove(Math.abs(dx)>Math.abs(dy)?(dx>0?1:0):(dy>0?3:2))},{passive:true});\ndocument.addEventListener('keydown',function(e){var m={ArrowLeft:0,ArrowRight:1,ArrowUp:2,ArrowDown:3}[e.key];if(m!==undefined)move(m)});\nstore.getItem('best').then(function(v){if(v)best=parseInt(v,10)||null;start()});\n</script></body></html>","kind":"html","iconSymbol":"cube.fill","iconColor":"yellow"}