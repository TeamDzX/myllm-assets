{"name": "2048", "html": "<!doctype html>\n<!--\n  2048 — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,user-scalable=no,viewport-fit=cover\">\n<title>2048</title>\n<style>:root{--build-id:\"9f8a708f9e\";color-scheme:light dark}\n  @property --h{ syntax:'<number>'; inherits:true; initial-value:42; }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  html,body{ height:100%; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:#0b0b10; color:#fff; overflow:hidden;\n    touch-action:none; overscroll-behavior:none; -webkit-user-select:none; user-select:none; }\n  button{ font:inherit; color:inherit; }\n\n  /* The stage: a hue-tinted backdrop in two layers, dark and light, so the\n     change between them can fade. */\n  .stage{ position:fixed; inset:0; --h:42; transition:--h 1.4s ease; color:#fff; }\n  .bg{ position:absolute; inset:0; transition:opacity .6s ease; }\n  .bg.d{ background:radial-gradient(120% 90% at 20% 10%, hsl(var(--h) 70% 34%), transparent 60%),\n      radial-gradient(120% 90% at 85% 95%, hsl(calc(var(--h) + 60) 65% 26%), transparent 62%), #0b0b10; }\n  .bg.l{ opacity:0; background:radial-gradient(120% 90% at 20% 0%, hsl(var(--h) 80% 84%), transparent 60%),\n      radial-gradient(120% 90% at 85% 100%, hsl(calc(var(--h) + 60) 78% 86%), transparent 62%), #f4f4f8; }\n  .lite{ color:#15151a; } .lite .bg.l{ opacity:1; } .lite .bg.d{ opacity:0; }\n\n  .col{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center;\n    padding:calc(12px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(14px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  .top{ width:100%; max-width:560px; height:44px; display:flex; align-items:center; justify-content:space-between; flex-shrink:0; }\n  .lbl{ font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; opacity:.62; white-space:nowrap; }\n  .glass{ border:1px solid rgba(255,255,255,.16); background:rgba(255,255,255,.12); color:inherit;\n    -webkit-backdrop-filter:blur(18px); backdrop-filter:blur(18px); }\n  .lite .glass{ border-color:rgba(0,0,0,.09); background:rgba(255,255,255,.62); }\n  svg{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  .rnd{ width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:15px; flex-shrink:0; }\n  .pill{ min-width:44px; height:44px; border-radius:99px; padding:0 16px; display:flex; align-items:center; justify-content:center; gap:6px;\n    font-size:19px; font-weight:800; font-variant-numeric:tabular-nums; flex-shrink:0; }\n  .pill small{ font-size:10px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; opacity:.6; }\n  .pill.bump{ animation:bump .28s ease; }\n  @keyframes bump{ 40%{ transform:scale(1.18); } }\n  .top .hide{ visibility:hidden; }\n\n  .wrap{ flex:1; width:100%; min-height:0; position:relative; display:flex; align-items:center; justify-content:center; margin:10px 0 34px; }\n  .foot{ position:absolute; left:0; right:0; top:calc(50% + var(--bh,320px) / 2 + 12px); text-align:center; font-size:12px; font-weight:600;\n    letter-spacing:.02em; opacity:.55; font-variant-numeric:tabular-nums; white-space:nowrap; }\n\n  /* One glass card over the board: title, paused, finished. */\n  .sheet{ position:absolute; left:50%; top:50%; width:max(232px, min(300px, calc(var(--b,320px) - 44px))); transform:translate(-50%,-50%) scale(.96);\n    opacity:0; pointer-events:none; border-radius:26px; padding:22px 20px 18px; text-align:center; box-shadow:0 24px 60px rgba(0,0,0,.35); z-index:5;\n    transition:opacity .28s ease, transform .28s cubic-bezier(.2,.8,.2,1); }\n  .sheet.on{ opacity:1; transform:translate(-50%,-50%); pointer-events:auto; }\n  /* whatever sits under an open card steps back, so the card reads */\n  .under{ transition:opacity .3s, filter .3s; } .veil .under{ opacity:.28; filter:blur(2px); }\n  .lite .sheet{ box-shadow:0 22px 50px rgba(20,20,40,.18); }\n  .sheet h1{ font-size:30px; font-weight:800; letter-spacing:-.02em; }\n  .sheet p{ font-size:13.5px; line-height:1.4; opacity:.72; margin-top:6px; }\n  .kick{ font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; opacity:.62; }\n  .big{ font-size:64px; font-weight:800; line-height:1.05; letter-spacing:-.03em; font-variant-numeric:tabular-nums; margin-top:4px; }\n  .big small{ display:block; font-size:12px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.6; margin-top:2px; }\n  .best{ display:inline-block; margin-top:10px; font-size:11.5px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; opacity:.7; }\n  .best.new{ opacity:1; color:#0b0b10; background:#ffd60a; border-radius:99px; padding:5px 11px; }\n  .sheet .act{ width:100%; height:50px; border-radius:99px; margin-top:10px; font-size:16px; font-weight:750;\n    display:flex; align-items:center; justify-content:center; gap:8px; }\n  .sheet .act:first-of-type{ margin-top:18px; }\n  .sheet .act:active, .rnd:active{ transform:scale(.96); }\n  .pri{ border:none; background:#fff; color:#0b0b10; box-shadow:0 10px 30px rgba(0,0,0,.3); }\n  .lite .pri{ background:#15151a; color:#fff; box-shadow:0 10px 26px rgba(20,20,40,.22); }\n\n  @media (max-height:430px){\n    .sheet{ padding:14px 18px 14px; } .sheet h1{ font-size:24px; } .big{ font-size:42px; }\n    .sheet .act{ height:44px; margin-top:8px; } .sheet .act:first-of-type{ margin-top:12px; } .sheet p{ display:none; }\n    .wrap{ margin:6px 0 26px; }\n  }\n  @media (prefers-reduced-motion:reduce){ .pill.bump{ animation:none; } .stage{ transition:none; } }\n\n  .board{ position:relative; z-index:1; width:var(--b,320px); height:var(--b,320px); border-radius:26px; background:rgba(10,10,16,.42);\n    border:1px solid rgba(255,255,255,.12); box-shadow:0 24px 60px rgba(0,0,0,.45); transition:background .6s, box-shadow .6s; flex-shrink:0; }\n  .lite .board{ background:rgba(255,255,255,.6); border-color:rgba(0,0,0,.06); box-shadow:0 22px 50px rgba(20,20,40,.16); }\n  .slot, .tile{ position:absolute; left:0; top:0; width:var(--t,70px); height:var(--t,70px); border-radius:calc(var(--t,70px) * .17); }\n  .slot{ background:rgba(255,255,255,.06); } .lite .slot{ background:rgba(20,20,40,.06); }\n  /* The outer box slides; the inner face pops — so the two never fight over transform. */\n  .tile{ transition:transform .13s cubic-bezier(.2,.8,.2,1); z-index:2; }\n  .tile.gone{ z-index:1; }\n  .still .tile{ transition:none; }\n  .tile b{ display:flex; width:100%; height:100%; align-items:center; justify-content:center; border-radius:inherit;\n    font-weight:800; letter-spacing:-.02em; font-variant-numeric:tabular-nums; box-shadow:inset 0 1px 0 rgba(255,255,255,.28), 0 4px 12px rgba(0,0,0,.18); }\n  .tile.new b{ animation:tin .2s cubic-bezier(.2,.8,.2,1) .09s both; }\n  .tile.hit b{ animation:thit .22s ease .1s; }\n  @keyframes tin{ from{ transform:scale(.2); opacity:0; } to{ transform:none; opacity:1; } }\n  @keyframes thit{ 45%{ transform:scale(1.16); } }\n  .toast{ position:absolute; left:50%; top:calc(50% - var(--bh,320px) / 2 - 8px); transform:translate(-50%,-100%) translateY(6px); opacity:0; pointer-events:none;\n    border-radius:99px; padding:7px 14px; font-size:12.5px; font-weight:800; letter-spacing:.04em; white-space:nowrap; transition:opacity .3s, transform .3s; z-index:4;\n    background:#ffd60a; color:#0b0b10; }\n  .toast.on{ opacity:1; transform:translate(-50%,-100%); }\n  @media (prefers-reduced-motion:reduce){ .tile{ transition:none; } .tile.new b, .tile.hit b{ animation:none; } }\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-play\" viewBox=\"0 0 24 24\"><path d=\"M8 5.5v13a1 1 0 0 0 1.52.85l10.4-6.5a1 1 0 0 0 0-1.7L9.52 4.65A1 1 0 0 0 8 5.5z\"/></symbol>\n  <symbol id=\"i-pause\" viewBox=\"0 0 24 24\"><rect x=\"6\" y=\"5\" width=\"4.2\" height=\"14\" rx=\"1.4\"/><rect x=\"13.8\" y=\"5\" width=\"4.2\" height=\"14\" rx=\"1.4\"/></symbol>\n  <symbol id=\"i-again\" viewBox=\"0 0 24 24\"><path d=\"M12 5V2.6a.6.6 0 0 0-1-.45L7.2 5.55a.6.6 0 0 0 0 .9L11 9.85a.6.6 0 0 0 1-.45V7a5.5 5.5 0 1 1-5.5 5.5 1 1 0 0 0-2 0A7.5 7.5 0 1 0 12 5z\"/></symbol>\n  <symbol id=\"i-close\" viewBox=\"0 0 24 24\"><path d=\"M6.4 5a1 1 0 0 0-1.4 1.4L10.6 12 5 17.6A1 1 0 0 0 6.4 19l5.6-5.6 5.6 5.6a1 1 0 0 0 1.4-1.4L13.4 12 19 6.4A1 1 0 0 0 17.6 5L12 10.6z\"/></symbol>\n</defs></svg>\n<div class=\"stage\" id=\"stage\">\n  <div class=\"bg d\"></div><div class=\"bg l\"></div>\n  <div class=\"col\">\n    <div class=\"top\">\n      <button class=\"glass rnd hide\" id=\"bHome\" aria-label=\"Close\"><svg><use href=\"#i-close\"/></svg></button>\n      <div class=\"lbl\">2048</div>\n      <div class=\"glass pill hide\" id=\"pill\" aria-label=\"Score\">0</div>\n    </div>\n    <div class=\"wrap\" id=\"wrap\">\n      <div class=\"board under\" id=\"board\"></div>\n      <div class=\"toast\" id=\"toast\"></div>\n      <div class=\"sheet glass\" id=\"sheet\"></div>\n      <div class=\"foot\" id=\"foot\"></div>\n    </div>\n  </div>\n</div>\n<script>\nfunction el(i){ return document.getElementById(i); }\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction haptic(s){ if (window.myllmHaptic) try { myllmHaptic(s); } catch(_){} }\nfunction load(k){ var s = window.myllmStorage; return s ? s.getItem(k).catch(function(){ return null; }) : Promise.resolve(null); }\nfunction keep(k, v){ var s = window.myllmStorage; if (s) try { s.setItem(k, v).catch(function(){}); } catch(_){} }\nvar calm = window.matchMedia && matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n\n/* ---------- look ---------- */\nfunction isLight(){ return !(window.matchMedia && matchMedia(\"(prefers-color-scheme: dark)\").matches); }\n/* A game in progress takes the whole display and goes dark. Where MyLLM can't\n   hide its own title bar, a dark stage under a white bar looks cut in half —\n   so in light mode, without myllmImmersive, the stage stays light. */\nfunction syncLook(){\n  el(\"stage\").classList.toggle(\"lite\", isLight() && !(state !== \"home\" && window.myllmImmersive));\n  if (typeof onLook === \"function\") onLook();\n}\nfunction syncChrome(){\n  if (!window.myllmImmersive) return;\n  try { myllmImmersive(state !== \"home\", {keepAwake:false}).catch(function(){}); } catch(_){}\n}\nfunction setHue(h){ el(\"stage\").style.setProperty(\"--h\", String(h)); }\nfunction showSheet(html, acts){\n  var s = el(\"sheet\"); s.innerHTML = html;\n  Object.keys(acts).forEach(function(id){ var b = el(id); if (b) b.onclick = acts[id]; });\n  s.classList.add(\"on\"); el(\"stage\").classList.add(\"veil\");\n}\nfunction hideSheet(){ el(\"sheet\").classList.remove(\"on\"); el(\"stage\").classList.remove(\"veil\"); }\nfunction bump(id){ var p = el(id); p.classList.remove(\"bump\"); void p.offsetWidth; p.classList.add(\"bump\"); }\ndocument.addEventListener(\"visibilitychange\", function(){\n  if (document.hidden){ if (typeof onHide === \"function\") onHide(); return; }\n  if (state !== \"home\") syncChrome();          /* MyLLM puts its bars back when the app is left */\n});\nif (window.matchMedia){\n  var mq = matchMedia(\"(prefers-color-scheme: dark)\");\n  if (mq.addEventListener) mq.addEventListener(\"change\", syncLook); else if (mq.addListener) mq.addListener(syncLook);\n}\n\nvar state = \"home\";                 /* home · play · over */\nvar grid = [], tiles = [], nextId = 1, live = false;      /* grid[r*4+c] = tile or null */\nvar score = 0, best = null, best0 = null, won = false, newBest = false, B = 320, T = 70, G = 9, toastT = 0;\n\n/* A tile's colour is its rank: cream and sand, then amber through coral and\n   rose into violet and blue — and gold for 2048. The backdrop follows the\n   biggest tile on the board. */\nvar RAMP = [null, [42,35,90,1], [42,55,80,1], [38,90,64,0], [26,92,60,0], [12,90,60,0], [352,85,57,0], [325,75,54,0],\n            [285,65,55,0], [255,70,59,0], [215,85,56,0]];\nfunction rank(v){ return Math.round(Math.log(v) / Math.LN2); }\nfunction face(b, v){\n  var e = rank(v), r = RAMP[e];\n  if (e === 11){ b.style.background = \"linear-gradient(145deg,#ffe27a,#ffb703)\"; b.style.color = \"#3b2a00\"; b.style.boxShadow = \"0 0 26px rgba(255,200,40,.65), inset 0 1px 0 rgba(255,255,255,.5)\"; }\n  else if (e > 11){ b.style.background = \"#15151a\"; b.style.color = \"#ffd60a\"; b.style.boxShadow = \"0 0 0 1.5px #ffd60a inset\"; }\n  else { b.style.background = \"hsl(\" + r[0] + \" \" + r[1] + \"% \" + r[2] + \"%)\"; b.style.color = r[3] ? \"#4a4030\" : \"#fff\"; b.style.boxShadow = \"\"; }\n  b.style.fontSize = (T * (v < 100 ? .42 : v < 1000 ? .34 : v < 10000 ? .27 : .22)).toFixed(1) + \"px\";\n  b.textContent = v;\n}\nfunction hueFor(v){ var e = rank(v); return e < 3 ? 42 : e >= 11 ? 46 : RAMP[e][0]; }\n\n/* ---------- the glass card ---------- */\nfunction bestLine(){\n  if (newBest) return '<div class=\"best new\">New best</div>';\n  return best != null ? '<div class=\"best\">Best ' + best + '</div>' : \"\";\n}\nfunction card(kind){\n  var h;\n  if (kind === \"home\") h = '<h1>2048</h1><p>Swipe to slide the tiles. Two the same merge into one — can you reach 2048?</p>' + bestLine() +\n    (live ? '<button class=\"act pri\" id=\"sA\"><svg><use href=\"#i-play\"/></svg>Resume</button><button class=\"act glass\" id=\"sB\">New game</button>'\n          : '<button class=\"act pri\" id=\"sB\"><svg><use href=\"#i-play\"/></svg>Play</button>');\n  else h = '<div class=\"kick\">No moves left</div><div class=\"big\">' + score + '</div>' + bestLine() +\n    '<button class=\"act pri\" id=\"sB\"><svg><use href=\"#i-again\"/></svg>Play again</button><button class=\"act glass\" id=\"sC\">Done</button>';\n  showSheet(h, {sA:resume, sB:begin, sC:goHome});\n}\nfunction hud(){\n  var playing = state === \"play\" || state === \"over\";\n  el(\"bHome\").classList.toggle(\"hide\", state !== \"play\");\n  el(\"pill\").classList.toggle(\"hide\", !playing);\n  el(\"pill\").textContent = score;\n  el(\"foot\").textContent = state === \"home\" ? \"\" : (best != null ? \"Best \" + best : \"Swipe to merge tiles\");\n}\nfunction toast(t){\n  var e = el(\"toast\"); e.textContent = t; e.classList.add(\"on\");\n  clearTimeout(toastT); toastT = setTimeout(function(){ e.classList.remove(\"on\"); }, 2600);\n}\n\n/* ---------- board ---------- */\nfunction xy(i){ return {x:G + (i % 4) * (T + G), y:G + Math.floor(i / 4) * (T + G)}; }\nfunction put(t, i){ var p = xy(i); t.el.style.transform = \"translate(\" + p.x.toFixed(1) + \"px,\" + p.y.toFixed(1) + \"px)\"; t.at = i; }\nfunction make(v, i, fresh){\n  var d = document.createElement(\"div\"), b = document.createElement(\"b\");\n  d.className = \"tile\" + (fresh ? \" new\" : \"\"); d.appendChild(b); face(b, v);\n  var t = {id:nextId++, v:v, el:d, at:i}; put(t, i); el(\"board\").appendChild(d); tiles.push(t); return t;\n}\nfunction wipe(){ tiles.forEach(function(t){ t.el.remove(); }); tiles = []; grid = []; for (var i = 0; i < 16; i++) grid.push(null); }\nfunction fit(){\n  var w = el(\"wrap\"), bd = el(\"board\");\n  B = Math.max(180, Math.floor(Math.min(w.clientWidth, w.clientHeight, 520)));\n  G = B * .028; T = (B - G * 5) / 4;\n  var st = el(\"stage\").style; st.setProperty(\"--b\", B + \"px\"); st.setProperty(\"--bh\", B + \"px\"); st.setProperty(\"--t\", T.toFixed(2) + \"px\");\n  bd.classList.add(\"still\");\n  bd.querySelectorAll(\".slot\").forEach(function(s, i){ var p = xy(i); s.style.transform = \"translate(\" + p.x.toFixed(1) + \"px,\" + p.y.toFixed(1) + \"px)\"; });\n  tiles.forEach(function(t){ put(t, t.at); face(t.el.firstChild, t.v); });\n  void bd.offsetWidth; bd.classList.remove(\"still\");\n}\nfunction showcase(){                  /* title screen: the whole ramp, dimmed, behind the glass */\n  wipe(); for (var e = 1; e <= 11; e++) grid[e - 1] = make(Math.pow(2, e), e - 1, false);\n}\n\n/* ---------- game (rules unchanged) ---------- */\nfunction spawn(){\n  var empty = []; grid.forEach(function(t, i){ if (!t) empty.push(i); });\n  if (!empty.length) return;\n  var i = empty[Math.floor(Math.random() * empty.length)];\n  grid[i] = make(Math.random() < 0.9 ? 2 : 4, i, true);\n}\nfunction line(d, r){\n  var idx = [];\n  for (var c = 0; c < 4; c++){\n    if (d === 0) idx.push(r * 4 + c); else if (d === 1) idx.push(r * 4 + 3 - c);\n    else if (d === 2) idx.push(c * 4 + r); else idx.push((3 - c) * 4 + r);\n  }\n  return idx;\n}\nfunction move(d){\n  if (state !== \"play\") return;\n  var changed = false, mergedAny = false, dying = [];\n  for (var r = 0; r < 4; r++){\n    var idx = line(d, r), row = idx.map(function(i){ return grid[i]; }).filter(Boolean), out = [];\n    for (var i = 0; i < row.length; i++){\n      if (i < row.length - 1 && row[i].v === row[i + 1].v){\n        row[i].v *= 2; row[i].hit = true; score += row[i].v; mergedAny = true;\n        row[i + 1].into = out.length; dying.push({t:row[i + 1], line:idx}); out.push(row[i]); i++;\n      } else out.push(row[i]);\n    }\n    for (var j = 0; j < 4; j++){\n      var t = out[j] || null;\n      if (grid[idx[j]] !== t) changed = true;\n      grid[idx[j]] = t; if (t && t.at !== idx[j]) put(t, idx[j]);\n    }\n  }\n  if (!changed && !mergedAny) return;\n  dying.forEach(function(o){                       /* slides under its partner, then goes */\n    var t = o.t; t.el.classList.add(\"gone\"); put(t, o.line[t.into]);\n    tiles.splice(tiles.indexOf(t), 1); setTimeout(function(){ t.el.remove(); }, calm ? 0 : 140);\n  });\n  tiles.forEach(function(t){\n    t.el.classList.remove(\"new\");\n    if (t.hit){ t.hit = false; face(t.el.firstChild, t.v); t.el.classList.remove(\"hit\"); void t.el.offsetWidth; t.el.classList.add(\"hit\"); }\n  });\n  spawn();\n  if (best == null || score > best){ best = score; keep(\"best\", String(best)); if (best0 == null || score > best0) newBest = score > 0; }\n  el(\"pill\").textContent = score; if (mergedAny){ bump(\"pill\"); haptic(\"light\"); }\n  var mx = 0; tiles.forEach(function(t){ if (t.v > mx) mx = t.v; }); setHue(hueFor(mx));\n  hud();\n  if (!won && tiles.some(function(t){ return t.v === 2048; })){ won = true; toast(\"2048! Keep going?\"); haptic(\"success\"); }\n  else if (!canMove()){ live = false; state = \"over\"; haptic(\"error\"); setTimeout(function(){ if (state === \"over\"){ card(\"over\"); hud(); } }, 600); }\n}\nfunction canMove(){\n  for (var i = 0; i < 16; i++) if (!grid[i]) return true;\n  for (var r = 0; r < 4; r++) for (var c = 0; c < 4; c++){\n    var v = grid[r * 4 + c].v;\n    if (c < 3 && grid[r * 4 + c + 1].v === v) return true;\n    if (r < 3 && grid[(r + 1) * 4 + c].v === v) return true;\n  }\n  return false;\n}\nfunction begin(){\n  haptic(\"medium\");\n  wipe(); score = 0; won = false; newBest = false; best0 = best; live = true; state = \"play\";\n  spawn(); spawn(); setHue(42);\n  hideSheet(); hud(); syncLook(); syncChrome();\n}\nfunction resume(){ haptic(\"light\"); state = \"play\"; hideSheet(); hud(); syncLook(); syncChrome(); }\nfunction goHome(){\n  haptic(\"light\");\n  state = \"home\"; if (!live){ newBest = false; showcase(); setHue(42); }\n  card(\"home\"); hud(); syncLook(); syncChrome();\n}\n\n/* ---------- input ---------- */\nvar px = 0, py = 0, tracking = false;\ndocument.addEventListener(\"pointerdown\", function(e){\n  if (e.target.closest && e.target.closest(\"button\")) return;\n  tracking = true; px = e.clientX; py = e.clientY;\n});\ndocument.addEventListener(\"pointermove\", function(e){\n  if (!tracking) return;\n  var dx = e.clientX - px, dy = e.clientY - py;\n  if (Math.abs(dx) < 24 && Math.abs(dy) < 24) return;\n  tracking = false;                               /* one slide per swipe */\n  move(Math.abs(dx) > Math.abs(dy) ? (dx > 0 ? 1 : 0) : (dy > 0 ? 3 : 2));\n});\ndocument.addEventListener(\"pointerup\", function(){ tracking = false; });\ndocument.addEventListener(\"pointercancel\", function(){ tracking = false; });\ndocument.addEventListener(\"keydown\", function(e){\n  var m = {ArrowLeft:0, ArrowRight:1, ArrowUp:2, ArrowDown:3, a:0, d:1, w:2, s:3}[e.key];\n  if (m !== undefined){ move(m); e.preventDefault(); }\n  else if (e.key === \"Escape\" && state === \"play\") goHome();\n  else if (e.key === \"Enter\" && state !== \"play\") begin();\n});\nel(\"bHome\").onclick = goHome;\nwindow.addEventListener(\"resize\", fit);\n\n/* ---------- boot ---------- */\n(function(){ var bd = el(\"board\"); for (var i = 0; i < 16; i++){ var s = document.createElement(\"div\"); s.className = \"slot\"; bd.appendChild(s); } })();\nfit(); showcase(); syncLook(); card(\"home\"); hud();\nload(\"best\").then(function(v){\n  if (v){ best = parseInt(v, 10) || null; if (state === \"home\") card(\"home\"); hud(); }\n});\n</script></body></html>\n", "kind": "html", "iconSymbol": "cube.fill", "iconColor": "yellow"}