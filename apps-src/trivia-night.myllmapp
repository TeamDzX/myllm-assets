{"name": "Trivia Night", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>:root{color-scheme:light dark}\n*{box-sizing:border-box}\nbody{font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);margin:0;padding:16px;background:var(--myllm-bg,#f2f2f7);color:var(--myllm-text,#111)}\nh1{font-size:22px;margin:0 0 2px}\n.sub{font-size:13px;color:var(--myllm-muted,#8a8a8e);margin:0 0 14px}\nlabel{font-size:13px;font-weight:600;display:block;margin:10px 0 4px}\ninput,select{width:100%;padding:11px;border:1px solid var(--myllm-border,#d1d1d6);border-radius:12px;font-size:16px;background:var(--myllm-surface,#fff);color:var(--myllm-text,#111)}\nbutton.go{width:100%;border:0;background:var(--myllm-accent,#0a84ff);color:#fff;border-radius:12px;padding:13px;font-size:16px;font-weight:700;margin-top:14px}\nbutton.go:disabled{opacity:.5}\n.bar{display:flex;justify-content:space-between;font-size:13px;color:var(--myllm-muted,#8a8a8e);margin-bottom:10px}\n.q{background:var(--myllm-surface,#fff);border-radius:16px;padding:16px;margin-top:6px}\n.q h2{font-size:18px;line-height:1.35;margin:0 0 14px}\n.opt{display:block;width:100%;text-align:left;border:1px solid var(--myllm-border,#d1d1d6);background:var(--myllm-bg,#f7f7fa);color:var(--myllm-text,#111);border-radius:12px;padding:13px;font-size:16px;margin-bottom:9px}\n.opt.correct{background:#34c759;border-color:#34c759;color:#fff}\n.opt.wrong{background:#ff3b30;border-color:#ff3b30;color:#fff}\n.opt:disabled{opacity:1}\n.fact{font-size:14px;color:var(--myllm-muted,#8a8a8e);margin:8px 2px 0;line-height:1.45}\n.note{color:var(--myllm-muted,#8a8a8e);font-size:14px;text-align:center;margin-top:18px;line-height:1.5}\n.big{font-size:46px;font-weight:800;text-align:center;margin:8px 0}\n@media(min-width:768px){body{max-width:720px;margin-left:auto;margin-right:auto}}\n</style></head><body>\n<h1>🧠 Trivia Night</h1>\n<p class=\"sub\">Pick any topic — your AI writes a fresh quiz every time.</p>\n<div id=\"app\"></div>\n\n<script>\nvar ASK = window.myllmAsk || null;\nvar store = window.myllmStorage || {getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar haptic = window.myllmHaptic || function(){};\nvar qs = [], idx = 0, score = 0;\n\nfunction el(id){return document.getElementById(id)}\n\nfunction setup(){\n  el('app').innerHTML =\n    '<label>Topic</label><input id=\"topic\" placeholder=\"90s movies, space, football…\">'+\n    '<label>Difficulty</label><select id=\"diff\"><option>Easy</option><option selected>Medium</option><option>Hard</option></select>'+\n    '<button class=\"go\" id=\"goBtn\" onclick=\"start()\">Start quiz</button>'+\n    '<p class=\"note\" id=\"best\"></p>';\n  store.getItem('bestScore').then(function(v){ if(v) el('best').textContent='🏆 Best: '+v+'/5'; });\n}\n\nfunction start(){\n  var topic = el('topic').value.trim();\n  if(!topic){ el('topic').focus(); return; }\n  if(!ASK){ el('app').innerHTML='<p class=\"note\">This app needs the latest MyLLM with <b>Settings → Allow apps to use the AI</b> turned on.</p>'; return; }\n  haptic('light');\n  el('goBtn').disabled=true; el('goBtn').textContent='Building quiz…';\n  var diff = el('diff').value;\n  var prompt = 'Create a fun '+diff+'-difficulty trivia quiz of 5 questions about \"'+topic+'\". '+\n    'Reply with EXACTLY these labelled lines and nothing else, repeating the block of 4 lines for each of the 5 questions:\\n'+\n    'Q: the question text\\n'+\n    'OPTION: one answer choice — repeat this line for each of the 4 choices\\n'+\n    'ANSWER: the correct choice, written out again\\n'+\n    'FACT: one short interesting fact about the answer';\n  var sys = {system:'You write fun, accurate trivia quizzes. Follow the requested labelled-line format exactly.'};\n  ASK(prompt, sys)\n    .then(function(reply){ return parse(reply||''); })\n    .catch(function(){ return ASK(prompt+'\\nIMPORTANT: fill each labelled line with real content — never repeat the instruction text.', sys)\n      .then(function(reply){ return parse(reply||''); }); })\n    .then(function(data){ qs = data; idx = 0; score = 0; showQ(); })\n    .catch(function(e){ el('app').innerHTML='<p class=\"note\">'+(e&&e.message?e.message:'Something went wrong')+'</p><button class=\"go\" onclick=\"setup()\">Try again</button>'; });\n}\n\n/* Labelled lines, not JSON — small models (Apple Intelligence) echo JSON\n   templates back verbatim. Echoed instructions are rejected and retried. */\nvar ECHO=/the question text|one answer choice|repeat this line|each of the 4 choices|the correct choice|one short interesting fact|labelled line/i;\nfunction parse(text){\n  var blocks=[], cur=null, got=false;\n  String(text||'').split(/\\r?\\n/).forEach(function(raw){\n    var ln=raw.replace(/\\*\\*/g,'').trim();\n    var m=ln.match(/^[-*#>\\s]*(QUESTIONS?|Q|OPTIONS?|ANSWERS?|FACTS?)\\s*\\d*\\s*[::]\\s*(.*)$/i);\n    if(!m)return;\n    got=true;\n    var k=m[1].toUpperCase().replace(/S$/,''), v=m[2].trim();\n    if(k==='Q'||k==='QUESTION'){ cur={q:v,options:[],ans:'',fact:''}; blocks.push(cur); }\n    else if(!cur)return;\n    else if(k==='OPTION'&&v)cur.options.push(v.replace(/^[A-Da-d][).]\\s*/,''));\n    else if(k==='ANSWER')cur.ans=v;\n    else if(k==='FACT')cur.fact=v;\n  });\n  if(!got){ // model answered in the old JSON shape — accept it\n    try{ var s=text.indexOf('['), e=text.lastIndexOf(']'); if(s>=0&&e>s){ var arr=JSON.parse(text.slice(s,e+1)); if(Array.isArray(arr)){ var old=arr.filter(valid).slice(0,5); if(old.length) return old; } } }catch(err){}\n    throw new Error('Could not build a quiz — try another topic.');\n  }\n  var out=[];\n  blocks.forEach(function(c){\n    if(!c.q||ECHO.test(c.q))return;\n    var opts=c.options.filter(function(x){return x&&!ECHO.test(x)});\n    if(opts.length<2)return;\n    var a=answerIndex(c.ans,opts);\n    if(a<0)return;\n    out.push({q:c.q,options:opts,answer:a,fact:(c.fact&&!ECHO.test(c.fact))?c.fact:''});\n  });\n  if(!out.length){ throw new Error('Could not build a quiz — try another topic.'); }\n  return out.slice(0,5);\n}\nfunction answerIndex(v,opts){\n  v=String(v||'').trim();\n  if(!v||ECHO.test(v))return -1;\n  var m=v.match(/^\\(?([1-9])\\)?[.)]?$/);\n  if(m){ var n=parseInt(m[1],10)-1; return n<opts.length?n:-1; }\n  m=v.match(/^\\(?([A-Da-d])\\)?[.)]?$/);\n  if(m){ var n2=m[1].toUpperCase().charCodeAt(0)-65; return n2<opts.length?n2:-1; }\n  var t=norm(v.replace(/^[A-Da-d][).]\\s*/,''));\n  if(!t)return -1;\n  for(var i=0;i<opts.length;i++)if(norm(opts[i])===t)return i;\n  for(i=0;i<opts.length;i++){ var o=norm(opts[i]); if(o&&(t.indexOf(o)>=0||o.indexOf(t)>=0))return i; }\n  return -1;\n}\nfunction norm(s){ return String(s||'').toLowerCase().replace(/[^a-z0-9]+/g,''); }\nfunction valid(q){ return q && q.q && Array.isArray(q.options) && q.options.length>=2 && typeof q.answer==='number'; }\n\nfunction showQ(){\n  var q = qs[idx];\n  var h = '<div class=\"bar\"><span>Question '+(idx+1)+' of '+qs.length+'</span><span>Score: '+score+'</span></div>';\n  h += '<div class=\"q\"><h2></h2><div id=\"opts\"></div><div class=\"fact\" id=\"fact\"></div></div>';\n  el('app').innerHTML = h;\n  el('app').querySelector('h2').textContent = q.q;\n  var opts = el('opts');\n  q.options.forEach(function(opt, i){\n    var b = document.createElement('button'); b.className='opt'; b.textContent = opt;\n    b.onclick = function(){ answer(i, b); };\n    opts.appendChild(b);\n  });\n}\n\nfunction answer(i, btn){\n  var q = qs[idx];\n  var buttons = el('opts').querySelectorAll('.opt');\n  buttons.forEach(function(b,j){ b.disabled=true; if(j===q.answer) b.classList.add('correct'); });\n  if(i===q.answer){ score++; haptic('success'); }\n  else { btn.classList.add('wrong'); haptic('error'); }\n  if(q.fact) el('fact').textContent = '💡 '+q.fact;\n  var next = document.createElement('button'); next.className='go';\n  next.textContent = (idx === qs.length-1) ? 'See results' : 'Next question';\n  next.onclick = function(){ idx++; if(idx<qs.length) showQ(); else finish(); };\n  el('app').querySelector('.q').appendChild(next);\n}\n\nfunction finish(){\n  haptic(score>=4?'success':'light');\n  store.getItem('bestScore').then(function(v){\n    var best = Math.max(parseInt(v||'0',10), score);\n    store.setItem('bestScore', String(best));\n    var msg = score===5?'Perfect! 🎉':score>=3?'Nicely done! 👏':'Good try! 🙂';\n    var h = '<div class=\"q\" style=\"text-align:center\"><h2>'+msg+'</h2>'+\n      '<div class=\"big\">'+score+'/'+qs.length+'</div>'+\n      '<p class=\"note\">🏆 Best: '+best+'/5</p>'+\n      '<button class=\"go\" onclick=\"setup()\">Play again</button>'+\n      (window.myllmShare?'<button class=\"go\" style=\"background:rgba(10,132,255,.14);color:var(--myllm-accent,#0a84ff)\" id=\"sh\">Share my score</button>':'')+\n      '</div>';\n    el('app').innerHTML = h;\n    var sh = el('sh'); if(sh) sh.onclick=function(){ window.myllmShare('I scored '+score+'/5 on Trivia Night! 🧠'); };\n  });\n}\n\nsetup();\n</script></body></html>\n"}