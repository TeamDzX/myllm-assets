{"name": "Habit Streaks", "html": "<!doctype html>\n<!--\n  Habit Streaks — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Habit Streaks</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"f4f010511c\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); --h:26; }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:760px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; border:none; background:none; } button:active{ transform:scale(.96); }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 28%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:20px 2px 10px; }\n\n  .hero{ border-radius:20px; padding:16px 18px; color:#fff; margin-bottom:12px; display:flex; align-items:center; gap:16px;\n    background:linear-gradient(145deg, hsl(var(--h) 72% 50%), hsl(calc(var(--h) - 22) 66% 32%)); box-shadow:0 10px 28px hsl(var(--h) 60% 30% / .25); }\n  .hero .k{ font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.8; }\n  .hero .n{ font-size:44px; font-weight:800; line-height:1.05; letter-spacing:-.03em; font-variant-numeric:tabular-nums; }\n  .hero .n small{ font-size:22px; opacity:.7; font-weight:750; }\n  .hero .main{ flex:1; min-width:0; }\n  .hero .bar{ height:6px; border-radius:99px; background:rgba(255,255,255,.25); margin-top:8px; overflow:hidden; }\n  .hero .bar i{ display:block; height:100%; border-radius:99px; background:#fff; transition:width .35s cubic-bezier(.2,.8,.2,1); }\n  .hero .best{ flex-shrink:0; text-align:center; background:rgba(255,255,255,.16); border:1px solid rgba(255,255,255,.22); border-radius:16px; padding:10px 12px; min-width:84px; }\n  .hero .best b{ display:flex; align-items:center; justify-content:center; gap:4px; font-size:24px; font-weight:800; font-variant-numeric:tabular-nums; }\n  .hero .best em{ font-style:normal; }\n  .hero .best span{ display:block; font-size:10.5px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; opacity:.8; margin-top:1px; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  .add{ display:flex; gap:8px; }\n  input{ flex:1; min-width:0; font:inherit; font-size:16px; padding:12px; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; }\n  input:focus{ border-color:var(--acc); }\n  .go{ flex-shrink:0; min-height:46px; border-radius:12px; background:var(--acc); color:#fff; font-weight:700; padding:0 16px; display:flex; align-items:center; gap:6px; }\n\n  .list{ display:grid; gap:8px; }\n  .list{ grid-template-columns:minmax(0,1fr); }\n  @media (min-width:768px){ .list{ grid-template-columns:repeat(2,minmax(0,1fr)); } }\n  .habit{ display:flex; align-items:center; gap:12px; background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:10px 8px 10px 12px; }\n  .habit.on{ border-color:hsl(var(--h) 70% 55% / .7); }\n  .check{ width:44px; height:44px; border-radius:50%; flex-shrink:0; display:flex; align-items:center; justify-content:center;\n    border:2.4px solid var(--line); color:transparent; font-size:18px; transition:background .2s, border-color .2s, color .2s; }\n  .habit.on .check{ background:hsl(var(--h) 72% 50%); border-color:hsl(var(--h) 72% 50%); color:#fff; }\n  .habit .nm{ flex:1; min-width:0; }\n  .habit .nm b{ display:block; font-size:16px; font-weight:650; overflow-wrap:anywhere; }\n  .habit .nm small{ display:flex; align-items:center; gap:4px; font-size:12.5px; color:var(--muted); margin-top:2px; font-variant-numeric:tabular-nums; }\n  .habit.on .nm small{ color:hsl(var(--h) 70% 42%); }\n  @media (prefers-color-scheme:dark){ .habit.on .nm small{ color:hsl(var(--h) 85% 64%); } }\n  .habit .nm small svg{ width:13px; height:13px; }\n  .del{ width:44px; height:44px; flex-shrink:0; color:var(--muted); display:flex; align-items:center; justify-content:center; font-size:14px; }\n\n  .empty{ text-align:center; padding:26px 20px 14px; }\n  .empty .tile{ width:48px; height:48px; border-radius:14px; font-size:21px; margin:0 auto 10px; opacity:.9; }\n  .empty b{ display:block; font-size:16px; font-weight:750; }\n  .empty p{ font-size:13.5px; color:var(--muted); line-height:1.5; max-width:280px; margin:5px auto 0; }\n  /* v6: the heatmap — every day of the last 18 weeks, Monday at the top. */\n  .heat{ overflow:hidden; }\n  .heat .months{ display:grid; font-size:10.5px; color:var(--muted); font-weight:700; margin:0 0 4px 22px; height:14px; }\n  .heat .wrap{ display:flex; gap:4px; }\n  .heat .wd{ display:grid; grid-template-rows:repeat(7,1fr); font-size:9.5px; color:var(--muted); font-weight:700; width:18px; }\n  .heat .wd span{ display:flex; align-items:center; }\n  .heat .cells{ flex:1; display:grid; grid-auto-flow:column; grid-template-rows:repeat(7,1fr); gap:3px; }\n  .heat .cells button{ aspect-ratio:1/1; border-radius:3px; background:var(--fill); padding:0; min-width:0; }\n  .heat .cells button.l1{ background:hsl(var(--h) 80% 55% / .35); }\n  .heat .cells button.l2{ background:hsl(var(--h) 80% 52% / .58); }\n  .heat .cells button.l3{ background:hsl(var(--h) 80% 50% / .8); }\n  .heat .cells button.l4{ background:hsl(var(--h) 85% 46%); }\n  .heat .cells button.sel{ outline:2px solid var(--ink); outline-offset:1px; }\n  .heat .cells button.future{ visibility:hidden; }\n  .heat .foot{ display:flex; align-items:center; gap:8px; margin-top:10px; font-size:12.5px; color:var(--muted); min-height:20px; }\n  .heat .foot .txt{ flex:1; min-width:0; }\n  .heat .foot .txt b{ color:var(--ink); font-weight:700; }\n  .heat .legend{ display:flex; align-items:center; gap:3px; font-size:10.5px; }\n  .heat .legend i{ width:10px; height:10px; border-radius:2px; display:inline-block; background:var(--fill); }\n  .heat .legend i.l2{ background:hsl(var(--h) 80% 52% / .58); } .heat .legend i.l4{ background:hsl(var(--h) 85% 46%); }\n  .week7{ display:flex; gap:3px; margin-top:6px; }\n  .week7 i{ width:9px; height:9px; border-radius:50%; background:var(--fill); }\n  .week7 i.on{ background:hsl(var(--h) 80% 50%); }\n  .auto{ display:flex; align-items:center; gap:12px; background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:10px 12px; margin-bottom:8px; }\n  .auto .tile{ width:40px; height:40px; border-radius:12px; font-size:17px; }\n  .auto .nm{ flex:1; min-width:0; }\n  .auto .nm b{ display:block; font-size:15.5px; font-weight:650; }\n  .auto .nm small{ display:block; font-size:12.5px; color:var(--muted); margin-top:1px; }\n  .auto .n{ text-align:right; font-variant-numeric:tabular-nums; }\n  .auto .n b{ display:block; font-size:18px; font-weight:800; }\n  .auto .n small{ font-size:10.5px; color:var(--muted); font-weight:700; text-transform:uppercase; letter-spacing:.06em; }\n  .hint2{ font-size:12.5px; color:var(--muted); margin:-2px 2px 10px; }\n  [hidden]{ display:none !important; }\n  @media (prefers-reduced-motion:reduce){ .hero .bar i, .check{ transition:none; } button:active{ transform:none; } }\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-flame\" viewBox=\"0 0 24 24\"><path d=\"M12.6 2.2c.4 2.8-.7 4.6-2 6.2-1.2 1.5-2.6 3-2.6 5.4a2.9 2.9 0 0 0 1.5 2.6c-.3-1.9.5-3.2 1.7-4.4.2 1.8 1.4 2.7 2.4 3.6.9.8 1.6 1.6 1.6 3.1A4.6 4.6 0 0 0 19 14.2c0-4.4-3.2-6.2-3.8-9.5-.3 1.3-.9 2.3-1.7 3 .3-2.4-.1-4.1-.9-5.5zM5.5 13.5c0 4.6 3 8.3 6.8 8.3-3.5-.4-6-3.5-5.9-7.2 0-.5 0-.9.1-1.4-.6.1-1 .1-1 .3z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M5 12.6l4.6 4.6L19.2 7.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-wind\" viewBox=\"0 0 24 24\"><path d=\"M3 9h11a3 3 0 1 0-3-3M3 15h15a3 3 0 1 1-3 3M3 12h8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-stretch\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"4.5\" r=\"2.2\" fill=\"currentColor\"/><path d=\"M5 8.5l7 2 7-2M12 10.5v5l-4 5.5M12 15.5l4 5.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-plus\" viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n</defs></svg>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-flame\"/></svg></div>\n  <div class=\"ht\"><h1>Habit Streaks</h1><p>Keep the flame alive</p></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Habit Streaks\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n\n<div class=\"hero\" id=\"hero\" hidden>\n  <div class=\"main\"><div class=\"k\">Today</div><div class=\"n\" id=\"hDone\">0<small>/0</small></div><div class=\"bar\"><i id=\"hBar\" style=\"width:0\"></i></div></div>\n  <div class=\"best\"><b><svg class=\"i\" style=\"width:.8em;height:.8em\"><use href=\"#i-flame\"/></svg><em id=\"hBest\">0</em></b><span>Top streak</span></div>\n</div>\n\n<div class=\"card\"><div class=\"add\"><input id=\"h\" placeholder=\"New habit (e.g. Read 10 pages)\" autocomplete=\"off\" enterkeyhint=\"done\"><button class=\"go\" id=\"addBtn\" type=\"button\"><svg class=\"i\"><use href=\"#i-plus\"/></svg>Add</button></div></div>\n\n<h2 id=\"heatLbl\" hidden>Last 18 weeks</h2>\n<div class=\"card heat\" id=\"heat\" hidden><div class=\"months\" id=\"hmMonths\"></div><div class=\"wrap\"><div class=\"wd\" id=\"hmWd\"></div><div class=\"cells\" id=\"hmCells\"></div></div>\n  <div class=\"foot\"><span class=\"txt\" id=\"hmTxt\">Tap a day to see what you did.</span><span class=\"legend\">Less <i></i><i class=\"l2\"></i><i class=\"l4\"></i> More</span></div></div>\n\n<h2 id=\"listLbl\" hidden>Your habits</h2>\n<div class=\"list\" id=\"list\"></div>\n\n<h2 id=\"autoLbl\" hidden>From your apps</h2>\n<p class=\"hint2\" id=\"autoHint\" hidden>Counted automatically when you finish a session.</p>\n<div id=\"autoList\"></div>\n\n<script>\nfunction el(i){return document.getElementById(i)}\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction store(){return window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}}}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nvar habits=[], activity=[], selDay=null;\n/* Local days. v5 used the UTC date, so a habit ticked after midnight in summer\n   time (00:00–01:00 BST) was put on the day before. */\nfunction p2(n){return (n<10?'0':'')+n}\nfunction dayOf(d){return d.getFullYear()+'-'+p2(d.getMonth()+1)+'-'+p2(d.getDate())}\nfunction today(){return dayOf(new Date())}\nfunction back(day,n){var d=new Date(+day.slice(0,4),+day.slice(5,7)-1,+day.slice(8,10));d.setDate(d.getDate()-n);return dayOf(d)}\nfunction save(){store().setItem('habits',JSON.stringify(habits));publish()}\nfunction streak(h){var n=0,d=today();if(h.days.indexOf(d)<0)d=back(d,1);while(h.days.indexOf(d)>=0){n++;d=back(d,1)}return n}\nfunction icon(n){return '<svg class=\"i\"><use href=\"#i-'+n+'\"/></svg>'}\nfunction esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}\n\n/* ---- Shared data (docs/SHARED_DATA.md) ----\n   Writes data/habits.json for other apps; reads data/activity.json, where\n   Box Breathing and Stretch log finished sessions, for the heatmap. */\nfunction publish(){var F=window.myllmFiles;if(!F||!F.write)return;\n  var out={schema:'myllm.habits',version:1,source:'habit-streaks',updated:new Date().toISOString(),\n    habits:habits.map(function(h){return {id:h.id,name:h.name,days:h.days.slice()}})};\n  try{Promise.resolve(F.write('data/habits.json',JSON.stringify(out))).catch(function(){})}catch(e){}}\nfunction readActivity(){var F=window.myllmFiles;if(!F||!F.read)return Promise.resolve([]);\n  return Promise.resolve().then(function(){return F.read('data/activity.json')}).then(function(t){\n    var j=null;try{j=t?JSON.parse(t):null}catch(e){}\n    if(!j||j.schema!=='myllm.activity'||j.version!==1||!Array.isArray(j.events))return [];\n    return j.events.filter(function(e){return e&&typeof e.app==='string'&&/^\\d{4}-\\d\\d-\\d\\d$/.test(e.date||'')});\n  }).catch(function(){return []})}\nvar APPS={'box-breathing':{name:'Box Breathing',icon:'wind',h:192},'stretch':{name:'Stretch',icon:'stretch',h:150}};\nfunction appName(id){return (APPS[id]&&APPS[id].name)||id.replace(/-/g,' ').replace(/^./,function(c){return c.toUpperCase()})}\n\n/* What happened on a day: habits ticked, sessions finished. */\nfunction dayInfo(day){\n  var hs=habits.filter(function(h){return h.days.indexOf(day)>=0}).map(function(h){return h.name});\n  var by={};activity.forEach(function(e){if(e.date===day)by[e.app]=(by[e.app]||0)+1});\n  return {habits:hs,apps:by,count:hs.length+Object.keys(by).reduce(function(a,k){return a+by[k]},0)};\n}\n\nfunction renderHeat(){\n  var show=habits.length||activity.length;el('heat').hidden=!show;el('heatLbl').hidden=!show;if(!show)return;\n  var WEEKS=18,t=today(),now=new Date(),dow=(now.getDay()+6)%7,start=back(t,dow+7*(WEEKS-1));\n  var counts=[],max=1;for(var i=0;i<WEEKS*7;i++){var d=back(start,-i);var c=d>t?-1:dayInfo(d).count;counts.push([d,c]);if(c>max)max=c}\n  el('hmCells').innerHTML=counts.map(function(x){\n    var lvl=x[1]<=0?0:Math.min(4,Math.ceil(x[1]/max*4));\n    var lab=new Date(+x[0].slice(0,4),+x[0].slice(5,7)-1,+x[0].slice(8,10)).toLocaleDateString(undefined,{weekday:'short',day:'numeric',month:'short'});\n    return '<button type=\"button\" data-day=\"'+x[0]+'\" class=\"'+(x[1]<0?'future':'l'+lvl)+(x[0]===selDay?' sel':'')+'\" aria-label=\"'+esc(lab+': '+Math.max(0,x[1]))+'\"></button>'}).join('');\n  var wd=[];for(var k=0;k<7;k++)wd.push('<span>'+(k%2===0?esc(new Date(2024,0,1+k).toLocaleDateString(undefined,{weekday:'narrow'})):'')+'</span>');\n  el('hmWd').innerHTML=wd.join('');\n  var cols=[],last='';for(var w=0;w<WEEKS;w++){var first=back(start,-w*7),m=first.slice(5,7);cols.push(m!==last&&w>0?'<span>'+esc(new Date(+first.slice(0,4),+m-1,1).toLocaleDateString(undefined,{month:'short'}))+'</span>':'<span></span>');last=m}\n  el('hmMonths').style.gridTemplateColumns='repeat('+WEEKS+',1fr)';el('hmMonths').innerHTML=cols.join('');\n  paintSel();\n}\nfunction paintSel(){\n  if(!selDay){el('hmTxt').textContent='Tap a day to see what you did.';return}\n  var i=dayInfo(selDay),lab=new Date(+selDay.slice(0,4),+selDay.slice(5,7)-1,+selDay.slice(8,10)).toLocaleDateString(undefined,{weekday:'short',day:'numeric',month:'short'});\n  var parts=i.habits.map(esc).concat(Object.keys(i.apps).map(function(a){return esc(appName(a))+(i.apps[a]>1?' ×'+i.apps[a]:'')}));\n  el('hmTxt').innerHTML='<b>'+esc(lab)+'</b> · '+(parts.length?parts.join(', '):'nothing logged');\n}\nel('hmCells').addEventListener('click',function(e){var b=e.target.closest('button');if(!b||b.classList.contains('future'))return;selDay=b.getAttribute('data-day');haptic('selection');renderHeat()});\n\nfunction renderAuto(){\n  var ids=Object.keys(activity.reduce(function(a,e){a[e.app]=1;return a},{}));\n  el('autoLbl').hidden=!ids.length;el('autoHint').hidden=!ids.length;\n  var t=today(),wk=back(t,6);\n  el('autoList').innerHTML=ids.map(function(id){\n    var ev=activity.filter(function(e){return e.app===id}),days={};ev.forEach(function(e){days[e.date]=1});\n    var week=ev.filter(function(e){return e.date>=wk}).length,s=0,d=days[t]?t:back(t,1);while(days[d]){s++;d=back(d,1)}\n    var lastAt=ev.reduce(function(m,e){return e.date>m?e.date:m},''),info=APPS[id]||{icon:'flame',h:26};\n    var lastLbl=lastAt?(lastAt===t?'today':lastAt===back(t,1)?'yesterday':new Date(+lastAt.slice(0,4),+lastAt.slice(5,7)-1,+lastAt.slice(8,10)).toLocaleDateString(undefined,{day:'numeric',month:'short'})):'—';\n    return '<div class=\"auto\"><div class=\"tile\" style=\"--h:'+info.h+'\">'+icon(info.icon)+'</div><div class=\"nm\"><b>'+esc(appName(id))+'</b><small>'+(s?s+(s===1?' day':' days')+' in a row':'last '+esc(lastLbl))+'</small></div><div class=\"n\"><b>'+week+'</b><small>this week</small></div></div>'}).join('');\n}\n\nfunction render(){var L=el('list');L.innerHTML='';\nel('hero').hidden=!habits.length;el('listLbl').hidden=!habits.length;\nrenderHeat();renderAuto();\nif(!habits.length){L.innerHTML='<div class=\"card empty\"><div class=\"tile\">'+icon('flame')+'</div><b>Start your first streak</b><p>Add a habit, then tick it off each day to grow the streak. Sessions you finish in Box Breathing and Stretch are counted here too.</p></div>';return}\nvar done=0,best=0,t=today();\nhabits.forEach(function(h,i){var doneToday=h.days.indexOf(t)>=0,s=streak(h);if(doneToday)done++;if(s>best)best=s;\nvar d=document.createElement('div');d.className='habit'+(doneToday?' on':'');\nvar b=document.createElement('button');b.className='check';b.type='button';b.innerHTML=icon('check');\nb.setAttribute('aria-label',doneToday?'Done today — tap to undo':'Mark done today');b.setAttribute('aria-pressed',doneToday);\nb.onclick=function(){if(doneToday)h.days=h.days.filter(function(x){return x!==t});else h.days.push(t);haptic(doneToday?'light':'success');save();render()};\nvar nm=document.createElement('div');nm.className='nm';\nvar tt=document.createElement('b');tt.textContent=h.name;nm.appendChild(tt);\nvar st=document.createElement('small');st.innerHTML=icon('flame')+'<span></span>';st.querySelector('span').textContent=s+(s===1?' day':' days')+(doneToday?' · done today':'');nm.appendChild(st);\nvar w7=document.createElement('div');w7.className='week7';w7.setAttribute('aria-hidden','true');\nfor(var k=6;k>=0;k--){var ii=document.createElement('i');if(h.days.indexOf(back(t,k))>=0)ii.className='on';w7.appendChild(ii)}nm.appendChild(w7);\nvar x=document.createElement('button');x.className='del';x.type='button';x.innerHTML=icon('x');x.setAttribute('aria-label','Delete habit');\nx.onclick=function(){habits.splice(i,1);haptic('light');save();render()};\nd.appendChild(b);d.appendChild(nm);d.appendChild(x);L.appendChild(d)});\nel('hDone').innerHTML=done+'<small>/'+habits.length+'</small>';\nel('hBar').style.width=(habits.length?done/habits.length*100:0)+'%';\nel('hBest').textContent=best}\nfunction add(){var t=el('h');var v=t.value.trim();if(!v)return;habits.push({id:'h_'+Date.now(),name:v,days:[]});t.value='';haptic('success');save();render()}\nel('addBtn').onclick=add;\nel('h').addEventListener('keydown',function(e){if(e.key==='Enter')add()});\nfunction boot(){return Promise.all([store().getItem('habits'),readActivity()]).then(function(r){\n  if(r[0])try{habits=JSON.parse(r[0])}catch(e){}\n  if(!Array.isArray(habits))habits=[];\n  var fixed=false;habits.forEach(function(h,i){if(!h.id){h.id='h_legacy_'+(i+1);fixed=true}if(!Array.isArray(h.days))h.days=[]});\n  if(fixed)store().setItem('habits',JSON.stringify(habits));\n  activity=r[1];render();publish()})}\nboot();\n/* Sessions finish in other apps: count them as soon as you come back. */\ndocument.addEventListener('visibilitychange',function(){if(!document.hidden)readActivity().then(function(a){activity=a;render()})});\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes.\n   The spacer keeps the header clear of the status bar / Dynamic Island. It is\n   live CSS — env(safe-area-inset-top) — not a measured number: the inset is\n   still 0 when the page loads and only grows once MyLLM's bar has gone (v1\n   measured once, so the title sat under the island). If the page's own styles\n   already pad the header down by the inset, the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  /* Does any rule that applies to the header or an ancestor already use the top inset? */\n  function pageHandlesInset(head){\n    var chain = [], n, found = false;\n    for (n = head; n && n.nodeType === 1; n = n.parentElement) chain.push(n);\n    function walk(rules){\n      for (var i = 0; i < rules.length && !found; i++){\n        var r = rules[i];\n        if (r.cssRules && !r.selectorText) { walk(r.cssRules); continue; }\n        if (!r.selectorText || !/safe-area-inset-top/.test(r.cssText) || !/(padding|margin|top)\\s*:/.test(r.cssText)) continue;\n        if (/\\.imm-safe/.test(r.selectorText)) continue;\n        for (var k = 0; k < chain.length; k++){\n          try { if (chain[k].matches(r.selectorText)) { found = true; break; } } catch(e){}\n        }\n      }\n    }\n    for (var s = 0; s < document.styleSheets.length && !found; s++){\n      try { walk(document.styleSheets[s].cssRules); } catch(e){}\n    }\n    for (n = head; n && n.nodeType === 1 && !found; n = n.parentElement){\n      if (/safe-area-inset-top/.test(n.getAttribute(\"style\") || \"\")) found = true;\n    }\n    return found;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = (document.body.classList.contains(\"imm\") && !pageHandlesInset(head)) ? \"env(safe-area-inset-top)\" : \"0px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script></body></html>\n", "kind": "html", "iconSymbol": "flame.fill", "iconColor": "orange"}