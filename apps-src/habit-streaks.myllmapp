{"name": "Habit Streaks", "html": "<!doctype html>\n<!--\n  Habit Streaks — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Habit Streaks</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"f4f010511c\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); --h:26; }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:760px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; border:none; background:none; } button:active{ transform:scale(.96); }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 28%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:20px 2px 10px; }\n\n  .hero{ border-radius:20px; padding:16px 18px; color:#fff; margin-bottom:12px; display:flex; align-items:center; gap:16px;\n    background:linear-gradient(145deg, hsl(var(--h) 72% 50%), hsl(calc(var(--h) - 22) 66% 32%)); box-shadow:0 10px 28px hsl(var(--h) 60% 30% / .25); }\n  .hero .k{ font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.8; }\n  .hero .n{ font-size:44px; font-weight:800; line-height:1.05; letter-spacing:-.03em; font-variant-numeric:tabular-nums; }\n  .hero .n small{ font-size:22px; opacity:.7; font-weight:750; }\n  .hero .main{ flex:1; min-width:0; }\n  .hero .bar{ height:6px; border-radius:99px; background:rgba(255,255,255,.25); margin-top:8px; overflow:hidden; }\n  .hero .bar i{ display:block; height:100%; border-radius:99px; background:#fff; transition:width .35s cubic-bezier(.2,.8,.2,1); }\n  .hero .best{ flex-shrink:0; text-align:center; background:rgba(255,255,255,.16); border:1px solid rgba(255,255,255,.22); border-radius:16px; padding:10px 12px; min-width:84px; }\n  .hero .best b{ display:flex; align-items:center; justify-content:center; gap:4px; font-size:24px; font-weight:800; font-variant-numeric:tabular-nums; }\n  .hero .best em{ font-style:normal; }\n  .hero .best span{ display:block; font-size:10.5px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; opacity:.8; margin-top:1px; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  .add{ display:flex; gap:8px; }\n  input{ flex:1; min-width:0; font:inherit; font-size:16px; padding:12px; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; }\n  input:focus{ border-color:var(--acc); }\n  .go{ flex-shrink:0; min-height:46px; border-radius:12px; background:var(--acc); color:#fff; font-weight:700; padding:0 16px; display:flex; align-items:center; gap:6px; }\n\n  .list{ display:grid; gap:8px; }\n  .list{ grid-template-columns:minmax(0,1fr); }\n  @media (min-width:768px){ .list{ grid-template-columns:repeat(2,minmax(0,1fr)); } }\n  .habit{ display:flex; align-items:center; gap:12px; background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:10px 8px 10px 12px; }\n  .habit.on{ border-color:hsl(var(--h) 70% 55% / .7); }\n  .check{ width:44px; height:44px; border-radius:50%; flex-shrink:0; display:flex; align-items:center; justify-content:center;\n    border:2.4px solid var(--line); color:transparent; font-size:18px; transition:background .2s, border-color .2s, color .2s; }\n  .habit.on .check{ background:hsl(var(--h) 72% 50%); border-color:hsl(var(--h) 72% 50%); color:#fff; }\n  .habit .nm{ flex:1; min-width:0; }\n  .habit .nm b{ display:block; font-size:16px; font-weight:650; overflow-wrap:anywhere; }\n  .habit .nm small{ display:flex; align-items:center; gap:4px; font-size:12.5px; color:var(--muted); margin-top:2px; font-variant-numeric:tabular-nums; }\n  .habit.on .nm small{ color:hsl(var(--h) 70% 42%); }\n  @media (prefers-color-scheme:dark){ .habit.on .nm small{ color:hsl(var(--h) 85% 64%); } }\n  .habit .nm small svg{ width:13px; height:13px; }\n  .del{ width:44px; height:44px; flex-shrink:0; color:var(--muted); display:flex; align-items:center; justify-content:center; font-size:14px; }\n\n  .empty{ text-align:center; padding:26px 20px 14px; }\n  .empty .tile{ width:48px; height:48px; border-radius:14px; font-size:21px; margin:0 auto 10px; opacity:.9; }\n  .empty b{ display:block; font-size:16px; font-weight:750; }\n  .empty p{ font-size:13.5px; color:var(--muted); line-height:1.5; max-width:280px; margin:5px auto 0; }\n  [hidden]{ display:none !important; }\n  @media (prefers-reduced-motion:reduce){ .hero .bar i, .check{ transition:none; } button:active{ transform:none; } }\n\n/* myllm-fullscreen-v1 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-flame\" viewBox=\"0 0 24 24\"><path d=\"M12.6 2.2c.4 2.8-.7 4.6-2 6.2-1.2 1.5-2.6 3-2.6 5.4a2.9 2.9 0 0 0 1.5 2.6c-.3-1.9.5-3.2 1.7-4.4.2 1.8 1.4 2.7 2.4 3.6.9.8 1.6 1.6 1.6 3.1A4.6 4.6 0 0 0 19 14.2c0-4.4-3.2-6.2-3.8-9.5-.3 1.3-.9 2.3-1.7 3 .3-2.4-.1-4.1-.9-5.5zM5.5 13.5c0 4.6 3 8.3 6.8 8.3-3.5-.4-6-3.5-5.9-7.2 0-.5 0-.9.1-1.4-.6.1-1 .1-1 .3z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M5 12.6l4.6 4.6L19.2 7.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-plus\" viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n</defs></svg>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-flame\"/></svg></div>\n  <div class=\"ht\"><h1>Habit Streaks</h1><p>Keep the flame alive</p></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Habit Streaks\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n\n<div class=\"hero\" id=\"hero\" hidden>\n  <div class=\"main\"><div class=\"k\">Today</div><div class=\"n\" id=\"hDone\">0<small>/0</small></div><div class=\"bar\"><i id=\"hBar\" style=\"width:0\"></i></div></div>\n  <div class=\"best\"><b><svg class=\"i\" style=\"width:.8em;height:.8em\"><use href=\"#i-flame\"/></svg><em id=\"hBest\">0</em></b><span>Top streak</span></div>\n</div>\n\n<div class=\"card\"><div class=\"add\"><input id=\"h\" placeholder=\"New habit (e.g. Read 10 pages)\" autocomplete=\"off\" enterkeyhint=\"done\"><button class=\"go\" id=\"addBtn\" type=\"button\"><svg class=\"i\"><use href=\"#i-plus\"/></svg>Add</button></div></div>\n\n<h2 id=\"listLbl\" hidden>Your habits</h2>\n<div class=\"list\" id=\"list\"></div>\n\n<script>\nfunction el(i){return document.getElementById(i)}\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction store(){return window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}}}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nvar habits=[];\nfunction today(){return new Date().toISOString().slice(0,10)}\nfunction save(){store().setItem('habits',JSON.stringify(habits))}\nfunction streak(h){var n=0;var d=new Date();if(h.days.indexOf(today())<0)d.setDate(d.getDate()-1);\nwhile(h.days.indexOf(d.toISOString().slice(0,10))>=0){n++;d.setDate(d.getDate()-1)}return n}\nfunction icon(n){return '<svg class=\"i\"><use href=\"#i-'+n+'\"/></svg>'}\nfunction render(){var L=el('list');L.innerHTML='';\nel('hero').hidden=!habits.length;el('listLbl').hidden=!habits.length;\nif(!habits.length){L.innerHTML='<div class=\"card empty\"><div class=\"tile\">'+icon('flame')+'</div><b>Start your first streak</b><p>Add a habit, then tick it off each day to grow the streak.</p></div>';return}\nvar done=0,best=0;\nhabits.forEach(function(h,i){var doneToday=h.days.indexOf(today())>=0,s=streak(h);if(doneToday)done++;if(s>best)best=s;\nvar d=document.createElement('div');d.className='habit'+(doneToday?' on':'');\nvar b=document.createElement('button');b.className='check';b.type='button';b.innerHTML=icon('check');\nb.setAttribute('aria-label',doneToday?'Done today — tap to undo':'Mark done today');b.setAttribute('aria-pressed',doneToday);\nb.onclick=function(){if(doneToday)h.days=h.days.filter(function(x){return x!==today()});else h.days.push(today());haptic(doneToday?'light':'success');save();render()};\nvar nm=document.createElement('div');nm.className='nm';\nvar t=document.createElement('b');t.textContent=h.name;nm.appendChild(t);\nvar st=document.createElement('small');st.innerHTML=icon('flame')+'<span></span>';st.querySelector('span').textContent=s+(s===1?' day':' days')+(doneToday?' · done today':'');nm.appendChild(st);\nvar x=document.createElement('button');x.className='del';x.type='button';x.innerHTML=icon('x');x.setAttribute('aria-label','Delete habit');\nx.onclick=function(){habits.splice(i,1);haptic('light');save();render()};\nd.appendChild(b);d.appendChild(nm);d.appendChild(x);L.appendChild(d)});\nel('hDone').innerHTML=done+'<small>/'+habits.length+'</small>';\nel('hBar').style.width=(habits.length?done/habits.length*100:0)+'%';\nel('hBest').textContent=best}\nfunction add(){var t=el('h');var v=t.value.trim();if(!v)return;habits.push({name:v,days:[]});t.value='';haptic('success');save();render()}\nel('addBtn').onclick=add;\nel('h').addEventListener('keydown',function(e){if(e.key==='Enter')add()});\nstore().getItem('habits').then(function(v){if(v)try{habits=JSON.parse(v)}catch(e){}render()});\n\n/* myllm-fullscreen-v1 — full screen where MyLLM can also close the app for us (myllmClose,\n   5.6.2+): full screen hides MyLLM's Done, and a page with no way out is\n   worse than a repeated title, so elsewhere nothing changes. The spacer keeps\n   the header clear of the status bar only if the page doesn't already. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  function inset(){\n    var p = document.createElement(\"div\");\n    p.style.cssText = \"position:fixed;top:0;left:0;width:1px;visibility:hidden;height:env(safe-area-inset-top)\";\n    document.body.appendChild(p); var h = p.offsetHeight; p.parentNode.removeChild(p); return h;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = \"0px\";\n    if (!document.body.classList.contains(\"imm\")) return;\n    var need = inset() + 6 - (head.getBoundingClientRect().top + window.scrollY);\n    sp.style.height = Math.max(0, Math.round(need)) + \"px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  window.addEventListener(\"resize\", fit);\n  sync();\n})();\n</script></body></html>\n", "kind": "html", "iconSymbol": "flame.fill", "iconColor": "orange"}