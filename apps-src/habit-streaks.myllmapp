{"name": "Habit Streaks", "html": "<!doctype html>\n<!--\n  Habit Streaks — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>:root{--build-id:\"f4f010511c\";color-scheme:light dark}\nbody{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:20px;background:#f2f2f7;color:#111}\n@media(prefers-color-scheme:dark){body{background:#000;color:#eee}.card{background:#1c1c1e}input{background:#2c2c2e;color:#eee;border-color:#3a3a3c}.done-btn.off{background:#3a3a3c;color:#aaa}}\nh1{font-size:22px;margin:0 0 14px}\n.row{display:flex;gap:8px;margin-bottom:14px}\ninput{flex:1;padding:12px;border:1px solid #d1d1d6;border-radius:10px;font-size:16px;background:#fff}\nbutton{border:0;background:#ff9f0a;color:#fff;border-radius:10px;padding:0 16px;font-size:15px;font-weight:600}\n.card{background:#fff;border-radius:12px;padding:12px 14px;margin-bottom:8px;display:flex;align-items:center;gap:10px}\n.card b{flex:1;font-size:16px;font-weight:600}\n.streak{font-size:14px;opacity:.8}\n.done-btn{padding:8px 12px;border-radius:8px;font-size:14px}\n.done-btn.off{background:#d1d1d6;color:#555}\n.del{background:none;color:#ff453a;font-size:17px;padding:6px}\n.empty{text-align:center;opacity:.5;margin-top:30px}\n@media(min-width:768px){body{max-width:760px;margin-left:auto;margin-right:auto}}\n</style></head><body>\n<h1>🔥 Habit Streaks</h1>\n<div class=\"row\"><input id=\"h\" placeholder=\"New habit (e.g. Read 10 pages)\"><button onclick=\"add()\">Add</button></div>\n<div id=\"list\"></div>\n<script>\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar habits=[];\nfunction today(){return new Date().toISOString().slice(0,10)}\nfunction save(){store.setItem('habits',JSON.stringify(habits))}\nfunction streak(h){var n=0;var d=new Date();if(h.days.indexOf(today())<0)d.setDate(d.getDate()-1);\nwhile(h.days.indexOf(d.toISOString().slice(0,10))>=0){n++;d.setDate(d.getDate()-1)}return n}\nfunction render(){var L=document.getElementById('list');L.innerHTML='';\nif(!habits.length){L.innerHTML='<p class=\"empty\">Add a habit, then tap Done each day to grow the streak.</p>';return}\nhabits.forEach(function(h,i){var doneToday=h.days.indexOf(today())>=0;\nvar d=document.createElement('div');d.className='card';\nvar nm=document.createElement('b');nm.textContent=h.name;\nvar st=document.createElement('span');st.className='streak';st.textContent='🔥 '+streak(h)+'d';\nvar b=document.createElement('button');b.className='done-btn'+(doneToday?'':' off');b.textContent=doneToday?'Done ✓':'Done?';\nb.onclick=function(){if(doneToday)h.days=h.days.filter(function(x){return x!==today()});else h.days.push(today());save();render()};\nvar x=document.createElement('button');x.className='del';x.textContent='✕';\nx.onclick=function(){habits.splice(i,1);save();render()};\nd.appendChild(nm);d.appendChild(st);d.appendChild(b);d.appendChild(x);L.appendChild(d)})}\nfunction add(){var t=document.getElementById('h');var v=t.value.trim();if(!v)return;habits.push({name:v,days:[]});t.value='';save();render()}\ndocument.getElementById('h').addEventListener('keydown',function(e){if(e.key==='Enter')add()});\nstore.getItem('habits').then(function(v){if(v)try{habits=JSON.parse(v)}catch(e){}render()});\n</script></body></html>", "kind": "html", "iconSymbol": "flame.fill", "iconColor": "orange"}