{"name": "Speedometer", "kind": "html", "iconSymbol": "speedometer", "iconColor": "orange", "html": "<!doctype html>\n<!--\n  Speedometer — MyLLMos App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Speedometer</title>\n<style>\n:root{--build-id:\"74b2300b0a\";color-scheme:dark;--bg:#0b0d12;--panel:#141824;--ink:#edf0f7;--mut:#7c86a0;--line:#232a3c;\n  --ac:#ffb04c;--ok:#5fd08a;--warn:#ffd23f;--bad:#ff6b60}\n*{box-sizing:border-box;margin:0}\nhtml,body{height:100%}\nbody{font-family:-apple-system,system-ui,sans-serif;color:var(--ink);\n  position:fixed;inset:0;width:100%;height:100dvh;overflow:hidden;display:flex;flex-direction:column;\n  -webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none;\n  background:radial-gradient(130% 100% at 50% 0%,#131a2c,var(--bg))}\n.top{padding:calc(12px + env(safe-area-inset-top)) 18px 0;display:flex;align-items:center;gap:8px}\nh1{font-size:17px;font-weight:800;letter-spacing:.04em}\n.gpsdot{width:9px;height:9px;border-radius:50%;background:#555;margin-left:auto}\n.gpsdot.ok{background:var(--ok);box-shadow:0 0 8px rgba(95,208,138,.7)}\n.gpsdot.mid{background:var(--warn)}\n.gpsdot.bad{background:var(--bad)}\n.gpstxt{font-size:11px;color:var(--mut);font-weight:700}\n#gaugeWrap{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:0;padding:0 12px}\ncanvas{max-width:100%}\n.readout{text-align:center;margin-top:-14dvh}\n.speed{font-size:min(19dvw,86px);font-weight:900;font-variant-numeric:tabular-nums;line-height:1;\n  text-shadow:0 0 30px rgba(255,176,76,.25)}\n.vehicle{font-size:14px;color:var(--mut);font-weight:700;min-height:20px;margin-top:6px}\n.vehicle b{font-size:17px}\n.units{display:flex;gap:8px;justify-content:center;margin:10px 0 4px}\n.uchip{border:1.5px solid var(--line);background:none;color:var(--mut);border-radius:999px;\n  padding:7px 16px;font-size:13px;font-weight:800}\n.uchip.on{color:var(--ac);border-color:var(--ac)}\n.trip{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;padding:8px 14px}\n.tcell{background:var(--panel);border:1px solid var(--line);border-radius:13px;padding:9px 6px;text-align:center}\n.tcell .v{font-size:16px;font-weight:900;font-variant-numeric:tabular-nums}\n.tcell .l{font-size:9px;letter-spacing:.12em;color:var(--mut);font-weight:800;margin-top:2px}\n.bar{display:flex;gap:9px;padding:8px 14px calc(16px + env(safe-area-inset-bottom))}\n.btn{flex:1;border:1.5px solid var(--line);background:var(--panel);color:var(--ink);border-radius:13px;\n  padding:13px;font-size:14px;font-weight:800}\n.btn.go{background:linear-gradient(135deg,var(--ac),#e08a2f);border:0;color:#1a1206}\n.btn.stop{background:linear-gradient(135deg,#ff7a6b,#d05548);border:0;color:#2a0d0a}\n.hint{text-align:center;font-size:11.5px;color:var(--mut);padding:0 22px 6px;line-height:1.5;min-height:16px}\n.best{text-align:center;font-size:11px;color:var(--warn);font-weight:700;padding-bottom:2px}\n</style></head><body>\n\n<div class=\"top\"><h1>⛭ SPEEDOMETER</h1><div class=\"gpstxt\" id=\"gpsTxt\">GPS off</div><div class=\"gpsdot\" id=\"gpsDot\"></div></div>\n<div id=\"gaugeWrap\">\n  <canvas id=\"gauge\"></canvas>\n  <div class=\"readout\">\n    <div class=\"speed\" id=\"speedV\">0</div>\n    <div class=\"vehicle\" id=\"vehicle\"></div>\n  </div>\n</div>\n<div class=\"units\" id=\"units\"></div>\n<div class=\"best\" id=\"best\"></div>\n<div class=\"trip\">\n  <div class=\"tcell\"><div class=\"v\" id=\"tDist\">0.0</div><div class=\"l\" id=\"tDistU\">KM</div></div>\n  <div class=\"tcell\"><div class=\"v\" id=\"tAvg\">0</div><div class=\"l\">AVG</div></div>\n  <div class=\"tcell\"><div class=\"v\" id=\"tMax\">0</div><div class=\"l\">MAX</div></div>\n  <div class=\"tcell\"><div class=\"v\" id=\"tTime\">0:00</div><div class=\"l\">MOVING</div></div>\n</div>\n<div class=\"hint\" id=\"hint\"></div>\n<div class=\"bar\">\n  <button class=\"btn\" id=\"resetBtn\">Reset trip</button>\n  <button class=\"btn go\" id=\"goBtn\">Start</button>\n</div>\n\n<script>\n\"use strict\";\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nfunction el(i){return document.getElementById(i)}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k||'light')}catch(e){}}\n\n/* ================= speed engine (pure — harness-tested) ================= */\nvar R=6371000;\nfunction haversine(a,b){\n  var dLat=(b.lat-a.lat)*Math.PI/180,dLon=(b.lon-a.lon)*Math.PI/180;\n  var la=a.lat*Math.PI/180,lb=b.lat*Math.PI/180;\n  var h=Math.sin(dLat/2)*Math.sin(dLat/2)+Math.cos(la)*Math.cos(lb)*Math.sin(dLon/2)*Math.sin(dLon/2);\n  return 2*R*Math.asin(Math.min(1,Math.sqrt(h)));\n}\nvar MAX_MS=340;           // ~1220 km/h sanity ceiling (fast jet); beyond = GPS glitch\nvar ACC_LIMIT=35;         // metres — ignore sloppy fixes\nfunction makeEngine(){\n  return {fixes:[],ema:null,dist:0,movingMs:0,maxMs:0,peakMs:0};\n}\n/* the gauge follows a DECAYING peak, not the trip max: it grows instantly when\n   you speed up, then eases back ~12%/s so a plane's 0-1000 scale returns to\n   something readable within half a minute of landing */\nfunction decayPeak(en,dtMs){\n  var v=en.ema||0;\n  if(v>en.peakMs)en.peakMs=v;\n  else if(dtMs>0)en.peakMs=Math.max(v,en.peakMs*Math.pow(0.88,dtMs/1000));\n}\n/* feed one fix {lat,lon,acc,t(ms),vNative(m/s or -1)}; returns speed m/s or null */\nfunction feed(en,fix){\n  var prev=en.fixes.length?en.fixes[en.fixes.length-1]:null;\n  en.fixes.push(fix);\n  if(en.fixes.length>10)en.fixes.shift();\n  var v=null;\n  if(fix.vNative!=null&&fix.vNative>=0){\n    v=Math.min(MAX_MS,fix.vNative);\n  } else if(fix.acc<=ACC_LIMIT){\n    /* windowed derivation: oldest good fix 4–9s back smooths poll-latency jitter */\n    var base=null;\n    for(var i=0;i<en.fixes.length-1;i++){\n      var f=en.fixes[i];\n      if(f.acc<=ACC_LIMIT&&fix.t-f.t>=4000&&fix.t-f.t<=9500){base=f;break;}\n    }\n    if(base){\n      var d=haversine({lat:base.lat,lon:base.lon},{lat:fix.lat,lon:fix.lon});\n      var raw=d/((fix.t-base.t)/1000);\n      if(raw<=MAX_MS)v=raw;\n    }\n  }\n  if(v!=null){\n    if(v<0.6)v=0;                      // GPS drift while standing reads as zero\n    en.ema=en.ema==null?v:en.ema+(v-en.ema)*0.45;\n    if(en.ema<0.3)en.ema=0;\n    if(en.ema>en.maxMs)en.maxMs=en.ema;\n  }\n  decayPeak(en,prev?(fix.t-prev.t):0);\n  /* trip accumulation between consecutive good fixes */\n  if(prev&&prev.acc<=ACC_LIMIT&&fix.acc<=ACC_LIMIT){\n    var dt=(fix.t-prev.t)/1000;\n    if(dt>0&&dt<15){\n      var seg=haversine({lat:prev.lat,lon:prev.lon},{lat:fix.lat,lon:fix.lon});\n      var segV=seg/dt;\n      if(segV>=0.5&&segV<=MAX_MS){en.dist+=seg;en.movingMs+=dt*1000;}\n    }\n  }\n  return en.ema;\n}\n/* units: factor from m/s + label */\nvar UNITS=[['kmh','km/h',3.6],['mph','mph',2.23694],['kn','kn',1.94384]];\nfunction conv(ms,u){return ms*UNITS.find(function(x){return x[0]===u})[2]}\n/* what's likely carrying you, from km/h */\nfunction vehicleFor(kmh){\n  if(kmh<1)return null;\n  if(kmh<7)return ['🚶','Walking pace'];\n  if(kmh<50)return ['🐎','Gallop territory'];\n  if(kmh<160)return ['🚗','Road speed'];\n  if(kmh<360)return ['🚄','Rail speed'];\n  return ['✈️','Air speed'];\n}\n/* gauge range auto-grows in display units */\nvar RANGES=[30,60,120,200,300,500,750,1000,1400];\nfunction rangeFor(maxDisp){\n  for(var i=0;i<RANGES.length;i++)if(RANGES[i]>=Math.max(30,maxDisp*1.12))return RANGES[i];\n  return RANGES[RANGES.length-1];\n}\n\n/* ================= state + UI ================= */\nvar en=makeEngine(),unit='kmh',running=false,pollT=null,inFlight=false,best=0,lastFixAt=0,lastAcc=null;\nfunction fmtTime(ms){var s=Math.floor(ms/1000),m=Math.floor(s/60);return m+':'+('0'+(s%60)).slice(-2)}\nfunction render(){\n  var ms=en.ema||0,disp=conv(ms,unit);\n  el('speedV').textContent=disp<10?disp.toFixed(1):Math.round(disp);\n  var veh=vehicleFor(ms*3.6);\n  el('vehicle').innerHTML=veh?('<b>'+veh[0]+'</b> '+veh[1]):(running?'Waiting for movement…':'');\n  el('tDist').textContent=unit==='mph'?(en.dist/1609.34).toFixed(1):unit==='kn'?(en.dist/1852).toFixed(1):(en.dist/1000).toFixed(1);\n  el('tDistU').textContent=unit==='mph'?'MI':unit==='kn'?'NM':'KM';\n  var avg=en.movingMs>2000?conv(en.dist/(en.movingMs/1000),unit):0;\n  el('tAvg').textContent=Math.round(avg);\n  el('tMax').textContent=Math.round(conv(en.maxMs,unit));\n  el('tTime').textContent=fmtTime(en.movingMs);\n  el('best').textContent=best>0?('Best ever  '+Math.round(conv(best,unit))+' '+UNITS.find(function(x){return x[0]===unit})[1]):'';\n  drawGauge(disp);\n}\n/* ---- gauge ---- */\nvar cv=el('gauge'),ctx=cv.getContext('2d');\nfunction drawGauge(disp){\n  var W=Math.min(innerWidth-24,430),H=W*0.62,D=Math.min(window.devicePixelRatio||1,2);\n  cv.width=W*D;cv.height=H*D;cv.style.width=W+'px';cv.style.height=H+'px';\n  var cx=W/2*D,cy=H*0.92*D,r=W*0.44*D;\n  var range=rangeFor(Math.max(disp,conv(en.peakMs,unit)));\n  var a0=Math.PI*1.05,a1=Math.PI*1.95;\n  function ang(v){return a0+(a1-a0)*Math.min(1,v/range)}\n  ctx.clearRect(0,0,cv.width,cv.height);\n  /* track */\n  ctx.lineWidth=10*D;ctx.lineCap='round';\n  ctx.strokeStyle='rgba(45,55,80,.8)';\n  ctx.beginPath();ctx.arc(cx,cy,r,a0,a1);ctx.stroke();\n  /* fill */\n  if(disp>0.4){\n    var grad=ctx.createLinearGradient(0,0,cv.width,0);\n    grad.addColorStop(0,'#ffb04c');grad.addColorStop(1,'#ff7a4c');\n    ctx.strokeStyle=grad;\n    ctx.beginPath();ctx.arc(cx,cy,r,a0,ang(disp));ctx.stroke();\n  }\n  /* ticks + labels */\n  ctx.fillStyle='rgba(160,172,200,.8)';\n  ctx.font=(11*D)+'px -apple-system';ctx.textAlign='center';ctx.textBaseline='middle';\n  for(var i=0;i<=6;i++){\n    var v=range*i/6,a=ang(v);\n    var x1=cx+Math.cos(a)*(r-16*D),y1=cy+Math.sin(a)*(r-16*D);\n    var x2=cx+Math.cos(a)*(r-7*D),y2=cy+Math.sin(a)*(r-7*D);\n    ctx.strokeStyle='rgba(160,172,200,.5)';ctx.lineWidth=2*D;\n    ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2,y2);ctx.stroke();\n    ctx.fillText(String(Math.round(v)),cx+Math.cos(a)*(r-30*D),cy+Math.sin(a)*(r-30*D));\n  }\n}\n/* ---- units ---- */\nfunction buildUnits(){\n  var w=el('units');w.innerHTML='';\n  UNITS.forEach(function(u){\n    var b=document.createElement('button');b.className='uchip'+(u[0]===unit?' on':'');b.textContent=u[1];\n    b.onclick=function(){unit=u[0];store.setItem('speedo.unit',unit);buildUnits();render();haptic('selection')};\n    w.appendChild(b);\n  });\n}\n/* ---- GPS polling ---- */\nfunction setGps(state,txt){\n  el('gpsDot').className='gpsdot'+(state?' '+state:'');\n  el('gpsTxt').textContent=txt;\n}\nfunction poll(){\n  if(inFlight||!window.myllmLocation)return;\n  inFlight=true;\n  myllmLocation.current({address:false}).then(function(p){\n    inFlight=false;\n    if(!p)return;\n    var now=Date.now();\n    var fix={lat:p.latitude,lon:p.longitude,acc:p.accuracy==null?999:p.accuracy,\n             t:(typeof p.timestamp==='number'&&p.timestamp>0)?p.timestamp:now,\n             vNative:(typeof p.speed==='number')?p.speed:null};\n    lastFixAt=now;lastAcc=fix.acc;\n    feed(en,fix);\n    if(en.maxMs>best){best=en.maxMs;store.setItem('speedo.best',String(best));}\n    setGps(fix.acc<=15?'ok':(fix.acc<=ACC_LIMIT?'mid':'bad'),'±'+Math.round(fix.acc)+'m');\n    if(fix.acc>ACC_LIMIT)el('hint').textContent='Weak GPS — get clearer sky for a good reading';\n    else if(fix.vNative==null&&en.fixes.length<3)el('hint').textContent='Getting a bearing — a few seconds…';\n    else el('hint').textContent='';\n    render();\n  }).catch(function(e){\n    inFlight=false;\n    setGps('bad','no fix');\n    el('hint').textContent=/turned off/i.test(e&&e.message||'')\n      ?'Turn on Settings → MyLLMos Apps → “Allow apps to use your location”.'\n      :'No GPS fix — open sky helps. ('+((e&&e.message)||'error')+')';\n  });\n}\nfunction start(){\n  if(!window.myllmLocation){\n    el('hint').textContent='This needs the MyLLM app with location for apps enabled.';\n    haptic('warning');return;\n  }\n  running=true;el('goBtn').textContent='Pause';el('goBtn').className='btn stop';\n  poll();pollT=setInterval(poll,2000);haptic('success');\n}\nfunction stop(){\n  running=false;clearInterval(pollT);pollT=null;\n  el('goBtn').textContent='Start';el('goBtn').className='btn go';\n  setGps(null,'paused');haptic('light');\n}\nel('goBtn').onclick=function(){running?stop():start()};\nel('resetBtn').onclick=function(){\n  var keep=en.fixes,e2=makeEngine();e2.fixes=keep.slice(-2);e2.ema=en.ema;e2.peakMs=en.ema||0;en=e2;\n  render();haptic('warning');\n};\nwindow.addEventListener('resize',render);\n\nstore.getItem('speedo.unit').then(function(v){\n  if(v&&UNITS.some(function(u){return u[0]===v}))unit=v;\n  return store.getItem('speedo.best');\n}).then(function(v){\n  best=parseFloat(v)||0;\n  buildUnits();render();\n  el('hint').textContent=window.myllmLocation?'Tap Start, then get moving — train, plane, car or horse.':'Open inside MyLLM to use GPS.';\n});\n</script>\n</body></html>\n"}