{"name": "Speedometer", "kind": "html", "iconSymbol": "speedometer", "iconColor": "orange", "html": "<!doctype html>\n<!--\n  Speedometer — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Speedometer</title>\n<style>\n:root{--build-id:\"74b2300b0a\";color-scheme:light dark;--ok:#5fd08a;--warn:#ffd23f;--bad:#ff6b60;--acc:#ffb04c}\n@property --h{ syntax:'<number>'; inherits:true; initial-value:36; }\n*{box-sizing:border-box;margin:0;-webkit-tap-highlight-color:transparent}\nhtml,body{height:100%}\nbody{font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);color:#fff;background:#0b0b10;\n  position:fixed;inset:0;width:100%;height:100dvh;overflow:hidden;user-select:none;-webkit-user-select:none}\n\n/* The stage: an amber instrument that shifts hue with speed — warm at rest,\n   through gold at road speed, to a cool blue at the top of the range. Two\n   layers, dark and light, so the change between them can fade. */\n.stage{position:absolute;inset:0;--h:36;transition:--h 1.2s ease;color:#fff;display:flex;flex-direction:column}\n.bg{position:absolute;inset:0;transition:opacity .6s ease}\n.bg.d{background:radial-gradient(120% 90% at 20% 10%,hsl(var(--h) 70% 30%),transparent 60%),\n  radial-gradient(120% 90% at 85% 95%,hsl(calc(var(--h) + 40) 62% 24%),transparent 62%),#0b0b10}\n.bg.l{opacity:0;background:radial-gradient(120% 90% at 20% 0%,hsl(var(--h) 85% 84%),transparent 60%),\n  radial-gradient(120% 90% at 85% 100%,hsl(calc(var(--h) + 40) 78% 87%),transparent 62%),#f4f4f8}\n.lite{color:#15151a}.lite .bg.l{opacity:1}.lite .bg.d{opacity:0}\n.stage>*:not(.bg){position:relative}\n.glass{border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.12);color:inherit;\n  -webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px)}\n.lite .glass{border-color:rgba(0,0,0,.09);background:rgba(255,255,255,.62)}\nsvg.i{width:1.25em;height:1.25em;fill:currentColor;flex-shrink:0}\nbutton{font:inherit}button:active{transform:scale(.96)}\n\n.top{display:flex;align-items:center;gap:10px;flex-shrink:0;\n  padding:calc(12px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) 0 calc(16px + env(safe-area-inset-left))}\n.top .lbl{font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;opacity:.62;flex:1}\n.gps{height:36px;border-radius:99px;padding:0 13px 0 11px;display:flex;align-items:center;gap:8px;font-size:11.5px;font-weight:800;letter-spacing:.06em}\n.gpsdot{width:9px;height:9px;border-radius:50%;background:rgba(128,128,140,.6);flex-shrink:0}\n.gpsdot.ok{background:var(--ok);box-shadow:0 0 8px rgba(95,208,138,.7)}\n.gpsdot.mid{background:var(--warn)}\n.gpsdot.bad{background:var(--bad)}\n/* the app is never silently doing nothing: while it's hunting for a fix the dot\n   breathes, so \"connecting\" never looks like \"broken\" */\n.gpsdot.search{background:var(--warn);animation:breathe 1.2s ease-in-out infinite}\n@keyframes breathe{0%,100%{opacity:.22;transform:scale(.75)}50%{opacity:1;transform:scale(1.3)}}\n.rnd{width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0}\n\n#gaugeWrap{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:0;padding:0 12px;position:relative}\n#gaugeWrap canvas{max-height:calc(100% - 8px)}\ncanvas{max-width:100%;display:block}\n.readout{position:absolute;left:0;right:0;top:50%;transform:translateY(-44%);text-align:center;pointer-events:none}\n.speed{font-size:var(--sp,86px);min-height:1em;font-weight:900;font-variant-numeric:tabular-nums;line-height:1;letter-spacing:-.03em;\n  text-shadow:0 0 30px hsl(var(--h) 90% 60% / .35);transition:opacity .35s}\n.lite .speed{text-shadow:none}\n/* a reading older than a few seconds is dimmed rather than shown as if live */\n.readout.stale .speed{opacity:.35;text-shadow:none}\n.unitlbl{font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;opacity:.6;margin-top:4px}\n.vehicle{font-size:14px;opacity:.75;font-weight:700;min-height:20px;margin-top:8px;display:flex;align-items:center;justify-content:center;gap:7px}\n.vehicle svg{font-size:18px;opacity:.9}\n\n.lower{flex-shrink:0;padding:6px calc(14px + env(safe-area-inset-right)) calc(14px + env(safe-area-inset-bottom)) calc(14px + env(safe-area-inset-left))}\n.lowerin{max-width:560px;margin:0 auto}\n.units{display:flex;gap:7px;justify-content:center;margin:0 0 10px}\n.uchip{height:36px;border-radius:99px;padding:0 15px;font-size:13px;font-weight:700}\n.uchip.on{background:#fff;border-color:#fff;color:#0b0b10}\n.lite .uchip.on{background:#15151a;border-color:#15151a;color:#fff}\n.best{text-align:center;font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;opacity:.7;min-height:14px;margin-bottom:8px;font-variant-numeric:tabular-nums}\n.trip{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}\n.tcell{border-radius:16px;padding:10px 6px;text-align:center}\n.tcell .v{font-size:17px;font-weight:800;font-variant-numeric:tabular-nums}\n.tcell .l{font-size:9.5px;letter-spacing:.12em;opacity:.6;font-weight:800;margin-top:2px}\n.hint{text-align:center;font-size:12px;opacity:.65;padding:8px 10px 2px;line-height:1.45;min-height:22px}\n.bar{display:flex;gap:9px;margin-top:8px}\n.btn{flex:1;height:52px;border-radius:99px;font-size:15.5px;font-weight:750;display:flex;align-items:center;justify-content:center;gap:8px}\n.btn.go{background:#fff;color:#0b0b10;border:0;box-shadow:0 10px 30px rgba(0,0,0,.3)}\n.lite .btn.go{background:#15151a;color:#fff;box-shadow:0 10px 26px rgba(20,20,40,.22)}\n.btn.stop{background:rgba(255,107,96,.85);border-color:transparent;color:#fff}\n.lite .btn.stop{background:#d8452f;color:#fff}\n\n/* Dock: true black, the number and nothing else, drifting a little every\n   minute so nothing burns in. For a phone on a dash mount. */\n.dock{display:none;position:fixed;inset:0;z-index:60;background:#000;color:#fff;overflow:hidden}\n.dock.on{display:block}\n.dock .drift{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;padding:0 24px;text-align:center;transition:transform 2s ease}\n.dock .dspeed{font-size:min(44vw,44vh,300px);font-weight:200;letter-spacing:-.02em;line-height:1;color:#c9c9cf;font-variant-numeric:tabular-nums}\n.dock .dspeed.stale{color:#55555c}\n.dock .dunit{font-size:14px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#5d5d66}\n.dock .dgps{font-size:12px;font-weight:700;letter-spacing:.08em;color:#4a4a52;margin-top:10px;display:flex;align-items:center;gap:8px}\n.dock .dgps .gpsdot{opacity:.8}\n.dock .ctl{position:absolute;left:0;right:0;bottom:calc(30px + env(safe-area-inset-bottom));display:flex;justify-content:center;gap:12px;opacity:0;pointer-events:none;transition:opacity .3s}\n.dock .ctl.on{opacity:1;pointer-events:auto}\n.dock .ctl button{border:1px solid #2c2c33;background:#121216;color:#eee;border-radius:99px;padding:12px 22px;font-size:15px;font-weight:700;display:inline-flex;align-items:center;gap:8px}\n.dock .dhint{position:absolute;bottom:calc(34px + env(safe-area-inset-bottom));left:0;right:0;text-align:center;font-size:12px;color:#4a4a52;transition:opacity .6s}\n\n@media (max-height:520px){                      /* on its side on a dash: gauge left, trip right */\n  .stage{display:grid;grid-template-columns:minmax(0,1fr) min(46%,360px);grid-template-rows:auto minmax(0,1fr)}\n  .top{grid-column:1 / 3}\n  #gaugeWrap{grid-column:1;grid-row:2;padding-bottom:8px}\n  .lower{grid-column:2;grid-row:2;display:flex;flex-direction:column;justify-content:center;padding-top:0}\n  .trip{grid-template-columns:repeat(2,1fr)} .readout{transform:translateY(-44%)}\n  .btn{font-size:14px;padding:0 6px;white-space:nowrap}\n}\n@media (prefers-reduced-motion:reduce){.gpsdot.search{animation:none;opacity:1}.stage,.bg{transition:none}.dock .drift{transition:none}}\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-play\" viewBox=\"0 0 24 24\"><path d=\"M8 5.5v13a1 1 0 0 0 1.52.85l10.4-6.5a1 1 0 0 0 0-1.7L9.52 4.65A1 1 0 0 0 8 5.5z\"/></symbol>\n  <symbol id=\"i-pause\" viewBox=\"0 0 24 24\"><rect x=\"6\" y=\"5\" width=\"4.2\" height=\"14\" rx=\"1.4\"/><rect x=\"13.8\" y=\"5\" width=\"4.2\" height=\"14\" rx=\"1.4\"/></symbol>\n  <symbol id=\"i-reset\" viewBox=\"0 0 24 24\"><path d=\"M12 5V2.6a.6.6 0 0 0-1-.45L7.2 5.55a.6.6 0 0 0 0 .9L11 9.85a.6.6 0 0 0 1-.45V7a5.5 5.5 0 1 1-5.5 5.5 1 1 0 0 0-2 0A7.5 7.5 0 1 0 12 5z\"/></symbol>\n  <symbol id=\"i-moon\" viewBox=\"0 0 24 24\"><path d=\"M12.3 2.4a1 1 0 0 0-1.1 1.3A7.5 7.5 0 0 1 3.7 13a1 1 0 0 0-1.3 1.1A9.5 9.5 0 1 0 12.3 2.4zm1.4 2.4a7.5 7.5 0 1 1-9.3 9.3 9.5 9.5 0 0 0 9.3-9.3z\"/></symbol>\n  <symbol id=\"i-close\" viewBox=\"0 0 24 24\"><path d=\"M6.4 5a1 1 0 0 0-1.4 1.4L10.6 12 5 17.6A1 1 0 0 0 6.4 19l5.6-5.6 5.6 5.6a1 1 0 0 0 1.4-1.4L13.4 12 19 6.4A1 1 0 0 0 17.6 5L12 10.6z\"/></symbol>\n  <symbol id=\"i-walk\" viewBox=\"0 0 24 24\"><path d=\"M13.5 2.5a1.8 1.8 0 1 0 0 3.6 1.8 1.8 0 0 0 0-3.6zM11.6 7c-.6 0-1.1.3-1.5.7L7.6 10.4a1 1 0 0 0 1.4 1.4l2.2-2.2.9 2.8-2.6 3.4a1 1 0 0 0-.1 1l1.8 4.3a1 1 0 0 0 1.8-.8l-1.6-3.7 1.9-2.4 1.3 2.2 2.9 1.7a1 1 0 0 0 1-1.7l-2.5-1.5-1.7-4.4 1.5.9 2.2.6a1 1 0 0 0 .5-1.9l-2-.6-2.8-1.9c-.3-.2-.7-.3-1-.3z\"/></symbol>\n  <symbol id=\"i-horse\" viewBox=\"0 0 24 24\"><path d=\"M15.5 3l-1.2 2.4-3.1.6L8 9.2 6.4 8.6 4 10.5l2 1.2 1.8-.6.6 2.6L6.6 20h2.2l1.4-5 2.6-1.6.4 2.6-.8 4h2.2l.9-4.6-.6-3.2 3.1-1.4 1.6 3.6 1.4-.8-1.4-4.8L21 7.4l-1.6-1.2-1.4.8-1.3-2.4z\"/></symbol>\n  <symbol id=\"i-car\" viewBox=\"0 0 24 24\"><path d=\"M6.5 5a2 2 0 0 0-1.9 1.4L3.4 10.2A2 2 0 0 0 2 12.1V17a1 1 0 0 0 1 1h1a2 2 0 0 0 4 0h8a2 2 0 0 0 4 0h1a1 1 0 0 0 1-1v-4.9a2 2 0 0 0-1.4-1.9l-1.2-3.8A2 2 0 0 0 17.5 5zm0 2h11l1 3H5.5zM6 12.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zm12 0a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3z\"/></symbol>\n  <symbol id=\"i-train\" viewBox=\"0 0 24 24\"><path d=\"M8 3a3 3 0 0 0-3 3v9a3 3 0 0 0 2.2 2.9L6 20h2.3l1-1.5h5.4l1 1.5H18l-1.2-2.1A3 3 0 0 0 19 15V6a3 3 0 0 0-3-3zm-1 4h10v4H7zm1.5 6.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zm7 0a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3z\"/></symbol>\n  <symbol id=\"i-plane\" viewBox=\"0 0 24 24\"><path d=\"M21 15.5v-2l-8-5V3a1.5 1.5 0 0 0-3 0v5.5l-8 5v2l8-2.5v4.5l-2 1.5V21l3.5-1 3.5 1v-1.5l-2-1.5V13z\"/></symbol>\n</defs></svg>\n\n<div class=\"stage\" id=\"app\">\n  <div class=\"bg d\"></div><div class=\"bg l\"></div>\n  <div class=\"top\">\n    <div class=\"lbl\">Speedometer</div>\n    <div class=\"glass gps\"><span class=\"gpsdot\" id=\"gpsDot\"></span><span id=\"gpsTxt\">GPS off</span></div>\n    <button class=\"glass rnd\" id=\"dockBtn\" aria-label=\"Dash mode\"><svg class=\"i\"><use href=\"#i-moon\"/></svg></button>\n  </div>\n  <div id=\"gaugeWrap\">\n    <canvas id=\"gauge\"></canvas>\n    <div class=\"readout\">\n      <div class=\"speed\" id=\"speedV\">0</div>\n      <div class=\"unitlbl\" id=\"unitLbl\">km/h</div>\n      <div class=\"vehicle\" id=\"vehicle\"></div>\n    </div>\n  </div>\n  <div class=\"lower\"><div class=\"lowerin\">\n    <div class=\"units\" id=\"units\"></div>\n    <div class=\"best\" id=\"best\"></div>\n    <div class=\"trip\">\n      <div class=\"tcell glass\"><div class=\"v\" id=\"tDist\">0.0</div><div class=\"l\" id=\"tDistU\">KM</div></div>\n      <div class=\"tcell glass\"><div class=\"v\" id=\"tAvg\">0</div><div class=\"l\">AVG</div></div>\n      <div class=\"tcell glass\"><div class=\"v\" id=\"tMax\">0</div><div class=\"l\">MAX</div></div>\n      <div class=\"tcell glass\"><div class=\"v\" id=\"tTime\">0:00</div><div class=\"l\">MOVING</div></div>\n    </div>\n    <div class=\"hint\" id=\"hint\"></div>\n    <div class=\"bar\">\n      <button class=\"btn glass\" id=\"resetBtn\"><svg class=\"i\"><use href=\"#i-reset\"/></svg>Reset trip</button>\n      <button class=\"btn go\" id=\"goBtn\"><svg class=\"i\"><use href=\"#i-play\"/></svg>Start</button>\n    </div>\n  </div></div>\n</div>\n\n<div class=\"dock\" id=\"dock\">\n  <div class=\"drift\" id=\"dDrift\">\n    <div class=\"dspeed\" id=\"dSpeed\">0</div>\n    <div class=\"dunit\" id=\"dUnit\">km/h</div>\n    <div class=\"dgps\"><span class=\"gpsdot\" id=\"dDot\"></span><span id=\"dTxt\"></span></div>\n  </div>\n  <div class=\"dhint\" id=\"dHint\">Tap for controls</div>\n  <div class=\"ctl\" id=\"dCtl\">\n    <button id=\"dGo\"><svg class=\"i\"><use href=\"#i-pause\"/></svg><span>Pause</span></button>\n    <button id=\"dExit\"><svg class=\"i\"><use href=\"#i-close\"/></svg>Exit dash mode</button>\n  </div>\n</div>\n\n<script>\n\"use strict\";\nfunction el(i){return document.getElementById(i)}\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nvar store={getItem:function(k){var s=window.myllmStorage;return s?s.getItem(k).catch(function(){return null}):Promise.resolve(null)},\n           setItem:function(k,v){var s=window.myllmStorage;if(s)try{s.setItem(k,v).catch(function(){})}catch(e){}}};\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k||'light')}catch(e){}}\n\n/* ================= speed engine (pure — harness-tested) ================= */\nvar R=6371000;\nfunction haversine(a,b){\n  var dLat=(b.lat-a.lat)*Math.PI/180,dLon=(b.lon-a.lon)*Math.PI/180;\n  var la=a.lat*Math.PI/180,lb=b.lat*Math.PI/180;\n  var h=Math.sin(dLat/2)*Math.sin(dLat/2)+Math.cos(la)*Math.cos(lb)*Math.sin(dLon/2)*Math.sin(dLon/2);\n  return 2*R*Math.asin(Math.min(1,Math.sqrt(h)));\n}\nvar MAX_MS=340;           // ~1220 km/h sanity ceiling (fast jet); beyond = GPS glitch\nvar ACC_LIMIT=35;         // metres — ignore sloppy fixes\nfunction makeEngine(){\n  return {fixes:[],ema:null,dist:0,movingMs:0,maxMs:0,peakMs:0};\n}\n/* Coverage hole (tunnel, underground, backgrounded app): drop the window so the\n   first fix on the far side can't be paired with one from before the gap — that\n   would derive a fictional speed and teleport the trip distance. Trip totals and\n   peak survive; only the derivation state is forgotten. */\nfunction resetWindow(en){en.fixes=[];en.ema=null;}\n/* the gauge follows a DECAYING peak, not the trip max: it grows instantly when\n   you speed up, then eases back ~12%/s so a plane's 0-1000 scale returns to\n   something readable within half a minute of landing */\nfunction decayPeak(en,dtMs){\n  var v=en.ema||0;\n  if(v>en.peakMs)en.peakMs=v;\n  else if(dtMs>0)en.peakMs=Math.max(v,en.peakMs*Math.pow(0.88,dtMs/1000));\n}\n/* feed one fix {lat,lon,acc,t(ms),vNative(m/s or -1)}; returns speed m/s or null */\nfunction feed(en,fix){\n  var prev=en.fixes.length?en.fixes[en.fixes.length-1]:null;\n  en.fixes.push(fix);\n  if(en.fixes.length>10)en.fixes.shift();\n  var v=null;\n  if(fix.vNative!=null&&fix.vNative>=0){\n    v=Math.min(MAX_MS,fix.vNative);\n  } else if(fix.acc<=ACC_LIMIT){\n    /* windowed derivation: oldest good fix 4–9s back smooths poll-latency jitter */\n    var base=null;\n    for(var i=0;i<en.fixes.length-1;i++){\n      var f=en.fixes[i];\n      if(f.acc<=ACC_LIMIT&&fix.t-f.t>=4000&&fix.t-f.t<=9500){base=f;break;}\n    }\n    if(base){\n      var d=haversine({lat:base.lat,lon:base.lon},{lat:fix.lat,lon:fix.lon});\n      var raw=d/((fix.t-base.t)/1000);\n      if(raw<=MAX_MS)v=raw;\n    }\n  }\n  if(v!=null){\n    if(v<0.6)v=0;                      // GPS drift while standing reads as zero\n    en.ema=en.ema==null?v:en.ema+(v-en.ema)*0.45;\n    if(en.ema<0.3)en.ema=0;\n    if(en.ema>en.maxMs)en.maxMs=en.ema;\n  }\n  decayPeak(en,prev?(fix.t-prev.t):0);\n  /* trip accumulation between consecutive good fixes */\n  if(prev&&prev.acc<=ACC_LIMIT&&fix.acc<=ACC_LIMIT){\n    var dt=(fix.t-prev.t)/1000;\n    if(dt>0&&dt<15){\n      var seg=haversine({lat:prev.lat,lon:prev.lon},{lat:fix.lat,lon:fix.lon});\n      var segV=seg/dt;\n      if(segV>=0.5&&segV<=MAX_MS){en.dist+=seg;en.movingMs+=dt*1000;}\n    }\n  }\n  return en.ema;\n}\n/* units: factor from m/s + label */\nvar UNITS=[['kmh','km/h',3.6],['mph','mph',2.23694],['kn','kn',1.94384]];\nfunction conv(ms,u){return ms*UNITS.find(function(x){return x[0]===u})[2]}\n/* what's likely carrying you, from km/h */\nfunction vehicleFor(kmh){\n  if(kmh<1)return null;\n  if(kmh<7)return ['walk','Walking pace'];\n  if(kmh<50)return ['horse','Gallop territory'];\n  if(kmh<160)return ['car','Road speed'];\n  if(kmh<360)return ['train','Rail speed'];\n  return ['plane','Air speed'];\n}\n/* gauge range auto-grows in display units */\nvar RANGES=[30,60,120,200,300,500,750,1000,1400];\nfunction rangeFor(maxDisp){\n  for(var i=0;i<RANGES.length;i++)if(RANGES[i]>=Math.max(30,maxDisp*1.12))return RANGES[i];\n  return RANGES[RANGES.length-1];\n}\n\n/* ================= state + UI ================= */\nvar en=makeEngine(),unit='kmh',running=false,best=0;\n/* connection state — deliberately split into \"when was the fix taken\" (lastFixAt,\n   from CoreLocation's own timestamp) and \"when did the bridge last answer\"\n   (lastReplyAt). iOS can keep answering instantly with a cached position, and\n   only the first of those tells you whether the GPS is actually alive. */\nvar uiT=null,inFlight=0,seq=0,lastPollAt=0,lastFixAt=0,lastFixT=0,lastReplyAt=0,\n    lastAcc=null,failStreak=0,denied=false,startedAt=0,srcMode='none',watchStartedAt=0;\nvar POLL_MS=2000,SLOW_MS=5000,TIMEOUT_MS=12000,STALE_MS=6000,LOST_MS=18000,GAP_MS=12000,\n    WATCH_GRACE=15000,WATCH_GIVEUP=30000;\nfunction fixAge(){return lastFixAt?Date.now()-lastFixAt:-1}\nfunction fmtTime(ms){var s=Math.floor(ms/1000),m=Math.floor(s/60);return m+':'+('0'+(s%60)).slice(-2)}\nfunction render(){\n  var age=fixAge(),lost=running&&(age<0||age>=LOST_MS),stale=running&&age>=STALE_MS;\n  document.querySelector('.readout').classList.toggle('stale',!!stale);\n  var ms=lost?0:(en.ema||0),disp=conv(ms,unit);\n  /* an em dash, not a stale number: a speedometer that confidently reads 60 with\n     no signal is worse than one that admits it doesn't know */\n  el('speedV').textContent=lost?'—':(disp<10?disp.toFixed(1):Math.round(disp));\n  var veh=lost?null:vehicleFor(ms*3.6);\n  el('vehicle').innerHTML=veh?('<svg class=\"i\"><use href=\"#i-'+veh[0]+'\"/></svg>'+veh[1]):(running&&!lost?'Waiting for movement…':'');\n  el('unitLbl').textContent=UNITS.find(function(x){return x[0]===unit})[1];\n  /* the room warms with speed: amber at rest, gold on the road, blue in the air */\n  setHue(36+Math.min(1,(ms*3.6)/400)*180);\n  if(dockOn){\n    el('dSpeed').textContent=el('speedV').textContent;el('dSpeed').className='dspeed'+(stale||lost?' stale':'');\n    el('dUnit').textContent=el('unitLbl').textContent;\n  }\n  el('tDist').textContent=unit==='mph'?(en.dist/1609.34).toFixed(1):unit==='kn'?(en.dist/1852).toFixed(1):(en.dist/1000).toFixed(1);\n  el('tDistU').textContent=unit==='mph'?'MI':unit==='kn'?'NM':'KM';\n  var avg=en.movingMs>2000?conv(en.dist/(en.movingMs/1000),unit):0;\n  el('tAvg').textContent=Math.round(avg);\n  el('tMax').textContent=Math.round(conv(en.maxMs,unit));\n  el('tTime').textContent=fmtTime(en.movingMs);\n  el('best').textContent=best>0?('Best ever  '+Math.round(conv(best,unit))+' '+UNITS.find(function(x){return x[0]===unit})[1]):'';\n  drawGauge(lost?0:disp);\n}\n/* ---- gauge ---- */\nvar cv=el('gauge'),ctx=cv.getContext('2d');\nfunction drawGauge(disp){\n  var wrap=el('gaugeWrap'),W=Math.max(160,Math.min(wrap.clientWidth-24,(wrap.clientHeight-16)/0.86,460)),H=W*0.86,D=Math.min(window.devicePixelRatio||1,3);\n  var L=el('app').classList.contains('lite');\n  el('app').style.setProperty('--sp',Math.round(W*0.22)+'px');\n  /* the status clock redraws twice a second — only reallocate the backing store\n     when the size actually changed, not on every frame */\n  if(cv.width!==W*D||cv.height!==H*D){\n    cv.width=W*D;cv.height=H*D;cv.style.width=W+'px';cv.style.height=H+'px';\n  }\n  var cx=W/2*D,cy=H*0.56*D,r=W*0.45*D;\n  var range=rangeFor(Math.max(disp,conv(en.peakMs,unit)));\n  var a0=Math.PI*0.75,a1=Math.PI*2.25;      /* 240°, opening at the bottom */\n  function ang(v){return a0+(a1-a0)*Math.min(1,v/range)}\n  ctx.clearRect(0,0,cv.width,cv.height);\n  /* track */\n  ctx.lineWidth=12*D;ctx.lineCap='round';\n  ctx.strokeStyle=L?'rgba(20,20,40,.12)':'rgba(255,255,255,.12)';\n  ctx.beginPath();ctx.arc(cx,cy,r,a0,a1);ctx.stroke();\n  /* fill */\n  if(disp>0.4){\n    var grad=ctx.createLinearGradient(0,0,cv.width,0);\n    grad.addColorStop(0,'hsl('+hueNow+',92%,'+(L?48:62)+'%)');grad.addColorStop(1,'hsl('+(hueNow+40)+',88%,'+(L?42:58)+'%)');\n    ctx.strokeStyle=grad;\n    ctx.save();ctx.shadowColor='hsl('+hueNow+',90%,60%)';ctx.shadowBlur=(L?0:14)*D;\n    ctx.beginPath();ctx.arc(cx,cy,r,a0,ang(disp));ctx.stroke();ctx.restore();\n  }\n  /* ticks + labels */\n  ctx.fillStyle=L?'rgba(21,21,26,.6)':'rgba(255,255,255,.62)';\n  ctx.font='700 '+(11*D)+'px -apple-system, system-ui, sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';\n  for(var i=0;i<=6;i++){\n    var v=range*i/6,a=ang(v);\n    var x1=cx+Math.cos(a)*(r-20*D),y1=cy+Math.sin(a)*(r-20*D);\n    var x2=cx+Math.cos(a)*(r-11*D),y2=cy+Math.sin(a)*(r-11*D);\n    ctx.strokeStyle=L?'rgba(21,21,26,.3)':'rgba(255,255,255,.35)';ctx.lineWidth=2*D;\n    ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2,y2);ctx.stroke();\n    ctx.fillText(String(Math.round(v)),cx+Math.cos(a)*(r-34*D),cy+Math.sin(a)*(r-34*D));\n  }\n}\n/* ---- units ---- */\nfunction buildUnits(){\n  var w=el('units');w.innerHTML='';\n  UNITS.forEach(function(u){\n    var b=document.createElement('button');b.className='uchip'+(u[0]===unit?' on':'');b.textContent=u[1];\n    b.onclick=function(){unit=u[0];store.setItem('speedo.unit',unit);buildUnits();render();haptic('selection')};\n    w.appendChild(b);\n  });\n}\n/* ---- GPS source ----\n   Two ways in. myllmLocation.watch() holds ONE live GPS session open, so fixes\n   carry the chip's real Doppler speed and a dropped signal reacquires itself —\n   that's the good path. Builds without it fall back to polling current(), and so\n   does a watch that never delivers.\n\n   Either way, one 500ms clock drives BOTH the status paint and the poll cadence.\n   That is the whole reconnect story: no separate poll timer to lose, and no\n   request that can wedge the app shut, because every tick re-checks and re-arms. */\nfunction setGps(state,txt){\n  el('gpsDot').className='gpsdot'+(state?' '+state:'');\n  el('gpsTxt').textContent=txt;\n  el('dDot').className=el('gpsDot').className;el('dTxt').textContent=txt;\n}\nfunction hint(t){if(el('hint').textContent!==t)el('hint').textContent=t}\nfunction idleHint(){\n  return !window.myllmLocation?'Open inside MyLLM to use GPS.'\n    :lastFixT?'Paused — tap Start to pick the signal back up.'\n    :'Tap Start, then get moving — train, plane, car or horse.';\n}\n/* Every word the user reads about the connection is derived HERE, from fix age.\n   Nothing else writes the dot or the hint, so a stale fix can't leave a healthy\n   green dot painted over a dead signal. */\nfunction paintStatus(){\n  if(!running){setGps(null,lastFixT?'paused':'GPS off');hint(idleHint());return}\n  if(denied){\n    setGps('bad','blocked');\n    hint('Location for apps is off. Turn it on in MyLLM Settings, then tap Start.');\n    return;\n  }\n  var age=fixAge();\n  if(age<0){                                     // no fix yet this session\n    var s=Math.max(0,Math.round((Date.now()-startedAt)/1000));\n    setGps('search','searching '+s+'s');\n    hint(s<10?'Acquiring GPS — the first fix takes a few seconds.'\n             :'Still searching — GPS needs a view of the sky. Indoors this can take a while.');\n    return;\n  }\n  if(age<STALE_MS){                              // live\n    setGps(lastAcc<=15?'ok':(lastAcc<=ACC_LIMIT?'mid':'bad'),'±'+Math.round(lastAcc)+'m');\n    hint(lastAcc>ACC_LIMIT?'Weak GPS — clearer sky gives a better reading.'\n        :(en.fixes.length<3?'Getting a bearing — a few seconds…':''));\n    return;\n  }\n  /* still answering but with old positions = iOS is serving a cache; not\n     answering at all = the fix or the bridge is gone. Different words, because\n     they need different things from the user. */\n  var answering=Date.now()-lastReplyAt<8000;\n  if(age<LOST_MS){\n    setGps('search','reacquiring');\n    hint('GPS went quiet '+Math.round(age/1000)+'s ago — reconnecting…');\n    return;\n  }\n  setGps('bad','no signal');\n  hint(answering?'Only an old position is coming back — open sky helps. Still retrying.'\n                :'Lost GPS. Still retrying — it picks up on its own when the signal returns.');\n}\n/* One fix in, from either source. Returns false if it wasn't usable — the\n   caller must NOT treat that as liveness. */\nfunction acceptFix(p){\n  if(!p||typeof p.latitude!=='number')return false;\n  var now=Date.now();\n  var t=(typeof p.timestamp==='number'&&p.timestamp>0)?p.timestamp:now;\n  /* A repeated or older timestamp is iOS replaying a cached fix. Feeding it\n     would stuff the window with duplicates AND refresh the \"live\" clock over a\n     signal that is actually gone, so it's dropped and the age keeps running. */\n  if(t<=lastFixT)return false;\n  if(lastFixT&&t-lastFixT>GAP_MS)resetWindow(en);\n  var fix={lat:p.latitude,lon:p.longitude,acc:p.accuracy==null?999:p.accuracy,t:t,\n           vNative:(typeof p.speed==='number')?p.speed:null};\n  lastFixT=t;lastFixAt=Math.min(now,t);lastAcc=fix.acc;\n  feed(en,fix);\n  if(en.maxMs>best){best=en.maxMs;store.setItem('speedo.best',String(best));}\n  return true;\n}\nfunction isBlocked(msg){return /turned off|denied|restricted|permission/i.test(msg||'')}\n/* ---- source A: live watch (MyLLM 4.5.6+) ---- */\nfunction onWatchFix(p){\n  lastReplyAt=Date.now();\n  if(p&&p.error){                       // the stream failed after it started\n    failStreak++;\n    if(isBlocked(p.error))denied=true;\n    paintStatus();return;\n  }\n  failStreak=0;\n  acceptFix(p);\n  paintStatus();render();\n}\nfunction beginSource(){\n  if(window.myllmLocation.watch){\n    srcMode='watch';watchStartedAt=Date.now();\n    /* 'best' = BestForNavigation. Worth the power for a speedometer, and it's\n       released the moment the user pauses. */\n    myllmLocation.watch(onWatchFix,{accuracy:'best'}).catch(function(e){\n      if(isBlocked((e&&e.message)||''))denied=true;\n      usePolling();\n    });\n  }else{\n    srcMode='poll';                     // older build — no watch() to feature-detect\n  }\n}\nfunction usePolling(){\n  if(srcMode==='poll')return;\n  srcMode='poll';\n  try{if(window.myllmLocation.stop)myllmLocation.stop()}catch(e){}\n}\nfunction releaseWatch(){\n  if(srcMode!=='watch')return;\n  try{myllmLocation.stop()}catch(e){}\n}\n/* ---- source B: polling current() ---- */\nfunction poll(){\n  if(!running||inFlight||denied||!window.myllmLocation)return;\n  var id=++seq;inFlight=id;lastPollAt=Date.now();\n  var done=false;\n  /* Watchdog. myllmLocation.current() is a promise over a WKWebView bridge, and\n     a promise that never settles (permission sheet left open, app suspended\n     mid-request, native callback dropped) used to strand the in-flight guard\n     forever — the app stayed on screen looking fine and never polled again.\n     Sits past CoreLocation's own ~10s one-shot timeout so real failures land\n     first and this only ever catches the genuinely lost ones. */\n  var wd=setTimeout(function(){\n    if(done)return;done=true;\n    if(inFlight===id)inFlight=0;\n    failStreak++;paintStatus();\n  },TIMEOUT_MS);\n  function settle(){if(done)return false;done=true;clearTimeout(wd);if(inFlight===id)inFlight=0;return true}\n  myllmLocation.current({address:false,accuracy:'best'}).then(function(p){\n    if(!settle())return;\n    lastReplyAt=Date.now();\n    if(!p||typeof p.latitude!=='number'){failStreak++;paintStatus();return}\n    failStreak=0;\n    acceptFix(p);\n    paintStatus();render();\n  }).catch(function(e){\n    if(!settle())return;\n    lastReplyAt=Date.now();failStreak++;\n    /* a refused permission won't fix itself by asking 30 more times a minute */\n    if(isBlocked((e&&e.message)||''))denied=true;\n    paintStatus();\n  });\n}\n/* the single clock: paint, then feed the source that needs feeding */\nfunction tick(){\n  paintStatus();render();\n  if(!running||denied)return;\n  if(srcMode==='watch'){\n    /* A watch that never delivers is worse than no watch — it just sits there\n       looking like a signal problem. Give it a grace period from the start, and\n       a longer one mid-session (the native side reacquires on its own), then\n       drop to the polling path that older builds have always used. */\n    var quiet=lastFixAt?Date.now()-lastFixAt:Date.now()-watchStartedAt;\n    if(quiet>(lastFixAt?WATCH_GIVEUP:WATCH_GRACE))usePolling();\n    return;\n  }\n  var gap=failStreak>=4?SLOW_MS:POLL_MS;   // ease off once it's clearly not answering\n  if(!inFlight&&Date.now()-lastPollAt>=gap)poll();\n}\nfunction start(){\n  if(!window.myllmLocation){\n    hint('This needs the MyLLM app with location for apps enabled.');\n    haptic('warning');return;\n  }\n  running=true;denied=false;failStreak=0;inFlight=0;\n  startedAt=Date.now();lastPollAt=0;lastFixAt=0;   // fresh session: \"searching\", not stale\n  el('goBtn').innerHTML='<svg class=\"i\"><use href=\"#i-pause\"/></svg>Pause';el('goBtn').className='btn glass stop';\n  syncLook();syncChrome();\n  clearInterval(uiT);uiT=setInterval(tick,500);\n  beginSource();tick();haptic('success');\n}\nfunction stop(){\n  running=false;clearInterval(uiT);uiT=null;inFlight=0;\n  releaseWatch();srcMode='none';   // let go of the GPS the moment the user pauses\n  el('goBtn').innerHTML='<svg class=\"i\"><use href=\"#i-play\"/></svg>Start';el('goBtn').className='btn go';\n  syncLook();syncChrome();\n  paintStatus();render();haptic('light');\n}\n/* The native side also stops the stream on teardown; this just makes sure a\n   swipe-away releases it without waiting for that. */\nwindow.addEventListener('pagehide',releaseWatch);\n/* Coming back from the background: timers were frozen and any request in flight\n   when we left will never land, so clear the guard and poll straight away\n   instead of waiting out the watchdog. */\ndocument.addEventListener('visibilitychange',function(){\n  if(document.hidden||!running)return;\n  inFlight=0;lastPollAt=0;tick();\n});\nel('goBtn').onclick=function(){running?stop():start()};\nel('resetBtn').onclick=function(){\n  var keep=en.fixes,e2=makeEngine();e2.fixes=keep.slice(-2);e2.ema=en.ema;e2.peakMs=en.ema||0;en=e2;\n  render();haptic('warning');\n};\nwindow.addEventListener('resize',render);\n\n/* ================= look, chrome, dash mode =================\n   Tracking takes the whole display and keeps it awake — a speedometer on a\n   dash mount must not sleep. Where MyLLM can't hide its own title bar, a dark\n   stage under a white bar looks cut in half, so in light mode without\n   myllmImmersive the stage stays light. The bridge is looked up on each call. */\nvar hue=36,hueNow=36,dockOn=false,dockDrift=null,dockCtlTimer=null,wakeLock=null;\nfunction setHue(h){if(Math.abs(h-hue)<0.5)return;hue=h;el('app').style.setProperty('--h',String(Math.round(h)))}\nfunction isLight(){return !(window.matchMedia&&matchMedia('(prefers-color-scheme: dark)').matches)}\nfunction syncLook(){el('app').classList.toggle('lite',isLight()&&!(running&&window.myllmImmersive))}\nfunction syncChrome(){\n  if(!window.myllmImmersive)return;\n  try{myllmImmersive(running||dockOn,{keepAwake:running||dockOn}).catch(function(){})}catch(e){}\n}\nfunction requestWake(){if(!('wakeLock' in navigator))return;navigator.wakeLock.request('screen').then(function(l){wakeLock=l}).catch(function(){wakeLock=null})}\nfunction releaseWake(){if(wakeLock){try{wakeLock.release()}catch(e){}wakeLock=null}}\nfunction driftOnce(){var x=Math.round((Math.random()-0.5)*44),y=Math.round((Math.random()-0.5)*44);el('dDrift').style.transform='translate('+x+'px,'+y+'px)'}\nfunction openDock(){\n  dockOn=true;haptic('medium');\n  el('dock').classList.add('on');el('dCtl').classList.remove('on');\n  el('dHint').style.opacity='1';setTimeout(function(){el('dHint').style.opacity='0'},4000);\n  driftOnce();dockDrift=setInterval(driftOnce,60000);\n  render();paintStatus();requestWake();syncChrome();\n}\nfunction closeDock(){\n  dockOn=false;el('dock').classList.remove('on');\n  clearInterval(dockDrift);clearTimeout(dockCtlTimer);dockDrift=dockCtlTimer=null;\n  releaseWake();syncChrome();\n}\nfunction dockTap(){\n  if(!dockOn)return;\n  el('dHint').style.opacity='0';el('dCtl').classList.add('on');\n  clearTimeout(dockCtlTimer);dockCtlTimer=setTimeout(function(){el('dCtl').classList.remove('on')},5000);\n}\nel('dockBtn').onclick=openDock;\nel('dock').addEventListener('click',function(e){if(!e.target.closest('button'))dockTap()});\nel('dExit').onclick=function(){haptic('light');closeDock()};\nel('dGo').onclick=function(){running?stop():start();el('dGo').innerHTML=running?'<svg class=\"i\"><use href=\"#i-pause\"/></svg><span>Pause</span>':'<svg class=\"i\"><use href=\"#i-play\"/></svg><span>Start</span>';dockTap()};\ndocument.addEventListener('visibilitychange',function(){\n  if(document.hidden){releaseWake();return}\n  if(dockOn)requestWake();\n  if(running||dockOn)syncChrome();          /* MyLLM puts its bars back when the app is left */\n});\nif(window.matchMedia){\n  var mq=matchMedia('(prefers-color-scheme: dark)');\n  if(mq.addEventListener)mq.addEventListener('change',function(){syncLook();render()});else if(mq.addListener)mq.addListener(function(){syncLook();render()});\n}\n(function ease(){hueNow+=(hue-hueNow)*0.08;requestAnimationFrame(ease)})();\nsyncLook();\n\nstore.getItem('speedo.unit').then(function(v){\n  if(v&&UNITS.some(function(u){return u[0]===v}))unit=v;\n  return store.getItem('speedo.best');\n}).then(function(v){\n  best=parseFloat(v)||0;\n  buildUnits();render();paintStatus();\n});\n</script>\n</body></html>\n"}