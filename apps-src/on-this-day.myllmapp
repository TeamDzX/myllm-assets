{"name": "On This Day", "html": "<!doctype html>\n<!--\n  On This Day — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>On This Day</title>\n<style>:root{--build-id:\"cf0902a5f1\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); --h:245; }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:760px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.96); }\n  [hidden]{ display:none !important; }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 6px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 28%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  .head .acts{ display:flex; gap:8px; flex-shrink:0; }\n  .ib{ width:40px; height:40px; border-radius:12px; border:1px solid var(--line); background:var(--surface); display:flex; align-items:center; justify-content:center; font-size:17px; }\n  .ib.busy svg{ animation:spin .8s linear infinite; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n\n  .stick{ position:sticky; top:0; z-index:5; margin:0 calc(-16px - env(safe-area-inset-right)) 4px calc(-16px - env(safe-area-inset-left));\n    padding:8px calc(16px + env(safe-area-inset-right)) 10px calc(16px + env(safe-area-inset-left));\n    background:color-mix(in srgb, var(--bg) 90%, transparent); -webkit-backdrop-filter:saturate(180%) blur(12px); backdrop-filter:saturate(180%) blur(12px); }\n  .chips{ display:flex; gap:7px; overflow-x:auto; -webkit-overflow-scrolling:touch; scrollbar-width:none; }\n  .chips::-webkit-scrollbar{ display:none; }\n  .chip{ flex:0 0 auto; min-height:36px; border:1px solid var(--line); background:var(--surface); border-radius:99px; padding:0 15px; font-size:14px; font-weight:650; white-space:nowrap; display:inline-flex; align-items:center; gap:6px; }\n  .chip small{ font-size:12px; font-weight:700; opacity:.6; font-variant-numeric:tabular-nums; }\n  .chip.hot{ background:var(--acc); border-color:var(--acc); color:#fff; }\n  .chip.hot small{ opacity:.85; }\n\n  .item{ display:flex; gap:12px; align-items:flex-start; background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:12px 14px; margin-bottom:8px; }\n  .year{ flex-shrink:0; min-width:48px; font-size:16px; font-weight:800; letter-spacing:-.01em; font-variant-numeric:tabular-nums; color:hsl(var(--h) 70% 55%); padding-top:1px; }\n  .year svg.i{ width:1.1em; height:1.1em; margin-top:2px; }\n  .txt{ flex:1; min-width:0; font-size:15px; line-height:1.45; overflow-wrap:anywhere; }\n  .txt a{ color:inherit; text-decoration:none; }\n  .thumb{ width:56px; height:56px; border-radius:12px; object-fit:cover; flex:none; background:var(--fill); }\n\n  .sk{ display:flex; gap:12px; background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:14px; margin-bottom:8px; }\n  .sk b{ width:44px; height:14px; border-radius:7px; background:var(--fill); flex-shrink:0; animation:pulse 1.3s ease-in-out infinite; }\n  .sk div{ flex:1; }\n  .sk i{ display:block; height:12px; border-radius:6px; background:var(--fill); margin-bottom:9px; animation:pulse 1.3s ease-in-out infinite; }\n  .sk i:last-child{ width:60%; margin-bottom:0; }\n  @keyframes pulse{ 50%{ opacity:.45; } }\n\n  .notice{ display:flex; gap:12px; align-items:flex-start; background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:14px; margin:4px 0 12px; }\n  .notice .tile{ width:36px; height:36px; border-radius:10px; font-size:15px; }\n  .notice.err .tile{ background:linear-gradient(145deg,#ff6b5f,#c0392b); }\n  .notice.off .tile{ background:linear-gradient(145deg,#8e8e93,#48484a); }\n  .notice b{ display:block; font-size:15px; font-weight:750; }\n  .notice p{ font-size:13.5px; color:var(--muted); margin-top:2px; line-height:1.45; }\n  .notice button{ margin-top:10px; min-height:36px; padding:0 14px; border-radius:10px; border:0; background:var(--acc); color:#fff; font-weight:700; font-size:13.5px; display:inline-flex; align-items:center; gap:6px; }\n\n  @media (prefers-reduced-motion:reduce){ .sk i, .sk b, .ib.busy svg{ animation:none; } button:active{ transform:none; } }\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-cal\" viewBox=\"0 0 24 24\"><path d=\"M7 2.8a1 1 0 0 1 1 1V5h8V3.8a1 1 0 0 1 2 0V5h.5A2.5 2.5 0 0 1 21 7.5v11a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 18.5v-11A2.5 2.5 0 0 1 5.5 5H6V3.8a1 1 0 0 1 1-1zM5 10.2v8.3c0 .3.2.5.5.5h13c.3 0 .5-.2.5-.5v-8.3z\"/></symbol>\n  <symbol id=\"i-refresh\" viewBox=\"0 0 24 24\"><path d=\"M20 12a8 8 0 1 1-2.6-5.9M20 4v5h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-flag\" viewBox=\"0 0 24 24\"><path d=\"M5 3a1 1 0 0 1 1 1v.5c1.6-.9 3.4-.9 5.3-.1 1.9.8 3.6.8 5.3-.1A1 1 0 0 1 18 5.2v8.4a1 1 0 0 1-.5.9c-2.1 1.2-4.3 1.3-6.6.3-1.6-.7-3.2-.6-4.9.4V21a1 1 0 1 1-2 0V4a1 1 0 0 1 1-1z\"/></symbol>\n  <symbol id=\"i-off\" viewBox=\"0 0 24 24\"><path d=\"M3.3 3.3a1 1 0 0 1 1.4 0l16 16a1 1 0 0 1-1.4 1.4l-3.5-3.5a2 2 0 1 1-2.5-2.5L10.8 12a5 5 0 0 0-3.4 1.6 1 1 0 0 1-1.5-1.3 7 7 0 0 1 3.1-2L7 8.4a10 10 0 0 0-3.2 2.2 1 1 0 0 1-1.4-1.4A12 12 0 0 1 5.6 7L3.3 4.7a1 1 0 0 1 0-1.4zM12 6c3.5 0 6.8 1.4 9.2 3.8a1 1 0 0 1-1.4 1.4A11 11 0 0 0 12 8h-.6L9.6 6.2C10.4 6.1 11.2 6 12 6z\"/></symbol>\n  <symbol id=\"i-warn\" viewBox=\"0 0 24 24\"><path d=\"M10.3 3.9a2 2 0 0 1 3.4 0l8 13.6a2 2 0 0 1-1.7 3H4a2 2 0 0 1-1.7-3zM12 9a1 1 0 0 0-1 1v4a1 1 0 0 0 2 0v-4a1 1 0 0 0-1-1zm0 7.2a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z\"/></symbol>\n</defs></svg>\n\n<div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-cal\"/></svg></div>\n  <div class=\"ht\"><h1>On This Day</h1><p id=\"date\"></p></div>\n  <div class=\"acts\"><button class=\"ib\" id=\"refresh\" type=\"button\" aria-label=\"Refresh\"><svg class=\"i\"><use href=\"#i-refresh\"/></svg></button></div>\n</div>\n<div class=\"stick\"><div class=\"chips\" id=\"tabs\"></div></div>\n<div id=\"status\"></div>\n<div id=\"wrap\"></div>\n\n<script>\nvar TABS=[['Events','events'],['Births','births'],['Deaths','deaths'],['Holidays','holidays']];\nvar active=0,data=null,loading=false;\nfunction el(i){return document.getElementById(i)}\nfunction icon(n){return '<svg class=\"i\"><use href=\"#i-'+n+'\"/></svg>'}\n/* Looked up when used, never kept: MyLLM can add bridges after this script runs. */\nfunction net(){return window.myllmFetch||null}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nfunction esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;')}\nvar now=new Date();\nvar MM=String(now.getMonth()+1).padStart(2,'0'),DD=String(now.getDate()).padStart(2,'0');\nvar DAYNAME=now.toLocaleDateString(undefined,{month:'long',day:'numeric'});\nel('date').textContent='History for '+DAYNAME;\n\nfunction notice(kind,title,text,retry){\n  var S=el('status');\n  S.innerHTML='<div class=\"notice '+kind+'\"><div class=\"tile\">'+icon(kind==='off'?'off':'warn')+'</div><div><b>'+esc(title)+'</b><p>'+esc(text)+'</p>'+\n    (retry?'<button type=\"button\">'+icon('refresh')+'Try again</button>':'')+'</div></div>';\n  if(retry)S.querySelector('button').onclick=retry;\n}\nfunction skeleton(){var h='';for(var i=0;i<6;i++)h+='<div class=\"sk\"><b></b><div><i></i><i></i></div></div>';el('wrap').innerHTML=h}\n\nfunction renderTabs(){\n  var T=el('tabs');T.innerHTML='';\n  TABS.forEach(function(t,i){\n    var b=document.createElement('button');b.type='button';b.className='chip'+(i===active?' hot':'');\n    var n=data&&data[t[1]]?data[t[1]].length:null;\n    b.innerHTML=esc(t[0])+(n!=null?'<small>'+n+'</small>':'');\n    b.onclick=function(){if(active===i)return;active=i;haptic('selection');render();window.scrollTo({top:0})};\n    T.appendChild(b);\n  });\n}\n\nfunction loadAll(){\n  el('status').innerHTML='';\n  if(!net()){el('wrap').innerHTML='';notice('off','Network access is off','On This Day needs “Allow apps to use the internet” in MyLLM’s Settings.',loadAll);return}\n  skeleton();loading=true;el('refresh').classList.add('busy');\n  net()('https://api.wikimedia.org/feed/v1/wikipedia/en/onthisday/all/'+MM+'/'+DD,\n    {headers:{'Api-User-Agent':'MyLLMos/1.0 (https://opticell-limited.com/myllm)'}})\n  .then(function(r){\n    if(!r||!r.ok)throw new Error('HTTP '+((r&&r.status)||'?'));\n    data=JSON.parse(r.body);render();\n  }).catch(function(e){el('wrap').innerHTML='';notice('err','Couldn’t load history',e.message,loadAll)})\n  .then(function(){loading=false;el('refresh').classList.remove('busy')});\n}\n\nfunction render(){\n  renderTabs();var W=el('wrap');W.innerHTML='';if(!data)return;\n  el('status').innerHTML='';\n  var list=(data[TABS[active][1]]||[]).slice();\n  list.sort(function(a,b){return (b.year||0)-(a.year||0)});\n  if(!list.length){notice('err','Nothing listed for today','Try another tab.',null);return}\n  list.forEach(function(ev){\n    var page=ev.pages&&ev.pages[0];\n    var url=page&&page.content_urls&&page.content_urls.desktop&&page.content_urls.desktop.page;\n    var thumb=page&&page.thumbnail&&page.thumbnail.source;\n    var c=document.createElement('div');c.className='item';\n    var inner='<div class=\"year\">'+(ev.year?ev.year:icon('flag'))+'</div><div class=\"txt\">'+\n      (url?'<a href=\"'+esc(url)+'\" target=\"_top\" rel=\"noopener\">'+esc(ev.text)+'</a>':esc(ev.text))+'</div>';\n    if(thumb)inner+='<img class=\"thumb\" src=\"'+esc(thumb)+'\" alt=\"\" loading=\"lazy\">';\n    c.innerHTML=inner;\n    var im=c.querySelector('img');if(im)im.onerror=function(){if(im.parentNode)im.parentNode.removeChild(im)};\n    W.appendChild(c);\n  });\n}\nel('refresh').onclick=function(){if(loading)return;haptic('light');loadAll()};\nrenderTabs();loadAll();\n</script></body></html>\n", "kind": "html", "iconSymbol": "calendar", "iconColor": "indigo"}