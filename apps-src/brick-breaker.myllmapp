{"name": "Brick Breaker", "html": "<!doctype html>\n<!--\n  Brick Breaker — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,user-scalable=no,viewport-fit=cover\">\n<title>Brick Breaker</title>\n<style>:root{--build-id:\"164946bd97\";color-scheme:light dark}\n  @property --h{ syntax:'<number>'; inherits:true; initial-value:258; }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  html,body{ height:100%; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:#0b0b10; color:#fff; overflow:hidden;\n    touch-action:none; overscroll-behavior:none; -webkit-user-select:none; user-select:none; }\n  button{ font:inherit; color:inherit; }\n\n  /* The stage: a hue-tinted backdrop in two layers, dark and light, so the\n     change between them can fade. */\n  .stage{ position:fixed; inset:0; --h:258; transition:--h 1.4s ease; color:#fff; }\n  .bg{ position:absolute; inset:0; transition:opacity .6s ease; }\n  .bg.d{ background:radial-gradient(120% 90% at 20% 10%, hsl(var(--h) 70% 34%), transparent 60%),\n      radial-gradient(120% 90% at 85% 95%, hsl(calc(var(--h) + 60) 65% 26%), transparent 62%), #0b0b10; }\n  .bg.l{ opacity:0; background:radial-gradient(120% 90% at 20% 0%, hsl(var(--h) 80% 84%), transparent 60%),\n      radial-gradient(120% 90% at 85% 100%, hsl(calc(var(--h) + 60) 78% 86%), transparent 62%), #f4f4f8; }\n  .lite{ color:#15151a; } .lite .bg.l{ opacity:1; } .lite .bg.d{ opacity:0; }\n\n  .col{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center;\n    padding:calc(12px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(14px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  .top{ width:100%; max-width:560px; height:44px; display:flex; align-items:center; justify-content:space-between; flex-shrink:0; }\n  .lbl{ font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; opacity:.62; white-space:nowrap; }\n  .glass{ border:1px solid rgba(255,255,255,.16); background:rgba(255,255,255,.12); color:inherit;\n    -webkit-backdrop-filter:blur(18px); backdrop-filter:blur(18px); }\n  .lite .glass{ border-color:rgba(0,0,0,.09); background:rgba(255,255,255,.62); }\n  svg{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  .rnd{ width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:15px; flex-shrink:0; }\n  .pill{ min-width:44px; height:44px; border-radius:99px; padding:0 16px; display:flex; align-items:center; justify-content:center; gap:6px;\n    font-size:19px; font-weight:800; font-variant-numeric:tabular-nums; flex-shrink:0; }\n  .pill small{ font-size:10px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; opacity:.6; }\n  .pill.bump{ animation:bump .28s ease; }\n  @keyframes bump{ 40%{ transform:scale(1.18); } }\n  .top .hide{ visibility:hidden; }\n\n  .wrap{ flex:1; width:100%; min-height:0; position:relative; display:flex; align-items:center; justify-content:center; margin:10px 0 34px; }\n  .foot{ position:absolute; left:0; right:0; top:calc(50% + var(--bh,320px) / 2 + 12px); text-align:center; font-size:12px; font-weight:600;\n    letter-spacing:.02em; opacity:.55; font-variant-numeric:tabular-nums; white-space:nowrap; }\n\n  /* One glass card over the board: title, paused, finished. */\n  .sheet{ position:absolute; left:50%; top:50%; width:max(232px, min(300px, calc(var(--b,320px) - 44px))); transform:translate(-50%,-50%) scale(.96);\n    opacity:0; pointer-events:none; border-radius:26px; padding:22px 20px 18px; text-align:center; box-shadow:0 24px 60px rgba(0,0,0,.35); z-index:5;\n    transition:opacity .28s ease, transform .28s cubic-bezier(.2,.8,.2,1); }\n  .sheet.on{ opacity:1; transform:translate(-50%,-50%); pointer-events:auto; }\n  /* whatever sits under an open card steps back, so the card reads */\n  .under{ transition:opacity .3s, filter .3s; } .veil .under{ opacity:.28; filter:blur(2px); }\n  .lite .sheet{ box-shadow:0 22px 50px rgba(20,20,40,.18); }\n  .sheet h1{ font-size:30px; font-weight:800; letter-spacing:-.02em; }\n  .sheet p{ font-size:13.5px; line-height:1.4; opacity:.72; margin-top:6px; }\n  .kick{ font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; opacity:.62; }\n  .big{ font-size:64px; font-weight:800; line-height:1.05; letter-spacing:-.03em; font-variant-numeric:tabular-nums; margin-top:4px; }\n  .big small{ display:block; font-size:12px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.6; margin-top:2px; }\n  .best{ display:inline-block; margin-top:10px; font-size:11.5px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; opacity:.7; }\n  .best.new{ opacity:1; color:#0b0b10; background:#ffd60a; border-radius:99px; padding:5px 11px; }\n  .sheet .act{ width:100%; height:50px; border-radius:99px; margin-top:10px; font-size:16px; font-weight:750;\n    display:flex; align-items:center; justify-content:center; gap:8px; }\n  .sheet .act:first-of-type{ margin-top:18px; }\n  .sheet .act:active, .rnd:active{ transform:scale(.96); }\n  .pri{ border:none; background:#fff; color:#0b0b10; box-shadow:0 10px 30px rgba(0,0,0,.3); }\n  .lite .pri{ background:#15151a; color:#fff; box-shadow:0 10px 26px rgba(20,20,40,.22); }\n\n  @media (max-height:430px){\n    .sheet{ padding:14px 18px 14px; } .sheet h1{ font-size:24px; } .big{ font-size:42px; }\n    .sheet .act{ height:44px; margin-top:8px; } .sheet .act:first-of-type{ margin-top:12px; } .sheet p{ display:none; }\n    .wrap{ margin:6px 0 26px; }\n  }\n  @media (prefers-reduced-motion:reduce){ .pill.bump{ animation:none; } .stage{ transition:none; } }\n\n  canvas{ display:block; position:relative; z-index:1; border-radius:22px; background:rgba(10,10,16,.42); border:1px solid rgba(255,255,255,.12);\n    box-shadow:0 24px 60px rgba(0,0,0,.45); touch-action:none; transition:background .6s, box-shadow .6s; flex-shrink:0; }\n  .lite canvas{ background:rgba(255,255,255,.6); border-color:rgba(0,0,0,.06); box-shadow:0 22px 50px rgba(20,20,40,.16); }\n  canvas.shake{ animation:shake .4s ease; }\n  @keyframes shake{ 20%{ transform:translate(-7px,2px); } 40%{ transform:translate(6px,-2px); } 60%{ transform:translate(-4px,1px); } 80%{ transform:translate(2px,0); } }\n  .mid{ display:flex; flex-direction:column; align-items:center; gap:5px; }\n  .lives{ display:flex; gap:4px; font-size:11px; height:14px; color:#ff5d73; }\n  .lives svg.off{ opacity:.22; color:inherit; filter:grayscale(1); }\n  .lives.hide{ visibility:hidden; }\n  @media (prefers-reduced-motion:reduce){ canvas.shake{ animation:none; } }\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-play\" viewBox=\"0 0 24 24\"><path d=\"M8 5.5v13a1 1 0 0 0 1.52.85l10.4-6.5a1 1 0 0 0 0-1.7L9.52 4.65A1 1 0 0 0 8 5.5z\"/></symbol>\n  <symbol id=\"i-pause\" viewBox=\"0 0 24 24\"><rect x=\"6\" y=\"5\" width=\"4.2\" height=\"14\" rx=\"1.4\"/><rect x=\"13.8\" y=\"5\" width=\"4.2\" height=\"14\" rx=\"1.4\"/></symbol>\n  <symbol id=\"i-again\" viewBox=\"0 0 24 24\"><path d=\"M12 5V2.6a.6.6 0 0 0-1-.45L7.2 5.55a.6.6 0 0 0 0 .9L11 9.85a.6.6 0 0 0 1-.45V7a5.5 5.5 0 1 1-5.5 5.5 1 1 0 0 0-2 0A7.5 7.5 0 1 0 12 5z\"/></symbol>\n  <symbol id=\"i-close\" viewBox=\"0 0 24 24\"><path d=\"M6.4 5a1 1 0 0 0-1.4 1.4L10.6 12 5 17.6A1 1 0 0 0 6.4 19l5.6-5.6 5.6 5.6a1 1 0 0 0 1.4-1.4L13.4 12 19 6.4A1 1 0 0 0 17.6 5L12 10.6z\"/></symbol>\n  <symbol id=\"i-heart\" viewBox=\"0 0 24 24\"><path d=\"M12 21.2l-1.3-1.2C5.4 15.2 2.5 12.5 2.5 9.1 2.5 6.4 4.6 4.3 7.3 4.3c1.8 0 3.6.9 4.7 2.4 1.1-1.5 2.9-2.4 4.7-2.4 2.7 0 4.8 2.1 4.8 4.8 0 3.4-2.9 6.1-8.2 10.9z\"/></symbol>\n</defs></svg>\n<div class=\"stage\" id=\"stage\">\n  <div class=\"bg d\"></div><div class=\"bg l\"></div>\n  <div class=\"col\">\n    <div class=\"top\">\n      <button class=\"glass rnd hide\" id=\"bPause\" aria-label=\"Pause\"><svg><use href=\"#i-pause\"/></svg></button>\n      <div class=\"mid\"><div class=\"lbl\">Brick Breaker</div><div class=\"lives hide\" id=\"lives\" aria-label=\"Lives\"></div></div>\n      <div class=\"glass pill hide\" id=\"pill\" aria-label=\"Score\">0</div>\n    </div>\n    <div class=\"wrap\" id=\"wrap\">\n      <canvas class=\"under\" id=\"cv\" width=\"320\" height=\"480\"></canvas>\n      <div class=\"sheet glass\" id=\"sheet\"></div>\n      <div class=\"foot\" id=\"foot\"></div>\n    </div>\n  </div>\n</div>\n<script>\nfunction el(i){ return document.getElementById(i); }\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction haptic(s){ if (window.myllmHaptic) try { myllmHaptic(s); } catch(_){} }\nfunction load(k){ var s = window.myllmStorage; return s ? s.getItem(k).catch(function(){ return null; }) : Promise.resolve(null); }\nfunction keep(k, v){ var s = window.myllmStorage; if (s) try { s.setItem(k, v).catch(function(){}); } catch(_){} }\nvar calm = window.matchMedia && matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n\n/* ---------- look ---------- */\nfunction isLight(){ return !(window.matchMedia && matchMedia(\"(prefers-color-scheme: dark)\").matches); }\n/* A game in progress takes the whole display and goes dark. Where MyLLM can't\n   hide its own title bar, a dark stage under a white bar looks cut in half —\n   so in light mode, without myllmImmersive, the stage stays light. */\nfunction syncLook(){\n  el(\"stage\").classList.toggle(\"lite\", isLight() && !(state !== \"home\" && window.myllmImmersive));\n  if (typeof onLook === \"function\") onLook();\n}\nfunction syncChrome(){\n  if (!window.myllmImmersive) return;\n  try { myllmImmersive(state !== \"home\", {keepAwake:false}).catch(function(){}); } catch(_){}\n}\nfunction setHue(h){ el(\"stage\").style.setProperty(\"--h\", String(h)); }\nfunction showSheet(html, acts){\n  var s = el(\"sheet\"); s.innerHTML = html;\n  Object.keys(acts).forEach(function(id){ var b = el(id); if (b) b.onclick = acts[id]; });\n  s.classList.add(\"on\"); el(\"stage\").classList.add(\"veil\");\n}\nfunction hideSheet(){ el(\"sheet\").classList.remove(\"on\"); el(\"stage\").classList.remove(\"veil\"); }\nfunction bump(id){ var p = el(id); p.classList.remove(\"bump\"); void p.offsetWidth; p.classList.add(\"bump\"); }\ndocument.addEventListener(\"visibilitychange\", function(){\n  if (document.hidden){ if (typeof onHide === \"function\") onHide(); return; }\n  if (state !== \"home\") syncChrome();          /* MyLLM puts its bars back when the app is left */\n});\nif (window.matchMedia){\n  var mq = matchMedia(\"(prefers-color-scheme: dark)\");\n  if (mq.addEventListener) mq.addEventListener(\"change\", syncLook); else if (mq.addListener) mq.addListener(syncLook);\n}\n\nvar state = \"home\";                 /* home · play · over */\nvar paused = false;\nvar cv = el(\"cv\"), ctx = cv.getContext(\"2d\"), DPR = 1, SC = 1;\n/* The playfield is a fixed logical size, exactly what the app has always used\n   on a phone held upright; only the drawing is scaled to the screen, so the\n   ball, the paddle and the pace are the same on every display. */\nvar W = Math.min(Math.min(window.innerWidth, window.innerHeight) - 20, 420), H = Math.round(W * 1.5);\nvar paddle, ball, bricks, score = 0, lives = 3, level = 1, best = 0, best0 = 0, newBest = false, launched = false;\nvar COLS = 7, ROWS = 5, GAP = 6, TOP = 54, trail = [];\nvar STEP = 1000 / 60, acc = 0, lastT = 0;      /* the game was tuned per frame at 60 Hz: keep that pace on faster screens */\n\nfunction reset(full){\n  if (full){ score = 0; lives = 3; level = 1; }\n  var bw = (W - GAP * (COLS + 1)) / COLS, bh = 20;\n  bricks = [];\n  for (var r = 0; r < ROWS; r++) for (var c = 0; c < COLS; c++) bricks.push({x:GAP + c * (bw + GAP), y:TOP + r * (bh + GAP), w:bw, h:bh, r:r, alive:true});\n  paddle = {w:Math.max(64, W * 0.22), h:12, x:W / 2};\n  var spd = 2.6 + level * 0.35;\n  ball = {x:W / 2, y:H - 60, r:7, vx:0, vy:0, spd:spd};\n  launched = false; trail = [];\n}\nfunction launch(){\n  if (launched) return;\n  var a = (-Math.PI / 2) + (Math.random() * 0.5 - 0.25);\n  ball.vx = Math.cos(a) * ball.spd; ball.vy = Math.sin(a) * ball.spd; launched = true; tip();\n}\nfunction step(){\n  if (!launched){ ball.x = paddle.x; ball.y = H - 60; return; }\n  ball.x += ball.vx; ball.y += ball.vy;\n  if (ball.x < ball.r){ ball.x = ball.r; ball.vx *= -1; }\n  if (ball.x > W - ball.r){ ball.x = W - ball.r; ball.vx *= -1; }\n  if (ball.y < ball.r){ ball.y = ball.r; ball.vy *= -1; }\n  var py = H - 28;\n  if (ball.vy > 0 && ball.y + ball.r >= py && ball.y + ball.r <= py + paddle.h + 8 && Math.abs(ball.x - paddle.x) < paddle.w / 2 + ball.r){\n    var hit = (ball.x - paddle.x) / (paddle.w / 2), ang = -Math.PI / 2 + hit * 1.0;\n    ball.vx = Math.cos(ang) * ball.spd; ball.vy = Math.sin(ang) * ball.spd; ball.y = py - ball.r;\n    haptic(\"light\");\n  }\n  for (var i = 0; i < bricks.length; i++){\n    var b = bricks[i]; if (!b.alive) continue;\n    if (ball.x + ball.r > b.x && ball.x - ball.r < b.x + b.w && ball.y + ball.r > b.y && ball.y - ball.r < b.y + b.h){\n      b.alive = false; b.t0 = performance.now(); score += 10 * level; el(\"pill\").textContent = score; bump(\"pill\");\n      var ox = Math.min(ball.x - b.x, b.x + b.w - ball.x), oy = Math.min(ball.y - b.y, b.y + b.h - ball.y);\n      if (ox < oy) ball.vx *= -1; else ball.vy *= -1;\n      haptic(\"selection\");\n      break;\n    }\n  }\n  if (!bricks.some(function(b){ return b.alive; })){ level++; reset(false); setHue(258 + (level - 1) * 24); tip(\"Level \" + level + \" — tap to launch\"); }\n  if (ball.y - ball.r > H){\n    lives--; hearts(); launched = false; ball.x = paddle.x; ball.y = H - 60; trail = [];\n    haptic(\"error\");\n    if (!calm){ cv.classList.remove(\"shake\"); void cv.offsetWidth; cv.classList.add(\"shake\"); }\n    if (lives <= 0) gameOver(); else tip();\n  }\n}\nfunction gameOver(){\n  state = \"over\";\n  if (score > best){ best = score; keep(\"bbBest\", String(best)); }\n  newBest = score > best0 && score > 0;\n  hud();\n  setTimeout(function(){ if (state === \"over\") card(\"over\"); }, 650);\n}\n\n/* ---------- drawing ---------- */\nfunction rr(x, y, w, h, r){ ctx.beginPath(); ctx.moveTo(x + r, y); ctx.arcTo(x + w, y, x + w, y + h, r); ctx.arcTo(x + w, y + h, x, y + h, r); ctx.arcTo(x, y + h, x, y, r); ctx.arcTo(x, y, x + w, y, r); ctx.closePath(); }\nfunction draw(now){\n  var L = el(\"stage\").classList.contains(\"lite\"), base = 258 + (level - 1) * 24;\n  ctx.setTransform(DPR * SC, 0, 0, DPR * SC, 0, 0);\n  ctx.clearRect(0, 0, W, H);\n  bricks.forEach(function(b){\n    var hue = base + b.r * 22;\n    if (!b.alive){                                   /* a broken brick fades and lifts away */\n      var k = b.t0 ? (now - b.t0) / 260 : 1; if (k >= 1 || calm) return;\n      ctx.globalAlpha = 1 - k; ctx.fillStyle = \"hsl(\" + hue + \" 90% 78%)\"; rr(b.x - 3 * k, b.y - 5 * k, b.w + 6 * k, b.h, 6); ctx.fill(); ctx.globalAlpha = 1; return;\n    }\n    var g = ctx.createLinearGradient(0, b.y, 0, b.y + b.h);\n    g.addColorStop(0, \"hsl(\" + hue + \" 85% \" + (L ? 64 : 70) + \"%)\"); g.addColorStop(1, \"hsl(\" + (hue + 14) + \" 80% \" + (L ? 50 : 54) + \"%)\");\n    ctx.fillStyle = g; rr(b.x, b.y, b.w, b.h, 6); ctx.fill();\n    ctx.fillStyle = \"rgba(255,255,255,.3)\"; rr(b.x + 3, b.y + 2, b.w - 6, 2.5, 1.2); ctx.fill();\n  });\n  var ink = L ? \"#15151a\" : \"#fff\";\n  ctx.save(); ctx.shadowColor = L ? \"rgba(20,20,40,.25)\" : \"hsla(\" + base + \",90%,70%,.7)\"; ctx.shadowBlur = 14;\n  ctx.fillStyle = ink; rr(paddle.x - paddle.w / 2, H - 28, paddle.w, paddle.h, 6); ctx.fill(); ctx.restore();\n  for (var i = 0; i < trail.length; i++){\n    ctx.globalAlpha = (i + 1) / trail.length * .22; ctx.fillStyle = L ? \"hsl(\" + base + \" 80% 45%)\" : \"hsl(\" + base + \" 95% 80%)\";\n    ctx.beginPath(); ctx.arc(trail[i].x, trail[i].y, ball.r * (.5 + .5 * (i + 1) / trail.length), 0, 7); ctx.fill();\n  }\n  ctx.globalAlpha = 1;\n  ctx.save(); ctx.shadowColor = L ? \"rgba(20,20,40,.3)\" : \"hsla(\" + base + \",95%,75%,.9)\"; ctx.shadowBlur = 16;\n  ctx.fillStyle = ink; ctx.beginPath(); ctx.arc(ball.x, ball.y, ball.r, 0, Math.PI * 2); ctx.fill(); ctx.restore();\n}\nfunction frame(now){\n  requestAnimationFrame(frame);\n  var dt = Math.min(100, now - (lastT || now)); lastT = now;\n  if (state === \"play\" && !paused){\n    acc += dt;\n    while (acc >= STEP && state === \"play\"){\n      acc -= STEP; step();\n      if (launched && !calm){ trail.push({x:ball.x, y:ball.y}); if (trail.length > 7) trail.shift(); }\n    }\n  } else acc = 0;\n  draw(now);\n}\nfunction fit(){\n  var w = el(\"wrap\");\n  SC = Math.max(.4, Math.min(w.clientWidth / W, w.clientHeight / H, 1.7));\n  DPR = Math.min(window.devicePixelRatio || 1, 3);\n  var cw = Math.floor(W * SC), ch = Math.floor(H * SC);\n  SC = cw / W;\n  cv.style.width = cw + \"px\"; cv.style.height = ch + \"px\"; cv.width = Math.round(cw * DPR); cv.height = Math.round(ch * DPR);\n  var st = el(\"stage\").style; st.setProperty(\"--b\", cw + \"px\"); st.setProperty(\"--bh\", ch + \"px\");\n}\n\n/* ---------- the glass card + HUD ---------- */\nfunction bestLine(){\n  if (newBest) return '<div class=\"best new\">New best</div>';\n  return best ? '<div class=\"best\">Best ' + best + '</div>' : \"\";\n}\nfunction card(kind){\n  var h;\n  if (kind === \"home\") h = '<h1>Brick Breaker</h1><p>Drag anywhere to move the paddle, tap to launch. Three lives — every level is faster.</p>' + bestLine() +\n    '<button class=\"act pri\" id=\"sB\"><svg><use href=\"#i-play\"/></svg>Play</button>';\n  else if (kind === \"pause\") h = '<div class=\"kick\">Paused · level ' + level + '</div><div class=\"big\">' + score + '</div>' +\n    '<button class=\"act pri\" id=\"sA\"><svg><use href=\"#i-play\"/></svg>Resume</button><button class=\"act glass\" id=\"sC\">End game</button>';\n  else h = '<div class=\"kick\">Game over · level ' + level + '</div><div class=\"big\">' + score + '</div>' + bestLine() +\n    '<button class=\"act pri\" id=\"sB\"><svg><use href=\"#i-again\"/></svg>Play again</button><button class=\"act glass\" id=\"sC\">Done</button>';\n  showSheet(h, {sA:resume, sB:begin, sC:goHome});\n}\nfunction hearts(){\n  var h = \"\"; for (var i = 0; i < 3; i++) h += '<svg' + (i < lives ? \"\" : ' class=\"off\"') + '><use href=\"#i-heart\"/></svg>';\n  el(\"lives\").innerHTML = h;\n}\nfunction tip(t){\n  el(\"foot\").textContent = state === \"home\" ? \"\" : (t || (launched ? \"Level \" + level + (best ? \" · best \" + best : \"\") : \"Drag to move · tap to launch\"));\n}\nfunction hud(){\n  var playing = state !== \"home\";\n  el(\"bPause\").classList.toggle(\"hide\", state !== \"play\" || paused);\n  el(\"pill\").classList.toggle(\"hide\", !playing || paused);\n  el(\"lives\").classList.toggle(\"hide\", !playing);\n  el(\"pill\").textContent = score; hearts(); tip();\n}\nfunction begin(){\n  haptic(\"medium\");\n  reset(true); best0 = best; newBest = false; paused = false; state = \"play\"; setHue(258);\n  hideSheet(); hud(); syncLook(); syncChrome();\n}\nfunction pause(){ if (state !== \"play\" || paused) return; paused = true; card(\"pause\"); hud(); }\nfunction resume(){ if (!paused) return; haptic(\"light\"); paused = false; hideSheet(); hud(); syncChrome(); }\nfunction goHome(){\n  haptic(\"light\");\n  state = \"home\"; paused = false; newBest = false; level = 1; reset(true); setHue(258);\n  card(\"home\"); hud(); syncLook(); syncChrome();\n}\nfunction onHide(){ pause(); }\n\n/* ---------- input: the whole screen is the paddle's rail ---------- */\nfunction toField(e){ var r = cv.getBoundingClientRect(); return (e.clientX - r.left) / SC; }\ndocument.addEventListener(\"pointerdown\", function(e){\n  if (e.target.closest && e.target.closest(\"button\")) return;\n  if (state === \"play\" && !paused) launch();\n});\ndocument.addEventListener(\"pointermove\", function(e){\n  if (state !== \"play\" || paused) return;\n  if (e.pointerType === \"mouse\" && !e.buttons) return;\n  paddle.x = Math.max(paddle.w / 2, Math.min(W - paddle.w / 2, toField(e)));\n});\ndocument.addEventListener(\"keydown\", function(e){\n  if (e.key === \" \" || e.key === \"Escape\" || e.key === \"p\"){ if (paused) resume(); else pause(); e.preventDefault(); }\n  else if (e.key === \"Enter\" && state !== \"play\") begin();\n  else if (e.key === \"ArrowUp\" && state === \"play\" && !paused) launch();\n  else if ((e.key === \"ArrowLeft\" || e.key === \"ArrowRight\") && state === \"play\" && !paused)\n    paddle.x = Math.max(paddle.w / 2, Math.min(W - paddle.w / 2, paddle.x + (e.key === \"ArrowLeft\" ? -26 : 26)));\n});\nel(\"bPause\").onclick = function(){ haptic(\"light\"); pause(); };\nwindow.addEventListener(\"resize\", fit);\n\n/* ---------- boot ---------- */\nreset(true); fit(); syncLook(); card(\"home\"); hud();\nrequestAnimationFrame(frame);\nload(\"bbBest\").then(function(v){ best = +v || 0; if (state === \"home\") card(\"home\"); hud(); });\n</script></body></html>\n", "kind": "html", "iconSymbol": "gamecontroller.fill", "iconColor": "purple"}