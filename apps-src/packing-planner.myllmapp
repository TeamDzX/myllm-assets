{"name": "Packing Planner", "kind": "html", "iconSymbol": "suitcase.fill", "iconColor": "orange", "html": "<!doctype html>\n<!--\n  Packing Planner — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Packing Planner</title>\n<style>\n  :root{ color-scheme:light dark;\n    --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n    --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n    --h:30; }\n  @media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n    --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); } }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:var(--bg); color:var(--ink); font-size:15.5px;\n    max-width:600px; margin:0 auto; min-height:100dvh;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(40px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left));\n  }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; } button:active{ transform:scale(.96); }\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 80% 54%), hsl(calc(var(--h) - 22) 72% 36%)); }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  .card{\n    background:var(--surface); border:1px solid var(--line);\n    border-radius:18px; padding:14px; margin-bottom:12px;\n  }\n  label{ display:block; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:14px 2px 7px; }\n  label:first-child{ margin-top:0; }\n  input, select{\n    width:100%; min-height:46px; font:inherit; font-size:16px; padding:11px 12px; border-radius:12px;\n    border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none;\n  }\n  input:focus{ border-color:var(--acc); }\n  input[type=date]{ -webkit-appearance:none; appearance:none; }\n  .row2{ display:flex; gap:10px; margin-top:14px; }\n  .row2 > div{ flex:1; min-width:0; }\n  .chips{ display:flex; flex-wrap:wrap; gap:7px; }\n  .chip{\n    min-height:38px; border:1px solid var(--line); background:var(--bg);\n    border-radius:99px; padding:0 14px; font-size:14px; font-weight:650;\n  }\n  .chip.on{ background:var(--acc); border-color:var(--acc); color:#fff; }\n  .go{\n    width:100%; min-height:52px; margin-top:16px; border:none; border-radius:14px; font-size:16.5px; font-weight:750;\n    background:var(--acc); color:#fff;\n  }\n  .go:disabled{ opacity:.55; }\n  .note{ font-size:13px; color:var(--muted); line-height:1.45; margin-top:8px; }\n  .note:empty{ display:none; }\n\n  /* trip hero: where you're going and how packed you are */\n  .hero{ border-radius:20px; padding:16px 18px; color:#fff; margin-bottom:12px;\n    background:linear-gradient(145deg, hsl(var(--h) 78% 50%), hsl(calc(var(--h) - 22) 72% 32%)); box-shadow:0 10px 28px hsl(var(--h) 70% 34% / .25); }\n  .hero .kick{ font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; opacity:.78; }\n  .phead{ display:flex; justify-content:space-between; align-items:flex-end; gap:12px; margin-top:4px; }\n  .phead b{ font-size:24px; font-weight:800; line-height:1.15; letter-spacing:-.02em; min-width:0; overflow-wrap:anywhere; }\n  .phead span{ font-size:13px; font-weight:700; opacity:.9; white-space:nowrap; font-variant-numeric:tabular-nums; padding-bottom:3px; }\n  .prog{ height:8px; border-radius:99px; background:rgba(255,255,255,.22); overflow:hidden; margin:12px 0 2px; }\n  .prog div{ height:100%; border-radius:99px; background:#fff; transition:width .25s cubic-bezier(.2,.8,.2,1); }\n  .prog.full div{ background:#b9ffcf; }\n\n  /* weather strip */\n  .wx{ display:flex; gap:6px; overflow-x:auto; padding-bottom:4px; scrollbar-width:none; margin:0 -14px; padding-left:14px; padding-right:14px; }\n  .wx::-webkit-scrollbar{ display:none; }\n  .day{\n    min-width:64px; text-align:center; background:var(--bg);\n    border-radius:12px; padding:8px 4px;\n  }\n  .day small{ display:block; font-size:10.5px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; color:var(--muted); }\n  .day .i{ font-size:20px; line-height:1.5; }\n  .day b{ font-size:12.5px; font-weight:700; font-variant-numeric:tabular-nums; }\n  .day i{ font-style:normal; font-size:11px; color:var(--muted); font-variant-numeric:tabular-nums; }\n  .wxhead{ display:flex; justify-content:space-between; align-items:baseline; margin-bottom:10px; gap:10px; }\n  .wxhead b{ font-size:15px; font-weight:750; }\n  .wxhead span{ font-size:12px; color:var(--muted); }\n\n  /* checklist */\n  .grp{ margin-top:16px; break-inside:avoid; }\n  .grp:first-child{ margin-top:0; }\n  .grp > b{ display:block; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:0 2px 4px; }\n  .it{\n    display:flex; align-items:center; gap:11px; min-height:46px; padding:6px 2px;\n    border-bottom:1px solid var(--line); font-size:15.5px; line-height:1.3;\n  }\n  .it:last-child{ border-bottom:none; }\n  .it > span{ flex:1; min-width:0; overflow-wrap:anywhere; }\n  .it .box{\n    width:24px; height:24px; border-radius:8px; border:2px solid var(--myllm-border,#c9c9cf);\n    display:flex; align-items:center; justify-content:center; color:#fff; font-size:12px; flex-shrink:0; transition:background .15s, border-color .15s;\n  }\n  .it .box svg{ opacity:0; }\n  .it.on .box{ background:#30d158; border-color:#30d158; }\n  .it.on .box svg{ opacity:1; }\n  .it.on > span{ text-decoration:line-through; color:var(--muted); }\n  .it .rm{ width:44px; height:44px; margin:-4px -10px -4px 0; border:none; background:none; color:var(--muted); font-size:13px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }\n  .addrow{ display:flex; gap:8px; margin-top:14px; }\n  .addrow input{ flex:1; min-width:0; }\n  .addrow button{\n    border:none; border-radius:12px; padding:0 18px; font-size:15px; font-weight:700;\n    background:var(--acc); color:#fff;\n  }\n  .toolrow{ display:flex; gap:8px; margin-top:10px; }\n  .toolrow button{\n    flex:1; min-width:0; min-height:44px; border:1px solid var(--line); border-radius:12px; padding:0 6px;\n    font-size:13.5px; font-weight:650; background:var(--bg);\n    display:flex; align-items:center; justify-content:center; gap:6px; white-space:nowrap;\n  }\n  @media (max-width:350px){ .toolrow button svg{ display:none; } }\n  @media (min-width:768px){ body{ max-width:820px; } #groups{ columns:2; column-gap:28px; } .grp:first-child{ margin-top:0; } }\n  @media (prefers-reduced-motion:reduce){ button:active{ transform:none; } .prog div{ transition:none; } }\n</style>\n<style>:root{--build-id:\"04941c4462\";}</style>\n</head>\n<body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-case\" viewBox=\"0 0 24 24\"><path d=\"M9 3a2 2 0 0 0-2 2v2H5a3 3 0 0 0-3 3v8a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3v-8a3 3 0 0 0-3-3h-2V5a2 2 0 0 0-2-2zm0 2h6v2H9z\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M9.6 18.4a1.5 1.5 0 0 1-1.08-.46l-4.6-4.7a1.5 1.5 0 1 1 2.16-2.1l3.5 3.6 8.32-8.7a1.5 1.5 0 0 1 2.16 2.08l-9.38 9.8a1.5 1.5 0 0 1-1.08.48z\"/></symbol>\n  <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M6.4 5a1 1 0 0 0-1.4 1.4L10.6 12 5 17.6A1 1 0 0 0 6.4 19l5.6-5.6 5.6 5.6a1 1 0 0 0 1.4-1.4L13.4 12 19 6.4A1 1 0 0 0 17.6 5L12 10.6z\"/></symbol>\n  <symbol id=\"i-share\" viewBox=\"0 0 24 24\"><path d=\"M12 2.6a1 1 0 0 0-.7.3L7.8 6.4a1 1 0 0 0 1.4 1.4L11 6v8.5a1 1 0 0 0 2 0V6l1.8 1.8a1 1 0 0 0 1.4-1.4l-3.5-3.5a1 1 0 0 0-.7-.3zM6 10a3 3 0 0 0-3 3v5a3 3 0 0 0 3 3h12a3 3 0 0 0 3-3v-5a3 3 0 0 0-3-3h-1a1 1 0 0 0 0 2h1a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-5a1 1 0 0 1 1-1h1a1 1 0 0 0 0-2z\"/></symbol>\n  <symbol id=\"i-again\" viewBox=\"0 0 24 24\"><path d=\"M12 5V2.6a.6.6 0 0 0-1-.45L7.2 5.55a.6.6 0 0 0 0 .9L11 9.85a.6.6 0 0 0 1-.45V7a5.5 5.5 0 1 1-5.5 5.5 1 1 0 0 0-2 0A7.5 7.5 0 1 0 12 5z\"/></symbol>\n  <symbol id=\"i-plus\" viewBox=\"0 0 24 24\"><path d=\"M12 4a1 1 0 0 0-1 1v6H5a1 1 0 0 0 0 2h6v6a1 1 0 0 0 2 0v-6h6a1 1 0 0 0 0-2h-6V5a1 1 0 0 0-1-1z\"/></symbol>\n</defs></svg>\n\n<div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-case\"/></svg></div>\n  <div><h1>Packing Planner</h1><p>Never forget the charger</p></div>\n</div>\n\n\n<div class=\"card\" id=\"form\">\n  <label>Where to?</label>\n  <input id=\"dest\" placeholder=\"Lisbon, Tokyo, Lake District…\" autocomplete=\"off\">\n  <div class=\"row2\">\n    <div><label>First day</label><input id=\"start\" type=\"date\"></div>\n    <div><label>Nights</label><input id=\"nights\" inputmode=\"numeric\" value=\"4\"></div>\n  </div>\n  <label>Trip type</label>\n  <div class=\"chips\" id=\"types\"></div>\n  <button class=\"go\" id=\"goBtn\" onclick=\"plan()\">Pack for this trip</button>\n  <p class=\"note\" id=\"formNote\"></p>\n</div>\n\n<div class=\"hero\" id=\"hero\" style=\"display:none\">\n  <div class=\"kick\" id=\"herokick\"></div>\n  <div class=\"phead\"><b id=\"listtitle\">Your list</b><span id=\"listcount\"></span></div>\n  <div class=\"prog\" id=\"prog\"><div id=\"progfill\" style=\"width:0%\"></div></div>\n</div>\n\n<div class=\"card\" id=\"wxcard\" style=\"display:none\">\n  <div class=\"wxhead\"><b id=\"wxplace\"></b><span id=\"wxsum\"></span></div>\n  <div class=\"wx\" id=\"wxdays\"></div>\n</div>\n\n<div class=\"card\" id=\"listcard\" style=\"display:none\">\n  <div id=\"groups\"></div>\n  <div class=\"addrow\">\n    <input id=\"newitem\" placeholder=\"Add your own item…\" enterkeyhint=\"done\" onkeydown=\"if(event.key==='Enter')addItem()\">\n    <button onclick=\"addItem()\">Add</button>\n  </div>\n  <div class=\"toolrow\">\n    <button onclick=\"shareList()\"><svg class=\"i\"><use href=\"#i-share\"/></svg>Share</button>\n    <button onclick=\"untickAll()\"><svg class=\"i\"><use href=\"#i-again\"/></svg>Untick all</button>\n    <button onclick=\"newTrip()\"><svg class=\"i\"><use href=\"#i-plus\"/></svg>New trip</button>\n  </div>\n</div>\n\n<!-- AI thinking pill (house convention) -->\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n<script>\nfunction myllmAiWrap(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\">⚙️</span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};}\nmyllmAiWrap();\n</script>\n\n<script>\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nvar store = {\n  getItem:function(k){ var s = window.myllmStorage; return s ? s.getItem(k).catch(function(){ return null; }) : Promise.resolve(null); },\n  setItem:function(k, v){ var s = window.myllmStorage; if (s) try { s.setItem(k, v).catch(function(){}); } catch(_){} }\n};\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction NET(u, o){ return window.myllmFetch(u, o); }\nfunction ASK(p, o){ myllmAiWrap(); return window.myllmAsk(p, o); }\n\nvar TYPES = [\n  {id:\"city\",     name:\"🏙️ City break\"},\n  {id:\"beach\",    name:\"🏖️ Beach\"},\n  {id:\"hiking\",   name:\"🥾 Hiking\"},\n  {id:\"business\", name:\"💼 Business\"},\n  {id:\"winter\",   name:\"⛷️ Winter\"},\n  {id:\"family\",   name:\"👨‍👩‍👧 Family\"}\n];\nvar WMOJI = [[0,\"☀️\"],[1,\"🌤️\"],[2,\"⛅\"],[3,\"☁️\"],[45,\"🌫️\"],[51,\"🌦️\"],[61,\"🌧️\"],[71,\"🌨️\"],[80,\"🌧️\"],[95,\"⛈️\"]];\nfunction wicon(code){\n  var best=\"☁️\";\n  for (var i=0;i<WMOJI.length;i++){ if (code >= WMOJI[i][0]) best = WMOJI[i][1]; }\n  return best;\n}\n\nvar trip = null;   // {dest, place, start, nights, type, wx:[{date,tmax,tmin,rain,code}]|null, groups:[{name,items:[{t,qty,on}]}]}\nvar picked = \"city\";\n\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\"); }\nfunction save(){ store.setItem(\"trip\", trip ? JSON.stringify(trip) : \"\"); }\n\nfunction renderTypes(){\n  el(\"types\").innerHTML = TYPES.map(function(t){\n    return '<button class=\"chip'+(picked===t.id?' on':'')+'\" onclick=\"pickType(\\''+t.id+'\\')\">'+t.name+'</button>';\n  }).join(\"\");\n}\nfunction pickType(id){ picked = id; haptic(\"selection\"); renderTypes(); }\n\n/* ---------- deterministic packing engine ---------- */\nfunction baseList(type, nights, wx){\n  var socks = Math.min(nights + 1, 8);\n  var tops  = Math.min(Math.ceil(nights * 0.8) + 1, 7);\n  var g = [];\n  g.push({name:\"Essentials\", items:[\n    \"Passport / ID\", \"Phone + charger\", \"Bank cards & some cash\", \"Tickets & bookings\",\n    \"Medication\", \"Toothbrush & toiletries\", \"Deodorant\"\n  ]});\n  g.push({name:\"Clothes\", items:[\n    socks + \"× socks\", socks + \"× underwear\", tops + \"× tops\",\n    \"2× trousers/shorts\", \"Comfortable shoes\", \"Sleepwear\", \"Light jacket\"\n  ]});\n  if (type === \"beach\") g.push({name:\"Beach\", items:[\n    \"Swimwear ×2\", \"Beach towel\", \"Sunglasses\", \"Sun hat\", \"Sunscreen\", \"Flip-flops\", \"Beach bag\", \"Book / e-reader\"\n  ]});\n  if (type === \"hiking\") g.push({name:\"Hiking\", items:[\n    \"Hiking boots (wear on travel day)\", \"Daypack\", \"Water bottle\", \"Blister plasters\",\n    \"Waterproof jacket\", \"Hiking socks\", \"Map / offline maps downloaded\", \"Snacks / trail bars\", \"Head torch\"\n  ]});\n  if (type === \"business\") g.push({name:\"Business\", items:[\n    \"Laptop + charger\", \"Smart outfit ×\" + Math.min(nights, 3), \"Smart shoes\", \"Notebook & pen\", \"Business cards\", \"Presentation on a USB backup\"\n  ]});\n  if (type === \"winter\") g.push({name:\"Winter\", items:[\n    \"Ski jacket & trousers\", \"Thermal base layers ×2\", \"Gloves\", \"Warm hat\", \"Ski socks ×\" + Math.min(nights, 5), \"Goggles\", \"Lip balm & high-SPF sunscreen\", \"Swimwear (spa/pool)\"\n  ]});\n  if (type === \"family\") g.push({name:\"Family\", items:[\n    \"Kids' clothes (a spare set per day)\", \"Favourite toy / comforter\", \"Snacks for the journey\", \"Wet wipes\", \"Tablet + downloads\", \"Kids' medicine\", \"Pushchair / carrier\"\n  ]});\n  if (type === \"city\") g.push({name:\"City\", items:[\n    \"Day bag\", \"Comfortable walking shoes\", \"Power bank\", \"One smarter outfit\", \"Reusable water bottle\"\n  ]});\n\n  /* weather-driven adds */\n  if (wx && wx.length){\n    var adds = [];\n    var maxT = Math.max.apply(null, wx.map(function(d){return d.tmax;}));\n    var minT = Math.min.apply(null, wx.map(function(d){return d.tmin;}));\n    var wet  = Math.max.apply(null, wx.map(function(d){return d.rain;}));\n    if (wet >= 40) adds.push(\"Umbrella or rain jacket\");\n    if (minT < 8)  adds.push(\"Warm layers (it drops to \" + Math.round(minT) + \"°C)\");\n    if (maxT >= 24){ adds.push(\"Sunscreen\"); adds.push(\"Sunglasses\"); }\n    if (maxT >= 29) adds.push(\"Refillable water bottle (it hits \" + Math.round(maxT) + \"°C)\");\n    if (adds.length) g.push({name:\"For the forecast\", items:adds});\n  }\n  return g.map(function(grp){\n    return {name:grp.name, items:grp.items.map(function(t){ return {t:t, on:false}; })};\n  });\n}\n\n/* ---------- plan flow ---------- */\nfunction plan(){\n  var dest = el(\"dest\").value.trim();\n  var start = el(\"start\").value;\n  var nights = parseInt(el(\"nights\").value, 10);\n  if (!dest){ el(\"formNote\").textContent = \"Where are you off to?\"; el(\"dest\").focus(); return; }\n  if (!start){ el(\"formNote\").textContent = \"Pick your first day.\"; return; }\n  if (!(nights > 0)) nights = 3;\n  haptic(\"light\");\n  el(\"goBtn\").disabled = true;\n  el(\"formNote\").textContent = window.myllmFetch ? \"Checking the forecast…\" : \"\";\n\n  lookupWeather(dest, start, nights).then(function(res){\n    trip = {\n      dest: dest, place: res.place || dest, start: start, nights: nights, type: picked,\n      wx: res.days, groups: baseList(picked, nights, res.days)\n    };\n    save(); render();\n    el(\"goBtn\").disabled = false;\n    el(\"formNote\").textContent = res.msg || \"\";\n    haptic(\"success\");\n    try{ el(\"hero\").scrollIntoView({behavior:\"smooth\", block:\"start\"}); }catch(_){}   /* the list lands below the form: bring it into view */\n    smartExtras();\n  });\n}\n\nfunction lookupWeather(dest, start, nights){\n  if (!window.myllmFetch) return Promise.resolve({days:null, msg:\"Weather needs network access — list built from trip type.\"});\n  var lead = Math.round((new Date(start + \"T12:00:00\") - new Date()) / 86400000);\n  if (lead > 14) return Promise.resolve({days:null, msg:\"Too far ahead for a forecast — I'll add weather items when it's closer.\"});\n  var gurl = \"https://geocoding-api.open-meteo.com/v1/search?count=1&name=\" + encodeURIComponent(dest);\n  return NET(gurl).then(function(r){\n    var j = JSON.parse(r.body);\n    if (!j.results || !j.results.length) throw new Error(\"no place\");\n    var p = j.results[0];\n    var days = Math.min(lead + nights + 1, 16);\n    var furl = \"https://api.open-meteo.com/v1/forecast?latitude=\" + p.latitude + \"&longitude=\" + p.longitude +\n      \"&daily=temperature_2m_max,temperature_2m_min,precipitation_probability_max,weather_code&forecast_days=\" + days + \"&timezone=auto\";\n    return NET(furl).then(function(fr){\n      var f = JSON.parse(fr.body).daily;\n      var out = [];\n      for (var i = 0; i < f.time.length; i++){\n        if (f.time[i] < start) continue;\n        out.push({date:f.time[i], tmax:f.temperature_2m_max[i], tmin:f.temperature_2m_min[i],\n                  rain:f.precipitation_probability_max[i] || 0, code:f.weather_code[i]});\n      }\n      var name = p.name + (p.country_code ? \", \" + p.country_code : \"\");\n      return {days:(out.length ? out : null), place:name};\n    });\n  }).catch(function(){\n    return {days:null, msg:\"Couldn't fetch the forecast — list built from trip type.\"};\n  });\n}\n\n/* AI extras appended as their own group (optional, graceful).\n   Labelled lines, not JSON — small models (Apple Intelligence) echo JSON\n   templates back verbatim. Echoed instructions are rejected and retried. */\nvar EXTRAS_ECHO = /destination-specific packing item|generic list would miss|repeat this line|labelled line/i;\nfunction parseExtras(reply){\n  var s = String(reply || \"\"), items = [], got = false;\n  s.split(/\\r?\\n/).forEach(function(raw){\n    var ln = raw.replace(/\\*\\*/g, \"\").trim();\n    var m = ln.match(/^[-*#>\\s]*(ITEMS?)\\s*\\d*\\s*[::]\\s*(.*)$/i);\n    if (!m) return;\n    got = true;\n    var v = m[2].trim();\n    if (v) items.push(v);\n  });\n  if (!got){ // model answered in the old JSON-array shape — accept it\n    var a = s.indexOf(\"[\"), b = s.lastIndexOf(\"]\");\n    if (a >= 0 && b > a){\n      try{\n        var j = JSON.parse(s.slice(a, b + 1));\n        if (Array.isArray(j)) items = j;\n      }catch(e){}\n    }\n  }\n  items = items.filter(function(x){\n    return typeof x === \"string\" && x.length > 1 && x.length < 90 && !EXTRAS_ECHO.test(x);\n  }).slice(0, 8);\n  if (!items.length) throw new Error(\"no usable extras\");\n  return items;\n}\nfunction smartExtras(){\n  if (!window.myllmAsk || !trip) return;\n  var wxs = trip.wx ? (\" Forecast: \" + Math.round(Math.min.apply(null, trip.wx.map(function(d){return d.tmin;}))) + \"–\" +\n    Math.round(Math.max.apply(null, trip.wx.map(function(d){return d.tmax;}))) + \"°C, max rain chance \" +\n    Math.round(Math.max.apply(null, trip.wx.map(function(d){return d.rain;}))) + \"%.\") : \"\";\n  var prompt = 'I\\'m going to ' + trip.place + ' for ' + trip.nights + ' nights (' + trip.type + ' trip), starting ' + trip.start + '.' + wxs +\n    ' List 4 to 6 destination-specific packing items a generic list would miss (think: plug adapter type, local etiquette, terrain, insects, payments). ' +\n    'Reply with EXACTLY these labelled lines and nothing else:\\n' +\n    'ITEM: one destination-specific packing item — repeat this line for each item';\n  var sys = {system:\"You suggest practical, destination-specific packing items. Output only the labelled lines requested.\"};\n  ASK(prompt, sys)\n    .then(function(r){ return parseExtras(r || \"\"); })\n    .catch(function(){\n      return ASK(prompt + '\\nIMPORTANT: fill each labelled line with real content — never repeat the instruction text.', sys)\n        .then(function(r){ return parseExtras(r || \"\"); });\n    })\n    .then(function(items){\n      if (!trip) return;\n      trip.groups = trip.groups.filter(function(g){ return g.name !== \"Smart extras ✨\"; });\n      trip.groups.push({name:\"Smart extras ✨\", items:items.map(function(t){ return {t:t, on:false}; })});\n      save(); render();\n    })\n    .catch(function(){});\n}\n\n/* ---------- render ---------- */\nfunction render(){\n  renderTypes();\n  if (!trip){\n    el(\"wxcard\").style.display = \"none\";\n    el(\"listcard\").style.display = \"none\";\n    el(\"hero\").style.display = \"none\";\n    return;\n  }\n  el(\"dest\").value = trip.dest;\n  el(\"start\").value = trip.start;\n  el(\"nights\").value = trip.nights;\n  picked = trip.type; renderTypes();\n\n  if (trip.wx && trip.wx.length){\n    el(\"wxcard\").style.display = \"block\";\n    el(\"wxplace\").textContent = trip.place;\n    el(\"wxsum\").textContent = \"your trip's forecast\";\n    el(\"wxdays\").innerHTML = trip.wx.map(function(d){\n      var dt = new Date(d.date + \"T12:00:00\");\n      var dow = [\"Sun\",\"Mon\",\"Tue\",\"Wed\",\"Thu\",\"Fri\",\"Sat\"][dt.getDay()];\n      return '<div class=\"day\"><small>' + dow + '</small><div class=\"i\">' + wicon(d.code) + '</div>' +\n        '<b>' + Math.round(d.tmax) + '°</b> <i>' + Math.round(d.tmin) + '°</i></div>';\n    }).join(\"\");\n  } else el(\"wxcard\").style.display = \"none\";\n\n  el(\"listcard\").style.display = \"block\";\n  el(\"hero\").style.display = \"block\";\n  var ty = TYPES.filter(function(t){ return t.id === trip.type; })[0];\n  el(\"herokick\").textContent = trip.nights + (trip.nights === 1 ? \" night\" : \" nights\") + (ty ? \" · \" + ty.name.replace(/^\\S+\\s/, \"\") : \"\");\n  el(\"listtitle\").textContent = \"Packing for \" + trip.place;\n  var total = 0, done = 0;\n  trip.groups.forEach(function(g){ g.items.forEach(function(it){ total++; if (it.on) done++; }); });\n  el(\"listcount\").textContent = done + \" / \" + total + \" packed\";\n  el(\"progfill\").style.width = (total ? Math.round(done / total * 100) : 0) + \"%\";\n  el(\"prog\").classList.toggle(\"full\", total > 0 && done === total);\n  el(\"groups\").innerHTML = trip.groups.map(function(g, gi){\n    return '<div class=\"grp\"><b>' + esc(g.name) + '</b>' + g.items.map(function(it, ii){\n      return '<div class=\"it' + (it.on ? ' on' : '') + '\" onclick=\"toggle(' + gi + ',' + ii + ')\">' +\n        '<div class=\"box\"><svg class=\"i\"><use href=\"#i-check\"/></svg></div><span>' + esc(it.t) + '</span>' +\n        '<button class=\"rm\" onclick=\"event.stopPropagation();removeItem(' + gi + ',' + ii + ')\" aria-label=\"Remove\"><svg class=\"i\"><use href=\"#i-x\"/></svg></button></div>';\n    }).join(\"\") + '</div>';\n  }).join(\"\");\n}\n\nfunction toggle(gi, ii){\n  var it = trip.groups[gi].items[ii];\n  it.on = !it.on;\n  haptic(it.on ? \"success\" : \"light\");\n  save(); render();\n}\nfunction removeItem(gi, ii){\n  trip.groups[gi].items.splice(ii, 1);\n  trip.groups = trip.groups.filter(function(g){ return g.items.length; });\n  haptic(\"light\"); save(); render();\n}\nfunction addItem(){\n  var v = el(\"newitem\").value.trim();\n  if (!v || !trip) return;\n  var mine = trip.groups.filter(function(g){ return g.name === \"My items\"; })[0];\n  if (!mine){ mine = {name:\"My items\", items:[]}; trip.groups.push(mine); }\n  mine.items.push({t:v, on:false});\n  el(\"newitem\").value = \"\";\n  haptic(\"success\"); save(); render();\n}\nfunction untickAll(){\n  trip.groups.forEach(function(g){ g.items.forEach(function(it){ it.on = false; }); });\n  haptic(\"light\"); save(); render();\n}\nfunction newTrip(){\n  trip = null; save(); render();\n  el(\"dest\").value = \"\"; el(\"formNote\").textContent = \"\";\n  haptic(\"light\");\n  window.scrollTo(0, 0);\n}\nfunction shareList(){\n  if (!trip) return;\n  var txt = \"Packing list — \" + trip.place + \" (\" + trip.nights + \" nights)\\n\\n\" +\n    trip.groups.map(function(g){\n      return g.name + \"\\n\" + g.items.map(function(it){ return (it.on ? \"☑ \" : \"☐ \") + it.t; }).join(\"\\n\");\n    }).join(\"\\n\\n\");\n  if (window.myllmShare){ try{ myllmShare({text:txt}); }catch(_){} }\n  haptic(\"light\");\n}\n\n/* ---------- boot ---------- */\nel(\"start\").value = new Date(Date.now() + 86400000 * 7).toISOString().slice(0, 10);\nrenderTypes();\nstore.getItem(\"trip\").then(function(v){\n  if (v){ try{ trip = JSON.parse(v) || null; }catch(e){} }\n  render();\n});\n</script>\n</body>\n</html>\n"}