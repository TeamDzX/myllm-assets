{"name": "Packing Planner", "kind": "html", "iconSymbol": "suitcase.fill", "iconColor": "orange", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Packing Planner</title>\n<style>\n  :root { color-scheme: light dark; }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111);\n    max-width:820px; margin:0 auto;\n    padding:16px 16px calc(40px + env(safe-area-inset-bottom));\n  }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-0.02em; margin:6px 2px 14px; }\n  .card{\n    background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8);\n    border-radius:16px; padding:14px; margin-bottom:12px;\n  }\n  label{ display:block; font-size:11.5px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:var(--myllm-muted,#8a8a8e); margin:10px 0 5px; }\n  label:first-child{ margin-top:0; }\n  input, select{\n    width:100%; font-size:16px; padding:11px 12px; border-radius:12px;\n    border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111);\n  }\n  .row2{ display:flex; gap:10px; }\n  .row2 > div{ flex:1; }\n  .chips{ display:flex; flex-wrap:wrap; gap:7px; }\n  .chip{\n    border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111);\n    border-radius:99px; padding:8px 14px; font-size:14px; font-weight:600;\n  }\n  .chip.on{ background:var(--myllm-accent,#0a84ff); border-color:var(--myllm-accent,#0a84ff); color:#fff; }\n  .go{\n    width:100%; margin-top:14px; border:none; border-radius:14px; padding:15px; font-size:16.5px; font-weight:750;\n    background:var(--myllm-accent,#0a84ff); color:#fff;\n  }\n  .go:disabled{ opacity:.55; }\n  .note{ font-size:13px; color:var(--myllm-muted,#8a8a8e); line-height:1.45; margin-top:8px; }\n\n  /* weather strip */\n  .wx{ display:flex; gap:6px; overflow-x:auto; padding-bottom:4px; scrollbar-width:none; }\n  .wx::-webkit-scrollbar{ display:none; }\n  .day{\n    min-width:64px; text-align:center; background:var(--myllm-bg,#f2f2f7);\n    border-radius:12px; padding:8px 4px;\n  }\n  .day small{ display:block; font-size:10.5px; font-weight:700; color:var(--myllm-muted,#8a8a8e); }\n  .day .i{ font-size:20px; line-height:1.5; }\n  .day b{ font-size:12px; font-weight:700; }\n  .day i{ font-style:normal; font-size:11px; color:var(--myllm-muted,#8a8a8e); }\n  .wxhead{ display:flex; justify-content:space-between; align-items:baseline; margin-bottom:8px; }\n  .wxhead b{ font-size:15px; font-weight:750; }\n  .wxhead span{ font-size:12px; color:var(--myllm-muted,#8a8a8e); }\n\n  /* checklist */\n  .prog{ height:8px; border-radius:99px; background:var(--myllm-bg,#f2f2f7); overflow:hidden; margin:8px 0 2px; }\n  .prog div{ height:100%; border-radius:99px; background:#30d158; transition:width .25s; }\n  .phead{ display:flex; justify-content:space-between; align-items:baseline; }\n  .phead b{ font-size:15px; font-weight:750; }\n  .phead span{ font-size:12.5px; color:var(--myllm-muted,#8a8a8e); }\n  .grp{ margin-top:12px; }\n  .grp > b{ display:block; font-size:13px; font-weight:800; letter-spacing:.02em; margin-bottom:6px; }\n  .it{\n    display:flex; align-items:center; gap:11px; padding:9px 2px;\n    border-bottom:1px solid var(--myllm-border,#e3e3e8); font-size:15.5px;\n  }\n  .it:last-child{ border-bottom:none; }\n  .it .box{\n    width:24px; height:24px; border-radius:8px; border:2px solid var(--myllm-border,#c9c9cf);\n    display:flex; align-items:center; justify-content:center; color:#fff; font-size:14px; flex-shrink:0;\n  }\n  .it.on .box{ background:#30d158; border-color:#30d158; }\n  .it.on span{ text-decoration:line-through; color:var(--myllm-muted,#8a8a8e); }\n  .it .rm{ margin-left:auto; border:none; background:none; color:var(--myllm-muted,#8a8a8e); font-size:15px; padding:4px 6px; }\n  .addrow{ display:flex; gap:8px; margin-top:12px; }\n  .addrow input{ flex:1; }\n  .addrow button{\n    border:none; border-radius:12px; padding:0 16px; font-size:15px; font-weight:700;\n    background:var(--myllm-accent,#0a84ff); color:#fff;\n  }\n  .toolrow{ display:flex; gap:8px; margin-top:14px; }\n  .toolrow button{\n    flex:1; border:1px solid var(--myllm-border,#e3e3e8); border-radius:12px; padding:11px;\n    font-size:14px; font-weight:650; background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111);\n  }\n</style>\n</head>\n<body>\n\n<h1>🧳 Packing Planner</h1>\n\n<div class=\"card\" id=\"form\">\n  <label>Where to?</label>\n  <input id=\"dest\" placeholder=\"Lisbon, Tokyo, Lake District…\" autocomplete=\"off\">\n  <div class=\"row2\">\n    <div><label>First day</label><input id=\"start\" type=\"date\"></div>\n    <div><label>Nights</label><input id=\"nights\" inputmode=\"numeric\" value=\"4\"></div>\n  </div>\n  <label>Trip type</label>\n  <div class=\"chips\" id=\"types\"></div>\n  <button class=\"go\" id=\"goBtn\" onclick=\"plan()\">Pack for this trip</button>\n  <p class=\"note\" id=\"formNote\"></p>\n</div>\n\n<div class=\"card\" id=\"wxcard\" style=\"display:none\">\n  <div class=\"wxhead\"><b id=\"wxplace\"></b><span id=\"wxsum\"></span></div>\n  <div class=\"wx\" id=\"wxdays\"></div>\n</div>\n\n<div class=\"card\" id=\"listcard\" style=\"display:none\">\n  <div class=\"phead\"><b id=\"listtitle\">Your list</b><span id=\"listcount\"></span></div>\n  <div class=\"prog\"><div id=\"progfill\" style=\"width:0%\"></div></div>\n  <div id=\"groups\"></div>\n  <div class=\"addrow\">\n    <input id=\"newitem\" placeholder=\"Add your own item…\" onkeydown=\"if(event.key==='Enter')addItem()\">\n    <button onclick=\"addItem()\">Add</button>\n  </div>\n  <div class=\"toolrow\">\n    <button onclick=\"shareList()\">Share</button>\n    <button onclick=\"untickAll()\">Untick all</button>\n    <button onclick=\"newTrip()\">New trip</button>\n  </div>\n</div>\n\n<!-- AI thinking pill (house convention) -->\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\">⚙️</span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n\n<script>\nvar store = window.myllmStorage || {getItem:function(){return Promise.resolve(null)}, setItem:function(){return Promise.resolve()}};\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nvar NET = window.myllmFetch || null;\nvar ASK = window.myllmAsk || null;\n\nvar TYPES = [\n  {id:\"city\",     name:\"🏙️ City break\"},\n  {id:\"beach\",    name:\"🏖️ Beach\"},\n  {id:\"hiking\",   name:\"🥾 Hiking\"},\n  {id:\"business\", name:\"💼 Business\"},\n  {id:\"winter\",   name:\"⛷️ Winter\"},\n  {id:\"family\",   name:\"👨‍👩‍👧 Family\"}\n];\nvar WMOJI = [[0,\"☀️\"],[1,\"🌤️\"],[2,\"⛅\"],[3,\"☁️\"],[45,\"🌫️\"],[51,\"🌦️\"],[61,\"🌧️\"],[71,\"🌨️\"],[80,\"🌧️\"],[95,\"⛈️\"]];\nfunction wicon(code){\n  var best=\"☁️\";\n  for (var i=0;i<WMOJI.length;i++){ if (code >= WMOJI[i][0]) best = WMOJI[i][1]; }\n  return best;\n}\n\nvar trip = null;   // {dest, place, start, nights, type, wx:[{date,tmax,tmin,rain,code}]|null, groups:[{name,items:[{t,qty,on}]}]}\nvar picked = \"city\";\n\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\"); }\nfunction save(){ store.setItem(\"trip\", trip ? JSON.stringify(trip) : \"\"); }\n\nfunction renderTypes(){\n  el(\"types\").innerHTML = TYPES.map(function(t){\n    return '<button class=\"chip'+(picked===t.id?' on':'')+'\" onclick=\"pickType(\\''+t.id+'\\')\">'+t.name+'</button>';\n  }).join(\"\");\n}\nfunction pickType(id){ picked = id; haptic(\"selection\"); renderTypes(); }\n\n/* ---------- deterministic packing engine ---------- */\nfunction baseList(type, nights, wx){\n  var socks = Math.min(nights + 1, 8);\n  var tops  = Math.min(Math.ceil(nights * 0.8) + 1, 7);\n  var g = [];\n  g.push({name:\"Essentials\", items:[\n    \"Passport / ID\", \"Phone + charger\", \"Bank cards & some cash\", \"Tickets & bookings\",\n    \"Medication\", \"Toothbrush & toiletries\", \"Deodorant\"\n  ]});\n  g.push({name:\"Clothes\", items:[\n    socks + \"× socks\", socks + \"× underwear\", tops + \"× tops\",\n    \"2× trousers/shorts\", \"Comfortable shoes\", \"Sleepwear\", \"Light jacket\"\n  ]});\n  if (type === \"beach\") g.push({name:\"Beach\", items:[\n    \"Swimwear ×2\", \"Beach towel\", \"Sunglasses\", \"Sun hat\", \"Sunscreen\", \"Flip-flops\", \"Beach bag\", \"Book / e-reader\"\n  ]});\n  if (type === \"hiking\") g.push({name:\"Hiking\", items:[\n    \"Hiking boots (wear on travel day)\", \"Daypack\", \"Water bottle\", \"Blister plasters\",\n    \"Waterproof jacket\", \"Hiking socks\", \"Map / offline maps downloaded\", \"Snacks / trail bars\", \"Head torch\"\n  ]});\n  if (type === \"business\") g.push({name:\"Business\", items:[\n    \"Laptop + charger\", \"Smart outfit ×\" + Math.min(nights, 3), \"Smart shoes\", \"Notebook & pen\", \"Business cards\", \"Presentation on a USB backup\"\n  ]});\n  if (type === \"winter\") g.push({name:\"Winter\", items:[\n    \"Ski jacket & trousers\", \"Thermal base layers ×2\", \"Gloves\", \"Warm hat\", \"Ski socks ×\" + Math.min(nights, 5), \"Goggles\", \"Lip balm & high-SPF sunscreen\", \"Swimwear (spa/pool)\"\n  ]});\n  if (type === \"family\") g.push({name:\"Family\", items:[\n    \"Kids' clothes (a spare set per day)\", \"Favourite toy / comforter\", \"Snacks for the journey\", \"Wet wipes\", \"Tablet + downloads\", \"Kids' medicine\", \"Pushchair / carrier\"\n  ]});\n  if (type === \"city\") g.push({name:\"City\", items:[\n    \"Day bag\", \"Comfortable walking shoes\", \"Power bank\", \"One smarter outfit\", \"Reusable water bottle\"\n  ]});\n\n  /* weather-driven adds */\n  if (wx && wx.length){\n    var adds = [];\n    var maxT = Math.max.apply(null, wx.map(function(d){return d.tmax;}));\n    var minT = Math.min.apply(null, wx.map(function(d){return d.tmin;}));\n    var wet  = Math.max.apply(null, wx.map(function(d){return d.rain;}));\n    if (wet >= 40) adds.push(\"Umbrella or rain jacket\");\n    if (minT < 8)  adds.push(\"Warm layers (it drops to \" + Math.round(minT) + \"°C)\");\n    if (maxT >= 24){ adds.push(\"Sunscreen\"); adds.push(\"Sunglasses\"); }\n    if (maxT >= 29) adds.push(\"Refillable water bottle (it hits \" + Math.round(maxT) + \"°C)\");\n    if (adds.length) g.push({name:\"For the forecast\", items:adds});\n  }\n  return g.map(function(grp){\n    return {name:grp.name, items:grp.items.map(function(t){ return {t:t, on:false}; })};\n  });\n}\n\n/* ---------- plan flow ---------- */\nfunction plan(){\n  var dest = el(\"dest\").value.trim();\n  var start = el(\"start\").value;\n  var nights = parseInt(el(\"nights\").value, 10);\n  if (!dest){ el(\"formNote\").textContent = \"Where are you off to?\"; el(\"dest\").focus(); return; }\n  if (!start){ el(\"formNote\").textContent = \"Pick your first day.\"; return; }\n  if (!(nights > 0)) nights = 3;\n  haptic(\"light\");\n  el(\"goBtn\").disabled = true;\n  el(\"formNote\").textContent = NET ? \"Checking the forecast…\" : \"\";\n\n  lookupWeather(dest, start, nights).then(function(res){\n    trip = {\n      dest: dest, place: res.place || dest, start: start, nights: nights, type: picked,\n      wx: res.days, groups: baseList(picked, nights, res.days)\n    };\n    save(); render();\n    el(\"goBtn\").disabled = false;\n    el(\"formNote\").textContent = res.msg || \"\";\n    haptic(\"success\");\n    smartExtras();\n  });\n}\n\nfunction lookupWeather(dest, start, nights){\n  if (!NET) return Promise.resolve({days:null, msg:\"Weather needs network access — list built from trip type.\"});\n  var lead = Math.round((new Date(start + \"T12:00:00\") - new Date()) / 86400000);\n  if (lead > 14) return Promise.resolve({days:null, msg:\"Too far ahead for a forecast — I'll add weather items when it's closer.\"});\n  var gurl = \"https://geocoding-api.open-meteo.com/v1/search?count=1&name=\" + encodeURIComponent(dest);\n  return NET(gurl).then(function(r){\n    var j = JSON.parse(r.body);\n    if (!j.results || !j.results.length) throw new Error(\"no place\");\n    var p = j.results[0];\n    var days = Math.min(lead + nights + 1, 16);\n    var furl = \"https://api.open-meteo.com/v1/forecast?latitude=\" + p.latitude + \"&longitude=\" + p.longitude +\n      \"&daily=temperature_2m_max,temperature_2m_min,precipitation_probability_max,weather_code&forecast_days=\" + days + \"&timezone=auto\";\n    return NET(furl).then(function(fr){\n      var f = JSON.parse(fr.body).daily;\n      var out = [];\n      for (var i = 0; i < f.time.length; i++){\n        if (f.time[i] < start) continue;\n        out.push({date:f.time[i], tmax:f.temperature_2m_max[i], tmin:f.temperature_2m_min[i],\n                  rain:f.precipitation_probability_max[i] || 0, code:f.weather_code[i]});\n      }\n      var name = p.name + (p.country_code ? \", \" + p.country_code : \"\");\n      return {days:(out.length ? out : null), place:name};\n    });\n  }).catch(function(){\n    return {days:null, msg:\"Couldn't fetch the forecast — list built from trip type.\"};\n  });\n}\n\n/* AI extras appended as their own group (optional, graceful) */\nfunction smartExtras(){\n  if (!ASK || !trip) return;\n  var wxs = trip.wx ? (\" Forecast: \" + Math.round(Math.min.apply(null, trip.wx.map(function(d){return d.tmin;}))) + \"–\" +\n    Math.round(Math.max.apply(null, trip.wx.map(function(d){return d.tmax;}))) + \"°C, max rain chance \" +\n    Math.round(Math.max.apply(null, trip.wx.map(function(d){return d.rain;}))) + \"%.\") : \"\";\n  var prompt = 'I\\'m going to ' + trip.place + ' for ' + trip.nights + ' nights (' + trip.type + ' trip), starting ' + trip.start + '.' + wxs +\n    ' List 4 to 6 destination-specific packing items a generic list would miss (think: plug adapter type, local etiquette, terrain, insects, payments). ' +\n    'Reply with ONLY a JSON array of short strings, e.g. [\"Type-C plug adapter\",\"Mosquito repellent\"]. No prose.';\n  ASK(prompt, {system:\"You output only compact JSON arrays of short strings. No commentary.\"})\n    .then(function(reply){\n      var s = String(reply);\n      var a = s.indexOf(\"[\"), b = s.lastIndexOf(\"]\");\n      if (a < 0 || b <= a) return;\n      var items;\n      try{ items = JSON.parse(s.slice(a, b + 1)); }catch(e){ return; }\n      if (!items || !items.length || !trip) return;\n      items = items.filter(function(x){ return typeof x === \"string\" && x.length > 1 && x.length < 90; }).slice(0, 8);\n      if (!items.length) return;\n      trip.groups = trip.groups.filter(function(g){ return g.name !== \"Smart extras ✨\"; });\n      trip.groups.push({name:\"Smart extras ✨\", items:items.map(function(t){ return {t:t, on:false}; })});\n      save(); render();\n    })\n    .catch(function(){});\n}\n\n/* ---------- render ---------- */\nfunction render(){\n  renderTypes();\n  if (!trip){\n    el(\"wxcard\").style.display = \"none\";\n    el(\"listcard\").style.display = \"none\";\n    return;\n  }\n  el(\"dest\").value = trip.dest;\n  el(\"start\").value = trip.start;\n  el(\"nights\").value = trip.nights;\n  picked = trip.type; renderTypes();\n\n  if (trip.wx && trip.wx.length){\n    el(\"wxcard\").style.display = \"block\";\n    el(\"wxplace\").textContent = trip.place;\n    el(\"wxsum\").textContent = \"your trip's forecast\";\n    el(\"wxdays\").innerHTML = trip.wx.map(function(d){\n      var dt = new Date(d.date + \"T12:00:00\");\n      var dow = [\"Sun\",\"Mon\",\"Tue\",\"Wed\",\"Thu\",\"Fri\",\"Sat\"][dt.getDay()];\n      return '<div class=\"day\"><small>' + dow + '</small><div class=\"i\">' + wicon(d.code) + '</div>' +\n        '<b>' + Math.round(d.tmax) + '°</b> <i>' + Math.round(d.tmin) + '°</i></div>';\n    }).join(\"\");\n  } else el(\"wxcard\").style.display = \"none\";\n\n  el(\"listcard\").style.display = \"block\";\n  el(\"listtitle\").textContent = \"Packing for \" + trip.place;\n  var total = 0, done = 0;\n  trip.groups.forEach(function(g){ g.items.forEach(function(it){ total++; if (it.on) done++; }); });\n  el(\"listcount\").textContent = done + \" / \" + total + \" packed\";\n  el(\"progfill\").style.width = (total ? Math.round(done / total * 100) : 0) + \"%\";\n  el(\"groups\").innerHTML = trip.groups.map(function(g, gi){\n    return '<div class=\"grp\"><b>' + esc(g.name) + '</b>' + g.items.map(function(it, ii){\n      return '<div class=\"it' + (it.on ? ' on' : '') + '\" onclick=\"toggle(' + gi + ',' + ii + ')\">' +\n        '<div class=\"box\">' + (it.on ? '✓' : '') + '</div><span>' + esc(it.t) + '</span>' +\n        '<button class=\"rm\" onclick=\"event.stopPropagation();removeItem(' + gi + ',' + ii + ')\" aria-label=\"Remove\">✕</button></div>';\n    }).join(\"\") + '</div>';\n  }).join(\"\");\n}\n\nfunction toggle(gi, ii){\n  var it = trip.groups[gi].items[ii];\n  it.on = !it.on;\n  haptic(it.on ? \"success\" : \"light\");\n  save(); render();\n}\nfunction removeItem(gi, ii){\n  trip.groups[gi].items.splice(ii, 1);\n  trip.groups = trip.groups.filter(function(g){ return g.items.length; });\n  haptic(\"light\"); save(); render();\n}\nfunction addItem(){\n  var v = el(\"newitem\").value.trim();\n  if (!v || !trip) return;\n  var mine = trip.groups.filter(function(g){ return g.name === \"My items\"; })[0];\n  if (!mine){ mine = {name:\"My items\", items:[]}; trip.groups.push(mine); }\n  mine.items.push({t:v, on:false});\n  el(\"newitem\").value = \"\";\n  haptic(\"success\"); save(); render();\n}\nfunction untickAll(){\n  trip.groups.forEach(function(g){ g.items.forEach(function(it){ it.on = false; }); });\n  haptic(\"light\"); save(); render();\n}\nfunction newTrip(){\n  trip = null; save(); render();\n  el(\"dest\").value = \"\"; el(\"formNote\").textContent = \"\";\n  haptic(\"light\");\n  window.scrollTo(0, 0);\n}\nfunction shareList(){\n  if (!trip) return;\n  var txt = \"Packing list — \" + trip.place + \" (\" + trip.nights + \" nights)\\n\\n\" +\n    trip.groups.map(function(g){\n      return g.name + \"\\n\" + g.items.map(function(it){ return (it.on ? \"☑ \" : \"☐ \") + it.t; }).join(\"\\n\");\n    }).join(\"\\n\\n\");\n  if (window.myllmShare){ try{ myllmShare({text:txt}); }catch(_){} }\n  haptic(\"light\");\n}\n\n/* ---------- boot ---------- */\nel(\"start\").value = new Date(Date.now() + 86400000 * 7).toISOString().slice(0, 10);\nrenderTypes();\nstore.getItem(\"trip\").then(function(v){\n  if (v){ try{ trip = JSON.parse(v) || null; }catch(e){} }\n  render();\n});\n</script>\n</body>\n</html>\n"}