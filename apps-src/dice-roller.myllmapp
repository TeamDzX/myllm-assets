{"name": "Dice", "kind": "html", "iconSymbol": "dice.fill", "iconColor": "cyan", "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Dice</title>\n<style>\n:root{color-scheme:dark;--bg:#0c0e14;--panel:#151924;--ink:#eceff5;--mut:#828da1;--line:#252c3c;--ac:#6ea8ff;--gold:#ffd23f}\n*{box-sizing:border-box;margin:0}\nhtml,body{height:100%}\nbody{font-family:-apple-system,system-ui,sans-serif;color:var(--ink);\n  position:fixed;inset:0;width:100%;height:100dvh;overflow:hidden;display:flex;flex-direction:column;\n  -webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none;\n  background:radial-gradient(130% 100% at 50% 0%,#141a28,var(--bg))}\n.top{padding:calc(12px + env(safe-area-inset-top)) 18px 4px;display:flex;align-items:baseline;gap:10px}\nh1{font-size:20px;font-weight:900;letter-spacing:.02em}\n.total{margin-left:auto;font-size:14px;color:var(--mut);font-weight:700}\n.total b{font-size:24px;color:var(--gold);font-variant-numeric:tabular-nums}\n/* table */\n#stage{flex:1;display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:26px;\n  padding:16px;min-height:0;perspective:900px;cursor:pointer}\n.die{width:var(--sz);height:var(--sz);position:relative;transform-style:preserve-3d;\n  transition:transform .95s cubic-bezier(.22,1.2,.36,1)}\n.face{position:absolute;inset:0;border-radius:16%;background:var(--body);\n  display:grid;grid-template:repeat(3,1fr)/repeat(3,1fr);padding:14%;\n  box-shadow:inset 0 0 calc(var(--sz)*.09) rgba(0,0,0,.28);border:1px solid var(--edge)}\n.pip{border-radius:50%;background:var(--pip);align-self:center;justify-self:center;\n  width:70%;aspect-ratio:1;box-shadow:var(--pipglow, inset 0 1px 2px rgba(0,0,0,.4))}\n.f1{transform:translateZ(calc(var(--sz)/2))}\n.f6{transform:rotateY(180deg) translateZ(calc(var(--sz)/2))}\n.f3{transform:rotateY(90deg) translateZ(calc(var(--sz)/2))}\n.f4{transform:rotateY(-90deg) translateZ(calc(var(--sz)/2))}\n.f2{transform:rotateX(90deg) translateZ(calc(var(--sz)/2))}\n.f5{transform:rotateX(-90deg) translateZ(calc(var(--sz)/2))}\n/* themes */\nbody.t-ivory{--body:linear-gradient(145deg,#fdfcf7,#e8e4d8);--pip:#22242b;--edge:rgba(0,0,0,.18)}\nbody.t-neon{--body:linear-gradient(145deg,#101625,#0a0e1a);--pip:#39e6ff;--edge:rgba(57,230,255,.5);\n  --pipglow:0 0 8px #39e6ff,0 0 16px rgba(57,230,255,.6)}\nbody.t-ember{--body:linear-gradient(145deg,#4a1512,#2b0b09);--pip:#ffd23f;--edge:rgba(255,150,60,.35);\n  --pipglow:0 0 6px rgba(255,210,63,.7)}\n.hint{text-align:center;font-size:12px;color:var(--mut);font-weight:600;padding:0 0 6px;min-height:16px}\n/* controls */\n.deck{flex:0 0 auto;background:rgba(17,21,31,.9);border-top:1px solid var(--line);\n  border-radius:20px 20px 0 0;padding:12px 16px calc(14px + env(safe-area-inset-bottom))}\n.lbl{font-size:10px;font-weight:800;letter-spacing:.14em;color:var(--mut);margin:8px 0 6px}\n.row{display:flex;gap:7px;flex-wrap:wrap}\n.chip{border:1.5px solid var(--line);background:none;color:var(--mut);border-radius:999px;\n  padding:8px 15px;font-size:13px;font-weight:700}\n.chip.on{color:var(--ac);border-color:var(--ac)}\n.rollbtn{width:100%;border:0;border-radius:14px;background:linear-gradient(135deg,#6ea8ff,#3f6fe0);\n  color:#0a1220;font-weight:900;font-size:16px;letter-spacing:.03em;padding:14px;margin-top:12px}\n.hist{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;margin-top:10px;min-height:26px}\n.hist::-webkit-scrollbar{display:none}\n.hist span{flex:0 0 auto;font-size:12px;font-weight:700;color:var(--mut);background:var(--panel);\n  border:1px solid var(--line);border-radius:8px;padding:4px 9px;font-variant-numeric:tabular-nums}\n.hist span.dbl{color:var(--gold);border-color:rgba(255,210,63,.4)}\n/* full-app card */\n.upsell{margin-top:12px;border:1px solid var(--line);border-radius:14px;padding:11px 13px;\n  display:flex;align-items:center;gap:11px;background:linear-gradient(135deg,rgba(110,168,255,.08),rgba(110,168,255,0))}\n.upsell .e{font-size:26px}\n.upsell .t{flex:1;font-size:11.5px;line-height:1.45;color:var(--mut)}\n.upsell .t b{color:var(--ink);font-size:12.5px}\n.upsell a{flex:0 0 auto;text-decoration:none;background:var(--ink);color:#10131c;font-weight:800;\n  font-size:12px;border-radius:999px;padding:8px 14px}\n</style></head><body class=\"t-ivory\">\n\n<div class=\"top\"><h1>🎲 Dice</h1><div class=\"total\">total <b id=\"total\">–</b></div></div>\n<div id=\"stage\"></div>\n<div class=\"hint\" id=\"hint\">Tap the table to roll</div>\n\n<div class=\"deck\">\n  <div class=\"lbl\">DICE</div>\n  <div class=\"row\" id=\"countRow\"></div>\n  <div class=\"lbl\">STYLE</div>\n  <div class=\"row\" id=\"themeRow\"></div>\n  <button class=\"rollbtn\" id=\"rollBtn\">ROLL</button>\n  <div class=\"hist\" id=\"hist\"></div>\n  <div class=\"upsell\">\n    <span class=\"e\">🎲</span>\n    <div class=\"t\"><b>Dice — the full app</b><br>Real 3D physics, dice &amp; table packs, game rulebooks, pass-the-phone play.</div>\n    <a href=\"https://apps.apple.com/app/id6761314774\" target=\"_blank\" rel=\"noopener\">Get it</a>\n  </div>\n</div>\n\n<script>\n\"use strict\";\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nfunction el(i){return document.getElementById(i)}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k||'light')}catch(e){}}\n\n/* pip layouts on a 3x3 grid (row,col), 1-indexed */\nvar PIPS={1:[[2,2]],2:[[1,1],[3,3]],3:[[1,1],[2,2],[3,3]],4:[[1,1],[1,3],[3,1],[3,3]],\n          5:[[1,1],[1,3],[2,2],[3,1],[3,3]],6:[[1,1],[1,3],[2,1],[2,3],[3,1],[3,3]]};\n/* cube rotation that brings each value to face the viewer (opposites sum to 7) */\nvar ORIENT={1:[0,0],2:[-90,0],3:[0,-90],4:[0,90],5:[90,0],6:[0,180]};\n\nvar THEMES=[['t-ivory','Ivory'],['t-neon','Neon'],['t-ember','Ember']];\nvar count=2,theme='t-ivory',dice=[],rolling=false,spins=0;\n\nfunction buildDice(){\n  var stage=el('stage');stage.innerHTML='';dice=[];\n  var sz=count<=2?110:(count<=4?92:74);\n  for(var i=0;i<count;i++){\n    var d=document.createElement('div');d.className='die';\n    d.style.setProperty('--sz',sz+'px');\n    for(var f=1;f<=6;f++){\n      var face=document.createElement('div');face.className='face f'+f;\n      PIPS[f].forEach(function(p){\n        var pip=document.createElement('i');pip.className='pip';\n        pip.style.gridRow=p[0];pip.style.gridColumn=p[1];\n        face.appendChild(pip);\n      });\n      d.appendChild(face);\n    }\n    d.style.transform='rotateX(-18deg) rotateY(22deg)';\n    stage.appendChild(d);dice.push({elDie:d,val:null});\n  }\n  el('total').textContent='–';\n}\nfunction roll(){\n  if(rolling)return;\n  rolling=true;spins++;haptic('medium');\n  el('hint').textContent='';\n  var vals=[];\n  dice.forEach(function(d,i){\n    var v=1+Math.floor(Math.random()*6);vals.push(v);d.val=v;\n    var o=ORIENT[v];\n    var tx=o[0]+360*(2+((spins+i)%2)), ty=o[1]+360*(2+(i%3)), tz=(Math.random()*14-7);\n    d.elDie.style.transform='rotateX('+tx+'deg) rotateY('+ty+'deg) rotateZ('+tz.toFixed(1)+'deg)';\n  });\n  setTimeout(function(){\n    var total=vals.reduce(function(a,b){return a+b},0);\n    el('total').textContent=total;\n    var allSame=vals.length>1&&vals.every(function(v){return v===vals[0]});\n    addHist(vals,total,allSame);\n    el('hint').textContent=allSame?(vals.length===2?'Doubles!':'All '+vals[0]+'s!'):'Tap the table to roll';\n    haptic(allSame?'success':'light');\n    rolling=false;\n  },980);\n}\nfunction addHist(vals,total,dbl){\n  var h=el('hist'),s=document.createElement('span');\n  if(dbl)s.className='dbl';\n  s.textContent=vals.join('+')+' = '+total;\n  h.insertBefore(s,h.firstChild);\n  while(h.children.length>14)h.removeChild(h.lastChild);\n}\nfunction buildCount(){\n  var r=el('countRow');r.innerHTML='';\n  for(var n=1;n<=6;n++)(function(n){\n    var b=document.createElement('button');b.className='chip'+(n===count?' on':'');b.textContent=n;\n    b.onclick=function(){count=n;store.setItem('dice.count',String(n));buildCount();buildDice();haptic('selection');};\n    r.appendChild(b);\n  })(n);\n}\nfunction buildTheme(){\n  var r=el('themeRow');r.innerHTML='';\n  THEMES.forEach(function(t){\n    var b=document.createElement('button');b.className='chip'+(t[0]===theme?' on':'');b.textContent=t[1];\n    b.onclick=function(){theme=t[0];document.body.className=theme;store.setItem('dice.theme',theme);buildTheme();haptic('selection');};\n    r.appendChild(b);\n  });\n}\nel('stage').addEventListener('click',roll);\nel('rollBtn').onclick=roll;\n\nstore.getItem('dice.count').then(function(v){\n  if(v&&+v>=1&&+v<=6)count=+v;\n  return store.getItem('dice.theme');\n}).then(function(v){\n  if(v&&THEMES.some(function(t){return t[0]===v})){theme=v;document.body.className=theme;}\n  buildCount();buildTheme();buildDice();\n});\n</script>\n</body></html>\n"}