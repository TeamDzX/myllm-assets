{"name": "Dice", "kind": "html", "iconSymbol": "dice.fill", "iconColor": "cyan", "html": "<!doctype html>\n<!--\n  Dice — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Dice</title>\n<style>\n:root{--build-id:\"9bf2dba491\";color-scheme:light dark;--gold:#ffd23f}\n@property --h{ syntax:'<number>'; inherits:true; initial-value:150; }\n*{box-sizing:border-box;margin:0;-webkit-tap-highlight-color:transparent}\nhtml,body{height:100%}\nbody{font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);color:#fff;background:#0b0b10;\n  position:fixed;inset:0;width:100%;height:100dvh;overflow:hidden;user-select:none;-webkit-user-select:none}\n\n/* The stage: a felt-green backdrop in two layers, dark and light, so the change\n   between them can fade. */\n.stage{position:absolute;inset:0;--h:150;color:#fff;display:flex;flex-direction:column;transition:color .5s}\n.bg{position:absolute;inset:0;transition:opacity .6s ease}\n.bg.d{background:radial-gradient(120% 90% at 20% 10%,hsl(var(--h) 62% 27%),transparent 60%),\n  radial-gradient(120% 90% at 85% 95%,hsl(calc(var(--h) + 55) 60% 24%),transparent 62%),#0b0b10}\n.bg.l{opacity:0;background:radial-gradient(120% 90% at 20% 0%,hsl(var(--h) 62% 84%),transparent 60%),\n  radial-gradient(120% 90% at 85% 100%,hsl(calc(var(--h) + 55) 70% 87%),transparent 62%),#f4f4f8}\n.lite{color:#15151a}.lite .bg.l{opacity:1}.lite .bg.d{opacity:0}\n.stage>*:not(.bg){position:relative}\n.glass{border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.12);color:inherit;\n  -webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px)}\n.lite .glass{border-color:rgba(0,0,0,.09);background:rgba(255,255,255,.62)}\nsvg.i{width:1.25em;height:1.25em;fill:currentColor;flex-shrink:0}\nbutton{font:inherit}button:active{transform:scale(.96)}\n\n.top{display:flex;align-items:center;gap:10px;flex-shrink:0;\n  padding:calc(12px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) 4px calc(16px + env(safe-area-inset-left))}\n.rnd{width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0}\nh1{font-size:22px;font-weight:800;display:flex;align-items:center;gap:8px;flex:1;min-width:0}\nh1 svg{font-size:20px;opacity:.85}\n.tlbl{display:none;flex:1;text-align:center;font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;opacity:.62}\n.total{height:44px;min-width:44px;border-radius:99px;padding:0 16px;display:flex;align-items:center;gap:8px;\n  font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}\n.total b{font-size:21px;letter-spacing:0;font-variant-numeric:tabular-nums}\n.lite .total b{color:inherit}.total b{color:var(--gold)}\n#bClose{display:none}\n\n/* table */\n#stage{flex:1;display:flex;align-items:center;align-content:center;justify-content:center;flex-wrap:wrap;gap:26px;\n  padding:16px calc(16px + env(safe-area-inset-right)) 16px calc(16px + env(safe-area-inset-left));min-height:0;perspective:900px;cursor:pointer}\n.die{width:var(--sz);height:var(--sz);position:relative;transform-style:preserve-3d;\n  transition:transform .95s cubic-bezier(.22,1.2,.36,1)}\n.face{position:absolute;inset:0;border-radius:16%;background:var(--body);\n  display:grid;grid-template:repeat(3,1fr)/repeat(3,1fr);padding:14%;\n  box-shadow:inset 0 0 calc(var(--sz)*.09) rgba(0,0,0,.28);border:1px solid var(--edge)}\n.pip{border-radius:50%;background:var(--pip);align-self:center;justify-self:center;\n  width:70%;aspect-ratio:1;box-shadow:var(--pipglow, inset 0 1px 2px rgba(0,0,0,.4))}\n.f1{transform:translateZ(calc(var(--sz)/2))}\n.f6{transform:rotateY(180deg) translateZ(calc(var(--sz)/2))}\n.f3{transform:rotateY(90deg) translateZ(calc(var(--sz)/2))}\n.f4{transform:rotateY(-90deg) translateZ(calc(var(--sz)/2))}\n.f2{transform:rotateX(90deg) translateZ(calc(var(--sz)/2))}\n.f5{transform:rotateX(-90deg) translateZ(calc(var(--sz)/2))}\n/* themes */\nbody.t-ivory{--body:linear-gradient(145deg,#fdfcf7,#e8e4d8);--pip:#22242b;--edge:rgba(0,0,0,.18)}\nbody.t-neon{--body:linear-gradient(145deg,#101625,#0a0e1a);--pip:#39e6ff;--edge:rgba(57,230,255,.5);\n  --pipglow:0 0 8px #39e6ff,0 0 16px rgba(57,230,255,.6)}\nbody.t-ember{--body:linear-gradient(145deg,#4a1512,#2b0b09);--pip:#ffd23f;--edge:rgba(255,150,60,.35);\n  --pipglow:0 0 6px rgba(255,210,63,.7)}\n.hint{text-align:center;font-size:12px;opacity:.6;font-weight:600;padding:0 16px 8px;min-height:24px;flex-shrink:0}\n\n/* controls */\n.deck{flex:0 0 auto;border-radius:24px 24px 0 0;border-bottom:0;max-height:62dvh;overflow-y:auto;\n  padding:12px calc(16px + env(safe-area-inset-right)) calc(14px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left))}\n.deckin{max-width:560px;margin:0 auto}\n.lbl{font-size:10.5px;font-weight:800;letter-spacing:.14em;opacity:.6;margin:8px 0 7px}\n.row{display:flex;gap:6px;flex-wrap:wrap}\n.chip{border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.08);color:inherit;border-radius:999px;\n  min-width:40px;height:40px;padding:0 13px;font-size:13.5px;font-weight:700}\n.lite .chip{border-color:rgba(0,0,0,.1);background:rgba(255,255,255,.5)}\n.chip.on{background:#fff;border-color:#fff;color:#0b0b10}\n.lite .chip.on{background:#15151a;border-color:#15151a;color:#fff}\n.rollbtn{width:100%;height:54px;border:0;border-radius:99px;background:#fff;color:#0b0b10;font-weight:800;font-size:16.5px;\n  letter-spacing:.02em;margin-top:14px;display:flex;align-items:center;justify-content:center;gap:8px;box-shadow:0 10px 30px rgba(0,0,0,.3)}\n.lite .rollbtn{background:#15151a;color:#fff;box-shadow:0 10px 26px rgba(20,20,40,.22)}\n.hist{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;margin-top:12px;min-height:28px}\n.hist::-webkit-scrollbar{display:none}\n.hist span{flex:0 0 auto;font-size:12px;font-weight:700;opacity:.8;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.07);\n  border-radius:9px;padding:5px 9px;font-variant-numeric:tabular-nums}\n.lite .hist span{border-color:rgba(0,0,0,.09);background:rgba(255,255,255,.5)}\n.hist span.dbl{color:var(--gold);border-color:rgba(255,210,63,.45);opacity:1}\n.lite .hist span.dbl{color:#8a6a00;border-color:rgba(160,120,0,.4)}\n/* full-app card */\n.upsell{margin-top:12px;border:1px solid rgba(255,255,255,.14);border-radius:16px;padding:11px 13px;\n  display:flex;align-items:center;gap:11px;background:rgba(255,255,255,.06)}\n.lite .upsell{border-color:rgba(0,0,0,.09);background:rgba(255,255,255,.5)}\n.upsell .e{font-size:26px}\n.upsell .t{flex:1;font-size:11.5px;line-height:1.45;opacity:.75}\n.upsell .t b{font-size:12.5px}\n.upsell a{flex:0 0 auto;text-decoration:none;background:#fff;color:#10131c;font-weight:800;\n  font-size:12px;border-radius:999px;padding:9px 15px}\n.lite .upsell a{background:#15151a;color:#fff}\n\n/* On the table: nothing but the dice. Tap anywhere to roll. */\n.table .deck{display:none}\n.table h1,.table #bTable{display:none}.table .tlbl{display:block}.table #bClose{display:flex}\n.table .hint{padding-bottom:calc(18px + env(safe-area-inset-bottom));font-size:13px}\n.table #stage{gap:34px}\n\n@media (max-height:520px) and (orientation:landscape){      /* phone on its side: table left, controls right */\n  .stage:not(.table){display:grid;grid-template-columns:minmax(0,1fr) min(50%,420px);grid-template-rows:auto minmax(0,1fr) auto}\n  .stage:not(.table) .top{grid-column:1 / 3}\n  .stage:not(.table) #stage{grid-column:1;grid-row:2}\n  .stage:not(.table) .hint{grid-column:1;grid-row:3}\n  .stage:not(.table) .deck{grid-column:2;grid-row:2 / 4;max-height:none;border-radius:24px 0 0 0;align-self:stretch}\n}\n@media (prefers-reduced-motion:reduce){.die{transition-duration:.01s}.bg{transition:none}}\n</style></head><body class=\"t-ivory\">\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-die\" viewBox=\"0 0 24 24\"><path d=\"M6.5 3A3.5 3.5 0 0 0 3 6.5v11A3.5 3.5 0 0 0 6.5 21h11a3.5 3.5 0 0 0 3.5-3.5v-11A3.5 3.5 0 0 0 17.500 3zM8 6.4A1.6 1.6 0 1 1 8 9.600 1.600 1.600 0 0 1 8 6.400zm8 0a1.600 1.600 0 1 1 0 3.200 1.600 1.600 0 0 1 0-3.200zm-4 4a1.600 1.600 0 1 1 0 3.200 1.600 1.600 0 0 1 0-3.200zm-4 4a1.600 1.600 0 1 1 0 3.200 1.600 1.600 0 0 1 0-3.200zm8 0a1.600 1.600 0 1 1 0 3.200 1.600 1.600 0 0 1 0-3.200z\" fill-rule=\"evenodd\"/></symbol>\n  <symbol id=\"i-expand\" viewBox=\"0 0 24 24\"><path d=\"M5 4a1 1 0 0 0-1 1v5a1 1 0 0 0 2 0V7.400l3.300 3.300a1 1 0 0 0 1.400-1.400L7.400 6H10a1 1 0 0 0 0-2zm14 16a1 1 0 0 0 1-1v-5a1 1 0 0 0-2 0v2.600l-3.300-3.300a1 1 0 0 0-1.400 1.400l3.300 3.300H14a1 1 0 0 0 0 2z\"/></symbol>\n  <symbol id=\"i-close\" viewBox=\"0 0 24 24\"><path d=\"M6.4 5a1 1 0 0 0-1.4 1.400L10.600 12 5 17.600A1 1 0 0 0 6.400 19l5.600-5.600 5.600 5.600a1 1 0 0 0 1.400-1.400L13.400 12 19 6.400A1 1 0 0 0 17.600 5L12 10.600z\"/></symbol>\n</defs></svg>\n\n<div class=\"stage\" id=\"app\">\n  <div class=\"bg d\"></div><div class=\"bg l\"></div>\n  <div class=\"top\">\n    <button class=\"glass rnd\" id=\"bClose\" aria-label=\"Leave the table\"><svg class=\"i\"><use href=\"#i-close\"/></svg></button>\n    <h1><svg class=\"i\"><use href=\"#i-die\"/></svg>Dice</h1>\n    <div class=\"tlbl\">Dice</div>\n    <div class=\"glass total\">total <b id=\"total\">–</b></div>\n    <button class=\"glass rnd\" id=\"bTable\" aria-label=\"Full-screen table\"><svg class=\"i\"><use href=\"#i-expand\"/></svg></button>\n  </div>\n  <div id=\"stage\"></div>\n  <div class=\"hint\" id=\"hint\">Tap the table to roll</div>\n\n  <div class=\"deck glass\">\n    <div class=\"deckin\">\n      <div class=\"lbl\">DICE</div>\n      <div class=\"row\" id=\"countRow\"></div>\n      <div class=\"lbl\">STYLE</div>\n      <div class=\"row\" id=\"themeRow\"></div>\n      <button class=\"rollbtn\" id=\"rollBtn\"><svg class=\"i\"><use href=\"#i-die\"/></svg>ROLL</button>\n      <div class=\"hist\" id=\"hist\"></div>\n      <div class=\"upsell\">\n        <span class=\"e\">🎲</span>\n        <div class=\"t\"><b>Dice — the full app</b><br>Real 3D physics, dice &amp; table packs, game rulebooks, pass-the-phone play.</div>\n        <a href=\"https://apps.apple.com/app/id6761314774\" target=\"_blank\" rel=\"noopener\">Get it</a>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n\"use strict\";\nfunction el(i){return document.getElementById(i)}\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k||'light')}catch(e){}}\nfunction load(k){var s=window.myllmStorage;return s?s.getItem(k).catch(function(){return null}):Promise.resolve(null)}\nfunction keep(k,v){var s=window.myllmStorage;if(s)try{s.setItem(k,v).catch(function(){})}catch(e){}}\n\n/* ---------- look ---------- */\nvar onTable=false;\nfunction isLight(){return !(window.matchMedia&&matchMedia('(prefers-color-scheme: dark)').matches)}\n/* The table takes the whole display and dims the room. Where MyLLM can't hide\n   its own title bar, a dark stage under a white bar looks cut in half — so in\n   light mode, without myllmImmersive, the table stays light. */\nfunction syncLook(){\n  var a=el('app');\n  a.classList.toggle('lite',isLight()&&!(onTable&&window.myllmImmersive));\n  a.classList.toggle('table',onTable);\n}\nfunction syncChrome(){\n  if(!window.myllmImmersive)return;\n  try{myllmImmersive(onTable,{keepAwake:false}).catch(function(){})}catch(e){}\n}\nfunction setTable(on){\n  onTable=on;haptic('light');syncLook();syncChrome();\n  if(!rolling)resizeDice();\n}\n/* the same three sizes as ever, a step up on the table, never wider than the room */\nfunction dieSize(){\n  var base=count<=2?110:(count<=4?92:74);\n  if(onTable)base=Math.round(base*1.4);\n  var box=el('stage'),w=box.clientWidth-32,h=box.clientHeight-32,gap=onTable?34:26;\n  var cols=count<=3?count:Math.ceil(count/2),rows=count<=3?1:2;\n  if(w>0&&h>0)base=Math.min(base,Math.floor((w-gap*(cols-1))/cols),Math.floor((h-gap*(rows-1))/rows/1.25));\n  base=Math.max(40,base);\n  /* pad the table in so the dice wrap into even rows (2+2, 3+3), not 3+1 */\n  var side=Math.max(16,Math.floor((box.clientWidth-(base*cols+gap*(cols-1)))/2)-2);\n  box.style.paddingLeft='calc('+side+'px + env(safe-area-inset-left))';\n  box.style.paddingRight='calc('+side+'px + env(safe-area-inset-right))';\n  return base;\n}\nfunction resizeDice(){\n  var sz=dieSize();\n  dice.forEach(function(d){d.elDie.style.setProperty('--sz',sz+'px')});\n}\n\n/* pip layouts on a 3x3 grid (row,col), 1-indexed */\nvar PIPS={1:[[2,2]],2:[[1,1],[3,3]],3:[[1,1],[2,2],[3,3]],4:[[1,1],[1,3],[3,1],[3,3]],\n          5:[[1,1],[1,3],[2,2],[3,1],[3,3]],6:[[1,1],[1,3],[2,1],[2,3],[3,1],[3,3]]};\n/* cube rotation that brings each value to face the viewer (opposites sum to 7) */\nvar ORIENT={1:[0,0],2:[-90,0],3:[0,-90],4:[0,90],5:[90,0],6:[0,180]};\n\nvar THEMES=[['t-ivory','Ivory'],['t-neon','Neon'],['t-ember','Ember']];\nvar count=2,theme='t-ivory',dice=[],rolling=false,spins=0;\n\nfunction buildDice(){\n  var stage=el('stage');stage.innerHTML='';dice=[];\n  var sz=dieSize();\n  for(var i=0;i<count;i++){\n    var d=document.createElement('div');d.className='die';\n    d.style.setProperty('--sz',sz+'px');\n    for(var f=1;f<=6;f++){\n      var face=document.createElement('div');face.className='face f'+f;\n      PIPS[f].forEach(function(p){\n        var pip=document.createElement('i');pip.className='pip';\n        pip.style.gridRow=p[0];pip.style.gridColumn=p[1];\n        face.appendChild(pip);\n      });\n      d.appendChild(face);\n    }\n    d.style.transform='rotateX(-18deg) rotateY(22deg)';\n    stage.appendChild(d);dice.push({elDie:d,val:null});\n  }\n  el('total').textContent='–';\n}\nfunction roll(){\n  if(rolling)return;\n  rolling=true;spins++;haptic('medium');\n  el('hint').textContent='';\n  var vals=[];\n  dice.forEach(function(d,i){\n    var v=1+Math.floor(Math.random()*6);vals.push(v);d.val=v;\n    var o=ORIENT[v];\n    var tx=o[0]+360*(2+((spins+i)%2)), ty=o[1]+360*(2+(i%3)), tz=(Math.random()*14-7);\n    d.elDie.style.transform='rotateX('+tx+'deg) rotateY('+ty+'deg) rotateZ('+tz.toFixed(1)+'deg)';\n  });\n  setTimeout(function(){\n    var total=vals.reduce(function(a,b){return a+b},0);\n    el('total').textContent=total;\n    var allSame=vals.length>1&&vals.every(function(v){return v===vals[0]});\n    addHist(vals,total,allSame);\n    el('hint').textContent=allSame?(vals.length===2?'Doubles!':'All '+vals[0]+'s!'):'Tap the table to roll';\n    haptic(allSame?'success':'light');\n    rolling=false;\n  },980);\n}\nfunction addHist(vals,total,dbl){\n  var h=el('hist'),s=document.createElement('span');\n  if(dbl)s.className='dbl';\n  s.textContent=vals.join('+')+' = '+total;\n  h.insertBefore(s,h.firstChild);\n  while(h.children.length>14)h.removeChild(h.lastChild);\n}\nfunction buildCount(){\n  var r=el('countRow');r.innerHTML='';\n  for(var n=1;n<=6;n++)(function(n){\n    var b=document.createElement('button');b.className='chip'+(n===count?' on':'');b.textContent=n;\n    b.onclick=function(){count=n;keep('dice.count',String(n));buildCount();buildDice();haptic('selection');};\n    r.appendChild(b);\n  })(n);\n}\nfunction buildTheme(){\n  var r=el('themeRow');r.innerHTML='';\n  THEMES.forEach(function(t){\n    var b=document.createElement('button');b.className='chip'+(t[0]===theme?' on':'');b.textContent=t[1];\n    b.onclick=function(){theme=t[0];document.body.className=theme;keep('dice.theme',theme);buildTheme();haptic('selection');};\n    r.appendChild(b);\n  });\n}\nel('stage').addEventListener('click',roll);\nel('rollBtn').onclick=roll;\nel('bTable').onclick=function(){setTable(true)};\nel('bClose').onclick=function(){setTable(false)};\ndocument.addEventListener('visibilitychange',function(){\n  if(!document.hidden&&onTable)syncChrome();      /* MyLLM puts its bars back when the app is left */\n});\nif(window.matchMedia){\n  var mq=matchMedia('(prefers-color-scheme: dark)');\n  if(mq.addEventListener)mq.addEventListener('change',syncLook);else if(mq.addListener)mq.addListener(syncLook);\n}\nwindow.addEventListener('resize',function(){if(!rolling)resizeDice()});\n\nsyncLook();\nload('dice.count').then(function(v){\n  if(v&&+v>=1&&+v<=6)count=+v;\n  return load('dice.theme');\n}).then(function(v){\n  if(v&&THEMES.some(function(t){return t[0]===v})){theme=v;document.body.className=theme;}\n  buildCount();buildTheme();buildDice();\n});\n</script>\n</body></html>\n"}