{"name": "Voice Memos", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\">\n<style>:root{color-scheme:light dark;--accent:#ff453a}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nbody{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:18px 16px 40px;background:#f2f2f7;color:#111}\n@media(prefers-color-scheme:dark){body{background:#000;color:#eee}.memo{background:#1c1c1e}}\nh1{font-size:22px;margin:0 0 4px}\n.sub{font-size:13px;opacity:.6;margin-bottom:18px}\n.recwrap{text-align:center;margin:10px 0 18px}\n.rec{border:0;width:84px;height:84px;border-radius:50%;background:var(--accent);color:#fff;font-size:32px;box-shadow:0 4px 14px rgba(255,69,58,.35)}\n.rec.on{animation:pulse 1.2s infinite}\n@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(255,69,58,.45)}70%{box-shadow:0 0 0 18px rgba(255,69,58,0)}100%{box-shadow:0 0 0 0 rgba(255,69,58,0)}}\n.timer{font-size:30px;font-variant-numeric:tabular-nums;font-weight:300;margin-top:10px;min-height:36px}\n#status{font-size:13px;opacity:.75;min-height:18px;text-align:center;line-height:1.45;margin-bottom:6px}\n#status a,.link{color:var(--accent);font-weight:600}\n.bar{height:5px;border-radius:3px;background:rgba(127,127,127,.18);overflow:hidden;margin:12px 0 4px}\n.bar i{display:block;height:100%;background:var(--accent);width:0}\nh2{font-size:13px;text-transform:uppercase;letter-spacing:.05em;opacity:.55;margin:20px 0 8px}\n.memo{background:#fff;border-radius:13px;padding:11px 14px;margin-bottom:9px;display:flex;align-items:center;gap:12px;box-shadow:0 1px 3px rgba(0,0,0,.07)}\n.play{border:0;background:rgba(255,69,58,.12);color:var(--accent);width:40px;height:40px;border-radius:50%;font-size:16px;flex:none}\n.mi{flex:1;min-width:0}\n.mi .nm{font-size:15px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.mi .dt{font-size:12px;opacity:.55}\n.del{border:0;background:none;color:#ff453a;font-size:16px;padding:4px 6px;flex:none;font-weight:600}\n.empty{text-align:center;opacity:.5;font-size:14px;padding:24px 0}\n.use{font-size:12px;opacity:.5;text-align:right;margin-top:4px}\n@media(min-width:768px){body{max-width:760px;margin-left:auto;margin-right:auto}}\n</style></head><body>\n<h1>🎙️ Voice Memos</h1>\n<div class=\"sub\">Quick voice notes, recorded and kept on your device.</div>\n<div class=\"recwrap\">\n  <button class=\"rec\" id=\"rec\" onclick=\"toggle()\">●</button>\n  <div class=\"timer\" id=\"timer\"></div>\n</div>\n<div id=\"status\"></div>\n<h2 id=\"head\" style=\"display:none\">Memos</h2>\n<div id=\"list\"></div>\n<div class=\"use\" id=\"use\"></div>\n<audio id=\"player\"></audio>\n<script>\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar memos=[],rec=null,stream=null,chunks=[],recording=false,t0=0,tHandle=null,armed=null;\nvar MAXBYTES=950000,MAXSECS=120;\nfunction el(i){return document.getElementById(i)}\nfunction setStatus(t){el('status').innerHTML=t||''}\nfunction pad(n){return String(n).padStart(2,'0')}\nfunction mmss(s){return pad(Math.floor(s/60))+':'+pad(Math.floor(s%60))}\n\nfunction pickMime(){\n  if(typeof MediaRecorder==='undefined')return null;\n  var c=['audio/mp4','audio/aac','audio/webm;codecs=opus','audio/webm'];\n  for(var i=0;i<c.length;i++){try{if(MediaRecorder.isTypeSupported(c[i]))return c[i]}catch(e){}}\n  return '';\n}\nfunction toggle(){recording?stop():start()}\n\nfunction start(){\n  if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia){setStatus('Recording isn’t available on this version of MyLLM.');return}\n  setStatus('Starting…');\n  navigator.mediaDevices.getUserMedia({audio:true}).then(function(s){\n    stream=s;var mime=pickMime();\n    try{rec=mime?new MediaRecorder(s,{mimeType:mime}):new MediaRecorder(s)}catch(e){rec=new MediaRecorder(s)}\n    chunks=[];rec.ondataavailable=function(e){if(e.data&&e.data.size)chunks.push(e.data)};\n    rec.onstop=finish;rec.start();\n    recording=true;t0=Date.now();el('rec').textContent='■';el('rec').classList.add('on');setStatus('Recording… tap to stop');\n    tick();\n  }).catch(function(err){\n    setStatus('Microphone blocked. Turn on <b>Allow apps to use the microphone</b> in Settings → MyLLMos Apps, then reopen this app. <span class=\"link\">(iOS will also ask once.)</span>');\n  });\n}\nfunction tick(){\n  if(!recording)return;var s=(Date.now()-t0)/1000;el('timer').textContent=mmss(s);\n  if(s>=MAXSECS){stop();return}\n  tHandle=setTimeout(tick,200);\n}\nfunction stop(){\n  if(!rec||!recording)return;recording=false;if(tHandle)clearTimeout(tHandle);\n  el('rec').textContent='●';el('rec').classList.remove('on');\n  try{rec.stop()}catch(e){}\n  if(stream)stream.getTracks().forEach(function(t){t.stop()});\n}\nfunction finish(){\n  var secs=Math.max(1,Math.round((Date.now()-t0)/1000));el('timer').textContent='';\n  var blob=new Blob(chunks,{type:(rec&&rec.mimeType)||'audio/mp4'});\n  var fr=new FileReader();\n  fr.onload=function(){\n    var memo={id:'m'+t0,name:defaultName(),dur:secs,url:fr.result,date:Date.now()};\n    var trial=memos.slice();trial.unshift(memo);\n    var size=JSON.stringify(trial).length;\n    if(size>MAXBYTES){setStatus('🎙️ Recorded, but on-device memo storage is full — delete an old memo to keep this one.');renderUse();return}\n    memos=trial;persist().then(function(){setStatus('');renderUse()}).catch(function(){setStatus('Couldn’t save — storage may be full.');memos.shift()});\n    render();if(window.myllmHaptic)myllmHaptic('success');\n  };\n  fr.readAsDataURL(blob);\n}\nfunction defaultName(){var d=new Date();return 'Memo · '+d.toLocaleDateString(undefined,{month:'short',day:'numeric'})+' '+pad(d.getHours())+':'+pad(d.getMinutes())}\n\nfunction play(id){var m=byId(id);if(!m)return;var p=el('player');p.src=m.url;p.play();if(window.myllmHaptic)myllmHaptic('light')}\nfunction del(id){\n  if(armed!==id){armed=id;render();setTimeout(function(){if(armed===id){armed=null;render()}},2500);return}\n  armed=null;memos=memos.filter(function(m){return m.id!==id});persist();render();renderUse();\n}\nfunction byId(id){return memos.filter(function(m){return m.id===id})[0]}\nfunction persist(){return store.setItem('memos',JSON.stringify(memos))}\n\nfunction render(){\n  var L=el('list');L.innerHTML='';el('head').style.display=memos.length?'block':'none';\n  if(!memos.length){L.innerHTML='<div class=\"empty\">No memos yet — tap the red button to record.</div>';renderUse();return}\n  memos.forEach(function(m){\n    var d=document.createElement('div');d.className='memo';\n    var pl=document.createElement('button');pl.className='play';pl.textContent='▶';pl.onclick=function(){play(m.id)};\n    var info=document.createElement('div');info.className='mi';\n    info.innerHTML='<div class=\"nm\">'+m.name+'</div><div class=\"dt\">'+mmss(m.dur)+'</div>';\n    var x=document.createElement('button');x.className='del';x.textContent=armed===m.id?'Delete?':'✕';x.onclick=function(){del(m.id)};\n    d.appendChild(pl);d.appendChild(info);d.appendChild(x);L.appendChild(d);\n  });\n  renderUse();\n}\nfunction renderUse(){\n  var kb=Math.round(JSON.stringify(memos).length/1024);\n  el('use').textContent=memos.length?(kb+' KB of ~930 KB used'):'';\n}\n\nstore.getItem('memos').then(function(v){\n  if(v)try{memos=JSON.parse(v)}catch(e){}\n  render();\n  if(typeof MediaRecorder==='undefined')setStatus('Recording needs the latest MyLLM. Update from the App Store.');\n});\n</script></body></html>\n", "kind": "html", "iconSymbol": "mic.fill", "iconColor": "red"}