{"name": "Bubble Breathing", "html": "<!doctype html>\n<!--\n  Bubble Breathing — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover\">\n<title>Bubble Breathing</title>\n<style>:root{--build-id:\"f946701289\";color-scheme:light dark}\n  @property --h{ syntax:'<number>'; inherits:true; initial-value:212; }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; -webkit-user-select:none; user-select:none; }\n  html,body{ height:100%; overflow:hidden; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:#0b0b10; color:#fff; touch-action:manipulation; }\n\n  /* The stage: a quiet blue backdrop that drifts a little cooler on the\n     out-breath. Two layers, dark and light, cross-faded slowly. */\n  .stage{ position:fixed; inset:0; --h:212; transition:--h 3.6s ease-in-out; color:#fff; overflow:hidden; }\n  .bg{ position:absolute; inset:0; transition:opacity 1.4s ease; }\n  .bg.d{ background:radial-gradient(120% 90% at 20% 10%, hsl(var(--h) 58% 28%), transparent 60%),\n      radial-gradient(120% 90% at 85% 95%, hsl(calc(var(--h) + 40) 50% 22%), transparent 62%), #0b0b10; }\n  .bg.l{ opacity:0; background:radial-gradient(120% 90% at 20% 0%, hsl(var(--h) 80% 87%), transparent 60%),\n      radial-gradient(120% 90% at 85% 100%, hsl(calc(var(--h) + 40) 72% 89%), transparent 62%), #f4f6fb; }\n  .lite{ color:#15151a; } .lite .bg.l{ opacity:1; } .lite .bg.d{ opacity:0; }\n\n  /* A few small bubbles rising, slowly, far apart. Decoration only. */\n  .rise{ position:absolute; inset:0; pointer-events:none; opacity:0; transition:opacity 2s ease; }\n  .run .rise{ opacity:1; }\n  .rise i{ position:absolute; bottom:-60px; border-radius:50%; border:1.5px solid rgba(255,255,255,.3); background:none; animation:rise linear infinite; }\n  .lite .rise i{ border-color:hsl(var(--h) 60% 55% / .4); }\n  @keyframes rise{ from{ transform:translate(0,0); } 50%{ transform:translate(14px,-60vh); } to{ transform:translate(-6px,-125vh); } }\n\n  .col{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; text-align:center;\n    padding:calc(12px + env(safe-area-inset-top)) calc(20px + env(safe-area-inset-right)) calc(20px + env(safe-area-inset-bottom)) calc(20px + env(safe-area-inset-left)); }\n  .top{ width:100%; max-width:520px; height:58px; display:flex; align-items:center; justify-content:space-between; flex-shrink:0; }\n  .top .side{ width:112px; display:flex; }\n  .lbl{ font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; opacity:.62; }\n  .glass{ border:1px solid rgba(255,255,255,.16); background:rgba(255,255,255,.12); color:inherit;\n    -webkit-backdrop-filter:blur(18px); backdrop-filter:blur(18px); }\n  .lite .glass{ border-color:rgba(0,0,0,.09); background:rgba(255,255,255,.66); }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; } button:active{ transform:scale(.96); }\n  .big{ height:58px; min-width:58px; border-radius:99px; padding:0 22px; font-size:16.5px; font-weight:750;\n    display:inline-flex; align-items:center; justify-content:center; gap:9px; }\n  #bDone{ opacity:0; pointer-events:none; transition:opacity .8s ease; }\n  .run #bDone{ opacity:1; pointer-events:auto; }\n\n  .mid{ flex:1; min-height:0; width:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; }\n  .well{ position:relative; width:var(--s,260px); height:var(--s,260px); flex-shrink:0; display:flex; align-items:center; justify-content:center; }\n  .well::before{ content:\"\"; position:absolute; inset:0; border-radius:50%; border:1.5px dashed currentColor; opacity:.14; }   /* how big the bubble gets */\n  .bubble{ width:100%; height:100%; border-radius:50%; display:flex; align-items:center; justify-content:center; transform:scale(.7); will-change:transform;\n    background:radial-gradient(circle at 34% 28%, hsl(var(--h) 100% 90%), hsl(var(--h) 85% 66%) 42%, hsl(calc(var(--h) + 18) 72% 50%) 100%);\n    box-shadow:0 0 80px hsl(var(--h) 90% 60% / .38), inset 0 0 0 1.5px rgba(255,255,255,.35), inset -14px -18px 40px hsl(calc(var(--h) + 26) 70% 34% / .35); }\n  .lite .bubble{ box-shadow:0 22px 56px hsl(var(--h) 70% 42% / .28), inset 0 0 0 1.5px rgba(255,255,255,.6), inset -14px -18px 40px hsl(calc(var(--h) + 26) 70% 40% / .22); }\n  .bubble::before{ content:\"\"; position:absolute; left:20%; top:14%; width:26%; height:16%; border-radius:50%; background:rgba(255,255,255,.55); filter:blur(5px); transform:rotate(-28deg); }\n  .face{ font-size:calc(var(--s,260px) * .24); line-height:1; position:relative; }\n\n  .word{ font-size:28px; font-weight:800; letter-spacing:-.01em; margin-top:26px; min-height:36px; flex-shrink:0; }\n  .word.swap{ animation:swap .6s ease both; }\n  @keyframes swap{ from{ opacity:0; transform:translateY(8px); } to{ opacity:1; transform:none; } }\n  .meta{ font-size:14px; opacity:.62; margin-top:6px; min-height:20px; max-width:300px; line-height:1.35; flex-shrink:0; font-variant-numeric:tabular-nums; }\n\n  .ctl{ width:100%; max-width:380px; flex-shrink:0; }\n  .chips{ display:flex; justify-content:center; gap:8px; margin-bottom:14px; }\n  .chips button{ height:56px; flex:1; max-width:120px; border-radius:20px; font-size:15px; font-weight:750; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:1px; }\n  .chips button small{ font-size:11px; font-weight:600; opacity:.6; font-variant-numeric:tabular-nums; }\n  .chips button.hot{ background:#fff; border-color:#fff; color:#0b0b10; }\n  .lite .chips button.hot{ background:#15151a; border-color:#15151a; color:#fff; }\n  .run .chips{ visibility:hidden; }          /* keeps its room, so the bubble doesn't jump on Start */\n  .go{ width:100%; height:60px; border-radius:99px; border:none; font-size:18px; font-weight:750; background:#fff; color:#0b0b10;\n    box-shadow:0 10px 30px rgba(0,0,0,.3); display:flex; align-items:center; justify-content:center; gap:9px; }\n  .lite .go{ background:#15151a; color:#fff; box-shadow:0 10px 26px rgba(20,20,40,.22); }\n  .run .go{ background:rgba(255,255,255,.12); color:inherit; border:1px solid rgba(255,255,255,.16); box-shadow:none;\n    -webkit-backdrop-filter:blur(18px); backdrop-filter:blur(18px); }\n  .lite.run .go{ background:rgba(255,255,255,.66); border-color:rgba(0,0,0,.09); color:#15151a; }\n\n  @media (max-width:340px){ .word{ font-size:24px; margin-top:18px; } .chips button{ font-size:14px; } }\n  @media (max-height:520px){                       /* phone on its side: bubble left, words and buttons right */\n    .mid{ flex-direction:row; justify-content:center; gap:26px; padding:0 calc(min(280px,36vw) + 22px) 0 2vw; }\n    .word{ margin-top:0; font-size:24px; } .words{ text-align:left; min-width:150px; } .meta{ max-width:200px; }\n    .ctl{ position:absolute; right:calc(20px + env(safe-area-inset-right)); top:50%; transform:translateY(-50%); width:min(280px,36vw); }\n    .chips{ margin-bottom:12px; } .go{ height:56px; font-size:16.5px; }\n  }\n  @media (prefers-reduced-motion:reduce){ .word.swap{ animation:none; } .stage{ transition:none; } .rise{ display:none; } }\n  @media (max-width:340px){ .top .side{ width:60px; } #bDone{ padding:0; width:56px; } #bDone span{ display:none; } }\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-play\" viewBox=\"0 0 24 24\"><path d=\"M8 5.5v13a1 1 0 0 0 1.52.85l10.4-6.5a1 1 0 0 0 0-1.7L9.52 4.65A1 1 0 0 0 8 5.5z\"/></symbol>\n  <symbol id=\"i-stop\" viewBox=\"0 0 24 24\"><rect x=\"6\" y=\"6\" width=\"12\" height=\"12\" rx=\"2.6\"/></symbol>\n  <symbol id=\"i-close\" viewBox=\"0 0 24 24\"><path d=\"M6.4 5a1 1 0 0 0-1.4 1.4L10.6 12 5 17.6A1 1 0 0 0 6.4 19l5.6-5.6 5.6 5.6a1 1 0 0 0 1.4-1.4L13.4 12 19 6.4A1 1 0 0 0 17.6 5L12 10.6z\"/></symbol>\n</defs></svg>\n\n<div class=\"stage\" id=\"stage\">\n  <div class=\"bg d\"></div><div class=\"bg l\"></div>\n  <div class=\"rise\" aria-hidden=\"true\">\n    <i style=\"left:12%;width:22px;height:22px;animation-duration:26s;animation-delay:-4s\"></i>\n    <i style=\"left:34%;width:12px;height:12px;animation-duration:34s;animation-delay:-19s\"></i>\n    <i style=\"left:58%;width:30px;height:30px;animation-duration:30s;animation-delay:-11s\"></i>\n    <i style=\"left:76%;width:16px;height:16px;animation-duration:38s;animation-delay:-27s\"></i>\n    <i style=\"left:90%;width:24px;height:24px;animation-duration:28s;animation-delay:-16s\"></i>\n  </div>\n  <div class=\"col\">\n    <div class=\"top\">\n      <div class=\"side\"><button class=\"glass big\" id=\"bDone\" aria-label=\"Stop\"><svg class=\"i\"><use href=\"#i-close\"/></svg><span>Done</span></button></div>\n      <div class=\"lbl\">Bubble Breathing</div>\n      <div class=\"side\"></div>\n    </div>\n    <div class=\"mid\">\n      <div class=\"well\"><div class=\"bubble\" id=\"bubble\"><span class=\"face\" id=\"face\">😌</span></div></div>\n      <div class=\"words\">\n        <div class=\"word\" id=\"word\">Ready?</div>\n        <div class=\"meta\" id=\"count\">Grow big as you breathe in, shrink as you breathe out</div>\n      </div>\n    </div>\n    <div class=\"ctl\">\n      <div class=\"chips\" id=\"modes\"></div>\n      <button class=\"go\" id=\"go\"><svg class=\"i\"><use href=\"#i-play\"/></svg><span>Start</span></button>\n    </div>\n  </div>\n</div>\n\n<script>\nfunction el(i){ return document.getElementById(i); }\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction haptic(s){ if (window.myllmHaptic) try { myllmHaptic(s); } catch(e){} }\n\n/* [inhale, hold-in, exhale, hold-out] seconds */\nvar MODES = [[\"Calm\",[4,1,4,1],\"😌\"], [\"Relax\",[4,2,6,1],\"😊\"], [\"Sleepy\",[4,7,8,0],\"😴\"]];\nvar HUES = [204, 212, 232, 212];                       /* in · hold · out · hold */\nvar INTRO = \"Grow big as you breathe in, shrink as you breathe out\";\nvar mode = 0, running = false, t0 = 0, raf = null, breaths = 0, lastPhase = -1, lastTxt = \"\";\nvar bubble = el(\"bubble\"), face = el(\"face\"), word = el(\"word\"), countEl = el(\"count\");\n\n/* ---------- look ---------- */\nfunction isLight(){ return !(window.matchMedia && matchMedia(\"(prefers-color-scheme: dark)\").matches); }\n/* A session takes the whole display and dims the room. Where MyLLM can't hide\n   its own title bar, a dark stage under a white bar looks cut in half — so in\n   light mode, without myllmImmersive, the stage stays light. */\nfunction syncLook(){\n  var s = el(\"stage\");\n  s.classList.toggle(\"lite\", isLight() && !(running && window.myllmImmersive));\n  s.classList.toggle(\"run\", running);\n}\nfunction syncChrome(){\n  if (!window.myllmImmersive) return;\n  try { myllmImmersive(running, {keepAwake:running}).catch(function(){}); } catch(_){}   /* nobody touches the screen while breathing */\n}\nfunction setHue(h){ el(\"stage\").style.setProperty(\"--h\", String(h)); }\nfunction fit(){\n  var m = document.querySelector(\".mid\"), wide = window.innerHeight <= 520;\n  var s = wide ? Math.min(m.clientHeight - 8, 300) : Math.min(m.clientWidth * .78, m.clientHeight - 110, 320);\n  el(\"stage\").style.setProperty(\"--s\", Math.max(120, Math.floor(s)) + \"px\");\n}\nfunction say(text){\n  if (text === lastTxt) return;\n  lastTxt = text; word.textContent = text;\n  word.classList.remove(\"swap\"); void word.offsetWidth; word.classList.add(\"swap\");\n}\n\nfunction renderModes(){\n  var M = el(\"modes\"); M.innerHTML = \"\";\n  MODES.forEach(function(m, i){\n    var b = document.createElement(\"button\"), p = m[1];\n    b.className = \"glass\" + (i === mode ? \" hot\" : \"\");\n    b.innerHTML = m[0] + \"<small>\" + p.filter(function(x){ return x > 0; }).join(\" · \") + \"</small>\";\n    b.onclick = function(){ if (running) return; mode = i; haptic(\"selection\"); renderModes(); };\n    M.appendChild(b);\n  });\n}\n\n/* ---------- session ---------- */\nfunction cycleLen(){ var p = MODES[mode][1]; return p[0] + p[1] + p[2] + p[3]; }\nfunction ease(x){ return 0.5 - 0.5 * Math.cos(Math.PI * x); }   /* smooth in/out */\nfunction frame(now){\n  if (!running) return;\n  var p = MODES[mode][1], L = cycleLen();\n  var t = ((now - t0) / 1000) % L, phase, frac, scale, txt;\n  if (t < p[0]){ phase = 0; frac = t / p[0]; scale = 0.55 + 0.45 * ease(frac); txt = \"Breathe in…\"; }\n  else if (t < p[0] + p[1]){ phase = 1; scale = 1; txt = \"Hold\"; }\n  else if (t < p[0] + p[1] + p[2]){ phase = 2; frac = (t - p[0] - p[1]) / p[2]; scale = 1 - 0.45 * ease(frac); txt = \"Breathe out…\"; }\n  else { phase = 3; scale = 0.55; txt = \"Hold\"; }\n  if (p[1] === 0 && phase === 1) phase = 2;\n  bubble.style.transform = \"scale(\" + scale.toFixed(4) + \")\";\n  say(txt);\n  if (phase !== lastPhase){\n    lastPhase = phase; haptic(phase === 0 ? \"medium\" : phase === 2 ? \"soft\" : \"selection\");\n    setHue(HUES[phase]);\n    if (phase === 0){ breaths++; countEl.textContent = breaths + \" breath\" + (breaths === 1 ? \"\" : \"s\"); }\n    face.textContent = phase === 0 ? \"🙂\" : phase === 2 ? \"😮\" : MODES[mode][2];\n  }\n  raf = requestAnimationFrame(frame);\n}\nfunction start(){\n  running = true; breaths = 0; lastPhase = -1; t0 = performance.now(); haptic(\"light\");\n  el(\"go\").innerHTML = '<svg class=\"i\"><use href=\"#i-stop\"/></svg><span>Stop</span>';\n  countEl.textContent = \"\";\n  syncLook(); syncChrome(); fit();\n  raf = requestAnimationFrame(frame);\n}\nfunction stop(){\n  if (!running) return;\n  running = false; if (raf) cancelAnimationFrame(raf);\n  bubble.style.transition = \"transform 1.4s ease\"; bubble.style.transform = \"scale(0.7)\";\n  setTimeout(function(){ bubble.style.transition = \"\"; }, 1500);\n  face.textContent = \"😌\"; setHue(212);\n  el(\"go\").innerHTML = '<svg class=\"i\"><use href=\"#i-play\"/></svg><span>Start</span>';\n  if (breaths > 1){ say(\"Well done\"); countEl.textContent = (breaths - 1) + \" breath\" + (breaths === 2 ? \"\" : \"s\"); }\n  else { say(\"Ready?\"); countEl.textContent = INTRO; }\n  renderModes(); syncLook(); syncChrome(); fit();\n}\nel(\"go\").onclick = function(){ if (running) stop(); else start(); };\nel(\"bDone\").onclick = stop;\n\ndocument.addEventListener(\"visibilitychange\", function(){ if (document.hidden) stop(); });   /* leaving ends the session and lets the screen sleep */\nif (window.matchMedia){\n  var mq = matchMedia(\"(prefers-color-scheme: dark)\");\n  if (mq.addEventListener) mq.addEventListener(\"change\", syncLook); else if (mq.addListener) mq.addListener(syncLook);\n}\nwindow.addEventListener(\"resize\", fit);\n\n/* ---------- boot ---------- */\nfit(); syncLook(); renderModes();\n</script></body></html>\n", "kind": "html", "iconSymbol": "lungs.fill", "iconColor": "blue"}