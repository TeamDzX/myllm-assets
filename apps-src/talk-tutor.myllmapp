{"name": "Talk Tutor", "kind": "html", "iconSymbol": "bubble.left.and.text.bubble.right.fill", "iconColor": "purple", "html": "<!doctype html>\n<!--\n  Talk Tutor — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Talk Tutor</title>\n<style>\n  :root { color-scheme: light dark; }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111);\n    max-width:600px; margin:0 auto; min-height:100dvh;\n    padding:14px 14px calc(76px + env(safe-area-inset-bottom));\n  }\n  h1{ font-size:21px; font-weight:800; margin:2px 2px 10px; display:flex; align-items:center; gap:8px; }\n  h1 .flag{ font-size:24px; }\n  h1 small{ font-size:12px; font-weight:650; color:var(--myllm-muted,#8a8a8e); margin-left:auto; }\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--myllm-muted,#8a8a8e); margin:16px 2px 9px; }\n\n  .card{ background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8); border-radius:18px; padding:14px; margin-bottom:12px; }\n  .status{ text-align:center; font-size:13.5px; color:var(--myllm-muted,#8a8a8e); padding:18px 12px; line-height:1.6; }\n  .note{ font-size:12.5px; color:var(--myllm-muted,#8a8a8e); margin:8px 2px; line-height:1.5; }\n\n  /* Tab bar */\n  .tabs{\n    position:fixed; bottom:0; left:50%; transform:translateX(-50%); width:100%; max-width:600px;\n    display:flex; background:var(--myllm-surface,#fff); border-top:1px solid var(--myllm-border,#e3e3e8);\n    padding:6px 8px calc(6px + env(safe-area-inset-bottom)); z-index:8;\n  }\n  .tabs button{ flex:1; border:none; background:none; color:var(--myllm-muted,#8a8a8e); font-size:10.5px; font-weight:700; padding:5px 0; }\n  .tabs button .ti{ display:block; font-size:21px; margin-bottom:2px; filter:grayscale(1) opacity(.55); }\n  .tabs button.hot{ color:var(--myllm-accent,#0a84ff); }\n  .tabs button.hot .ti{ filter:none; }\n  .tabs button b.badge{ position:absolute; margin-left:14px; margin-top:-4px; background:#ff453a; color:#fff; font-size:10px; border-radius:99px; padding:1px 5px; }\n\n  /* Chips */\n  .chips{ display:flex; gap:7px; overflow-x:auto; -webkit-overflow-scrolling:touch; padding:2px 2px 10px; scrollbar-width:none; }\n  .chips::-webkit-scrollbar{ display:none; }\n  .chips button{ border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-surface,#fff); color:var(--myllm-text,#111); border-radius:99px; padding:7px 13px; font-size:13px; font-weight:650; white-space:nowrap; flex-shrink:0; }\n  .chips button.hot{ background:var(--myllm-accent,#0a84ff); border-color:var(--myllm-accent,#0a84ff); color:#fff; }\n\n  /* Chat */\n  #chat{ padding-bottom:4px; }\n  .msg{ max-width:86%; margin-bottom:10px; }\n  .msg .bub{ border-radius:17px; padding:10px 13px; font-size:15.5px; line-height:1.45; }\n  .msg.tutor .bub{ background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8); border-bottom-left-radius:6px; }\n  .msg.me{ margin-left:auto; }\n  .msg.me .bub{ background:var(--myllm-accent,#0a84ff); color:#fff; border-bottom-right-radius:6px; }\n  .msg .xtra{ font-size:12.5px; color:var(--myllm-muted,#8a8a8e); line-height:1.45; padding:7px 6px 0; display:none; }\n  .msg.open .xtra{ display:block; }\n  .msg .fix{ font-size:12.5px; line-height:1.45; padding:6px 6px 0; color:#ff9f0a; display:none; }\n  .msg.open .fix{ display:block; }\n  .msg .row{ display:flex; align-items:center; gap:9px; }\n  .msg .spk{ border:none; background:none; font-size:17px; padding:4px; flex-shrink:0; }\n  .typing{ color:var(--myllm-muted,#8a8a8e); font-size:13px; padding:2px 6px 10px; display:none; }\n\n  /* Composer */\n  .composer{ display:flex; gap:8px; margin-top:4px; }\n  .composer input{ flex:1; font-size:16px; padding:11px 13px; border-radius:14px; border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-surface,#fff); color:var(--myllm-text,#111); }\n  .composer button{ border:none; border-radius:14px; width:46px; font-size:18px; background:var(--myllm-accent,#0a84ff); color:#fff; flex-shrink:0; }\n  .composer button.alt{ background:var(--myllm-surface,#fff); color:var(--myllm-text,#111); border:1px solid var(--myllm-border,#e3e3e8); }\n  .helprow{ display:flex; gap:7px; margin-top:8px; flex-wrap:wrap; }\n  .helprow button{ border:1px dashed var(--myllm-border,#c9c9cf); background:none; color:var(--myllm-muted,#6a6a6e); border-radius:12px; padding:7px 11px; font-size:12.5px; text-align:left; }\n\n  .tools{ display:flex; gap:7px; align-items:center; margin-bottom:9px; flex-wrap:wrap; }\n  .tools button{ border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-surface,#fff); color:var(--myllm-text,#111); border-radius:99px; padding:5px 11px; font-size:12px; font-weight:650; }\n  .tools button.hot{ background:var(--myllm-accent,#0a84ff); border-color:var(--myllm-accent,#0a84ff); color:#fff; }\n\n  /* Practice */\n  .pcard{ text-align:center; padding:22px 16px; }\n  .pcard img{ width:132px; height:132px; border-radius:20px; object-fit:cover; margin-bottom:12px; background:var(--myllm-bg,#f2f2f7); }\n  .pcard .front{ font-size:17px; font-weight:650; color:var(--myllm-muted,#8a8a8e); }\n  .pcard .back{ font-size:27px; font-weight:800; margin-top:8px; display:none; }\n  .pcard.flip .back{ display:block; }\n  .pcard .hintw{ font-size:13px; color:var(--myllm-muted,#8a8a8e); margin-top:9px; display:none; line-height:1.5; }\n  .pcard.flip .hintw{ display:block; }\n  .grades{ display:flex; gap:8px; margin-top:14px; }\n  .grades button{ flex:1; border:none; border-radius:13px; padding:13px 6px; font-size:14px; font-weight:750; color:#fff; }\n  .g-again{ background:#ff453a; } .g-good{ background:var(--myllm-accent,#0a84ff); } .g-easy{ background:#30d158; }\n  .reveal{ width:100%; border:none; border-radius:13px; padding:13px; font-size:15px; font-weight:750; background:var(--myllm-accent,#0a84ff); color:#fff; margin-top:14px; }\n  .prog{ font-size:12px; color:var(--myllm-muted,#8a8a8e); text-align:center; margin-bottom:8px; }\n\n  /* Words */\n  .vrow{ display:flex; align-items:center; gap:11px; padding:9px 2px; border-bottom:1px solid var(--myllm-border,#e3e3e8); }\n  .vrow:last-child{ border-bottom:none; }\n  .vrow img{ width:40px; height:40px; border-radius:9px; object-fit:cover; background:var(--myllm-bg,#f2f2f7); flex-shrink:0; }\n  .vrow .noimg{ width:40px; height:40px; border-radius:9px; background:var(--myllm-bg,#f2f2f7); display:flex; align-items:center; justify-content:center; font-size:18px; flex-shrink:0; }\n  .vrow .vi{ flex:1; min-width:0; }\n  .vrow .w{ font-size:15px; font-weight:700; }\n  .vrow .e{ font-size:12px; color:var(--myllm-muted,#8a8a8e); }\n  .vrow .lvl{ font-size:10.5px; font-weight:800; border-radius:6px; padding:2px 6px; flex-shrink:0; }\n  .lvl.new{ background:rgba(10,132,255,.14); color:var(--myllm-accent,#0a84ff); }\n  .lvl.learning{ background:rgba(255,159,10,.16); color:#ff9f0a; }\n  .lvl.known{ background:rgba(48,209,88,.16); color:#30d158; }\n  .vrow .del{ border:none; background:none; color:var(--myllm-muted,#8a8a8e); font-size:15px; padding:6px; }\n  .packrow{ display:flex; align-items:center; gap:10px; padding:9px 2px; border-bottom:1px solid var(--myllm-border,#e3e3e8); }\n  .packrow:last-child{ border-bottom:none; }\n  .packrow .pi{ flex:1; }\n  .packrow .t{ font-size:14.5px; font-weight:700; }\n  .packrow .c{ font-size:12px; color:var(--myllm-muted,#8a8a8e); }\n  .packrow button{ border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111); border-radius:10px; padding:8px 13px; font-size:13px; font-weight:650; }\n  .packrow button.done{ color:#30d158; border-color:#30d158; background:none; }\n  .search{ width:100%; font-size:15px; padding:10px 12px; border-radius:12px; border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-surface,#fff); color:var(--myllm-text,#111); margin-bottom:10px; }\n\n  /* Me */\n  .stats{ display:grid; grid-template-columns:1fr 1fr 1fr; gap:9px; }\n  .stat{ background:var(--myllm-bg,#f2f2f7); border-radius:14px; padding:13px 8px; text-align:center; }\n  .stat b{ display:block; font-size:23px; font-variant-numeric:tabular-nums; }\n  .stat span{ font-size:11px; color:var(--myllm-muted,#8a8a8e); font-weight:650; }\n  .optrow{ display:flex; align-items:center; justify-content:space-between; gap:10px; padding:10px 0; border-bottom:1px solid var(--myllm-border,#e3e3e8); }\n  .optrow:last-child{ border-bottom:none; }\n  .optrow label{ font-size:14px; font-weight:650; }\n  .seg{ display:flex; background:var(--myllm-bg,#f2f2f7); border-radius:10px; padding:3px; }\n  .seg button{ border:none; background:none; color:var(--myllm-text,#111); border-radius:8px; padding:6px 11px; font-size:12.5px; font-weight:650; }\n  .seg button.hot{ background:var(--myllm-surface,#fff); box-shadow:0 1px 4px rgba(0,0,0,.12); }\n  .switch{ width:46px; height:28px; border-radius:99px; border:none; background:var(--myllm-border,#d5d5db); position:relative; }\n  .switch.on{ background:#30d158; }\n  .switch i{ position:absolute; top:3px; left:3px; width:22px; height:22px; border-radius:50%; background:#fff; transition:left .18s; }\n  .switch.on i{ left:21px; }\n\n  /* Onboarding */\n  .ob{ position:fixed; inset:0; background:var(--myllm-bg,#f2f2f7); z-index:20; overflow-y:auto; padding:26px 20px calc(26px + env(safe-area-inset-bottom)); }\n  .ob .inner{ max-width:420px; margin:0 auto; }\n  .ob h1{ font-size:26px; margin:12px 0 4px; }\n  .ob p.sub{ font-size:14.5px; color:var(--myllm-muted,#8a8a8e); line-height:1.55; margin-bottom:20px; }\n  .langbtn{ display:flex; align-items:center; gap:13px; width:100%; border:2px solid var(--myllm-border,#e3e3e8); background:var(--myllm-surface,#fff); color:var(--myllm-text,#111); border-radius:16px; padding:14px; font-size:16px; font-weight:700; margin-bottom:10px; }\n  .langbtn.hot{ border-color:var(--myllm-accent,#0a84ff); }\n  .langbtn .f{ font-size:27px; }\n  .langbtn small{ display:block; font-size:12px; font-weight:500; color:var(--myllm-muted,#8a8a8e); }\n  .ob .go{ width:100%; border:none; border-radius:15px; padding:15px; font-size:16px; font-weight:750; background:var(--myllm-accent,#0a84ff); color:#fff; margin-top:14px; }\n  .ob .go:disabled{ opacity:.4; }\n\n  .toast{ position:fixed; left:50%; bottom:calc(88px + env(safe-area-inset-bottom)); transform:translateX(-50%) translateY(20px); background:var(--myllm-text,#111); color:var(--myllm-bg,#fff); font-size:13.5px; font-weight:650; padding:11px 18px; border-radius:99px; transition:transform .25s, opacity .25s; z-index:22; white-space:nowrap; opacity:0; visibility:hidden; pointer-events:none; }\n  .toast.show{ transform:translateX(-50%) translateY(0); opacity:1; visibility:visible; }\n</style>\n<style>:root{--build-id:\"c987d5381b\";}</style>\n</head>\n<body>\n\n<!-- AI busy cog (house convention) -->\n<style>\n.myllm-ai-busy{position:fixed;top:calc(10px + env(safe-area-inset-top));left:50%;transform:translateX(-50%) translateY(-60px);display:flex;gap:8px;align-items:center;background:var(--myllm-surface,#fff);border:1px solid var(--myllm-border,#e3e3e8);border-radius:99px;padding:8px 15px;font-size:13px;font-weight:650;z-index:30;opacity:0;transition:all .25s;box-shadow:0 4px 18px rgba(0,0,0,.14)}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n</style>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\">⚙️</span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n\n<div class=\"ob\" id=\"ob\" style=\"display:none\">\n  <div class=\"inner\">\n    <div style=\"font-size:44px\">🗣️</div>\n    <h1>Talk Tutor</h1>\n    <p class=\"sub\">A patient conversation partner that lives on your phone. Speak, make mistakes, get gently corrected — nobody's listening but you.</p>\n    <div id=\"obLangs\"></div>\n    <h2>Your level</h2>\n    <div class=\"chips\" id=\"obLevels\"></div>\n    <button class=\"go\" id=\"obGo\" onclick=\"finishOb()\" disabled>Start talking</button>\n  </div>\n</div>\n\n<h1><span class=\"flag\" id=\"hFlag\">🗣️</span> Talk Tutor <small id=\"hStreak\"></small></h1>\n\n<!-- TALK -->\n<div class=\"tab\" id=\"tab-talk\">\n  <div class=\"chips\" id=\"scenarios\"></div>\n  <div class=\"tools\">\n    <button id=\"autoBtn\" onclick=\"toggleAuto()\">🔊 Auto-speak</button>\n    <button id=\"slowBtn\" onclick=\"toggleSlow()\">🐢 Slow</button>\n    <button onclick=\"newChat()\">↺ New chat</button>\n  </div>\n  <div id=\"chat\"></div>\n  <div class=\"typing\" id=\"typing\">✍️ …</div>\n  <div id=\"aiGate\" class=\"card\" style=\"display:none\">\n    <p class=\"status\">Conversations need the on-device AI.<br>Enable AI in MyLLM's Settings, then come back — your tutor is waiting.</p>\n  </div>\n  <div class=\"composer\" id=\"composer\">\n    <button class=\"alt\" id=\"micBtn\" onclick=\"dictate()\" style=\"display:none\">🎙️</button>\n    <input id=\"say\" type=\"text\" autocomplete=\"off\" autocapitalize=\"sentences\" placeholder=\"\">\n    <button onclick=\"send()\" id=\"sendBtn\">➤</button>\n  </div>\n  <div class=\"helprow\" id=\"helps\" style=\"display:none\"></div>\n  <p class=\"note\" id=\"talkHint\">Tap any tutor bubble for the English translation. Orange lines are gentle corrections of what you wrote.</p>\n</div>\n\n<!-- PRACTICE -->\n<div class=\"tab\" id=\"tab-practice\" style=\"display:none\">\n  <div class=\"prog\" id=\"pProg\"></div>\n  <div id=\"pArea\"></div>\n</div>\n\n<!-- WORDS -->\n<div class=\"tab\" id=\"tab-words\" style=\"display:none\">\n  <input class=\"search\" id=\"vq\" type=\"search\" placeholder=\"Search your words…\" oninput=\"renderWords()\">\n  <div class=\"card\" id=\"vlist\"></div>\n  <h2>Starter packs <span style=\"font-weight:500;text-transform:none;letter-spacing:0\">— with pictures</span></h2>\n  <div class=\"card\" id=\"packs\"></div>\n</div>\n\n<!-- ME -->\n<div class=\"tab\" id=\"tab-me\" style=\"display:none\">\n  <div class=\"card\"><div class=\"stats\">\n    <div class=\"stat\"><b id=\"sStreak\">0</b><span>day streak</span></div>\n    <div class=\"stat\"><b id=\"sMins\">0</b><span>minutes</span></div>\n    <div class=\"stat\"><b id=\"sKnown\">0</b><span>words known</span></div>\n  </div></div>\n  <div class=\"card\">\n    <div class=\"optrow\"><label>Language</label><div class=\"seg\" id=\"meLang\"></div></div>\n    <div class=\"optrow\"><label>Level</label><div class=\"seg\" id=\"meLevel\"></div></div>\n    <div class=\"optrow\"><label>Auto-speak replies</label><button class=\"switch\" id=\"swAuto\" onclick=\"toggleAuto()\"><i></i></button></div>\n    <div class=\"optrow\"><label>Slow speech</label><button class=\"switch\" id=\"swSlow\" onclick=\"toggleSlow()\"><i></i></button></div>\n  </div>\n  <p class=\"note\">Everything — your conversations, mistakes and progress — stays on this phone. Switching language keeps each language's words and progress separate.</p>\n</div>\n\n<div class=\"tabs\" id=\"tabs\"></div>\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\nvar ASK = window.myllmAsk || null;\nvar TRANSCRIBE = window.myllmTranscribe || null;\nvar store = window.myllmStorage || {getItem:function(){return Promise.resolve(null)}, setItem:function(){return Promise.resolve()}};\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s==null?'':s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\"); }\nfunction toast(m){ var t=el(\"toast\"); t.textContent=m; t.classList.add(\"show\"); clearTimeout(t._t); t._t=setTimeout(function(){t.classList.remove(\"show\");},2200); }\nfunction today(){ return new Date().toISOString().slice(0,10); }\n\nvar IMG_BASE = \"https://raw.githubusercontent.com/TeamDzX/hanyu-packs/main/images/flashcards/\";\nvar PACKS = {\"es\":[{\"id\":\"fruits\",\"title\":\"Fruits\",\"img\":\"fruits\",\"cards\":[{\"w\":\"la manzana\",\"en\":\"apple\",\"i\":0},{\"w\":\"el plátano\",\"en\":\"banana\",\"i\":1},{\"w\":\"la naranja\",\"en\":\"orange\",\"i\":2},{\"w\":\"las uvas\",\"en\":\"grapes\",\"i\":3},{\"w\":\"la sandía\",\"en\":\"watermelon\",\"i\":4},{\"w\":\"la fresa\",\"en\":\"strawberry\",\"i\":5},{\"w\":\"el melocotón\",\"en\":\"peach\",\"i\":6},{\"w\":\"la pera\",\"en\":\"pear\",\"i\":7},{\"w\":\"el mango\",\"en\":\"mango\",\"i\":8},{\"w\":\"la piña\",\"en\":\"pineapple\",\"i\":9},{\"w\":\"la cereza\",\"en\":\"cherry\",\"i\":10},{\"w\":\"el limón\",\"en\":\"lemon\",\"i\":11},{\"w\":\"el coco\",\"en\":\"coconut\",\"i\":12},{\"w\":\"el arándano\",\"en\":\"blueberry\",\"i\":13},{\"w\":\"el pomelo\",\"en\":\"pomelo\",\"i\":14}]},{\"id\":\"vegetables\",\"title\":\"Vegetables\",\"img\":\"vegetables\",\"cards\":[{\"w\":\"el tomate\",\"en\":\"tomato\",\"i\":0},{\"w\":\"la patata\",\"en\":\"potato\",\"i\":1},{\"w\":\"la zanahoria\",\"en\":\"carrot\",\"i\":2},{\"w\":\"el repollo chino\",\"en\":\"Chinese cabbage\",\"i\":3},{\"w\":\"el pepino\",\"en\":\"cucumber\",\"i\":4},{\"w\":\"la berenjena\",\"en\":\"eggplant\",\"i\":5},{\"w\":\"la cebolla\",\"en\":\"onion\",\"i\":6},{\"w\":\"el champiñón\",\"en\":\"mushroom\",\"i\":7},{\"w\":\"el maíz\",\"en\":\"corn\",\"i\":8},{\"w\":\"el chile\",\"en\":\"chili pepper\",\"i\":9},{\"w\":\"las espinacas\",\"en\":\"spinach\",\"i\":10},{\"w\":\"la calabaza\",\"en\":\"pumpkin\",\"i\":11},{\"w\":\"el pimiento verde\",\"en\":\"green pepper\",\"i\":12},{\"w\":\"el ajo\",\"en\":\"garlic\",\"i\":13},{\"w\":\"las judías verdes\",\"en\":\"green beans\",\"i\":14}]},{\"id\":\"food\",\"title\":\"Food & Drinks\",\"img\":\"food\",\"cards\":[{\"w\":\"el arroz\",\"en\":\"rice (cooked)\",\"i\":0},{\"w\":\"los fideos\",\"en\":\"noodles\",\"i\":1},{\"w\":\"el pan\",\"en\":\"bread\",\"i\":2},{\"w\":\"la fruta\",\"en\":\"fruit\",\"i\":3},{\"w\":\"la manzana\",\"en\":\"apple\",\"i\":4},{\"w\":\"el plátano\",\"en\":\"banana\",\"i\":5},{\"w\":\"la naranja\",\"en\":\"orange\",\"i\":6},{\"w\":\"las verduras\",\"en\":\"vegetables\",\"i\":7},{\"w\":\"la carne\",\"en\":\"meat\",\"i\":8},{\"w\":\"el pollo\",\"en\":\"chicken meat\",\"i\":9},{\"w\":\"la carne de res\",\"en\":\"beef\",\"i\":10},{\"w\":\"el pescado\",\"en\":\"fish meat\",\"i\":11},{\"w\":\"el agua\",\"en\":\"water\",\"i\":12},{\"w\":\"el té\",\"en\":\"tea\",\"i\":13},{\"w\":\"el café\",\"en\":\"coffee\",\"i\":14},{\"w\":\"la leche\",\"en\":\"milk\",\"i\":15},{\"w\":\"el zumo\",\"en\":\"juice\",\"i\":16}]},{\"id\":\"drinks\",\"title\":\"Drinks\",\"img\":\"drinks\",\"cards\":[{\"w\":\"el agua\",\"en\":\"water\",\"i\":0},{\"w\":\"el té\",\"en\":\"t