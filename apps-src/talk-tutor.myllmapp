"w\":\"der Reiseführer\",\"en\":\"tour guide\",\"i\":15},{\"w\":\"reisen\",\"en\":\"to travel, tourism\",\"i\":16},{\"w\":\"die Karte\",\"en\":\"map\",\"i\":17}]},{\"id\":\"home\",\"title\":\"House & Home\",\"img\":\"home\",\"cards\":[{\"w\":\"das Bett\",\"en\":\"bed\",\"i\":0},{\"w\":\"der Tisch\",\"en\":\"table\",\"i\":1},{\"w\":\"der Stuhl\",\"en\":\"chair\",\"i\":2},{\"w\":\"das Sofa\",\"en\":\"sofa\",\"i\":3},{\"w\":\"die Tür\",\"en\":\"door\",\"i\":4},{\"w\":\"das Fenster\",\"en\":\"window\",\"i\":5},{\"w\":\"die Lampe\",\"en\":\"lamp\",\"i\":6},{\"w\":\"der Kühlschrank\",\"en\":\"refrigerator\",\"i\":7},{\"w\":\"der Fernseher\",\"en\":\"television\",\"i\":8},{\"w\":\"der Spiegel\",\"en\":\"mirror\",\"i\":9},{\"w\":\"die Uhr\",\"en\":\"clock\",\"i\":10},{\"w\":\"das Bücherregal\",\"en\":\"bookshelf\",\"i\":11},{\"w\":\"die Küche\",\"en\":\"kitchen\",\"i\":12},{\"w\":\"das Schlafzimmer\",\"en\":\"bedroom\",\"i\":13},{\"w\":\"das Badezimmer\",\"en\":\"bathroom\",\"i\":14}]},{\"id\":\"town\",\"title\":\"Around Town\",\"img\":\"town\",\"cards\":[{\"w\":\"die Schule\",\"en\":\"school\",\"i\":0},{\"w\":\"das Krankenhaus\",\"en\":\"hospital\",\"i\":1},{\"w\":\"die Bank\",\"en\":\"bank\",\"i\":2},{\"w\":\"der Park\",\"en\":\"park\",\"i\":3},{\"w\":\"der Supermarkt\",\"en\":\"supermarket\",\"i\":4},{\"w\":\"das Restaurant\",\"en\":\"restaurant\",\"i\":5},{\"w\":\"die Bibliothek\",\"en\":\"library\",\"i\":6},{\"w\":\"das Kino\",\"en\":\"cinema\",\"i\":7},{\"w\":\"die Post\",\"en\":\"post office\",\"i\":8},{\"w\":\"der Bahnhof\",\"en\":\"train station\",\"i\":9},{\"w\":\"der Flughafen\",\"en\":\"airport\",\"i\":10},{\"w\":\"das Geschäft\",\"en\":\"shop\",\"i\":11},{\"w\":\"das Hotel\",\"en\":\"hotel\",\"i\":12},{\"w\":\"das Bürogebäude\",\"en\":\"office building\",\"i\":13},{\"w\":\"der Marktplatz\",\"en\":\"town square\",\"i\":14}]}]};\n\nvar LANGS = {\n  es: {name:\"Spanish\", flag:\"🇪🇸\", tts:\"es-ES\", tutor:\"Sofía\",\n       greet:\"¡Hola! Soy Sofía. ¿Cómo estás hoy?\", greetEn:\"Hi! I'm Sofía. How are you today?\"},\n  fr: {name:\"French\", flag:\"🇫🇷\", tts:\"fr-FR\", tutor:\"Léa\",\n       greet:\"Salut ! Moi, c'est Léa. Comment ça va aujourd'hui ?\", greetEn:\"Hi! I'm Léa. How's it going today?\"},\n  de: {name:\"German\", flag:\"🇩🇪\", tts:\"de-DE\", tutor:\"Max\",\n       greet:\"Hallo! Ich bin Max. Wie geht's dir heute?\", greetEn:\"Hello! I'm Max. How are you today?\"}\n};\nvar LEVELS = {\n  beginner:     {label:\"Beginner\",     rule:\"Use very short, simple sentences and only common everyday words. One idea per sentence.\"},\n  intermediate: {label:\"Intermediate\", rule:\"Use natural everyday conversational language, still fairly simple.\"},\n  advanced:     {label:\"Advanced\",     rule:\"Speak naturally like a native, idioms welcome.\"}\n};\nvar SCENARIOS = [\n  {id:\"free\",   label:\"💬 Free chat\",  role:\"Chat naturally about everyday life. Ask the student questions to keep them talking.\"},\n  {id:\"cafe\",   label:\"☕ At a café\",   role:\"You are a friendly waiter in a café. The student is a customer ordering.\"},\n  {id:\"dirs\",   label:\"🗺️ Directions\", role:\"You are a friendly local. The student is a tourist asking their way around.\"},\n  {id:\"shop\",   label:\"🛍️ Shopping\",   role:\"You are a shop assistant in a clothes shop. The student is browsing and buying.\"},\n  {id:\"hotel\",  label:\"🏨 Hotel\",      role:\"You are a hotel receptionist. The student is checking in and asking about the hotel.\"},\n  {id:\"meet\",   label:\"👋 New friend\", role:\"You are someone the student just met at a party. Get to know each other.\"},\n  {id:\"doctor\", label:\"🩺 Doctor\",     role:\"You are a kind doctor. The student is describing how they feel.\"},\n  {id:\"work\",   label:\"💼 Interview\",  role:\"You are a friendly interviewer. The student is interviewing for a job they like.\"}\n];\n\n/* ---------- state ---------- */\nvar S = null;          /* settings: {lang, level, auto, slow, micNoted} */\nvar vocab = [];        /* [{w,en,lang,img?,ease,ivl,due,reps}] */\nvar hist = [];         /* [{who:'t'|'m', txt, en?, fix?}] current chat (per lang) */\nvar stats = null;      /* {streak, lastDay, mins, lastTs} */\nvar scenario = SCENARIOS[0];\nvar busy = false;\nvar pQueue = [], pCard = null;\n\n/* ---------- pure helpers ---------- */\n\nfunction parseTutor(raw){\n  var out = {fix:null, say:\"\", en:null, word:null};\n  var lines = String(raw||\"\").split(/\\n+/);\n  for (var i=0;i<lines.length;i++){\n    var m = lines[i].match(/^\\s*\\**\\s*(FIX|SAY|EN|WORD)\\s*\\**\\s*[:：]\\s*(.+)$/i);\n    if (!m) continue;\n    var v = m[2].replace(/\\*+/g,\"\").trim();\n    var k = m[1].toUpperCase();\n    if (k===\"FIX\" && !/^(OK|✓|-)\\.?$/i.test(v)) out.fix = v;\n    else if (k===\"SAY\") out.say = out.say ? out.say+\" \"+v : v;\n    else if (k===\"EN\") out.en = v;\n    else if (k===\"WORD\"){\n      var p = v.split(\"|\");\n      if (p.length>=2 && p[0].trim() && p[1].trim()) out.word = {w:p[0].trim(), en:p[1].trim()};\n    }\n  }\n  if (!out.say){\n    /* model ignored the format — treat the whole reply as speech, strip stray labels */\n    out.say = String(raw||\"\").replace(/^\\s*(FIX|SAY|EN|WORD)\\s*[:：]/gim,\"\").replace(/\\*+/g,\"\").trim();\n    out.fix = null; out.en = null; out.word = null;\n  }\n  return out;\n}\n\nfunction srsGrade(card, grade){\n  /* SM-2 lite. grade: 0 again, 1 good, 2 easy */\n  if (grade === 0){\n    card.ivl = 0; card.ease = Math.max(1.3, (card.ease||2.5) - 0.2);\n  } else {\n    var e = card.ease || 2.5;\n    if (card.ivl === 0) card.ivl = grade === 2 ? 2 : 1;\n    else card.ivl = Math.max(card.ivl + 1, Math.round(card.ivl * e * (grade === 2 ? 1.3 : 1)));\n    if (grade === 2) card.ease = e + 0.1;\n  }\n  card.reps = (card.reps||0) + 1;\n  var d = new Date(); d.setDate(d.getDate() + card.ivl);\n  card.due = d.toISOString().slice(0,10);\n  return card;\n}\n\nfunction wordLevel(c){ return c.ivl >= 21 ? \"known\" : (c.reps > 0 ? \"learning\" : \"new\"); }\nfunction dueCards(){ var t = today(); return vocab.filter(function(c){ return c.lang === S.lang && c.due <= t; }); }\nfunction langWords(){ return vocab.filter(function(c){ return c.lang === S.lang; }); }\nfunction hasWord(w){ w = w.toLowerCase(); return langWords().some(function(c){ return c.w.toLowerCase() === w; }); }\n\nfunction buildPrompt(userMsg){\n  var L = LANGS[S.lang], lv = LEVELS[S.level];\n  var p = \"You are \" + L.tutor + \", a warm, encouraging \" + L.name + \" tutor. \" + scenario.role +\n    \"\\nStudent level: \" + lv.label + \". \" + lv.rule +\n    \"\\nAlways stay in \" + L.name + \" for SAY. Never break character.\\n\" +\n    \"Reply in EXACTLY this format, one item per line and nothing else:\\n\" +\n    \"FIX: corrected version of the student's message if it had mistakes, otherwise OK\\n\" +\n    \"SAY: your reply in \" + L.name + \" (1-2 short sentences, end with a question when natural)\\n\" +\n    \"EN: English translation of SAY\\n\" +\n    \"WORD: one useful \" + L.name + \" word or phrase from this exchange|its English meaning\\n\\n\" +\n    \"Conversation so far:\\n\";\n  var recent = hist.slice(-10);\n  for (var i=0;i<recent.length;i++)\n    p += (recent[i].who === \"t\" ? L.tutor : \"Student\") + \": \" + recent[i].txt + \"\\n\";\n  p += \"Student: \" + userMsg + \"\\n\";\n  return p;\n}\n\n/* ---------- speech ---------- */\n\nvar CAN_SPEAK = !!(window.speechSynthesis && window.SpeechSynthesisUtterance);\nvar spokeOnce = false;\n\n/* Tutor-appropriate voices: iOS's default voice per language is often the\n   wrong gender for our personas (Léa kept getting Thomas). Prefer known\n   voices matching each tutor, then any enhanced voice, then anything in the\n   right language. Names checked case-insensitively as substrings. */\nvar VOICE_PREF = { es: [\"mónica\",\"monica\",\"paulina\",\"marisol\"],\n                   fr: [\"amélie\",\"amelie\",\"audrey\",\"aurélie\",\"aurelie\",\"marie\",\"chantal\"],\n                   de: [\"markus\",\"viktor\",\"yannick\",\"martin\"] };\nvar voiceCache = {};\nfunction pickVoice(langKey){\n  if (voiceCache[langKey] !== undefined) return voiceCache[langKey];\n  var tts = LANGS[langKey].tts;\n  var all = [];\n  try { all = speechSynthesis.getVoices() || []; } catch(_){}\n  var inLang = all.filter(function(v){ return (v.lang||\"\").replace(\"_\",\"-\").indexOf(tts.slice(0,2)) === 0; });\n  if (!inLang.length){ voiceCache[langKey] = null; return null; }\n  var prefs = VOICE_PREF[langKey] || [];\n  var byName = null;\n  for (var i = 0; i < prefs.length && !byName; i++){\n    byName = inLang.filter(function(v){ return (v.name||\"\").toLowerCase().indexOf(prefs[i]) >= 0; })\n                   .sort(function(a,b){ return (b.localService?0:0) + ((b.name.indexOf(\"Enhanced\")>=0||b.name.indexOf(\"Premium\")>=0)?-1:0) - (((a.name.indexOf(\"Enhanced\")>=0||a.name.indexOf(\"Premium\")>=0))?-1:0); })[0] || null;\n  }\n  var enhanced = inLang.filter(function(v){ return /enhanced|premium/i.test(v.name); })[0];\n  var exact = inLang.filter(function(v){ return (v.lang||\"\").replace(\"_\",\"-\") === tts; })[0];\n  voiceCache[langKey] = byName || enhanced || exact || inLang[0];\n  return voiceCache[langKey];\n}\nif (CAN_SPEAK){\n  try { speechSynthesis.onvoiceschanged = function(){ voiceCache = {}; }; } catch(_){}\n}\n\nfunction speak(text){\n  if (!CAN_SPEAK || !text) return;\n  try{\n    speechSynthesis.cancel();\n    var u = new SpeechSynthesisUtterance(text);\n    u.lang = LANGS[S.lang].tts;\n    var v = pickVoice(S.lang);\n    if (v) u.voice = v;\n    u.rate = S.slow ? 0.68 : 0.92;\n    speechSynthesis.speak(u);\n    spokeOnce = true;\n  }catch(_){}\n}\nfunction primeSpeech(){\n  /* unlock speechSynthesis inside the user gesture before async work */\n  if (spokeOnce || !CAN_SPEAK) return;\n  try{ var u = new SpeechSynthesisUtterance(\" \"); u.volume = 0; speechSynthesis.speak(u); }catch(_){}\n}\n\n/* ---------- persistence ---------- */\n\nfunction saveAll(){\n  store.setItem(\"tt_set\", JSON.stringify(S));\n  store.setItem(\"tt_vocab\", JSON.stringify(vocab));\n  store.setItem(\"tt_stats\", JSON.stringify(stats));\n  store.setItem(\"tt_hist_\" + S.lang, JSON.stringify(hist.slice(-40)));\n}\n\nfunction tickActivity(){\n  var now = Date.now();\n  if (stats.lastTs && now - stats.lastTs < 120000) stats.mins += (now - stats.lastTs) / 60000;\n  stats.lastTs = now;\n  var t = today();\n  if (stats.lastDay !== t){\n    var y = new Date(); y.setDate(y.getDate()-1);\n    stats.streak = (stats.lastDay === y.toISOString().slice(0,10)) ? stats.streak + 1 : 1;\n    stats.lastDay = t;\n  }\n  el(\"hStreak\").textContent = \"🔥 \" + stats.streak;\n}\n\n/* ---------- chat ---------- */\n\nfunction pushMsg(m){ hist.push(m); renderMsg(m, hist.length-1); }\n\nfunction renderMsg(m, idx){\n  var d = document.createElement(\"div\");\n  d.className = \"msg \" + (m.who === \"t\" ? \"tutor\" : \"me\");\n  if (m.who === \"t\"){\n    d.innerHTML = '<div class=\"row\"><div class=\"bub\">' + esc(m.txt) + '</div>' +\n      (CAN_SPEAK ? '<button class=\"spk\" onclick=\"event.stopPropagation();speakIdx('+idx+')\">🔊</button>' : '') + '</div>' +\n      (m.en ? '<div class=\"xtra\">' + esc(m.en) + '</div>' : '');\n    d.onclick = function(){ if (m.en) d.classList.toggle(\"open\"); };\n  } else {\n    d.innerHTML = '<div class=\"bub\">' + esc(m.txt) + '</div>' +\n      (m.fix ? '<div class=\"fix\">✏️ ' + esc(m.fix) + '</div>' : '');\n    if (m.fix){ d.classList.add(\"open\"); }\n  }\n  el(\"chat\").appendChild(d);\n  d.scrollIntoView({block:\"end\"});\n}\n\nfunction renderChat(){\n  el(\"chat\").innerHTML = \"\";\n  for (var i=0;i<hist.length;i++) renderMsg(hist[i], i);\n}\n\nfunction speakIdx(i){ haptic(\"selection\"); if (hist[i]) speak(hist[i].txt); }\n\nfunction greet(){\n  var L = LANGS[S.lang];\n  pushMsg({who:\"t\", txt:L.greet, en:L.greetEn});\n  saveAll();\n}\n\nfunction newChat(){\n  haptic(\"light\");\n  hist = [];\n  el(\"chat\").innerHTML = \"\";\n  el(\"helps\").style.display = \"none\";\n  if (scenario.id === \"free\") greet();\n  else openScenario();\n}\n\nfunction pickScenario(id){\n  scenario = SCENARIOS.filter(function(s){ return s.id === id; })[0] || SCENARIOS[0];\n  renderScenarios();\n  hist = [];\n  el(\"chat\").innerHTML = \"\";\n  if (scenario.id === \"free\"){ greet(); return; }\n  openScenario();\n}\n\nfunction openScenario(){\n  if (!ASK){ greet(); return; }\n  var L = LANGS[S.lang], lv = LEVELS[S.level];\n  var p = \"You are \" + L.tutor + \", a \" + L.name + \" tutor. \" + scenario.role +\n    \"\\nStudent level: \" + lv.label + \". \" + lv.rule +\n    \"\\nOpen the role-play with your first line in \" + L.name + \".\\nReply in EXACTLY this format:\\n\" +\n    \"SAY: your opening line in \" + L.name + \" (1-2 short sentences)\\nEN: English translation\";\n  askTutor(p, true);\n}\n\nfunction send(){\n  var t = el(\"say\").value.trim();\n  if (!t || busy) return;\n  if (!ASK){ el(\"aiGate\").style.display = \"block\"; return; }\n  haptic(\"light\");\n  primeSpeech();\n  el(\"say\").value = \"\";\n  el(\"helps\").style.display = \"none\";\n  var mine = {who:\"m\", txt:t};\n  pushMsg(mine);\n  tickActivity();\n  askTutor(buildPrompt(t), false, mine);\n}\n\nfunction askTutor(prompt, opening, mine){\n  busy = true;\n  el(\"typing\").style.display = \"block\";\n  el(\"sendBtn\").disabled = true;\n  ASK(prompt).then(function(raw){\n    var r = parseTutor(raw);\n    if (mine && r.fix && r.fix.toLowerCase() !== mine.txt.toLowerCase()){\n      mine.fix = r.fix;\n      renderChat();\n    }\n    pushMsg({who:\"t\", txt:r.say, en:r.en});\n    if (S.auto) speak(r.say);\n    if (r.word && !hasWord(r.word.w)){\n      vocab.push({w:r.word.w, en:r.word.en, lang:S.lang, ease:2.5, ivl:0, due:today(), reps:0});\n      toast(\"📖 \" + r.word.w + \" added to your words\");\n      updateBadge();\n    }\n    saveAll();\n  }).catch(function(){\n    pushMsg({who:\"t\", txt:\"…\", en:\"The AI didn't answer — try again in a moment.\"});\n  }).then(function(){\n    busy = false;\n    el(\"typing\").style.display = \"none\";\n    el(\"sendBtn\").disabled = false;\n  });\n}\n\nfunction help(){\n  if (!ASK || busy) return;\n  haptic(\"light\");\n  var L = LANGS[S.lang];\n  var last = \"\";\n  for (var i=hist.length-1;i>=0;i--) if (hist[i].who===\"t\"){ last = hist[i].txt; break; }\n  var p = \"A \" + LEVELS[S.level].label + \" student of \" + L.name + \" must reply to: \\\"\" + last + \"\\\"\\n\" +\n    \"Give exactly 2 different example replies they could send, in \" + L.name + \", one per line, format:\\n\" +\n    \"1: first reply|English meaning\\n2: second reply|English meaning\";\n  ASK(p).then(function(raw){\n    var opts = [];\n    String(raw||\"\").split(/\\n+/).forEach(function(l){\n      var m = l.match(/^\\s*\\d\\s*[:.)]\\s*(.+)$/);\n      if (m){ var pr = m[1].split(\"|\"); opts.push({t:pr[0].replace(/\\*+/g,\"\").trim(), e:(pr[1]||\"\").trim()}); }\n    });\n    if (!opts.length) return;\n    var h = el(\"helps\"); h.innerHTML = \"\"; h.style.display = \"flex\";\n    opts.slice(0,2).forEach(function(o){\n      var b = document.createElement(\"button\");\n      b.textContent = o.t + (o.e ? \" — \" + o.e : \"\");\n      b.onclick = function(){ el(\"say\").value = o.t; h.style.display = \"none\"; };\n      h.appendChild(b);\n    });\n  }).catch(function(){});\n}\n\nfunction dictate(){\n  if (!TRANSCRIBE || busy) return;\n  haptic(\"light\");\n  var go = function(){\n    /* MyLLM 4.2+ transcribes in the tutor's language; older builds silently\n       ignore the option and use the phone language. */\n    TRANSCRIBE({lang: LANGS[S.lang].tts}).then(function(text){\n      if (text) el(\"say\").value = text;\n    }).catch(function(){});\n  };\n  if (!S.micNoted){\n    S.micNoted = true; saveAll();\n    toast(\"Speak in \" + LANGS[S.lang].name + \"! 🎙\");\n    setTimeout(go, 1200);\n  } else go();\n}\n\n/* ---------- practice ---------- */\n\nfunction startPractice(){\n  pQueue = dueCards();\n  renderPractice();\n}\n\nfunction renderPractice(){\n  updateBadge();\n  var area = el(\"pArea\");\n  if (!pQueue.length){\n    var w = langWords();\n    area.innerHTML = '<div class=\"card\"><p class=\"status\">' +\n      (w.length ? \"All caught up — nothing due to review. 🎉<br>Chat with \" + LANGS[S.lang].tutor + \" to collect new words, or add a starter pack.\" :\n        \"No words yet. Chat with \" + LANGS[S.lang].tutor + \" — useful words are collected automatically — or add a starter pack in Words.\") +\n      '</p></div>';\n    el(\"pProg\").textContent = \"\";\n    return;\n  }\n  pCard = pQueue[0];\n  el(\"pProg\").textContent = pQueue.length + \" to review\";\n  var img = pCard.img != null ?\n    '<img src=\"' + IMG_BASE + pCard.img + '.webp\" onerror=\"this.onerror=null;this.src=this.src.replace(\\'.webp\\',\\'.jpg\\')\" alt=\"\">' : \"\";\n  area.innerHTML = '<div class=\"card pcard\" id=\"pc\">' + img +\n    '<div class=\"front\">' + esc(pCard.en) + '</div>' +\n    '<div class=\"back\">' + esc(pCard.w) +\n      (CAN_SPEAK ? ' <button class=\"spk\" style=\"border:none;background:none;font-size:17px\" onclick=\"speak(\\'' + esc(pCard.w).replace(/'/g,\"\\\\'\") + '\\')\">🔊</button>' : '') + '</div>' +\n    '<div class=\"hintw\" id=\"pEx\"></div>' +\n    '<button class=\"reveal\" id=\"pReveal\" onclick=\"flipCard()\">Show answer</button>' +\n    '<div class=\"grades\" id=\"pGrades\" style=\"display:none\">' +\n      '<button class=\"g-again\" onclick=\"grade(0)\">Again</button>' +\n      '<button class=\"g-good\" onclick=\"grade(1)\">Good</button>' +\n      '<button class=\"g-easy\" onclick=\"grade(2)\">Easy</button></div>' +\n    (ASK ? '<p class=\"note\" style=\"text-align:center\"><a href=\"#\" onclick=\"exampleFor();return false\" style=\"color:var(--myllm-muted,#8a8a8e)\">✨ use it in a sentence</a></p>' : '') +\n    '</div>';\n}\n\nfunction flipCard(){\n  haptic(\"selection\");\n  el(\"pc\").classList.add(\"flip\");\n  el(\"pReveal\").style.display = \"none\";\n  el(\"pGrades\").style.display = \"flex\";\n  if (S.auto) speak(pCard.w);\n}\n\nfunction grade(g){\n  haptic(g === 0 ? \"warning\" : \"success\");\n  srsGrade(pCard, g);\n  tickActivity();\n  if (g === 0){ pQueue.push(pQueue.shift()); }  /* failed card comes back this session */\n  else pQueue.shift();\n  saveAll();\n  renderPractice();\n}\n\nfunction exampleFor(){\n  if (!ASK || !pCard) return;\n  var L = LANGS[S.lang];\n  ASK(\"Write one short simple \" + L.name + \" sentence using \\\"\" + pCard.w + \"\\\" (\" + pCard.en + \"), for a \" +\n      LEVELS[S.level].label + \" learner. Format:\\nSAY: the sentence\\nEN: English translation\")\n    .then(function(raw){\n      var r = parseTutor(raw);\n      if (r.say) el(\"pEx\").innerHTML = esc(r.say) + (r.en ? '<br><span style=\"opacity:.75\">' + esc(r.en) + \"</span>\" : \"\");\n    }).catch(function(){});\n}\n\n/* ---------- words ---------- */\n\nfunction renderWords(){\n  var q = (el(\"vq\").value||\"\").toLowerCase().trim();\n  var w = langWords().filter(function(c){\n    return !q || c.w.toLowerCase().indexOf(q) >= 0 || c.en.toLowerCase().indexOf(q) >= 0;\n  });\n  if (!w.length){\n    el(\"vlist\").innerHTML = '<p class=\"status\">' + (q ? \"No matches.\" : \"Words you meet in conversation land here automatically.\") + '</p>';\n  } else {\n    w.sort(function(a,b){ return a.w.localeCompare(b.w); });\n    var h = \"\";\n    for (var i=0;i<w.length;i++){\n      var c = w[i], lv = wordLevel(c);\n      var im = c.img != null ?\n        '<img loading=\"lazy\" src=\"' + IMG_BASE + c.img + '.jpg\" onerror=\"this.style.visibility=\\'hidden\\'\" alt=\"\">' :\n        '<div class=\"noimg\">💬</div>';\n      h += '<div class=\"vrow\">' + im +\n        '<div class=\"vi\"><div class=\"w\">' + esc(c.w) + '</div><div class=\"e\">' + esc(c.en) + '</div></div>' +\n        '<span class=\"lvl ' + lv + '\">' + lv + '</span>' +\n        '<button class=\"del\" onclick=\"delWord(\\'' + esc(c.w).replace(/'/g,\"\\\\'\") + '\\')\">✕</button></div>';\n    }\n    el(\"vlist\").innerHTML = h;\n  }\n  renderPacks();\n}\n\nfunction delWord(w){\n  vocab = vocab.filter(function(c){ return !(c.lang === S.lang && c.w === w); });\n  saveAll(); renderWords(); updateBadge();\n}\n\nfunction renderPacks(){\n  var decks = PACKS[S.lang] || [];\n  var h = \"\";\n  for (var i=0;i<decks.length;i++){\n    var d = decks[i];\n    var added = d.cards.every(function(c){ return hasWord(c.w); });\n    h += '<div class=\"packrow\"><div class=\"pi\"><div class=\"t\">' + esc(d.title) + '</div>' +\n      '<div class=\"c\">' + d.cards.length + ' words with pictures</div></div>' +\n      '<button ' + (added ? 'class=\"done\">✓ Added' : 'onclick=\"addPack(' + i + ')\">+ Add') + '</button></div>';\n  }\n  el(\"packs\").innerHTML = h || '<p class=\"status\">No packs for this language yet.</p>';\n}\n\nfunction addPack(i){\n  haptic(\"success\");\n  var d = (PACKS[S.lang]||[])[i];\n  if (!d) return;\n  var n = 0;\n  d.cards.forEach(function(c){\n    if (hasWord(c.w)) return;\n    vocab.push({w:c.w, en:c.en, lang:S.lang, img:d.img + \"/\" + c.i, ease:2.5, ivl:0, due:today(), reps:0});\n    n++;\n  });\n  saveAll(); renderWords(); updateBadge();\n  toast(\"Added \" + n + \" words — see Practice\");\n}\n\n/* ---------- tabs & settings ---------- */\n\nvar TABS = [\n  {id:\"talk\", icon:\"💬\", label:\"Talk\"},\n  {id:\"practice\", icon:\"🃏\", label:\"Practice\"},\n  {id:\"words\", icon:\"📖\", label:\"Words\"},\n  {id:\"me\", icon:\"🔥\", label:\"Me\"}\n];\nvar tab = \"talk\";\n\nfunction renderTabs(){\n  var due = S ? dueCards().length : 0;\n  el(\"tabs\").innerHTML = TABS.map(function(t){\n    return '<button ' + (t.id === tab ? 'class=\"hot\"' : '') + ' onclick=\"go(\\'' + t.id + '\\')\">' +\n      '<span class=\"ti\">' + t.icon + '</span>' + t.label +\n      (t.id === \"practice\" && due ? '<b class=\"badge\">' + due + '</b>' : '') + '</button>';\n  }).join(\"\");\n}\n\nfunction go(t){\n  haptic(\"selection\");\n  tab = t;\n  TABS.forEach(function(x){ el(\"tab-\" + x.id).style.display = x.id === t ? \"block\" : \"none\"; });\n  renderTabs();\n  if (t === \"practice\") startPractice();\n  if (t === \"words\") renderWords();\n  if (t === \"me\") renderMe();\n}\n\nfunction updateBadge(){ renderTabs(); }\n\nfunction renderScenarios(){\n  el(\"scenarios\").innerHTML = SCENARIOS.map(function(s){\n    return '<button ' + (s.id === scenario.id ? 'class=\"hot\"' : '') + ' onclick=\"pickScenario(\\'' + s.id + '\\')\">' + s.label + '</button>';\n  }).join(\"\");\n}\n\nfunction toggleAuto(){ S.auto = !S.auto; saveAll(); syncToggles(); haptic(\"selection\"); }\nfunction toggleSlow(){ S.slow = !S.slow; saveAll(); syncToggles(); haptic(\"selection\"); }\nfunction syncToggles(){\n  el(\"autoBtn\").className = S.auto ? \"hot\" : \"\";\n  el(\"slowBtn\").className = S.slow ? \"hot\" : \"\";\n  el(\"swAuto\").className = \"switch\" + (S.auto ? \" on\" : \"\");\n  el(\"swSlow\").className = \"switch\" + (S.slow ? \" on\" : \"\");\n}\n\nfunction renderMe(){\n  el(\"sStreak\").textContent = stats.streak;\n  el(\"sMins\").textContent = Math.round(stats.mins);\n  el(\"sKnown\").textContent = langWords().filter(function(c){ return wordLevel(c) === \"known\"; }).length;\n  el(\"meLang\").innerHTML = Object.keys(LANGS).map(function(k){\n    return '<button ' + (k === S.lang ? 'class=\"hot\"' : '') + ' onclick=\"setLang(\\'' + k + '\\')\">' + LANGS[k].flag + '</button>';\n  }).join(\"\");\n  el(\"meLevel\").innerHTML = Object.keys(LEVELS).map(function(k){\n    return '<button ' + (k === S.level ? 'class=\"hot\"' : '') + ' onclick=\"setLevel(\\'' + k + '\\')\">' + LEVELS[k].label + '</button>';\n  }).join(\"\");\n  syncToggles();\n}\n\nfunction setLang(k){\n  if (k === S.lang){ return; }\n  S.lang = k; haptic(\"selection\");\n  el(\"hFlag\").textContent = LANGS[k].flag;\n  el(\"say\").placeholder = \"Write in \" + LANGS[k].name + \" or English…\";\n  store.getItem(\"tt_hist_\" + k).then(function(v){\n    hist = [];\n    if (v){ try{ hist = JSON.parse(v) || []; }catch(_){} }\n    renderChat();\n    if (!hist.length){ scenario = SCENARIOS[0]; greet(); }\n    renderScenarios();\n  });\n  saveAll(); renderMe(); updateBadge();\n}\n\nfunction setLevel(k){ S.level = k; haptic(\"selection\"); saveAll(); renderMe(); }\n\n/* ---------- onboarding & boot ---------- */\n\nvar obLang = null, obLevel = \"beginner\";\nfunction renderOb(){\n  el(\"obLangs\").innerHTML = Object.keys(LANGS).map(function(k){\n    var L = LANGS[k];\n    return '<button class=\"langbtn' + (k === obLang ? ' hot' : '') + '\" onclick=\"obPick(\\'' + k + '\\')\">' +\n      '<span class=\"f\">' + L.flag + '</span><span>' + L.name + '<small>with ' + L.tutor + '</small></span></button>';\n  }).join(\"\");\n  el(\"obLevels\").innerHTML = Object.keys(LEVELS).map(function(k){\n    return '<button ' + (k === obLevel ? 'class=\"hot\"' : '') + ' onclick=\"obLvl(\\'' + k + '\\')\">' + LEVELS[k].label + '</button>';\n  }).join(\"\");\n  el(\"obGo\").disabled = !obLang;\n}\nfunction obPick(k){ obLang = k; haptic(\"selection\"); renderOb(); }\nfunction obLvl(k){ obLevel = k; haptic(\"selection\"); renderOb(); }\nfunction finishOb(){\n  haptic(\"success\");\n  S = {lang:obLang, level:obLevel, auto:true, slow:false, micNoted:false};\n  el(\"ob\").style.display = \"none\";\n  boot2();\n  saveAll();\n}\n\nfunction boot2(){\n  el(\"hFlag\").textContent = LANGS[S.lang].flag;\n  el(\"say\").placeholder = \"Write in \" + LANGS[S.lang].name + \" or English…\";\n  el(\"hStreak\").textContent = stats.streak ? \"🔥 \" + stats.streak : \"\";\n  if (TRANSCRIBE) el(\"micBtn\").style.display = \"block\";\n  if (!ASK){ el(\"aiGate\").style.display = \"block\"; el(\"talkHint\").style.display = \"none\"; }\n  renderScenarios(); renderTabs(); syncToggles();\n  store.getItem(\"tt_hist_\" + S.lang).then(function(v){\n    if (v){ try{ hist = JSON.parse(v) || []; }catch(_){} }\n    if (hist.length) renderChat(); else greet();\n  });\n}\n\nel(\"say\").addEventListener(\"keydown\", function(e){ if (e.key === \"Enter\") send(); });\n/* long-press send = help suggestions; also double-tap */\nel(\"sendBtn\").addEventListener(\"dblclick\", function(e){ e.preventDefault(); help(); });\nvar pressT = null;\nel(\"sendBtn\").addEventListener(\"touchstart\", function(){ pressT = setTimeout(help, 550); });\nel(\"sendBtn\").addEventListener(\"touchend\", function(){ clearTimeout(pressT); });\n\nPromise.all([store.getItem(\"tt_set\"), store.getItem(\"tt_vocab\"), store.getItem(\"tt_stats\")]).then(function(vs){\n  try{ S = vs[0] ? JSON.parse(vs[0]) : null; }catch(_){ S = null; }\n  try{ vocab = vs[1] ? JSON.parse(vs[1]) || [] : []; }catch(_){ vocab = []; }\n  try{ stats = vs[2] ? JSON.parse(vs[2]) : null; }catch(_){ stats = null; }\n  if (!stats) stats = {streak:0, lastDay:null, mins:0, lastTs:0};\n  if (S && LANGS[S.lang]) boot2();\n  else { el(\"ob\").style.display = \"block\"; renderOb(); }\n});\n</script>\n</body>\n</html>\n"}