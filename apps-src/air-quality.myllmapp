{"name": "Air Quality", "kind": "html", "iconSymbol": "leaf.fill", "iconColor": "green", "html": "<!doctype html>\n<!--\n  Air Quality — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Air Quality</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"520e7488e3\";color-scheme:light dark; --h:142;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:760px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.96); }\n  a{ color:inherit; }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 28%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  .head .acts{ display:flex; gap:8px; flex-shrink:0; }\n  .head .acts button{ min-width:40px; height:40px; border-radius:12px; border:1px solid var(--line); background:var(--surface);\n    display:flex; align-items:center; justify-content:center; gap:6px; padding:0 10px; font-size:13.5px; font-weight:650; }\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:20px 2px 10px; display:flex; align-items:center; gap:6px; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  label{ display:block; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:14px 2px 7px; }\n  label:first-child{ margin-top:0; }\n  input{ width:100%; font:inherit; font-size:16px; padding:12px; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; }\n  input:focus{ border-color:var(--acc); }\n  .field{ position:relative; } .field svg.i{ position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--muted); font-size:15px; pointer-events:none; }\n  .field input{ padding-left:38px; }\n  .inrow{ display:flex; gap:8px; } .inrow input{ flex:1; min-width:0; }\n  .chips{ display:flex; gap:7px; overflow-x:auto; -webkit-overflow-scrolling:touch; scrollbar-width:none; margin:10px -14px 0; padding:0 14px 2px; }\n  .chips::-webkit-scrollbar{ display:none; }\n  .chip{ flex:0 0 auto; min-height:36px; border:1px solid var(--line); background:var(--bg); border-radius:99px; padding:0 14px; font-size:13.5px; font-weight:650; white-space:nowrap; }\n  .chip.hot{ background:var(--acc); border-color:var(--acc); color:#fff; }\n  .go{ min-height:48px; border:none; border-radius:14px; background:var(--acc); color:#fff; font-size:16px; font-weight:700;\n    display:flex; align-items:center; justify-content:center; gap:8px; padding:0 18px; }\n  .go.wide{ width:100%; margin-top:14px; }\n  .go.soft{ background:var(--fill); color:var(--acc); }\n  .go:disabled{ opacity:.55; }\n  .pillbtn{ display:inline-flex; align-items:center; gap:6px; min-height:36px; border:none; border-radius:10px; padding:0 12px;\n    background:hsl(var(--h) 70% 50% / .13); color:hsl(var(--h) 70% 38%); font-size:13.5px; font-weight:700; text-decoration:none; }\n  @media (prefers-color-scheme:dark){ .pillbtn{ color:hsl(var(--h) 80% 70%); } }\n  .spin{ width:16px; height:16px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n  .skel{ border-radius:16px; margin-bottom:10px; background:var(--fill); animation:shimmer 1.4s ease-in-out infinite; }\n  @keyframes shimmer{ 50%{ opacity:.45; } }\n\n  .notice{ display:flex; gap:12px; align-items:flex-start; background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  .notice .tile{ width:36px; height:36px; border-radius:10px; font-size:16px; }\n  .notice.warn .tile{ background:linear-gradient(145deg,#ff9f0a,#c25e00); }\n  .notice b{ display:block; font-size:15px; font-weight:750; }\n  .notice p{ font-size:13.5px; color:var(--muted); line-height:1.45; margin-top:2px; }\n  .notice p b{ display:inline; font-size:inherit; font-weight:700; color:var(--ink); }\n  .notice .go{ margin-top:10px; min-height:40px; font-size:14.5px; border-radius:12px; }\n  .hint{ text-align:center; font-size:13px; color:var(--muted); line-height:1.5; padding:18px 12px 6px; }\n\n  [hidden]{ display:none !important; }\n  @media (prefers-reduced-motion:reduce){ .spin{ animation-duration:2.4s; } .skel{ animation:none; } button:active{ transform:none; } }\n\n  /* the reading: a hero in the band's own colour */\n  .hero{ border-radius:20px; padding:18px 18px 16px; color:#fff; margin-bottom:12px;\n    background:linear-gradient(145deg, var(--b1,#1f9d55), var(--b2,#136b3a)); box-shadow:0 10px 28px rgba(0,0,0,.14); }\n  .hero .k{ font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.8; }\n  .hero .row{ display:flex; align-items:flex-end; gap:14px; margin-top:4px; }\n  .hero .n{ font-size:64px; font-weight:800; line-height:.95; letter-spacing:-.03em; font-variant-numeric:tabular-nums; }\n  .hero .bn{ font-size:21px; font-weight:800; line-height:1.15; padding-bottom:6px; }\n  .hero .adv{ font-size:14px; line-height:1.45; opacity:.92; margin-top:10px; }\n  .scale{ position:relative; display:flex; gap:3px; height:8px; margin-top:16px; }\n  .scale i{ flex:1; border-radius:99px; background:rgba(255,255,255,.28); }\n  .scale i.on{ background:rgba(255,255,255,.95); }\n  .scale b{ position:absolute; top:50%; width:16px; height:16px; border-radius:50%; background:#fff; border:3px solid var(--b2,#136b3a);\n    transform:translate(-50%,-50%); box-shadow:0 2px 6px rgba(0,0,0,.25); }\n  .scalelbl{ display:flex; justify-content:space-between; font-size:10.5px; font-weight:700; opacity:.75; margin-top:6px; }\n\n  /* pollutants as bars against their health guideline */\n  .pol{ padding:11px 0; border-bottom:1px solid var(--line); }\n  .pol:first-child{ padding-top:0; } .pol:last-child{ border-bottom:none; padding-bottom:0; }\n  .pol .t{ display:flex; align-items:baseline; gap:8px; }\n  .pol .nm{ flex:1; min-width:0; font-size:14.5px; font-weight:650; }\n  .pol .nm small{ font-weight:500; color:var(--muted); }\n  .pol .v{ font-size:16px; font-weight:800; font-variant-numeric:tabular-nums; }\n  .pol .v small{ font-size:11.5px; font-weight:600; color:var(--muted); margin-left:2px; }\n  .bar{ position:relative; height:8px; border-radius:99px; background:var(--fill); margin-top:8px; overflow:visible; }\n  .bar i{ position:absolute; left:0; top:0; bottom:0; border-radius:99px; }\n  .bar u{ position:absolute; left:50%; top:-3px; bottom:-3px; width:2px; border-radius:2px; background:var(--muted); opacity:.55; }\n  .pol .lvl{ font-size:12px; color:var(--muted); margin-top:5px; }\n  .tag{ display:inline-flex; align-items:center; font-size:11.5px; font-weight:800; letter-spacing:.03em; border-radius:99px; padding:3px 9px; color:#fff; }\n  .uvico{ display:inline-flex; vertical-align:-3px; margin-right:4px; color:#ff9f0a; }\n\n  .pgrid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:8px; }\n  .pgrid div{ display:flex; align-items:center; justify-content:space-between; gap:8px; background:var(--bg); border-radius:12px; padding:10px 12px; font-size:14px; font-weight:650; }\n\n  .bars{ display:flex; align-items:flex-end; gap:3px; height:84px; }\n  .bars i{ flex:1; border-radius:4px 4px 1px 1px; min-height:4px; }\n  .bars i.now{ box-shadow:0 0 0 2px var(--surface), 0 0 0 3.5px var(--ink); }\n  .barlbl{ display:flex; justify-content:space-between; font-size:11px; font-weight:600; color:var(--muted); margin-top:7px; }\n  .src{ text-align:center; font-size:11.5px; color:var(--muted); margin-top:4px; }\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-leaf\" viewBox=\"0 0 24 24\"><path d=\"M20.5 3.5a.9.9 0 0 0-.9-.9C11.2 2.6 4.6 6.3 4.6 13.4c0 1.6.4 3 1.1 4.2l-2.4 2.4a1 1 0 1 0 1.4 1.4l2.4-2.4c1.2.7 2.6 1.1 4.2 1.1 7.1 0 10.8-6.6 10.8-15zM8.9 16.5a1 1 0 0 1-1.4-1.4c2.4-2.4 5-4 7.9-5a1 1 0 0 1 .7 1.9c-2.6.9-5 2.3-7.2 4.5z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-pin\" viewBox=\"0 0 24 24\"><path d=\"M12 2a7 7 0 0 0-7 7c0 5.2 6.1 12.2 6.4 12.5a.8.8 0 0 0 1.2 0C12.9 21.2 19 14.2 19 9a7 7 0 0 0-7-7zm0 9.6a2.6 2.6 0 1 1 0-5.2 2.6 2.6 0 0 1 0 5.2z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-refresh\" viewBox=\"0 0 24 24\"><path d=\"M20 12a8 8 0 1 1-2.6-5.9M20 4v5h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-search\" viewBox=\"0 0 24 24\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"/><path d=\"M15.5 15.5L20 20\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-sun\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"4.2\" fill=\"currentColor\"/><path d=\"M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-offline\" viewBox=\"0 0 24 24\"><path d=\"M2 8.8a15 15 0 0 1 20 0M5.3 12.2a10.5 10.5 0 0 1 13.4 0M8.6 15.6a6 6 0 0 1 6.8 0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/><circle cx=\"12\" cy=\"19\" r=\"1.6\" fill=\"currentColor\"/><path d=\"M3.5 3.5l17 17\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-warn\" viewBox=\"0 0 24 24\"><path d=\"M10.3 3.9a2 2 0 0 1 3.4 0l8 13.6a2 2 0 0 1-1.7 3H4a2 2 0 0 1-1.7-3zM12 9a1 1 0 0 0-1 1v4a1 1 0 0 0 2 0v-4a1 1 0 0 0-1-1zm0 7.2a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z\" fill=\"currentColor\"/></symbol>\n</defs></svg>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-leaf\"/></svg></div>\n  <div class=\"ht\"><h1>Air Quality</h1><p id=\"where\">Know what you're breathing</p></div>\n  <div class=\"acts\" id=\"acts\" hidden>\n    <button type=\"button\" id=\"bPlace\" aria-label=\"Change place\"><svg class=\"i\"><use href=\"#i-pin\"/></svg></button>\n    <button type=\"button\" id=\"bRefresh\" aria-label=\"Refresh\"><svg class=\"i\"><use href=\"#i-refresh\"/></svg></button>\n  </div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Air Quality\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n<div id=\"app\"></div>\n\n<script>\nfunction el(id){ return document.getElementById(id); }\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction store(){ return window.myllmStorage || {getItem:function(){return Promise.resolve(null)}, setItem:function(){return Promise.resolve()}}; }\nfunction NET(){ return window.myllmFetch ? window.myllmFetch.apply(window, arguments) : Promise.reject(new Error(\"offline\")); }\nfunction LOC(){ return window.myllmLocation || null; }\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction esc(s){ return String(s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\"); }\nfunction icon(n){ return '<svg class=\"i\"><use href=\"#i-' + n + '\"/></svg>'; }\n\nvar obs = null;\n/* European AQI bands. b1/b2 = the hero's gradient, deep enough for white text. */\nvar BANDS = [\n  {max:20,  name:\"Good\",           color:\"#30d158\", b1:\"#1f9d55\", b2:\"#0f6a37\", adv:\"Beautiful air. Windows open, lungs happy — enjoy being outside.\"},\n  {max:40,  name:\"Fair\",           color:\"#63c78b\", b1:\"#3b9c6b\", b2:\"#1f6a47\", adv:\"Perfectly fine for everyone. Sensitive folks won't notice a thing.\"},\n  {max:60,  name:\"Moderate\",       color:\"#ffd60a\", b1:\"#c89400\", b2:\"#8a5f00\", adv:\"Fine for most. If you're very sensitive, take intense exercise a little easier.\"},\n  {max:80,  name:\"Poor\",           color:\"#ff9500\", b1:\"#e07400\", b2:\"#984600\", adv:\"Consider lighter outdoor exercise; sensitive groups should limit time in traffic.\"},\n  {max:100, name:\"Very poor\",      color:\"#ff3b30\", b1:\"#d9342b\", b2:\"#8c1b15\", adv:\"Keep outdoor exertion short; close windows on busy roads.\"},\n  {max:1e9, name:\"Extremely poor\", color:\"#af52de\", b1:\"#9b44c9\", b2:\"#5a2080\", adv:\"Stay indoors where you can; masks help if you must be out long.\"}\n];\nfunction band(aqi){ for (var i = 0; i < BANDS.length; i++) if (aqi <= BANDS[i].max) return BANDS[i]; return BANDS[BANDS.length-1]; }\nfunction pollenLevel(v){\n  if (v == null) return null;\n  if (v < 25) return {name:\"Low\", color:\"#30d158\"};\n  if (v < 75) return {name:\"Moderate\", color:\"#e0a800\"};\n  return {name:\"High\", color:\"#ff3b30\"};\n}\nfunction uvBand(u){\n  if (u < 3) return {name:\"Low\", color:\"#30d158\", adv:\"no protection needed\"};\n  if (u < 6) return {name:\"Moderate\", color:\"#e0a800\", adv:\"hat and SPF if out long\"};\n  if (u < 8) return {name:\"High\", color:\"#ff9500\", adv:\"SPF, shade in the middle of the day\"};\n  if (u < 11) return {name:\"Very high\", color:\"#ff3b30\", adv:\"cover up, seek shade 11–3\"};\n  return {name:\"Extreme\", color:\"#af52de\", adv:\"avoid midday sun entirely\"};\n}\n\nfunction notice(kind, title, text, action){\n  el(\"app\").innerHTML = '<div class=\"notice' + (kind === \"warn\" ? \" warn\" : \"\") + '\"><div class=\"tile\">' + icon(kind === \"offline\" ? \"offline\" : kind === \"warn\" ? \"warn\" : \"leaf\") +\n    '</div><div style=\"flex:1;min-width:0\"><b>' + esc(title) + '</b><p>' + text + '</p>' +\n    (action ? '<button class=\"go\" type=\"button\" id=\"noticeGo\">' + icon(\"refresh\") + '<span>' + esc(action.label) + '</span></button>' : '') + '</div></div>';\n  if (action) el(\"noticeGo\").onclick = action.run;\n}\nfunction loading(label){\n  el(\"app\").innerHTML = '<div class=\"skel\" style=\"height:196px;border-radius:20px\"></div><div class=\"skel\" style=\"height:210px\"></div><div class=\"skel\" style=\"height:120px\"></div>' +\n    '<p class=\"hint\">' + esc(label) + '</p>';\n}\n\nfunction load(){\n  if (!window.myllmFetch){\n    el(\"acts\").hidden = false;\n    notice(\"offline\", \"Internet access is off\", \"Air Quality needs internet access for apps — turn it on in MyLLMos settings, then reopen.\", {label:\"Try again\", run:load});\n    return;\n  }\n  el(\"where\").textContent = obs.label;\n  el(\"acts\").hidden = false;\n  loading(\"Reading the air around \" + obs.label + \"…\");\n  var aq = \"https://air-quality-api.open-meteo.com/v1/air-quality?latitude=\" + obs.lat + \"&longitude=\" + obs.lon +\n    \"&current=european_aqi,us_aqi,pm2_5,pm10,ozone,nitrogen_dioxide,grass_pollen,birch_pollen,ragweed_pollen,olive_pollen,mugwort_pollen,alder_pollen\" +\n    \"&hourly=european_aqi&forecast_days=2&timezone=auto\";\n  var uv = \"https://api.open-meteo.com/v1/forecast?latitude=\" + obs.lat + \"&longitude=\" + obs.lon +\n    \"&daily=uv_index_max&forecast_days=1&timezone=auto\";\n  Promise.all([NET(aq), NET(uv)]).then(function(rs){\n    var a = JSON.parse(rs[0].body);\n    var u = JSON.parse(rs[1].body);\n    render(a, (u.daily && u.daily.uv_index_max && u.daily.uv_index_max[0]) || null);\n  }).catch(function(){\n    notice(\"offline\", \"Couldn't reach the air-quality service\", \"Check your connection — the reading comes from Open-Meteo.\", {label:\"Try again\", run:function(){ haptic(\"light\"); load(); }});\n  });\n}\n\n/* A pollutant's bar is drawn against its WHO-style guideline: the tick sits at\n   the guideline, the bar turns amber past it and red past twice it. */\nfunction polRow(p){\n  var ratio = p.v / p.g, pct = Math.min(100, ratio * 50);\n  var col = ratio <= 1 ? \"#30d158\" : ratio <= 2 ? \"#ff9f0a\" : \"#ff3b30\";\n  var word = ratio <= .5 ? \"Well below the guideline\" : ratio <= 1 ? \"Below the guideline\" : ratio <= 2 ? \"Above the guideline\" : \"Well above the guideline\";\n  return '<div class=\"pol\"><div class=\"t\"><div class=\"nm\">' + esc(p.n) + (p.d ? ' <small>' + esc(p.d) + '</small>' : '') + '</div>' +\n    '<div class=\"v\">' + Math.round(p.v) + '<small>' + p.u + '</small></div></div>' +\n    '<div class=\"bar\"><i style=\"width:' + pct.toFixed(1) + '%;background:' + col + '\"></i><u></u></div>' +\n    '<div class=\"lvl\">' + word + ' (' + p.g + ' ' + p.u + ')</div></div>';\n}\n\nfunction render(a, uvMax){\n  var c = a.current || {};\n  var aqi = Math.round(c.european_aqi != null ? c.european_aqi : -1);\n  if (aqi < 0){\n    notice(\"warn\", \"No reading for this spot\", \"The service has no air-quality data here — try a nearby town.\", {label:\"Choose another place\", run:function(){ setupUI(); }});\n    return;\n  }\n  var b = band(aqi), bi = BANDS.indexOf(b);\n  var pos = Math.min(100, aqi / 120 * 100);\n\n  var pols = [\n    {n:\"PM2.5\", d:\"fine particles\", v:c.pm2_5,  u:\"µg/m³\", g:15},\n    {n:\"PM10\",  d:\"dust\",           v:c.pm10,   u:\"µg/m³\", g:45},\n    {n:\"Ozone\", d:\"\",               v:c.ozone,  u:\"µg/m³\", g:120},\n    {n:\"NO₂\",   d:\"traffic\",        v:c.nitrogen_dioxide, u:\"µg/m³\", g:40}\n  ].filter(function(p){ return p.v != null; });\n\n  var pollens = [\n    {n:\"Grass\", v:c.grass_pollen}, {n:\"Birch\", v:c.birch_pollen}, {n:\"Ragweed\", v:c.ragweed_pollen},\n    {n:\"Olive\", v:c.olive_pollen}, {n:\"Mugwort\", v:c.mugwort_pollen}, {n:\"Alder\", v:c.alder_pollen}\n  ].map(function(p){ return {n:p.n, lv:pollenLevel(p.v), v:p.v}; }).filter(function(p){ return p.lv && p.v > 1; });\n\n  /* next 24 hourly bars from \"now\" */\n  var barsHtml = \"\";\n  if (a.hourly && a.hourly.time){\n    var nowIdx = 0, now = new Date(), best = 1e15;\n    for (var i = 0; i < a.hourly.time.length; i++){\n      var d = Math.abs(new Date(a.hourly.time[i]) - now);\n      if (d < best){ best = d; nowIdx = i; }\n    }\n    var slice = [];\n    for (var j = nowIdx; j < Math.min(nowIdx + 24, a.hourly.time.length); j++){\n      slice.push({t:a.hourly.time[j], v:a.hourly.european_aqi[j] || 0});\n    }\n    var maxV = Math.max(60, Math.max.apply(null, slice.map(function(s){ return s.v; })));\n    barsHtml = '<h2>Next 24 hours</h2><div class=\"card\"><div class=\"bars\">' +\n      slice.map(function(s, k){\n        return '<i' + (k === 0 ? ' class=\"now\"' : '') + ' style=\"height:' + Math.max(5, s.v / maxV * 100) + '%;background:' + band(s.v).color + '\" title=\"' + Math.round(s.v) + '\"></i>';\n      }).join(\"\") + '</div><div class=\"barlbl\"><span>Now</span><span>+12h</span><span>+24h</span></div></div>';\n  }\n\n  var uvHtml = \"\";\n  if (uvMax != null){\n    var ub = uvBand(uvMax), uvv = Math.round(uvMax * 10) / 10;\n    uvHtml = '<div class=\"pol\"><div class=\"t\"><div class=\"nm\"><span class=\"uvico\">' + icon(\"sun\") + '</span>UV index <small>today\\'s max</small></div>' +\n      '<div class=\"v\">' + uvv + '</div></div>' +\n      '<div class=\"bar\"><i style=\"width:' + Math.min(100, uvMax / 11 * 100).toFixed(1) + '%;background:' + ub.color + '\"></i></div>' +\n      '<div class=\"lvl\"><span class=\"tag\" style=\"background:' + ub.color + '\">' + ub.name + '</span> ' + ub.adv + '</div></div>';\n  }\n\n  el(\"app\").innerHTML =\n    '<div class=\"hero\" style=\"--b1:' + b.b1 + ';--b2:' + b.b2 + '\">' +\n      '<div class=\"k\">European AQI · now</div>' +\n      '<div class=\"row\"><div class=\"n\">' + aqi + '</div><div class=\"bn\">' + b.name + '</div></div>' +\n      '<div class=\"adv\">' + b.adv + '</div>' +\n      '<div class=\"scale\">' + BANDS.map(function(x, k){ return '<i' + (k === bi ? ' class=\"on\"' : '') + '></i>'; }).join(\"\") +\n        '<b style=\"left:' + pos + '%\"></b></div>' +\n      '<div class=\"scalelbl\"><span>Good</span><span>Moderate</span><span>Very poor</span></div>' +\n    '</div>' +\n    '<h2>What\\'s in the air</h2><div class=\"card\">' + pols.map(polRow).join(\"\") + uvHtml + '</div>' +\n    (pollens.length ?\n      '<h2>Pollen</h2><div class=\"card\"><div class=\"pgrid\">' +\n      pollens.map(function(p){\n        return '<div><span>' + p.n + '</span><span class=\"tag\" style=\"background:' + p.lv.color + '\">' + p.lv.name + '</span></div>';\n      }).join(\"\") + '</div></div>' : \"\") +\n    barsHtml +\n    '<p class=\"src\">Data: Open-Meteo air-quality forecast</p>';\n\n  el(\"where\").textContent = obs.label;\n  haptic(\"selection\");\n}\n\n/* ---------- location (sky-tonight pattern) ---------- */\nfunction setupUI(msg){\n  el(\"acts\").hidden = true;\n  el(\"where\").textContent = \"Know what you're breathing\";\n  el(\"app\").innerHTML =\n    '<div class=\"card\"><label for=\"q\">Where are you breathing?</label>' +\n    '<div class=\"inrow\"><div class=\"field\" style=\"flex:1\">' + icon(\"search\") + '<input id=\"q\" placeholder=\"e.g. Bristol\" enterkeyhint=\"search\" autocomplete=\"off\"></div>' +\n    '<button class=\"go\" type=\"button\" id=\"bFind\">Go</button></div>' +\n    (LOC() ? '<button class=\"go soft wide\" type=\"button\" id=\"bGps\">' + icon(\"pin\") + '<span>Use my location</span></button>' : \"\") +\n    '<p class=\"hint\" id=\"setupnote\" style=\"padding:12px 4px 0;text-align:left\">' + esc(msg || \"Your location is used only on this device, to fetch the right forecast.\") + '</p></div>';\n  el(\"q\").onkeydown = function(e){ if (e.key === \"Enter\") findPlace(); };\n  el(\"bFind\").onclick = findPlace;\n  if (el(\"bGps\")) el(\"bGps\").onclick = useGps;\n}\nfunction useGps(){\n  haptic(\"light\");\n  el(\"setupnote\").textContent = \"Locating…\";\n  LOC().current().then(function(p){\n    obs = {lat:p.latitude, lon:p.longitude, label:(p.address || \"Your location\")};\n    store().setItem(\"aq_obs\", JSON.stringify(obs));\n    load();\n  }).catch(function(e){\n    el(\"setupnote\").textContent = (e && e.message ? e.message + \" — \" : \"\") + \"Try typing a place instead.\";\n  });\n}\nfunction findPlace(){\n  var q = (el(\"q\").value || \"\").trim();\n  if (!q) return;\n  haptic(\"light\");\n  var m = q.match(/^\\s*(-?\\d+(?:\\.\\d+)?)\\s*,\\s*(-?\\d+(?:\\.\\d+)?)\\s*$/);\n  if (m){\n    obs = {lat:parseFloat(m[1]), lon:parseFloat(m[2]), label:\"Lat \" + m[1] + \", Lon \" + m[2]};\n    store().setItem(\"aq_obs\", JSON.stringify(obs));\n    load(); return;\n  }\n  if (!window.myllmFetch){ el(\"setupnote\").textContent = \"Needs internet access for apps (MyLLMos settings).\"; return; }\n  el(\"setupnote\").textContent = \"Searching…\";\n  NET(\"https://geocoding-api.open-meteo.com/v1/search?count=1&name=\" + encodeURIComponent(q)).then(function(r){\n    var j = JSON.parse(r.body);\n    if (j.results && j.results.length){\n      var p = j.results[0];\n      obs = {lat:p.latitude, lon:p.longitude, label:p.name + (p.country_code ? \", \" + p.country_code : \"\")};\n      store().setItem(\"aq_obs\", JSON.stringify(obs));\n      load();\n    } else el(\"setupnote\").textContent = \"Couldn't find that place — try another spelling.\";\n  }).catch(function(){\n    el(\"setupnote\").textContent = \"Search didn't work — try \\\"lat, lon\\\" instead.\";\n  });\n}\nel(\"bPlace\").onclick = function(){ haptic(\"light\"); setupUI(); };\nel(\"bRefresh\").onclick = function(){ haptic(\"light\"); if (obs) load(); };\n\n/* ---------- boot ---------- */\nloading(\"Finding your air…\");\nstore().getItem(\"aq_obs\").then(function(v){\n  if (v){ try{ obs = JSON.parse(v); }catch(e){} }\n  if (obs && typeof obs.lat === \"number\"){ load(); return; }\n  var loc = LOC();\n  if (loc){\n    loc.current().then(function(p){\n      obs = {lat:p.latitude, lon:p.longitude, label:(p.address || \"Your location\")};\n      store().setItem(\"aq_obs\", JSON.stringify(obs));\n      load();\n    }).catch(function(){ setupUI(); });\n  } else setupUI();\n});\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes.\n   The spacer keeps the header clear of the status bar / Dynamic Island. It is\n   live CSS — env(safe-area-inset-top) — not a measured number: the inset is\n   still 0 when the page loads and only grows once MyLLM's bar has gone (v1\n   measured once, so the title sat under the island). If the page's own styles\n   already pad the header down by the inset, the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  /* Does any rule that applies to the header or an ancestor already use the top inset? */\n  function pageHandlesInset(head){\n    var chain = [], n, found = false;\n    for (n = head; n && n.nodeType === 1; n = n.parentElement) chain.push(n);\n    function walk(rules){\n      for (var i = 0; i < rules.length && !found; i++){\n        var r = rules[i];\n        if (r.cssRules && !r.selectorText) { walk(r.cssRules); continue; }\n        if (!r.selectorText || !/safe-area-inset-top/.test(r.cssText) || !/(padding|margin|top)\\s*:/.test(r.cssText)) continue;\n        if (/\\.imm-safe/.test(r.selectorText)) continue;\n        for (var k = 0; k < chain.length; k++){\n          try { if (chain[k].matches(r.selectorText)) { found = true; break; } } catch(e){}\n        }\n      }\n    }\n    for (var s = 0; s < document.styleSheets.length && !found; s++){\n      try { walk(document.styleSheets[s].cssRules); } catch(e){}\n    }\n    for (n = head; n && n.nodeType === 1 && !found; n = n.parentElement){\n      if (/safe-area-inset-top/.test(n.getAttribute(\"style\") || \"\")) found = true;\n    }\n    return found;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = (document.body.classList.contains(\"imm\") && !pageHandlesInset(head)) ? \"env(safe-area-inset-top)\" : \"0px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script>\n</body>\n</html>\n"}