{"name": "Air Quality", "kind": "html", "iconSymbol": "leaf.fill", "iconColor": "green", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Air Quality</title>\n<style>\n  :root { color-scheme: light dark; }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111);\n    max-width:600px; margin:0 auto; min-height:100dvh;\n    padding:16px 16px calc(30px + env(safe-area-inset-bottom));\n  }\n  h1{ font-size:22px; font-weight:800; margin:4px 2px 2px; }\n  .where{ font-size:13px; color:var(--myllm-muted,#8a8a8e); margin:0 2px 14px; display:flex; gap:8px; align-items:center; flex-wrap:wrap; }\n  .where button{ border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-surface,#fff); color:var(--myllm-text,#111); border-radius:99px; padding:4px 11px; font-size:12px; font-weight:650; }\n\n  .card{\n    background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8);\n    border-radius:18px; padding:16px; margin-bottom:12px;\n  }\n  .hero{ text-align:center; }\n  .aqiv{ font-size:64px; font-weight:800; line-height:1; }\n  .aqlbl{ font-size:17px; font-weight:750; margin-top:4px; }\n  .aqadv{ font-size:13.5px; color:var(--myllm-muted,#8a8a8e); margin-top:8px; line-height:1.5; }\n  .scale{ display:flex; height:9px; border-radius:99px; overflow:hidden; margin-top:14px; }\n  .scale i{ flex:1; }\n  .scale-dot{ position:relative; height:0; }\n  .scale-dot i{\n    position:absolute; top:-13px; width:15px; height:15px; border-radius:50%;\n    background:var(--myllm-surface,#fff); border:3px solid var(--myllm-text,#111);\n    transform:translateX(-50%);\n  }\n\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--myllm-muted,#8a8a8e); margin:0 0 10px; }\n  .grid{ display:grid; grid-template-columns:1fr 1fr; gap:9px; }\n  .pol{ background:var(--myllm-bg,#f2f2f7); border-radius:13px; padding:11px 12px; }\n  .pol small{ display:block; font-size:11px; font-weight:700; color:var(--myllm-muted,#8a8a8e); }\n  .pol b{ font-size:19px; font-variant-numeric:tabular-nums; }\n  .pol span{ font-size:11px; color:var(--myllm-muted,#8a8a8e); }\n  .pol .lv{ display:inline-block; margin-left:6px; width:9px; height:9px; border-radius:50%; }\n\n  .bars{ display:flex; align-items:flex-end; gap:3px; height:76px; }\n  .bars i{ flex:1; border-radius:3px 3px 0 0; min-height:4px; }\n  .barlbl{ display:flex; justify-content:space-between; font-size:10.5px; color:var(--myllm-muted,#8a8a8e); margin-top:5px; }\n\n  .status{ text-align:center; font-size:13.5px; color:var(--myllm-muted,#8a8a8e); padding:22px 12px; line-height:1.6; }\n  .setup input{\n    width:100%; font-size:16px; padding:11px 12px; border-radius:12px;\n    border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111);\n  }\n  .setup .row{ display:flex; gap:8px; }\n  .setup .row button{ border:none; border-radius:12px; padding:0 16px; font-size:15px; font-weight:700; background:var(--myllm-accent,#0a84ff); color:#fff; }\n  .setup .gps{ width:100%; border:1px solid var(--myllm-border,#e3e3e8); border-radius:12px; padding:12px; margin-top:9px; background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111); font-size:15px; font-weight:650; }\n  .note{ font-size:12.5px; color:var(--myllm-muted,#8a8a8e); margin-top:9px; line-height:1.5; }\n  .refresh{ width:100%; border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-surface,#fff); color:var(--myllm-text,#111); border-radius:13px; padding:12px; font-size:14px; font-weight:650; }\n</style>\n</head>\n<body>\n\n<h1>🌿 Air Quality</h1>\n<div class=\"where\" id=\"where\"></div>\n<div id=\"app\"><p class=\"status\">Finding your air…</p></div>\n\n<script>\nvar store = window.myllmStorage || {getItem:function(){return Promise.resolve(null)}, setItem:function(){return Promise.resolve()}};\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nvar NET = window.myllmFetch || null;\nvar LOC = window.myllmLocation || null;\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\"); }\n\nvar obs = null;\n/* European AQI bands */\nvar BANDS = [\n  {max:20,  name:\"Good\",           color:\"#30d158\", adv:\"Beautiful air. Windows open, lungs happy — enjoy being outside.\"},\n  {max:40,  name:\"Fair\",           color:\"#63c78b\", adv:\"Perfectly fine for everyone. Sensitive folks won't notice a thing.\"},\n  {max:60,  name:\"Moderate\",       color:\"#ffd60a\", adv:\"Fine for most. If you're very sensitive, take intense exercise a little easier.\"},\n  {max:80,  name:\"Poor\",           color:\"#ff9500\", adv:\"Consider lighter outdoor exercise; sensitive groups should limit time in traffic.\"},\n  {max:100, name:\"Very poor\",      color:\"#ff3b30\", adv:\"Keep outdoor exertion short; close windows on busy roads.\"},\n  {max:1e9, name:\"Extremely poor\", color:\"#af52de\", adv:\"Stay indoors where you can; masks help if you must be out long.\"}\n];\nfunction band(aqi){ for (var i = 0; i < BANDS.length; i++) if (aqi <= BANDS[i].max) return BANDS[i]; return BANDS[BANDS.length-1]; }\nfunction pollenLevel(v){\n  if (v == null) return null;\n  if (v < 25) return {name:\"Low\", color:\"#30d158\"};\n  if (v < 75) return {name:\"Moderate\", color:\"#ffd60a\"};\n  return {name:\"High\", color:\"#ff3b30\"};\n}\nfunction uvBand(u){\n  if (u < 3) return {name:\"Low\", color:\"#30d158\", adv:\"no protection needed\"};\n  if (u < 6) return {name:\"Moderate\", color:\"#ffd60a\", adv:\"hat and SPF if out long\"};\n  if (u < 8) return {name:\"High\", color:\"#ff9500\", adv:\"SPF, shade in the middle of the day\"};\n  if (u < 11) return {name:\"Very high\", color:\"#ff3b30\", adv:\"cover up, seek shade 11–3\"};\n  return {name:\"Extreme\", color:\"#af52de\", adv:\"avoid midday sun entirely\"};\n}\n\nfunction load(){\n  if (!NET){\n    el(\"app\").innerHTML = '<p class=\"status\">Air Quality needs internet access for apps — turn it on in MyLLMos settings, then reopen.</p>';\n    return;\n  }\n  el(\"app\").innerHTML = '<p class=\"status\">Reading the air around ' + esc(obs.label) + '…</p>';\n  var aq = \"https://air-quality-api.open-meteo.com/v1/air-quality?latitude=\" + obs.lat + \"&longitude=\" + obs.lon +\n    \"&current=european_aqi,us_aqi,pm2_5,pm10,ozone,nitrogen_dioxide,grass_pollen,birch_pollen,ragweed_pollen,olive_pollen,mugwort_pollen,alder_pollen\" +\n    \"&hourly=european_aqi&forecast_days=2&timezone=auto\";\n  var uv = \"https://api.open-meteo.com/v1/forecast?latitude=\" + obs.lat + \"&longitude=\" + obs.lon +\n    \"&daily=uv_index_max&forecast_days=1&timezone=auto\";\n  Promise.all([NET(aq), NET(uv)]).then(function(rs){\n    var a = JSON.parse(rs[0].body);\n    var u = JSON.parse(rs[1].body);\n    render(a, (u.daily && u.daily.uv_index_max && u.daily.uv_index_max[0]) || null);\n  }).catch(function(){\n    el(\"app\").innerHTML = '<p class=\"status\">Couldn\\'t reach the air-quality service — tap to retry.</p>' +\n      '<button class=\"refresh\" onclick=\"load()\">↻ Try again</button>';\n  });\n}\n\nfunction render(a, uvMax){\n  var c = a.current || {};\n  var aqi = Math.round(c.european_aqi != null ? c.european_aqi : -1);\n  if (aqi < 0){\n    el(\"app\").innerHTML = '<p class=\"status\">No air-quality data for this spot — try a nearby town.</p>';\n    return;\n  }\n  var b = band(aqi);\n  var pos = Math.min(100, aqi / 120 * 100);\n\n  var pols = [\n    {n:\"PM2.5 — fine particles\", v:c.pm2_5,  u:\"µg/m³\", warn:c.pm2_5 > 15},\n    {n:\"PM10 — dust\",            v:c.pm10,   u:\"µg/m³\", warn:c.pm10 > 45},\n    {n:\"Ozone\",                  v:c.ozone,  u:\"µg/m³\", warn:c.ozone > 120},\n    {n:\"NO₂ — traffic\",          v:c.nitrogen_dioxide, u:\"µg/m³\", warn:c.nitrogen_dioxide > 40}\n  ].filter(function(p){ return p.v != null; });\n\n  var pollens = [\n    {n:\"Grass\", v:c.grass_pollen}, {n:\"Birch\", v:c.birch_pollen}, {n:\"Ragweed\", v:c.ragweed_pollen},\n    {n:\"Olive\", v:c.olive_pollen}, {n:\"Mugwort\", v:c.mugwort_pollen}, {n:\"Alder\", v:c.alder_pollen}\n  ].map(function(p){ return {n:p.n, lv:pollenLevel(p.v), v:p.v}; }).filter(function(p){ return p.lv && p.v > 1; });\n\n  /* next 24 hourly bars from \"now\" */\n  var barsHtml = \"\";\n  if (a.hourly && a.hourly.time){\n    var nowIdx = 0, now = new Date(), best = 1e15;\n    for (var i = 0; i < a.hourly.time.length; i++){\n      var d = Math.abs(new Date(a.hourly.time[i]) - now);\n      if (d < best){ best = d; nowIdx = i; }\n    }\n    var slice = [];\n    for (var j = nowIdx; j < Math.min(nowIdx + 24, a.hourly.time.length); j++){\n      slice.push({t:a.hourly.time[j], v:a.hourly.european_aqi[j] || 0});\n    }\n    var maxV = Math.max(60, Math.max.apply(null, slice.map(function(s){ return s.v; })));\n    barsHtml = '<div class=\"card\"><h2>Next 24 hours</h2><div class=\"bars\">' +\n      slice.map(function(s){\n        return '<i style=\"height:' + Math.max(5, s.v / maxV * 100) + '%;background:' + band(s.v).color + '\"></i>';\n      }).join(\"\") + '</div><div class=\"barlbl\"><span>now</span><span>+12h</span><span>+24h</span></div></div>';\n  }\n\n  var uvHtml = \"\";\n  if (uvMax != null){\n    var ub = uvBand(uvMax);\n    uvHtml = '<div class=\"pol\"><small>UV index (today\\'s max)</small><b>' + Math.round(uvMax * 10) / 10 +\n      '<span class=\"lv\" style=\"background:' + ub.color + '\"></span></b><span> ' + ub.name + ' — ' + ub.adv + '</span></div>';\n  }\n\n  el(\"app\").innerHTML =\n    '<div class=\"card hero\">' +\n      '<div class=\"aqiv\" style=\"color:' + b.color + '\">' + aqi + '</div>' +\n      '<div class=\"aqlbl\">' + b.name + ' <span style=\"color:var(--myllm-muted,#8a8a8e);font-weight:500\">· European AQI</span></div>' +\n      '<div class=\"aqadv\">' + b.adv + '</div>' +\n      '<div class=\"scale\">' + BANDS.slice(0,5).map(function(x){ return '<i style=\"background:' + x.color + '\"></i>'; }).join(\"\") +\n        '<i style=\"background:' + BANDS[5].color + '\"></i></div>' +\n      '<div class=\"scale-dot\"><i style=\"left:' + pos + '%\"></i></div>' +\n    '</div>' +\n    '<div class=\"card\"><h2>What\\'s in the air</h2><div class=\"grid\">' +\n      pols.map(function(p){\n        return '<div class=\"pol\"><small>' + p.n + '</small><b>' + Math.round(p.v) +\n          '<span class=\"lv\" style=\"background:' + (p.warn ? \"#ff9500\" : \"#30d158\") + '\"></span></b><span> ' + p.u + '</span></div>';\n      }).join(\"\") + uvHtml + '</div></div>' +\n    (pollens.length ?\n      '<div class=\"card\"><h2>Pollen</h2><div class=\"grid\">' +\n      pollens.map(function(p){\n        return '<div class=\"pol\"><small>' + p.n + '</small><b style=\"font-size:15px\">' + p.lv.name +\n          '<span class=\"lv\" style=\"background:' + p.lv.color + '\"></span></b></div>';\n      }).join(\"\") + '</div></div>' : \"\") +\n    barsHtml +\n    '<button class=\"refresh\" onclick=\"load()\">↻ Refresh</button>';\n\n  el(\"where\").innerHTML = '📍 ' + esc(obs.label) + ' <button onclick=\"setupUI()\">Change</button>';\n  haptic(\"selection\");\n}\n\n/* ---------- location (sky-tonight pattern) ---------- */\nfunction setupUI(msg){\n  el(\"where\").innerHTML = \"\";\n  el(\"app\").innerHTML =\n    '<div class=\"card setup\"><h2>Where are you breathing?</h2>' +\n    '<div class=\"row\"><input id=\"q\" placeholder=\"e.g. Bristol\" onkeydown=\"if(event.key===\\'Enter\\')findPlace()\">' +\n    '<button onclick=\"findPlace()\">Go</button></div>' +\n    (LOC ? '<button class=\"gps\" onclick=\"useGps()\">📍 Use my location</button>' : \"\") +\n    '<p class=\"note\" id=\"setupnote\">' + (msg || \"Your location is used only on this device, to fetch the right forecast.\") + '</p></div>';\n}\nfunction useGps(){\n  haptic(\"light\");\n  el(\"setupnote\").textContent = \"Locating…\";\n  LOC.current().then(function(p){\n    obs = {lat:p.latitude, lon:p.longitude, label:(p.address || \"Your location\")};\n    store.setItem(\"aq_obs\", JSON.stringify(obs));\n    load();\n  }).catch(function(e){\n    el(\"setupnote\").textContent = (e && e.message ? e.message + \" — \" : \"\") + \"Try typing a place instead.\";\n  });\n}\nfunction findPlace(){\n  var q = (el(\"q\").value || \"\").trim();\n  if (!q) return;\n  haptic(\"light\");\n  var m = q.match(/^\\s*(-?\\d+(?:\\.\\d+)?)\\s*,\\s*(-?\\d+(?:\\.\\d+)?)\\s*$/);\n  if (m){\n    obs = {lat:parseFloat(m[1]), lon:parseFloat(m[2]), label:\"Lat \" + m[1] + \", Lon \" + m[2]};\n    store.setItem(\"aq_obs\", JSON.stringify(obs));\n    load(); return;\n  }\n  if (!NET){ el(\"setupnote\").textContent = \"Needs internet access for apps (MyLLMos settings).\"; return; }\n  el(\"setupnote\").textContent = \"Searching…\";\n  NET(\"https://geocoding-api.open-meteo.com/v1/search?count=1&name=\" + encodeURIComponent(q)).then(function(r){\n    var j = JSON.parse(r.body);\n    if (j.results && j.results.length){\n      var p = j.results[0];\n      obs = {lat:p.latitude, lon:p.longitude, label:p.name + (p.country_code ? \", \" + p.country_code : \"\")};\n      store.setItem(\"aq_obs\", JSON.stringify(obs));\n      load();\n    } else el(\"setupnote\").textContent = \"Couldn't find that place — try another spelling.\";\n  }).catch(function(){\n    el(\"setupnote\").textContent = \"Search didn't work — try \\\"lat, lon\\\" instead.\";\n  });\n}\n\n/* ---------- boot ---------- */\nstore.getItem(\"aq_obs\").then(function(v){\n  if (v){ try{ obs = JSON.parse(v); }catch(e){} }\n  if (obs && typeof obs.lat === \"number\"){ load(); return; }\n  if (LOC){\n    LOC.current().then(function(p){\n      obs = {lat:p.latitude, lon:p.longitude, label:(p.address || \"Your location\")};\n      store.setItem(\"aq_obs\", JSON.stringify(obs));\n      load();\n    }).catch(function(){ setupUI(); });\n  } else setupUI();\n});\n</script>\n</body>\n</html>\n"}