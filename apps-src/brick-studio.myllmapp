{"name": "Brick Studio", "kind": "html", "iconSymbol": "square.stack.3d.up.fill", "iconColor": "red", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Brick Studio</title>\n<style>\n  :root { color-scheme: light; }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:linear-gradient(180deg,#f6f3ff 0%,#eef4ff 100%);\n    color:#3a3550;\n    max-width:600px; margin:0 auto; min-height:100dvh;\n    padding:12px 12px calc(20px + env(safe-area-inset-bottom));\n    display:flex; flex-direction:column; gap:10px;\n  }\n  .top{ display:flex; align-items:center; justify-content:space-between; padding:0 4px; }\n  h1{ font-size:20px; font-weight:800; }\n  .top .steps{ font-size:12.5px; font-weight:700; color:#8d87a8; }\n\n  .board{ position:relative; background:#fffdf6; border:2px solid #e6e1f2; border-radius:20px; overflow:hidden; }\n  canvas{ display:block; width:100%; touch-action:manipulation; }\n  .banner-msg{\n    position:absolute; top:10px; left:50%; transform:translateX(-50%) translateY(-60px);\n    background:#3a3550; color:#fff; font-size:13px; font-weight:650; padding:9px 16px;\n    border-radius:99px; transition:transform .3s, opacity .3s; opacity:0; white-space:nowrap; max-width:92%;\n    overflow:hidden; text-overflow:ellipsis;\n  }\n  .banner-msg.show{ transform:translateX(-50%) translateY(0); opacity:1; }\n\n  .row{ display:flex; gap:7px; align-items:center; overflow-x:auto; scrollbar-width:none; padding:2px; }\n  .row::-webkit-scrollbar{ display:none; }\n  .swatch{ width:34px; height:34px; border-radius:11px; border:3px solid transparent; flex-shrink:0; }\n  .swatch.on{ border-color:#3a3550; }\n  .tool{\n    border:2px solid #e6e1f2; background:#fff; color:#3a3550; border-radius:13px;\n    padding:9px 12px; font-size:12.5px; font-weight:750; flex-shrink:0;\n  }\n  .tool.on{ background:#3a3550; color:#fff; border-color:#3a3550; }\n  .tool.warn{ color:#d05555; border-color:#f0c8c8; }\n  .brickbtn{ display:flex; align-items:center; gap:5px; }\n  .brickbtn .mini{ display:inline-block; background:#b9b2d8; border-radius:3px; }\n\n  .ai{ display:flex; gap:8px; }\n  .ai button{\n    flex:1; border:none; border-radius:14px; padding:12px 8px; font-size:13.5px; font-weight:750;\n    background:linear-gradient(135deg,#7c5cff,#5c8aff); color:#fff;\n  }\n  .ai button.ghost{ background:#fff; color:#3a3550; border:2px solid #e6e1f2; }\n\n  .sheet{ position:fixed; inset:0; background:rgba(58,53,80,.4); display:none; align-items:flex-end; z-index:9; }\n  .sheet.show{ display:flex; }\n  .sheetcard{ background:#fff; border-radius:22px 22px 0 0; padding:20px 18px calc(22px + env(safe-area-inset-bottom)); width:100%; max-width:600px; margin:0 auto; }\n  .sheetcard h2{ font-size:17px; margin-bottom:10px; }\n  .sheetcard input{ width:100%; font-size:16px; padding:12px; border-radius:13px; border:2px solid #e6e1f2; background:#f8f6ff; color:#3a3550; }\n  .sheetcard .go{ width:100%; border:none; border-radius:13px; padding:13px; margin-top:11px; font-size:15px; font-weight:750; background:linear-gradient(135deg,#7c5cff,#5c8aff); color:#fff; }\n  .sheetcard .cancel{ width:100%; border:none; background:none; color:#8d87a8; padding:11px; margin-top:4px; font-size:14px; font-weight:650; }\n  .ideas{ margin-top:8px; }\n  .ideas button{ width:100%; text-align:left; border:2px solid #e6e1f2; background:#f8f6ff; color:#3a3550; border-radius:13px; padding:11px 13px; font-size:14px; font-weight:650; margin-top:7px; }\n  .sheetnote{ font-size:12.5px; color:#8d87a8; line-height:1.5; margin-top:8px; }\n</style>\n</head>\n<body>\n\n<!-- AI busy cog (house convention) -->\n<style>\n.myllm-ai-busy{position:fixed;top:calc(10px + env(safe-area-inset-top));left:50%;transform:translateX(-50%) translateY(-60px);display:flex;gap:8px;align-items:center;background:#fff;border:1px solid #e6e1f2;border-radius:99px;padding:8px 15px;font-size:13px;font-weight:650;z-index:30;opacity:0;transition:all .25s;box-shadow:0 4px 18px rgba(0,0,0,.14)}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n</style>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\">⚙️</span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n\n<div class=\"top\">\n  <h1>🧱 Brick Studio</h1>\n  <span class=\"steps\" id=\"stepInfo\"></span>\n</div>\n\n<div class=\"board\">\n  <canvas id=\"cv\"></canvas>\n  <div class=\"banner-msg\" id=\"msg\"></div>\n</div>\n\n<div class=\"row\" id=\"palette\"></div>\n\n<div class=\"row\" id=\"tools\">\n  <button class=\"tool on\" id=\"sz-1x1\" onclick=\"setSize(1,1)\"><span class=\"brickbtn\"><span class=\"mini\" style=\"width:10px;height:10px\"></span>1×1</span></button>\n  <button class=\"tool\" id=\"sz-1x2\" onclick=\"setSize(1,2)\"><span class=\"brickbtn\"><span class=\"mini\" style=\"width:10px;height:18px\"></span>1×2</span></button>\n  <button class=\"tool\" id=\"sz-2x2\" onclick=\"setSize(2,2)\"><span class=\"brickbtn\"><span class=\"mini\" style=\"width:18px;height:18px\"></span>2×2</span></button>\n  <button class=\"tool\" id=\"sz-2x4\" onclick=\"setSize(2,4)\"><span class=\"brickbtn\"><span class=\"mini\" style=\"width:18px;height:30px\"></span>2×4</span></button>\n  <button class=\"tool\" onclick=\"rotateSize()\">↻ Rotate</button>\n  <button class=\"tool\" id=\"eraseBtn\" onclick=\"toggleErase()\">🧽 Erase</button>\n  <button class=\"tool\" onclick=\"undo()\">↩︎ Undo</button>\n  <button class=\"tool warn\" id=\"clearBtn\" onclick=\"clearAll()\">🗑 New</button>\n  <button class=\"tool\" onclick=\"saveRender()\">📸 Save</button>\n</div>\n\n<div class=\"ai\">\n  <button onclick=\"openBuildSheet()\">✨ Build for me</button>\n  <button class=\"ghost\" id=\"visionBtn\" onclick=\"whatCanWeBuild()\">📷 What can we build?</button>\n</div>\n\n<div class=\"sheet\" id=\"buildSheet\">\n  <div class=\"sheetcard\">\n    <h2>What shall we build? ✨</h2>\n    <input id=\"buildPrompt\" placeholder=\"a little duck… a rocket… a house\" autocomplete=\"off\">\n    <button class=\"go\" onclick=\"aiBuild()\">Build it, brick by brick</button>\n    <button class=\"cancel\" onclick=\"closeSheets()\">Cancel</button>\n  </div>\n</div>\n\n<div class=\"sheet\" id=\"ideaSheet\">\n  <div class=\"sheetcard\">\n    <h2>We could build… 🧱</h2>\n    <div class=\"ideas\" id=\"ideaList\"></div>\n    <p class=\"sheetnote\" id=\"ideaNote\"></p>\n    <button class=\"cancel\" onclick=\"closeSheets()\">Cancel</button>\n  </div>\n</div>\n\n<script>\nvar ASK = window.myllmAsk || null;\nvar VISION = window.myllmVision || null;\nvar SAVE = window.myllmSaveImage || null;\nvar store = window.myllmStorage || {getItem:function(){return Promise.resolve(null)}, setItem:function(){return Promise.resolve()}};\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction el(id){ return document.getElementById(id); }\n\n/* ---------- world ---------- */\nvar GW = 10, GD = 10, MAXH = 14;\nvar COLORS = {\n  red:\"#e05252\", orange:\"#f2913d\", yellow:\"#f2c53d\", green:\"#5cb85f\",\n  mint:\"#79d0a6\", blue:\"#4f86e0\", purple:\"#8b6cd9\", white:\"#f2f0ea\"\n};\nvar COLOR_KEYS = Object.keys(COLORS);\nvar SIZES = [[1,1],[1,2],[2,1],[2,2],[2,4],[4,2]];\n\nvar bricks = [];          /* {x,z,y,w,d,c} — y computed by gravity */\nvar sel = { c:\"red\", w:1, d:1, erase:false };\nvar undoStack = [];\nvar plan = null;          /* {name, list:[...], i} during AI step-through */\nvar planTimer = null;\n\n/* ---------- pure engine (node-tested) ---------- */\nfunction inBounds(x, z, w, d){ return x >= 0 && z >= 0 && w >= 1 && d >= 1 && x + w <= GW && z + d <= GD; }\n\nfunction topAt(x, z){\n  var t = 0;\n  for (var i = 0; i < bricks.length; i++){\n    var b = bricks[i];\n    if (x >= b.x && x < b.x + b.w && z >= b.z && z < b.z + b.d)\n      t = Math.max(t, b.y + 1);\n  }\n  return t;\n}\n\nfunction placeY(x, z, w, d){\n  var y = 0;\n  for (var dx = 0; dx < w; dx++)\n    for (var dz = 0; dz < d; dz++)\n      y = Math.max(y, topAt(x + dx, z + dz));\n  return y;\n}\n\nfunction addBrick(x, z, w, d, c){\n  if (!inBounds(x, z, w, d) || !COLORS[c]) return null;\n  var y = placeY(x, z, w, d);\n  if (y >= MAXH) return null;\n  var b = { x:x, z:z, y:y, w:w, d:d, c:c };\n  bricks.push(b);\n  return b;\n}\n\nfunction removeTopAt(x, z){\n  var best = -1, bestY = -1;\n  for (var i = 0; i < bricks.length; i++){\n    var b = bricks[i];\n    if (x >= b.x && x < b.x + b.w && z >= b.z && z < b.z + b.d && b.y > bestY){\n      bestY = b.y; best = i;\n    }\n  }\n  if (best < 0) return null;\n  return bricks.splice(best, 1)[0];\n}\n\n/* AI plan contract:\n   NAME: duck\n   BRICK: x z WxD color      (one per line, build order; y is gravity-computed)\n   Forgiving parse: clamp coords into bounds, snap unknown sizes to nearest,\n   skip unknown colors, cap at 60 bricks. */\nfunction parsePlan(raw){\n  var name = null, list = [];\n  String(raw||\"\").split(/\\n+/).forEach(function(line){\n    var nm = line.match(/^\\s*\\**\\s*NAME\\s*\\**\\s*[:：]\\s*(.+)$/i);\n    if (nm){ name = nm[1].replace(/\\*+/g,\"\").trim().slice(0, 30); return; }\n    var m = line.match(/^\\s*\\**\\s*BRICK\\s*\\**\\s*[:：]\\s*(\\d+)\\s+(\\d+)\\s+(\\d+)\\s*[xX×]\\s*(\\d+)\\s+([a-z]+)\\s*$/i);\n    if (!m || list.length >= 60) return;\n    var x = +m[1], z = +m[2], w = +m[3], d = +m[4], c = m[5].toLowerCase();\n    if (!COLORS[c]) return;\n    var ok = SIZES.some(function(s){ return s[0] === w && s[1] === d; });\n    if (!ok){\n      w = Math.min(4, Math.max(1, w)); d = Math.min(4, Math.max(1, d));\n      if (w > 2 && d > 2){ w = 2; d = 2; }\n      if (w === 3){ w = 2; } if (d === 3){ d = 2; }\n    }\n    x = Math.min(GW - w, Math.max(0, x));\n    z = Math.min(GD - d, Math.max(0, z));\n    list.push({ x:x, z:z, w:w, d:d, c:c });\n  });\n  return { name: name || \"something wonderful\", list: list };\n}\n\n/* ---------- iso rendering ---------- */\nvar TW = 46, TH = 23, BH = 26;   /* tile width/height, brick visual height */\nvar cv, ctx, DPR = 1, ox = 0, oy = 0;\n\nfunction shade(hex, f){\n  var n = parseInt(hex.slice(1), 16);\n  var r = Math.min(255, Math.max(0, ((n >> 16) & 255) * f | 0));\n  var g = Math.min(255, Math.max(0, ((n >> 8) & 255) * f | 0));\n  var b = Math.min(255, Math.max(0, (n & 255) * f | 0));\n  return \"rgb(\" + r + \",\" + g + \",\" + b + \")\";\n}\n\nfunction isoX(x, z){ return ox + (x - z) * TW / 2; }\nfunction isoY(x, z, y){ return oy + (x + z) * TH / 2 - y * (BH * 0.62); }\n\nfunction draw(){\n  ctx.clearRect(0, 0, cv.width, cv.height);\n  ctx.save(); ctx.scale(DPR, DPR);\n  /* ground */\n  for (var z = 0; z < GD; z++)\n    for (var x = 0; x < GW; x++){\n      diamond(x, z, 0, \"#efeafb\", \"#e2dbf4\");\n    }\n  /* bricks: painter's order */\n  var sorted = bricks.slice().sort(function(a, b){\n    return (a.y - b.y) || ((a.x + a.z) - (b.x + b.z));\n  });\n  for (var i = 0; i < sorted.length; i++) drawBrick(sorted[i]);\n  ctx.restore();\n}\n\nfunction diamond(x, z, y, fill, stroke){\n  ctx.beginPath();\n  ctx.moveTo(isoX(x, z), isoY(x, z, y));\n  ctx.lineTo(isoX(x + 1, z), isoY(x + 1, z, y));\n  ctx.lineTo(isoX(x + 1, z + 1), isoY(x + 1, z + 1, y));\n  ctx.lineTo(isoX(x, z + 1), isoY(x, z + 1, y));\n  ctx.closePath();\n  ctx.fillStyle = fill; ctx.fill();\n  if (stroke){ ctx.strokeStyle = stroke; ctx.lineWidth = 1; ctx.stroke(); }\n}\n\nfunction drawBrick(b){\n  var base = COLORS[b.c];\n  var topY = b.y + 1;\n  /* left face */\n  ctx.beginPath();\n  ctx.moveTo(isoX(b.x, b.z + b.d), isoY(b.x, b.z + b.d, topY));\n  ctx.lineTo(isoX(b.x + b.w, b.z + b.d), isoY(b.x + b.w, b.z + b.d, topY));\n  ctx.lineTo(isoX(b.x + b.w, b.z + b.d), isoY(b.x + b.w, b.z + b.d, b.y));\n  ctx.lineTo(isoX(b.x, b.z + b.d), isoY(b.x, b.z + b.d, b.y));\n  ctx.closePath(); ctx.fillStyle = shade(base, 0.72); ctx.fill();\n  /* right face */\n  ctx.beginPath();\n  ctx.moveTo(isoX(b.x + b.w, b.z), isoY(b.x + b.w, b.z, topY));\n  ctx.lineTo(isoX(b.x + b.w, b.z + b.d), isoY(b.x + b.w, b.z + b.d, topY));\n  ctx.lineTo(isoX(b.x + b.w, b.z + b.d), isoY(b.x + b.w, b.z + b.d, b.y));\n  ctx.lineTo(isoX(b.x + b.w, b.z), isoY(b.x + b.w, b.z, b.y));\n  ctx.closePath(); ctx.fillStyle = shade(base, 0.86); ctx.fill();\n  /* top face */\n  ctx.beginPath();\n  ctx.moveTo(isoX(b.x, b.z), isoY(b.x, b.z, topY));\n  ctx.lineTo(isoX(b.x + b.w, b.z), isoY(b.x + b.w, b.z, topY));\n  ctx.lineTo(isoX(b.x + b.w, b.z + b.d), isoY(b.x + b.w, b.z + b.d, topY));\n  ctx.lineTo(isoX(b.x, b.z + b.d), isoY(b.x, b.z + b.d, topY));\n  ctx.closePath(); ctx.fillStyle = base; ctx.fill();\n  ctx.strokeStyle = shade(base, 0.68); ctx.lineWidth = 1.2; ctx.stroke();\n  /* studs */\n  ctx.fillStyle = shade(base, 1.12);\n  for (var sx = 0; sx < b.w; sx++)\n    for (var sz = 0; sz < b.d; sz++){\n      var cxp = (isoX(b.x + sx, b.z + sz) + isoX(b.x + sx + 1, b.z + sz + 1)) / 2;\n      var cyp = (isoY(b.x + sx, b.z + sz, topY) + isoY(b.x + sx + 1, b.z + sz + 1, topY)) / 2;\n      ctx.beginPath();\n      ctx.ellipse(cxp, cyp, TW * 0.16, TH * 0.16, 0, 0, Math.PI * 2);\n      ctx.fill();\n    }\n}\n\n/* column hit-test: walk columns near the tap, prefer the visually nearest\n   (largest x+z wins because it draws in front). Pure-ish for testing. */\nfunction columnFromPoint(px, py){\n  var best = null, bestKey = -1;\n  for (var z = 0; z < GD; z++)\n    for (var x = 0; x < GW; x++){\n      var y = topAt(x, z);\n      var cx = (isoX(x, z) + isoX(x + 1, z + 1)) / 2;\n      var cyTop = (isoY(x, z, y) + isoY(x + 1, z + 1, y)) / 2;\n      var dx = px - cx, dy = py - cyTop;\n      if (Math.abs(dx) <= TW * 0.5 && Math.abs(dy) <= TH * 0.75){\n        var key = x + z + y * 100;\n        if (key > bestKey){ bestKey = key; best = { x:x, z:z }; }\n      }\n    }\n  return best;\n}\n\n/* ---------- interaction ---------- */\nfunction setSize(w, d){\n  sel.w = w; sel.d = d; sel.erase = false;\n  haptic(\"selection\"); syncTools();\n}\nfunction rotateSize(){ var t = sel.w; sel.w = sel.d; sel.d = t; haptic(\"selection\"); syncTools(); }\nfunction toggleErase(){ sel.erase = !sel.erase; haptic(\"selection\"); syncTools(); }\n\nfunction syncTools(){\n  [\"1x1\",\"1x2\",\"2x2\",\"2x4\"].forEach(function(k){\n    var b = el(\"sz-\" + k);\n    var m = k.split(\"x\");\n    b.className = \"tool\" + ((!sel.erase && ((sel.w == m[0] && sel.d == m[1]) || (sel.w == m[1] && sel.d == m[0]))) ? \" on\" : \"\");\n  });\n  el(\"eraseBtn\").className = \"tool\" + (sel.erase ? \" on\" : \"\");\n  renderPalette();\n}\n\nfunction renderPalette(){\n  el(\"palette\").innerHTML = COLOR_KEYS.map(function(c){\n    return '<button class=\"swatch' + (sel.c === c && !sel.erase ? ' on' : '') + '\" style=\"background:' + COLORS[c] + '\" onclick=\"pickColor(\\'' + c + '\\')\"></button>';\n  }).join(\"\");\n}\nfunction pickColor(c){ sel.c = c; sel.erase = false; haptic(\"selection\"); syncTools(); }\n\nfunction tapAt(px, py){\n  if (plan) return;                     /* watch the AI build, then play */\n  var col = columnFromPoint(px, py);\n  if (!col) return;\n  if (sel.erase){\n    var r = removeTopAt(col.x, col.z);\n    if (r){ haptic(\"light\"); pushUndo({ op:\"remove\", brick:r }); draw(); persist(); }\n    return;\n  }\n  var x = Math.min(GW - sel.w, col.x), z = Math.min(GD - sel.d, col.z);\n  var b = addBrick(x, z, sel.w, sel.d, sel.c);\n  if (b){ haptic(\"light\"); pushUndo({ op:\"add\", brick:b }); draw(); persist(); }\n  else msg(\"No room there — try another spot\");\n}\n\nfunction pushUndo(step){ undoStack.push(step); if (undoStack.length > 80) undoStack.shift(); }\n\nfunction undo(){\n  var s = undoStack.pop();\n  if (!s) return;\n  haptic(\"selection\");\n  if (s.op === \"add\"){ var i = bricks.indexOf(s.brick); if (i >= 0) bricks.splice(i, 1); }\n  else bricks.push(s.brick);\n  draw(); persist();\n}\n\nvar clearArmed = false;\nfunction clearAll(){\n  if (!clearArmed){\n    clearArmed = true; el(\"clearBtn\").textContent = \"Sure?\";\n    setTimeout(function(){ clearArmed = false; el(\"clearBtn\").textContent = \"🗑 New\"; }, 2400);\n    return;\n  }\n  clearArmed = false; el(\"clearBtn\").textContent = \"🗑 New\";\n  haptic(\"warning\");\n  stopPlan(); bricks = []; undoStack = []; draw(); persist();\n  el(\"stepInfo\").textContent = \"\";\n}\n\nfunction msg(text, ms){\n  var m = el(\"msg\");\n  m.textContent = text; m.classList.add(\"show\");\n  clearTimeout(m._t); m._t = setTimeout(function(){ m.classList.remove(\"show\"); }, ms || 2600);\n}\n\n/* ---------- AI: build for me ---------- */\nfunction openBuildSheet(){\n  if (!ASK){ msg(\"Building together needs AI — enable it in MyLLM Settings\"); return; }\n  el(\"buildSheet\").classList.add(\"show\");\n  setTimeout(function(){ el(\"buildPrompt\").focus(); }, 250);\n}\nfunction closeSheets(){\n  el(\"buildSheet\").classList.remove(\"show\");\n  el(\"ideaSheet\").classList.remove(\"show\");\n}\n\nfunction aiBuild(subject){\n  var want = subject || el(\"buildPrompt\").value.trim();\n  if (!want) return;\n  closeSheets();\n  haptic(\"medium\");\n  var p = \"Design a cute simple toy-brick model of: \" + want + \"\\n\" +\n    \"Grid: 10x10 studs (x and z from 0 to 9). Bricks stack automatically — list them bottom layer first.\\n\" +\n    \"Allowed sizes: 1x1, 1x2, 2x1, 2x2, 2x4, 4x2. Allowed colors: \" + COLOR_KEYS.join(\", \") + \".\\n\" +\n    \"Use 8 to 30 bricks. Make it recognisable and chunky, centred near the middle.\\n\" +\n    \"Reply in EXACTLY this format, nothing else:\\n\" +\n    \"NAME: what you built\\n\" +\n    \"BRICK: x z WxD color\\n\" +\n    \"BRICK: x z WxD color\\n(one line per brick, in build order)\";\n  ASK(p).then(function(raw){\n    var parsed = parsePlan(raw);\n    if (parsed.list.length < 3){ msg(\"The AI's plan was too wobbly — try again!\"); return; }\n    startPlan(parsed);\n  }).catch(function(){ msg(\"The AI is napping — try again in a moment\"); });\n}\n\nfunction startPlan(parsed){\n  stopPlan();\n  bricks = []; undoStack = [];\n  plan = { name: parsed.name, list: parsed.list, i: 0 };\n  draw();\n  msg(\"Building \" + plan.name + \"…\", 3200);\n  planTimer = setInterval(stepPlan, 640);\n}\n\nfunction stepPlan(){\n  if (!plan) return;\n  if (plan.i >= plan.list.length){ finishPlan(); return; }\n  var s = plan.list[plan.i++];\n  addBrick(s.x, s.z, s.w, s.d, s.c);\n  haptic(\"light\");\n  el(\"stepInfo\").textContent = \"Brick \" + plan.i + \" of \" + plan.list.length;\n  draw();\n}\n\nfunction finishPlan(){\n  var name = plan ? plan.name : \"\";\n  stopPlan();\n  haptic(\"success\");\n  el(\"stepInfo\").textContent = \"\";\n  msg(\"Ta-da! One \" + name + \" 🎉 — now make it yours\", 4200);\n  persist();\n}\n\nfunction stopPlan(){\n  if (planTimer){ clearInterval(planTimer); planTimer = null; }\n  plan = null;\n}\n\n/* ---------- AI: what can we build (camera) ---------- */\nfunction whatCanWeBuild(){\n  if (!VISION || !ASK){\n    msg(VISION ? \"Needs AI enabled in MyLLM Settings\" : \"Camera ideas need the MyLLM app with vision\");\n    return;\n  }\n  haptic(\"light\");\n  VISION(\"Look at these toy building bricks. Briefly list roughly what you see: the main colours and an idea of how many bricks (a few / a pile / lots).\")\n    .then(function(seen){\n      var p = \"A child has these toy bricks: \" + String(seen).slice(0, 300) + \"\\n\" +\n        \"Suggest exactly 3 simple, fun things they could build with them. \" +\n        \"Reply as 3 lines, each: IDEA: name|one short encouraging sentence\";\n      return ASK(p);\n    })\n    .then(function(raw){\n      var ideas = [];\n      String(raw||\"\").split(/\\n+/).forEach(function(l){\n        var m = l.match(/^\\s*\\**\\s*IDEA\\s*\\**\\s*[:：]\\s*([^|]+)\\|(.+)$/i);\n        if (m) ideas.push({ name: m[1].trim().slice(0, 28), why: m[2].trim().slice(0, 90) });\n      });\n      if (!ideas.length){ msg(\"Hmm, no ideas came — try again!\"); return; }\n      el(\"ideaList\").innerHTML = ideas.slice(0, 3).map(function(i, idx){\n        return '<button onclick=\"buildIdea(' + idx + ')\"><b>' + i.name + '</b><br><span style=\"font-weight:500;color:#8d87a8\">' + i.why + '</span></button>';\n      }).join(\"\");\n      window.__ideas = ideas;\n      el(\"ideaNote\").textContent = \"Tap one and we'll build it on screen — then copy it with your real bricks!\";\n      el(\"ideaSheet\").classList.add(\"show\");\n    })\n    .catch(function(){ msg(\"Couldn't peek at the bricks — try again\"); });\n}\n\nfunction buildIdea(i){\n  var idea = (window.__ideas || [])[i];\n  closeSheets();\n  if (idea) aiBuild(idea.name);\n}\n\n/* ---------- save & persist ---------- */\nfunction saveRender(){\n  if (!bricks.length){ msg(\"Nothing built yet!\"); return; }\n  if (!SAVE){ msg(\"Saving needs the MyLLM app\"); return; }\n  haptic(\"medium\");\n  var du = cv.toDataURL(\"image/png\");\n  SAVE(du).then(function(){ msg(\"Saved to Photos 🧱✨\"); haptic(\"success\"); })\n    .catch(function(e){ msg(String(e && e.message || \"Couldn't save\")); });\n}\n\nfunction persist(){\n  store.setItem(\"bricks_v1\", JSON.stringify({ bricks: bricks.map(function(b){\n    return [b.x, b.z, b.y, b.w, b.d, b.c];\n  })}));\n}\n\n/* ---------- boot ---------- */\nfunction fit(){\n  DPR = window.devicePixelRatio || 1;\n  var w = el(\"cv\").parentNode.clientWidth || 360;\n  var h = Math.min(430, Math.max(320, window.innerHeight * 0.44));\n  cv.width = w * DPR; cv.height = h * DPR;\n  cv.style.height = h + \"px\";\n  ox = w / 2; oy = h - GD * TH / 2 - GW * TH / 2 - 24 + (GW + GD) * TH / 4 - 96;\n  /* center the diamond: top corner at (ox, oy) */\n  oy = Math.max(40, (h - (GW + GD) * TH / 2) / 2 + 40);\n  draw();\n}\n\n(function boot(){\n  cv = el(\"cv\"); ctx = cv.getContext(\"2d\");\n  renderPalette(); syncTools();\n  cv.addEventListener(\"click\", function(e){\n    var r = cv.getBoundingClientRect();\n    tapAt(e.clientX - r.left, e.clientY - r.top);\n  });\n  window.addEventListener(\"resize\", fit);\n  store.getItem(\"bricks_v1\").then(function(v){\n    if (v){ try{\n      var d = JSON.parse(v);\n      (d.bricks || []).forEach(function(a){\n        bricks.push({ x:a[0], z:a[1], y:a[2], w:a[3], d:a[4], c:a[5] });\n      });\n    }catch(_){} }\n    fit();\n  });\n  if (!VISION) el(\"visionBtn\").style.opacity = 0.55;\n})();\n</script>\n</body>\n</html>\n"}