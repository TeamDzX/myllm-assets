{
  "name": "Chess Clock",
  "kind": "html",
  "iconSymbol": "timer",
  "iconColor": "orange",
  "html": "<!doctype html>\n<!--\n  Chess Clock — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no\">\n<title>Chess Clock</title>\n<style>\n  :root{--build-id:\"e1eb6de5a6\";\n    color-scheme: dark;\n    --cream:#f2ead9; --cream-2:#e4d8bf; --ink:#1b1815;\n    --slate:#22201e; --slate-2:#171513; --chalk:#efe9df;\n    --brass:#c99a3f; --brass-soft:rgba(201,154,63,.22);\n    --warn:#e0912f; --danger:#d8452f; --ok:#4e8d5b;\n    --font:-apple-system,system-ui,\"Segoe UI\",sans-serif;\n  }\n  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\n  html,body{height:100%;margin:0;overscroll-behavior:none}\n  body{\n    font-family:var(--font); background:#0d0c0b; color:var(--chalk);\n    user-select:none; -webkit-user-select:none; touch-action:manipulation;\n    display:flex; flex-direction:column;\n  }\n\n  /* ---------- the two clock faces ---------- */\n  .board{flex:1;display:flex;flex-direction:column;min-height:0}\n  .side{\n    flex:1; position:relative; display:flex; align-items:center; justify-content:center;\n    border:0; padding:0; margin:0; font:inherit; color:inherit; width:100%;\n    background:var(--slate); transition:background .18s, opacity .18s;\n    min-height:0; overflow:hidden;\n  }\n  /* The far player reads across the phone, so their half is upside down. */\n  .side.flip .inner{transform:rotate(180deg)}\n  .side.white{background:var(--cream); color:var(--ink)}\n  .side.black{background:var(--slate); color:var(--chalk)}\n\n  /* Only the running side is lit; the waiting side recedes so there is never a\n     question about whose move it is from across a table. */\n  .side.idle{opacity:.5}\n  .side.live.white{background:linear-gradient(180deg,#fffaf0,var(--cream))}\n  .side.live.black{background:linear-gradient(180deg,#2c2926,var(--slate))}\n  .side.live::after{\n    content:\"\"; position:absolute; inset:0; border:3px solid var(--brass);\n    border-radius:2px; pointer-events:none;\n  }\n  .side.low.live{animation:pulseLow 1s ease-in-out infinite}\n  @keyframes pulseLow{50%{filter:brightness(1.16)}}\n  .side.flagged{background:var(--danger) !important; color:#fff !important; opacity:1}\n\n  .inner{display:flex;flex-direction:column;align-items:center;gap:6px;padding:12px;\n         transition:transform .2s}\n  .clock{\n    font-size:clamp(52px,17vw,120px); font-weight:600; line-height:1;\n    font-variant-numeric:tabular-nums; letter-spacing:-.02em;\n  }\n  .clock .frac{font-size:.52em;opacity:.62}\n  .side.low .clock{color:var(--danger)}\n  .side.white.low .clock{color:#b3301c}\n  .meta{font-size:12.5px;opacity:.62;display:flex;gap:12px;align-items:center;\n        font-variant-numeric:tabular-nums}\n  .who{font-size:11px;letter-spacing:.14em;text-transform:uppercase;opacity:.5;font-weight:600}\n  .stage-note{font-size:11.5px;color:var(--brass);min-height:14px;font-weight:600}\n\n  /* ---------- centre control bar ---------- */\n  .bar{\n    display:flex; align-items:center; justify-content:center; gap:10px;\n    padding:9px 12px calc(9px + env(safe-area-inset-bottom));\n    background:#0d0c0b; border-top:1px solid rgba(255,255,255,.09); flex:0 0 auto;\n  }\n  .bar .ctl{\n    appearance:none;border:1px solid rgba(255,255,255,.16);background:#1a1817;color:var(--chalk);\n    border-radius:11px; height:42px; min-width:42px; padding:0 13px; font:inherit; font-size:13.5px;\n    font-weight:600; display:inline-flex; align-items:center; justify-content:center; gap:6px;\n  }\n  .bar .ctl:active{background:#262322}\n  .bar .ctl.primary{background:var(--brass);border-color:var(--brass);color:#20180a}\n  .bar .name{flex:1;text-align:center;font-size:12.5px;opacity:.62;overflow:hidden;\n             text-overflow:ellipsis;white-space:nowrap}\n\n  /* ---------- sheets ---------- */\n  .scrim{position:fixed;inset:0;background:rgba(0,0,0,.62);display:none;z-index:20;\n         align-items:flex-end;justify-content:center}\n  .scrim.open{display:flex}\n  .sheet{\n    background:#141211;width:100%;max-width:560px;max-height:88dvh;overflow:auto;\n    border-radius:20px 20px 0 0;padding:20px 18px calc(22px + env(safe-area-inset-bottom));\n    border:1px solid rgba(255,255,255,.1);border-bottom:0;\n  }\n  .sheet h2{margin:0 0 3px;font-size:17px}\n  .sheet .cap{margin:0 0 16px;font-size:12.5px;opacity:.55;line-height:1.5}\n  .grp{margin-bottom:18px}\n  .grp h3{margin:0 0 8px;font-size:11px;letter-spacing:.13em;text-transform:uppercase;\n          opacity:.45;font-weight:700}\n  .presets{display:grid;grid-template-columns:repeat(auto-fill,minmax(96px,1fr));gap:8px}\n  .preset{\n    appearance:none;border:1px solid rgba(255,255,255,.14);background:#1d1a18;color:var(--chalk);\n    border-radius:12px;padding:11px 8px;font:inherit;text-align:center;\n  }\n  .preset:active{background:#282422}\n  .preset[aria-pressed=\"true\"]{border-color:var(--brass);background:var(--brass-soft)}\n  .preset b{display:block;font-size:15.5px;font-weight:650;font-variant-numeric:tabular-nums}\n  .preset span{display:block;font-size:11px;opacity:.55;margin-top:2px}\n\n  .row{display:flex;align-items:center;justify-content:space-between;gap:12px;\n       padding:11px 0;border-top:1px solid rgba(255,255,255,.08)}\n  .row:first-of-type{border-top:0}\n  .row label{font-size:14px}\n  .row .hint{font-size:11.5px;opacity:.5;margin-top:2px;line-height:1.45}\n  .row input[type=number],.row select{\n    background:#221f1d;border:1px solid rgba(255,255,255,.16);color:var(--chalk);\n    border-radius:10px;padding:9px 11px;font:inherit;font-size:14px;width:96px;text-align:right;\n  }\n  .row select{width:auto;text-align:left}\n  .row input:focus,.row select:focus{outline:2px solid var(--brass);outline-offset:-1px}\n  .seg{display:inline-flex;background:#221f1d;border:1px solid rgba(255,255,255,.14);\n       border-radius:10px;padding:2px}\n  .seg button{appearance:none;border:0;background:transparent;color:var(--chalk);font:inherit;\n              font-size:12.5px;font-weight:600;padding:7px 11px;border-radius:8px;opacity:.6}\n  .seg button[aria-pressed=\"true\"]{background:var(--brass);color:#20180a;opacity:1}\n  .sheet .go{\n    appearance:none;border:0;background:var(--brass);color:#20180a;font:inherit;font-size:15.5px;\n    font-weight:700;border-radius:13px;padding:14px;width:100%;margin-top:6px;\n  }\n  .sheet .close{\n    appearance:none;border:1px solid rgba(255,255,255,.16);background:transparent;color:var(--chalk);\n    font:inherit;font-size:14px;border-radius:13px;padding:12px;width:100%;margin-top:9px;\n  }\n\n  /* ---------- result banner ---------- */\n  .result{\n    position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);z-index:15;\n    background:#141211;border:1px solid var(--brass);border-radius:16px;padding:18px 22px;\n    text-align:center;display:none;box-shadow:0 18px 50px rgba(0,0,0,.6);max-width:82vw;\n    pointer-events:none;\n  }\n  .result.show{display:block}\n  .result h2{margin:0 0 4px;font-size:19px}\n  .result p{margin:0;font-size:13px;opacity:.62}\n</style>\n</head>\n<body>\n\n<div class=\"board\">\n  <button class=\"side flip black idle\" id=\"side-1\" aria-label=\"Black clock\">\n    <div class=\"inner\">\n      <div class=\"who\" id=\"who-1\">Black</div>\n      <div class=\"clock\" id=\"clock-1\">5:00</div>\n      <div class=\"meta\"><span id=\"moves-1\">0 moves</span></div>\n      <div class=\"stage-note\" id=\"stage-1\"></div>\n    </div>\n  </button>\n  <button class=\"side white idle\" id=\"side-0\" aria-label=\"White clock\">\n    <div class=\"inner\">\n      <div class=\"who\" id=\"who-0\">White</div>\n      <div class=\"clock\" id=\"clock-0\">5:00</div>\n      <div class=\"meta\"><span id=\"moves-0\">0 moves</span></div>\n      <div class=\"stage-note\" id=\"stage-0\"></div>\n    </div>\n  </button>\n</div>\n\n<div class=\"bar\">\n  <button class=\"ctl\" id=\"reset\" aria-label=\"Reset clocks\">↺</button>\n  <button class=\"ctl primary\" id=\"playpause\" aria-label=\"Start or pause\">▶</button>\n  <div class=\"name\" id=\"control-name\">Blitz · 5 + 0</div>\n  <button class=\"ctl\" id=\"sound\" aria-label=\"Toggle sound\">🔔</button>\n  <button class=\"ctl\" id=\"settings\" aria-label=\"Time control settings\">⚙</button>\n</div>\n\n<div class=\"result\" id=\"result\" role=\"status\">\n  <h2 id=\"result-t\"></h2>\n  <p id=\"result-p\"></p>\n</div>\n\n<div class=\"scrim\" id=\"scrim\">\n  <div class=\"sheet\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"sheet-t\">\n    <h2 id=\"sheet-t\">Time control</h2>\n    <p class=\"cap\">Pick a standard control, or build your own below. Choosing one resets both clocks.</p>\n\n    <div class=\"grp\"><h3>Bullet</h3><div class=\"presets\" data-band=\"bullet\"></div></div>\n    <div class=\"grp\"><h3>Blitz</h3><div class=\"presets\" data-band=\"blitz\"></div></div>\n    <div class=\"grp\"><h3>Rapid</h3><div class=\"presets\" data-band=\"rapid\"></div></div>\n    <div class=\"grp\"><h3>Classical &amp; tournament</h3><div class=\"presets\" data-band=\"classical\"></div></div>\n\n    <div class=\"grp\">\n      <h3>Custom</h3>\n      <div class=\"row\">\n        <label for=\"c-min\">Minutes each</label>\n        <input type=\"number\" id=\"c-min\" min=\"0\" max=\"360\" step=\"1\" value=\"5\" inputmode=\"numeric\">\n      </div>\n      <div class=\"row\">\n        <div><label for=\"c-inc\">Extra seconds a move</label>\n          <div class=\"hint\" id=\"inc-hint\">Added to your clock each time you press.</div></div>\n        <input type=\"number\" id=\"c-inc\" min=\"0\" max=\"180\" step=\"1\" value=\"0\" inputmode=\"numeric\">\n      </div>\n      <div class=\"row\">\n        <label for=\"c-mode\">Method</label>\n        <select id=\"c-mode\">\n          <option value=\"fischer\">Increment (Fischer)</option>\n          <option value=\"bronstein\">Bronstein delay</option>\n          <option value=\"delay\">Simple delay (US)</option>\n        </select>\n      </div>\n      <div class=\"row\">\n        <div><label for=\"c-sec\">Second time control</label>\n          <div class=\"hint\">Tournament style: after a set number of moves, both players get extra minutes. Leave at 0 moves for a single control.</div></div>\n      </div>\n      <div class=\"row\">\n        <label for=\"c-after\">After … moves</label>\n        <input type=\"number\" id=\"c-after\" min=\"0\" max=\"120\" step=\"1\" value=\"0\" inputmode=\"numeric\">\n      </div>\n      <div class=\"row\">\n        <label for=\"c-add\">Add … minutes</label>\n        <input type=\"number\" id=\"c-add\" min=\"0\" max=\"180\" step=\"1\" value=\"0\" inputmode=\"numeric\">\n      </div>\n      <button class=\"go\" id=\"use-custom\">Use this control</button>\n    </div>\n\n    <div class=\"grp\">\n      <h3>Options</h3>\n      <div class=\"row\">\n        <div><label>Sound &amp; buzz</label>\n          <div class=\"hint\">A tick when you press, and a warning when a clock drops under ten seconds.</div></div>\n        <div class=\"seg\" id=\"seg-sound\">\n          <button data-v=\"on\" aria-pressed=\"true\">On</button>\n          <button data-v=\"off\" aria-pressed=\"false\">Off</button>\n        </div>\n      </div>\n      <div class=\"row\">\n        <div><label>Low-time warning</label>\n          <div class=\"hint\">When a clock turns red.</div></div>\n        <div class=\"seg\" id=\"seg-low\">\n          <button data-v=\"10\" aria-pressed=\"true\">10s</button>\n          <button data-v=\"30\" aria-pressed=\"false\">30s</button>\n          <button data-v=\"60\" aria-pressed=\"false\">60s</button>\n        </div>\n      </div>\n    </div>\n\n    <button class=\"close\" id=\"close\">Done</button>\n  </div>\n</div>\n\n<script>\n\"use strict\";\n\n/* ---------------------------------------------------------------------------\n   Time controls\n\n   A control is a list of stages. Stage 0 is the game's opening allowance; a\n   further stage adds its minutes once a player has completed `after` moves,\n   which is how FIDE-style tournament controls (90 minutes for 40 moves, then\n   30 more) actually work — the extra time lands on each player independently\n   as they reach the move count, not when the game does.\n\n   `mode` covers the three ways a move can earn time back:\n     fischer   — a flat bonus added after every move (the common one online)\n     bronstein — returns what you spent, capped at the bonus, so you can never\n                 bank time you did not use\n     delay     — the clock simply does not start for the first N seconds of\n                 your move (US delay)\n--------------------------------------------------------------------------- */\nfunction control(label, band, minutes, bonus, mode, after, addMinutes){\n  return {\n    label: label, band: band, mode: mode || \"fischer\",\n    baseMs: Math.round(minutes * 60000),\n    bonusMs: Math.round((bonus || 0) * 1000),\n    after: after || 0,\n    addMs: Math.round((addMinutes || 0) * 60000),\n  };\n}\n\nvar PRESETS = [\n  control(\"1 + 0\",   \"bullet\", 1, 0),\n  control(\"1 + 1\",   \"bullet\", 1, 1),\n  control(\"2 + 1\",   \"bullet\", 2, 1),\n  control(\"3 + 0\",   \"blitz\", 3, 0),\n  control(\"3 + 2\",   \"blitz\", 3, 2),\n  control(\"5 + 0\",   \"blitz\", 5, 0),\n  control(\"5 + 3\",   \"blitz\", 5, 3),\n  control(\"10 + 0\",  \"rapid\", 10, 0),\n  control(\"10 + 5\",  \"rapid\", 10, 5),\n  control(\"15 + 10\", \"rapid\", 15, 10),\n  control(\"25 + 10\", \"rapid\", 25, 10),\n  control(\"30 + 0\",  \"classical\", 30, 0),\n  control(\"30 + 20\", \"classical\", 30, 20),\n  control(\"60 + 30\", \"classical\", 60, 30),\n  control(\"90 + 30\", \"classical\", 90, 30),\n  // The FIDE standard, and the club control most people mean by \"tournament\".\n  control(\"40/90 + 30\", \"classical\", 90, 30, \"fischer\", 40, 30),\n  control(\"40/120 + 60\", \"classical\", 120, 0, \"fischer\", 40, 60),\n];\nvar BAND_NAME = { bullet:\"Bullet\", blitz:\"Blitz\", rapid:\"Rapid\", classical:\"Classical\" };\n\n/* ---------------------------------------------------------------------------\n   State\n\n   Clocks are wall-clock derived, never decremented by a timer. `remain` is the\n   time banked at the last press; the running side's live figure is that minus\n   the elapsed time since the press. A dropped frame, a backgrounded web view\n   or a sleeping screen therefore cannot make the clock wrong — it only makes\n   the display stale until the next paint.\n--------------------------------------------------------------------------- */\nvar LS = { control:\"chessclock.control\", opts:\"chessclock.opts\" };\nvar cfg = PRESETS[5];                 // 5 + 0\nvar remain = [0, 0];                  // ms banked, [white, black]\nvar moves  = [0, 0];\nvar staged = [false, false];          // has this side taken its extra stage yet\nvar turn = 0;                         // 0 white, 1 black\nvar running = false;\nvar started = false;                  // a press has happened this game\nvar turnStart = 0;                    // ms timestamp the running turn began\nvar flagged = -1;\nvar opts = { sound:true, lowAt:10 };\nvar warned = [false, false];\nvar raf = null;\nvar actx = null;\n\nvar $ = function(s){ return document.querySelector(s); };\nfunction el(id){ return document.getElementById(id); }\nfunction now(){ return Date.now(); }\n\n/* ---------------------------------------------------------------------------\n   Storage — myllmStorage is async and absent in a plain browser, so both paths\n   are guarded and neither is allowed to throw into the game loop.\n--------------------------------------------------------------------------- */\nfunction save(key, value){\n  var s = JSON.stringify(value);\n  try{ if(window.myllmStorage){ window.myllmStorage.setItem(key, s); return; } }catch(e){}\n  try{ localStorage.setItem(key, s); }catch(e){}\n}\nfunction load(key){\n  try{\n    if(window.myllmStorage){\n      return Promise.resolve(window.myllmStorage.getItem(key)).then(function(v){\n        try{ return v ? JSON.parse(v) : null; }catch(e){ return null; }\n      }).catch(function(){ return null; });\n    }\n  }catch(e){}\n  try{ var v = localStorage.getItem(key); return Promise.resolve(v ? JSON.parse(v) : null); }\n  catch(e){ return Promise.resolve(null); }\n}\n\nfunction buzz(style){\n  if(!opts.sound) return;\n  try{ if(window.myllmHaptic) window.myllmHaptic(style || \"light\"); }catch(e){}\n}\n\n/* A short tone rather than an audio file, so the app stays self-contained.\n   The context is created on the first press — a user gesture — because that is\n   the only moment iOS will let it start. */\nfunction tone(freq, ms, gain){\n  if(!opts.sound) return;\n  try{\n    var AC = window.AudioContext || window.webkitAudioContext;\n    if(!AC) return;\n    if(!actx) actx = new AC();\n    if(actx.state === \"suspended\") actx.resume();\n    var o = actx.createOscillator(), g = actx.createGain();\n    o.type = \"triangle\";\n    o.frequency.value = freq;\n    g.gain.setValueAtTime(0.0001, actx.currentTime);\n    g.gain.exponentialRampToValueAtTime(gain || 0.16, actx.currentTime + 0.008);\n    g.gain.exponentialRampToValueAtTime(0.0001, actx.currentTime + ms/1000);\n    o.connect(g); g.connect(actx.destination);\n    o.start(); o.stop(actx.currentTime + ms/1000 + 0.02);\n  }catch(e){}\n}\n\n/* ---------------------------------------------------------------------------\n   Clock maths\n--------------------------------------------------------------------------- */\n// How much of this turn actually counts against the clock. Simple delay gives\n// the first `bonusMs` free; the other two modes charge from the first instant.\nfunction charged(elapsed){\n  if(cfg.mode === \"delay\") return Math.max(0, elapsed - cfg.bonusMs);\n  return elapsed;\n}\n\nfunction liveRemaining(side){\n  if(!running || side !== turn || flagged >= 0) return remain[side];\n  return remain[side] - charged(now() - turnStart);\n}\n\nfunction fmt(ms){\n  if(ms < 0) ms = 0;\n  var t = Math.ceil(ms / 100) / 10;                 // tenths, rounded up\n  var h = Math.floor(t / 3600);\n  var m = Math.floor((t % 3600) / 60);\n  var s = t % 60;\n  // Under twenty seconds a chess clock shows tenths — that is when they matter.\n  if(ms < 20000){\n    var whole = Math.floor(s);\n    var frac = Math.floor((s - whole) * 10);\n    return '<span>' + (h ? h + \":\" + pad(m) + \":\" + pad(whole) : (m ? m + \":\" + pad(whole) : whole))\n         + '</span><span class=\"frac\">.' + frac + '</span>';\n  }\n  s = Math.floor(s);\n  if(h) return h + \":\" + pad(m) + \":\" + pad(s);\n  return m + \":\" + pad(s);\n}\nfunction pad(n){ return n < 10 ? \"0\" + n : \"\" + n; }\n\n/* ---------------------------------------------------------------------------\n   Game flow\n--------------------------------------------------------------------------- */\nfunction setControl(c){\n  cfg = c;\n  save(LS.control, c);\n  resetGame();\n}\n\nfunction resetGame(){\n  stopLoop();\n  remain = [cfg.baseMs, cfg.baseMs];\n  moves = [0, 0];\n  staged = [false, false];\n  warned = [false, false];\n  turn = 0;\n  running = false;\n  started = false;\n  flagged = -1;\n  el(\"result\").className = \"result\";\n  el(\"stage-0\").textContent = \"\";\n  el(\"stage-1\").textContent = \"\";\n  el(\"control-name\").textContent = controlName(cfg);\n  draw();\n}\n\nfunction controlName(c){\n  var band = BAND_NAME[c.band] || \"Custom\";\n  var mode = c.mode === \"bronstein\" ? \" · Bronstein\" : (c.mode === \"delay\" ? \" · delay\" : \"\");\n  return band + \" · \" + c.label + mode;\n}\n\n// Pressing your own side ends your move. Anything else is ignored, which is\n// what stops a spectator's stray tap — or the waiting player's — from moving\n// the game on.\nfunction press(side){\n  if(flagged >= 0) return;\n\n  if(!started){ begin(); return; }\n  if(!running){ resume(); return; }\n  if(side !== turn) return;\n  commitTurn();\n}\n\n// Bank the elapsed time, pay out the bonus, advance the stage if this move\n// reached it, and hand over.\nfunction commitTurn(){\n  var elapsed = now() - turnStart;\n  var spent = charged(elapsed);\n  remain[turn] -= spent;\n\n  if(remain[turn] <= 0){ remain[turn] = 0; flag(turn); return; }\n\n  if(cfg.mode === \"fischer\") remain[turn] += cfg.bonusMs;\n  else if(cfg.mode === \"bronstein\") remain[turn] += Math.min(cfg.bonusMs, spent);\n\n  moves[turn] += 1;\n\n  if(cfg.after > 0 && !staged[turn] && moves[turn] >= cfg.after){\n    staged[turn] = true;\n    remain[turn] += cfg.addMs;\n    el(\"stage-\" + turn).textContent = \"+\" + Math.round(cfg.addMs / 60000) + \" min\";\n    tone(760, 140, 0.13);\n  }\n\n  warned[turn] = false;\n  turn = turn === 0 ? 1 : 0;\n  turnStart = now();\n  buzz(\"light\");\n  tone(520, 45, 0.1);\n  draw();\n}\n\nfunction flag(side){\n  flagged = side;\n  running = false;\n  stopLoop();\n  remain[side] = 0;\n  buzz(\"heavy\");\n  tone(180, 520, 0.2);\n  el(\"result-t\").textContent = (side === 0 ? \"Black\" : \"White\") + \" wins on time\";\n  el(\"result-p\").textContent = (side === 0 ? \"White\" : \"Black\") + \" ran out after \" +\n    moves[side] + \" move\" + (moves[side] === 1 ? \"\" : \"s\") + \".\";\n  el(\"result\").className = \"result show\";\n  draw();\n}\n\nfunction pause(){\n  if(!running || flagged >= 0) return;\n  remain[turn] -= charged(now() - turnStart);\n  if(remain[turn] < 0) remain[turn] = 0;\n  running = false;\n  stopLoop();\n  draw();\n}\nfunction resume(){\n  if(running || flagged >= 0 || !started) return;\n  running = true;\n  turnStart = now();\n  startLoop();\n  draw();\n}\n// White always moves first, so the opening gesture — either clock face or the\n// play button — just starts White's clock. It must not commit a turn: doing so\n// credited a move nobody had made and, under Fischer, paid an increment for it.\nfunction begin(){\n  started = true; running = true;\n  turn = 0;\n  turnStart = now();\n  startLoop();\n  draw();\n}\n\nfunction toggleRun(){\n  if(flagged >= 0){ resetGame(); return; }\n  if(!started){ begin(); return; }\n  if(running) pause(); else resume();\n}\n\n/* ---------------------------------------------------------------------------\n   Paint\n--------------------------------------------------------------------------- */\nfunction draw(){\n  for(var i = 0; i < 2; i++){\n    var ms = liveRemaining(i);\n    var node = el(\"side-\" + i);\n    var low = ms <= opts.lowAt * 1000;\n\n    el(\"clock-\" + i).innerHTML = fmt(ms);\n    el(\"moves-\" + i).textContent = moves[i] + (moves[i] === 1 ? \" move\" : \" moves\");\n\n    var cls = \"side \" + (i === 1 ? \"flip black\" : \"white\");\n    if(flagged === i) cls += \" flagged\";\n    else if(!started || !running) cls += \" idle\";\n    else if(i === turn) cls += \" live\";\n    else cls += \" idle\";\n    if(low && flagged !== i) cls += \" low\";\n    node.className = cls;\n\n    if(running && i === turn && low && !warned[i] && ms > 0){\n      warned[i] = true;\n      buzz(\"medium\");\n      tone(880, 120, 0.14);\n    }\n    if(running && i === turn && ms <= 0){ flag(i); return; }\n  }\n  el(\"playpause\").textContent = flagged >= 0 ? \"↺\" : (running ? \"❚❚\" : \"▶\");\n  el(\"sound\").style.opacity = opts.sound ? \"1\" : \".4\";\n}\n\nfunction startLoop(){ if(!raf) raf = requestAnimationFrame(loop); }\nfunction stopLoop(){ if(raf){ cancelAnimationFrame(raf); raf = null; } }\nfunction loop(){ raf = null; draw(); if(running) startLoop(); }\n\n/* ---------------------------------------------------------------------------\n   Settings sheet\n--------------------------------------------------------------------------- */\nfunction buildPresets(){\n  var bands = document.querySelectorAll(\".presets\");\n  for(var b = 0; b < bands.length; b++){\n    var band = bands[b].dataset.band, html = \"\";\n    for(var i = 0; i < PRESETS.length; i++){\n      var p = PRESETS[i];\n      if(p.band !== band) continue;\n      var sub = p.after ? p.after + \" moves, then +\" + Math.round(p.addMs/60000)\n              : (p.bonusMs ? \"+\" + Math.round(p.bonusMs/1000) + \"s a move\" : \"no increment\");\n      html += '<button class=\"preset\" data-i=\"' + i + '\" aria-pressed=\"false\">' +\n              \"<b>\" + p.label + \"</b><span>\" + sub + \"</span></button>\";\n    }\n    bands[b].innerHTML = html;\n  }\n  markPreset();\n}\nfunction markPreset(){\n  var all = document.querySelectorAll(\".preset\");\n  for(var i = 0; i < all.length; i++){\n    var p = PRESETS[+all[i].dataset.i];\n    all[i].setAttribute(\"aria-pressed\", String(p === cfg || (p.label === cfg.label && p.band === cfg.band)));\n  }\n}\n\nfunction openSheet(){ pause(); el(\"scrim\").classList.add(\"open\"); markPreset(); }\nfunction closeSheet(){ el(\"scrim\").classList.remove(\"open\"); }\n\nfunction syncSegs(){\n  var s = el(\"seg-sound\").children;\n  s[0].setAttribute(\"aria-pressed\", String(opts.sound));\n  s[1].setAttribute(\"aria-pressed\", String(!opts.sound));\n  var l = el(\"seg-low\").children;\n  for(var i = 0; i < l.length; i++)\n    l[i].setAttribute(\"aria-pressed\", String(+l[i].dataset.v === opts.lowAt));\n  el(\"inc-hint\").textContent = el(\"c-mode\").value === \"delay\"\n    ? \"Your clock does not start until these seconds have passed.\"\n    : el(\"c-mode\").value === \"bronstein\"\n      ? \"Returns what you spent, up to this many seconds — never more.\"\n      : \"Added to your clock each time you press.\";\n}\n\n/* ---------------------------------------------------------------------------\n   Wiring\n--------------------------------------------------------------------------- */\nel(\"side-0\").addEventListener(\"pointerdown\", function(e){ e.preventDefault(); press(0); });\nel(\"side-1\").addEventListener(\"pointerdown\", function(e){ e.preventDefault(); press(1); });\n\nel(\"playpause\").addEventListener(\"click\", toggleRun);\nel(\"reset\").addEventListener(\"click\", function(){ resetGame(); buzz(\"light\"); });\nel(\"settings\").addEventListener(\"click\", openSheet);\nel(\"close\").addEventListener(\"click\", closeSheet);\nel(\"scrim\").addEventListener(\"click\", function(e){ if(e.target === el(\"scrim\")) closeSheet(); });\nel(\"sound\").addEventListener(\"click\", function(){\n  opts.sound = !opts.sound; save(LS.opts, opts); syncSegs(); draw();\n});\n\ndocument.addEventListener(\"click\", function(e){\n  var p = e.target.closest ? e.target.closest(\".preset\") : null;\n  if(!p) return;\n  setControl(PRESETS[+p.dataset.i]);\n  markPreset();\n  closeSheet();\n});\n\nel(\"use-custom\").addEventListener(\"click\", function(){\n  var mins = Math.max(0, Math.min(360, +el(\"c-min\").value || 0));\n  var inc  = Math.max(0, Math.min(180, +el(\"c-inc\").value || 0));\n  var mode = el(\"c-mode\").value;\n  var after = Math.max(0, Math.min(120, +el(\"c-after\").value || 0));\n  var add = Math.max(0, Math.min(180, +el(\"c-add\").value || 0));\n  if(mins <= 0 && inc <= 0) return;                 // a clock with no time is not a control\n  var label = mins + \" + \" + inc + (after && add ? \" · \" + after + \"/+\" + add : \"\");\n  setControl(control(label, \"custom\", mins, inc, mode, after, add));\n  markPreset();\n  closeSheet();\n});\n\nel(\"c-mode\").addEventListener(\"change\", syncSegs);\n\nel(\"seg-sound\").addEventListener(\"click\", function(e){\n  var b = e.target.closest(\"button\"); if(!b) return;\n  opts.sound = b.dataset.v === \"on\"; save(LS.opts, opts); syncSegs(); draw();\n});\nel(\"seg-low\").addEventListener(\"click\", function(e){\n  var b = e.target.closest(\"button\"); if(!b) return;\n  opts.lowAt = +b.dataset.v; save(LS.opts, opts); warned = [false, false]; syncSegs(); draw();\n});\n\n// A backgrounded web view stops painting, so the display can be stale on the\n// way back in. The clocks are timestamp-derived, so one repaint is the whole\n// fix — nothing needs reconciling.\ndocument.addEventListener(\"visibilitychange\", function(){\n  if(document.visibilityState === \"visible\"){ draw(); if(running) startLoop(); }\n});\n\n// Best effort only: there is no keep-awake bridge, and the clocks survive the\n// screen sleeping anyway.\ntry{ if(navigator.wakeLock) navigator.wakeLock.request(\"screen\").catch(function(){}); }catch(e){}\n\n/* ---------------------------------------------------------------------------\n   Boot\n--------------------------------------------------------------------------- */\nbuildPresets();\nPromise.all([load(LS.control), load(LS.opts)]).then(function(r){\n  var savedControl = r[0], savedOpts = r[1];\n  if(savedOpts && typeof savedOpts === \"object\"){\n    if(typeof savedOpts.sound === \"boolean\") opts.sound = savedOpts.sound;\n    if([10,30,60].indexOf(+savedOpts.lowAt) >= 0) opts.lowAt = +savedOpts.lowAt;\n  }\n  if(savedControl && typeof savedControl.baseMs === \"number\" && savedControl.baseMs >= 0){\n    cfg = savedControl;\n    el(\"c-min\").value = Math.round(cfg.baseMs / 60000);\n    el(\"c-inc\").value = Math.round(cfg.bonusMs / 1000);\n    el(\"c-mode\").value = cfg.mode || \"fischer\";\n    el(\"c-after\").value = cfg.after || 0;\n    el(\"c-add\").value = Math.round((cfg.addMs || 0) / 60000);\n  }\n  syncSegs();\n  resetGame();\n  markPreset();\n}).catch(function(){ syncSegs(); resetGame(); });\n</script>\n</body></html>\n"
}
