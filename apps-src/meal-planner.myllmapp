{"name": "Meal Planner", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>:root{color-scheme:light dark;--accent:#ff9f0a}\n*{box-sizing:border-box}\nbody{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:18px;background:#f2f2f7;color:#111}\n@media(prefers-color-scheme:dark){body{background:#000;color:#eee}.card,input,textarea{background:#1c1c1e;color:#eee;border-color:#3a3a3c}.meal{border-color:#2c2c2e}}\nh1{font-size:22px;margin:0 0 4px}\n.sub{font-size:13px;opacity:.6;margin-bottom:14px}\ninput,textarea{width:100%;padding:11px;border:1px solid #d1d1d6;border-radius:10px;font-size:15px;background:#fff;font-family:inherit}\ntextarea{min-height:42px;resize:vertical}\n.row{display:flex;gap:8px;margin-bottom:10px}\nbutton{border:0;background:var(--accent);color:#fff;border-radius:10px;padding:11px 16px;font-size:15px;font-weight:600;white-space:nowrap}\nbutton.sec{background:#e5e5ea;color:#111}\n@media(prefers-color-scheme:dark){button.sec{background:#2c2c2e;color:#eee}}\nbutton:disabled{opacity:.5}\n#status{font-size:13px;opacity:.7;min-height:18px;margin:8px 0}\n.card{background:#fff;border-radius:14px;padding:12px 14px;margin-bottom:10px;box-shadow:0 1px 3px rgba(0,0,0,.08)}\n.day{font-size:13px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--accent);margin-bottom:8px}\n.meal{display:flex;align-items:baseline;gap:8px;padding:7px 0;border-top:1px solid #eee;cursor:pointer}\n.meal:first-of-type{border-top:0}\n.meal .lbl{font-size:11px;text-transform:uppercase;letter-spacing:.05em;opacity:.5;width:64px;flex:none}\n.meal .dish{font-size:15px;flex:1}\n.actions{display:flex;gap:8px;margin-top:6px}\n.actions button{flex:1;padding:12px}\n.hint{font-size:11px;opacity:.4;text-align:center;margin-top:14px}\n</style></head><body>\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-family:-apple-system,system-ui,sans-serif;font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;line-height:1;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n<script>\n(function(){\n  if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;\n  window.__myllmAiWrap=true;\n  var orig=window.myllmAsk,depth=0,node=null;\n  function ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\n    node.innerHTML='<span class=\"myllm-ai-cog\">\\u2699\\uFE0F</span><span>AI is thinking\\u2026 <small>privately, on your device</small></span>';\n    (document.body||document.documentElement).appendChild(node);}\n  function show(){ensure();depth++;node.classList.add('on');}\n  function hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\n  window.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\n    return Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};\n})();\n</script>\n\n<h1>🍽️ Meal Planner</h1>\n<div class=\"sub\">A week of meals, written by your AI — tap any meal to swap it.</div>\n<textarea id=\"prefs\" placeholder=\"Any preferences? e.g. vegetarian, quick dinners, no nuts, budget-friendly (optional)\"></textarea>\n<div class=\"actions\">\n  <button id=\"gen\" onclick=\"generate()\">Plan my week</button>\n  <button class=\"sec\" id=\"shop\" onclick=\"shoppingList()\" style=\"display:none\">Shopping list</button>\n</div>\n<div id=\"status\"></div>\n<div id=\"week\"></div>\n<div class=\"hint\" id=\"hint\"></div>\n<script>\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar DAYS=[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\",\"Sunday\"];\nvar MEALS=[\"breakfast\",\"lunch\",\"dinner\"];\nvar plan=null;\nfunction el(i){return document.getElementById(i)}\nfunction setStatus(t){el('status').textContent=t||''}\nfunction save(){store.setItem('plan',JSON.stringify({prefs:el('prefs').value,plan:plan}))}\nfunction prefsText(){var p=el('prefs').value.trim();return p?('Preferences: '+p+'. '):''}\n\nfunction needAI(){\n  if(window.myllmAsk)return true;\n  setStatus('This app needs AI — update MyLLM and turn on “Allow apps to use the AI” in Settings.');\n  return false;\n}\n\nfunction generate(){\n  if(!needAI())return;\n  el('gen').disabled=true;setStatus('Cooking up a week of meals…');\n  myllmAsk(prefsText()+'Create a 7-day meal plan (Monday to Sunday). Reply with ONLY a JSON object exactly like {\"days\":[{\"day\":\"Monday\",\"breakfast\":\"...\",\"lunch\":\"...\",\"dinner\":\"...\"}]} with all 7 days in order and nothing else. Keep each meal under 9 words.')\n  .then(function(reply){\n    var s=reply.indexOf('{'),e=reply.lastIndexOf('}');\n    if(s<0||e<=s)throw new Error('the model did not return a plan');\n    var obj=JSON.parse(reply.slice(s,e+1));\n    var days=(obj.days||[]).filter(function(d){return d&&d.day});\n    if(days.length<5)throw new Error('the plan came back incomplete');\n    plan=days;save();render();setStatus('');\n    if(window.myllmHaptic)myllmHaptic('success');\n  }).catch(function(err){setStatus('Could not plan: '+err.message)})\n  .then(function(){el('gen').disabled=false});\n}\n\nfunction swap(di,meal){\n  if(!needAI())return;\n  var d=plan[di];setStatus('Swapping '+meal+' for '+d.day+'…');\n  myllmAsk(prefsText()+'Suggest ONE different '+meal+' idea to replace \"'+d[meal]+'\" for '+d.day+'. Reply with ONLY the dish name, under 9 words, no trailing punctuation.')\n  .then(function(reply){\n    var dish=reply.trim().replace(/^[\"'\\-\\s]+|[\"'\\.\\s]+$/g,'').split('\\n')[0];\n    if(dish){d[meal]=dish;save();render();if(window.myllmHaptic)myllmHaptic('light')}\n    setStatus('');\n  }).catch(function(err){setStatus('Could not swap: '+err.message)});\n}\n\nfunction shoppingList(){\n  if(!needAI()||!plan)return;\n  setStatus('Building your shopping list…');\n  myllmAsk('From this 7-day meal plan, write a concise grocery shopping list grouped under simple aisle headings (Produce, Dairy, etc.). Plan JSON: '+JSON.stringify(plan)+'. Reply as plain text, headings on their own line, one item per line with a \"- \" bullet.')\n  .then(function(list){\n    setStatus('');\n    if(window.myllmShare)myllmShare('🛒 Shopping list\\n\\n'+list.trim());\n    else setStatus('Update MyLLM to share your shopping list.');\n  }).catch(function(err){setStatus('Could not build list: '+err.message)});\n}\n\nfunction render(){\n  var W=el('week');W.innerHTML='';\n  el('shop').style.display=plan?'block':'none';\n  el('gen').textContent=plan?'Refresh week':'Plan my week';\n  if(!plan){el('hint').textContent=window.myllmAsk?'':'Needs the latest MyLLM with apps-AI enabled.';return}\n  el('hint').textContent='Tap any meal to swap just that one.';\n  plan.forEach(function(d,di){\n    var c=document.createElement('div');c.className='card';\n    var h=document.createElement('div');h.className='day';h.textContent=d.day;c.appendChild(h);\n    MEALS.forEach(function(m){\n      if(!d[m])return;\n      var r=document.createElement('div');r.className='meal';\n      var l=document.createElement('span');l.className='lbl';l.textContent=m;\n      var t=document.createElement('span');t.className='dish';t.textContent=d[m];\n      r.appendChild(l);r.appendChild(t);\n      r.onclick=function(){swap(di,m)};\n      c.appendChild(r);\n    });\n    W.appendChild(c);\n  });\n}\n\nstore.getItem('plan').then(function(v){\n  if(v)try{var o=JSON.parse(v);el('prefs').value=o.prefs||'';plan=o.plan||null}catch(e){}\n  render();\n});\n</script></body></html>\n", "kind": "html", "iconSymbol": "fork.knife", "iconColor": "orange"}