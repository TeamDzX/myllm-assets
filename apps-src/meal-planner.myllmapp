{"name": "Meal Planner", "html": "<!doctype html>\n<!--\n  Meal Planner — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Meal Planner</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"52979fc2fa\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); --h:36; }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:760px; } #week{ display:grid; grid-template-columns:1fr 1fr; gap:0 12px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.96); }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 90% 50%), hsl(calc(var(--h) - 24) 80% 42%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  label{ display:block; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:0 2px 7px; }\n  textarea{ width:100%; font:inherit; font-size:16px; padding:11px 12px; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; min-height:48px; resize:vertical; line-height:1.4; }\n  textarea:focus{ border-color:var(--acc); }\n  .actions{ display:flex; gap:8px; margin-top:12px; }\n  .go{ flex:1; min-height:50px; border:none; border-radius:14px; background:var(--acc); color:#fff; font-size:16px; font-weight:700;\n    display:flex; align-items:center; justify-content:center; gap:8px; padding:0 14px; }\n  .go.soft{ flex:0 1 auto; background:var(--fill); color:var(--acc); }\n  .go:disabled{ opacity:.55; }\n  @media (max-width:360px){ .actions{ flex-direction:column; } .go.soft{ flex:1; } }\n  .status{ font-size:13px; color:var(--muted); min-height:18px; margin-top:10px; text-align:center; }\n  .status.err{ color:#ff453a; }\n  .spin{ width:16px; height:16px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n\n  .day{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:4px 6px 4px 14px; margin-bottom:10px; }\n  .day h3{ font-size:12px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; color:hsl(var(--h) 85% 38%); margin:10px 0 2px; }\n  @media (prefers-color-scheme:dark){ .day h3{ color:hsl(var(--h) 95% 62%); } }\n  .meal{ display:flex; align-items:center; gap:10px; min-height:48px; padding:6px 0; border-top:1px solid var(--line); cursor:pointer; }\n  .meal:first-of-type{ border-top:none; }\n  .meal .lbl{ flex-shrink:0; width:74px; font-size:10.5px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); }\n  .meal .dish{ flex:1; min-width:0; font-size:15px; line-height:1.35; overflow-wrap:anywhere; }\n  .meal .sw{ flex-shrink:0; width:40px; height:40px; border-radius:11px; display:flex; align-items:center; justify-content:center; color:var(--muted); font-size:15px; }\n  .meal.busy .dish{ opacity:.5; }\n  .meal.busy .sw{ color:hsl(var(--h) 85% 45%); }\n  .hint{ font-size:12px; color:var(--muted); text-align:center; margin:4px 0 8px; }\n\n  .skel{ height:150px; border-radius:18px; margin-bottom:10px; background:var(--fill); animation:shimmer 1.4s ease-in-out infinite; }\n  @keyframes shimmer{ 50%{ opacity:.45; } }\n  .empty{ text-align:center; padding:26px 20px 14px; }\n  .empty .tile{ width:48px; height:48px; border-radius:14px; font-size:21px; margin:0 auto 10px; opacity:.9; }\n  .empty b{ display:block; font-size:16px; font-weight:750; }\n  .empty p{ font-size:13.5px; color:var(--muted); line-height:1.5; max-width:280px; margin:5px auto 0; }\n  [hidden]{ display:none !important; }\n  @media (prefers-reduced-motion:reduce){ .spin{ animation-duration:2.4s; } .skel{ animation:none; } button:active{ transform:none; } }\n\n  @keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n  .myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n  .myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n  .myllm-ai-cog{width:16px;height:16px;border-radius:50%;border:2.4px solid #a78bfa;border-right-color:transparent;animation:myllmAiSpin .9s linear infinite;flex-shrink:0}\n  .myllm-ai-busy small{font-weight:400;opacity:.6}\n\n/* myllm-fullscreen-v1 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-fork\" viewBox=\"0 0 24 24\"><g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 3v6a2 2 0 0 0 4 0V3M9 11v10\"/><path d=\"M17 21V3c-2 1.2-3 3.8-3 7.5h3\"/></g></symbol>\n  <symbol id=\"i-spark\" viewBox=\"0 0 24 24\"><path d=\"M10 2.5l1.9 5.6 5.6 1.9-5.6 1.9L10 17.5l-1.9-5.6L2.5 10l5.6-1.9zM18.5 14l.95 2.55L22 17.5l-2.55.95L18.5 21l-.95-2.55L15 17.5l2.55-.95z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-cart\" viewBox=\"0 0 24 24\"><g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 4h2.2l2.2 11h10.4l2-8H6.3\"/><circle cx=\"9.5\" cy=\"19\" r=\"1.4\"/><circle cx=\"16.5\" cy=\"19\" r=\"1.4\"/></g></symbol>\n  <symbol id=\"i-swap\" viewBox=\"0 0 24 24\"><g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 12a8 8 0 1 1-2.6-5.9\"/><path d=\"M20 4v5h-5\"/></g></symbol>\n  <symbol id=\"i-cal\" viewBox=\"0 0 24 24\"><path d=\"M7 2.8a1 1 0 0 1 1 1V5h8V3.8a1 1 0 0 1 2 0V5h.5A2.5 2.5 0 0 1 21 7.5v11a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 18.5v-11A2.5 2.5 0 0 1 5.5 5H6V3.8a1 1 0 0 1 1-1zM5 10.2v8.3c0 .3.2.5.5.5h13c.3 0 .5-.2.5-.5v-8.3z\" fill=\"currentColor\"/></symbol>\n</defs></svg>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\"></span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-fork\"/></svg></div>\n  <div class=\"ht\"><h1>Meal Planner</h1><p>A week of meals, written by your AI — tap any meal to swap it</p></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Meal Planner\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n\n<div class=\"card\">\n  <label for=\"prefs\">Preferences</label>\n  <textarea id=\"prefs\" placeholder=\"e.g. vegetarian, quick dinners, no nuts, budget-friendly (optional)\"></textarea>\n  <div class=\"actions\">\n    <button class=\"go\" id=\"gen\" type=\"button\"></button>\n    <button class=\"go soft\" id=\"shop\" type=\"button\" hidden><svg class=\"i\"><use href=\"#i-cart\"/></svg>Shopping list</button>\n  </div>\n  <div class=\"status\" id=\"status\"></div>\n</div>\n\n<div class=\"card empty\" id=\"empty\" hidden>\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-cal\"/></svg></div>\n  <b>Your week lives here</b>\n  <p>Add any preferences above, then plan — breakfast, lunch and dinner for seven days.</p>\n</div>\n<div id=\"skeleton\" hidden><div class=\"skel\"></div><div class=\"skel\"></div><div class=\"skel\"></div></div>\n<div class=\"hint\" id=\"hint\"></div>\n<div id=\"week\"></div>\n\n<script>\nfunction el(i){return document.getElementById(i)}\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction store(){return window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}}}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nvar DAYS=[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\",\"Sunday\"];\nvar MEALS=[\"breakfast\",\"lunch\",\"dinner\"];\nvar plan=null,busyMeal=null;\nfunction setStatus(t,err){var s=el('status');s.textContent=t||'';s.classList.toggle('err',!!err)}\nfunction save(){store().setItem('plan',JSON.stringify({prefs:el('prefs').value,plan:plan}))}\nfunction prefsText(){var p=el('prefs').value.trim();return p?('Preferences: '+p+'. '):''}\nfunction genBtn(busy){\n  var b=el('gen');b.disabled=!!busy;\n  b.innerHTML=busy?'<i class=\"spin\"></i><span>Cooking up a week…</span>':'<svg class=\"i\"><use href=\"#i-spark\"/></svg><span>'+(plan?'Refresh week':'Plan my week')+'</span>';\n}\n\nfunction needAI(){\n  if(window.myllmAsk)return true;\n  setStatus('This app needs AI — update MyLLM and turn on “Allow apps to use the AI” in Settings.',true);\n  return false;\n}\n\n/* Labelled lines, not JSON — small models (Apple Intelligence) echo JSON\n   templates back verbatim. Echoed instructions are rejected and retried. */\nvar ECHO=/the breakfast dish|the lunch dish|the dinner dish|repeat this line|labelled line/i;\nfunction parsePlan(reply){\n  var got=false,byDay={};\n  String(reply||'').split(/\\r?\\n/).forEach(function(raw){\n    var ln=raw.replace(/\\*\\*/g,'').trim();\n    var m=ln.match(/^[-*#>\\s]*(MONDAY|TUESDAY|WEDNESDAY|THURSDAY|FRIDAY|SATURDAY|SUNDAY)\\s*\\d*\\s*[::]\\s*(.*)$/i);\n    if(!m)return;\n    got=true;\n    var day=m[1].charAt(0).toUpperCase()+m[1].slice(1).toLowerCase();\n    var parts=m[2].split('|').map(function(s){return s.trim()});\n    var d={day:day};\n    MEALS.forEach(function(meal,i){var v=parts[i]||'';if(v&&!ECHO.test(v))d[meal]=v});\n    if(d.breakfast||d.lunch||d.dinner)byDay[day]=d;\n  });\n  var days=[];\n  if(got){DAYS.forEach(function(day){if(byDay[day])days.push(byDay[day])});}\n  else{ // model answered in the old JSON shape — accept it\n    var s=reply.indexOf('{'),e=reply.lastIndexOf('}');\n    if(s>=0&&e>s)try{\n      var j=JSON.parse(reply.slice(s,e+1));\n      days=(j.days||[]).filter(function(d){\n        return d&&d.day&&!ECHO.test([d.breakfast,d.lunch,d.dinner].join(' '));\n      });\n    }catch(e2){}\n  }\n  if(days.length<5)throw new Error('the plan came back incomplete');\n  return days;\n}\n/* MyLLM 5.6+: ask for the week as JSON fenced to a schema — on the phone's own\n   model the reply is grammar-constrained, so it always parses however small the\n   model. The parsed plan still goes through parsePlan's JSON branch so the echo\n   filter and the incomplete-week guard apply. Any failure falls through to the\n   labelled-line path, which is also all that older builds have. */\nfunction askPlanJSON(p){\n  if(typeof window.myllmAskJSON!=='function')return Promise.reject(new Error('no JSON bridge'));\n  var q=p.replace(/Reply with EXACTLY these labelled lines[\\s\\S]*$/,\n    'Reply as JSON: a \"days\" array with one item per day, Monday to Sunday, each with \"day\", \"breakfast\", \"lunch\" and \"dinner\" (the dish names).');\n  var dish={type:'string',maxLength:80};\n  var schema={type:'object',required:['days'],properties:{days:{type:'array',minItems:7,maxItems:7,\n    items:{type:'object',required:['day','breakfast','lunch','dinner'],\n      properties:{day:{type:'string',enum:DAYS},breakfast:dish,lunch:dish,dinner:dish}}}}};\n  return myllmAskJSON(q,schema).then(function(j){return parsePlan(JSON.stringify(j&&typeof j==='object'?j:{}))});\n}\n\nfunction generate(){\n  if(!needAI())return;\n  genBtn(true);setStatus('');\n  el('skeleton').hidden=false;el('week').hidden=true;el('empty').hidden=true;el('hint').textContent='';\n  var p=prefsText()+'Create a 7-day meal plan (Monday to Sunday). Keep each meal under 9 words. Reply with EXACTLY these labelled lines and nothing else:\\n'+\n    DAYS.map(function(d){return d.toUpperCase()+': the breakfast dish | the lunch dish | the dinner dish'}).join('\\n');\n  askPlanJSON(p)\n  .catch(function(){return myllmAsk(p).then(function(r){return parsePlan(r||'')})})\n  .catch(function(){return myllmAsk(p+'\\nIMPORTANT: fill each labelled line with real content — never repeat the instruction text.')\n    .then(function(r){return parsePlan(r||'')})})\n  .then(function(days){\n    plan=days;save();setStatus('');haptic('success');\n  }).catch(function(err){setStatus('Could not plan: '+err.message,true)})\n  .then(function(){el('skeleton').hidden=true;el('week').hidden=false;render()});\n}\n\nfunction swap(di,meal){\n  if(!needAI()||busyMeal)return;\n  var d=plan[di];setStatus('Swapping '+meal+' for '+d.day+'…');\n  busyMeal=di+':'+meal;render();\n  var ask=prefsText()+'Suggest ONE different '+meal+' idea to replace \"'+d[meal]+'\" for '+d.day+'.';\n  // 5.6+: the dish arrives as schema-fenced JSON; a miss (or an older build) asks for plain text\n  (typeof window.myllmAskJSON==='function'\n    ? myllmAskJSON(ask+' Reply as JSON with the dish name, under 9 words, in \"dish\".',\n        {type:'object',required:['dish'],properties:{dish:{type:'string',maxLength:80}}})\n      .then(function(j){var v=j&&typeof j.dish==='string'?j.dish.trim():'';if(!v)throw new Error('no dish');return v})\n    : Promise.reject(new Error('no JSON bridge')))\n  .catch(function(){return myllmAsk(ask+' Reply with ONLY the dish name, under 9 words, no trailing punctuation.')})\n  .then(function(reply){\n    var dish=reply.trim().replace(/^[\"'\\-\\s]+|[\"'\\.\\s]+$/g,'').split('\\n')[0];\n    if(dish){d[meal]=dish;save();haptic('light')}\n    setStatus('');\n  }).catch(function(err){setStatus('Could not swap: '+err.message,true)})\n  .then(function(){busyMeal=null;render()});\n}\n\nfunction shoppingList(){\n  if(!needAI()||!plan)return;\n  var b=el('shop');b.disabled=true;b.innerHTML='<i class=\"spin\"></i>Building…';\n  setStatus('Building your shopping list…');\n  myllmAsk('From this 7-day meal plan, write a concise grocery shopping list grouped under simple aisle headings (Produce, Dairy, etc.). Plan JSON: '+JSON.stringify(plan)+'. Reply as plain text, headings on their own line, one item per line with a \"- \" bullet.')\n  .then(function(list){\n    setStatus('');\n    if(window.myllmShare)myllmShare('🛒 Shopping list\\n\\n'+list.trim());\n    else setStatus('Update MyLLM to share your shopping list.',true);\n  }).catch(function(err){setStatus('Could not build list: '+err.message,true)})\n  .then(function(){b.disabled=false;b.innerHTML='<svg class=\"i\"><use href=\"#i-cart\"/></svg>Shopping list'});\n}\n\nfunction render(){\n  var W=el('week');W.innerHTML='';\n  el('shop').hidden=!plan;\n  genBtn(!el('skeleton').hidden);\n  el('empty').hidden=!!plan||!el('skeleton').hidden;\n  if(!plan){el('hint').textContent='';if(!window.myllmAsk&&!el('status').textContent)setStatus('Needs the latest MyLLM with apps-AI enabled.');return}\n  el('hint').textContent='Tap any meal to swap just that one.';\n  plan.forEach(function(d,di){\n    var c=document.createElement('div');c.className='day';\n    var h=document.createElement('h3');h.textContent=d.day;c.appendChild(h);\n    MEALS.forEach(function(m){\n      if(!d[m])return;\n      var busy=busyMeal===di+':'+m;\n      var r=document.createElement('div');r.className='meal'+(busy?' busy':'');r.setAttribute('role','button');\n      r.setAttribute('aria-label','Swap '+m+' on '+d.day);\n      var l=document.createElement('span');l.className='lbl';l.textContent=m;\n      var t=document.createElement('span');t.className='dish';t.textContent=d[m];\n      var s=document.createElement('span');s.className='sw';s.innerHTML=busy?'<i class=\"spin\"></i>':'<svg class=\"i\"><use href=\"#i-swap\"/></svg>';\n      r.appendChild(l);r.appendChild(t);r.appendChild(s);\n      r.onclick=function(){swap(di,m)};\n      c.appendChild(r);\n    });\n    W.appendChild(c);\n  });\n}\n\nel('gen').onclick=generate;\nel('shop').onclick=shoppingList;\ngenBtn(false);\nstore().getItem('plan').then(function(v){\n  if(v)try{var o=JSON.parse(v);el('prefs').value=o.prefs||'';plan=o.plan||null}catch(e){}\n  render();\n});\n\n/* myllm-fullscreen-v1 — full screen where MyLLM can also close the app for us (myllmClose,\n   5.6.2+): full screen hides MyLLM's Done, and a page with no way out is\n   worse than a repeated title, so elsewhere nothing changes. The spacer keeps\n   the header clear of the status bar only if the page doesn't already. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  function inset(){\n    var p = document.createElement(\"div\");\n    p.style.cssText = \"position:fixed;top:0;left:0;width:1px;visibility:hidden;height:env(safe-area-inset-top)\";\n    document.body.appendChild(p); var h = p.offsetHeight; p.parentNode.removeChild(p); return h;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = \"0px\";\n    if (!document.body.classList.contains(\"imm\")) return;\n    var need = inset() + 6 - (head.getBoundingClientRect().top + window.scrollY);\n    sp.style.height = Math.max(0, Math.round(need)) + \"px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  window.addEventListener(\"resize\", fit);\n  sync();\n})();\n</script></body></html>\n", "kind": "html", "iconSymbol": "fork.knife", "iconColor": "orange"}