{"name": "Learn Guitar", "kind": "html", "iconSymbol": "guitars.fill", "iconColor": "teal", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Learn Guitar</title>\n<style>\n  :root { color-scheme: light dark; }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111);\n    max-width:820px; margin:0 auto;\n    padding:16px 16px calc(40px + env(safe-area-inset-bottom));\n  }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-0.02em; margin:6px 2px 14px; }\n\n  .seg{ display:flex; background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8); border-radius:14px; padding:3px; margin-bottom:14px; gap:2px; }\n  .seg button{ flex:1; border:none; background:none; color:var(--myllm-muted,#8a8a8e); border-radius:11px; padding:9px 4px; font-size:13.5px; font-weight:700; font-family:inherit; }\n  .seg button.on{ background:var(--myllm-accent,#0a84ff); color:#fff; }\n\n  .card{ background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8); border-radius:16px; padding:14px; margin-bottom:12px; }\n  .card h2{ font-size:16px; font-weight:750; margin-bottom:4px; }\n  .card p.lede{ font-size:13.5px; color:var(--myllm-muted,#8a8a8e); line-height:1.5; }\n  label.cap{ display:block; font-size:11.5px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:var(--myllm-muted,#8a8a8e); margin:0 0 8px; }\n\n  .btn{ border:none; border-radius:13px; padding:13px 16px; font-size:15px; font-weight:750; background:var(--myllm-accent,#0a84ff); color:#fff; font-family:inherit; }\n  .btn.ghost{ background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111); border:1px solid var(--myllm-border,#e3e3e8); }\n  .btn.wide{ display:block; width:100%; margin-top:10px; }\n  .btn.sm{ padding:9px 13px; font-size:13.5px; border-radius:11px; }\n  .btn[disabled]{ opacity:.45; }\n\n  /* ---- chord diagram grid ---- */\n  .chordgrid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(96px,1fr)); gap:10px; }\n  .chordcell{ background:var(--myllm-bg,#f2f2f7); border:1px solid var(--myllm-border,#e3e3e8); border-radius:14px; padding:8px 4px 6px; text-align:center; font-family:inherit; color:var(--myllm-text,#111); }\n  .chordcell.on{ border-color:var(--myllm-accent,#0a84ff); background:rgba(10,132,255,.10); }\n  .chordcell b{ display:block; font-size:14.5px; font-weight:800; margin-bottom:2px; }\n  .chordcell small{ display:block; font-size:10px; color:var(--myllm-muted,#8a8a8e); margin-top:3px; }\n  .cats{ display:flex; flex-wrap:wrap; gap:6px; margin-bottom:12px; }\n  .cat{ border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111); border-radius:99px; padding:7px 12px; font-size:12.5px; font-weight:700; font-family:inherit; }\n  .cat.on{ background:var(--myllm-accent,#0a84ff); border-color:transparent; color:#fff; }\n  /* what each chord family IS and how the families combine — the bit that turns\n     a grid of shapes into something you can actually use */\n  .catinfo{ background:var(--myllm-bg,#f2f2f7); border:1px solid var(--myllm-border,#e3e3e8); border-radius:14px; padding:12px 13px; margin-bottom:12px; }\n  .catinfo h3{ font-size:14.5px; font-weight:800; margin-bottom:5px; }\n  .catinfo p{ font-size:13px; line-height:1.55; color:var(--myllm-text,#111); margin-bottom:7px; }\n  .catinfo p:last-child{ margin-bottom:0; }\n  .catinfo .together{ color:var(--myllm-muted,#8a8a8e); }\n  .catinfo .together b{ color:var(--myllm-text,#111); font-weight:750; }\n  .catinfo .try{ display:flex; flex-wrap:wrap; gap:6px; margin-top:9px; }\n  .catinfo .try button{ border:1px solid var(--myllm-accent,#0a84ff); background:none; color:var(--myllm-accent,#0a84ff); border-radius:99px; padding:7px 12px; font-size:12.5px; font-weight:750; font-family:inherit; }\n\n  /* ---- big detail view ---- */\n  .detail{ display:flex; gap:14px; align-items:center; flex-wrap:wrap; }\n  .detail .meta{ flex:1 1 150px; min-width:0; }\n  .detail .name{ font-size:34px; font-weight:800; letter-spacing:-0.02em; line-height:1.1; }\n  .detail .sub{ font-size:13px; color:var(--myllm-muted,#8a8a8e); margin-top:3px; line-height:1.5; }\n  .tips{ font-size:13px; line-height:1.55; margin-top:10px; }\n  .tips li{ margin-left:18px; margin-bottom:4px; }\n\n  /* ---- changes drill ---- */\n  .pair{ display:flex; gap:10px; align-items:center; justify-content:center; margin:6px 0 4px; }\n  .pair select{ flex:1 1 0; min-width:0; font-size:16px; font-weight:700; padding:10px; border-radius:12px; border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111); font-family:inherit; }\n  .pair span{ flex:0 0 auto; color:var(--myllm-muted,#8a8a8e); font-size:18px; }\n  .bigcount{ text-align:center; font-size:64px; font-weight:800; letter-spacing:-0.03em; line-height:1.05; }\n  .bigcount small{ display:block; font-size:13px; font-weight:650; color:var(--myllm-muted,#8a8a8e); letter-spacing:0; margin-top:2px; }\n  .timer{ text-align:center; font-size:15px; font-weight:700; color:var(--myllm-muted,#8a8a8e); margin-bottom:6px; }\n  .tapzone{ width:100%; border:2px dashed var(--myllm-border,#c9c9cf); border-radius:18px; padding:22px 12px; background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111); font-family:inherit; font-size:15px; font-weight:750; margin-top:8px; }\n  .tapzone.live{ border-style:solid; border-color:var(--myllm-accent,#0a84ff); background:rgba(10,132,255,.08); }\n  .best{ text-align:center; font-size:12.5px; color:var(--myllm-muted,#8a8a8e); margin-top:8px; }\n\n  /* ---- strumming ---- */\n  .strumrow{ display:flex; gap:6px; justify-content:center; margin:14px 0 8px; flex-wrap:wrap; }\n  .beat{ width:38px; height:52px; border-radius:11px; border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-bg,#f2f2f7); display:flex; align-items:center; justify-content:center; font-size:19px; font-weight:800; color:var(--myllm-text,#111); }\n  .beat.rest{ color:var(--myllm-border,#c9c9cf); }\n  .beat.hit{ background:var(--myllm-accent,#0a84ff); border-color:transparent; color:#fff; transform:scale(1.08); }\n  .row{ display:flex; gap:10px; align-items:center; }\n  .row .grow{ flex:1 1 0; min-width:0; }\n  input[type=range]{ width:100%; accent-color:var(--myllm-accent,#0a84ff); }\n\n  /* ---- songs ---- */\n  .bars{ display:grid; grid-template-columns:repeat(4,1fr); gap:6px; margin-top:10px; }\n  .bar{ background:var(--myllm-bg,#f2f2f7); border:1px solid var(--myllm-border,#e3e3e8); border-radius:10px; padding:10px 4px; text-align:center; font-size:14px; font-weight:800; }\n  .bar.on{ background:var(--myllm-accent,#0a84ff); border-color:transparent; color:#fff; }\n  .trad{ font-size:11.5px; color:var(--myllm-muted,#8a8a8e); margin-top:8px; line-height:1.5; }\n\n  /* ---- learn path ---- */\n  .step{ display:flex; gap:11px; align-items:flex-start; padding:11px 0; border-bottom:1px solid var(--myllm-border,#e3e3e8); }\n  .step:last-child{ border-bottom:none; }\n  .step .tick{ flex:0 0 auto; width:26px; height:26px; border-radius:50%; border:2px solid var(--myllm-border,#c9c9cf); display:flex; align-items:center; justify-content:center; font-size:13px; font-weight:800; color:var(--myllm-muted,#8a8a8e); background:none; font-family:inherit; }\n  .step.done .tick{ background:#30d158; border-color:#30d158; color:#fff; }\n  .step .body{ flex:1 1 0; min-width:0; }\n  .step .body b{ font-size:14.5px; font-weight:750; }\n  .step .body small{ display:block; font-size:12.5px; color:var(--myllm-muted,#8a8a8e); margin-top:2px; line-height:1.5; }\n  .step .body .go{ margin-top:7px; }\n  .prog{ height:7px; border-radius:4px; background:var(--myllm-border,#e3e3e8); overflow:hidden; margin:10px 0 2px; }\n  .prog i{ display:block; height:100%; background:#30d158; width:0%; transition:width .3s; }\n</style>\n</head>\n<body>\n\n<h1>🎸 Learn Guitar</h1>\n\n<div class=\"seg\">\n  <button id=\"tabLearn\" class=\"on\" onclick=\"showTab('learn')\">Learn</button>\n  <button id=\"tabChords\" onclick=\"showTab('chords')\">Chords</button>\n  <button id=\"tabChanges\" onclick=\"showTab('changes')\">Changes</button>\n  <button id=\"tabStrum\" onclick=\"showTab('strum')\">Strum</button>\n  <button id=\"tabSongs\" onclick=\"showTab('songs')\">Songs</button>\n</div>\n\n<!-- ======================= LEARN ======================= -->\n<div id=\"paneLearn\">\n  <div class=\"card\">\n    <h2>Your path</h2>\n    <p class=\"lede\">Work down the list. Each step is small on purpose — the aim is clean changes, not speed.</p>\n    <div class=\"prog\"><i id=\"progBar\"></i></div>\n    <div class=\"best\" id=\"progTxt\"></div>\n  </div>\n  <div class=\"card\" id=\"steps\"></div>\n  <div class=\"card\">\n    <h2>How to hold it</h2>\n    <p class=\"lede\">Thumb behind the neck, roughly opposite your middle finger. Press just behind the fret, not on top of it. Curl your fingers so the tips land straight down — flat fingers mute the strings next door, which is the usual reason a chord buzzes.</p>\n  </div>\n</div>\n\n<!-- ======================= CHORDS ======================= -->\n<div id=\"paneChords\" style=\"display:none\">\n  <div class=\"card\">\n    <div class=\"detail\">\n      <div id=\"bigChord\"></div>\n      <div class=\"meta\">\n        <div class=\"name\" id=\"cName\">—</div>\n        <div class=\"sub\" id=\"cSub\"></div>\n        <button class=\"btn sm\" style=\"margin-top:9px\" onclick=\"strumCurrent()\">▶︎ Hear it</button>\n      </div>\n    </div>\n    <ul class=\"tips\" id=\"cTips\"></ul>\n  </div>\n  <div class=\"card\">\n    <div class=\"cats\" id=\"cats\"></div>\n    <div class=\"catinfo\" id=\"catInfo\"></div>\n    <div class=\"chordgrid\" id=\"grid\"></div>\n  </div>\n</div>\n\n<!-- ======================= CHANGES ======================= -->\n<div id=\"paneChanges\" style=\"display:none\">\n  <div class=\"card\">\n    <h2>One-minute changes</h2>\n    <p class=\"lede\">The real test of a beginner guitarist isn't knowing shapes, it's swapping between them. Pick two chords, start the clock, and tap every time you land the change cleanly. Both chords must ring — no muted strings.</p>\n    <div class=\"pair\">\n      <select id=\"chA\"></select><span>↔</span><select id=\"chB\"></select>\n    </div>\n    <div class=\"row\" style=\"gap:8px;margin-top:8px\">\n      <button class=\"btn ghost sm grow\" onclick=\"hearPair()\">▶︎ Hear both</button>\n      <button class=\"btn sm grow\" id=\"startDrill\" onclick=\"toggleDrill()\">Start 60s</button>\n    </div>\n  </div>\n  <div class=\"card\">\n    <div class=\"timer\" id=\"drillTime\">60s</div>\n    <div class=\"bigcount\" id=\"drillCount\">0<small>changes</small></div>\n    <button class=\"tapzone\" id=\"tapZone\" onclick=\"tapChange()\">Tap here on every change</button>\n    <div class=\"best\" id=\"drillBest\"></div>\n  </div>\n  <div class=\"card\">\n    <p class=\"lede\"><b>What's a good score?</b> Around 20 in a minute means the shape is becoming automatic. Under 10 is completely normal in your first weeks — the fix is short sessions, often, not long ones.</p>\n  </div>\n</div>\n\n<!-- ======================= STRUM ======================= -->\n<div id=\"paneStrum\" style=\"display:none\">\n  <div class=\"card\">\n    <h2>Strumming patterns</h2>\n    <p class=\"lede\">Keep your hand moving down-up all the way through, even on the beats you don't hit. That steady motion is what keeps time — the missed strokes are just your hand passing the strings.</p>\n    <div class=\"cats\" id=\"patCats\"></div>\n    <div class=\"strumrow\" id=\"strumRow\"></div>\n    <div class=\"row\" style=\"margin-top:6px\">\n      <label class=\"cap\" style=\"margin:0;flex:0 0 auto\">Tempo</label>\n      <input type=\"range\" id=\"bpm\" min=\"50\" max=\"140\" value=\"70\" oninput=\"setBpm(this.value)\">\n      <b id=\"bpmTxt\" style=\"flex:0 0 auto;font-size:13px;min-width:58px;text-align:right\">70 BPM</b>\n    </div>\n    <div class=\"row\" style=\"gap:8px;margin-top:10px\">\n      <select id=\"strumChord\" class=\"grow\" style=\"font-size:15px;padding:10px;border-radius:12px;border:1px solid var(--myllm-border,#e3e3e8);background:var(--myllm-bg,#f2f2f7);color:var(--myllm-text,#111);font-family:inherit\"></select>\n      <button class=\"btn sm\" id=\"strumBtn\" onclick=\"toggleStrum()\">Play</button>\n    </div>\n  </div>\n</div>\n\n<!-- ======================= SONGS ======================= -->\n<div id=\"paneSongs\" style=\"display:none\">\n  <div class=\"card\">\n    <h2>Play something real</h2>\n    <p class=\"lede\">Four beats per box. Change chord when the highlight moves. Start slow enough that the changes are clean, then nudge the tempo up.</p>\n    <div class=\"cats\" id=\"songCats\"></div>\n    <div class=\"best\" id=\"songNeeds\" style=\"text-align:left;margin-top:2px\"></div>\n    <div class=\"bars\" id=\"songBars\"></div>\n    <div class=\"row\" style=\"gap:8px;margin-top:12px\">\n      <input type=\"range\" id=\"songBpm\" min=\"40\" max=\"120\" value=\"60\" oninput=\"setSongBpm(this.value)\" class=\"grow\">\n      <b id=\"songBpmTxt\" style=\"flex:0 0 auto;font-size:13px;min-width:58px;text-align:right\">60 BPM</b>\n    </div>\n    <button class=\"btn wide\" id=\"songBtn\" onclick=\"toggleSong()\">Play along</button>\n    <div class=\"trad\" id=\"songNote\"></div>\n  </div>\n</div>\n\n<script>\n/* ===================== helpers ===================== */\nfunction el(id){ return document.getElementById(id); }\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }\n\nvar store = {\n  set: async function(k,v){\n    try{ if(window.myllmStorage){ await myllmStorage.setItem(k,v); return; } }catch(e){}\n    try{ localStorage.setItem(k,v); }catch(e){}\n  },\n  get: async function(k){\n    try{ if(window.myllmStorage){ var v = await myllmStorage.getItem(k); if(v!=null) return v; } }catch(e){}\n    try{ return localStorage.getItem(k); }catch(e){ return null; }\n  }\n};\n\n/* ===================== chord data =====================\n   frets are low-E first; -1 = don't play, 0 = open string.\n   fingers: 1 index … 4 little, 0 = open/none. */\nvar OPEN_MIDI = [40,45,50,55,59,64];   /* E2 A2 D3 G3 B3 E4 */\n\nvar CHORDS = [\n  {n:\"Em\",  cat:\"Minors\",  frets:[0,2,2,0,0,0],     fing:[0,2,3,0,0,0], tip:\"Two fingers, nothing muted — the friendliest chord on the guitar.\"},\n  {n:\"Am\",  cat:\"Minors\",  frets:[-1,0,2,2,1,0],    fing:[0,0,2,3,1,0], tip:\"Same shape as E, moved across one string. Don't play the low E.\"},\n  {n:\"Dm\",  cat:\"Minors\",  frets:[-1,-1,0,2,3,1],   fing:[0,0,0,2,3,1], tip:\"A tight little triangle. Only the thin four strings.\"},\n  {n:\"E\",   cat:\"Majors\",  frets:[0,2,2,1,0,0],     fing:[0,2,3,1,0,0], tip:\"Em plus one finger. Big and full — all six strings ring.\"},\n  {n:\"A\",   cat:\"Majors\",  frets:[-1,0,2,2,2,0],    fing:[0,0,1,2,3,0], tip:\"Three fingers squeezed into one fret. Roll them slightly if they won't fit.\"},\n  {n:\"D\",   cat:\"Majors\",  frets:[-1,-1,0,2,3,2],   fing:[0,0,0,1,3,2], tip:\"Thin strings only. Keep your thumb low so your fingers arch.\"},\n  {n:\"G\",   cat:\"Majors\",  frets:[3,2,0,0,0,3],     fing:[2,1,0,0,0,3], tip:\"A wide stretch at first. Use fingers 2-1-3 so G to C is an easy move later.\"},\n  {n:\"C\",   cat:\"Majors\",  frets:[-1,3,2,0,1,0],    fing:[0,3,2,0,1,0], tip:\"A diagonal line. Keep the tips upright or the open strings choke.\"},\n  {n:\"E7\",  cat:\"Sevenths\",frets:[0,2,0,1,0,0],     fing:[0,2,0,1,0,0], tip:\"E with a finger lifted. Instantly bluesy.\"},\n  {n:\"A7\",  cat:\"Sevenths\",frets:[-1,0,2,0,2,0],    fing:[0,0,2,0,3,0], tip:\"Easier than A and sounds restless — it wants to move to D.\"},\n  {n:\"D7\",  cat:\"Sevenths\",frets:[-1,-1,0,2,1,2],   fing:[0,0,0,2,1,3], tip:\"The classic turnaround chord at the end of a blues line.\"},\n  {n:\"G7\",  cat:\"Sevenths\",frets:[3,2,0,0,0,1],     fing:[3,2,0,0,0,1], tip:\"G with the little finger swapped for the index on the thin string.\"},\n  {n:\"C7\",  cat:\"Sevenths\",frets:[-1,3,2,3,1,0],    fing:[0,3,2,4,1,0], tip:\"C plus the little finger. Needed for a blues in C or F.\"},\n  {n:\"B7\",  cat:\"Sevenths\",frets:[-1,2,1,2,0,2],    fing:[0,2,1,3,0,4], tip:\"Four fingers and awkward, but it's the chord that finishes an E blues.\"},\n  {n:\"Am7\", cat:\"Sevenths\",frets:[-1,0,2,0,1,0],    fing:[0,0,2,0,1,0], tip:\"Am with one finger lifted. Soft and open.\"},\n  {n:\"Em7\", cat:\"Sevenths\",frets:[0,2,2,0,3,0],     fing:[0,1,2,0,3,0], tip:\"Em with the little finger added. Drop it for plain Em any time.\"},\n  {n:\"Dm7\", cat:\"Sevenths\",frets:[-1,-1,0,2,1,1],   fing:[0,0,0,2,1,1], tip:\"One finger flattened across the top two strings — a gentle first barre.\"},\n  {n:\"Fmaj7\",cat:\"Majors\", frets:[-1,-1,3,2,1,0],   fing:[0,0,3,2,1,0], tip:\"Use this wherever F is asked for until the barre is ready.\"},\n  {n:\"F\",   cat:\"Barre\",   frets:[1,3,3,2,1,1],     fing:[1,3,4,2,1,1], barre:{fret:1,from:0,to:5}, tip:\"The wall every beginner hits. Index bar flat, thumb low and centred. Weeks, not days.\"},\n  {n:\"Bm\",  cat:\"Barre\",   frets:[-1,2,4,4,3,2],    fing:[0,1,3,4,2,1], barre:{fret:2,from:1,to:5}, tip:\"The Am shape with a bar behind it. Learn F first.\"},\n  {n:\"E5\",  cat:\"Power\",   frets:[0,2,2,-1,-1,-1],  fing:[0,1,2,0,0,0], tip:\"Neither major nor minor — the rock chord. Two fingers, thick strings only.\"},\n  {n:\"A5\",  cat:\"Power\",   frets:[-1,0,2,2,-1,-1],  fing:[0,0,1,2,0,0], tip:\"Same shape, one string across.\"},\n  {n:\"D5\",  cat:\"Power\",   frets:[-1,-1,0,2,3,-1],  fing:[0,0,0,1,3,0], tip:\"Move this shape up the neck and it stays a power chord.\"},\n  {n:\"G5\",  cat:\"Power\",   frets:[3,5,5,-1,-1,-1],  fing:[1,3,4,0,0,0], tip:\"A movable shape: slide it and the root moves with you.\"}\n];\nvar CATS = [\"All\",\"Majors\",\"Minors\",\"Sevenths\",\"Power\",\"Barre\"];\n\n/* Each family explained in plain English: what it is, and — the part beginners\n   actually need — how it sits alongside the others. `demo` is a progression the\n   reader can hear, so the explanation is audible rather than just words. */\nvar CATINFO = {\n  \"All\": {\n    h: \"Five families of chord\",\n    what: \"Every chord here belongs to one of five families. <b>Majors</b> sound bright and settled, <b>minors</b> sound wistful, <b>sevenths</b> sound unfinished and lean forward, <b>power chords</b> are neither happy nor sad, and <b>barre chords</b> are movable shapes that unlock the rest of the neck.\",\n    how: \"Start with majors and minors. Those two families alone cover most traditional songs — everything else is flavour you add later.\",\n    demos: [{n:\"Hear a major, then its minor\", bars:[\"C\",\"Am\"]}]\n  },\n  \"Majors\": {\n    h: \"Majors — the bright ones\",\n    what: \"The settled, finished-sounding chords, and the backbone of nearly every song. Most music stays inside three majors belonging to one key: in the key of G those are <b>G, C and D</b>.\",\n    how: \"Those three are the famous <b>I–IV–V</b>. Play G → C → G → D and you've played the most common progression in Western music. Learn one set of three and hundreds of songs open up.\",\n    demos: [{n:\"I–IV–V in G\", bars:[\"G\",\"C\",\"G\",\"D\"]}, {n:\"I–IV–V in A\", bars:[\"A\",\"D\",\"A\",\"E\"]}]\n  },\n  \"Minors\": {\n    h: \"Minors — the wistful ones\",\n    what: \"A major with one note moved down a single fret. That one note is the whole difference between bright and sad, which is worth knowing when a chord sounds wrong: you've probably fretted a major where a minor was wanted.\",\n    how: \"Every major key has minors that belong to it. In G, the minors are <b>Em and Am</b>. Slot one into a major progression for contrast — <b>G → Em → C → D</b> is the spine of countless songs.\",\n    demos: [{n:\"G → Em → C → D\", bars:[\"G\",\"Em\",\"C\",\"D\"]}, {n:\"Am → F-ish → C → G\", bars:[\"Am\",\"Fmaj7\",\"C\",\"G\"]}]\n  },\n  \"Sevenths\": {\n    h: \"Sevenths — the restless ones\",\n    what: \"A major or minor with one extra note stacked on top. It deliberately sounds unfinished, as if leaning towards the next chord — which is exactly what makes it useful.\",\n    how: \"Drop one in just before you change and it pulls you along: <b>G → G7 → C</b> practically drags you into the C. In blues, every chord becomes a seventh — that's the whole sound.\",\n    demos: [{n:\"G7 pulling into C\", bars:[\"G\",\"G7\",\"C\"]}, {n:\"Blues in A\", bars:[\"A7\",\"D7\",\"A7\",\"E7\"]}]\n  },\n  \"Power\": {\n    h: \"Power chords — neither happy nor sad\",\n    what: \"Only two different notes: the root and the fifth. The note that decides major or minor simply isn't there, so a power chord is neither — which is why it stays clean under heavy distortion where a full chord turns to mud.\",\n    how: \"The shape is <b>movable</b>: keep the fingering, slide it up or down, and the chord follows wherever the root lands. Two fingers gets you most rock rhythm playing.\",\n    demos: [{n:\"E5 → A5 → D5\", bars:[\"E5\",\"A5\",\"D5\"]}, {n:\"Riff shape\", bars:[\"E5\",\"G5\",\"A5\",\"E5\"]}]\n  },\n  \"Barre\": {\n    h: \"Barre chords — one shape, twelve chords\",\n    what: \"Your index finger lies flat across all six strings, acting as a movable nut, with an open-chord shape fretted behind it. Slide the whole thing and the chord changes name but keeps its character.\",\n    how: \"<b>F</b> is the E shape barred at the first fret; <b>Bm</b> is the Am shape barred at the second. This is the hardest step on the instrument and takes weeks, not days — use <b>Fmaj7</b> wherever a song asks for F until the barre is ready. Nobody listening will mind.\",\n    demos: [{n:\"F the easy way (Fmaj7)\", bars:[\"C\",\"Fmaj7\",\"G\",\"C\"]}, {n:\"The real thing\", bars:[\"F\",\"C\",\"G\",\"F\"]}]\n  }\n};\nfunction chordByName(n){ for(var i=0;i<CHORDS.length;i++) if(CHORDS[i].n===n) return CHORDS[i]; return null; }\n\n/* ===================== audio =====================\n   Karplus-Strong plucked string: a noise burst fed through a short delay line\n   with a gentle lowpass in the feedback path. Costs a few kilobytes of code\n   and sounds like a string, where samples would cost megabytes. */\nvar actx = null, bufCache = {};\nfunction ensureCtx(){\n  if(!actx){ var AC = window.AudioContext || window.webkitAudioContext; if(!AC) return null; actx = new AC(); }\n  if(actx.state === \"suspended\"){ try{ actx.resume(); }catch(e){} }\n  return actx;\n}\nfunction midiFreq(m){ return 440 * Math.pow(2,(m-69)/12); }\n/* Three refinements over a plain Karplus-Strong, each fixing one cause of the\n   thin, metallic character the textbook version has:\n\n   1. LOSS IS SET FROM A TARGET DECAY TIME. The naive version applies a fixed\n      per-lap factor, which at 0.9965 takes ~1970 laps to fall 60 dB — about\n      18 seconds at 110 Hz. The note therefore never decayed inside the buffer;\n      it held flat and was then killed by a linear fade, and a tone that\n      sustains and then ramps off is exactly what reads as metallic. Loss is\n      now derived from a target T60, longer for the bass strings than the\n      treble, so notes die away the way a string actually does.\n\n   2. THE EXCITATION IS COMB-FILTERED AT THE PICK POSITION. A real string\n      plucked an eighth of the way along starts with no energy in the harmonics\n      that have a node at that point. Feeding in flat white noise instead gives\n      every harmonic equal weight, which is much of why the plain algorithm\n      sounds wiry rather than woody.\n\n   3. THE LOOP FILTER DARKENS WITH PITCH. A thin top string loses its highs\n      faster than a wound bottom one; matching that stops the treble ringing\n      like a harpsichord. */\nfunction pluckBuffer(ctx, freq){\n  var key = Math.round(freq*10);\n  if(bufCache[key]) return bufCache[key];\n  var sr = ctx.sampleRate;\n  var hi = Math.min(1, Math.max(0, (freq-80)/280));   /* 0 = low E … 1 = high E */\n  var t60 = 3.6 - 1.5*hi;                             /* bass rings longer */\n  var dur = Math.min(3.0, t60*0.9);\n  /* Loop delay is N - b, not N + b. Working it through: a cell is rewritten as\n     g*((1-b)*cur + b*next), so out[i] = g*((1-b)out[i-N] + b*out[i-N+1]), whose\n     delay is (N-1) + (1-b) = N - b. Compensating the wrong way makes every\n     note sharp by 2b samples' worth — about 19 cents on the top string. */\n  var bright = 0.5 + 0.16*hi;\n  var N = Math.max(3, Math.round(sr/freq + bright));\n\n  var buf = ctx.createBuffer(1, Math.floor(sr*dur), sr);\n  var out = buf.getChannelData(0);\n\n  /* ---- excitation: softened noise, combed at the pick point ---- */\n  var ring = new Float32Array(N), i;\n  for(i=0;i<N;i++) ring[i] = Math.random()*2-1;\n  var lp = 0;\n  for(i=0;i<N;i++){ lp += 0.5*(ring[i]-lp); ring[i] = lp; }\n  /* pluck exactly 1/8 of the way along: the comb's null then lands ON the 8th\n     harmonic and its multiples, which is what a real pluck at that point does */\n  var pick = Math.max(1, Math.round(N/8));\n  for(i=N-1;i>=pick;i--) ring[i] -= 0.9*ring[i-pick];\n  var mx = 0;\n  for(i=0;i<N;i++) mx = Math.max(mx, Math.abs(ring[i]));\n  if(mx>0) for(i=0;i<N;i++) ring[i] /= mx;\n\n  /* ---- the string ---- */\n  var gLap = Math.pow(10, -3/(t60*freq));             /* one lap's loss for that T60 */\n  var idx = 0;\n  for(i=0;i<out.length;i++){\n    var cur = ring[idx], nxt = ring[(idx+1)%N];\n    out[i] = cur;\n    ring[idx] = ((1-bright)*cur + bright*nxt) * gLap;\n    idx = (idx+1)%N;\n  }\n  /* the note has already decayed on its own; this only guards the very end */\n  var f = Math.min(out.length, Math.floor(sr*0.08));\n  for(i=0;i<f;i++) out[out.length-1-i] *= i/f;\n  bufCache[key] = buf;\n  return buf;\n}\nfunction pluck(ctx, midi, when, gain){\n  var src = ctx.createBufferSource();\n  src.buffer = pluckBuffer(ctx, midiFreq(midi));\n  var g = ctx.createGain();\n  g.gain.value = gain==null ? 0.28 : gain;\n  src.connect(g); g.connect(ctx.destination);\n  src.start(when);\n  return src;\n}\n/* strum: stagger the strings so it rolls like a pick across them */\nfunction strumChord(ch, up, when){\n  var ctx = ensureCtx(); if(!ctx || !ch) return;\n  var t0 = when==null ? ctx.currentTime+0.01 : when;\n  var order = [0,1,2,3,4,5];\n  if(up) order = order.slice().reverse();\n  var k = 0;\n  for(var i=0;i<order.length;i++){\n    var s = order[i], fr = ch.frets[s];\n    if(fr < 0) continue;\n    pluck(ctx, OPEN_MIDI[s]+fr, t0 + k*0.026, 0.26);\n    k++;\n  }\n}\nfunction click(ctx, when, accent){\n  var o = ctx.createOscillator(), g = ctx.createGain();\n  o.frequency.value = accent ? 1600 : 1100;\n  g.gain.setValueAtTime(0.0001, when);\n  g.gain.exponentialRampToValueAtTime(accent?0.3:0.16, when+0.002);\n  g.gain.exponentialRampToValueAtTime(0.0001, when+0.055);\n  o.connect(g); g.connect(ctx.destination);\n  o.start(when); o.stop(when+0.07);\n}\n\n/* ===================== chord diagram (SVG) ===================== */\nfunction chordSVG(ch, size){\n  var W = size||118, H = Math.round(W*1.30);\n  var padL = W*0.14, padR = W*0.10, padT = H*0.20, padB = H*0.07;\n  var gw = W-padL-padR, gh = H-padT-padB;\n  var strings = 6, frets = 5;\n  var sx = gw/(strings-1), fy = gh/frets;\n  var lo = 99, hi = 0, i;\n  for(i=0;i<6;i++){ var f=ch.frets[i]; if(f>0){ if(f<lo) lo=f; if(f>hi) hi=f; } }\n  if(lo===99) lo = 1;\n  var base = (hi<=4) ? 1 : lo;          /* show open position unless the shape sits higher */\n  var s = '<svg viewBox=\"0 0 '+W+' '+H+'\" width=\"'+W+'\" height=\"'+H+'\" aria-label=\"'+esc(ch.n)+' chord diagram\">';\n  var C = 'var(--myllm-text,#111)', M = 'var(--myllm-muted,#8a8a8e)', A = 'var(--myllm-accent,#0a84ff)';\n  /* nut or fret-number label */\n  if(base===1) s += '<rect x=\"'+padL+'\" y=\"'+(padT-3)+'\" width=\"'+gw+'\" height=\"4\" fill=\"'+C+'\"/>';\n  else s += '<text x=\"'+(padL-6)+'\" y=\"'+(padT+fy*0.7)+'\" font-size=\"'+(W*0.11)+'\" fill=\"'+M+'\" text-anchor=\"end\" font-weight=\"700\">'+base+'</text>';\n  for(i=0;i<=frets;i++) s += '<line x1=\"'+padL+'\" y1=\"'+(padT+i*fy)+'\" x2=\"'+(padL+gw)+'\" y2=\"'+(padT+i*fy)+'\" stroke=\"'+M+'\" stroke-opacity=\".45\" stroke-width=\"1\"/>';\n  for(i=0;i<strings;i++) s += '<line x1=\"'+(padL+i*sx)+'\" y1=\"'+padT+'\" x2=\"'+(padL+i*sx)+'\" y2=\"'+(padT+gh)+'\" stroke=\"'+M+'\" stroke-opacity=\".55\" stroke-width=\"1\"/>';\n  /* barre bar behind the dots */\n  if(ch.barre && ch.barre.fret>=base && ch.barre.fret<base+frets){\n    var by = padT+(ch.barre.fret-base+0.5)*fy;\n    s += '<rect x=\"'+(padL+ch.barre.from*sx-sx*0.28)+'\" y=\"'+(by-fy*0.30)+'\" width=\"'+((ch.barre.to-ch.barre.from)*sx+sx*0.56)+'\" height=\"'+(fy*0.60)+'\" rx=\"'+(fy*0.30)+'\" fill=\"'+A+'\"/>';\n  }\n  for(i=0;i<6;i++){\n    var f = ch.frets[i], x = padL+i*sx;\n    if(f < 0){\n      s += '<text x=\"'+x+'\" y=\"'+(padT-7)+'\" font-size=\"'+(W*0.115)+'\" fill=\"'+M+'\" text-anchor=\"middle\" font-weight=\"700\">✕</text>';\n    } else if(f === 0){\n      s += '<circle cx=\"'+x+'\" cy=\"'+(padT-11)+'\" r=\"'+(W*0.045)+'\" fill=\"none\" stroke=\"'+M+'\" stroke-width=\"1.6\"/>';\n    } else if(f>=base && f<base+frets){\n      var isBarreEnd = ch.barre && ch.barre.fret===f;\n      var y = padT+(f-base+0.5)*fy;\n      if(!isBarreEnd) s += '<circle cx=\"'+x+'\" cy=\"'+y+'\" r=\"'+(W*0.078)+'\" fill=\"'+A+'\"/>';\n      var fg = ch.fing[i];\n      if(fg) s += '<text x=\"'+x+'\" y=\"'+(y+W*0.033)+'\" font-size=\"'+(W*0.088)+'\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"800\">'+fg+'</text>';\n    }\n  }\n  return s+'</svg>';\n}\n\n/* ===================== chords tab ===================== */\nvar curCat = \"All\", curChord = CHORDS[0];\nfunction renderCats(){\n  el(\"cats\").innerHTML = CATS.map(function(c){\n    return '<button class=\"cat'+(c===curCat?' on':'')+'\" onclick=\"setCat(\\''+c+'\\')\">'+c+'</button>';\n  }).join(\"\");\n}\nfunction setCat(c){ curCat=c; renderCats(); renderCatInfo(); renderGrid(); haptic(\"light\"); }\nfunction renderCatInfo(){\n  var info = CATINFO[curCat]; if(!info) { el(\"catInfo\").innerHTML=\"\"; return; }\n  var demos = (info.demos||[]).map(function(d,i){\n    return '<button onclick=\"playDemo(\\''+curCat+'\\','+i+')\">▶︎ '+esc(d.n)+'</button>';\n  }).join(\"\");\n  el(\"catInfo\").innerHTML =\n      '<h3>'+esc(info.h)+'</h3>'\n    + '<p>'+info.what+'</p>'\n    + '<p class=\"together\"><b>Playing them together:</b> '+info.how+'</p>'\n    + (demos ? '<div class=\"try\">'+demos+'</div>' : '');\n}\n/* play a short progression so the explanation can be heard, not just read */\nfunction playDemo(cat, i){\n  var d = (CATINFO[cat].demos||[])[i]; if(!d) return;\n  var ctx = ensureCtx(); if(!ctx) return;\n  var t = ctx.currentTime + 0.05;\n  d.bars.forEach(function(name, k){\n    var ch = chordByName(name);\n    if(ch) strumChord(ch, false, t + k*1.15);\n  });\n  haptic(\"light\");\n}\nfunction renderGrid(){\n  var list = CHORDS.filter(function(c){ return curCat===\"All\" || c.cat===curCat; });\n  el(\"grid\").innerHTML = list.map(function(c){\n    return '<button class=\"chordcell'+(c.n===curChord.n?' on':'')+'\" onclick=\"pickChord(\\''+c.n+'\\')\">'\n         + '<b>'+esc(c.n)+'</b>'+chordSVG(c,78)+'<small>'+esc(c.cat)+'</small></button>';\n  }).join(\"\");\n}\nfunction pickChord(n){\n  curChord = chordByName(n) || curChord;\n  renderGrid(); renderDetail(); strumCurrent(); haptic(\"light\");\n}\nfunction renderDetail(){\n  var c = curChord;\n  el(\"bigChord\").innerHTML = chordSVG(c,132);\n  el(\"cName\").textContent = c.n;\n  var played = c.frets.filter(function(f){ return f>=0; }).length;\n  el(\"cSub\").textContent = played+\" of 6 strings\" + (c.barre ? \" · barre chord\" : \"\");\n  var names = [\"low E\",\"A\",\"D\",\"G\",\"B\",\"high E\"];\n  var lines = ['<li>'+esc(c.tip)+'</li>'];\n  var muted = [];\n  for(var i=0;i<6;i++) if(c.frets[i]<0) muted.push(names[i]);\n  if(muted.length) lines.push(\"<li>Don't play the \"+muted.join(\" or \")+\" string\"+(muted.length>1?\"s\":\"\")+\".</li>\");\n  lines.push(\"<li>Play it one string at a time — every note should ring. A dead note means a finger is leaning on its neighbour.</li>\");\n  el(\"cTips\").innerHTML = lines.join(\"\");\n}\nfunction strumCurrent(){ strumChord(curChord,false); haptic(\"light\"); }\n\n/* ===================== changes drill ===================== */\nvar drillOn=false, drillLeft=60, drillCount=0, drillTimer=null, bestScores={};\nfunction fillChordSelects(){\n  var opts = CHORDS.map(function(c){ return '<option value=\"'+c.n+'\">'+esc(c.n)+'</option>'; }).join(\"\");\n  [\"chA\",\"chB\",\"strumChord\"].forEach(function(id){ if(el(id)) el(id).innerHTML = opts; });\n  el(\"chA\").value = \"Em\"; el(\"chB\").value = \"Am\"; el(\"strumChord\").value = \"Em\";\n  el(\"chA\").onchange = el(\"chB\").onchange = showBest;\n  showBest();\n}\nfunction pairKey(){ var a=el(\"chA\").value, b=el(\"chB\").value; return [a,b].sort().join(\"|\"); }\nfunction showBest(){\n  var k = pairKey(), v = bestScores[k];\n  el(\"drillBest\").textContent = v ? (\"Your best for this pair: \"+v+\" changes\") : \"No score yet for this pair.\";\n}\nfunction hearPair(){\n  var ctx = ensureCtx(); if(!ctx) return;\n  var t = ctx.currentTime+0.05;\n  strumChord(chordByName(el(\"chA\").value), false, t);\n  strumChord(chordByName(el(\"chB\").value), false, t+1.1);\n  haptic(\"light\");\n}\nfunction toggleDrill(){\n  if(drillOn){ endDrill(); return; }\n  ensureCtx();\n  drillOn=true; drillLeft=60; drillCount=0;\n  el(\"startDrill\").textContent=\"Stop\";\n  el(\"tapZone\").className=\"tapzone live\";\n  el(\"drillCount\").innerHTML='0<small>changes</small>';\n  el(\"drillTime\").textContent=\"60s\";\n  haptic(\"success\");\n  drillTimer = setInterval(function(){\n    drillLeft--;\n    el(\"drillTime\").textContent = drillLeft+\"s\";\n    if(drillLeft<=0) endDrill(true);\n  },1000);\n}\nfunction tapChange(){\n  if(!drillOn) return;\n  drillCount++;\n  el(\"drillCount\").innerHTML = drillCount+'<small>changes</small>';\n  haptic(\"light\");\n}\nfunction endDrill(finished){\n  drillOn=false; clearInterval(drillTimer); drillTimer=null;\n  el(\"startDrill\").textContent=\"Start 60s\";\n  el(\"tapZone\").className=\"tapzone\";\n  el(\"drillTime\").textContent = finished ? \"Time!\" : \"60s\";\n  if(finished){\n    var k = pairKey();\n    if(!bestScores[k] || drillCount>bestScores[k]){\n      bestScores[k]=drillCount;\n      store.set(\"lg.best\", JSON.stringify(bestScores));\n    }\n    if(drillCount>=10) markDone(\"changes\");\n    haptic(\"success\");\n  }\n  showBest();\n}\n\n/* ===================== strumming ===================== */\nvar PATTERNS = [\n  {n:\"All down\",     p:[\"D\",\"D\",\"D\",\"D\"]},\n  {n:\"Down-up\",      p:[\"D\",\"U\",\"D\",\"U\",\"D\",\"U\",\"D\",\"U\"]},\n  {n:\"The classic\",  p:[\"D\",\"-\",\"D\",\"U\",\"-\",\"U\",\"D\",\"U\"]},\n  {n:\"Folk\",         p:[\"D\",\"-\",\"D\",\"U\",\"D\",\"U\",\"D\",\"U\"]},\n  {n:\"Waltz (3/4)\",  p:[\"D\",\"U\",\"D\",\"U\",\"D\",\"U\"]}\n];\nvar curPat = PATTERNS[0], strumOn=false, strumTimer=null, strumIdx=0, bpm=70;\nfunction renderPats(){\n  el(\"patCats\").innerHTML = PATTERNS.map(function(p,i){\n    return '<button class=\"cat'+(p===curPat?' on':'')+'\" onclick=\"setPat('+i+')\">'+esc(p.n)+'</button>';\n  }).join(\"\");\n  renderStrumRow(-1);\n}\nfunction setPat(i){ curPat=PATTERNS[i]; strumIdx=0; renderPats(); haptic(\"light\"); }\nfunction renderStrumRow(active){\n  el(\"strumRow\").innerHTML = curPat.p.map(function(s,i){\n    var cls = \"beat\"+(s===\"-\"?\" rest\":\"\")+(i===active?\" hit\":\"\");\n    return '<div class=\"'+cls+'\">'+(s===\"-\"?\"·\":(s===\"D\"?\"↓\":\"↑\"))+'</div>';\n  }).join(\"\");\n}\nfunction setBpm(v){ bpm = +v; el(\"bpmTxt\").textContent = bpm+\" BPM\"; if(strumOn){ stopStrum(); startStrum(); } }\nfunction startStrum(){\n  var ctx = ensureCtx(); if(!ctx) return;\n  strumOn = true; el(\"strumBtn\").textContent = \"Stop\";\n  var eighth = 30000/bpm;      /* two strokes per beat */\n  strumTimer = setInterval(function(){\n    var s = curPat.p[strumIdx % curPat.p.length];\n    renderStrumRow(strumIdx % curPat.p.length);\n    var isBeat = (strumIdx % 2) === 0;\n    click(ctx, ctx.currentTime+0.001, isBeat && (strumIdx % curPat.p.length)===0);\n    if(s!==\"-\") strumChord(chordByName(el(\"strumChord\").value), s===\"U\");\n    strumIdx++;\n  }, eighth);\n}\nfunction stopStrum(){ strumOn=false; clearInterval(strumTimer); strumTimer=null; el(\"strumBtn\").textContent=\"Play\"; renderStrumRow(-1); }\nfunction toggleStrum(){ if(strumOn){ stopStrum(); } else { startStrum(); markDone(\"strum\"); } haptic(\"light\"); }\n\n/* ===================== songs =====================\n   Traditional / public-domain only — the same rule the piano game follows.\n   Chord progressions are facts, but modern arrangements are not ours to ship. */\nvar SONGS = [\n  {n:\"12-bar blues in A\", bars:[\"A\",\"A\",\"A\",\"A\",\"D\",\"D\",\"A\",\"A\",\"E\",\"D\",\"A\",\"E\"],\n   note:\"Not a song but a form — the backbone of blues and early rock, and public domain by nature.\"},\n  {n:\"House of the Rising Sun\", bars:[\"Am\",\"C\",\"D\",\"Fmaj7\",\"Am\",\"C\",\"E\",\"E\"],\n   note:\"Traditional folk ballad, origins in the 18th–19th century.\"},\n  {n:\"Scarborough Fair\", bars:[\"Am\",\"Am\",\"C\",\"D\",\"Am\",\"C\",\"Am\",\"Am\"],\n   note:\"Traditional English ballad, first printed in the 17th century.\"},\n  {n:\"Amazing Grace\", bars:[\"G\",\"G\",\"C\",\"G\",\"G\",\"D\",\"G\",\"G\"],\n   note:\"Words by John Newton, 1779. Long out of copyright.\"},\n  {n:\"When the Saints Go Marching In\", bars:[\"G\",\"G\",\"G\",\"G\",\"C\",\"C\",\"G\",\"G\"],\n   note:\"Traditional American gospel, published in the early 1900s.\"},\n  {n:\"Auld Lang Syne\", bars:[\"G\",\"G\",\"C\",\"G\",\"G\",\"C\",\"D\",\"G\"],\n   note:\"Robert Burns, 1788, to an older folk melody.\"}\n];\nvar curSong = SONGS[0], songOn=false, songTimer=null, songIdx=0, songBpm=60;\nfunction renderSongs(){\n  el(\"songCats\").innerHTML = SONGS.map(function(s,i){\n    return '<button class=\"cat'+(s===curSong?' on':'')+'\" onclick=\"setSong('+i+')\">'+esc(s.n)+'</button>';\n  }).join(\"\");\n  renderBars(-1);\n  var need = curSong.bars.filter(function(v,i,a){ return a.indexOf(v)===i; });\n  el(\"songNeeds\").textContent = \"Chords you'll need: \"+need.join(\"  ·  \");\n  el(\"songNote\").textContent = curSong.note;\n}\nfunction setSong(i){ if(songOn) stopSong(); curSong=SONGS[i]; songIdx=0; renderSongs(); haptic(\"light\"); }\nfunction renderBars(active){\n  el(\"songBars\").innerHTML = curSong.bars.map(function(b,i){\n    return '<div class=\"bar'+(i===active?' on':'')+'\">'+esc(b)+'</div>';\n  }).join(\"\");\n}\nfunction setSongBpm(v){ songBpm=+v; el(\"songBpmTxt\").textContent=songBpm+\" BPM\"; if(songOn){ stopSong(); startSong(); } }\nfunction startSong(){\n  var ctx = ensureCtx(); if(!ctx) return;\n  songOn=true; el(\"songBtn\").textContent=\"Stop\";\n  var barMs = 4*60000/songBpm;\n  var fire = function(){\n    var i = songIdx % curSong.bars.length;\n    renderBars(i);\n    strumChord(chordByName(curSong.bars[i]), false);\n    songIdx++;\n  };\n  fire();\n  songTimer = setInterval(fire, barMs);\n}\nfunction stopSong(){ songOn=false; clearInterval(songTimer); songTimer=null; el(\"songBtn\").textContent=\"Play along\"; renderBars(-1); }\nfunction toggleSong(){ if(songOn){ stopSong(); } else { startSong(); markDone(\"song\"); } haptic(\"light\"); }\n\n/* ===================== learn path ===================== */\nvar STEPS = [\n  {id:\"strings\", t:\"Meet the six strings\", d:\"Low to high: E A D G B E. Thickest is the low E. Tap to hear them ring.\", act:\"Hear the strings\", fn:function(){ heartStrings(); }},\n  {id:\"em\",      t:\"Your first chord: Em\", d:\"Two fingers, all six strings. Get every note ringing before moving on.\", act:\"Show me Em\", fn:function(){ showTab('chords'); pickChord('Em'); }},\n  {id:\"am\",      t:\"Add Am\", d:\"One extra finger on the Em shape, shifted across. Now you have two chords.\", act:\"Show me Am\", fn:function(){ showTab('chords'); pickChord('Am'); }},\n  {id:\"changes\", t:\"Change between them\", d:\"Score 10 or more in the one-minute drill. This is the step that actually makes you a guitarist.\", act:\"Start the drill\", fn:function(){ showTab('changes'); el('chA').value='Em'; el('chB').value='Am'; showBest(); }},\n  {id:\"strum\",   t:\"Learn a strum\", d:\"Start with all-downs at a slow tempo, then try the down-up pattern.\", act:\"Open strumming\", fn:function(){ showTab('strum'); }},\n  {id:\"gcd\",     t:\"The big three: G, C, D\", d:\"Most traditional songs live in these three chords. Learn the shapes, then drill G↔C and C↔D.\", act:\"Show me G\", fn:function(){ showTab('chords'); pickChord('G'); }},\n  {id:\"song\",    t:\"Play a whole song\", d:\"Four beats a bar, slow enough to change cleanly. Speed comes later, on its own.\", act:\"Open songs\", fn:function(){ showTab('songs'); }},\n  {id:\"sevenths\",t:\"Add the sevenths\", d:\"E7, A7 and D7 turn three chords into a blues. Small change, completely different mood.\", act:\"Show me A7\", fn:function(){ showTab('chords'); pickChord('A7'); }},\n  {id:\"barre\",   t:\"Start on F\", d:\"The barre chord everyone struggles with. Use Fmaj7 in songs meanwhile — nobody will mind.\", act:\"Show me F\", fn:function(){ showTab('chords'); pickChord('F'); }}\n];\nvar done = {};\nfunction heartStrings(){\n  var ctx = ensureCtx(); if(!ctx) return;\n  for(var i=0;i<6;i++) pluck(ctx, OPEN_MIDI[i], ctx.currentTime+0.05+i*0.45, 0.3);\n  markDone(\"strings\"); haptic(\"light\");\n}\nfunction renderSteps(){\n  el(\"steps\").innerHTML = STEPS.map(function(s,i){\n    return '<div class=\"step'+(done[s.id]?' done':'')+'\">'\n      + '<button class=\"tick\" onclick=\"toggleDone(\\''+s.id+'\\')\" aria-label=\"Mark done\">'+(done[s.id]?'✓':(i+1))+'</button>'\n      + '<div class=\"body\"><b>'+esc(s.t)+'</b><small>'+esc(s.d)+'</small>'\n      + '<button class=\"btn ghost sm go\" onclick=\"runStep('+i+')\">'+esc(s.act)+'</button></div></div>';\n  }).join(\"\");\n  var n = STEPS.filter(function(s){ return done[s.id]; }).length;\n  el(\"progBar\").style.width = Math.round(n/STEPS.length*100)+\"%\";\n  el(\"progTxt\").textContent = n+\" of \"+STEPS.length+\" steps done\";\n}\nfunction runStep(i){ STEPS[i].fn(); }\nfunction toggleDone(id){ done[id] = !done[id]; store.set(\"lg.done\", JSON.stringify(done)); renderSteps(); haptic(\"light\"); }\nfunction markDone(id){ if(!done[id]){ done[id]=true; store.set(\"lg.done\", JSON.stringify(done)); renderSteps(); } }\n\n/* ===================== tabs ===================== */\nvar PANES = {learn:\"paneLearn\", chords:\"paneChords\", changes:\"paneChanges\", strum:\"paneStrum\", songs:\"paneSongs\"};\nvar TABS  = {learn:\"tabLearn\", chords:\"tabChords\", changes:\"tabChanges\", strum:\"tabStrum\", songs:\"tabSongs\"};\nfunction showTab(k){\n  if(strumOn) stopStrum();\n  if(songOn) stopSong();\n  Object.keys(PANES).forEach(function(key){\n    el(PANES[key]).style.display = (key===k) ? \"block\" : \"none\";\n    el(TABS[key]).className = (key===k) ? \"on\" : \"\";\n  });\n  window.scrollTo(0,0);\n}\n\n/* ===================== boot ===================== */\n(async function(){\n  try{\n    var d = await store.get(\"lg.done\"); if(d) done = JSON.parse(d) || {};\n    var b = await store.get(\"lg.best\"); if(b) bestScores = JSON.parse(b) || {};\n  }catch(e){}\n  renderCats(); renderCatInfo(); renderGrid(); renderDetail();\n  fillChordSelects(); renderPats(); renderSongs(); renderSteps();\n})();\n</script>\n</body>\n</html>\n"}