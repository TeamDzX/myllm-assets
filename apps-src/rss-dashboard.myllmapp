{"name": "Headlines", "kind": "html", "iconSymbol": "square.grid.2x2.fill", "iconColor": "purple", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Headlines</title>\n<style>\n:root{\n  color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7);\n  --surface:var(--myllm-surface,#fff);\n  --text:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#6b6b72);\n  --accent:var(--myllm-accent,#0b5ed7);\n  --border:var(--myllm-border,rgba(120,120,128,.22));\n  --radius:var(--myllm-radius,14px);\n  --font:var(--myllm-font,-apple-system,system-ui,sans-serif);\n}\n@media(prefers-color-scheme:dark){\n  :root{--bg:var(--myllm-bg,#000);--surface:var(--myllm-surface,#1c1c1e);--text:var(--myllm-text,#eee);--muted:var(--myllm-muted,#98989f)}\n}\n*{box-sizing:border-box}\nbody{margin:0;font-family:var(--font);background:var(--bg);color:var(--text);-webkit-text-size-adjust:100%}\n.head{position:sticky;top:0;z-index:10;background:var(--bg);padding:10px 0 0;border-bottom:1px solid var(--border)}\n#tabs{display:flex;gap:6px;overflow-x:auto;padding:0 16px 12px;-webkit-overflow-scrolling:touch;scrollbar-width:none}\n#tabs::-webkit-scrollbar{display:none}\n.tab{flex:none;border:0;padding:8px 14px;border-radius:999px;background:var(--surface);color:var(--muted);font:inherit;font-size:14px;font-weight:600;cursor:pointer;white-space:nowrap;border:1px solid var(--border)}\n.tab.on{background:var(--accent);color:#fff;border-color:transparent}\n#status{padding:40px 24px;text-align:center;color:var(--muted);font-size:15px;line-height:1.5}\n.wrap{padding:14px 16px 28px;max-width:780px;margin:0 auto}\na.card,a.hero{display:block;text-decoration:none;color:inherit;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;-webkit-tap-highlight-color:transparent}\na.hero{margin-bottom:16px}\n.thumb{width:100%;background:linear-gradient(135deg,var(--accent),#7b5cff);position:relative;display:flex;align-items:center;justify-content:center}\n.hero .thumb{aspect-ratio:16/9}\n.card .thumb{aspect-ratio:16/10}\n.thumb img{width:100%;height:100%;object-fit:cover;display:block}\n.thumb .ph{font-size:34px;opacity:.85}\n.body{position:relative;padding:13px 15px 26px}\n.lean{position:absolute;right:14px;bottom:12px;width:36px;height:4px;border-radius:2px;background:linear-gradient(90deg,#3b6fd4,#8e8e93 50%,#c0392b);opacity:.85}\n.lean i{position:absolute;top:50%;transform:translate(-50%,-50%);width:9px;height:9px;border-radius:50%;background:var(--surface);border:2px solid var(--text)}\n.hero .body h2{font-size:20px;line-height:1.3;margin:0 0 8px;font-weight:700}\n.hero .excerpt{font-size:14px;line-height:1.5;color:var(--muted);margin:0}\n.card .body h3{font-size:16px;line-height:1.35;margin:0;font-weight:600}\n.meta{font-size:12px;font-weight:600;letter-spacing:.02em;color:var(--accent);margin-bottom:7px;text-transform:uppercase}\n.card .meta{margin-bottom:6px}\n#grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px}\n#more{display:block;margin:22px auto 0;padding:11px 22px;background:var(--accent);color:#fff;border:0;border-radius:10px;font:inherit;font-size:15px;font-weight:600;cursor:pointer}\n#more[disabled]{opacity:.5}\n@media(prefers-reduced-motion:no-preference){a.card,a.hero{transition:transform .12s ease}a.card:active,a.hero:active{transform:scale(.985)}}\n</style>\n</head>\n<body>\n\n<div class=\"head\">\n  <div id=\"tabs\"></div>\n</div>\n\n<div id=\"status\"></div>\n<div class=\"wrap\">\n  <div id=\"hero\"></div>\n  <div id=\"grid\"></div>\n  <button id=\"more\" style=\"display:none\">Load more</button>\n</div>\n\n<script>\nvar TOPICS=[\n  {name:\"Top\",          src:\"BBC\",          url:\"https://feeds.bbci.co.uk/news/rss.xml\"},\n  {name:\"World\",        src:\"BBC\",          url:\"https://feeds.bbci.co.uk/news/world/rss.xml\"},\n  {name:\"UK\",           src:\"BBC\",          url:\"https://feeds.bbci.co.uk/news/uk/rss.xml\"},\n  {name:\"Business\",     src:\"BBC\",          url:\"https://feeds.bbci.co.uk/news/business/rss.xml\"},\n  {name:\"Technology\",   src:\"Ars Technica\", url:\"https://feeds.arstechnica.com/arstechnica/index\"},\n  {name:\"Science\",      src:\"BBC\",          url:\"https://feeds.bbci.co.uk/news/science_and_environment/rss.xml\"},\n  {name:\"Health\",       src:\"BBC\",          url:\"https://feeds.bbci.co.uk/news/health/rss.xml\"},\n  {name:\"Politics\",     src:\"BBC\",          url:\"https://feeds.bbci.co.uk/news/politics/rss.xml\"},\n  {name:\"Entertainment\",src:\"BBC\",          url:\"https://feeds.bbci.co.uk/news/entertainment_and_arts/rss.xml\"},\n  {name:\"Sport\",        src:\"BBC\",          url:\"https://feeds.bbci.co.uk/sport/rss.xml\"},\n  {name:\"Environment\",  src:\"The Guardian\", url:\"https://www.theguardian.com/environment/rss\"},\n  {name:\"Football\",     src:\"The Guardian\", url:\"https://www.theguardian.com/football/rss\"},\n  {name:\"Film\",         src:\"The Guardian\", url:\"https://www.theguardian.com/film/rss\"},\n  {name:\"Music\",        src:\"The Guardian\", url:\"https://www.theguardian.com/music/rss\"},\n  {name:\"Games\",        src:\"The Guardian\", url:\"https://www.theguardian.com/games/rss\"},\n  {name:\"Food\",         src:\"The Guardian\", url:\"https://www.theguardian.com/food/rss\"},\n  {name:\"Travel\",       src:\"The Guardian\", url:\"https://www.theguardian.com/travel/rss\"},\n  {name:\"Books\",        src:\"The Guardian\", url:\"https://www.theguardian.com/books/rss\"}\n];\n\nvar PAGE=8, active=0, shown=0, articles=[], cache={};\nfunction el(i){return document.getElementById(i)}\nfunction setStatus(t){var s=el('status');s.style.display=t?'block':'none';s.textContent=t||''}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\n\nfunction buildTabs(){\n  var T=el('tabs');T.innerHTML='';\n  TOPICS.forEach(function(t,i){\n    var b=document.createElement('button');\n    b.className='tab'+(i===active?' on':'');\n    b.textContent=t.name;\n    b.onclick=function(){\n      haptic('selection');\n      if(i===active){delete cache[TOPICS[i].url]} // tap active tab to refresh\n      active=i;\n      buildTabs();\n      load();\n      window.scrollTo(0,0);\n    };\n    T.appendChild(b);\n  });\n}\n\nfunction load(){\n  var t=TOPICS[active];\n  el('hero').innerHTML='';el('grid').innerHTML='';el('more').style.display='none';\n  shown=0;\n  if(cache[t.url]){articles=cache[t.url];setStatus('');paint();return}\n  if(!window.myllmFetch){setStatus('Headlines needs network access — update MyLLM and turn on “Allow apps to use the network” in Settings → MyLLMos Apps.');return}\n  setStatus('Loading '+t.name+'…');\n  myllmFetch(t.url,{headers:{Accept:'application/rss+xml,application/atom+xml,application/xml,text/xml'}})\n    .then(function(r){\n      if(!r||!r.ok)throw new Error('feed returned '+((r&&r.status)||'no response'));\n      var items=parse(r.body);\n      if(!items.length)throw new Error('no stories found');\n      articles=items;cache[t.url]=items;setStatus('');paint();\n    })\n    .catch(function(e){setStatus('Couldn’t load '+t.name+': '+e.message+'\\nTap the topic again to retry.')});\n}\n\nfunction parse(xml){\n  var doc=new DOMParser().parseFromString(xml,'text/xml');\n  var nodes=doc.getElementsByTagName('item');\n  var atom=false;\n  if(!nodes.length){nodes=doc.getElementsByTagName('entry');atom=true}\n  var out=[];\n  for(var i=0;i<nodes.length;i++){\n    var n=nodes[i];\n    var title=text(n,'title');\n    if(!title)continue;\n    var link=text(n,'link');\n    if(atom||!link){\n      var ls=n.getElementsByTagName('link');\n      for(var k=0;k<ls.length;k++){var h=ls[k].getAttribute('href');if(h){link=h;if((ls[k].getAttribute('rel')||'alternate')==='alternate')break}}\n    }\n    var desc=text(n,'description')||text(n,'summary')||text(n,'content');\n    out.push({\n      title:title,\n      link:link,\n      date:text(n,'pubDate')||text(n,'updated')||text(n,'published')||text(n,'date'),\n      excerpt:strip(desc),\n      image:imageOf(n,desc)\n    });\n  }\n  return out;\n}\n\nfunction text(node,tag){var e=node.getElementsByTagName(tag)[0];return e?e.textContent.trim():''}\n\n// Pull the best image: media:content/thumbnail (largest), then enclosure,\n// then the first <img> embedded in the description HTML.\nfunction imageOf(node,descHtml){\n  var best=null,bestW=-1;\n  function consider(url,w,type){\n    if(!url)return;\n    if(type&&type.indexOf('image')===-1&&type!=='image'&&!/\\.(jpe?g|png|webp|gif)(\\?|$)/i.test(url))return;\n    w=parseInt(w)||0;\n    if(w>bestW){best=url;bestW=w}\n  }\n  ['media:content','media:thumbnail'].forEach(function(tag){\n    var els=node.getElementsByTagName(tag);\n    for(var i=0;i<els.length;i++)consider(els[i].getAttribute('url'),els[i].getAttribute('width'),els[i].getAttribute('type')||els[i].getAttribute('medium'));\n  });\n  if(!best){\n    var enc=node.getElementsByTagName('enclosure');\n    for(var j=0;j<enc.length;j++)consider(enc[j].getAttribute('url'),enc[j].getAttribute('width'),enc[j].getAttribute('type'));\n  }\n  if(!best&&descHtml){var m=descHtml.match(/<img[^>]+src=[\"']([^\"']+)[\"']/i);if(m)best=m[1]}\n  return best;\n}\n\nfunction strip(html){\n  if(!html)return'';\n  var d=document.createElement('div');d.innerHTML=html;\n  var t=(d.textContent||'').replace(/\\s+/g,' ').trim();\n  return t.length>200?t.slice(0,200)+'…':t;\n}\nfunction ago(d){\n  if(!d)return'';var t=new Date(d);if(isNaN(t))return'';\n  var s=Math.round((Date.now()-t)/1000);\n  if(s<60)return'just now';\n  if(s<3600)return Math.round(s/60)+'m ago';\n  if(s<86400)return Math.round(s/3600)+'h ago';\n  return Math.round(s/86400)+'d ago';\n}\nfunction esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;')}\nfunction thumb(a){\n  if(a.image)return '<div class=\"thumb\"><img loading=\"lazy\" src=\"'+esc(a.image)+'\" onerror=\"this.style.display=\\'none\\';this.parentNode.innerHTML=\\'<span class=&quot;ph&quot;>🗞️</span>\\'\"></div>';\n  return '<div class=\"thumb\"><span class=\"ph\">🗞️</span></div>';\n}\nfunction metaLine(a){var src=TOPICS[active].src,t=ago(a.date);return esc(src)+(t?' • '+t:'')}\n\n// Political lean of the outlet (per AllSides/MBFC-style source ratings),\n// shown as a dot on a left–right spectrum bar. 0 = left, 100 = right.\nvar LEAN={\"BBC\":{pos:50,label:\"Centre\"},\"The Guardian\":{pos:28,label:\"Left-leaning\"},\"Ars Technica\":{pos:40,label:\"Centre-left\"}};\nfunction leanBadge(){\n  var l=LEAN[TOPICS[active].src];\n  if(!l)return'';\n  return '<span class=\"lean\" role=\"img\" title=\"Political lean: '+l.label+'\" aria-label=\"Political lean: '+l.label+'\"><i style=\"left:'+l.pos+'%\"></i></span>';\n}\n\nfunction paint(){\n  var hero=articles[0];\n  el('hero').innerHTML=hero?(\n    '<a class=\"hero\" href=\"'+esc(hero.link||'#')+'\" target=\"_blank\" rel=\"noopener\">'+\n      thumb(hero)+\n      '<div class=\"body\"><div class=\"meta\">'+metaLine(hero)+'</div>'+\n      '<h2>'+esc(hero.title)+'</h2>'+\n      (hero.excerpt?'<p class=\"excerpt\">'+esc(hero.excerpt)+'</p>':'')+\n      leanBadge()+\n      '</div></a>'\n  ):'';\n  shown=1;\n  el('grid').innerHTML='';\n  more();\n}\nfunction more(){\n  var slice=articles.slice(shown,shown+PAGE),frag=document.createDocumentFragment();\n  slice.forEach(function(a){\n    var card=document.createElement('a');\n    card.className='card';card.href=a.link||'#';card.target='_blank';card.rel='noopener';\n    card.innerHTML=thumb(a)+'<div class=\"body\"><div class=\"meta\">'+metaLine(a)+'</div><h3>'+esc(a.title)+'</h3>'+leanBadge()+'</div>';\n    card.addEventListener('click',function(){haptic('light')});\n    frag.appendChild(card);\n  });\n  el('grid').appendChild(frag);\n  shown+=slice.length;\n  var b=el('more');\n  if(shown>=articles.length){b.style.display='none'}\n  else{b.style.display='block';b.disabled=false;b.textContent='Load more'}\n}\nel('more').onclick=function(){haptic('selection');more()};\n\nbuildTabs();\nload();\n</script>\n</body>\n</html>\n"}