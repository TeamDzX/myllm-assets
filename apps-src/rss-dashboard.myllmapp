{"name": "Headlines", "kind": "html", "iconSymbol": "square.grid.2x2.fill", "iconColor": "purple", "html": "<!doctype html>\n<!--\n  Headlines — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Headlines</title>\n<style>\n:root{--build-id:\"1b88943126\";\n  color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7);\n  --surface:var(--myllm-surface,#fff);\n  --text:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#6b6b72);\n  --accent:var(--myllm-accent,#0b5ed7);\n  --border:var(--myllm-border,rgba(120,120,128,.22));\n  --radius:var(--myllm-radius,14px);\n  --font:var(--myllm-font,-apple-system,system-ui,sans-serif);\n}\n@media(prefers-color-scheme:dark){\n  :root{--bg:var(--myllm-bg,#000);--surface:var(--myllm-surface,#1c1c1e);--text:var(--myllm-text,#eee);--muted:var(--myllm-muted,#98989f)}\n}\n*{box-sizing:border-box}\nbody{margin:0;font-family:var(--font);background:var(--bg);color:var(--text);-webkit-text-size-adjust:100%}\n.head{position:sticky;top:0;z-index:10;background:var(--bg);padding:10px 0 0;border-bottom:1px solid var(--border)}\n.headrow{display:flex;align-items:flex-start}\n#tabs{display:flex;gap:6px;overflow-x:auto;padding:0 16px 12px 4px;-webkit-overflow-scrolling:touch;scrollbar-width:none;flex:1;min-width:0}\n#tabs::-webkit-scrollbar{display:none}\n#gear{flex:none;border:1px solid var(--border);background:var(--surface);color:var(--muted);border-radius:999px;width:36px;height:36px;font-size:17px;margin:0 6px 0 16px;cursor:pointer}\n.prefs{position:fixed;inset:0;z-index:400;display:none;background:rgba(0,0,0,.45);align-items:flex-end}\n.prefs.on{display:flex}\n.prefs .sheet{background:var(--surface);width:100%;max-width:780px;margin:0 auto;border-radius:18px 18px 0 0;padding:20px 18px calc(26px + env(safe-area-inset-bottom))}\n.prefs h3{font-size:18px;font-weight:800;margin:0 0 12px}\n.prefs label{display:block;font-size:11.5px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--muted);margin:12px 0 7px}\n.prefs .chips{display:flex;flex-wrap:wrap;gap:7px}\n.prefs .chips button{border:1px solid var(--border);background:var(--bg);color:var(--text);border-radius:999px;padding:8px 14px;font:inherit;font-size:13.5px;font-weight:600;cursor:pointer}\n.prefs .chips button.on{background:var(--accent);border-color:transparent;color:#fff}\n.prefs .pnote{font-size:12.5px;color:var(--muted);line-height:1.5;margin:12px 0 0}\n.prefs .done{display:block;width:100%;margin-top:16px;border:0;border-radius:12px;padding:13px;background:var(--accent);color:#fff;font:inherit;font-size:15px;font-weight:700;cursor:pointer}\n.tab{flex:none;border:0;padding:8px 14px;border-radius:999px;background:var(--surface);color:var(--muted);font:inherit;font-size:14px;font-weight:600;cursor:pointer;white-space:nowrap;border:1px solid var(--border)}\n.tab.on{background:var(--accent);color:#fff;border-color:transparent}\n#status{padding:40px 24px;text-align:center;color:var(--muted);font-size:15px;line-height:1.5}\n.wrap{padding:14px 16px 28px;max-width:780px;margin:0 auto}\na.card,a.hero{display:block;text-decoration:none;color:inherit;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;-webkit-tap-highlight-color:transparent}\na.hero{margin-bottom:16px}\n.thumb{width:100%;background:linear-gradient(135deg,var(--accent),#7b5cff);position:relative;display:flex;align-items:center;justify-content:center}\n.hero .thumb{aspect-ratio:16/9}\n.card .thumb{aspect-ratio:16/10}\n.thumb img{width:100%;height:100%;object-fit:cover;display:block}\n.thumb .ph{font-size:34px;opacity:.85}\n.body{position:relative;padding:13px 15px 26px}\n.lean{position:absolute;right:14px;bottom:12px;width:36px;height:4px;border-radius:2px;background:linear-gradient(90deg,#3b6fd4,#8e8e93 50%,#c0392b);opacity:.85;cursor:pointer}\n.lean::before{content:'';position:absolute;inset:-14px -12px} /* enlarged tap target */\n.lean i{position:absolute;top:50%;transform:translate(-50%,-50%);width:9px;height:9px;border-radius:50%;background:var(--surface);border:2px solid var(--text)}\n#ovl{position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.45);display:flex;align-items:flex-end;justify-content:center}\n.sheet{background:var(--bg);width:100%;max-width:640px;max-height:82vh;border-radius:18px 18px 0 0;display:flex;flex-direction:column;overflow:hidden;padding-bottom:env(safe-area-inset-bottom)}\n.sh-head{display:flex;align-items:center;justify-content:space-between;padding:14px 16px 10px}\n.sh-t{font-size:17px;font-weight:700}\n.sh-x{border:0;background:var(--surface);color:var(--muted);width:30px;height:30px;border-radius:50%;font-size:15px;cursor:pointer;border:1px solid var(--border)}\n.sh-story{padding:0 16px 10px;font-size:13px;color:var(--muted);line-height:1.4}\n.sh-sum{margin:0 16px 12px;padding:12px 14px;background:var(--surface);border:1px solid var(--border);border-radius:12px;font-size:14px;line-height:1.5}\n.sh-sum b{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--accent);margin-bottom:5px}\n.sh-sum .sh-wait{color:var(--muted);font-size:13px}\n.sh-body{overflow-y:auto;padding:0 16px 20px;-webkit-overflow-scrolling:touch}\n.sh-load,.sh-empty{padding:26px 0;text-align:center;color:var(--muted);font-size:14px;line-height:1.5}\na.cvg{display:flex;gap:11px;align-items:center;text-decoration:none;color:inherit;background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:10px;margin-bottom:9px}\n.cvg .tmb{flex:none;width:62px;height:62px;border-radius:9px;overflow:hidden;background:linear-gradient(135deg,var(--accent),#7b5cff);display:flex;align-items:center;justify-content:center;font-size:22px}\n.cvg .tmb img{width:100%;height:100%;object-fit:cover;display:block}\n.cvg .cbody{display:block;min-width:0}\n.cvg-src{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.02em;color:var(--accent);margin-bottom:4px}\n.cvg-src .when{font-weight:600;color:var(--muted);text-transform:none;letter-spacing:0;margin-left:auto}\n.cvg h4{margin:0;font-size:14px;line-height:1.4;font-weight:600}\n.mini{position:relative;width:26px;height:3px;border-radius:2px;background:linear-gradient(90deg,#3b6fd4,#8e8e93 50%,#c0392b);flex:none}\n.mini i{position:absolute;top:50%;transform:translate(-50%,-50%);width:7px;height:7px;border-radius:50%;background:var(--surface);border:1.5px solid var(--text)}\n.hero .body h2{font-size:20px;line-height:1.3;margin:0 0 8px;font-weight:700}\n.hero .excerpt{font-size:14px;line-height:1.5;color:var(--muted);margin:0}\n.card .body h3{font-size:16px;line-height:1.35;margin:0;font-weight:600}\n.meta{font-size:12px;font-weight:600;letter-spacing:.02em;color:var(--accent);margin-bottom:7px;text-transform:uppercase}\n.card .meta{margin-bottom:6px}\n#grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px}\n#more{display:block;margin:22px auto 0;padding:11px 22px;background:var(--accent);color:#fff;border:0;border-radius:10px;font:inherit;font-size:15px;font-weight:600;cursor:pointer}\n#more[disabled]{opacity:.5}\n@media(prefers-reduced-motion:no-preference){a.card,a.hero{transition:transform .12s ease}a.card:active,a.hero:active{transform:scale(.985)}}\n</style>\n</head>\n<body>\n\n<div class=\"head\">\n  <div class=\"headrow\">\n    <button id=\"gear\" onclick=\"openPrefs()\" aria-label=\"Feed settings\">⚙︎</button>\n    <div id=\"tabs\"></div>\n  </div>\n</div>\n\n<div id=\"prefs\" class=\"prefs\">\n  <div class=\"sheet\">\n    <h3>Your feed</h3>\n    <label>Region</label>\n    <div class=\"chips\" id=\"regionChips\"></div>\n    <label>Perspective</label>\n    <div class=\"chips\" id=\"perspChips\"></div>\n    <p class=\"pnote\" id=\"pnote\">Every option keeps centre outlets in the mix, and each story shows its outlet and lean — the dial tilts the blend, it never hides the other side entirely.</p>\n    <button class=\"done\" onclick=\"closePrefs()\">Done</button>\n  </div>\n</div>\n\n<div id=\"status\"></div>\n<div class=\"wrap\">\n  <div id=\"hero\"></div>\n  <div id=\"grid\"></div>\n  <button id=\"more\" style=\"display:none\">Load more</button>\n</div>\n\n<script>\n// Each topic blends several channels across the spectrum; stories are\n// interleaved round-robin so no single outlet dominates the top of the wall.\nvar TOPICS=[\n  {name:\"Top\",srcs:[\n    {src:\"BBC\",url:\"https://feeds.bbci.co.uk/news/rss.xml\"},\n    {src:\"Sky News\",url:\"https://feeds.skynews.com/feeds/rss/home.xml\"},\n    {src:\"The Independent\",url:\"https://www.independent.co.uk/news/rss\"},\n    {src:\"Daily Express\",url:\"https://www.express.co.uk/posts/rss/1\"}]},\n  {name:\"World\",srcs:[\n    {src:\"BBC\",url:\"https://feeds.bbci.co.uk/news/world/rss.xml\"},\n    {src:\"The Guardian\",url:\"https://www.theguardian.com/world/rss\"},\n    {src:\"Al Jazeera\",url:\"https://www.aljazeera.com/xml/rss/all.xml\"},\n    {src:\"Sky News\",url:\"https://feeds.skynews.com/feeds/rss/world.xml\"}]},\n  {name:\"UK\",srcs:[\n    {src:\"BBC\",url:\"https://feeds.bbci.co.uk/news/uk/rss.xml\"},\n    {src:\"The Guardian\",url:\"https://www.theguardian.com/uk-news/rss\"},\n    {src:\"The Sun\",url:\"https://www.thesun.co.uk/news/feed/\"},\n    {src:\"Daily Express\",url:\"https://www.express.co.uk/posts/rss/1\"}]},\n  {name:\"Business\",srcs:[\n    {src:\"BBC\",url:\"https://feeds.bbci.co.uk/news/business/rss.xml\"},\n    {src:\"The Guardian\",url:\"https://www.theguardian.com/uk/business/rss\"},\n    {src:\"Sky News\",url:\"https://feeds.skynews.com/feeds/rss/business.xml\"}]},\n  {name:\"Technology\",srcs:[\n    {src:\"Ars Technica\",url:\"https://feeds.arstechnica.com/arstechnica/index\"},\n    {src:\"BBC\",url:\"https://feeds.bbci.co.uk/news/technology/rss.xml\"},\n    {src:\"The Guardian\",url:\"https://www.theguardian.com/uk/technology/rss\"},\n    {src:\"Sky News\",url:\"https://feeds.skynews.com/feeds/rss/technology.xml\"}]},\n  {name:\"Science\",srcs:[\n    {src:\"BBC\",url:\"https://feeds.bbci.co.uk/news/science_and_environment/rss.xml\"},\n    {src:\"The Guardian\",url:\"https://www.theguardian.com/science/rss\"}]},\n  {name:\"Health\",srcs:[\n    {src:\"BBC\",url:\"https://feeds.bbci.co.uk/news/health/rss.xml\"},\n    {src:\"The Guardian\",url:\"https://www.theguardian.com/society/rss\"}]},\n  {name:\"Politics\",srcs:[\n    {src:\"BBC\",url:\"https://feeds.bbci.co.uk/news/politics/rss.xml\"},\n    {src:\"The Guardian\",url:\"https://www.theguardian.com/politics/rss\"},\n    {src:\"Sky News\",url:\"https://feeds.skynews.com/feeds/rss/politics.xml\"},\n    {src:\"GB News\",url:\"https://www.gbnews.com/feeds/politics.rss\"},\n    {src:\"Daily Express\",url:\"https://www.express.co.uk/posts/rss/139\"}]},\n  {name:\"Entertainment\",srcs:[\n    {src:\"BBC\",url:\"https://feeds.bbci.co.uk/news/entertainment_and_arts/rss.xml\"},\n    {src:\"The Guardian\",url:\"https://www.theguardian.com/culture/rss\"},\n    {src:\"The Sun\",url:\"https://www.thesun.co.uk/tvandshowbiz/feed/\"},\n    {src:\"New York Post\",url:\"https://nypost.com/entertainment/feed/\"}]},\n  {name:\"Sport\",srcs:[\n    {src:\"BBC\",url:\"https://feeds.bbci.co.uk/sport/rss.xml\"},\n    {src:\"The Guardian\",url:\"https://www.theguardian.com/uk/sport/rss\"},\n    {src:\"Daily Mirror\",url:\"https://www.mirror.co.uk/sport/rss.xml\"}]},\n  {name:\"Environment\",srcs:[\n    {src:\"The Guardian\",url:\"https://www.theguardian.com/environment/rss\"},\n    {src:\"BBC\",url:\"https://feeds.bbci.co.uk/news/science_and_environment/rss.xml\"}]},\n  {name:\"Football\",srcs:[\n    {src:\"The Guardian\",url:\"https://www.theguardian.com/football/rss\"},\n    {src:\"The Sun\",url:\"https://www.thesun.co.uk/sport/football/feed/\"}]},\n  {name:\"Film\",srcs:[{src:\"The Guardian\",url:\"https://www.theguardian.com/film/rss\"}]},\n  {name:\"Music\",srcs:[{src:\"The Guardian\",url:\"https://www.theguardian.com/music/rss\"}]},\n  {name:\"Games\",srcs:[{src:\"The Guardian\",url:\"https://www.theguardian.com/games/rss\"}]},\n  {name:\"Food\",srcs:[{src:\"The Guardian\",url:\"https://www.theguardian.com/food/rss\"}]},\n  {name:\"Travel\",srcs:[{src:\"The Guardian\",url:\"https://www.theguardian.com/travel/rss\"}]},\n  {name:\"Books\",srcs:[{src:\"The Guardian\",url:\"https://www.theguardian.com/books/rss\"}]}\n];\n\nvar PAGE=8, active=0, shown=0, articles=[], cache={};\nfunction el(i){return document.getElementById(i)}\nfunction setStatus(t){var s=el('status');s.style.display=t?'block':'none';s.textContent=t||''}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\n\nfunction buildTabs(){\n  var T=el('tabs');T.innerHTML='';\n  TOPICS.forEach(function(t,i){\n    var b=document.createElement('button');\n    b.className='tab'+(i===active?' on':'');\n    b.textContent=t.name;\n    b.onclick=function(){\n      haptic('selection');\n      if(i===active){TOPICS[i].srcs.forEach(function(s){delete cache[s.url]})} // tap active tab to refresh\n      active=i;\n      buildTabs();\n      load();\n      window.scrollTo(0,0);\n    };\n    T.appendChild(b);\n  });\n}\n\nvar loadGen=0;\nfunction load(){\n  var t=TOPICS[active];\n  el('hero').innerHTML='';el('grid').innerHTML='';el('more').style.display='none';\n  shown=0;\n  if(!window.myllmFetch){setStatus('Headlines needs network access — update MyLLM and turn on “Allow apps to use the network” in Settings → MyLLMos Apps.');return}\n  setStatus('Loading '+t.name+'…');\n  var gen=++loadGen;\n  Promise.all(t.srcs.map(function(s){\n    return getFeed(s.url).then(function(items){\n      items.forEach(function(it){it.src=s.src});\n      return items;\n    },function(){return null});\n  })).then(function(feeds){\n    if(gen!==loadGen)return; // user switched topic while loading\n    var ok=feeds.filter(function(f){return f&&f.length});\n    if(!ok.length){setStatus('Couldn’t load '+t.name+' from any of its channels.\\nTap the topic again to retry.');return}\n    articles=interleave(ok);\n    setStatus('');paint();\n  });\n}\n\n// Round-robin merge: story i of each channel in turn, so the wall opens with\n// one story per outlet rather than a block from whichever feed is largest.\nfunction interleave(feeds){\n  var out=[],i=0,added=true;\n  while(added&&out.length<60){\n    added=false;\n    for(var f=0;f<feeds.length;f++){\n      if(i<feeds[f].length&&i<15){out.push(feeds[f][i]);added=true}\n    }\n    i++;\n  }\n  return out;\n}\n\nfunction parse(xml){\n  var doc=new DOMParser().parseFromString(xml,'text/xml');\n  var nodes=doc.getElementsByTagName('item');\n  var atom=false;\n  if(!nodes.length){nodes=doc.getElementsByTagName('entry');atom=true}\n  var out=[];\n  for(var i=0;i<nodes.length;i++){\n    var n=nodes[i];\n    var title=text(n,'title');\n    if(!title)continue;\n    var link=text(n,'link');\n    if(atom||!link){\n      var ls=n.getElementsByTagName('link');\n      for(var k=0;k<ls.length;k++){var h=ls[k].getAttribute('href');if(h){link=h;if((ls[k].getAttribute('rel')||'alternate')==='alternate')break}}\n    }\n    var desc=text(n,'description')||text(n,'summary')||text(n,'content');\n    // WordPress-family feeds (NY Post, The Hill, Japan Times, Hindustan\n    // Times, Global News…) carry their images in content:encoded, not the\n    // description — scan it too or whole regions render as placeholders.\n    var bodyHtml=text(n,'content:encoded');\n    out.push({\n      title:title,\n      link:link,\n      date:text(n,'pubDate')||text(n,'updated')||text(n,'published')||text(n,'date'),\n      excerpt:strip(desc||bodyHtml),\n      image:imageOf(n,desc,bodyHtml)\n    });\n  }\n  return out;\n}\n\nfunction text(node,tag){var e=node.getElementsByTagName(tag)[0];return e?e.textContent.trim():''}\n\n// Pull the best image: media:content/thumbnail (largest), then enclosure,\n// then the first <img> embedded in the description or content:encoded HTML.\nfunction imageOf(node,descHtml,bodyHtml){\n  var best=null,bestW=-1;\n  function consider(url,w,type){\n    if(!url)return;\n    if(type&&type.indexOf('image')===-1&&type!=='image'&&!/\\.(jpe?g|png|webp|gif)(\\?|$)/i.test(url))return;\n    w=parseInt(w)||0;\n    if(w>bestW){best=url;bestW=w}\n  }\n  ['media:content','media:thumbnail'].forEach(function(tag){\n    var els=node.getElementsByTagName(tag);\n    for(var i=0;i<els.length;i++)consider(els[i].getAttribute('url'),els[i].getAttribute('width'),els[i].getAttribute('type')||els[i].getAttribute('medium'));\n  });\n  if(!best){\n    var enc=node.getElementsByTagName('enclosure');\n    for(var j=0;j<enc.length;j++)consider(enc[j].getAttribute('url'),enc[j].getAttribute('width'),enc[j].getAttribute('type'));\n  }\n  if(!best&&descHtml){var m=descHtml.match(/<img[^>]+src=[\"']([^\"']+)[\"']/i);if(m)best=m[1]}\n  if(!best&&bodyHtml){var m2=bodyHtml.match(/<img[^>]+src=[\"']([^\"']+)[\"']/i);if(m2)best=m2[1]}\n  return best;\n}\n\n// og:image rescue: some outlets' feeds carry NO image data at all (Al Jazeera,\n// NPR, DW, Nikkei, NHK). For rendered cards that lack an image, fetch the\n// article page and use its og:image. Bounded: 2 concurrent, ≤10 article\n// fetches per topic load, results cached per link so tab-hopping is free.\nvar ogCache={};                       // link → url | null (null = tried, none)\nvar ogInflight=0, ogQueue=[], ogBudget=0;\nfunction setThumb(node,url){\n  var t=node&&node.querySelector&&node.querySelector('.thumb');\n  if(t)t.innerHTML='<img loading=\"lazy\" src=\"'+esc(url)+'\" data-orig=\"'+esc(url)+'\" onerror=\"imgFallback(this)\">';\n}\nfunction rescueImage(a,node,gen){\n  if(!a||a.image||!a.link||!window.myllmFetch)return;\n  if(ogCache[a.link]!==undefined){\n    if(ogCache[a.link]){a.image=ogCache[a.link];setThumb(node,a.image)}\n    return;\n  }\n  if(ogBudget<=0)return;\n  ogBudget--;\n  ogQueue.push({a:a,node:node,gen:gen});\n  pumpOg();\n}\nfunction pumpOg(){\n  if(ogInflight>=2||!ogQueue.length)return;\n  var job=ogQueue.shift();\n  if(job.gen!==loadGen){pumpOg();return}\n  if(ogCache[job.a.link]!==undefined){\n    if(ogCache[job.a.link]){job.a.image=ogCache[job.a.link];setThumb(job.node,job.a.image)}\n    pumpOg();return;\n  }\n  ogInflight++;\n  var done=function(){ogInflight--;pumpOg()};\n  myllmFetch(job.a.link).then(function(r){\n    var body=String(r&&r.body||'');\n    var m=body.match(/property=[\"']og:image[\"'][^>]+content=[\"']([^\"']+)[\"']/i)\n        ||body.match(/content=[\"']([^\"']+)[\"'][^>]+property=[\"']og:image[\"']/i);\n    ogCache[job.a.link]=m?m[1]:null;\n    if(m&&job.gen===loadGen){job.a.image=m[1];setThumb(job.node,m[1])}\n    done();\n  },function(){ogCache[job.a.link]=null;done()});\n}\n\nfunction strip(html){\n  if(!html)return'';\n  var d=document.createElement('div');d.innerHTML=html;\n  var t=(d.textContent||'').replace(/\\s+/g,' ').trim();\n  return t.length>200?t.slice(0,200)+'…':t;\n}\nfunction ago(d){\n  if(!d)return'';var t=new Date(d);if(isNaN(t))return'';\n  var s=Math.round((Date.now()-t)/1000);\n  if(s<60)return'just now';\n  if(s<3600)return Math.round(s/60)+'m ago';\n  if(s<86400)return Math.round(s/3600)+'h ago';\n  return Math.round(s/86400)+'d ago';\n}\nfunction esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;')}\nfunction thumb(a){\n  if(a.image)return '<div class=\"thumb\"><img loading=\"lazy\" src=\"'+esc(a.image)+'\" data-orig=\"'+esc(a.image)+'\" onerror=\"imgFallback(this)\"></div>';\n  return '<div class=\"thumb\"><span class=\"ph\">🗞️</span></div>';\n}\n\n// Hotlink rescue: some outlets' CDNs (Japan Times…) 403 any image request\n// whose Referer isn't their own site — a webview <img> can never satisfy\n// that. On error, refetch ONCE through the native bridge with the image's\n// own origin as Referer and swap in a data URL; if that also fails, show\n// the placeholder as before.\nfunction imgFallback(img){\n  var src=img.getAttribute('data-orig');\n  img.removeAttribute('data-orig');                       // one retry only\n  if(!src||!window.myllmFetch){phImg(img);return}\n  var origin=(src.match(/^https?:\\/\\/[^\\/]+/)||[])[0];\n  if(!origin){phImg(img);return}\n  myllmFetch(src,{headers:{'Referer':origin+'/'}}).then(function(r){\n    var b64=r&&(r.bodyBase64||r.base64);\n    if(r&&r.ok&&b64){\n      var ct=(r.headers&&(r.headers['Content-Type']||r.headers['content-type']))||'image/jpeg';\n      img.src='data:'+ct+';base64,'+b64;\n    }else phImg(img);\n  }).catch(function(){phImg(img)});\n}\nfunction phImg(img){\n  img.style.display='none';\n  if(img.parentNode)img.parentNode.innerHTML='<span class=\"ph\">🗞️</span>';\n}\nfunction metaLine(a){var t=ago(a.date);return esc(a.src||'')+(t?' • '+t:'')}\n\n// Political lean per outlet (per AllSides/MBFC-style source ratings),\n// shown as a dot on a left–right spectrum bar. 0 = left, 100 = right.\nvar SRC_LEAN={\n  \"Daily Mirror\":   {pos:28,label:\"Left-leaning\"},\n  \"The Guardian\":   {pos:28,label:\"Left-leaning\"},\n  \"Guardian Australia\":{pos:28,label:\"Left-leaning\"},\n  \"The Independent\":{pos:30,label:\"Left-leaning\"},\n  \"CNN\":            {pos:32,label:\"Left-leaning\"},\n  \"NPR\":            {pos:36,label:\"Centre-left\"},\n  \"The Hindu\":      {pos:36,label:\"Centre-left\"},\n  \"NDTV\":           {pos:38,label:\"Centre-left\"},\n  \"Ars Technica\":   {pos:40,label:\"Centre-left\"},\n  \"Al Jazeera\":     {pos:40,label:\"Centre-left\"},\n  \"CBC\":            {pos:42,label:\"Centre-left\"},\n  \"Japan Times\":    {pos:42,label:\"Centre-left\"},\n  \"Sydney Morning Herald\":{pos:43,label:\"Centre-left\"},\n  \"Politico\":       {pos:46,label:\"Centre\"},\n  \"Politico Europe\":{pos:46,label:\"Centre\"},\n  \"France 24\":      {pos:46,label:\"Centre\"},\n  \"DW\":             {pos:46,label:\"Centre\"},\n  \"ABC News (AU)\":  {pos:46,label:\"Centre\"},\n  \"Euronews\":       {pos:48,label:\"Centre\"},\n  \"Sky News\":       {pos:48,label:\"Centre\"},\n  \"Global News\":    {pos:48,label:\"Centre\"},\n  \"Hindustan Times\":{pos:48,label:\"Centre\"},\n  \"BBC\":            {pos:50,label:\"Centre\"},\n  \"NHK\":            {pos:50,label:\"Centre\"},\n  \"SCMP\":           {pos:52,label:\"Centre\"},\n  \"The Hill\":       {pos:52,label:\"Centre\"},\n  \"Times of India\": {pos:55,label:\"Centre\"},\n  \"Nikkei Asia\":    {pos:56,label:\"Centre\"},\n  \"National Post\":  {pos:66,label:\"Right-leaning\"},\n  \"The Sun\":        {pos:70,label:\"Right-leaning\"},\n  \"New York Post\":  {pos:70,label:\"Right-leaning\"},\n  \"Daily Express\":  {pos:72,label:\"Right-leaning\"},\n  \"GB News\":        {pos:75,label:\"Right-leaning\"},\n  \"Fox News\":       {pos:78,label:\"Right-leaning\"}\n};\nfunction leanBadge(a){\n  var l=SRC_LEAN[a.src];\n  if(!l)return'';\n  var t='Political lean: '+l.label+'. Tap to compare coverage on other channels.';\n  return '<span class=\"lean\" role=\"button\" tabindex=\"0\" title=\"'+t+'\" aria-label=\"'+t+'\"><i style=\"left:'+l.pos+'%\"></i></span>';\n}\nfunction wireLean(root,article){\n  var b=root.querySelector('.lean');\n  if(b)b.onclick=function(e){e.preventDefault();e.stopPropagation();openCoverage(article)};\n}\n\n// Fixed panel of channels across the spectrum for the coverage sheet (lean\n// comes from SRC_LEAN). Each entry's own RSS feed supplies the story match AND\n// its thumbnail. Feeds land in the shared session `cache` (per-feed cache);\n// matched results are cached per story below.\nvar SPECTRUM=[\n  {src:\"Daily Mirror\",   url:\"https://www.mirror.co.uk/news/rss.xml\"},\n  {src:\"The Guardian\",   url:\"https://www.theguardian.com/uk/rss\"},\n  {src:\"The Independent\",url:\"https://www.independent.co.uk/news/rss\"},\n  {src:\"Al Jazeera\",     url:\"https://www.aljazeera.com/xml/rss/all.xml\"},\n  {src:\"Sky News\",       url:\"https://feeds.skynews.com/feeds/rss/home.xml\"},\n  {src:\"BBC\",            url:\"https://feeds.bbci.co.uk/news/rss.xml\"},\n  {src:\"The Sun\",        url:\"https://www.thesun.co.uk/news/feed/\"},\n  {src:\"New York Post\",  url:\"https://nypost.com/feed/\"},\n  {src:\"Daily Express\",  url:\"https://www.express.co.uk/posts/rss/1\"},\n  {src:\"GB News\",        url:\"https://www.gbnews.com/feeds/politics.rss\"},\n  {src:\"Fox News\",       url:\"https://moxie.foxnews.com/google-publisher/latest.xml\"}\n];\nfunction miniBar(pos){return pos==null?'':'<span class=\"mini\"><i style=\"left:'+pos+'%\"></i></span>'}\n\nvar STOP={'this':1,'that':1,'with':1,'from':1,'have':1,'will':1,'after':1,'over':1,'into':1,'says':1,'said':1,'what':1,'when':1,'where':1,'while':1,'been':1,'were':1,'they':1,'their':1,'them':1,'there':1,'about':1,'more':1,'than':1,'against':1,'amid':1,'could':1,'would':1,'should':1,'year':1,'years':1,'week':1,'today':1,'first':1,'last':1,'live':1,'news':1,'your':1,'just':1,'like':1,'make':1,'take':1,'takes':1,'before':1,'being':1,'between':1,'during':1,'under':1,'because':1,'reveals':1,'revealed':1,'still':1,'down':1,'back':1};\nfunction kws(t){return String(t||'').toLowerCase().replace(/[^a-z0-9\\s]/g,' ').split(/\\s+/).filter(function(w){return w.length>3&&!STOP[w]})}\n\nfunction getFeed(url){\n  if(cache[url])return Promise.resolve(cache[url]);\n  return myllmFetch(url,{headers:{Accept:'application/rss+xml,application/atom+xml,application/xml,text/xml'}})\n    .then(function(r){\n      if(!r||!r.ok)throw new Error('feed');\n      var items=parse(r.body);\n      cache[url]=items;\n      return items;\n    });\n}\n\nvar ovlNode=null,covCache={}; // per-story coverage cache: link → {items,summary}\nfunction closeCoverage(){if(ovlNode){ovlNode.parentNode.removeChild(ovlNode);ovlNode=null;document.body.style.overflow=''}}\nfunction openCoverage(a){\n  haptic('selection');\n  closeCoverage();\n  var ovl=document.createElement('div');ovl.id='ovl';ovlNode=ovl;\n  ovl.innerHTML='<div class=\"sheet\" role=\"dialog\" aria-label=\"Coverage across channels\">'+\n    '<div class=\"sh-head\"><div class=\"sh-t\">Across the spectrum</div><button class=\"sh-x\" aria-label=\"Close\">✕</button></div>'+\n    '<div class=\"sh-story\">'+esc(a.title)+'</div>'+\n    '<div class=\"sh-sum\" id=\"shSum\" style=\"display:none\"></div>'+\n    '<div class=\"sh-body\" id=\"shBody\"><div class=\"sh-load\">Checking channels across the spectrum…</div></div></div>';\n  ovl.addEventListener('click',function(e){if(e.target===ovl)closeCoverage()});\n  document.body.appendChild(ovl);\n  ovl.querySelector('.sh-x').onclick=closeCoverage;\n  document.body.style.overflow='hidden';\n  var body=ovl.querySelector('#shBody');\n  var key=a.link||a.title;\n  if(covCache[key]){renderCoverage(a,covCache[key],ovl);return}\n  if(!window.myllmFetch){body.innerHTML='<div class=\"sh-empty\">Network access is off — enable it in Settings → MyLLMos Apps.</div>';return}\n  var cur=(a.src||'').toLowerCase();\n  var panel=SPECTRUM.filter(function(s){var n=s.src.toLowerCase();return !cur||(n.indexOf(cur)===-1&&cur.indexOf(n)===-1)});\n  Promise.all(panel.map(function(s){\n    return getFeed(s.url).then(function(items){return{s:s,items:items}},function(){return null});\n  })).then(function(feeds){\n    if(!ovlNode)return;\n    var want=kws(a.title),matched=[];\n    feeds.forEach(function(f){\n      if(!f)return;\n      var best=null,bestScore=1; // need ≥2 shared keywords to count as the same story\n      f.items.forEach(function(it){\n        var seen={},score=0;\n        kws(it.title+' '+(it.excerpt||'')).forEach(function(w){seen[w]=1});\n        want.forEach(function(w){if(seen[w]){score++;seen[w]=0}});\n        if(score>bestScore){bestScore=score;best=it}\n      });\n      if(best)matched.push({s:f.s,it:best});\n    });\n    matched.sort(function(x,y){return SRC_LEAN[x.s.src].pos-SRC_LEAN[y.s.src].pos}); // left → right\n    covCache[key]={items:matched,summary:null};\n    renderCoverage(a,covCache[key],ovl);\n  });\n}\nfunction renderCoverage(a,entry,ovl){\n  var body=ovl.querySelector('#shBody');\n  if(!entry.items.length){\n    body.innerHTML='<div class=\"sh-empty\">None of the other channels on the panel are carrying this story right now.</div>';\n    return;\n  }\n  body.innerHTML=entry.items.map(function(m){\n    var t=ago(m.it.date);\n    var tmb=m.it.image\n      ?'<span class=\"tmb\"><img loading=\"lazy\" src=\"'+esc(m.it.image)+'\" onerror=\"this.parentNode.innerHTML=\\'📰\\'\"></span>'\n      :'<span class=\"tmb\">📰</span>';\n    return '<a class=\"cvg\" href=\"'+esc(m.it.link||'#')+'\" target=\"_blank\" rel=\"noopener\">'+tmb+\n      '<span class=\"cbody\"><span class=\"cvg-src\">'+miniBar(SRC_LEAN[m.s.src].pos)+'<span>'+esc(m.s.src)+'</span>'+(t?'<span class=\"when\">'+t+'</span>':'')+'</span>'+\n      '<h4>'+esc(m.it.title)+'</h4></span></a>';\n  }).join('');\n  if(entry.summary){showSummary(ovl,entry.summary)}\n  else summarize(a,entry,ovl);\n}\nfunction showSummary(ovl,text){\n  var sum=ovl.querySelector('#shSum');\n  sum.style.display='block';\n  sum.innerHTML='<b>AI summary</b>'+esc(text).replace(/\\n+/g,'<br>');\n}\nfunction summarize(a,entry,ovl){\n  if(!window.myllmAsk)return;\n  var sum=ovl.querySelector('#shSum');\n  sum.style.display='block';\n  sum.innerHTML='<b>AI summary</b><span class=\"sh-wait\">Reading the coverage…</span>';\n  var lines=entry.items.map(function(m){return '- \"'+m.it.title+'\" ('+m.s.src+')'}).join('\\n');\n  var p='Different news channels are covering the same story.\\nOriginal headline: \"'+a.title+'\" ('+(a.src||'')+')\\nOther channels:\\n'+lines+\n        '\\n\\nIn 2-3 short sentences, neutrally summarise the story and note briefly whether the channels frame it differently. Plain text only, no lists, no preamble.';\n  myllmAsk(p).then(function(r){\n    r=String(r||'').trim();\n    if(r)entry.summary=r; // cached with the story\n    if(!ovlNode)return;\n    if(r)showSummary(ovl,r);else sum.style.display='none';\n  }).catch(function(){if(ovlNode)sum.style.display='none'});\n}\n\nfunction paint(){\n  var hero=articles[0];\n  el('hero').innerHTML=hero?(\n    '<a class=\"hero\" href=\"'+esc(hero.link||'#')+'\" target=\"_blank\" rel=\"noopener\">'+\n      thumb(hero)+\n      '<div class=\"body\"><div class=\"meta\">'+metaLine(hero)+'</div>'+\n      '<h2>'+esc(hero.title)+'</h2>'+\n      (hero.excerpt?'<p class=\"excerpt\">'+esc(hero.excerpt)+'</p>':'')+\n      leanBadge(hero)+\n      '</div></a>'\n  ):'';\n  if(hero)wireLean(el('hero'),hero);\n  ogBudget=10;                        // fresh rescue allowance per topic load\n  ogQueue=[];\n  if(hero)rescueImage(hero,el('hero'),loadGen);\n  shown=1;\n  el('grid').innerHTML='';\n  more();\n}\nfunction more(){\n  var slice=articles.slice(shown,shown+PAGE),frag=document.createDocumentFragment();\n  slice.forEach(function(a){\n    var card=document.createElement('a');\n    card.className='card';card.href=a.link||'#';card.target='_blank';card.rel='noopener';\n    card.innerHTML=thumb(a)+'<div class=\"body\"><div class=\"meta\">'+metaLine(a)+'</div><h3>'+esc(a.title)+'</h3>'+leanBadge(a)+'</div>';\n    wireLean(card,a);\n    card.addEventListener('click',function(){haptic('light')});\n    if(!a.image)rescueImage(a,card,loadGen);\n    frag.appendChild(card);\n  });\n  el('grid').appendChild(frag);\n  shown+=slice.length;\n  var b=el('more');\n  if(shown>=articles.length){b.style.display='none'}\n  else{b.style.display='block';b.disabled=false;b.textContent='Load more'}\n}\nel('more').onclick=function(){haptic('selection');more()};\n\n// ===================== Region & perspective =====================\n// Regions swap the sources behind the news-core topics (Top, the local tab,\n// Politics); World and the lifestyle topics keep their global channels. Every\n// listed feed was verified live before shipping. All sources carry SRC_LEAN\n// entries so the perspective dial and the per-card spectrum dots stay honest.\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar REGIONS=[\n  {id:\"uk\",name:\"United Kingdom\",localName:\"UK\"},   // the app's original sources, unchanged\n  {id:\"us\",name:\"United States\",localName:\"US\",\n    top:[{src:\"CNN\",url:\"https://rss.cnn.com/rss/cnn_topstories.rss\"},\n         {src:\"Fox News\",url:\"https://moxie.foxnews.com/google-publisher/latest.xml\"},\n         {src:\"The Hill\",url:\"https://thehill.com/feed/\"},\n         {src:\"NPR\",url:\"https://feeds.npr.org/1001/rss.xml\"}],\n    local:[{src:\"NPR\",url:\"https://feeds.npr.org/1001/rss.xml\"},\n           {src:\"New York Post\",url:\"https://nypost.com/feed/\"},\n           {src:\"The Hill\",url:\"https://thehill.com/feed/\"},\n           {src:\"CNN\",url:\"https://rss.cnn.com/rss/cnn_topstories.rss\"}],\n    politics:[{src:\"Politico\",url:\"https://rss.politico.com/politics-news.xml\"},\n              {src:\"The Hill\",url:\"https://thehill.com/feed/\"},\n              {src:\"Fox News\",url:\"https://moxie.foxnews.com/google-publisher/latest.xml\"},\n              {src:\"CNN\",url:\"https://rss.cnn.com/rss/cnn_topstories.rss\"}],\n    topics:{\n      \"Business\":[{src:\"NPR\",url:\"https://feeds.npr.org/1006/rss.xml\"},\n                  {src:\"New York Post\",url:\"https://nypost.com/business/feed/\"},\n                  {src:\"BBC\",url:\"https://feeds.bbci.co.uk/news/business/rss.xml\"}],\n      \"Technology\":[{src:\"NPR\",url:\"https://feeds.npr.org/1019/rss.xml\"},\n                    {src:\"Fox News\",url:\"https://moxie.foxnews.com/google-publisher/tech.xml\"},\n                    {src:\"Ars Technica\",url:\"https://feeds.arstechnica.com/arstechnica/index\"}],\n      \"Science\":[{src:\"NPR\",url:\"https://feeds.npr.org/1007/rss.xml\"},\n                 {src:\"Fox News\",url:\"https://moxie.foxnews.com/google-publisher/science.xml\"},\n                 {src:\"BBC\",url:\"https://feeds.bbci.co.uk/news/science_and_environment/rss.xml\"}],\n      \"Health\":[{src:\"NPR\",url:\"https://feeds.npr.org/1128/rss.xml\"},\n                {src:\"Fox News\",url:\"https://moxie.foxnews.com/google-publisher/health.xml\"},\n                {src:\"BBC\",url:\"https://feeds.bbci.co.uk/news/health/rss.xml\"}],\n      \"Sport\":[{src:\"New York Post\",url:\"https://nypost.com/sports/feed/\"},\n               {src:\"Fox News\",url:\"https://moxie.foxnews.com/google-publisher/sports.xml\"}],\n      \"Entertainment\":[{src:\"New York Post\",url:\"https://nypost.com/entertainment/feed/\"},\n                       {src:\"Fox News\",url:\"https://moxie.foxnews.com/google-publisher/entertainment.xml\"},\n                       {src:\"The Guardian\",url:\"https://www.theguardian.com/culture/rss\"}]\n    }},\n  {id:\"eu\",name:\"Europe\",localName:\"Europe\",\n    top:[{src:\"France 24\",url:\"https://www.france24.com/en/rss\"},\n         {src:\"DW\",url:\"https://rss.dw.com/rdf/rss-en-all\"},\n         {src:\"Euronews\",url:\"https://www.euronews.com/rss\"},\n         {src:\"The Guardian\",url:\"https://www.theguardian.com/world/europe-news/rss\"}],\n    local:[{src:\"France 24\",url:\"https://www.france24.com/en/rss\"},\n           {src:\"DW\",url:\"https://rss.dw.com/rdf/rss-en-all\"},\n           {src:\"The Guardian\",url:\"https://www.theguardian.com/world/europe-news/rss\"},\n           {src:\"Euronews\",url:\"https://www.euronews.com/rss\"}],\n    politics:[{src:\"Politico Europe\",url:\"https://www.politico.eu/feed/\"},\n              {src:\"France 24\",url:\"https://www.france24.com/en/rss\"},\n              {src:\"DW\",url:\"https://rss.dw.com/rdf/rss-en-all\"}],\n    topics:{\n      \"Business\":[{src:\"DW\",url:\"https://rss.dw.com/rdf/rss-en-bus\"},\n                  {src:\"BBC\",url:\"https://feeds.bbci.co.uk/news/business/rss.xml\"},\n                  {src:\"The Guardian\",url:\"https://www.theguardian.com/uk/business/rss\"}]\n    }},\n  {id:\"jp\",name:\"Japan\",localName:\"Japan\",\n    top:[{src:\"Japan Times\",url:\"https://www.japantimes.co.jp/feed/\"},\n         {src:\"SCMP\",url:\"https://www.scmp.com/rss/91/feed\"},\n         {src:\"Nikkei Asia\",url:\"https://asia.nikkei.com/rss/feed/nar\"},\n         {src:\"NHK\",url:\"https://www3.nhk.or.jp/rss/news/cat0.xml\"}],\n    local:[{src:\"Japan Times\",url:\"https://www.japantimes.co.jp/feed/\"},\n           {src:\"NHK\",url:\"https://www3.nhk.or.jp/rss/news/cat0.xml\"},\n           {src:\"Nikkei Asia\",url:\"https://asia.nikkei.com/rss/feed/nar\"}],\n    topics:{\n      \"Business\":[{src:\"Nikkei Asia\",url:\"https://asia.nikkei.com/rss/feed/nar\"},\n                  {src:\"SCMP\",url:\"https://www.scmp.com/rss/92/feed\"},\n                  {src:\"BBC\",url:\"https://feeds.bbci.co.uk/news/business/rss.xml\"}]\n    }},\n  {id:\"in\",name:\"India\",localName:\"India\",\n    top:[{src:\"The Hindu\",url:\"https://www.thehindu.com/news/national/feeder/default.rss\"},\n         {src:\"Times of India\",url:\"https://timesofindia.indiatimes.com/rssfeedstopstories.cms\"},\n         {src:\"NDTV\",url:\"https://feeds.feedburner.com/ndtvnews-top-stories\"},\n         {src:\"Hindustan Times\",url:\"https://www.hindustantimes.com/feeds/rss/india-news/rssfeed.xml\"}],\n    local:[{src:\"Hindustan Times\",url:\"https://www.hindustantimes.com/feeds/rss/india-news/rssfeed.xml\"},\n           {src:\"The Hindu\",url:\"https://www.thehindu.com/news/national/feeder/default.rss\"},\n           {src:\"NDTV\",url:\"https://feeds.feedburner.com/ndtvnews-top-stories\"}],\n    topics:{\n      \"Business\":[{src:\"NDTV\",url:\"https://feeds.feedburner.com/ndtvprofit-latest\"},\n                  {src:\"The Hindu\",url:\"https://www.thehindu.com/business/feeder/default.rss\"},\n                  {src:\"Times of India\",url:\"https://timesofindia.indiatimes.com/rssfeeds/1898055.cms\"}],\n      \"Sport\":[{src:\"NDTV\",url:\"https://feeds.feedburner.com/ndtvsports-latest\"},\n               {src:\"The Hindu\",url:\"https://www.thehindu.com/sport/feeder/default.rss\"}]\n    }},\n  {id:\"au\",name:\"Australia\",localName:\"Australia\",\n    top:[{src:\"ABC News (AU)\",url:\"https://www.abc.net.au/news/feed/51120/rss.xml\"},\n         {src:\"Sydney Morning Herald\",url:\"https://www.smh.com.au/rss/feed.xml\"},\n         {src:\"Guardian Australia\",url:\"https://www.theguardian.com/australia-news/rss\"}],\n    local:[{src:\"ABC News (AU)\",url:\"https://www.abc.net.au/news/feed/51120/rss.xml\"},\n           {src:\"Sydney Morning Herald\",url:\"https://www.smh.com.au/rss/feed.xml\"},\n           {src:\"Guardian Australia\",url:\"https://www.theguardian.com/australia-news/rss\"}],\n    topics:{\n      \"Business\":[{src:\"Sydney Morning Herald\",url:\"https://www.smh.com.au/rss/business.xml\"},\n                  {src:\"BBC\",url:\"https://feeds.bbci.co.uk/news/business/rss.xml\"}],\n      \"Sport\":[{src:\"Sydney Morning Herald\",url:\"https://www.smh.com.au/rss/sport.xml\"},\n               {src:\"Guardian Australia\",url:\"https://www.theguardian.com/au/sport/rss\"}]\n    }},\n  {id:\"ca\",name:\"Canada\",localName:\"Canada\",\n    top:[{src:\"CBC\",url:\"https://www.cbc.ca/webfeed/rss/rss-topstories\"},\n         {src:\"Global News\",url:\"https://globalnews.ca/feed/\"},\n         {src:\"National Post\",url:\"https://nationalpost.com/feed/\"}],\n    local:[{src:\"CBC\",url:\"https://www.cbc.ca/webfeed/rss/rss-topstories\"},\n           {src:\"Global News\",url:\"https://globalnews.ca/feed/\"},\n           {src:\"National Post\",url:\"https://nationalpost.com/feed/\"}],\n    topics:{\n      \"Business\":[{src:\"CBC\",url:\"https://www.cbc.ca/webfeed/rss/rss-business\"},\n                  {src:\"BBC\",url:\"https://feeds.bbci.co.uk/news/business/rss.xml\"}],\n      \"Technology\":[{src:\"CBC\",url:\"https://www.cbc.ca/webfeed/rss/rss-technology\"},\n                    {src:\"Ars Technica\",url:\"https://feeds.arstechnica.com/arstechnica/index\"}],\n      \"Sport\":[{src:\"CBC\",url:\"https://www.cbc.ca/webfeed/rss/rss-sports\"},\n               {src:\"Global News\",url:\"https://globalnews.ca/sports/feed/\"}],\n      \"Health\":[{src:\"CBC\",url:\"https://www.cbc.ca/webfeed/rss/rss-health\"},\n                {src:\"BBC\",url:\"https://feeds.bbci.co.uk/news/health/rss.xml\"}],\n      \"Entertainment\":[{src:\"CBC\",url:\"https://www.cbc.ca/webfeed/rss/rss-arts\"},\n                       {src:\"The Guardian\",url:\"https://www.theguardian.com/culture/rss\"}]\n    }},\n  {id:\"intl\",name:\"International\",localName:\"World+\",\n    top:[{src:\"BBC\",url:\"https://feeds.bbci.co.uk/news/world/rss.xml\"},\n         {src:\"Al Jazeera\",url:\"https://www.aljazeera.com/xml/rss/all.xml\"},\n         {src:\"France 24\",url:\"https://www.france24.com/en/rss\"},\n         {src:\"SCMP\",url:\"https://www.scmp.com/rss/91/feed\"}],\n    local:[{src:\"DW\",url:\"https://rss.dw.com/rdf/rss-en-all\"},\n           {src:\"Al Jazeera\",url:\"https://www.aljazeera.com/xml/rss/all.xml\"},\n           {src:\"France 24\",url:\"https://www.france24.com/en/rss\"}],\n    topics:{\n      \"Business\":[{src:\"DW\",url:\"https://rss.dw.com/rdf/rss-en-bus\"},\n                  {src:\"SCMP\",url:\"https://www.scmp.com/rss/92/feed\"},\n                  {src:\"BBC\",url:\"https://feeds.bbci.co.uk/news/business/rss.xml\"}]\n    }}\n];\nvar PERSPS=[\n  {id:\"all\",  name:\"Balanced\"},\n  {id:\"left\", name:\"Lean left\"},\n  {id:\"centre\",name:\"Centre\"},\n  {id:\"right\",name:\"Lean right\"}\n];\nvar prefs={region:\"uk\",persp:\"all\"};\nvar BASE_TOPICS=TOPICS;   // keep the originals; effective list derives from them\n\nfunction perspKeeps(srcName){\n  if(prefs.persp===\"all\")return true;\n  var l=SRC_LEAN[srcName];var pos=l?l.pos:50;\n  if(prefs.persp===\"left\")return pos<=55;\n  if(prefs.persp===\"right\")return pos>=45;\n  return pos>=40&&pos<=60;   // centre\n}\nfunction applyPrefs(){\n  var region=null;\n  for(var i=0;i<REGIONS.length;i++)if(REGIONS[i].id===prefs.region)region=REGIONS[i];\n  TOPICS=BASE_TOPICS.map(function(t){\n    var name=t.name,srcs=t.srcs;\n    if(region&&region.top){\n      if(t.name===\"Top\")srcs=region.top;\n      else if(t.name===\"UK\"){name=region.localName;srcs=region.local||region.top}\n      else if(t.name===\"Politics\"&&region.politics)srcs=region.politics;\n      else if(region.topics&&region.topics[t.name])srcs=region.topics[t.name];\n    }\n    // perspective filter — never below 2 channels (falls back to the full mix,\n    // so a lens can thin the blend but can't empty it)\n    var kept=srcs.filter(function(s){return perspKeeps(s.src)});\n    if(kept.length<2)kept=srcs;\n    return {name:name,srcs:kept};\n  });\n  if(active>=TOPICS.length)active=0;\n}\n\nfunction openPrefs(){\n  haptic('selection');\n  renderPrefChips();\n  el('prefs').classList.add('on');\n}\nfunction closePrefs(){\n  el('prefs').classList.remove('on');\n  cache={};                 // fresh sources → fresh wall\n  applyPrefs();\n  buildTabs();\n  load();\n  window.scrollTo(0,0);\n}\nfunction renderPrefChips(){\n  el('regionChips').innerHTML=REGIONS.map(function(r){\n    return '<button class=\"'+(prefs.region===r.id?'on':'')+'\" onclick=\"setRegion(\\''+r.id+'\\')\">'+r.name+'</button>';\n  }).join('');\n  el('perspChips').innerHTML=PERSPS.map(function(p){\n    return '<button class=\"'+(prefs.persp===p.id?'on':'')+'\" onclick=\"setPersp(\\''+p.id+'\\')\">'+p.name+'</button>';\n  }).join('');\n}\nfunction setRegion(id){prefs.region=id;haptic('selection');savePrefs();renderPrefChips()}\nfunction setPersp(id){prefs.persp=id;haptic('selection');savePrefs();renderPrefChips()}\nfunction savePrefs(){store.setItem('hl_prefs',JSON.stringify(prefs))}\n\n// boot: restore prefs, then build the wall\nstore.getItem('hl_prefs').then(function(v){\n  if(v){try{var p=JSON.parse(v);if(p&&p.region)prefs=p}catch(e){}}\n  applyPrefs();\n  buildTabs();\n  load();\n});\n</script>\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\">⚙️</span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n</body>\n</html>\n"}