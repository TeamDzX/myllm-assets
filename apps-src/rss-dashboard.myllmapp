{"name": "Headlines", "kind": "html", "iconSymbol": "square.grid.2x2.fill", "iconColor": "purple", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Headlines</title>\n<style>\n:root{\n  color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7);\n  --surface:var(--myllm-surface,#fff);\n  --text:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#6b6b72);\n  --accent:var(--myllm-accent,#0b5ed7);\n  --border:var(--myllm-border,rgba(120,120,128,.22));\n  --radius:var(--myllm-radius,14px);\n  --font:var(--myllm-font,-apple-system,system-ui,sans-serif);\n}\n@media(prefers-color-scheme:dark){\n  :root{--bg:var(--myllm-bg,#000);--surface:var(--myllm-surface,#1c1c1e);--text:var(--myllm-text,#eee);--muted:var(--myllm-muted,#98989f)}\n}\n*{box-sizing:border-box}\nbody{margin:0;font-family:var(--font);background:var(--bg);color:var(--text);-webkit-text-size-adjust:100%}\n.head{position:sticky;top:0;z-index:10;background:var(--bg);padding:10px 0 0;border-bottom:1px solid var(--border)}\n#tabs{display:flex;gap:6px;overflow-x:auto;padding:0 16px 12px;-webkit-overflow-scrolling:touch;scrollbar-width:none}\n#tabs::-webkit-scrollbar{display:none}\n.tab{flex:none;border:0;padding:8px 14px;border-radius:999px;background:var(--surface);color:var(--muted);font:inherit;font-size:14px;font-weight:600;cursor:pointer;white-space:nowrap;border:1px solid var(--border)}\n.tab.on{background:var(--accent);color:#fff;border-color:transparent}\n#status{padding:40px 24px;text-align:center;color:var(--muted);font-size:15px;line-height:1.5}\n.wrap{padding:14px 16px 28px;max-width:780px;margin:0 auto}\na.card,a.hero{display:block;text-decoration:none;color:inherit;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;-webkit-tap-highlight-color:transparent}\na.hero{margin-bottom:16px}\n.thumb{width:100%;background:linear-gradient(135deg,var(--accent),#7b5cff);position:relative;display:flex;align-items:center;justify-content:center}\n.hero .thumb{aspect-ratio:16/9}\n.card .thumb{aspect-ratio:16/10}\n.thumb img{width:100%;height:100%;object-fit:cover;display:block}\n.thumb .ph{font-size:34px;opacity:.85}\n.body{position:relative;padding:13px 15px 26px}\n.lean{position:absolute;right:14px;bottom:12px;width:36px;height:4px;border-radius:2px;background:linear-gradient(90deg,#3b6fd4,#8e8e93 50%,#c0392b);opacity:.85;cursor:pointer}\n.lean::before{content:'';position:absolute;inset:-14px -12px} /* enlarged tap target */\n.lean i{position:absolute;top:50%;transform:translate(-50%,-50%);width:9px;height:9px;border-radius:50%;background:var(--surface);border:2px solid var(--text)}\n#ovl{position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.45);display:flex;align-items:flex-end;justify-content:center}\n.sheet{background:var(--bg);width:100%;max-width:640px;max-height:82vh;border-radius:18px 18px 0 0;display:flex;flex-direction:column;overflow:hidden;padding-bottom:env(safe-area-inset-bottom)}\n.sh-head{display:flex;align-items:center;justify-content:space-between;padding:14px 16px 10px}\n.sh-t{font-size:17px;font-weight:700}\n.sh-x{border:0;background:var(--surface);color:var(--muted);width:30px;height:30px;border-radius:50%;font-size:15px;cursor:pointer;border:1px solid var(--border)}\n.sh-story{padding:0 16px 10px;font-size:13px;color:var(--muted);line-height:1.4}\n.sh-sum{margin:0 16px 12px;padding:12px 14px;background:var(--surface);border:1px solid var(--border);border-radius:12px;font-size:14px;line-height:1.5}\n.sh-sum b{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--accent);margin-bottom:5px}\n.sh-sum .sh-wait{color:var(--muted);font-size:13px}\n.sh-body{overflow-y:auto;padding:0 16px 20px;-webkit-overflow-scrolling:touch}\n.sh-load,.sh-empty{padding:26px 0;text-align:center;color:var(--muted);font-size:14px;line-height:1.5}\na.cvg{display:flex;gap:11px;align-items:center;text-decoration:none;color:inherit;background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:10px;margin-bottom:9px}\n.cvg .tmb{flex:none;width:62px;height:62px;border-radius:9px;overflow:hidden;background:linear-gradient(135deg,var(--accent),#7b5cff);display:flex;align-items:center;justify-content:center;font-size:22px}\n.cvg .tmb img{width:100%;height:100%;object-fit:cover;display:block}\n.cvg .cbody{display:block;min-width:0}\n.cvg-src{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.02em;color:var(--accent);margin-bottom:4px}\n.cvg-src .when{font-weight:600;color:var(--muted);text-transform:none;letter-spacing:0;margin-left:auto}\n.cvg h4{margin:0;font-size:14px;line-height:1.4;font-weight:600}\n.mini{position:relative;width:26px;height:3px;border-radius:2px;background:linear-gradient(90deg,#3b6fd4,#8e8e93 50%,#c0392b);flex:none}\n.mini i{position:absolute;top:50%;transform:translate(-50%,-50%);width:7px;height:7px;border-radius:50%;background:var(--surface);border:1.5px solid var(--text)}\n.hero .body h2{font-size:20px;line-height:1.3;margin:0 0 8px;font-weight:700}\n.hero .excerpt{font-size:14px;line-height:1.5;color:var(--muted);margin:0}\n.card .body h3{font-size:16px;line-height:1.35;margin:0;font-weight:600}\n.meta{font-size:12px;font-weight:600;letter-spacing:.02em;color:var(--accent);margin-bottom:7px;text-transform:uppercase}\n.card .meta{margin-bottom:6px}\n#grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px}\n#more{display:block;margin:22px auto 0;padding:11px 22px;background:var(--accent);color:#fff;border:0;border-radius:10px;font:inherit;font-size:15px;font-weight:600;cursor:pointer}\n#more[disabled]{opacity:.5}\n@media(prefers-reduced-motion:no-preference){a.card,a.hero{transition:transform .12s ease}a.card:active,a.hero:active{transform:scale(.985)}}\n</style>\n</head>\n<body>\n\n<div class=\"head\">\n  <div id=\"tabs\"></div>\n</div>\n\n<div id=\"status\"></div>\n<div class=\"wrap\">\n  <div id=\"hero\"></div>\n  <div id=\"grid\"></div>\n  <button id=\"more\" style=\"display:none\">Load more</button>\n</div>\n\n<script>\nvar TOPICS=[\n  {name:\"Top\",          src:\"BBC\",          url:\"https://feeds.bbci.co.uk/news/rss.xml\"},\n  {name:\"World\",        src:\"BBC\",          url:\"https://feeds.bbci.co.uk/news/world/rss.xml\"},\n  {name:\"UK\",           src:\"BBC\",          url:\"https://feeds.bbci.co.uk/news/uk/rss.xml\"},\n  {name:\"Business\",     src:\"BBC\",          url:\"https://feeds.bbci.co.uk/news/business/rss.xml\"},\n  {name:\"Technology\",   src:\"Ars Technica\", url:\"https://feeds.arstechnica.com/arstechnica/index\"},\n  {name:\"Science\",      src:\"BBC\",          url:\"https://feeds.bbci.co.uk/news/science_and_environment/rss.xml\"},\n  {name:\"Health\",       src:\"BBC\",          url:\"https://feeds.bbci.co.uk/news/health/rss.xml\"},\n  {name:\"Politics\",     src:\"BBC\",          url:\"https://feeds.bbci.co.uk/news/politics/rss.xml\"},\n  {name:\"Entertainment\",src:\"BBC\",          url:\"https://feeds.bbci.co.uk/news/entertainment_and_arts/rss.xml\"},\n  {name:\"Sport\",        src:\"BBC\",          url:\"https://feeds.bbci.co.uk/sport/rss.xml\"},\n  {name:\"Environment\",  src:\"The Guardian\", url:\"https://www.theguardian.com/environment/rss\"},\n  {name:\"Football\",     src:\"The Guardian\", url:\"https://www.theguardian.com/football/rss\"},\n  {name:\"Film\",         src:\"The Guardian\", url:\"https://www.theguardian.com/film/rss\"},\n  {name:\"Music\",        src:\"The Guardian\", url:\"https://www.theguardian.com/music/rss\"},\n  {name:\"Games\",        src:\"The Guardian\", url:\"https://www.theguardian.com/games/rss\"},\n  {name:\"Food\",         src:\"The Guardian\", url:\"https://www.theguardian.com/food/rss\"},\n  {name:\"Travel\",       src:\"The Guardian\", url:\"https://www.theguardian.com/travel/rss\"},\n  {name:\"Books\",        src:\"The Guardian\", url:\"https://www.theguardian.com/books/rss\"}\n];\n\nvar PAGE=8, active=0, shown=0, articles=[], cache={};\nfunction el(i){return document.getElementById(i)}\nfunction setStatus(t){var s=el('status');s.style.display=t?'block':'none';s.textContent=t||''}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\n\nfunction buildTabs(){\n  var T=el('tabs');T.innerHTML='';\n  TOPICS.forEach(function(t,i){\n    var b=document.createElement('button');\n    b.className='tab'+(i===active?' on':'');\n    b.textContent=t.name;\n    b.onclick=function(){\n      haptic('selection');\n      if(i===active){delete cache[TOPICS[i].url]} // tap active tab to refresh\n      active=i;\n      buildTabs();\n      load();\n      window.scrollTo(0,0);\n    };\n    T.appendChild(b);\n  });\n}\n\nfunction load(){\n  var t=TOPICS[active];\n  el('hero').innerHTML='';el('grid').innerHTML='';el('more').style.display='none';\n  shown=0;\n  if(cache[t.url]){articles=cache[t.url];setStatus('');paint();return}\n  if(!window.myllmFetch){setStatus('Headlines needs network access — update MyLLM and turn on “Allow apps to use the network” in Settings → MyLLMos Apps.');return}\n  setStatus('Loading '+t.name+'…');\n  myllmFetch(t.url,{headers:{Accept:'application/rss+xml,application/atom+xml,application/xml,text/xml'}})\n    .then(function(r){\n      if(!r||!r.ok)throw new Error('feed returned '+((r&&r.status)||'no response'));\n      var items=parse(r.body);\n      if(!items.length)throw new Error('no stories found');\n      articles=items;cache[t.url]=items;setStatus('');paint();\n    })\n    .catch(function(e){setStatus('Couldn’t load '+t.name+': '+e.message+'\\nTap the topic again to retry.')});\n}\n\nfunction parse(xml){\n  var doc=new DOMParser().parseFromString(xml,'text/xml');\n  var nodes=doc.getElementsByTagName('item');\n  var atom=false;\n  if(!nodes.length){nodes=doc.getElementsByTagName('entry');atom=true}\n  var out=[];\n  for(var i=0;i<nodes.length;i++){\n    var n=nodes[i];\n    var title=text(n,'title');\n    if(!title)continue;\n    var link=text(n,'link');\n    if(atom||!link){\n      var ls=n.getElementsByTagName('link');\n      for(var k=0;k<ls.length;k++){var h=ls[k].getAttribute('href');if(h){link=h;if((ls[k].getAttribute('rel')||'alternate')==='alternate')break}}\n    }\n    var desc=text(n,'description')||text(n,'summary')||text(n,'content');\n    out.push({\n      title:title,\n      link:link,\n      date:text(n,'pubDate')||text(n,'updated')||text(n,'published')||text(n,'date'),\n      excerpt:strip(desc),\n      image:imageOf(n,desc)\n    });\n  }\n  return out;\n}\n\nfunction text(node,tag){var e=node.getElementsByTagName(tag)[0];return e?e.textContent.trim():''}\n\n// Pull the best image: media:content/thumbnail (largest), then enclosure,\n// then the first <img> embedded in the description HTML.\nfunction imageOf(node,descHtml){\n  var best=null,bestW=-1;\n  function consider(url,w,type){\n    if(!url)return;\n    if(type&&type.indexOf('image')===-1&&type!=='image'&&!/\\.(jpe?g|png|webp|gif)(\\?|$)/i.test(url))return;\n    w=parseInt(w)||0;\n    if(w>bestW){best=url;bestW=w}\n  }\n  ['media:content','media:thumbnail'].forEach(function(tag){\n    var els=node.getElementsByTagName(tag);\n    for(var i=0;i<els.length;i++)consider(els[i].getAttribute('url'),els[i].getAttribute('width'),els[i].getAttribute('type')||els[i].getAttribute('medium'));\n  });\n  if(!best){\n    var enc=node.getElementsByTagName('enclosure');\n    for(var j=0;j<enc.length;j++)consider(enc[j].getAttribute('url'),enc[j].getAttribute('width'),enc[j].getAttribute('type'));\n  }\n  if(!best&&descHtml){var m=descHtml.match(/<img[^>]+src=[\"']([^\"']+)[\"']/i);if(m)best=m[1]}\n  return best;\n}\n\nfunction strip(html){\n  if(!html)return'';\n  var d=document.createElement('div');d.innerHTML=html;\n  var t=(d.textContent||'').replace(/\\s+/g,' ').trim();\n  return t.length>200?t.slice(0,200)+'…':t;\n}\nfunction ago(d){\n  if(!d)return'';var t=new Date(d);if(isNaN(t))return'';\n  var s=Math.round((Date.now()-t)/1000);\n  if(s<60)return'just now';\n  if(s<3600)return Math.round(s/60)+'m ago';\n  if(s<86400)return Math.round(s/3600)+'h ago';\n  return Math.round(s/86400)+'d ago';\n}\nfunction esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;')}\nfunction thumb(a){\n  if(a.image)return '<div class=\"thumb\"><img loading=\"lazy\" src=\"'+esc(a.image)+'\" onerror=\"this.style.display=\\'none\\';this.parentNode.innerHTML=\\'<span class=&quot;ph&quot;>🗞️</span>\\'\"></div>';\n  return '<div class=\"thumb\"><span class=\"ph\">🗞️</span></div>';\n}\nfunction metaLine(a){var src=TOPICS[active].src,t=ago(a.date);return esc(src)+(t?' • '+t:'')}\n\n// Political lean of the outlet (per AllSides/MBFC-style source ratings),\n// shown as a dot on a left–right spectrum bar. 0 = left, 100 = right.\nvar LEAN={\"BBC\":{pos:50,label:\"Centre\"},\"The Guardian\":{pos:28,label:\"Left-leaning\"},\"Ars Technica\":{pos:40,label:\"Centre-left\"}};\nfunction leanBadge(){\n  var l=LEAN[TOPICS[active].src];\n  if(!l)return'';\n  var t='Political lean: '+l.label+'. Tap to compare coverage on other channels.';\n  return '<span class=\"lean\" role=\"button\" tabindex=\"0\" title=\"'+t+'\" aria-label=\"'+t+'\"><i style=\"left:'+l.pos+'%\"></i></span>';\n}\nfunction wireLean(root,article){\n  var b=root.querySelector('.lean');\n  if(b)b.onclick=function(e){e.preventDefault();e.stopPropagation();openCoverage(article)};\n}\n\n// Fixed panel of channels across the spectrum (left → right). Each entry's own\n// RSS feed supplies the story match AND its thumbnail. Feeds land in the shared\n// session `cache` (per-feed cache); matched results are cached per story below.\nvar SPECTRUM=[\n  {src:\"Daily Mirror\",   pos:28,url:\"https://www.mirror.co.uk/news/rss.xml\"},\n  {src:\"The Guardian\",   pos:28,url:\"https://www.theguardian.com/uk/rss\"},\n  {src:\"The Independent\",pos:30,url:\"https://www.independent.co.uk/news/rss\"},\n  {src:\"Al Jazeera\",     pos:40,url:\"https://www.aljazeera.com/xml/rss/all.xml\"},\n  {src:\"Sky News\",       pos:48,url:\"https://feeds.skynews.com/feeds/rss/home.xml\"},\n  {src:\"BBC\",            pos:50,url:\"https://feeds.bbci.co.uk/news/rss.xml\"},\n  {src:\"The Sun\",        pos:70,url:\"https://www.thesun.co.uk/news/feed/\"},\n  {src:\"New York Post\",  pos:70,url:\"https://nypost.com/feed/\"},\n  {src:\"Daily Express\",  pos:72,url:\"https://www.express.co.uk/posts/rss/1\"},\n  {src:\"GB News\",        pos:75,url:\"https://www.gbnews.com/feeds/politics.rss\"},\n  {src:\"Fox News\",       pos:78,url:\"https://moxie.foxnews.com/google-publisher/latest.xml\"}\n];\nfunction miniBar(pos){return pos==null?'':'<span class=\"mini\"><i style=\"left:'+pos+'%\"></i></span>'}\n\nvar STOP={'this':1,'that':1,'with':1,'from':1,'have':1,'will':1,'after':1,'over':1,'into':1,'says':1,'said':1,'what':1,'when':1,'where':1,'while':1,'been':1,'were':1,'they':1,'their':1,'them':1,'there':1,'about':1,'more':1,'than':1,'against':1,'amid':1,'could':1,'would':1,'should':1,'year':1,'years':1,'week':1,'today':1,'first':1,'last':1,'live':1,'news':1,'your':1,'just':1,'like':1,'make':1,'take':1,'takes':1,'before':1,'being':1,'between':1,'during':1,'under':1,'because':1,'reveals':1,'revealed':1,'still':1,'down':1,'back':1};\nfunction kws(t){return String(t||'').toLowerCase().replace(/[^a-z0-9\\s]/g,' ').split(/\\s+/).filter(function(w){return w.length>3&&!STOP[w]})}\n\nfunction getFeed(url){\n  if(cache[url])return Promise.resolve(cache[url]);\n  return myllmFetch(url,{headers:{Accept:'application/rss+xml,application/atom+xml,application/xml,text/xml'}})\n    .then(function(r){\n      if(!r||!r.ok)throw new Error('feed');\n      var items=parse(r.body);\n      cache[url]=items;\n      return items;\n    });\n}\n\nvar ovlNode=null,covCache={}; // per-story coverage cache: link → {items,summary}\nfunction closeCoverage(){if(ovlNode){ovlNode.parentNode.removeChild(ovlNode);ovlNode=null;document.body.style.overflow=''}}\nfunction openCoverage(a){\n  haptic('selection');\n  closeCoverage();\n  var ovl=document.createElement('div');ovl.id='ovl';ovlNode=ovl;\n  ovl.innerHTML='<div class=\"sheet\" role=\"dialog\" aria-label=\"Coverage across channels\">'+\n    '<div class=\"sh-head\"><div class=\"sh-t\">Across the spectrum</div><button class=\"sh-x\" aria-label=\"Close\">✕</button></div>'+\n    '<div class=\"sh-story\">'+esc(a.title)+'</div>'+\n    '<div class=\"sh-sum\" id=\"shSum\" style=\"display:none\"></div>'+\n    '<div class=\"sh-body\" id=\"shBody\"><div class=\"sh-load\">Checking channels across the spectrum…</div></div></div>';\n  ovl.addEventListener('click',function(e){if(e.target===ovl)closeCoverage()});\n  document.body.appendChild(ovl);\n  ovl.querySelector('.sh-x').onclick=closeCoverage;\n  document.body.style.overflow='hidden';\n  var body=ovl.querySelector('#shBody');\n  var key=a.link||a.title;\n  if(covCache[key]){renderCoverage(a,covCache[key],ovl);return}\n  if(!window.myllmFetch){body.innerHTML='<div class=\"sh-empty\">Network access is off — enable it in Settings → MyLLMos Apps.</div>';return}\n  var cur=TOPICS[active].src.toLowerCase();\n  var panel=SPECTRUM.filter(function(s){var n=s.src.toLowerCase();return n.indexOf(cur)===-1&&cur.indexOf(n)===-1});\n  Promise.all(panel.map(function(s){\n    return getFeed(s.url).then(function(items){return{s:s,items:items}},function(){return null});\n  })).then(function(feeds){\n    if(!ovlNode)return;\n    var want=kws(a.title),matched=[];\n    feeds.forEach(function(f){\n      if(!f)return;\n      var best=null,bestScore=1; // need ≥2 shared keywords to count as the same story\n      f.items.forEach(function(it){\n        var seen={},score=0;\n        kws(it.title+' '+(it.excerpt||'')).forEach(function(w){seen[w]=1});\n        want.forEach(function(w){if(seen[w]){score++;seen[w]=0}});\n        if(score>bestScore){bestScore=score;best=it}\n      });\n      if(best)matched.push({s:f.s,it:best});\n    });\n    matched.sort(function(x,y){return x.s.pos-y.s.pos}); // left → right\n    covCache[key]={items:matched,summary:null};\n    renderCoverage(a,covCache[key],ovl);\n  });\n}\nfunction renderCoverage(a,entry,ovl){\n  var body=ovl.querySelector('#shBody');\n  if(!entry.items.length){\n    body.innerHTML='<div class=\"sh-empty\">None of the other channels on the panel are carrying this story right now.</div>';\n    return;\n  }\n  body.innerHTML=entry.items.map(function(m){\n    var t=ago(m.it.date);\n    var tmb=m.it.image\n      ?'<span class=\"tmb\"><img loading=\"lazy\" src=\"'+esc(m.it.image)+'\" onerror=\"this.parentNode.innerHTML=\\'📰\\'\"></span>'\n      :'<span class=\"tmb\">📰</span>';\n    return '<a class=\"cvg\" href=\"'+esc(m.it.link||'#')+'\" target=\"_blank\" rel=\"noopener\">'+tmb+\n      '<span class=\"cbody\"><span class=\"cvg-src\">'+miniBar(m.s.pos)+'<span>'+esc(m.s.src)+'</span>'+(t?'<span class=\"when\">'+t+'</span>':'')+'</span>'+\n      '<h4>'+esc(m.it.title)+'</h4></span></a>';\n  }).join('');\n  if(entry.summary){showSummary(ovl,entry.summary)}\n  else summarize(a,entry,ovl);\n}\nfunction showSummary(ovl,text){\n  var sum=ovl.querySelector('#shSum');\n  sum.style.display='block';\n  sum.innerHTML='<b>AI summary</b>'+esc(text).replace(/\\n+/g,'<br>');\n}\nfunction summarize(a,entry,ovl){\n  if(!window.myllmAsk)return;\n  var sum=ovl.querySelector('#shSum');\n  sum.style.display='block';\n  sum.innerHTML='<b>AI summary</b><span class=\"sh-wait\">Reading the coverage…</span>';\n  var lines=entry.items.map(function(m){return '- \"'+m.it.title+'\" ('+m.s.src+')'}).join('\\n');\n  var p='Different news channels are covering the same story.\\nOriginal headline: \"'+a.title+'\" ('+TOPICS[active].src+')\\nOther channels:\\n'+lines+\n        '\\n\\nIn 2-3 short sentences, neutrally summarise the story and note briefly whether the channels frame it differently. Plain text only, no lists, no preamble.';\n  myllmAsk(p).then(function(r){\n    r=String(r||'').trim();\n    if(r)entry.summary=r; // cached with the story\n    if(!ovlNode)return;\n    if(r)showSummary(ovl,r);else sum.style.display='none';\n  }).catch(function(){if(ovlNode)sum.style.display='none'});\n}\n\nfunction paint(){\n  var hero=articles[0];\n  el('hero').innerHTML=hero?(\n    '<a class=\"hero\" href=\"'+esc(hero.link||'#')+'\" target=\"_blank\" rel=\"noopener\">'+\n      thumb(hero)+\n      '<div class=\"body\"><div class=\"meta\">'+metaLine(hero)+'</div>'+\n      '<h2>'+esc(hero.title)+'</h2>'+\n      (hero.excerpt?'<p class=\"excerpt\">'+esc(hero.excerpt)+'</p>':'')+\n      leanBadge()+\n      '</div></a>'\n  ):'';\n  if(hero)wireLean(el('hero'),hero);\n  shown=1;\n  el('grid').innerHTML='';\n  more();\n}\nfunction more(){\n  var slice=articles.slice(shown,shown+PAGE),frag=document.createDocumentFragment();\n  slice.forEach(function(a){\n    var card=document.createElement('a');\n    card.className='card';card.href=a.link||'#';card.target='_blank';card.rel='noopener';\n    card.innerHTML=thumb(a)+'<div class=\"body\"><div class=\"meta\">'+metaLine(a)+'</div><h3>'+esc(a.title)+'</h3>'+leanBadge()+'</div>';\n    wireLean(card,a);\n    card.addEventListener('click',function(){haptic('light')});\n    frag.appendChild(card);\n  });\n  el('grid').appendChild(frag);\n  shown+=slice.length;\n  var b=el('more');\n  if(shown>=articles.length){b.style.display='none'}\n  else{b.style.display='block';b.disabled=false;b.textContent='Load more'}\n}\nel('more').onclick=function(){haptic('selection');more()};\n\nbuildTabs();\nload();\n</script>\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\">⚙️</span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n</body>\n</html>\n"}