{"name": "Day Out Planner", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>:root{color-scheme:light dark}\n*{box-sizing:border-box}\nbody{font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);margin:0;padding:16px;background:var(--myllm-bg,#f2f2f7);color:var(--myllm-text,#111)}\nh1{font-size:22px;margin:0 0 2px}\n.sub{font-size:13px;color:var(--myllm-muted,#8a8a8e);margin:0 0 14px}\n.row{display:flex;gap:8px;margin-bottom:10px}\ninput{flex:1;padding:12px;border:1px solid var(--myllm-border,#d1d1d6);border-radius:12px;font-size:16px;background:var(--myllm-surface,#fff);color:var(--myllm-text,#111)}\nbutton.go{border:0;background:var(--myllm-accent,#0a84ff);color:#fff;border-radius:12px;padding:0 18px;font-size:15px;font-weight:700}\n.chips{display:flex;gap:8px;overflow-x:auto;padding-bottom:6px;margin-bottom:6px;-webkit-overflow-scrolling:touch}\n.chip{flex:0 0 auto;background:var(--myllm-surface,#fff);border:1px solid var(--myllm-border,#d1d1d6);color:var(--myllm-text,#111);border-radius:999px;padding:8px 13px;font-size:14px}\n.step{background:var(--myllm-surface,#fff);border-radius:14px;padding:12px 14px;margin-bottom:10px;display:flex;gap:12px;align-items:flex-start}\n.step .n{width:26px;height:26px;border-radius:50%;background:var(--myllm-accent,#0a84ff);color:#fff;font-weight:700;font-size:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px}\n.step .body{flex:1}\n.step .name{font-size:16px;font-weight:600}\n.step .meta{font-size:13px;color:var(--myllm-muted,#8a8a8e);margin:2px 0 8px}\n.step .dist{color:var(--myllm-accent,#0a84ff);font-weight:600}\n.step a{font-size:13px;font-weight:600;text-decoration:none;background:rgba(10,132,255,.12);color:var(--myllm-accent,#0a84ff);border-radius:9px;padding:6px 11px;display:inline-block}\n.note{text-align:center;color:var(--myllm-muted,#8a8a8e);font-size:14px;margin-top:20px;line-height:1.5;padding:0 8px}\n@media(min-width:768px){body{max-width:780px;margin-left:auto;margin-right:auto}}\n</style></head><body>\n<h1>🗺 Day Out Planner</h1>\n<p class=\"sub\" id=\"here\">Finding your location…</p>\n<div class=\"chips\" id=\"chips\"></div>\n<div class=\"row\"><input id=\"vibe\" placeholder=\"A vibe… e.g. rainy day with kids\"><button class=\"go\" onclick=\"plan()\">Plan</button></div>\n<div id=\"out\"></div>\n\n<script>\nvar LOC = window.myllmLocation || null;\nvar ASK = window.myllmAsk || null;\nvar haptic = window.myllmHaptic || function(){};\nvar here = null;\nvar IDEAS = [\"rainy day with kids\",\"date night\",\"lazy Sunday\",\"tourist for a day\",\"active outdoors\",\"foodie crawl\"];\n\nfunction el(id){return document.getElementById(id)}\nfunction dist(m){ if(m==null)return \"\"; return m<1000?Math.round(m)+\" m\":(m/1000).toFixed(m<10000?1:0)+\" km\"; }\n\nfunction emojiFor(q){\n  q=q.toLowerCase();\n  var map=[[\"coffee\",\"☕\"],[\"cafe\",\"☕\"],[\"breakfast\",\"🥐\"],[\"brunch\",\"🥞\"],[\"restaurant\",\"🍽\"],[\"pizza\",\"🍕\"],\n    [\"bar\",\"🍺\"],[\"pub\",\"🍺\"],[\"park\",\"🌳\"],[\"museum\",\"🏛\"],[\"gallery\",\"🖼\"],[\"cinema\",\"🎬\"],[\"movie\",\"🎬\"],\n    [\"beach\",\"🏖\"],[\"shop\",\"🛍\"],[\"book\",\"📚\"],[\"ice cream\",\"🍦\"],[\"dessert\",\"🍰\"],[\"garden\",\"🌷\"],\n    [\"playground\",\"🛝\"],[\"zoo\",\"🦁\"],[\"aquarium\",\"🐠\"],[\"bowling\",\"🎳\"],[\"gym\",\"💪\"],[\"viewpoint\",\"🌄\"]];\n  for(var i=0;i<map.length;i++){ if(q.indexOf(map[i][0])>=0) return map[i][1]; }\n  return \"📍\";\n}\n\nfunction chips(){\n  var c=el(\"chips\");\n  IDEAS.forEach(function(v){\n    var b=document.createElement(\"button\");b.className=\"chip\";b.textContent=v;\n    b.onclick=function(){haptic(\"selection\");el(\"vibe\").value=v;plan()};\n    c.appendChild(b);\n  });\n}\n\n/* Labelled lines, not JSON — small models (Apple Intelligence) echo JSON\n   templates back verbatim. Echoed instructions are rejected and retried. */\nvar ECHO=/place search query|repeat this line|labelled line|visiting order|apple-maps style/i;\nfunction parseQueries(text){\n  var out=[],got=false;\n  String(text||\"\").split(/\\r?\\n/).forEach(function(raw){\n    var ln=raw.replace(/\\*\\*/g,\"\").trim();\n    var m=ln.match(/^[-*#>\\s]*(QUERY|QUERIES|STOP)\\s*\\d*\\s*[:：]\\s*(.*)$/i);\n    if(!m)return;\n    got=true;var v=m[2].trim();\n    if(v)out.push(v);\n  });\n  if(!got){ // model answered in the old JSON-array shape — accept it\n    try{\n      var s=text.indexOf(\"[\"), e=text.lastIndexOf(\"]\");\n      if(s>=0&&e>s){ var arr=JSON.parse(text.slice(s,e+1)); if(Array.isArray(arr)) out=arr.map(String); }\n    }catch(err){}\n  }\n  out=out.filter(function(x){return x&&!ECHO.test(x)});\n  if(out.length<2) throw new Error(\"no usable plan\");\n  return out.slice(0,6);\n}\n\nfunction plan(){\n  var vibe=el(\"vibe\").value.trim();\n  if(!vibe) return;\n  if(!LOC){ el(\"out\").innerHTML='<p class=\"note\">This needs the latest MyLLM with <b>Allow apps to use your location</b> on.</p>'; return; }\n  haptic(\"light\");\n  el(\"out\").innerHTML='<p class=\"note\">Planning your day…</p>';\n\n  getQueries(vibe).then(function(queries){\n    if(!queries||!queries.length){ el(\"out\").innerHTML='<p class=\"note\">Couldn’t plan that one — try another vibe.</p>'; return; }\n    // Resolve each step to its nearest real place, in order.\n    var jobs=queries.map(function(q){\n      return LOC.search(q,{limit:1}).then(function(list){\n        var p=(list&&list[0])||null; return p?{q:q,place:p}:null;\n      }).catch(function(){return null});\n    });\n    Promise.all(jobs).then(function(steps){\n      steps=steps.filter(Boolean);\n      if(!steps.length){ el(\"out\").innerHTML='<p class=\"note\">No matching places nearby for that idea.</p>'; return; }\n      render(steps);\n    });\n  });\n}\n\nfunction getQueries(vibe){\n  if(!ASK){\n    return Promise.resolve(presets(vibe));\n  }\n  var prompt='Plan a short local outing for this vibe: \"'+vibe+'\". Reply with EXACTLY these labelled lines and nothing else:\\n'+\n    'QUERY: one short place search query, Apple-Maps style — repeat this line for each stop (3 to 5 stops, in a sensible visiting order)';\n  var sys={system:\"You plan short local outings as a list of place search queries.\"};\n  return ASK(prompt,sys)\n    .then(function(reply){ return parseQueries(reply||\"\"); })\n    .catch(function(){\n      return ASK(prompt+'\\nIMPORTANT: fill each labelled line with real content — never repeat the instruction text.',sys)\n        .then(function(reply){ return parseQueries(reply||\"\"); });\n    })\n    .catch(function(){ return presets(vibe); });\n}\n\nfunction presets(vibe){\n  vibe=vibe.toLowerCase();\n  if(vibe.indexOf(\"kid\")>=0) return [\"cafe\",\"playground\",\"family restaurant\",\"ice cream\"];\n  if(vibe.indexOf(\"date\")>=0||vibe.indexOf(\"romantic\")>=0) return [\"coffee shop\",\"park\",\"restaurant\",\"bar\"];\n  if(vibe.indexOf(\"outdoor\")>=0||vibe.indexOf(\"active\")>=0) return [\"park\",\"viewpoint\",\"cafe\"];\n  if(vibe.indexOf(\"food\")>=0) return [\"bakery\",\"restaurant\",\"dessert\",\"bar\"];\n  return [\"coffee shop\",\"park\",\"restaurant\",\"museum\"];\n}\n\nfunction render(steps){\n  var O=el(\"out\");O.innerHTML=\"\";\n  var share=[];\n  steps.forEach(function(st,i){\n    var p=st.place, dest=p.latitude+\",\"+p.longitude;\n    var d=document.createElement(\"div\");d.className=\"step\";\n    d.innerHTML='<div class=\"n\">'+(i+1)+'</div><div class=\"body\">'+\n      '<div class=\"name\">'+emojiFor(st.q)+' </div>'+\n      '<div class=\"meta\"><span class=\"dist\">'+dist(p.distance)+'</span> · </div>'+\n      '<a href=\"https://maps.apple.com/?daddr='+dest+'\">Directions</a></div>';\n    d.querySelector(\".name\").appendChild(document.createTextNode(p.name));\n    d.querySelector(\".meta\").appendChild(document.createTextNode(p.address||st.q));\n    O.appendChild(d);\n    share.push((i+1)+\". \"+p.name+(p.address?\" (\"+p.address+\")\":\"\"));\n  });\n  if(window.myllmShare){\n    var sb=document.createElement(\"button\");sb.className=\"go\";sb.style.width=\"100%\";sb.style.padding=\"12px\";sb.textContent=\"Share this plan\";\n    sb.onclick=function(){haptic(\"light\");myllmShare(\"My day out:\\n\"+share.join(\"\\n\"))};\n    O.appendChild(sb);\n  }\n}\n\nfunction start(){\n  chips();\n  if(!LOC){\n    el(\"here\").textContent=\"Location unavailable\";\n    el(\"out\").innerHTML='<p class=\"note\">This needs the latest MyLLM with <b>Settings → Allow apps to use your location</b> on (and <b>Allow apps to use the AI</b> for smarter plans).</p>';\n    return;\n  }\n  el(\"out\").innerHTML='<p class=\"note\">Pick a vibe or type your own, and I’ll build a route from places around you.</p>';\n  LOC.current().then(function(p){\n    here=p; el(\"here\").textContent=p.address?(\"Around \"+p.address):\"Got your location\";\n  }).catch(function(e){\n    el(\"here\").textContent=\"Location off\";\n    el(\"out\").innerHTML='<p class=\"note\">'+(e&&e.message?e.message:\"Couldn’t get your location\")+'<br>Turn on <b>Settings → Allow apps to use your location</b>, then reopen.</p>';\n  });\n}\nstart();\n</script></body></html>\n"}