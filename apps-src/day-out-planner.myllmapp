{"name": "Day Out Planner", "html": "<!doctype html>\n<!--\n  Day Out Planner — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Day Out Planner</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"f3fb5b3cfc\";color-scheme:light dark; --h:26;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:760px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.96); }\n  a{ color:inherit; }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 28%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  .head .acts{ display:flex; gap:8px; flex-shrink:0; }\n  .head .acts button{ min-width:40px; height:40px; border-radius:12px; border:1px solid var(--line); background:var(--surface);\n    display:flex; align-items:center; justify-content:center; gap:6px; padding:0 10px; font-size:13.5px; font-weight:650; }\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:20px 2px 10px; display:flex; align-items:center; gap:6px; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  label{ display:block; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:14px 2px 7px; }\n  label:first-child{ margin-top:0; }\n  input{ width:100%; font:inherit; font-size:16px; padding:12px; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; }\n  input:focus{ border-color:var(--acc); }\n  .field{ position:relative; } .field svg.i{ position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--muted); font-size:15px; pointer-events:none; }\n  .field input{ padding-left:38px; }\n  .inrow{ display:flex; gap:8px; } .inrow input{ flex:1; min-width:0; }\n  .chips{ display:flex; gap:7px; overflow-x:auto; -webkit-overflow-scrolling:touch; scrollbar-width:none; margin:10px -14px 0; padding:0 14px 2px; }\n  .chips::-webkit-scrollbar{ display:none; }\n  .chip{ flex:0 0 auto; min-height:36px; border:1px solid var(--line); background:var(--bg); border-radius:99px; padding:0 14px; font-size:13.5px; font-weight:650; white-space:nowrap; }\n  .chip.hot{ background:var(--acc); border-color:var(--acc); color:#fff; }\n  .go{ min-height:48px; border:none; border-radius:14px; background:var(--acc); color:#fff; font-size:16px; font-weight:700;\n    display:flex; align-items:center; justify-content:center; gap:8px; padding:0 18px; }\n  .go.wide{ width:100%; margin-top:14px; }\n  .go.soft{ background:var(--fill); color:var(--acc); }\n  .go:disabled{ opacity:.55; }\n  .pillbtn{ display:inline-flex; align-items:center; gap:6px; min-height:36px; border:none; border-radius:10px; padding:0 12px;\n    background:hsl(var(--h) 70% 50% / .13); color:hsl(var(--h) 70% 38%); font-size:13.5px; font-weight:700; text-decoration:none; }\n  @media (prefers-color-scheme:dark){ .pillbtn{ color:hsl(var(--h) 80% 70%); } }\n  .spin{ width:16px; height:16px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n  .skel{ border-radius:16px; margin-bottom:10px; background:var(--fill); animation:shimmer 1.4s ease-in-out infinite; }\n  @keyframes shimmer{ 50%{ opacity:.45; } }\n\n  .notice{ display:flex; gap:12px; align-items:flex-start; background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  .notice .tile{ width:36px; height:36px; border-radius:10px; font-size:16px; }\n  .notice.warn .tile{ background:linear-gradient(145deg,#ff9f0a,#c25e00); }\n  .notice b{ display:block; font-size:15px; font-weight:750; }\n  .notice p{ font-size:13.5px; color:var(--muted); line-height:1.45; margin-top:2px; }\n  .notice p b{ display:inline; font-size:inherit; font-weight:700; color:var(--ink); }\n  .notice .go{ margin-top:10px; min-height:40px; font-size:14.5px; border-radius:12px; }\n  .hint{ text-align:center; font-size:13px; color:var(--muted); line-height:1.5; padding:18px 12px 6px; }\n\n  [hidden]{ display:none !important; }\n  @media (prefers-reduced-motion:reduce){ .spin{ animation-duration:2.4s; } .skel{ animation:none; } button:active{ transform:none; } }\n\n  /* the plan: a numbered route with a line joining the stops */\n  .route{ position:relative; }\n  .step{ position:relative; display:flex; gap:12px; align-items:flex-start; padding-bottom:12px; }\n  .step:not(:last-child)::before{ content:\"\"; position:absolute; left:17px; top:40px; bottom:0; width:2px; border-radius:2px; background:hsl(var(--h) 60% 50% / .35); }\n  .step .n{ width:36px; height:36px; border-radius:11px; font-size:15px; font-weight:800; font-variant-numeric:tabular-nums; }\n  .step .body{ flex:1; min-width:0; background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:12px 13px; }\n  .step .name{ font-size:16px; font-weight:700; line-height:1.3; overflow-wrap:anywhere; }\n  .step .meta{ display:flex; align-items:center; gap:8px; flex-wrap:wrap; font-size:13px; color:var(--muted); margin:5px 0 10px; }\n  .step .d{ font-size:12px; font-weight:800; font-variant-numeric:tabular-nums; color:hsl(var(--h) 70% 38%); background:hsl(var(--h) 70% 50% / .13); border-radius:99px; padding:2px 8px; }\n  @media (prefers-color-scheme:dark){ .step .d{ color:hsl(var(--h) 80% 68%); } }\n  .step .addr{ min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; flex:1; }\n  .skstep{ display:flex; gap:12px; margin-bottom:12px; }\n  .skstep .skel{ margin:0; }\n  @media (min-width:700px){ .route{ display:grid; grid-template-columns:1fr 1fr; column-gap:14px; } .step::before{ display:none; } }\n\n/* myllm-fullscreen-v1 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-map\" viewBox=\"0 0 24 24\"><path d=\"M3.5 6.5L9 4l6 2.5L20.5 4v13.5L15 20l-6-2.5-5.5 2.5zM9 4v13.5M15 6.5V20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-spark\" viewBox=\"0 0 24 24\"><path d=\"M10 2.5l1.9 5.6 5.6 1.9-5.6 1.9L10 17.5l-1.9-5.6L2.5 10l5.6-1.9zM18.5 14l.95 2.55L22 17.5l-2.55.95L18.5 21l-.95-2.55L15 17.5l2.55-.95z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-dir\" viewBox=\"0 0 24 24\"><path d=\"M11.3 2.7a1 1 0 0 1 1.4 0l8.6 8.6a1 1 0 0 1 0 1.4l-8.6 8.6a1 1 0 0 1-1.4 0l-8.6-8.6a1 1 0 0 1 0-1.4zM13 8.5v2.2H9.5a1 1 0 0 0-1 1V15h2v-2.3H13v2.2l3.2-3.2z\" fill=\"currentColor\" fill-rule=\"evenodd\"/></symbol>\n  <symbol id=\"i-share\" viewBox=\"0 0 24 24\"><path d=\"M12 3v12M7.5 7.5L12 3l4.5 4.5M5 12v6.5A1.5 1.5 0 0 0 6.5 20h11a1.5 1.5 0 0 0 1.5-1.5V12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-pin\" viewBox=\"0 0 24 24\"><path d=\"M12 2a7 7 0 0 0-7 7c0 5.2 6.1 12.2 6.4 12.5a.8.8 0 0 0 1.2 0C12.9 21.2 19 14.2 19 9a7 7 0 0 0-7-7zm0 9.6a2.6 2.6 0 1 1 0-5.2 2.6 2.6 0 0 1 0 5.2z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-warn\" viewBox=\"0 0 24 24\"><path d=\"M10.3 3.9a2 2 0 0 1 3.4 0l8 13.6a2 2 0 0 1-1.7 3H4a2 2 0 0 1-1.7-3zM12 9a1 1 0 0 0-1 1v4a1 1 0 0 0 2 0v-4a1 1 0 0 0-1-1zm0 7.2a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z\" fill=\"currentColor\"/></symbol>\n</defs></svg>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-map\"/></svg></div>\n  <div class=\"ht\"><h1>Day Out Planner</h1><p id=\"here\">Finding your location…</p></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Day Out Planner\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n\n<div class=\"card\">\n  <label for=\"vibe\">Your vibe</label>\n  <input id=\"vibe\" placeholder=\"A vibe… e.g. rainy day with kids\" autocomplete=\"off\" enterkeyhint=\"go\">\n  <div class=\"chips\" id=\"chips\"></div>\n  <button class=\"go wide\" id=\"bPlan\" type=\"button\"></button>\n</div>\n<div id=\"out\"></div>\n\n<script>\nfunction el(id){return document.getElementById(id)}\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction LOC(){ return window.myllmLocation || null; }\nfunction ASK(){ return window.myllmAsk || null; }\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k); }catch(_){} } }\nfunction esc(s){ return String(s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\"); }\nfunction icon(n){ return '<svg class=\"i\"><use href=\"#i-' + n + '\"/></svg>'; }\nvar here = null, busy = false;\nvar IDEAS = [\"rainy day with kids\",\"date night\",\"lazy Sunday\",\"tourist for a day\",\"active outdoors\",\"foodie crawl\"];\n\nfunction dist(m){ if(m==null)return \"\"; return m<1000?Math.round(m)+\" m\":(m/1000).toFixed(m<10000?1:0)+\" km\"; }\n\nfunction emojiFor(q){\n  q=q.toLowerCase();\n  var map=[[\"coffee\",\"☕\"],[\"cafe\",\"☕\"],[\"breakfast\",\"🥐\"],[\"brunch\",\"🥞\"],[\"restaurant\",\"🍽\"],[\"pizza\",\"🍕\"],\n    [\"bar\",\"🍺\"],[\"pub\",\"🍺\"],[\"park\",\"🌳\"],[\"museum\",\"🏛\"],[\"gallery\",\"🖼\"],[\"cinema\",\"🎬\"],[\"movie\",\"🎬\"],\n    [\"beach\",\"🏖\"],[\"shop\",\"🛍\"],[\"book\",\"📚\"],[\"ice cream\",\"🍦\"],[\"dessert\",\"🍰\"],[\"garden\",\"🌷\"],\n    [\"playground\",\"🛝\"],[\"zoo\",\"🦁\"],[\"aquarium\",\"🐠\"],[\"bowling\",\"🎳\"],[\"gym\",\"💪\"],[\"viewpoint\",\"🌄\"]];\n  for(var i=0;i<map.length;i++){ if(q.indexOf(map[i][0])>=0) return map[i][1]; }\n  return \"📍\";\n}\n\nfunction notice(kind, title, text){\n  el(\"out\").innerHTML='<div class=\"notice'+(kind===\"warn\"?\" warn\":\"\")+'\"><div class=\"tile\">'+icon(kind===\"warn\"?\"warn\":\"map\")+'</div>'+\n    '<div style=\"flex:1;min-width:0\"><b>'+esc(title)+'</b><p>'+text+'</p></div></div>';\n}\nfunction planBtn(on){\n  var b=el(\"bPlan\"); b.disabled=!!on;\n  b.innerHTML=on?'<i class=\"spin\"></i><span>Planning your day…</span>':icon(\"spark\")+'<span>Plan my day</span>';\n}\nfunction chips(){\n  var c=el(\"chips\");\n  IDEAS.forEach(function(v){\n    var b=document.createElement(\"button\");b.type=\"button\";b.className=\"chip\";b.textContent=v;\n    b.onclick=function(){haptic(\"selection\");el(\"vibe\").value=v;plan()};\n    c.appendChild(b);\n  });\n}\nfunction markChip(v){ [].forEach.call(el(\"chips\").children,function(c){ c.classList.toggle(\"hot\",c.textContent===v); }); }\n\n/* Labelled lines, not JSON — small models (Apple Intelligence) echo JSON\n   templates back verbatim. Echoed instructions are rejected and retried. */\nvar ECHO=/place search query|repeat this line|labelled line|visiting order|apple-maps style/i;\nfunction parseQueries(text){\n  var out=[],got=false;\n  String(text||\"\").split(/\\r?\\n/).forEach(function(raw){\n    var ln=raw.replace(/\\*\\*/g,\"\").trim();\n    var m=ln.match(/^[-*#>\\s]*(QUERY|QUERIES|STOP)\\s*\\d*\\s*[:：]\\s*(.*)$/i);\n    if(!m)return;\n    got=true;var v=m[2].trim();\n    if(v)out.push(v);\n  });\n  if(!got){ // model answered in the old JSON-array shape — accept it\n    try{\n      var s=text.indexOf(\"[\"), e=text.lastIndexOf(\"]\");\n      if(s>=0&&e>s){ var arr=JSON.parse(text.slice(s,e+1)); if(Array.isArray(arr)) out=arr.map(String); }\n    }catch(err){}\n  }\n  out=out.filter(function(x){return x&&!ECHO.test(x)});\n  if(out.length<2) throw new Error(\"no usable plan\");\n  return out.slice(0,6);\n}\n\nfunction plan(){\n  var vibe=el(\"vibe\").value.trim();\n  if(!vibe||busy) return;\n  var loc=LOC();\n  if(!loc){ notice(\"warn\",\"Location is off\",'This needs the latest MyLLM with <b>Allow apps to use your location</b> on.'); return; }\n  haptic(\"light\"); markChip(vibe);\n  busy=true; planBtn(true);\n  el(\"out\").innerHTML='<h2>Your day</h2>'+[0,1,2].map(function(){return '<div class=\"skstep\"><div class=\"skel\" style=\"width:36px;height:36px;border-radius:11px\"></div><div class=\"skel\" style=\"flex:1;height:92px\"></div></div>'}).join(\"\");\n\n  getQueries(vibe).then(function(queries){\n    if(!queries||!queries.length){ notice(\"warn\",\"Couldn’t plan that one\",\"Try another vibe.\"); return; }\n    // Resolve each step to its nearest real place, in order.\n    var jobs=queries.map(function(q){\n      return loc.search(q,{limit:1}).then(function(list){\n        var p=(list&&list[0])||null; return p?{q:q,place:p}:null;\n      }).catch(function(){return null});\n    });\n    return Promise.all(jobs).then(function(steps){\n      steps=steps.filter(Boolean);\n      if(!steps.length){ notice(\"warn\",\"Nothing nearby for that idea\",\"No matching places turned up — try another vibe.\"); return; }\n      render(steps,vibe);\n    });\n  }).then(function(){ busy=false; planBtn(false); },function(){ busy=false; planBtn(false); notice(\"warn\",\"Couldn’t plan that one\",\"Try another vibe.\"); });\n}\n\nfunction getQueries(vibe){\n  var ask=ASK();\n  if(!ask){\n    return Promise.resolve(presets(vibe));\n  }\n  var prompt='Plan a short local outing for this vibe: \"'+vibe+'\". Reply with EXACTLY these labelled lines and nothing else:\\n'+\n    'QUERY: one short place search query, Apple-Maps style — repeat this line for each stop (3 to 5 stops, in a sensible visiting order)';\n  var sys={system:\"You plan short local outings as a list of place search queries.\"};\n  return ask(prompt,sys)\n    .then(function(reply){ return parseQueries(reply||\"\"); })\n    .catch(function(){\n      return ask(prompt+'\\nIMPORTANT: fill each labelled line with real content — never repeat the instruction text.',sys)\n        .then(function(reply){ return parseQueries(reply||\"\"); });\n    })\n    .catch(function(){ return presets(vibe); });\n}\n\nfunction presets(vibe){\n  vibe=vibe.toLowerCase();\n  if(vibe.indexOf(\"kid\")>=0) return [\"cafe\",\"playground\",\"family restaurant\",\"ice cream\"];\n  if(vibe.indexOf(\"date\")>=0||vibe.indexOf(\"romantic\")>=0) return [\"coffee shop\",\"park\",\"restaurant\",\"bar\"];\n  if(vibe.indexOf(\"outdoor\")>=0||vibe.indexOf(\"active\")>=0) return [\"park\",\"viewpoint\",\"cafe\"];\n  if(vibe.indexOf(\"food\")>=0) return [\"bakery\",\"restaurant\",\"dessert\",\"bar\"];\n  return [\"coffee shop\",\"park\",\"restaurant\",\"museum\"];\n}\n\nfunction render(steps,vibe){\n  var O=el(\"out\");O.innerHTML='<h2>Your day · '+esc(vibe)+'</h2>';\n  var R=document.createElement(\"div\");R.className=\"route\";O.appendChild(R);\n  var share=[];\n  steps.forEach(function(st,i){\n    var p=st.place, dest=p.latitude+\",\"+p.longitude;\n    var d=document.createElement(\"div\");d.className=\"step\";\n    d.innerHTML='<div class=\"tile n\">'+(i+1)+'</div><div class=\"body\">'+\n      '<div class=\"name\">'+emojiFor(st.q)+' </div>'+\n      '<div class=\"meta\">'+(p.distance!=null?'<span class=\"d\">'+dist(p.distance)+'</span>':'')+'<span class=\"addr\"></span></div>'+\n      '<a class=\"pillbtn\" href=\"https://maps.apple.com/?daddr='+dest+'\">'+icon(\"dir\")+'Directions</a></div>';\n    d.querySelector(\".name\").appendChild(document.createTextNode(p.name));\n    d.querySelector(\".addr\").textContent=p.address||st.q;\n    R.appendChild(d);\n    share.push((i+1)+\". \"+p.name+(p.address?\" (\"+p.address+\")\":\"\"));\n  });\n  if(window.myllmShare){\n    var sb=document.createElement(\"button\");sb.type=\"button\";sb.className=\"go soft wide\";sb.innerHTML=icon(\"share\")+'<span>Share this plan</span>';\n    sb.onclick=function(){haptic(\"light\");myllmShare(\"My day out:\\n\"+share.join(\"\\n\"))};\n    O.appendChild(sb);\n  }\n  haptic(\"success\");\n}\n\nfunction start(){\n  chips(); planBtn(false);\n  el(\"bPlan\").onclick=plan;\n  el(\"vibe\").addEventListener(\"keydown\",function(e){ if(e.key===\"Enter\") plan(); });\n  var loc=LOC();\n  if(!loc){\n    el(\"here\").textContent=\"Location unavailable\";\n    notice(\"warn\",\"Location is off\",'This needs the latest MyLLM with <b>Settings → Allow apps to use your location</b> on (and <b>Allow apps to use the AI</b> for smarter plans).');\n    return;\n  }\n  el(\"out\").innerHTML='<p class=\"hint\">Pick a vibe or type your own, and I’ll build a route from places around you.</p>';\n  loc.current().then(function(p){\n    here=p; el(\"here\").textContent=p.address?(\"Around \"+p.address):\"Got your location\";\n  }).catch(function(e){\n    el(\"here\").textContent=\"Location off\";\n    notice(\"warn\",\"Couldn’t get your location\",esc(e&&e.message?e.message:\"Location isn’t available\")+'<br>Turn on <b>Settings → Allow apps to use your location</b>, then reopen.');\n  });\n}\nstart();\n\n/* myllm-fullscreen-v1 — full screen where MyLLM can also close the app for us (myllmClose,\n   5.6.2+): full screen hides MyLLM's Done, and a page with no way out is\n   worse than a repeated title, so elsewhere nothing changes. The spacer keeps\n   the header clear of the status bar only if the page doesn't already. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  function inset(){\n    var p = document.createElement(\"div\");\n    p.style.cssText = \"position:fixed;top:0;left:0;width:1px;visibility:hidden;height:env(safe-area-inset-top)\";\n    document.body.appendChild(p); var h = p.offsetHeight; p.parentNode.removeChild(p); return h;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = \"0px\";\n    if (!document.body.classList.contains(\"imm\")) return;\n    var need = inset() + 6 - (head.getBoundingClientRect().top + window.scrollY);\n    sp.style.height = Math.max(0, Math.round(need)) + \"px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  window.addEventListener(\"resize\", fit);\n  sync();\n})();\n</script></body></html>\n"}