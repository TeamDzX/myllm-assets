n setField(img) { tex.field = mkField(img); }\n\n  // ---------- events from the game drive the visual state\n  function event(e) {\n    var k = e[0];\n    if (k === 'bumper') { bump[e[1]] = 1; var c = T.circs.filter(function (q) { return q.k === 'bumper'; })[e[1]]; sparks(c.x, c.y, 1.2, [1, 0.8, 0.4], 7); fx.shake = Math.max(fx.shake, 0.05); }\n    else if (k === 'sling') { slingK[e[1]] = 1; fx.shake = Math.max(fx.shake, 0.04); }\n    else if (k === 'spin') spinV = Math.min(40, spinV + 9);\n    else if (k === 'jackpot' || k === 'super' || k === 'skill') { fx.flash = 1; }\n    else if (k === 'mb') { fx.flash = 1.4; fx.shake = 0.25; }\n    else if (k === 'drop') sparks(T.DROPS[e[1]].x1 + 0.65, 24.3, 1, [0.8, 0.5, 1], 5);\n    else if (k === 'standup') sparks([2.65, 0.7, 16.15][e[1]], [24.0, 18.0, 24.0][e[1]], 0.9, [1, 0.8, 0.3], 5);\n    else if (k === 'nudge') fx.shake = 0.3;\n    else if (k === 'lock' || k === 'mission' && e[2] === 'done') fx.flash = 0.8;\n    else if (k === 'kickback') sparks(1.15, 9.5, 0.6, [0.4, 1, 0.6], 8);\n    else if (k === 'drain') fx.flash = Math.max(fx.flash, 0.15);\n  }\n  function sparks(x, y, z, col, n) { for (var i = 0; i < n && parts.length < 90; i++) { var a = Math.random() * 6.28, s = 4 + Math.random() * 9; parts.push({ x: x, y: y, z: z, vx: Math.cos(a) * s, vy: Math.sin(a) * s, vz: 2 + Math.random() * 5, t: 0.35 + Math.random() * 0.3, c: col }); } }\n\n  // ---------- frame\n  function frame(g, dt, ui) {\n    var S = g.S, i, b, u, t;\n    time += dt; fx.flash = Math.max(0, fx.flash - dt * 3.2); fx.shake = Math.max(0, fx.shake - dt * 1.4);\n    // general illumination follows the mode\n    var gi = S.wz ? [1.12, 0.88, 0.86] : S.mb === 'kraken' ? [0.98, 0.84, 1.12] : S.cur === 4 ? [0.7, 0.95, 1.2] : S.cur >= 0 ? [1.08, 1.0, 0.85] : S.state === 'play' ? [1, 1, 1] : [0.78, 0.82, 0.95];\n    if (S.tilted) gi = [0.35, 0.35, 0.4];\n    for (i = 0; i < 3; i++) { fx.giT[i] = gi[i]; fx.gi[i] += (fx.giT[i] - fx.gi[i]) * Math.min(1, dt * 4); 