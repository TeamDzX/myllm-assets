 784, 1047], 0.07, 'square', 0.12, 0.2); },\n    jackpot: function () { arp([523, 659, 784, 1047, 784, 1047, 1319], 0.06, 'square', 0.16, 0.2); noise(0.3, 0.2, 5000, 0.6); },\n    'super': function () { arp([392, 523, 659, 784, 1047, 1319, 1568, 2093], 0.055, 'square', 0.17, 0.25); noise(0.6, 0.25, 6000, 0.5); },\n    skill: function () { arp([784, 988, 1175, 1568], 0.06, 'triangle', 0.2, 0.2); },\n    drain: function () { tone(330, 0.7, 'sawtooth', 0.2, 55); },\n    save: function () { arp([392, 523, 659, 784], 0.06, 'triangle', 0.18); },\n    launch: function () { noise(0.18, 0.4, 400, 0.7, 2000); tone(80, 0.12, 'triangle', 0.35, 160); },\n    kickback: function () { noise(0.1, 0.5, 700, 0.7); arp([659, 880], 0.07, 'square', 0.14); },\n    mstart: function () { arp([294, 370, 440, 587], 0.11, 'triangle', 0.2, 0.3); },\n    mdone: function () { arp([587, 740, 880, 1175, 880, 1175, 1480], 0.08, 'square', 0.15, 0.22); },\n    mfail: function () { arp([294, 277, 262, 247], 0.12, 'sawtooth', 0.12, 0.2); },\n    tilt: function () { tone(70, 1.0, 'sawtooth', 0.4, 50); },\n    warn: function () { tone(180, 0.2, 'square', 0.2); tone(180, 0.2, 'square', 0.2, 0, 0.26); },\n    extra: function () { arp([523, 784, 1047, 1568, 2093], 0.09, 'sine', 0.22, 0.3); },\n    bonus: function () { tone(880, 0.05, 'square', 0.1); },\n    beam: function () { tone(440, 0.6, 'sine', 0.2, 880); },\n    click: function () { tone(2400, 0.02, 'sine', 0.12); },\n    ui: function () { tone(660, 0.05, 'triangle', 0.15); }\n  };\n  function sfx(n, a) { if (!AC || !SAVE.snd) return; try { SFX[n](a); } catch (e) {} }\n  // music: a rolling 6/8 figure in D dorian, thicker when the game heats up\n  var mNext = 0, mStep = 0, SC = [146.83, 164.81, 174.61, 196.0, 220.0, 246.94, 261.63, 293.66];\n  var BASS = [0, 0, 4, 0, 3, 4, 0, 0, 4, 0, 6, 4, 3, 3, 0, 3, 4, 5, 4, 4, 1, 4, 3, 1], ARP = [0, 2, 4, 7, 4, 2, 0, 3, 5, 7, 5, 3, 1, 3, 5, 6, 5, 3, 0, 2, 4, 6, 4, 2];\n  function music() {\n    if (!AC || !SAVE.mus || paused) return; var S = g.S, hot = S.mb ? 2 : S.cur >= 0 ? 1 : 0, playing = S.state === 'play' || S.state === 'bonus', spb = playing ? (hot === 2 ? 0.145 : 0.17) : 0.24;\n    if (mNext < AC.currentTime) mNext = AC.currentTime + 0.05;\n    while (mNext < AC.currentTime + 0.2) {\n      var w = mNext - AC.currentTime, i = mStep % 24;\n      if (i % 3 === 0 || (hot && i % 3 === 2)) tone(SC[BASS[i]] / 2, spb * 1.6, 'triangle', 0.22, 0, w, musG);\n      if (playing) tone(SC[ARP[i]] * (hot === 2 ? 2 : 1), spb * 0.9, hot ? 'square' : 'triangle', hot ? 0.06 : 0.07, 0, w, musG);\n      else if (i % 6 === 0) tone(SC[ARP[i]], spb * 5, 'sine', 0.09, 0, w, musG);\n      if (hot && i % 3 === 0) tone(SC[(ARP[i] + 4) % 8] * 2, spb * 2.4, 'sine', 0.05, 0, w, musG);\n      mNext += spb; mStep++;\n    }\n  }\n\n  // ---------- score display\n  var dq = [], dCur = null, dT = 0, shown = 0;\n  function dmsg(a, b, pr, dur) { var m = { a: a, b: b || '', p: pr || 1, d: dur || (pr >= 3 ? 2.2 : 1.4) }; if (dCur && pr > dCur.p) { dCur = null; dq.length = 0; } if (dq.length < 3 || pr >= 3) dq.push(m); }\n  function dmdTick(dt) {\n    var S = g.S, M = el('dMsg');\n    if (dCur) { dT -= dt; if (dT <= 0) { dCur = null; M.classList.remove('on'); } }\n    if (!dCur && dq.length) { dCur = dq.shift(); dT = dCur.d; M.firstChild.textContent = dCur.a; M.lastChild.textContent = dCur.b; M.className = 'on' + (dCur.p >= 3 ? ' big' : ''); }\n    shown += (S.score - shown) * Math.min(1, dt * 9); if (Math.abs(S.score - shown) < 60) shown = S.score;\n    el('dScore').textContent = g.fmt(shown);\n    var playing = S.state === 'play' || S.state === 'bonus';\n    el('dBall').textContent = playing ? 'Ball ' + S.ball + ' of ' + S.balls + (S.extra ? '  +' + S.extra : '') : 'Stormglass';\n    el('dX').textContent = playing ? (S.beamT > 0 ? '2x scoring  ' : '') + 'Bonus ' + S.bx + 'x' : (SAVE.hi[0] ? 'Best ' + g.fmt(SAVE.hi[0]) : '');\n    var sub = '', bar = 0;\n    if (playing) {\n      if (S.wz) sub = 'Eye of the storm: every lit shot is a jackpot';\n      else if (S.mb === 'kraken') sub = S.sup ? 'Super jackpot: shoot the Kraken' : 'Kraken multiball: shoot the lit ramps';\n      else if (S.cur >= 0) { sub = T.MNAME[S.cur] + '  ' + S.mp + '/' + [4, 4, 20, 6, 3][S.cur] + '  ' + Math.ceil(S.mt) + 's'; bar = S.mt / [45, 45, 60, 50, 50][S.cur]; }\n      else if (S.lockLit) sub = 'Lock is lit: shoot the Kraken';\n      else if (g.laneBall()) sub = 'Hold right side, release to launch';\n      else sub = 'Harbour starts ' + T.MNAME[S.sel];\n    } else sub = 'Tap play';\n    el('dSub').textContent = sub; el('dBar').style.width = (bar * 100).toFixed(1) + '%';\n  }\n\n  // ---------- events\n  function onEvent(e) {\n    var k = e[0]; RD.event(e);\n    switch (k) {\n      case 'msg': dmsg(e[1], e[2], e[3]); break;\n      case 'flip': sfx('flip'); haptic('light'); break;\n      case 'bumper': sfx('bumper'); haptic('light'); break;\n      case 'sling': sfx('sling'); haptic('light'); break;\n      case 'knock': sfx('knock', e[3]); break;\n      case 'click': sfx('click'); break;\n      case 'standup': sfx('standup'); break;\n      case 'drop': sfx('drop'); haptic('medium'); break;\n      case 'spin': sfx('spin'); break;\n      case 'lane': case 'inlane': sfx('lane'); break;\n      case 'rampin': sfx('rampin'); break;\n      case 'rampdrop': sfx('rampdrop'); break;\n      case 'shot': if (e[2] < 2) sfx('shot'); break;\n      case 'combo': sfx('combo', e[1]); break;\n      case 'scoop': sfx('scoop'); haptic('medium'); break;\n      case 'eject': sfx('eject'); haptic('medium'); break;\n      case 'lock': sfx('lock'); haptic('heavy'); break;\n      case 'locklit': sfx('locklit'); break;\n      case 'mb': sfx('mb'); haptic('heavy'); flash(0.5); break;\n      case 'jackpot': sfx('jackpot'); haptic('heavy'); flash(0.35); break;\n      case 'super': sfx('super'); haptic('heavy'); flash(0.6); break;\n      case 'skill': sfx('skill'); haptic('medium'); break;\n      case 'drain': sfx('drain'); haptic('heavy'); break;\n      case 'save': sfx('save'); break;\n      case 'launch': sfx('launch'); haptic('medium'); break;\n      case 'kickback': sfx('kickback'); haptic('heavy'); break;\n      case 'mission': if (e[2] === 'start') sfx('mstart'); else if (e[2] === 'done') { sfx('mdone'); haptic('heavy'); } else if (e[2] === 'fail') sfx('mfail'); else sfx('shot'); break;\n      case 'tilt': sfx('tilt'); haptic('heavy'); break;\n      case 'warn': sfx('warn'); break;\n      case 'extra': sfx('extra'); break;\n      case 'beam': case 'fog': case 'bonusx': sfx('beam'); break;\n      case 'bonus': bonusShow(e[1], e[2], e[3]); break;\n      case 'gameover': gameOver(); break;\n      case 'ballstart': hint(SAVE.games < 2 && e[1] === 1 ? 'Hold the right side to pull the plunger, then let go' : ''); break;\n    }\n  }\n  function flash(a) { var f = el('flash'); f.style.transition = 'none'; f.style.opacity = a; requestAnimationFrame(function () { f.style.transition = 'opacity .5s'; f.style.opacity = 0; }); }\n  function hint(t) { var h = el('hint'); if (!t) { h.classList.remove('on'); return; } h.textContent = t; h.classList.add('on'); hintT = 6; }\n  function bonusShow(items, x, tot) {\n    var i = 0; items.forEach(function (it) { if (it[1] > 0) { dmsg(it[0], g.fmt(it[1]), 2, 0.5); i++; } });\n    dmsg('BONUS ' + x + 'X', g.fmt(tot), 2, 1.1); for (i = 0; i < 8; i++) setTimeout(function () { sfx('bonus'); }, 150 * i);\n  }\n  function gameOver() {\n    var S = g.S, sc = S.score, rank; SAVE.hi.push(sc); SAVE.hi.sort(function (a, b) { return b - a; }); SAVE.hi = SAVE.hi.slice(0, 5); rank = SAVE.hi.indexOf(sc); SAVE.games++; save();\n    el('ovT').textContent = rank === 0 && sc > 0 && SAVE.games > 1 ? 'New best score!' : 'Game over';\n    el('ovRows').innerHTML = '<div><span>Missions completed</span><span>' + S.misDone + ' of 5</span></div><div class=\"tot\"><span>Score</span><span>' + g.fmt(sc) + '</span></div>';\n    el('ovHi').innerHTML = SAVE.hi.map(function (h, i) { return (i === rank ? '<b>' : '') + (i + 1) + '.  ' + g.fmt(h) + (i === rank ? '</b>' : ''); }).join('<br>');\n    setTimeout(function () { show('over'); }, 900);\n  }\n  function hiLine() { el('hiLine').innerHTML = SAVE.hi.length ? 'Best  <b>' + g.fmt(SAVE.hi[0]) + '</b>' : ''; }\n\n  // ---------- flow\n  function startGame() { audio(); hide('menu'); hide('over'); hide('how'); immersive(true); dq.length = 0; dCur = null; shown = 0; g.newGame(); started = true; paused = false; sfx('mstart'); }\n  function setPause(p) { if (!started || g.S.state === 'over') return; paused = p; if (p) { show('pause'); keys.l = keys.r = keys.p = 0; touch = {}; } else hide('pause'); }\n  function toMenu() { hide('over'); hide('pause'); show('menu'); started = false; paused = false; g.S.state = 'attract'; g.balls.length = 0; hiLine(); immersive(false); }\n  function togLabels() { el('bSnd').textContent = 'Sound ' + (SAVE.snd ? 'on' : 'off'); el('bMus').textContent = 'Music ' + (SAVE.mus ? 'on' : 'off'); if (master) master.gain.value = SAVE.snd ? 0.9 : 0; if (musG) musG.gain.value = SAVE.mus ? 0.5 : 0; }\n  function tap(id, fn) { el(id).addEventListener('click', function (e) { e.stopPropagation(); audio(); sfx('ui'); fn(); }); }\n  tap('bStart', startGame); tap('bAgain', startGame); tap('bMenu', toMenu);\n  tap('bHow', function () { show('how'); }); tap('bHow2', function () { show('how'); }); tap('bHowOk', function () { hide('how'); });\n  tap('bPause', function () { setPause(true); }); tap('bResume', function () { setPause(false); });\n  tap('bQuit', function () { hide('pause'); paused = false; g.debug.endBall(); g.S.ball = g.S.balls; g.S.extra = 0; });\n  tap('bSnd', function () { SAVE.snd = SAVE.snd ? 0 : 1; togLabels(); save(); }); tap('bMus', function () { SAVE.mus = SAVE.mus ? 0 : 1; togLabels(); save(); });\n  if (typeof window.myllmClose === 'function') { show('bClose'); tap('bClose', function () { immersive(false); window.myllmClose(); }); }\n\n  // ---------- input\n  function sideOf(x) { return x < window.innerWidth / 2 ? 0 : 1; }\n  function inGame() { return started && !paused && g.S.state === 'play'; }\n  // Touch screens: rebuild the set of held sides from the live touch list on every change, so a lost \"up\" can never leave a flipper raised.\n  function syncTouches(e) {\n    var old = touch, i, t, k; touch = {}; for (k in old) if (k.charAt(0) === 'm') touch[k] = old[k];\n    if (!inGame()) return;\n    for (i = 0; i < e.touches.length; i++) {\n      t = e.touches[i]; if (t.target && t.target.closest && t.target.closest('.ov,button')) continue;\n      var o = old[t.identifier] || { s: sideOf(t.clientX), x: t.clientX, y: t.clientY, t: performance.now(), n: 0 };\n      if (!o.n && o.y - t.clientY > 70 && performance.now() - o.t < 260) { o.n = 1; g.nudge(o.s ? -1 : 1); }\n      touch[t.identifier] = o;\n    }\n    if (e.cancelable && !(e.target.closest && e.target.closest('.ov,button'))) e.preventDefault();\n  }\n  ['touchstart', 'touchmove', 'touchend', 'touchcancel'].forEach(function (n) { window.addEventListener(n, function (e) { if (n === 'touchstart') audio(); syncTouches(e); }, { passive: false }); });\n  // Mouse and pen\n  window.addEventListener('pointerdown', function (e) {\n    if (e.pointerType === 'touch') return;\n    if (e.target.closest && e.target.closest('.ov,button')) return; audio(); if (!inGame()) return; e.preventDefault();\n    touch['m' + e.pointerId] = { s: sideOf(e.clientX), x: e.clientX, y: e.clientY, t: performance.now(), n: 0 };\n  }, { passive: false });\n  window.addEventListener('pointermove', function (e) {\n    var t = touch['m' + e.pointerId]; if (!t) return;\n    if (e.buttons === 0) { delete touch['m' + e.pointerId]; return; }\n    if (!t.n && t.y - e.clientY > 70 && performance.now() - t.t < 260) { t.n = 1; g.nudge(t.s ? -1 : 1); }\n  });\n  function up(e) { delete touch['m' + e.pointerId]; }\n  window.addEventListener('pointerup', up); window.addEventListener('pointercancel', up);\n  function releaseAll() { touch = {}; keys.l = keys.r = keys.p = 0; }\n  window.addEventListener('blur', releaseAll); document.addEventListener('mouseleave', function () { for (var k in touch) if (k.charAt(0) === 'm') delete touch[k]; });\n  window.addEventListener('contextmenu', function (e) { e.preventDefault(); });\n  function key(e, d) {\n    var c = e.code; if (d && e.repeat) return;\n    if (c === 'MetaLeft' || c === 'MetaRight' || c === 'AltLeft' || c === 'AltRight' || c === 'ControlLeft' || c === 'ControlRight') { releaseAll(); return; }\n    if (c === 'ArrowLeft' || c === 'KeyZ' || c === 'KeyA') keys.l = d; else if (c === 'ArrowRight' || c === 'Slash' || c === 'KeyL' || c === 'KeyM') keys.r = d;\n    else if (c === 'Space' || c === 'ArrowDown' || c === 'Enter') { keys.p = d; if (d && !started) startGame(); }\n    else if (c === 'ArrowUp' && d) g.nudge(Math.random() < 0.5 ? -1 : 1); else if ((c === 'Escape' || c === 'KeyP') && d) setPause(!paused); else return;\n    e.preventDefault(); if (d) audio();\n  }\n  window.addEventListener('keydown', function (e) { key(e, 1); }); window.addEventListener('keyup', function (e) { key(e, 0); });\n  document.addEventListener('visibilitychange', function () { if (document.hidden) { if (inGame()) setPause(true); if (AC) AC.suspend(); } else if (AC && !paused) AC.resume(); });\n\n  function controls(dt) {\n    var l = keys.l, r = keys.r, k, pulling = keys.p;\n    for (k in touch) { if (touch[k].s) r = 1; else l = 1; }\n    var lane = g.laneBall();\n    if (lane && (r || pulling)) { if (pullT < 0) pullT = 0; pullT += dt; ui.pull = Math.min(1, pullT / 0.95); }\n    else { if (pullT >= 0 && lane) { g.plunge(Math.max(0.04, ui.pull)); hint(''); } pullT = -1; ui.pull = 0; }\n    el('pl').className = lane ? 'on' : ''; el('pl').firstChild.style.height = (ui.pull * 100) + '%';\n    g.input(l, r);\n  }\n\n  // ---------- loop\n  function layout() { var top = el('dmd').getBoundingClientRect().height; RD.resize(window.innerWidth, window.innerHeight, top, Math.min(window.devicePixelRatio || 1, 2)); }\n  function frame(t) {\n    var dt = Math.min(0.05, (t - last) / 1000 || 0.016); last = t;\n    if (!paused) {\n      if (started) controls(dt);\n      g.step(dt);\n      for (var i = 0; i < g.ev.length; i++) onEvent(g.ev[i]); g.ev.length = 0;\n      dmdTick(dt); music();\n      if (hintT > 0) { hintT -= dt; if (hintT <= 0) hint(''); }\n    }\n    RD.frame(g, paused ? 0 : dt, ui);\n    requestAnimationFrame(frame);\n  }\n  function boot(img) {\n    try { RD.init(el('gl'), img); } catch (err) { el('menu').querySelector('.tag').textContent = 'This device could not start the 3D table: ' + err.message; return; }\n    layout(); window.addEventListener('resize', layout); window.addEventListener('orientationchange', function () { setTimeout(layout, 250); });\n    requestAnimationFrame(frame);\n  }\n  if (ART.back && ART.back.indexOf('data:') === 0) el('menu').style.backgroundImage = 'url(' + ART.back + ')';\n  store.getItem(KEY).then(function (v) { try { var o = JSON.parse(v); if (o) for (var k in o) SAVE[k] = o[k]; } catch (e) {} }).catch(function () {}).then(function () { togLabels(); hiLine(); });\n  if (ART.field && ART.field.indexOf('data:') === 0) { var im = new Image(); im.onload = function () { boot(im); }; im.onerror = function () { boot(null); }; im.src = ART.field; } else boot(null);\n  window.__sg = { g: g, RD: RD, SAVE: SAVE, start: startGame, pause: setPause };\n})();\n\n</script>\n</body>\n</html>\n"}