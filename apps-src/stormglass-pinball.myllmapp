{"name": "Stormglass Pinball", "kind": "html", "iconSymbol": "circle.circle.fill", "iconColor": "teal", "html": "<!DOCTYPE html>\n<!--\n  Stormglass Pinball — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>Stormglass Pinball</title>\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover\">\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>\n*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}\n:root{--build-id:\"c6ddc66ab0\";--amber:#ffb53a;--hot:#ff5a36;--ink:#f4f8ff;--dim:#9db4c8;--panel:rgba(6,16,28,.88);--line:rgba(255,200,110,.35);--sat:env(safe-area-inset-top);--sab:env(safe-area-inset-bottom);--disp:ui-rounded,\"SF Pro Rounded\",\"Arial Rounded MT Bold\",\"Segoe UI\",system-ui,sans-serif;--mono:ui-monospace,\"SF Mono\",Menlo,Consolas,monospace;--grain:0.283349774688}\nhtml,body{height:100%;background:#03060b;color:var(--ink);font-family:var(--disp);overflow:hidden;overscroll-behavior:none;touch-action:none}\n#gl{position:fixed;inset:0;width:100%;height:100%;display:block}\n#dmd{position:fixed;left:0;right:0;top:0;height:calc(86px + var(--sat));padding:calc(6px + var(--sat)) 10px 6px;background:linear-gradient(#0b0705,#150b06);border-bottom:2px solid #3a2410;box-shadow:0 6px 18px rgba(0,0,0,.6);z-index:5}\n#dmdIn{position:relative;height:100%;max-width:560px;margin:0 auto;border-radius:8px;background:#120803;border:1px solid #4a2b10;overflow:hidden;font-family:var(--mono);color:var(--amber);text-shadow:0 0 6px rgba(255,150,30,.9),0 0 16px rgba(255,110,10,.5);text-transform:uppercase;display:flex;flex-direction:column;justify-content:space-between;padding:4px 10px 7px}\n#dmdIn:after{content:\"\";position:absolute;inset:0;background-image:linear-gradient(rgba(18,8,3,.42) 1px,transparent 1px),linear-gradient(90deg,rgba(18,8,3,.42) 1px,transparent 1px);background-size:3px 3px;pointer-events:none}\n#dTop{display:flex;justify-content:space-between;gap:10px;font-size:11px;line-height:13px;font-weight:700;letter-spacing:.06em;opacity:.85;white-space:nowrap;overflow:hidden}\n#dTop span{overflow:hidden;text-overflow:ellipsis}\n#dScore{text-align:center;font-size:clamp(22px,8vw,32px);font-weight:800;letter-spacing:.03em;line-height:1;white-space:nowrap}\n#dSub{text-align:center;font-size:11px;line-height:13px;font-weight:700;letter-spacing:.06em;opacity:.9;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n#dMsg{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;background:#120803;opacity:0;transition:opacity .12s}\n#dMsg.on{opacity:1}\n#dMsg b{font-size:clamp(17px,5.6vw,23px);font-weight:800;letter-spacing:.05em;white-space:nowrap}\n#dMsg i{font-style:normal;font-size:clamp(10px,3.2vw,13px);font-weight:700;letter-spacing:.08em;white-space:nowrap}\n#dMsg.big b{font-size:clamp(18px,6.2vw,27px);animation:pulse .28s steps(2) infinite}\n@keyframes pulse{50%{opacity:.35}}\n#dBar{position:absolute;left:0;bottom:0;height:4px;width:0;background:var(--amber);box-shadow:0 0 8px var(--amber)}\n#bPause{position:fixed;right:8px;top:calc(96px + var(--sat));z-index:6;width:38px;height:38px;border-radius:12px;border:1px solid var(--line);background:rgba(6,16,28,.6);color:var(--ink);font:800 14px var(--disp)}\n#pl{position:fixed;right:10px;bottom:calc(120px + var(--sab));width:12px;height:150px;border-radius:8px;border:1px solid var(--line);background:rgba(6,16,28,.6);z-index:4;overflow:hidden;opacity:0;transition:opacity .2s}\n#pl.on{opacity:1}\n#pl s{position:absolute;left:0;right:0;bottom:0;height:0;background:linear-gradient(#ff5a36,#ffb53a)}\n#hint{position:fixed;left:0;right:0;bottom:calc(18px + var(--sab));text-align:center;font-size:14px;font-weight:700;color:var(--ink);text-shadow:0 2px 6px #000;z-index:4;pointer-events:none;opacity:0;transition:opacity .3s;padding:0 16px}\n#hint.on{opacity:.95}\n#flash{position:fixed;inset:0;background:#dfeaff;opacity:0;pointer-events:none;z-index:3}\n.ov{position:fixed;inset:0;z-index:10;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;padding:calc(20px + var(--sat)) 20px calc(26px + var(--sab));background:linear-gradient(rgba(3,6,11,.0) 0%,rgba(3,6,11,.55) 45%,rgba(3,6,11,.96) 78%);touch-action:pan-y;overflow-y:auto}\n.ov.mid{justify-content:center;background:rgba(3,6,11,.82);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}\n.hidden{display:none!important}\n#menu{background-size:cover;background-position:center top}\n#menu .shade{position:absolute;inset:0;background:linear-gradient(rgba(3,6,11,.05) 0%,rgba(3,6,11,.35) 40%,rgba(3,6,11,.97) 80%);pointer-events:none}\n#menu>*{position:relative}\n.logo{font-size:clamp(40px,12vw,64px);font-weight:900;letter-spacing:.02em;line-height:.95;text-align:center;color:#ffe9b8;text-shadow:0 2px 0 #7a3b10,0 4px 18px rgba(255,140,40,.55),0 0 2px #000}\n.logo small{display:block;font-size:.3em;letter-spacing:.42em;margin-top:8px;color:var(--amber)}\n.tag{margin:12px 0 18px;text-align:center;color:var(--dim);font-size:15px;max-width:340px;line-height:1.35}\n.btn{display:block;width:100%;max-width:320px;padding:15px 18px;border-radius:16px;border:0;font:800 18px var(--disp);color:#1a0c02;background:linear-gradient(#ffd27a,#ff9d2e);box-shadow:0 4px 0 #9a4a0c,0 10px 24px rgba(255,130,30,.35);margin-top:10px}\n.btn:active{transform:translateY(3px);box-shadow:0 1px 0 #9a4a0c}\n.btn.sec{background:rgba(255,255,255,.08);color:var(--ink);box-shadow:none;border:1px solid var(--line);font-size:16px;padding:12px}\n.card{width:100%;max-width:360px;border-radius:18px;border:1px solid var(--line);background:var(--panel);padding:18px}\n.card h2{font-size:22px;color:#ffe9b8;text-align:center;margin-bottom:10px}\n.card p,.card li{font-size:14.5px;line-height:1.4;color:var(--ink)}\n.card ul{list-style:none;display:grid;gap:8px;margin:6px 0 4px}\n.card li b{color:var(--amber)}\n.rows{display:grid;gap:6px;margin:8px 0 6px;font-family:var(--mono);font-size:15px}\n.rows div{display:flex;justify-content:space-between;gap:12px}\n.rows .tot{border-top:1px solid var(--line);padding-top:8px;font-size:19px;font-weight:800;color:var(--amber)}\n.hi{margin-top:12px;font-family:var(--mono);font-size:13.5px;color:var(--dim);text-align:center}\n.hi b{color:var(--amber)}\n.tog{display:flex;gap:8px;width:100%;max-width:320px;margin-top:10px}\n.tog .btn{margin-top:0}\n@media (max-height:480px){#dmd{height:calc(72px + var(--sat))}#dScore{font-size:24px}#bPause{top:calc(80px + var(--sat))}}\n</style>\n</head>\n<body>\n<canvas id=\"gl\"></canvas>\n<div id=\"flash\"></div>\n<div id=\"dmd\"><div id=\"dmdIn\">\n  <div id=\"dTop\"><span id=\"dBall\">Stormglass</span><span id=\"dX\"></span></div>\n  <div id=\"dScore\">0</div><div id=\"dSub\"></div>\n  <div id=\"dMsg\"><b></b><i></i></div><div id=\"dBar\"></div>\n</div></div>\n<button id=\"bPause\" type=\"button\" aria-label=\"Pause\">II</button>\n<div id=\"pl\"><s></s></div>\n<div id=\"hint\"></div>\n\n<div id=\"menu\" class=\"ov\">\n  <div class=\"shade\"></div>\n  <div class=\"logo\">Stormglass<small>PINBALL</small></div>\n  <p class=\"tag\">Light the lighthouse, guide five ships home, and feed the Kraken for multiball.</p>\n  <button class=\"btn\" id=\"bStart\" type=\"button\">Play</button>\n  <button class=\"btn sec\" id=\"bHow\" type=\"button\">How to play</button>\n  <div class=\"hi\" id=\"hiLine\"></div>\n</div>\n\n<div id=\"how\" class=\"ov mid hidden\"><div class=\"card\">\n  <h2>How to play</h2>\n  <ul>\n    <li><b>Flippers:</b> tap the left or right half of the screen.</li>\n    <li><b>Launch:</b> hold the right side to pull the plunger, let go to fire. A soft launch into the flashing top lane is a skill shot.</li>\n    <li><b>Nudge:</b> swipe up. Too many and the table tilts.</li>\n    <li><b>Missions:</b> shoot the green Harbour to start one. Finish all five for Eye of the Storm.</li>\n    <li><b>Kraken:</b> knock down the three purple targets, then lock three balls in its mouth for multiball. Ramps score jackpots.</li>\n    <li><b>Skyway:</b> the narrow gold ramp circles the lighthouse and doubles all scoring for 20 seconds.</li>\n    <li><b>Combos:</b> chain ramps and orbits quickly for up to 6x.</li>\n  </ul>\n  <button class=\"btn\" id=\"bHowOk\" type=\"button\">Got it</button>\n</div></div>\n\n<div id=\"pause\" class=\"ov mid hidden\"><div class=\"card\">\n  <h2>Paused</h2>\n  <button class=\"btn\" id=\"bResume\" type=\"button\">Resume</button>\n  <div class=\"tog\"><button class=\"btn sec\" id=\"bSnd\" type=\"button\">Sound on</button><button class=\"btn sec\" id=\"bMus\" type=\"button\">Music on</button></div>\n  <button class=\"btn sec\" id=\"bHow2\" type=\"button\">How to play</button>\n  <button class=\"btn sec\" id=\"bQuit\" type=\"button\">End game</button>\n  <button class=\"btn sec hidden\" id=\"bClose\" type=\"button\">Close</button>\n</div></div>\n\n<div id=\"over\" class=\"ov mid hidden\"><div class=\"card\">\n  <h2 id=\"ovT\">Game over</h2>\n  <div class=\"rows\" id=\"ovRows\"></div>\n  <div class=\"hi\" id=\"ovHi\"></div>\n  <button class=\"btn\" id=\"bAgain\" type=\"button\">Play again</button>\n  <button class=\"btn sec\" id=\"bMenu\" type=\"button\">Menu</button>\n</div></div>\n\n<script>\nvar ART = { field: 'data:image/jpeg;base64,', back: 'data:image/jpeg;base64,' };\n// Stormglass: table, physics and rules. No DOM in this file (it also runs in Node for tests).\nvar SG = (function () {\n  'use strict';\n  var R = 0.55, G = 42, DT = 1 / 960, CX = 9.4, XL = 0.3, XR = 18.5, XS = 19.95;\n  var AX = (XL + XS) / 2, AY = 32, AR = (XS - XL) / 2, KZ = 430, VMAX = 150;\n  var segs = [], circs = [], sens = [], rails = [], lamps = [], lampIx = {};\n  function mir(x) { return 2 * CX - x; }\n  function seg(x1, y1, x2, y2, o) {\n    o = o || {};\n    var s = { x1: x1, y1: y1, x2: x2, y2: y2, e: o.e == null ? 0.4 : o.e, k: o.k || 'wall', id: o.id | 0, ow: o.ow | 0, h: o.h == null ? 1.0 : o.h, sty: o.sty || 'wall', on: 1 };\n    s.a = Math.min(x1, x2) - R; s.b = Math.max(x1, x2) + R; s.c = Math.min(y1, y2) - R; s.d = Math.max(y1, y2) + R;\n    segs.push(s); return s;\n  }\n  function poly(p, o) { for (var i = 0; i + 1 < p.length; i++) seg(p[i][0], p[i][1], p[i + 1][0], p[i + 1][1], o); }\n  function arcPts(cx, cy, r, a0, a1, n) { var p = [], i, a; for (i = 0; i <= n; i++) { a = (a0 + (a1 - a0) * i / n) * Math.PI / 180; p.push([cx + r * Math.cos(a), cy + r * Math.sin(a)]); } return p; }\n  function circ(x, y, r, o) { o = o || {}; var c = { x: x, y: y, r: r, e: o.e == null ? 0.6 : o.e, k: o.k || 'post', id: o.id | 0, sty: o.sty || 'post' }; circs.push(c); return c; }\n  function both(f) { f(function (x) { return x; }, 0); f(mir, 1); }\n\n  // ---- outer shell\n  seg(XS, 1.6, XS, AY, { sty: 'rail' });\n  poly(arcPts(AX, AY, AR, 0, 180, 40), { sty: 'rail' });\n  seg(XL, AY, XL, 4.4, { sty: 'rail' });\n  seg(XL, 4.4, CX - 2.0, 1.4, { sty: 'apron', e: 0.25 });\n  seg(XR, 4.4, CX + 2.0, 1.4, { sty: 'apron', e: 0.25 });\n  seg(XR, 1.6, XR, 33.2, { sty: 'rail' });\n  seg(XR, 1.6, XS, 1.6, { k: 'plfloor', e: 0.1, sty: 'none' });\n  seg(XR, 33.2, 19.69, 34.3, { ow: 1, k: 'gate', e: 0.2, sty: 'gate', h: 0.9 });\n  // one-way gate at the top left: stops balls travelling anticlockwise (plunges, right orbit) so they drop into the lanes\n  var TOPGATE = seg(5.32, 40.57, 6.4, 38.65, { ow: 1, k: 'gate', e: 0.2, sty: 'gate', h: 0.9 });\n  // one-way deflectors under the orbit exits push returning balls toward the inlanes\n  seg(XL, 14.8, 2.25, 13.0, { ow: 1, e: 0.15, sty: 'wire', h: 0.5 });\n  seg(mir(2.25), 13.0, XR, 14.8, { ow: 1, e: 0.15, sty: 'wire', h: 0.5 });\n  // inner arch and top lanes\n  poly(arcPts(CX, 32, 7.3, 114.3, 180, 14), { sty: 'rail' });\n  poly(arcPts(CX, 32, 7.3, 0, 65.7, 14), { sty: 'rail' });\n  seg(6.4, 38.65, 6.4, 36.3, { sty: 'rail' }); seg(12.4, 38.65, 12.4, 36.3, { sty: 'rail' });\n  seg(8.4, 38.4, 8.4, 36.3, { sty: 'rail' }); seg(10.4, 38.4, 10.4, 36.3, { sty: 'rail' });\n  circ(8.4, 38.4, 0.14, { e: 0.4 }); circ(10.4, 38.4, 0.14, { e: 0.4 });\n  // lower lanes, slings\n  both(function (m, side) {\n    seg(m(2.0), 8.2, m(2.0), 11.4, { sty: 'rail' });\n    circ(m(2.0), 11.4, 0.2);\n    seg(m(2.0), 8.2, m(5.25), 6.05, { sty: 'rail', e: 0.2 });\n    seg(m(3.7), 12.3, m(5.6), 7.9, { k: 'sling', id: side, e: 0.5, sty: 'rubber', h: 0.7 });\n    seg(m(5.6), 7.9, m(3.7), 9.1, { sty: 'rubber', h: 0.7, e: 0.5 });\n    seg(m(3.7), 9.1, m(3.7), 12.3, { sty: 'rubber', h: 0.7, e: 0.5 });\n    circ(m(3.7), 12.3, 0.24); circ(m(5.6), 7.9, 0.24); circ(m(3.7), 9.1, 0.24);\n  });\n  // mid island: orbit walls, standups, ramp mouths, kraken maw, harbour\n  seg(2.1, 26.4, 2.1, 24.2, { sty: 'rail' });\n  seg(2.1, 24.2, 3.2, 24.2, { k: 'standup', id: 0, sty: 'target' });\n  poly([[3.2, 24.2], [3.2, 25.4], [5.6, 25.4], [5.6, 24.2]], { sty: 'none' });\n  poly([[5.6, 25.4], [7.3, 25.4]], { sty: 'none' });\n  seg(0.45, 17.2, 0.45, 18.8, { k: 'standup', id: 1, sty: 'target' });\n  poly([[7.3, 24.2], [7.3, 27.2], [11.5, 27.2], [11.5, 24.2]], { sty: 'wall' });\n  poly([[11.5, 26.0], [13.2, 26.0], [13.2, 24.2]], { sty: 'wall' });\n  poly([[13.2, 25.4], [15.6, 25.4], [15.6, 24.2]], { sty: 'none' });\n  seg(15.6, 24.2, 16.7, 24.2, { k: 'standup', id: 2, sty: 'target' });\n  seg(16.7, 24.2, 16.7, 26.4, { sty: 'rail' });\n  seg(2.1, 26.4, CX, 28.2, { sty: 'wall' }); seg(CX, 28.2, 16.7, 26.4, { sty: 'wall' });\n  [2.1, 7.3, 11.5, 16.7].forEach(function (x) { circ(x, 24.2, 0.17, { e: 0.5 }); });\n  var DROPS = [seg(7.38, 24.4, 8.7, 24.4, { k: 'drop', id: 0, sty: 'drop', e: 0.3 }), seg(8.75, 24.4, 10.05, 24.4, { k: 'drop', id: 1, sty: 'drop', e: 0.3 }), seg(10.1, 24.4, 11.42, 24.4, { k: 'drop', id: 2, sty: 'drop', e: 0.3 })];\n  // bumpers\n  circ(7.2, 33.4, 1.05, { k: 'bumper', id: 0 }); circ(11.6, 33.4, 1.05, { k: 'bumper', id: 1 }); circ(CX, 30.6, 1.05, { k: 'bumper', id: 2 });\n\n  // ---- sensors (zones). c: circle [x,y,r]; b: box [x0,y0,x1,y1]\n  function zc(k, id, x, y, r) { sens.push({ k: k, id: id, x: x, y: y, r: r }); }\n  function zb(k, id, x0, y0, x1, y1) { sens.push({ k: k, id: id, x0: x0, y0: y0, x1: x1, y1: y1 }); }\n  zc('top', 0, 7.4, 37.2, 0.6); zc('top', 1, 9.4, 37.2, 0.6); zc('top', 2, 11.4, 37.2, 0.6);\n  zc('inl', 0, 2.85, 10.3, 0.65); zc('inl', 1, mir(2.85), 10.3, 0.65);\n  zc('outl', 0, 1.15, 9.4, 0.7); zc('outl', 1, mir(1.15), 9.4, 0.7);\n  zb('orb', 0, XL, 25.7, 2.1, 26.3); zb('orb', 1, 16.7, 25.7, XR, 26.3);\n  zb('spin', 0, XL, 24.6, 2.1, 25.2);\n  zb('maw', 0, 7.5, 25.3, 11.3, 27.2); zb('harb', 0, 11.7, 24.85, 13.0, 26.0);\n  \n\n  // ---- ramps: centreline [x,y,z], ridden as a rail\n  function mkRail(side) {\n    var m = side ? mir : function (x) { return x; }, p = [], i, a;\n    p.push([4.4, 24.2, 0]); p.push([4.4, 27.0, 1.5]); p.push([4.4, 29.8, 2.6]);\n    for (i = 1; i <= 10; i++) { a = Math.PI * i / 10; p.push([2.8 + 1.6 * Math.cos(a), 29.8 + 1.6 * Math.sin(a), 2.6]); }\n    p.push([1.2, 26, 2.3]); p.push([1.2, 20, 1.8]); p.push([1.2, 15.4, 1.3]);\n    p.push([1.32, 14.5, 1.15]); p.push([1.75, 13.7, 1.0]); p.push([2.4, 13.15, 0.85]); p.push([2.85, 12.75, 0.7]); p.push([2.85, 12.4, 0.6]);\n    var pts = p.map(function (q) { return [m(q[0]), q[1], q[2]]; }), cum = [0], L = 0;\n    for (i = 1; i < pts.length; i++) { L += Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]); cum.push(L); }\n    return { p: pts, cum: cum, len: L, crest: cum[2] + 0.2, side: side, id: side, shot: side ? 4 : 1, hw: 1.05, rw: 0.95, pl: cum[2] + 5.4 };\n  }\n  rails.push(mkRail(0), mkRail(1));\n  (function () { // the Skyway: up the middle, round the lighthouse, across the top arch and down to the right inlane\n    var p = [[6.45, 24.2, 0], [6.45, 27, 1.6], [6.45, 29.5, 3.0], [6.3, 31.5, 3.2], [5.6, 34.2, 3.35], [4.6, 36.8, 3.45], [3.9, 39.2, 3.5]], a, i, cum = [0], L = 0;\n    for (a = 30; a <= 300; a += 18) p.push([1.9 + 1.75 * Math.cos(a * Math.PI / 180), 40.1 + 1.75 * Math.sin(a * Math.PI / 180), 3.5]);\n    p.push([3.9, 38.75, 3.45]);\n    for (a = 128; a >= 12; a -= 8) p.push([AX + 8.9 * Math.cos(a * Math.PI / 180), AY + 8.9 * Math.sin(a * Math.PI / 180), 3.4 - (128 - a) / 116 * 0.9]);\n    p.push([19.2, 31.5, 2.4], [19.2, 18, 1.6], [19.0, 16, 1.45], [18.3, 14.6, 1.25], [17.05, 13.7, 1.0], [16.4, 13.15, 0.85], [15.95, 12.75, 0.7], [15.95, 12.4, 0.6]);\n    for (i = 1; i < p.length; i++) { L += Math.hypot(p[i][0] - p[i - 1][0], p[i][1] - p[i - 1][1]); cum.push(L); }\n    rails.push({ p: p, cum: cum, len: L, crest: cum[2] + 0.2, side: 1, id: 2, shot: 6, hw: 0.72, rw: 0.7, pl: cum[3] });\n  })();\n  function railAt(rl, s, out) {\n    var c = rl.cum, i = 1; while (i < c.length - 1 && c[i] < s) i++;\n    var a = rl.p[i - 1], b = rl.p[i], l = c[i] - c[i - 1], f = Math.max(0, Math.min(1, (s - c[i - 1]) / l));\n    out.x = a[0] + (b[0] - a[0]) * f; out.y = a[1] + (b[1] - a[1]) * f; out.z = a[2] + (b[2] - a[2]) * f;\n    out.tx = (b[0] - a[0]) / l; out.ty = (b[1] - a[1]) / l; out.dz = (b[2] - a[2]) / l; return out;\n  }\n\n  // ---- lamps: [id, x, y, shape, label]\n  function lamp(id, x, y, shape, label) { lampIx[id] = lamps.length; lamps.push({ id: id, x: x, y: y, sh: shape, lb: label || '' }); }\n  var SHOTX = [1.2, 4.4, CX, 12.35, 14.4, 17.6, 6.45], SHOTY = [22.3, 22.3, 22.6, 22.6, 22.3, 22.3, 22.5], SHOTN = ['LEFT ORBIT', 'LEFT RAMP', 'KRAKEN', 'HARBOUR', 'RIGHT RAMP', 'RIGHT ORBIT', 'SKYWAY'], NS = 7;\n  SHOTX.forEach(function (x, i) { lamp('s' + i, x, SHOTY[i], 'arrow'); });\n  ['S', 'E', 'A'].forEach(function (c, i) { lamp('t' + i, 7.4 + 2 * i, 35.5, 'dot', c); });\n  [[2.65, 23.2], [1.5, 18.0], [16.15, 23.2]].forEach(function (p, i) { lamp('f' + i, p[0], p[1], 'dot', 'FOG'[i]); });\n  [[8.2, 21.3], [9.4, 20.9], [10.6, 21.3]].forEach(function (p, i) { lamp('k' + i, p[0], p[1], 'dot', 'LOCK'); });\n  var MNAME = ['FOG BANK', 'TIDE RACE', 'STORM CELLS', 'SALVAGE', 'MAELSTROM'];\n  for (var mi = 0; mi < 5; mi++) { var ma = (198 + 36 * mi) * Math.PI / 180; lamp('m' + mi, CX + 3.3 * Math.cos(ma), 17.3 + 3.3 * Math.sin(ma), 'dot', MNAME[mi].split(' ')[0]); }\n  lamp('wiz', CX, 17.3, 'big', 'EYE');\n  for (var bi = 0; bi < 5; bi++) lamp('x' + bi, 7.0 + 1.2 * bi, 10.4, 'dot', (bi + 2) + 'X');\n  lamp('save', CX, 6.9, 'big', 'SHOOT AGAIN'); lamp('kick', 1.15, 11.4, 'dot', 'KICK'); lamp('extra', 12.35, 20.9, 'dot', 'EXTRA'); lamp('start', 12.35, 19.6, 'dot', 'START');\n  lamp('beam', 6.45, 20.9, 'dot', '2X'); lamp('in0', 2.85, 10.9, 'dot'); lamp('in1', mir(2.85), 10.9, 'dot'); lamp('gate', 4.6, 38.4, 'dot', 'LOOP');\n  lamp('jl', 4.4, 20.9, 'dot', 'JACKPOT'); lamp('jr', 14.4, 20.9, 'dot', 'JACKPOT'); lamp('sup', CX, 19.6, 'dot', 'SUPER');\n\n  var FL = [{ px: 5.65, py: 5.6, dir: 1 }, { px: mir(5.65), py: 5.6, dir: -1 }];\n  var OV = {};\n  var FLEN = OV.len || 3.15, FR0 = 0.55, FR1 = 0.3, FREST = -(OV.rest || 34) * Math.PI / 180, FUP = (OV.up || 26) * Math.PI / 180, FACC = OV.acc || 1500, FWMAX = OV.w || 30, FWDN = 16, FE = OV.e == null ? 0.5 : OV.e, FMU = OV.mu == null ? 0.05 : OV.mu;\n  var T = { R: R, G: G, CX: CX, XL: XL, XR: XR, XS: XS, AX: AX, AY: AY, AR: AR, W: 20.25, H: 42, segs: segs, circs: circs, sens: sens, rails: rails, lamps: lamps, lampIx: lampIx, FL: FL, FLEN: FLEN, FR0: FR0, FR1: FR1, FREST: FREST, FUP: FUP, DROPS: DROPS, SHOTX: SHOTX, SHOTY: SHOTY, SHOTN: SHOTN, MNAME: MNAME, WHIRL: [CX, 17.3], railAt: railAt, PLY: 2.2 };\n\n  function create(seed) {\n    var rs = (seed | 0) || 12345;\n    function rnd() { rs ^= rs << 13; rs ^= rs >>> 17; rs ^= rs << 5; return ((rs >>> 0) % 100000) / 100000; }\n    var balls = [], ev = [], acc = 0, nextId = 1, tmp = {};\n    var flip = FL.map(function (f) { return { px: f.px, py: f.py, dir: f.dir, a: FREST, w: 0, on: 0 }; });\n    var S = { state: 'attract', t: 0, score: 0, ball: 0, balls: 3, lamp: new Uint8Array(lamps.length), hi: 0 };\n    function E() { ev.push(Array.prototype.slice.call(arguments)); }\n    function msg(a, b, pr) { E('msg', a, b || '', pr || 1); }\n    function add(n) { if (S.tilted) return; n = Math.round(n * (S.beamT > 0 ? 2 : 1)); S.score += n; return n; }\n\n    function newGame() {\n      S.state = 'play'; S.score = 0; S.ball = 0; S.extra = 0; S.t = 0;\n      S.mis = [0, 0, 0, 0, 0]; S.cur = -1; S.sel = 0; S.locks = 0; S.lockLit = 0; S.mb = ''; S.wizDone = 0; S.misDone = 0; S.extraLit = 0; S.extraGiven = 0;\n      S.jp = 150000; S.kick = 1; S.bx = 1; balls.length = 0; S.queue = 0; S.held = [];\n      resetDrops(); nextBall();\n    }\n    function nextBall() {\n      S.ball++; S.state = 'play'; S.tilted = 0; S.tilt = 0; S.top = [0, 0, 0]; S.fog = [0, 0, 0];\n      S.bon = { bump: 0, ramp: 0, orb: 0, tgt: 0, mis: 0 }; S.combo = 0; S.comboT = -9; S.beamT = 0; S.orbN = 0; S.saveT = -1; S.saveArm = 1;\n      S.skill = (rnd() * 3) | 0; S.skillOn = 1; S.spinV = 1000; S.inl = [0, 0]; S.loopT = -9; S.jl = [0, 0]; S.sup = 0; S.wz = null;\n      S.queue = 1; S.auto = 0; E('ballstart', S.ball); msg('BALL ' + S.ball, 'PULL BACK TO LAUNCH', 2);\n    }\n    function resetDrops() { S.drop = [1, 1, 1]; DROPS.forEach(function (d) { d.on = 1; }); E('dropreset'); }\n    function spawn() { var b = { id: nextId++, x: XS - 0.72, y: T.PLY, vx: 0, vy: 0, m: 0, z: 0, rl: null, s: 0, sv: 0, crest: 0, hold: null, ht: 0, in: 0, still: 0, lane: 1, kicks: 0, spin: 0 }; balls.push(b); return b; }\n    function laneBall() { for (var i = 0; i < balls.length; i++) if (balls[i].m === 0 && balls[i].lane && balls[i].y < 5 && Math.abs(balls[i].vy) < 3) return balls[i]; return null; }\n    function laneBusy() { for (var i = 0; i < balls.length; i++) if (balls[i].m === 0 && balls[i].x > XR && balls[i].y < 31) return true; return false; }\n    function plunge(p) { var b = laneBall(); if (!b || S.state !== 'play') return false; b.vy = 46 + 48 * Math.max(0, Math.min(1, p)); b.vx = 0; E('launch', p); return true; }\n    function inPlay() { var n = 0; for (var i = 0; i < balls.length; i++) if (balls[i].m !== 2 || balls[i].hold !== 'lock') n++; return n; }\n\n    // ---- rules\n    function lit(i) { // is shot i lit for something, and what colour\n      if (S.wz) return S.wz[i] ? 3 : 0;\n      if (S.mb === 'kraken') { if (S.sup) return i === 2 ? 3 : 0; if (i === 1 && S.jl[0]) return 3; if (i === 4 && S.jl[1]) return 3; return i === 6 ? 3 : 0; }\n      if (S.cur >= 0) return S.need && S.need[i] ? 2 : 0;\n      if (i === 3) return 4; if (i === 2 && S.lockLit) return 6;\n      return 0;\n    }\n    function comboHit() { S.combo = (S.t - S.comboT < 5) ? Math.min(S.combo + 1, 6) : 1; S.comboT = S.t; if (S.combo > 1) { E('combo', S.combo); msg(S.combo + 'X COMBO', '', 1); } return S.combo; }\n    function shot(i) {\n      var c = 1, v;\n      if (i !== 2 && i !== 3) { c = comboHit(); v = add((i === 6 ? 60000 : i === 1 || i === 4 ? 25000 : 15000) * c); if (i === 1 || i === 4 || i === 6) S.bon.ramp++; else S.bon.orb++; }\n      if (i === 6) { S.beamT = Math.max(S.beamT, 20); E('beam'); if (!S.mb && !S.wz) msg('SKYWAY', 'LIGHTHOUSE LIT  2X SCORING', 2); }\n      E('shot', i, c);\n      if (S.wz) { if (S.wz[i]) { S.wz[i] = 0; v = add(S.jp * 2); S.wzN++; E('jackpot', v, 'wiz'); msg('STORM JACKPOT', fmt(v), 3); if (S.wzN % NS === 0) { S.wz = [1, 1, 1, 1, 1, 1, 1]; v = add(2000000); E('super', v); msg('EYE OF THE STORM', fmt(v), 3); } } return; }\n      if (S.mb === 'kraken') {\n        if (S.sup && i === 2) { v = add(S.jp * 3); S.sup = 0; S.jl = [1, 1]; S.jp += 50000; E('super', v); msg('SUPER JACKPOT', fmt(v), 3); }\n        else if (i === 6) { v = add(S.jp * 2); E('jackpot', v, 'kraken'); msg('DOUBLE JACKPOT', fmt(v), 3); }\n        else if (i === 1 && S.jl[0] || i === 4 && S.jl[1]) { S.jl[i === 1 ? 0 : 1] = 0; v = add(S.jp); E('jackpot', v, 'kraken'); msg('JACKPOT', fmt(v), 3); if (!S.jl[0] && !S.jl[1]) { S.sup = 1; msg('SUPER JACKPOT LIT', 'SHOOT THE KRAKEN', 2); } }\n        return;\n      }\n      if (S.cur >= 0 && S.need && S.need[i]) missionHit(i);\n      if (i === 0 || i === 5) { S.orbN++; if (S.orbN % 4 === 0) { S.beamT = 30; E('beam'); msg('LIGHTHOUSE BEAM', 'DOUBLE SCORING', 2); } }\n    }\n    var MGOAL = [4, 4, 20, 6, 3], MTIME = [45, 45, 60, 50, 50];\n    function startMission(i) {\n      S.cur = i; S.mis[i] = Math.max(S.mis[i], 1); S.mp = 0; S.mt = MTIME[i]; S.need = [0, 0, 0, 0, 0, 0, 0];\n      if (i === 0) fogNext(-1); if (i === 1) { S.need[1] = S.need[4] = S.need[6] = 1; } if (i === 2) S.need[5] = 1; if (i === 4) { S.need[0] = S.need[5] = 1; }\n      if (i === 3 && !S.drop[0] && !S.drop[1] && !S.drop[2]) resetDrops();\n      E('mission', i, 'start'); msg(MNAME[i], ['FOLLOW THE LIGHTS', 'SHOOT 4 RAMPS', '20 BUMPER HITS', 'HIT 6 TARGETS', 'SHOOT 3 ORBITS'][i], 3);\n    }\n    function fogNext(prev) { var o = [0, 1, 4, 5, 6], j; do { j = o[(rnd() * 5) | 0]; } while (j === prev); S.need = [0, 0, 0, 0, 0, 0, 0]; S.need[j] = 1; }\n    function missionHit(i) {\n      S.mp++; var v = add(40000 + 10000 * S.mp); E('mission', S.cur, 'hit', S.mp); msg(MNAME[S.cur], S.mp + ' / ' + MGOAL[S.cur], 1);\n      if (S.cur === 0 && S.mp < MGOAL[0]) fogNext(i);\n      if (S.mp >= MGOAL[S.cur]) endMission(true);\n    }\n    function endMission(win) {\n      var i = S.cur, v; if (i < 0) return; S.cur = -1; S.need = null;\n      if (win) { S.mis[i] = 2; S.misDone++; S.bon.mis++; v = add(250000 + Math.round(S.mt) * 2000); E('mission', i, 'done', v); msg(MNAME[i] + ' COMPLETE', fmt(v), 3); if (S.misDone >= 3 && !S.extraGiven) S.extraLit = 1; }\n      else { E('mission', i, 'fail'); msg(MNAME[i], 'TIME UP', 2); }\n      var k = 0; while (k < 5 && S.mis[(S.sel + k) % 5]) k++; S.sel = (S.sel + k) % 5;\n    }\n    function allPlayed() { return S.mis[0] && S.mis[1] && S.mis[2] && S.mis[3] && S.mis[4]; }\n    function fmt(n) { return String(Math.round(n)).replace(/\\B(?=(\\d{3})+(?!\\d))/g, ','); }\n    function target() { S.bon.tgt++; if (S.cur === 3) missionHit(-1); }\n    function harbour(b) {\n      hold(b, 'harb', 1.4);\n      if (S.extraLit) { S.extraLit = 0; S.extraGiven = 1; S.extra++; E('extra'); msg('EXTRA BALL', '', 3); }\n      if (S.mb || S.cur >= 0 || S.wz) { add(25000); shot(3); return; }\n      if (allPlayed() && !S.wizDone) { startWizard(); return; }\n      if (allPlayed()) { S.mis = [0, 0, 0, 0, 0]; S.wizDone = 0; S.sel = 0; }\n      add(20000); E('shot', 3, 1); startMission(S.sel);\n    }\n    function maw(b) {\n      if (S.mb || S.wz) { hold(b, 'maw', 0.9); shot(2); return; }\n      if (S.lockLit) {\n        S.locks++; S.lockLit = 0; add(50000); E('lock', S.locks);\n        if (S.locks >= 3) { hold(b, 'maw', 2.2); startKraken(); return; }\n        msg('BALL ' + S.locks + ' LOCKED', (3 - S.locks) + ' MORE FOR MULTIBALL', 3);\n        b.hold = 'lock'; b.m = 2; b.ht = 0.6; return;\n      }\n      hold(b, 'maw', 1.0); add(10000); E('shot', 2, 1); if (S.cur >= 0 && S.need && S.need[2]) missionHit(2);\n    }\n    function startKraken() { S.mb = 'kraken'; S.locks = 0; S.jl = [1, 1]; S.sup = 0; S.saveT = 18; S.mbSpit = 2; S.mbT = 2.2; if (S.cur >= 0) S.mt += 20; E('mb', 'kraken'); msg('KRAKEN MULTIBALL', 'RAMPS SCORE JACKPOTS', 3); }\n    function startWizard() { S.wz = [1, 1, 1, 1, 1, 1, 1]; S.wzN = 0; S.wizDone = 1; S.saveT = 30; S.queue += 3; S.auto = 1; S.mb = 'wiz'; E('mb', 'wiz'); msg('EYE OF THE STORM', 'EVERY SHOT IS A JACKPOT', 3); }\n    function endMultiball() { if (S.mb === 'kraken') resetDrops(); S.mb = ''; S.wz = null; S.sup = 0; S.jl = [0, 0]; E('mbend'); msg('MULTIBALL OVER', '', 2); }\n    function hold(b, k, t) { b.m = 2; b.hold = k; b.ht = t; b.vx = b.vy = 0; E('scoop', k); }\n\n    function sensor(b, z) {\n      var k = z.k, v;\n      if (S.skillOn && k !== 'top' && k !== 'orb' && k !== 'spin') S.skillOn = 0;\n      if (k === 'top') {\n        add(5000);\n        if (S.skillOn) { S.skillOn = 0; if (z.id === S.skill && S.t < S.skillT) { v = add(100000 * S.ball); E('skill', v); msg('SKILL SHOT', fmt(v), 3); } }\n        if (!S.top[z.id]) { S.top[z.id] = 1; E('lane', z.id); if (S.top[0] && S.top[1] && S.top[2]) { S.top = [0, 0, 0]; if (S.bx < 6) S.bx++; add(25000); E('bonusx', S.bx); msg('BONUS ' + S.bx + 'X', '', 2); } }\n      } else if (k === 'inl') { add(3000); S.inl[z.id] = S.t; E('inlane', z.id); }\n      else if (k === 'outl') {\n        add(10000); E('outlane', z.id);\n        if (z.id === 0 && S.kick && !S.tilted) { S.kick = 0; b.vx = 0.4; b.vy = 52; b.y = Math.max(b.y, 9.0); E('kickback'); msg('KICKBACK', '', 2); }\n      } else if (k === 'orb') {\n        if (b.vy > 25) { b.orb = z.id; b.orbT = S.t; shot(z.id ? 5 : 0); }\n        else if (b.vy < -8 && b.orb != null && b.orb !== z.id && S.t - b.orbT < 4) { v = add(20000); b.orb = null; E('loop', v); msg('FULL LOOP', fmt(v), 1); }\n      } else if (k === 'spin') { b.spin = Math.min(14, Math.round(Math.abs(b.vy) / 6)); }\n      else if (k === 'maw') maw(b);\n      else if (k === 'harb') harbour(b);\n    }\n    function hitSeg(b, s, vn) {\n      var k = s.k;\n      if (k === 'sling') { add(500); E('sling', s.id); if (S.cur < 0 && !S.mb) { var q = 0; do { S.sel = (S.sel + 1) % 5; q++; } while (S.mis[S.sel] && q < 5); } }\n      else if (k === 'standup') {\n        add(4000); E('standup', s.id); target();\n        if (!S.fog[s.id]) { S.fog[s.id] = 1; if (S.fog[0] && S.fog[1] && S.fog[2]) { S.fog = [0, 0, 0]; S.kick = 1; add(50000); S.beamT = Math.max(S.beamT, 20); E('fog'); msg('FOG CLEARED', 'KICKBACK LIT  2X SCORING', 2); } }\n      } else if (k === 'drop') {\n        s.on = 0; S.drop[s.id] = 0; add(8000); E('drop', s.id); target();\n        if (!S.drop[0] && !S.drop[1] && !S.drop[2]) {\n          if (S.cur === 3) { S.dropT = 1.0; }\n          else if (!S.mb && !S.lockLit) { S.lockLit = 1; E('locklit'); msg('LOCK IS LIT', 'FEED THE KRAKEN', 2); }\n        }\n      }\n    }\n    function drain(b) {\n      E('drain', b.x);\n      if (S.state !== 'play') return;\n      if ((S.saveT > 0 || (S.saveArm && S.t - (S.lastLaunch || 0) < 0)) && !S.tilted) { S.queue++; S.auto = 1; E('save'); msg('BALL SAVED', '', 2); return; }\n      var n = 0, i; for (i = 0; i < balls.length; i++) if (balls[i].hold !== 'lock') n++;\n      n += S.queue + (S.mbSpit || 0);\n      if (S.mb && n <= 1) endMultiball();\n      if (n === 0) endBall();\n    }\n    function endBall() {\n      if (S.cur >= 0) endMission(false);\n      var it = [['BUMPERS', S.bon.bump * 500], ['RAMPS', S.bon.ramp * 5000], ['ORBITS', S.bon.orb * 5000], ['TARGETS', S.bon.tgt * 2000], ['MISSIONS', S.bon.mis * 50000]];\n      var tot = 0; it.forEach(function (x) { tot += x[1]; }); tot *= S.bx; if (S.tilted) tot = 0;\n      S.score += tot; S.state = 'bonus'; S.bt = S.tilted ? 1.2 : 3.2; E('bonus', it, S.bx, tot);\n      // locked balls stay locked (virtual), remove them from the table list\n      for (var i = balls.length - 1; i >= 0; i--) balls.splice(i, 1);\n    }\n    function afterBonus() {\n      if (S.extra > 0) { S.extra--; S.ball--; nextBall(); msg('SHOOT AGAIN', '', 3); return; }\n      if (S.ball >= S.balls) { S.state = 'over'; if (S.score > S.hi) S.hi = S.score; E('gameover', S.score); return; }\n      S.bx = 1; nextBall();\n    }\n    function nudge(dx) {\n      if (S.state !== 'play' || S.tilted) return;\n      for (var i = 0; i < balls.length; i++) if (balls[i].m === 0) { balls[i].vx += dx * 9; balls[i].vy += 5; }\n      S.tilt += 1; E('nudge', dx);\n      if (S.tilt > 2.6) { S.tilted = 1; S.saveT = 0; flip[0].on = flip[1].on = 0; E('tilt'); msg('TILT', '', 3); }\n      else if (S.tilt > 1.5) { E('warn'); msg('DANGER', '', 2); }\n    }\n    function input(l, r) {\n      if (S.tilted || S.state !== 'play') { l = r = 0; }\n      if (l && !flip[0].on) { E('flip', 0); S.top = [S.top[1], S.top[2], S.top[0]]; if (S.skillOn) S.skill = (S.skill + 2) % 3; }\n      if (r && !flip[1].on) { E('flip', 1); S.top = [S.top[2], S.top[0], S.top[1]]; if (S.skillOn) S.skill = (S.skill + 1) % 3; }\n      flip[0].on = l ? 1 : 0; flip[1].on = r ? 1 : 0;\n    }\n\n    // ---- physics\n    function collideSeg(b, s) {\n      if (b.x < s.a || b.x > s.b || b.y < s.c || b.y > s.d) return;\n      var dx = s.x2 - s.x1, dy = s.y2 - s.y1, l2 = dx * dx + dy * dy, t = ((b.x - s.x1) * dx + (b.y - s.y1) * dy) / l2;\n      t = t < 0 ? 0 : t > 1 ? 1 : t;\n      var px = s.x1 + dx * t, py = s.y1 + dy * t, nx = b.x - px, ny = b.y - py, d2 = nx * nx + ny * ny;\n      if (d2 >= R * R || d2 < 1e-9) return;\n      var d = Math.sqrt(d2); nx /= d; ny /= d;\n      var vn = b.vx * nx + b.vy * ny;\n      if (s.ow) { var l = Math.sqrt(l2), ox = -dy / l, oy = dx / l; if ((b.x - s.x1) * ox + (b.y - s.y1) * oy <= 0 || b.vx * ox + b.vy * oy > 0.5) return; }\n      b.x = px + nx * R; b.y = py + ny * R;\n      if (vn >= 0) return;\n      var e = vn > -7 ? 0 : s.e, tx = -ny, ty = nx, vt = b.vx * tx + b.vy * ty;\n      if (s.k === 'sling' && vn < -9 && t > 0.12 && t < 0.88) { b.vx -= vn * nx; b.vy -= vn * ny; b.vx += nx * (46 + rnd() * 10) + tx * (rnd() - 0.5) * 8; b.vy += ny * 50; hitSeg(b, s, vn); return; }\n      b.vx -= (1 + e) * vn * nx; b.vy -= (1 + e) * vn * ny;\n      var fr = Math.min(Math.abs(vt), 0.06 * (1 + e) * -vn); b.vx -= fr * Math.sign(vt) * tx; b.vy -= fr * Math.sign(vt) * ty;\n      if (vn < -3) { if (s.k !== 'wall' && s.k !== 'gate' && s.k !== 'plfloor') { if (vn < -6) hitSeg(b, s, vn); } if (vn < -14) E('knock', b.x, b.y, -vn, s.sty); }\n    }\n    function collideCirc(b, c) {\n      var nx = b.x - c.x, ny = b.y - c.y, rr = R + c.r, d2 = nx * nx + ny * ny;\n      if (d2 >= rr * rr || d2 < 1e-9) return;\n      var d = Math.sqrt(d2); nx /= d; ny /= d; b.x = c.x + nx * rr; b.y = c.y + ny * rr;\n      var vn = b.vx * nx + b.vy * ny;\n      if (c.k === 'bumper') {\n        if (vn < -2) { b.vx -= vn * nx; b.vy -= vn * ny; var k = 50 + rnd() * 10; b.vx += nx * k; b.vy += ny * k; add(1000 + (S.cur === 2 ? 2000 : 0)); S.bon.bump++; E('bumper', c.id); if (S.cur === 2) { S.mp++; if (S.mp % 5 === 0) msg('STORM CELLS', S.mp + ' / 20', 1); if (S.mp >= 20) endMission(true); } }\n        return;\n      }\n      if (vn >= 0) return; var e = vn > -7 ? 0 : c.e; b.vx -= (1 + e) * vn * nx; b.vy -= (1 + e) * vn * ny; if (vn < -14) E('knock', b.x, b.y, -vn, 'post');\n    }\n    function collideFlip(b, f) {\n      var ca = Math.cos(f.a), sa = Math.sin(f.a), dx = f.dir * ca * FLEN, dy = sa * FLEN;\n      var rx = b.x - f.px, ry = b.y - f.py; if (rx * rx + ry * ry > 22) return;\n      var t = (rx * dx + ry * dy) / (FLEN * FLEN); t = t < 0 ? 0 : t > 1 ? 1 : t;\n      var px = f.px + dx * t, py = f.py + dy * t, nx = b.x - px, ny = b.y - py, rr = R + FR0 + (FR1 - FR0) * t, d2 = nx * nx + ny * ny;\n      if (d2 >= rr * rr || d2 < 1e-9) return;\n      var d = Math.sqrt(d2); nx /= d; ny /= d; b.x = px + nx * rr; b.y = py + ny * rr;\n      if (t === 0 && !f.on && (b.x - f.px) * f.dir < 0.25) b.vx += f.dir * 30 * DT; // no resting place where the lane guide meets the flipper\n      var cx = b.x - nx * R - f.px, cy = b.y - ny * R - f.py, w = f.w * f.dir, sx = -w * cy, sy = w * cx;\n      var ux = b.vx - sx, uy = b.vy - sy, vn = ux * nx + uy * ny; if (vn >= 0) return;\n      var e = vn > -10 ? 0 : FE, tx = -ny, ty = nx, vt = ux * tx + uy * ty;\n      b.vx -= (1 + e) * vn * nx; b.vy -= (1 + e) * vn * ny;\n      var fr = Math.min(Math.abs(vt), FMU * (1 + e) * -vn); b.vx -= fr * Math.sign(vt) * tx; b.vy -= fr * Math.sign(vt) * ty;\n      if (vn < -16) E('knock', b.x, b.y, -vn, 'flip');\n    }\n    function stepFlip(f) {\n      if (f.on) { if (f.a < FUP) { f.w = Math.min(FWMAX, f.w + FACC * DT); f.a += f.w * DT; if (f.a >= FUP) { f.a = FUP; f.w = 0; } } else f.w = 0; }\n      else { if (f.a > FREST) { f.w = Math.max(-FWDN, f.w - FACC * DT); f.a += f.w * DT; if (f.a <= FREST) { f.a = FREST; f.w = 0; } } else f.w = 0; }\n    }\n    function inZone(b, z) { if (z.r) { var dx = b.x - z.x, dy = b.y - z.y; return dx * dx + dy * dy < z.r * z.r; } return b.x > z.x0 && b.x < z.x1 && b.y > z.y0 && b.y < z.y1; }\n    function eject(b) {\n      var k = b.hold; b.m = 0; b.hold = null; b.in = 0; b.still = 0;\n      if (k === 'maw') { b.x = CX + (rnd() - 0.5) * 0.6; b.y = 23.4; b.vx = -3.4 - rnd() * 1.2; b.vy = -30; }\n      else { b.x = 12.35; b.y = 23.6; b.vx = -1.5 + rnd() * 0.5; b.vy = -30; }\n      E('eject', k);\n    }\n    function stepBall(b) {\n      var i, z, s;\n      if (b.m === 2) return;\n      if (b.m === 1) {\n        var rl = b.rl; railAt(rl, b.s, tmp);\n        b.sv += (-G * tmp.ty - KZ * tmp.dz) * DT - 0.25 * b.sv * DT;\n        if (b.crest) { if (b.sv > 34) b.sv = 34; if (b.sv < 7) b.sv = 7; }\n        b.s += b.sv * DT;\n        if (!b.crest && b.s > rl.crest) { b.crest = 1; E('rampup', rl.id); shot(rl.shot); }\n        if (b.s <= 0) { b.m = 0; b.rl = null; b.z = 0; b.x = rl.p[0][0]; b.y = 23.9; b.vx = 0; b.vy = Math.min(-4, b.sv); b.in = 0; E('rampfail', rl.id); return; }\n        if (b.s >= rl.len) { railAt(rl, rl.len, tmp); b.m = 0; b.rl = null; b.z = 0; b.x = tmp.x; b.y = tmp.y; b.vx = 0; b.vy = -Math.min(30, Math.max(12, b.sv)); b.in = 0; E('rampdrop', rl.id); return; }\n        railAt(rl, b.s, tmp); b.x = tmp.x; b.y = tmp.y; b.z = tmp.z; b.vx = tmp.tx * b.sv; b.vy = tmp.ty * b.sv; return;\n      }\n      b.vy -= G * DT;\n      if (S.cur === 4 || S.wz) { var wx = T.WHIRL[0] - b.x, wy = T.WHIRL[1] - b.y, wd = Math.hypot(wx, wy); if (wd < 4.6 && wd > 0.2) { var wf = 95 * (1 - wd / 4.6); b.vx += (wx / wd * wf - wy / wd * wf * 0.9) * DT; b.vy += (wy / wd * wf + wx / wd * wf * 0.9 + G * 0.5) * DT; } }\n      var sp = b.vx * b.vx + b.vy * b.vy; if (sp > VMAX * VMAX) { sp = VMAX / Math.sqrt(sp); b.vx *= sp; b.vy *= sp; }\n      b.x += b.vx * DT; b.y += b.vy * DT;\n      // ramp capture before the mouth's back wall\n      if (b.vy > 6 && b.y > 23.55 && b.y < 24.9) { for (i = 0; i < rails.length; i++) { var m