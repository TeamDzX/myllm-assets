94b1\",\"pinyin\":\"qi\\u00e1n\",\"english\":\"money\"}]},{\"chinese\":\"\\u94f6\\u884c\\u91cc\\u4eba\\u5f88\\u591a\\uff0c\\u6211\\u8981\\u6392\\u961f\\u3002\",\"pinyin\":\"Y\\u00ednh\\u00e1ng l\\u01d0 r\\u00e9n h\\u011bn du\\u014d, w\\u01d2 y\\u00e0o p\\u00e1idu\\u00ec.\",\"english\":\"There were many people in the bank, so I had to queue.\",\"words\":[{\"hanzi\":\"\\u94f6\\u884c\\u91cc\",\"pinyin\":\"y\\u00ednh\\u00e1ng l\\u01d0\",\"english\":\"in the bank\"},{\"hanzi\":\"\\u4eba\",\"pinyin\":\"r\\u00e9n\",\"english\":\"people\"},{\"hanzi\":\"\\u5f88\\u591a\",\"pinyin\":\"h\\u011bn du\\u014d\",\"english\":\"many\"},{\"hanzi\":\"\\u6392\\u961f\",\"pinyin\":\"p\\u00e1idu\\u00ec\",\"english\":\"to queue\"}]},{\"chinese\":\"\\u5de5\\u4f5c\\u4eba\\u5458\\u5f88\\u70ed\\u60c5\\uff0c\\u5e2e\\u6211\\u529e\\u597d\\u4e86\\u3002\",\"pinyin\":\"G\\u014dngzu\\u00f2 r\\u00e9nyu\\u00e1n h\\u011bn r\\u00e8q\\u00edng, b\\u0101ng w\\u01d2 b\\u00e0n h\\u01ceo le.\",\"english\":\"The staff were warm and helped me finish.\",\"words\":[{\"hanzi\":\"\\u5de5\\u4f5c\\u4eba\\u5458\",\"pinyin\":\"g\\u014dngzu\\u00f2 r\\u00e9nyu\\u00e1n\",\"english\":\"staff\"},{\"hanzi\":\"\\u70ed\\u60c5\",\"pinyin\":\"r\\u00e8q\\u00edng\",\"english\":\"warm, enthusiastic\"},{\"hanzi\":\"\\u5e2e\",\"pinyin\":\"b\\u0101ng\",\"english\":\"to help\"},{\"hanzi\":\"\\u529e\\u597d\",\"pinyin\":\"b\\u00e0n h\\u01ceo\",\"english\":\"to finish (a task)\"}]},{\"chinese\":\"\\u529e\\u5b8c\\u4ee5\\u540e\\uff0c\\u6211\\u5c31\\u56de\\u5bb6\\u4e86\\u3002\",\"pinyin\":\"B\\u00e0n w\\u00e1n y\\u01d0h\\u00f2u, w\\u01d2 ji\\u00f9 hu\\u00edji\\u0101 le.\",\"english\":\"After finishing, I went home.\",\"words\":[{\"hanzi\":\"\\u529e\\u5b8c\",\"pinyin\":\"b\\u00e0n w\\u00e1n\",\"english\":\"to finish\"},{\"hanzi\":\"\\u4ee5\\u540e\",\"pinyin\":\"y\\u01d0h\\u00f2u\",\"english\":\"after\"},{\"hanzi\":\"\\u5c31\",\"pinyin\":\"ji\\u00f9\",\"english\":\"then\"},{\"hanzi\":\"\\u56de\\u5bb6\",\"pinyin\":\"hu\\u00edji\\u0101\",\"english\":\"to go home\"}]}],\"questions\":[{\"question\":\"Where did the narrator go?\",\"options\":[\"The post office\",\"The bank\",\"The market\",\"The library\"],\"correct\":1},{\"question\":\"What did the narrator want to do?\",\"options\":[\"Open an account\",\"Exchange some money\",\"Get a loan\",\"Pay a bill\"],\"correct\":1},{\"question\":\"Why did the narrator have to wait?\",\"options\":[\"The bank was closed\",\"There were many people\",\"The computer broke\",\"No staff\"],\"correct\":1}],\"pack\":\"New Stories \\u00b7 Vol. 4\"},{\"id\":\"pack4_story_midautumn\",\"title\":\"\\u4e2d\\u79cb\\u8282\",\"titlePinyin\":\"Zh\\u014dngqi\\u016bji\\u00e9\",\"titleEnglish\":\"Mid-Autumn Festival\",\"level\":3,\"theme\":\"<i class=\\\"fas fa-moon\\\" style=\\\"color:#6366f1\\\"><\\/i>\",\"image\":\"https://raw.githubusercontent.com/TeamDzX/hanyu-packs/main/images/pack4_story_midautumn.jpg\",\"sentences\":[{\"chinese\":\"\\u4e2d\\u79cb\\u8282\\u662f\\u4e2d\\u56fd\\u7684\\u4f20\\u7edf\\u8282\\u65e5\\u3002\",\"pinyin\":\"Zh\\u014dngqi\\u016bji\\u00e9 sh\\u00ec Zh\\u014dnggu\\u00f3 de chu\\u00e1nt\\u01d2ng ji\\u00e9r\\u00ec.\",\"english\":\"The Mid-Autumn Festival is a traditional Chinese holiday.\",\"words\":[{\"hanzi\":\"\\u4e2d\\u79cb\\u8282\",\"pinyin\":\"Zh\\u014dngqi\\u016bji\\u00e9\",\"english\":\"Mid-Autumn Festival\"},{\"hanzi\":\"\\u662f\",\"pinyin\":\"sh\\u00ec\",\"english\":\"is\"},{\"hanzi\":\"\\u4e2d\\u56fd\",\"pinyin\":\"Zh\\u014dnggu\\u00f3\",\"english\":\"China\"},{\"hanzi\":\"\\u4f20\\u7edf\",\"pinyin\":\"chu\\u00e1nt\\u01d2ng\",\"english\":\"traditional\"},{\"hanzi\":\"\\u8282\\u65e5\",\"pinyin\":\"ji\\u00e9r\\u00ec\",\"english\":\"holiday\"}]},{\"chinese\":\"\\u8fd9\\u4e00\\u5929\\uff0c\\u5bb6\\u4eba\\u4f1a\\u4e00\\u8d77\\u8d4f\\u6708\\u3002\",\"pinyin\":\"Zh\\u00e8 y\\u00ec ti\\u0101n, ji\\u0101r\\u00e9n hu\\u00ec y\\u00ecq\\u01d0 sh\\u01ceng yu\\u00e8.\",\"english\":\"On this day, family members admire the moon together.\",\"words\":[{\"hanzi\":\"\\u8fd9\\u4e00\\u5929\",\"pinyin\":\"zh\\u00e8 y\\u00ec ti\\u0101n\",\"english\":\"this day\"},{\"hanzi\":\"\\u5bb6\\u4eba\",\"pinyin\":\"ji\\u0101r\\u00e9n\",\"english\":\"family\"},{\"hanzi\":\"\\u4e00\\u8d77\",\"pinyin\":\"y\\u00ecq\\u01d0\",\"english\":\"together\"},{\"hanzi\":\"\\u8d4f\\u6708\",\"pinyin\":\"sh\\u01ceng yu\\u00e8\",\"english\":\"to admire the moon\"}]},{\"chinese\":\"\\u6211\\u4eec\\u4e00\\u8fb9\\u5403\\u6708\\u997c\\uff0c\\u4e00\\u8fb9\\u804a\\u5929\\u3002\",\"pinyin\":\"W\\u01d2men y\\u00ecbi\\u0101n ch\\u012b yu\\u00e8b\\u01d0ng, y\\u00ecbi\\u0101n li\\u00e1oti\\u0101n.\",\"english\":\"We eat mooncakes while chatting.\",\"words\":[{\"hanzi\":\"\\u4e00\\u8fb9\",\"pinyin\":\"y\\u00ecbi\\u0101n\",\"english\":\"while (doing two things)\"},{\"hanzi\":\"\\u5403\",\"pinyin\":\"ch\\u012b\",\"english\":\"to eat\"},{\"hanzi\":\"\\u6708\\u997c\",\"pinyin\":\"yu\\u00e8b\\u01d0ng\",\"english\":\"mooncake\"},{\"hanzi\":\"\\u804a\\u5929\",\"pinyin\":\"li\\u00e1oti\\u0101n\",\"english\":\"to chat\"}]},{\"chinese\":\"\\u6708\\u4eae\\u53c8\\u5706\\u53c8\\u4eae\\u3002\",\"pinyin\":\"Yu\\u00e8liang y\\u00f2u yu\\u00e1n y\\u00f2u li\\u00e0ng.\",\"english\":\"The moon is round and bright.\",\"words\":[{\"hanzi\":\"\\u6708\\u4eae\",\"pinyin\":\"yu\\u00e8liang\",\"english\":\"moon\"},{\"hanzi\":\"\\u53c8\",\"pinyin\":\"y\\u00f2u\",\"english\":\"both\\u2026and\"},{\"hanzi\":\"\\u5706\",\"pinyin\":\"yu\\u00e1n\",\"english\":\"round\"},{\"hanzi\":\"\\u4eae\",\"pinyin\":\"li\\u00e0ng\",\"english\":\"bright\"}]},{\"chinese\":\"\\u8fd9\\u4e2a\\u8282\\u65e5\\u8ba9\\u6211\\u4eec\\u56e2\\u5706\\u3002\",\"pinyin\":\"Zh\\u00e8ge ji\\u00e9r\\u00ec r\\u00e0ng w\\u01d2men tu\\u00e1nyu\\u00e1n.\",\"english\":\"This holiday brings us together.\",\"words\":[{\"hanzi\":\"\\u8fd9\\u4e2a\",\"pinyin\":\"zh\\u00e8ge\",\"english\":\"this\"},{\"hanzi\":\"\\u8282\\u65e5\",\"pinyin\":\"ji\\u00e9r\\u00ec\",\"english\":\"holiday\"},{\"hanzi\":\"\\u8ba9\",\"pinyin\":\"r\\u00e0ng\",\"english\":\"to let, make\"},{\"hanzi\":\"\\u56e2\\u5706\",\"pinyin\":\"tu\\u00e1nyu\\u00e1n\",\"english\":\"reunion\"}]}],\"questions\":[{\"question\":\"What kind of holiday is the Mid-Autumn Festival?\",\"options\":[\"A modern one\",\"A traditional Chinese one\",\"A foreign one\",\"A work holiday\"],\"correct\":1},{\"question\":\"What do they eat?\",\"options\":[\"Dumplings\",\"Mooncakes\",\"Noodles\",\"Rice cakes\"],\"correct\":1},{\"question\":\"How is the moon described?\",\"options\":[\"Small and dim\",\"Round and bright\",\"Red\",\"Hidden\"],\"correct\":1}],\"pack\":\"New Stories \\u00b7 Vol. 4\"},{\"id\":\"pack4_story_interview\",\"title\":\"\\u9762\\u8bd5\",\"titlePinyin\":\"mi\\u00e0nsh\\u00ec\",\"titleEnglish\":\"A Job Interview\",\"level\":3,\"theme\":\"<i class=\\\"fas fa-user-tie\\\" style=\\\"color:#ef4444\\\"><\\/i>\",\"image\":\"https://raw.githubusercontent.com/TeamDzX/hanyu-packs/main/images/pack4_story_interview.jpg\",\"sentences\":[{\"chinese\":\"\\u4e0a\\u5468\\u6211\\u53bb\\u4e00\\u5bb6\\u516c\\u53f8\\u9762\\u8bd5\\u3002\",\"pinyin\":\"Sh\\u00e0ng zh\\u014du w\\u01d2 q\\u00f9 y\\u00ec ji\\u0101 g\\u014dngs\\u012b mi\\u00e0nsh\\u00ec.\",\"english\":\"Last week I went to a company for an interview.\",\"words\":[{\"hanzi\":\"\\u4e0a\\u5468\",\"pinyin\":\"sh\\u00e0ng zh\\u014du\",\"english\":\"last week\"},{\"hanzi\":\"\\u53bb\",\"pinyin\":\"q\\u00f9\",\"english\":\"to go\"},{\"hanzi\":\"\\u4e00\\u5bb6\\u516c\\u53f8\",\"pinyin\":\"y\\u00ec ji\\u0101 g\\u014dngs\\u012b\",\"english\":\"a company\"},{\"hanzi\":\"\\u9762\\u8bd5\",\"pinyin\":\"mi\\u00e0nsh\\u00ec\",\"english\":\"interview\"}]},{\"chinese\":\"\\u6211\\u7a7f\\u5f97\\u5f88\\u6b63\\u5f0f\\uff0c\\u4e5f\\u63d0\\u524d\\u5230\\u4e86\\u3002\",\"pinyin\":\"W\\u01d2 chu\\u0101n de h\\u011bn zh\\u00e8ngsh\\u00ec, y\\u011b t\\u00edqi\\u00e1n d\\u00e0o le.\",\"english\":\"I dressed formally and arrived early.\",\"words\":[{\"hanzi\":\"\\u7a7f\",\"pinyin\":\"chu\\u0101n\",\"english\":\"to wear, dress\"},{\"hanzi\":\"\\u6b63\\u5f0f\",\"pinyin\":\"zh\\u00e8ngsh\\u00ec\",\"english\":\"formal\"},{\"hanzi\":\"\\u4e5f\",\"pinyin\":\"y\\u011b\",\"english\":\"also\"},{\"hanzi\":\"\\u63d0\\u524d\",\"pinyin\":\"t\\u00edqi\\u00e1n\",\"english\":\"early, in advance\"},{\"hanzi\":\"\\u5230\",\"pinyin\":\"d\\u00e0o\",\"english\":\"to arrive\"}]},{\"chinese\":\"\\u7ecf\\u7406\\u95ee\\u4e86\\u6211\\u5f88\\u591a\\u95ee\\u9898\\u3002\",\"pinyin\":\"J\\u012bngl\\u01d0 w\\u00e8n le w\\u01d2 h\\u011bn du\\u014d w\\u00e8nt\\u00ed.\",\"english\":\"The manager asked me many questions.\",\"words\":[{\"hanzi\":\"\\u7ecf\\u7406\",\"pinyin\":\"j\\u012bngl\\u01d0\",\"english\":\"manager\"},{\"hanzi\":\"\\u95ee\",\"pinyin\":\"w\\u00e8n\",\"english\":\"to ask\"},{\"hanzi\":\"\\u5f88\\u591a\",\"pinyin\":\"h\\u011bn du\\u014d\",\"english\":\"many\"},{\"hanzi\":\"\\u95ee\\u9898\",\"pinyin\":\"w\\u00e8nt\\u00ed\",\"english\":\"question\"}]},{\"chinese\":\"\\u6211\\u867d\\u7136\\u6709\\u70b9\\u7d27\\u5f20\\uff0c\\u4f46\\u662f\\u56de\\u7b54\\u5f97\\u5f88\\u597d\\u3002\",\"pinyin\":\"W\\u01d2 su\\u012br\\u00e1n y\\u01d2udi\\u01cen j\\u01d0nzh\\u0101ng, d\\u00e0nsh\\u00ec hu\\u00edd\\u00e1 de h\\u011bn h\\u01ceo.\",\"english\":\"Although I was a bit nervous, I answered well.\",\"words\":[{\"hanzi\":\"\\u867d\\u7136\",\"pinyin\":\"su\\u012br\\u00e1n\",\"english\":\"although\"},{\"hanzi\":\"\\u6709\\u70b9\",\"pinyin\":\"y\\u01d2udi\\u01cen\",\"english\":\"a little\"},{\"hanzi\":\"\\u7d27\\u5f20\",\"pinyin\":\"j\\u01d0nzh\\u0101ng\",\"english\":\"nervous\"},{\"hanzi\":\"\\u4f46\\u662f\",\"pinyin\":\"d\\u00e0nsh\\u00ec\",\"english\":\"but\"},{\"hanzi\":\"\\u56de\\u7b54\",\"pinyin\":\"hu\\u00edd\\u00e1\",\"english\":\"to answer\"}]},{\"chinese\":\"\\u51e0\\u5929\\u4ee5\\u540e\\uff0c\\u516c\\u53f8\\u7ed9\\u4e86\\u6211\\u5de5\\u4f5c\\u3002\",\"pinyin\":\"J\\u01d0 ti\\u0101n y\\u01d0h\\u00f2u, g\\u014dngs\\u012b g\\u011bi le w\\u01d2 g\\u014dngzu\\u00f2.\",\"english\":\"A few days later, the company gave me the job.\",\"words\":[{\"hanzi\":\"\\u51e0\\u5929\\u4ee5\\u540e\",\"pinyin\":\"j\\u01d0 ti\\u0101n y\\u01d0h\\u00f2u\",\"english\":\"a few days later\"},{\"hanzi\":\"\\u516c\\u53f8\",\"pinyin\":\"g\\u014dngs\\u012b\",\"english\":\"company\"},{\"hanzi\":\"\\u7ed9\",\"pinyin\":\"g\\u011bi\",\"english\":\"to give\"},{\"hanzi\":\"\\u5de5\\u4f5c\",\"pinyin\":\"g\\u014dngzu\\u00f2\",\"english\":\"job\"}]},{\"chinese\":\"\\u6211\\u975e\\u5e38\\u9ad8\\u5174\\u3002\",\"pinyin\":\"W\\u01d2 f\\u0113ich\\u00e1ng g\\u0101ox\\u00ecng.\",\"english\":\"I was extremely happy.\",\"words\":[{\"hanzi\":\"\\u975e\\u5e38\",\"pinyin\":\"f\\u0113ich\\u00e1ng\",\"english\":\"extremely\"},{\"hanzi\":\"\\u9ad8\\u5174\",\"pinyin\":\"g\\u0101ox\\u00ecng\",\"english\":\"happy\"}]}],\"questions\":[{\"question\":\"Why did the narrator go to the company?\",\"options\":[\"To deliver a package\",\"For a job interview\",\"To meet a friend\",\"To buy something\"],\"correct\":1},{\"question\":\"How did the narrator prepare?\",\"options\":[\"Arrived late\",\"Dressed formally and arrived early\",\"Forgot the time\",\"Wore casual clothes\"],\"correct\":1},{\"question\":\"What was the result?\",\"options\":[\"Got the job\",\"Was rejected\",\"Still waiting\",\"Cancelled\"],\"correct\":0}],\"pack\":\"New Stories \\u00b7 Vol. 4\"}];</script>\n\n<style>\n.hy-cta{display:block;margin:14px;padding:13px 16px;border-radius:14px;text-align:center;font-weight:700;font-size:14px;text-decoration:none;color:#fff;background:linear-gradient(135deg,#4a6bdf,#8b5cf6);box-shadow:0 4px 14px rgba(74,107,223,.35)}\n.hy-cta small{display:block;font-weight:500;opacity:.92;font-size:12px;margin-top:3px}\n</style>\n<script>\n(function(){\n  var RATIO=0.30, APP='https://apps.apple.com/us/app/hanyu-learn-chinese/id6760541929';\n  function keepN(n){ return Math.max(1, Math.ceil(n*RATIO)); }\n  function cut(a){ if(Array.isArray(a) && a.length>1){ a.length=keepN(a.length); } }\n  // Data-driven content: truncate the global source arrays (runs at parse,\n  // before the app's DOMContentLoaded init reads them).\n  try{ if(typeof characters!=='undefined') cut(characters); }catch(e){}\n  try{ if(typeof strokeChallengeCharacters!=='undefined') cut(strokeChallengeCharacters); }catch(e){}\n  try{ if(typeof compoundWords!=='undefined') cut(compoundWords); }catch(e){}\n  try{ if(typeof sentencesDatabase!=='undefined') cut(sentencesDatabase); }catch(e){}\n  // Static grids: keep ~30%, hide the rest, append a CTA card.\n  function cta(extra,label,span){\n    var a=document.createElement('a'); a.href=APP; a.target='_blank'; a.rel='noopener'; a.className='hy-cta';\n    if(span) a.style.gridColumn='1 / -1';\n    a.innerHTML='🔒 +'+extra+' more '+label+' in the full app<small>Get Hanyu on the App Store →</small>';\n    return a;\n  }\n  function trimGrid(grid,label){\n    if(!grid || grid.__hy) return; grid.__hy=1;\n    var kids=[]; for(var i=0;i<grid.children.length;i++){ if(grid.children[i].nodeType===1) kids.push(grid.children[i]); }\n    if(kids.length<=2) return;\n    var keep=keepN(kids.length);\n    for(var j=keep;j<kids.length;j++){ kids[j].style.display='none'; }\n    grid.appendChild(cta(kids.length-keep,label,true));\n  }\n  function run(){\n    document.querySelectorAll('.game-grid').forEach(function(g){ trimGrid(g,'games'); });\n    document.querySelectorAll('.vocab-grid').forEach(function(g){ trimGrid(g,'words'); });\n    document.querySelectorAll('.radicals-grid').forEach(function(g){ trimGrid(g,'radicals'); });\n    document.querySelectorAll('.province-grid').forEach(function(g){ trimGrid(g,'places'); });\n    var gc=document.getElementById('grammarContent');\n    if(gc && !gc.__hy){ gc.__hy=1; var cards=gc.querySelectorAll('.grammar-card');\n      if(cards.length>2){ var k=keepN(cards.length); for(var i=k;i<cards.length;i++){ cards[i].style.display='none'; } gc.appendChild(cta(cards.length-k,'grammar topics',false)); } }\n  }\n  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', function(){ run(); setTimeout(run,500); });\n  else { run(); setTimeout(run,500); }\n})();\n</script>\n\n<style>\n.hy-stories-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:14px;margin-top:8px}\n.hy-story-card{background:#fff;border-radius:14px;overflow:hidden;box-shadow:var(--shadow-md);cursor:pointer;transition:transform .2s,box-shadow .2s;border:1px solid var(--gray-200)}\n.hy-story-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-lg)}\n.hy-story-card:active{transform:scale(.98)}\n.hy-story-card .thumb{width:100%;aspect-ratio:16/10;object-fit:cover;display:block;background:var(--gray-100)}\n.hy-story-card .meta{padding:10px 12px}\n.hy-story-card .zh{font-size:18px;font-weight:700;color:var(--gray-800)}\n.hy-story-card .py{font-size:12px;color:var(--primary-color);font-weight:600}\n.hy-story-card .en{font-size:12px;color:var(--gray-500);margin-top:2px}\n.hy-story-card .lvl{display:inline-block;margin-top:6px;font-size:10px;font-weight:700;color:#fff;background:var(--primary-color);border-radius:10px;padding:2px 8px}\n.hy-reader{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:11000;display:none;align-items:flex-start;justify-content:center;overflow-y:auto;-webkit-overflow-scrolling:touch}\n.hy-reader.open{display:flex}\n.hy-reader-card{background:var(--gray-50);width:100%;max-width:640px;min-height:100%}\n.hy-reader-hero{position:relative}\n.hy-reader-hero img{width:100%;aspect-ratio:16/9;object-fit:cover;display:block;background:var(--gray-200)}\n.hy-reader-hero .titles{position:absolute;left:0;right:0;bottom:0;padding:16px;background:linear-gradient(transparent,rgba(0,0,0,.78));color:#fff}\n.hy-reader-hero .titles .zh{font-size:26px;font-weight:800}\n.hy-reader-hero .titles .py{font-size:14px;opacity:.92}\n.hy-reader-hero .titles .en{font-size:14px;opacity:.85}\n.hy-reader-close{position:absolute;top:12px;right:12px;width:38px;height:38px;border:0;border-radius:50%;background:rgba(0,0,0,.5);color:#fff;font-size:22px;line-height:1;cursor:pointer;z-index:2}\n.hy-sent{background:#fff;border-radius:12px;padding:14px;margin:12px;box-shadow:var(--shadow-sm);border-left:4px solid var(--primary-color)}\n.hy-sent .zh{font-size:22px;font-weight:600;color:var(--gray-800);line-height:1.5}\n.hy-sent .zh .w{cursor:pointer;border-radius:4px;padding:0 1px}\n.hy-sent .zh .w:active{background:var(--primary-light)}\n.hy-sent .py{font-size:14px;color:var(--primary-color);margin-top:4px}\n.hy-sent .en{font-size:14px;color:var(--gray-600);margin-top:2px}\n.hy-sent .play{margin-top:8px;border:0;background:var(--primary-color);color:#fff;border-radius:18px;padding:7px 16px;font-size:13px;font-weight:600;cursor:pointer}\n.hy-q{background:#fff;border-radius:12px;padding:14px;margin:12px;box-shadow:var(--shadow-sm)}\n.hy-q-t{font-weight:600;color:var(--gray-800);margin-bottom:8px}\n.hy-opts{display:grid;gap:8px}\n.hy-opt{text-align:left;border:2px solid var(--gray-200);background:#fff;border-radius:10px;padding:10px 12px;font-size:15px;color:var(--gray-700);cursor:pointer}\n.hy-opt.ok{background:#d1fae5;border-color:#10b981;color:#065f46}\n.hy-opt.no{background:#fee2e2;border-color:#ef4444;color:#991b1b}\n@media (prefers-color-scheme: dark){\n  .hy-story-card{background:#1c1c1e;border-color:#2c2c2e}.hy-story-card .zh{color:#eee}\n  .hy-reader-card{background:#000}.hy-sent,.hy-q{background:#1c1c1e}.hy-sent .zh,.hy-q-t{color:#eee}\n  .hy-opt{background:#1c1c1e;color:#ccc;border-color:#2c2c2e}\n}\n</style>\n<script>\n(function(){\n  var ALL = window.__hanyuStories || [];\n  if(!ALL.length) return;\n  var STORIES = ALL.slice(0, Math.max(1, Math.ceil(ALL.length*0.30)));   // demo: ~30%\n  function speak(zh,py){ try{ if(typeof speakVocab==='function'){ speakVocab(zh,py||''); return; } if('speechSynthesis' in window){ speechSynthesis.cancel(); var u=new SpeechSynthesisUtterance(zh); u.lang='zh-CN'; u.rate=0.85; speechSynthesis.speak(u); } }catch(e){} }\n  function esc(t){ return String(t==null?'':t).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];}); }\n  var reader=document.createElement('div'); reader.className='hy-reader';\n  reader.addEventListener('click',function(e){ if(e.target===reader) close(); });\n  document.body.appendChild(reader);\n  function close(){ reader.className='hy-reader'; reader.innerHTML=''; try{speechSynthesis.cancel();}catch(e){} }\n  function open(s){\n    var sents=(s.sentences||[]).map(function(se){\n      var zh=(se.words&&se.words.length)? se.words.map(function(w){return '<span class=\"w\" data-zh=\"'+esc(w.hanzi)+'\" data-py=\"'+esc(w.pinyin)+'\">'+esc(w.hanzi)+'</span>';}).join('') : esc(se.chinese);\n      return '<div class=\"hy-sent\"><div class=\"zh\">'+zh+'</div><div class=\"py\">'+esc(se.pinyin)+'</div><div class=\"en\">'+esc(se.english)+'</div><button class=\"play\" data-zh=\"'+esc(se.chinese)+'\" data-py=\"'+esc(se.pinyin)+'\">🔊 Listen</button></div>';\n    }).join('');\n    var qs=(s.questions||[]).map(function(q,qi){\n      var opts=(q.options||[]).map(function(o,oi){return '<button class=\"hy-opt\" data-o=\"'+oi+'\">'+esc(o)+'</button>';}).join('');\n      return '<div class=\"hy-q\" data-correct=\"'+(q.correct)+'\"><div class=\"hy-q-t\">'+esc(q.question)+'</div><div class=\"hy-opts\">'+opts+'</div></div>';\n    }).join('');\n    var qhead = qs ? '<div style=\"margin:18px 12px 2px;font-weight:700;color:var(--gray-600)\">Quick check</div>' : '';\n    reader.innerHTML='<div class=\"hy-reader-card\"><div class=\"hy-reader-hero\"><button class=\"hy-reader-close\" aria-label=\"Close\">&times;</button>'+\n      (s.image?'<img src=\"'+esc(s.image)+'\" alt=\"\">':'')+\n      '<div class=\"titles\"><div class=\"zh\">'+esc(s.title)+'</div><div class=\"py\">'+esc(s.titlePinyin)+'</div><div class=\"en\">'+esc(s.titleEnglish)+'</div></div></div>'+\n      sents+qhead+qs+'<div style=\"height:28px\"></div></div>';\n    reader.className='hy-reader open'; reader.scrollTop=0;\n    reader.querySelector('.hy-reader-close').onclick=close;\n    reader.querySelectorAll('.hy-sent .play').forEach(function(b){ b.onclick=function(){ speak(b.getAttribute('data-zh'), b.getAttribute('data-py')); }; });\n    reader.querySelectorAll('.hy-sent .w').forEach(function(w){ w.onclick=function(){ speak(w.getAttribute('data-zh'), w.getAttribute('data-py')); }; });\n    reader.querySelectorAll('.hy-q').forEach(function(qd){\n      var correct=parseInt(qd.getAttribute('data-correct'),10);\n      var btns=qd.querySelectorAll('.hy-opt');\n      btns.forEach(function(b,oi){ b.onclick=function(){\n        btns.forEach(function(x){ x.style.pointerEvents='none'; });\n        if(oi===correct){ b.className='hy-opt ok'; } else { b.className='hy-opt no'; if(btns[correct]) btns[correct].className='hy-opt ok'; }\n      }; });\n    });\n  }\n  function buildGrid(){\n    var grid=document.createElement('div'); grid.className='hy-stories-grid';\n    STORIES.forEach(function(s){\n      var c=document.createElement('div'); c.className='hy-story-card';\n      c.innerHTML=(s.image?'<img class=\"thumb\" loading=\"lazy\" src=\"'+esc(s.image)+'\" alt=\"\">':'<div class=\"thumb\"></div>')+\n        '<div class=\"meta\"><div class=\"zh\">'+esc(s.title)+'</div><div class=\"py\">'+esc(s.titlePinyin)+'</div><div class=\"en\">'+esc(s.titleEnglish)+'</div><span class=\"lvl\">HSK '+esc(s.level)+'</span></div>';\n      c.onclick=function(){ open(s); };\n      grid.appendChild(c);\n    });\n    if(ALL.length>STORIES.length){\n      var a=document.createElement('a'); a.href='https://apps.apple.com/us/app/hanyu-learn-chinese/id6760541929';\n      a.target='_blank'; a.rel='noopener'; a.className='hy-cta'; a.style.gridColumn='1 / -1';\n      a.innerHTML='🔒 +'+(ALL.length-STORIES.length)+' more stories in the full app<small>Get Hanyu on the App Store →</small>';\n      grid.appendChild(a);\n    }\n    return grid;\n  }\n  function install(){\n    var mc=document.getElementById('moviesContent'); if(!mc) return false;   // repurpose the old Movies pane\n    mc.innerHTML='<div class=\"section-intro\" style=\"background:linear-gradient(135deg,#ef4444,#f59e0b)\"><h2><i class=\"fas fa-book-open\"></i> Chinese Stories</h2><p>Illustrated short stories — tap any word or sentence to hear it.</p></div>';\n    mc.appendChild(buildGrid());\n    var btns=document.querySelectorAll('#storiesTab .sub-tab-btn');\n    if(btns[0]) btns[0].innerHTML='<i class=\"fas fa-book-open\"></i> Stories';\n    return true;\n  }\n  function tryInstall(n){ if(install()||n<=0) return; setTimeout(function(){ tryInstall(n-1); },300); }\n  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', function(){ tryInstall(6); });\n  else tryInstall(6);\n})();\n</script>\n</body>\n</html>", "kind": "html", "iconSymbol": "character.book.closed.fill", "iconColor": "orange"}