 'A child (子) under a roof (冖) — studying' },\n        '说': { components: ['讠','兑'], radical: '讠', explanation: 'Words radical (讠) + exchange (兑) — speaking' },\n        '看': { components: ['手','目'], radical: '目', explanation: 'Hand (手) over eye (目) — looking' },\n        '来': { components: ['木','一'], radical: '木', explanation: 'Tree (木) with marks — to come' },\n        '去': { components: ['土','厶'], radical: '厶', explanation: 'Earth (土) + private (厶) — to go away' },\n        '吃': { components: ['口','乞'], radical: '口', explanation: 'Mouth (口) + beg (乞) — eating' },\n        '喝': { components: ['口','曷'], radical: '口', explanation: 'Mouth (口) + why (曷) — drinking' },\n        '做': { components: ['亻','故'], radical: '亻', explanation: 'Person (亻) + cause (故) — to do/make' },\n        '买': { components: ['乛','头'], radical: '乛', explanation: 'Simplified from 買 — to buy' },\n        '卖': { components: ['十','买'], radical: '十', explanation: 'Ten (十) above buy (买) — to sell' },\n        '走': { components: ['土','止'], radical: '走', explanation: 'Earth (土) + stop (止) — to walk' },\n        '跑': { components: ['足','包'], radical: '足', explanation: 'Foot (足) + wrap (包) — to run' },\n        '坐': { components: ['人','土'], radical: '土', explanation: 'Two people on earth (土) — to sit' },\n        '站': { components: ['立','占'], radical: '立', explanation: 'Stand (立) + occupy (占) — to stand' },\n        '睡': { components: ['目','垂'], radical: '目', explanation: 'Eye (目) + droop (垂) — to sleep' },\n        '起': { components: ['走','己'], radical: '走', explanation: 'Walk (走) + self (己) — to rise' },\n        '想': { components: ['相','心'], radical: '心', explanation: 'Appearance (相) + heart (心) — to think' },\n        '知': { components: ['矢','口'], radical: '矢', explanation: 'Arrow (矢) + mouth (口) — to know' },\n        '听': { components: ['口','斤'], radical: '口', explanation: 'Mouth (口) + axe (斤) — to listen' },\n        '读': { components: ['讠','卖'], radical: '讠', explanation: 'Words (讠) + sell (卖) — to read' },\n        '写': { components: ['冖','与'], radical: '冖', explanation: 'Roof (冖) + give (与) — to write' },\n        '画': { components: ['一','田'], radical: '田', explanation: 'Field (田) enclosed — to draw/paint' },\n        '唱': { components: ['口','昌'], radical: '口', explanation: 'Mouth (口) + prosper (昌) — to sing' },\n        '跳': { components: ['足','兆'], radical: '足', explanation: 'Foot (足) + omen (兆) — to jump' },\n        '游': { components: ['氵','方','子'], radical: '氵', explanation: 'Water (氵) + direction + child — to swim/travel' },\n        '飞': { components: ['飞'], radical: '飞', explanation: 'Simplified from 飛 — to fly' },\n        '开': { components: ['一','廾'], radical: '廾', explanation: 'Two hands (廾) lifting — to open' },\n        '关': { components: ['丷','天'], radical: '丷', explanation: 'Horns above heaven — to close' },\n        '好': { components: ['女','子'], radical: '女', explanation: 'Woman (女) + child (子) — good' },\n        '大': { components: ['一','人'], radical: '大', explanation: 'Person (人) with arms wide — big' },\n        '小': { components: ['亅','八'], radical: '小', explanation: 'Small hooks — small' },\n        '多': { components: ['夕','夕'], radical: '夕', explanation: 'Two evenings (夕夕) — many' },\n        '少': { components: ['小','丿'], radical: '小', explanation: 'Small (小) with stroke — few' },\n        '长': { components: ['长'], radical: '长', explanation: 'Simplified from 長 — long' },\n        '高': { components: ['亠','口','冋'], radical: '高', explanation: 'Tall building structure — high/tall' },\n        '明': { components: ['日','月'], radical: '日', explanation: 'Sun (日) + moon (月) — bright/tomorrow' },\n        '休': { components: ['亻','木'], radical: '亻', explanation: 'Person (亻) against tree (木) — to rest' },\n        '男': { components: ['田','力'], radical: '田', explanation: 'Field (田) + strength (力) — man' },\n        '女': { components: ['女'], radical: '女', explanation: 'Pictograph of a kneeling woman' },\n        '人': { components: ['人'], radical: