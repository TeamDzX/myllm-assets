{"name": "Social Story Maker", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\">\n<style>:root{color-scheme:light dark;--bg:#f2f2f7;--fg:#111;--card:#fff;--accent:#7c5cff}\n@media(prefers-color-scheme:dark){:root{--bg:#000;--fg:#eee;--card:#1c1c1e}}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nbody{font-family:-apple-system,system-ui,sans-serif;background:var(--bg);color:var(--fg);margin:0 auto;max-width:600px;padding:calc(16px + env(safe-area-inset-top)) 16px calc(24px + env(safe-area-inset-bottom));-webkit-user-select:none;user-select:none}\nh1{font-size:21px;margin:0 0 2px;font-weight:700}\n.sub{font-size:13px;opacity:.6;margin-bottom:16px}\nlabel{display:block;font-size:12px;font-weight:600;opacity:.7;margin:12px 2px 5px}\ninput,textarea,select{width:100%;border:1px solid rgba(127,127,127,.3);background:var(--card);color:var(--fg);border-radius:12px;padding:12px;font-size:16px;font-family:inherit;-webkit-user-select:text;user-select:text}\ntextarea{min-height:74px;resize:none}\n.rowflex{display:flex;gap:10px}.rowflex>div{flex:1}\n.gen{width:100%;border:0;background:var(--accent);color:#fff;border-radius:14px;padding:15px;font-size:17px;font-weight:700;margin-top:16px}\n.gen:disabled{opacity:.5}\n.note{font-size:12px;opacity:.55;margin-top:8px;text-align:center}\n.err{background:rgba(240,88,79,.14);color:#f0584f;border-radius:12px;padding:12px;font-size:14px;margin-top:14px;display:none}\n.err.show{display:block}\n.story{display:none;margin-top:18px;background:var(--card);border-radius:18px;padding:20px;box-shadow:0 2px 8px rgba(0,0,0,.1)}\n.story.show{display:block}\n.story h2{margin:0 0 12px;font-size:22px}\n.story p{font-size:19px;line-height:1.6;margin:0 0 14px;-webkit-user-select:text;user-select:text}\n.sbtns{display:flex;gap:10px;margin-top:8px}\n.sbtns button{flex:1;border:0;border-radius:13px;padding:12px;font-size:15px;font-weight:700}\n.save{background:#34a853;color:#fff}.again{background:rgba(127,127,127,.18);color:var(--fg)}\n.saved{margin-top:26px}\n.saved h3{font-size:13px;opacity:.55;text-transform:uppercase;letter-spacing:.5px;margin:0 0 8px}\n.srow{display:flex;align-items:center;gap:10px;padding:12px;background:var(--card);border-radius:13px;margin-bottom:8px}\n.srow .ttl{flex:1;font-size:15px;font-weight:600}\n.srow button{border:0;background:none;font-size:18px}\n.spin{display:inline-block;width:16px;height:16px;border:2px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:sp .7s linear infinite;vertical-align:-2px;margin-right:6px}\n@keyframes sp{to{transform:rotate(360deg)}}\n</style></head><body>\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-family:-apple-system,system-ui,sans-serif;font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;line-height:1;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n@media(min-width:768px){body{max-width:760px}}\n</style>\n<script>\n(function(){\n  if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;\n  window.__myllmAiWrap=true;\n  var orig=window.myllmAsk,depth=0,node=null;\n  function ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\n    node.innerHTML='<span class=\"myllm-ai-cog\">\\u2699\\uFE0F</span><span>AI is thinking\\u2026 <small>privately, on your device</small></span>';\n    (document.body||document.documentElement).appendChild(node);}\n  function show(){ensure();depth++;node.classList.add('on');}\n  function hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\n  window.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\n    return Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};\n})();\n</script>\n\n<h1>📖 Social Story Maker</h1>\n<div class=\"sub\">Make a gentle, personalised story to help a child get ready for something new. Created privately by the AI on your device.</div>\n\n<div id=\"form\">\n  <label>What is the story about?</label>\n  <textarea id=\"situation\" placeholder=\"e.g. Going to the dentist for a check-up\"></textarea>\n  <div class=\"rowflex\">\n    <div><label>Child’s name (optional)</label><input id=\"name\" placeholder=\"e.g. Sam\"></div>\n    <div><label>Age</label>\n      <select id=\"age\"><option value=\"young child\">3–5</option><option value=\"child\" selected>6–9</option><option value=\"older child\">10–12</option></select>\n    </div>\n  </div>\n  <label>Anything to include? (optional)</label>\n  <input id=\"extra\" placeholder=\"e.g. they feel nervous about the noise\">\n  <button class=\"gen\" id=\"gen\" onclick=\"generate()\">Create story</button>\n  <div class=\"note\">Needs the latest MyLLM with “Allow apps to use the AI” turned on (MyLLMos settings menu).</div>\n  <div class=\"err\" id=\"err\"></div>\n</div>\n\n<div class=\"story\" id=\"story\"></div>\n\n<div class=\"saved\" id=\"saved\"></div>\n\n<script>\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nfunction haptic(s){if(window.myllmHaptic)try{myllmHaptic(s)}catch(e){}}\nfunction el(i){return document.getElementById(i)}\nvar saved=[],current=null;\nvar SYSTEM=\"You write Social Stories in the style of Carol Gray to help a neurodivergent child (autism/ADHD) prepare for a situation. Rules: write in the FIRST PERSON ('I'). Use short, simple, clear sentences. Be calm, positive and reassuring. Describe what will happen, what I might see, hear or feel, and the helpful things I can do. Use gentle words like 'sometimes', 'usually', 'I can try' rather than 'always' or 'must'. Never use anything scary or negative. End on a calm, encouraging note. Output ONLY the story: a short title line, then 8 to 14 short sentences as 2-4 small paragraphs. No headings, bullet points, markdown, or notes.\";\n\nfunction generate(){\n  var sit=el('situation').value.trim();\n  if(!sit){el('situation').focus();return}\n  if(!window.myllmAsk){showErr(\"This needs the MyLLM app’s on-device AI. Please update MyLLM and try again.\");return}\n  var name=el('name').value.trim(),age=el('age').value,extra=el('extra').value.trim();\n  var prompt=\"Write a Social Story about: \"+sit+\".\\nThe reader is a \"+age+\".\";\n  if(name)prompt+=\"\\nUse the child’s name: \"+name+\" — but the story is still told as 'I'.\";\n  if(extra)prompt+=\"\\nPlease gently address: \"+extra+\".\";\n  el('err').className='err';\n  var g=el('gen');g.disabled=true;g.innerHTML='<span class=\"spin\"></span>Writing…';\n  haptic('light');\n  window.myllmAsk(prompt,{system:SYSTEM}).then(function(text){\n    showStory(sit,text);\n  }).catch(function(e){\n    showErr(String(e&&e.message||e));\n  }).then(function(){g.disabled=false;g.textContent='Create story'});\n}\nfunction showErr(m){var E=el('err');E.textContent=m;E.className='err show';haptic('warning')}\nfunction parseStory(text){\n  var lines=text.trim().split(/\\n+/).map(function(l){return l.trim()}).filter(Boolean);\n  var title=lines.shift()||'My Story';\n  title=title.replace(/^#+\\s*/,'').replace(/^title:\\s*/i,'').replace(/[\"*]/g,'');\n  return {title:title,body:lines};\n}\nfunction showStory(sit,text){\n  var s=parseStory(text);current={sit:sit,title:s.title,body:s.body};\n  var S=el('story');S.className='story show';\n  S.innerHTML='<h2>'+esc(s.title)+'</h2>'+s.body.map(function(p){return '<p>'+esc(p)+'</p>'}).join('')+\n    '<div class=\"sbtns\"><button class=\"save\" id=\"saveb\">Save story</button><button class=\"again\" id=\"againb\">New story</button></div>';\n  el('saveb').onclick=saveCurrent;\n  el('againb').onclick=function(){S.className='story';el('situation').value='';el('extra').value='';window.scrollTo({top:0,behavior:'smooth'})};\n  haptic('success');\n  S.scrollIntoView({behavior:'smooth',block:'start'});\n}\nfunction saveCurrent(){\n  if(!current)return;\n  saved.unshift({id:Date.now(),title:current.title,body:current.body});\n  saved=saved.slice(0,40);\n  persist();haptic('success');el('saveb').textContent='Saved ✓';renderSaved();\n}\nfunction persist(){store.setItem('ss_stories',JSON.stringify(saved))}\nfunction renderSaved(){\n  var W=el('saved');\n  if(!saved.length){W.innerHTML='';return}\n  W.innerHTML='<h3>Saved stories</h3>'+saved.map(function(s){\n    return '<div class=\"srow\" data-id=\"'+s.id+'\"><span class=\"ttl\">'+esc(s.title)+'</span><button class=\"open\">📖</button><button class=\"rm\">🗑️</button></div>';\n  }).join('');\n  Array.prototype.forEach.call(W.querySelectorAll('.srow'),function(row){\n    var id=+row.getAttribute('data-id');\n    row.querySelector('.open').onclick=function(){var s=saved.filter(function(x){return x.id===id})[0];if(s)openSaved(s)};\n    row.querySelector('.rm').onclick=function(){saved=saved.filter(function(x){return x.id!==id});persist();renderSaved()};\n  });\n}\nfunction openSaved(s){\n  current={sit:s.title,title:s.title,body:s.body};\n  var S=el('story');S.className='story show';\n  S.innerHTML='<h2>'+esc(s.title)+'</h2>'+s.body.map(function(p){return '<p>'+esc(p)+'</p>'}).join('')+\n    '<div class=\"sbtns\"><button class=\"again\" id=\"againb\">Close</button></div>';\n  el('againb').onclick=function(){S.className='story'};\n  S.scrollIntoView({behavior:'smooth',block:'start'});\n}\nfunction esc(t){return String(t).replace(/[&<>]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;'}[c]})}\nstore.getItem('ss_stories').then(function(v){if(v){try{saved=JSON.parse(v)||[]}catch(e){}}renderSaved()});\n</script></body></html>\n", "kind": "html", "iconSymbol": "book.fill", "iconColor": "purple"}