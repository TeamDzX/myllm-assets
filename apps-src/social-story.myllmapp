{"name": "Social Story Maker", "html": "<!doctype html>\n<!--\n  Social Story Maker — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover\">\n<title>Social Story Maker</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"b99145b5e9\";color-scheme:light dark;\n  --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n  --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n  --fill:rgba(120,120,128,.12); --h:258; }\n@media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n  --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4; -webkit-user-select:none; user-select:none;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:720px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.97); }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 60% 58%), hsl(calc(var(--h) + 25) 50% 38%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  h3{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:22px 2px 10px; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  label{ display:block; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:14px 2px 7px; }\n  label:first-child{ margin-top:0; }\n  input,textarea,select{ width:100%; border:1px solid var(--line); background:var(--bg); color:var(--ink); border-radius:12px; padding:12px; font:inherit; font-size:16px; outline:none; -webkit-user-select:text; user-select:text; }\n  input:focus,textarea:focus,select:focus{ border-color:var(--acc); }\n  select{ -webkit-appearance:none; appearance:none; min-height:48px;\n    background-image:linear-gradient(45deg,transparent 50%,var(--muted) 50%),linear-gradient(135deg,var(--muted) 50%,transparent 50%);\n    background-position:calc(100% - 18px) 50%,calc(100% - 13px) 50%; background-size:5px 5px; background-repeat:no-repeat; padding-right:34px; }\n  textarea{ min-height:84px; resize:none; line-height:1.45; }\n  .rowflex{ display:flex; gap:10px; } .rowflex>div{ flex:1; min-width:0; } .rowflex>div.age{ flex:0 0 38%; }\n  .gen{ width:100%; min-height:56px; border:none; background:hsl(var(--h) 60% 52%); color:#fff; border-radius:16px; font-size:17px; font-weight:750; margin-top:16px;\n    display:flex; align-items:center; justify-content:center; gap:8px; }\n  .gen:disabled{ opacity:.6; }\n  .note{ font-size:12.5px; color:var(--muted); margin-top:10px; text-align:center; line-height:1.45; }\n  .err{ display:flex; gap:10px; align-items:flex-start; background:rgba(229,72,77,.12); border-radius:14px; padding:12px; font-size:14.5px; line-height:1.45; margin-top:12px; }\n  .err svg{ color:#e5484d; margin-top:1px; }\n  .spin{ width:16px; height:16px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n\n  /* The story itself: large, calm, easy to read aloud together. */\n  .story{ background:var(--surface); border:1px solid var(--line); border-radius:22px; padding:22px 20px 18px; margin-top:6px; }\n  .story .k{ display:flex; align-items:center; gap:8px; font-size:11.5px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; color:hsl(var(--h) 55% 50%); margin-bottom:8px; }\n  .story h2{ font-size:24px; font-weight:800; letter-spacing:-.01em; line-height:1.25; margin-bottom:14px; }\n  .story p{ font-size:20px; line-height:1.65; margin:0 0 14px; -webkit-user-select:text; user-select:text; }\n  .sbtns{ display:flex; gap:10px; margin-top:10px; }\n  .sbtns button{ flex:1; min-height:56px; border:none; border-radius:16px; font-size:16px; font-weight:750; display:flex; align-items:center; justify-content:center; gap:8px; }\n  .save{ background:hsl(145 50% 40%); color:#fff; } .save:disabled{ opacity:.7; }\n  .again{ background:var(--fill); }\n  .skel{ height:16px; border-radius:8px; background:var(--fill); margin-top:12px; animation:shimmer 1.6s ease-in-out infinite; }\n  .skel.t{ height:24px; width:60%; margin:0 0 6px; } .skel.w8{ width:82%; } .skel.w6{ width:64%; } .skel.w9{ width:94%; }\n  @keyframes shimmer{ 50%{ opacity:.45; } }\n\n  .list{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:2px 14px; }\n  .srow{ display:flex; align-items:center; gap:12px; min-height:60px; border-bottom:1px solid var(--line); cursor:pointer; }\n  .srow:last-child{ border-bottom:none; }\n  .srow .bk{ width:36px; height:36px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:15px; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 60% 58%), hsl(calc(var(--h) + 25) 50% 38%)); }\n  .srow .ttl{ flex:1; min-width:0; font-size:16px; font-weight:650; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .srow .rm{ width:48px; height:48px; margin-right:-8px; border:none; background:none; color:var(--muted); font-size:15px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }\n  [hidden]{ display:none !important; }\n  @media (prefers-reduced-motion:reduce){ .spin{ animation-duration:2.4s; } .skel{ animation:none; } button:active{ transform:none; } }\n\n  @keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n  .myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n  .myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n  .myllm-ai-cog{width:16px;height:16px;border-radius:50%;border:2.4px solid #a78bfa;border-right-color:transparent;animation:myllmAiSpin .9s linear infinite;flex-shrink:0}\n  .myllm-ai-busy small{font-weight:400;opacity:.6}\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-book\" viewBox=\"0 0 24 24\"><path d=\"M4 5.5A2.5 2.5 0 0 1 6.5 3H19a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H6.5a.5.5 0 0 0 0 1H19a1 1 0 0 1 0 2H6.5A2.5 2.5 0 0 1 4 18.5z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-spark\" viewBox=\"0 0 24 24\"><path d=\"M10 2.5l1.9 5.6 5.6 1.9-5.6 1.9L10 17.5l-1.9-5.6L2.5 10l5.6-1.9zM18.5 14l.95 2.55L22 17.5l-2.55.95L18.5 21l-.95-2.55L15 17.5l2.55-.95z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M5 12.6l4.6 4.6L19.2 7.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-bin\" viewBox=\"0 0 24 24\"><path d=\"M9 3h6a1 1 0 0 1 1 1v1h4a1 1 0 0 1 0 2h-1l-.9 12.1A2 2 0 0 1 16.1 21H7.9a2 2 0 0 1-2-1.9L5 7H4a1 1 0 0 1 0-2h4V4a1 1 0 0 1 1-1zm-2 4l.9 12h8.2L17 7z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-plus\" viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-warn\" viewBox=\"0 0 24 24\"><path d=\"M10.3 3.9a2 2 0 0 1 3.4 0l8 13.6a2 2 0 0 1-1.7 3H4a2 2 0 0 1-1.7-3zM12 9a1 1 0 0 0-1 1v4a1 1 0 0 0 2 0v-4a1 1 0 0 0-1-1zm0 7.2a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z\" fill=\"currentColor\"/></symbol>\n</defs></svg>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\"></span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-book\"/></svg></div>\n  <div class=\"ht\"><h1>Social Story Maker</h1><p>Make a gentle, personalised story to help a child get ready for something new. Created privately by the AI on your device.</p></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Social Story Maker\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n\n<div class=\"card\" id=\"form\">\n  <label for=\"situation\">What is the story about?</label>\n  <textarea id=\"situation\" placeholder=\"e.g. Going to the dentist for a check-up\"></textarea>\n  <div class=\"rowflex\">\n    <div><label for=\"name\">Child’s name (optional)</label><input id=\"name\" placeholder=\"e.g. Sam\" autocomplete=\"off\"></div>\n    <div class=\"age\"><label for=\"age\">Age</label>\n      <select id=\"age\"><option value=\"young child\">3–5</option><option value=\"child\" selected>6–9</option><option value=\"older child\">10–12</option></select>\n    </div>\n  </div>\n  <label for=\"extra\">Anything to include? (optional)</label>\n  <input id=\"extra\" placeholder=\"e.g. they feel nervous about the noise\" autocomplete=\"off\">\n  <button class=\"gen\" id=\"gen\" type=\"button\"></button>\n  <div class=\"note\">Needs the latest MyLLM with “Allow apps to use the AI” turned on (MyLLMos settings menu).</div>\n  <div class=\"err\" id=\"err\" hidden><svg class=\"i\"><use href=\"#i-warn\"/></svg><span id=\"errText\"></span></div>\n</div>\n\n<div class=\"story\" id=\"story\" hidden></div>\n\n<div id=\"saved\"></div>\n\n<script>\nfunction el(i){return document.getElementById(i)}\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction store(){return window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}}}\nfunction haptic(s){if(window.myllmHaptic)try{myllmHaptic(s)}catch(e){}}\nfunction icon(n){return '<svg class=\"i\"><use href=\"#i-'+n+'\"/></svg>'}\nvar saved=[],current=null;\nvar SYSTEM=\"You write Social Stories in the style of Carol Gray to help a neurodivergent child (autism/ADHD) prepare for a situation. Rules: write in the FIRST PERSON ('I'). Use short, simple, clear sentences. Be calm, positive and reassuring. Describe what will happen, what I might see, hear or feel, and the helpful things I can do. Use gentle words like 'sometimes', 'usually', 'I can try' rather than 'always' or 'must'. Never use anything scary or negative. End on a calm, encouraging note. Output ONLY the story: a short title line, then 8 to 14 short sentences as 2-4 small paragraphs. No headings, bullet points, markdown, or notes.\";\n\nfunction genBtn(busy){var g=el('gen');g.disabled=!!busy;g.innerHTML=busy?'<i class=\"spin\"></i>Writing…':icon('spark')+'Create story'}\nfunction generate(){\n  var sit=el('situation').value.trim();\n  if(!sit){el('situation').focus();return}\n  if(!window.myllmAsk){showErr(\"This needs the MyLLM app’s on-device AI. Please update MyLLM and try again.\");return}\n  var name=el('name').value.trim(),age=el('age').value,extra=el('extra').value.trim();\n  var prompt=\"Write a Social Story about: \"+sit+\".\\nThe reader is a \"+age+\".\";\n  if(name)prompt+=\"\\nUse the child’s name: \"+name+\" — but the story is still told as 'I'.\";\n  if(extra)prompt+=\"\\nPlease gently address: \"+extra+\".\";\n  el('err').hidden=true;\n  genBtn(true);\n  var S=el('story');S.hidden=false;\n  S.innerHTML='<div class=\"k\">'+icon('book')+'Writing your story</div><div class=\"skel t\"></div><div class=\"skel w9\"></div><div class=\"skel w8\"></div><div class=\"skel w9\"></div><div class=\"skel w6\"></div>';\n  haptic('light');\n  window.myllmAsk(prompt,{system:SYSTEM}).then(function(text){\n    showStory(sit,text);\n  }).catch(function(e){\n    S.hidden=true;\n    showErr(String(e&&e.message||e));\n  }).then(function(){genBtn(false)});\n}\nfunction showErr(m){el('errText').textContent=m;el('err').hidden=false;haptic('warning')}\nfunction parseStory(text){\n  var lines=String(text).trim().split(/\\n+/).map(function(l){return l.trim()}).filter(Boolean);\n  var title=lines.shift()||'My Story';\n  title=title.replace(/^#+\\s*/,'').replace(/^title:\\s*/i,'').replace(/[\"*]/g,'');\n  return {title:title,body:lines};\n}\nfunction storyHTML(title,body,label){\n  return '<div class=\"k\">'+icon('book')+label+'</div><h2>'+esc(title)+'</h2>'+body.map(function(p){return '<p>'+esc(p)+'</p>'}).join('');\n}\nfunction showStory(sit,text){\n  var s=parseStory(text);current={sit:sit,title:s.title,body:s.body};\n  var S=el('story');S.hidden=false;\n  S.innerHTML=storyHTML(s.title,s.body,'Your story')+\n    '<div class=\"sbtns\"><button class=\"save\" id=\"saveb\" type=\"button\">'+icon('check')+'Save story</button><button class=\"again\" id=\"againb\" type=\"button\">'+icon('plus')+'New story</button></div>';\n  el('saveb').onclick=saveCurrent;\n  el('againb').onclick=function(){S.hidden=true;el('situation').value='';el('extra').value='';window.scrollTo({top:0,behavior:'smooth'})};\n  haptic('success');\n  S.scrollIntoView({behavior:'smooth',block:'start'});\n}\nfunction saveCurrent(){\n  if(!current)return;\n  saved.unshift({id:Date.now(),title:current.title,body:current.body});\n  saved=saved.slice(0,40);\n  persist();haptic('success');\n  var b=el('saveb');b.innerHTML=icon('check')+'Saved';b.disabled=true;\n  renderSaved();\n}\nfunction persist(){store().setItem('ss_stories',JSON.stringify(saved))}\nfunction renderSaved(){\n  var W=el('saved');\n  if(!saved.length){W.innerHTML='';return}\n  W.innerHTML='<h3>Saved stories</h3><div class=\"list\">'+saved.map(function(s){\n    return '<div class=\"srow\" data-id=\"'+s.id+'\" role=\"button\" tabindex=\"0\"><span class=\"bk\">'+icon('book')+'</span><span class=\"ttl\">'+esc(s.title)+'</span><button class=\"rm\" type=\"button\" aria-label=\"Delete story\">'+icon('bin')+'</button></div>';\n  }).join('')+'</div>';\n  Array.prototype.forEach.call(W.querySelectorAll('.srow'),function(row){\n    var id=+row.getAttribute('data-id');\n    row.onclick=function(){var s=saved.filter(function(x){return x.id===id})[0];if(s)openSaved(s)};\n    row.querySelector('.rm').onclick=function(ev){ev.stopPropagation();saved=saved.filter(function(x){return x.id!==id});persist();renderSaved()};\n  });\n}\nfunction openSaved(s){\n  current={sit:s.title,title:s.title,body:s.body};\n  var S=el('story');S.hidden=false;\n  S.innerHTML=storyHTML(s.title,s.body,'Saved story')+\n    '<div class=\"sbtns\"><button class=\"again\" id=\"againb\" type=\"button\">'+icon('x')+'Close</button></div>';\n  el('againb').onclick=function(){S.hidden=true};\n  S.scrollIntoView({behavior:'smooth',block:'start'});\n}\nfunction esc(t){return String(t).replace(/[&<>]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;'}[c]})}\nel('gen').onclick=generate;\ngenBtn(false);\nstore().getItem('ss_stories').then(function(v){if(v){try{saved=JSON.parse(v)||[]}catch(e){}}renderSaved()});\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes.\n   The spacer keeps the header clear of the status bar / Dynamic Island. It is\n   live CSS — env(safe-area-inset-top) — not a measured number: the inset is\n   still 0 when the page loads and only grows once MyLLM's bar has gone (v1\n   measured once, so the title sat under the island). If the page's own styles\n   already pad the header down by the inset, the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  /* Does any rule that applies to the header or an ancestor already use the top inset? */\n  function pageHandlesInset(head){\n    var chain = [], n, found = false;\n    for (n = head; n && n.nodeType === 1; n = n.parentElement) chain.push(n);\n    function walk(rules){\n      for (var i = 0; i < rules.length && !found; i++){\n        var r = rules[i];\n        if (r.cssRules && !r.selectorText) { walk(r.cssRules); continue; }\n        if (!r.selectorText || !/safe-area-inset-top/.test(r.cssText) || !/(padding|margin|top)\\s*:/.test(r.cssText)) continue;\n        if (/\\.imm-safe/.test(r.selectorText)) continue;\n        for (var k = 0; k < chain.length; k++){\n          try { if (chain[k].matches(r.selectorText)) { found = true; break; } } catch(e){}\n        }\n      }\n    }\n    for (var s = 0; s < document.styleSheets.length && !found; s++){\n      try { walk(document.styleSheets[s].cssRules); } catch(e){}\n    }\n    for (n = head; n && n.nodeType === 1 && !found; n = n.parentElement){\n      if (/safe-area-inset-top/.test(n.getAttribute(\"style\") || \"\")) found = true;\n    }\n    return found;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = (document.body.classList.contains(\"imm\") && !pageHandlesInset(head)) ? \"env(safe-area-inset-top)\" : \"0px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script></body></html>\n", "kind": "html", "iconSymbol": "book.fill", "iconColor": "purple"}