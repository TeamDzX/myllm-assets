{"name": "Light Meter", "kind": "html", "iconSymbol": "camera.aperture", "iconColor": "orange", "html": "<!DOCTYPE html>\n<!--\n  Light Meter \u2014 MyLLMos\u2122 App Gallery \u00b7 \u00a9 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM\u2122.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>Light Meter</title>\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<style>\n*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}\n:root{--build-id:\"9345a0c754\";--bg:#0c0d0f;--panel:#16181c;--panel2:#1d2025;--line:#2b2f36;--ink:#f2efe8;--dim:#a09c92;--amber:#ffb224;--amberd:#7a5410;--red:#ff6152;--blue:#62aefc;--green:#74d695;--sat:env(safe-area-inset-top);--sab:env(safe-area-inset-bottom);--ui:system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;--num:ui-monospace,\"SF Mono\",Menlo,Consolas,monospace;--grain:0.997572103043}\nhtml,body{height:100%;background:var(--bg);color:var(--ink);font-family:var(--ui);font-size:15px;line-height:1.4;overflow:hidden;-webkit-text-size-adjust:100%}\nbutton,select,input{font:inherit;color:inherit}\nbutton{cursor:pointer;-webkit-user-select:none;user-select:none}\n#app{display:flex;flex-direction:column;height:100%;max-width:640px;margin:0 auto}\nheader{display:flex;align-items:center;justify-content:space-between;padding:calc(10px + var(--sat)) 16px 8px;flex:none}\nheader h1{font-size:13px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--dim)}\nheader h1 b{color:var(--amber)}\n.ib{width:36px;height:36px;border-radius:50%;border:1px solid var(--line);background:var(--panel);font-weight:700;color:var(--dim)}\nmain{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:4px 16px 24px;overscroll-behavior:contain}\nsection{display:none}\nsection.on{display:block}\nnav{flex:none;display:flex;border-top:1px solid var(--line);background:#101114;padding:6px 8px calc(6px + var(--sab))}\nnav button{flex:1;background:none;border:0;padding:8px 2px 6px;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--dim);border-radius:10px;min-height:48px}\nnav button svg{display:block;margin:0 auto 3px;width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}\nnav button.on{color:var(--amber)}\n.card{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:14px;margin-top:12px}\n.card h3{font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--dim);margin-bottom:10px}\n.num{font-family:var(--num);font-variant-numeric:tabular-nums}\n.dim{color:var(--dim)}\n.small{font-size:13px}\n.hidden{display:none!important}\n\n/* meter */\n#gauge{display:block;width:100%;max-width:420px;margin:0 auto}\n#needle{transition:transform .7s cubic-bezier(.3,1.4,.5,1);transform-origin:150px 150px}\n#read{text-align:center;margin-top:-6px}\n#evBig{font-family:var(--num);font-size:46px;font-weight:700;line-height:1;letter-spacing:-.02em}\n#evBig small{font-size:15px;font-weight:600;color:var(--dim);letter-spacing:.06em;margin-right:8px}\n#evName{margin-top:6px;font-size:16px;font-weight:600;color:var(--amber)}\n#evSrc{margin-top:3px;font-size:13px;color:var(--dim);min-height:18px}\n.btns{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}\n.btn{min-height:50px;border-radius:14px;border:1px solid var(--line);background:var(--panel2);font-weight:700;font-size:15px;padding:8px 10px;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;text-align:center}\n.btn.pri{background:var(--amber);border-color:var(--amber);color:#1b1203}\n.btn:active{filter:brightness(.88)}\n.btn input[type=file]{position:absolute;inset:0;width:100%;height:100%;opacity:0;font-size:60px;cursor:pointer}\n.link{background:none;border:0;color:var(--dim);text-decoration:underline;font-size:13px;padding:10px 4px;min-height:40px}\n.step{display:flex;align-items:center;justify-content:space-between;gap:8px}\n.step button{width:52px;height:44px;border-radius:12px;border:1px solid var(--line);background:var(--panel2);font-family:var(--num);font-size:16px;font-weight:700}\n.step .v{flex:1;text-align:center;font-family:var(--num);font-size:16px;font-weight:700}\n#pcWrap{position:relative;border-radius:12px;overflow:hidden;background:#000;line-height:0;touch-action:manipulation}\n#pc{width:100%;height:auto;display:block}\n#spotRing{position:absolute;width:44px;height:44px;margin:-22px 0 0 -22px;border:2px solid var(--amber);border-radius:50%;box-shadow:0 0 0 1px #000,inset 0 0 0 1px #000;pointer-events:none}\n#hist{width:100%;height:92px;display:block;margin-top:10px;border-radius:8px;background:#0b0c0e}\n.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:10px}\n.stat{background:var(--panel2);border-radius:10px;padding:8px 6px;text-align:center}\n.stat b{display:block;font-family:var(--num);font-size:17px}\n.stat span{font-size:11px;color:var(--dim);letter-spacing:.04em}\n.seg{display:flex;background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:3px;gap:3px}\n.seg button{flex:1;min-height:38px;border:0;border-radius:9px;background:none;font-weight:700;font-size:13.5px;color:var(--dim);padding:4px 2px}\n.seg button.on{background:var(--amber);color:#1b1203}\n.note{margin-top:10px;font-size:13.5px;color:var(--ink);background:var(--panel2);border-left:3px solid var(--amber);border-radius:6px;padding:8px 10px}\n.row{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:10px}\n.tog{display:flex;align-items:center;gap:8px;font-size:13.5px;color:var(--dim);background:none;border:0;min-height:40px}\n.tog i{width:38px;height:22px;border-radius:11px;background:var(--line);position:relative;flex:none}\n.tog i:after{content:\"\";position:absolute;left:2px;top:2px;width:18px;height:18px;border-radius:50%;background:var(--ink);transition:left .15s}\n.tog.on i{background:var(--amber)}\n.tog.on i:after{left:18px}\n\n/* scene sheet + help */\n.sheet{position:fixed;inset:0;z-index:20;background:rgba(5,6,8,.86);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);display:flex;flex-direction:column;align-items:center;padding:calc(14px + var(--sat)) 14px calc(14px + var(--sab));overflow-y:auto}\n.sheet .in{width:100%;max-width:560px}\n.sheet h2{font-size:18px;margin:4px 2px 4px}\n.sheet p.sub{font-size:13.5px;color:var(--dim);margin:0 2px 12px}\n#scGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}\n.sc{position:relative;aspect-ratio:1;border-radius:12px;overflow:hidden;border:1px solid var(--line);background:var(--panel2) center/cover;padding:0;text-align:left}\n.sc:after{content:\"\";position:absolute;inset:0;background:linear-gradient(transparent 35%,rgba(0,0,0,.82))}\n.sc span{position:absolute;left:7px;right:7px;bottom:6px;z-index:1;font-size:12px;font-weight:700;line-height:1.15;color:#fff;text-shadow:0 1px 3px #000}\n.sc em{position:absolute;right:6px;top:6px;z-index:1;font-style:normal;font-family:var(--num);font-size:11px;font-weight:700;background:rgba(0,0,0,.66);color:var(--amber);padding:2px 6px;border-radius:8px}\n.sc.on{outline:2px solid var(--amber);outline-offset:-2px}\n.help p,.help li{font-size:14px;margin-bottom:8px}\n.help ul{padding-left:18px}\n.help b{color:var(--amber)}\n\n/* expose */\n#trip{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;text-align:center}\n#trip div{background:var(--panel2);border-radius:12px;padding:10px 4px;border:1px solid transparent}\n#trip div.sol{border-color:var(--amber)}\n#trip div.bad{border-color:var(--red)}\n#trip b{display:block;font-family:var(--num);font-size:clamp(17px,5.4vw,23px);font-weight:700;white-space:nowrap}\n#trip span{font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--dim)}\n#trip div.sol span{color:var(--amber)}\n.chips{display:flex;gap:8px;overflow-x:auto;padding:2px 0 6px;scrollbar-width:none;-webkit-overflow-scrolling:touch}\n.chips::-webkit-scrollbar{display:none}\n.chip{flex:none;min-height:40px;padding:6px 13px;border-radius:20px;border:1px solid var(--line);background:var(--panel2);font-weight:600;font-size:13.5px;white-space:nowrap}\n.chip.on{background:var(--amber);border-color:var(--amber);color:#1b1203}\n.rl{display:flex;align-items:baseline;justify-content:space-between;margin:14px 0 6px}\n.rl b{font-size:13px;letter-spacing:.08em;text-transform:uppercase}\n.rl span{font-size:12px;color:var(--dim)}\n.ruler .chip{font-family:var(--num);border-radius:10px;padding:6px 10px;min-width:54px;text-align:center}\n.ruler.sol .chip{opacity:.38}\n.ruler.sol .chip.on{opacity:1}\n.ruler .chip.off{opacity:.25}\n#checks{list-style:none;display:grid;gap:8px}\n#checks li{display:grid;grid-template-columns:20px 1fr;gap:8px;font-size:14px;align-items:start}\n#checks li i{width:10px;height:10px;border-radius:50%;margin:5px 0 0 4px;background:var(--green)}\n#checks li.w i{background:var(--red)}\n#checks li.i i{background:var(--blue)}\n#exBanner{font-size:13.5px;color:var(--dim);margin-top:10px}\n#exBanner b{color:var(--ink);font-family:var(--num)}\n\n/* depth */\n#dof{width:100%;height:96px;display:block}\ninput[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:36px;background:none}\ninput[type=range]::-webkit-slider-runnable-track{height:6px;border-radius:3px;background:var(--line)}\ninput[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:28px;height:28px;border-radius:50%;background:var(--amber);margin-top:-11px;border:3px solid var(--bg)}\ninput[type=range]::-moz-range-track{height:6px;border-radius:3px;background:var(--line)}\ninput[type=range]::-moz-range-thumb{width:24px;height:24px;border-radius:50%;background:var(--amber);border:3px solid var(--bg)}\n.kv{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px}\n.kv .stat b{font-size:19px}\n\n/* kit */\n.f{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:9px 0;border-bottom:1px solid var(--line)}\n.f:last-child{border-bottom:0}\n.f label{font-size:14.5px}\n.f label small{display:block;font-size:12px;color:var(--dim)}\n.f select,.f input{min-height:42px;max-width:52%;background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:6px 10px;font-family:var(--num);font-size:16px;text-align:right}\n.f input{width:96px}\nselect{-webkit-appearance:none;appearance:none}\n</style>\n</head>\n<body>\n<div id=\"app\">\n<header><h1><b>Light</b> Meter</h1><button class=\"ib\" id=\"bHelp\" type=\"button\" aria-label=\"How it works\">?</button></header>\n<main id=\"main\">\n\n<section id=\"tMeter\" class=\"on\">\n  <svg id=\"gauge\" viewBox=\"0 0 300 168\" role=\"img\" aria-label=\"Light level gauge\">\n    <defs><linearGradient id=\"gg\" x1=\"0\" x2=\"1\" y1=\"0\" y2=\"0\"><stop offset=\"0\" stop-color=\"#2a3f7a\"/><stop offset=\".45\" stop-color=\"#7a5a8a\"/><stop offset=\".75\" stop-color=\"#ff9a3a\"/><stop offset=\"1\" stop-color=\"#fff0b8\"/></linearGradient></defs>\n    <path d=\"M30 150 A120 120 0 0 1 270 150\" fill=\"none\" stroke=\"url(#gg)\" stroke-width=\"7\" stroke-linecap=\"round\"/>\n    <g id=\"ticks\"></g>\n    <g id=\"needle\"><line x1=\"150\" y1=\"150\" x2=\"150\" y2=\"46\" stroke=\"#ffb224\" stroke-width=\"3\" stroke-linecap=\"round\"/></g>\n    <circle cx=\"150\" cy=\"150\" r=\"9\" fill=\"#ffb224\"/><circle cx=\"150\" cy=\"150\" r=\"3.5\" fill=\"#0c0d0f\"/>\n  </svg>\n  <div id=\"read\">\n    <div id=\"evBig\"><small>EV</small><span id=\"evNum\">--</span></div>\n    <div id=\"evName\">No reading yet</div>\n    <div id=\"evSrc\">Meter with a photo, or pick the light you are in.</div>\n  </div>\n  <div class=\"btns\">\n    <label class=\"btn pri\" id=\"bPhoto\">Meter with a photo<input type=\"file\" id=\"file\" accept=\"image/*\"></label>\n    <button class=\"btn\" id=\"bScene\" type=\"button\">Pick the light</button>\n  </div>\n  <div style=\"text-align:center\"><button class=\"link hidden\" id=\"bPick\" type=\"button\">Photo not opening? Use the simple picker</button></div>\n\n  <div class=\"card\" id=\"adjCard\">\n    <h3>Fine adjust</h3>\n    <div class=\"step\"><button id=\"adjM\" type=\"button\" aria-label=\"Darker by a third of a stop\">&minus;&#8531;</button><div class=\"v\" id=\"adjV\">0</div><button id=\"adjP\" type=\"button\" aria-label=\"Brighter by a third of a stop\">+&#8531;</button></div>\n  </div>\n\n  <div class=\"card hidden\" id=\"photoCard\">\n    <h3>The photo</h3>\n    <div id=\"pcWrap\"><canvas id=\"pc\" width=\"8\" height=\"8\"></canvas><div id=\"spotRing\" class=\"hidden\"></div></div>\n    <div class=\"row\"><span class=\"small dim\" id=\"spotTxt\">Tap the photo to meter one spot.</span><button class=\"tog\" id=\"bClip\" type=\"button\"><i></i>Clipping</button></div>\n    <div class=\"seg hidden\" id=\"segMode\" style=\"margin-top:8px\"><button data-m=\"avg\" class=\"on\" type=\"button\">Whole scene</button><button data-m=\"spot\" type=\"button\">Tapped spot</button></div>\n    <div id=\"zoneBox\" class=\"hidden\">\n      <div class=\"rl\"><b>Render the spot as</b><span>Zone system</span></div>\n      <div class=\"seg\" id=\"segZone\"><button data-z=\"3\" type=\"button\">III</button><button data-z=\"4\" type=\"button\">IV</button><button data-z=\"5\" class=\"on\" type=\"button\">V</button><button data-z=\"6\" type=\"button\">VI</button><button data-z=\"7\" type=\"button\">VII</button></div>\n      <div class=\"small dim\" id=\"zoneTxt\" style=\"margin-top:8px\"></div>\n    </div>\n    <canvas id=\"hist\" width=\"600\" height=\"184\"></canvas>\n    <div class=\"stats\">\n      <div class=\"stat\"><b id=\"stC\">--</b><span>contrast</span></div>\n      <div class=\"stat\"><b id=\"stH\">--</b><span>highlights lost</span></div>\n      <div class=\"stat\"><b id=\"stS\">--</b><span>shadows lost</span></div>\n    </div>\n    <div class=\"note\" id=\"advice\"></div>\n  </div>\n  <div class=\"btns\" style=\"grid-template-columns:1fr\"><button class=\"btn\" id=\"bUse\" type=\"button\">Work out camera settings</button></div>\n</section>\n\n<section id=\"tExpose\">\n  <div class=\"card\" style=\"margin-top:4px\">\n    <div id=\"trip\"><div id=\"tA\"><b>--</b><span>Aperture</span></div><div id=\"tK\"><b>--</b><span>Shutter</span></div><div id=\"tJ\"><b>--</b><span>ISO</span></div></div>\n    <div id=\"exBanner\"></div>\n  </div>\n  <div class=\"card\">\n    <h3>What are you shooting?</h3>\n    <div class=\"chips\" id=\"presets\"></div>\n    <div class=\"small dim\" id=\"presetNote\">Pick one for a starting point, then adjust below.</div>\n  </div>\n  <div class=\"card\">\n    <h3>Work out the</h3>\n    <div class=\"seg\" id=\"segSolve\"><button data-s=\"k\" type=\"button\">Shutter</button><button data-s=\"a\" type=\"button\">Aperture</button><button data-s=\"j\" type=\"button\">ISO</button></div>\n    <div class=\"rl\"><b>Aperture</b><span id=\"capA\"></span></div><div class=\"chips ruler\" id=\"rA\"></div>\n    <div class=\"rl\"><b>Shutter</b><span id=\"capK\"></span></div><div class=\"chips ruler\" id=\"rK\"></div>\n    <div class=\"rl\"><b>ISO</b><span id=\"capJ\"></span></div><div class=\"chips ruler\" id=\"rJ\"></div>\n  </div>\n  <div class=\"card\">\n    <h3>Exposure compensation</h3>\n    <div class=\"step\"><button id=\"cM\" type=\"button\" aria-label=\"Darker\">&minus;</button><div class=\"v\" id=\"cV\">0</div><button id=\"cP\" type=\"button\" aria-label=\"Brighter\">+</button></div>\n    <div class=\"rl\"><b>ND filter</b><span>stops of light removed</span></div>\n    <div class=\"chips\" id=\"nds\"></div>\n  </div>\n  <div class=\"card\"><h3>Check before you shoot</h3><ul id=\"checks\"></ul></div>\n  <div class=\"card\"><h3>Same exposure, other ways</h3><div class=\"chips\" id=\"equiv\"></div><div class=\"small dim\">Each one lets in the same light. Tap to use it.</div></div>\n</section>\n\n<section id=\"tDepth\">\n  <div class=\"card\" style=\"margin-top:4px\">\n    <h3>Depth of field</h3>\n    <canvas id=\"dof\" width=\"600\" height=\"192\"></canvas>\n    <div class=\"rl\"><b>Focus distance</b><span class=\"num\" id=\"dV\"></span></div>\n    <input type=\"range\" id=\"dist\" min=\"0\" max=\"1000\" step=\"1\" aria-label=\"Focus distance\">\n    <div class=\"rl\"><b>Aperture</b><span id=\"dCap\"></span></div><div class=\"chips ruler\" id=\"rD\"></div>\n    <div class=\"kv\">\n      <div class=\"stat\"><b id=\"dN\">--</b><span>sharp from</span></div>\n      <div class=\"stat\"><b id=\"dF\">--</b><span>sharp to</span></div>\n      <div class=\"stat\"><b id=\"dT\">--</b><span>total depth</span></div>\n      <div class=\"stat\"><b id=\"dH\">--</b><span>hyperfocal</span></div>\n    </div>\n    <div class=\"note\" id=\"dNote\"></div>\n  </div>\n</section>\n\n<section id=\"tKit\">\n  <div class=\"card\" style=\"margin-top:4px\">\n    <h3>Camera</h3>\n    <div class=\"f\"><label for=\"kSensor\">Sensor</label><select id=\"kSensor\"></select></div>\n    <div class=\"f\"><label for=\"kKmax\">Fastest shutter</label><select id=\"kKmax\"></select></div>\n    <div class=\"f\"><label for=\"kJmin\">Lowest ISO</label><select id=\"kJmin\"></select></div>\n    <div class=\"f\"><label for=\"kJmax\">Highest ISO</label><select id=\"kJmax\"></select></div>\n    <div class=\"f\"><label for=\"kJok\">Comfortable ISO<small>Above this you'll be warned about noise</small></label><select id=\"kJok\"></select></div>\n  </div>\n  <div class=\"card\">\n    <h3>Lens</h3>\n    <div class=\"f\"><label for=\"kFocal\">Focal length<small>The number on the lens, in mm</small></label><input id=\"kFocal\" type=\"number\" inputmode=\"decimal\" min=\"4\" max=\"1200\"></div>\n    <div class=\"f\"><label for=\"kAmin\">Widest aperture</label><select id=\"kAmin\"></select></div>\n    <div class=\"f\"><label for=\"kAmax\">Narrowest aperture</label><select id=\"kAmax\"></select></div>\n    <div class=\"f\"><label for=\"kIS\">Stabilisation<small>Lens or body, in stops. 0 if none</small></label><select id=\"kIS\"></select></div>\n  </div>\n  <div class=\"card\">\n    <h3>Display</h3>\n    <div class=\"f\"><label for=\"kUnit\">Distances in</label><select id=\"kUnit\"><option value=\"m\">metres</option><option value=\"ft\">feet</option></select></div>\n  </div>\n</section>\n</main>\n<nav id=\"nav\">\n  <button data-t=\"tMeter\" class=\"on\" type=\"button\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 17a9 9 0 0 1 18 0\"/><path d=\"M12 17l4-7\"/></svg>Meter</button>\n  <button data-t=\"tExpose\" type=\"button\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 3l3.5 6M21 12h-7M17 19.5L13.5 14M7 19.5l3.5-6M3 12h7M7 4.5L10.5 10\"/></svg>Expose</button>\n  <button data-t=\"tDepth\" type=\"button\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 12h18M7 8v8M17 6v12M12 10v4\"/></svg>Depth</button>\n  <button data-t=\"tKit\" type=\"button\"><svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"7\" width=\"18\" height=\"13\" rx=\"2\"/><path d=\"M8 7l1.5-3h5L16 7\"/><circle cx=\"12\" cy=\"13.5\" r=\"3.5\"/></svg>Kit</button>\n</nav>\n</div>\n\n<div class=\"sheet hidden\" id=\"scSheet\"><div class=\"in\">\n  <h2>Pick the light</h2><p class=\"sub\">Choose what matches where you are standing. You can fine adjust afterwards.</p>\n  <div id=\"scGrid\"></div>\n  <div class=\"btns\" style=\"grid-template-columns:1fr\"><button class=\"btn\" id=\"scClose\" type=\"button\">Cancel</button></div>\n</div></div>\n\n<div class=\"sheet hidden\" id=\"helpSheet\"><div class=\"in help\">\n  <h2>How it works</h2>\n  <p class=\"sub\">A reading of the light, turned into settings for your camera in manual mode.</p>\n  <ul>\n    <li><b>Meter with a photo.</b> Take or choose a photo of the scene. Your phone records the shutter, aperture and ISO it chose, and the app works the light level out from those. Nothing is uploaded.</li>\n    <li><b>Pick the light.</b> No photo needed: choose the conditions and the app uses the well-known light level for them (the \"sunny 16\" family of rules).</li>\n    <li><b>EV</b> is the light level at ISO 100. Each step of 1 is one stop: twice or half the light.</li>\n    <li><b>Tap the photo</b> to meter one spot, such as a face, and choose how bright it should come out. Zone V is a mid-tone, VI is pale skin, VII is bright but still detailed.</li>\n    <li><b>Expose</b> works out the third setting from the two you choose, within the limits of the camera and lens you set under Kit.</li>\n  </ul>\n  <p class=\"dim\">Expect the reading to be within about half a stop. Phones brighten shadows and hold back highlights, so spot readings and contrast are estimates. Take a test shot and check your camera's histogram.</p>\n  <div class=\"btns\" style=\"grid-template-columns:1fr\"><button class=\"btn pri\" id=\"helpClose\" type=\"button\">Got it</button></div>\n</div></div>\n\n<script>\n(function(){\n'use strict';\nvar $=function(id){return document.getElementById(id);};\nfunction el(tag,cls,txt){var e=document.createElement(tag);if(cls)e.className=cls;if(txt!=null)e.textContent=txt;return e;}\nfunction clamp(v,a,b){return v<a?a:v>b?b:v;}\nfunction log2(x){return Math.log(x)/Math.LN2;}\nfunction hap(k){try{if(window.myllmHaptic)window.myllmHaptic(k||'light');}catch(e){}}\n\n/* ---------- scales, all in thirds of a stop ---------- */\nvar AN=['1','1.1','1.2','1.4','1.6','1.8','2','2.2','2.5','2.8','3.2','3.5','4','4.5','5','5.6','6.3','7.1','8','9','10','11','13','14','16','18','20','22','25','29','32'];\nvar KD=[32000,25000,20000,16000,12800,10000,8000,6400,5000,4000,3200,2500,2000,1600,1250,1000,800,640,500,400,320,250,200,160,125,100,80,60,50,40,30,25,20,15,13,10,8,6,5,4]; /* k=45..6 */\nvar KS=['1','1.3','1.6','2','2.5','3.2','4','5','6','8','10','13','15','20','25','30']; /* k=0..-15 */\nvar KF=['0.3','0.4','0.5','0.6','0.8']; /* k=5..1 */\nvar JN=[50,64,80,100,125,160,200,250,320,400,500,640,800,1000,1250,1600,2000,2500,3200,4000,5000,6400,8000,10000,12800,16000,20000,25600,32000,40000,51200,64000,80000,102400]; /* j=-3..30 */\nvar KMIN=-33,KTOP=45,AMAXI=AN.length-1,JLO=-3,JHI=30;\nfunction fA(a){return 'f/'+AN[clamp(a,0,AMAXI)];}\nfunction secs(k){ if(k>=-15) return Math.pow(2,-k/3); var n=-15-k; return [30,40,50][n%3]*Math.pow(2,Math.floor(n/3)); }\nfunction fK(k){\n  k=clamp(k,KMIN,KTOP);\n  if(k>=6) return '1/'+KD[45-k];\n  if(k>=1) return KF[5-k]+'s';\n  if(k>=-15) return KS[-k]+'s';\n  var s=secs(k),m=Math.floor(s/60),r=Math.round(s-m*60);\n  return m+'m'+(r?(r<10?'0':'')+r+'s':'');\n}\nfunction fJ(j){return String(JN[clamp(j,JLO,JHI)+3]);}\nfunction nA(a){return Math.pow(2,a/6);}\nfunction stops(n){ n=Math.abs(n); var w=Math.floor(n/3),r=n%3,f=r===1?'\u2153':r===2?'\u2154':''; return (w||!f?String(w):'')+f; }\nfunction stopsTxt(n){ var s=stops(n); return s+(Math.abs(n)===3||Math.abs(n)<3?' stop':' stops'); }\nfunction sgn(n){return n>0?'+':n<0?'\u2212':'';}\n\n/* ---------- scenes ---------- */\nvar SC=[\n {ev:16,n:'Snow or sand in full sun',img:'data:image/jpeg;base64,'},\n {ev:15,n:'Full sun, hard shadows',img:'data:image/jpeg;base64,'},\n {ev:14,n:'Hazy sun, soft shadows',img:'data:image/jpeg;base64,'},\n {ev:13,n:'Bright cloud, no shadows',img:'data:image/jpeg;base64,'},\n {ev:12,n:'Overcast or open shade',img:'data:image/jpeg;base64,'},\n {ev:11,n:'Deep shade or sunset',img:'data:image/jpeg;base64,'},\n {ev:9,n:'Dusk, just after sunset',img:'data:image/jpeg;base64,'},\n {ev:8,n:'Neon street or stage',img:'data:image/jpeg;base64,'},\n {ev:6,n:'Room lit by lamps',img:'data:image/jpeg;base64,'},\n {ev:4,n:'Candles or street lamps',img:'data:image/jpeg;base64,'},\n {ev:-2,n:'Landscape by full moon',img:'data:image/jpeg;base64,'},\n {ev:-6,n:'Starry sky, Milky Way',img:'data:image/jpeg;base64,'}\n];\nfunction evName(ev){ var b=SC[0],d=99; SC.forEach(function(s){var x=Math.abs(s.ev-ev);if(x<d){d=x;b=s;}}); return b.n; }\n\n/* ---------- state ---------- */\nvar SENS=[['Medium format',0.79],['Full frame',1],['APS-C',1.5],['APS-C (Canon)',1.6],['Micro Four Thirds',2],['1-inch',2.7]];\nvar KIT0={sensor:1,focal:50,aMin:5,aMax:27,kMax:39,jMin:0,jMax:24,jOk:15,is:0,unit:'m'};\nvar S={evBase:null,src:'',adj:0,mode:'avg',zone:5,spot:null,a:12,k:21,j:0,solve:'k',comp:0,nd:0,dist:3,preset:'',kit:JSON.parse(JSON.stringify(KIT0))};\nvar KEY='lightmeter.v1',mem=null,saveT=0;\nfunction save(){ clearTimeout(saveT); saveT=setTimeout(function(){\n  var o={evBase:S.evBase,src:S.src,adj:S.adj,a:S.a,k:S.k,j:S.j,solve:S.solve,comp:S.comp,nd:S.nd,dist:S.dist,kit:S.kit};\n  mem=JSON.stringify(o);\n  try{ if(window.myllmStorage) window.myllmStorage.setItem(KEY,mem); }catch(e){}\n},250); }\nfunction load(){ try{ if(window.myllmStorage){ return Promise.resolve(window.myllmStorage.getItem(KEY)).then(function(v){return v||mem;},function(){return mem;}); } }catch(e){} return Promise.resolve(mem); }\nfunction crop(){return SENS[S.kit.sensor][1];}\nfunction ev(){ if(S.evBase==null) return null; var e=S.evBase+S.adj/3; if(S.mode==='spot'&&S.spot) e+=S.spot.stops-(S.zone-5); return e; }\nfunction evOr(){ var e=ev(); return e==null?12:e; }\nfunction E3(){ return Math.round(3*evOr())-S.comp-3*S.nd; }\n\n/* ---------- exposure maths ---------- */\nvar over=0; /* thirds; + means the picture comes out too bright */\nfunction solve(){\n  var K=S.kit,e=E3(); over=0;\n  if(S.solve==='k'){ var k=e+S.j-S.a; if(k>K.kMax){over=k-K.kMax;k=K.kMax;} else if(k<KMIN){over=k-KMIN;k=KMIN;} S.k=k; }\n  else if(S.solve==='a'){ var a=e+S.j-S.k; if(a>K.aMax){over=a-K.aMax;a=K.aMax;} else if(a<K.aMin){over=a-K.aMin;a=K.aMin;} S.a=a; }\n  else { var j=S.a+S.k-e; if(j<K.jMin){over=K.jMin-j;j=K.jMin;} else if(j>K.jMax){over=K.jMax-j;j=K.jMax;} S.j=j; }\n}\nfunction kHand(){ var K=S.kit; return Math.max(3,Math.ceil(3*log2(K.focal*crop())-3*K.is-1e-9)); }\nvar PRE=[\n ['portrait','Portrait','Widest aperture to blur the background, lowest ISO that keeps the shutter safe.'],\n ['landscape','Landscape','A middle aperture for depth and sharpness at your lowest ISO. Use a tripod if the shutter gets slow.'],\n ['action','Action','1/1000s to freeze movement, aperture wide open, ISO does the rest.'],\n ['lowlight','Low light, handheld','Wide open at the slowest shutter you can hold steady, then as little ISO as possible.'],\n ['water','Silky water','A long shutter on a tripod. The ND filter shown is the weakest that gets you there.'],\n ['stars','Night sky','Wide open, the longest shutter before stars trail (the 500 rule), ISO does the rest. Tripod.']\n];\nfunction preset(id){\n  var K=S.kit,e,need;\n  S.preset=id; S.comp=0; if(id!=='water') S.nd=0; e=E3();\n  if(id==='portrait'){\n    S.j=K.jMin; S.a=K.aMin; S.k=e+S.j-S.a; need=Math.max(kHand(),18);\n    if(S.k<need){ S.j=Math.min(K.jMax,S.j+need-S.k); S.k=e+S.j-S.a; }\n    if(S.k>K.kMax){ S.a=Math.min(K.aMax,S.a+S.k-K.kMax); }\n    S.solve='k';\n  } else if(id==='landscape'){\n    S.j=K.jMin; S.a=clamp(Math.round(18-6*log2(crop())),K.aMin,K.aMax); S.solve='k';\n  } else if(id==='action'){\n    S.k=Math.min(30,K.kMax); S.a=K.aMin; S.j=S.a+S.k-e;\n    if(S.j>K.jMax){ S.k=Math.max(24,S.k-(S.j-K.jMax)); }\n    else if(S.j<K.jMin){ var d=K.jMin-S.j, up=Math.min(d,K.kMax-S.k); S.k+=up; S.a=Math.min(K.aMax,S.a+d-up); }\n    S.solve='j';\n  } else if(id==='lowlight'){\n    S.a=K.aMin; S.k=Math.max(kHand(),12); S.j=S.a+S.k-e;\n    if(S.j<K.jMin){ S.k=Math.min(K.kMax,S.k+K.jMin-S.j); }\n    S.solve='j';\n  } else if(id==='water'){\n    S.j=K.jMin; S.a=Math.min(K.aMax,21); var nds=[0,3,6,10],i,ok=false;\n    for(i=0;i<nds.length;i++){ S.nd=nds[i]; if(E3()+S.j-S.a<=3){ok=true;break;} }\n    if(!ok){ S.a=Math.min(K.aMax,24); }\n    S.solve='k';\n  } else if(id==='stars'){\n    S.a=K.aMin; S.k=Math.ceil(-3*log2(500/(K.focal*crop()))-1e-9); S.solve='j';\n  }\n  solve(); renderAll(); save(); hap('light');\n}\n\n/* ---------- depth of field ---------- */\nfunction dof(a,s){ /* s in metres */\n  var f=S.kit.focal/1000,N=nA(a),c=0.00003/crop(),H=f*f/(N*c)+f;\n  var near=s*(H-f)/(H+s-2*f), far=s<H?s*(H-f)/(H-s):Infinity;\n  return {H:H,near:near,far:far};\n}\nfunction fD(m){\n  if(!isFinite(m)) return '\u221e';\n  var ft=S.kit.unit==='ft',v=ft?m*3.28084:m,u=ft?' ft':' m';\n  if(!ft&&v<1) return Math.round(v*100)+' cm';\n  return (v<10?v.toFixed(v<3?2:1):String(Math.round(v)))+u;\n}\n\n/* ---------- EXIF ---------- */\nfunction readExif(buf){\n  try{\n    var d=new DataView(buf),n=d.byteLength,t=-1,o,i;\n    if(n>12&&d.getUint16(0)===0xFFD8){\n      o=2; while(o+10<n){ var m=d.getUint16(o); if((m&0xFF00)!==0xFF00||m===0xFFDA) break; var len=d.getUint16(o+2);\n        if(m===0xFFE1&&d.getUint32(o+4)===0x45786966&&d.getUint16(o+8)===0){t=o+10;break;} o+=2+len; }\n    }\n    if(t<0){ var u=new Uint8Array(buf,0,Math.min(n,786432));\n      for(i=0;i<u.length-16;i++){ if(u[i]===0x45&&u[i+1]===0x78&&u[i+2]===0x69&&u[i+3]===0x66&&u[i+4]===0&&u[i+5]===0){ var b=i+6;\n        if((u[b]===0x49&&u[b+1]===0x49&&u[b+2]===0x2A&&u[b+3]===0)||(u[b]===0x4D&&u[b+1]===0x4D&&u[b+2]===0&&u[b+3]===0x2A)){t=b;break;} } } }\n    if(t<0) return null;\n    var le=d.getUint16(t)===0x4949, out={};\n    var u16=function(p){return d.getUint16(p,le);}, u32=function(p){return d.getUint32(p,le);};\n    var val=function(p){ var ty=u16(p+2),vp=p+8;\n      if(ty===3) return u16(vp); if(ty===4) return u32(vp);\n      if(ty===5){ var q=t+u32(vp),dn=u32(q+4); return dn?u32(q)/dn:0; }\n      if(ty===10){ var q2=t+u32(vp),dn2=d.getInt32(q2+4,le); return dn2?d.getInt32(q2,le)/dn2:0; }\n      return null; };\n    var walk=function(p,cb){ var c=u16(p),x; if(c>400) return; for(x=0;x<c;x++){ var e=p+2+x*12; if(e+12>n) return; cb(u16(e),e); } };\n    var sub=0;\n    walk(t+u32(t+4),function(tag,e){ if(tag===0x8769) sub=t+u32(e+8); });\n    if(!sub) return null;\n    walk(sub,function(tag,e){\n      if(tag===0x829A) out.t=val(e); else if(tag===0x829D) out.N=val(e); else if(tag===0x8827) out.iso=val(e);\n      else if(tag===0x8833&&!out.iso) out.iso=val(e); else if(tag===0x9204) out.bias=val(e); else if(tag===0xA405) out.f35=val(e);\n    });\n    if(!(out.t>0&&out.N>0&&out.iso>0)) return null;\n    out.ev=log2(out.N*out.N/out.t)-log2(out.iso/100)+(isFinite(out.bias)?out.bias:0);\n    return isFinite(out.ev)?out:null;\n  }catch(e){ return null; }\n}\nfunction fT(t){ return t>=0.35?(Math.round(t*10)/10)+'s':'1/'+Math.round(1/t)+'s'; }\n\n/* ---------- photo analysis ---------- */\nvar P=null; /* {img,w,h,lin:Float32Array (analysis grid),aw,ah,hist,...} */\nvar LUT=(function(){var a=new Float32Array(256),i,c;for(i=0;i<256;i++){c=i/255;a[i]=c<=0.04045?c/12.92:Math.pow((c+0.055)/1.055,2.4);}return a;})();\nfunction analyse(img){\n  var W=img.naturalWidth||img.width,H=img.naturalHeight||img.height; if(!W||!H) return null;\n  var sc=Math.min(1,720/Math.max(W,H)),w=Math.max(1,Math.round(W*sc)),h=Math.max(1,Math.round(H*sc));\n  var cv=$('pc'); cv.width=w; cv.height=h; var cx=cv.getContext('2d'); cx.drawImage(img,0,0,w,h);\n  var asc=Math.min(1,240/Math.max(w,h)),aw=Math.max(1,Math.round(w*asc)),ah=Math.max(1,Math.round(h*asc));\n  var t=document.createElement('canvas'); t.width=aw; t.height=ah; var tx=t.getContext('2d'); tx.drawImage(img,0,0,aw,ah);\n  var px; try{ px=tx.getImageData(0,0,aw,ah).data; }catch(e){ return null; }\n  var n=aw*ah,lin=new Float32Array(n),hl=new Uint32Array(256),hr=new Uint32Array(256),hg=new Uint32Array(256),hb=new Uint32Array(256),hi=0,lo=0,i,r,g,b,y,mask=new Uint8Array(n);\n  for(i=0;i<n;i++){ r=px[i*4];g=px[i*4+1];b=px[i*4+2];\n    y=0.2126*LUT[r]+0.7152*LUT[g]+0.0722*LUT[b]; lin[i]=y;\n    hr[r]++;hg[g]++;hb[b]++;hl[Math.round(0.299*r+0.587*g+0.114*b)]++;\n    if(r>=252&&g>=252&&b>=252){hi++;mask[i]=1;} else if(r<=5&&g<=5&&b<=5){lo++;mask[i]=2;} }\n  var sorted=Float32Array.from(lin); sorted.sort();\n  var p1=Math.max(sorted[Math.floor(n*0.01)],0.0008),p99=Math.max(sorted[Math.min(n-1,Math.floor(n*0.99))],p1);\n  return {img:img,w:w,h:h,aw:aw,ah:ah,lin:lin,mask:mask,hl:hl,hr:hr,hg:hg,hb:hb,hi:hi/n,lo:lo/n,contrast:log2(p99/p1),clip:false};\n}\nfunction drawPhoto(){\n  if(!P) return; var cv=$('pc'),cx=cv.getContext('2d'); cx.drawImage(P.img,0,0,P.w,P.h);\n  if(P.clip){ var sx=P.w/P.aw,sy=P.h/P.ah,x,y,m;\n    for(y=0;y<P.ah;y++) for(x=0;x<P.aw;x++){ m=P.mask[y*P.aw+x]; if(m){ cx.fillStyle=m===1?'#ff3b30':'#2f8cff'; cx.fillRect(Math.floor(x*sx),Math.floor(y*sy),Math.ceil(sx),Math.ceil(sy)); } } }\n}\nfunction drawHist(){\n  var cv=$('hist'),cx=cv.getContext('2d'),W=cv.width,H=cv.height,i; cx.clearRect(0,0,W,H); if(!P) return;\n  var mx=0; for(i=2;i<254;i++) mx=Math.max(mx,P.hl[i]); mx=Math.max(mx,1)*1.08;\n  cx.strokeStyle='rgba(255,255,255,.08)'; cx.lineWidth=1; for(i=1;i<4;i++){ cx.beginPath(); cx.moveTo(W*i/4,0); cx.lineTo(W*i/4,H); cx.stroke(); }\n  var path=function(h,fill){ cx.beginPath(); cx.moveTo(0,H); for(var k=0;k<256;k++){ var v=(h[Math.max(0,k-1)]+h[k]*2+h[Math.min(255,k+1)])/4; cx.lineTo(k/255*W,H-Math.min(1,v/mx)*(H-6)); } cx.lineTo(W,H); if(fill){cx.closePath();cx.fill();} else cx.stroke(); };\n  cx.fillStyle='rgba(242,239,232,.30)'; path(P.hl,true);\n  cx.globalCompositeOperation='lighter'; cx.lineWidth=2;\n  cx.strokeStyle='rgba(255,90,80,.75)'; path(P.hr); cx.strokeStyle='rgba(90,220,120,.7)'; path(P.hg); cx.strokeStyle='rgba(90,150,255,.8)'; path(P.hb);\n  cx.globalCompositeOperation='source-over';\n  if(P.lo>0.005){ cx.fillStyle='#2f8cff'; cx.fillRect(0,0,5,H); } if(P.hi>0.005){ cx.fillStyle='#ff3b30'; cx.fillRect(W-5,0,5,H); }\n}\nfunction pct(v){ return v<0.001?'0%':v<0.01?'<1%':Math.round(v*100)+'%'; }\nfunction renderPhoto(){\n  $('photoCard').classList.toggle('hidden',!P); if(!P) return;\n  drawPhoto(); drawHist();\n  var cl=P.hi>0.01||P.lo>0.01;\n  $('stC').textContent=(cl?'>':'')+P.contrast.toFixed(1)+' st'; $('stH').textContent=pct(P.hi); $('stS').textContent=pct(P.lo);\n  $('stH').style.color=P.hi>0.02?'var(--red)':''; $('stS').style.color=P.lo>0.02?'var(--blue)':'';\n  var adv;\n  if(P.hi>0.02)