)) return; }\n    if(key==='focal') v=clamp(Math.round(v*10)/10,4,1200);\n    S.kit[key]=v; fixKit(); S.preset=''; solve(); renderAll(); syncKit(); save(); }; };\n  bind('kSensor','sensor',1); bind('kKmax','kMax',1); bind('kJmin','jMin',1); bind('kJmax','jMax',1); bind('kJok','jOk',1);\n  bind('kFocal','focal',1); bind('kAmin','aMin',1); bind('kAmax','aMax',1); bind('kIS','is',1); bind('kUnit','unit',0);\n}\nfunction fixKit(){\n  var K=S.kit,k; for(k in KIT0){ if(K[k]==null||(k!=='unit'&&!isFinite(K[k]))) K[k]=KIT0[k]; }\n  K.sensor=clamp(Math.round(K.sensor),0,SENS.length-1); K.aMin=clamp(K.aMin,0,18); K.aMax=clamp(K.aMax,18,AMAXI);\n  K.jMin=clamp(K.jMin,JLO,3); K.jMax=clamp(K.jMax,12,JHI); K.jOk=clamp(K.jOk,6,24); K.kMax=clamp(K.kMax,33,KTOP);\n  K.focal=clamp(K.focal,4,1200); K.is=clamp(K.is,0,8); if(K.unit!=='ft') K.unit='m';\n  S.a=clamp(S.a,K.aMin,K.aMax); S.k=clamp(S.k,KMIN,K.kMax); S.j=clamp(S.j,K.jMin,K.jMax);\n}\nfunction syncKit(){ var K=S.kit; $('kSensor').value=K.sensor; $('kKmax').value=K.kMax; $('kJmin').value=K.jMin; $('kJmax').value=K.jMax; $('kJok').value=K.jOk; $('kFocal').value=K.focal; $('kAmin').value=K.aMin; $('kAmax').value=K.aMax; $('kIS').value=K.is; $('kUnit').value=K.unit; }\n\n/* ---------- wiring ---------- */\nfunction tab(id){ [].forEach.call(document.querySelectorAll('section'),function(s){s.classList.toggle('on',s.id===id);}); [].forEach.call($('nav').children,function(b){b.classList.toggle('on',b.dataset.t===id);}); $('main').scrollTop=0;\n  ['rA','rK','rJ','rD','equiv'].forEach(function(r){centre($(r));}); }\nfunction init(){\n  var g=$('ticks'),NS='http://www.w3.org/2000/svg',i;\n  for(i=-6;i<=17;i++){ var an=Math.PI*(1-(i+6)/23),big=i%5===0,r1=big?100:106,r2=112,l=document.createElementNS(NS,'line');\n    l.setAttribute('x1',150+r1*Math.cos(an)); l.setAttribute('y1',150-r1*Math.sin(an)); l.setAttribute('x2',150+r2*Math.cos(an)); l.setAttribute('y2',150-r2*Math.sin(an));\n    l.setAttribute('stroke',big?'#f2efe8':'#6b6860'); l.setAttribute('stroke-width',big?2:1); g.appendChild(l);\n    if(big){ var t=document.createElementNS(NS,'text'); t.setAttribute('x',150+86*Math.cos(an)); t.setAttribute('y',150-86*Math.sin(an)+4); t.setAttribute('text-anchor','middle'); t.setAttribute('font-size','11'); t.setAttribute('font-family','ui-monospace,Menlo,monospace'); t.setAttribute('fill','#a09c92'); t.textContent=(i<0?'\u2212':'')+Math.abs(i); g.appendChild(t); } }\n  SC.forEach(function(s){ var b=el('button','sc'); b.type='button'; if(s.img) b.style.backgroundImage='url('+s.img+')'; b.appendChild(el('em','','EV '+(s.ev<0?'\u2212':'')+Math.abs(s.ev))); b.appendChild(el('span','',s.n));\n    b.onclick=function(){ S.evBase=s.ev; S.src='Picked: '+s.n.toLowerCase()+'.'; S.srcWarn=''; S.adj=0; if(S.mode==='spot'&&!S.spot) S.mode='avg'; $('scSheet').classList.add('hidden'); solve(); renderAll(); save(); hap('success'); }; $('scGrid').appendChild(b); });\n  PRE.forEach(function(p){ var c=el('button','chip',p[1]); c.type='button'; c.dataset.p=p[0]; c.onclick=function(){preset(p[0]);}; $('presets').appendChild(c); });\n  [0,1,2,3,6,10,15].forEach(function(n){ var c=el('button','chip num',n?String(n):'None'); c.type='button'; c.dataset.n=n; c.onclick=function(){ S.nd=n; S.preset=''; solve(); renderAll(); save(); hap('light'); }; $('nds').appendChild(c); });\n  buildKit();\n  [].forEach.call($('nav').children,function(b){ b.onclick=function(){tab(b.dataset.t);}; });\n  $('bUse').onclick=function(){tab('tExpose');};\n  $('bScene').onclick=function(){ $('scSheet').classList.remove('hidden'); $('scSheet').scrollTop=0; };\n  $('scClose').onclick=function(){ $('scSheet').classList.add('hidden'); };\n  $('bHelp').onclick=function(){ $('helpSheet').classList.remove('hidden'); $('helpSheet').scrollTop=0; };\n  $('helpClose').onclick=function(){ $('helpSheet').classList.add('hidden'); };\n  $('file').onchange=function(){ var f=this.files&&this.files[0]; this.value=''; onFile(f); };\n  if(typeof window.myllmPickImage==='function'){ $('bPick').classList.remove('hidden');\n    $('bPick').onclick=function(){ Promise.resolve().then(function(){return window.myllmPickImage({maxDim:1200});}).then(function(u){ if(u) usePhoto(u,null); },function(){}); }; }\n  $('adjM').onclick=function(){ S.adj=clamp(S.adj-1,-9,9); solve(); renderAll(); save(); hap('light'); };\n  $('adjP').onclick=function(){ S.adj=clamp(S.adj+1,-9,9); solve(); renderAll(); save(); hap('light'); };\n  $('cM').onclick=function(){ S.comp=clamp(S.comp-1,-9,9); S.preset=''; solve(); renderAll(); save(); hap('light'); };\n  $('cP').onclick=function(){ S.comp=clamp(S.comp+1,-9,9); S.preset=''; solve(); renderAll(); save(); hap('light'); };\n  [].forEach.call($('segSolve').children,function(b){ b.onclick=function(){ S.solve=b.dataset.s; S.preset=''; solve(); renderAll(); save(); }; });\n  [].forEach.call($('segMode').children,function(b){ b.onclick=function(){ S.mode=b.dataset.m; solve(); renderAll(); }; });\n  [].forEach.call($('segZone').children,function(b){ b.onclick=function(){ S.zone=+b.dataset.z; solve(); renderAll(); hap('light'); }; });\n  $('bClip').onclick=function(){ if(P){ P.clip=!P.clip; renderPhoto(); } };\n  $('pcWrap').onclick=function(e){ var r=$('pc').getBoundingClientRect(); if(!r.width) return; spotAt(clamp((e.clientX-r.left)/r.width,0,1),clamp((e.clientY-r.top)/r.height,0,1)); };\n  $('dist').oninput=function(){ S.dist=s2d(+this.value); renderDepth(); renderExpose(); save(); };\n  load().then(function(v){\n    try{ var o=v?JSON.parse(v):null; if(o){ ['evBase','src','adj','a','k','j','solve','comp','nd','dist'].forEach(function(k){ if(o[k]!=null) S[k]=o[k]; }); if(o.kit){ for(var k in o.kit) S.kit[k]=o.kit[k]; } } }catch(e){}\n    if(typeof S.evBase!=='number'||!isFinite(S.evBase)) S.evBase=null;\n    if(['a','k','j'].indexOf(S.solve)<0) S.solve='k'; S.adj=clamp(Math.round(+S.adj||0),-9,9); S.comp=clamp(Math.round(+S.comp||0),-9,9); S.nd=clamp(Math.round(+S.nd||0),0,15); S.dist=clamp(+S.dist||3,0.3,100);\n    S.a=Math.round(+S.a||12); S.k=Math.round(+S.k||21); S.j=Math.round(+S.j||0);\n    fixKit(); syncKit(); solve(); renderAll();\n  });\n  window.__lm={S:S,solve:solve,render:renderAll,readExif:readExif,preset:preset,tab:tab,fA:fA,fK:fK,fJ:fJ,over:function(){return over;},P:function(){return P;},spotAt:spotAt};\n}\ninit();\n})();\n</script>\n</body>\n</html>\n"}