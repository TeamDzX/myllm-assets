{"name": "Piano Rush", "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no\">\n<title>Piano Rush</title>\n<style>\n:root{\n  color-scheme:dark;\n  --font:var(--myllm-font,-apple-system,system-ui,\"Segoe UI\",Roboto,sans-serif);\n  --bg1:#0b0a14; --bg2:#141024;\n  --surface:#1a1728; --surface2:#241f38;\n  --ink:#f1eff7; --muted:#9a94ab; --faint:#67617a;\n  --border:#2b2640;\n  --acc:#8b5cf6; --acc2:#e0559e; --gold:#f5c26b; --good:#5eead4;\n  --lane0:#8b5cf6; --lane1:#5e9eff; --lane2:#5eead4; --lane3:#e0559e;\n  --radius:16px;\n  --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 28px -14px rgba(0,0,0,.7);\n}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none}\nhtml,body{height:100%}\nbody{font-family:var(--font);margin:0;background:linear-gradient(180deg,var(--bg1),var(--bg2));\n  color:var(--ink);overflow:hidden;position:fixed;inset:0;touch-action:none}\n\n/* ---------- home ---------- */\n.screen{position:absolute;inset:0;display:none;flex-direction:column;overflow:hidden}\n.screen.on{display:flex}\n#home{padding:calc(14px + env(safe-area-inset-top)) 16px calc(14px + env(safe-area-inset-bottom));overflow-y:auto;touch-action:pan-y}\n.logo{text-align:center;margin:10px 0 2px;font-size:34px;font-weight:850;letter-spacing:-.02em;\n  background:linear-gradient(90deg,var(--acc),var(--acc2),var(--gold));-webkit-background-clip:text;background-clip:text;color:transparent}\n.sub{text-align:center;color:var(--muted);font-size:13.5px;margin:0 0 16px}\n.speeds{display:flex;gap:8px;justify-content:center;margin-bottom:16px}\n.spd{border:1px solid var(--border);background:var(--surface);color:var(--muted);font:inherit;font-size:13px;\n  font-weight:700;padding:8px 16px;border-radius:12px;cursor:pointer}\n.spd.on{background:var(--acc);border-color:var(--acc);color:#fff}\n.song{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:12px 14px;\n  margin-bottom:10px;display:flex;align-items:center;gap:12px;box-shadow:var(--shadow);cursor:pointer}\n.song:active{background:var(--surface2)}\n.song .em{font-size:26px;width:40px;text-align:center}\n.song .si{flex:1;min-width:0}\n.song .si .nm{font-size:15.5px;font-weight:700}\n.song .si .meta{font-size:12px;color:var(--muted);margin-top:2px}\n.song .stars{font-size:13px;letter-spacing:1px;color:var(--gold);text-align:right}\n.song .stars .best{display:block;font-size:11px;color:var(--faint);letter-spacing:0;margin-top:2px}\n.song .lis{border:0;background:var(--surface2);color:var(--muted);width:36px;height:36px;border-radius:10px;\n  cursor:pointer;font-size:14px;flex:0 0 auto}\n.song .lis:active{color:var(--acc)}\n.foot{text-align:center;color:var(--faint);font-size:11.5px;margin-top:14px;line-height:1.6}\n\n/* ---------- game ---------- */\n#game{background:transparent}\n#hud{position:absolute;top:0;left:0;right:0;padding:calc(8px + env(safe-area-inset-top)) 14px 6px;\n  display:flex;align-items:center;gap:10px;z-index:5}\n#hud .score{font-size:22px;font-weight:800;font-variant-numeric:tabular-nums;min-width:86px}\n#hud .prog{flex:1;height:5px;border-radius:3px;background:rgba(255,255,255,.12);overflow:hidden}\n#hud .prog i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--acc),var(--acc2))}\n#quitBtn{border:0;background:rgba(255,255,255,.1);color:var(--ink);font:inherit;font-size:12.5px;font-weight:700;\n  padding:8px 14px;border-radius:11px;cursor:pointer}\n#cv{position:absolute;inset:0;width:100%;height:100%}\n#keys{position:absolute;left:0;right:0;bottom:0;display:flex;z-index:4;\n  height:calc(118px + env(safe-area-inset-bottom));padding-bottom:env(safe-area-inset-bottom)}\n.key{flex:1;margin:0 3px;border-radius:14px 14px 4px 4px;background:linear-gradient(180deg,#f5f3fb,#d9d4ea);\n  border:1px solid rgba(255,255,255,.25);box-shadow:0 -2px 14px rgba(0,0,0,.35),inset 0 -7px 0 rgba(80,70,120,.28);\n  position:relative;touch-action:none}\n.key.hit{transform:translateY(3px);box-shadow:0 -1px 6px rgba(0,0,0,.3),inset 0 -4px 0 rgba(80,70,120,.28)}\n.key::after{content:\"\";position:absolute;left:12%;right:12%;bottom:14px;height:5px;border-radius:3px;opacity:.85}\n.key:nth-child(1)::after{background:var(--lane0)}\n.key:nth-child(2)::after{background:var(--lane1)}\n.key:nth-child(3)::after{background:var(--lane2)}\n.key:nth-child(4)::after{background:var(--lane3)}\n#judge{position:absolute;left:0;right:0;text-align:center;z-index:5;pointer-events:none;\n  font-size:30px;font-weight:850;letter-spacing:.02em;opacity:0;transform:scale(.8);transition:opacity .12s,transform .12s}\n#judge.pop{opacity:1;transform:scale(1)}\n#judge.perfect{color:var(--gold);text-shadow:0 0 18px rgba(245,194,107,.6)}\n#judge.good{color:var(--good);text-shadow:0 0 18px rgba(94,234,212,.5)}\n#judge.miss{color:#ff6b62;text-shadow:0 0 18px rgba(255,107,98,.5)}\n#combo{position:absolute;left:0;right:0;text-align:center;z-index:5;pointer-events:none;\n  font-size:15px;font-weight:800;color:var(--muted)}\n#combo b{color:var(--ink)}\n#count{position:absolute;inset:0;display:none;align-items:center;justify-content:center;z-index:6;\n  font-size:84px;font-weight:850;color:var(--ink);text-shadow:0 0 40px rgba(139,92,246,.8);pointer-events:none}\n\n/* ---------- overlays (pause / results) ---------- */\n.veil{position:absolute;inset:0;background:rgba(8,6,16,.78);z-index:10;display:none;\n  align-items:center;justify-content:center;padding:24px}\n.veil.on{display:flex}\n.panel{background:var(--surface);border:1px solid var(--border);border-radius:22px;box-shadow:var(--shadow);\n  padding:24px 22px;width:100%;max-width:340px;text-align:center}\n.panel h2{margin:0 0 4px;font-size:21px;font-weight:800}\n.panel .psub{color:var(--muted);font-size:13px;margin:0 0 14px}\n.rstars{font-size:38px;letter-spacing:6px;margin:6px 0 10px;color:var(--gold)}\n.rstars .off{color:var(--faint);opacity:.45}\n.rrow{display:flex;justify-content:space-between;font-size:14px;padding:7px 4px;border-bottom:1px solid var(--border)}\n.rrow:last-of-type{border-bottom:0}\n.rrow b{font-variant-numeric:tabular-nums}\n.newbest{color:var(--gold);font-weight:800;font-size:13px;margin-top:8px}\n.pbtns{display:flex;gap:10px;margin-top:16px}\n.pbtns button{flex:1;border:0;font:inherit;font-size:14.5px;font-weight:700;padding:13px 0;border-radius:13px;cursor:pointer}\n.pbtns .ghost{background:var(--surface2);color:var(--ink)}\n.pbtns .go{background:linear-gradient(135deg,var(--acc),var(--acc2));color:#fff;box-shadow:0 6px 16px -8px var(--acc)}\n\n@media(min-width:768px){#home{max-width:560px;margin:0 auto;width:100%}}\n@media(prefers-reduced-motion:reduce){#judge{transition:none}}\n</style></head><body>\n\n<div class=\"screen on\" id=\"home\">\n  <div class=\"logo\">Piano Rush</div>\n  <p class=\"sub\">Tap the keys as the notes reach them — play real songs.</p>\n  <div class=\"speeds\" id=\"speeds\"></div>\n  <div id=\"songList\"></div>\n  <div class=\"foot\">All melodies are traditional or public domain.<br>Best scores are saved on your device.</div>\n</div>\n\n<div class=\"screen\" id=\"game\">\n  <canvas id=\"cv\"></canvas>\n  <div id=\"hud\">\n    <div class=\"score\" id=\"score\">0</div>\n    <div class=\"prog\"><i id=\"pbar\"></i></div>\n    <button id=\"quitBtn\" onclick=\"pauseGame()\">❚❚</button>\n  </div>\n  <div id=\"judge\"></div>\n  <div id=\"combo\"></div>\n  <div id=\"count\"></div>\n  <div id=\"keys\"></div>\n</div>\n\n<div class=\"veil\" id=\"pauseVeil\">\n  <div class=\"panel\">\n    <h2>Paused</h2>\n    <p class=\"psub\" id=\"pauseSong\"></p>\n    <div class=\"pbtns\">\n      <button class=\"ghost\" onclick=\"quitToHome()\">Songs</button>\n      <button class=\"go\" onclick=\"resumeGame()\">Resume</button>\n    </div>\n  </div>\n</div>\n\n<div class=\"veil\" id=\"doneVeil\">\n  <div class=\"panel\">\n    <h2 id=\"doneTitle\">Song complete!</h2>\n    <p class=\"psub\" id=\"doneSong\"></p>\n    <div class=\"rstars\" id=\"doneStars\"></div>\n    <div class=\"rrow\"><span>Score</span><b id=\"rScore\">0</b></div>\n    <div class=\"rrow\"><span>Accuracy</span><b id=\"rAcc\">0%</b></div>\n    <div class=\"rrow\"><span>Best combo</span><b id=\"rCombo\">0</b></div>\n    <div class=\"rrow\"><span>Perfect / Good / Miss</span><b id=\"rPGM\">0/0/0</b></div>\n    <div class=\"newbest\" id=\"rBest\" style=\"display:none\">★ New best!</div>\n    <div class=\"pbtns\">\n      <button class=\"ghost\" onclick=\"quitToHome()\">Songs</button>\n      <button class=\"go\" onclick=\"replaySong()\">Replay</button>\n    </div>\n  </div>\n</div>\n\n<script>\n\"use strict\";\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nfunction el(i){return document.getElementById(i)}\nfunction haptic(k){if(window.myllmHaptic)try{myllmHaptic(k)}catch(e){}}\nvar RM=!!(window.myllmTheme&&myllmTheme.reduceMotion)||\n  (window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches);\n\n/* ================= songs =================\n   Notes as \"Name:beat:durBeats\" — traditional / public-domain melodies. */\nvar SONGS=[\n {id:'twinkle',name:'Twinkle Twinkle',em:'✨',bpm:104,diff:1,\n  n:'C4:0:1 C4:1:1 G4:2:1 G4:3:1 A4:4:1 A4:5:1 G4:6:2 F4:8:1 F4:9:1 E4:10:1 E4:11:1 D4:12:1 D4:13:1 C4:14:2 '+\n    'G4:16:1 G4:17:1 F4:18:1 F4:19:1 E4:20:1 E4:21:1 D4:22:2 G4:24:1 G4:25:1 F4:26:1 F4:27:1 E4:28:1 E4:29:1 D4:30:2 '+\n    'C4:32:1 C4:33:1 G4:34:1 G4:35:1 A4:36:1 A4:37:1 G4:38:2 F4:40:1 F4:41:1 E4:42:1 E4:43:1 D4:44:1 D4:45:1 C4:46:2'},\n {id:'mary',name:'Mary Had a Little Lamb',em:'🐑',bpm:112,diff:1,\n  n:'E4:0:1 D4:1:1 C4:2:1 D4:3:1 E4:4:1 E4:5:1 E4:6:2 D4:8:1 D4:9:1 D4:10:2 E4:12:1 G4:13:1 G4:14:2 '+\n    'E4:16:1 D4:17:1 C4:18:1 D4:19:1 E4:20:1 E4:21:1 E4:22:1 E4:23:1 D4:24:1 D4:25:1 E4:26:1 D4:27:1 C4:28:3'},\n {id:'ode',name:'Ode to Joy',em:'🎼',bpm:120,diff:1,\n  n:'E4:0:1 E4:1:1 F4:2:1 G4:3:1 G4:4:1 F4:5:1 E4:6:1 D4:7:1 C4:8:1 C4:9:1 D4:10:1 E4:11:1 E4:12:1.5 D4:13.5:.5 D4:14:2 '+\n    'E4:16:1 E4:17:1 F4:18:1 G4:19:1 G4:20:1 F4:21:1 E4:22:1 D4:23:1 C4:24:1 C4:25:1 D4:26:1 E4:27:1 D4:28:1.5 C4:29.5:.5 C4:30:2 '+\n    'D4:32:1 D4:33:1 E4:34:1 C4:35:1 D4:36:1 E4:37:.5 F4:37.5:.5 E4:38:1 C4:39:1 D4:40:1 E4:41:.5 F4:41.5:.5 E4:42:1 D4:43:1 C4:44:1 D4:45:1 G3:46:2 '+\n    'E4:48:1 E4:49:1 F4:50:1 G4:51:1 G4:52:1 F4:53:1 E4:54:1 D4:55:1 C4:56:1 C4:57:1 D4:58:1 E4:59:1 D4:60:1.5 C4:61.5:.5 C4:62:2'},\n {id:'canon',name:'Canon',em:'🕊️',bpm:96,diff:2,\n  n:'F#5:0:2 E5:2:2 D5:4:2 C#5:6:2 B4:8:2 A4:10:2 B4:12:2 C#5:14:2 '+\n    'D5:16:2 C#5:18:2 B4:20:2 A4:22:2 G4:24:2 F#4:26:2 G4:28:2 E4:30:2 '+\n    'D4:32:1 F#4:33:1 A4:34:1 G4:35:1 F#4:36:1 D4:37:1 F#4:38:1 E4:39:1 '+\n    'D4:40:1 B3:41:1 D4:42:1 A4:43:1 G4:44:1 B4:45:1 A4:46:1 G4:47:1 '+\n    'F#4:48:1 D4:49:1 E4:50:1 C#5:51:1 D5:52:2 D4:54:2 D5:56:4'},\n {id:'birthday',name:'Happy Birthday',em:'🎂',bpm:100,diff:2,\n  n:'G4:0:.5 G4:.5:.5 A4:1:1 G4:2:1 C5:3:1 B4:4:2 G4:6:.5 G4:6.5:.5 A4:7:1 G4:8:1 D5:9:1 C5:10:2 '+\n    'G4:12:.5 G4:12.5:.5 G5:13:1 E5:14:1 C5:15:1 B4:16:1 A4:17:2 F5:19:.5 F5:19.5:.5 E5:20:1 C5:21:1 D5:22:1 C5:23:2'},\n {id:'jingle',name:'Jingle Bells',em:'🔔',bpm:132,diff:2,\n  n:'E4:0:1 E4:1:1 E4:2:2 E4:4:1 E4:5:1 E4:6:2 E4:8:1 G4:9:1 C4:10:1.5 D4:11.5:.5 E4:12:4 '+\n    'F4:16:1 F4:17:1 F4:18:1.5 F4:19.5:.5 F4:20:1 E4:21:1 E4:22:1 E4:23:.5 E4:23.5:.5 E4:24:1 D4:25:1 D4:26:1 E4:27:1 D4:28:2 G4:30:2 '+\n    'E4:32:1 E4:33:1 E4:34:2 E4:36:1 E4:37:1 E4:38:2 E4:40:1 G4:41:1 C4:42:1.5 D4:43.5:.5 E4:44:4 '+\n    'F4:48:1 F4:49:1 F4:50:1.5 F4:51.5:.5 F4:52:1 E4:53:1 E4:54:1 E4:55:.5 E4:55.5:.5 G4:56:1 G4:57:1 F4:58:1 D4:59:1 C4:60:4'},\n {id:'korobeiniki',name:'Korobeiniki',em:'🧱',bpm:132,diff:3,\n  n:'E5:0:1 B4:1:.5 C5:1.5:.5 D5:2:1 C5:3:.5 B4:3.5:.5 A4:4:1 A4:5:.5 C5:5.5:.5 E5:6:1 D5:7:.5 C5:7.5:.5 '+\n    'B4:8:1.5 C5:9.5:.5 D5:10:1 E5:11:1 C5:12:1 A4:13:1 A4:14:2 '+\n    'D5:16.5:1 F5:17.5:.5 A5:18:1 G5:19:.5 F5:19.5:.5 E5:20:1.5 C5:21.5:.5 E5:22:1 D5:23:.5 C5:23.5:.5 '+\n    'B4:24:1 B4:25:.5 C5:25.5:.5 D5:26:1 E5:27:1 C5:28:1 A4:29:1 A4:30:2 '+\n    'E5:32:1 B4:33:.5 C5:33.5:.5 D5:34:1 C5:35:.5 B4:35.5:.5 A4:36:1 A4:37:.5 C5:37.5:.5 E5:38:1 D5:39:.5 C5:39.5:.5 '+\n    'B4:40:1.5 C5:41.5:.5 D5:42:1 E5:43:1 C5:44:1 A4:45:1 A4:46:2'},\n {id:'elise',name:'Für Elise',em:'🌙',bpm:120,diff:3,\n  n:'E5:0:.5 D#5:.5:.5 E5:1:.5 D#5:1.5:.5 E5:2:.5 B4:2.5:.5 D5:3:.5 C5:3.5:.5 A4:4:1 C4:5:.5 E4:5.5:.5 A4:6:.5 '+\n    'B4:6.5:1 E4:7.5:.5 G#4:8:.5 B4:8.5:.5 C5:9:1 E4:10:.5 '+\n    'E5:10.5:.5 D#5:11:.5 E5:11.5:.5 D#5:12:.5 E5:12.5:.5 B4:13:.5 D5:13.5:.5 C5:14:.5 A4:14.5:1 C4:15.5:.5 E4:16:.5 A4:16.5:.5 '+\n    'B4:17:1 E4:18:.5 C5:18.5:.5 B4:19:.5 A4:19.5:2'}\n];\n\n/* parse \"Name:beat:dur\" → [{t,d,m,lane}] with contour-based lane mapping */\nvar NOTEIDX={C:0,D:2,E:4,F:5,G:7,A:9,B:11};\nfunction midiOf(nm){\n  var mch=/^([A-G])([#b]?)(\\d)$/.exec(nm);if(!mch)return null;\n  var v=NOTEIDX[mch[1]]+(mch[2]==='#'?1:mch[2]==='b'?-1:0);\n  return v+12*(+mch[3]+1);\n}\nfunction parseSong(s){\n  var out=[];\n  s.n.split(/\\s+/).forEach(function(tok){\n    if(!tok)return;\n    var p=tok.split(':');var m=midiOf(p[0]);\n    if(m===null)return;\n    out.push({t:+p[1]*60/s.bpm,d:(+p[2]||1)*60/s.bpm,m:m});\n  });\n  out.sort(function(a,b){return a.t-b.t});\n  // contour lanes: split the song's pitch range into 4 bands by rank\n  var uniq=[];out.forEach(function(n){if(uniq.indexOf(n.m)<0)uniq.push(n.m)});\n  uniq.sort(function(a,b){return a-b});\n  out.forEach(function(n){\n    n.lane=Math.min(3,Math.floor(uniq.indexOf(n.m)/uniq.length*4));\n  });\n  return out;\n}\n\n/* ================= audio ================= */\nvar ac=null,master=null;\nfunction audioInit(){\n  if(ac)return true;\n  var AC=window.AudioContext||window.webkitAudioContext;if(!AC)return false;\n  ac=new AC();master=ac.createGain();master.gain.value=.9;master.connect(ac.destination);\n  return true;\n}\nfunction playNote(midi,dur,vol){\n  if(!ac)return;\n  if(ac.state==='suspended')try{ac.resume()}catch(e){}\n  var f=440*Math.pow(2,(midi-69)/12),t=ac.currentTime;\n  var hold=Math.min(Math.max(dur||.4,.35),1.6);\n  var g=ac.createGain();\n  g.gain.setValueAtTime(0,t);\n  g.gain.linearRampToValueAtTime(vol||.5,t+.008);\n  g.gain.exponentialRampToValueAtTime(.001,t+hold);\n  var lp=ac.createBiquadFilter();lp.type='lowpass';\n  lp.frequency.setValueAtTime(Math.min(f*5,9000),t);\n  lp.frequency.exponentialRampToValueAtTime(Math.max(f*1.5,400),t+hold);\n  var o1=ac.createOscillator();o1.type='triangle';o1.frequency.value=f;\n  var o2=ac.createOscillator();o2.type='sine';o2.frequency.value=f*2;\n  var g2=ac.createGain();g2.gain.value=.28;\n  o1.connect(lp);o2.connect(g2);g2.connect(lp);lp.connect(g);g.connect(master);\n  o1.start(t);o2.start(t);o1.stop(t+hold+.05);o2.stop(t+hold+.05);\n}\nfunction playClick(hi){\n  if(!ac)return;var t=ac.currentTime;\n  var o=ac.createOscillator(),g=ac.createGain();\n  o.type='sine';o.frequency.value=hi?1320:880;\n  g.gain.setValueAtTime(.25,t);g.gain.exponentialRampToValueAtTime(.001,t+.09);\n  o.connect(g);g.connect(master);o.start(t);o.stop(t+.1);\n}\n\n/* ================= scoring / judging ================= */\nvar PERFECT=.11,GOOD=.24;      // seconds either side of the note time\nfunction judge(dt){\n  var a=Math.abs(dt);\n  if(a<=PERFECT)return 'perfect';\n  if(a<=GOOD)return 'good';\n  return null;\n}\nfunction multOf(combo){return combo>=30?4:combo>=20?3:combo>=10?2:1}\nfunction maxScoreOf(count){\n  var s=0;for(var i=1;i<=count;i++)s+=100*multOf(i);\n  return s||1;\n}\nfunction starsOf(scorePct){return scorePct>=.92?3:scorePct>=.72?2:scorePct>=.45?1:0}\n\n/* ================= state ================= */\nvar SPEEDS=[{k:'chill',label:'Chill',lead:2.6},{k:'normal',label:'Normal',lead:2.0},{k:'fast',label:'Fast',lead:1.45}];\nvar speedIdx=1;\nvar bests={};                   // {songId_speed:{score,stars}}\nvar cur=null;                   // running game\nvar previewT=null;\n\nfunction bkey(songId){return songId+'_'+SPEEDS[speedIdx].k}\n\n/* ================= home ================= */\nfunction renderSpeeds(){\n  var w=el('speeds');w.innerHTML='';\n  SPEEDS.forEach(function(s,i){\n    var b=document.createElement('button');b.className='spd'+(i===speedIdx?' on':'');\n    b.textContent=s.label;\n    b.onclick=function(){speedIdx=i;store.setItem('speed',String(i));renderSpeeds();renderSongs();haptic('selection')};\n    w.appendChild(b);\n  });\n}\nfunction renderSongs(){\n  var L=el('songList');L.innerHTML='';\n  SONGS.forEach(function(s){\n    var noteCount=s.n.split(/\\s+/).length;\n    var d=document.createElement('div');d.className='song';\n    var em=document.createElement('div');em.className='em';em.textContent=s.em;\n    var si=document.createElement('div');si.className='si';\n    si.innerHTML='<div class=\"nm\"></div><div class=\"meta\"></div>';\n    si.firstChild.textContent=s.name;\n    si.lastChild.textContent='♪'.repeat(s.diff)+' · '+noteCount+' notes';\n    var st=document.createElement('div');st.className='stars';\n    var b=bests[bkey(s.id)];\n    st.innerHTML=(b?('★★★'.slice(0,b.stars)+'<span class=\"off\">'+'★★★'.slice(b.stars)+'</span>'):'<span class=\"off\">★★★</span>')\n      +(b?'<span class=\"best\">'+b.score+'</span>':'');\n    var lis=document.createElement('button');lis.className='lis';lis.textContent='🔊';\n    lis.setAttribute('aria-label','Preview');\n    lis.onclick=function(ev){ev.stopPropagation();preview(s)};\n    d.onclick=function(){startGame(s)};\n    d.appendChild(em);d.appendChild(si);d.appendChild(st);d.appendChild(lis);\n    L.appendChild(d);\n  });\n}\nfunction preview(s){\n  if(!audioInit())return;\n  if(ac.state==='suspended')try{ac.resume()}catch(e){}\n  if(previewT){clearTimeout(previewT);previewT=null}\n  var notes=parseSong(s).slice(0,10),i=0;\n  haptic('light');\n  (function step(){\n    if(i>=notes.length){previewT=null;return}\n    var n=notes[i];playNote(n.m,n.d,.4);\n    var gap=(i+1<notes.length)?(notes[i+1].t-n.t):0;i++;\n    previewT=setTimeout(step,Math.max(120,gap*1000));\n  })();\n}\n\n/* ================= game ================= */\nfunction startGame(song){\n  if(!audioInit()){alert1('Audio isn’t available on this device.');return}\n  if(ac.state==='suspended')try{ac.resume()}catch(e){}\n  if(previewT){clearTimeout(previewT);previewT=null}\n  var notes=parseSong(song);\n  cur={\n    song:song,notes:notes,lead:SPEEDS[speedIdx].lead,\n    startAt:0,pos:-9,paused:false,over:false,\n    score:0,combo:0,maxCombo:0,perfect:0,good:0,miss:0,\n    maxScore:maxScoreOf(notes.length), // all-perfect run incl. combo ramp\n    end:notes[notes.length-1].t+notes[notes.length-1].d+1.2,\n    fx:[],raf:null\n  };\n  el('home').classList.remove('on');el('game').classList.add('on');\n  el('score').textContent='0';el('pbar').style.width='0';\n  el('combo').textContent='';el('judge').className='';\n  sizeCanvas();\n  countdown(3);\n}\nfunction countdown(n){\n  if(!cur)return;\n  var c=el('count');c.style.display='flex';\n  if(n>0){\n    c.textContent=String(n);playClick(false);haptic('light');\n    cur.cdT=setTimeout(function(){countdown(n-1)},700);\n  }else{\n    c.textContent='';c.style.display='none';playClick(true);\n    cur.cdT=null;\n    cur.startAt=ac.currentTime+.15;\n    loop();\n  }\n}\nfunction songPos(){return cur?(ac.currentTime-cur.startAt):0}\n\nfunction loop(){\n  if(!cur||cur.paused||cur.over)return;\n  var now=songPos();\n  // misses\n  cur.notes.forEach(function(n){\n    if(!n.hit&&!n.missed&&now-n.t>GOOD){\n      n.missed=true;cur.miss++;cur.combo=0;showJudge('miss');\n    }\n  });\n  draw(now);\n  el('pbar').style.width=Math.min(100,Math.max(0,now/cur.end*100))+'%';\n  if(now>=cur.end){finishGame();return}\n  cur.raf=requestAnimationFrame(loop);\n}\n\nfunction laneX(i,W){var lw=(W-24)/4;return 12+lw*i}\nfunction sizeCanvas(){\n  var c=el('cv'),dpr=window.devicePixelRatio||1;\n  c.width=innerWidth*dpr;c.height=innerHeight*dpr;\n  var g=c.getContext('2d');g.setTransform(dpr,0,0,dpr,0,0);\n}\nfunction draw(now){\n  var c=el('cv'),g=c.getContext('2d');\n  var W=innerWidth,H=innerHeight;\n  var keysH=el('keys').offsetHeight,hitY=H-keysH-14;\n  g.clearRect(0,0,W,H);\n  var lw=(W-24)/4;\n  var css=getComputedStyle(document.documentElement);\n  var laneCols=[css.getPropertyValue('--lane0'),css.getPropertyValue('--lane1'),\n                css.getPropertyValue('--lane2'),css.getPropertyValue('--lane3')].map(function(x){return x.trim()});\n  // lanes\n  for(var i=0;i<4;i++){\n    g.fillStyle='rgba(255,255,255,.035)';\n    g.fillRect(laneX(i,W)+2,0,lw-4,hitY+8);\n  }\n  // hit line\n  g.fillStyle='rgba(255,255,255,.35)';g.fillRect(10,hitY,W-20,2);\n  g.fillStyle='rgba(139,92,246,.28)';g.fillRect(10,hitY-3,W-20,8);\n  // notes: y so that note reaches hitY at n.t; speed = hitY/lead px per sec\n  var v=hitY/cur.lead;\n  cur.notes.forEach(function(n){\n    if(n.hit)return;\n    var y=hitY-(n.t-now)*v;\n    var h=Math.max(26,Math.min(90,n.d*v*.8));\n    if(y<-h||y>H)return;\n    var x=laneX(n.lane,W)+5,w2=lw-10;\n    g.globalAlpha=n.missed?.25:1;\n    g.fillStyle=laneCols[n.lane];\n    rr(g,x,y-h,w2,h,9);g.fill();\n    g.globalAlpha=n.missed?.1:.45;\n    g.fillStyle='#fff';rr(g,x+4,y-h+4,w2-8,7,4);g.fill();\n    g.globalAlpha=1;\n  });\n  // hit effects\n  if(!RM){\n    cur.fx=cur.fx.filter(function(p){return p.a>0});\n    cur.fx.forEach(function(p){\n      p.x+=p.vx;p.y+=p.vy;p.vy+=.25;p.a-=.045;\n      g.globalAlpha=Math.max(0,p.a);g.fillStyle=p.c;\n      g.fillRect(p.x,p.y,4,4);\n    });\n    g.globalAlpha=1;\n  }\n}\nfunction rr(g,x,y,w,h,r){\n  g.beginPath();\n  g.moveTo(x+r,y);g.arcTo(x+w,y,x+w,y+h,r);g.arcTo(x+w,y+h,x,y+h,r);\n  g.arcTo(x,y+h,x,y,r);g.arcTo(x,y,x+w,y,r);g.closePath();\n}\nfunction spawnFx(lane){\n  if(RM||!cur)return;\n  var W=innerWidth,H=innerHeight,keysH=el('keys').offsetHeight,hitY=H-keysH-14;\n  var lw=(W-24)/4,cx=laneX(lane,W)+lw/2;\n  var css=getComputedStyle(document.documentElement);\n  var col=css.getPropertyValue('--lane'+lane).trim();\n  for(var i=0;i<10;i++){\n    cur.fx.push({x:cx,y:hitY,vx:(Math.random()-.5)*7,vy:-Math.random()*5-1,a:1,c:col});\n  }\n}\n\nfunction tapLane(lane){\n  if(!cur||cur.paused||cur.over)return;\n  var now=songPos();\n  // earliest unhit note in this lane within the window\n  var best=null;\n  for(var i=0;i<cur.notes.length;i++){\n    var n=cur.notes[i];\n    if(n.lane!==lane||n.hit||n.missed)continue;\n    if(n.t-now>GOOD)break;                 // sorted — nothing closer coming\n    if(Math.abs(now-n.t)<=GOOD){best=n;break}\n  }\n  var kb=el('keys').children[lane];\n  kb.classList.add('hit');setTimeout(function(){kb.classList.remove('hit')},90);\n  if(!best){playClick(false);return}\n  var j=judge(now-best.t);\n  best.hit=true;\n  playNote(best.m,best.d,.55);\n  cur.combo++;cur.maxCombo=Math.max(cur.maxCombo,cur.combo);\n  var pts=(j==='perfect'?100:60)*multOf(cur.combo);\n  cur.score+=pts;\n  if(j==='perfect')cur.perfect++;else cur.good++;\n  el('score').textContent=String(cur.score);\n  showJudge(j);spawnFx(lane);\n  if(cur.combo>0&&cur.combo%10===0)haptic('light');\n}\nfunction showJudge(kind){\n  var J=el('judge');\n  J.textContent=kind==='perfect'?'Perfect!':kind==='good'?'Good':'Miss';\n  J.className=kind+' pop';\n  clearTimeout(J._t);J._t=setTimeout(function(){J.className=kind},260);\n  var C=el('combo');\n  C.innerHTML=(cur&&cur.combo>=2)?('<b>'+cur.combo+'</b> combo ×'+multOf(cur.combo)):'';\n  if(kind==='miss')haptic('warning');\n}\n\nfunction pauseGame(){\n  if(!cur||cur.over)return;\n  if(cur.cdT){clearTimeout(cur.cdT);cur.cdT=null;quitToHome();return}\n  cur.paused=true;cur.pos=songPos();\n  if(cur.raf)cancelAnimationFrame(cur.raf);\n  el('pauseSong').textContent=cur.song.name;\n  el('pauseVeil').classList.add('on');\n  try{ac.suspend()}catch(e){}\n}\nfunction resumeGame(){\n  if(!cur)return;\n  el('pauseVeil').classList.remove('on');\n  try{ac.resume()}catch(e){}\n  cur.paused=false;cur.startAt=ac.currentTime-cur.pos;\n  loop();\n}\nfunction finishGame(){\n  if(!cur)return;\n  cur.over=true;if(cur.raf)cancelAnimationFrame(cur.raf);\n  var total=cur.notes.length;\n  var acc=total?Math.round((cur.perfect+cur.good)/total*100):0;\n  var pct=cur.maxScore?cur.score/cur.maxScore:0;\n  var st=starsOf(pct);\n  el('doneTitle').textContent=st===3?'Flawless!':st===2?'Great run!':st===1?'Nice one!':'Song complete';\n  el('doneSong').textContent=cur.song.name+' · '+SPEEDS[speedIdx].label;\n  el('doneStars').innerHTML='★★★'.slice(0,st)+'<span class=\"off\">'+'★★★'.slice(st)+'</span>';\n  el('rScore').textContent=String(cur.score);\n  el('rAcc').textContent=acc+'%';\n  el('rCombo').textContent=String(cur.maxCombo);\n  el('rPGM').textContent=cur.perfect+' / '+cur.good+' / '+cur.miss;\n  var k=bkey(cur.song.id),b=bests[k],isBest=!b||cur.score>b.score;\n  el('rBest').style.display=isBest&&cur.score>0?'block':'none';\n  if(isBest){bests[k]={score:cur.score,stars:st};store.setItem('bests',JSON.stringify(bests))}\n  el('doneVeil').classList.add('on');\n  haptic(st>=2?'success':'light');\n}\nfunction replaySong(){\n  var s=cur?cur.song:null;\n  el('doneVeil').classList.remove('on');\n  if(s)startGame(s);\n}\nfunction quitToHome(){\n  if(cur&&cur.raf)cancelAnimationFrame(cur.raf);\n  if(cur&&cur.cdT)clearTimeout(cur.cdT);\n  cur=null;\n  try{if(ac&&ac.state==='suspended')ac.resume()}catch(e){}\n  el('pauseVeil').classList.remove('on');el('doneVeil').classList.remove('on');\n  el('count').style.display='none';\n  el('game').classList.remove('on');el('home').classList.add('on');\n  renderSongs();\n}\nfunction alert1(t){var s=document.querySelector('.sub');if(s)s.textContent=t}\n\n/* keys + input */\n(function(){\n  var K=el('keys');\n  for(var i=0;i<4;i++){\n    var k=document.createElement('div');k.className='key';k.dataset.lane=i;\n    k.setAttribute('role','button');k.setAttribute('aria-label','Key '+(i+1));\n    k.addEventListener('pointerdown',function(ev){ev.preventDefault();tapLane(+this.dataset.lane)});\n    K.appendChild(k);\n  }\n  // also allow tapping the lanes themselves (above the keys)\n  el('cv').addEventListener('pointerdown',function(ev){\n    if(!cur||cur.paused||cur.over)return;\n    var lane=Math.max(0,Math.min(3,Math.floor((ev.clientX-12)/((innerWidth-24)/4))));\n    tapLane(lane);\n  });\n  window.addEventListener('resize',function(){if(cur)sizeCanvas()});\n  document.addEventListener('visibilitychange',function(){\n    if(document.hidden&&cur&&!cur.paused&&!cur.over)pauseGame();\n  });\n})();\n\n/* boot */\nstore.getItem('bests').then(function(v){if(v)try{bests=JSON.parse(v)||{}}catch(e){}\n  return store.getItem('speed');\n}).then(function(v){\n  var i=parseInt(v,10);if(i>=0&&i<SPEEDS.length)speedIdx=i;\n  renderSpeeds();renderSongs();\n});\n</script></body></html>\n", "kind": "html", "iconSymbol": "pianokeys", "iconColor": "purple"}