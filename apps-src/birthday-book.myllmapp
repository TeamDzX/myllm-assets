{"name": "Birthday Book", "kind": "html", "iconSymbol": "gift.fill", "iconColor": "pink", "html": "<!doctype html>\n<!--\n  Birthday Book — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Birthday Book</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>\n  :root{ color-scheme:light dark;\n    --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n    --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,#0a84ff);\n    --fill:rgba(120,120,128,.12); --h:330; }\n  @media (prefers-color-scheme:dark){ :root{ --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e);\n    --ink:var(--myllm-text,#f2f2f7); --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(120,120,128,.24); } }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    max-width:600px; margin:0 auto; min-height:100dvh; font-size:15.5px; line-height:1.4;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(96px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  @media (min-width:768px){ body{ max-width:760px; } }\n  svg.i{ width:1.25em; height:1.25em; fill:currentColor; flex-shrink:0; }\n  button{ font:inherit; color:inherit; cursor:pointer; } button:active{ transform:scale(.96); }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 50%), hsl(calc(var(--h) + 40) 58% 28%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  .head .ht{ flex:1; min-width:0; }\n  h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:20px 2px 10px; }\n\n  .hero{ border-radius:20px; padding:16px 18px; color:#fff; margin-bottom:12px; display:flex; align-items:center; gap:14px; cursor:pointer;\n    background:linear-gradient(145deg, hsl(var(--h) 66% 50%), hsl(calc(var(--h) + 30) 58% 28%)); box-shadow:0 10px 28px hsl(var(--h) 60% 30% / .25); }\n  .hero .main{ flex:1; min-width:0; }\n  .hero .k{ font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.8; }\n  .hero b{ display:block; font-size:22px; font-weight:800; line-height:1.2; letter-spacing:-.01em; margin-top:2px; overflow-wrap:anywhere; }\n  .hero .l{ font-size:13px; opacity:.85; margin-top:2px; }\n  .hero .days{ flex-shrink:0; text-align:center; background:rgba(255,255,255,.16); border:1px solid rgba(255,255,255,.22); border-radius:16px; padding:8px 12px; min-width:78px; }\n  .hero .days .n{ font-size:34px; font-weight:800; line-height:1.05; letter-spacing:-.03em; font-variant-numeric:tabular-nums; }\n  .hero .days span{ display:block; font-size:10.5px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; opacity:.8; }\n  .hero .days svg{ width:34px; height:34px; margin:2px 0; }\n\n  .list{ display:grid; gap:8px; }\n  .list{ grid-template-columns:minmax(0,1fr); }\n  @media (min-width:768px){ .list{ grid-template-columns:repeat(2,minmax(0,1fr)); } }\n  .person{ display:flex; align-items:center; gap:12px; background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:10px 12px; min-height:66px; cursor:pointer; }\n  .person.today{ border-color:hsl(var(--h) 70% 55%); box-shadow:0 0 0 2px hsl(var(--h) 70% 55% / .22); }\n  .person .tile{ width:42px; height:42px; border-radius:12px; font-size:15px; font-weight:800; letter-spacing:.02em; }\n  .person .t{ flex:1; min-width:0; }\n  .person .t b{ display:block; font-size:15.5px; font-weight:650; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .person .t small{ display:block; color:var(--muted); font-size:12.5px; margin-top:1px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n  .when{ text-align:right; flex:none; }\n  .when b{ font-size:14.5px; display:block; font-weight:700; }\n  .when small{ font-size:11.5px; color:var(--muted); font-variant-numeric:tabular-nums; }\n  .when.today b{ color:hsl(var(--h) 70% 48%); }\n  @media (prefers-color-scheme:dark){ .when.today b{ color:hsl(var(--h) 85% 68%); } }\n  .when.soon b{ color:#ff9500; }\n\n  .empty{ text-align:center; padding:26px 20px 14px; background:var(--surface); border:1px solid var(--line); border-radius:18px; }\n  .empty .tile{ width:48px; height:48px; border-radius:14px; font-size:21px; margin:0 auto 10px; opacity:.9; }\n  .empty b{ display:block; font-size:16px; font-weight:750; }\n  .empty p{ font-size:13.5px; color:var(--muted); line-height:1.5; max-width:290px; margin:5px auto 0; }\n\n  .fab{ position:fixed; right:calc(18px + env(safe-area-inset-right)); bottom:calc(20px + env(safe-area-inset-bottom));\n    width:56px; height:56px; border-radius:50%; border:none; display:flex; align-items:center; justify-content:center; font-size:24px;\n    background:linear-gradient(145deg, hsl(var(--h) 66% 52%), hsl(calc(var(--h) + 30) 58% 36%)); color:#fff;\n    box-shadow:0 10px 26px -6px hsl(var(--h) 70% 40% / .6); z-index:50; }\n\n  /* sheet */\n  .veil{ position:fixed; inset:0; background:rgba(0,0,0,.4); z-index:90; display:none; }\n  .veil.on{ display:block; }\n  .sheet{ position:fixed; left:0; right:0; bottom:0; z-index:95; background:var(--surface); border-radius:22px 22px 0 0;\n    padding:10px calc(18px + env(safe-area-inset-right)) calc(24px + env(safe-area-inset-bottom)) calc(18px + env(safe-area-inset-left));\n    transform:translateY(105%); transition:transform .28s cubic-bezier(.2,.8,.2,1);\n    max-width:600px; margin:0 auto; max-height:88dvh; overflow-y:auto; box-shadow:0 -10px 40px rgba(0,0,0,.2); }\n  .sheet::before{ content:\"\"; display:block; width:38px; height:5px; border-radius:99px; background:var(--line); margin:0 auto 12px; }\n  .sheet.on{ transform:none; }\n  .sheet h3{ font-size:18px; font-weight:800; margin-bottom:2px; }\n  label{ display:block; font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:14px 2px 7px; }\n  label span{ text-transform:none; letter-spacing:0; font-weight:500; }\n  input{ width:100%; font:inherit; font-size:16px; padding:12px; border-radius:12px; border:1px solid var(--line); background:var(--bg); color:var(--ink); outline:none; }\n  input:focus{ border-color:var(--acc); }\n  .row3{ display:flex; gap:8px; }\n  .row3 > div{ flex:1; min-width:0; }\n  .go{ width:100%; min-height:50px; border:none; border-radius:14px; margin-top:14px; font-size:16px; font-weight:700;\n    background:var(--acc); color:#fff; display:flex; align-items:center; justify-content:center; gap:8px; }\n  .go:disabled{ opacity:.6; }\n  .go.danger{ background:transparent; color:#ff3b30; }\n  .gift{ background:hsl(var(--h) 70% 50% / .12); color:hsl(var(--h) 70% 42%); }\n  @media (prefers-color-scheme:dark){ .gift{ color:hsl(var(--h) 85% 70%); } }\n  .spin{ width:16px; height:16px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n  .ideas{ margin-top:12px; display:none; border-radius:14px; background:var(--bg); padding:2px 12px; }\n  .ideas.on{ display:block; }\n  .idea{ display:flex; gap:9px; padding:10px 0; border-bottom:1px solid var(--line); font-size:14.5px; line-height:1.45; }\n  .idea svg{ color:hsl(var(--h) 65% 50%); margin-top:2px; }\n  .idea:last-child{ border-bottom:none; }\n  .note{ font-size:12.5px; color:var(--muted); margin-top:8px; line-height:1.5; }\n  [hidden]{ display:none !important; }\n  @media (prefers-reduced-motion:reduce){ .sheet{ transition:none; } .spin{ animation-duration:2.4s; } button:active{ transform:none; } }\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style>\n<style>:root{--build-id:\"905f50d9f9\";}</style>\n</head>\n<body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-gift\" viewBox=\"0 0 24 24\"><path d=\"M8.2 2.6c1.5 0 2.9.9 3.8 2.3.9-1.4 2.3-2.3 3.8-2.3a2.8 2.8 0 0 1 2 4.9H20a1 1 0 0 1 1 1V11a1 1 0 0 1-1 1h-7V8.5h-2V12H4a1 1 0 0 1-1-1V8.5a1 1 0 0 1 1-1h2.2a2.8 2.8 0 0 1 2-4.9zm0 2a.8.8 0 0 0 0 1.6h2.4c-.6-1-1.5-1.6-2.4-1.6zm7.6 0c-.9 0-1.8.6-2.4 1.6h2.4a.8.8 0 0 0 0-1.6zM4.5 13.5H11v8H6a1.5 1.5 0 0 1-1.5-1.5zm8.5 0h6.5V20a1.5 1.5 0 0 1-1.5 1.5h-5z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-plus\" viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-cake\" viewBox=\"0 0 24 24\"><path d=\"M12 2.3c.9 1 1.4 1.8 1.4 2.5a1.4 1.4 0 0 1-2.8 0c0-.7.5-1.5 1.4-2.5zM11 7.5h2V10h4.5A2.5 2.5 0 0 1 20 12.5v1.8c-1 .9-2 .9-3 0-1 .9-2 .9-3 0-1 .9-2 .9-3 0-1 .9-2 .9-3 0-1 .9-2 .9-3 0v-1.8A2.5 2.5 0 0 1 6.5 10H11zM4 16.6c1.3.6 2.7.5 4-.2 1.3.7 2.7.7 4 0 1.3.7 2.7.7 4 0 1.3.7 2.7.8 4 .2V20a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 20z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-party\" viewBox=\"0 0 24 24\"><path d=\"M4.3 19.7l4.5-12 7.5 7.5zM14 3.5a1 1 0 0 1 1 1v1a1 1 0 0 1-2 0v-1a1 1 0 0 1 1-1zm5.5 5.5a1 1 0 0 1 0 2h-1a1 1 0 0 1 0-2zm-.9-4.6a1 1 0 0 1 0 1.4l-1.4 1.4a1 1 0 1 1-1.4-1.4l1.4-1.4a1 1 0 0 1 1.4 0zM17 13.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zM9.5 3a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3z\" fill=\"currentColor\"/></symbol>\n</defs></svg>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg class=\"i\"><use href=\"#i-gift\"/></svg></div>\n  <div class=\"ht\"><h1>Birthday Book</h1><p>Never miss a birthday again</p></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Birthday Book\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n<div class=\"hero\" id=\"hero\" hidden></div>\n<h2 id=\"listLbl\" hidden>Coming up</h2>\n<div class=\"list\" id=\"list\"></div>\n<button class=\"fab\" onclick=\"openSheet()\" aria-label=\"Add a birthday\"><svg class=\"i\"><use href=\"#i-plus\"/></svg></button>\n\n<div class=\"veil\" id=\"veil\" onclick=\"closeSheet()\"></div>\n<div class=\"sheet\" id=\"sheet\">\n  <h3 id=\"sheetTitle\">New birthday</h3>\n  <label for=\"f_name\">Name</label>\n  <input id=\"f_name\" placeholder=\"Mum, Sam, Aunt Rosa…\" autocomplete=\"off\">\n  <div class=\"row3\">\n    <div><label>Day</label><input id=\"f_day\" inputmode=\"numeric\" placeholder=\"14\"></div>\n    <div><label>Month</label><input id=\"f_month\" inputmode=\"numeric\" placeholder=\"7\"></div>\n    <div><label>Year <span>(optional)</span></label><input id=\"f_year\" inputmode=\"numeric\" placeholder=\"1968\"></div>\n  </div>\n  <label for=\"f_notes\">What do they love? <span>(for gift ideas)</span></label>\n  <input id=\"f_notes\" placeholder=\"gardening, crime novels, good coffee…\">\n  <button class=\"go\" onclick=\"savePerson()\">Save</button>\n  <button class=\"go gift\" id=\"giftBtn\" onclick=\"giftIdeas()\" style=\"display:none\"><svg class=\"i\"><use href=\"#i-gift\"/></svg><span>Gift ideas</span></button>\n  <div class=\"ideas\" id=\"ideas\"></div>\n  <p class=\"note\" id=\"sheetnote\"></p>\n  <button class=\"go danger\" id=\"delBtn\" onclick=\"delPerson()\" style=\"display:none\">Delete</button>\n</div>\n\n<!-- AI thinking pill (house convention) -->\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{width:16px;height:16px;border-radius:50%;border:2.4px solid #a78bfa;border-right-color:transparent;animation:myllmAiSpin .9s linear infinite;flex-shrink:0}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\"></span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n\n<script>\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction store(){ return window.myllmStorage || {getItem:function(){return Promise.resolve(null)}, setItem:function(){return Promise.resolve()}}; }\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nfunction ASK(){ return window.myllmAsk.apply(window, arguments); }\nfunction hasAI(){ return typeof window.myllmAsk === 'function'; }\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\"); }\n\nvar people = [];   /* {id,name,day,month,year|null,notes} */\nvar editing = null, armDelete = false;\nvar MONTHS = [\"Jan\",\"Feb\",\"Mar\",\"Apr\",\"May\",\"Jun\",\"Jul\",\"Aug\",\"Sep\",\"Oct\",\"Nov\",\"Dec\"];\nfunction initials(n){ var w=String(n||'').trim().split(/\\s+/).filter(Boolean); return ((w[0]||'?').charAt(0)+(w.length>1?w[w.length-1].charAt(0):'')).toUpperCase(); }\n\nfunction uid(){ return \"p\" + Date.now().toString(36) + Math.floor(Math.random()*1e5).toString(36); }\nfunction save(){ store().setItem(\"bdays\", JSON.stringify(people)); }\n\n/* days until the NEXT occurrence (0 = today) */\nfunction daysUntil(p){\n  var now = new Date(); now.setHours(0,0,0,0);\n  var next = new Date(now.getFullYear(), p.month - 1, p.day);\n  /* handle 29 Feb in non-leap years → celebrate 1 Mar */\n  if (p.day === 29 && p.month === 2 && next.getDate() !== 29) next = new Date(now.getFullYear(), 2, 1);\n  if (next < now){\n    next = new Date(now.getFullYear() + 1, p.month - 1, p.day);\n    if (p.day === 29 && p.month === 2 && next.getDate() !== 29) next = new Date(now.getFullYear() + 1, 2, 1);\n  }\n  return Math.round((next - now) / 86400000);\n}\nfunction turningAge(p){\n  if (!p.year) return null;\n  var now = new Date();\n  var age = now.getFullYear() - p.year;\n  var passed = daysUntil(p) === 0 ||\n    (new Date(now.getFullYear(), p.month - 1, p.day) >= new Date(now.getFullYear(), now.getMonth(), now.getDate()));\n  return passed ? age : age + 1;\n}\n\nfunction render(){\n  el(\"listLbl\").hidden = !people.length;\n  if (!people.length){\n    el(\"hero\").hidden = true;\n    el(\"list\").innerHTML = '<div class=\"empty\"><div class=\"tile\"><svg class=\"i\"><use href=\"#i-cake\"/></svg></div><b>Add the birthdays you must never miss</b><p>They sort themselves by who\\'s next — and the AI helps with gift ideas.</p></div>';\n    return;\n  }\n  var sorted = people.slice().sort(function(a, b){ return daysUntil(a) - daysUntil(b); });\n  var next = sorted[0];\n  var d0 = daysUntil(next), a0 = turningAge(next);\n  var hero = el(\"hero\"); hero.hidden = false;\n  hero.onclick = function(){ openSheet(next.id); };\n  hero.innerHTML = '<div class=\"main\"><div class=\"k\">' + (d0 === 0 ? \"Today\" : \"Next up\") + '</div><b>' + esc(next.name) + '</b>' +\n    '<div class=\"l\">' + next.day + ' ' + MONTHS[next.month - 1] + (a0 ? ' · turning ' + a0 : '') + '</div></div>' +\n    '<div class=\"days\">' + (d0 === 0 ? '<svg class=\"i\"><use href=\"#i-party\"/></svg><span>Today</span>'\n      : '<div class=\"n\">' + d0 + '</div><span>' + (d0 === 1 ? \"day\" : \"days\") + '</span>') + '</div>';\n  el(\"list\").innerHTML = sorted.map(function(p, i){\n    var d = daysUntil(p);\n    var age = turningAge(p);\n    var when = d === 0 ? \"today!\" : d === 1 ? \"tomorrow\" : \"in \" + d + \" days\";\n    var hue = 330 + ((i * 23) % 70) - 35;\n    return '<div class=\"person' + (d === 0 ? ' today' : '') + '\" onclick=\"openSheet(\\'' + p.id + '\\')\">' +\n      '<div class=\"tile\" style=\"--h:' + hue + '\">' + esc(initials(p.name)) + '</div>' +\n      '<div class=\"t\"><b>' + esc(p.name) + '</b>' +\n      '<small>' + p.day + ' ' + MONTHS[p.month - 1] + (age ? ' · turning ' + age : '') +\n      (p.notes ? ' · ' + esc(p.notes) : '') + '</small></div>' +\n      '<div class=\"when' + (d === 0 ? ' today' : d <= 7 ? ' soon' : '') + '\"><b>' + when + '</b>' +\n      (d !== 0 ? '<small>' + p.day + '/' + p.month + '</small>' : '') + '</div></div>';\n  }).join(\"\");\n}\n\n/* ---------- sheet ---------- */\nfunction openSheet(id){\n  editing = id || null;\n  armDelete = false;\n  var p = editing ? people.filter(function(x){ return x.id === editing; })[0] : null;\n  el(\"sheetTitle\").textContent = p ? p.name : \"New birthday\";\n  el(\"f_name\").value = p ? p.name : \"\";\n  el(\"f_day\").value = p ? p.day : \"\";\n  el(\"f_month\").value = p ? p.month : \"\";\n  el(\"f_year\").value = p && p.year ? p.year : \"\";\n  el(\"f_notes\").value = p ? (p.notes || \"\") : \"\";\n  el(\"delBtn\").style.display = p ? \"block\" : \"none\";\n  el(\"delBtn\").textContent = \"Delete\";\n  el(\"giftBtn\").style.display = (p && hasAI()) ? \"flex\" : \"none\";\n  el(\"ideas\").className = \"ideas\"; el(\"ideas\").innerHTML = \"\";\n  el(\"sheetnote\").textContent = (!hasAI() && p) ? \"Enable AI in Settings to get gift ideas here.\" : \"\";\n  el(\"veil\").classList.add(\"on\"); el(\"sheet\").classList.add(\"on\");\n  haptic(\"light\");\n}\nfunction closeSheet(){\n  el(\"veil\").classList.remove(\"on\"); el(\"sheet\").classList.remove(\"on\");\n  editing = null;\n}\nfunction savePerson(){\n  var name = el(\"f_name\").value.trim();\n  var day = parseInt(el(\"f_day\").value, 10);\n  var month = parseInt(el(\"f_month\").value, 10);\n  var year = parseInt(el(\"f_year\").value, 10) || null;\n  if (!name){ el(\"sheetnote\").textContent = \"A name would help.\"; return; }\n  if (!(day >= 1 && day <= 31) || !(month >= 1 && month <= 12)){\n    el(\"sheetnote\").textContent = \"Check the day and month (day 1–31, month 1–12).\"; return;\n  }\n  if (year && (year < 1900 || year > new Date().getFullYear())){\n    el(\"sheetnote\").textContent = \"That year looks off.\"; return;\n  }\n  var notes = el(\"f_notes\").value.trim();\n  if (editing){\n    var p = people.filter(function(x){ return x.id === editing; })[0];\n    p.name = name; p.day = day; p.month = month; p.year = year; p.notes = notes;\n  } else {\n    people.push({id:uid(), name:name, day:day, month:month, year:year, notes:notes});\n  }\n  save(); render(); closeSheet(); haptic(\"success\");\n}\nfunction delPerson(){\n  if (!armDelete){ armDelete = true; el(\"delBtn\").textContent = \"Really delete?\"; haptic(\"light\"); return; }\n  people = people.filter(function(x){ return x.id !== editing; });\n  save(); render(); closeSheet(); haptic(\"success\");\n}\n\n/* ---------- gift ideas ---------- */\n/* Labelled lines, not JSON — small models (Apple Intelligence) echo JSON\n   templates back verbatim. Echoed instructions are rejected and retried. */\nvar ECHO = /one specific gift idea|repeat this line|labelled line|short and concrete/i;\nfunction parseIdeas(reply){\n  var ideas = [], got = false;\n  String(reply || '').split(/\\r?\\n/).forEach(function(raw){\n    var ln = raw.replace(/\\*\\*/g, '').trim();\n    var m = ln.match(/^[-*#>\\s]*(IDEAS?)\\s*\\d*\\s*[::]\\s*(.*)$/i);\n    if (!m) return;\n    got = true;\n    var v = m[2].trim();\n    if (v) ideas.push(v);\n  });\n  if (!got){ // model answered in the old JSON-array shape — accept it\n    var s = String(reply || '');\n    var a = s.indexOf(\"[\"), b = s.lastIndexOf(\"]\");\n    if (a >= 0 && b > a) try{\n      var j = JSON.parse(s.slice(a, b + 1));\n      if (Array.isArray(j)) ideas = j.map(function(x){ return String(x).trim(); });\n    }catch(e){}\n  }\n  ideas = ideas.filter(function(x){ return x && !ECHO.test(x); });\n  if (ideas.length < 2) throw new Error(\"no real gift ideas came back\");\n  return ideas;\n}\nfunction giftIdeas(){\n  if (!hasAI() || !editing) return;\n  var p = people.filter(function(x){ return x.id === editing; })[0];\n  if (!p) return;\n  haptic(\"light\");\n  var gb = el(\"giftBtn\"); gb.disabled = true; gb.innerHTML = '<i class=\"spin\"></i><span>Thinking of ideas…</span>';\n  var age = turningAge(p);\n  var prompt = \"Suggest 5 thoughtful, specific birthday gift ideas for \" + p.name +\n      (age ? \" (turning \" + age + \")\" : \"\") +\n      (p.notes ? \", who loves: \" + p.notes : \"\") +\n      \". Mix price ranges; at least one should cost nothing but effort.\" +\n      \" Reply with EXACTLY these labelled lines and nothing else:\\n\" +\n      \"IDEA: one specific gift idea, short and concrete (repeat this line for each of the 5 ideas)\";\n  var sys = {system:\"You are a thoughtful gift-picker. Give specific, personal gift ideas.\"};\n  ASK(prompt, sys)\n  .then(function(r){ return parseIdeas(r); })\n  .catch(function(){\n    return ASK(prompt + \"\\nIMPORTANT: fill each labelled line with real content — never repeat the instruction text.\", sys)\n      .then(function(r){ return parseIdeas(r); });\n  })\n  .then(function(ideas){\n    el(\"ideas\").className = \"ideas on\";\n    el(\"ideas\").innerHTML = ideas.slice(0, 5).map(function(x){\n      return '<div class=\"idea\"><svg class=\"i\"><use href=\"#i-gift\"/></svg><span>' + esc(String(x)) + '</span></div>';\n    }).join(\"\");\n    el(\"sheetnote\").textContent = \"\";\n    haptic(\"success\");\n  })\n  .catch(function(){ el(\"sheetnote\").textContent = \"The ideas didn't come through — tap again.\"; })\n  .then(function(){ gb.disabled = false; gb.innerHTML = '<svg class=\"i\"><use href=\"#i-gift\"/></svg><span>Gift ideas</span>'; });\n}\n\n/* ---------- boot ---------- */\nstore().getItem(\"bdays\").then(function(v){\n  if (v){ try{ people = JSON.parse(v) || []; }catch(e){} }\n  render();\n});\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes.\n   The spacer keeps the header clear of the status bar / Dynamic Island. It is\n   live CSS — env(safe-area-inset-top) — not a measured number: the inset is\n   still 0 when the page loads and only grows once MyLLM's bar has gone (v1\n   measured once, so the title sat under the island). If the page's own styles\n   already pad the header down by the inset, the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  /* Does any rule that applies to the header or an ancestor already use the top inset? */\n  function pageHandlesInset(head){\n    var chain = [], n, found = false;\n    for (n = head; n && n.nodeType === 1; n = n.parentElement) chain.push(n);\n    function walk(rules){\n      for (var i = 0; i < rules.length && !found; i++){\n        var r = rules[i];\n        if (r.cssRules && !r.selectorText) { walk(r.cssRules); continue; }\n        if (!r.selectorText || !/safe-area-inset-top/.test(r.cssText) || !/(padding|margin|top)\\s*:/.test(r.cssText)) continue;\n        if (/\\.imm-safe/.test(r.selectorText)) continue;\n        for (var k = 0; k < chain.length; k++){\n          try { if (chain[k].matches(r.selectorText)) { found = true; break; } } catch(e){}\n        }\n      }\n    }\n    for (var s = 0; s < document.styleSheets.length && !found; s++){\n      try { walk(document.styleSheets[s].cssRules); } catch(e){}\n    }\n    for (n = head; n && n.nodeType === 1 && !found; n = n.parentElement){\n      if (/safe-area-inset-top/.test(n.getAttribute(\"style\") || \"\")) found = true;\n    }\n    return found;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = (document.body.classList.contains(\"imm\") && !pageHandlesInset(head)) ? \"env(safe-area-inset-top)\" : \"0px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script>\n</body>\n</html>\n"}