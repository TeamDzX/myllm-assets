{"name": "Birthday Book", "kind": "html", "iconSymbol": "gift.fill", "iconColor": "pink", "html": "<!doctype html>\n<!--\n  Birthday Book — MyLLMos App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Birthday Book</title>\n<style>\n  :root { color-scheme: light dark; }\n  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{\n    font-family:var(--myllm-font,-apple-system,system-ui,sans-serif);\n    background:var(--myllm-bg,#f2f2f7);\n    color:var(--myllm-text,#111);\n    max-width:600px; margin:0 auto; min-height:100dvh;\n    padding:16px 16px calc(96px + env(safe-area-inset-bottom));\n  }\n  h1{ font-size:22px; font-weight:800; margin:4px 2px 2px; }\n  .sub{ font-size:13px; color:var(--myllm-muted,#8a8a8e); margin:0 2px 14px; }\n\n  .person{\n    display:flex; align-items:center; gap:12px;\n    background:var(--myllm-surface,#fff); border:1px solid var(--myllm-border,#e3e3e8);\n    border-radius:16px; padding:13px 14px; margin-bottom:9px;\n  }\n  .person.today{ border-color:#ff9500; box-shadow:0 0 0 2px rgba(255,149,0,.25); }\n  .cake{\n    width:46px; height:46px; border-radius:14px; flex:none;\n    display:flex; align-items:center; justify-content:center; font-size:21px;\n    background:var(--myllm-bg,#f2f2f7);\n  }\n  .person .t{ flex:1; min-width:0; }\n  .person b{ display:block; font-size:15.5px; }\n  .person small{ display:block; color:var(--myllm-muted,#8a8a8e); font-size:12.5px; margin-top:1px; }\n  .when{ text-align:right; flex:none; }\n  .when b{ font-size:15px; display:block; }\n  .when small{ font-size:11px; color:var(--myllm-muted,#8a8a8e); }\n  .when.today b{ color:#ff9500; }\n\n  .empty{ text-align:center; color:var(--myllm-muted,#8a8a8e); font-size:13.5px; padding:34px 16px; line-height:1.7; }\n  .empty .big{ font-size:40px; }\n\n  .fab{\n    position:fixed; right:18px; bottom:calc(20px + env(safe-area-inset-bottom));\n    width:56px; height:56px; border-radius:50%; border:none;\n    background:#e0559b; color:#fff; font-size:28px; line-height:1;\n    box-shadow:0 8px 24px -6px rgba(224,85,155,.55); z-index:50;\n  }\n\n  /* sheet */\n  .veil{ position:fixed; inset:0; background:rgba(0,0,0,.4); z-index:90; display:none; }\n  .veil.on{ display:block; }\n  .sheet{\n    position:fixed; left:0; right:0; bottom:0; z-index:95;\n    background:var(--myllm-surface,#fff); border-radius:20px 20px 0 0;\n    padding:18px 18px calc(24px + env(safe-area-inset-bottom));\n    transform:translateY(105%); transition:transform .25s ease;\n    max-width:600px; margin:0 auto; max-height:88dvh; overflow-y:auto;\n  }\n  .sheet.on{ transform:none; }\n  .sheet h3{ font-size:17px; font-weight:800; margin-bottom:2px; }\n  label{ display:block; font-size:11.5px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:var(--myllm-muted,#8a8a8e); margin:12px 0 6px; }\n  input{\n    width:100%; font-size:16px; padding:11px 12px; border-radius:12px;\n    border:1px solid var(--myllm-border,#e3e3e8); background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111);\n  }\n  .row3{ display:flex; gap:8px; }\n  .row3 > div{ flex:1; }\n  .go{\n    width:100%; border:none; border-radius:13px; padding:14px; margin-top:14px;\n    font-size:15.5px; font-weight:750; background:#e0559b; color:#fff;\n  }\n  .go.ghost{ background:var(--myllm-bg,#f2f2f7); color:var(--myllm-text,#111); border:1px solid var(--myllm-border,#e3e3e8); }\n  .go.danger{ background:transparent; color:#ff3b30; }\n  .gift{\n    border:1px solid rgba(224,85,155,.4); background:rgba(224,85,155,.1); color:#e0559b;\n  }\n  .ideas{ margin-top:12px; display:none; }\n  .ideas.on{ display:block; }\n  .idea{ padding:9px 0; border-bottom:1px solid var(--myllm-border,#e3e3e8); font-size:14px; line-height:1.45; }\n  .idea:last-child{ border-bottom:none; }\n  .note{ font-size:12.5px; color:var(--myllm-muted,#8a8a8e); margin-top:8px; line-height:1.5; }\n</style>\n<style>:root{--build-id:\"905f50d9f9\";}</style>\n</head>\n<body>\n\n<h1>🎂 Birthday Book</h1>\n<p class=\"sub\" id=\"sub\">Never scramble for a card again.</p>\n<div id=\"list\"></div>\n<button class=\"fab\" onclick=\"openSheet()\" aria-label=\"Add a birthday\">+</button>\n\n<div class=\"veil\" id=\"veil\" onclick=\"closeSheet()\"></div>\n<div class=\"sheet\" id=\"sheet\">\n  <h3 id=\"sheetTitle\">New birthday</h3>\n  <label>Name</label>\n  <input id=\"f_name\" placeholder=\"Mum, Sam, Aunt Rosa…\" autocomplete=\"off\">\n  <div class=\"row3\">\n    <div><label>Day</label><input id=\"f_day\" inputmode=\"numeric\" placeholder=\"14\"></div>\n    <div><label>Month</label><input id=\"f_month\" inputmode=\"numeric\" placeholder=\"7\"></div>\n    <div><label>Year <span style=\"text-transform:none;font-weight:500\">(optional)</span></label><input id=\"f_year\" inputmode=\"numeric\" placeholder=\"1968\"></div>\n  </div>\n  <label>What do they love? <span style=\"text-transform:none;font-weight:500\">(for gift ideas)</span></label>\n  <input id=\"f_notes\" placeholder=\"gardening, crime novels, good coffee…\">\n  <button class=\"go\" onclick=\"savePerson()\">Save</button>\n  <button class=\"go gift\" id=\"giftBtn\" onclick=\"giftIdeas()\" style=\"display:none\">🎁 Gift ideas</button>\n  <div class=\"ideas\" id=\"ideas\"></div>\n  <p class=\"note\" id=\"sheetnote\"></p>\n  <button class=\"go danger\" id=\"delBtn\" onclick=\"delPerson()\" style=\"display:none\">Delete</button>\n</div>\n\n<!-- AI thinking pill (house convention) -->\n<style>\n@keyframes myllmAiSpin{to{transform:rotate(360deg)}}\n.myllm-ai-busy{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(18px);z-index:99999;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;display:flex;align-items:center;gap:10px;background:rgba(28,28,30,.96);color:#fff;border-radius:999px;padding:10px 16px 10px 14px;box-shadow:0 6px 22px rgba(0,0,0,.4);font-size:14px;font-weight:600;max-width:92%}\n.myllm-ai-busy.on{opacity:1;transform:translateX(-50%) translateY(0)}\n.myllm-ai-cog{font-size:18px;animation:myllmAiSpin 2.4s linear infinite;filter:drop-shadow(0 0 5px rgba(124,92,255,.85))}\n.myllm-ai-busy small{font-weight:400;opacity:.6}\n</style>\n<script>\n(function(){if(window.__myllmAiWrap||typeof window.myllmAsk!=='function')return;window.__myllmAiWrap=true;\nvar orig=window.myllmAsk,depth=0,node=null;\nfunction ensure(){if(node)return;node=document.createElement('div');node.className='myllm-ai-busy';\nnode.innerHTML='<span class=\"myllm-ai-cog\">⚙️</span><span>AI is thinking… <small>privately, on your device</small></span>';\n(document.body||document.documentElement).appendChild(node);}\nfunction show(){ensure();depth++;node.classList.add('on');}\nfunction hide(){depth=Math.max(0,depth-1);if(depth===0&&node)node.classList.remove('on');}\nwindow.myllmAsk=function(){show();var p;try{p=orig.apply(this,arguments);}catch(e){hide();throw e;}\nreturn Promise.resolve(p).then(function(r){hide();return r;},function(e){hide();throw e;});};})();\n</script>\n\n<script>\nvar store = window.myllmStorage || {getItem:function(){return Promise.resolve(null)}, setItem:function(){return Promise.resolve()}};\nfunction haptic(k){ if(window.myllmHaptic){ try{ myllmHaptic(k||'light'); }catch(_){} } }\nvar ASK = window.myllmAsk || null;\nfunction el(id){ return document.getElementById(id); }\nfunction esc(s){ return String(s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\"); }\n\nvar people = [];   /* {id,name,day,month,year|null,notes} */\nvar editing = null, armDelete = false;\nvar MONTHS = [\"Jan\",\"Feb\",\"Mar\",\"Apr\",\"May\",\"Jun\",\"Jul\",\"Aug\",\"Sep\",\"Oct\",\"Nov\",\"Dec\"];\nvar EMOJI = [\"🎂\",\"🎈\",\"🎁\",\"🥳\",\"🍰\",\"✨\"];\n\nfunction uid(){ return \"p\" + Date.now().toString(36) + Math.floor(Math.random()*1e5).toString(36); }\nfunction save(){ store.setItem(\"bdays\", JSON.stringify(people)); }\n\n/* days until the NEXT occurrence (0 = today) */\nfunction daysUntil(p){\n  var now = new Date(); now.setHours(0,0,0,0);\n  var next = new Date(now.getFullYear(), p.month - 1, p.day);\n  /* handle 29 Feb in non-leap years → celebrate 1 Mar */\n  if (p.day === 29 && p.month === 2 && next.getDate() !== 29) next = new Date(now.getFullYear(), 2, 1);\n  if (next < now){\n    next = new Date(now.getFullYear() + 1, p.month - 1, p.day);\n    if (p.day === 29 && p.month === 2 && next.getDate() !== 29) next = new Date(now.getFullYear() + 1, 2, 1);\n  }\n  return Math.round((next - now) / 86400000);\n}\nfunction turningAge(p){\n  if (!p.year) return null;\n  var now = new Date();\n  var age = now.getFullYear() - p.year;\n  var passed = daysUntil(p) === 0 ||\n    (new Date(now.getFullYear(), p.month - 1, p.day) >= new Date(now.getFullYear(), now.getMonth(), now.getDate()));\n  return passed ? age : age + 1;\n}\n\nfunction render(){\n  if (!people.length){\n    el(\"list\").innerHTML = '<div class=\"empty\"><div class=\"big\">🎂</div>Add the birthdays you must never miss.<br>They sort themselves by who\\'s next — and the AI helps with gift ideas.</div>';\n    el(\"sub\").textContent = \"Never scramble for a card again.\";\n    return;\n  }\n  var sorted = people.slice().sort(function(a, b){ return daysUntil(a) - daysUntil(b); });\n  var next = sorted[0];\n  var d0 = daysUntil(next);\n  el(\"sub\").textContent = d0 === 0 ? \"🎉 It's \" + next.name + \"'s birthday TODAY!\"\n    : \"Next up: \" + next.name + \" in \" + d0 + (d0 === 1 ? \" day\" : \" days\");\n  el(\"list\").innerHTML = sorted.map(function(p, i){\n    var d = daysUntil(p);\n    var age = turningAge(p);\n    var when = d === 0 ? \"today!\" : d === 1 ? \"tomorrow\" : \"in \" + d + \" days\";\n    return '<div class=\"person' + (d === 0 ? ' today' : '') + '\" onclick=\"openSheet(\\'' + p.id + '\\')\">' +\n      '<div class=\"cake\">' + EMOJI[i % EMOJI.length] + '</div>' +\n      '<div class=\"t\"><b>' + esc(p.name) + '</b>' +\n      '<small>' + p.day + ' ' + MONTHS[p.month - 1] + (age ? ' · turning ' + age : '') +\n      (p.notes ? ' · ' + esc(p.notes) : '') + '</small></div>' +\n      '<div class=\"when' + (d === 0 ? ' today' : '') + '\"><b>' + when + '</b>' +\n      (d !== 0 ? '<small>' + p.day + '/' + p.month + '</small>' : '<small>🎉</small>') + '</div></div>';\n  }).join(\"\");\n}\n\n/* ---------- sheet ---------- */\nfunction openSheet(id){\n  editing = id || null;\n  armDelete = false;\n  var p = editing ? people.filter(function(x){ return x.id === editing; })[0] : null;\n  el(\"sheetTitle\").textContent = p ? p.name : \"New birthday\";\n  el(\"f_name\").value = p ? p.name : \"\";\n  el(\"f_day\").value = p ? p.day : \"\";\n  el(\"f_month\").value = p ? p.month : \"\";\n  el(\"f_year\").value = p && p.year ? p.year : \"\";\n  el(\"f_notes\").value = p ? (p.notes || \"\") : \"\";\n  el(\"delBtn\").style.display = p ? \"block\" : \"none\";\n  el(\"delBtn\").textContent = \"Delete\";\n  el(\"giftBtn\").style.display = (p && ASK) ? \"block\" : \"none\";\n  el(\"ideas\").className = \"ideas\"; el(\"ideas\").innerHTML = \"\";\n  el(\"sheetnote\").textContent = (!ASK && p) ? \"Enable AI in Settings to get gift ideas here.\" : \"\";\n  el(\"veil\").classList.add(\"on\"); el(\"sheet\").classList.add(\"on\");\n  haptic(\"light\");\n}\nfunction closeSheet(){\n  el(\"veil\").classList.remove(\"on\"); el(\"sheet\").classList.remove(\"on\");\n  editing = null;\n}\nfunction savePerson(){\n  var name = el(\"f_name\").value.trim();\n  var day = parseInt(el(\"f_day\").value, 10);\n  var month = parseInt(el(\"f_month\").value, 10);\n  var year = parseInt(el(\"f_year\").value, 10) || null;\n  if (!name){ el(\"sheetnote\").textContent = \"A name would help.\"; return; }\n  if (!(day >= 1 && day <= 31) || !(month >= 1 && month <= 12)){\n    el(\"sheetnote\").textContent = \"Check the day and month (day 1–31, month 1–12).\"; return;\n  }\n  if (year && (year < 1900 || year > new Date().getFullYear())){\n    el(\"sheetnote\").textContent = \"That year looks off.\"; return;\n  }\n  var notes = el(\"f_notes\").value.trim();\n  if (editing){\n    var p = people.filter(function(x){ return x.id === editing; })[0];\n    p.name = name; p.day = day; p.month = month; p.year = year; p.notes = notes;\n  } else {\n    people.push({id:uid(), name:name, day:day, month:month, year:year, notes:notes});\n  }\n  save(); render(); closeSheet(); haptic(\"success\");\n}\nfunction delPerson(){\n  if (!armDelete){ armDelete = true; el(\"delBtn\").textContent = \"Really delete?\"; haptic(\"light\"); return; }\n  people = people.filter(function(x){ return x.id !== editing; });\n  save(); render(); closeSheet(); haptic(\"success\");\n}\n\n/* ---------- gift ideas ---------- */\n/* Labelled lines, not JSON — small models (Apple Intelligence) echo JSON\n   templates back verbatim. Echoed instructions are rejected and retried. */\nvar ECHO = /one specific gift idea|repeat this line|labelled line|short and concrete/i;\nfunction parseIdeas(reply){\n  var ideas = [], got = false;\n  String(reply || '').split(/\\r?\\n/).forEach(function(raw){\n    var ln = raw.replace(/\\*\\*/g, '').trim();\n    var m = ln.match(/^[-*#>\\s]*(IDEAS?)\\s*\\d*\\s*[::]\\s*(.*)$/i);\n    if (!m) return;\n    got = true;\n    var v = m[2].trim();\n    if (v) ideas.push(v);\n  });\n  if (!got){ // model answered in the old JSON-array shape — accept it\n    var s = String(reply || '');\n    var a = s.indexOf(\"[\"), b = s.lastIndexOf(\"]\");\n    if (a >= 0 && b > a) try{\n      var j = JSON.parse(s.slice(a, b + 1));\n      if (Array.isArray(j)) ideas = j.map(function(x){ return String(x).trim(); });\n    }catch(e){}\n  }\n  ideas = ideas.filter(function(x){ return x && !ECHO.test(x); });\n  if (ideas.length < 2) throw new Error(\"no real gift ideas came back\");\n  return ideas;\n}\nfunction giftIdeas(){\n  if (!ASK || !editing) return;\n  var p = people.filter(function(x){ return x.id === editing; })[0];\n  if (!p) return;\n  haptic(\"light\");\n  var age = turningAge(p);\n  var prompt = \"Suggest 5 thoughtful, specific birthday gift ideas for \" + p.name +\n      (age ? \" (turning \" + age + \")\" : \"\") +\n      (p.notes ? \", who loves: \" + p.notes : \"\") +\n      \". Mix price ranges; at least one should cost nothing but effort.\" +\n      \" Reply with EXACTLY these labelled lines and nothing else:\\n\" +\n      \"IDEA: one specific gift idea, short and concrete (repeat this line for each of the 5 ideas)\";\n  var sys = {system:\"You are a thoughtful gift-picker. Give specific, personal gift ideas.\"};\n  ASK(prompt, sys)\n  .then(function(r){ return parseIdeas(r); })\n  .catch(function(){\n    return ASK(prompt + \"\\nIMPORTANT: fill each labelled line with real content — never repeat the instruction text.\", sys)\n      .then(function(r){ return parseIdeas(r); });\n  })\n  .then(function(ideas){\n    el(\"ideas\").className = \"ideas on\";\n    el(\"ideas\").innerHTML = ideas.slice(0, 5).map(function(x){\n      return '<div class=\"idea\">🎁 ' + esc(String(x)) + '</div>';\n    }).join(\"\");\n    el(\"sheetnote\").textContent = \"\";\n    haptic(\"success\");\n  })\n  .catch(function(){ el(\"sheetnote\").textContent = \"The ideas didn't come through — tap again.\"; });\n}\n\n/* ---------- boot ---------- */\nstore.getItem(\"bdays\").then(function(v){\n  if (v){ try{ people = JSON.parse(v) || []; }catch(e){} }\n  render();\n});\n</script>\n</body>\n</html>\n"}