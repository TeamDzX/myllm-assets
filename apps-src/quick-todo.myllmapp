{"name": "Quick Todo", "html": "<!doctype html>\n<!--\n  Quick Todo — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Quick Todo</title>\n<meta name=\"myllm:intents\" content=\"add-todo\">\n<script type=\"application/myllm-actions\">[{\"name\":\"add-todo\",\"description\":\"Add a task to the user's Quick Todo list, optionally due on a date\",\"parameters\":{\"text\":\"the task\",\"due\":\"optional due date, YYYY-MM-DD\",\"list\":\"optional: the name of one of the user's lists (e.g. Work); the open list if left out\"}}]</script>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"7491b81bef\";color-scheme:light dark; --h:214;--grain:0.369954771855;}\n\n  /* Shared surface — the same block sits in Quick Todo, Action Items, Sprint\n     Planner and Risk & Decision Log, so the four read as one family. Each app\n     only sets its own hue. MyLLM's theme where it supplies one; the fallbacks\n     carry a dark set too, because a token-only page renders light in dark mode\n     on a build (or a platform) that sends no --myllm-* variables. */\n  :root{\n    --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n    --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,hsl(var(--h) 85% 52%));\n    --fill:rgba(118,118,128,.12); --good:#2aa84f; --warn:#e8890c; --bad:#ff453a; --h2:calc(var(--h) + 40);\n  }\n  @media (prefers-color-scheme:dark){ :root{\n    --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e); --ink:var(--myllm-text,#f2f2f7);\n    --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(118,118,128,.24); --good:#30d158; --warn:#ff9f0a;\n  } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    font-size:15.5px; line-height:1.35; max-width:600px; margin:0 auto; min-height:100dvh; -webkit-text-size-adjust:100%;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  svg{ width:1.25em; height:1.25em; flex-shrink:0; }\n  button{ font:inherit; color:inherit; border:none; background:none; }\n  button:active{ transform:scale(.96); }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .head .ht{ flex:1; min-width:0; }\n  .head h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 46%), hsl(var(--h2) 58% 24%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:20px 2px 9px;\n    display:flex; align-items:center; justify-content:space-between; gap:10px; min-height:20px; }\n  h2 button{ font-size:12.5px; font-weight:700; letter-spacing:0; text-transform:none; color:var(--acc); padding:6px 2px; margin:-6px 0; }\n  h2 .pts{ color:var(--ink); letter-spacing:0; text-transform:none; font-size:13px; font-variant-numeric:tabular-nums; }\n\n  /* Hero: the app's headline number on its own hue. */\n  .hero{ position:relative; overflow:hidden; border-radius:22px; padding:16px 16px 15px; color:#fff; margin-bottom:14px;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 46%), hsl(var(--h2) 58% 24%)); box-shadow:0 10px 28px hsl(var(--h) 60% 30% / .26); }\n  .hero .k{ font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.78; }\n  .hero .n{ font-size:44px; font-weight:800; letter-spacing:-.02em; line-height:1.08; font-variant-numeric:tabular-nums; }\n  .hero .s{ font-size:13px; opacity:.82; margin-top:1px; font-variant-numeric:tabular-nums; }\n  .hero .bar{ height:6px; border-radius:99px; background:rgba(255,255,255,.22); margin-top:12px; overflow:hidden; }\n  .hero .bar i{ display:block; height:100%; width:0; border-radius:99px; background:#fff; transition:width .3s cubic-bezier(.2,.8,.2,1); }\n  .hero .cols{ display:flex; gap:8px; } .hero .cols > div{ flex:1; min-width:0; }\n  .hero .cols .n{ font-size:32px; }\n  .hero .hbtn{ position:absolute; z-index:2; top:12px; right:12px; height:34px; padding:0 13px; border-radius:99px; font-size:12.5px; font-weight:700; color:#fff;\n    display:inline-flex; align-items:center; gap:6px; border:1px solid rgba(255,255,255,.22); background:rgba(255,255,255,.16);\n    -webkit-backdrop-filter:blur(18px); backdrop-filter:blur(18px); }\n  .hero .hbtn:disabled{ opacity:.45; }\n  .hero .marks{ display:flex; gap:6px; flex-wrap:wrap; margin-top:10px; }\n  .hero .marks span{ font-size:12px; font-weight:700; padding:4px 10px; border-radius:99px; background:rgba(255,255,255,.16); display:inline-flex; align-items:center; gap:6px; }\n  .hero .marks i{ width:7px; height:7px; border-radius:50%; background:currentColor; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  .card.list{ padding:2px 14px; }\n  input,textarea{ width:100%; font:inherit; font-size:16px; color:var(--ink); background:var(--surface); border:1px solid var(--line);\n    border-radius:12px; padding:11px 12px; -webkit-appearance:none; appearance:none; outline:none; }\n  input:focus,textarea:focus{ border-color:var(--acc); }\n  input::placeholder,textarea::placeholder{ color:var(--muted); }\n  textarea{ min-height:92px; resize:vertical; display:block; }\n  .card input,.card textarea{ background:var(--bg); }\n  .addrow{ display:flex; gap:8px; } .addrow input{ flex:1; min-width:0; }\n  /* v7: due dates. A chip beside the box picks one; every task can have one. */\n  .duechip{ flex-shrink:0; min-height:46px; min-width:46px; border-radius:12px; border:1px solid var(--line); background:var(--surface); color:var(--muted);\n    display:flex; align-items:center; justify-content:center; gap:5px; padding:0 10px; font-weight:700; font-size:13px; position:relative; }\n  .duechip.on{ color:var(--warn); border-color:hsl(32 90% 50% / .5); }\n  .duechip svg{ width:18px; height:18px; }\n  .datepick{ position:absolute; inset:0; opacity:0; width:100%; height:100%; border:0; padding:0; }\n  .rdate{ width:34px; height:34px; border-radius:50%; flex-shrink:0; display:flex; align-items:center; justify-content:center; color:var(--muted); position:relative; }\n  .rdate svg{ width:15px; height:15px; }\n  .tag.when.late{ background:hsl(4 90% 58% / .16); color:var(--bad); }\n  .tag.when.today{ background:hsl(210 90% 55% / .16); color:var(--acc); }\n  label{ display:block; font-size:11.5px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:13px 2px 7px; }\n\n  .btn{ min-height:46px; padding:0 16px; border-radius:13px; font-size:15px; font-weight:700; display:inline-flex; align-items:center; justify-content:center; gap:7px; flex-shrink:0; }\n  .btn.pri{ background:var(--acc); color:#fff; } .btn.sec{ background:var(--fill); color:var(--ink); }\n  .btn.wide{ width:100%; } .btn:disabled{ opacity:.5; }\n  .btnrow{ display:flex; gap:8px; margin-top:10px; } .btnrow .btn.pri{ flex:1; }\n  .pills{ display:flex; gap:6px; }\n  .pills button{ flex:1; min-width:0; height:42px; border-radius:12px; border:1px solid var(--line); background:var(--bg); font-size:15px; font-weight:750; font-variant-numeric:tabular-nums; }\n  .pills button.on{ background:var(--acc); border-color:var(--acc); color:#fff; }\n  .seg{ display:flex; gap:3px; padding:3px; border-radius:13px; background:var(--fill); margin-bottom:14px; }\n  .seg button{ flex:1; height:38px; border-radius:10px; font-size:14px; font-weight:700; color:var(--muted); }\n  .seg button.on{ background:var(--surface); color:var(--ink); box-shadow:0 1px 4px rgba(0,0,0,.14); }\n\n  /* Rows: a check on the left where the thing can be done, the text, then what you can do to it. */\n  .row{ display:flex; align-items:center; gap:11px; padding:10px 0; border-bottom:1px solid var(--line); min-height:52px; }\n  .row:last-child{ border-bottom:none; }\n  .row.top{ align-items:flex-start; }\n  .row .body{ flex:1; min-width:0; }\n  .row .tx{ font-size:15.5px; line-height:1.35; overflow-wrap:break-word; }\n  .row.done .tx{ color:var(--muted); text-decoration:line-through; }\n  .ck{ width:26px; height:26px; border-radius:50%; border:2px solid var(--muted); opacity:.9; flex-shrink:0; display:flex; align-items:center; justify-content:center;\n    color:transparent; font-size:12px; transition:background .2s, border-color .2s; }\n  .row.top .ck{ margin-top:1px; }\n  .row.done .ck{ background:var(--acc); border-color:var(--acc); color:#fff; opacity:1; }\n  .ck.good{ } .row.done .ck.good{ background:var(--good); border-color:var(--good); }\n  .x{ width:36px; height:36px; margin:-4px -8px -4px -2px; border-radius:50%; flex-shrink:0; display:flex; align-items:center; justify-content:center; color:var(--muted); font-size:13px; }\n  .x:active{ color:var(--bad); background:var(--fill); }\n  .tags{ display:flex; gap:6px; flex-wrap:wrap; margin-top:6px; }\n  .tag{ display:inline-flex; align-items:center; gap:5px; font-size:12px; font-weight:700; padding:3px 9px; border-radius:99px; background:var(--fill); color:var(--muted); max-width:100%; }\n  .tag span{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  .tag svg{ font-size:10.5px; }\n  .tag.who{ background:hsl(140 60% 45% / .16); color:var(--good); } .tag.when{ background:hsl(32 90% 50% / .16); color:var(--warn); }\n\n  .empty{ text-align:center; padding:26px 12px 22px; }\n  .empty .tile{ width:54px; height:54px; border-radius:16px; font-size:24px; margin:0 auto 12px; }\n  .empty p{ font-size:14px; color:var(--muted); max-width:280px; margin:0 auto; }\n  .empty .btn{ margin-top:14px; min-height:40px; font-size:14px; }\n\n  .note{ font-size:13px; color:var(--muted); margin:10px 2px 0; min-height:18px; }\n  .note:empty{ display:none; }\n  .alert{ display:flex; align-items:flex-start; gap:10px; border-radius:16px; padding:12px 13px; margin-top:10px; font-size:13.5px; line-height:1.4;\n    background:hsl(4 90% 58% / .12); border:1px solid hsl(4 90% 58% / .28); }\n  .alert svg{ color:var(--bad); margin-top:1px; } .alert div{ flex:1; min-width:0; }\n  .alert button{ font-weight:750; color:var(--acc); font-size:13.5px; padding:2px 0 0 8px; flex-shrink:0; }\n  .alert.info{ background:var(--fill); border-color:transparent; } .alert.info svg{ color:var(--muted); }\n  .spin{ width:16px; height:16px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n  .skel{ height:14px; border-radius:7px; background:var(--fill); animation:skel 1.1s ease-in-out infinite alternate; }\n  @keyframes skel{ from{ opacity:.45; } to{ opacity:1; } }\n\n  @media (max-width:340px){ .hero .cols .k{ font-size:9.5px; letter-spacing:.05em; } .btn{ font-size:14px; padding:0 12px; } .row{ gap:8px; }\n    body{ padding-left:calc(12px + env(safe-area-inset-left)); padding-right:calc(12px + env(safe-area-inset-right)); }\n    .hero .n{ font-size:38px; } .hero .cols .n{ font-size:26px; } .pills{ gap:4px; } }\n  @media (min-width:768px){ body{ max-width:760px; } }\n  @media (prefers-reduced-motion:reduce){ .spin{ animation-duration:2.4s; } .skel{ animation:none; } .hero .bar i{ transition:none; } button:active{ transform:none; } }\n\n  /* this app's own colours, after the shared defaults so they win */\n  :root{ --acc:var(--myllm-accent,#0a84ff); }\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n/* lists-kit:css */\n/* lists-kit v1 — list bar + sheet (uses the app's --bg/--surface/--ink/--muted/--line/--acc/--fill) */\n.lk-bar{ display:flex; align-items:center; gap:8px; margin:0 0 12px; }\n.lk-chips{ flex:1; min-width:0; display:flex; gap:6px; overflow-x:auto; scrollbar-width:none; -webkit-overflow-scrolling:touch; padding:2px 1px; }\n.lk-chips::-webkit-scrollbar{ display:none; }\n.lk-chip{ flex-shrink:0; display:inline-flex; align-items:center; gap:6px; height:34px; padding:0 13px; border-radius:99px; font-size:13.5px; font-weight:700;\n  background:var(--surface); border:1px solid var(--line); color:var(--ink); max-width:62vw; }\n.lk-chip span{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n.lk-chip.on{ background:var(--acc); border-color:var(--acc); color:#fff; }\n.lk-chip.lk-new{ color:var(--acc); border-style:dashed; }\n.lk-i{ width:15px; height:15px; flex-shrink:0; }\n.lk-dot{ width:7px; height:7px; border-radius:50%; background:#ff9f0a; flex-shrink:0; }\n.lk-share{ flex-shrink:0; display:inline-flex; align-items:center; gap:6px; height:34px; padding:0 12px; border-radius:99px; font-size:13px; font-weight:700;\n  color:var(--acc); background:var(--fill); }\n.lk-line{ font-size:12.5px; color:var(--muted); margin:-6px 4px 10px; min-height:0; }\n.lk-line:empty{ display:none; }\n.lk-line.bad{ color:#e8890c; }\n.lk-wrap{ position:fixed; inset:0; z-index:50; background:rgba(0,0,0,0); display:flex; align-items:flex-end; justify-content:center; transition:background .2s; }\n.lk-wrap.show{ background:rgba(0,0,0,.38); }\n.lk-sheet{ width:100%; max-width:520px; background:var(--surface); color:var(--ink); border-radius:22px 22px 0 0; display:flex; flex-direction:column; gap:10px;\n  padding:18px 16px calc(18px + env(safe-area-inset-bottom)); transform:translateY(100%); transition:transform .25s cubic-bezier(.2,.8,.2,1); max-height:88dvh; overflow:auto; }\n.lk-wrap.show .lk-sheet{ transform:none; }\n.lk-sheet h3{ font-size:19px; font-weight:800; overflow-wrap:anywhere; }\n.lk-sub{ font-size:13.5px; color:var(--muted); margin-top:-6px; }\n.lk-sheet input{ width:100%; font:inherit; font-size:16px; color:var(--ink); background:var(--bg); border:1px solid var(--line); border-radius:12px; padding:11px 12px; outline:none; -webkit-appearance:none; }\n.lk-sheet input:focus{ border-color:var(--acc); }\n.lk-sheet input:disabled{ opacity:.6; }\n.lk-field{ display:flex; gap:8px; } .lk-field input{ flex:1; min-width:0; }\n.lk-row{ display:flex; gap:8px; } .lk-row .lk-btn{ flex:1; }\n.lk-btn{ min-height:44px; padding:0 14px; border-radius:13px; font-size:15px; font-weight:700; background:var(--fill); color:var(--ink);\n  display:inline-flex; align-items:center; justify-content:center; gap:8px; flex-shrink:0; }\n.lk-btn.wide{ width:100%; }\n.lk-btn.pri{ background:var(--acc); color:#fff; }\n.lk-btn.danger{ color:#ff453a; }\n.lk-btn:disabled{ opacity:.45; }\n.lk-note{ font-size:12.5px; color:var(--muted); line-height:1.4; }\n.lk-err{ color:#ff453a; }\n.lk-toast{ position:fixed; left:50%; bottom:calc(24px + env(safe-area-inset-bottom)); transform:translate(-50%, 20px); opacity:0; pointer-events:none; z-index:60;\n  background:rgba(30,30,32,.94); color:#fff; font-size:14px; font-weight:600; padding:10px 16px; border-radius:99px; max-width:86vw; text-align:center; transition:all .25s; }\n.lk-toast.show{ opacity:1; transform:translate(-50%, 0); }\n@media (prefers-reduced-motion:reduce){ .lk-wrap,.lk-sheet,.lk-toast{ transition:none; } }\n/* /lists-kit:css */\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M5 12.6l4.6 4.6L19.2 7.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-plus\" viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-cal\" viewBox=\"0 0 24 24\"><rect x=\"3.5\" y=\"5\" width=\"17\" height=\"15.5\" rx=\"3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"/><path d=\"M3.5 10h17M8 3v4M16 3v4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-list\" viewBox=\"0 0 24 24\"><path d=\"M4.5 7.2l1.7 1.7 3-3.4M4.5 15.2l1.7 1.7 3-3.4M13 7.5h7M13 15.5h7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n</defs></svg>\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg><use href=\"#i-list\"/></svg></div>\n  <div class=\"ht\"><h1>Quick Todo</h1><p>Lists you can share through iCloud</p></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Quick Todo\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n<!-- lists-kit:bar --><div class=\"lk-bar\" id=\"lkBar\"></div><p class=\"lk-line\" id=\"lkLine\"></p><!-- /lists-kit:bar --><div class=\"hero\" id=\"hero\">\n  <div class=\"k\">To do</div>\n  <div class=\"n\" id=\"hN\">0</div>\n  <div class=\"s\" id=\"hS\">Nothing yet</div>\n  <div class=\"bar\"><i id=\"hBar\"></i></div>\n</div>\n<div class=\"addrow\"><input id=\"t\" placeholder=\"Add a task…\" enterkeyhint=\"done\" autocomplete=\"off\"><label class=\"duechip\" id=\"dueChip\" aria-label=\"Due date\"><svg><use href=\"#i-cal\"/></svg><span id=\"dueLbl\"></span><input type=\"date\" class=\"datepick\" id=\"due\"></label><button class=\"btn pri\" id=\"addBtn\"><svg><use href=\"#i-plus\"/></svg>Add</button></div>\n<h2>Tasks</h2>\n<div id=\"list\"></div>\n<script id=\"lists-kit\">\n/* lists-kit v1 — several lists in one app; any of them can move to iCloud and\n   be shared with other iCloud users, who edit the same list from their own\n   MyLLM (myllmLists, MyLLM 6.1+). Without iCloud everything stays on this\n   device, as before.\n   The app keeps its own item code and calls:\n     ListsKit.start({kind, storeKey, defaultName, noun, fix, legacy, render, main, changed, ready})\n     main(items): the first list changed · changed(list): any list changed\n     ListsKit.items()  → the open list's items (the app may mutate it)\n     ListsKit.set(arr[, list]) → after any change (saves, mirrors, syncs)\n     ListsKit.byName(name) / ListsKit.current() / ListsKit.all() */\n(function(){\n  var K = window.ListsKit = {};\n  var o = null, st = { current: null, lists: [] };\n  var cloud = null, why = \"\";           // null = not asked yet\n  var pushing = {}, timers = {}, polling = null;\n\n  function el(id){ return document.getElementById(id); }\n  function esc(s){ return String(s).replace(/[&<>\"]/g, function(c){ return {\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\"}[c]; }); }\n  function haptic(k){ try { if (window.myllmHaptic) myllmHaptic(k || \"light\"); } catch(e){} }\n  function uid(){ return \"l_\" + Date.now().toString(36) + Math.random().toString(36).slice(2, 6); }\n  function find(id){ for (var i = 0; i < st.lists.length; i++) if (st.lists[i].id === id) return st.lists[i]; return null; }\n  function cur(){ return find(st.current) || st.lists[0]; }\n  function fixAll(a){ return (Array.isArray(a) ? a : []).filter(function(x){ return x && typeof x === \"object\"; }).map(o.fix); }\n  function same(a, b){ return JSON.stringify(a) === JSON.stringify(b); }\n\n  /* ---- this device ---- */\n  /* myllmStorage only: MyLLM always has it, and outside MyLLM the lists just\n     last while the page is open. */\n  function persist(){\n    var S = window.myllmStorage;\n    try { if (S) S.setItem(o.storeKey, JSON.stringify(st)).catch(function(){}); } catch(e){}\n  }\n  function restore(){\n    var S = window.myllmStorage;\n    if (!S) return Promise.resolve(null);\n    return Promise.resolve().then(function(){ return S.getItem(o.storeKey); }).catch(function(){ return null; })\n      .then(function(v){ try { return v ? JSON.parse(v) : null; } catch(e){ return null; } });\n  }\n  function afterChange(list){\n    persist();\n    if (list === st.lists[0] && o.main) try { o.main(list.items); } catch(e){}\n    if (o.changed) try { o.changed(list); } catch(e){}\n  }\n\n  /* ---- merge: what changed here since `base` wins, the rest follows `remote`\n     (the same rules MyLLM uses in iCloud) ---- */\n  function merge(base, local, remote){\n    function idx(a){ var m = {}; a.forEach(function(x){ m[x.id] = x; }); return m; }\n    var b = idx(base), r = idx(remote), out = [], placed = {};\n    local.forEach(function(x){\n      if (placed[x.id]) return;\n      var mine = !same(x, b[x.id]);\n      if (r[x.id]) out.push(mine ? x : r[x.id]);\n      else if (!b[x.id] || mine) out.push(x);\n      else return;\n      placed[x.id] = 1;\n    });\n    var prev = null;\n    remote.forEach(function(x){\n      var p = prev; prev = x.id;\n      if (placed[x.id] || b[x.id]) return;\n      var at = 0;\n      if (p != null) for (var i = 0; i < out.length; i++) if (out[i].id === p) { at = i + 1; break; }\n      out.splice(at, 0, x); placed[x.id] = 1;\n    });\n    return out;\n  }\n  K._merge = merge;\n\n  /* ---- iCloud ---- */\n  function check(){\n    if (!window.myllmLists) { cloud = false; why = \"Sharing needs MyLLM 6.1 or later on iPhone, iPad or Mac.\"; return Promise.resolve(); }\n    return myllmLists.available().then(function(a){ cloud = !!(a && a.available); why = (a && a.reason) || \"\"; })\n      .catch(function(e){ cloud = false; why = e.message || \"iCloud couldn't be reached.\"; });\n  }\n  function meta(l, r){\n    l.name = r.name || l.name;\n    l.cloud = { shared: !!r.shared, owner: !!r.owner, ownerName: r.ownerName || \"\", people: r.people || [] };\n  }\n  function pull(){\n    if (!cloud) return Promise.resolve();\n    return myllmLists.all(o.kind).then(function(remote){\n      var seen = {}, gone = [];\n      remote.forEach(function(r){\n        seen[r.id] = 1;\n        var l = find(r.id);\n        if (!l) { l = { id: r.id, items: fixAll(r.items) }; meta(l, r); st.lists.push(l); return; }\n        l.err = null;\n        if (l.dirty || pushing[l.id]) { meta(l, r); return; }    // our change is on its way\n        l.items = fixAll(r.items); meta(l, r);\n      });\n      st.lists = st.lists.filter(function(l){ if (l.cloud && !seen[l.id]) { gone.push(l.name); return false; } return true; });\n      if (!st.lists.length) st.lists.push({ id: uid(), name: o.defaultName, items: [] });\n      if (!find(st.current)) st.current = st.lists[0].id;\n      if (gone.length) toast(\"“\" + gone[0] + \"” was deleted or is no longer shared with you\");\n      afterChange(st.lists[0]); paint(); o.render();\n    }).catch(function(e){\n      st.lists.forEach(function(l){ if (l.cloud) l.err = e.message; }); paint();\n    });\n  }\n  function schedule(l){\n    clearTimeout(timers[l.id]);\n    timers[l.id] = setTimeout(function(){ push(l.id); }, 450);\n  }\n  function push(id){\n    var l = find(id);\n    if (!l || !l.cloud || !l.dirty || !cloud) return Promise.resolve();\n    if (pushing[id]) return pushing[id];\n    var sent = JSON.parse(JSON.stringify(l.items));\n    l.dirty = false;\n    pushing[id] = myllmLists.save(id, sent).then(function(r){\n      var now = find(id); if (!now) return;\n      var merged = fixAll(r.items);\n      if (same(now.items, sent)) now.items = merged;\n      else { now.items = merge(sent, now.items, merged); now.dirty = true; }   // edited while saving\n      meta(now, r); now.err = null;\n    }).catch(function(e){\n      var now = find(id); if (now) { now.dirty = true; now.err = e.message || \"Not synced\"; }\n    }).then(function(){\n      delete pushing[id];\n      var now = find(id);\n      if (now) { afterChange(now); if (now === cur()) o.render(); paint(); if (now.dirty && !now.err) schedule(now); }\n    });\n    return pushing[id];\n  }\n  function accepted(){\n    if (!cloud || !myllmLists.takeAccepted) return Promise.resolve();\n    return myllmLists.takeAccepted(o.kind).then(function(id){\n      if (!id) return;\n      return pull().then(function(){\n        var l = find(id); if (!l) return;\n        st.current = id; persist(); paint(); o.render();\n        toast(\"You've joined “\" + l.name + \"”\");\n      });\n    }).catch(function(){});\n  }\n  function tick(){\n    if (document.hidden) return;\n    var errs = st.lists.filter(function(l){ return l.cloud && l.dirty && l.err; });\n    errs.forEach(function(l){ l.err = null; push(l.id); });\n    pull();\n  }\n\n  /* ---- the list bar ---- */\n  function people(l){\n    if (!l.cloud) return \"\";\n    if (!l.cloud.owner) return \"Shared by \" + (l.cloud.ownerName || \"someone\");\n    if (l.cloud.people.length) return \"Shared with \" + l.cloud.people.join(\", \");\n    return \"In your iCloud\";\n  }\n  function paint(){\n    var bar = el(\"lkBar\"); if (!bar) return;\n    var c = cur(), h = '<div class=\"lk-chips\" role=\"tablist\">';\n    st.lists.forEach(function(l){\n      h += '<button class=\"lk-chip' + (l === c ? \" on\" : \"\") + '\" role=\"tab\" aria-selected=\"' + (l === c) + '\" data-lk=\"' + esc(l.id) + '\">' +\n        (l.cloud && (l.cloud.shared || !l.cloud.owner) ? '<svg class=\"lk-i\" viewBox=\"0 0 24 24\" aria-label=\"Shared\"><use href=\"#lk-people\"/></svg>' : \"\") +\n        '<span>' + esc(l.name) + '</span>' + (l.cloud && l.err ? '<i class=\"lk-dot\" title=\"Not synced\"></i>' : \"\") + '</button>';\n    });\n    h += '<button class=\"lk-chip lk-new\" data-lk-new aria-label=\"New ' + o.noun + '\"><svg class=\"lk-i\" viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></svg><span>New</span></button></div>';\n    h += '<button class=\"lk-share\" data-lk-menu aria-label=\"Share or edit this ' + o.noun + '\"><svg class=\"lk-i\" viewBox=\"0 0 24 24\"><use href=\"#lk-people\"/></svg><span>' + (c.cloud && (c.cloud.shared || !c.cloud.owner) ? \"Shared\" : \"Share\") + '</span></button>';\n    bar.innerHTML = h;\n    var line = el(\"lkLine\");\n    if (line) {\n      var t = people(c);\n      if (c.cloud && c.err) t = (t ? t + \" · \" : \"\") + \"Not synced: \" + c.err;\n      line.textContent = t; line.classList.toggle(\"bad\", !!(c.cloud && c.err));\n    }\n    var on = bar.querySelector(\".lk-chip.on\");\n    if (on && on.scrollIntoView) try { on.scrollIntoView({ block: \"nearest\", inline: \"nearest\" }); } catch(e){}\n  }\n\n  /* ---- sheet ---- */\n  function sheet(html, wire){\n    close();\n    var w = document.createElement(\"div\");\n    w.className = \"lk-wrap\"; w.id = \"lkWrap\";\n    w.innerHTML = '<div class=\"lk-sheet\" role=\"dialog\" aria-modal=\"true\">' + html + '</div>';\n    w.addEventListener(\"click\", function(e){ if (e.target === w) close(); });\n    document.body.appendChild(w);\n    requestAnimationFrame(function(){ w.classList.add(\"show\"); });\n    wire(w);\n  }\n  function close(){ var w = el(\"lkWrap\"); if (w) w.remove(); }\n  function busy(btn, on, label){ if (!btn) return; btn.disabled = on; if (label) btn.textContent = label; }\n\n  function newSheet(){\n    sheet('<h3>New ' + o.noun + '</h3><input id=\"lkName\" maxlength=\"60\" placeholder=\"Name, e.g. ' + esc(o.example) + '\" enterkeyhint=\"done\" autocomplete=\"off\">' +\n      '<div class=\"lk-row\"><button class=\"lk-btn\" data-x>Cancel</button><button class=\"lk-btn pri\" id=\"lkMake\">Create</button></div>' +\n      '<p class=\"lk-note\">' + (cloud ? \"Kept on this device until you share it.\" : \"Kept on this device.\") + '</p>', function(w){\n      var inp = w.querySelector(\"#lkName\"), go = w.querySelector(\"#lkMake\");\n      w.querySelector(\"[data-x]\").onclick = close;\n      function make(){\n        var name = inp.value.trim(); if (!name) { inp.focus(); return; }\n        var l = { id: uid(), name: name.slice(0, 60), items: [] };\n        st.lists.push(l); st.current = l.id; persist(); close(); haptic(\"success\"); paint(); o.render();\n      }\n      go.onclick = make;\n      inp.addEventListener(\"keydown\", function(e){ if (e.key === \"Enter\") make(); });\n      setTimeout(function(){ inp.focus(); }, 60);\n    });\n  }\n\n  function menuSheet(){\n    var l = cur(), isCloud = !!l.cloud, owner = !isCloud || l.cloud.owner, only = st.lists.length < 2;\n    var status = isCloud ? people(l) : \"On this device only\";\n    var shareLabel = !isCloud ? \"Share with people…\" : owner ? \"Manage sharing…\" : \"See who's sharing…\";\n    var del = !owner ? \"Leave this \" + o.noun : isCloud && l.cloud.shared ? \"Delete for everyone\" : \"Delete \" + o.noun;\n    sheet('<h3>' + esc(l.name) + '</h3><p class=\"lk-sub\">' + esc(status) + '</p>' +\n      '<button class=\"lk-btn pri wide\" id=\"lkShare\"><svg class=\"lk-i\" viewBox=\"0 0 24 24\"><use href=\"#lk-people\"/></svg>' + shareLabel + '</button>' +\n      (cloud === false ? '<p class=\"lk-note\">' + esc(why) + '</p>' : !isCloud ? '<p class=\"lk-note\">Sharing moves this ' + o.noun + ' to your iCloud. People you invite need MyLLM 6.1 or later and edit it from their own app.</p>' : \"\") +\n      '<div class=\"lk-field\"><input id=\"lkRename\" maxlength=\"60\" value=\"' + esc(l.name) + '\" aria-label=\"Name\" enterkeyhint=\"done\" autocomplete=\"off\"' + (owner ? \"\" : \" disabled\") + '>' +\n      (owner ? '<button class=\"lk-btn\" id=\"lkSave\">Rename</button>' : \"\") + '</div>' +\n      '<button class=\"lk-btn danger wide\" id=\"lkDel\"' + (only && owner ? \" disabled\" : \"\") + '>' + del + '</button>' +\n      (only && owner ? '<p class=\"lk-note\">This is your only ' + o.noun + '. Make another first to delete it.</p>' : \"\") +\n      '<button class=\"lk-btn wide\" data-x>Done</button>', function(w){\n      w.querySelector(\"[data-x]\").onclick = close;\n      var share = w.querySelector(\"#lkShare\"), msg = function(t){ var n = w.querySelector(\".lk-err\") || w.querySelector(\".lk-sheet\").appendChild(Object.assign(document.createElement(\"p\"), { className: \"lk-note lk-err\" })); n.textContent = t; };\n      share.disabled = cloud === false;\n      share.onclick = function(){ busy(share, true); shareList(l).then(close, function(e){ busy(share, false); msg(e.message || String(e)); }); };\n      var ren = w.querySelector(\"#lkSave\");\n      if (ren) ren.onclick = function(){\n        var name = w.querySelector(\"#lkRename\").value.trim().slice(0, 60); if (!name || name === l.name) return;\n        busy(ren, true);\n        (l.cloud ? myllmLists.rename(l.id, name).then(function(r){ meta(l, r); }) : Promise.resolve(l.name = name))\n          .then(function(){ persist(); paint(); close(); haptic(\"success\"); }, function(e){ busy(ren, false); msg(e.message); });\n      };\n      var d = w.querySelector(\"#lkDel\"), armed = false;\n      d.onclick = function(){\n        if (!armed) { armed = true; d.textContent = \"Tap again to \" + del.charAt(0).toLowerCase() + del.slice(1); haptic(\"warning\"); return; }\n        busy(d, true);\n        (l.cloud ? myllmLists.remove(l.id) : Promise.resolve()).then(function(){\n          st.lists = st.lists.filter(function(x){ return x !== l; });\n          if (!st.lists.length) st.lists.push({ id: uid(), name: o.defaultName, items: [] });\n          st.current = st.lists[0].id; afterChange(st.lists[0]); close(); paint(); o.render(); haptic(\"light\");\n        }, function(e){ busy(d, false); msg(e.message); });\n      };\n    });\n  }\n\n  /* Moving a list to iCloud the first time it's shared: create it there, put\n     the items in, swap it into place, then open Apple's sharing sheet. */\n  function shareList(l){\n    var go = cloud === null ? check() : Promise.resolve();\n    return go.then(function(){\n      if (!cloud) throw new Error(why || \"iCloud isn't available.\");\n      if (l.cloud) return myllmLists.share(l.id);\n      return myllmLists.create(o.kind, l.name).then(function(c){\n        return myllmLists.save(c.id, l.items).then(function(r){\n          var at = st.lists.indexOf(l), moved = { id: r.id, items: fixAll(r.items) };\n          meta(moved, r);\n          if (at >= 0) st.lists[at] = moved; else st.lists.push(moved);\n          if (st.current === l.id) st.current = moved.id;\n          afterChange(moved); paint(); o.render();\n          return myllmLists.share(moved.id);\n        });\n      });\n    });\n  }\n\n  var toastT = null;\n  function toast(t){\n    var n = el(\"lkToast\");\n    if (!n) { n = document.createElement(\"div\"); n.id = \"lkToast\"; n.className = \"lk-toast\"; document.body.appendChild(n); }\n    n.textContent = t; n.classList.add(\"show\");\n    clearTimeout(toastT); toastT = setTimeout(function(){ n.classList.remove(\"show\"); }, 2600);\n  }\n\n  /* ---- public ---- */\n  K.items = function(){ return cur().items; };\n  K.current = function(){ return cur(); };\n  K.all = function(){ return st.lists; };\n  K.byName = function(name){\n    var n = String(name || \"\").trim().toLowerCase(); if (!n) return null;\n    for (var i = 0; i < st.lists.length; i++) if (st.lists[i].name.toLowerCase() === n) return st.lists[i];\n    return null;\n  };\n  K.set = function(arr, list){\n    var l = list || cur(); l.items = arr;\n    afterChange(l); paint();\n    if (l.cloud) { l.dirty = true; schedule(l); }\n  };\n  K.start = function(opts){\n    o = opts; o.noun = o.noun || \"list\"; o.example = o.example || \"Weekend\";\n    var defs = document.createElement(\"div\");\n    defs.innerHTML = '<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><symbol id=\"lk-people\" viewBox=\"0 0 24 24\">' +\n      '<circle cx=\"9\" cy=\"8\" r=\"3.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"/><path d=\"M2.8 19.5c.6-3.3 3.1-5.2 6.2-5.2s5.6 1.9 6.2 5.2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"/>' +\n      '<path d=\"M15.6 4.9a3.2 3.2 0 0 1 0 6.2M18 14.6c1.7.7 2.9 2.4 3.2 4.9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"/></symbol></svg>';\n    document.body.appendChild(defs.firstChild);\n    document.addEventListener(\"click\", function(e){\n      var t = e.target.closest ? e.target : null; if (!t) return;\n      var chip = t.closest(\"[data-lk]\"), add = t.closest(\"[data-lk-new]\"), menu = t.closest(\"[data-lk-menu]\");\n      if (chip) { var id = chip.getAttribute(\"data-lk\"); if (id !== st.current) { st.current = id; persist(); haptic(\"selection\"); paint(); o.render(); } else menuSheet(); }\n      else if (add) newSheet();\n      else if (menu) menuSheet();\n    });\n    return restore().then(function(saved){\n      if (saved && Array.isArray(saved.lists) && saved.lists.length) {\n        st = saved;\n        st.lists.forEach(function(l){ l.items = fixAll(l.items); l.err = null; });\n        return null;\n      }\n      return Promise.resolve(o.legacy ? o.legacy() : []).catch(function(){ return []; }).then(function(items){\n        st = { current: null, lists: [{ id: uid(), name: o.defaultName, items: fixAll(items) }] };\n        st.current = st.lists[0].id; persist();\n      });\n    }).then(function(){\n      if (!find(st.current)) st.current = st.lists[0].id;\n      paint(); o.render();\n      if (o.ready) try { o.ready(); } catch(e){}     // lists are usable now; iCloud follows\n      return check();\n    }).then(function(){\n      paint();\n      if (!cloud) return;\n      return pull().then(function(){\n        st.lists.forEach(function(l){ if (l.cloud && l.dirty) push(l.id); });\n        return accepted();\n      }).then(function(){\n        polling = setInterval(tick, 12000);\n        document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) { tick(); accepted(); } });\n      });\n    });\n  };\n})();\n</script>\n<script>\nfunction el(i){ return document.getElementById(i); }\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction haptic(k){ if (window.myllmHaptic) try { myllmHaptic(k || \"light\"); } catch(_){} }\nfunction load(k){ var s = window.myllmStorage; if (!s) return Promise.resolve(null); try { return s.getItem(k).catch(function(){ return null; }); } catch(_){ return Promise.resolve(null); } }\nfunction keep(k, v){ var s = window.myllmStorage; if (s) try { s.setItem(k, v).catch(function(){}); } catch(_){} }\nfunction esc(s){ return (s + \"\").replace(/[&<>\"]/g, function(c){ return {\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\"}[c]; }); }\nfunction icon(n){ return '<svg><use href=\"#i-' + n + '\"/></svg>'; }\nfunction emptyState(glyph, text, action, target){\n  return '<div class=\"empty\"><div class=\"tile\">' + icon(glyph) + '</div><p>' + text + '</p>' +\n    (action ? '<button class=\"btn sec\" data-focus=\"' + target + '\">' + icon(\"plus\") + action + '</button>' : '') + '</div>';\n}\ndocument.addEventListener(\"click\", function(e){\n  var b = e.target.closest && e.target.closest(\"[data-focus]\");\n  if (b){ var f = el(b.getAttribute(\"data-focus\")); if (f){ f.focus(); f.scrollIntoView({block:\"center\", behavior:\"smooth\"}); } }\n});\nvar todos = [];\n/* v8: the lists live in ListsKit (this app's storage, or iCloud once shared). */\nfunction fixTodo(td){ return { id: String(td.id || (\"t_\" + Date.now() + \"_\" + Math.floor(Math.random() * 100000))), text: String(td.text || \"\"), done: !!td.done,\n  due: validDay(td.due), added: td.added || null, doneAt: td.doneAt || null }; }\nfunction save(list){ if (list) ListsKit.set(list.items, list); else ListsKit.set(todos); }\n\n/* ---- dates ---- */\nfunction pad2(n){ return (n < 10 ? \"0\" : \"\") + n; }\nfunction dayOf(d){ return d.getFullYear() + \"-\" + pad2(d.getMonth() + 1) + \"-\" + pad2(d.getDate()); }\nfunction today(){ return dayOf(new Date()); }\nfunction addDays(day, n){ var d = new Date(+day.slice(0,4), +day.slice(5,7) - 1, +day.slice(8,10)); d.setDate(d.getDate() + n); return dayOf(d); }\nfunction validDay(v){ return /^\\d{4}-\\d{2}-\\d{2}$/.test(String(v || \"\")) ? String(v) : null; }\nfunction dueLabel(day){\n  var t = today();\n  if (day === t) return \"Today\";\n  if (day === addDays(t, 1)) return \"Tomorrow\";\n  if (day === addDays(t, -1)) return \"Yesterday\";\n  var d = new Date(+day.slice(0,4), +day.slice(5,7) - 1, +day.slice(8,10)), soon = day > t && day <= addDays(t, 6);\n  return d.toLocaleDateString(undefined, soon ? { weekday: \"short\" } : { weekday: \"short\", day: \"numeric\", month: \"short\" });\n}\n\n/* ---- Shared data (docs/SHARED_DATA.md): every list also goes to\n   data/todos.json so other apps (Calendar Planner) can show it; `list` says\n   which. Best effort. ---- */\nfunction publish(){\n  var F = window.myllmFiles; if (!F || !F.write) return;\n  var all = [];\n  ListsKit.all().forEach(function(l){ l.items.forEach(function(t){\n    all.push({ id: t.id, text: t.text, done: !!t.done, due: t.due || null, added: t.added || null, doneAt: t.doneAt || null, list: l.name }); }); });\n  var out = { schema: \"myllm.todos\", version: 1, source: \"quick-todo\", updated: new Date().toISOString(), items: all };\n  try { Promise.resolve(F.write(\"data/todos.json\", JSON.stringify(out))).catch(function(){}); } catch(e){}\n}\nfunction newTodo(text, due){ return { id: \"t_\" + Date.now() + \"_\" + Math.floor(Math.random() * 1000), text: text, done: false, due: validDay(due), added: new Date().toISOString(), doneAt: null }; }\nfunction render(){\n  todos = ListsKit.items();\n  var L = el(\"list\"), done = todos.filter(function(t){ return t.done; }).length, open = todos.length - done;\n  el(\"hN\").textContent = open;\n  el(\"hS\").textContent = !todos.length ? \"Nothing yet\" : open ? done + \" of \" + todos.length + \" done\" : \"All \" + todos.length + \" done\";\n  el(\"hBar\").style.width = (todos.length ? Math.round(done / todos.length * 100) : 0) + \"%\";\n  if (!todos.length){ L.innerHTML = '<div class=\"card\">' + emptyState(\"list\", \"Nothing yet — add your first task.\", \"Add a task\", \"t\") + '</div>'; return; }\n  L.innerHTML = \"\"; var card = document.createElement(\"div\"); card.className = \"card list\";\n  todos.forEach(function(td, i){\n    var d = document.createElement(\"div\"); d.className = \"row\" + (td.done ? \" done\" : \"\");\n    var late = td.due && !td.done && td.due < today(), isToday = td.due === today();\n    d.innerHTML = '<div class=\"ck\">' + icon(\"check\") + '</div><div class=\"body\"><div class=\"tx\"></div>' +\n      (td.due ? '<div class=\"tags\"><span class=\"tag when' + (late ? \" late\" : isToday ? \" today\" : \"\") + '\">' + icon(\"cal\") + '<span>' + esc((late ? \"Overdue \\u00b7 \" : \"\") + dueLabel(td.due)) + '</span></span></div>' : '') +\n      '</div><label class=\"rdate\" aria-label=\"' + (td.due ? \"Change due date\" : \"Add a due date\") + '\">' + icon(\"cal\") + '<input type=\"date\" class=\"datepick\"></label><button class=\"x\" aria-label=\"Delete\">' + icon(\"x\") + '</button>';\n    d.querySelector(\".tx\").textContent = td.text;\n    var dp = d.querySelector(\".rdate input\"); dp.value = td.due || \"\";\n    dp.addEventListener(\"change\", function(){ td.due = validDay(dp.value); haptic(\"selection\"); save(); render(); });\n    function flip(){ td.done = !td.done; td.doneAt = td.done ? new Date().toISOString() : null; haptic(\"selection\"); save(); render(); }\n    d.querySelector(\".ck\").onclick = flip; d.querySelector(\".body\").onclick = flip;\n    d.querySelector(\".x\").onclick = function(){ todos.splice(i, 1); haptic(\"light\"); save(); render(); };\n    card.appendChild(d);\n  });\n  L.appendChild(card);\n}\nfunction add(){ var t = el(\"t\"), v = t.value.trim(); if (!v) return; todos.push(newTodo(v, el(\"due\").value)); t.value = \"\"; el(\"due\").value = \"\"; paintDue(); haptic(\"light\"); save(); render(); }\nfunction paintDue(){ var v = validDay(el(\"due\").value); el(\"dueLbl\").textContent = v ? dueLabel(v) : \"\"; el(\"dueChip\").classList.toggle(\"on\", !!v); }\nel(\"due\").addEventListener(\"change\", paintDue);\nel(\"addBtn\").onclick = add;\nel(\"t\").addEventListener(\"keydown\", function(e){ if (e.key === \"Enter\") add(); });\n/* Lists from before v8: the single list in this app's storage. Tasks from\n   before v7 have no id: fixTodo gives them one. */\nfunction legacy(){\n  return load(\"todos\").then(function(v){ try { var a = JSON.parse(v || \"[]\"); return Array.isArray(a) ? a : []; } catch(e){ return []; } });\n}\n/* add-todo: from Calendar Planner, or the MyLLM assistant. Registered after\n   the lists have loaded, so the load can't overwrite what it adds. */\nfunction listen(){\n  if (window.myllmIntent && myllmIntent.receive) myllmIntent.receive(function(intent){\n    if (!intent || intent.action !== \"add-todo\" || !intent.data) return;\n    var text = String(intent.data.text || intent.data.task || \"\").trim();\n    if (!text) return \"Nothing added: the task had no text.\";\n    var asked = String(intent.data.list || \"\").trim(), list = ListsKit.byName(asked) || ListsKit.current();\n    var td = newTodo(text.slice(0, 200), intent.data.due);\n    list.items.push(td); save(list); render(); haptic(\"success\");\n    return \"Added \\u201c\" + td.text + \"\\u201d to \" + list.name + (td.due ? \", due \" + td.due : \"\") + \" (\" + list.items.filter(function(x){ return !x.done; }).length + \" still to do).\" +\n      (asked && list.name.toLowerCase() !== asked.toLowerCase() ? \" There is no list called \\u201c\" + asked + \"\\u201d; the user's lists are: \" + ListsKit.all().map(function(l){ return l.name; }).join(\", \") + \".\" : \"\");\n  });\n}\nListsKit.start({ kind: \"todo\", storeKey: \"lists\", defaultName: \"To do\", example: \"Work, House\",\n  fix: fixTodo, legacy: legacy, render: render, changed: publish, ready: listen });\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes.\n   The spacer keeps the header clear of the status bar / Dynamic Island. It is\n   live CSS — env(safe-area-inset-top) — not a measured number: the inset is\n   still 0 when the page loads and only grows once MyLLM's bar has gone (v1\n   measured once, so the title sat under the island). If the page's own styles\n   already pad the header down by the inset, the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  /* Does any rule that applies to the header or an ancestor already use the top inset? */\n  function pageHandlesInset(head){\n    var chain = [], n, found = false;\n    for (n = head; n && n.nodeType === 1; n = n.parentElement) chain.push(n);\n    function walk(rules){\n      for (var i = 0; i < rules.length && !found; i++){\n        var r = rules[i];\n        if (r.cssRules && !r.selectorText) { walk(r.cssRules); continue; }\n        if (!r.selectorText || !/safe-area-inset-top/.test(r.cssText) || !/(padding|margin|top)\\s*:/.test(r.cssText)) continue;\n        if (/\\.imm-safe/.test(r.selectorText)) continue;\n        for (var k = 0; k < chain.length; k++){\n          try { if (chain[k].matches(r.selectorText)) { found = true; break; } } catch(e){}\n        }\n      }\n    }\n    for (var s = 0; s < document.styleSheets.length && !found; s++){\n      try { walk(document.styleSheets[s].cssRules); } catch(e){}\n    }\n    for (n = head; n && n.nodeType === 1 && !found; n = n.parentElement){\n      if (/safe-area-inset-top/.test(n.getAttribute(\"style\") || \"\")) found = true;\n    }\n    return found;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = (document.body.classList.contains(\"imm\") && !pageHandlesInset(head)) ? \"env(safe-area-inset-top)\" : \"0px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script></body></html>\n", "kind": "html", "iconSymbol": "list.bullet.rectangle", "iconColor": "blue"}