{"name": "Quick Todo", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>:root{color-scheme:light dark}\nbody{font-family:-apple-system,system-ui,sans-serif;margin:0;padding:20px;background:#f2f2f7;color:#111}\n@media(prefers-color-scheme:dark){body{background:#000;color:#eee}.card{background:#1c1c1e}input{background:#2c2c2e;color:#eee;border-color:#3a3a3c}}\nh1{font-size:22px;margin:0 0 14px}\n.row{display:flex;gap:8px;margin-bottom:14px}\ninput{flex:1;padding:12px;border:1px solid #d1d1d6;border-radius:10px;font-size:16px;background:#fff}\nbutton{border:0;background:#0a84ff;color:#fff;border-radius:10px;padding:0 16px;font-size:15px;font-weight:600}\n.card{background:#fff;border-radius:12px;padding:4px 14px;margin-bottom:8px;display:flex;align-items:center;gap:10px}\n.card.done span{text-decoration:line-through;opacity:.45}\n.card span{flex:1;padding:10px 0;font-size:16px}\n.del{background:none;color:#ff453a;font-size:18px;padding:8px}\n.empty{text-align:center;opacity:.5;margin-top:30px}\n@media(min-width:768px){body{max-width:760px;margin-left:auto;margin-right:auto}}\n</style></head><body>\n<h1>✅ Quick Todo</h1>\n<div class=\"row\"><input id=\"t\" placeholder=\"Add a task…\"><button onclick=\"add()\">Add</button></div>\n<div id=\"list\"></div>\n<script>\nvar store=window.myllmStorage||{getItem:function(){return Promise.resolve(null)},setItem:function(){return Promise.resolve()}};\nvar todos=[];\nfunction save(){store.setItem('todos',JSON.stringify(todos))}\nfunction render(){var L=document.getElementById('list');L.innerHTML='';\nif(!todos.length){L.innerHTML='<p class=\"empty\">Nothing yet — add your first task.</p>';return}\ntodos.forEach(function(td,i){var d=document.createElement('div');d.className='card'+(td.done?' done':'');\nvar s=document.createElement('span');s.textContent=td.text;s.onclick=function(){td.done=!td.done;save();render()};\nvar b=document.createElement('button');b.className='del';b.textContent='✕';b.onclick=function(){todos.splice(i,1);save();render()};\nd.appendChild(s);d.appendChild(b);L.appendChild(d)})}\nfunction add(){var t=document.getElementById('t');var v=t.value.trim();if(!v)return;todos.push({text:v,done:false});t.value='';save();render()}\ndocument.getElementById('t').addEventListener('keydown',function(e){if(e.key==='Enter')add()});\nstore.getItem('todos').then(function(v){if(v)try{todos=JSON.parse(v)}catch(e){}render()});\n</script></body></html>", "kind": "html", "iconSymbol": "list.bullet.rectangle", "iconColor": "blue"}