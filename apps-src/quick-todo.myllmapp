{"name": "Quick Todo", "html": "<!doctype html>\n<!--\n  Quick Todo — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n--><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Quick Todo</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"7491b81bef\";color-scheme:light dark; --h:214;}\n\n  /* Shared surface — the same block sits in Quick Todo, Action Items, Sprint\n     Planner and Risk & Decision Log, so the four read as one family. Each app\n     only sets its own hue. MyLLM's theme where it supplies one; the fallbacks\n     carry a dark set too, because a token-only page renders light in dark mode\n     on a build (or a platform) that sends no --myllm-* variables. */\n  :root{\n    --bg:var(--myllm-bg,#f2f2f7); --surface:var(--myllm-surface,#fff); --ink:var(--myllm-text,#111);\n    --muted:var(--myllm-muted,#8a8a8e); --line:var(--myllm-border,#e3e3e8); --acc:var(--myllm-accent,hsl(var(--h) 85% 52%));\n    --fill:rgba(118,118,128,.12); --good:#2aa84f; --warn:#e8890c; --bad:#ff453a; --h2:calc(var(--h) + 40);\n  }\n  @media (prefers-color-scheme:dark){ :root{\n    --bg:var(--myllm-bg,#000); --surface:var(--myllm-surface,#1c1c1e); --ink:var(--myllm-text,#f2f2f7);\n    --muted:var(--myllm-muted,#8e8e93); --line:var(--myllm-border,#2c2c2e); --fill:rgba(118,118,128,.24); --good:#30d158; --warn:#ff9f0a;\n  } }\n  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n  body{ font-family:var(--myllm-font,-apple-system,system-ui,sans-serif); background:var(--bg); color:var(--ink);\n    font-size:15.5px; line-height:1.35; max-width:600px; margin:0 auto; min-height:100dvh; -webkit-text-size-adjust:100%;\n    padding:calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) calc(30px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-left)); }\n  svg{ width:1.25em; height:1.25em; flex-shrink:0; }\n  button{ font:inherit; color:inherit; border:none; background:none; }\n  button:active{ transform:scale(.96); }\n\n  .head{ display:flex; align-items:center; gap:12px; margin:2px 2px 14px; }\n  .head .ht{ flex:1; min-width:0; }\n  .head h1{ font-size:22px; font-weight:800; letter-spacing:-.01em; }\n  .head p{ font-size:13px; color:var(--muted); margin-top:1px; }\n  .tile{ display:flex; align-items:center; justify-content:center; color:#fff; flex-shrink:0;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 46%), hsl(var(--h2) 58% 24%)); }\n  .head .tile{ width:44px; height:44px; border-radius:13px; font-size:19px; }\n  h2{ font-size:12px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:20px 2px 9px;\n    display:flex; align-items:center; justify-content:space-between; gap:10px; min-height:20px; }\n  h2 button{ font-size:12.5px; font-weight:700; letter-spacing:0; text-transform:none; color:var(--acc); padding:6px 2px; margin:-6px 0; }\n  h2 .pts{ color:var(--ink); letter-spacing:0; text-transform:none; font-size:13px; font-variant-numeric:tabular-nums; }\n\n  /* Hero: the app's headline number on its own hue. */\n  .hero{ position:relative; overflow:hidden; border-radius:22px; padding:16px 16px 15px; color:#fff; margin-bottom:14px;\n    background:linear-gradient(145deg, hsl(var(--h) 62% 46%), hsl(var(--h2) 58% 24%)); box-shadow:0 10px 28px hsl(var(--h) 60% 30% / .26); }\n  .hero .k{ font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; opacity:.78; }\n  .hero .n{ font-size:44px; font-weight:800; letter-spacing:-.02em; line-height:1.08; font-variant-numeric:tabular-nums; }\n  .hero .s{ font-size:13px; opacity:.82; margin-top:1px; font-variant-numeric:tabular-nums; }\n  .hero .bar{ height:6px; border-radius:99px; background:rgba(255,255,255,.22); margin-top:12px; overflow:hidden; }\n  .hero .bar i{ display:block; height:100%; width:0; border-radius:99px; background:#fff; transition:width .3s cubic-bezier(.2,.8,.2,1); }\n  .hero .cols{ display:flex; gap:8px; } .hero .cols > div{ flex:1; min-width:0; }\n  .hero .cols .n{ font-size:32px; }\n  .hero .hbtn{ position:absolute; z-index:2; top:12px; right:12px; height:34px; padding:0 13px; border-radius:99px; font-size:12.5px; font-weight:700; color:#fff;\n    display:inline-flex; align-items:center; gap:6px; border:1px solid rgba(255,255,255,.22); background:rgba(255,255,255,.16);\n    -webkit-backdrop-filter:blur(18px); backdrop-filter:blur(18px); }\n  .hero .hbtn:disabled{ opacity:.45; }\n  .hero .marks{ display:flex; gap:6px; flex-wrap:wrap; margin-top:10px; }\n  .hero .marks span{ font-size:12px; font-weight:700; padding:4px 10px; border-radius:99px; background:rgba(255,255,255,.16); display:inline-flex; align-items:center; gap:6px; }\n  .hero .marks i{ width:7px; height:7px; border-radius:50%; background:currentColor; }\n\n  .card{ background:var(--surface); border:1px solid var(--line); border-radius:18px; padding:14px; margin-bottom:12px; }\n  .card.list{ padding:2px 14px; }\n  input,textarea{ width:100%; font:inherit; font-size:16px; color:var(--ink); background:var(--surface); border:1px solid var(--line);\n    border-radius:12px; padding:11px 12px; -webkit-appearance:none; appearance:none; outline:none; }\n  input:focus,textarea:focus{ border-color:var(--acc); }\n  input::placeholder,textarea::placeholder{ color:var(--muted); }\n  textarea{ min-height:92px; resize:vertical; display:block; }\n  .card input,.card textarea{ background:var(--bg); }\n  .addrow{ display:flex; gap:8px; } .addrow input{ flex:1; min-width:0; }\n  label{ display:block; font-size:11.5px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); margin:13px 2px 7px; }\n\n  .btn{ min-height:46px; padding:0 16px; border-radius:13px; font-size:15px; font-weight:700; display:inline-flex; align-items:center; justify-content:center; gap:7px; flex-shrink:0; }\n  .btn.pri{ background:var(--acc); color:#fff; } .btn.sec{ background:var(--fill); color:var(--ink); }\n  .btn.wide{ width:100%; } .btn:disabled{ opacity:.5; }\n  .btnrow{ display:flex; gap:8px; margin-top:10px; } .btnrow .btn.pri{ flex:1; }\n  .pills{ display:flex; gap:6px; }\n  .pills button{ flex:1; min-width:0; height:42px; border-radius:12px; border:1px solid var(--line); background:var(--bg); font-size:15px; font-weight:750; font-variant-numeric:tabular-nums; }\n  .pills button.on{ background:var(--acc); border-color:var(--acc); color:#fff; }\n  .seg{ display:flex; gap:3px; padding:3px; border-radius:13px; background:var(--fill); margin-bottom:14px; }\n  .seg button{ flex:1; height:38px; border-radius:10px; font-size:14px; font-weight:700; color:var(--muted); }\n  .seg button.on{ background:var(--surface); color:var(--ink); box-shadow:0 1px 4px rgba(0,0,0,.14); }\n\n  /* Rows: a check on the left where the thing can be done, the text, then what you can do to it. */\n  .row{ display:flex; align-items:center; gap:11px; padding:10px 0; border-bottom:1px solid var(--line); min-height:52px; }\n  .row:last-child{ border-bottom:none; }\n  .row.top{ align-items:flex-start; }\n  .row .body{ flex:1; min-width:0; }\n  .row .tx{ font-size:15.5px; line-height:1.35; overflow-wrap:break-word; }\n  .row.done .tx{ color:var(--muted); text-decoration:line-through; }\n  .ck{ width:26px; height:26px; border-radius:50%; border:2px solid var(--muted); opacity:.9; flex-shrink:0; display:flex; align-items:center; justify-content:center;\n    color:transparent; font-size:12px; transition:background .2s, border-color .2s; }\n  .row.top .ck{ margin-top:1px; }\n  .row.done .ck{ background:var(--acc); border-color:var(--acc); color:#fff; opacity:1; }\n  .ck.good{ } .row.done .ck.good{ background:var(--good); border-color:var(--good); }\n  .x{ width:36px; height:36px; margin:-4px -8px -4px -2px; border-radius:50%; flex-shrink:0; display:flex; align-items:center; justify-content:center; color:var(--muted); font-size:13px; }\n  .x:active{ color:var(--bad); background:var(--fill); }\n  .tags{ display:flex; gap:6px; flex-wrap:wrap; margin-top:6px; }\n  .tag{ display:inline-flex; align-items:center; gap:5px; font-size:12px; font-weight:700; padding:3px 9px; border-radius:99px; background:var(--fill); color:var(--muted); max-width:100%; }\n  .tag span{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  .tag svg{ font-size:10.5px; }\n  .tag.who{ background:hsl(140 60% 45% / .16); color:var(--good); } .tag.when{ background:hsl(32 90% 50% / .16); color:var(--warn); }\n\n  .empty{ text-align:center; padding:26px 12px 22px; }\n  .empty .tile{ width:54px; height:54px; border-radius:16px; font-size:24px; margin:0 auto 12px; }\n  .empty p{ font-size:14px; color:var(--muted); max-width:280px; margin:0 auto; }\n  .empty .btn{ margin-top:14px; min-height:40px; font-size:14px; }\n\n  .note{ font-size:13px; color:var(--muted); margin:10px 2px 0; min-height:18px; }\n  .note:empty{ display:none; }\n  .alert{ display:flex; align-items:flex-start; gap:10px; border-radius:16px; padding:12px 13px; margin-top:10px; font-size:13.5px; line-height:1.4;\n    background:hsl(4 90% 58% / .12); border:1px solid hsl(4 90% 58% / .28); }\n  .alert svg{ color:var(--bad); margin-top:1px; } .alert div{ flex:1; min-width:0; }\n  .alert button{ font-weight:750; color:var(--acc); font-size:13.5px; padding:2px 0 0 8px; flex-shrink:0; }\n  .alert.info{ background:var(--fill); border-color:transparent; } .alert.info svg{ color:var(--muted); }\n  .spin{ width:16px; height:16px; border-radius:50%; border:2.4px solid currentColor; border-right-color:transparent; animation:spin .8s linear infinite; flex-shrink:0; }\n  @keyframes spin{ to{ transform:rotate(360deg); } }\n  .skel{ height:14px; border-radius:7px; background:var(--fill); animation:skel 1.1s ease-in-out infinite alternate; }\n  @keyframes skel{ from{ opacity:.45; } to{ opacity:1; } }\n\n  @media (max-width:340px){ .hero .cols .k{ font-size:9.5px; letter-spacing:.05em; } .btn{ font-size:14px; padding:0 12px; } .row{ gap:8px; }\n    body{ padding-left:calc(12px + env(safe-area-inset-left)); padding-right:calc(12px + env(safe-area-inset-right)); }\n    .hero .n{ font-size:38px; } .hero .cols .n{ font-size:26px; } .pills{ gap:4px; } }\n  @media (min-width:768px){ body{ max-width:760px; } }\n  @media (prefers-reduced-motion:reduce){ .spin{ animation-duration:2.4s; } .skel{ animation:none; } .hero .bar i{ transition:none; } button:active{ transform:none; } }\n\n  /* this app's own colours, after the shared defaults so they win */\n  :root{ --acc:var(--myllm-accent,#0a84ff); }\n/* myllm-fullscreen-v1 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:40px;height:40px;border-radius:12px;border:1px solid var(--myllm-border,rgba(128,128,128,.28));\n  background:var(--myllm-surface,rgba(128,128,128,.12));color:var(--myllm-text,currentColor);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active,.head .imm-x:active{transform:scale(.94)}\n.head .imm-x{display:none !important}\nbody.imm .head .imm-x{display:grid !important;place-items:center}\n.imm-x svg,.imm-acts svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style></head><body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M5 12.6l4.6 4.6L19.2 7.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-plus\" viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></symbol>\n  <symbol id=\"i-list\" viewBox=\"0 0 24 24\"><path d=\"M4.5 7.2l1.7 1.7 3-3.4M4.5 15.2l1.7 1.7 3-3.4M13 7.5h7M13 15.5h7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n</defs></svg>\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg><use href=\"#i-list\"/></svg></div>\n  <div class=\"ht\"><h1>Quick Todo</h1><p>Tasks that stay done</p></div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Quick Todo\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n<div class=\"hero\" id=\"hero\">\n  <div class=\"k\">To do</div>\n  <div class=\"n\" id=\"hN\">0</div>\n  <div class=\"s\" id=\"hS\">Nothing yet</div>\n  <div class=\"bar\"><i id=\"hBar\"></i></div>\n</div>\n<div class=\"addrow\"><input id=\"t\" placeholder=\"Add a task…\" enterkeyhint=\"done\" autocomplete=\"off\"><button class=\"btn pri\" id=\"addBtn\"><svg><use href=\"#i-plus\"/></svg>Add</button></div>\n<h2>Tasks</h2>\n<div id=\"list\"></div>\n<script>\nfunction el(i){ return document.getElementById(i); }\n/* Bridges are looked up when used, never kept: MyLLM can add them after this\n   script has run. */\nfunction haptic(k){ if (window.myllmHaptic) try { myllmHaptic(k || \"light\"); } catch(_){} }\nfunction load(k){ var s = window.myllmStorage; if (!s) return Promise.resolve(null); try { return s.getItem(k).catch(function(){ return null; }); } catch(_){ return Promise.resolve(null); } }\nfunction keep(k, v){ var s = window.myllmStorage; if (s) try { s.setItem(k, v).catch(function(){}); } catch(_){} }\nfunction esc(s){ return (s + \"\").replace(/[&<>\"]/g, function(c){ return {\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\"}[c]; }); }\nfunction icon(n){ return '<svg><use href=\"#i-' + n + '\"/></svg>'; }\nfunction emptyState(glyph, text, action, target){\n  return '<div class=\"empty\"><div class=\"tile\">' + icon(glyph) + '</div><p>' + text + '</p>' +\n    (action ? '<button class=\"btn sec\" data-focus=\"' + target + '\">' + icon(\"plus\") + action + '</button>' : '') + '</div>';\n}\ndocument.addEventListener(\"click\", function(e){\n  var b = e.target.closest && e.target.closest(\"[data-focus]\");\n  if (b){ var f = el(b.getAttribute(\"data-focus\")); if (f){ f.focus(); f.scrollIntoView({block:\"center\", behavior:\"smooth\"}); } }\n});\nvar todos = [];\nfunction save(){ keep(\"todos\", JSON.stringify(todos)); }\nfunction render(){\n  var L = el(\"list\"), done = todos.filter(function(t){ return t.done; }).length, open = todos.length - done;\n  el(\"hN\").textContent = open;\n  el(\"hS\").textContent = !todos.length ? \"Nothing yet\" : open ? done + \" of \" + todos.length + \" done\" : \"All \" + todos.length + \" done\";\n  el(\"hBar\").style.width = (todos.length ? Math.round(done / todos.length * 100) : 0) + \"%\";\n  if (!todos.length){ L.innerHTML = '<div class=\"card\">' + emptyState(\"list\", \"Nothing yet — add your first task.\", \"Add a task\", \"t\") + '</div>'; return; }\n  L.innerHTML = \"\"; var card = document.createElement(\"div\"); card.className = \"card list\";\n  todos.forEach(function(td, i){\n    var d = document.createElement(\"div\"); d.className = \"row\" + (td.done ? \" done\" : \"\");\n    d.innerHTML = '<div class=\"ck\">' + icon(\"check\") + '</div><div class=\"body\"><div class=\"tx\"></div></div><button class=\"x\" aria-label=\"Delete\">' + icon(\"x\") + '</button>';\n    d.querySelector(\".tx\").textContent = td.text;\n    function flip(){ td.done = !td.done; haptic(\"selection\"); save(); render(); }\n    d.querySelector(\".ck\").onclick = flip; d.querySelector(\".body\").onclick = flip;\n    d.querySelector(\".x\").onclick = function(){ todos.splice(i, 1); haptic(\"light\"); save(); render(); };\n    card.appendChild(d);\n  });\n  L.appendChild(card);\n}\nfunction add(){ var t = el(\"t\"), v = t.value.trim(); if (!v) return; todos.push({text:v, done:false}); t.value = \"\"; haptic(\"light\"); save(); render(); }\nel(\"addBtn\").onclick = add;\nel(\"t\").addEventListener(\"keydown\", function(e){ if (e.key === \"Enter\") add(); });\nrender();\nload(\"todos\").then(function(v){ if (v) try { var a = JSON.parse(v); if (Array.isArray(a)) todos = a; } catch(e){} render(); });\n\n/* myllm-fullscreen-v1 — full screen where MyLLM can also close the app for us (myllmClose,\n   5.6.2+): full screen hides MyLLM's Done, and a page with no way out is\n   worse than a repeated title, so elsewhere nothing changes. The spacer keeps\n   the header clear of the status bar only if the page doesn't already. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  function inset(){\n    var p = document.createElement(\"div\");\n    p.style.cssText = \"position:fixed;top:0;left:0;width:1px;visibility:hidden;height:env(safe-area-inset-top)\";\n    document.body.appendChild(p); var h = p.offsetHeight; p.parentNode.removeChild(p); return h;\n  }\n  function fit(){\n    var sp = document.querySelector(\".imm-safe\"), head = document.querySelector(\".head\");\n    if (!sp || !head) return;\n    sp.style.height = \"0px\";\n    if (!document.body.classList.contains(\"imm\")) return;\n    var need = inset() + 6 - (head.getBoundingClientRect().top + window.scrollY);\n    sp.style.height = Math.max(0, Math.round(need)) + \"px\";\n  }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    fit();\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  window.addEventListener(\"resize\", fit);\n  sync();\n})();\n</script></body></html>\n", "kind": "html", "iconSymbol": "list.bullet.rectangle", "iconColor": "blue"}