643,1996,3634,2070,3610,1884,3038,1855,3023,1575,3113,1256,2139,447,2405,377,2407,211,2460,225,2507,202,2514,204,2520,236,2510,258,2588,198,2608,213,2637,194,2661,237,2792,244,2790,248,2800,299,2968,333,2958],[333,2958,410,2936,464,3149,561,3441,462,3474,456,3502]]},\"stamp\":\"2026-06-01\"}}/*DATA:END*/;\n\nvar $=function(id){return document.getElementById(id)};\nfunction esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]})}\nfunction haptic(s){ try{ if(window.myllmHaptic)window.myllmHaptic(s||'light'); }catch(e){} }\nfunction fold(s){ return String(s||'').normalize('NFD').replace(/[̀-ͯ]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,' ').trim(); }\nvar DARK=matchMedia('(prefers-color-scheme: dark)');\n\n/* ---------- Categories ---------- */\nvar CATS={\n  food:{name:'Food & drink',color:'#f97316',icon:'M7 3v7a2 2 0 0 0 4 0V3M9 3v18M16 3c-1.7 1.5-2.2 4-2.2 6.2 0 1.6.9 2.8 2.2 2.8V21'},\n  shop:{name:'Shops',color:'#ec4899',icon:'M5 8h14l-1.2 12H6.2zM9 8V6.5a3 3 0 0 1 6 0V8'},\n  toilets:{name:'Toilets',color:'#0ea5e9',txt:'WC'},\n  gate:{name:'Gates',color:'#475569',dark:'#8391a7',icon:'M5 20V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v14M5 20h14M10 12h.01'},\n  lounge:{name:'Lounges',color:'#8b5cf6',icon:'M4 12v5h16v-5M6 12V9a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v3M3 12h3v3M21 12h-3v3M7 17v2M17 17v2'},\n  service:{name:'Services',color:'#10b981',icon:'M12 8v.01M11 11h1v6h1'},\n  transport:{name:'Transport',color:'#4f46e5',icon:'M7 4h10a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM5 10h14M8.5 20l2-4M15.5 20l-2-4M8.5 13h.01M15.5 13h.01'},\n  parking:{name:'Parking',color:'#2563eb',txt:'P'},\n  hotel:{name:'Hotels',color:'#b45309',icon:'M3 18V7M3 14h18v4M21 14v-2.5A3.5 3.5 0 0 0 17.5 8H11v6M7 11.2a1.4 1.4 0 1 0 0-.01'},\n  lift:{name:'Lifts',color:'#64748b',icon:'M8 10l4-4 4 4M8 14l4 4 4-4'}\n};\nvar CAT_ORDER=['food','shop','toilets','gate','lounge','service','transport','parking','hotel'];\nvar SERVICE_TXT={'Cash machine':'£','Currency exchange':'€','Pharmacy':'+','Information':'i','Prayer room':'✧','Drinking water':'◊','Phone charging':'⚡','EV charging':'⚡','Baby changing':'♡','Post office':'✉','Medical':'+','Left luggage':'▣'};\nfunction catColor(c){ var C=CATS[c]; return (DARK.matches&&C.dark)||C.color; }\nfunction iconHTML(cat,kind){\n  var C=CATS[cat];\n  if(cat==='service'&&SERVICE_TXT[kind])return '<b>'+esc(SERVICE_TXT[kind])+'</b>';\n  if(C.txt)return '<b>'+C.txt+'</b>';\n  return '<svg viewBox=\"0 0 24 24\"><path d=\"'+C.icon+'\"/></svg>';\n}\nvar PATHS={}; Object.keys(CATS).forEach(function(k){ if(CATS[k].icon)PATHS[k]=new Path2D(CATS[k].icon); });\n\n/* ---------- State ---------- */\nvar STORE='airportmaps.v1';\nvar S={ap:'LHR',term:'AIR',filter:'all',level:{},views:{}};\nvar AP=null, curTab='map', selected=null, nearGate=null, nearList=[];\nfunction save(){\n  var d=JSON.stringify({ap:S.ap,term:S.term,filter:S.filter,level:S.level});\n  try{ if(window.myllmStorage){ myllmStorage.setItem(STORE,d); return; } }catch(e){}\n  try{ localStorage.setItem(STORE,d); }catch(e){}\n}\nfunction load(done){\n  function apply(v){ if(v){ try{ var d=JSON.parse(v);\n    if(d.ap&&DATA[d.ap])S.ap=d.ap; if(typeof d.term==='string')S.term=d.term; if(CATS[d.filter]||d.filter==='all')S.filter=d.filter;\n    if(d.level&&typeof d.level==='object')S.level=d.level; }catch(e){} }\n    done(); }\n  try{ if(window.myllmStorage){ myllmStorage.getItem(STORE).then(apply,function(){apply(null)}); return; } }catch(e){}\n  var v=null; try{ v=localStorage.getItem(STORE); }catch(e){} apply(v);\n}\n\n/* ---------- Prepare an airport ---------- */\nfunction bboxOf(pts,b){ b=b||[1e9,1e9,-1e9,-1e9]; for(var i=0;i<pts.length;i+=2){ if(pts[i]<b[0])b[0]=pts[i]; if(pts[i+1]<b[1])b[1]=pts[i+1]; if(pts[i]>b[2])b[2]=pts[i]; if(pts[i+1]>b[3])b[3]=pts[i+1]; } return b; }\nfunction prep(code){\n  var raw=DATA[code]; if(!raw)return null;\n  var ap={code:code,name:raw.name,city:raw.city,country:raw.country||'',cash:raw.cash||'¤',basic:!!raw.basic,stamp:raw.stamp,base:raw.base||{},terms:raw.terminals,shapes:raw.shapes||[],walks:raw.walks||[]};\n  ap.byTerm={};\n  ap.pois=raw.pois.map(function(p,i){\n    var x=p[8]||{};\n    return {i:i,x:p[0],y:p[1],cat:p[2],name:p[3]||p[4]||CATS[p[2]].name,kind:p[4],t:p[5],lv:p[6]||[],side:p[7]||'',x2:x,\n      terms:x.terms?x.terms.split(','):[p[5]],key:fold((p[3]||'')+' '+(p[4]||'')+' '+(x.brand||'')+' '+(x.cuisine||'').replace(/_/g,' ')+' '+(x.ref||''))};\n  });\n  ap.terms.forEach(function(t){\n    var ob=null; t.outline.forEach(function(r){ ob=bboxOf(r,ob); }); t.obox=ob;\n    // the building plus what's mapped within 400 m of it (remote stands stay out of the fit)\n    var b=ob.slice();\n    ap.pois.forEach(function(p){ if(p.t===t.id&&p.cat!=='parking'&&p.cat!=='hotel'&&p.cat!=='transport'&&\n      p.x>ob[0]-400&&p.x<ob[2]+400&&p.y>ob[1]-400&&p.y<ob[3]+400){ b=bboxOf([p.x,p.y],b); } });\n    t.box=b; t.cx=(b[0]+b[2])/2; t.cy=(b[1]+b[3])/2;\n  });\n  var all=null; (ap.base.aero||[]).forEach(function(r){ all=bboxOf(r,all); });\n  if(!all){ ap.terms.forEach(function(t){ all=bboxOf([t.box[0],t.box[1],t.box[2],t.box[3]],all); }); }\n  ap.box=all;\n  return ap;\n}\nfunction term(){ return AP.terms.find(function(t){return t.id===S.term})||null; }\nfunction lvKey(t){ return AP.code+':'+t.id; }\nfunction curLevel(){ var t=term(); if(!t)return null; var l=S.level[lvKey(t)]; return (l===undefined||l===null||t.levels.indexOf(l)<0)?null:l; }\nfunction lvName(l){ return 'Level '+(l<0?'−'+(-l):l); }\nfunction lvShort(l){ return l<0?'−'+(-l):String(l); }\nfunction termName(id){ if(id==='AIR')return 'Around the airport'; var t=AP.terms.find(function(t){return t.id===id}); return t?t.name:id; }\n\n/* ---------- Map view ---------- */\nvar cv=$('map'), ctx=cv.getContext('2d'), stage=$('stage');\nvar W=0,H=0,DPR=1, view={s:.1,tx:0,ty:0}, baseS=.1, drawQueued=false, drawn=[];\nfunction toScreen(x,y){ return [x*view.s+view.tx, y*view.s+view.ty]; }\nfunction resize(){\n  var r=stage.getBoundingClientRect(); DPR=Math.min(3,window.devicePixelRatio||1);\n  var nw=Math.max(1,Math.round(r.width)), nh=Math.max(1,Math.round(r.height));\n  if(nw===W&&nh===H&&cv.width===Math.round(nw*DPR))return;\n  var cx=W?(W/2-view.tx)/view.s:null, cy=H?(H/2-view.ty)/view.s:null;\n  W=nw;H=nh; cv.width=Math.round(W*DPR); cv.height=Math.round(H*DPR);\n  if(cx!==null){ view.tx=W/2-cx*view.s; view.ty=H/2-cy*view.s; }\n  refScale(); draw();\n}\nfunction isLand(){ return matchMedia('(orientation:landscape) and (max-height:560px)').matches; }\nfunction sheetCover(){ var sh=$('sheet'); if(!sh.classList.contains('open')||isLand())return 0; return Math.min(sh.offsetHeight,H*.76); }\nfunction fitBox(b,pad,anim){\n  var bw=Math.max(40,b[2]-b[0]), bh=Math.max(40,b[3]-b[1]);\n  var left=pad+(!$('levels').hidden?56:0), top=pad+($('gcard').classList.contains('show')?62:0), bottom=pad+sheetCover();\n  var s=Math.min((W-left-pad)/bw,(H-top-bottom)/bh);\n  var t={s:s,tx:left+((W-left-pad)-bw*s)/2-b[0]*s,ty:top+((H-top-bottom)-bh*s)/2-b[1]*s};\n  if(anim)animateTo(t); else { view=t; draw(); }\n}\nvar anim=null;\nfunction animateTo(t,ms){\n  if(matchMedia('(prefers-reduced-motion: reduce)').matches){ view=t; draw(); return; }\n  var from={s:view.s,tx:view.tx,ty:view.ty}, t0=performance.now(), d=ms||380;\n  cancelAnimationFrame(anim);\n  (function step(now){ var k=Math.min(1,(now-t0)/d), e=1-Math.pow(1-k,3);\n    var s=Math.exp(Math.log(from.s)+(Math.log(t.s)-Math.log(from.s))*e);\n    var cxF=(W/2-from.tx)/from.s, cyF=(H/2-from.ty)/from.s, cxT=(W/2-t.tx)/t.s, cyT=(H/2-t.ty)/t.s;\n    var cx=cxF+(cxT-cxF)*e, cy=cyF+(cyT-cyF)*e;\n    view={s:s,tx:W/2-cx*s,ty:H/2-cy*s}; draw(true);\n    if(k<1)anim=requestAnimationFrame(step); else { view=t; draw(); }\n  })(t0);\n}\nfunction zoomAt(f,px,py,animate){\n  var s=Math.max(baseS*.4,Math.min(baseS*60,view.s*f)); f=s/view.s;\n  var t={s:s,tx:px-(px-view.tx)*f,ty:py-(py-view.ty)*f};\n  if(animate)animateTo(t,260); else { view=t; draw(true); }\n}\nvar COL={};\nfunction readColors(){ var cs=getComputedStyle(document.documentElement);\n  ['--map','--ink','--muted','--surface','--acc','--bad','--faint','--apron','--runway','--road','--bldg','--bldgline','--walk','--room','--other'].forEach(function(k){ COL[k]=cs.getPropertyValue(k).trim(); }); }\n\nfunction poly(pts){ ctx.beginPath(); for(var i=0;i<pts.length;i+=2){ var x=pts[i]*view.s+view.tx, y=pts[i+1]*view.s+view.ty; if(i)ctx.lineTo(x,y); else ctx.moveTo(x,y); } }\nfunction levelOK(lv,l){ return l===null||!lv.length||lv.indexOf(l)>=0; }\nfunction visiblePois(){\n  var t=S.term, l=curLevel(), f=S.filter;\n  return AP.pois.filter(function(p){\n    if(t==='AIR'){\n      if(f==='all')return p.cat==='transport'||p.cat==='parking'||p.cat==='hotel';\n      return p.cat===f;\n    }\n    if(p.terms.indexOf(t)<0)return false;\n    if(f!=='all'&&p.cat!==f)return false;\n    if(f==='all'&&p.cat==='lift'&&view.s<baseS*3)return false;\n    if(p.cat==='hotel'||p.cat==='parking')return f!=='all'||view.s>baseS*1.5;\n    return true;\n  });\n}\nfunction draw(fast){\n  ctx.setTransform(DPR,0,0,DPR,0,0);\n  ctx.fillStyle=COL['--map']; ctx.fillRect(0,0,W,H);\n  if(!AP)return;\n  var s=view.s, B=AP.base, inTerm=S.term!=='AIR', l=curLevel();\n  ctx.lineJoin='round'; ctx.lineCap='round';\n  // aprons, roads, runways\n  ctx.fillStyle=COL['--apron'];\n  (B.apron||[]).forEach(function(r){ poly(r); ctx.fill(); });\n  ctx.strokeStyle=COL['--road']; ctx.lineWidth=Math.max(1.2,Math.min(4,9*s));\n  (B.road||[]).forEach(function(r){ poly(r); ctx.stroke(); });\n  ctx.strokeStyle=COL['--runway']; ctx.lineWidth=Math.max(3,50*s);\n  (B.runway||[]).forEach(function(r){ poly(r); ctx.stroke(); });\n  if(s>baseS*.7&&!inTerm){ // runway centre dashes\n    ctx.save(); ctx.strokeStyle=COL['--map']; ctx.globalAlpha=.8; ctx.lineWidth=Math.max(1,2*s); ctx.setLineDash([Math.max(4,30*s),Math.max(4,30*s)]);\n    (B.runway||[]).forEach(function(r){ poly(r); ctx.stroke(); }); ctx.restore();\n  }\n  ctx.save(); ctx.strokeStyle=COL['--faint']; ctx.globalAlpha=.45; ctx.lineWidth=1; ctx.setLineDash([4,5]);\n  (B.aero||[]).forEach(function(r){ poly(r); ctx.stroke(); }); ctx.restore();\n  // terminals\n  AP.terms.forEach(function(t){\n    var dim=inTerm&&t.id!==S.term;\n    ctx.globalAlpha=dim?.55:1;\n    ctx.fillStyle=dim?COL['--other']:COL['--bldg']; ctx.strokeStyle=COL['--bldgline']; ctx.lineWidth=dim?1:1.4;\n    t.outline.forEach(function(r){ poly(r); ctx.closePath(); ctx.fill(); ctx.stroke(); });\n    ctx.globalAlpha=1;\n  });\n  // floor plan of the current terminal\n  if(inTerm){\n    ctx.fillStyle=COL['--room']; ctx.strokeStyle=COL['--bldgline']; ctx.lineWidth=1;\n    AP.shapes.forEach(function(sh){ if(sh[0]!==S.term)return; ctx.globalAlpha=levelOK(sh[2],l)?1:.25; poly(sh[3]); ctx.closePath(); ctx.fill(); ctx.stroke(); });\n    ctx.strokeStyle=COL['--walk']; ctx.lineWidth=Math.max(3,Math.min(22,7*s));\n    AP.walks.forEach(function(w){ if(w[0]!==S.term)return; var ok=levelOK(w[1],l); if(!ok&&l!==null)return; ctx.globalAlpha=(l!==null&&!w[1].length)?.45:1; poly(w[2]); ctx.stroke(); });\n    ctx.globalAlpha=1;\n  }\n  drawPois(fast);\n  if(!inTerm){\n    // terminal badges, on top\n    AP.terms.forEach(function(t){\n      var p=toScreen((t.obox[0]+t.obox[2])/2,(t.obox[1]+t.obox[3])/2), lab=t.label||t.id;\n      ctx.font='800 15px '+getComputedStyle(document.body).fontFamily;\n      var w=ctx.measureText(lab).width+20;\n      ctx.fillStyle=COL['--ink']; roundRect(p[0]-w/2,p[1]-15,w,30,10); ctx.fill();\n      ctx.fillStyle=COL['--surface']; ctx.textAlign='center'; ctx.textBaseline='middle'; ctx.fillText(lab,p[0],p[1]+.5);\n    });\n  }\n}\nfunction roundRect(x,y,w,h,r){ ctx.beginPath(); ctx.moveTo(x+r,y); ctx.arcTo(x+w,y,x+w,y+h,r); ctx.arcTo(x+w,y+h,x,y+h,r); ctx.arcTo(x,y+h,x,y,r); ctx.arcTo(x,y,x+w,y,r); ctx.closePath(); }\nvar PRIO={gate:0,toilets:1,transport:2,lounge:3,food:4,service:5,shop:6,parking:7,hotel:8,lift:9};\nfunction drawPois(fast){\n  drawn=[];\n  var list=visiblePois(), l=curLevel(), z=view.s/baseS, ff=getComputedStyle(document.body).fontFamily;\n  var R=Math.max(7,Math.min(13,6+2.2*Math.log2(Math.max(1,z))));\n  var hi={}; if(selected!==null)hi[selected]=1; nearList.forEach(function(n){hi[n.p.i]=2;}); if(nearGate!==null)hi[nearGate]=3;\n  list.sort(function(a,b){ return (hi[b.i]?1:0)-(hi[a.i]?1:0)||PRIO[a.cat]-PRIO[b.cat]; });\n  var boxes=[];\n  // badges of the terminals keep their space in the overview\n  if(S.term==='AIR'){ ctx.font='800 15px '+ff; AP.terms.forEach(function(t){ var c=toScreen((t.obox[0]+t.obox[2])/2,(t.obox[1]+t.obox[3])/2), hw=ctx.measureText(t.label||t.id).width/2+14; boxes.push([c[0]-hw,c[1]-17,c[0]+hw,c[1]+17]); }); }\n  function hits(b){ for(var i=0;i<boxes.length;i++){ var o=boxes[i]; if(b[0]<o[2]+1&&b[2]>o[0]-1&&b[1]<o[3]+1&&b[3]>o[1]-1)return true; } return false; }\n  list.forEach(function(p){\n    var sp=toScreen(p.x,p.y); if(sp[0]<-40||sp[1]<-40||sp[0]>W+40||sp[1]>H+40)return;\n    var faded=l!==null&&!p.lv.length;\n    if(l!==null&&p.lv.length&&p.lv.indexOf(l)<0)return;\n    if(nearGate!==null&&!hi[p.i]&&S.term!=='AIR')faded=true;\n    var lab, w, h, r;\n    if(p.cat==='gate'){ lab=p.x2.ref||p.name; ctx.font='700 '+Math.round(R*.95)+'px '+ff; w=Math.max(R*2.2,ctx.measureText(lab).width+R*.9); h=R*1.7; }\n    else { r=p.cat==='lift'?R*.72:R; w=h=r*2; }\n    var bx=[sp[0]-w/2,sp[1]-h/2,sp[0]+w/2,sp[1]+h/2];\n    if(!hi[p.i]&&hits(bx))return;\n    ctx.globalAlpha=faded?.35:1;\n    if(p.cat==='gate'){\n      ctx.fillStyle=hi[p.i]===3?COL['--acc']:catColor('gate'); roundRect(sp[0]-w/2,sp[1]-h/2,w,h,h*.32); ctx.fill();\n      ctx.fillStyle='#fff'; ctx.textAlign='center'; ctx.textBaseline='middle'; ctx.fillText(lab,sp[0],sp[1]+.5);\n      drawn.push({p:p,x:sp[0],y:sp[1],r:Math.max(w,h)/2});\n      boxes.push([sp[0]-w/2,sp[1]-h/2,sp[0]+w/2,sp[1]+h/2]);\n    } else {\n      if(hi[p.i]){ ctx.beginPath(); ctx.arc(sp[0],sp[1],r+4,0,7); ctx.fillStyle=hi[p.i]===1?COL['--acc']:'rgba(255,255,255,.9)'; ctx.fill(); }\n      ctx.beginPath(); ctx.arc(sp[0],sp[1],r,0,7); ctx.fillStyle=catColor(p.cat); ctx.fill();\n      ctx.lineWidth=1.5; ctx.strokeStyle=COL['--surface']; ctx.stroke();\n      var txt=(p.cat==='service'&&SERVICE_TXT[p.kind])||CATS[p.cat].txt;\n      if(txt){ ctx.fillStyle='#fff'; ctx.font='800 '+Math.round(r*(txt.length>1?.78:1.05))+'px '+ff; ctx.textAlign='center'; ctx.textBaseline='middle'; ctx.fillText(txt,sp[0],sp[1]+.5); }\n      else { ctx.save(); ctx.translate(sp[0]-r*.62,sp[1]-r*.62); ctx.scale(r*1.24/24,r*1.24/24); ctx.strokeStyle='#fff'; ctx.lineWidth=2.4; ctx.lineCap='round'; ctx.lineJoin='round'; ctx.stroke(PATHS[p.cat]); ctx.restore(); }\n      drawn.push({p:p,x:sp[0],y:sp[1],r:r});\n      boxes.push([sp[0]-r,sp[1]-r,sp[0]+r,sp[1]+r]);\n    }\n    ctx.globalAlpha=1;\n  });\n  // labels\n  var showLabels=z>=(S.term==='AIR'?1.6:2.4)||nearGate!==null;\n  if(!showLabels&&selected===null)return;\n  ctx.font='600 12px '+ff; ctx.textBaseline='middle'; ctx.textAlign='left';\n  drawn.forEach(function(d){\n    if(d.p.cat==='gate'||d.p.cat==='lift'||d.p.name===d.p.kind&&d.p.i!==selected)return;\n    if(!showLabels&&d.p.i!==selected)return;\n    var name=d.p.name; if(name.length>26)name=name.slice(0,25)+'…';\n    var w=ctx.measureText(name).width, x0=d.x+d.r+4, y0=d.y;\n    var bx=[x0-2,y0-9,x0+w+2,y0+9];\n    if(x0+w>W){ x0=d.x-d.r-4-w; bx=[x0-2,y0-9,x0+w+2,y0+9]; }\n    for(var i=0;i<boxes.length;i++){ var b=boxes[i]; if(bx[0]<b[2]&&bx[2]>b[0]&&bx[1]<b[3]&&bx[3]>b[1]){ if(d.p.i!==selected)return; } }\n    boxes.push(bx);\n    ctx.lineWidth=3.5; ctx.strokeStyle=COL['--map']; ctx.strokeText(name,x0,y0);\n    ctx.fillStyle=COL['--ink']; ctx.fillText(name,x0,y0);\n  });\n}\nfunction queueDraw(){ if(drawQueued)return; drawQueued=true; requestAnimationFrame(function(){ drawQueued=false; draw(true); }); }\n\n/* ---------- Gestures ---------- */\nvar ptrs={}, gest=null, lastTap=0, vel=null;\ncv.addEventListener('pointerdown',function(e){\n  $('legend').style.opacity='0';\n  cv.setPointerCapture(e.pointerId); cancelAnimationFrame(anim); vel=null;\n  ptrs[e.pointerId]={x:e.offsetX,y:e.offsetY,t:performance.now(),x0:e.offsetX,y0:e.offsetY};\n  var ids=Object.keys(ptrs);\n  if(ids.length===1)gest={type:'pan',moved:false,t0:performance.now()};\n  else if(ids.length===2){ var a=ptrs[ids[0]],b=ptrs[ids[1]]; gest={type:'pinch',d:Math.hypot(a.x-b.x,a.y-b.y),moved:true}; }\n});\ncv.addEventListener('pointermove',function(e){\n  var p=ptrs[e.pointerId]; if(!p||!gest)return;\n  var dx=e.offsetX-p.x, dy=e.offsetY-p.y, now=performance.now();\n  if(gest.type==='pan'){\n    if(Math.hypot(e.offsetX-p.x0,e.offsetY-p.y0)>6)gest.moved=true;\n    if(gest.moved){ view.tx+=dx; view.ty+=dy; var dt=Math.max(1,now-p.t); vel={x:dx/dt,y:dy/dt,t:now}; queueDraw(); }\n  } else if(gest.type==='pinch'){\n    var ids=Object.keys(ptrs); p.x=e.offsetX; p.y=e.offsetY;\n    var a=ptrs[ids[0]],b=ptrs[ids[1]], d=Math.hypot(a.x-b.x,a.y-b.y);\n    var mx=(a.x+b.x)/2, my=(a.y+b.y)/2;\n    if(gest.mx!==undefined){ view.tx+=mx-gest.mx; view.ty+=my-gest.my; }\n    if(gest.d>0)zoomAt(d/gest.d,mx,my,false);\n    gest.d=d; gest.mx=mx; gest.my=my; return;\n  }\n  p.x=e.offsetX; p.y=e.offsetY; p.t=now;\n});\nfunction endPtr(e){\n  var p=ptrs[e.pointerId]; delete ptrs[e.pointerId];\n  if(!gest)return;\n  if(gest.type==='pan'&&!gest.moved&&p&&performance.now()-gest.t0<450){\n    var now=performance.now();\n    if(now-lastTap<300){ lastTap=0; zoomAt(2,e.offsetX,e.offsetY,true); haptic('light'); }\n    else { lastTap=now; tapAt(e.offsetX,e.offsetY); }\n  } else if(gest.type==='pan'&&vel&&performance.now()-vel.t<60&&!matchMedia('(prefers-reduced-motion: reduce)').matches){\n    var vx=vel.x*16, vy=vel.y*16;\n    (function glide(){ vx*=.92; vy*=.92; view.tx+=vx; view.ty+=vy; draw(true); if(Math.abs(vx)+Math.abs(vy)>.4)anim=requestAnimationFrame(glide); else draw(); })();\n  }\n  if(Object.keys(ptrs).length===0){ if(gest.type!=='pan'||gest.moved)draw(); gest=null; }\n  else if(gest.type==='pinch'){ var k=Object.keys(ptrs)[0]; ptrs[k].x0=ptrs[k].x; ptrs[k].y0=ptrs[k].y; gest={type:'pan',moved:true,t0:0}; }\n}\ncv.addEventListener('pointerup',endPtr); cv.addEventListener('pointercancel',endPtr);\ncv.addEventListener('wheel',function(e){ e.preventDefault(); zoomAt(Math.exp(-e.deltaY*.0022),e.offsetX,e.offsetY,false); },{passive:false});\ndocument.addEventListener('gesturestart',function(e){ e.preventDefault(); });\nfunction tapAt(px,py){\n  var best=null,bd=1e9;\n  drawn.forEach(function(d){ var dd=Math.hypot(d.x-px,d.y-py); if(dd<Math.max(20,d.r+6)&&dd<bd){bd=dd;best=d.p;} });\n  if(best){ haptic('light'); openPoi(best); return; }\n  if(S.term==='AIR'){ // tap a terminal\n    for(var i=0;i<AP.terms.length;i++){ var t=AP.terms[i], b=t.obox, a=toScreen(b[0],b[1]), c=toScreen(b[2],b[3]);\n      if(px>=a[0]-12&&px<=c[0]+12&&py>=a[1]-12&&py<=c[1]+12){ haptic('light'); setTerm(t.id); return; } }\n  }\n  if(selected!==null){ selected=null; draw(); }\n}\n$('zin').onclick=function(){ zoomAt(1.8,W/2,H/2,true); haptic('light'); };\n$('zout').onclick=function(){ zoomAt(1/1.8,W/2,H/2,true); haptic('light'); };\n$('zfit').onclick=function(){ haptic('light'); homeView(true); };\nfunction homeView(anim){\n  var t=term();\n  if(nearGate!==null&&nearList.length){ var b=null; [AP.pois[nearGate]].concat(nearList.map(function(n){return n.p})).forEach(function(p){ b=bboxOf([p.x,p.y],b); }); b=[b[0]-40,b[1]-40,b[2]+40,b[3]+40]; fitBox(b,24,anim); return; }\n  fitBox(t?t.box:AP.box,t?18:10,anim);\n}\n/* The whole airport on screen is the reference scale for zoom-dependent detail. */\nfunction refScale(){ if(!AP||!W)return; var b=AP.box; baseS=Math.min((W-20)/Math.max(40,b[2]-b[0]),(H-20)/Math.max(40,b[3]-b[1])); }\n\n/* ---------- Terminals, levels, filters ---------- */\nfunction renderTerms(){\n  var btns=[{id:'AIR',label:'Airport'}].concat(AP.terms.map(function(t){return {id:t.id,label:t.label||t.id}}));\n  $('terms').innerHTML=btns.map(function(b){ return '<button role=\"tab\" data-t=\"'+b.id+'\" class=\"'+(b.id===S.term?'on':'')+'\" aria-selected=\"'+(b.id===S.term)+'\">'+esc(b.label)+'</button>'; }).join('');\n}\n$('terms').addEventListener('click',function(e){ var b=e.target.closest('button'); if(!b)return; haptic('light'); setTerm(b.dataset.t); });\nfunction setTerm(id,keep){\n  if(id!=='AIR'&&!AP.terms.some(function(t){return t.id===id}))id='AIR';\n  S.term=id; selected=null; nearGate=null; nearList=[]; $('gcard').classList.remove('show');\n  renderTerms(); renderCats(); renderLevels(); setLegend(); save();\n  $('apSub').textContent=AP.name+' · '+(id==='AIR'?AP.city:termName(id));\n  if(!keep&&curTab!=='map'){ openTab(curTab); }\n  requestAnimationFrame(function(){ homeView(false); });\n}\nfunction renderLevels(){\n  var t=term(), el=$('levels');\n  if(!t||t.levels.length<2){ el.hidden=true; document.body.classList.remove('haslv'); return; }\n  var l=curLevel();\n  el.innerHTML='<div class=\"lh\">LEVEL</div><button data-l=\"\" class=\"'+(l===null?'on':'')+'\" aria-label=\"All levels\">All</button>'+\n    t.levels.slice().reverse().map(function(v){ return '<button data-l=\"'+v+'\" class=\"'+(l===v?'on':'')+'\" aria-label=\"'+lvName(v)+'\">'+lvShort(v)+'</button>'; }).join('');\n  el.hidden=false; document.body.classList.add('haslv');\n}\n$('levels').addEventListener('click',function(e){ var b=e.target.closest('button'); if(!b)return; haptic('light');\n  var t=term(); S.level[lvKey(t)]=b.dataset.l===''?null:parseInt(b.dataset.l,10); save(); renderLevels(); draw();\n  if(curTab==='places')showPlaces(); });\nfunction counts(){\n  var c={}; AP.pois.forEach(function(p){ if(S.term==='AIR'?true:p.terms.indexOf(S.term)>=0)c[p.cat]=(c[p.cat]||0)+1; }); return c;\n}\nfunction renderCats(){\n  var c=counts();\n  var h='<button class=\"all'+(S.filter==='all'?' on':'')+'\" data-c=\"all\">Everything</button>';\n  CAT_ORDER.forEach(function(k){\n    if(!c[k])return;\n    if(S.term!=='AIR'&&k==='hotel'&&c[k]<2)return;\n    h+='<button data-c=\"'+k+'\" class=\"'+(S.filter===k?'on':'')+'\"><i style=\"background:'+catColor(k)+'\">'+iconHTML(k)+'</i>'+esc(CATS[k].name)+' <span>'+c[k]+'</span></button>';\n  });\n  $('cats').innerHTML=h;\n  if(S.filter!=='all'&&!c[S.filter])S.filter='all';\n}\n$('cats').addEventListener('click',function(e){ var b=e.target.closest('button'); if(!b)return; haptic('light');\n  S.filter=(S.filter===b.dataset.c&&b.dataset.c!=='all')?'all':b.dataset.c; save(); renderCats(); draw(); setLegend();\n  if(curTab==='places')showPlaces(); });\nfunction setLegend(){\n  var t=term(), txt;\n  if(!t)txt=S.filter==='all'?'Tap a terminal, or pick what to show above':'All terminals · '+CATS[S.filter].name;\n  else txt=t.name+' · '+(S.filter==='all'?'everything':CATS[S.filter].name.toLowerCase())+' · © OpenStreetMap';\n  $('legend').textContent=txt; $('legend').style.opacity='1';\n}\n\n/* ---------- Sheets ---------- */\nvar back=null;\nfunction openSheet(title,html,opts){\n  opts=opts||{};\n  $('shTitle').textContent=title; $('shBody').innerHTML=html; $('shBody').scrollTop=0;\n  $('shBack').hidden=!opts.back; if(opts.back)$('shBack').textContent='‹ '+opts.back;\n  back=opts.onBack||null;\n  $('sheet').classList.add('open'); placeFab();\n}\nfunction closeSheet(){\n  $('sheet').classList.remove('open'); placeFab();\n  document.querySelectorAll('.tabs button').forEach(function(b){ b.classList.toggle('on',b.dataset.tab==='map'); }); curTab='map';\n}\nfunction placeFab(){ requestAnimationFrame(function(){ var c=sheetCover(); $('fab').style.bottom=(c+12)+'px'; $('fab').style.visibility=c?'hidden':''; $('legend').style.display=c?'none':''; }); }\n$('shX').onclick=function(){ haptic('light'); closeSheet(); };\n$('shBack').onclick=function(){ if(back)back(); };\n(function(){ var y0=null, sh=$('sheet');\n  $('grab').addEventListener('pointerdown',function(e){ y0=e.clientY; sh.style.transition='none'; $('grab').setPointerCapture(e.pointerId); });\n  $('grab').addEventListener('pointermove',function(e){ if(y0===null)return; var d=Math.max(0,e.clientY-y0); sh.style.transform='translateY('+d+'px)'; });\n  function up(e){ if(y0===null)return; var d=e.clientY-y0; y0=null; sh.style.transition=''; sh.style.transform=''; if(d>90)closeSheet(); }\n  $('grab').addEventListener('pointerup',up); $('grab').addEventListener('pointercancel',up);\n})();\n$('tabs').addEventListener('click',function(e){ var b=e.target.closest('button'); if(!b)return; haptic('light'); openTab(b.dataset.tab); });\nfunction openTab(t){\n  curTab=t;\n  document.querySelectorAll('.tabs button').forEach(function(b){ b.classList.toggle('on',b.dataset.tab===t); });\n  if(t==='map'){ closeSheet(); return; }\n  if(t==='places')showPlaces(); else if(t==='gates')showGates(); else if(t==='travel')showTravel();\n}\n\n/* ---------- Rows ---------- */\nfunction lvLabel(p){ if(!p.lv.length)return ''; return p.lv.length>2?'Levels '+lvShort(p.lv[0])+'–'+lvShort(p.lv[p.lv.length-1]):p.lv.map(lvShort).map(function(x,i){return i?x:'Level '+x}).join(', '); }\nfunction poiRow(p,right){\n  var sub=[p.kind]; if(S.term==='AIR'||p.t!==S.term)sub.push(termName(p.t)); var lv=lvLabel(p); if(lv)sub.push(lv); if(p.side)sub.push(p.side);\n  return '<div class=\"row\" data-p=\"'+p.i+'\"><div class=\"ic\" style=\"background:'+catColor(p.cat)+'\">'+iconHTML(p.cat,p.kind)+'</div>'+\n    '<div class=\"t\"><b>'+esc(p.name)+'</b><span>'+esc(sub.join(' · '))+'</span></div>'+(right||'')+'</div>';\n}\n/* Several outlets with one name in one terminal (T3 has five Caffè Neros)\n   read as broken data when listed row after row: they become one row with a\n   count, which opens in place to the outlets, each with its own level. */\nfunction groupPois(list){\n  var map={}, out=[];\n  list.forEach(function(p){ var k=p.cat+'|'+p.t+'|'+fold(p.name); if(!map[k]){ map[k]=[]; out.push(map[k]); } map[k].push(p); });\n  return out;\n}\nfunction groupSub(g){\n  var lv={}, sides={}; g.forEach(function(p){ p.lv.forEach(function(v){ lv[v]=1; }); if(p.side)sides[p.side]=1; });\n  var l=Object.keys(lv).map(Number).sort(function(a,b){return a-b});\n  var sub=[g.length+' outlets']; if(l.length)sub.push((l.length>1?'Levels ':'Level ')+l.map(lvShort).join(', '));\n  var sd=Object.keys(sides); if(sd.length===1)sub.push(sd[0]); else if(sd.length>1)sub.push('Airside and landside');\n  return sub.join(' · ');\n}\nfunction outletRow(p,right,n){\n  var sub=[lvLabel(p)||'Level not recorded']; if(p.side)sub.push(p.side); else if(p.x2.opening_hours)sub.push(hoursNice(p.x2.opening_hours).split('\\n')[0]);\n  return '<div class=\"row\" data-p=\"'+p.i+'\"><div class=\"t\"><b>Outlet '+n+'</b><span>'+esc(sub.join(' · '))+'</span></div>'+(right||'')+'</div>';\n}\nfunction groupRows(list,rightFn){\n  return groupPois(list).map(function(g){\n    if(g.length===1)return poiRow(g[0],rightFn?rightFn(g[0]):'');\n    var p=g[0];\n    return '<div class=\"row grp\" data-grp=\"1\"><div class=\"ic\" style=\"background:'+catColor(p.cat)+'\">'+iconHTML(p.cat,p.kind)+'</div>'+\n      '<div class=\"t\"><b>'+esc(p.name)+'</b><span>'+esc(groupSub(g))+'</span></div>'+(rightFn?rightFn(p):'')+'<span class=\"cnt\">'+g.length+'</span><span class=\"chev2\">›</span></div>'+\n      '<div class=\"outs\">'+g.slice().sort(function(a,b){ return rightFn?0:((a.lv[0]===undefined?99:a.lv[0])-(b.lv[0]===undefined?99:b.lv[0])); })\n        .map(function(o,j){ return outletRow(o,rightFn?rightFn(o):'',j+1); }).join('')+'</div>';\n  }).join('');\n}\nfunction bindRows(el,from){\n  el.querySelectorAll('.row[data-p]').forEach(function(r){ r.onclick=function(){ haptic('light'); openPoi(AP.pois[+r.dataset.p],from); }; });\n  el.querySelectorAll('.row.grp').forEach(function(r){ r.onclick=function(){ haptic('light'); r.classList.toggle('open'); }; });\n}\n\n/* ---------- Places ---------- */\nfunction showPlaces(){\n  var l=curLevel(), list=AP.pois.filter(function(p){\n    if(p.cat==='lift')return false;\n    if(S.term!=='AIR'&&p.terms.indexOf(S.term)<0)return false;\n    if(S.term==='AIR'&&S.filter==='all'&&p.cat!=='transport'&&p.cat!=='parking'&&p.cat!=='hotel')return false;\n    if(S.filter!=='all'&&p.cat!==S.filter)return false;\n    if(l!==null&&p.lv.length&&p.lv.indexOf(l)<0)return false;\n    return true;\n  });\n  var groups={}; list.forEach(function(p){ (groups[p.cat]=groups[p.cat]||[]).push(p); });\n  var t=term(), h='';\n  if(t){\n    var c=counts();\n    h+='<p class=\"note\">'+['food','shop','toilets','gate','lounge'].filter(function(k){return c[k]}).map(function(k){return c[k]+' '+CATS[k].name.toLowerCase()}).join(' · ')+\n      (l!==null?'. Showing '+lvName(l).toLowerCase()+' and places with no level recorded.':'.')+'</p>';\n    if(askAvailable())h+='<div class=\"acts2\"><button class=\"btn pri\" id=\"askBtn\">Ask about '+esc(t.name)+'</button></div>';\n  }\n  if(!list.length)h+='<p class=\"note\" style=\"margin-top:14px\">Nothing mapped here for this choice yet. OpenStreetMap is edited by volunteers, so some places may be missing.</p>';\n  CAT_ORDER.forEach(function(k){\n    var g=groups[k]; if(!g)return;\n    g.sort(function(a,b){ return k==='gate'?natCmp(a.x2.ref||'',b.x2.ref||''):a.name.localeCompare(b.name); });\n    h+='<div class=\"sec\">'+esc(CATS[k].name)+' · '+g.length+'</div>'+groupRows(g);\n  });\n  openSheet(t?t.name:'Around the airport',h);\n  bindRows($('shBody'),{label:'Places',fn:showPlaces});\n  var ab=$('askBtn'); if(ab)ab.onclick=function(){ haptic('light'); showAsk(); };\n}\nfunction natCmp(a,b){ var re=/(\\d+)|(\\D+)/g, x=a.match(re)||[], y=b.match(re)||[];\n  for(var i=0;i<Math.min(x.length,y.length);i++){ var p=x[i],q=y[i]; if(p===q)continue; var np=/^\\d/.test(p), nq=/^\\d/.test(q);\n    if(np&&nq)return +p-+q; return p.localeCompare(q); } return x.length-y.length; }\n\n/* ---------- One place ---------- */\nfunction hoursNice(s){\n  s=String(s).trim(); if(/^24\\/7$/.test(s)||/^Mo-Su 00:00-(24:00|23:59)$/.test(s))return 'Open 24 hours';\n  var D={Mo:'Mon',Tu:'Tue',We:'Wed',Th:'Thu',Fr:'Fri',Sa:'Sat',Su:'Sun',PH:'Bank holidays'};\n  return s.split(/\\s*;\\s*/).map(function(part){ return part.replace(/\\b(Mo|Tu|We|Th|Fr|Sa|Su|PH)\\b/g,function(m){return D[m]}).replace(/-/g,'–').replace(/,/g,', ').replace(/\\boff\\b/,'closed'); }).join('\\n');\n}\nfunction openPoi(p,from){\n  selected=p.i;\n  if(p.t!==S.term&&!(S.term!=='AIR'&&p.terms.indexOf(S.term)>=0)){\n    if(p.t==='AIR'){ if(S.term!=='AIR')setTerm('AIR',true); } else setTerm(p.t,true);\n  }\n  var t=term();\n  if(t&&p.lv.length&&curLevel()!==null&&p.lv.indexOf(curLevel())<0){ S.level[lvKey(t)]=null; renderLevels(); }\n  var x=p.x2, facts=[];\n  facts.push(['Where',termName(p.t)+(x.terms&&x.terms.indexOf(',')>0?' (also '+x.terms.split(',').slice(1).map(termName).join(', ')+')':''),false]);\n  facts.push(['Level',p.lv.length?lvLabel(p).replace(/^Levels? /,''):'Not recorded',false]);\n  if(p.side)facts.push(['Side',p.side==='Airside'?'Airside (after security)':'Landside (before security)',true]);\n  if(x.opening_hours)facts.push(['Opening hours',hoursNice(x.opening_hours),true]);\n  if(x.cuisine)facts.push(['Food',x.cuisine.replace(/_/g,' ').replace(/;/g,', '),false]);\n  if(x.brand&&x.brand!==p.name)facts.push(['Brand',x.brand,false]);\n  if(x.operator)facts.push(['Run by',x.operator,false]);\n  if(x.wheelchair)facts.push(['Wheelchair',{yes:'Accessible',limited:'Limited access',no:'Not accessible',designated:'Accessible'}[x.wheelchair]||x.wheelchair,false]);\n  if(p.cat==='toilets'){ var g=[]; if(x.female==='yes')g.push('Women'); if(x.male==='yes')g.push('Men'); if(x.unisex==='yes')g.push('All genders'); if(g.length)facts.push(['For',g.join(', '),false]); }\n  if(x.changing_table==='yes')facts.push(['Baby changing','Yes',false]);\n  if(x.capacity)facts.push(['Spaces',x.capacity,false]);\n  if(x.fee)facts.push(['Fee',x.fee==='yes'?'Charged':x.fee==='no'?'Free':x.fee,false]);\n  var h='<div class=\"pc\"><div class=\"big\" style=\"background:'+catColor(p.cat)+'\">'+iconHTML(p.cat,p.kind)+'</div><div class=\"pt\"><b>'+esc(p.kind)+'</b><span>'+esc(CATS[p.cat].name)+'</span></div></div>'+\n    '<div class=\"facts\">'+facts.map(function(f){ return '<div class=\"fact'+(f[2]||String(f[1]).length>18?' w':'')+'\"><small>'+esc(f[0])+'</small><div>'+esc(f[1]).replace(/\\n/g,'<br>')+'</div></div>'; }).join('')+'</div>'+\n    '<div class=\"acts2\"><button class=\"btn pri\" id=\"pShow\">Show on map</button>'+(p.cat==='gate'?'<button class=\"btn\" id=\"pNear\">What’s near</button>':'')+'</div>';\n  openSheet(p.name,h,from?{back:from.label,onBack:from.fn}:null);\n  $('pShow').onclick=function(){ haptic('light'); showOnMap(p); };\n  var pn=$('pNear'); if(pn)pn.onclick=function(){ haptic('light'); pickGate(p.i); };\n  draw();\n}\nfunction showOnMap(p){\n  closeSheet(); selected=p.i;\n  var s=Math.max(view.s,baseS*4), t={s:s,tx:W/2-p.x*s,ty:H/2-p.y*s};\n  animateTo(t); draw();\n}\n\n/* ---------- Near a gate ---------- */\nfunction gatesOf(tid){ return AP.pois.filter(function(p){return p.cat==='gate'&&p.t===tid}).sort(function(a,b){return natCmp(a.x2.ref||'',b.x2.ref||'')}); }\nfunction showGates(){\n  var t=term();\n  if(!t){\n    openSheet('Near a gate','<p class=\"note\">Pick your terminal first.</p><div class=\"acts2\">'+AP.terms.map(function(t){return '<button class=\"btn\" data-t=\"'+t.id+'\">'+t.id+'</button>'}).join('')+'</div>');\n    $('shBody').querySelectorAll('[data-t]').forEach(function(b){ b.onclick=function(){ setTerm(b.dataset.t,true); showGates(); }; });\n    return;\n  }\n  var gs=gatesOf(t.id);\n  var h='<p class=\"note\">Pick your gate to see the nearest toilets, food, shops and more. Distances are in a straight line on the map, so the walk may be longer; each place shows its level.</p>';\n  if(!gs.length)h+='<p class=\"note\" style=\"margin-top:10px\">No gates are mapped for '+esc(t.name)+' yet.</p>';\n  h+='<div class=\"ggrid\">'+gs.map(function(g){ return '<button data-g=\"'+g.i+'\" class=\"'+(nearGate===g.i?'on':'')+'\">'+esc(g.x2.ref)+'</button>'; }).join('')+'</div>';\n  if(nearGate!==null)h+=nearHTML();\n  openSheet('Near a gate · '+t.id,h);\n  $('shBody').querySelectorAll('[data-g]').forEach(function(b){ b.onclick=function(){ haptic('light'); pickGate(+b.dataset.g); }; });\n  bindRows($('shBody'),{label:'Near gate',fn:showGates});\n  var cl=$('nearClear'); if(cl)cl.onclick=clearNear;\n}\nvar NEAR_CATS=['toilets','food','shop','lounge','service'];\nfunction computeNear(gi){\n  var g=AP.pois[gi], out=[];\n  NEAR_CATS.forEach(function(k){\n    // Not filtered by level: a gate's recorded level is often the boarding\n    // level, while the shops it's near are a floor or two up. Each row shows its level.\n    var cand=AP.pois.filter(function(p){ return p.cat===k&&p.terms.indexOf(g.t)>=0; });\n    cand.forEach(function(p){ p._d=Math.hypot(p.x-g.x,p.y-g.y); });\n    cand.sort(function(a,b){return a._d-b._d});\n    cand.slice(0,k==='toilets'?3:k==='service'?3:4).forEach(function(p){ out.push({p:p,d:p._d,cat:k}); });\n  });\n  return out;\n}\nfunction pickGate(gi){\n  var g=AP.pois[gi];\n  if(S.term!==g.t)setTerm(g.t,true);\n  nearGate=gi; nearList=computeNear(gi); selected=null;\n  var t=term(); if(t&&curLevel()!==null){ S.level[lvKey(t)]=null; renderLevels(); }\n  $('gcT').textContent='Near gate '+g.x2.ref; $('gcS').textContent=nearList.length+' places · straight-line distances';\n  $('gcard').classList.add('show');\n  curTab='gates'; document.querySelectorAll('.tabs button').forEach(function(b){ b.classList.toggle('on',b.dataset.tab==='gates'); });\n  showGates(); requestAnimationFrame(function(){ homeView(true); });\n}\nfunction walk(d){ var m=Math.max(1,Math.round(d/75)); return '<b>'+m+' min</b>'+(d<1000?Math.round(d/10)*10+' m':(d/1000).toFixed(1)+' km'); }\nfunction nearHTML(){\n  var g=AP.pois[nearGate], h='<div class=\"sec\">Nearest to gate '+esc(g.x2.ref)+'</div>';\n  NEAR_CATS.forEach(function(k){\n    var rows=nearList.filter(function(n){return n.cat===k}); if(!rows.length)return;\n    h+='<div class=\"nearsec\"><i style=\"background:'+catColor(k)+'\">'+iconHTML(k)+'</i><h3>'+esc(CATS[k].name)+'</h3></div>'+groupRows(rows.map(function(n){return n.p}),function(p){ return '<div class=\"r\">'+walk(p._d)+'</div>'; });\n  });\n  if(!nearList.length)h+='<p class=\"note\">Nothing mapped near this gate yet.</p>';\n  h+='<div class=\"acts2\"><button class=\"btn\" id=\"nearClear\">Clear gate</button></div><p class=\"note\" style=\"margin-top:10px\">Walking times assume about 4.5 km/h in a straight line; follow the airport’s signs.</p>';\n  return h;\n}\nfunction clearNear(){ nearGate=null; nearList=[]; $('gcard').classList.remove('show'); draw(); if(curTab==='gates')showGates(); }\n$('gcClear').onclick=function(){ haptic('light'); clearNear(); };\n$('gcOpen').onclick=function(){ haptic('light'); curTab='gates'; showGates(); };\n\n/* ---------- Getting there ---------- */\nfunction showTravel(){\n  var t=term();\n  var list=AP.pois.filter(function(p){ return (p.cat==='transport'||p.cat==='parking')&&(t?p.terms.indexOf(t.id)>=0:true); });\n  var extra=t?AP.pois.filter(function(p){ return p.cat==='transport'&&p.t==='AIR'&&(p.kind==='Station'||p.kind==='Bus & coach'); }):[];\n  var groups=[['Trains','Station'],['Transit trains between gates','Transit train'],['Buses & coaches','Bus & coach'],['Taxis','Taxi'],['Car hire','Car hire'],['Parking','Car park']];\n  var h='<p class=\"note\">'+(t?'How to reach '+esc(t.name)+', from the map data.':'Stations, buses, taxis, car hire and parking around the airport, from the map data.')+' Check times with the operator before you travel.</p>';\n  groups.forEach(function(g){\n    var rows=list.filter(function(p){return p.kind===g[1]}).sort(function(a,b){return a.name.localeCompare(b.name)});\n    if(!rows.length)return;\n    h+='<div class=\"sec\">'+g[0]+'</div>'+groupRows(rows);\n  });\n  if(t&&extra.length){ h+='<div class=\"sec\">Elsewhere at the airport</div>'+extra.filter(function(p){return list.indexOf(p)<0}).map(function(p){return poiRow(p)}).join(''); }\n  openSheet('Getting there'+(t?' · '+t.id:''),h);\n  bindRows($('shBody'),{label:'Getting there',fn:showTravel});\n}\n\n/* ---------- Ask your AI ---------- */\nfunction askAvailable(){ return typeof window.myllmAsk==='function'; }\nvar lastAsk={q:'',a:''};\nfunction showAsk(){\n  var t=term(); if(!t)return;\n  var sug=['Where can I get breakfast?','Is there a pharmacy airside?','Where are the quietest toilets?','Which lounges are here?'];\n  var h='<div class=\"ask\"><p class=\"note\">Your AI answers from the places mapped in '+esc(t.name)+'. It only knows what the map shows.</p>'+\n    '<div class=\"sugg\">'+sug.map(function(s){return '<button data-s=\"'+esc(s)+'\">'+esc(s)+'</button>'}).join('')+'</div>'+\n    '<textarea id=\"askQ\" placeholder=\"Ask about '+esc(t.name)+'\">'+esc(lastAsk.q)+'</textarea>'+\n    '<div class=\"acts2\"><button class=\"btn pri\" id=\"askGo\">Ask</button></div><div id=\"askOut\">'+(lastAsk.a?answerHTML(lastAsk.a):'')+'</div></div>';\n  openSheet('Ask about '+t.id,h,{back:'Places',onBack:showPlaces});\n  $('shBody').querySelectorAll('[data-s]').forEach(function(b){ b.onclick=function(){ $('askQ').value=b.dataset.s; }; });\n  $('askGo').onclick=function(){ doAsk(t); };\n}\nfunction answerHTML(a){ return '<div class=\"answer\"><small>Your AI, from the map data</small>'+esc(a)+'</div>'; }\nfunction doAsk(t){\n  var q=$('askQ').value.trim(); if(!q)return;\n  haptic('light'); $('askGo').disabled=true; $('askOut').innerHTML='<div class=\"skel\"></div><div class=\"skel\" style=\"width:70%\"></div>';\n  var lines=AP.pois.filter(function(p){ return p.terms.indexOf(t.id)>=0&&p.cat!=='lift'; }).map(function(p){\n    var b=[p.name+' — '+p.kind]; if(p.lv.length)b.push('level '+p.lv.join('/')); if(p.side)b.push(p.side.toLowerCase()); if(p.x2.opening_hours)b.push('hours '+p.x2.opening_hours); return b.join(', ');\n  });\n  var ctxTxt=lines.join('\\n'); if(ctxTxt.length>7000)ctxTxt=ctxTxt.slice(0,7000);\n  var prompt='You are helping a traveller at '+AP.name+' airport, '+t.name+'. These are the places the map (OpenStreetMap) lists in this terminal; it may be incomplete:\\n'+ctxTxt+\n    '\\n\\nAnswer the question in two to four short sentences, using only this list. Mention levels and airside/landside when known. If the list does not show it, say the map doesn’t show it and suggest the airport’s signs or information desks.\\nQuestion: '+q;\n  lastAsk.q=q;\n  Promise.resolve().then(function(){ return window.myllmAsk(prompt); }).then(function(r){\n    lastAsk.a=String(r||'').trim()||'No answer came back.'; if($('askOut'))$('askOut').innerHTML=answerHTML(lastAsk.a);\n  }).catch(function(){ if($('askOut'))$('askOut').innerHTML='<p class=\"note\" style=\"margin-top:10px\">Couldn’t reach your AI just now.</p>'; })\n  .then(function(){ if($('askGo'))$('askGo').disabled=false; });\n}\n\n/* ---------- Search ---------- */\nfunction openSearch(){ $('search').classList.add('open'); $('q').value=''; renderResults(''); setTimeout(function(){ $('q').focus(); },60); }\nfunction closeSearch(){ $('search').classList.remove('open'); $('q').blur(); }\n$('findBtn').onclick=function(){ haptic('light'); openSearch(); };\n$('qCancel').onclick=closeSearch;\n$('q').addEventListener('input',function(){ renderResults(this.value); });\nfunction renderResults(q){\n  var f=fold(q), h='';\n  if(!f){\n    var gs=S.term!=='AIR'?gatesOf(S.term).length:0;\n    h='<p class=\"note\" style=\"margin-top:12px\">Search every terminal by name, brand, type or gate number — try “coffee”, “pharmacy”, “Boots” or “A10”.'+(gs?'':'')+'</p>';\n    $('qRes').innerHTML=h; return;\n  }\n  var toks=f.split(' ');\n  var res=AP.pois.filter(function(p){ return p.cat!=='lift'&&toks.every(function(t){ return (' '+p.key).indexOf(' '+t)>=0||(p.cat==='gate'&&fold(p.x2.ref)===t); }); });\n  function exact(p){ return fold(p.name)===f||fold(p.x2.ref||'')===f?0:1; }\n  res.sort(function(a,b){ return exact(a)-exact(b)||(a.t===S.term?0:1)-(b.t===S.term?0:1)||a.name.localeCompare(b.name); });\n  res=res.slice(0,80);\n  h=res.length?groupRows(res):'<p class=\"note\" style=\"margin-top:12px\">Nothing mapped by that name. Try a type, like “coffee” or “toilets”.</p>';\n  $('qRes').innerHTML=h;\n  $('qRes').querySelectorAll('.row[data-p]').forEach(function(r){ r.onclick=function(){ haptic('light'); closeSearch(); openPoi(AP.pois[+r.dataset.p]); }; });\n  $('qRes').querySelectorAll('.row.grp').forEach(function(r){ r.onclick=function(){ haptic('light'); r.classList.toggle('open'); }; });\n}\n\n/* ---------- Airports ----------\n   One map at a time; the choice is remembered. Levels are remembered per\n   airport and terminal (Dubai and Pudong both have a T1). */\nfunction setAirport(code,termId){\n  AP=prep(code)||prep(Object.keys(DATA)[0]); S.ap=AP.code;\n  SERVICE_TXT['Cash machine']=AP.cash;\n  $('apCode').textContent=AP.code;\n  $('apBtn').setAttribute('aria-label','Airport: '+AP.name+'. Change airport');\n  // the whole-airport scale is the reference for zoom-dependent detail\n  refScale(); renderTerms(); setTerm(termId||'AIR',true);\n}\nfunction showAirports(){\n  var h='<p class=\"note\" style=\"margin-bottom:4px\">Maps drawn from OpenStreetMap. How much is mapped varies by airport.</p>'+\n    Object.keys(DATA).map(function(k){ var d=DATA[k], n=d.pois.filter(function(p){return p[2]!=='lift'}).length;\n      var sub=[d.city,d.terminals.length+' terminal'+(d.terminals.length===1?'':'s'),n.toLocaleString()+' places'];\n      if(d.basic)sub.push('lightly mapped');\n      return '<div class=\"row\" data-ap=\"'+k+'\"><div class=\"ic ap\"><b>'+esc(k)+'</b></div><div class=\"t\"><b>'+esc(d.name)+'</b><span>'+esc(sub.join(' · '))+'</span></div>'+\n        (k===AP.code?'<span class=\"ok\" aria-label=\"Current airport\">✓</span>':'')+'</div>'; }).join('');\n  openSheet('Airports',h);\n  $('shBody').querySelectorAll('.row[data-ap]').forEach(function(r){ r.onclick=function(){ haptic('light'); var k=r.dataset.ap;\n    closeSheet(); if(k!==AP.code){ setAirport(k,'AIR'); toast(AP.name); } }; });\n}\n$('apBtn').onclick=function(){ haptic('light'); showAirports(); };\ndocument.querySelector('.head .ht').onclick=function(){ haptic('light'); showAirports(); };\n\n/* ---------- About ---------- */\nfunction showAbout(){\n  var h='<p class=\"note\">Airport Maps draws its own maps from OpenStreetMap: terminal outlines, walkways, shops, restaurants, toilets, gates, lounges, transport and parking, as volunteers have mapped them. It is not an official airport map and is not affiliated with or endorsed by any airport operator or airline.</p>'+\n    '<div class=\"sec\">Data</div><p class=\"note\">© OpenStreetMap contributors. Available under the Open Database License (ODbL 1.0); the airport data in this app is a derivative database under the ODbL. Map data as of '+esc(AP.stamp||'2026')+'.</p>'+\n    '<div class=\"sec\">Good to know</div><p class=\"note\">Places open, close and move, and some aren’t mapped at all. Levels are shown where the map records them. There is no indoor positioning: distances near a gate are straight lines, not walking routes. Follow the airport’s signs and check your gate on the departure boards.</p>'+\n    '<div class=\"sec\">Airports</div><p class=\"note\">'+esc(Object.keys(DATA).map(function(k){return DATA[k].name+' ('+k+')';}).join(', '))+'. Each is built from open data, so how much is mapped varies from one airport to the next. More will follow where the mapping is good.</p>';\n  openSheet('About Airport Maps',h);\n}\n$('aboutBtn').onclick=function(){ haptic('light'); showAbout(); };\n\n/* ---------- Toast ---------- */\nvar tt; function toast(m){ var t=$('toast'); t.textContent=m; t.classList.add('show'); clearTimeout(tt); tt=setTimeout(function(){t.classList.remove('show')},1500); }\n\n/* ---------- Boot ---------- */\nreadColors();\nDARK.addEventListener&&DARK.addEventListener('change',function(){ readColors(); renderCats(); draw(); });\nif(window.ResizeObserver)new ResizeObserver(function(){ resize(); placeFab(); }).observe(stage);\naddEventListener('resize',function(){ resize(); placeFab(); });\nAP=prep(S.ap);\nresize();\nload(function(){\n  if(!DATA[S.ap])S.ap=Object.keys(DATA)[0];\n  $('apTitle').textContent='Airport Maps';\n  setAirport(S.ap,S.term||'AIR');\n});\n\n/* myllm-fullscreen-v2 — full screen where MyLLM can also close the app for us\n   (myllmClose, 5.6.2+): full screen hides MyLLM's Done, and a page with no way\n   out is worse than a repeated title, so elsewhere nothing changes. This page\n   pads its own top by env(safe-area-inset-top), so the spacer stays at 0. */\n(function(){\n  function full(){ return !!(window.myllmClose && window.myllmImmersive); }\n  function sync(){\n    var f = full();\n    document.body.classList.toggle(\"imm\", f);\n    var sp = document.querySelector(\".imm-safe\"); if (sp) sp.style.height = \"0px\";\n    if (!f) return;\n    try { window.myllmImmersive(true, { keepAwake:false }).catch(function(){}); } catch(e){}\n  }\n  window.myllmFSClose = function(){\n    try { if (window.myllmHaptic) window.myllmHaptic(\"light\"); } catch(e){}\n    try { window.myllmClose().catch(function(){}); } catch(e){}\n  };\n  document.addEventListener(\"visibilitychange\", function(){ if (!document.hidden) sync(); });\n  sync();\n})();\n</script></body></html>\n", "kind": "html", "iconSymbol": "airplane", "iconColor": "cyan"}