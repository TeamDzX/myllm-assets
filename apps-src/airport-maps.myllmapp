{"name": "Airport Maps", "html": "<!doctype html>\n<!--\n  Airport Maps — MyLLMos™ App Gallery · © 2026 Opticell Ltd\n  Source-available: read it, remix it, run your version inside MyLLM™.\n  Not for redistribution or republication. Terms: https://github.com/TeamDzX/myllm-assets/blob/main/LICENSE\n-->\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no\">\n<title>Airport Maps</title>\n<meta name=\"myllm:immersive\" content=\"on\">\n<style>:root{--build-id:\"d076e4507b\";color-scheme:light dark;\n  --bg:#f4f5f8; --map:#e8ecf0; --surface:#ffffff; --surface2:#f0f1f5; --ink:#15171c; --muted:#6c7280; --faint:#a3a8b3;\n  --line:rgba(20,24,32,.09); --chip:rgba(20,24,32,.06); --acc:#0b84d8; --acc2:#4f46e5; --good:#1f9d55; --bad:#d6342c;\n  --apron:#dde2e8; --runway:#c3cad4; --road:#d3d8df; --bldg:#ffffff; --bldgline:#8e9aab; --walk:#d3ddeb; --room:#eef2f8; --other:#f4f6f9;\n  --shadow:0 10px 30px rgba(20,24,40,.16); --font:-apple-system,system-ui,\"Segoe UI\",sans-serif; }\n@media (prefers-color-scheme:dark){ :root{\n  --bg:#0c0e13; --map:#0f1218; --surface:#181b23; --surface2:#20242e; --ink:#eef0f4; --muted:#8f96a3; --faint:#5b6170;\n  --line:rgba(255,255,255,.08); --chip:rgba(255,255,255,.07); --acc:#38a8ff; --acc2:#8b86ff; --good:#3ecf7c; --bad:#ff6259;\n  --apron:#151920; --runway:#262c38; --road:#1c212a; --bldg:#212835; --bldgline:#4a5568; --walk:#323c4f; --room:#29303e; --other:#191d25;\n  --shadow:0 12px 34px rgba(0,0,0,.5); } }\n*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}\n[hidden]{display:none !important}\nhtml,body{height:100%;overflow:hidden;overscroll-behavior:none}\nbody{font-family:var(--font);color:var(--ink);background:var(--bg);height:100vh;height:100dvh;display:flex;flex-direction:column;\n  padding:env(safe-area-inset-top) env(safe-area-inset-right) 0 env(safe-area-inset-left);-webkit-user-select:none;user-select:none}\nbutton{font:inherit;color:inherit;border:0;background:none;cursor:pointer}\ninput,textarea{font:inherit;color:inherit}\n\n/* Header */\n.head{display:flex;align-items:center;gap:10px;padding:8px 14px 6px;flex-shrink:0}\n.tile{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;flex-shrink:0;\n  background:linear-gradient(145deg,#38bdf8,#4f46e5);box-shadow:0 4px 12px rgba(56,120,240,.3)}\n.tile svg{width:20px;height:20px;color:#fff}\n.ht{min-width:0;flex:1}\n.ht h1{font-size:17px;line-height:1.3;font-weight:650;letter-spacing:-.2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.ht p{font-size:12px;line-height:1.35;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.acts{display:flex;gap:8px;align-items:center}\n.hbtn{height:36px;min-width:36px;padding:0 9px;border-radius:11px;background:var(--chip);display:grid;place-items:center;transition:transform .12s}\n.hbtn:active{transform:scale(.93)}\n.hbtn svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}\n.hbtn.apbtn{display:flex;align-items:center;gap:2px;padding:0 6px 0 10px;font-size:13.5px;line-height:1;font-weight:800;letter-spacing:.3px;font-variant-numeric:tabular-nums}\n.hbtn.apbtn svg{width:14px;height:14px;stroke-width:2.6}\n.ht{cursor:pointer}\n.row .ic.ap{width:44px;border-radius:10px;background:linear-gradient(145deg,#38bdf8,#4f46e5)}\n.row .ic.ap b{font-size:12.5px;letter-spacing:.3px}\n.row .ok{color:var(--acc);font-size:17px;font-weight:700;flex-shrink:0}\n\n/* Terminal switcher */\n.terms{display:flex;gap:3px;margin:2px 14px 6px;padding:3px;border-radius:12px;background:var(--chip);flex-shrink:0}\n.terms button{flex:1;min-width:0;height:32px;border-radius:9px;font-size:14px;line-height:1.3;font-weight:600;color:var(--muted);transition:background .2s,color .2s;white-space:nowrap}\n.terms button.on{background:var(--surface);color:var(--ink);box-shadow:0 1px 4px rgba(0,0,0,.12)}\n\n/* Category chips */\n.cats{display:flex;gap:6px;overflow-x:auto;padding:2px 14px 8px;flex-shrink:0;scrollbar-width:none}\n.cats::-webkit-scrollbar{display:none}\n.cats button{flex-shrink:0;display:flex;align-items:center;gap:6px;height:32px;padding:0 11px 0 8px;border-radius:999px;background:var(--surface);\n  border:1px solid var(--line);font-size:13px;line-height:1.3;font-weight:600;color:var(--ink);white-space:nowrap}\n.cats button i{width:18px;height:18px;border-radius:50%;display:grid;place-items:center;flex-shrink:0}\n.cats button i svg{width:12px;height:12px;fill:none;stroke:#fff;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}\n.cats button i b{font-size:9.5px;line-height:1;color:#fff;font-weight:800}\n.cats button span{color:var(--muted);font-weight:600}\n.cats button.on{background:var(--ink);color:var(--surface);border-color:transparent}\n.cats button.on span{color:var(--surface);opacity:.7}\n.cats button.all{padding-left:12px}\n\n/* Map stage */\n.stage{position:relative;flex:1 1 auto;min-height:0;overflow:hidden;background:var(--map);border-top:1px solid var(--line)}\ncanvas#map{position:absolute;inset:0;width:100%;height:100%;touch-action:none;display:block}\n.fab{position:absolute;right:12px;bottom:12px;display:flex;flex-direction:column;gap:8px;z-index:2}\n.fab button{width:42px;height:42px;border-radius:13px;background:var(--surface);box-shadow:var(--shadow);display:grid;place-items:center}\n.fab button:active{transform:scale(.93)}\n.fab svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}\n.levels{position:absolute;left:12px;top:12px;z-index:2;display:flex;flex-direction:column;gap:2px;padding:3px;border-radius:13px;\n  background:var(--surface);box-shadow:0 4px 14px rgba(20,24,40,.16);max-height:calc(100% - 24px);overflow-y:auto;scrollbar-width:none}\n.levels::-webkit-scrollbar{display:none}\n.levels button{min-width:40px;height:32px;padding:0 8px;border-radius:10px;font-size:13px;line-height:1.3;font-weight:650;color:var(--muted);flex-shrink:0}\n.levels button.on{background:var(--ink);color:var(--surface)}\n.levels .lh{font-size:9.5px;line-height:1.3;font-weight:800;letter-spacing:.6px;color:var(--faint);text-align:center;padding:3px 0 1px}\n.legend{position:absolute;left:12px;bottom:12px;font-size:11px;line-height:1.35;color:var(--muted);background:color-mix(in srgb,var(--surface) 88%,transparent);\n  padding:5px 8px;border-radius:8px;z-index:1;pointer-events:none;max-width:62%;transition:opacity .4s}\n.gcard{position:absolute;left:12px;right:12px;top:10px;z-index:3;background:var(--surface);border-radius:16px;box-shadow:var(--shadow);\n  padding:10px 12px;display:none;align-items:center;gap:10px}\n.gcard.show{display:flex}\nbody.haslv .gcard{left:66px}\nbody.haslv .legend{left:66px;max-width:calc(100% - 136px)}\n.gcard .rt{flex:1;min-width:0}\n.gcard .rt b{display:block;font-size:14px;line-height:1.35;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.gcard .rt span{display:block;font-size:12.5px;line-height:1.35;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.gcard button{font-size:13px;line-height:1.3;font-weight:600;color:var(--acc);padding:6px 6px;flex-shrink:0}\n\n/* Tab bar */\n.tabs{display:flex;flex-shrink:0;background:var(--surface);border-top:1px solid var(--line);padding:6px 6px calc(6px + env(safe-area-inset-bottom))}\n.tabs button{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;padding:4px 0;color:var(--muted);font-size:11px;line-height:1.3;font-weight:600;border-radius:10px}\n.tabs button svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}\n.tabs button.on{color:var(--acc)}\n\n/* Sheets */\n.sheet{position:absolute;left:0;right:0;bottom:0;z-index:5;background:var(--surface);border-radius:20px 20px 0 0;box-shadow:0 -8px 30px rgba(0,0,0,.18);\n  display:flex;flex-direction:column;max-height:76%;transform:translateY(105%);transition:transform .32s cubic-bezier(.2,.8,.2,1);visibility:hidden}\n.sheet.open{transform:none;visibility:visible}\n.grab{height:22px;flex-shrink:0;display:grid;place-items:center;cursor:grab}\n.grab::before{content:\"\";width:38px;height:5px;border-radius:3px;background:var(--faint);opacity:.6}\n.sh{display:flex;align-items:center;gap:10px;padding:0 16px 8px;flex-shrink:0}\n.sh h2{flex:1;font-size:19px;line-height:1.3;font-weight:700;letter-spacing:-.3px;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.sh .x{width:30px;height:30px;border-radius:50%;background:var(--chip);display:grid;place-items:center;flex-shrink:0}\n.sh .x svg{width:13px;height:13px;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.sh .back{font-size:15px;line-height:1.3;color:var(--acc);font-weight:600;padding:4px 2px;flex-shrink:0}\n.sb{overflow-y:auto;-webkit-overflow-scrolling:touch;padding:0 16px 18px;flex:1 1 auto;min-height:0;-webkit-user-select:text;user-select:text}\n.note{font-size:13px;line-height:1.45;color:var(--muted)}\n.sec{font-size:12px;line-height:1.4;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:var(--muted);margin:14px 0 6px}\n\n/* Rows */\n.row{display:flex;align-items:center;gap:12px;padding:10px 2px;border-bottom:1px solid var(--line);cursor:pointer;min-height:50px}\n.row:last-child{border-bottom:0}\n.row:active{background:var(--chip)}\n.row .ic{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;flex-shrink:0}\n.row .ic svg{width:16px;height:16px;fill:none;stroke:#fff;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}\n.row .ic b{font-size:12px;line-height:1;color:#fff;font-weight:800}\n.row .t{flex:1;min-width:0}\n.row .t b{display:block;font-size:15.5px;line-height:1.35;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.row .t span{display:block;font-size:13px;line-height:1.4;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.row .r{font-size:13px;line-height:1.35;color:var(--muted);text-align:right;flex-shrink:0;font-variant-numeric:tabular-nums}\n.row .r b{display:block;color:var(--ink);font-size:14px;line-height:1.35}\n.row .cnt{min-width:24px;height:22px;padding:0 7px;border-radius:11px;background:var(--chip);color:var(--ink);font-size:12.5px;line-height:22px;font-weight:700;text-align:center;flex-shrink:0}\n.row .chev2{color:var(--faint);font-size:15px;flex-shrink:0;transition:transform .2s}\n.grp.open .chev2{transform:rotate(90deg)}\n.outs{display:none;padding-left:18px;border-bottom:1px solid var(--line)}\n.grp.open+.outs{display:block}\n.outs .row{min-height:44px;padding:8px 2px}\n.outs .row:last-child{border-bottom:0}\n.lvl{display:inline-block;font-size:11.5px;line-height:1.3;font-weight:700;padding:1px 6px;border-radius:6px;background:var(--chip);color:var(--muted);margin-left:4px}\n\n/* POI card */\n.pc{display:flex;align-items:center;gap:14px;margin:2px 0 8px}\n.pc .big{width:52px;height:52px;border-radius:16px;display:grid;place-items:center;flex-shrink:0}\n.pc .big svg{width:26px;height:26px;fill:none;stroke:#fff;stroke-width:2.1;stroke-linecap:round;stroke-linejoin:round}\n.pc .big b{font-size:19px;line-height:1;color:#fff;font-weight:800}\n.pc .pt{min-width:0}\n.pc .pt b{display:block;font-size:14px;line-height:1.35;font-weight:650}\n.pc .pt span{display:block;font-size:13px;line-height:1.4;color:var(--muted)}\n.facts{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px}\n.fact{background:var(--surface2);border-radius:12px;padding:9px 11px;min-width:0}\n.fact.w{grid-column:1/-1}\n.fact small{display:block;font-size:11px;line-height:1.35;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:var(--muted)}\n.fact div{font-size:14.5px;line-height:1.45;margin-top:2px;overflow-wrap:anywhere}\n.acts2{display:flex;gap:8px;margin-top:14px}\n.btn{flex:1;height:44px;border-radius:12px;background:var(--chip);font-size:14.5px;line-height:1.3;font-weight:600}\n.btn.pri{background:linear-gradient(145deg,var(--acc),var(--acc2));color:#fff}\n\n/* Gate grid */\n.ggrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(64px,1fr));gap:6px;margin-top:4px}\n.ggrid button{height:38px;border-radius:10px;background:var(--surface2);font-size:14px;line-height:1.3;font-weight:700;font-variant-numeric:tabular-nums}\n.ggrid button.on{background:var(--ink);color:var(--surface)}\n.nearsec{display:flex;align-items:center;gap:8px;margin:16px 0 4px}\n.nearsec i{width:22px;height:22px;border-radius:50%;display:grid;place-items:center}\n.nearsec i svg{width:13px;height:13px;fill:none;stroke:#fff;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}\n.nearsec i b{font-size:10px;line-height:1;color:#fff;font-weight:800}\n.nearsec h3{font-size:15px;line-height:1.35;font-weight:700}\n\n/* Ask */\n.ask textarea{width:100%;min-height:64px;border-radius:13px;border:1px solid var(--line);background:var(--surface2);padding:11px 12px;font-size:16px;line-height:1.4;resize:none;outline:none;-webkit-user-select:text;user-select:text}\n.ask textarea:focus{border-color:var(--acc)}\n.sugg{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0}\n.sugg button{font-size:13px;line-height:1.3;padding:7px 11px;border-radius:999px;background:var(--chip);color:var(--ink)}\n.answer{margin-top:12px;background:var(--surface2);border-radius:14px;padding:12px 13px;font-size:15px;line-height:1.5;white-space:pre-wrap}\n.answer small{display:block;font-size:11.5px;line-height:1.35;font-weight:700;letter-spacing:.4px;text-transform:uppercase;color:var(--acc);margin-bottom:6px}\n.skel{height:14px;border-radius:7px;background:var(--chip);margin:12px 0;animation:pulse 1.2s ease-in-out infinite}\n@keyframes pulse{50%{opacity:.45}}\n\n/* Search overlay */\n.search{position:absolute;inset:0;z-index:8;background:var(--surface);display:none;flex-direction:column}\n.search.open{display:flex}\n.sbar{display:flex;align-items:center;gap:10px;padding:10px 14px;flex-shrink:0;border-bottom:1px solid var(--line)}\n.sbar input{flex:1;min-width:0;height:42px;border-radius:12px;border:0;background:var(--surface2);padding:0 14px;font-size:16px;line-height:1.3;outline:none;-webkit-user-select:text;user-select:text}\n.sbar button{font-size:15px;line-height:1.3;color:var(--acc);font-weight:600}\n.sres{flex:1;min-height:0;overflow-y:auto;padding:0 16px 20px}\n\n.toast{position:absolute;left:50%;top:14px;transform:translate(-50%,-10px);opacity:0;pointer-events:none;z-index:9;background:var(--ink);color:var(--surface);\n  font-size:13px;line-height:1.35;font-weight:600;padding:8px 13px;border-radius:10px;transition:.25s;max-width:86%;text-align:center}\n.toast.show{opacity:1;transform:translate(-50%,0)}\n\n@media (orientation:landscape) and (max-height:560px){\n  .head{padding-top:4px;padding-bottom:4px} .ht p{display:none}\n  .terms{margin-bottom:4px} .terms button{height:28px}\n  .cats{padding-bottom:6px} .cats button{height:28px}\n  .sheet{left:auto;right:10px;bottom:10px;top:10px;width:min(400px,52%);max-height:none;border-radius:18px}\n  .tabs{padding-top:4px} .tabs button{flex-direction:row;justify-content:center;gap:6px;font-size:12px}\n  .tabs button svg{width:19px;height:19px}\n  .levels button{height:28px}\n}\n@media (prefers-reduced-motion:reduce){ .sheet{transition:none} .skel{animation:none} }\n\n/* myllm-fullscreen-v2 — MyLLM 5.6.2+ opens this app full screen; the ✕ is the way out. */\n.head .imm-acts{display:none;flex-shrink:0;margin-left:auto}\n.head .acts + .imm-acts{margin-left:0}\nbody.imm .head .imm-acts{display:flex}\n.head .imm-acts button{width:36px;height:36px;border-radius:11px;border:1px solid var(--line);\n  background:var(--chip);color:var(--ink);display:grid;place-items:center;padding:0;cursor:pointer;transition:transform .12s}\n.head .imm-acts button:active{transform:scale(.94)}\n.imm-acts svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}\n.imm-safe{display:none}\nbody.imm .imm-safe{display:block}\n</style></head><body>\n\n<div class=\"imm-safe\"></div><div class=\"head\">\n  <div class=\"tile\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M21 15.5v-1.8l-8-5V4.2a1.4 1.4 0 0 0-2.8 0v4.5l-8 5v1.8l8-2.5v4.6l-2 1.5v1.4l3.4-1 3.4 1v-1.4l-2-1.5V13z\"/></svg></div>\n  <div class=\"ht\"><h1 id=\"apTitle\">Airport Maps</h1><p id=\"apSub\">Heathrow · London</p></div>\n  <div class=\"acts\">\n    <button class=\"hbtn apbtn\" id=\"apBtn\" aria-label=\"Change airport\"><span id=\"apCode\">LHR</span><svg viewBox=\"0 0 24 24\"><path d=\"M7 10l5 5 5-5\"/></svg></button>\n    <button class=\"hbtn\" id=\"findBtn\" aria-label=\"Search the airport\"><svg viewBox=\"0 0 24 24\"><circle cx=\"11\" cy=\"11\" r=\"6.5\"/><path d=\"M20 20l-4.2-4.2\"/></svg></button>\n    <button class=\"hbtn\" id=\"aboutBtn\" aria-label=\"About and data sources\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.01\"/></svg></button>\n  </div>\n<div class=\"imm-acts\"><button type=\"button\" aria-label=\"Close Airport Maps\" onclick=\"myllmFSClose()\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div></div>\n\n<div class=\"terms\" id=\"terms\" role=\"tablist\" aria-label=\"Terminal\"></div>\n<div class=\"cats\" id=\"cats\" role=\"toolbar\" aria-label=\"Show\"></div>\n\n<div class=\"stage\" id=\"stage\">\n  <canvas id=\"map\" role=\"img\" aria-label=\"Airport map\"></canvas>\n  <div class=\"levels\" id=\"levels\" hidden></div>\n  <div class=\"gcard\" id=\"gcard\"><div class=\"rt\"><b id=\"gcT\"></b><span id=\"gcS\"></span></div><button id=\"gcOpen\">List</button><button id=\"gcClear\" aria-label=\"Clear\">Clear</button></div>\n  <div class=\"fab\" id=\"fab\">\n    <button id=\"zin\" aria-label=\"Zoom in\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 6v12M6 12h12\"/></svg></button>\n    <button id=\"zout\" aria-label=\"Zoom out\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></svg></button>\n    <button id=\"zfit\" aria-label=\"Fit to view\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5\"/></svg></button>\n  </div>\n  <div class=\"legend\" id=\"legend\"></div>\n  <div class=\"toast\" id=\"toast\"></div>\n\n  <div class=\"sheet\" id=\"sheet\" role=\"dialog\" aria-modal=\"false\">\n    <div class=\"grab\" id=\"grab\"></div>\n    <div class=\"sh\"><button class=\"back\" id=\"shBack\" hidden>‹ Back</button><h2 id=\"shTitle\"></h2><button class=\"x\" id=\"shX\" aria-label=\"Close\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button></div>\n    <div class=\"sb\" id=\"shBody\"></div>\n  </div>\n\n  <div class=\"search\" id=\"search\">\n    <div class=\"sbar\"><input id=\"q\" type=\"search\" placeholder=\"Shop, restaurant, gate…\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" enterkeyhint=\"search\"><button id=\"qCancel\">Cancel</button></div>\n    <div class=\"sres\" id=\"qRes\"></div>\n  </div>\n</div>\n\n<div class=\"tabs\" id=\"tabs\">\n  <button data-tab=\"map\" class=\"on\"><svg viewBox=\"0 0 24 24\"><path d=\"M9 4L3 6.5v13.5l6-2.5 6 2.5 6-2.5V4l-6 2.5z\"/><path d=\"M9 4v13.5M15 6.5V20\"/></svg>Map</button>\n  <button data-tab=\"places\"><svg viewBox=\"0 0 24 24\"><path d=\"M8 6h12M8 12h12M8 18h12\"/><circle cx=\"4\" cy=\"6\" r=\"1.2\" fill=\"currentColor\"/><circle cx=\"4\" cy=\"12\" r=\"1.2\" fill=\"currentColor\"/><circle cx=\"4\" cy=\"18\" r=\"1.2\" fill=\"currentColor\"/></svg>Places</button>\n  <button data-tab=\"gates\"><svg viewBox=\"0 0 24 24\"><rect x=\"4\" y=\"5\" width=\"16\" height=\"14\" rx=\"3\"/><path d=\"M9 5v14M4 12h5\"/></svg>Near gate</button>\n  <button data-tab=\"travel\"><svg viewBox=\"0 0 24 24\"><rect x=\"6\" y=\"3.5\" width=\"12\" height=\"13\" rx=\"3\"/><path d=\"M6 10.5h12M9 20l1.5-3.5M15 20l-1.5-3.5M9 13.5h.01M15 13.5h.01\"/></svg>Getting there</button>\n</div>\n\n<script>\n'use strict';\n/* Data: © OpenStreetM