 "starterGrammar": [
  {
   "title": "Gender & articles",
   "rule": "Every noun is masculine or feminine: le (m) / la (f), les (plural). Before a vowel, le and la become l'.",
   "ex": [
    [
     "le pain",
     "the bread"
    ],
    [
     "la ville",
     "the city"
    ],
    [
     "l'école",
     "the school"
    ]
   ]
  },
  {
   "title": "Être & avoir",
   "rule": "The two essential verbs: être (to be) and avoir (to have). Many everyday phrases use avoir where English uses “to be”.",
   "ex": [
    [
     "Je suis anglais.",
     "I am English."
    ],
    [
     "J'ai deux sœurs.",
     "I have two sisters."
    ],
    [
     "J'ai faim.",
     "I'm hungry. (lit. I have hunger)"
    ]
   ]
  },
  {
   "title": "Present tense: -er verbs",
   "rule": "Drop -er and add -e, -es, -e, -ons, -ez, -ent. Most French verbs follow this pattern.",
   "ex": [
    [
     "je parle",
     "I speak"
    ],
    [
     "tu parles",
     "you speak"
    ],
    [
     "nous parlons",
     "we speak"
    ]
   ]
  }
 ]
