 "starterGrammar": [
  {
   "title": "Gender & articles",
   "rule": "Nouns are masculine, feminine or neuter: der / die / das. The plural article is always die. Learn each noun with its article.",
   "ex": [
    [
     "der Mann",
     "the man"
    ],
    [
     "die Frau",
     "the woman"
    ],
    [
     "das Kind",
     "the child"
    ]
   ]
  },
  {
   "title": "Sein & haben",
   "rule": "The two essential verbs: sein (to be) and haben (to have). Most other tenses are built with them.",
   "ex": [
    [
     "Ich bin müde.",
     "I am tired."
    ],
    [
     "Du bist nett.",
     "You are nice."
    ],
    [
     "Ich habe Zeit.",
     "I have time."
    ]
   ]
  },
  {
   "title": "Word order",
   "rule": "In a statement the verb is always the second idea — whatever comes first. In yes/no questions the verb comes first.",
   "ex": [
    [
     "Ich trinke Kaffee.",
     "I drink coffee."
    ],
    [
     "Heute trinke ich Kaffee.",
     "Today I drink coffee. (verb stays 2nd)"
    ],
    [
     "Trinkst du Kaffee?",
     "Do you drink coffee?"
    ]
   ]
  }
 ]
}