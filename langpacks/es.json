 "starterGrammar": [
  {
   "title": "Gender & articles",
   "rule": "Every noun is masculine or feminine: el (m) / la (f), plural los / las. Most -o words are masculine, most -a words feminine.",
   "ex": [
    [
     "el libro",
     "the book"
    ],
    [
     "la casa",
     "the house"
    ],
    [
     "los amigos",
     "the friends"
    ]
   ]
  },
  {
   "title": "Ser vs estar",
   "rule": "Both mean “to be”. Use ser for what something is (identity, origin); use estar for how or where it is (feelings, states, location).",
   "ex": [
    [
     "Soy inglés.",
     "I am English. (ser)"
    ],
    [
     "Estoy cansado.",
     "I am tired. (estar)"
    ],
    [
     "El café está frío.",
     "The coffee is cold. (estar)"
    ]
   ]
  },
  {
   "title": "Present tense: -ar verbs",
   "rule": "Drop -ar and add -o, -as, -a, -amos, -áis, -an. Same person endings work for most verbs.",
   "ex": [
    [
     "hablo",
     "I speak"
    ],
    [
     "hablas",
     "you speak"
    ],
    [
     "hablamos",
     "we speak"
    ]
   ]
  }
 ]
}